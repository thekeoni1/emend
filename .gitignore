/target

# Office and spreadsheet files never enter the repository, except under
# tests/fixtures/. Extensions match in any letter case, alone or followed
# by #, ~, : or a further extension, which catches lock files, backups and
# download metadata such as .~lock.<name>.xlsx#, <name>.xlsx~,
# <name>.xlsx.bak and <name>.xlsx:Zone.Identifier.
*.[xX][lL][sS][xX]
*.[xX][lL][sS][xX][#~]
*.[xX][lL][sS][xX][.:]*
*.[xX][lL][sS][mM]
*.[xX][lL][sS][mM][#~]
*.[xX][lL][sS][mM][.:]*
*.[xX][lL][tT][xX]
*.[xX][lL][tT][xX][#~]
*.[xX][lL][tT][xX][.:]*
*.[xX][lL][tT][mM]
*.[xX][lL][tT][mM][#~]
*.[xX][lL][tT][mM][.:]*
*.[xX][lL][sS][bB]
*.[xX][lL][sS][bB][#~]
*.[xX][lL][sS][bB][.:]*
*.[xX][lL][sS]
*.[xX][lL][sS][#~]
*.[xX][lL][sS][.:]*
*.[oO][dD][sS]
*.[oO][dD][sS][#~]
*.[oO][dD][sS][.:]*
*.[cC][sS][vV]
*.[cC][sS][vV][#~]
*.[cC][sS][vV][.:]*
*.[tT][sS][vV]
*.[tT][sS][vV][#~]
*.[tT][sS][vV][.:]*
*.[fF][oO][dD][sS]
*.[fF][oO][dD][sS][#~]
*.[fF][oO][dD][sS][.:]*
*.[oO][tT][sS]
*.[oO][tT][sS][#~]
*.[oO][tT][sS][.:]*
*.[xX][lL][tT]
*.[xX][lL][tT][#~]
*.[xX][lL][tT][.:]*
*.[xX][lL][aA]
*.[xX][lL][aA][#~]
*.[xX][lL][aA][.:]*
*.[xX][lL][aA][mM]
*.[xX][lL][aA][mM][#~]
*.[xX][lL][aA][mM][.:]*
*.[nN][uU][mM][bB][eE][rR][sS]
*.[nN][uU][mM][bB][eE][rR][sS][#~]
*.[nN][uU][mM][bB][eE][rR][sS][.:]*
!**/tests/fixtures/**
# Download metadata beside a file copied from Windows is ignored everywhere,
# tests/fixtures/ included, so it comes after the exception above.
*:[Zz][Oo][Nn][Ee].[Ii][Dd][Ee][Nn][Tt][Ii][Ff][Ii][Ee][Rr]
