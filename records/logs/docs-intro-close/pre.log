    #!/usr/bin/env bash
    # Docs intro close-out, pre mode (specs/0050 "Close-out"; planning's
    # close-out brief). Read-only: pushes nothing, changes nothing.
    # Usage: bash close-pre.sh   (run from anywhere; works in <repo>)
    set -uo pipefail
    export LC_ALL=C PYTHONDONTWRITEBYTECODE=1
    cd "$HOME/emend" || exit 2
    FAILS=0
    ok() { echo "  $1: as-expected"; }
    bad() { echo "  $1: no"; FAILS=$((FAILS + 1)); }
    check() { local d=$1; shift; if "$@"; then ok "$d"; else bad "$d"; fi; }
    refuse() { local d=$1; shift; if "$@"; then bad "control: $d"; else ok "control: $d"; fi; }
    same() { [ "$1" = "$2" ]; }
    echo "Docs intro close-out pre log"
    echo "run started $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "attempt 2: attempt 1 (<phase>/superseded/pre-1.log, script close-pre-1.sh) ran its U+2014 grep as a PCRE pattern, which git grep refuses under LC_ALL=C, so its check counted 0 without testing; its control said no. This attempt greps the three bytes as a fixed string."
    echo "script sha256: $(sha256sum <"$0" | cut -d' ' -f1)"
    echo "## this script, as run"
    sed 's/^/    /' "$0"
    echo
    BASE=$(git rev-parse --verify 635aaba^{commit})
    HEAD_AT=$(git rev-parse HEAD)
    echo "## the range"
    echo "  base (the remote's main at the last push): $BASE"
    echo "  HEAD: $HEAD_AT"
    echo "command: git log --reverse --format='%H %P %s' <base>..HEAD"
    git log --reverse --format='%H %P %s' "$BASE..HEAD" | sed 's/^/  /'
    n=$(git rev-list --count "$BASE..HEAD")
    echo "  commits: $n"
    check "the range is a straight line (every commit has one parent)" same "$(git rev-list --min-parents=2 "$BASE..HEAD" | wc -l)" 0
    check "the first three are the Milestone 8 commits 5df377c, 031732b, e9dcaac" same "$(git rev-list --reverse --abbrev-commit --abbrev=7 "$BASE..HEAD" | head -n 3 | tr '\n' ' ')" "5df377c 031732b e9dcaac "
    check "HEAD's subject is this close-out's doc commit" same "$(git log -1 --format=%s HEAD)" "Docs intro close-out: commit planning docs (P1's verification and ruling G)"
    echo
    echo "## the remote"
    echo "command: git ls-remote origin refs/heads/main"
    rm_main=$(git ls-remote origin refs/heads/main | cut -f1)
    echo "  origin main: ${rm_main:-none}"
    check "origin's main is still 635aaba" same "$rm_main" "$BASE"
    refuse "the same comparison against HEAD" same "$rm_main" "$HEAD_AT"
    echo "command: git ls-remote --tags origin, count"
    echo "  tags at origin: $(git ls-remote --tags origin | wc -l)"
    echo
    echo "## the messages"
    msg_ok() { local m; m=$(git log -1 --format=%B "$1"); [ "$(printf '%s' "$m" | grep -c '[^ -~]')" = 0 ] && [ "$(printf '%s\n' "$m" | grep -c -E '^(Co-Authored-By|Claude-Session):')" = 1 ] && [ "$(printf '%s\n' "$m" | tail -n 1)" = "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>" ]; }
    for c in $(git rev-list --reverse "$BASE..HEAD"); do
      check "$(git log -1 --format=%h "$c"): ASCII, ending with the Co-Authored-By line alone" msg_ok "$c"
    done
    printf 'x\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: x\n' >"$HOME/.cache/emend-build/docs-intro-close/msg-control.txt"
    ctl_ok() { local m; m=$(cat "$1"); [ "$(printf '%s\n' "$m" | grep -c -E '^(Co-Authored-By|Claude-Session):')" = 1 ] && [ "$(printf '%s\n' "$m" | tail -n 1)" = "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>" ]; }
    refuse "the same test over a message with a Claude-Session line" ctl_ok "$HOME/.cache/emend-build/docs-intro-close/msg-control.txt"
    echo
    echo "## U+2014 over the range's tree at HEAD and the gate's hygiene on the committed tree"
    dash_files() { git grep -c -F $'\xe2\x80\x94' "$1" -- . | wc -l; }
    d=$(dash_files HEAD)
    echo "  files holding U+2014 at HEAD: $d"
    check "no file at HEAD holds U+2014" same "$d" 0
    echo "  the superseded 25ceb42: $(dash_files 25ceb42) file(s)"
    refuse "the same form at the superseded 25ceb42 finds one" same "$(dash_files 25ceb42)" 0
    echo "command: bash scripts/check.sh --only hygiene"
    bash scripts/check.sh --only hygiene >"$HOME/.cache/emend-build/docs-intro-close/hygiene.out" 2>&1
    h=$?
    sed 's/^/    /' "$HOME/.cache/emend-build/docs-intro-close/hygiene.out"
    check "the gate's hygiene passes at HEAD (exit 0)" same "$h" 0
    echo
    echo "## the privacy scan over the range"
    echo "command: bash scripts/privacy.sh --range <base>..HEAD"
    bash scripts/privacy.sh --range "$BASE..HEAD" >"$HOME/.cache/emend-build/docs-intro-close/privacy.out" 2>&1
    pr=$?
    sed "s#$HOME#<home>#g" "$HOME/.cache/emend-build/docs-intro-close/privacy.out" | sed 's/^/    /'
    check "the privacy scan passes (exit 0)" same "$pr" 0
    echo
    echo "## the tree"
    st=$(git status --porcelain | wc -l)
    echo "  status lines: $st"
    git status --porcelain | sed 's/^/    /'
    check "the tree is clean" same "$st" 0
    echo
    echo "  checks and controls not as expected: $FAILS"
    echo "run ended $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ "$FAILS" -eq 0 ]; then echo "pre log checks all as expected: yes"; else echo "pre log checks all as expected: no"; fi

