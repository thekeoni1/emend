    done
    refuse "the same message form for a hash it does not carry" grep -q -x -F "ROADMAP.md sha256 0000" <(git log -1 --format=%B "$DOC")
    echo
    
    echo "## the texts: the README block, the example, the crate doc, the tail, the citations, the three crates"
    mkdir -p "$RUN/text"
