    echo "  HEAD at run: $HEAD_AT"
    echo "  status: $(git status --porcelain | wc -l) lines"
    git status --porcelain | sed 's/^/    /'
    check "the base is e9dcaac, the M8 part 3 P4 record" same "$(git log -1 --format='%h %s' --abbrev=7 "$BASE")" "e9dcaac M8 part 3 P4 record: the publication verified"
    check "the doc commit's subject" same "$(git log -1 --format=%s "$DOC")" "Docs intro P1: commit planning docs (the spec, M8 part 3 P4's verification)"
    check "the first code commit's subject" same "$(git log -1 --format=%s "$CODE1")" "Docs intro P1: the README's opening and the crate docs' example"
    check "the second code commit's subject (change 1)" same "$(git log -1 --format=%s "$CODE")" "Docs intro P1 change 1: the crate docs keep the openpyxl paragraph's first sentence"
    check "the two code commits and the doc commit each have one parent" same "$(git log -1 --format=%P "$CODE" | wc -w) $(git log -1 --format=%P "$CODE1" | wc -w) $(git log -1 --format=%P "$DOC" | wc -w)" "1 1 1"
    refuse "same over two different strings" same "a" "b"
    echo
    
    echo "## Acceptance 1: the files each commit changes"
    echo "command: git diff --name-only <doc commit> <code commit> (both code commits); the same over each code commit alone and over <base> <doc commit>"
    code_files=$(git diff --name-only "$DOC" "$CODE" | tr '\n' ' ')
    code1_files=$(git diff --name-only "$DOC" "$CODE1" | tr '\n' ' ')
    code2_files=$(git diff --name-only "$CODE1" "$CODE" | tr '\n' ' ')
    echo "  first code commit: $code1_files"
    echo "  change 1: $code2_files"
    doc_files=$(git diff --name-only "$BASE" "$DOC" | tr '\n' ' ')
    echo "  both code commits: $code_files"
    echo "  doc commit: $doc_files"
    git diff --stat "$DOC" "$CODE" | sed 's/^/    /'
    check "the two code commits name README.md and crates/emend/src/lib.rs and nothing else" same "$code_files" "README.md crates/emend/src/lib.rs "
    check "the first code commit names the same two files" same "$code1_files" "README.md crates/emend/src/lib.rs "
    check "change 1 names crates/emend/src/lib.rs alone" same "$code2_files" "crates/emend/src/lib.rs "
    check "the doc commit names the three planning files and nothing else" same "$doc_files" "ROADMAP.md specs/0049-excel-check-and-release.md specs/0050-newcomer-intro.md "
    refuse "the code commit's form over the doc commit gives a different list" same "$doc_files" "README.md crates/emend/src/lib.rs "
    echo "command: git show <doc commit>:<path> | sha256sum, for each planning file, and the doc commit message's line for it"
    for f in specs/0050-newcomer-intro.md specs/0049-excel-check-and-release.md ROADMAP.md; do
