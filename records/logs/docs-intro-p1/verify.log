    #!/usr/bin/env bash
    # Docs intro P1 (specs/0050-newcomer-intro.md): the verify log.
    #
    # Usage: RUN_DIR=<a directory that does not exist> bash docs-intro-p1-verify.sh <code commit>
    #
    # <code commit> is the phase's last code commit, change 1 (planning's
    # ruling C on the stop report); its parent is the first code commit, whose
    # parent is the doc commit, whose parent is the base e9dcaac. The texts are
    # read at <code commit>. Proves: Acceptance 1 (the two code commits' files), the README text and
    # the example rules (the README block equals the doc test's visible lines),
    # Acceptance 3 (the README tail from "## Dependencies and features" byte for
    # byte as at the base), rules 1 to 3 (the figures in their cited records by
    # grep -n -F; the two crates' descriptions read from their crate files; the
    # umya line rests on its record), Acceptance 4 (no U+2014; the privacy scan
    # over the range) and Acceptance 2 (scripts/check.sh on both targets, the doc
    # test run and printed on each, a planted defect that makes it fail, and the
    # budget at 456248, a difference a FINDING line).
    #
    # Every check prints "<what>: as-expected" or "<what>: no"; every control
    # prints "control: <what>: as-expected" or "control: <what>: no". The last
    # line says whether every check and control was as expected. Placeholders:
    # <repo> the repository, <run> RUN_DIR, <home> the home directory.
    set -uo pipefail
    export PYTHONDONTWRITEBYTECODE=1
    export CARGO_NET_OFFLINE=true
    export CARGO_TERM_COLOR=never
    export RUSTUP_AUTO_INSTALL=0
    export LC_ALL=C
    
    CODE_ARG=${1:-}
    RUN=${RUN_DIR:-}
    if [ -z "$CODE_ARG" ] || [ -z "$RUN" ]; then
      echo "usage: RUN_DIR=<new dir> bash docs-intro-p1-verify.sh <code commit>" >&2
      exit 2
    fi
    if [ -e "$RUN" ]; then
      echo "RUN_DIR exists; each run takes a new directory" >&2
      exit 2
    fi
    mkdir -p "$RUN" || exit 2
    REPO=$HOME/emend
    cd "$REPO" || exit 2
    
    FAILS=0
    FINDINGS=0
    ok() { echo "  $1: as-expected"; }
    bad() { echo "  $1: no"; FAILS=$((FAILS + 1)); }
    # check <what> <command...>: the command succeeds.
    check() { local d=$1; shift; if "$@"; then ok "$d"; else bad "$d"; fi; }
    # accept <what> <command...>: a control that must succeed.
    accept() { local d=$1; shift; if "$@"; then ok "control: $d"; else bad "control: $d"; fi; }
    # refuse <what> <command...>: a control that must fail.
    refuse() { local d=$1; shift; if "$@"; then bad "control: $d"; else ok "control: $d"; fi; }
    finding() { echo "FINDING: $1"; FINDINGS=$((FINDINGS + 1)); }
    same() { [ "$1" = "$2" ]; }
    
    echo "Docs intro P1 verify log (specs/0050-newcomer-intro.md)"
    echo "run started $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "invocation: RUN_DIR=<run> bash <phase>/scripts/docs-intro-p1-verify.sh $CODE_ARG"
    echo "script sha256: $(sha256sum <"$0" | cut -d' ' -f1)"
    echo
    echo "## this script, as run"
    sed 's/^/    /' "$0"
    echo
    
    echo "## the environment"
    if [ -n "${ANTHROPIC_API_KEY+set}" ]; then bad "ANTHROPIC_API_KEY is unset"; else ok "ANTHROPIC_API_KEY is unset"; fi
    for v in CARGO_REGISTRY_TOKEN CARGO_REGISTRIES_CRATES_IO_TOKEN; do
      if [ -n "${!v+set}" ]; then bad "$v is unset"; else ok "$v is unset"; fi
    done
    echo "  rustc: $(rustc --version)"
    echo "  cargo: $(cargo --version)"
    echo "  python3: $(python3 --version 2>&1)"
