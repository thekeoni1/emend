    grep -n -F '3.1.0' "$RUN/text/decision.md" | head -n 5 | sed 's/^/    /'
    check "records/decision-architecture.md names umya-spreadsheet 3.1.0" grep -q -F 'umya-spreadsheet 3.1.0' "$RUN/text/decision.md"
    refuse "the same form for a version it does not name" grep -q -F 'umya-spreadsheet 9.9.9' "$RUN/text/decision.md"
    echo
    
    echo "## rule 2: the two crates' descriptions, read from their crate files"
    echo "(downloaded into <run>/crates, read-only reference material; nothing is copied into the repository)"
    mkdir -p "$RUN/crates"
    cat >"$RUN/crates/pick.py" <<'PY'
    import json, sys
    # The newest version in a sparse index file: the greatest semver among the
    # non-yanked, non-pre-release lines. Prints "<version> <cksum> <lines> <yanked>".
    lines = [json.loads(l) for l in open(sys.argv[1], encoding="utf-8") if l.strip()]
    def key(v):
        return tuple(int(x) for x in v.split("+")[0].split("."))
    ok = [e for e in lines if not e["yanked"] and "-" not in e["vers"]]
    best = max(ok, key=lambda e: key(e["vers"]))
    print(best["vers"], best["cksum"], len(lines), sum(e["yanked"] for e in lines))
    PY
    cat >"$RUN/crates/manifest.py" <<'PY'
    import sys, tarfile
    # Writes <name>-<version>/Cargo.toml of a crate file to the given path.
    src, member, dst = sys.argv[1:4]
    with tarfile.open(src, "r:gz") as t:
        data = t.extractfile(member).read()
    open(dst, "wb").write(data)
    PY
    for name in calamine rust_xlsxwriter; do
      idx=$RUN/crates/$name.index
      url="https://index.crates.io/$(printf %s "$name" | cut -c1-2)/$(printf %s "$name" | cut -c3-4)/$name"
      echo "command: curl -sS --fail -A emend-docs-check $url"
      code=$(curl -sS --fail -A emend-docs-check -o "$idx" -w '%{http_code}' "$url" 2>"$RUN/crates/$name.index.err")
      echo "  HTTP $code; $(wc -c <"$idx" 2>/dev/null || echo 0) bytes"
      check "$name: the index entry was read (HTTP 200)" same "$code" 200
      read -r ver ck nl ny < <(python3 -I -B "$RUN/crates/pick.py" "$idx" 2>/dev/null) || true
      echo "  index lines ${nl:-none}, yanked ${ny:-none}; the newest version ${ver:-none}, cksum ${ck:-none}"
      crate=$RUN/crates/$name-${ver:-none}.crate
      echo "command: curl -sS --fail -A emend-docs-check https://static.crates.io/crates/$name/$name-${ver:-none}.crate"
      code=$(curl -sS --fail -A emend-docs-check -o "$crate" -w '%{http_code}' "https://static.crates.io/crates/$name/$name-${ver:-none}.crate" 2>"$RUN/crates/$name.crate.err")
      sum=$(sha256sum <"$crate" 2>/dev/null | cut -d' ' -f1)
      echo "  HTTP $code; $(wc -c <"$crate" 2>/dev/null || echo 0) bytes; sha256 ${sum:-none}"
      check "$name $ver: the crate file was read (HTTP 200)" same "$code" 200
      check "$name $ver: the crate file's sha256 is the index's cksum" same "${sum:-x}" "${ck:-y}"
      chmod a-w "$crate" "$idx"
      python3 -I -B "$RUN/crates/manifest.py" "$crate" "$name-$ver/Cargo.toml" "$RUN/crates/$name-Cargo.toml" 2>"$RUN/crates/$name.toml.err"
      echo "command: grep -n -A2 '^description' <run>/crates/$name-$ver/Cargo.toml"
      grep -n -A2 '^description' "$RUN/crates/$name-Cargo.toml" | sed 's/^/    /'
      desc=$(grep '^description' "$RUN/crates/$name-Cargo.toml")
      case $name in
        calamine) word=read; claim="a reader" ;;
        *) word=writ; claim="a writer" ;;
      esac
      if printf '%s\n' "$desc" | grep -q -i -F "$word"; then
        ok "$name $ver: its description supports the README line ($claim; it holds '$word')"
      else
        finding "$name $ver: its description does not support the README line ($claim); the phase stops (specs/0050 rule 2)"
        bad "$name $ver: its description supports the README line"
      fi
    done
    refuse "the description test refuses a description without the word" grep -q -i -F writ <(echo 'description = "A pure Rust Excel/OpenDocument SpreadSheets file reader"')
    echo
    
    echo "## Acceptance 4: the commit messages and the privacy scan over the range"
    for c in "$DOC" "$CODE1" "$CODE"; do
      m=$(git log -1 --format=%B "$c")
      check "$(git log -1 --format=%h "$c")'s message is ASCII" same "$(printf '%s' "$m" | grep -c '[^ -~]')" 0
      check "$(git log -1 --format=%h "$c")'s message ends with the Co-Authored-By line alone" same "$(printf '%s\n' "$m" | grep -c -E '^(Co-Authored-By|Claude-Session):')/$(printf '%s\n' "$m" | tail -n 1)" "1/Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>"
    done
    refuse "the ASCII test over a planted U+2014" same "$(printf 'a \xe2\x80\x94 b' | grep -c '[^ -~]')" 0
    echo "command: bash scripts/privacy.sh --range <base>..<code commit>"
    bash scripts/privacy.sh --range "$BASE..$CODE" >"$RUN/privacy.out" 2>&1
    p_rc=$?
    sed -e "s#$RUN#<run>#g" -e "s#$HOME#<home>#g" "$RUN/privacy.out" | sed 's/^/    /'
    check "the privacy scan over the range passes (exit 0)" same "$p_rc" 0
    echo
    
    echo "## Acceptance 2: the gate, the doc test on each target, a planted defect, the budget"
    T=$RUN/target
    echo "command: CARGO_TARGET_DIR=<run>/target bash scripts/check.sh"
    CARGO_TARGET_DIR=$T bash scripts/check.sh >"$RUN/check.out" 2>"$RUN/check.err"
    g_rc=$?
    sed 's/^/    /' "$RUN/check.out"
    echo "  exit $g_rc; stderr $(wc -c <"$RUN/check.err") bytes"
    sed -e "s#$RUN#<run>#g" -e "s#$HOME#<home>#g" "$RUN/check.err" | sed 's/^/    /'
    check "the gate passes (exit 0)" same "$g_rc" 0
    check "the gate printed PASS for each of its nine steps" same "$(grep -c -E '^PASS (host|i686|fmt|clippy|doc|native|licences|hygiene|privacy)( \(.*\))?$' "$RUN/check.out")" 9
    printf 'PASS host\nPASS i686\nPASS fmt\nPASS clippy\nFAIL doc: x\n' >"$RUN/check-control.out"
    refuse "the same count over a gate output that stopped at doc reaches nine" same "$(grep -c -E '^PASS (host|i686|fmt|clippy|doc|native|licences|hygiene|privacy)( \(.*\))?$' "$RUN/check-control.out")" 9
    doc_ok() { [ "$(grep -c -E '^test crates/emend/src/lib.rs - \(line [0-9]+\) \.\.\. ok$' "$1")" = 1 ] && grep -q -E '^test result: ok\. 1 passed; 0 failed;' "$1"; }
    for tgt in host i686-unknown-linux-musl; do
      if [ "$tgt" = host ]; then targ=(); else targ=(--target "$tgt"); fi
      echo "command: CARGO_TARGET_DIR=<run>/target cargo test -p emend --doc ${targ[*]}"
      CARGO_TARGET_DIR=$T cargo test -p emend --doc "${targ[@]}" >"$RUN/doc-$tgt.out" 2>&1
      rc=$?
      grep -E '^(running|test |test result:)' "$RUN/doc-$tgt.out" | sed 's/^/    /'
      echo "  exit $rc"
      check "the doc test ran and passed on $tgt" doc_ok "$RUN/doc-$tgt.out"
    done
    printf 'test crates/emend/src/lib.rs - (line 43) ... FAILED\ntest result: FAILED. 0 passed; 1 failed;\n' >"$RUN/doc-control.out"
    refuse "the same test over a failed doc test's output" doc_ok "$RUN/doc-control.out"
    # plant <n> <mode> <expected text>: the code commit's tree in <run>/planted-<n>
    # with one line of the doc test changed, the doc test run there; it must fail
    # and print the expected text. mode remove: the set_cell line removed (the
    # read-back finds no cell); mode value: its text "checked" made "other" (the
    # read-back's assertion fails).
    plant() {
      local n=$1 mode=$2 want=$3 d=$RUN/planted-$1 rc
      echo "command: git archive <code commit> into <run>/planted-$n; the doc test's set_cell line: $mode; CARGO_TARGET_DIR=<run>/planted-target cargo test -p emend --doc there"
      mkdir -p "$d"
      git archive "$CODE" | tar -x -C "$d"
      python3 -I -B - "$d/crates/emend/src/lib.rs" "$mode" <<'PY'
    import sys
    p, mode = sys.argv[1:3]
    L = open(p, encoding="utf-8").read().split("\n")
    hit = [n for n, l in enumerate(L) if l.startswith("//!") and "book.set_cell(&sheet, cell" in l]
    assert len(hit) == 1, hit
    if mode == "remove":
        del L[hit[0]]
    else:
        assert L[hit[0]].count('"checked"') == 1
        L[hit[0]] = L[hit[0]].replace('"checked"', '"other"')
    open(p, "w", encoding="utf-8").write("\n".join(L))
    print(f"    line {hit[0] + 1}: {mode}")
    PY
      ( cd "$d" && CARGO_TARGET_DIR=$RUN/planted-target cargo test -p emend --doc ) >"$d.out" 2>&1
      rc=$?
      grep -E '^(test |test result:|Error: )|assertion' "$d.out" | sed "s#$RUN#<run>#g" | sed 's/^/    /'
      echo "  exit $rc"
      check "control: the doc test fails with the line's $mode, printing '$want'" same "$([ "$rc" -ne 0 ] && grep -q -F -- "$want" "$d.out" && echo bites)" bites
    }
    plant 1 remove 'Error: "no cell"'
    plant 2 value 'assertion `left == right` failed'
    echo "command: CARGO_TARGET_DIR=<run>/target cargo build -p size-probe --bin probe-emend-format-write-xml --features emend,xml --profile size --target i686-unknown-linux-musl"
    CARGO_TARGET_DIR=$T cargo build -p size-probe --bin probe-emend-format-write-xml --features emend,xml --profile size --target i686-unknown-linux-musl >"$RUN/format-build.out" 2>&1
    f_rc=$?
    grep -E '^(warning|error)(\[|:)' "$RUN/format-build.out" | sed 's/^/    /'
    echo "  the build: exit $f_rc"
    check "the format probe's size-profile build on i686 exits 0" same "$f_rc" 0
    section_total() { size -A "$1" 2>/dev/null | awk '$1 == "Total" { print $2 }'; }
    BIN=$T/i686-unknown-linux-musl/size/probe-emend-format-write-xml
    fs=$(section_total "$BIN")
    echo "  <run>/target/i686-unknown-linux-musl/size/probe-emend-format-write-xml: file $(wc -c <"$BIN" 2>/dev/null || echo none) bytes; sections ${fs:-none}; sha256 $(sha256sum <"$BIN" 2>/dev/null | cut -d' ' -f1)"
    check "a section total was read" [ -n "$fs" ]
    accept "section_total over this shell, same command form, reads a figure" [ -n "$(section_total "$(command -v bash)")" ]
    SR=records/size-m8p2-2026-11-10-8065795.md
    record_probe() { awk -F ' [|] ' -v p="| \`$2\` | " 'index($0, p) == 1 && NF == 7 { print $5; exit }' "$1"; }
    git show "$CODE:$SR" >"$RUN/size-record.md"
    zx=$(record_probe "$RUN/size-record.md" probe-zip-xml)
    fr=$(record_probe "$RUN/size-record.md" probe-emend-format-write-xml)
    echo "command: git show <code commit>:$SR, its verdicts table's rows for probe-zip-xml and the format probe"
    echo "  probe-zip-xml: ${zx:-none}; the format probe: ${fr:-none}"
    check "the record's probe-zip-xml figure was read" [ -n "$zx" ]
    REQ=456248
    if [ -n "$fs" ] && [ -n "$zx" ]; then
      budget=$((fs - zx))
      echo "  the budget, the format probe less probe-zip-xml: $fs - $zx = $budget; required by planning's brief: $REQ; the ceiling 458752, $((458752 - budget)) under it"
      if [ "$budget" = "$REQ" ]; then
        ok "the budget is $REQ"
      else
        finding "the budget is $budget, not $REQ (specs/0050 Acceptance 2); recorded, not a rerun"
      fi
    fi
    echo
    
    echo "## summary"
    echo "  FINDING lines: $FINDINGS"
    echo "  checks and controls not as expected: $FAILS"
    echo "run ended $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ "$FAILS" -eq 0 ]; then echo "verify log checks all as expected: yes"; else echo "verify log checks all as expected: no"; fi

