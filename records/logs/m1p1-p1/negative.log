## script
    #!/usr/bin/env bash
    # Milestone 1 part 1 P1 negative.log (specs/0008-zip-layer.md, "P1"): the
    # widened leftover check working, and emend-copy's exit codes and refusals.
    #
    # Two families of case:
    #
    #  L1 to L4, planning's ruling of 2026-09-16 (specs/0006-passthrough.md,
    #  "Planning ruling for Milestone 1 part 1 P1: the leftover glob"). The runner's
    #  two leftover globs named only the passthrough tool's temporary, so for any
    #  other tool the summary's leftover column read no whatever happened. A
    #  stand-in tool given through --passthrough exercises the widened glob: one
    #  leaving the new form, one leaving the OLD passthrough- form as a regression
    #  pin, one leaving nothing, and one with a stale temporary planted before the
    #  run. No fault hook is added to emend-copy for this; the stand-in exercises
    #  the runner.
    #
    #  E1 to E8, emend-copy's own exit codes and refusals, on GENERATED archives
    #  only. No corpus file is copied or read: every fixture here is built by the
    #  inline generator below (planning's ruling of 2026-09-16, carried from T3 P4).
    #
    # Every case runs in a scratch clone under <scratch>, never in the main working
    # tree, with the binaries the gate built copied in; gate.log prints the same
    # four hashes.
    #
    # Usage: m1p1-negative.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m1p1-p1/negative.log. No absolute path, no host name
    # and no corpus name is printed: scratch locations are written <scratch>.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    B=$(mktemp -d)
    trap 'rm -rf "$B"' EXIT INT TERM HUP
    fail=0
    note() { echo "  $1: $2"; [ "$2" = as-expected ] || fail=1; }
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    # Rewrites the scratch base out of any captured text, so no absolute path is
    # printed even when a tool echoes one.
    hide() { sed "s#$B#<scratch>#g; s#$MAIN#<repo>#g"; }
    
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    
    echo "command: git rev-parse HEAD"
    echo "about: M1 part 1 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: Milestone 1 part 1 P1 (specs/0008-zip-layer.md) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    echo "SERIALIZED: produced with no other run in flight"
    echo "every fixture is generated; no corpus file is copied or read"
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scratch clone and the gate's binaries"
    echo "command: git clone --quiet --shared <repo> <scratch>/clone"
    git clone --quiet --shared "$MAIN" "$B/clone" 2>&1 | hide | sed 's/^/    /'
    CLONE=$B/clone
    clone_head=$(git -C "$CLONE" rev-parse HEAD)
    echo "  clone HEAD: $clone_head"
    note "the clone is at the phase commit" "$(is [ "$clone_head" = "$C" ])"
    mkdir -p "$CLONE/target/debug" "$CLONE/target/i686-unknown-linux-musl/debug"
    bins_ok=yes
    for b in target/debug/emend-copy target/debug/xlsx-diff \
             target/i686-unknown-linux-musl/debug/emend-copy \
             target/i686-unknown-linux-musl/debug/xlsx-diff; do
      if cp "$MAIN/$b" "$CLONE/$b" 2>/dev/null; then
        echo "  copied $b: sha256 $(sha256sum <"$CLONE/$b" | cut -d' ' -f1), bytes $(wc -c <"$CLONE/$b")"
      else
        echo "  copied $b: FAILED"
        bins_ok=no
      fi
    done
    note "all four binaries were copied in and are executable" \
      "$(is [ "$bins_ok" = yes ] && [ -x "$CLONE/target/debug/emend-copy" ] && [ -x "$CLONE/target/debug/xlsx-diff" ])"
    
    # The binary built from the commit the checks read, kept before the repair so
    # the defect can still be measured after it. Its path is given through
    # OLD_BIN so this log never prints one.
    OLD=""
    if [ -n "${OLD_BIN:-}" ] && [ -r "${OLD_BIN:-/nonexistent}" ]; then
      cp "$OLD_BIN" "$B/old-emend-copy" && chmod 755 "$B/old-emend-copy" && OLD=$B/old-emend-copy
    fi
    if [ -n "$OLD" ]; then
      echo "  the pre-repair binary: sha256 $(sha256sum <"$OLD" | cut -d' ' -f1), bytes $(wc -c <"$OLD")"
    else
      echo "  the pre-repair binary was not supplied"
    fi
    note "the pre-repair binary is available, so the defect can be measured" "$(is [ -n "$OLD" ])"
    echo "  (gate.log prints these same four hashes; nothing is rebuilt here)"
    echo "  every command below runs in <scratch>/clone"
    
    echo
    echo "## the generated corpus"
    cat >"$B/gen.py" <<'GEN_PY'
    import hashlib, os, struct, sys, zipfile
    
    base, corpus = sys.argv[1:3]
    os.makedirs(os.path.join(corpus, "corpus"), mode=0o700, exist_ok=True)
    
    CT = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
          '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
          '<Default Extension="xml" ContentType="application/xml"/></Types>')
    WB = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
          '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
          '<sheets><sheet name="S" sheetId="1"/></sheets></workbook>')
    
    
    def sound(path):
        """A small, valid archive: one stored entry and one deflated."""
        with zipfile.ZipFile(path, "w") as z:
            z.writestr("[Content_Types].xml", CT, zipfile.ZIP_STORED)
            z.writestr("xl/workbook.xml", WB, zipfile.ZIP_DEFLATED)
    
    
    def ident(path):
        return hashlib.sha256(open(path, "rb").read()).hexdigest()
    
    
    made = []
    # ONE workbook the runner sees. Only sound archives go in the manifest: the
    # refusal fixtures are for emend-copy directly, not for a corpus run.
    #
    # One and not two, deliberately. An earlier version of this generator built
    # two with identical content, so both took the same id (the id is the first
    # twelve hex digits of the content hash) and the second overwrote the first,
    # leaving a manifest of two rows naming one file. One entry also keeps the
    # summary to a single data row, so reading the leftover column cannot quietly
    # report on one row while ignoring another.
    path = os.path.join(corpus, "corpus", "PLACE.xlsx")
    sound(path)
    entry_id = ident(path)[:12]
    final = os.path.join(corpus, "corpus", entry_id + ".xlsx")
    os.replace(path, final)
    made.append((entry_id, final))
    
    header = ["id", "sha256", "bytes", "ext", "producer", "producer_version",
              "app", "source", "tags", "added", "original_name", "note"]
    rows = ["\t".join(header)]
    for entry_id, path in made:
        rows.append("\t".join([
            entry_id, ident(path), str(os.path.getsize(path)), "xlsx",
            "generated", "0", "none", "generated", "generated", "2026-09-16",
            "generated", "built by this log's generator"]))
    with open(os.path.join(corpus, "manifest.tsv"), "w", newline="\n") as handle:
        handle.write("\n".join(rows) + "\n")
    
    # Fixtures for emend-copy's refusals, outside the manifest.
    sound(os.path.join(base, "sound.xlsx"))
    with open(os.path.join(base, "notzip.xlsx"), "wb") as handle:
        handle.write(b"this is not a zip archive\n" * 8)
    data = open(os.path.join(base, "sound.xlsx"), "rb").read()
    # Tail removed: the central directory and the end-of-central-directory record
    # are gone, so there is nothing to read an offset FROM. This reaches NotZip,
    # not Truncated, and the case below is named for what it is. An earlier
    # version called this fixture "truncated" and asserted only "one error line",
    # so it passed while printing the same message as the not-a-zip case and
    # testing nothing the not-a-zip case did not already test.
    with open(os.path.join(base, "no-tail.xlsx"), "wb") as handle:
        handle.write(data[: len(data) // 2])
    
    # A file whose records are all present but whose first central record points
    # its local header past the end of the file: this is what reaches Truncated.
    # Built as the unit test builds it (crates/emend/src/archive/tests.rs,
    # a_local_offset_beyond_the_file_is_refused): the local header offset is the
    # four bytes at 42 of the central record.
    CENTRAL_SIG = b"\x50\x4b\x01\x02"
    at = data.find(CENTRAL_SIG)
    if at < 0:
        raise SystemExit("no central record in the generated archive")
    bad = bytearray(data)
    bad[at + 42:at + 46] = struct.pack("<I", 0x0000_7FFF)
    with open(os.path.join(base, "bad-offset.xlsx"), "wb") as handle:
        handle.write(bytes(bad))
    # Two central records with the same raw name: written by hand, since no
    # library will build one.
    with zipfile.ZipFile(os.path.join(base, "dup-src.xlsx"), "w") as z:
        z.writestr("a.xml", "one", zipfile.ZIP_STORED)
        z.writestr("b.xml", "two", zipfile.ZIP_STORED)
    raw = open(os.path.join(base, "dup-src.xlsx"), "rb").read()
    raw = raw.replace(b"b.xml", b"a.xml")
    with open(os.path.join(base, "duplicate.xlsx"), "wb") as handle:
        handle.write(raw)
    
    for label, path in (("sound", "sound.xlsx"), ("notzip", "notzip.xlsx"),
                        ("no-tail", "no-tail.xlsx"), ("bad-offset", "bad-offset.xlsx"),
                        ("duplicate", "duplicate.xlsx")):
        full = os.path.join(base, path)
        print("%s: %d bytes" % (label, os.path.getsize(full)))
    for entry_id, path in made:
        print("corpus entry %s: %d bytes" % (entry_id, os.path.getsize(path)))
    GEN_PY
    echo "command: python3 <scratch>/gen.py <scratch> <scratch>/corpus"
    python3 "$B/gen.py" "$B" "$B/corpus" >"$B/gen.out" 2>&1
    grc=$?
    hide <"$B/gen.out" | sed 's/^/    /'
    note "the generator exits 0" "$(is [ "$grc" -eq 0 ])"
    nrows=$(count_lines "$B/corpus/manifest.tsv")
    echo "  manifest lines including the header: $nrows"
    note "the manifest has a header and one row" "$(is [ "$nrows" = 2 ])"
    
    echo
    echo "## the stand-in tools"
    # Three one-line copy tools, so the runner is exercised rather than
    # emend-copy. Each writes the output and then leaves (or does not leave) a
    # temporary beside it, in the shape its name says.
    for suffix in stand-in passthrough none; do
      cat >"$B/stand-in-$suffix" <<STANDIN
    #!/usr/bin/env bash
    set -u
    cp -- "\$1" "\$2" || exit 2
    if [ "$suffix" != none ]; then
      d=\$(dirname -- "\$2"); b=\$(basename -- "\$2")
      : >"\$d/.\$b.$suffix-\$\$.tmp" || exit 2
    fi
    exit 0
    STANDIN
      chmod 755 "$B/stand-in-$suffix"
    done
    note "three stand-in tools are executable" \
      "$(is [ -x "$B/stand-in-stand-in" ] && [ -x "$B/stand-in-passthrough" ] && [ -x "$B/stand-in-none" ])"
    
    XD=$CLONE/target/debug/xlsx-diff
    EC=$CLONE/target/debug/emend-copy
    
    # leftover_of <summary file>: the value of the leftover column, computed from
    # the header rather than a counted index (column 22 of 24 today).
    leftover_of() {
      awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "leftover") c = i; next }
                  c && NR == 2 { print $c }' "$1"
    }
    outcome_of() {
      awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "outcome") c = i; next }
                  c && NR == 2 { print $c }' "$1"
    }
    
    run_case() {
      local label=$1 tool=$2 out=$3
      ( cd "$CLONE" && scripts/passthrough-run.sh --label host --passthrough "$tool" \
          --xlsx-diff "$XD" --corpus "$B/corpus" --out "$out" --timeout 60 ) \
        >"$B/$label.out" 2>"$B/$label.err"
      echo $?
    }
    
    echo
    echo "## L1: a stand-in leaving the NEW temporary form is caught"
    RC=$(run_case L1 "$B/stand-in-stand-in" "$B/run-L1")
    echo "command: scripts/passthrough-run.sh --label host --passthrough <scratch>/stand-in-stand-in --xlsx-diff <repo binary> --corpus <scratch>/corpus --out <scratch>/run-L1 --timeout 60"
    echo "  exit: $RC"
    hide <"$B/L1.out" | sed 's/^/    /'
    l1_leftover=$(leftover_of "$B/run-L1/summary.host.tsv")
    l1_outcome=$(outcome_of "$B/run-L1/summary.host.tsv")
    l1_rest=$(find "$B/run-L1" -name '.out.host.xlsx.*.tmp' | wc -l)
    echo "  outcome: $l1_outcome; leftover: $l1_leftover; temporary files still present: $l1_rest"
    note "L1 the run exits 0" "$(is [ "$RC" -eq 0 ])"
    note "L1 leftover is yes, the widened glob catching a tool that is not passthrough" "$(is [ "$l1_leftover" = yes ])"
    note "L1 the temporary was removed by the runner" "$(is [ "$l1_rest" -eq 0 ])"
    
    echo
    echo "## L2: the OLD passthrough- form is still caught (the regression pin)"
    RC=$(run_case L2 "$B/stand-in-passthrough" "$B/run-L2")
    echo "  exit: $RC"
    l2_leftover=$(leftover_of "$B/run-L2/summary.host.tsv")
    l2_rest=$(find "$B/run-L2" -name '.out.host.xlsx.*.tmp' | wc -l)
    echo "  leftover: $l2_leftover; temporary files still present: $l2_rest"
    note "L2 leftover is yes for the old form too" "$(is [ "$l2_leftover" = yes ])"
    note "L2 the temporary was removed" "$(is [ "$l2_rest" -eq 0 ])"
    
    echo
    echo "## L3: a tool leaving nothing reports no"
    # The control for L1 and L2: the column is not stuck at yes.
    RC=$(run_case L3 "$B/stand-in-none" "$B/run-L3")
    echo "  exit: $RC"
    l3_leftover=$(leftover_of "$B/run-L3/summary.host.tsv")
    echo "  leftover: $l3_leftover"
    note "L3 leftover is no when nothing is left behind" "$(is [ "$l3_leftover" = no ])"
    
    echo
    echo "## L4: a STALE temporary planted before the run is cleared, and leftover stays no"
    # The clearing step runs before the child, so a file from an earlier, stopped
    # run is removed and does not count as this child's. This is the case the
    # passthrough backlog item "stale-temporary-file removal has no negative case"
    # asks for.
    first_id=$(awk -F'\t' 'NR == 2 { print $1 }' "$B/corpus/manifest.tsv")
    mkdir -p "$B/run-L4/$first_id"
    : >"$B/run-L4/$first_id/.out.host.xlsx.emend-copy-1.tmp"
    planted_before=$(find "$B/run-L4/$first_id" -name '.out.host.xlsx.emend-copy-1.tmp' | wc -l)
    echo "  planted before the run: $planted_before"
    RC=$(run_case L4 "$B/stand-in-none" "$B/run-L4")
    echo "  exit: $RC"
    l4_leftover=$(leftover_of "$B/run-L4/summary.host.tsv")
    planted_after=$(find "$B/run-L4/$first_id" -name '.out.host.xlsx.emend-copy-1.tmp' | wc -l)
    echo "  leftover: $l4_leftover; the planted file after the run: $planted_after"
    note "L4 the planted stale temporary existed before the run" "$(is [ "$planted_before" -eq 1 ])"
    note "L4 the clearing step removed it" "$(is [ "$planted_after" -eq 0 ])"
    note "L4 leftover stays no, since only this child's file counts" "$(is [ "$l4_leftover" = no ])"
    
    echo
    echo "## emend-copy: exit codes and refusals on generated archives"
    # ec_case <label> <expected exit> <expected stderr, empty for none> <args...>
    #
    # The whole stderr line is compared, not its "error: " prefix. An earlier
    # version checked only the exit status, that stderr held one line, and that the
    # line began "error: ", while the note beside it said things like "exits 2 with
    # the usage line". Three notes therefore claimed more than the check performed,
    # and the looseness hid a real mislabel: the fixture called "truncated" printed
    # the not-a-zip message, so that case tested nothing the not-a-zip case had not
    # already tested.
    ec_case() {
      local label=$1 expect_rc=$2 expect_err=$3
      shift 3
      "$EC" "$@" >"$B/$label.out" 2>"$B/$label.err"
      local rc=$?
      local errlines got
      errlines=$(count_lines "$B/$label.err")
      got=$(cat "$B/$label.err")
      echo "  $label: exit $rc; stderr lines $errlines"
      hide <"$B/$label.err" | sed 's/^/      /'
      # One function, explicit returns: the nested && and || form is what captured
      # only the first test in T0b P2 and T1 P1 (specs/0001).
      ec_ok() {
        [ "$rc" -eq "$expect_rc" ] || return 1
        [ "$got" = "$expect_err" ] || return 1
        if [ -z "$expect_err" ]; then [ "$errlines" = 0 ]; else [ "$errlines" = 1 ]; fi
      }
      # The sentence must match what was checked. An earlier version said "stderr
      # is exactly the expected line" for the success case too, where the
      # expectation is NO line, so the note was false of a check that was right.
      local said
      if [ -z "$expect_err" ]; then
        said="and says nothing on stderr"
      else
        said="and stderr is exactly the expected line"
      fi
      note "$label exits $expect_rc $said" "$(is ec_ok)"
    }
    
    # The usage text is READ from the committed source at run time, never typed
    # here, so this log cannot keep passing against a string the tool no longer
    # prints (the same rule as the gate log reading OFFICE_RE from check.sh).
    USAGE=$(sed -n 's/^const USAGE: &str = "\(.*\)";$/\1/p' "$MAIN/tools/emend-copy/src/main.rs")
    echo "command: sed -n 's/^const USAGE...//p' tools/emend-copy/src/main.rs"
    echo "  usage text read from the source: [$USAGE]"
    note "the usage text was read from the tool's source and is not empty" "$(is [ -n "$USAGE" ])"
    
    NOT_ZIP='error: no end-of-central-directory record: not a zip archive'
    BEYOND='error: a recorded offset or size lies beyond the file'
    
    echo "command: emend-copy <scratch>/sound.xlsx <scratch>/out-E1.xlsx"
    ec_case E1 0 "" "$B/sound.xlsx" "$B/out-E1.xlsx"
    e1_same=$(cmp -s "$B/sound.xlsx" "$B/out-E1.xlsx" && echo yes || echo no)
    echo "  E1 the output is byte-identical to the input: $e1_same"
    note "E1 a no-edit copy is byte-identical" "$(is [ "$e1_same" = yes ])"
    
    echo "E2: a file that is not a zip archive at all"
    ec_case E2 2 "$NOT_ZIP" "$B/notzip.xlsx" "$B/out-E2.xlsx"
    note "E2 no output file was left" "$(is [ ! -e "$B/out-E2.xlsx" ])"
    
    echo "E3a: a sound archive with its tail removed, so there is no record to read"
    ec_case E3a 2 "$NOT_ZIP" "$B/no-tail.xlsx" "$B/out-E3a.xlsx"
    note "E3a no output file was left" "$(is [ ! -e "$B/out-E3a.xlsx" ])"
    
    echo "E3b: every record present, but a central record points its local header"
    echo "     past the end of the file. This is the case that reaches Truncated,"
    echo "     which no case in this log reached before."
    ec_case E3b 2 "$BEYOND" "$B/bad-offset.xlsx" "$B/out-E3b.xlsx"
    note "E3b no output file was left" "$(is [ ! -e "$B/out-E3b.xlsx" ])"
    
    echo "E4: two central records sharing a raw name"
    ec_case E4 2 'error: two central records share a raw name (entry 1)' "$B/duplicate.xlsx" "$B/out-E4.xlsx"
    note "E4 no output file was left" "$(is [ ! -e "$B/out-E4.xlsx" ])"
    
    echo "E5, E6, E7: one argument, none, and three"
    ec_case E5 2 "error: $USAGE" "$B/sound.xlsx"
    ec_case E6 2 "error: $USAGE"
    ec_case E7 2 "error: $USAGE" "$B/sound.xlsx" "$B/a.xlsx" "$B/b.xlsx"
    
    echo "E8: an output directory that does not exist"
    ec_case E8 2 'error: cannot create the output file: entity not found' "$B/sound.xlsx" "$B/no-such-directory/out.xlsx"
    
    echo
    echo "## P1 to P4: the prefix defect, measured before and after the repair"
    echo "The independent checks of e14dbee found that the layer silently dropped"
    echo "the prefix of an archive whose producer records file-absolute offsets,"
    echo "and that a zip64 archive behind a prefix with an archive-relative locator"
    echo "was refused. Planning reproduced both against its own build before ruling"
    echo "(specs/0008-zip-layer.md, the P1 rulings of 2026-09-17). Four fixtures"
    echo "are built here and run through BOTH binaries, so the defect and the fix"
    echo "are each a measurement rather than a claim."
    echo "The generator is this log's own. It does not use the crate's test"
    echo "builder: a fixture and the code it tests sharing a parent is how the"
    echo "original fixture came to encode the implementation's own convention."
    echo "Every signature it needs is ASSERTED, not guarded: an earlier attempt at"
    echo "these fixtures skipped its zip64 patches behind 'if found >= 0' and"
    echo "silently produced two plain archives, which read as a refutation of"
    echo "planning's measurement when it was a bug in the generator."
    cat >"$B/fixtures.py" <<'FIX_PY'
    import struct, sys, zipfile
    
    w = sys.argv[1]
    STUB = b"MZ" + b"\x00" * 14
    CEN, EOCD = b"PK\x01\x02", b"PK\x05\x06"
    Z64SIG, LOCSIG = 0x06064b50, 0x07064b50
    
    
    def must(cond, msg):
        if not cond:
            raise SystemExit("fixture generator: " + msg)
    
    
    def plain(absolute):
        p = w + "/base-plain.zip"
        with zipfile.ZipFile(p, "w") as z:
            z.writestr("a.txt", "hello", zipfile.ZIP_STORED)
        buf = bytearray(STUB + open(p, "rb").read())
        at, eo = buf.find(CEN), buf.rfind(EOCD)
        must(at > 0 and eo > 0, "plain: no central record or end record")
        if absolute:
            struct.pack_into("<I", buf, at + 42,
                             struct.unpack_from("<I", buf, at + 42)[0] + len(STUB))
            struct.pack_into("<I", buf, eo + 16,
                             struct.unpack_from("<I", buf, eo + 16)[0] + len(STUB))
        return bytes(buf)
    
    
    def zip64(absolute):
        """A real zip64 archive: the end record and the locator are built here."""
        p = w + "/base-z64.zip"
        with zipfile.ZipFile(p, "w") as z:
            z.writestr("a.txt", "hello", zipfile.ZIP_STORED)
        raw = open(p, "rb").read()
        eo = raw.rfind(EOCD)
        must(eo > 0, "zip64: no end record in the base archive")
        cd_size = struct.unpack_from("<I", raw, eo + 12)[0]
        cd_off = struct.unpack_from("<I", raw, eo + 16)[0]
        entries = struct.unpack_from("<H", raw, eo + 10)[0]
        body = bytearray(STUB + raw[:eo])
        base = 0 if absolute else len(STUB)
        cd_abs = len(STUB) + cd_off
        at = body.find(CEN)
        must(at > 0, "zip64: no central record")
        if absolute:
            struct.pack_into("<I", body, at + 42,
                             struct.unpack_from("<I", body, at + 42)[0] + len(STUB))
        z64_at = len(body)
        rec = bytearray()
        rec += struct.pack("<I", Z64SIG) + struct.pack("<Q", 44)
        rec += struct.pack("<HHII", 45, 45, 0, 0)
        rec += struct.pack("<QQQQ", entries, entries, cd_size, cd_abs - base)
        must(len(rec) == 56, "zip64: end record is %d bytes, not 56" % len(rec))
        body += rec
        loc = struct.pack("<IIQI", LOCSIG, 0, z64_at - base, 1)
        must(len(loc) == 20, "zip64: locator is not 20 bytes")
        body += loc
        tail = bytearray(raw[eo:])
        struct.pack_into("<I", tail, 12, 0xFFFFFFFF)
        struct.pack_into("<I", tail, 16, 0xFFFFFFFF)
        body += tail
        out = bytes(body)
        must(out.find(struct.pack("<I", Z64SIG)) >= 0, "zip64: end record missing")
        must(out.find(struct.pack("<I", LOCSIG)) >= 0, "zip64: locator missing")
        return out
    
    
    for name, data, want64 in (("plain-abs", plain(True), False),
                               ("plain-rel", plain(False), False),
                               ("z64-abs", zip64(True), True),
                               ("z64-rel", zip64(False), True)):
        has64 = data.find(struct.pack("<I", Z64SIG)) >= 0
        must(has64 == want64, "%s: zip64 end record present=%s, wanted %s"
             % (name, has64, want64))
        open(w + "/" + name + ".zip", "wb").write(data)
        print("%s: %d bytes, real zip64 end record: %s" % (name, len(data), has64))
    FIX_PY
    echo "command: python3 <scratch>/fixtures.py <scratch>"
    python3 "$B/fixtures.py" "$B" >"$B/fixtures.out" 2>&1
    frc=$?
    hide <"$B/fixtures.out" | sed 's/^/    /'
    note "the fixture generator exits 0, every signature asserted" "$(is [ "$frc" -eq 0 ])"
    
    fixture_case() {
      local label=$1 name=$2 want_old_rc=$3 want_old_same=$4
      local insize oldsize newsize oldrc newrc oldsame newsame
      insize=$(wc -c <"$B/$name.zip")
      if [ -n "$OLD" ]; then
        "$OLD" "$B/$name.zip" "$B/$name.old" >/dev/null 2>"$B/$name.olderr"; oldrc=$?
      else
        oldrc=-1
      fi
      "$EC" "$B/$name.zip" "$B/$name.new" >/dev/null 2>"$B/$name.newerr"; newrc=$?
      # Guarded on the file's existence, not on a redirect. A refused run writes
      # no output at all (P4 before the repair), and `wc -c <file 2>/dev/null`
      # cannot suppress the shell's own message: redirections are applied left to
      # right, so the input redirection fails before 2>/dev/null is in effect and
      # the message escapes to this log's stderr, carrying a scratch path that
      # hide() never sees because hide only rewrites CAPTURED output.
      if [ -f "$B/$name.old" ]; then oldsize=$(wc -c <"$B/$name.old"); else oldsize=0; fi
      if [ -f "$B/$name.new" ]; then newsize=$(wc -c <"$B/$name.new"); else newsize=0; fi
      oldsame=$(cmp -s "$B/$name.zip" "$B/$name.old" 2>/dev/null && echo identical || echo differs)
      newsame=$(cmp -s "$B/$name.zip" "$B/$name.new" 2>/dev/null && echo identical || echo differs)
      echo "  $label $name: input $insize bytes"
      echo "    before the repair: exit $oldrc, output $oldsize bytes, $oldsame"
      [ -s "$B/$name.olderr" ] && hide <"$B/$name.olderr" | sed 's/^/      /'
      echo "    after the repair:  exit $newrc, output $newsize bytes, $newsame"
      [ -s "$B/$name.newerr" ] && hide <"$B/$name.newerr" | sed 's/^/      /'
      note "$label before the repair: exit $want_old_rc and the output $want_old_same" \
        "$(is [ "$oldrc" = "$want_old_rc" ] && [ "$oldsame" = "$want_old_same" ])"
      note "$label after the repair: exit 0 and the output identical to the input" \
        "$(is [ "$newrc" -eq 0 ] && [ "$newsame" = identical ])"
    }
    
    # The two absolute forms lost their prefix silently, at exit 0; the relative
    # plain form was never affected; the relative zip64 form was refused.
    fixture_case P1 plain-abs 0 differs
    fixture_case P2 plain-rel 0 identical
    fixture_case P3 z64-abs 0 differs
    fixture_case P4 z64-rel 2 differs
    
    echo
    echo "## no temporary of emend-copy's own survived any refusal"
    ectmp=$(find "$B" -maxdepth 1 -name '.*.emend-copy-*.tmp' | wc -l)
    echo "  emend-copy temporaries left in <scratch>: $ectmp"
    note "no emend-copy temporary survived" "$(is [ "$ectmp" -eq 0 ])"
    
    echo
    echo "## the main working tree was never used"
    st_all=$(run_lines git -C "$MAIN" status --porcelain)
    st_log=$(run_matches -E 'records/logs/m1p1-p1' git -C "$MAIN" status --porcelain)
    echo "status lines in the main tree: $st_all; of them under the phase log directory: $st_log"
    main_untouched() {
      [ "$st_all" != error ] && [ "$st_log" != error ] && [ "$st_all" = "$st_log" ]
    }
    note "every change in the main tree is under the phase's log directory" "$(is main_untouched)"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

