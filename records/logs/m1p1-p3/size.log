## script
    #!/usr/bin/env bash
    # Milestone 1 part 1 P3 size.log (specs/0008-zip-layer.md, "Size" and "P3"):
    # the five size probes built in the size profile for i686-unknown-linux-musl as
    # the baseline built its two (records/logs/t3-p2/size.log), the figures the
    # size record carries, and the record itself.
    #
    # REPAIR ROUND (specs/0008, "Planning rulings on P3 (2026-09-17, first
    # verification)", and "Planning rulings during the P3 repair round"): rerun
    # after the round's code commit. The four probes the first record measured are
    # compared with that log as the repair-round rulings' item 1 says, below. The fifth
    # probe, probe-emend-edit-xml, is measured, and the budget
    # is judged on it over probe-zip-xml. A new record is written; the first
    # stands as history.
    #
    # What "Size" asks this log to print, all of it measured here:
    #  - for probe-emend-copy (no edits), probe-emend-edit (edits from argv) and
    #    probe-emend-edit-xml (the same plus the quick-xml count): the file size,
    #    the section total and .text from `size -A`, and the deltas of file size
    #    and section total over probe-zip and over probe-zip-xml;
    #  - the two baseline probes RE-MEASURED at this commit, beside the figures
    #    the committed baseline record gives, which are read from that record and
    #    not typed here;
    #  - the differences between the three emend probes, the part of the editing
    #    probe's cost that is reading an entry measured by a third build;
    #  - the section cost of each duplicate-name candidate built for the P3
    #    repair (P3 ruling 2), each built from a clone of this commit that differs
    #    only in that function: the quadratic check P2 shipped, the stable
    #    sort_by, and the unstable sort_unstable_by the commit carries.
    # File sizes on this target move in 4096-byte steps (the differences between
    # probes are whole pages, the sizes are not); the section figures resolve to
    # the byte. Both are printed, and the record says why.
    #
    # Usage: m1p1-p3-size.sh <phase commit> <record output file> > <scratch file>;
    # the caller moves the output to records/logs/m1p1-p3/size.log and the record
    # to records/size-m1p1-<utc-date>-<shortsha>.md.
    set -uo pipefail
    # Every check with more than one condition is a named function, all_of_<n>,
    # defined on the line before it and called through yn or is
    # (specs/0001-bootstrap.md, "Rules for every phase"). An earlier form of these
    # scripts wrote the conditions inline, which evaluated them whole but was not
    # the form that rule gives (independent check 2 of this round).
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    RECORD_OUT=${2:?record output file required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    unset CARGO_TARGET_DIR
    I686=i686-unknown-linux-musl
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT INT TERM HUP
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    hide() { sed "s#$T#<scratch>#g; s#$MAIN#<repo>#g; s#$HOME#<home>#g"; }
    # static_i686_stripped <binary>: file(1) reports a stripped static 32-bit i386 ELF.
    static_i686_stripped() {
      local d
      d=$(file -b "$1")
      [[ "$d" == *"ELF 32-bit LSB executable, Intel i386"* ]] && [[ "$d" == *"statically linked"* ]] && [[ "$d" == *", stripped"* ]]
    }
    # section <binary> <name>: a section's size from `size -A`, or "error".
    section() {
      local out
      out=$(size -A "$1" 2>/dev/null) || { printf 'error'; return; }
      printf '%s\n' "$out" | awk -v s="$2" '$1 == s { print $2; found = 1 } END { if (!found) print "error" }'
    }
    
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    entry_all=$(run_lines git status --porcelain)
    entry_log=$(run_matches -E '^(\?\?| ?[MARCD]) (records/logs/m1p1-p3|records/size-m1p1-)' git status --porcelain)
    entry_clean() {
      [ "$entry_all" != error ] && [ "$entry_log" != error ] && [ "$entry_all" = "$entry_log" ]
    }
    if ! entry_clean; then echo "the working tree holds changes outside this phase's logs" >&2; exit 2; fi
    
    echo "command: git rev-parse HEAD"
    echo "about: M1 part 1 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: Milestone 1 part 1 P3 (specs/0008-zip-layer.md) size.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    echo "SERIALIZED: produced with no other run in flight"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR"
    echo "at entry: status lines $entry_all, all of them this phase's logs"
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## toolchain"
    RUSTC=$(rustc --version)
    CARGO=$(cargo --version)
    echo "$RUSTC"
    echo "$CARGO"
    echo "installed targets for the pinned toolchain:"
    rustup target list --installed | sed 's/^/    /'
    echo "command: size --version"
    size --version | head -1 | sed 's/^/    /'
    
    echo
    echo "## manifests at $C"
    for f in Cargo.toml tools/size-probe/Cargo.toml crates/emend/Cargo.toml; do
      echo "$f (sha256 $(git show "$C:$f" | sha256sum | cut -d' ' -f1)):"
      git show "$C:$f" | sed 's/^/    /'
    done
    ZIP_V=$(awk '$0 == "name = \"zip\"" { getline; gsub(/^version = "|"$/, ""); print; exit }' Cargo.lock)
    QX_V=$(awk '$0 == "name = \"quick-xml\"" { getline; gsub(/^version = "|"$/, ""); print; exit }' Cargo.lock)
    echo "Cargo.lock: zip $ZIP_V; quick-xml $QX_V"
    check "zip in Cargo.lock is 8.6.0" "$(yn [ "$ZIP_V" = 8.6.0 ])"
    check "quick-xml in Cargo.lock is 0.42.0" "$(yn [ "$QX_V" = 0.42.0 ])"
    
    echo
    echo "## dependency trees, by feature"
    tree_count() {
      # tree_count <features or empty> <crate>: lines naming that crate in the
      # normal-edge tree, or "error" if cargo tree failed.
      local out rc
      if [ -n "$1" ]; then
        out=$(cargo tree -p size-probe --features "$1" -e normal --prefix none --target "$I686" --offline 2>/dev/null); rc=$?
      else
        out=$(cargo tree -p size-probe -e normal --prefix none --target "$I686" --offline 2>/dev/null); rc=$?
      fi
      [ "$rc" -eq 0 ] || { printf 'error'; return; }
      printf '%s\n' "$out" | awk -v c="$2" '$1 == c { n++ } END { print n + 0 }'
    }
    for feat in "" xml emend emend,xml; do
      label=${feat:-none}
      echo "command: cargo tree -p size-probe ${feat:+--features $feat} -e normal --prefix none --target $I686 --offline"
      if [ -n "$feat" ]; then
        cargo tree -p size-probe --features "$feat" -e normal --prefix none --target "$I686" --offline 2>&1 | hide | sed 's/^/    /'
      else
        cargo tree -p size-probe -e normal --prefix none --target "$I686" --offline 2>&1 | hide | sed 's/^/    /'
      fi
      echo "  features $label: quick-xml lines $(tree_count "$feat" quick-xml); emend lines $(tree_count "$feat" emend)"
    done
    all_of_1() { [ "$(tree_count "" quick-xml)" = 0 ] && [ "$(tree_count "" emend)" = 0 ]; }
    check "with no feature, neither quick-xml nor emend is in the tree (probe-zip is built as the baseline was)" \
      "$(yn all_of_1)"
    all_of_2() { [ "$(tree_count xml quick-xml)" -ge 1 ] && [ "$(tree_count xml emend)" = 0 ]; }
    check "with xml alone, quick-xml is in and emend is not (probe-zip-xml is built as the baseline was)" \
      "$(yn all_of_2)"
    all_of_3() { [ "$(tree_count emend emend)" -ge 1 ] && [ "$(tree_count emend quick-xml)" = 0 ]; }
    check "with emend alone, emend is in and quick-xml is not" \
      "$(yn all_of_3)"
    all_of_4() { [ "$(tree_count emend,xml emend)" -ge 1 ] && [ "$(tree_count emend,xml quick-xml)" -ge 1 ]; }
    check "with emend and xml, both are in (probe-emend-edit-xml)" \
      "$(yn all_of_4)"
    
    echo
    echo "## the five size builds for $I686"
    echo "command: cargo clean -p size-probe --profile size --target $I686"
    cargo clean -p size-probe --profile size --target "$I686" 2>&1 | sed 's/^/    /'
    build() {
      # build <bin> <features or empty>
      local rc
      echo "command: cargo build -p size-probe --bin $1 ${2:+--features $2 }--profile size --target $I686 --offline"
      if [ -n "$2" ]; then
        cargo build -p size-probe --bin "$1" --features "$2" --profile size --target "$I686" --offline >"$T/b-$1" 2>&1 </dev/null; rc=$?
      else
        cargo build -p size-probe --bin "$1" --profile size --target "$I686" --offline >"$T/b-$1" 2>&1 </dev/null; rc=$?
      fi
      echo "exit: $rc"
      return "$rc"
    }
    brc=0
    build probe-zip "" || brc=1
    build probe-zip-xml xml || brc=1
    build probe-emend-copy emend || brc=1
    build probe-emend-edit emend || brc=1
    build probe-emend-edit-xml emend,xml || brc=1
    check "all five size builds exit 0" "$(yn [ "$brc" -eq 0 ])"
    
    D=target/$I686/size
    PROBES="probe-zip probe-zip-xml probe-emend-copy probe-emend-edit probe-emend-edit-xml"
    declare -A FILE SECT TEXT SHA
    for b in $PROBES; do
      FILE[$b]=$(stat -c %s "$D/$b")
      SECT[$b]=$(section "$D/$b" Total)
      TEXT[$b]=$(section "$D/$b" .text)
      SHA[$b]=$(sha256sum <"$D/$b" | cut -d' ' -f1)
      echo "$D/$b: file ${FILE[$b]} bytes; sections ${SECT[$b]}; .text ${TEXT[$b]}; sha256 ${SHA[$b]}"
      echo "    $(file -b "$D/$b" | sed 's/, BuildID\[[^]]*\]=[0-9a-f]*//')"
      check "$b is a stripped static i386 ELF" "$(yn static_i686_stripped "$D/$b")"
      all_of_5() { [ "${SECT[$b]}" != error ] && [ "${TEXT[$b]}" != error ]; }
      check "$b's section figures were read" "$(yn all_of_5)"
    done
    
    # File sizes on this target change in whole 4096-byte steps, but they are NOT
    # whole multiples of a page: every probe carries the same remainder, so it is
    # the DIFFERENCES that come in whole pages. The first run of this log asserted
    # that each size was a whole number of pages, which is false, and failed on it;
    # the claim had also been made to planning in those words.
    REM=$((FILE[probe-zip] % 4096))
    for b in $PROBES; do
      echo "  $b: ${FILE[$b]} = $((FILE[$b] / 4096)) pages of 4096 bytes + $((FILE[$b] % 4096))"
    done
    same_remainder() {
      local b
      for b in $PROBES; do
        [ $((FILE[$b] % 4096)) -eq "$REM" ] || return 1
      done
    }
    check "all five file sizes leave the same remainder modulo 4096, $REM bytes, so every difference between them is whole pages" \
      "$(yn same_remainder)"
    
    echo
    echo "## the four earlier probes, against the size.log of the first P3 record"
    # specs/0008, "Planning rulings during the P3 repair round", item 1. The round
    # added doc lines above archive.rs's code, and panic locations carry line
    # numbers, so the two emend probes are not byte-identical to the first round's
    # builds. What is asserted instead: (a) all four keep their file size, section
    # total and .text; (b) a rebuild of the two emend probes at the first log's
    # commit, in a scratch clone, reproduces that log's sha256s; (c) every byte
    # that differs between that rebuild and this build lies in .note.gnu.build-id
    # or in a four-byte slot in .data.rel.ro whose value rose by exactly the line
    # shift, computed from git; (d) the counts are printed; (e) probe-zip and
    # probe-zip-xml keep plain sha256 equality.
    FIRST_REC=$(git log --format='%H' --grep='^M1 part 1 P3 record:' -n 1)
    echo "command: git log --format='%H' --grep='^M1 part 1 P3 record:' -n 1"
    echo "  the first P3 record commit resolves to $FIRST_REC"
    check "the first record commit resolved from git" "$(yn [ -n "$FIRST_REC" ])"
    git show "$FIRST_REC:records/logs/m1p1-p3/size.log" >"$T/first-size.log" 2>/dev/null
    echo "  its size.log: sha256 $(sha256sum <"$T/first-size.log" | cut -d' ' -f1)"
    FIRST_AT=$(sed -n 's/^about: M1 part 1 P3 phase commit \([0-9a-f]*\);.*/\1/p' "$T/first-size.log")
    echo "  that log was measured at $FIRST_AT"
    check "the commit that log was measured at was read" "$(yn [ -n "$FIRST_AT" ])"
    declare -A WAS_SHA
    for b in probe-zip probe-zip-xml probe-emend-copy probe-emend-edit; do
      line=$(LC_ALL=C "$G" -E "^target/$I686/size/$b: file " "$T/first-size.log")
      was_file=$(printf '%s\n' "$line" | sed -n 's/^.*: file \([0-9]*\) bytes; sections \([0-9]*\); \.text \([0-9]*\); sha256 \([0-9a-f]\{64\}\)$/\1/p')
      was_sect=$(printf '%s\n' "$line" | sed -n 's/^.*: file \([0-9]*\) bytes; sections \([0-9]*\); \.text \([0-9]*\); sha256 \([0-9a-f]\{64\}\)$/\2/p')
      was_text=$(printf '%s\n' "$line" | sed -n 's/^.*: file \([0-9]*\) bytes; sections \([0-9]*\); \.text \([0-9]*\); sha256 \([0-9a-f]\{64\}\)$/\3/p')
      WAS_SHA[$b]=$(printf '%s\n' "$line" | sed -n 's/^.*: file \([0-9]*\) bytes; sections \([0-9]*\); \.text \([0-9]*\); sha256 \([0-9a-f]\{64\}\)$/\4/p')
      echo "  $b: then file $was_file, sections $was_sect, .text $was_text, sha256 ${WAS_SHA[$b]}"
      echo "  $b: now  file ${FILE[$b]}, sections ${SECT[$b]}, .text ${TEXT[$b]}, sha256 ${SHA[$b]}"
      read_all() { [ -n "$was_file" ] && [ -n "$was_sect" ] && [ -n "$was_text" ] && [ -n "${WAS_SHA[$b]}" ]; }
      same_figures() { [ "$was_file" = "${FILE[$b]}" ] && [ "$was_sect" = "${SECT[$b]}" ] && [ "$was_text" = "${TEXT[$b]}" ]; }
      check "$b: the first log's four figures were read" "$(yn read_all)"
      check "(a) $b keeps its file size, section total and .text" "$(yn same_figures)"
    done
    check "(e) probe-zip is byte-identical to the first log's build" "$(yn [ "${WAS_SHA[probe-zip]}" = "${SHA[probe-zip]}" ])"
    check "(e) probe-zip-xml is byte-identical to the first log's build" "$(yn [ "${WAS_SHA[probe-zip-xml]}" = "${SHA[probe-zip-xml]}" ])"
    
    echo "  the line shift, from git: the first line of archive.rs that is neither blank nor a comment, at each commit"
    git show "$FIRST_AT:crates/emend/src/archive.rs" >"$T/archive-then.rs"
    git show "$C:crates/emend/src/archive.rs" >"$T/archive-now.rs"
    python3 - "$T/archive-then.rs" "$T/archive-now.rs" >"$T/shift.out" <<'SHIFT_PY'
    import sys
    
    def first(lines):
        for i, l in enumerate(lines):
            if l.strip() and not l.startswith("//"):
                return i
        raise SystemExit("no code line")
    
    a = open(sys.argv[1]).read().split("\n")
    b = open(sys.argv[2]).read().split("\n")
    fa, fb = first(a), first(b)
    print("then line %d, now line %d" % (fa + 1, fb + 1))
    print("the file from that line on is identical: %s" % ("yes" if a[fa:] == b[fb:] else "no"))
    print("shift %d" % (fb - fa))
    SHIFT_PY
    sed 's/^/    /' "$T/shift.out"
    SHIFT=$(sed -n 's/^shift \(-\{0,1\}[0-9]*\)$/\1/p' "$T/shift.out")
    check "the code below the first code line is unchanged, so the shift is the only move" \
      "$(yn [ "$(count_matches -F 'the file from that line on is identical: yes' "$T/shift.out")" = 1 ])"
    check "the line shift was computed" "$(yn [ -n "$SHIFT" ])"
    
    O=$T/then
    git clone --quiet --shared "$MAIN" "$O" 2>/dev/null
    git -C "$O" checkout --quiet "$FIRST_AT"
    echo "command: in a scratch clone at $FIRST_AT, cargo build -p size-probe --bin <probe> --features emend --profile size --target $I686 --offline"
    cat >"$T/bytes.py" <<'BYTES_PY'
    import struct, sys
    
    old, new, shift = open(sys.argv[1], "rb").read(), open(sys.argv[2], "rb").read(), int(sys.argv[3])
    
    def sections(data):
        shoff, = struct.unpack_from("<I", data, 32)
        shentsize, shnum, shstrndx = struct.unpack_from("<HHH", data, 46)
        heads = [struct.unpack_from("<IIIIII", data, shoff + i * shentsize) for i in range(shnum)]
        names_off = heads[shstrndx][4]
        out = {}
        for h in heads:
            end = data.index(b"\0", names_off + h[0])
            out[data[names_off + h[0]:end].decode()] = (h[4], h[5])
        return out
    
    so, sn = sections(old), sections(new)
    print("same length: %s" % ("yes" if len(old) == len(new) else "no"))
    print("same section layout: %s" % ("yes" if so == sn else "no"))
    bid, rel = sn[".note.gnu.build-id"], sn[".data.rel.ro"]
    diffs = [i for i in range(min(len(old), len(new))) if old[i] != new[i]]
    in_bid = [i for i in diffs if bid[0] <= i < bid[0] + bid[1]]
    rest = [i for i in diffs if not (bid[0] <= i < bid[0] + bid[1])]
    slots = sorted({i - (i - rel[0]) % 4 for i in rest})
    shifted = [s for s in slots if rel[0] <= s and s + 4 <= rel[0] + rel[1]
               and struct.unpack_from("<I", new, s)[0] - struct.unpack_from("<I", old, s)[0] == shift]
    covered = set()
    for s in shifted:
        covered.update(range(s, s + 4))
    unexplained = [i for i in rest if i not in covered]
    print("differing bytes: %d" % len(diffs))
    print("in .note.gnu.build-id: %d" % len(in_bid))
    print(".data.rel.ro slots risen by exactly %d: %d" % (shift, len(shifted)))
    print("differing bytes explained by neither: %d" % len(unexplained))
    def where(i):
        for name, (off, size) in sn.items():
            if name and off <= i < off + size:
                return name
        return "no section"
    print("sections holding the unexplained bytes: %s" % (" ".join(sorted({where(i) for i in unexplained})) or "none"))
    BYTES_PY
    # The control: the comparison applied to a pair that differs in one byte
    # outside both regions must report that byte as unexplained.
    cp "$D/probe-zip" "$T/ctl-a"
    cp "$D/probe-zip" "$T/ctl-b"
    printf '\001' | dd of="$T/ctl-b" bs=1 seek=4200 conv=notrunc 2>/dev/null
    python3 "$T/bytes.py" "$T/ctl-a" "$T/ctl-b" "$SHIFT" >"$T/ctl-bytes.out" 2>&1
    sed 's/^/    control: /' "$T/ctl-bytes.out"
    all_of_ctl_text() {
      [ "$(count_matches -F 'differing bytes explained by neither: 1' "$T/ctl-bytes.out")" = 1 ] &&
        [ "$(count_matches -Fx 'sections holding the unexplained bytes: .text' "$T/ctl-bytes.out")" = 1 ]
    }
    check "control: one byte changed in .text is reported unexplained, and in .text" "$(yn all_of_ctl_text)"
    for b in probe-emend-copy probe-emend-edit; do
      ( cd "$O" && CARGO_TARGET_DIR="$O/target" cargo build -p size-probe --bin "$b" --features emend \
          --profile size --target "$I686" --offline ) >"$T/then-$b.out" 2>&1 </dev/null
      rc=$?
      then_bin=$O/target/$I686/size/$b
      then_sha=$(sha256sum <"$then_bin" 2>/dev/null | cut -d' ' -f1)
      echo "  $b rebuilt at $FIRST_AT: build exit $rc; sha256 $then_sha"
      check "(b) $b rebuilt at the first log's commit reproduces its sha256" "$(yn [ "$then_sha" = "${WAS_SHA[$b]}" ])"
      python3 "$T/bytes.py" "$then_bin" "$D/$b" "$SHIFT" >"$T/bytes-$b.out" 2>&1
      sed "s/^/    $b: /" "$T/bytes-$b.out"
      explained() {
        [ "$(count_matches -F 'same length: yes' "$T/bytes-$b.out")" = 1 ] &&
          [ "$(count_matches -F 'same section layout: yes' "$T/bytes-$b.out")" = 1 ] &&
          [ "$(count_matches -F 'differing bytes explained by neither: 0' "$T/bytes-$b.out")" = 1 ]
      }
      check "(c) $b: every differing byte is the build id or a line number risen by $SHIFT" "$(yn explained)"
      python3 "$T/bytes.py" "$then_bin" "$D/$b" "$((SHIFT + 1))" >"$T/bytes-wrong-$b.out" 2>&1
      sed "s/^/    control, shift $((SHIFT + 1)), $b: /" "$T/bytes-wrong-$b.out"
      # A number of unexplained bytes above 0 must be PRINTED; a crash prints none.
      wrong_left=$(sed -n 's/^differing bytes explained by neither: \([0-9]*\)$/\1/p' "$T/bytes-wrong-$b.out")
      wrong_shift_caught() { [ -n "$wrong_left" ] && [ "$wrong_left" -gt 0 ]; }
      check "control: $b compared with a shift of $((SHIFT + 1)) leaves bytes unexplained ($wrong_left)" "$(yn wrong_shift_caught)"
    done
    
    echo
    echo "## the baseline probes, re-measured against the committed baseline"
    BASEREC=records/size-baseline-2026-09-15-6a7533e.md
    echo "command: read the byte figures from $BASEREC (sha256 $(sha256sum <"$BASEREC" | cut -d' ' -f1))"
    BZ=$(awk -F'|' '$2 ~ /`probe-zip`/ { gsub(/ /, "", $4); print $4 }' "$BASEREC")
    BX=$(awk -F'|' '$2 ~ /`probe-zip-xml`/ { gsub(/ /, "", $4); print $4 }' "$BASEREC")
    echo "  committed baseline: probe-zip $BZ, probe-zip-xml $BX"
    echo "  re-measured here:   probe-zip ${FILE[probe-zip]}, probe-zip-xml ${FILE[probe-zip-xml]}"
    all_of_6() { [ -n "$BZ" ] && [ -n "$BX" ]; }
    check "the committed baseline figures were read" "$(yn all_of_6)"
    check "probe-zip re-measures to the committed figure" "$(yn [ "${FILE[probe-zip]}" = "$BZ" ])"
    check "probe-zip-xml re-measures to the committed figure" "$(yn [ "${FILE[probe-zip-xml]}" = "$BX" ])"
    
    echo
    echo "## the deltas"
    for p in probe-emend-copy probe-emend-edit probe-emend-edit-xml; do
      echo "  $p over probe-zip:     file $((FILE[$p] - FILE[probe-zip])), sections $((SECT[$p] - SECT[probe-zip])), .text $((TEXT[$p] - TEXT[probe-zip]))"
      echo "  $p over probe-zip-xml: file $((FILE[$p] - FILE[probe-zip-xml])), sections $((SECT[$p] - SECT[probe-zip-xml])), .text $((TEXT[$p] - TEXT[probe-zip-xml]))"
    done
    EDIT_MINUS_COPY_FILE=$((FILE[probe-emend-edit] - FILE[probe-emend-copy]))
    EDIT_MINUS_COPY_SECT=$((SECT[probe-emend-edit] - SECT[probe-emend-copy]))
    EDIT_MINUS_COPY_TEXT=$((TEXT[probe-emend-edit] - TEXT[probe-emend-copy]))
    echo "  probe-emend-edit over probe-emend-copy: file $EDIT_MINUS_COPY_FILE, sections $EDIT_MINUS_COPY_SECT, .text $EDIT_MINUS_COPY_TEXT"
    XML_FILE=$((FILE[probe-emend-edit-xml] - FILE[probe-emend-edit]))
    XML_SECT=$((SECT[probe-emend-edit-xml] - SECT[probe-emend-edit]))
    XML_TEXT=$((TEXT[probe-emend-edit-xml] - TEXT[probe-emend-edit]))
    echo "  probe-emend-edit-xml over probe-emend-edit (the quick-xml count): file $XML_FILE, sections $XML_SECT, .text $XML_TEXT"
    BUDGET=$((250 * 1024))
    JUDGED_FILE=$((FILE[probe-emend-edit-xml] - FILE[probe-zip-xml]))
    JUDGED_SECT=$((SECT[probe-emend-edit-xml] - SECT[probe-zip-xml]))
    JUDGED_TEXT=$((TEXT[probe-emend-edit-xml] - TEXT[probe-zip-xml]))
    echo "  the provisional budget, 250 KiB above probe-zip-xml: $BUDGET bytes"
    echo "  judged on probe-emend-edit-xml: file delta $JUDGED_FILE, section delta $JUDGED_SECT, .text delta $JUDGED_TEXT"
    echo "  headroom under the provisional budget: file $((BUDGET - JUDGED_FILE)), sections $((BUDGET - JUDGED_SECT))"
    check "the editing probe is not smaller than the no-edit one, by sections" "$(yn [ "$EDIT_MINUS_COPY_SECT" -ge 0 ])"
    check "the xml probe is larger than the editing probe, by sections" "$(yn [ "$XML_SECT" -gt 0 ])"
    all_of_7() { [ "$JUDGED_FILE" -lt "$BUDGET" ] && [ "$JUDGED_SECT" -lt "$BUDGET" ]; }
    check "the budget's figures are under the provisional budget" "$(yn all_of_7)"
    
    echo
    echo "## what the editing probe adds, split by measurement"
    # Measured for the report, beyond what the P3 rulings ask for, because the
    # difference above needs explaining and an explanation is not a measurement.
    # probe-emend-edit differs from probe-emend-copy in two ways: it READS an entry
    # through the layer (`Archive::read`, which goes through the zip crate), and it
    # EDITS, which keeps the replacement, removal and addition paths that a
    # consumer that never edits does not link. A third build, from a
    # clone of this commit whose probe-emend-edit takes the replacement's bytes
    # from its command line and reads nothing, separates the two.
    A=$T/attrib
    git clone --quiet --shared "$MAIN" "$A" 2>/dev/null
    git -C "$A" checkout --quiet "$C"
    python3 - "$A/tools/size-probe/src/bin/probe-emend-edit.rs" <<'ATTR_PY' | sed 's/^/  /'
    import re, sys
    
    p = sys.argv[1]
    s = open(p).read()
    m = re.search(r"    let mut own = Vec::new\(\);\n.*?\.map_err\(\|e\| e\.kind\(\)\.to_string\(\)\)\?;\n", s, re.S)
    if not m:
        raise SystemExit("the read of the replaced entry was not found")
    s = s[:m.start()] + "    let own = names.replace.to_vec();\n" + s[m.end():]
    if ".read(replace)" in s:
        raise SystemExit("the read is still there")
    open(p, "w").write(s)
    print("scratch: probe-emend-edit takes the replacement's bytes from its command line and reads no entry")
    ATTR_PY
    ( cd "$A" && CARGO_TARGET_DIR="$A/target" cargo build -p size-probe --bin probe-emend-edit --features emend \
        --profile size --target "$I686" --offline ) >"$T/attrib.out" 2>&1 </dev/null
    arc=$?
    NOREAD=$A/target/$I686/size/probe-emend-edit
    NOREAD_FILE=$(stat -c %s "$NOREAD" 2>/dev/null || echo error)
    NOREAD_SECT=$(section "$NOREAD" Total)
    NOREAD_TEXT=$(section "$NOREAD" .text)
    echo "  the editing probe that reads no entry: build exit $arc; file $NOREAD_FILE; sections $NOREAD_SECT; .text $NOREAD_TEXT"
    all_of_8() { [ "$arc" -eq 0 ] && [ "$NOREAD_SECT" != error ] && [ "$NOREAD_TEXT" != error ]; }
    check "the editing probe that reads no entry built and was measured" \
      "$(yn all_of_8)"
    EDITS_SECT=$((NOREAD_SECT - SECT[probe-emend-copy]))
    EDITS_TEXT=$((NOREAD_TEXT - TEXT[probe-emend-copy]))
    EDITS_FILE=$((NOREAD_FILE - FILE[probe-emend-copy]))
    READ_SECT=$((SECT[probe-emend-edit] - NOREAD_SECT))
    READ_TEXT=$((TEXT[probe-emend-edit] - NOREAD_TEXT))
    READ_FILE=$((FILE[probe-emend-edit] - NOREAD_FILE))
    echo "  the edit paths, which a no-edit consumer lets the linker drop (reads-nothing editing probe over probe-emend-copy):"
    echo "    sections $EDITS_SECT, .text $EDITS_TEXT, file $EDITS_FILE"
    echo "  reading an entry through the layer (probe-emend-edit over the reads-nothing editing probe):"
    echo "    sections $READ_SECT, .text $READ_TEXT, file $READ_FILE"
    # The record says reading is most of the difference; that sentence is only
    # written because this check says so.
    check "reading an entry is the larger part of what the editing probe adds, by sections" \
      "$(yn [ "$READ_SECT" -gt "$EDITS_SECT" ])"
    
    echo
    echo "## the duplicate-name candidates (P3 ruling 2)"
    # Each candidate is a clone of this commit with refuse_duplicate_names in one
    # form, built in its own target directory; nothing is edited in <repo>. The
    # quadratic form is P2's, read from git at the code commit P2 shipped, not
    # typed. probe-emend-copy is the probe the candidates were first measured
    # with, and probe-emend-edit the editing probe the first record judged the
    # budget on; both are built for each. (The budget is now judged on
    # probe-emend-edit-xml, whose code this function reaches the same way.)
    P2_CODE=$(git log --format='%H' --grep='^M1 part 1 P2: replace, remove and add' -n 1)
    echo "command: git log --format='%H' --grep='^M1 part 1 P2: replace, remove and add' -n 1"
    echo "  P2's code commit resolves to $P2_CODE"
    check "P2's code commit resolved from git" "$(yn [ -n "$P2_CODE" ])"
    git show "$P2_CODE:crates/emend/src/archive.rs" >"$T/p2-archive.rs"
    cat >"$T/swap.py" <<'SWAP_PY'
    import re, sys
    
    target, form, p2 = sys.argv[1], sys.argv[2], sys.argv[3]
    src = open(target).read()
    anchor = "/// Refuses two central records with the same raw name, since an edit by name\n/// would be ambiguous."
    
    
    def span(text):
        start = text.index(anchor)
        body = text.index("fn refuse_duplicate_names(", start)
        return start, text.index("\n}\n", body) + 3
    
    
    if form == "quadratic":
        old = open(p2).read()
        s, e = span(old)
        ts, te = span(src)
        src = src[:ts] + old[s:e] + src[te:]
    elif form == "stable":
        if src.count("order.sort_unstable_by(") != 1:
            raise SystemExit("the unstable sort is not where it is expected")
        src = src.replace("order.sort_unstable_by(", "order.sort_by(")
    elif form != "unstable":
        raise SystemExit("unknown form " + form)
    open(target, "w").write(src)
    m = re.search(r"fn refuse_duplicate_names\(.*?\n\}\n", src, re.S)
    body = m.group(0)
    kind = "quadratic" if "seen.contains" in body else ("stable" if "sort_by(" in body and "sort_unstable_by(" not in body else "unstable")
    print("form written: %s; the function reads as: %s" % (form, kind))
    SWAP_PY
    declare -A CAND_SECT CAND_TEXT CAND_FILE
    for form in quadratic stable unstable; do
      R=$T/cand-$form
      git clone --quiet --shared "$MAIN" "$R" 2>/dev/null
      git -C "$R" checkout --quiet "$C"
      python3 "$T/swap.py" "$R/crates/emend/src/archive.rs" "$form" "$T/p2-archive.rs" | sed 's/^/  /'
      for p in probe-emend-copy probe-emend-edit; do
        ( cd "$R" && CARGO_TARGET_DIR="$R/target" cargo build -p size-probe --bin "$p" --features emend \
            --profile size --target "$I686" --offline ) >"$T/cand-$form-$p.out" 2>&1 </dev/null
        rc=$?
        bin=$R/target/$I686/size/$p
        CAND_FILE[$form-$p]=$(stat -c %s "$bin" 2>/dev/null || echo error)
        CAND_SECT[$form-$p]=$(section "$bin" Total)
        CAND_TEXT[$form-$p]=$(section "$bin" .text)
        echo "  $form $p: build exit $rc; file ${CAND_FILE[$form-$p]}; sections ${CAND_SECT[$form-$p]}; .text ${CAND_TEXT[$form-$p]}"
        all_of_9() { [ "$rc" -eq 0 ] && [ "${CAND_SECT[$form-$p]}" != error ]; }
        check "$form $p built and measured" "$(yn all_of_9)"
      done
    done
    for p in probe-emend-copy probe-emend-edit; do
      for form in stable unstable; do
        echo "  $p, $form over quadratic: sections $((CAND_SECT[$form-$p] - CAND_SECT[quadratic-$p])), .text $((CAND_TEXT[$form-$p] - CAND_TEXT[quadratic-$p])), file $((CAND_FILE[$form-$p] - CAND_FILE[quadratic-$p]))"
      done
      check "$p: the unstable sort is not larger than the stable one, by sections" \
        "$(yn [ "${CAND_SECT[unstable-$p]}" -le "${CAND_SECT[stable-$p]}" ])"
      check "$p: the unstable candidate measures the same as the committed build" \
        "$(yn [ "${CAND_SECT[unstable-$p]}" = "${SECT[$p]}" ])"
    done
    
    echo
    echo "## the probes on a generated archive"
    python3 - "$T/probe.zip" <<'PY'
    import sys, zipfile
    with zipfile.ZipFile(sys.argv[1], "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("[Content_Types].xml", "<Types><Default/><Override/></Types>")
        z.writestr("xl/workbook.xml", "<workbook><sheets><sheet/><sheet/></sheets></workbook>")
        z.writestr("docProps/app.xml", "<Properties/>")
    PY
    "$D/probe-zip" "$T/probe.zip" >"$T/o1" 2>&1; R1=$?
    "$D/probe-zip-xml" "$T/probe.zip" xl/workbook.xml >"$T/o2" 2>&1; R2=$?
    "$D/probe-emend-copy" "$T/probe.zip" "$T/copy.zip" >"$T/o3" 2>&1; R3=$?
    "$D/probe-emend-edit" "$T/probe.zip" "$T/edit.zip" '[Content_Types].xml' docProps/app.xml added.xml >"$T/o4" 2>&1; R4=$?
    "$D/probe-emend-edit-xml" "$T/probe.zip" "$T/editx.zip" '[Content_Types].xml' docProps/app.xml added.xml >"$T/o6" 2>&1; R6=$?
    for n in 1 2 3 4 6; do echo "  run $n:"; hide <"$T/o$n" | sed 's/^/    /'; done
    all_of_10() { [ "$R1" -eq 0 ] && [ "$(cat "$T/o1")" = "entries 3" ]; }
    check "probe-zip prints the entry count" "$(yn all_of_10)"
    all_of_11() { [ "$R2" -eq 0 ] && [ "$(cat "$T/o2")" = "$(printf 'entries 3\nelements 4')" ]; }
    check "probe-zip-xml prints the entry and element counts" "$(yn all_of_11)"
    all_of_12() { [ "$R3" -eq 0 ] && cmp -s "$T/probe.zip" "$T/copy.zip"; }
    check "probe-emend-copy exits 0 and its copy is byte-identical" "$(yn all_of_12)"
    python3 - "$T/edit.zip" >"$T/o5" 2>&1 <<'PY'
    import sys, zipfile
    names = sorted(zipfile.ZipFile(sys.argv[1]).namelist())
    print(" ".join(names))
    PY
    echo "  names in the edited archive, read by python's zipfile: $(cat "$T/o5")"
    all_of_13() { [ "$R4" -eq 0 ] && [ "$(cat "$T/o5")" = "[Content_Types].xml added.xml xl/workbook.xml" ]; }
    check "probe-emend-edit exits 0; the replaced entry stays, the removed one goes, the added one appears" \
      "$(yn all_of_13)"
    all_of_14() { [ "$R6" -eq 0 ] && [ "$(cat "$T/o6")" = "$(printf 'entries 3\nelements 3')" ]; }
    check "probe-emend-edit-xml prints the entry count and the replaced entry's three elements" \
      "$(yn all_of_14)"
    check "probe-emend-edit-xml writes the same archive as probe-emend-edit" "$(yn cmp -s "$T/edit.zip" "$T/editx.zip")"
    
    SHORT=$(git rev-parse --short "$C")
    DATE=$(date -u +%Y-%m-%d)
    cat >"$RECORD_OUT" <<EOF
    # Size, Milestone 1 part 1: $DATE-$SHORT
    
    The stripped \`i686-unknown-linux-musl\` sizes of the five size probes,
    measured by \`records/logs/m1p1-p3/size.log\` at P3's repair round as the
    baseline's two were measured by \`records/logs/t3-p2/size.log\`
    (\`specs/0008-zip-layer.md\`, "Size"). The budget is judged on
    \`probe-emend-edit-xml\` over \`probe-zip-xml\`, with the other two emend probes
    beside it. This record follows \`records/size-m1p1-2026-09-17-5a8b491.md\`,
    which stands as history. The four probes it measured keep their figures here;
    \`probe-zip\` and \`probe-zip-xml\` are byte-identical, and the two emend probes
    differ only in their build id and in panic-location line numbers, which the
    round's doc lines above \`archive.rs\`'s code moved by $SHIFT (the size log
    compares them byte by byte against a rebuild at the first record's commit).
    
    - Commit: $C
    - Date: $DATE (UTC)
    - Toolchain: $RUSTC; $CARGO
    - Target: $I686
    - Profile: \`size\` in the workspace \`Cargo.toml\` (inherits release,
      opt-level "z", lto "fat", codegen-units 1, panic "abort", strip true,
      debug false)
    - \`zip\` $ZIP_V, \`default-features = false\`, features
      \`deflate-flate2-zlib-rs\`; \`quick-xml\` $QX_V behind the \`size-probe\`
      feature \`xml\`; emend behind the \`size-probe\` feature \`emend\`
    
    ## The probes
    
    | Binary | What it does | File bytes | Section bytes | .text bytes |
    | --- | --- | --- | --- | --- |
    | \`probe-zip\` | opens an archive with \`zip\`, prints the entry count | ${FILE[probe-zip]} | ${SECT[probe-zip]} | ${TEXT[probe-zip]} |
    | \`probe-zip-xml\` | the same, then reads one entry through \`zip\` and counts its elements with \`quick-xml\` | ${FILE[probe-zip-xml]} | ${SECT[probe-zip-xml]} | ${TEXT[probe-zip-xml]} |
    | \`probe-emend-copy\` | opens an archive with emend and writes it back with no edits | ${FILE[probe-emend-copy]} | ${SECT[probe-emend-copy]} | ${TEXT[probe-emend-copy]} |
    | \`probe-emend-edit\` | opens with emend, reads the entry to replace, and writes a replace, a removal and an addition from its command line | ${FILE[probe-emend-edit]} | ${SECT[probe-emend-edit]} | ${TEXT[probe-emend-edit]} |
    | \`probe-emend-edit-xml\` | \`probe-emend-edit\`, plus the \`quick-xml\` element count over the replaced entry's bytes | ${FILE[probe-emend-edit-xml]} | ${SECT[probe-emend-edit-xml]} | ${TEXT[probe-emend-edit-xml]} |
    
    \`probe-zip\` and \`probe-zip-xml\` re-measure to the figures of
    \`records/size-baseline-2026-09-15-6a7533e.md\` ($BZ and $BX).
    
    ## The deltas
    
    | Probe | Over \`probe-zip\`: file | sections | Over \`probe-zip-xml\`: file | sections |
    | --- | --- | --- | --- | --- |
    | \`probe-emend-copy\` | $((FILE[probe-emend-copy] - FILE[probe-zip])) | $((SECT[probe-emend-copy] - SECT[probe-zip])) | $((FILE[probe-emend-copy] - FILE[probe-zip-xml])) | $((SECT[probe-emend-copy] - SECT[probe-zip-xml])) |
    | \`probe-emend-edit\` | $((FILE[probe-emend-edit] - FILE[probe-zip])) | $((SECT[probe-emend-edit] - SECT[probe-zip])) | $((FILE[probe-emend-edit] - FILE[probe-zip-xml])) | $((SECT[probe-emend-edit] - SECT[probe-zip-xml])) |
    | \`probe-emend-edit-xml\` | $((FILE[probe-emend-edit-xml] - FILE[probe-zip])) | $((SECT[probe-emend-edit-xml] - SECT[probe-zip])) | $((FILE[probe-emend-edit-xml] - FILE[probe-zip-xml])) | $((SECT[probe-emend-edit-xml] - SECT[probe-zip-xml])) |
    
    Only \`probe-emend-edit-xml\` links \`quick-xml\`, as \`probe-zip-xml\` does, so
    its delta over \`probe-zip-xml\` is what emend adds to a consumer that already
    carries both crates and reads entries. The other two emend probes' deltas
    over \`probe-zip-xml\` subtract \`quick-xml\` and are not that figure.
    
    Between the emend probes:
    
    | Difference | Section bytes | .text bytes | File bytes |
    | --- | --- | --- | --- |
    | \`probe-emend-edit\` over \`probe-emend-copy\` | $EDIT_MINUS_COPY_SECT | $EDIT_MINUS_COPY_TEXT | $EDIT_MINUS_COPY_FILE |
    | of which the edit paths, which a consumer that never edits does not link | $EDITS_SECT | $EDITS_TEXT | $EDITS_FILE |
    | of which reading an entry through the layer (\`Archive::read\` goes through \`zip\`) | $READ_SECT | $READ_TEXT | $READ_FILE |
    | \`probe-emend-edit-xml\` over \`probe-emend-edit\`, the \`quick-xml\` count | $XML_SECT | $XML_TEXT | $XML_FILE |
    
    The two parts of the first difference were separated by a third build that
    edits but reads no entry. Reading is most of that difference.
    
    ## The budget
    
    The provisional budget is 250 KiB, $BUDGET bytes, above \`probe-zip-xml\`.
    Judged on \`probe-emend-edit-xml\`: $JUDGED_FILE file bytes and $JUDGED_SECT
    section bytes ($JUDGED_TEXT of \`.text\`), leaving $((BUDGET - JUDGED_FILE)) and
    $((BUDGET - JUDGED_SECT)). The maintainer re-rules the budget with these
    figures in hand.
    
    ## Reading these figures
    
    File sizes on this target change in whole 4096-byte steps. They are not
    themselves whole pages: all five probes leave the same remainder, $REM bytes,
    modulo 4096, so it is every DIFFERENCE between them that is a whole number of
    pages. A change under a page is therefore invisible in the file size, and a
    change of a few thousand section bytes can cost more than one page: the
    committed duplicate check costs
    $((CAND_SECT[unstable-probe-emend-edit] - CAND_SECT[quadratic-probe-emend-edit])) section bytes and $((CAND_FILE[unstable-probe-emend-edit] - CAND_FILE[quadratic-probe-emend-edit])) file bytes in \`probe-emend-edit\`. The section
    totals, from \`size -A\`, resolve to the byte, which is why both are given.
    
    ## The duplicate-name candidates
    
    \`refuse_duplicate_names\` was quadratic in P2 and is linear-logarithmic from
    Milestone 1 part 1 P3. Each form below was built from a clone of this commit
    differing only in that function.
    
    | Form | \`probe-emend-copy\` sections | \`probe-emend-edit\` sections |
    | --- | --- | --- |
    | quadratic, as P2 shipped it | ${CAND_SECT[quadratic-probe-emend-copy]} | ${CAND_SECT[quadratic-probe-emend-edit]} |
    | stable \`sort_by\` | ${CAND_SECT[stable-probe-emend-copy]} | ${CAND_SECT[stable-probe-emend-edit]} |
    | unstable \`sort_unstable_by\`, committed | ${CAND_SECT[unstable-probe-emend-copy]} | ${CAND_SECT[unstable-probe-emend-edit]} |
    
    The committed form costs $((CAND_SECT[unstable-probe-emend-edit] - CAND_SECT[quadratic-probe-emend-edit])) section bytes over the quadratic one in
    \`probe-emend-edit\`, and $((CAND_SECT[stable-probe-emend-edit] - CAND_SECT[unstable-probe-emend-edit])) fewer than the stable sort.
    EOF
    echo
    echo "## the size record, written to <scratch>"
    hide <"$RECORD_OUT" | sed 's/^/    /'
    check "the record is ASCII" "$(yn [ "$(LC_ALL=C tr -cd '\200-\377' <"$RECORD_OUT" | wc -c)" -eq 0 ])"
    check "the record carries no U+2014" "$(yn [ "$(count_matches -F "$(printf '\342\200\224')" "$RECORD_OUT")" = 0 ])"
    check "the record names no home, mount or corpus path" \
      "$(yn [ "$(count_matches -E '(/home/|/mnt/|/Users/|emend-testing|/tmp/)' "$RECORD_OUT")" = 0 ])"
    check "the record carries no unfilled figure" "$(yn [ "$(count_matches -F 'error' "$RECORD_OUT")" = 0 ])"
    
    echo
    echo "## status after the run"
    st_all=$(run_lines git status --porcelain)
    st_log=$(run_matches -E '^(\?\?| ?[MARCD]) (records/logs/m1p1-p3|records/size-m1p1-)' git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or its size record: $st_log"
    status_accounted() { [ "$st_all" != error ] && [ "$st_log" != error ] && [ "$st_all" = "$st_log" ]; }
    check "every change in the working tree is one of this phase's logs or its size record" "$(yn status_accounted)"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "size log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

