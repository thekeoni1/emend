## script that wrote this log
    #!/usr/bin/env bash
    # Milestone 1 part 1 P3 test.log (specs/0008-zip-layer.md, "Phases": test.log
    # on both targets): cargo test for the workspace on the host and with
    # --target i686-unknown-linux-musl, colour off; size-probe built and linted
    # with each of its features; and the layer's ignored 4 GiB case run explicitly
    # on both targets under /usr/bin/time -v.
    #
    # The form is P2's test.log. What P3 changes in it:
    #
    #  - The 4 GiB case is RERUN. specs/0008-zip-layer.md, "32-bit and
    #    streaming", ties that test to changes in the layer's size or offset code,
    #    and P3's repairs commit changed `rewrite_eocd`, which writes the end
    #    record's counts, size and offset. Its design is the P2 rulings of
    #    2026-09-17, item 3; the run is as P2's was: the test binary of each target
    #    under /usr/bin/time -v, TMPDIR on a disk-backed file system with its type
    #    measured, EMEND_XLSX_DIFF set to the xlsx-diff binary of the SAME target
    #    with its sha256 printed, and peak RSS under 64 MiB.
    #  - size-probe gains the feature `emend` and two probes that require it, so
    #    the build and clippy section covers `xml`, `emend` and both together on
    #    each target. The workspace runs above do not build those probes, because
    #    their required features are off there.
    #
    # REPAIR ROUND (specs/0008, "Planning rulings on P3 (2026-09-17, first
    # verification)"). The round's code commit adds tests and the probe
    # probe-emend-edit-xml, and touches no size or offset code, so the 4 GiB case
    # is not required again by "32-bit and streaming"; it is rerun anyway, because
    # this log replaces the one that recorded it. Item 7 adds: the sha256 of every
    # test executable this log runs, so negative.log can compare its copies with
    # them; a positive control for the count of fixtures left behind, which is
    # now read through a form that says "error" when find fails; and the round's
    # new tests, required by name.
    #
    # Usage: m1p1-p3-test.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m1p1-p3/test.log. EMEND_BIG_TMPDIR must name a
    # disk-backed scratch directory for the 4 GiB runs. The caller runs it in the
    # foreground and waits: P2's run of the same shape took about a minute.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT INT TERM HUP
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    passed_matches() { [ "$passed" -gt 0 ] && [ "$passed" -eq "$nok" ]; }
    
    BIG=${EMEND_BIG_TMPDIR:?EMEND_BIG_TMPDIR must name a disk-backed scratch directory}
    hide() { sed "s#$BIG#<scratch>#g; s#$MAIN#<repo>#g; s#$HOME#<home>#g"; }
    
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    
    # The entry guard: every change must be one of this phase's logs or its size
    # record.
    entry_all=$(run_lines git status --porcelain)
    entry_log=$(run_matches -E '^(\?\?| ?[MARCD]) (records/logs/m1p1-p3|records/size-m1p1-)' git status --porcelain)
    entry_clean() {
      [ "$entry_all" != error ] && [ "$entry_log" != error ] && [ "$entry_all" = "$entry_log" ]
    }
    if ! entry_clean; then
      echo "the working tree holds changes outside records/logs/m1p1-p3" >&2
      exit 2
    fi
    
    echo "command: git rev-parse HEAD"
    echo "about: M1 part 1 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: Milestone 1 part 1 P3 (specs/0008-zip-layer.md) test.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    echo "SERIALIZED: produced with no other run in flight"
    echo "FOREGROUND: run in one call and waited for, not detached."
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR; CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS; $(rustc --version)"
    echo "at entry: status lines $entry_all, all of them this phase's logs or its size record"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    for target in host i686-unknown-linux-musl; do
      echo
      echo "## cargo test --workspace ($target)"
      if [ "$target" = host ]; then
        echo "command: cargo test --workspace"
        cargo test --workspace >"$T/$target.out" 2>&1 </dev/null
      else
        echo "command: cargo test --workspace --target $target"
        cargo test --workspace --target "$target" >"$T/$target.out" 2>&1 </dev/null
      fi
      rc=$?
      echo "exit: $rc"
      check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
      echo "Running lines, test lines and summary lines:"
      LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test .* \.\.\. |^test result: ' "$T/$target.out" | sed 's/^ */    /'
      # Every test executable this run ran, with its sha256 (item 7).
      sed -n 's/^ *Running .* (\(target\/[^)]*\))$/\1/p' "$T/$target.out" >"$T/$target.exes"
      nexe=0
      while IFS= read -r exe; do
        if [ -x "$exe" ]; then
          echo "  test executable $exe: sha256 $(sha256sum <"$exe" | cut -d' ' -f1)"
          nexe=$((nexe + 1))
        else
          echo "  test executable $exe: MISSING"; fail=1
        fi
      done <"$T/$target.exes"
      nexes=$(count_lines "$T/$target.exes")
      all_hashed() { [ "$nexe" -gt 0 ] && [ "$nexe" = "$nexes" ]; }
      check "$target: every test executable it ran was hashed ($nexe of $nexes)" "$(yn all_hashed)"
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/$target.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/$target.names"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      ignored=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^ignored;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      nok=$(count_lines "$T/$target.names")
      echo "$target: passed $passed; failed $failed; ignored $ignored; test lines ending ok: $nok"
      check "$target: failed is 0" "$(yn [ "$failed" -eq 0 ])"
      check "$target: passed is more than 0 and equals the ok test lines" "$(yn passed_matches)"
      n=$(count_bytes "$CTRL_CLASS" "$T/$target.out")
      check "$target: control bytes in the cargo output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
      echo "$passed" >"$T/$target.count"
    done
    
    echo
    echo "## the zip layer's own tests, named"
    # specs/0008's P3 list names the tests it requires; they are printed so a
    # reader can check the list against the spec rather than trust a count.
    LC_ALL=C "$G" -E '^archive::tests::' "$T/host.names" | sed 's/^/    /'
    nlayer=$(count_matches -E '^archive::tests::' "$T/host.names")
    echo "  zip layer tests that ran on the host: $nlayer"
    check "the zip layer ran 78 tests of its own: 71 before the repair round and 7 it adds" "$(yn [ "$nlayer" = 78 ])"
    # The tests P3's text names, each required by name.
    for t in adding_past_65535_entries_synthesises_the_zip64_end_records \
             removing_from_65535_entries_writes_a_plain_count \
             a_65535_entry_archive_round_trips_byte_for_byte \
             the_catalogue_names_every_refusal \
             a_replacement_for_an_entry_of_another_method_is_refused_when_planned \
             compressing_with_another_method_is_refused_before_a_file_exists \
             a_temporary_archive_of_two_entries_is_refused \
             a_value_past_32_bits_in_a_plain_field_is_refused \
             a_marker_with_no_zip64_extra_field_is_refused_on_rewrite \
             a_replacement_too_large_for_a_plain_local_header_is_refused \
             a_panicking_replacement_leaves_no_temporary_and_a_refusing_archive \
             a_zip64_sector_past_the_scan_window_is_refused_with_its_own_message \
             an_unsigned_descriptor_with_the_signature_as_crc_is_refused_when_nothing_follows \
             an_unsigned_descriptor_with_the_signature_as_crc_gains_a_signature_over_padding \
             the_crate_path_reports_the_index_asked_for \
             bytes_after_the_end_record_are_refused_with_their_own_message \
             the_replacement_temporary_is_created_with_mode_0600 \
             an_added_name_longer_than_a_header_can_record_is_refused \
             a_non_zip_with_a_stray_end_record_signature_is_refused_as_trailing_bytes \
             a_zip64_locator_without_its_record_is_refused \
             a_locator_and_a_directory_disagreeing_on_the_base_are_refused \
             reading_an_entry_of_a_method_the_crate_cannot_decode_is_refused \
             the_crate_refusals_carry_their_catalogued_messages \
             a_multi_disk_record_is_refused \
             reading_an_encrypted_entry_is_refused \
             replacing_an_encrypted_entry_is_refused \
             two_changes_for_one_entry_are_refused; do
      check "host ran and passed archive::tests::$t" \
        "$(yn [ "$(count_matches -E "^archive::tests::$t\$" "$T/host.names")" = 1 ])"
    done
    
    echo
    echo "## the ignored tests, named"
    # Two are ignored, and for different reasons, so both are named.
    #  - tools/xlsx-diff's zip64_entry_over_4_gib belongs to the HARNESS and reruns
    #    only when the harness's size or offset code changes (T1 P5). P3 does not
    #    touch the harness.
    #  - crates/emend's zip64_replace_in_an_archive_over_4_gib is the LAYER's own
    #    (P2 rulings of 2026-09-17, item 3), ignored by default and RUN EXPLICITLY
    #    below on both targets, so "ignored" here does not mean "not run".
    LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/host.out" | sed 's/^/    /'
    nign=$(count_matches -E '^test .* \.\.\. ignored' "$T/host.out")
    nign_layer=$(count_matches -E '^test archive::tests::.* \.\.\. ignored' "$T/host.out")
    echo "  ignored tests on the host: $nign; of them in the zip layer: $nign_layer"
    check "exactly one layer test is ignored, the 4 GiB case this log runs below" "$(yn [ "$nign_layer" = 1 ])"
    check "it is the 4 GiB case by name" \
      "$(yn [ "$(count_matches -E '^test archive::tests::zip64_replace_in_an_archive_over_4_gib \.\.\. ignored' "$T/host.out")" = 1 ])"
    
    echo
    echo "## size-probe with each of its features"
    # `xml` enables probe-zip-xml, `emend` enables probe-emend-copy and
    # probe-emend-edit, and both together enable probe-emend-edit-xml; the
    # workspace runs above build none of the four.
    for target in host i686-unknown-linux-musl; do
      if [ "$target" = host ]; then tflag=(); else tflag=(--target "$target"); fi
      for feat in xml emend xml,emend; do
        echo "command: cargo build -p size-probe --features $feat --all-targets ${tflag[*]}"
        cargo build -p size-probe --features "$feat" --all-targets "${tflag[@]}" >"$T/build-$feat-$target.out" 2>&1 </dev/null
        rc=$?
        echo "exit: $rc"
        check "$target: size-probe builds with --features $feat" "$(yn [ "$rc" -eq 0 ])"
        echo "command: cargo clippy -p size-probe --features $feat --all-targets ${tflag[*]} -- -D warnings"
        cargo clippy -p size-probe --features "$feat" --all-targets "${tflag[@]}" -- -D warnings >"$T/clippy-$feat-$target.out" 2>&1 </dev/null
        rc=$?
        echo "exit: $rc"
        check "$target: clippy with --features $feat passes" "$(yn [ "$rc" -eq 0 ])"
        n=$(count_bytes "$CTRL_CLASS" "$T/clippy-$feat-$target.out")
        check "$target: control bytes in the clippy output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
      done
    done
    
    echo
    echo "## the two runs"
    echo "host executed $(cat "$T/host.count") tests; i686-unknown-linux-musl executed $(cat "$T/i686-unknown-linux-musl.count") tests"
    check "the i686 run executed the same test names as the host run" "$(yn cmp -s "$T/host.names" "$T/i686-unknown-linux-musl.names")"
    check "the two counts are equal" "$(yn [ "$(cat "$T/host.count")" = "$(cat "$T/i686-unknown-linux-musl.count")" ])"
    
    echo
    echo "## the layer's 4 GiB case, run explicitly on both targets"
    # The count of fixtures left behind, read so that a failing find is "error",
    # never 0, with its controls: a planted file is counted, then removed and not
    # counted, and a directory that does not exist reads as error.
    count_named() {
      local out
      out=$(find "$1" -maxdepth 1 -name "$2" -print 2>/dev/null) || { echo error; return; }
      if [ -z "$out" ]; then echo 0; else printf '%s\n' "$out" | wc -l; fi
    }
    : >"$BIG/emend-4gib-control-plant"
    n=$(count_named "$BIG" 'emend-4gib-*')
    check "control: a planted fixture is counted: $n (expect 1)" "$(yn [ "$n" = 1 ])"
    rm -f "$BIG/emend-4gib-control-plant"
    n=$(count_named "$BIG" 'emend-4gib-*')
    check "control: removed, it is not: $n (expect 0)" "$(yn [ "$n" = 0 ])"
    n=$(count_named "$BIG/no-such-directory" 'emend-4gib-*')
    check "control: a directory that does not exist reads as error: $n" "$(yn [ "$n" = error ])"
    echo "command: df --output=fstype <scratch>"
    BIG_FS=$(df --output=fstype "$BIG" | tail -1 | tr -d ' ')
    BIG_FREE=$(df -h --output=avail "$BIG" | tail -1 | tr -d ' ')
    echo "  TMPDIR for these runs: <scratch>; file system type $BIG_FS; available $BIG_FREE"
    check "TMPDIR for the 4 GiB runs is not a RAM-backed tmpfs" "$(yn [ "$BIG_FS" != tmpfs ])"
    echo "command: df --output=fstype /tmp"
    echo "  /tmp, which these runs do NOT use: $(df --output=fstype /tmp | tail -1 | tr -d ' '), available $(df -h --output=avail /tmp | tail -1 | tr -d ' ')"
    
    for target in host i686-unknown-linux-musl; do
      if [ "$target" = host ]; then
        tflag=()
        XD=target/debug/xlsx-diff
      else
        tflag=(--target "$target")
        XD=target/i686-unknown-linux-musl/debug/xlsx-diff
      fi
      echo
      echo "### $target"
      echo "command: cargo test -p emend --no-run ${tflag[*]}"
      cargo test -p emend --no-run "${tflag[@]}" >"$T/norun-$target.out" 2>&1 </dev/null
      rc=$?
      echo "exit: $rc"
      BIN=$(sed -n 's/^ *Executable unittests src\/lib\.rs (\(.*\))$/\1/p' "$T/norun-$target.out" | tail -1)
      echo "test executable: $BIN"
      [ -x "$BIN" ] && echo "  test executable $BIN: sha256 $(sha256sum <"$BIN" | cut -d' ' -f1)"
      built_ok() { [ "$rc" -eq 0 ] && [ -n "$BIN" ] && [ -x "$BIN" ]; }
      check "$target: build exit 0 and an executable named" "$(yn built_ok)"
      if [ -x "$XD" ]; then
        echo "EMEND_XLSX_DIFF: $XD, sha256 $(sha256sum <"$XD" | cut -d' ' -f1)"
      else
        echo "EMEND_XLSX_DIFF: $XD MISSING"; fail=1
      fi
      check "$target: the harness binary of this target is executable" "$(yn [ -x "$XD" ])"
    
      echo "command: TMPDIR=<scratch> EMEND_XLSX_DIFF=$XD /usr/bin/time -v $BIN --ignored zip64 --test-threads=1"
      TMPDIR="$BIG" EMEND_XLSX_DIFF="$MAIN/$XD" /usr/bin/time -v -o "$T/time-$target.txt" \
        "$BIN" --ignored zip64 --test-threads=1 >"$T/big-$target.out" 2>&1 </dev/null
      brc=$?
      echo "exit: $brc"
      echo "output:"
      hide <"$T/big-$target.out" | sed 's/^/    /'
      echo "/usr/bin/time -v, selected lines:"
      LC_ALL=C "$G" -E 'Elapsed \(wall clock\)|Maximum resident set size|Exit status' "$T/time-$target.txt" | sed 's/^[[:space:]]*/    /'
      rss=$(LC_ALL=C "$G" -a -m 1 -F 'Maximum resident set size (kbytes): ' "$T/time-$target.txt" | sed 's/^.*: //')
      npass=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/big-$target.out")
      nfail=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$T/big-$target.out")
      big_ok() { [ "$brc" -eq 0 ] && [ "$npass" -eq 1 ] && [ "$nfail" -eq 0 ]; }
      check "$target: exit 0, 1 passed and 0 failed" "$(yn big_ok)"
      check "$target: the 4 GiB test ran and was not filtered out" \
        "$(yn [ "$(count_matches -E '^test archive::tests::zip64_replace_in_an_archive_over_4_gib \.\.\. ok$' "$T/big-$target.out")" = 1 ])"
      rss_ok() { [ -n "$rss" ] && [ "$rss" -lt 65536 ]; }
      check "$target: maximum resident set size $rss kB is under 65536 kB (64 MiB)" "$(yn rss_ok)"
      n=$(count_bytes "$CTRL_CLASS" "$T/big-$target.out")
      check "$target: control bytes in the 4 GiB output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
      left=$(count_named "$BIG" 'emend-4gib-*')
      echo "  fixtures left in <scratch> after the run: $left"
      check "$target: the test removed its files" "$(yn [ "$left" = 0 ])"
    done
    
    echo
    echo "## status after the runs"
    st_all=$(run_lines git status --porcelain)
    st_untracked_log=$(run_matches -E '^[?][?] records/logs/m1p1-p3' git status --porcelain)
    st_tracked_log=$(run_matches -E '^ ?[MARCD] records/logs/m1p1-p3' git status --porcelain)
    st_record=$(run_matches -E '^(\?\?| ?[MARCD]) records/size-m1p1-' git status --porcelain)
    echo "status lines: $st_all; untracked under the log directory: $st_untracked_log; tracked and modified under it: $st_tracked_log; the phase's size record: $st_record"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_untracked_log" != error ] &&
        [ "$st_tracked_log" != error ] && [ "$st_record" != error ] &&
        [ "$st_all" = "$((st_untracked_log + st_tracked_log + st_record))" ]
    }
    check "every change in the working tree is one of this phase's logs or its size record" "$(yn status_accounted)"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

