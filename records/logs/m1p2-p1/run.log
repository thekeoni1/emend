## script
    #!/usr/bin/env bash
    # Milestone 1 part 2 P1 run.log (specs/0009-package-layer.md, "P1" and
    # "Harness runs"): the corpus run on both targets with the LibreOffice open
    # check and --tool-arg --xml-null-rewrite, and the record pair.
    #
    # P1's acceptance, in the spec's words: "every `.xml` and `.rels` entry
    # `recompressed` or `identical`, never `changed`, with `descriptor` alone
    # allowed as `specs/0008` says for a replaced entry (an entry whose
    # recompressed bytes equal the input's is `identical` and unflagged); every
    # other entry `identical` unflagged; `lo` and `lo_in` `ok`; diff exit 0 or 1.
    # The run log counts the XML-named entries from the diff rows and asserts every
    # one has one of the two statuses."
    #
    # That acceptance lives in the ENTRY rows, not in the summary, so this log
    # asserts it there, per entry class. T3 P4 is why: with the zip crate's own raw
    # copy every one of the 870 entries stayed identical and every one was flagged,
    # and a summary-only check would have called that a pass.
    #
    # This log also asserts what the summary CANNOT show: that every rewritten
    # part's decompressed bytes are unchanged, by comparing crc_in with crc_out and
    # uncompressed_in with uncompressed_out on every XML-named row. A null rewrite
    # that lost or added a byte would keep its status and change its CRC, so this
    # is the corpus-scale form of the reconstruction property the unit tests check
    # on byte-built parts.
    #
    # DERIVED FROM the M1 part 1 P1 run script as its log printed it, audited
    # against specs/0001 before this run. What changed, and why:
    #  1. The acceptance is part 2 P1's, which is not part 1's. The null rewrite
    #     REPLACES every XML-named entry, so files_identical is expected to be no,
    #     the diff is expected to exit 1 rather than 0, and recompressed entries
    #     are expected rather than forbidden. Asserting part 1's clauses here would
    #     fail on a correct run.
    #  2. The entry rows are classified by NAME into the two classes the spec
    #     names, and each class is asserted separately, since "every entry
    #     identical and unflagged" is true of one class and false of the other.
    #  3. The part 1 script asserted the record pair by calling the `is` helper on
    #     a bracket test and chaining a second bracket test after it with the
    #     and-operator inside one substitution, a form specs/0001 forbids because
    #     only the first test is captured: the .txt half was never checked. It is a
    #     named function here. (The form is described and never quoted, so this
    #     log's printed script does not trip the shape grep the scan log runs.)
    #  4. --tool-arg --xml-null-rewrite is passed, and the run row's tool_args
    #     column is asserted to record it, so the log cannot be mistaken for a
    #     no-edit run.
    #  5. The entries header is printed and every column the classifying form
    #     indexes by name is asserted present, with a pair of controls. Added for
    #     this rerun; item 2 of the RERUN_NOTE below says why.
    #
    # RERUN_NOTE. This log supersedes the run.log of the same phase run at commit
    # 7a856adac9e00b3b6050c4132e016dd409f02bd1, 55702 bytes, sha256
    # 7f5e7abbde02db2110f08f652f7254f604cb374f792ac0c56ebc0e0aec4c77e1, which was
    # never committed. That log passed: it printed "run log checks all as expected:
    # yes", 54 as-expected lines and no UNEXPECTED line, and the figures below
    # should reproduce it. It is superseded for two reasons, neither a failure of
    # the run:
    #  1. The phase's code commits were redone, so its commit is no longer in the
    #     phase's history. A doc sentence in crates/emend/src/xml.rs wrongly said
    #     Error::Io was "returned unchanged" when parse_error carries the kind
    #     across (quick-xml holds the error in an Arc to stay Clone), and planning's
    #     rulings 5 to 8 arrived as a fourth doc commit. No behaviour changed.
    #  2. Independent check 1 observed that the classifying form resolves its
    #     columns by header name while this log asserted nowhere that those columns
    #     exist, so a renamed column would have pinned xml_crc_differs and
    #     xml_size_differs at 0 with the fixture control still passing. The check
    #     confirmed the names do exist in the unchanged runner, so the earlier
    #     figures were sound; item 5 above closes the class in the log itself.
    #
    # Workbooks appear as ids only. No original name, note, producer_version or
    # app, and no corpus path: the corpus directory is written <corpus>
    # (specs/0005-corpus.md, planning ruling 5 of 2026-09-16). Entry NAMES are
    # quoted, which the corpus rules allow, and only for a row that violates an
    # expectation.
    #
    # Usage: m1p2-run.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m1p2-p1/run.log. Expected to take some minutes, so the
    # caller starts it detached and polls.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    LO_IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    SHORT=$(git rev-parse --short HEAD)
    DATE=$(date -u +%Y-%m-%d)
    OUT=$CORPUS/runs/$DATE-$SHORT
    STEM=m1p2-p1-$DATE-$SHORT
    OPERATION=--xml-null-rewrite
    fail=0
    note() { echo "  $1: $2"; [ "$2" = as-expected ] || fail=1; }
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    # For a control that must FAIL. `is ! f x` cannot express it: `!` is a shell
    # keyword, so "$@" tries to run a command named "!", which is not found, and
    # the helper prints UNEXPECTED whatever f does. The first draft of this log's
    # column control used that form and printed UNEXPECTED on a sound fixture; the
    # run was stopped and this helper written instead.
    isnot() { if "$@"; then echo UNEXPECTED; else echo as-expected; fi; }
    hide() { sed "s#$CORPUS#<corpus>#g; s#$MAIN#<repo>#g; s#$HOME#<home>#g"; }
    
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    [ -d "$CORPUS" ] || { echo "no corpus directory" >&2; exit 2; }
    mkdir -p "$CORPUS/runs" || { echo "cannot create the runs directory" >&2; exit 2; }
    
    # nrows <tsv>: data rows, header excluded.
    nrows() { awk -F'\t' 'NR > 1 { n++ } END { print n + 0 }' "$1"; }
    
    # entry_counts resolves its columns by header NAME. If the runner's header ever
    # named them otherwise, awk would compare $0 with $0 and xml_crc_differs and
    # xml_size_differs would sit at 0 whatever the data said, while the fixture
    # control below, which supplies its own header, still passed. Independent
    # check 1 of this phase raised that as the one class of green line it could not
    # rule out from the log alone, so the real header is printed and every column
    # the form indexes is asserted present. One condition, one function.
    COLUMNS_USED='id name status flags crc_in crc_out uncompressed_in uncompressed_out'
    columns_resolve() {
      awk -F'\t' -v want="$2" '
        NR == 1 {
          for (i = 1; i <= NF; i++) have[$i] = 1
          n = split(want, w, " ")
          for (j = 1; j <= n; j++) if (!(w[j] in have)) miss++
          exit
        }
        END { exit (miss > 0) }' "$1"
    }
    # count_where <tsv> <column> <value>: rows whose named column equals the value.
    count_where() {
      awk -F'\t' -v c="$2" -v v="$3" '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next }
        k && $k == v { n++ } END { print n + 0 }' "$1"
    }
    # count_in <tsv> <column> <value> <value>: rows whose column is either value.
    count_in() {
      awk -F'\t' -v c="$2" -v u="$3" -v v="$4" '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next }
        k && ($k == u || $k == v) { n++ } END { print n + 0 }' "$1"
    }
    # sum_col <tsv> <column>: the numeric total of a column.
    sum_col() {
      awk -F'\t' -v c="$2" '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next }
        k { n += $k } END { print n + 0 }' "$1"
    }
    # xml_rows <tsv> <mode>: counts over the entry rows, split by whether the
    # entry NAME ends in .xml or .rels, ASCII case-insensitively, which is exactly
    # the rule the tool applies (tools/emend-copy/src/main.rs, is_xml_name).
    #
    # mode is one of:
    #   xml_total, xml_ok, xml_bad_status, xml_bad_flags, xml_crc_differs,
    #   other_total, other_bad_status, other_bad_flags
    # Every mode is counted in ONE awk program over one pass, so the classes
    # cannot drift apart between two passes.
    entry_counts() {
      awk -F'\t' '
        NR == 1 { for (i = 1; i <= NF; i++) idx[$i] = i; next }
        {
          name = tolower($idx["name"])
          status = $idx["status"]
          flags = $idx["flags"]
          isxml = (name ~ /\.xml$/ || name ~ /\.rels$/)
          if (isxml) {
            xml_total++
            if (status == "identical" || status == "recompressed") xml_ok++
            else xml_bad_status++
            if (flags != "" && flags != "descriptor") xml_bad_flags++
            if (flags == "descriptor") xml_descriptor++
            if ($idx["crc_in"] != $idx["crc_out"]) xml_crc_differs++
            if ($idx["uncompressed_in"] != $idx["uncompressed_out"]) xml_size_differs++
            if (status == "identical") xml_identical++
            if (status == "recompressed") xml_recompressed++
          } else {
            other_total++
            if (status != "identical") other_bad_status++
            if (flags != "") other_bad_flags++
          }
        }
        END {
          printf "xml_total=%d xml_ok=%d xml_identical=%d xml_recompressed=%d", \
            xml_total + 0, xml_ok + 0, xml_identical + 0, xml_recompressed + 0
          printf " xml_bad_status=%d xml_bad_flags=%d xml_descriptor=%d", \
            xml_bad_status + 0, xml_bad_flags + 0, xml_descriptor + 0
          printf " xml_crc_differs=%d xml_size_differs=%d", \
            xml_crc_differs + 0, xml_size_differs + 0
          printf " other_total=%d other_bad_status=%d other_bad_flags=%d\n", \
            other_total + 0, other_bad_status + 0, other_bad_flags + 0
        }' "$1"
    }
    
    echo "command: git rev-parse HEAD"
    echo "about: M1 part 2 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: Milestone 1 part 2 P1 (specs/0009-package-layer.md) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    echo "SERIALIZED: produced with no other run in flight"
    echo "DETACHED: started with setsid and nohup, stdout and stderr to a scratch"
    echo "  file, polled from later calls. The session's command tool stops a"
    echo "  background task after a few minutes and caps a foreground call at ten;"
    echo "  part 1 P1's equivalent run took about six and a half minutes and this"
    echo "  one parses every XML part as well, so a foreground call would risk a"
    echo "  half-written log."
    echo "TERMS: both target builds were finished by the gate before this run"
    echo "  started, so no cargo runs during it; foreground order host then i686;"
    echo "  nothing else running; no mid-run tuning, and a copy or conversion that"
    echo "  timed out or was killed would be recorded and listed apart, never"
    echo "  rerun with a larger value."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the copy child. The"
    echo "  slowest case was measured first, outside this log: the largest corpus"
    echo "  workbook, whose largest part is 63745347 bytes, took about 28 seconds"
    echo "  with the host debug binary and about 30 with the i686 one, so 300"
    echo "  leaves an order of magnitude. The figure is not tuned during the run."
    echo "Workbooks are cited by id only. The corpus directory's PATH is written"
    echo "  <corpus> wherever this log prints a path; its NAME appears in the"
    echo "  script printed below, in the line that takes the default CLAUDE.md"
    echo "  gives. What is private is the corpus's contents and file names."
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the entry-classifying form's own controls"
    # entry_counts is the form the whole acceptance rests on, so it is exercised
    # on a fixture whose answers are known before it is used on the run's output
    # (specs/0001: every scan form has a positive control using the same command
    # form).
    CTL=$(mktemp -d)
    printf 'id\tlabel\trow\tname\tstatus\tcrc_in\tcrc_out\tuncompressed_in\tuncompressed_out\tflags\n' >"$CTL/e.tsv"
    printf 'a\thost\t1\t[Content_Types].xml\trecompressed\tdead\tdead\t10\t10\tdescriptor\n' >>"$CTL/e.tsv"
    printf 'a\thost\t2\t_rels/.rels\tidentical\tbeef\tbeef\t20\t20\t\n' >>"$CTL/e.tsv"
    printf 'a\thost\t3\tdocProps/app.XML\trecompressed\tcafe\tcafe\t30\t30\t\n' >>"$CTL/e.tsv"
    printf 'a\thost\t4\txl/media/image1.bin\tidentical\tf00d\tf00d\t40\t40\t\n' >>"$CTL/e.tsv"
    printf 'a\thost\t5\txl/worksheets/sheet1.xml\tchanged\t1111\t2222\t50\t51\tattrs\n' >>"$CTL/e.tsv"
    printf 'a\thost\t6\txl/media/image2.bin\trecompressed\t3333\t3333\t60\t60\tmtime\n' >>"$CTL/e.tsv"
    echo "  a fixture of six rows: four sound, one XML row changed with a bad flag"
    echo "  and a differing CRC and size, one binary row recompressed and flagged"
    ctl_line=$(entry_counts "$CTL/e.tsv")
    echo "  entry_counts on the fixture: $ctl_line"
    ctl_expected="xml_total=4 xml_ok=3 xml_identical=1 xml_recompressed=2 xml_bad_status=1 xml_bad_flags=1 xml_descriptor=1 xml_crc_differs=1 xml_size_differs=1 other_total=2 other_bad_status=1 other_bad_flags=1"
    echo "  expected:                    $ctl_expected"
    note "the classifying form reports every class correctly, including the .XML name and the bad rows" \
      "$(is [ "$ctl_line" = "$ctl_expected" ])"
    
    # And the column-resolution check gets its own pair of controls, in the same
    # command form: the fixture's header carries every column the form indexes, and
    # a copy with crc_out renamed does not.
    echo "  the columns entry_counts indexes: $COLUMNS_USED"
    note "columns_resolve says yes on a header carrying all of them" \
      "$(is columns_resolve "$CTL/e.tsv" "$COLUMNS_USED")"
    sed '1s/crc_out/crc_gone/' "$CTL/e.tsv" >"$CTL/e-renamed.tsv"
    note "columns_resolve says no on the same header with crc_out renamed" \
      "$(isnot columns_resolve "$CTL/e-renamed.tsv" "$COLUMNS_USED")"
    note "control: isnot reports a passing command as UNEXPECTED, so it can fail" \
      "$(is [ "$(isnot true)" = UNEXPECTED ])"
    rm -rf "$CTL"
    
    echo
    echo "## settings"
    echo "  --timeout 300 (the copy child only); --lo-timeout 600 (per conversion,"
    echo "  input and copy each); --memory 2048 MiB; image $LO_IMAGE"
    echo "  --tool-arg $OPERATION"
    echo "  out directory: <corpus>/runs/$DATE-$SHORT"
    echo "  record stem: $STEM"
    for b in target/debug/emend-copy target/debug/xlsx-diff \
             target/i686-unknown-linux-musl/debug/emend-copy \
             target/i686-unknown-linux-musl/debug/xlsx-diff; do
      if [ -x "$b" ]; then
        echo "  $b: sha256 $(sha256sum <"$b" | cut -d' ' -f1)"
      else
        echo "  $b: MISSING"; fail=1
      fi
    done
    echo "  (gate.log prints these same four hashes; nothing is rebuilt here)"
    
    manifest_rows=$(nrows "$CORPUS/manifest.tsv")
    echo "  corpus manifest rows: $manifest_rows"
    note "the corpus holds the 27 workbooks specs/0009 counts its facts over" \
      "$(is [ "$manifest_rows" = 27 ])"
    
    for label in host i686; do
      if [ "$label" = host ]; then
        PT=target/debug/emend-copy
        XD=target/debug/xlsx-diff
      else
        PT=target/i686-unknown-linux-musl/debug/emend-copy
        XD=target/i686-unknown-linux-musl/debug/xlsx-diff
      fi
      echo
      echo "## $label run"
      echo "command: scripts/passthrough-run.sh --label $label --passthrough $PT --xlsx-diff $XD --out <corpus>/runs/$DATE-$SHORT --libreoffice $LO_IMAGE --lo-timeout 600 --timeout 300 --tool-arg $OPERATION"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" \
        --out "$OUT" --libreoffice "$LO_IMAGE" --lo-timeout 600 --timeout 300 \
        --tool-arg "$OPERATION" \
        >"$OUT-$label.stdout" 2>"$OUT-$label.stderr"
      rc=$?
      ended=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      echo "  started $started; ended $ended; exit $rc; stderr bytes: $(wc -c <"$OUT-$label.stderr")"
      hide <"$OUT-$label.stdout" | sed 's/^/    /'
      if [ -s "$OUT-$label.stderr" ]; then hide <"$OUT-$label.stderr" | sed 's/^/    stderr: /'; fi
      note "$label the run exits 0" "$(is [ "$rc" -eq 0 ])"
      note "$label stderr is empty" "$(is [ "$(wc -c <"$OUT-$label.stderr")" -eq 0 ])"
    
      SUM=$OUT/summary.$label.tsv
      ENT=$OUT/entries.$label.tsv
      if [ ! -f "$SUM" ] || [ ! -f "$ENT" ]; then
        echo "  the run wrote no summary or entries file"; fail=1; continue
      fi
    
      rows=$(nrows "$SUM")
      ok=$(count_where "$SUM" outcome ok)
      diff01=$(count_in "$SUM" diff_exit 0 1)
      fid_no=$(count_where "$SUM" files_identical no)
      lo=$(count_where "$SUM" lo ok)
      lo_in=$(count_where "$SUM" lo_in ok)
      noleft=$(count_where "$SUM" leftover no)
      order=$(count_where "$SUM" order_preserved yes)
      comment=$(count_where "$SUM" comment_equal yes)
      changed=$(sum_col "$SUM" changed)
      dropped=$(sum_col "$SUM" dropped)
      added=$(sum_col "$SUM" added)
      recompressed=$(sum_col "$SUM" recompressed)
      identical=$(sum_col "$SUM" identical)
      echo "  summary rows: $rows (manifest rows $manifest_rows)"
      echo "  outcome ok: $ok; diff_exit 0 or 1: $diff01; files_identical no: $fid_no"
      echo "  lo ok: $lo; lo_in ok: $lo_in; leftover no: $noleft; order_preserved yes: $order; comment_equal yes: $comment"
      echo "  entry totals from the summary: identical $identical, recompressed $recompressed, changed $changed, dropped $dropped, added $added"
      note "$label every manifest workbook produced a summary row" "$(is [ "$rows" = "$manifest_rows" ])"
      note "$label every outcome is ok" "$(is [ "$ok" = "$rows" ])"
      note "$label every diff exits 0 or 1" "$(is [ "$diff01" = "$rows" ])"
      note "$label lo is ok on every file" "$(is [ "$lo" = "$rows" ])"
      note "$label lo_in is ok on every file" "$(is [ "$lo_in" = "$rows" ])"
      note "$label no tool left a temporary behind" "$(is [ "$noleft" = "$rows" ])"
      note "$label order is preserved in every file" "$(is [ "$order" = "$rows" ])"
      note "$label the archive comment is unchanged in every file" "$(is [ "$comment" = "$rows" ])"
      note "$label no entry was changed, dropped or added" \
        "$(is [ "$((changed + dropped + added))" -eq 0 ])"
      # The rewrite replaces entries, so a byte-identical FILE would mean the
      # operation did nothing. Every file is expected to differ, and at least one
      # entry per file is expected to be recompressed.
      note "$label every file differs from its input, as a rewrite must make it" \
        "$(is [ "$fid_no" = "$rows" ])"
      note "$label at least one entry was recompressed" "$(is [ "$recompressed" -gt 0 ])"
    
      echo "  the acceptance, from the ENTRY rows, by the two classes specs/0009 names:"
      echo "    the entries header, as the runner wrote it:"
      echo "      $(head -1 "$ENT")"
      note "$label every column the classifying form indexes is in that header" \
        "$(is columns_resolve "$ENT" "$COLUMNS_USED")"
      line=$(entry_counts "$ENT")
      echo "    $line"
      # The named values are read out of the one line above, so the assertions and
      # the printed measurement cannot disagree.
      eval "$(echo "$line" | tr ' ' '\n' | sed 's/^/e_/')"
      erows=$(nrows "$ENT")
      echo "    entry rows in all: $erows; XML-named $e_xml_total; other $e_other_total"
      note "$label every entry row falls in one of the two classes" \
        "$(is [ "$((e_xml_total + e_other_total))" = "$erows" ])"
      note "$label the corpus has the 781 XML-named entries specs/0009 counts" \
        "$(is [ "$e_xml_total" = 781 ])"
      note "$label every XML-named entry is identical or recompressed" \
        "$(is [ "$e_xml_bad_status" = 0 ])"
      note "$label no XML-named entry carries a flag other than descriptor" \
        "$(is [ "$e_xml_bad_flags" = 0 ])"
      note "$label every XML-named entry keeps its CRC-32, so its bytes are unchanged" \
        "$(is [ "$e_xml_crc_differs" = 0 ])"
      note "$label every XML-named entry keeps its uncompressed size" \
        "$(is [ "$e_xml_size_differs" = 0 ])"
      note "$label every other entry is identical" "$(is [ "$e_other_bad_status" = 0 ])"
      note "$label no other entry carries any flag" "$(is [ "$e_other_bad_flags" = 0 ])"
    
      # Any row that violated an expectation is named, so a failure is actionable
      # rather than a count. Entry names are quoted, which the corpus rules allow.
      bad=$(awk -F'\t' '
        NR == 1 { for (i = 1; i <= NF; i++) idx[$i] = i; next }
        {
          name = tolower($idx["name"]); status = $idx["status"]; flags = $idx["flags"]
          isxml = (name ~ /\.xml$/ || name ~ /\.rels$/)
          bad = 0
          if (isxml) {
            if (status != "identical" && status != "recompressed") bad = 1
            if (flags != "" && flags != "descriptor") bad = 1
            if ($idx["crc_in"] != $idx["crc_out"]) bad = 1
            if ($idx["uncompressed_in"] != $idx["uncompressed_out"]) bad = 1
          } else {
            if (status != "identical") bad = 1
            if (flags != "") bad = 1
          }
          if (bad) printf "    %s %s %s [%s]\n", $idx["id"], $idx["name"], status, flags
        }' "$ENT")
      if [ -n "$bad" ]; then
        echo "  the rows that violated an expectation:"
        echo "$bad"
      else
        echo "  no row violated an expectation"
      fi
    
      echo "  per workbook, id and the acceptance columns:"
      awk -F'\t' -v l="$label" '
        NR == 1 { for (i = 1; i <= NF; i++) idx[$i] = i; next }
        { printf "    %s %s outcome=%s diff_exit=%s files_identical=%s leftover=%s lo=%s lo_in=%s identical=%s recompressed=%s changed=%s flagged=%s\n",
            $idx["id"], l, $idx["outcome"], $idx["diff_exit"], $idx["files_identical"],
            $idx["leftover"], $idx["lo"], $idx["lo_in"], $idx["identical"],
            $idx["recompressed"], $idx["changed"], $idx["flagged"] }' "$SUM"
    done
    
    echo
    echo "## the two labels agree on every entry's class and status"
    # The same input through two builds of the same code must classify identically.
    # Only the id, name and status columns are compared: compressed sizes may
    # differ between targets in principle, and the acceptance does not rest on them.
    for label in host i686; do
      awk -F'\t' '
        NR == 1 { for (i = 1; i <= NF; i++) idx[$i] = i; next }
        { print $idx["id"] "\t" $idx["name"] "\t" $idx["status"] "\t" $idx["flags"] }' \
        "$OUT/entries.$label.tsv" | sort >"$OUT-$label.classes"
    done
    if cmp -s "$OUT-host.classes" "$OUT-i686.classes"; then
      echo "  the two labels' id, name, status and flags rows are identical"
    else
      echo "  the two labels differ; the first differing rows:"
      diff "$OUT-host.classes" "$OUT-i686.classes" | head -20 | sed 's/^/    /'
    fi
    note "both targets classified every entry the same way" \
      "$(is cmp -s "$OUT-host.classes" "$OUT-i686.classes")"
    
    echo
    echo "## the run rows both labels appended"
    for label in host i686; do
      R=$OUT/run.$label.tsv
      if [ -f "$R" ]; then
        echo "  run.$label.tsv header: $(head -1 "$R")"
        echo "  run.$label.tsv row: $(sed -n 2p "$R" | hide)"
        args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next }
                           k && NR == 2 { print $k }' "$R")
        echo "  run.$label.tsv tool_args: [$args]"
        note "$label the run row records the operation, so this is not a no-edit run" \
          "$(is [ "$args" = "$OPERATION" ])"
      else
        echo "  run.$label.tsv: MISSING"; fail=1
      fi
    done
    
    echo
    echo "## the record pair"
    echo "command: scripts/passthrough-record.py --run <corpus>/runs/$DATE-$SHORT --stem $STEM"
    scripts/passthrough-record.py --run "$OUT" --stem "$STEM" >"$OUT-record.out" 2>&1
    rrc=$?
    hide <"$OUT-record.out" | sed 's/^/    /'
    note "the record script exits 0" "$(is [ "$rrc" -eq 0 ])"
    for ext in md txt; do
      f=records/$STEM.$ext
      if [ -f "$f" ]; then
        echo "  $f: $(wc -c <"$f") bytes, sha256 $(sha256sum <"$f" | cut -d' ' -f1)"
      else
        echo "  $f: MISSING"; fail=1
      fi
    done
    # One function, two conditions: the part 1 script's form captured the first
    # test alone, so the .txt half went unchecked.
    both_halves() {
      [ -f "records/$STEM.md" ] || return 1
      [ -f "records/$STEM.txt" ] || return 1
    }
    note "both halves of the record pair were written" "$(is both_halves)"
    echo "  the record's Tool arguments line:"
    LC_ALL=C "$G" -n 'Tool arguments' "records/$STEM.md" | sed 's/^/    /'
    nargs=$(count_matches -F "$OPERATION" "records/$STEM.md")
    echo "  lines of the record naming the operation: $nargs"
    note "the record names the operation it was run with" "$(is [ "$nargs" -ge 1 ])"
    
    echo
    echo "## the record pair holds no corpus path and no absolute path"
    for ext in md txt; do
      f=records/$STEM.$ext
      [ -f "$f" ] || continue
      n=$(count_matches -E '(/home/|/mnt/|/Users/|emend-testing)' "$f")
      echo "  $f: lines naming a home, mount or corpus path: $n"
      note "$f carries no such path" "$(is [ "$n" = 0 ])"
    done
    # The control for the form above, through the same command form.
    printf '/home/someone/emend-testing/corpus/x.xlsx\n' >"$OUT-path-control"
    nctl=$(count_matches -E '(/home/|/mnt/|/Users/|emend-testing)' "$OUT-path-control")
    note "control: the path form finds a planted path ($nctl)" "$(is [ "$nctl" = 1 ])"
    
    echo
    echo "## status after the runs"
    st_all=$(run_lines git status --porcelain)
    st_log=$(run_matches -E 'records/logs/m1p2-p1|records/'"$STEM" git status --porcelain)
    echo "status lines: $st_all; of them under the phase log directory or the record pair: $st_log"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_log" != error ] && [ "$st_all" = "$st_log" ]
    }
    note "every change in the working tree is a log or the record pair" "$(is status_accounted)"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

