    #!/usr/bin/env bash
    # Milestone 1 part 3 close-out push-part2.log: push.log part 2 (steps 3 and 4,
    # the push), in a file of its own because push.log part 1 was committed in the
    # record commit before the push and a committed log is never edited
    # (specs/0001 "Rules for every phase"). Planning accepted the split record.
    #
    # The push ran as `m1p3close-push.sh push <base>`, the same script push.log
    # prints, with stdout to a scratch file kept at the moment it finished. This
    # wrapper does not re-run the push: it proves the script that ran is the one
    # push.log prints, hashes the kept output, and copies it verbatim below.
    #
    # Usage: M1CLOSE_LIB=<lib> m1p3close-push2.sh <push script> <kept output> <kept stderr>
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    SCRIPT=${1:?push script}; OUT=${2:?kept output}; ERR=${3:?kept stderr}
    LIB=${M1CLOSE_LIB:?the path to the counting library is required}
    . "$LIB"
    T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    echo "command: git rev-parse HEAD -> $(git rev-parse HEAD)"
    echo "phase: Milestone 1 part 3 close-out (specs/0010-reading-cells.md \"Close-out push (after P3)\") push.log part 2, steps 3 and 4; assembled at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_FILES:-}" ]; then
      echo "rerun: superseded attempts of this wrapper, none committed, hashed by the command below"
      for sf in $RERUN_FILES; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum < "$sf" | cut -d' ' -f1)" "$(wc -c < "$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
      echo "  push2-1.out read \"no\" on the script comparison because of the log's"
      echo "  trailing empty line (see the script's comment); push2-2.out was correct"
      echo "  but its comment named attempt 1 with no hash line, which this run adds."
    fi
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$0"
    echo
    echo "## the push script that ran is the one push.log prints"
    awk '/^## script that wrote this log/ { on = 1; next } /^## / { on = 0 } on' records/logs/m1p3-close/push.log | sed 's/^    //; s/^ *$//' > "$T/printed"
    # The log writes one empty line after every printed script, before the next
    # heading, so the script that ran gets that same line before the comparison.
    # (Attempt 1 of this wrapper compared without it and read "no" on that line
    # alone.)
    { sed 's/^ *$//' "$SCRIPT"; echo; } > "$T/ran"
    echo "  sha256 of the script printed in push.log (indent removed): $(sha256sum < "$T/printed" | cut -d' ' -f1)"
    echo "  sha256 of the script that ran (same normalisation):        $(sha256sum < "$T/ran" | cut -d' ' -f1)"
    check "the push ran the script push.log prints" "$(yn cmp -s "$T/printed" "$T/ran")"
    echo "command: sha256sum and wc -c over the kept output and stderr"
    printf '    %s  %s bytes  stdout\n' "$(sha256sum < "$OUT" | cut -d' ' -f1)" "$(wc -c < "$OUT")"
    printf '    %s  %s bytes  stderr\n' "$(sha256sum < "$ERR" | cut -d' ' -f1)" "$(wc -c < "$ERR")"
    check "the push script wrote nothing on stderr" "$(yn [ "$(count_bytes '\000-\377' "$ERR")" = 0 ])"
    n=$(count_matches -F 'part 2 checks all as expected: yes' "$OUT")
    check "the kept output ends its checks all as expected: $n line(s)" "$(yn [ "$n" = 1 ])"
    echo
    echo "## the push script's output, verbatim"
    cat "$OUT"
    echo
    echo "wrapper checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

