    #!/usr/bin/env bash
    # Milestone 1 part 3 close-out push.log (specs/0010-reading-cells.md "Close-out
    # push (after P3)", which says "As part 2's, with the close-out scripts as part 2
    # ran them"), in two parts.
    #
    # DERIVED FROM part 2's close-out script as records/logs/m1p2-close/push.log
