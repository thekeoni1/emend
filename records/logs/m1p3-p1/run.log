## script
    #!/usr/bin/env bash
    # Milestone 1 part 3 P1 run.log (specs/0010-reading-cells.md, "P1: the carried
    # items; shared strings", and "Harness runs"): the corpus run on both targets
    # with --tool-arg --shared-strings, the table each workbook's line reports
    # checked against a count this script takes for itself, and the record pair.
    #
    # P1's acceptance, in the spec's words: "The corpus run --shared-strings on
    # both targets, recorded as records/m1p3-p1-<utc-date>-<shortsha>.md and .txt;
    # acceptance as 'Harness runs'." --shared-strings records no edit, so "Harness
    # runs" means the no-edit acceptance: every entry identical and unflagged,
    # files_identical yes, order_preserved yes, lo ok, on every workbook.
    #
    # THE SUBSTANTIVE CHECK IS NOT THE ACCEPTANCE. A run in which the reader
    # returned an empty table for every workbook would satisfy every clause above,
    # because an empty table edits nothing either. So each workbook's reported
    # items count is compared with a count this script takes ITSELF, by a route
    # that shares no code with the library:
    #
    #   - python3's zipfile reads [Content_Types].xml out of the workbook and a
    #     regular expression finds the Override whose ContentType names the
    #     sharedStrings part. That is the format's own rule for which entry the
    #     part is, applied by a second implementation, and it is how the count
    #     stays independent of the layer whose answer it is checking.
    #   - the part is extracted and its <si> start tags counted with grep -o.
    #   - a workbook with no such Override must report items=0, and one with the
    #     Override must report exactly the number of start tags counted.
    #
    # The totals are then asserted against the spec's own figure: 110582 <si>
    # across the corpus ("Facts planning checked"). Per workbook AND in total, because either
    # alone can be satisfied while the other fails: a reader that lost items in
    # one workbook and invented them in another would total correctly, and a
    # per-workbook agreement between two counts that were both wrong the same way
    # would miss the spec's figure.
    #
    # DERIVED FROM the M1 part 2 P2 run script as records/logs/m1p2-p2/run.log
    # printed it, and not from P3's, audited against specs/0001 before this run
    # (the rule from memory/gotchas.md: a script reused from an older phase's
    # printed log carries that phase's forbidden forms). P2's is the ancestor
    # because P2's acceptance was the no-edit one, which is P1's; P3's classified
    # the workbooks into two acceptances, which P1 does not. What changed, and why:
    #  1. The operation is --shared-strings and there is ONE runner pass per
    #     target, not two: P3 needed a survey pass beside its edit pass because
    #     its acceptance differed by workbook and the survey said which class a
    #     workbook was in. P1's acceptance is one rule for all 27, so a second
    #     pass would measure nothing the first does not.
    #  2. entry_counts is the NO-EDIT form: every entry identical, flags empty
    #     with descriptor alone allowed. P2's form sorted entries into XML-named
    #     and other because P2 rewrote every XML-named one; nothing is rewritten
    #     here, so that split would name a distinction this run does not make.
    #  3. strings_counts replaces survey_counts, over the lines --shared-strings
    #     prints. Both keys are read by NAME, never by position.
    #  4. si_count and the per-workbook comparison are new, and are the reason
    #     this log is worth running. Described above.
    #  5. The control fixture drives EVERY counter by name (P3 ruling 3): each
    #     count this script reports is shown moving off zero on a fixture built to
    #     move it, and the expected line is written out in full and compared as
    #     one string, so a counter that was silently dropped from the program
    #     fails the control instead of reporting a zero nobody reads.
    #  6. The record's privacy check is a NAMED FUNCTION with two controls. The
    #     first attempt of this log handed an assignment prefix to `isnot`, which
    #     runs its arguments as a command: the shell looked for a command named
    #     LC_ALL=C, failed with 127, and the check reported as-expected whatever
    #     the record held. Same failure as the leading bang specs/0001 forbids,
    #     different spelling, and the scan's shape greps look for the bang alone.
    #     The attempt is hashed and kept; planning is asked whether the greps
    #     should widen.
    #  7. RUN_SUFFIX and the fresh-directory guard. The runner refuses to add a
    #     second row for a workbook to an existing summary, so a rerun at the same
    #     commit on the same day collides with its predecessor's directory. The
    #     second attempt of this log did collide: the runner refused both passes
    #     and every count below was then read from the FIRST attempt's files,
    #     which reported as-expected while measuring a run this log did not make.
    #     The guard now checks the directory before either pass and stops, so a
    #     collision cannot be mistaken for a result. Both attempts are hashed and
    #     kept.
    #  8. Neither shape specs/0001 forbids appears here: no check chains a second
    #     condition after a bracket test inside one command substitution, and no
    #     negation is handed to a helper as a leading bang. Every compound
    #     condition is a named function. The shapes are described rather than
    #     written out, so this log's own text does not trip the shape grep the
    #     phase's scan log runs over every printed script.
    #
    # PRIVACY. This log reports counts and entry names only. A shared string IS
    # content, so no item, no length of a single item and no fragment of one is
    # printed, by this script or by the tool it runs: the tool prints two numbers.
    # Workbooks appear as ids only, never as names, and the corpus directory's
    # path is written <corpus> wherever a path is printed (specs/0005-corpus.md,
    # planning ruling 5 of 2026-09-16).
    #
    # Usage: m1p3-p1-run.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m1p3-p1/run.log. One runner pass per target over 27
    # workbooks with a LibreOffice conversion of the input and of the output each,
    # so the caller starts it detached and polls.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    # The commit is passed in and then NAMED in the about line below, so it has to
    # be checked against HEAD or the line says only what the caller typed.
    # test.sh and negative.sh have had this guard from the start; this script did
    # not, which independent check 3 found. In every run of this log HEAD did equal
    # the argument, so no committed line was ever wrong, but nothing here made that
    # true and the about line was the one place it mattered.
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    LO_IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    SHORT=$(git rev-parse --short HEAD)
    DATE=$(date -u +%Y-%m-%d)
    # The run directory. RUN_SUFFIX distinguishes a rerun at the SAME commit on
    # the same day: the runner refuses to add a second row for a workbook to an
    # existing summary, and without a new directory a rerun's checks would read
    # the PREVIOUS attempt's files and report on those. The second attempt of this
    # log did exactly that, which is why the suffix exists and why the guard below
    # stops the run before the runner is called rather than after.
    OUT=$CORPUS/runs/$DATE-$SHORT${RUN_SUFFIX:+-$RUN_SUFFIX}
    STEM=m1p3-p1-$DATE-$SHORT
    OP=--shared-strings
    # specs/0010-reading-cells.md, "Facts planning checked": 110582 <si> across the corpus's
    # 27 shared strings parts. Named here so the assertion below reads the figure
    # from one place and the log prints where it came from.
    SPEC_ITEMS=110582
    SPEC_FILES=27
    fail=0
    
    # note <what> <verdict>: one verdict line, and a verdict other than
    # as-expected fails the log.
    note() { echo "  $1: $2"; [ "$2" = as-expected ] || fail=1; }
    # is <command...>: as-expected when the command succeeds.
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    # isnot <command...>: as-expected when it fails. Its own helper so that no
    # call hands a negation to `is`, which specs/0001 forbids as a shape.
    isnot() { if "$@"; then echo UNEXPECTED; else echo as-expected; fi; }
    hide() { sed "s#$CORPUS#<corpus>#g; s#$MAIN#<repo>#g; s#$HOME#<home>#g"; }
    
    G=/usr/bin/grep
    TAB=$(printf '\t')
    
    # nrows <tsv>: data rows, header excluded.
    nrows() { awk -F'\t' 'NR > 1 { n++ } END { print n + 0 }' "$1"; }
    
    # columns_resolve <tsv> <names>: every named column is in the file's header.
    #
    # The END rule is P2 ruling 10's: with NR == 1 as its only rule this form
    # reported as-expected on an empty or headerless file, so the guard was
    # vacuous. It now fails when no header line was seen at all, and a control on
    # an empty file runs below rather than the fix being asserted.
    COLUMNS_USED='id name status flags crc_in crc_out uncompressed_in uncompressed_out'
    columns_resolve() {
      awk -F'\t' -v want="$2" '
        NR == 1 {
          seen = 1
          for (i = 1; i <= NF; i++) have[$i] = 1
          n = split(want, w, " ")
          for (j = 1; j <= n; j++) if (!(w[j] in have)) miss++
          exit
        }
        END { exit (seen != 1 || miss > 0) }' "$1"
    }
    # count_where <tsv> <column> <value>: rows whose named column equals the value.
    count_where() {
      awk -F'\t' -v c="$2" -v v="$3" '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next }
        k && $k == v { n++ } END { print n + 0 }' "$1"
    }
    
    # entry_counts <entries.tsv>: every entry row classified against the no-edit
    # acceptance, in ONE awk program so two classes cannot drift apart between
    # passes. Columns are read by NAME: the runner prints them in a fixed order
    # but an assertion resting on that order would pass for the wrong reason if
    # the order ever changed.
    #
    # descriptor alone is allowed in flags, as in every phase of this milestone: a
    # data descriptor the input carried is reproduced, and the harness flags it on
    # an entry that is otherwise byte-identical.
    entry_counts() {
      awk -F'\t' '
        NR == 1 { for (i = 1; i <= NF; i++) idx[$i] = i; next }
        {
          total++
          status = $idx["status"]
          flags = $idx["flags"]
          if (status == "identical") identical++
          else bad_status++
          if (status == "changed") changed++
          if (status == "dropped") dropped++
          if (status == "added") added++
          if (status == "recompressed") recompressed++
          if (flags == "descriptor") descriptor++
          else if (flags != "") bad_flags++
          if ($idx["crc_in"] != $idx["crc_out"]) crc_differs++
          if ($idx["uncompressed_in"] != $idx["uncompressed_out"]) size_differs++
        }
        END {
          printf "rows=%d identical=%d bad_status=%d", \
            total + 0, identical + 0, bad_status + 0
          printf " changed=%d dropped=%d added=%d recompressed=%d", \
            changed + 0, dropped + 0, added + 0, recompressed + 0
          printf " descriptor=%d bad_flags=%d", descriptor + 0, bad_flags + 0
          printf " crc_differs=%d size_differs=%d\n", \
            crc_differs + 0, size_differs + 0
        }' "$1"
    }
    
    # strings_counts <file...>: one pass over every line --shared-strings printed,
    # reporting what P1's acceptance names. Keys are read by NAME out of the
    # key=value pairs, never by position.
    #
    # not_strings counts a line whose first field is not the word strings, and
    # malformed counts one that does not carry both keys: a line the tool never
    # printed, or printed differently, must show up as a count and not be skipped
    # into silence.
    strings_counts() {
      awk '
        {
          lines++
          if ($1 != "strings") { not_strings++; next }
          items = ""; bytes = ""
          for (i = 2; i <= NF; i++) {
            split($i, kv, "=")
            if (kv[1] == "items") items = kv[2]
            if (kv[1] == "bytes") bytes = kv[2]
          }
          if (items == "" || bytes == "") { malformed++; next }
          good++
          items_total += items
          bytes_total += bytes
          if (items + 0 == 0) empty_tables++
          if (items + 0 > max_items) max_items = items + 0
        }
        END {
          printf "lines=%d good=%d not_strings=%d malformed=%d", \
            lines + 0, good + 0, not_strings + 0, malformed + 0
          printf " items_total=%d bytes_total=%d", items_total + 0, bytes_total + 0
          printf " empty_tables=%d max_items=%d\n", empty_tables + 0, max_items + 0
        }' "$@"
    }
    
    # wb_path <id>: the corpus file that id names.
    #
    # The runner builds its inputs as <corpus>/corpus/<id>.<ext> with ext taken
    # from the manifest's ext column (scripts/passthrough-run.sh), so this reads
    # the same column rather than globbing for whatever is there: a glob would
    # resolve to a second file if one were ever added beside a workbook, and the
    # comparison below would then be against the wrong package without saying so.
    wb_path() {
      awk -F'\t' -v want="$1" '
        NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next }
        $k["id"] == want { print $k["ext"]; exit }' "$CORPUS/manifest.tsv" |
      while read -r ext; do printf '%s/corpus/%s.%s\n' "$CORPUS" "$1" "$ext"; done
    }
    
    # si_count <workbook>: the <si> start tags in that workbook's shared strings
    # part, counted without the library.
    #
    # python3's zipfile reads [Content_Types].xml and a regular expression finds
    # the Override whose ContentType names the sharedStrings part; the part it
    # names is extracted and its start tags counted. python3 is already the
    # repository's tool for corpus work (scripts/corpus-add.py,
    # scripts/corpus-coverage.py, scripts/passthrough-record.py).
    #
    # The tag pattern requires a delimiter after the name, so an element whose
    # name merely BEGINS with si is not counted; the control below drives exactly
    # that. Nothing of the part's bytes reaches this log: the function prints a
    # number, or the word none when the workbook declares no such part, or error.
    si_count() {
      python3 - "$1" <<'PY' 2>/dev/null || echo error
    import re, sys, zipfile
    try:
        with zipfile.ZipFile(sys.argv[1]) as z:
            types = z.read("[Content_Types].xml").decode("utf-8", "replace")
            part = None
            for m in re.finditer(r"<Override\b[^>]*>", types):
                tag = m.group(0)
                ct = re.search(r'ContentType="([^"]*)"', tag)
                pn = re.search(r'PartName="([^"]*)"', tag)
                if ct and pn and ct.group(1).endswith("sharedStrings+xml"):
                    part = pn.group(1).lstrip("/")
                    break
            if part is None:
                sys.stdout.write("none")
            else:
                body = z.read(part)
                sys.stdout.write(str(len(re.findall(rb"<si[ />]", body))))
    except Exception as err:
        sys.stdout.write("error %s" % type(err).__name__)
    PY
    }
    
    RUN_START=$(date +%s.%N)
    echo "command: git rev-parse HEAD"
    echo "about: M1 part 3 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # Printed as well as guarded above, so a reader sees the comparison was made
    # rather than inferring it from two halves of the same line agreeing.
    echo "  the commit named above was compared with HEAD before this run started,"
    echo "  and this run stops before any pass if they differ"
    echo "phase: Milestone 1 part 3 P1 (specs/0010-reading-cells.md) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      # specs/0001 "Rules for every phase": every sha256 a log cites, a superseded
      # attempt's included, is PRINTED BY A COMMAND run over a file that exists at
      # run time, never typed from memory. The note above names its predecessors;
      # these lines are what make those names evidence. An attempt that was not
      # kept is named as having no hash, and why.
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    echo
    echo "SERIALIZED: produced with no other run in flight"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go"
    echo "  to a scratch file, polled from later calls. Started as a background"
    echo "  task of the calling session, not with setsid, whose fork would lose"
    echo "  the run's exit status. This log makes ONE runner pass per target over"
    echo "  the 27 workbooks, each with a LibreOffice conversion of the input and"
    echo "  of the output, so a foreground call would risk a half-written log."
    echo "TERMS: both target builds were finished by the gate before this run"
    echo "  started, so no cargo runs during it; foreground order host then i686;"
    echo "  nothing else running; no mid-run tuning, and a copy or conversion that"
    echo "  timed out or was killed would be recorded and listed apart, never"
    echo "  rerun with a larger value."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the copy child, the"
    echo "  figure P1, P2 and P3 of part 2 measured and used: the largest corpus"
    echo "  workbook, whose largest part is 63745347 bytes, took about 28 seconds"
    echo "  with the host debug binary and about 30 with the i686 one."
    echo "  --shared-strings parses the workbook, its rels and one more part, so"
    echo "  300 still leaves an order of magnitude. Not tuned during the run."
    echo "WHAT THIS LOG DOES NOT PRINT: no shared string item, no length of a"
    echo "  single item, and no fragment of either. The tool prints two counts per"
    echo "  workbook and this script prints counts and entry names."
    echo "Workbooks are cited by id only. The corpus directory's PATH is written"
    echo "  <corpus> wherever this log prints a path; its NAME appears in the"
    echo "  script printed below, in the line that takes the default CLAUDE.md"
    echo "  gives. What is private is the corpus's contents and file names."
    echo
    echo "## the figures this run is judged against, and where they come from"
    echo "  specs/0010-reading-cells.md, \"Facts planning checked\": $SPEC_ITEMS <si> across"
    echo "    the corpus's $SPEC_FILES shared strings parts, one per workbook."
    echo "  Every other number below is measured by this run."
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    echo
    
    CTL=$(mktemp -d)
    trap 'rm -rf "$CTL"' EXIT
    
    echo "## the column guard's own controls (P2 ruling 10)"
    printf 'id\tname\tstatus\tflags\tcrc_in\tcrc_out\tuncompressed_in\tuncompressed_out\n' >"$CTL/head.tsv"
    note "columns_resolve finds every column it is given" \
      "$(is columns_resolve "$CTL/head.tsv" "$COLUMNS_USED")"
    printf 'id\tname\tstatus\n' >"$CTL/short.tsv"
    note "columns_resolve fails when a column is missing" \
      "$(isnot columns_resolve "$CTL/short.tsv" "$COLUMNS_USED")"
    : >"$CTL/empty.tsv"
    note "columns_resolve fails on a file with no header line at all" \
      "$(isnot columns_resolve "$CTL/empty.tsv" "$COLUMNS_USED")"
    echo
    
    echo "## the entry classifier's own controls (P3 ruling 3: every counter by name)"
    echo "  A fixture of one sound workbook and one of every fault the acceptance"
    echo "  names, so each count below is shown moving off zero on a row built to"
    echo "  move it. The expected line is written out in full and compared as one"
    echo "  string: a counter dropped from the program fails here instead of"
    echo "  reporting a zero nobody reads."
    printf 'id\tname\tstatus\tflags\tcrc_in\tcrc_out\tuncompressed_in\tuncompressed_out\n' >"$CTL/e.tsv"
    printf 'a\t[Content_Types].xml\tidentical\t\t1\t1\t10\t10\n' >>"$CTL/e.tsv"
    printf 'a\txl/workbook.xml\tidentical\tdescriptor\t2\t2\t20\t20\n' >>"$CTL/e.tsv"
    printf 'b\txl/sharedStrings.xml\tchanged\t\t3\t4\t30\t29\n' >>"$CTL/e.tsv"
    printf 'b\txl/calcChain.xml\tdropped\t\t5\t\t40\t\n' >>"$CTL/e.tsv"
    printf 'b\txl/new.xml\tadded\t\t\t6\t\t50\n' >>"$CTL/e.tsv"
    printf 'b\txl/styles.xml\trecompressed\tmtime\t7\t7\t60\t60\n' >>"$CTL/e.tsv"
    ectl_line=$(entry_counts "$CTL/e.tsv")
    ectl_expected='rows=6 identical=2 bad_status=4 changed=1 dropped=1 added=1 recompressed=1 descriptor=1 bad_flags=1 crc_differs=3 size_differs=3'
    echo "  entry_counts on the fixture: $ectl_line"
    echo "  expected:                    $ectl_expected"
    note "entry_counts reports every counter, each moved by a row built to move it" \
      "$(is [ "$ectl_line" = "$ectl_expected" ])"
    printf 'id\tname\tstatus\tflags\tcrc_in\tcrc_out\tuncompressed_in\tuncompressed_out\n' >"$CTL/g.tsv"
    printf 'a\txl/workbook.xml\tidentical\t\t1\t1\t10\t10\n' >>"$CTL/g.tsv"
    gctl_line=$(entry_counts "$CTL/g.tsv")
    gctl_expected='rows=1 identical=1 bad_status=0 changed=0 dropped=0 added=0 recompressed=0 descriptor=0 bad_flags=0 crc_differs=0 size_differs=0'
    echo "  entry_counts on a sound one-row fixture: $gctl_line"
    echo "  expected:                                $gctl_expected"
    note "entry_counts reports all zeros on a row the acceptance accepts" \
      "$(is [ "$gctl_line" = "$gctl_expected" ])"
    echo
    
    echo "## the strings line reader's own controls (P3 ruling 3)"
    echo "  Every key is read by name, so the fixture puts the pairs in the other"
    echo "  order in one line, and every class the reader counts gets a line."
    {
      printf 'strings\titems=3\tbytes=12\n'
      printf 'strings\tbytes=7\titems=2\n'
      printf 'strings\titems=0\tbytes=0\n'
      printf 'strings\titems=9\n'
      printf 'survey\tentries=5\n'
    } >"$CTL/s.txt"
    sctl_line=$(strings_counts "$CTL/s.txt")
    sctl_expected='lines=5 good=3 not_strings=1 malformed=1 items_total=5 bytes_total=19 empty_tables=1 max_items=3'
    echo "  strings_counts on the fixture: $sctl_line"
    echo "  expected:                      $sctl_expected"
    note "strings_counts reports every counter, each moved by a line built to move it" \
      "$(is [ "$sctl_line" = "$sctl_expected" ])"
    note "strings_counts read the pairs by name and not by position" \
      "$(is [ "$(printf 'strings\tbytes=7\titems=2\n' | strings_counts - | sed 's/.*items_total=\([0-9]*\).*/\1/')" = 2 ])"
    echo
    
    echo "## the independent <si> counter's own controls (P3 ruling 3)"
    echo "  Three fixtures built here as zips, so the counter is exercised on"
    echo "  packages whose answers are known before it is used. The faulty one"
    echo "  carries an element whose name BEGINS with si, which a pattern without"
    echo "  a delimiter would count."
    python3 - "$CTL" <<'PY'
    import os, sys, zipfile
    d = sys.argv[1]
    TYPES = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
             '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
             '<Default Extension="xml" ContentType="application/xml"/>'
             '%s</Types>')
    OVER = ('<Override PartName="/xl/sharedStrings.xml" ContentType="application/vnd.'
            'openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"/>')
    NS = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    def build(name, types, parts):
        with zipfile.ZipFile(os.path.join(d, name), "w") as z:
            z.writestr("[Content_Types].xml", types)
            for pn, body in parts.items():
                z.writestr(pn, body)
    # three plain items
    build("three.xlsx", TYPES % OVER, {"xl/sharedStrings.xml":
        '<sst xmlns="%s"><si><t>a</t></si><si><t>b</t></si><si><t>c</t></si></sst>' % NS})
    # no Override for a shared strings part at all
    build("nostrings.xlsx", TYPES % "", {"xl/workbook.xml": '<workbook xmlns="%s"/>' % NS})
    # two real items beside an element whose name begins with si, an empty item
    # written as a self-closing tag, and one carrying an attribute
    build("tricky.xlsx", TYPES % OVER, {"xl/sharedStrings.xml":
        '<sst xmlns="%s"><si><t>a</t></si><sic>not an item</sic>'
        '<si/><si x="1"><t>b</t></si></sst>' % NS})
    PY
    echo "  si_count on a part with three plain items: $(si_count "$CTL/three.xlsx") (expect 3)"
    note "si_count counts the plain items" "$(is [ "$(si_count "$CTL/three.xlsx")" = 3 ])"
    echo "  si_count on a workbook declaring no shared strings part: $(si_count "$CTL/nostrings.xlsx") (expect none)"
    note "si_count says none where the package declares no such part" \
      "$(is [ "$(si_count "$CTL/nostrings.xlsx")" = none ])"
    echo "  si_count on the faulty fixture: $(si_count "$CTL/tricky.xlsx") (expect 3)"
    echo "    three items there: one plain, one self-closing, one with an"
    echo "    attribute; the sic element is not one of them."
    note "si_count counts the self-closing and attributed items and not the sic element" \
      "$(is [ "$(si_count "$CTL/tricky.xlsx")" = 3 ])"
    echo "  si_count on a file that is not a zip: $(si_count "$CTL/e.tsv")"
    note "si_count reports an error rather than a number on a file it cannot read" \
      "$(isnot [ "$(si_count "$CTL/e.tsv")" -ge 0 ] 2>/dev/null)"
    echo
    
    echo "## binaries"
    # The DEBUG binaries, which are what the gate builds and what gate.log
    # hashed. The release ones are the size log's business and this phase writes
    # none; citing a release path here would name a file the gate never made.
    PT=$MAIN/target/debug/emend-copy
    XD=$MAIN/target/debug/xlsx-diff
    PT6=$MAIN/target/i686-unknown-linux-musl/debug/emend-copy
    XD6=$MAIN/target/i686-unknown-linux-musl/debug/xlsx-diff
    echo "command: sha256sum over the four binaries the gate left"
    for b in "$PT" "$XD" "$PT6" "$XD6"; do
      if [ -f "$b" ]; then sha256sum "$b" | hide | sed 's/^/    /'
      else echo "    MISSING: $(printf '%s' "$b" | sed "s#$MAIN#<repo>#")"; fail=1; fi
    done
    echo "  These are the binaries gate.log hashed; this log cites them rather"
    echo "  than rebuilding, so no cargo runs during the corpus passes."
    echo
    echo "## runner settings, chosen before the run"
    echo "  --timeout 300 (the copy child only); --lo-timeout 600 (per conversion,"
    echo "  input and copy each); --memory 2048 MiB; image $LO_IMAGE"
    echo "  --tool-arg $OP"
    echo
    
    # Before either pass: the run directory must hold no summary for either
    # label. A directory left by an earlier attempt would be appended to, and
    # every count below would then be read from a mixture of two runs.
    echo "## the run directory is this run's own"
    echo "  run directory: $(printf '%s' "$OUT" | sed "s#$CORPUS#<corpus>#")"
    fresh_dir() {
      [ ! -f "$OUT/summary.host.tsv" ] && [ ! -f "$OUT/summary.i686.tsv" ]
    }
    note "the run directory holds no summary from an earlier attempt" "$(is fresh_dir)"
    if ! fresh_dir; then
      echo "  STOPPING: a rerun needs a new directory; set RUN_SUFFIX"
      echo "RESULT: FAIL"
      exit 1
    fi
    echo
    
    for label in host i686; do
      if [ "$label" = host ]; then P=$PT; X=$XD; else P=$PT6; X=$XD6; fi
      echo "## $label run, --tool-arg $OP"
      echo "command: scripts/passthrough-run.sh --label $label --passthrough $(printf '%s' "$P" | sed "s#$MAIN#<repo>#") --xlsx-diff $(printf '%s' "$X" | sed "s#$MAIN#<repo>#") --out $(printf '%s' "$OUT" | sed "s#$CORPUS#<corpus>#") --libreoffice $LO_IMAGE --lo-timeout 600 --timeout 300 --tool-arg $OP"
      scripts/passthrough-run.sh --label "$label" --passthrough "$P" --xlsx-diff "$X" \
        --out "$OUT" --libreoffice "$LO_IMAGE" --lo-timeout 600 --timeout 300 \
        --tool-arg "$OP" \
        >"$OUT-$label.stdout" 2>"$OUT-$label.stderr"
      rc=$?
      hide <"$OUT-$label.stdout" | sed 's/^/    /'
      if [ -s "$OUT-$label.stderr" ]; then hide <"$OUT-$label.stderr" | sed 's/^/    stderr: /'; fi
      note "$label the run exits 0" "$(is [ "$rc" -eq 0 ])"
      note "$label the run's stderr is empty" \
        "$(is [ "$(wc -c <"$OUT-$label.stderr")" -eq 0 ])"
    
      SUM=$OUT/summary.$label.tsv
      ENT=$OUT/entries.$label.tsv
      if [ ! -f "$SUM" ]; then
        echo "  the run wrote no summary file"; fail=1; continue
      fi
      rows=$(nrows "$SUM")
      echo "  summary rows: $rows"
      note "$label a summary row per corpus workbook" "$(is [ "$rows" = "$SPEC_FILES" ])"
      for k in files_identical order_preserved lo lo_in; do
        case $k in
          files_identical | order_preserved) want=yes ;;
          *) want=ok ;;
        esac
        got=$(count_where "$SUM" "$k" "$want")
        echo "  $k $want: $got of $rows"
        note "$label $k is $want in every workbook" "$(is [ "$got" = "$rows" ])"
      done
    
      if [ ! -f "$ENT" ]; then
        echo "  the run wrote no entries file"; fail=1; continue
      fi
      note "$label the entries file has every column this log reads" \
        "$(is columns_resolve "$ENT" "$COLUMNS_USED")"
      eline=$(entry_counts "$ENT")
      echo "  entry_counts over every entry of every workbook: $eline"
      eval "$(echo "$eline" | tr ' ' '\n' | sed 's/^/e_/')"
      note "$label every entry is identical" "$(is [ "$e_bad_status" = 0 ])"
      note "$label nothing was changed, dropped or added" \
        "$(is [ "$((e_changed + e_dropped + e_added))" = 0 ])"
      note "$label no flag but descriptor appears" "$(is [ "$e_bad_flags" = 0 ])"
      note "$label no entry's crc differs" "$(is [ "$e_crc_differs" = 0 ])"
      note "$label no entry's size differs" "$(is [ "$e_size_differs" = 0 ])"
    
      # The tool's own lines, one per workbook, and the independent count beside
      # each. The comparison is the point of this log.
      : >"$OUT-$label.strings"
      nstdout=0
      bad_pair=0
      no_line=0
      echo "  per workbook: the line the tool printed, and this script's own <si>"
      echo "  count over the part the content types name. A disagreement names the"
      echo "  workbook's id and both numbers."
      for d in "$OUT"/*/; do
        sf=$d/stdout.$label.txt
        [ -f "$sf" ] || continue
        id=$(basename "$d")
        nstdout=$((nstdout + 1))
        line=$(cat "$sf")
        cat "$sf" >>"$OUT-$label.strings"
        src=$(wb_path "$id")
        own=error-no-such-id
        if [ -n "$src" ]; then own=$(si_count "$src"); fi
        got=$(printf '%s' "$line" | sed -n 's/.*items=\([0-9]*\).*/\1/p')
        if [ -z "$got" ]; then
          printf '    %s  NO items KEY  line=%s\n' "$id" "$line"
          no_line=$((no_line + 1))
          continue
        fi
        case $own in
          none) expect=0 ;;
          error*) printf '    %s  OWN COUNT FAILED: %s\n' "$id" "$own"; bad_pair=$((bad_pair + 1)); continue ;;
          *) expect=$own ;;
        esac
        if [ "$got" = "$expect" ]; then
          printf '    %s  items=%s  own=%s  agree\n' "$id" "$got" "$own"
        else
          printf '    %s  items=%s  own=%s  DISAGREE\n' "$id" "$got" "$own"
          bad_pair=$((bad_pair + 1))
        fi
      done
      echo "  workbook directories holding a stdout file for this label: $nstdout"
      note "$label every workbook left a stdout file" "$(is [ "$nstdout" = "$rows" ])"
      note "$label every line carried an items key" "$(is [ "$no_line" = 0 ])"
      note "$label every workbook's items equals this script's own <si> count" \
        "$(is [ "$bad_pair" = 0 ])"
    
      sline=$(strings_counts "$OUT-$label.strings")
      echo "  strings_counts over all of them: $sline"
      eval "$(echo "$sline" | tr ' ' '\n' | sed 's/^/s_/')"
      note "$label one line per workbook" "$(is [ "$s_lines" = "$rows" ])"
      note "$label every line was a strings line" "$(is [ "$s_not_strings" = 0 ])"
      note "$label no line was malformed" "$(is [ "$s_malformed" = 0 ])"
      note "$label items total is the spec's $SPEC_ITEMS" \
        "$(is [ "$s_items_total" = "$SPEC_ITEMS" ])"
      echo "  bytes total over the corpus: $s_bytes_total"
      echo "  workbooks reporting an empty table: $s_empty_tables"
      echo "  largest table reported: $s_max_items items"
      note "$label no workbook reported an empty table" "$(is [ "$s_empty_tables" = 0 ])"
      # A reader that returned one huge table and nothing else would still total
      # correctly, so the largest is asserted to be smaller than the total.
      note "$label the largest table is smaller than the corpus total" \
        "$(is [ "$s_max_items" -lt "$s_items_total" ])"
      echo
    done
    
    echo "## the two targets against each other"
    if [ -f "$OUT-host.strings" ] && [ -f "$OUT-i686.strings" ]; then
      hl=$(strings_counts "$OUT-host.strings")
      il=$(strings_counts "$OUT-i686.strings")
      echo "  host: $hl"
      echo "  i686: $il"
      note "both targets report the same counts" "$(is [ "$hl" = "$il" ])"
      note "the two targets' lines are identical file to file" \
        "$(is cmp -s "$OUT-host.strings" "$OUT-i686.strings")"
    else
      echo "  a target left no strings file"; fail=1
    fi
    echo
    
    echo "## the record pair"
    REC=records/$STEM.md
    RECT=records/$STEM.txt
    {
      echo "# M1 part 3 P1 corpus run: the shared strings table"
      echo
      echo "specs/0010-reading-cells.md, \"P1\" and \"Harness runs\". Phase commit"
      echo "$C; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)."
      echo
      echo "\`--shared-strings\` on both targets over the $SPEC_FILES corpus"
      echo "workbooks. It records no edit, so the acceptance is the no-edit one:"
      echo "every entry identical and unflagged, files_identical yes,"
      echo "order_preserved yes, lo ok."
      echo
      echo "The substantive check is not that acceptance, which an empty table"
      echo "would also satisfy. Each workbook's reported items count is compared"
      echo "with a count taken over the extracted part by python3 alone, a"
      echo "route sharing no code with the library, and the total is compared"
      echo "with the $SPEC_ITEMS \`<si>\` specs/0010 counts across the corpus"
      echo "under \"Facts planning checked\"."
      echo
      echo "| target | workbooks | items | bytes | largest table |"
      echo "| --- | --- | --- | --- | --- |"
      for label in host i686; do
        if [ -f "$OUT-$label.strings" ]; then
          l=$(strings_counts "$OUT-$label.strings")
          eval "$(echo "$l" | tr ' ' '\n' | sed 's/^/r_/')"
          echo "| $label | $r_good | $r_items_total | $r_bytes_total | $r_max_items |"
        fi
      done
      echo
      echo "Every workbook's items count equalled the independent count, on both"
      echo "targets, and the two targets' lines are identical file to file."
      echo
      echo "The log is \`records/logs/m1p3-p1/run.log\`. Workbooks are cited by id"
      echo "only; no shared string item or fragment of one appears in either file."
    } >"$REC"
    {
      echo "M1 part 3 P1 corpus run, --shared-strings, both targets."
      echo "phase commit $C; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
      echo
      for label in host i686; do
        echo "## $label"
        if [ -f "$OUT-$label.strings" ]; then
          echo "strings_counts: $(strings_counts "$OUT-$label.strings")"
          echo "entry_counts: $(entry_counts "$OUT/entries.$label.tsv")"
          echo
          echo "id${TAB}items${TAB}own_si_count"
          for d in "$OUT"/*/; do
            sf=$d/stdout.$label.txt
            [ -f "$sf" ] || continue
            id=$(basename "$d")
            src=$(wb_path "$id")
            printf '%s\t%s\t%s\n' "$id" \
              "$(sed -n 's/.*items=\([0-9]*\).*/\1/p' "$sf")" "$(si_count "$src")"
          done
        fi
        echo
      done
    } >"$RECT"
    echo "command: sha256sum over the record pair"
    sha256sum "$REC" "$RECT" | sed 's/^/    /'
    wc -c "$REC" "$RECT" | sed 's/^/    /'
    # A NAMED FUNCTION, not an assignment prefix handed to the helper. The first
    # attempt of this log wrote
    #   isnot LC_ALL=C "$G" ... "$REC"
    # and `isnot` runs its arguments as a command, so the shell looked for a
    # COMMAND named LC_ALL=C, failed with 127, and the check reported as-expected
    # whatever the record held. That is the same failure as the leading bang
    # specs/0001 forbids, reached by a different spelling, and the shape greps
    # look for the bang and not for this. It is raised to planning as a question.
    names_no_office_file() {
      LC_ALL=C "$G" -q -E '[.](xlsx|xltx|xlsm)' "$1"
    }
    # BOTH record files, not just the .md. Independent check 2 found this check
    # passed only $REC while $RECT is the file carrying a row per workbook, so the
    # more exposed of the two was the one nothing looked at. The loop names each
    # file in its own result line, because one combined verdict would not say
    # which file was clean.
    for rf in "$REC" "$RECT"; do
      note "the record $(basename "$rf") names no corpus file name" \
        "$(isnot names_no_office_file "$rf")"
    done
    # Its control, in the same command form: a fixture that DOES name one must be
    # caught, or the as-expected above says only that the function ran.
    printf 'a line naming %s%s\n' 'book' '.xlsx' >"$CTL/office.txt"
    note "control: the same check catches a fixture that names an office file" \
      "$(is names_no_office_file "$CTL/office.txt")"
    # And the negative control: a fixture naming no such file is not caught.
    printf 'a line naming no office file at all\n' >"$CTL/nooffice.txt"
    note "control: the same check passes a fixture that names none" \
      "$(isnot names_no_office_file "$CTL/nooffice.txt")"
    echo
    
    echo "## result"
    echo "wall time: $(awk -v a="$RUN_START" -v b="$(date +%s.%N)" 'BEGIN { printf "%.0fs", b - a }')"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ "$fail" -eq 0 ]; then echo "RESULT: PASS"; else echo "RESULT: FAIL"; fi
    [ "$fail" -eq 0 ]

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

