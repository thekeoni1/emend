    import sys
    
    CELLS = "crates/emend/src/cells.rs"
    TESTS = "crates/emend/src/cells/tests.rs"
    
    # A test planted for the measurement and never committed: what
    # `u32::from_str` ANSWERS for the three spellings `decimal`'s doc and
    # e127fc2's message name. It passes only where `decimal` is `from_str`.
    WITNESS_FROM_STR = r'''
    #[test]
    fn the_witness_from_str_reads_plus_one_plus_zero_and_zero_zero_seven() {
        // PLANTED BY records/logs/m1p3-p3/test.log and never committed.
        let styled = read_cells(&one_row("<c r=\"A1\" s=\"+1\"><v>1</v></c>"));
        assert_eq!(styled[0].style, Some(1));
        let formula = read_cells(&one_row("<c r=\"A1\"><f t=\"shared\" si=\"+0\">1</f></c>"));
        assert!(matches!(
            formula[0].formula.as_ref().expect("a formula").kind,
            FormulaKind::Shared { index: 0, .. }
        ));
        let shared = read_cells(&one_row("<c r=\"A1\" t=\"s\"><v>+0</v></c>"));
        let table = table(&sst("<si><t>zero</t></si>"));
        assert_eq!(table.resolve(&shared[0]).expect("resolves"), Some("zero"));
        let rows = read_cells(&one_row_in_row("007", "<c><v>1</v></c>"));
        assert_eq!(rows[0].reference.a1(), "A7");
    }
    '''
    
    # The second witness: the reference a row of 0 made, and its own parser's
    # answer to it. It passes only where the row filter is gone.
    WITNESS_ZERO_ROW = r'''
    #[test]
    fn the_witness_a_row_of_zero_emits_a0_which_its_own_parser_refuses() {
        // PLANTED BY records/logs/m1p3-p3/test.log and never committed.
        let cells = read_cells(&one_row_in_row("0", "<c><v>1</v></c>"));
        assert_eq!(cells[0].reference.a1(), "A0");
        assert_eq!(CellRef::parse(b"A0"), None);
    }
    '''
    
    # `decimal`'s body, and what it was before ruling 2: `u32::from_str` alone.
    DECIMAL_OLD = """    let digits = value.as_bytes();
        if digits.is_empty() || !digits.iter().all(u8::is_ascii_digit) {
            return None;
        }
        if digits.len() > 1 && digits[0] == b'0' {
            return None;
        }
        value.parse().ok()
    """
    DECIMAL_NEW = """    value.parse().ok()
    """
    
    # `number`'s body, and the same with the sign of a zero lost.
    NUMBER_OLD = "        self.value.as_deref()?.parse().ok()\n"
    NUMBER_NEW = """        let number: f64 = self.value.as_deref()?.parse().ok()?;
            Some(if number == 0.0 { 0.0 } else { number })
    """
    
    # The sign-bit assertion, and the equality the comment says would hold for
    # either sign.
