    #!/usr/bin/env bash
    # Milestone 1 part 3 P3 test.log (specs/0010-reading-cells.md, "Phases":
    # test.log on both targets): cargo test for the workspace on the host and with
    # --target i686-unknown-linux-musl, colour off. The log shows the test names,
    # the "Running" lines and the summary lines of each run, both executed counts,
    # and checks the two runs executed the same tests. Each check is evaluated once
    # (specs/0001: a check with more than one condition lives in one function that
    # returns yes or no).
    #
    # DERIVED FROM the M1 part 3 P2 test script as records/logs/m1p3-p2/test.log
    # printed it, audited against specs/0001 before this run. What changed, and
    # why:
    #  1. The phase and the log directory are part 3 P3's, and the previous
    #     phase's figures are read from records/logs/m1p3-p2/test.log.
    #  2. THE MUTATION BLOCK IS THIS PHASE'S, not P2's: eleven mutations for the
    #     claims THIS phase's comments and commit messages make. specs/0001 says a
    #     claim that a test BITES is a printed measurement in test.log or is not
    #     made anywhere. Five of the eleven are new in kind and are the reason
    #     this block is longer than P2's:
    #       - Two plant a WITNESS TEST rather than only a defect. `decimal`'s doc
    #         and e127fc2's message say what `u32::from_str` alone ANSWERED for
    #         three spellings (1, 0 and 7), and e127fc2 says a row of 0 gave the
    #         reference A0 that `CellRef::parse` refuses. A defect that makes a
    #         test fail does not measure either claim: what it answered has to be
    #         asserted. So M1 and M3 plant the defect AND a test that asserts the
    #         answers, and M2 and M4 plant the same witness ALONE, where it must
    #         fail: a witness that passed either way would measure nothing.
    #       - M7 is the one mutation that must leave the tests PASSING. The
    #         comment on the negative zero says an equality "would hold for either
    #         sign", so the measurement is that with the sign lost AND the
    #         assertion written as an equality the test passes, beside M6 where
    #         the sign is lost and the sign-bit assertion catches it.
    #       - M8 changes only a test, on unmutated code: the comment says
    #         `assert_eq!` against `f64::NAN` "would fail on a correct answer", so
    #         the answer here must be correct and the assertion must still fail.
    #     The applier refuses a mutation whose text it cannot find exactly once,
    #     as P2's did, so a mutation that applied to nothing cannot read as a test
    #     that failed to bite.
    #  3. A PROBE BLOCK, new: 2575083's message states seven figures for
    #     probe-emend-cells-xml on a generated fixture, and size.log measures that
    #     probe with different arguments (the sheet as the part to replace, which
    #     is eleven elements, not the workbook's three). This block generates the
    #     fixture again and runs the message's own arguments, so every figure in
    #     that message is a measurement in a committed log. No corpus file is
    #     read by it.
    #  4. The tool's integration count must be EQUAL to P2's, not larger: this
    #     phase adds library tests and no integration test. The workspace total
    #     must be exactly eleven more, which is one test removed and twelve added
    #     across e127fc2, 8c8a0ca and 13fe4a4.
    #  5. The entry guard and the status block carry three terms, not P2's two:
    #     this phase writes a size record as well as its logs and its run record
    #     pair.
    #  6. Everything else is P2's, which took it from P1: the per-binary
    #     breakdown with its controls, the xml, package and cells named-test
    #     blocks, the ignored-test block, the feature builds, and the comparison
    #     of the two targets. The counts this log prints are read from the runs,
    #     never typed.
    #
    # Usage: m1p3-p3-test.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m1p3-p3/test.log.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT INT TERM HUP
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # One function, two conditions (specs/0001).
    passed_matches() { [ "$passed" -gt 0 ] && [ "$passed" -eq "$nok" ]; }
    
    # specs/0001 "Rules for every phase": the phase commit is GIVEN to the script
    # and compared with HEAD, with a control, and both are printed. The hard guard
    # is here, before a line of log exists; the printed comparison and its control
    # are in the body below, where a reader sees them.
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { ! head_is "$1"; }
    full_sha() { LC_ALL=C printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if ! full_sha "$C"; then echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if ! head_is "$C"; then echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    
    # The entry guard: every change must be under this phase's log directory, or be
    # its run record pair, or the part's size record; all three count as this
    # phase's work, and the third is why the regex has a term P2's did not.
    entry_all=$(run_lines git status --porcelain)
    entry_log=$(run_matches -E '^(\?\?| ?[MARCD]) (records/logs/m1p3-p3|records/m1p3-p3-|records/size-m1p3-)' git status --porcelain)
    entry_clean() {
      [ "$entry_all" != error ] && [ "$entry_log" != error ] && [ "$entry_all" = "$entry_log" ]
    }
    if ! entry_clean; then
      echo "the working tree holds changes outside this phase's records" >&2
      exit 2
    fi
    
    echo "command: git rev-parse HEAD"
    echo "about: M1 part 3 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: Milestone 1 part 3 P3 (specs/0010-reading-cells.md) test.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      # specs/0001 "Rules for every phase": every sha256 a log cites, a superseded
      # attempt's included, is PRINTED BY A COMMAND run over a file that exists at
      # run time, never typed from memory. The note above names its predecessors;
      # these lines are what make those names evidence. An attempt that was not
      # kept is named as having no hash, and why.
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    echo "SERIALIZED: produced with no other run in flight"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR; CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS; $(rustc --version)"
    echo "at entry: status lines $entry_all, all of them this phase's logs"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    # The control for the comparison, in the same command form: the same function
    # against a commit that is not HEAD must say no, so the yes above cannot be a
    # comparison that says yes to anything.
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    for target in host i686-unknown-linux-musl; do
      echo
      echo "## cargo test --workspace ($target)"
      if [ "$target" = host ]; then
        echo "command: cargo test --workspace"
        cargo test --workspace >"$T/$target.out" 2>&1 </dev/null
      else
        echo "command: cargo test --workspace --target $target"
        cargo test --workspace --target "$target" >"$T/$target.out" 2>&1 </dev/null
      fi
      rc=$?
      echo "exit: $rc"
      check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
      echo "Running lines, test lines and summary lines:"
      LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test .* \.\.\. |^test result: ' "$T/$target.out" | sed 's/^ */    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/$target.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/$target.names"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      ignored=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^ignored;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      nok=$(count_lines "$T/$target.names")
      echo "$target: passed $passed; failed $failed; ignored $ignored; test lines ending ok: $nok"
      check "$target: failed is 0" "$(yn [ "$failed" -eq 0 ])"
      check "$target: passed is more than 0 and equals the ok test lines" "$(yn passed_matches)"
      n=$(count_bytes "$CTRL_CLASS" "$T/$target.out")
      check "$target: control bytes in the cargo output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
      echo "$passed" >"$T/$target.count"
    done
    
    echo
    echo "## the tests per binary, which planning asked this log for"
    # For each Running or Doc-tests line, the binary it names and how many of its
    # tests passed, taken from the test result line that closes its block. The
    # binary's hash suffix is stripped, so the same table can be compared with
    # another run's: a suffix changes whenever the crate is rebuilt and carries no
    # information about the tests.
    per_binary() {
      awk '
        /^ *Running / {
          # The label comes from the compiled binary in parentheses, with its hash
          # suffix removed, because that names the CRATE; the words before it are
          # only "unittests src/lib.rs" or the tests/ file, which repeat across
          # crates. unittests and integration tests are distinguished, so a
          # library and an integration binary of the same crate stay apart.
          path = $NF
          gsub(/[()]/, "", path)
          parts = split(path, piece, "/")
          label = piece[parts]
          sub(/-[0-9a-f]+$/, "", label)
          current = (($2 == "unittests") ? "unittests " : "integration ") label
          next
        }
        /^ *Doc-tests / { current = "doc-tests " $2; next }
        /^test result: / {
          if (current == "") next
          for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n = $i
          printf "%s %d\n", current, n
          current = ""
        }
      ' "$1" | sort
    }
    for target in host i686-unknown-linux-musl; do
      per_binary "$T/$target.out" >"$T/$target.per"
    done
    sed 's/^/    /' "$T/host.per"
    sum_per=$(awk '{ n += $NF } END { print n + 0 }' "$T/host.per")
    echo "  the per-binary counts sum to $sum_per; the run's own passed total was $(cat "$T/host.count")"
    check "the per-binary counts sum to the run's passed total" \
      "$(yn [ "$sum_per" = "$(cat "$T/host.count")" ])"
    check "the two targets produce the same per-binary breakdown" \
      "$(yn cmp -s "$T/host.per" "$T/i686-unknown-linux-musl.per")"
    # The control for the extraction, in the same command form: a stream with no
    # Running line yields no rows, so a silent awk failure cannot read as "no
    # tests" indistinguishably from a correct empty answer.
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n' >"$T/c-per"
    per_binary "$T/c-per" >"$T/c-per.out"
    nctl_per=$(count_lines "$T/c-per.out")
    echo "  control: a result line with no Running line above it yields $nctl_per rows"
    check "control: the per-binary form attributes nothing to a binary it never saw named" \
      "$(yn [ "$nctl_per" = 0 ])"
    # A positive control for the same form, so the 0 above cannot be a form that
    # never counts anything: a Running line and its result must yield one row.
    printf '     Running unittests src/lib.rs (target/debug/deps/libctl-0123456789abcdef)\ntest result: ok. 7 passed; 0 failed; 0 ignored\n' >"$T/c-per-hit"
    per_binary "$T/c-per-hit" >"$T/c-per-hit.out"
    sed 's/^/    control row: /' "$T/c-per-hit.out"
    check "control: a Running line and its result yield one row naming the crate and its count" \
      "$(yn [ "$(cat "$T/c-per-hit.out")" = "unittests libctl 7" ])"
    # The library's figure beside the previous phase's total, read from that
    # phase's committed log rather than typed. The library's own row is the
    # unittests row of the emend crate.
    LIB_NOW=$(awk '$1 == "unittests" && $2 == "emend" { n += $3 } END { print n + 0 }' "$T/host.per")
    PREV_LOG=records/logs/m1p3-p2/test.log
    PREV_TOTAL=$(sed -n 's/^host executed \([0-9]*\) tests;.*/\1/p' "$PREV_LOG")
    NOW_TOTAL=$(cat "$T/host.count")
    echo "  the library's own tests in this run: $LIB_NOW"
    echo "  the workspace total: this phase $NOW_TOTAL, the previous phase $PREV_TOTAL (read from $PREV_LOG)"
    check "the previous phase's total was read from its committed log" "$(yn [ -n "$PREV_TOTAL" ])"
    # EXACTLY eleven more, not "larger": e127fc2 removed one test and added five,
    # 8c8a0ca added six, and 13fe4a4, the commit the two independent checks asked
    # for, added one, which is
    # what_the_standard_librarys_parse_takes_and_this_refuses. A phase that
    # quietly lost one while adding another would pass a floor. The figure to
    # compare with is what P2's log printed, which is why it is read from there
    # and not typed here. The earlier run of this log asserted ten, before that
    # commit existed; the rerun header names it.
    total_grew_by_eleven() { [ -n "$PREV_TOTAL" ] && [ "$NOW_TOTAL" -eq "$((PREV_TOTAL + 11))" ]; }
    check "this phase's workspace total is exactly eleven more than the previous phase's" \
      "$(yn total_grew_by_eleven)"
    
    echo
    echo "## the xml module's tests, named"
    # specs/0009's P1 list names the cases the token stream must cover, so the log
    # prints them rather than only a count: a reader checks the list against the
    # spec, case by case.
    LC_ALL=C "$G" -E '^xml::tests::' "$T/host.names" | sed 's/^/    /'
    nxml=$(count_matches -E '^xml::tests::' "$T/host.names")
    echo "  xml module tests on the host: $nxml"
    check "the xml module has more than twenty tests of its own" "$(yn [ "$nxml" -gt 20 ])"
    # The same names on i686, since a test compiled out on one target is exactly
    # what T6 P1 case B3 exists for.
    nxml_i686=$(count_matches -E '^xml::tests::' "$T/i686-unknown-linux-musl.names")
    echo "  xml module tests on i686-unknown-linux-musl: $nxml_i686"
    check "the xml module's test count is the same on both targets" "$(yn [ "$nxml" = "$nxml_i686" ])"
    
    echo
    echo "## the package module's tests, named"
    # specs/0009's P2 list names the cases the package layer must cover, so the
    # log prints them rather than only a count: a reader checks the list against
    # the spec, case by case, as for the xml module above.
    LC_ALL=C "$G" -E '^package::tests::' "$T/host.names" | sed 's/^/    /'
    npkg=$(count_matches -E '^package::tests::' "$T/host.names")
    echo "  package module tests on the host: $npkg"
    check "the package module has more than twenty tests of its own" "$(yn [ "$npkg" -gt 20 ])"
    npkg_i686=$(count_matches -E '^package::tests::' "$T/i686-unknown-linux-musl.names")
    echo "  package module tests on i686-unknown-linux-musl: $npkg_i686"
    check "the package module's test count is the same on both targets" "$(yn [ "$npkg" = "$npkg_i686" ])"
    
    echo
    echo "## the cells module's tests, named"
    # specs/0010's P2 list names the cases the cell reader must cover, so the log
    # prints them rather than only a count: a reader checks the list against the
    # spec, case by case, as for the two modules above and as P1's log did for the
    # shared strings table.
    LC_ALL=C "$G" -E '^cells::tests::' "$T/host.names" | sed 's/^/    /'
    ncells=$(count_matches -E '^cells::tests::' "$T/host.names")
    PREV_CELLS=$(sed -n 's/^  cells module tests on the host: \([0-9]*\)$/\1/p' "$PREV_LOG")
    echo "  cells module tests on the host: $ncells"
    echo "  the previous phase's cells count, read from $PREV_LOG: $PREV_CELLS"
    check "the previous phase's cells count was read from its committed log" "$(yn [ -n "$PREV_CELLS" ])"
    # The floor is the PREVIOUS PHASE'S MEASURED COUNT and not a number typed
    # here: P3 adds the typed views' cases and ruling 2's to the cell reader's, so
    # a phase that lost a case falls through this even if nobody remembers how
    # many there were. The whole of this phase's growth is in this module, which
    # the workspace total above asserts exactly; the names are what a reader
    # checks against the spec's list.
    check "the cells module runs more tests than the previous phase's log printed" \
      "$(yn [ "$ncells" -gt "$PREV_CELLS" ])"
    ncells_i686=$(count_matches -E '^cells::tests::' "$T/i686-unknown-linux-musl.names")
    echo "  cells module tests on i686-unknown-linux-musl: $ncells_i686"
    check "the cells module's test count is the same on both targets" "$(yn [ "$ncells" = "$ncells_i686" ])"
    
    echo
    echo "## the tool's integration tests, named"
    # The null rewrite applied to a byte-built archive, and the operation parsing.
    # These run the BUILT BINARY, so they are the only tests here that exercise
    # emend-copy's own argument handling.
    # Taken from the null_rewrite binary's OWN section of the cargo output, not by
    # a name prefix: the xlsx-diff and passthrough integration tests carry no
    # module prefix either, so a prefix filter would count them as the tool's.
    # NONE is new this phase: P3 adds the typed views' own tests, which are the
    # library's, and a probe, which has none. The tool's line is unchanged since
    # P2 added shared_strings_counts_the_items_and_edits_nothing and
    # cells_counts_every_cell_and_edits_nothing, so the count below is asserted
    # equal to P2's rather than larger. The names are printed from the run, so
    # this comment is checkable against them.
    for target in host i686-unknown-linux-musl; do
      awk '
        /^ *Running tests\/null_rewrite\.rs/ { inblock = 1; next }
        inblock && /^test result: / { inblock = 0 }
        inblock && /^test .* \.\.\. ok$/ {
          sub(/^test /, ""); sub(/ \.\.\. ok$/, ""); print
        }
      ' "$T/$target.out" | sort >"$T/$target.tool"
    done
    sed 's/^/    /' "$T/host.tool"
    ntool=$(count_lines "$T/host.tool")
    ntool_i686=$(count_lines "$T/i686-unknown-linux-musl.tool")
    echo "  tests in the tool's null_rewrite binary: host $ntool, i686-unknown-linux-musl $ntool_i686"
    PREV_TOOL=$(sed -n "s/^  tests in the tool's null_rewrite binary: host \\([0-9]*\\),.*/\\1/p" "$PREV_LOG")
    echo "  the previous phase's tool count, read from $PREV_LOG: $PREV_TOOL"
    check "the previous phase's tool count was read from its committed log" "$(yn [ -n "$PREV_TOOL" ])"
    # EQUAL, and equal is the claim: P3 adds the typed views' own tests and the
    # probe, and no integration test. P2's log printed 14 after adding two; a
    # phase that added one here without saying so, or lost one, fails this.
    tool_is_unchanged() { [ -n "$PREV_TOOL" ] && [ "$ntool" -eq "$PREV_TOOL" ]; }
    check "the tool has exactly as many integration tests as the previous phase's log printed" \
      "$(yn tool_is_unchanged)"
    check "the tool's tests are the same names on both targets" "$(yn cmp -s "$T/host.tool" "$T/i686-unknown-linux-musl.tool")"
    # The control for the extraction above, through the same command form: a
    # Running line that is not the tool's yields none of the tool's names.
    awk '
      /^ *Running tests\/no-such-binary\.rs/ { inblock = 1; next }
      inblock && /^test result: / { inblock = 0 }
      inblock && /^test .* \.\.\. ok$/ { print }
    ' "$T/host.out" >"$T/tool-control"
    nctl=$(count_lines "$T/tool-control")
    check "control: the same extraction for a binary that does not exist yields 0 names ($nctl)" "$(yn [ "$nctl" = 0 ])"
    
    echo
    echo "## the zip layer's tests, counted (unchanged by this phase)"
    nlayer=$(count_matches -E '^archive::tests::' "$T/host.names")
    echo "  zip layer tests on the host: $nlayer"
    check "the zip layer still has more than twenty tests of its own" "$(yn [ "$nlayer" -gt 20 ])"
    
    # Both runs report TWO ignored tests, and they are named here rather than left
    # as a count, because "ignored" beside a phase that writes new parsing code
    # invites exactly the wrong inference.
    #
    # The inherited check from part 1 P1 asserted that NO test of the layer is
    # ignored. That was true when it was written and is false now: part 1 P2 added
    # archive::tests::zip64_replace_in_an_archive_over_4_gib, which writes an
    # archive over 4 GiB and is gated behind `--ignored zip64` exactly as the
    # harness's zip64_entry_over_4_gib is (specs/0004; T1 P5 ruled those run when
    # the size or offset code changes, and this phase touches neither). The first
    # round of this log ran with the stale assertion and reported
    # "ignored tests on the host: 2; of them in the core: 1" and
    # "no test of the core is ignored: no" (see this log's rerun header).
    #
    # The property that actually matters here is asserted instead: no test of the
    # XML or the PACKAGE module, which are what this phase adds to, is ignored;
    # and every ignored test in the workspace is one of the two documented 4 GiB
    # zip64 cases, so a newly ignored test anywhere could not hide among them.
    echo "  the ignored test or tests, named:"
    LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/host.out" | sed 's/^/    /'
    nign=$(count_matches -E '^test .* \.\.\. ignored' "$T/host.out")
    nign_xml=$(count_matches -E '^test xml::tests::.* \.\.\. ignored' "$T/host.out")
    nign_pkg=$(count_matches -E '^test package::tests::.* \.\.\. ignored' "$T/host.out")
    nign_zip64=$(count_matches -E '^test .* \.\.\. ignored, writes and (rewrites an archive over 4 GiB|compares a 4 GiB \+ 1 byte entry); run with --ignored zip64$' "$T/host.out")
    echo "  ignored tests on the host: $nign; of them in the xml module: $nign_xml; in the package module: $nign_pkg; of them the documented 4 GiB zip64 cases: $nign_zip64"
    check "no test of the xml module is ignored" "$(yn [ "$nign_xml" = 0 ])"
    check "no test of the package module is ignored" "$(yn [ "$nign_pkg" = 0 ])"
    check "every ignored test is one of the two documented 4 GiB zip64 cases" "$(yn [ "$nign" = "$nign_zip64" ])"
    check "there are exactly two such ignored tests" "$(yn [ "$nign_zip64" = 2 ])"
    # The control for the reason-matching form above, through the same command
    # form: an ignored line with any other reason is not counted.
    printf 'test some::other ... ignored, for some other reason\n' >"$T/c-ignored"
    nctl_ign=$(count_matches -E '^test .* \.\.\. ignored, writes and (rewrites an archive over 4 GiB|compares a 4 GiB \+ 1 byte entry); run with --ignored zip64$' "$T/c-ignored")
    check "control: an ignored test with another reason is not counted as a zip64 case ($nctl_ign)" "$(yn [ "$nctl_ign" = 0 ])"
    
    echo
    echo "## size-probe with the xml feature (the workspace runs above skip probe-zip-xml, which requires it)"
    for target in host i686-unknown-linux-musl; do
      if [ "$target" = host ]; then tflag=(); else tflag=(--target "$target"); fi
      echo "command: cargo build -p size-probe --features xml --all-targets ${tflag[*]}"
      cargo build -p size-probe --features xml --all-targets "${tflag[@]}" >"$T/xml-build-$target.out" 2>&1 </dev/null
      rc=$?
      echo "exit: $rc"
      check "$target: size-probe builds with the xml feature" "$(yn [ "$rc" -eq 0 ])"
      echo "command: cargo clippy -p size-probe --features xml --all-targets ${tflag[*]} -- -D warnings"
      cargo clippy -p size-probe --features xml --all-targets "${tflag[@]}" -- -D warnings >"$T/xml-clippy-$target.out" 2>&1 </dev/null
      rc=$?
      echo "exit: $rc"
      check "$target: clippy with the xml feature passes" "$(yn [ "$rc" -eq 0 ])"
      n=$(count_bytes "$CTRL_CLASS" "$T/xml-clippy-$target.out")
      check "$target: control bytes in the clippy output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
    done
    
    echo
    echo "## the core builds and passes clippy with both features of the probes"
    # quick-xml is now a dependency of the core itself, so the emend probes link it
    # transitively. Both feature sets are built here, because a feature that no
    # workspace member enables is in no build at all (T0 P4).
    for target in host i686-unknown-linux-musl; do
      if [ "$target" = host ]; then tflag=(); else tflag=(--target "$target"); fi
      echo "command: cargo clippy -p size-probe --features emend,xml --all-targets ${tflag[*]} -- -D warnings"
      cargo clippy -p size-probe --features emend,xml --all-targets "${tflag[@]}" -- -D warnings \
        >"$T/both-clippy-$target.out" 2>&1 </dev/null
      rc=$?
      echo "exit: $rc"
      check "$target: clippy with both features passes" "$(yn [ "$rc" -eq 0 ])"
    done
    
    
    echo
    echo "## the probe's own run, the figures 2575083's message states"
    # CLAUDE.md, "The fidelity harness is the acceptance instrument": measure
    # before claiming, and a sentence about fidelity, speed or size cites a run
    # that exists in the repo's records. specs/0001's rule of this kind is
    # narrower than that and is about a claim that a test BITES, which is the
    # mutation block below; the figures here are a commit message's own
    # measurements, and this block exists so they rest on a run a reader can find
    # rather than on one nobody kept. 2575083's message states seven
    # for probe-emend-cells-xml on a generated fixture: exit 0, sheets 1,
    # elements 3, items 2, cells 4, sum 3.75 and text 14, and it says the text
    # figure is two shared items of 5 and 2 bytes plus two number cells' own
    # values of 3 and 4 bytes.
    #
    # size.log runs the same binary with the SHEET as the part to replace and
    # reads elements 11; the message's run replaced the WORKBOOK, which is three
    # elements. Both are the same probe with different arguments, so this block
    # runs the message's arguments and leaves size.log's alone. The fixture is
    # generated here rather than carried in from a scratch directory, so the
    # figures are reproducible from this log alone.
    # A fictional package, generated here: the smallest thing that has a workbook,
    # a calculation chain with its override and relationship, two parts the recipe
    # must not touch, and, added for this part, a shared strings table and a sheet
    # with cells to read. The cells are two numbers and two shared strings, so the
    # cells probe exercises the float parser and the table lookup rather than
    # counting an empty sheet. No corpus file is read by this log.
    python3 - "$T/probe.xlsx" <<'FIXTURE_PY'
    import sys, zipfile
    
    CT = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
          '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
          '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
          '<Default Extension="xml" ContentType="application/xml"/>'
          '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>'
          '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>'
          '<Override PartName="/xl/calcChain.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.calcChain+xml"/>'
          '<Override PartName="/xl/sharedStrings.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"/>'
          '</Types>')
    ROOT_RELS = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                 '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
                 '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>'
                 '</Relationships>')
    WB = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
          '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" '
          'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">'
          '<sheets><sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets></workbook>')
    WB_RELS = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
               '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
               '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/>'
               '<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>'
               '<Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/calcChain" Target="calcChain.xml"/>'
               '<Relationship Id="rId4" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/sharedStrings" Target="sharedStrings.xml"/>'
               '</Relationships>')
    SHEET = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
             '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
             '<sheetData><row r="1"><c r="A1"><v>1.5</v></c><c r="B1" t="s"><v>0</v></c>'
             '<c r="C1" t="s"><v>1</v></c><c r="D1"><v>2.25</v></c>'
             '</row></sheetData></worksheet>')
    # Two items, of five and two bytes. The cells probe's `text` figure covers
    # EVERY cell, because `resolve` answers with a non-shared cell's own value: 5
    # and 2 for the items, plus "1.5" and "2.25", is 14.
    SST = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
           '<sst xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" count="2" uniqueCount="2">'
           '<si><t>alpha</t></si><si><t>bb</t></si></sst>')
    STYLES = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
              '<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"/>')
    CHAIN = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
             '<calcChain xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
             '<c r="A1" i="1"/></calcChain>')
    
    with zipfile.ZipFile(sys.argv[1], "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("[Content_Types].xml", CT)
        z.writestr("_rels/.rels", ROOT_RELS)
        z.writestr("xl/workbook.xml", WB)
        z.writestr("xl/_rels/workbook.xml.rels", WB_RELS)
        z.writestr("xl/worksheets/sheet1.xml", SHEET)
        z.writestr("xl/sharedStrings.xml", SST)
        z.writestr("xl/styles.xml", STYLES)
        z.writestr("xl/calcChain.xml", CHAIN)
    print("generated: 8 entries, a workbook with one sheet of four cells, a shared "
          "strings table of two items, a chain with its override and relationship")
    FIXTURE_PY
    echo "command: sha256sum and wc -c over the generated fixture"
    printf '    %s  %s bytes  the generated fixture\n' \
      "$(sha256sum "$T/probe.xlsx" | cut -d' ' -f1)" "$(wc -c <"$T/probe.xlsx")"
    echo "command: cargo build -p size-probe --features emend,xml --bin probe-emend-cells-xml"
    cargo build -p size-probe --features emend,xml --bin probe-emend-cells-xml \
      >"$T/probe-build.out" 2>&1 </dev/null
    rc=$?
    echo "exit: $rc"
    check "the probe builds on the host" "$(yn [ "$rc" -eq 0 ])"
    PROBE=target/debug/probe-emend-cells-xml
    check "the built probe is where this block looks for it" "$(yn [ -x "$PROBE" ])"
    THEME_NAME=/xl/theme/theme1.xml
    THEME_TYPE=application/vnd.openxmlformats-officedocument.theme+xml
    echo "command: $PROBE <scratch>/probe.xlsx <scratch>/probe-out.xlsx xl/workbook.xml $THEME_NAME $THEME_TYPE xl/worksheets/sheet1.xml"
    "$PROBE" "$T/probe.xlsx" "$T/probe-out.xlsx" xl/workbook.xml "$THEME_NAME" "$THEME_TYPE" \
      xl/worksheets/sheet1.xml >"$T/o-probe" 2>&1
    probe_rc=$?
    echo "exit: $probe_rc"
    sed 's/^/    /' "$T/o-probe"
    probe_prints_the_messages_figures() {
      [ "$probe_rc" -eq 0 ] &&
        [ "$(cat "$T/o-probe")" = "$(printf 'sheets 1\nelements 3\nitems 2\ncells 4\nsum 3.75\ntext 14')" ]
    }
    check "the probe exits 0 and prints the six figures 2575083's message states" \
      "$(yn probe_prints_the_messages_figures)"
    # The control for the comparison above, in the same command form: the same
    # function against the same run with one figure changed must say no, so a
    # comparison that says yes to anything cannot pass for a match.
    probe_control() {
      [ "$probe_rc" -eq 0 ] &&
        [ "$(cat "$T/o-probe")" = "$(printf 'sheets 1\nelements 3\nitems 2\ncells 4\nsum 3.76\ntext 14')" ]
    }
    # `yn` runs its arguments as a command, so the negation is a function and not
    # a leading `!`: the first attempt at this log wrote `yn ! probe_control` and
    # bash answered "!: command not found", which read as a control that said no
    # when nothing had been compared. The attempt is named and hashed in the
    # rerun header above.
    probe_control_says_no() { ! probe_control; }
    check "control: the same comparison with sum 3.76 says no" "$(yn probe_control_says_no)"
    # The breakdown the message gives for the text figure, read out of the fixture
    # rather than asserted from the probe's own answer: the two items' lengths and
    # the two non-shared cells' own values' lengths.
    python3 - "$T/probe.xlsx" >"$T/o-text" 2>&1 <<'TEXT_PY'
    import re, sys, zipfile
    
    z = zipfile.ZipFile(sys.argv[1])
    items = re.findall(r"<t>([^<]*)</t>", z.read("xl/sharedStrings.xml").decode())
    sheet = z.read("xl/worksheets/sheet1.xml").decode()
    # A cell with no `t` attribute: its own value is what `resolve` answers with.
    own = re.findall(r'<c r="[A-Z]+[0-9]+"><v>([^<]*)</v></c>', sheet)
    lengths = [len(x) for x in items + own]
    print(" ".join(str(n) for n in lengths), sum(lengths))
    TEXT_PY
    echo "  the two items' and the two own values' lengths, and their total: $(cat "$T/o-text")"
    text_breakdown_holds() { [ "$(cat "$T/o-text")" = "5 2 3 4 14" ]; }
    check "the message's breakdown holds: items of 5 and 2 bytes and own values of 3 and 4 bytes total 14" \
      "$(yn text_breakdown_holds)"
    python3 - "$T/probe-out.xlsx" >"$T/o-probe-out" 2>&1 <<'OUT_PY'
    import sys, zipfile
    
    z = zipfile.ZipFile(sys.argv[1])
    print(len(z.namelist()), "calcChain" in " ".join(z.namelist()))
    OUT_PY
    echo "  the package the probe wrote, read by python's zipfile: $(cat "$T/o-probe-out")"
    wrote_seven_without_the_chain() { [ "$(cat "$T/o-probe-out")" = "7 False" ]; }
    check "the probe wrote its package after the reads: seven entries, the chain removed" \
      "$(yn wrote_seven_without_the_chain)"
    
    echo
    echo "## the mutations, and what each one broke"
    # specs/0001 "Rules for every phase": a claim that a test BITES is a printed
    # measurement in test.log, or the claim is not made anywhere, comments and
    # commit messages included. Eleven such claims stand in this phase's tree and
    # in the messages of e127fc2 and 8c8a0ca, so each is planted here and run.
    #
    # Each mutation is applied to a DETACHED WORKTREE of this phase's commit, with
    # its own CARGO_TARGET_DIR, so nothing touches the tree this log is being
    # written from and nothing poisons the build the runs above used. The applier
    # refuses a mutation whose text it cannot find exactly once, so a mutation
    # that silently applied to nothing cannot read as a test that failed to bite.
    #
    # Four of the eleven plant a WITNESS TEST, which P2's block had no need of.
    # Two claims here are about what the OLD code answered, not about what breaks:
    # `decimal`'s doc and e127fc2's message say `from_str` alone read `s="+1"`,
    # `si="+0"` and `r="007"` as 1, 0 and 7, and e127fc2 says a row of 0 gave the
    # reference A0 that `CellRef::parse` refuses. A failing test measures neither.
    # So M1 and M3 plant the defect together with a test asserting those answers,
    # and M2 and M4 plant the same witness ALONE against unmutated code, where it
    # must fail: a witness that passed either way would measure nothing. The
    # witnesses are planted, never committed; they exist only inside the worktree
    # this block deletes.
    #
    # M7 is the one mutation that must leave the tests PASSING, and M8 changes
    # only a test on correct code. Both are in the block for the same reason: the
    # comments they measure are about what a WEAKER ASSERTION would have done,
    # and the only way to measure that is to write the weaker assertion and read
    # what it says.
    MUTTREE=$(mktemp -d)
    git worktree add --detach "$MUTTREE/tree" "$C" >"$T/worktree.out" 2>&1
    wt=$?
    echo "command: git worktree add --detach <scratch>/tree $C"
    echo "exit: $wt"
    check "the worktree for the mutations was created at the phase commit" "$(yn [ "$wt" -eq 0 ])"
    cleanup_worktree() {
      git worktree remove --force "$MUTTREE/tree" >/dev/null 2>&1
      rm -rf "$MUTTREE"
    }
    trap 'cleanup_worktree; rm -rf "$T"' EXIT INT TERM HUP
    
    cat >"$MUTTREE/mutate.py" <<'PYEOF'
    import sys
    
    CELLS = "crates/emend/src/cells.rs"
    TESTS = "crates/emend/src/cells/tests.rs"
    
    # A test planted for the measurement and never committed: what
    # `u32::from_str` ANSWERS for the three spellings `decimal`'s doc and
    # e127fc2's message name. It passes only where `decimal` is `from_str`.
    WITNESS_FROM_STR = r'''
    #[test]
    fn the_witness_from_str_reads_plus_one_plus_zero_and_zero_zero_seven() {
        // PLANTED BY records/logs/m1p3-p3/test.log and never committed.
        let styled = read_cells(&one_row("<c r=\"A1\" s=\"+1\"><v>1</v></c>"));
        assert_eq!(styled[0].style, Some(1));
        let formula = read_cells(&one_row("<c r=\"A1\"><f t=\"shared\" si=\"+0\">1</f></c>"));
        assert!(matches!(
            formula[0].formula.as_ref().expect("a formula").kind,
            FormulaKind::Shared { index: 0, .. }
        ));
        let shared = read_cells(&one_row("<c r=\"A1\" t=\"s\"><v>+0</v></c>"));
        let table = table(&sst("<si><t>zero</t></si>"));
        assert_eq!(table.resolve(&shared[0]).expect("resolves"), Some("zero"));
        let rows = read_cells(&one_row_in_row("007", "<c><v>1</v></c>"));
        assert_eq!(rows[0].reference.a1(), "A7");
    }
    '''
    
    # The second witness: the reference a row of 0 made, and its own parser's
    # answer to it. It passes only where the row filter is gone.
    WITNESS_ZERO_ROW = r'''
    #[test]
    fn the_witness_a_row_of_zero_emits_a0_which_its_own_parser_refuses() {
        // PLANTED BY records/logs/m1p3-p3/test.log and never committed.
        let cells = read_cells(&one_row_in_row("0", "<c><v>1</v></c>"));
        assert_eq!(cells[0].reference.a1(), "A0");
        assert_eq!(CellRef::parse(b"A0"), None);
    }
    '''
    
    # `decimal`'s body, and what it was before ruling 2: `u32::from_str` alone.
    DECIMAL_OLD = """    let digits = value.as_bytes();
        if digits.is_empty() || !digits.iter().all(u8::is_ascii_digit) {
            return None;
        }
        if digits.len() > 1 && digits[0] == b'0' {
            return None;
        }
        value.parse().ok()
    """
    DECIMAL_NEW = """    value.parse().ok()
    """
    
    # `number`'s body, and the same with the sign of a zero lost.
    NUMBER_OLD = "        self.value.as_deref()?.parse().ok()\n"
    NUMBER_NEW = """        let number: f64 = self.value.as_deref()?.parse().ok()?;
            Some(if number == 0.0 { 0.0 } else { number })
    """
    
    # The sign-bit assertion, and the equality the comment says would hold for
    # either sign.
    SIGN_OLD = """    let zero = cells[2].number().expect("parses");
        assert_eq!(zero, 0.0);
        assert!(zero.is_sign_negative(), "-0 keeps its sign");
    """
    SIGN_NEW = """    assert_eq!(cells[2].number(), Some(-0.0));
    """
    
    MUTATIONS = {
        # decimal goes back to u32::from_str alone, and the witness asserts what
        # it reads: 1, 0 and 7.
        "M1": [(CELLS, DECIMAL_OLD, DECIMAL_NEW), (TESTS, None, WITNESS_FROM_STR)],
        # The same witness with no code change, where it must fail.
        "M2": [(TESTS, None, WITNESS_FROM_STR)],
        # The row filter goes, and the witness asserts the reference a row of 0
        # then makes.
        "M3": [
            (CELLS, """            let number = decimal(&attribute.value)
                    .filter(|number| *number > 0)
                    .ok_or(""", """            let number = decimal(&attribute.value)
                    .ok_or("""),
            (TESTS, None, WITNESS_ZERO_ROW),
        ],
        # The same witness with no code change, where it must fail.
        "M4": [(TESTS, None, WITNESS_ZERO_ROW)],
        # The reference buffer holds six letters instead of seven, so only a
        # column that needs the seventh stops round tripping: the saturated one
        # the round-trip test says it covers.
        "M5": [(CELLS, "let mut letters = [0u8; 7];", "let mut letters = [0u8; 6];")],
        # A zero loses its sign.
        "M6": [(CELLS, NUMBER_OLD, NUMBER_NEW)],
        # The same, with the sign-bit assertion written as the equality the
        # comment says would hold for either sign: this one must PASS.
        "M7": [(CELLS, NUMBER_OLD, NUMBER_NEW), (TESTS, SIGN_OLD, SIGN_NEW)],
        # No code change: the NaN predicate written as an equality against
        # f64::NAN, which the comment says would fail on a correct answer.
        "M8": [(TESTS, '        assert!(cells[0].number().expect("parses").is_nan(), "{spelling}");',
                '        assert_eq!(cells[0].number(), Some(f64::NAN), "{spelling}");')],
        # Each typed view loses its kind check and answers for a neighbour.
        "M9": [(CELLS, "        if self.kind != Kind::Number {\n            return None;\n        }\n", "")],
        "M10": [(CELLS, "        if self.kind != Kind::Boolean {\n            return None;\n        }\n", "")],
        "M11": [(CELLS, "        if self.kind != Kind::Error {\n            return None;\n        }\n", "")],
    }
    
    which = sys.argv[1]
    root = sys.argv[2]
    for path, old, new in MUTATIONS[which]:
        full = root + "/" + path
        body = open(full).read()
        if old is None:
            open(full, "a").write(new)
            print("    applied %s to %s: appended %d bytes" % (which, path, len(new)))
            continue
        found = body.count(old)
        if found != 1:
            print("REFUSED %s: the text to replace in %s occurs %d times, not once" % (which, path, found))
            sys.exit(2)
        open(full, "w").write(body.replace(old, new, 1))
        print("    applied %s to %s: %d bytes -> %d bytes" % (which, path, len(old), len(new)))
    PYEOF
    echo
    echo "## the mutation applier this block runs"
    sed 's/^/    /' "$MUTTREE/mutate.py"
    
    # What each mutation must break, what it must leave PASSING where that is the
    # point of the case, and whether the mutated tree is expected to fail its
    # tests at all. M7 is the only one whose tree must pass.
    mut_mode() {
      case "$1" in
        M7) echo passes ;;
        *) echo fails ;;
      esac
    }
    mut_expect() {
      case "$1" in
        M1) echo "cells::tests::a_number_this_layer_reads_is_digits_alone" ;;
        M2) echo "cells::tests::the_witness_from_str_reads_plus_one_plus_zero_and_zero_zero_seven" ;;
        M3) echo "cells::tests::a_row_number_of_zero_is_refused" ;;
        M4) echo "cells::tests::the_witness_a_row_of_zero_emits_a0_which_its_own_parser_refuses" ;;
        M5) echo "cells::tests::every_reference_the_reader_emits_parses_back" ;;
        M6) echo "cells::tests::a_numbers_text_is_read_as_an_f64" ;;
        M8) echo "cells::tests::the_parse_is_the_standard_librarys_and_wider_than_the_format" ;;
        M9 | M10 | M11) echo "cells::tests::each_typed_view_answers_only_for_its_own_kind" ;;
        *) echo "" ;;
      esac
    }
    mut_survives() {
      case "$1" in
        M1) echo "cells::tests::the_witness_from_str_reads_plus_one_plus_zero_and_zero_zero_seven" ;;
        M3) echo "cells::tests::the_witness_a_row_of_zero_emits_a0_which_its_own_parser_refuses" ;;
        # The witness for the OTHER half of M5: the largest column the format
        # itself writes is three letters, so a six-letter buffer leaves every
        # reference but the saturated one round tripping, and the test that says
        # it covers the saturated case is the one that fails.
        M5) echo "cells::tests::a_cells_own_reference_wins_over_its_row" ;;
        M6) echo "cells::tests::the_parse_is_the_standard_librarys_and_wider_than_the_format" ;;
        M7) echo "cells::tests::a_numbers_text_is_read_as_an_f64" ;;
        *) echo "" ;;
      esac
    }
    
    for m in M1 M2 M3 M4 M5 M6 M7 M8 M9 M10 M11; do
      echo
      echo "### $m"
      ( cd "$MUTTREE/tree" && git checkout -q -- . ) || fail=1
      python3 "$MUTTREE/mutate.py" "$m" "$MUTTREE/tree" >"$T/mut-$m.apply" 2>&1
      arc=$?
      sed 's/^/  /' "$T/mut-$m.apply"
      check "$m: the applier found its text exactly once and replaced it" "$(yn [ "$arc" -eq 0 ])"
      if [ "$arc" -ne 0 ]; then continue; fi
      # --no-fail-fast, as P2's block found it needed: without it cargo stops
      # after the first test binary that fails, and a mutation block that cannot
      # see every binary's failures is measuring the runner and not the mutation.
      echo "command: cargo test --no-fail-fast -p emend -p emend-copy (in the mutated worktree)"
      ( cd "$MUTTREE/tree" && CARGO_TARGET_DIR="$MUTTREE/target" \
          cargo test --no-fail-fast -p emend -p emend-copy ) \
        >"$T/mut-$m.out" 2>&1 </dev/null
      rc=$?
      echo "exit: $rc"
      if [ "$(mut_mode "$m")" = passes ]; then
        check "$m: the mutated tree PASSES its tests, which is the point of it" "$(yn [ "$rc" -eq 0 ])"
      else
        check "$m: the mutated tree does not pass its tests" "$(yn [ "$rc" -ne 0 ])"
      fi
      echo "  the failures, with the values each assertion saw:"
      LC_ALL=C "$G" -E '^---- .* stdout ----$|^ *left: |^ *right: |panicked at |^test result: FAILED' \
        "$T/mut-$m.out" | sed 's/^/    /'
      LC_ALL=C "$G" -E '^ +[a-z_:0-9]+$' "$T/mut-$m.out" | sed 's/^ *//' | sort -u >"$T/mut-$m.failed"
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/mut-$m.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort -u >"$T/mut-$m.ok"
      echo "  the failing test names this run reports:"
      sed 's/^/    /' "$T/mut-$m.failed"
      for want in $(mut_expect "$m"); do
        hit=$(count_matches -E "^${want}\$" "$T/mut-$m.failed")
        check "$m: $want fails" "$(yn [ "$hit" -ge 1 ])"
      done
      for keep in $(mut_survives "$m"); do
        hit=$(count_matches -E "^${keep}\$" "$T/mut-$m.ok")
        check "$m: $keep still passes, which is the point of it" "$(yn [ "$hit" -ge 1 ])"
      done
    done
    
    # The neighbour's own answer, which is the other half of the comment M9
    # measures: it says the shared-string cell "would be read as the number 0 if
    # number went by the text alone". The failing test prints the whole table it
    # saw, so the tuple for that cell is read out of M9's own output rather than
    # inferred from the failure.
    neighbour=$(count_matches -F '(Some(0.0), None, None)' "$T/mut-M9.out")
    echo
    echo "  the answers M9's run printed for the shared-string cell: $neighbour line or lines hold (Some(0.0), None, None)"
    check "M9: the shared-string cell is read as the number 0 with the kind check gone" \
      "$(yn [ "$neighbour" -ge 1 ])"
    # The control for that form, through the same command: the UNMUTATED run of
    # the same test prints no such tuple, so the count above is the mutation's.
    neighbour_ctl=$(count_matches -F '(Some(0.0), None, None)' "$T/mut-M2.out")
    check "control: M2's run, whose code is unmutated, holds no such tuple ($neighbour_ctl)" \
      "$(yn [ "$neighbour_ctl" -eq 0 ])"
    
    # The control for this whole block, in the same command form: the UNMUTATED
    # worktree at the same commit must pass, so a failure above cannot be the
    # worktree, the target directory or the toolchain rather than the mutation.
    echo
    echo "### control: the same worktree with no mutation applied"
    ( cd "$MUTTREE/tree" && git checkout -q -- . ) || fail=1
    echo "command: cargo test --no-fail-fast -p emend -p emend-copy (in the clean worktree)"
    ( cd "$MUTTREE/tree" && CARGO_TARGET_DIR="$MUTTREE/target" \
        cargo test --no-fail-fast -p emend -p emend-copy ) \
      >"$T/mut-clean.out" 2>&1 </dev/null
    rc=$?
    echo "exit: $rc"
    LC_ALL=C "$G" -E '^test result: ' "$T/mut-clean.out" | sed 's/^/    /'
    check "control: the unmutated worktree passes, so each failure above is the mutation's" \
      "$(yn [ "$rc" -eq 0 ])"
    # The witnesses are planted and never committed: the worktree this block
    # deletes is the only place they existed. Measured, not asserted.
    witness_lines=$(count_matches -F 'the_witness_' "$MUTTREE/tree/crates/emend/src/cells/tests.rs")
    check "the restored worktree holds neither witness ($witness_lines lines)" "$(yn [ "$witness_lines" -eq 0 ])"
    cleanup_worktree
    trap 'rm -rf "$T"' EXIT INT TERM HUP
    echo
    echo "## the two runs"
    echo "host executed $(cat "$T/host.count") tests; i686-unknown-linux-musl executed $(cat "$T/i686-unknown-linux-musl.count") tests"
    check "the i686 run executed the same test names as the host run" "$(yn cmp -s "$T/host.names" "$T/i686-unknown-linux-musl.names")"
    check "the two counts are equal" "$(yn [ "$(cat "$T/host.count")" = "$(cat "$T/i686-unknown-linux-musl.count")" ])"
    
    echo
    echo "## status after the runs"
    # FOUR terms, not P2's three: specs/0010, "Size", puts part 3's size record at
    # the part's end, which is this phase, so the record is a fourth thing the
    # working tree legitimately holds and a term that can be more than zero.
    st_all=$(run_lines git status --porcelain)
    st_untracked_log=$(run_matches -E '^[?][?] records/logs/m1p3-p3' git status --porcelain)
    st_tracked_log=$(run_matches -E '^ ?[MARCD] records/logs/m1p3-p3' git status --porcelain)
    st_record=$(run_matches -E '^(\?\?| ?[MARCD]) records/m1p3-p3-' git status --porcelain)
    st_size=$(run_matches -E '^(\?\?| ?[MARCD]) records/size-m1p3-' git status --porcelain)
    echo "status lines: $st_all; untracked under the log directory: $st_untracked_log; tracked and modified under it: $st_tracked_log; the phase's record pair: $st_record; the part's size record: $st_size"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_untracked_log" != error ] &&
        [ "$st_tracked_log" != error ] && [ "$st_record" != error ] &&
        [ "$st_size" != error ] &&
        [ "$st_all" = "$((st_untracked_log + st_tracked_log + st_record + st_size))" ]
    }
    check "every change in the working tree is one of this phase's logs, its record pair or the part's size record" "$(yn status_accounted)"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

