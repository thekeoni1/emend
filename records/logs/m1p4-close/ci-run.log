## script that wrote this log
    #!/usr/bin/env bash
    # Milestone 1 part 4 close-out ci-run.log (specs/0011-editing-cells.md "Close-out
    # push (after P3)": "As part 3's, with the close-out scripts as part 3 ran
    # them").
    #
    # DERIVED FROM part 3's close-out script as records/logs/m1p3-close/ci-run.log
    # printed it, extracted from that log and audited against specs/0001 "Rules for
    # every phase" before this run. What changed, and why:
    #  1. The names are part 4's and the spec cited is specs/0011.
    #  2. The clean-tree check is strict again: part 3's allowed exactly one line,
    #     the maintainer's uncommitted CLAUDE.md edit during part 3's close-out.
    #     Git status was empty when this close-out began and the last commit to
    #     touch CLAUDE.md is in this range (8d865e9, part 4 P1's doc commit), so
    #     any status line now fails the check.
    #  3. A PATH CHECK over the captured output (the run list, the jobs, the run's
    #     JSON and the filtered job logs), with a planted path assembled at run time
    #     as its control: planning's ruling 1 on P3 (specs/0011), that a zero is
    #     meaningful only beside a control that can be nonzero, from the close-out
    #     on. Part 3's script had no path check.
    # The per-job log route (gh api .../actions/jobs/<id>/logs) is part 3's,
    # unchanged. Nothing about the gate's steps is asserted here, as in part 3.
    #
    # Records the CI run on the pushed commit: the run's identity, its status and
    # conclusion, every job and step conclusion, and the repository's Actions
    # settings. It waits for the run to finish, polling at a fixed interval, and
    # says how long it waited.
    #
    # Usage: M1CLOSE_LIB=<lib> m1p4close-ci.sh <pushed sha> > <scratch file>
    # The caller moves the output to records/logs/m1p4-close/ci-run.log.
    #
    # Every commit id this log reports is read from git at run time by a command
    # the log prints, or is the argument given by the caller, which is checked
    # against git. Every count goes through the shared counting library, which
    # reads exit statuses and reports "error" rather than a number when it cannot
    # read; its controls run before any of them is used.
    # No token or authentication output is captured: gh reads its own credentials.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    SHA=${1:?the pushed commit is required}
    LIB=${M1CLOSE_LIB:?the path to the counting library is required}
    . "$LIB"
    REPO=thekeoni1/emend
    INTERVAL=30
    MAX=90
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    
    show() { echo "$1:"; sed 's/^/    /' "$2"; }
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # jfield <json file> <python expression over d>: one value from the JSON, or
    # nothing if it cannot be read.
    jfield() {
      python3 -c '
    import json, sys
    d = json.load(open(sys.argv[1]))
    print('"$2"')
    ' "$1" 2>/dev/null
    }
    HEAD_SHA=$(git rev-parse HEAD)
    NULL_SHA=0000000000000000000000000000000000000000
    full_sha() { printf '%s' "$1" | LC_ALL=C /usr/bin/grep -qE '^[0-9a-f]{40}$'; }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    not_head() { if is_head "$1"; then return 1; else return 0; fi; }
    
    echo "command: git rev-parse main"
    echo "about: M1 part 4 close-out CI run for pushed commit $SHA; HEAD at run: $HEAD_SHA"
    echo "  the pushed commit given to this script: $SHA"
    echo "  git rev-parse HEAD at this run:         $HEAD_SHA"
    check "the commit given to this script is HEAD" "$(yn is_head "$SHA")"
    check "control: the same form refuses a commit that is not HEAD" "$(yn not_head "$NULL_SHA")"
    check "control: the same form refuses a short sha of the real commit" "$(yn not_head "$(printf '%s' "$SHA" | cut -c1-7)")"
    echo "phase: Milestone 1 part 4 close-out (specs/0011-editing-cells.md \"Close-out push (after P3)\") ci-run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
    fi
    check "the commit given is main as git reports it" "$(yn [ "$SHA" = "$(git rev-parse main)" ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$LIB"
    echo
    echo "## counting controls (every form, before any of them is used)"
    counting_controls
    check "every counting form behaves on a match, a miss and an unreadable file" "$(yn [ "$counting_controls_ok" = yes ])"
    
    echo
    echo "## waiting for the run on $SHA to complete"
    echo "polled every $INTERVAL seconds, at most $MAX times"
    waited=0
    ID=""
    while [ "$waited" -lt "$MAX" ]; do
      if gh run list --repo "$REPO" --workflow ci.yml --commit "$SHA" \
          --json databaseId,status,conclusion > "$T/runs.json" 2>"$T/runs.err" </dev/null; then
        ID=$(jfield "$T/runs.json" 'd[0]["databaseId"] if d else ""')
        ST=$(jfield "$T/runs.json" 'd[0]["status"] if d else ""')
        if [ -n "$ID" ] && [ "$ST" = completed ]; then
          echo "  run $ID is completed after $((waited * INTERVAL)) second(s) of polling"
          break
        fi
        echo "  poll $((waited + 1)): run ${ID:-none yet}, status ${ST:-none}"
      else
        echo "  poll $((waited + 1)): gh run list failed"
      fi
      waited=$((waited + 1))
      sleep "$INTERVAL"
    done
    check "a completed run was found for $SHA" "$(yn [ -n "$ID" ])"
    
    echo
    echo "## the run"
    echo "command: gh run list --repo $REPO --workflow ci.yml --commit $SHA"
    gh run list --repo "$REPO" --workflow ci.yml --commit "$SHA" \
      --json databaseId,workflowName,headBranch,event,status,conclusion \
      --jq '.[] | "\(.databaseId) \(.workflowName) \(.headBranch) \(.event) \(.status) \(.conclusion)"' \
      > "$T/list" 2>"$T/listerr" </dev/null
    show output "$T/list"
    n=$(count_lines "$T/list")
    check "exactly one ci.yml run on this commit: $n" "$(yn [ "$n" = 1 ])"
    
    echo "command: gh run view $ID --json headSha,headBranch,event,status,conclusion,workflowName,jobs"
    gh run view "$ID" --repo "$REPO" \
      --json headSha,headBranch,event,status,conclusion,workflowName,jobs > "$T/view.json" 2>"$T/viewerr" </dev/null
    rc=$?
    check "gh run view exit is 0" "$(yn [ "$rc" -eq 0 ])"
    python3 -c '
    import json, sys
    d = json.load(open(sys.argv[1]))
    print("workflow %s; head %s; branch %s; event %s" % (d["workflowName"], d["headSha"], d["headBranch"], d["event"]))
    print("status %s; conclusion %s" % (d["status"], d["conclusion"]))
    for j in d["jobs"]:
        print("job %s: status %s; conclusion %s" % (j["name"], j["status"], j["conclusion"]))
        for s in j["steps"]:
            print("  step %s %s: status %s; conclusion %s" % (s["number"], s["name"], s["status"], s["conclusion"]))
    ' "$T/view.json" 2>/dev/null | sed 's/^/    /'
    v=$(jfield "$T/view.json" '"%s %s %s %s" % (d["headSha"], d["headBranch"], d["event"], d["conclusion"])')
    check "head, branch, event and conclusion: $v (expect $SHA main push success)" "$(yn [ "$v" = "$SHA main push success" ])"
    v=$(jfield "$T/view.json" 'sum(1 for j in d["jobs"] for s in j["steps"] if s["conclusion"] not in ("success", "skipped"))')
    check "steps with a conclusion other than success or skipped: $v (expect 0)" "$(yn [ "$v" = 0 ])"
    
    echo
    echo "## the runner and the job labels"
    echo "command: gh api repos/$REPO/actions/runs/$ID/jobs"
    gh api "repos/$REPO/actions/runs/$ID/jobs" \
      --jq '.jobs[] | "job \(.name): labels \(.labels | join(",")); runner \(.runner_name // "none"); conclusion \(.conclusion)"' \
      > "$T/jobs" 2>"$T/joberr" </dev/null
    show output "$T/jobs"
    
    echo
    echo "## Actions settings, unchanged since T0b"
    for ep in "actions/permissions" "actions/permissions/selected-actions"; do
      echo "command: gh api repos/$REPO/$ep"
      gh api "repos/$REPO/$ep" > "$T/perm" 2>"$T/permerr" </dev/null && show output "$T/perm" || show error "$T/permerr"
    done
    
    echo
    echo "## the log of the run, filtered as in P1"
    echo "command: gh api repos/$REPO/actions/runs/$ID/jobs --jq '.jobs[].id'"
    gh api "repos/$REPO/actions/runs/$ID/jobs" --jq '.jobs[].id' > "$T/jobids" 2>/dev/null </dev/null
    : > "$T/log"
    lrc=0
    while IFS= read -r jid; do
      echo "command: gh api repos/$REPO/actions/jobs/$jid/logs  (filtered: the PASS and SKIP lines and the rustc version)"
      gh api "repos/$REPO/actions/jobs/$jid/logs" >> "$T/log" 2>/dev/null </dev/null || lrc=1
    done < "$T/jobids"
    echo "  job logs fetched: $(count_lines "$T/jobids"); any fetch failed: $lrc; bytes $(count_bytes '\000-\377' "$T/log")"
    LC_ALL=C "$G" -a -E '(PASS|SKIP) [a-z]|rustc [0-9]' "$T/log" | head -40 >"$T/filtered"
    sed 's/^/    /' "$T/filtered"
    # counted_some <count>: the count is a real number and is not zero, in a
    # named function as specs/0001 requires for a check of two conditions.
    counted_some() { [ "$1" != error ] && [ "$1" != 0 ]; }
    check "every job's log was fetched" "$(yn [ "$lrc" -eq 0 ])"
    n=$(count_matches -E '^.*PASS host' "$T/log")
    check "the run's log holds a PASS host line: $n" "$(yn counted_some "$n")"
    n=$(count_matches -E 'SKIP privacy' "$T/log")
    check "the run skipped the privacy step, as CI mode requires: $n" "$(yn counted_some "$n")"
    
    echo
    echo "## this log's own output"
    ALL=()
    for f in "$T/list" "$T/jobs" "$T/view.json" "$T/filtered"; do [ -e "$f" ] && ALL+=("$f"); done
    echo "  files counted (${#ALL[@]}): $(printf '%s ' "${ALL[@]##*/}")"
    captured_clean() {
      [ "$(count_bytes "$CTRL_CLASS" "${ALL[@]}")" = 0 ] &&
        [ "$(count_bytes "$NONASCII_CLASS" "${ALL[@]}")" = 0 ]
    }
    echo "  control bytes $(count_bytes "$CTRL_CLASS" "${ALL[@]}"), non-ASCII bytes $(count_bytes "$NONASCII_CLASS" "${ALL[@]}") (expect 0 and 0)"
    check "no control or non-ASCII byte in the captured output" "$(yn captured_clean)"
    # The path check (header change 3). The planted path is assembled at run time
    # so this script's own text carries none; path_control is not run inside yn,
    # so its printed line is not swallowed.
    PATH_RE='(/home/|/mnt/|/Users/|/tmp/|emend-testing)'
    path_control() {
      printf 'x %s%s%s y\n' '/ho' 'me/someone/' 'emend-testing/corpus/x.xlsx' >"$T/path-plant"
      printf 'x clean y\n' >"$T/path-clean"
      local a b
      a=$(count_matches -E "$PATH_RE" "$T/path-plant")
      b=$(count_matches -E "$PATH_RE" "$T/path-clean")
      echo "  control: the path form on a planted path: $a (expect 1); on a clean line: $b (expect 0)"
      path_ctl_ok=no
      if [ "$a" = 1 ] && [ "$b" = 0 ]; then path_ctl_ok=yes; fi
    }
    no_paths() { [ "$(count_matches -E "$PATH_RE" "$@")" = 0 ]; }
    path_control
    check "the path form can count a planted path" "$path_ctl_ok"
    echo "  lines naming a home, mount, temp or corpus path in the captured output: $(count_matches -E "$PATH_RE" "${ALL[@]}")"
    check "the captured output names no such path" "$(yn no_paths "${ALL[@]}")"
    echo "command: git status --porcelain -> $(run_lines git status --porcelain) line(s)"
    tree_clean() { [ "$(run_lines git status --porcelain)" = 0 ]; }
    check "working tree clean" "$(yn tree_clean)"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "ci-run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"
    
    

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls (every form, before any of them is used)
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
  control count_matches with a regular expression: 2 (expect 2)
  control count_matches on an unreadable file: error (expect error)
  control count_matches on readable plus unreadable: error (expect error)
  control count_from_file on the same file: 2 (expect 2)
  control count_from_file on a file with none: 0 (expect 0)
