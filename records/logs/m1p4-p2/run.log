## the comparison this log runs (python3, zipfile and expat)
    """The run log's own cell comparison (specs/0011, "Harness runs", P2).
    
    Usage: cmp.py <input archive> <output archive> [--plant]
    
    Finds the workbook's first sheet of kind worksheet in <sheets> order by the
    package's own relationships, reads that part from both archives with
    zipfile, and compares them with python3's expat parser, sharing no code with
    the library:
    
    - the bytes before the sheetData start tag, and the bytes from its end tag to
      the end of the part (for an empty <sheetData/>, from the byte after it);
    - every cell, a <c> child of a <row> child of the sheetData, as the tuple
      (reference, s, t, formula presence, value text), where the value text is
      the <v> text or, without a <v>, the <is> text;
    - from the INPUT alone, its own pick of A (the first cell whose t is absent,
      n or s, with a <v> and no <f>), B (the second) and M (the largest row
      number), and whether the output differs from the input exactly there.
    
    It prints ONE line of counts and yes/no flags: no reference, no value, no
    text and no part name. With --part in place of the output it prints the
    part's name alone, which the log compares and never prints. --plant adds one cell to the output part before it is
    compared (after the last cell, in the last row), a planted difference the
    comparison must report.
    """
    import re
    import sys
    import xml.parsers.expat
    import zipfile
    import posixpath
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    
    def rels_of(z, part):
        d, base = posixpath.split(part)
        name = posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
        out = []
        if name not in z.namelist():
            return out
        found = []
    
        def start(tag, attrs):
            if tag == RELS + " Relationship" and attrs.get("TargetMode") != "External":
                found.append(attrs)
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.Parse(z.read(name), True)
        for a in found:
            target = a.get("Target", "")
            resolved = (target[1:] if target.startswith("/")
                        else posixpath.normpath(posixpath.join(d, target)))
            out.append((a.get("Id"), a.get("Type", ""), resolved))
        return out
    
    
    def first_worksheet(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        if len(office) != 1:
            return None
        workbook = office[0]
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        order = []
    
        def start(tag, attrs):
            ns, _, local = tag.rpartition(" ")
            if ns in MAIN and local == "sheet":
                for a in ATTR:
                    if a + " id" in attrs:
                        order.append(attrs[a + " id"])
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.Parse(z.read(workbook), True)
        for rid in order:
            ty, target = by_id.get(rid, ("", None))
            if ty.endswith("/worksheet"):
                return target
        return None
    
    
    def cells(data):
        """{reference: tuple} in document order, and the order itself."""
        out = {}
        order = []
        stack = []
        state = {"cell": None, "text": None}
    
        def start(tag, attrs):
            ns, _, local = tag.rpartition(" ")
            local = local if ns in MAIN else None
            stack.append(local)
            if local == "c" and stack[-2:-1] == ["row"] and stack[-3:-2] == ["sheetData"]:
                state["cell"] = {"r": attrs.get("r"), "s": attrs.get("s"),
                                 "t": attrs.get("t"), "f": False, "v": None, "is": None}
            elif state["cell"] is not None:
                if local == "f" and stack[-2:-1] == ["c"]:
                    state["cell"]["f"] = True
                elif local == "v" and stack[-2:-1] == ["c"]:
                    state["text"] = "v"
                    state["cell"]["v"] = ""
                elif local == "is" and stack[-2:-1] == ["c"]:
                    state["cell"]["is"] = ""
                elif local == "t" and "is" in stack:
                    state["text"] = "is"
    
        def end(tag):
            local = stack.pop()
            if local in ("v", "t"):
                state["text"] = None
            if local == "c" and state["cell"] is not None and stack[-1:] == ["row"]:
                c = state["cell"]
                value = c["v"] if c["v"] is not None else c["is"]
                out[c["r"]] = (c["r"], c["s"], c["t"], c["f"], value, c["v"] is not None)
                order.append(c["r"])
                state["cell"] = None
    
        def chars(text):
            if state["cell"] is not None and state["text"] is not None:
                state["cell"][state["text"]] += text
    
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.CharacterDataHandler = chars
        p.buffer_text = True
        p.Parse(data, True)
        return out, order
    
    
    def bounds(data):
        """(prefix end, end tag start or None for <sheetData/>, element end)."""
        start = re.search(rb"<([A-Za-z_][\w.-]*:)?sheetData[\s/>]", data)
        if start is None:
            return None
        close = data.find(b">", start.start())
        if data[close - 1:close] == b"/":
            return start.start(), None, close + 1
        ends = list(re.finditer(rb"</([A-Za-z_][\w.-]*:)?sheetData\s*>", data))
        if not ends:
            return None
        return start.start(), ends[-1].start(), ends[-1].end()
    
    
    def row_of(ref):
        m = re.fullmatch(r"[A-Z]+([1-9][0-9]*)", ref or "")
        return int(m.group(1)) if m else None
    
    
    def main():
        if sys.argv[2:3] == ["--part"]:
            # The part's name, for the log to compare with the entry the runner
            # saw changed; the log never prints it.
            print(first_worksheet(zipfile.ZipFile(sys.argv[1])) or "")
            return
        zin, zout = zipfile.ZipFile(sys.argv[1]), zipfile.ZipFile(sys.argv[2])
        plant = "--plant" in sys.argv[3:]
        part = first_worksheet(zin)
        if part is None or part != first_worksheet(zout):
            print("error=no-first-worksheet")
            return
        din, dout = zin.read(part), zout.read(part)
        if plant:
            at = dout.rfind(b"</row>")
            prefix = b""
            rows = list(re.finditer(rb"<([A-Za-z_][\w.-]*:)?row[\s/>]", dout))
            if rows and rows[-1].group(1):
                prefix = rows[-1].group(1)
            dout = (dout[:at] + b"<" + prefix + b'c r="ZZ999999"><' + prefix + b"v>0</"
                    + prefix + b"v></" + prefix + b"c>" + dout[at:])
        bi, bo = bounds(din), bounds(dout)
        if bi is None or bo is None:
            print("error=no-sheetData")
            return
        prefix_same = din[:bi[0]] == dout[:bo[0]]
        # From the end tag when both have one; after the element when the input's
        # was an empty <sheetData/>, which has no end tag to start from.
        if bi[1] is not None and bo[1] is not None:
            suffix_same = din[bi[1]:] == dout[bo[1]:]
        else:
            suffix_same = din[bi[2]:] == dout[bo[2]:]
        cin, order = cells(din)
        cout, _ = cells(dout)
        unchanged = changed = added = removed = 0
        changed_refs, removed_refs = set(), set()
        for ref, tup in cin.items():
            if ref not in cout:
                removed += 1
                removed_refs.add(ref)
            elif cout[ref] == tup:
                unchanged += 1
            else:
                changed += 1
                changed_refs.add(ref)
        added_refs = set(cout) - set(cin)
        added = len(added_refs)
    
        # The comparison's own pick of A, B and M, from the input alone.
        picks = [r for r in order
                 if cin[r][2] in (None, "n", "s") and cin[r][5] and not cin[r][3]]
        a = picks[0] if picks else None
        b = picks[1] if len(picks) > 1 else None
        rows = [row_of(r) for r in order]
        m = max([x for x in rows if x is not None], default=0)
        b_styled = b is not None and cin[b][1] is not None
        want_changed = ({a} if a else set()) | ({b} if b_styled else set())
        want_removed = {b} if (b is not None and not b_styled) else set()
        want_added = {"A%d" % (m + 1), "B%d" % (m + 1)}
        refs_as_edited = (changed_refs == want_changed and removed_refs == want_removed
                          and added_refs == want_added)
        a_ok = a is None or (a in cout and cout[a][1:] == (cin[a][1], None, False, "42.5", True))
        b_ok = (not b_styled) or (b in cout and cout[b][1] == cin[b][1] and not cout[b][5]
                                 and cout[b][4] is None)
        new_ok = (cout.get("A%d" % (m + 1), (None,) * 6)[2:5] == ("inlineStr", False, "emend")
                  and cout.get("B%d" % (m + 1), (None,) * 6)[2:5] == ("b", False, "1"))
        yn = lambda x: "yes" if x else "no"
        print(" ".join([
            "prefix_same=%s" % yn(prefix_same), "suffix_same=%s" % yn(suffix_same),
            "cells_in=%d" % len(cin), "cells_out=%d" % len(cout),
            "unchanged=%d" % unchanged, "changed=%d" % changed,
            "added=%d" % added, "removed=%d" % removed,
            "a=%d" % (a is not None), "b=%d" % (b is not None),
            "b_styled=%d" % b_styled,
            "refs_as_edited=%s" % yn(refs_as_edited), "a_value=%s" % yn(a_ok),
            "b_kept_s_no_value=%s" % yn(b_ok), "new_cells=%s" % yn(new_ok),
        ]))
    
    
    main()

