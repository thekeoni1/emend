## script
    #!/usr/bin/env bash
    # Milestone 1 part 4 P3 run.log (specs/0011-editing-cells.md, "P3" and
    # "Harness runs"): the corpus run on both targets with --tool-arg
    # --edit-formula-sample, using the release binaries size.log built and
    # hashed, the run log's own expat comparison of every workbook's edited
    # sheet, and the record pair.
    #
    # P3's acceptance, from "Harness runs" as planning's rulings during P3 (4 to
    # 6) corrected it, lo and lo_in ok in every case:
    #  - in every workbook with a normal formula, the sheet holding it `changed`;
    #    in those with a chain, the chain `dropped` and the workbook's rels part
    #    and [Content_Types].xml `changed`, `descriptor` alone allowed on a
    #    changed entry (P2 verification ruling 6); every other entry `identical`
    #    unflagged; a workbook with no normal formula `files_identical` `yes`;
    #  - per target, how many workbooks had a formula replaced and how many
    #    chains were dropped;
    #  - the same cell comparison as P2, from the comparison's own pick of the
    #    sheet and the cell (the first normal formula of the first worksheet, in
    #    <sheets> order, that has one): prefix and suffix bytes identical,
    #    `changed` 1 and `added` and `removed` 0, the changed reference exactly
    #    that cell, which keeps its s and carries the number 1 with no formula;
    #  - <row> elements counted in input and output (P2 verification ruling 4);
    #  - the tool's line: read_back equal to formula_replaced in every file,
    #    chain_dropped equal to whether the input had a chain when a formula was
    #    replaced, cells_after equal to the edited sheet's cell count, and every
    #    key 0 when none was.
    #
    # WRITTEN FOR P3 from P2's run script (records/logs/m1p4-p2/run.log). What
    # differs from P2's:
    #  1. The binaries are the RELEASE builds, hashed against size.log by command
    #     rather than against gate.log.
    #  2. The comparison (cmp.py, printed below) is P3's: its own pick, the chain
    #     read from both archives, the <row> counts, and --parts for the entry
    #     rows. Every flag of its line has a planted fault on a generated pair,
    #     and a planted cell on a real pair (P2 verification ruling 4).
    #  3. The entry rows are checked per workbook by name against the parts the
    #     comparison names; names are compared and never printed.
    #  4. The planted path in the path check is assembled at run time.
    #
    # ONE PLANNING FILE IS MODIFIED AND UNCOMMITTED: specs/0011-editing-cells.md
    # (planning's rulings during P3). The log prints its sha256 at the start and
    # the end, and the status check accounts for exactly that line.
    #
    # None of the three shapes specs/0001 forbids appears here: every compound
    # condition is a named function and every negated one goes through isnot,
    # whose control is below; the shapes are described rather than written out.
    #
    # Workbooks appear as ids only. No original name, note, producer_version or
    # app, and no corpus path: the corpus directory is written <corpus>. The
    # comparison prints counts and yes/no flags only: no reference, no value, no
    # text, no part name.
    #
    # Usage: m1p4-p3-run.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m1p4-p3/run.log. One runner pass per target over 27
    # workbooks with a LibreOffice conversion each, so the caller starts it
    # detached and polls.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    LO_IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    SHORT=$(git rev-parse --short HEAD)
    DATE=$(date -u +%Y-%m-%d)
    # A rerun takes a run directory of its own, RUN_TAG naming it (the runner
    # refuses a second row for an id in one directory).
    RUN_TAG=${RUN_TAG:-}
    RUN=$DATE-$SHORT$RUN_TAG
    OUT=$CORPUS/runs/$RUN
    STEM=m1p4-p3-$DATE-$SHORT
    PLANNING_FILES="specs/0011-editing-cells.md"
    HEAD_SHA=$(git rev-parse HEAD)
    NULL_SHA=0000000000000000000000000000000000000000
    EDIT=--edit-formula-sample
    fail=0
    
    # note <what> <verdict>: one verdict line, and a verdict other than
    # as-expected fails the log.
    note() { echo "  $1: $2"; [ "$2" = as-expected ] || fail=1; }
    # is <command...>: as-expected when the command succeeds.
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    # isnot <command...>: as-expected when it fails, so no call hands a negation
    # to `is`, which specs/0001 forbids as a shape.
    isnot() { if "$@"; then echo UNEXPECTED; else echo as-expected; fi; }
    hide() { sed "s#$CORPUS#<corpus>#g; s#$MAIN#<repo>#g; s#$HOME#<home>#g"; }
    
    G=/usr/bin/grep
    W=$(mktemp -d) || exit 2
    trap 'rm -rf "$W"' EXIT INT TERM HUP
    
    nrows() { awk -F'\t' 'NR > 1 { n++ } END { print n + 0 }' "$1"; }
    # columns_resolve <tsv> <names>: every named column is in the file's header,
    # and there is a header at all.
    columns_resolve() {
      awk -F'\t' -v want="$2" '
        NR == 1 {
          seen = 1
          for (i = 1; i <= NF; i++) have[$i] = 1
          n = split(want, w, " ")
          for (j = 1; j <= n; j++) if (!(w[j] in have)) miss++
          exit
        }
        END { exit (seen != 1 || miss > 0) }' "$1"
    }
    count_where() {
      awk -F'\t' -v c="$2" -v v="$3" '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next }
        k && $k == v { n++ } END { print n + 0 }' "$1"
    }
    sum_col() {
      awk -F'\t' -v c="$2" '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next }
        k { n += $k } END { print n + 0 }' "$1"
    }
    # kv <line> <key>: the value of key=value in a line whose pairs are split on
    # tabs or spaces; empty when the key is absent.
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    # kvn <line> <key>: the same, 0 when absent or not a number, for totals; a
    # workbook whose line is short is refused by accept_one, so a 0 here cannot
    # hide it.
    kvn() {
      local v
      v=$(kv "$1" "$2")
      case "$v" in '' | *[!0-9]*) echo 0 ;; *) echo "$v" ;; esac
    }
    
    # The guard, before a line of the run exists.
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    if ! is_head "$C"; then echo "the phase commit must be HEAD as a full sha, not $C" >&2; exit 2; fi
    
    echo "command: git rev-parse HEAD"
    echo "about: M1 part 4 P3 phase commit $C; HEAD at run: $HEAD_SHA"
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $HEAD_SHA"
    note "the phase commit given to this script is a full sha" "$(is full_sha "$C")"
    note "the phase commit given to this script is HEAD" "$(is is_head "$C")"
    note "control: the same comparison refuses the null commit" "$(isnot is_head "$NULL_SHA")"
    note "control: the same comparison refuses a short sha of the real commit" \
      "$(isnot is_head "$(printf '%s' "$C" | cut -c1-7)")"
    note "control: isnot reports a passing command as UNEXPECTED, so it can fail" \
      "$(is [ "$(isnot true)" = UNEXPECTED ])"
    echo "phase: Milestone 1 part 4 P3 (specs/0011-editing-cells.md) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    echo "command: sha256sum over planning's uncommitted file (rulings during P3)"
    for pf in $PLANNING_FILES; do
      echo "  $pf: sha256 $(sha256sum <"$pf" | cut -d' ' -f1)"
    done
    echo "SERIALIZED: produced with no other run in flight"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go"
    echo "  to a scratch file, polled from later calls. Started as a background"
    echo "  task of the calling session."
    echo "TERMS: the four release builds were finished by size.log before this run"
    echo "  started, so no cargo runs during it; order host then i686; nothing"
    echo "  else running; no mid-run tuning, and a copy or conversion that timed"
    echo "  out or was killed would be recorded and listed apart, never rerun with"
    echo "  a larger value."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the copy child, the"
    echo "  figure part 4 P1's and P2's runs used: M1 part 2 P1 and P2 measured the"
    echo "  largest corpus workbook, whose largest part is 63745347 bytes, at about"
    echo "  28 seconds with the host debug binary and about 30 with the i686 one."
    echo "  --edit-formula-sample reads worksheets until one has a normal formula,"
    echo "  rewrites that one and reads it back, with release binaries here. The"
    echo "  figure is not tuned during the run."
    echo "Workbooks are cited by id only. The corpus directory's PATH is written"
    echo "  <corpus> wherever this log prints a path; its NAME appears in the"
    echo "  script printed below, in the line that takes the default CLAUDE.md"
    echo "  gives. What is private is the corpus's contents and file names."
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then
      echo "  the counting controls did not all hold"
      fail=1
    fi
    
    echo
    
    echo "## the comparison this log runs (python3, zipfile and expat)"
    cat >"$W/cmp.py" <<'CMP_PY'
    """The run log's own cell comparison (specs/0011, "Harness runs", P3).
    
    Usage: cmp.py <input archive> <output archive> [--plant]
           cmp.py <input archive> --parts
    
    Reads the package's own relationships with zipfile and expat, sharing no
    code with the library, and makes its own pick of the edit
    --edit-formula-sample should have made: the sheets of kind worksheet in
    <sheets> order, and in the first that has one, X, the first cell in document
    order whose <f> has no t attribute or t="normal". Then, when X exists, it
    compares that part in the two archives:
    
    - the bytes before the sheetData start tag, and the bytes from its end tag to
      the end of the part;
    - the <row> elements of the sheetData, counted in input and output;
    - every cell, a <c> child of a <row> child of the sheetData, as the tuple
      (reference, s, t, formula presence, value text, has <v>), counted
      unchanged, changed, added and removed; the changed references must be
      exactly X, and X in the output must keep its s, carry no t and no formula,
      and have the value text 1;
    - whether the workbook part has a calcChain relationship, in the input and in
      the output.
    
    It prints ONE line of counts and yes/no flags: no reference, no value, no
    text and no part name. With --parts it prints three part names on three
    lines (the sheet holding X or nothing, the workbook's rels part, the chain's
    part or nothing) for the log to compare with the runner's entry rows; the log
    never prints them. --plant adds one cell to the output part before it is
    compared (after the last cell, in the last row), a planted difference the
    comparison must report.
    """
    import posixpath
    import re
    import sys
    import xml.parsers.expat
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        d = posixpath.dirname(part)
        name = rels_name(part)
        out = []
        if name not in z.namelist():
            return out
        found = []
    
        def start(tag, attrs):
            if tag == RELS + " Relationship" and attrs.get("TargetMode") != "External":
                found.append(attrs)
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.Parse(z.read(name), True)
        for a in found:
            target = a.get("Target", "")
            resolved = (target[1:] if target.startswith("/")
                        else posixpath.normpath(posixpath.join(d, target)))
            out.append((a.get("Id"), a.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def worksheets(z, workbook):
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        order = []
    
        def start(tag, attrs):
            ns, _, local = tag.rpartition(" ")
            if ns in MAIN and local == "sheet":
                for a in ATTR:
                    if a + " id" in attrs:
                        order.append(attrs[a + " id"])
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.Parse(z.read(workbook), True)
        out = []
        for rid in order:
            ty, target = by_id.get(rid, ("", None))
            if ty.endswith("/worksheet") and target in z.namelist():
                out.append(target)
        return out
    
    
    def chain_of(z, workbook):
        chains = [t for (_, ty, t) in rels_of(z, workbook) if ty.endswith("/calcChain")]
        return chains[0] if chains else None
    
    
    def cells(data):
        """{reference: tuple}, the document order, the <row> count, and the
        first cell with a normal formula."""
        out = {}
        order = []
        stack = []
        state = {"cell": None, "text": None, "rows": 0, "normal": None}
    
        def start(tag, attrs):
            ns, _, local = tag.rpartition(" ")
            local = local if ns in MAIN else None
            stack.append(local)
            if local == "row" and stack[-2:-1] == ["sheetData"]:
                state["rows"] += 1
            if local == "c" and stack[-2:-1] == ["row"] and stack[-3:-2] == ["sheetData"]:
                state["cell"] = {"r": attrs.get("r"), "s": attrs.get("s"),
                                 "t": attrs.get("t"), "f": False, "normal": False,
                                 "v": None, "is": None}
            elif state["cell"] is not None:
                if local == "f" and stack[-2:-1] == ["c"]:
                    state["cell"]["f"] = True
                    state["cell"]["normal"] = attrs.get("t", "normal") == "normal"
                elif local == "v" and stack[-2:-1] == ["c"]:
                    state["text"] = "v"
                    state["cell"]["v"] = ""
                elif local == "is" and stack[-2:-1] == ["c"]:
                    state["cell"]["is"] = ""
                elif local == "t" and "is" in stack:
                    state["text"] = "is"
    
        def end(tag):
            local = stack.pop()
            if local in ("v", "t"):
                state["text"] = None
            if local == "c" and state["cell"] is not None and stack[-1:] == ["row"]:
                c = state["cell"]
                value = c["v"] if c["v"] is not None else c["is"]
                out[c["r"]] = (c["r"], c["s"], c["t"], c["f"], value, c["v"] is not None)
                order.append(c["r"])
                if c["normal"] and state["normal"] is None:
                    state["normal"] = c["r"]
                state["cell"] = None
    
        def chars(text):
            if state["cell"] is not None and state["text"] is not None:
                state["cell"][state["text"]] += text
    
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.CharacterDataHandler = chars
        p.buffer_text = True
        p.Parse(data, True)
        return out, order, state["rows"], state["normal"]
    
    
    def bounds(data):
        """(prefix end, end tag start or None for <sheetData/>, element end)."""
        start = re.search(rb"<([A-Za-z_][\w.-]*:)?sheetData[\s/>]", data)
        if start is None:
            return None
        close = data.find(b">", start.start())
        if data[close - 1:close] == b"/":
            return start.start(), None, close + 1
        ends = list(re.finditer(rb"</([A-Za-z_][\w.-]*:)?sheetData\s*>", data))
        if not ends:
            return None
        return start.start(), ends[-1].start(), ends[-1].end()
    
    
    def pick(z):
        """The sheet and the cell --edit-formula-sample should edit, or None."""
        workbook = workbook_of(z)
        if workbook is None:
            return None, None, None
        for part in worksheets(z, workbook):
            _, _, _, normal = cells(z.read(part))
            if normal is not None:
                return workbook, part, normal
        return workbook, None, None
    
    
    def main():
        zin = zipfile.ZipFile(sys.argv[1])
        workbook, part, x = pick(zin)
        if sys.argv[2:3] == ["--parts"]:
            print(part or "")
            print(rels_name(workbook) if workbook else "")
            print((chain_of(zin, workbook) or "") if workbook else "")
            return
        zout = zipfile.ZipFile(sys.argv[2])
        plant = "--plant" in sys.argv[3:]
        yn = lambda v: "yes" if v else "no"
        wb_out = workbook_of(zout)
        chain_in = int(workbook is not None and chain_of(zin, workbook) is not None)
        chain_out = int(wb_out is not None and chain_of(zout, wb_out) is not None)
        if part is None:
            print(" ".join([
                "found=0", "chain_in=%d" % chain_in, "chain_out=%d" % chain_out,
                "prefix_same=no", "suffix_same=no", "rows_in=0", "rows_out=0",
                "rows_same=no", "cells_in=0", "cells_out=0", "unchanged=0",
                "changed=0", "added=0", "removed=0", "refs_as_edited=no",
                "x_value=no",
            ]))
            return
        din, dout = zin.read(part), zout.read(part)
        if plant:
            at = dout.rfind(b"</row>")
            prefix = b""
            rows = list(re.finditer(rb"<([A-Za-z_][\w.-]*:)?row[\s/>]", dout))
            if rows and rows[-1].group(1):
                prefix = rows[-1].group(1)
            dout = (dout[:at] + b"<" + prefix + b'c r="ZZ999999"><' + prefix + b"v>0</"
                    + prefix + b"v></" + prefix + b"c>" + dout[at:])
        bi, bo = bounds(din), bounds(dout)
        if bi is None or bo is None:
            print("error=no-sheetData")
            return
        prefix_same = din[:bi[0]] == dout[:bo[0]]
        if bi[1] is not None and bo[1] is not None:
            suffix_same = din[bi[1]:] == dout[bo[1]:]
        else:
            suffix_same = din[bi[2]:] == dout[bo[2]:]
        cin, _, rows_in, _ = cells(din)
        cout, _, rows_out, _ = cells(dout)
        unchanged = changed = removed = 0
        changed_refs = set()
        for ref, tup in cin.items():
            if ref not in cout:
                removed += 1
            elif cout[ref] == tup:
                unchanged += 1
            else:
                changed += 1
                changed_refs.add(ref)
        added = len(set(cout) - set(cin))
        refs_as_edited = changed_refs == {x} and removed == 0 and added == 0
        x_value = x in cout and cout[x][1:] == (cin[x][1], None, False, "1", True)
        print(" ".join([
            "found=1", "chain_in=%d" % chain_in, "chain_out=%d" % chain_out,
            "prefix_same=%s" % yn(prefix_same), "suffix_same=%s" % yn(suffix_same),
            "rows_in=%d" % rows_in, "rows_out=%d" % rows_out,
            "rows_same=%s" % yn(rows_in == rows_out),
            "cells_in=%d" % len(cin), "cells_out=%d" % len(cout),
            "unchanged=%d" % unchanged, "changed=%d" % changed,
            "added=%d" % added, "removed=%d" % removed,
            "refs_as_edited=%s" % yn(refs_as_edited), "x_value=%s" % yn(x_value),
        ]))
    
    
    main()
    CMP_PY
    sed 's/^/    /' "$W/cmp.py"
    # cmp_line <input> <output> [--plant]: the comparison's one line.
    cmp_line() { python3 "$W/cmp.py" "$@" 2>&1 | tail -1; }
    
    echo
    echo "## the column guard's own controls"
    printf 'id\tname\tstatus\tflags\n' >"$W/head.tsv"
    : >"$W/empty.tsv"
    printf 'id\tname\n' >"$W/short.tsv"
    COLUMNS_USED='id name status flags'
    note "columns_resolve accepts a header holding every column it indexes" \
      "$(is columns_resolve "$W/head.tsv" "$COLUMNS_USED")"
    note "columns_resolve refuses a header missing some of them" \
      "$(isnot columns_resolve "$W/short.tsv" "$COLUMNS_USED")"
    note "columns_resolve refuses an empty file" "$(isnot columns_resolve "$W/empty.tsv" "$COLUMNS_USED")"
    
    
    echo
    echo "## the comparison's own controls, on generated pairs"
    # A fictional workbook built here, with a chain: A1 (s, a number), B1 (s, a
    # normal formula), C1 (a shared formula's master, not a candidate), and the
    # output --edit-formula-sample must produce from it, written by hand: B1 the
    # number 1 keeping its s, no formula, and the chain's relationship gone. Then
    # one planted fault per flag of the line, each of which the comparison must
    # report; a pair whose FIRST worksheet has no normal formula and whose second
    # has one, so the pick reads on in <sheets> order; and a pair with no normal
    # formula at all.
    python3 - "$W" <<'GEN_PY'
    import sys, zipfile
    d = sys.argv[1]
    NS = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    R = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    P = "http://schemas.openxmlformats.org/package/2006/relationships"
    def pkg(path, sheets, chain):
        with zipfile.ZipFile(path, "w") as z:
            z.writestr("_rels/.rels", '<Relationships xmlns="%s"><Relationship Id="rId1" '
                       'Type="%s/officeDocument" Target="xl/workbook.xml"/></Relationships>' % (P, R))
            z.writestr("xl/workbook.xml", '<workbook xmlns="%s" xmlns:r="%s"><sheets>%s</sheets>'
                       '</workbook>' % (NS, R, "".join(
                           '<sheet name="S%d" sheetId="%d" r:id="rId%d"/>' % (i, i, i)
                           for i in range(1, len(sheets) + 1))))
            rels = "".join('<Relationship Id="rId%d" Type="%s/worksheet" '
                           'Target="worksheets/sheet%d.xml"/>' % (i, R, i)
                           for i in range(1, len(sheets) + 1))
            if chain:
                rels += '<Relationship Id="rId99" Type="%s/calcChain" Target="calcChain.xml"/>' % R
            z.writestr("xl/_rels/workbook.xml.rels", '<Relationships xmlns="%s">%s'
                       '</Relationships>' % (P, rels))
            for i, s in enumerate(sheets, 1):
                z.writestr("xl/worksheets/sheet%d.xml" % i, s)
            if chain:
                z.writestr("xl/calcChain.xml", '<calcChain xmlns="%s"><c r="B1" i="1"/></calcChain>' % NS)
    def sheet(rows, dim="A1:C1", tail="<pageMargins/>"):
        return ('<worksheet xmlns="%s"><dimension ref="%s"/><sheetData>%s</sheetData>%s'
                '</worksheet>' % (NS, dim, rows, tail))
    IN = ('<row r="1"><c r="A1" s="1"><v>1</v></c><c r="B1" s="2"><f>A1*2</f><v>2</v></c>'
          '<c r="C1"><f t="shared" ref="C1:C2" si="0">A1</f><v>1</v></c></row>')
    OUT = ('<row r="1"><c r="A1" s="1"><v>1</v></c><c r="B1" s="2"><v>1</v></c>'
           '<c r="C1"><f t="shared" ref="C1:C2" si="0">A1</f><v>1</v></c></row>')
    PLAIN = '<row r="1"><c r="A1"><v>1</v></c></row>'
    pkg(d + "/c-in.xlsx", [sheet(IN)], True)
    pkg(d + "/c-out.xlsx", [sheet(OUT)], False)
    pkg(d + "/c-prefix.xlsx", [sheet(OUT, dim="A1:B2")], False)
    pkg(d + "/c-suffix.xlsx", [sheet(OUT, tail='<pageMargins left="1"/>')], False)
    pkg(d + "/c-rows.xlsx", [sheet(OUT + '<row r="7"/>')], False)
    pkg(d + "/c-refs.xlsx", [sheet(OUT.replace('<v>1</v></c><c r="B1"', '<v>9</v></c><c r="B1"'))], False)
    pkg(d + "/c-xvalue.xlsx", [sheet(OUT.replace('s="2"><v>1</v>', 's="2"><v>2</v>'))], False)
    pkg(d + "/c-chain.xlsx", [sheet(OUT)], True)
    pkg(d + "/c-in2.xlsx", [sheet(PLAIN), sheet(IN)], False)
    pkg(d + "/c-out2.xlsx", [sheet(PLAIN), sheet(OUT)], False)
    pkg(d + "/c-none.xlsx", [sheet(PLAIN)], True)
    GEN_PY
    c_sound=$(cmp_line "$W/c-in.xlsx" "$W/c-out.xlsx")
    c_sound_want='found=1 chain_in=1 chain_out=0 prefix_same=yes suffix_same=yes rows_in=1 rows_out=1 rows_same=yes cells_in=3 cells_out=3 unchanged=2 changed=1 added=0 removed=0 refs_as_edited=yes x_value=yes'
    echo "  the sound pair:  $c_sound"
    echo "  expected:        $c_sound_want"
    note "the comparison reports the sound pair exactly" "$(is [ "$c_sound" = "$c_sound_want" ])"
    c_second=$(cmp_line "$W/c-in2.xlsx" "$W/c-out2.xlsx")
    c_second_want='found=1 chain_in=0 chain_out=0 prefix_same=yes suffix_same=yes rows_in=1 rows_out=1 rows_same=yes cells_in=3 cells_out=3 unchanged=2 changed=1 added=0 removed=0 refs_as_edited=yes x_value=yes'
    echo "  second sheet:    $c_second"
    echo "  expected:        $c_second_want"
    note "the comparison reads on to the second worksheet when the first has no normal formula" \
      "$(is [ "$c_second" = "$c_second_want" ])"
    c_none=$(cmp_line "$W/c-none.xlsx" "$W/c-none.xlsx")
    echo "  no formula:      $c_none"
    note "the comparison reports found=0 for a workbook with no normal formula" \
      "$(is [ "$(kv "$c_none" found)" = 0 ])"
    # One planted fault per flag: prefix_same, suffix_same, rows_same,
    # refs_as_edited, x_value; and the chain kept, which the line reports as
    # chain_out=1. Each must read as its own flag and leave the named other alone.
    for planted in prefix:prefix_same=no:refs_as_edited=yes suffix:suffix_same=no:refs_as_edited=yes \
                   rows:rows_same=no:refs_as_edited=yes refs:refs_as_edited=no:x_value=yes \
                   xvalue:x_value=no:refs_as_edited=yes chain:chain_out=1:x_value=yes; do
      name=${planted%%:*}
      rest=${planted#*:}
      want1=${rest%%:*}
      want2=${rest#*:}
      line=$(cmp_line "$W/c-in.xlsx" "$W/c-$name.xlsx")
      echo "  planted $name: $line"
      holds_both() {
        printf '%s\n' "$line" | tr ' ' '\n' | LC_ALL=C "$G" -qx -e "$want1" || return 1
        printf '%s\n' "$line" | tr ' ' '\n' | LC_ALL=C "$G" -qx -e "$want2"
      }
      note "the comparison reports the planted $name fault ($want1, $want2)" "$(is holds_both)"
    done
    
    # The acceptance for one workbook, one function, every clause.
    #   $1 the tool's edit line, $2 the comparison's line.
    accept_one() {
      local e=$1 c=$2 fr cd after rb k
      fr=$(kv "$e" formula_replaced); cd=$(kv "$e" chain_dropped)
      after=$(kv "$e" cells_after); rb=$(kv "$e" read_back)
      case "$e" in edit$'\t'*) ;; *) return 1 ;; esac
      for v in "$fr" "$cd" "$after" "$rb"; do
        case "$v" in '' | *[!0-9]*) return 1 ;; esac
      done
      for k in prefix_same suffix_same rows_same refs_as_edited x_value; do
        case "$(kv "$c" "$k")" in yes | no) ;; *) return 1 ;; esac
      done
      for k in found chain_in chain_out rows_in rows_out cells_in cells_out unchanged changed added removed; do
        case "$(kv "$c" "$k")" in '' | *[!0-9]*) return 1 ;; esac
      done
      [ "$fr" = "$(kv "$c" found)" ] || return 1
      [ "$rb" = "$fr" ] || return 1
      if [ "$fr" = 0 ]; then
        [ "$cd" = 0 ] || return 1
        [ "$after" = 0 ] || return 1
        [ "$(kv "$c" chain_out)" = "$(kv "$c" chain_in)" ] || return 1
        return 0
      fi
      [ "$fr" = 1 ] || return 1
      [ "$cd" = "$(kv "$c" chain_in)" ] || return 1
      [ "$(kv "$c" chain_out)" = 0 ] || return 1
      [ "$(kv "$c" prefix_same)" = yes ] || return 1
      [ "$(kv "$c" suffix_same)" = yes ] || return 1
      [ "$(kv "$c" rows_same)" = yes ] || return 1
      [ "$(kv "$c" changed)" = 1 ] || return 1
      [ "$(kv "$c" added)" = 0 ] || return 1
      [ "$(kv "$c" removed)" = 0 ] || return 1
      [ "$(kv "$c" unchanged)" = "$(($(kv "$c" cells_in) - 1))" ] || return 1
      [ "$(kv "$c" cells_out)" = "$(kv "$c" cells_in)" ] || return 1
      [ "$after" = "$(kv "$c" cells_out)" ] || return 1
      [ "$(kv "$c" refs_as_edited)" = yes ] || return 1
      [ "$(kv "$c" x_value)" = yes ] || return 1
    }
    ctl_edit=$(printf 'edit\tformula_replaced=1\tchain_dropped=1\tcells_after=3\tread_back=1')
    note "control: accept_one accepts the sound pair with its edit line" \
      "$(is accept_one "$ctl_edit" "$c_sound")"
    note "control: accept_one refuses the same pair with a line claiming chain_dropped 0" \
      "$(isnot accept_one "${ctl_edit/chain_dropped=1/chain_dropped=0}" "$c_sound")"
    note "control: accept_one refuses a line whose read_back is 0" \
      "$(isnot accept_one "${ctl_edit/read_back=1/read_back=0}" "$c_sound")"
    note "control: accept_one refuses a line whose cells_after is off by one" \
      "$(isnot accept_one "${ctl_edit/cells_after=3/cells_after=4}" "$c_sound")"
    for name in prefix suffix rows refs xvalue chain; do
      note "control: accept_one refuses the planted $name fault" \
        "$(isnot accept_one "$ctl_edit" "$(cmp_line "$W/c-in.xlsx" "$W/c-$name.xlsx")")"
    done
    ctl_none=$(printf 'edit\tformula_replaced=0\tchain_dropped=0\tcells_after=0\tread_back=0')
    note "control: accept_one accepts the all-zero line on the pair with no normal formula" \
      "$(is accept_one "$ctl_none" "$c_none")"
    note "control: accept_one refuses the all-zero line on a pair that has one" \
      "$(isnot accept_one "$ctl_none" "$c_sound")"
    
    # entries_ok <entries file> <id> <found> <chain_in> <sheet> <rels> <chain part>:
    # the runner's entry rows for one workbook are what the edit requires. With a
    # formula replaced: the sheet changed; with a chain, the chain's entry
    # dropped and the workbook's rels part and [Content_Types].xml changed; every
    # changed row's flags empty or descriptor alone; every other row identical
    # and unflagged; nothing added or recompressed. With none: every row
    # identical and unflagged. Names are compared, never printed.
    entries_ok() {
      awk -F'\t' -v id="$2" -v found="$3" -v chain="$4" -v sheet="$5" -v rels="$6" -v cpart="$7" '
        NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next }
        $k["id"] != id { next }
        {
          n++
          want = "identical"
          if (found == 1 && $k["name"] == sheet) want = "changed"
          if (found == 1 && chain == 1 && ($k["name"] == rels || $k["name"] == "[Content_Types].xml")) want = "changed"
          if (found == 1 && chain == 1 && $k["name"] == cpart) want = "dropped"
          if ($k["status"] != want) bad++
          if (want == "changed" && $k["flags"] != "" && $k["flags"] != "descriptor") bad++
          if (want != "changed" && $k["flags"] != "") bad++
          if (want == "changed") nch++
          if (want == "dropped") ndr++
        }
        END {
          if (n == 0 || bad > 0) exit 1
          if (found == 1 && nch != (chain == 1 ? 3 : 1)) exit 1
          if (found == 1 && chain == 1 && ndr != 1) exit 1
        }' "$1"
    }
    printf 'id\tname\tstatus\tflags\nw\ts.xml\tchanged\t\nw\tr.rels\tchanged\tdescriptor\nw\t[Content_Types].xml\tchanged\t\nw\tc.xml\tdropped\t\nw\to.xml\tidentical\t\n' >"$W/e-ctl.tsv"
    note "control: entries_ok accepts rows as a chained edit requires" \
      "$(is entries_ok "$W/e-ctl.tsv" w 1 1 s.xml r.rels c.xml)"
    note "control: entries_ok refuses the same rows read as an unchained edit" \
      "$(isnot entries_ok "$W/e-ctl.tsv" w 1 0 s.xml r.rels c.xml)"
    sed 's/o.xml\tidentical\t$/o.xml\tidentical\tdescriptor/' "$W/e-ctl.tsv" >"$W/e-flag.tsv"
    note "control: entries_ok refuses an identical row that carries a flag" \
      "$(isnot entries_ok "$W/e-flag.tsv" w 1 1 s.xml r.rels c.xml)"
    note "control: entries_ok refuses an id with no rows" \
      "$(isnot entries_ok "$W/e-ctl.tsv" nosuchid 1 1 s.xml r.rels c.xml)"
    
    echo
    echo "## settings"
    echo "  --timeout 300 (the copy child only); --lo-timeout 600 (per conversion,"
    echo "  input and copy each); image $LO_IMAGE; --tool-arg $EDIT"
    echo "  out directory: <corpus>/runs/$RUN"
    echo "  record stem: $STEM"
    # The release binaries size.log built and hashed (specs/0011 "P3"), each
    # compared with the hash that log printed, read out of it by command.
    SIZE_LOG=records/logs/m1p4-p3/size.log
    echo "command: read the four release hashes from $SIZE_LOG (sha256 $(sha256sum <"$SIZE_LOG" | cut -d' ' -f1))"
    size_hash() { sed -n "s#^  $1: sha256 \([0-9a-f]\{64\}\), bytes [0-9]*\$#\1#p" "$SIZE_LOG"; }
    for b in target/release/emend-copy target/release/xlsx-diff \
             target/i686-unknown-linux-musl/release/emend-copy \
             target/i686-unknown-linux-musl/release/xlsx-diff; do
      if [ -x "$b" ]; then
        now=$(sha256sum <"$b" | cut -d' ' -f1)
        sized=$(size_hash "$b")
        echo "  $b: sha256 $now; size.log printed ${sized:-nothing}"
        note "$b is the binary size.log hashed" "$(is [ "$now" = "$sized" ])"
      else
        echo "  $b: MISSING"; fail=1
      fi
    done
    note "control: the same reader finds no hash for a binary size.log does not name" \
      "$(is [ -z "$(size_hash target/release/no-such-binary)" ])"
    echo "  (nothing is rebuilt here)"
    manifest_rows=$(nrows "$CORPUS/manifest.tsv")
    echo "  corpus manifest rows: $manifest_rows"
    note "the corpus holds its 27 workbooks" "$(is [ "$manifest_rows" = 27 ])"
    
    for label in host i686; do
      if [ "$label" = host ]; then
        PT=target/release/emend-copy
        XD=target/release/xlsx-diff
      else
        PT=target/i686-unknown-linux-musl/release/emend-copy
        XD=target/i686-unknown-linux-musl/release/xlsx-diff
      fi
      echo
      echo "## $label edit run, --tool-arg $EDIT"
      echo "command: scripts/passthrough-run.sh --label $label --passthrough $PT --xlsx-diff $XD --out <corpus>/runs/$RUN --libreoffice $LO_IMAGE --lo-timeout 600 --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" \
        --out "$OUT" --libreoffice "$LO_IMAGE" --lo-timeout 600 --timeout 300 \
        --tool-arg "$EDIT" \
        >"$W/run-$label.stdout" 2>"$W/run-$label.stderr"
      rc=$?
      ended=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      echo "  started $started; ended $ended; exit $rc; stderr bytes: $(wc -c <"$W/run-$label.stderr")"
      hide <"$W/run-$label.stdout" | sed 's/^/    /'
      if [ -s "$W/run-$label.stderr" ]; then hide <"$W/run-$label.stderr" | sed 's/^/    stderr: /'; fi
      note "$label the edit run exits 0" "$(is [ "$rc" -eq 0 ])"
      note "$label the edit run's stderr is empty" "$(is [ "$(wc -c <"$W/run-$label.stderr")" -eq 0 ])"
    
      SUM=$OUT/summary.$label.tsv
      ENT=$OUT/entries.$label.tsv
      if [ ! -f "$SUM" ] || [ ! -f "$ENT" ]; then
        echo "  the edit run wrote no summary or entries file"; fail=1; continue
      fi
      rows=$(nrows "$SUM")
      ok=$(count_where "$SUM" outcome ok)
      lo=$(count_where "$SUM" lo ok)
      lo_in=$(count_where "$SUM" lo_in ok)
      noleft=$(count_where "$SUM" leftover no)
      order=$(count_where "$SUM" order_preserved yes)
      comment=$(count_where "$SUM" comment_equal yes)
      fid_yes=$(count_where "$SUM" files_identical yes)
      echo "  summary rows: $rows; outcome ok: $ok; lo ok: $lo; lo_in ok: $lo_in; leftover no: $noleft"
      echo "  order_preserved yes: $order; comment_equal yes: $comment; files_identical yes: $fid_yes"
      echo "  entry totals from the summary: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      note "$label every manifest workbook produced a summary row" "$(is [ "$rows" = "$manifest_rows" ])"
      note "$label every outcome is ok" "$(is [ "$ok" = "$rows" ])"
      note "$label lo is ok on every file" "$(is [ "$lo" = "$rows" ])"
      note "$label lo_in is ok on every file" "$(is [ "$lo_in" = "$rows" ])"
      note "$label no tool left a temporary behind" "$(is [ "$noleft" = "$rows" ])"
      note "$label order is preserved in every file" "$(is [ "$order" = "$rows" ])"
      note "$label the archive comment is unchanged in every file" "$(is [ "$comment" = "$rows" ])"
      note "$label nothing added or recompressed" \
        "$(is [ "$(sum_col "$SUM" added)$(sum_col "$SUM" recompressed)" = 00 ])"
    
      echo "  the entries header, as the runner wrote it:"
      echo "    $(head -1 "$ENT")"
      note "$label every column the entry forms index is in that header" \
        "$(is columns_resolve "$ENT" "$COLUMNS_USED")"
    
      echo "  per workbook: id, the tool's edit line, the comparison's line (counts only)"
      : >"$W/edit-$label"
      nwb=0; naccepted=0; nentries_ok=0; nfid_ok=0
      n_replaced=0; n_chain_in=0; n_chain_dropped=0; n_none=0
      tot_changed=0; tot_rows_in=0; tot_rows_out=0
      while IFS=$'\t' read -r id ext; do
        nwb=$((nwb + 1))
        in_file=$CORPUS/corpus/$id.$ext
        out_file=$OUT/$id/out.$label.$ext
        e=$(cat "$OUT/$id/stdout.$label.txt" 2>/dev/null)
        printf '%s\t%s\n' "$id" "$e" >>"$W/edit-$label"
        c=$(cmp_line "$in_file" "$out_file")
        printf '    %s %s\n' "$id" "$(printf '%s' "$e" | tr '\t' ' ')"
        printf '    %s %s\n' "$id" "$c"
        if accept_one "$e" "$c"; then naccepted=$((naccepted + 1)); else echo "    $id: NOT ACCEPTED"; fi
        python3 "$W/cmp.py" "$in_file" --parts >"$W/parts" 2>/dev/null
        p_sheet=$(sed -n 1p "$W/parts"); p_rels=$(sed -n 2p "$W/parts"); p_chain=$(sed -n 3p "$W/parts")
        found=$(kvn "$c" found); chain_in=$(kvn "$c" chain_in)
        if entries_ok "$ENT" "$id" "$found" "$chain_in" "$p_sheet" "$p_rels" "$p_chain"; then
          nentries_ok=$((nentries_ok + 1))
        else
          echo "    $id: the entry rows are not what the edit requires"
        fi
        fid=$(awk -F'\t' -v id="$id" '
          NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next }
          $k["id"] == id { print $k["files_identical"] }' "$SUM")
        fid_as_edit() {
          if [ "$found" = 1 ]; then [ "$fid" = no ]; else [ "$fid" = yes ]; fi
        }
        if fid_as_edit; then nfid_ok=$((nfid_ok + 1)); else echo "    $id: files_identical $fid with found $found"; fi
        n_replaced=$((n_replaced + $(kvn "$e" formula_replaced)))
        n_chain_dropped=$((n_chain_dropped + $(kvn "$e" chain_dropped)))
        n_chain_in=$((n_chain_in + chain_in))
        if [ "$found" = 0 ]; then n_none=$((n_none + 1)); fi
        tot_changed=$((tot_changed + $(kvn "$c" changed)))
        tot_rows_in=$((tot_rows_in + $(kvn "$c" rows_in)))
        tot_rows_out=$((tot_rows_out + $(kvn "$c" rows_out)))
      done < <(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv")
      echo "  workbooks: $nwb; accepted on every clause: $naccepted; entry rows as the edit requires: $nentries_ok; files_identical as the edit requires: $nfid_ok"
      echo "  $label: workbooks with a formula replaced: $n_replaced; with no normal formula: $n_none"
      echo "  $label: workbooks with a chain: $n_chain_in; chains dropped: $n_chain_dropped"
      echo "  $label: cells changed in all: $tot_changed; <row> elements in the edited sheets, input $tot_rows_in, output $tot_rows_out"
      note "$label every workbook meets every clause of the tool line and the comparison" "$(is [ "$naccepted" = 27 ])"
      note "$label in every workbook the entry rows are what the edit requires" "$(is [ "$nentries_ok" = 27 ])"
      note "$label files_identical is yes exactly where no formula was replaced" "$(is [ "$nfid_ok" = 27 ])"
      note "$label the workbooks with a formula replaced and those with none are the 27" \
        "$(is [ "$((n_replaced + n_none))" = 27 ])"
      note "$label one cell changed per replaced formula" "$(is [ "$tot_changed" = "$n_replaced" ])"
      note "$label the edited sheets hold as many <row> elements after as before" "$(is [ "$tot_rows_in" = "$tot_rows_out" ])"
      summary_changed_as_edits() {
        [ "$(sum_col "$SUM" changed)" = "$((n_replaced + 2 * n_chain_dropped))" ] || return 1
        [ "$(sum_col "$SUM" dropped)" = "$n_chain_dropped" ]
      }
      note "$label the summary's changed and dropped totals are the edits' (one sheet per formula, two parts and one drop per chain)" \
        "$(is summary_changed_as_edits)"
    
      # The planted difference on a REAL pair: the first workbook with a formula
      # replaced, its output with one cell added to the edited part, in memory,
      # before the comparison. The counts must move and accept_one must refuse it.
      # The key is matched anywhere on the line: the file's second field is the
      # word edit, and the first attempt of this log looked for the key there, so
      # it found no workbook and the control never ran (header of the rerun).
      first_id=$(awk -F'\t' 'index($0, "\tformula_replaced=1\t") { print $1; exit }' "$W/edit-$label")
      first_ext=$(awk -F'\t' -v id="$first_id" 'NR > 1 && $1 == id { print $4 }' "$CORPUS/manifest.tsv")
      if [ -n "$first_id" ]; then
        e1=$(awk -F'\t' -v id="$first_id" '$1 == id { sub(/^[^\t]*\t/, ""); print }' "$W/edit-$label")
        c_real=$(cmp_line "$CORPUS/corpus/$first_id.$first_ext" "$OUT/$first_id/out.$label.$first_ext")
        c_plant=$(cmp_line "$CORPUS/corpus/$first_id.$first_ext" "$OUT/$first_id/out.$label.$first_ext" --plant)
        echo "  control on $first_id, as run:          $c_real"
        echo "  control on $first_id, one cell planted: $c_plant"
        note "$label control: the planted cell is counted as an added cell" "$(is [ "$(kv "$c_plant" added)" = 1 ])"
        note "$label control: accept_one refuses the planted pair" "$(isnot accept_one "$e1" "$c_plant")"
      else
        echo "  no workbook had a formula replaced, so there is no real pair to plant in"; fail=1
      fi
    done
    echo
    echo "## the two labels agree"
    for label in host i686; do
      awk -F'\t' '
        NR == 1 { for (i = 1; i <= NF; i++) idx[$i] = i; next }
        { print $idx["id"] "\t" $idx["name"] "\t" $idx["status"] "\t" $idx["flags"] }' \
        "$OUT/entries.$label.tsv" | sort >"$W/classes-$label"
      sort "$W/edit-$label" >"$W/edit-sorted-$label"
    done
    note "both targets classified every entry the same way" "$(is cmp -s "$W/classes-host" "$W/classes-i686")"
    note "both targets printed the same edit line for every workbook" \
      "$(is cmp -s "$W/edit-sorted-host" "$W/edit-sorted-i686")"
    same_out=0; diff_out=0
    while IFS=$'\t' read -r id ext; do
      h=$(sha256sum <"$OUT/$id/out.host.$ext" | cut -d' ' -f1)
      i=$(sha256sum <"$OUT/$id/out.i686.$ext" | cut -d' ' -f1)
      if [ "$h" = "$i" ]; then same_out=$((same_out + 1)); else diff_out=$((diff_out + 1)); echo "    $id: the two targets' outputs differ"; fi
    done < <(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv")
    echo "  outputs byte-identical across the two targets: $same_out; different: $diff_out"
    note "every workbook's host and i686 outputs are byte-identical" "$(is [ "$same_out" = "$manifest_rows" ])"
    ida=$(awk -F'\t' 'NR == 2 { print $1 "." $4 }' "$CORPUS/manifest.tsv")
    idb=$(awk -F'\t' 'NR == 3 { print $1 "." $4 }' "$CORPUS/manifest.tsv")
    ca=$(sha256sum <"$OUT/${ida%%.*}/out.host.${ida#*.}" | cut -d' ' -f1)
    cb=$(sha256sum <"$OUT/${idb%%.*}/out.i686.${idb#*.}" | cut -d' ' -f1)
    note "control: the same comparison between two different workbooks' outputs says they differ" \
      "$(isnot [ "$ca" = "$cb" ])"
    
    echo
    echo "## the run rows both labels appended"
    for label in host i686; do
      R=$OUT/run.$label.tsv
      if [ -f "$R" ]; then
        echo "  run.$label.tsv header: $(head -1 "$R")"
        echo "  run.$label.tsv row: $(sed -n 2p "$R" | hide)"
        args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next }
                           k && NR == 2 { print $k }' "$R")
        echo "  run.$label.tsv tool_args: [$args]"
        note "$label the run row records the operation" "$(is [ "$args" = "$EDIT" ])"
      else
        echo "  run.$label.tsv: MISSING"; fail=1
      fi
    done
    
    echo
    echo "## the record pair"
    echo "command: scripts/passthrough-record.py --run <corpus>/runs/$RUN --stem $STEM"
    scripts/passthrough-record.py --run "$OUT" --stem "$STEM" >"$W/record.out" 2>&1
    rrc=$?
    hide <"$W/record.out" | sed 's/^/    /'
    note "the record script exits 0" "$(is [ "$rrc" -eq 0 ])"
    for ext in md txt; do
      f=records/$STEM.$ext
      if [ -f "$f" ]; then
        echo "  $f: $(wc -c <"$f") bytes, sha256 $(sha256sum <"$f" | cut -d' ' -f1)"
      else
        echo "  $f: MISSING"; fail=1
      fi
    done
    both_halves() {
      [ -f "records/$STEM.md" ] || return 1
      [ -f "records/$STEM.txt" ] || return 1
    }
    note "both halves of the record pair were written" "$(is both_halves)"
    nargs=$(count_matches -F "$EDIT" "records/$STEM.md")
    echo "  lines of the record naming the operation: $nargs"
    note "the record names the operation it was run with" "$(is [ "$nargs" -ge 1 ])"
    
    echo
    echo "## the record pair holds no corpus path and no absolute path"
    for ext in md txt; do
      f=records/$STEM.$ext
      [ -f "$f" ] || continue
      n=$(count_matches -E '(/home/|/mnt/|/Users/|emend-testing)' "$f")
      echo "  $f: lines naming a home, mount or corpus path: $n"
      note "$f carries no such path" "$(is [ "$n" = 0 ])"
    done
    # The planted path is assembled at run time (P2 verification ruling 4), so
    # this script's own text carries no home-shaped path.
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x.xlsx' >"$W/path-control"
    nctl=$(count_matches -E '(/home/|/mnt/|/Users/|emend-testing)' "$W/path-control")
    note "control: the path form finds a planted path ($nctl)" "$(is [ "$nctl" = 1 ])"
    
    
    echo
    echo "## status after the runs"
    st_all=$(run_lines git status --porcelain)
    st_log=$(run_matches -E '^(\?\?| ?[MARCD]) (records/logs/m1p4-p3|records/'"$STEM"'|records/size-m1p4-)' git status --porcelain)
    st_planning=$(run_matches -E '^ M specs/0011-editing-cells[.]md$' git status --porcelain)
    echo "status lines: $st_all; of them under the phase log directory, the record pair or the size record: $st_log; planning's uncommitted file: $st_planning"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_log" != error ] && [ "$st_planning" = 1 ] &&
        [ "$st_all" = "$((st_log + st_planning))" ]
    }
    note "every change in the working tree is a log, a record or planning's one file" "$(is status_accounted)"
    for pf in $PLANNING_FILES; do
      echo "  $pf at the end of the run: sha256 $(sha256sum <"$pf" | cut -d' ' -f1)"
    done
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
