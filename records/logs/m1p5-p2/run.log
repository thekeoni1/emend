the generator this section runs:
    """Three fictional packages for the comparison's controls.
    
    Usage: make.py <directory>
    
      sample.xlsx   a sheet with a styled number, a shared string and a formula,
                    and a styles part with one numFmt and three xfs;
      empty.xlsx    the same styles part and a sheet with no cells at all, so the
                    sample has no A and styles the new cell alone;
      nofmts.xlsx   a styles part with NO numFmts of its own, so the edit creates
                    the container (P1 verification ruling 5).
    """
    import os
    import sys
    import zipfile
    
    MAIN = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    TYPES = "http://schemas.openxmlformats.org/package/2006/content-types"
    DECL = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    
    WITH_FMTS = ('<styleSheet xmlns="%s"><numFmts count="1">'
                 '<numFmt numFmtId="164" formatCode="0.00"/></numFmts>'
                 '<fonts count="1"><font><name val="Fictional"/></font></fonts>'
                 '<cellXfs count="3"><xf numFmtId="0"/>'
                 '<xf numFmtId="164" fontId="0"/><xf/></cellXfs></styleSheet>' % MAIN)
    NO_FMTS = ('<styleSheet xmlns="%s">'
               '<fonts count="1"><font><name val="Fictional"/></font></fonts>'
               '<cellXfs count="2"><xf numFmtId="0"/>'
               '<xf numFmtId="9" fontId="0"/></cellXfs></styleSheet>' % MAIN)
    CELLS = ('<sheetData><row r="1"><c r="A1" s="1"><v>1.5</v></c>'
             '<c r="B1" t="s"><v>1</v></c></row>'
             '<row r="2"><c r="A2"><f>A1*2</f><v>3</v></c>'
             '<c r="C2" s="2"><v>7</v></c></row></sheetData>')
    
    
    def build(path, sheet_data, styles):
        parts = {
            "[Content_Types].xml": DECL + (
                '<Types xmlns="%s"><Default Extension="rels" ContentType="application/rels"/>'
                '<Default Extension="xml" ContentType="application/xml"/>'
                '<Override PartName="/xl/workbook.xml" ContentType="application/workbook"/>'
                '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/sheet"/>'
                '<Override PartName="/xl/styles.xml" ContentType="application/styles"/>'
                "</Types>" % TYPES),
            "_rels/.rels": (
                '<Relationships xmlns="%s"><Relationship Id="rId1" Type="%s/officeDocument" '
                'Target="xl/workbook.xml"/></Relationships>' % (RELS, ATTR)),
            "xl/workbook.xml": DECL + (
                '<workbook xmlns="%s" xmlns:r="%s"><sheets>'
                '<sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets></workbook>' % (MAIN, ATTR)),
            "xl/_rels/workbook.xml.rels": (
                '<Relationships xmlns="%s">'
                '<Relationship Id="rId1" Type="%s/worksheet" Target="worksheets/sheet1.xml"/>'
                '<Relationship Id="rId2" Type="%s/styles" Target="styles.xml"/>'
                "</Relationships>" % (RELS, ATTR, ATTR)),
            "xl/worksheets/sheet1.xml": DECL + (
                '<worksheet xmlns="%s"><dimension ref="A1"/>%s'
                '<pageMargins left="0.7"/></worksheet>' % (MAIN, sheet_data)),
            "xl/styles.xml": DECL + styles,
        }
        with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
            for name, text in parts.items():
                z.writestr(name, text)
    
    
    d = sys.argv[1]
    build(os.path.join(d, "sample.xlsx"), CELLS, WITH_FMTS)
    build(os.path.join(d, "empty.xlsx"), "<sheetData/>", WITH_FMTS)
    build(os.path.join(d, "nofmts.xlsx"),
          '<sheetData><row r="1"><c r="A1" s="1"><v>2.5</v></c></row></sheetData>', NO_FMTS)
