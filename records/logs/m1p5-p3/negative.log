## script
    #!/usr/bin/env bash
    # Milestone 1 part 5 P3 negative.log (specs/0012-styles.md, "P3", and
    # "Planning rulings during P3" ruling 6; the negative log specs/0001 asks
    # each phase for): --date-sample, P3's operation, through the BUILT binary on
    # generated packages; the two fixtures P3 names, a styles part without
    # cellXfs and one whose xf has a non-numeric numFmtId, each through
    # --style-sample and through the release probe-emend-styles-write-xml
    # size.log built; the styles messages no binary reaches named from the
    # source beside the test that raises each; and the earlier parts' refusals
    # again, unchanged.
    #
    # The families:
    #  N1 to N62, the operation parsing, as in P2's log; N63 to N69 add
    #  --date-sample: in pairs with another operation, twice, before the paths
    #  and given an argument, beside N69, its accepted form.
    #  A1 and A2, P3's positive controls for --date-sample: the six-cell styled
    #  package in the 1900 system (A1) and the same in the 1904 system (A2), each
    #  printing the line its own fixture calls for, key by key.
    #  A3 and A4: the two refusals the date sample shares with the style sample,
    #  a workbook with no styles part and a styles part the reader refuses.
    #  W1 to W6 (ruling 6): the no-cellXfs fixture through --style-sample, whose
    #  A carries no s so both additions take no base, reaching "a styles part
    #  without cellXfs cannot take a style" at the write (W1), and through the
    #  release probe, whose first addition takes base 0, reaching "a style index
    #  is out of range" from add_cell_style before its second output exists
    #  (W2); the non-numeric numFmtId fixture through both routes, each reaching
    #  "a style attribute is not a number" (W3, W4); the probe's positive control
    #  on the sound styles package (W5); and the probe given an empty code, which
    #  reaches "a number format code is empty or holds a character XML cannot
    #  carry" (W6). The source line that raises each message is printed by
    #  command. The probe is a size consumer, not a tool, and keeps its outputs
    #  on a refusal (specs/0011 P3 ruling 8): its first output is written whole
    #  before its edits, so for the probe the exit, the exact message and an
    #  empty stdout are asserted and both outputs are printed as measured.
    #  V: of the five messages the additions and the write raise, those this log
    #  reaches and those it cannot, each unreached one named from the source
    #  beside the package test that raises it.
    #  Z1 to Z5: P2's --style-sample family; Z5 now counts four mentions of the
    #  assertion's error, the date sample raising it too.
    #  Y1 to Y8: P1's --styles family, unchanged; Y8's title no longer says the
    #  five messages are reached by no binary, which the W family disproves.
    #  S0 to S14, T1 to T4, U1 to U18, D1 to D5, E1 to E10, F1 to F3, X1 and X2,
    #  R1 and R2, G1 and G2: the earlier parts' cases, unchanged.
    #  C, the catalogue: every message the four modules raise is raised by a case
    #  here or named in a module test file.
    #
    # Every case runs in a scratch clone under <scratch>, never in the main working
    # tree. The debug binaries the gate built are copied in and each sha256 is
    # compared with the one gate.log printed, read out of gate.log by command; the
    # probe is copied from the size build and its sha256 compared with the one
    # size.log printed, the same way. Nothing is rebuilt here. Every fixture is
    # GENERATED: no corpus file is copied or read.
    #
    # WRITTEN FOR M1 part 5 P3 from P2's negative script
    # (records/logs/m1p5-p2/negative.log), its header rewritten for this phase;
    # the comments inside the families earlier phases ran are carried with them
    # and describe those families. What differs from P2's:
    #  1. The phase and the log directory are P3's; the log prints its invocation
    #     (P2 verification ruling 4).
    #  2. The message list is compared BY NAME with P2's committed negative.log:
    #     none may be removed, and P3 adds none, since the dates module raises no
    #     Error and the tool's new operation reuses the tool's messages.
    #  3. The release probe is copied in and compared with size.log's hash, as
    #     part 4 P3's log did (records/logs/m1p4-p3/negative.log).
    #  4. The fixture builder gains pkg-styles-cells-1904, pkg-styles-noxfs (the
    #     sound styles part with its cellXfs removed, and a sheet whose one cell
    #     is an unstyled number) and nothing else; every other fixture is built
    #     exactly as before.
    #  5. The N family grows by N63 to N69; the A, W and V families are new.
    #  6. The main-tree status check accounts for this phase's logs, its record
    #     pair, its size record, and planning's files modified and uncommitted,
    #     each printed by name with its sha256, should one stand (P2 verification
    #     ruling 8).
    #  7. None of the three shapes specs/0001 forbids appears here; the shapes
    #     are described rather than written out.
    #
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    B=$(mktemp -d)
    trap 'rm -rf "$B"' EXIT INT TERM HUP
    fail=0
    note() { echo "  $1: $2"; [ "$2" = as-expected ] || fail=1; }
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    # Negation goes through a helper, never through `is ! cmd ...`: `!` is a shell
    # keyword, so passing it as the first argument runs a command of that name,
    # which fails with 127 and prints UNEXPECTED whatever the condition did
    # (specs/0001, from this milestone's P1 departure 10).
    isnot() { if "$@"; then echo UNEXPECTED; else echo as-expected; fi; }
    # Rewrites the scratch base out of any captured text, so no absolute path is
    # printed even when a tool echoes one.
    hide() { sed "s#$B#<scratch>#g; s#$MAIN#<repo>#g"; }
    
    # specs/0001 "Rules for every phase": the phase commit is GIVEN to the script
    # and compared with HEAD, with a control, and both are printed. The hard guard
    # is here, before a line of log exists; the printed comparison and its control
    # are in the body below, where a reader sees them.
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { LC_ALL=C printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if ! full_sha "$C"; then echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if ! head_is "$C"; then echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    
    echo "command: git rev-parse HEAD"
    # The invocation as run, the script's directory written as <repo> or <scratch>:
    # an absolute machine path in a log is a defect (T0 P6d ruling).
    inv_path=$0
    case "$inv_path" in
      "$MAIN"/*) inv_path="<repo>/${inv_path#"$MAIN"/}" ;;
      /*) inv_path="<scratch>/$(basename "$inv_path")" ;;
    esac
    echo "invocation: bash $inv_path $*"
    echo "about: M1 part 5 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: Milestone 1 part 5 P3 (specs/0012-styles.md) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      # specs/0001 "Rules for every phase": every sha256 a log cites, a superseded
      # attempt's included, is PRINTED BY A COMMAND run over a file that exists at
      # run time, never typed from memory. The note above names its predecessors;
      # these lines are what make those names evidence. An attempt that was not
      # kept is named as having no hash, and why.
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    echo "SERIALIZED: produced with no other run in flight"
    echo "every fixture is generated; no corpus file is copied or read"
    note "the phase commit given to this script is a full sha" "$(is full_sha "$C")"
    note "the phase commit given to this script is HEAD" "$(is head_is "$C")"
    # The control for the comparison, in the same command form: the same function
    # against a commit that is not HEAD must say no, so the yes above cannot be a
    # comparison that says yes to anything.
    note "control: the same comparison against the null commit says no" "$(isnot head_is "$NULL_SHA")"
    note "control: the same comparison against a short sha of the real commit says no" \
      "$(isnot head_is "$(printf '%s' "$C" | cut -c1-7)")"
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scratch clone and the gate's binaries"
    echo "command: git clone --quiet --shared <repo> <scratch>/clone"
    git clone --quiet --shared "$MAIN" "$B/clone" 2>&1 | hide | sed 's/^/    /'
    CLONE=$B/clone
    clone_head=$(git -C "$CLONE" rev-parse HEAD)
    echo "  clone HEAD: $clone_head"
    note "the clone is at the phase commit" "$(is [ "$clone_head" = "$C" ])"
    mkdir -p "$CLONE/target/debug" "$CLONE/target/i686-unknown-linux-musl/debug"
    bins_ok=yes
    for b in target/debug/emend-copy target/debug/xlsx-diff \
             target/i686-unknown-linux-musl/debug/emend-copy \
             target/i686-unknown-linux-musl/debug/xlsx-diff; do
      if cp "$MAIN/$b" "$CLONE/$b" 2>/dev/null; then
        echo "  copied $b: sha256 $(sha256sum <"$CLONE/$b" | cut -d' ' -f1), bytes $(wc -c <"$CLONE/$b")"
      else
        echo "  copied $b: FAILED"
        bins_ok=no
      fi
    done
    # One function, four conditions. The part 1 P1 script chained these with the
    # and-operator inside a single `is` substitution, which captures the first test
    # alone (specs/0001, "Rules for every phase"; the header above says why the
    # form is described here and never quoted).
    all_four_executable() {
      [ "$bins_ok" = yes ] || return 1
      for f in "$CLONE/target/debug/emend-copy" "$CLONE/target/debug/xlsx-diff" \
               "$CLONE/target/i686-unknown-linux-musl/debug/emend-copy" \
               "$CLONE/target/i686-unknown-linux-musl/debug/xlsx-diff"; do
        [ -x "$f" ] || return 1
      done
      return 0
    }
    note "all four binaries were copied in and all four are executable" "$(is all_four_executable)"
    EC=$CLONE/target/debug/emend-copy
    XD=$CLONE/target/debug/xlsx-diff
    # Each hash compared with the one gate.log printed, read out of it by command.
    GATE_LOG=$MAIN/records/logs/m1p5-p3/gate.log
    echo "command: read the four debug hashes from records/logs/m1p5-p3/gate.log (sha256 $(sha256sum <"$GATE_LOG" | cut -d' ' -f1))"
    gate_hash() { sed -n "s#^  $1: sha256 \([0-9a-f]\{64\}\), bytes [0-9]*\$#\1#p" "$GATE_LOG"; }
    nsame_gate=0
    for b in target/debug/emend-copy target/debug/xlsx-diff \
             target/i686-unknown-linux-musl/debug/emend-copy \
             target/i686-unknown-linux-musl/debug/xlsx-diff; do
      want=$(gate_hash "$b")
      got=$(sha256sum <"$CLONE/$b" | cut -d' ' -f1)
      echo "  $b: gate.log $want; copied $got"
      if [ -n "$want" ] && [ "$want" = "$got" ]; then nsame_gate=$((nsame_gate + 1)); fi
    done
    note "all four copied binaries are the ones gate.log hashed" "$(is [ "$nsame_gate" = 4 ])"
    note "control: the same reader finds no hash for a binary gate.log does not name" \
      "$(is [ -z "$(gate_hash target/debug/no-such-binary)" ])"
    # The release probe (header change 3): the i686 size build size.log measured.
    SIZE_LOG=$MAIN/records/logs/m1p5-p3/size.log
    PROBE_REL=target/i686-unknown-linux-musl/size/probe-emend-styles-write-xml
    mkdir -p "$CLONE/target/i686-unknown-linux-musl/size"
    cp "$MAIN/$PROBE_REL" "$CLONE/$PROBE_REL" 2>/dev/null
    PR=$CLONE/$PROBE_REL
    echo "command: read the probe's hash from records/logs/m1p5-p3/size.log (sha256 $(sha256sum <"$SIZE_LOG" | cut -d' ' -f1))"
    probe_want=$(sed -n "s#^$PROBE_REL: file [0-9]* bytes; sections [0-9]*; \.text [0-9]*; sha256 \([0-9a-f]\{64\}\)\$#\1#p" "$SIZE_LOG")
    probe_got=$(sha256sum <"$PR" 2>/dev/null | cut -d' ' -f1)
    echo "  $PROBE_REL: size.log $probe_want; copied $probe_got, bytes $(wc -c <"$PR" 2>/dev/null)"
    probe_is_sized() { [ -n "$probe_want" ] && [ "$probe_want" = "$probe_got" ] && [ -x "$PR" ]; }
    note "the copied probe is the one size.log built and hashed, and is executable" "$(is probe_is_sized)"
    note "control: the same reader finds no hash for a probe size.log does not name" \
      "$(is [ -z "$(sed -n "s#^target/i686-unknown-linux-musl/size/no-such-probe: file .*sha256 \([0-9a-f]\{64\}\)\$#\1#p" "$SIZE_LOG")" ])"
    echo "  (nothing is rebuilt here)"
    
    echo
    echo "## the generated fixtures"
    cat >"$B/gen.py" <<'GEN_PY'
    import hashlib, os, sys, zipfile
    
    base, corpus = sys.argv[1:3]
    os.makedirs(os.path.join(corpus, "corpus"), mode=0o700, exist_ok=True)
    
    BOM = b"\xef\xbb\xbf"
    CT = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
          '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
          '<Default Extension="xml" ContentType="application/xml"/>'
          '<Default Extension="rels" ContentType="application/rels"/></Types>')
    WB = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
          '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
          '<sheets><sheet name="S" sheetId="1"/></sheets></workbook>')
    RELS = ('<?xml version="1.0" encoding="UTF-8"?>'
            '<Relationships xmlns="http://example.invalid/rels">'
            '<Relationship Id="rId1" Type="http://example.invalid/t" Target="xl/workbook.xml"/>'
            '</Relationships>')
    
    
    def sound(path):
        """A small, valid archive: stored and deflated XML, a marked rels part,
        and one binary entry that the rewrite must not touch."""
        with zipfile.ZipFile(path, "w") as z:
            z.writestr("[Content_Types].xml", CT, zipfile.ZIP_STORED)
            z.writestr("xl/workbook.xml", WB, zipfile.ZIP_DEFLATED)
            z.writestr("_rels/.rels", BOM.decode("utf-8") + RELS, zipfile.ZIP_STORED)
            z.writestr("xl/media/image1.bin", bytes(range(256)) * 4, zipfile.ZIP_DEFLATED)
    
    
    def ident(path):
        return hashlib.sha256(open(path, "rb").read()).hexdigest()
    
    
    # ONE workbook the runner sees, its id the first twelve hex digits of its
    # content hash, as the corpus names its files.
    path = os.path.join(corpus, "corpus", "PLACE.xlsx")
    sound(path)
    entry_id = ident(path)[:12]
    final = os.path.join(corpus, "corpus", entry_id + ".xlsx")
    os.replace(path, final)
    
    header = ["id", "sha256", "bytes", "ext", "producer", "producer_version",
              "app", "source", "tags", "added", "original_name", "note"]
    rows = ["\t".join(header), "\t".join([
        entry_id, ident(final), str(os.path.getsize(final)), "xlsx",
        "generated", "0", "none", "generated", "generated", "2026-09-17",
        "generated", "built by this log's generator"])]
    with open(os.path.join(corpus, "manifest.tsv"), "w", newline="\n") as handle:
        handle.write("\n".join(rows) + "\n")
    
    # The fixtures for the tool's own refusals, outside the manifest.
    sound(os.path.join(base, "sound.xlsx"))
    
    # A part that is not XML under an XML name. The SOUND part comes first, so the
    # index in the refusal is the failing entry's and not simply zero: the bytes
    # are not valid UTF-8, which is what this parser refuses (ruling 4).
    with zipfile.ZipFile(os.path.join(base, "badxml.xlsx"), "w") as z:
        z.writestr("[Content_Types].xml", CT, zipfile.ZIP_STORED)
        z.writestr("xl/worksheets/sheet1.xml", b"\x89PNG\r\n\x1a\n\xff\xfe\x80\x81" * 4,
                   zipfile.ZIP_DEFLATED)
    
    # The packages the S family surveys. One sound, then one per refusal, each
    # differing from the sound one in exactly the element the case is about.
    ATTR = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    PKG_RELS_NS = "http://schemas.openxmlformats.org/package/2006/relationships"
    MAIN_NS = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    PKG_TYPES = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                 '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
                 '<Default Extension="rels" ContentType="application/rels"/>'
                 '<Default Extension="xml" ContentType="application/xml"/>'
                 '<Override PartName="/xl/workbook.xml" ContentType="application/workbook"/>'
                 '</Types>')
    PKG_RELS = ('<Relationships xmlns="%s">'
                '<Relationship Id="rId1" Type="%s/officeDocument" Target="xl/workbook.xml"/>'
                '</Relationships>' % (PKG_RELS_NS, ATTR))
    PKG_WB = ('<workbook xmlns="%s" xmlns:r="%s"><sheets>'
              '<sheet name="S" sheetId="1" r:id="rId1"/></sheets></workbook>' % (MAIN_NS, ATTR))
    PKG_WB_RELS = ('<Relationships xmlns="%s">'
                   '<Relationship Id="rId1" Type="%s/worksheet" Target="worksheets/sheet1.xml"/>'
                   '</Relationships>' % (PKG_RELS_NS, ATTR))
    PKG_SHEET = '<worksheet xmlns="%s"><sheetData/></worksheet>' % MAIN_NS
    # Part 3 P2's worksheets. SHEET_CELLS is the U family's positive control: six
    # cells that between them exercise every count the line distinguishes, so the
    # asserted line is a measurement of this fixture. The rest each differ from it
    # in exactly the one thing the case is about.
    SHEET_CELLS = (
        '<worksheet xmlns="%s"><sheetData>'
        '<row r="1"><c r="A1" s="1"><v>1.5</v></c>'
        '<c r="B1" t="s"><v>1</v></c>'
        '<c r="C1" t="b"><v>1</v></c></row>'
        '<row r="2"><c r="A2"><f t="shared" ref="A2:A3" si="0">A1*2</f><v>3</v></c>'
        '<c r="B2"><f t="shared" si="0"/><v>3</v></c>'
        '<c r="C2"/></row>'
        '</sheetData></worksheet>' % MAIN_NS)
    
    
    def one_cell_sheet(cell):
        return ('<worksheet xmlns="%s"><sheetData><row r="1">%s</row>'
                '</sheetData></worksheet>' % (MAIN_NS, cell))
    
    
    SHEET_ROOT = '<sheet xmlns="%s"><sheetData/></sheet>' % MAIN_NS
    SHEET_REF = one_cell_sheet('<c r="A1:B2"><v>1</v></c>')
    SHEET_ROWNUM = ('<worksheet xmlns="%s"><sheetData><row r="one">'
                    '<c><v>1</v></c></row></sheetData></worksheet>' % MAIN_NS)
    SHEET_STYLE = one_cell_sheet('<c r="A1" s="x"><v>1</v></c>')
    SHEET_TYPE = one_cell_sheet('<c r="A1" t="z"><v>1</v></c>')
    SHEET_FTYPE = one_cell_sheet('<c r="A1"><f t="cse">1</f></c>')
    SHEET_NOSI = one_cell_sheet('<c r="A1"><f t="shared" ref="A1:A2">1</f></c>')
    SHEET_ENTITY = one_cell_sheet('<c r="A1"><v>a&nbsp;b</v></c>')
    SHEET_ELEM = one_cell_sheet('<c r="A1"><v>a<b/>c</v></c>')
    SHEET_OUTRANGE = one_cell_sheet('<c r="A1" t="s"><v>9</v></c>')
    SHEET_NOTANUM = one_cell_sheet('<c r="A1" t="s"><v>x</v></c>')
    # Part 3 P3, ruling 2: a decimal u32 is ASCII digits only, no sign and no
    # leading zero except 0 itself, and a row is numbered from 1. Each of these
    # was ACCEPTED before that ruling, three of them read as 0, 3 and 7.
    SHEET_ROW0 = ('<worksheet xmlns="%s"><sheetData><row r="0">'
                  '<c><v>1</v></c></row></sheetData></worksheet>' % MAIN_NS)
    SHEET_ROWPLUS = ('<worksheet xmlns="%s"><sheetData><row r="+3">'
                     '<c><v>1</v></c></row></sheetData></worksheet>' % MAIN_NS)
    SHEET_STYLEPAD = one_cell_sheet('<c r="A1" s="007"><v>1</v></c>')
    SHEET_SIPLUS = one_cell_sheet('<c r="A1"><f t="shared" si="+1">1</f></c>')
    
    
    PKG_CHAIN = '<calcChain xmlns="%s"><c r="A1" i="1"/></calcChain>' % MAIN_NS
    # Part 3 P1's fixtures. A shared strings part is added the way a producer adds
    # one: the entry, the Override that types it and the relationship from the
    # workbook part. The body is a parameter so a fixture can carry a sound table,
    # a root of the wrong name, or a reference this layer cannot expand.
    PKG_SST = '<sst xmlns="%s"><si><t>a</t></si><si><t>b</t></si></sst>' % MAIN_NS
    PKG_SST_ROOT = '<strings xmlns="%s"><si><t>a</t></si></strings>' % MAIN_NS
    PKG_SST_ENTITY = '<sst xmlns="%s"><si><t>a&nbsp;b</t></si></sst>' % MAIN_NS
    
    
    def package(name, types=PKG_TYPES, rels=PKG_RELS, workbook=PKG_WB,
                workbook_rels=PKG_WB_RELS, with_types=True, chain=False,
                strings=None, sheet=PKG_SHEET, with_sheet=True, styles=None):
        """The smallest package, with one part replaced or dropped.
    
        With chain=True it also carries a calculation chain: the entry, the
        override that names it and the relationship from the workbook part, which
        are the three things the recipe removes.
    
        With strings set it carries a shared strings part holding exactly that
        text, with the Override and the relationship a producer writes for one.
        The part is added the same way whatever the body, so a refusal below is
        the reader refusing the body and not the package missing a piece.
    
        sheet is the worksheet part's body, for the same reason: the U family's
        refusals are the cell reader refusing a body, and every other case in this
        log is built with the sound default exactly as before.
    
        with_sheet=False drops the worksheet ENTRY while leaving the workbook, its
        sheet element and the relationship that names it, which is the package
        specs/0010 P3 asks the tool to be run on: the sheet is named and the part
        is not there.
    
        With styles set it carries a styles part holding exactly that text, with
        the Override and the relationship a producer writes for one (part 5 P1).
        """
        path = os.path.join(base, name + ".xlsx")
        if styles is not None:
            types = types.replace(
                "</Types>",
                '<Override PartName="/xl/styles.xml" '
                'ContentType="application/styles"/></Types>')
            workbook_rels = workbook_rels.replace(
                "</Relationships>",
                '<Relationship Id="rId8" Type="%s/styles" '
                'Target="styles.xml"/></Relationships>' % ATTR)
        if strings is not None:
            types = types.replace(
                "</Types>",
                '<Override PartName="/xl/sharedStrings.xml" '
                'ContentType="application/strings"/></Types>')
            workbook_rels = workbook_rels.replace(
                "</Relationships>",
                '<Relationship Id="rId9" Type="%s/sharedStrings" '
                'Target="sharedStrings.xml"/></Relationships>' % ATTR)
        if chain:
            types = types.replace(
                "</Types>",
                '<Override PartName="/xl/calcChain.xml" ContentType="application/chain"/>'
                "</Types>")
            workbook_rels = workbook_rels.replace(
                "</Relationships>",
                '<Relationship Id="rId2" Type="%s/calcChain" Target="calcChain.xml"/>'
                "</Relationships>" % ATTR)
        with zipfile.ZipFile(path, "w") as z:
            if with_types:
                z.writestr("[Content_Types].xml", types, zipfile.ZIP_STORED)
            z.writestr("_rels/.rels", rels, zipfile.ZIP_STORED)
            z.writestr("xl/workbook.xml", workbook, zipfile.ZIP_DEFLATED)
            z.writestr("xl/_rels/workbook.xml.rels", workbook_rels, zipfile.ZIP_STORED)
            if with_sheet:
                z.writestr("xl/worksheets/sheet1.xml", sheet, zipfile.ZIP_DEFLATED)
            if chain:
                z.writestr("xl/calcChain.xml", PKG_CHAIN, zipfile.ZIP_DEFLATED)
            if strings is not None:
                z.writestr("xl/sharedStrings.xml", strings, zipfile.ZIP_DEFLATED)
            if styles is not None:
                z.writestr("xl/styles.xml", styles, zipfile.ZIP_DEFLATED)
        print("%s: %d bytes" % (name, os.path.getsize(path)))
    
    
    package("pkg")
    # P3's fixtures: the same package with a chain, for --drop-calc-chain to drop,
    # and one with a chain but no content types part, which the recipe must reach
    # for and refuse. pkg-noct has no chain, so the recipe never asks it for a
    # content types part at all; that difference is what D1 and D5 are about.
    package("pkg-chain", chain=True)
    package("pkg-chain-noct", chain=True, with_types=False)
    package("pkg-noct", with_types=False)
    package("pkg-ctroot", types=PKG_TYPES.replace("<Types ", "<Kinds ")
            .replace("</Types>", "</Kinds>"))
    package("pkg-incomplete",
            types=PKG_TYPES.replace('<Default Extension="xml" ContentType="application/xml"/>',
                                    '<Default Extension="xml"/>'))
    package("pkg-relsroot", rels=PKG_RELS.replace("<Relationships ", "<Relations ")
            .replace("</Relationships>", "</Relations>"))
    package("pkg-dupid", workbook_rels=PKG_WB_RELS.replace(
        "</Relationships>",
        '<Relationship Id="rId1" Type="%s/styles" Target="styles.xml"/></Relationships>' % ATTR))
    package("pkg-above", rels=PKG_RELS.replace('Target="xl/workbook.xml"',
                                               'Target="../workbook.xml"'))
    package("pkg-noffice", rels=PKG_RELS.replace("/officeDocument", "/thumbnail"))
    package("pkg-twooffice", rels=PKG_RELS.replace(
        "</Relationships>",
        '<Relationship Id="rId2" Type="%s/officeDocument" Target="xl/workbook.xml"/>'
        '</Relationships>' % ATTR))
    package("pkg-dangling", rels=PKG_RELS.replace('Target="xl/workbook.xml"',
                                                  'Target="xl/missing.xml"'))
    package("pkg-wbroot", workbook=PKG_WB.replace("<workbook ", "<book ")
            .replace("</workbook>", "</book>"))
    package("pkg-nosheetid", workbook=PKG_WB.replace(' r:id="rId1"', ""))
    package("pkg-sheetid", workbook=PKG_WB.replace('sheetId="1"', 'sheetId="one"'))
    package("pkg-missingrel", workbook=PKG_WB.replace('r:id="rId1"', 'r:id="rId404"'))
    package("pkg-unbound", workbook=PKG_WB.replace(' xmlns:r="%s"' % ATTR, ""))
    # Part 3 P1: one sound table, which is the T family's positive control, and one
    # per refusal the reader can raise. Each differs from pkg-sst in the body of
    # the shared strings part alone.
    package("pkg-sst", strings=PKG_SST)
    package("pkg-sstroot", strings=PKG_SST_ROOT)
    package("pkg-sstentity", strings=PKG_SST_ENTITY)
    # Part 3 P2: one sound worksheet, which is the U family's positive control,
    # and one per refusal or counted failure. Each differs from pkg-cells in the
    # worksheet body alone; the two that need a table to look an index up in carry
    # the same two-item table pkg-sst does.
    package("pkg-cells", strings=PKG_SST, sheet=SHEET_CELLS)
    package("pkg-cellroot", sheet=SHEET_ROOT)
    package("pkg-cellref", sheet=SHEET_REF)
    package("pkg-cellrow", sheet=SHEET_ROWNUM)
    package("pkg-cellstyle", sheet=SHEET_STYLE)
    package("pkg-celltype", sheet=SHEET_TYPE)
    package("pkg-cellftype", sheet=SHEET_FTYPE)
    package("pkg-cellnosi", sheet=SHEET_NOSI)
    package("pkg-cellentity", sheet=SHEET_ENTITY)
    package("pkg-cellelem", sheet=SHEET_ELEM)
    package("pkg-cellrange", strings=PKG_SST, sheet=SHEET_OUTRANGE)
    package("pkg-cellnotanum", strings=PKG_SST, sheet=SHEET_NOTANUM)
    package("pkg-cellnotable", sheet=SHEET_OUTRANGE)
    # Part 3 P3: ruling 2's four refusals, and the package whose named sheet part
    # is not there.
    package("pkg-cellrow0", sheet=SHEET_ROW0)
    package("pkg-cellrowplus", sheet=SHEET_ROWPLUS)
    package("pkg-cellstylepad", sheet=SHEET_STYLEPAD)
    package("pkg-cellsiplus", sheet=SHEET_SIPLUS)
    package("pkg-nosheetpart", with_sheet=False)
    # Part 4 P2: the E family. pkg-edit is pkg-cells, the U family's sound
    # worksheet; the rest each differ in the worksheet body alone, except
    # pkg-edit-chart, whose only sheet's relationship is a chartsheet.
    package("pkg-edit", strings=PKG_SST, sheet=SHEET_CELLS)
    package("pkg-edit-empty", sheet=PKG_SHEET)
    package("pkg-edit-order", sheet=(
        '<worksheet xmlns="%s"><sheetData><row r="2"><c r="A2"><v>1</v></c></row>'
        '<row r="1"><c r="A1"><v>2</v></c></row></sheetData></worksheet>' % MAIN_NS))
    package("pkg-edit-noref", sheet=one_cell_sheet('<c><v>1</v></c><c><v>2</v></c>'))
    package("pkg-edit-cm", sheet=one_cell_sheet(
        '<c r="A1" cm="1"><v>1</v></c><c r="B1"><v>2</v></c>'))
    package("pkg-edit-array", sheet=one_cell_sheet(
        '<c r="A1"><f t="array" ref="A1:B2">X1</f><v>1</v></c><c r="B1"><v>1</v></c>'
        '<c r="C1"><v>1</v></c>'))
    package("pkg-edit-nodata", sheet=(
        '<worksheet xmlns="%s"><dimension ref="A1"/></worksheet>' % MAIN_NS))
    package("pkg-edit-chart", workbook_rels=PKG_WB_RELS.replace("/worksheet\"", "/chartsheet\""))
    package("pkg-edit-lastrow", sheet=(
        '<worksheet xmlns="%s"><sheetData><row r="4294967295">'
        '<c r="A4294967295"><v>1</v></c></row></sheetData></worksheet>' % MAIN_NS))
    # Part 4 P3: the F family. SHEET_FORMULA is the integration tests' formula
    # worksheet: A1 a styled number, B1 a shared formula's master and B2 its
    # follower (kind Shared, not candidates), C2 and D2 normal formulas. The first
    # normal formula in document order is C2. Five cells.
    SHEET_FORMULA = (
        '<worksheet xmlns="%s"><sheetData>'
        '<row r="1"><c r="A1" s="1"><v>2</v></c>'
        '<c r="B1"><f t="shared" ref="B1:B2" si="0">A1*2</f><v>4</v></c></row>'
        '<row r="2"><c r="B2"><f t="shared" si="0"/><v>4</v></c>'
        '<c r="C2" s="3"><f>A1+1</f><v>3</v></c>'
        '<c r="D2"><f>A1+2</f><v>4</v></c></row>'
        '</sheetData></worksheet>' % MAIN_NS)
    package("pkg-fs-chain", chain=True, sheet=SHEET_FORMULA)
    package("pkg-fs-nochain", sheet=SHEET_FORMULA)
    # Part 5 P1: the Y family. STYLES_SOUND holds two custom number formats, one
    # a date, and four cell formats: the general one, built-in 14 (a date), the
    # custom number and the custom date. The codes are fictional. By hand: xfs 4,
    # num_fmts 2, custom 2, dated 2. pkg-styles-1904 is the same with date1904
    # set on the workbook. The rest each differ from pkg-styles in the styles
    # body alone, one per reading refusal.
    STYLES_SOUND = (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
        '<styleSheet xmlns="%s"><numFmts count="2">'
        '<numFmt numFmtId="164" formatCode="0.00"/>'
        '<numFmt numFmtId="165" formatCode="yyyy-mm-dd"/></numFmts>'
        '<cellXfs count="4"><xf numFmtId="0"/><xf numFmtId="14"/>'
        '<xf numFmtId="164"/><xf numFmtId="165"/></cellXfs></styleSheet>' % MAIN_NS)
    package("pkg-styles", styles=STYLES_SOUND)
    # Part 5 P2: the same styles part with the U family's six cells, so the
    # style sample has an A to restyle. Hand count: xfs 4, cells 6, M 2.
    package("pkg-styles-cells", styles=STYLES_SOUND, sheet=SHEET_CELLS)
    package("pkg-styles-1904", styles=STYLES_SOUND,
            workbook=PKG_WB.replace("<sheets>", '<workbookPr date1904="1"/><sheets>'))
    # Part 5 P3: the style sample's cells in the 1904 system, for the date
    # sample's second positive control; and ruling 6's no-cellXfs fixture, the
    # sound styles part with its cellXfs removed, on a sheet whose only cell is an
    # unstyled number, so --style-sample's A carries no s and both additions take
    # no base.
    package("pkg-styles-cells-1904", styles=STYLES_SOUND, sheet=SHEET_CELLS,
            workbook=PKG_WB.replace("<sheets>", '<workbookPr date1904="1"/><sheets>'))
    STYLES_NOXFS = STYLES_SOUND[:STYLES_SOUND.index("<cellXfs")] + "</styleSheet>"
    package("pkg-styles-noxfs", styles=STYLES_NOXFS,
            sheet=one_cell_sheet('<c r="A1"><v>1</v></c>'))
    package("pkg-styles-root", styles=STYLES_SOUND.replace("<styleSheet ", "<styles ")
            .replace("</styleSheet>", "</styles>"))
    package("pkg-styles-nocode", styles=STYLES_SOUND.replace(' formatCode="0.00"', ""))
    package("pkg-styles-notanum", styles=STYLES_SOUND.replace('<xf numFmtId="14"/>',
                                                              '<xf numFmtId="x14"/>'))
    package("pkg-styles-two", styles=STYLES_SOUND.replace(
        "</styleSheet>", '<cellXfs count="1"><xf/></cellXfs></styleSheet>'))
    
    print("sound: %d bytes" % os.path.getsize(os.path.join(base, "sound.xlsx")))
    print("badxml: %d bytes" % os.path.getsize(os.path.join(base, "badxml.xlsx")))
    print("corpus entry %s: %d bytes" % (entry_id, os.path.getsize(final)))
    print("the bad part is entry 1 of 2 in badxml, after a sound content types part")
    GEN_PY
    echo "command: python3 <scratch>/gen.py <scratch> <scratch>/corpus"
    python3 "$B/gen.py" "$B" "$B/corpus" >"$B/gen.out" 2>&1
    genrc=$?
    hide <"$B/gen.out" | sed 's/^/    /'
    note "the generator exits 0" "$(is [ "$genrc" -eq 0 ])"
    nrows=$(count_lines "$B/corpus/manifest.tsv")
    echo "  manifest lines including the header: $nrows"
    note "the manifest has a header and one row" "$(is [ "$nrows" = 2 ])"
    ID=$(awk -F'\t' 'NR == 2 { print $1 }' "$B/corpus/manifest.tsv")
    
    echo
    echo "## the messages this log asserts, read from the committed source"
    # Never typed here: a log that types a message keeps passing against a string
    # the tool no longer prints (the same rule as the gate log reading OFFICE_RE
    # from check.sh).
    # The usage text spans two source lines now that a third operation is named,
    # joined by a Rust string continuation, so a line oriented sed cannot read it.
    # This reads the constant and undoes the continuation, which is the string the
    # binary itself prints.
    cat >"$B/usage.py" <<'USAGE_PY'
    import re
    import sys
    
    source = open(sys.argv[1], encoding="utf-8").read()
    found = re.search(r'const USAGE: &str = "((?:[^"\\]|\\.)*)"', source, re.S)
    print(re.sub(r'\\\n\s*', '', found.group(1)) if found else '')
    USAGE_PY
    USAGE=$(python3 "$B/usage.py" "$MAIN/tools/emend-copy/src/main.rs")
    echo "command: python3 <scratch>/usage.py tools/emend-copy/src/main.rs"
    echo "  usage text read from the source: [$USAGE]"
    note "the usage text was read from the tool's source and is not empty" "$(is [ -n "$USAGE" ])"
    XML_FMT=$(sed -n 's/^ *write!(f, "\(not well-formed XML or not UTF-8 (entry {index})\)")$/\1/p' \
      "$MAIN/crates/emend/src/archive.rs")
    echo "  the layer's XML message format read from archive.rs: [$XML_FMT]"
    note "the XML message format was read from the layer's source and is not empty" "$(is [ -n "$XML_FMT" ])"
    XML_MSG="error: ${XML_FMT/\{index\}/1}"
    echo "  the message expected for entry 1: [$XML_MSG]"
    note "substituting the index left no brace in the expected message" \
      "$(is [ "$XML_MSG" = "${XML_MSG%\{*}" ])"
    TAB_FMT=$(sed -n 's/.*die "\(a --tool-arg value must hold no tab or newline\); \$USAGE".*/\1/p' \
      "$MAIN/scripts/passthrough-run.sh")
    echo "  the runner's tab refusal read from passthrough-run.sh: [$TAB_FMT]"
    note "the tab refusal text was read from the runner's source and is not empty" "$(is [ -n "$TAB_FMT" ])"
    
    # The package layer's messages, every one of them, extracted from the
    # committed source. The S family then selects one by a short key and asserts
    # the key names exactly one message, so a case cannot quietly assert a string
    # the layer does not hold and no message is typed into this script.
    cat >"$B/msgs.py" <<'MSG_PY'
    import re
    import sys
    
    for path in sys.argv[1:]:
        source = open(path, encoding="utf-8").read()
        for message in re.findall(r'Error::Package\(\s*"((?:[^"\\]|\\.)*)"', source, re.S):
            print(message)
    MSG_PY
    # All THREE modules now: Scope raises the unbound-prefix message and lives in
    # xml.rs, cells.rs raises the two this phase adds, package.rs raises the rest,
    # and package.rs's header catalogues all of them. The first round of this log
    # read package.rs alone and its last case failed; part 3 P1 adds cells.rs for
    # the same reason, and the set-equality test in the package module's own tests
    # reads the same three files.
    # Part 5 P1 adds styles.rs, which raises the reading's messages, as the
    # set-equality test in the package module's own tests now reads it too.
    echo "command: python3 <scratch>/msgs.py crates/emend/src/package.rs crates/emend/src/xml.rs crates/emend/src/cells.rs crates/emend/src/styles.rs | sort -u"
    python3 "$B/msgs.py" "$MAIN/crates/emend/src/package.rs" "$MAIN/crates/emend/src/xml.rs" \
      "$MAIN/crates/emend/src/cells.rs" "$MAIN/crates/emend/src/styles.rs" | sort -u >"$B/messages"
    nmsg=$(count_lines "$B/messages")
    sed 's/^/    /' "$B/messages"
    echo "  messages extracted: $nmsg"
    # Header change 2: by name, against the phase immediately before this one.
    PREV_NEG=$MAIN/records/logs/m1p5-p2/negative.log
    PREV_MSG=$(sed -n 's/^  messages extracted: \([0-9]*\)$/\1/p' "$PREV_NEG")
    echo "  the previous phase's count, read from records/logs/m1p5-p2/negative.log: $PREV_MSG"
    note "the previous phase's message count was read from its committed log" "$(is [ -n "$PREV_MSG" ])"
    awk '/^command: python3 <scratch>\/msgs.py/ { f = 1; next } /^  messages extracted/ { f = 0 } f' "$PREV_NEG" |
      sed 's/^    //' | sort -u >"$B/prev-messages"
    nprev_listed=$(count_lines "$B/prev-messages")
    echo "  messages the previous log listed: $nprev_listed"
    note "the previous log's listing accounts for its whole count" "$(is [ "$nprev_listed" = "$PREV_MSG" ])"
    comm -13 "$B/prev-messages" "$B/messages" >"$B/added-messages"
    comm -23 "$B/prev-messages" "$B/messages" >"$B/removed-messages"
    nadded_msg=$(count_lines "$B/added-messages")
    nremoved_msg=$(count_lines "$B/removed-messages")
    echo "  messages added since the previous phase: $nadded_msg"
    sed 's/^/    added: /' "$B/added-messages"
    echo "  messages removed since the previous phase: $nremoved_msg"
    sed 's/^/    removed: /' "$B/removed-messages"
    note "no message the previous phase extracted is gone" "$(is [ "$nremoved_msg" = 0 ])"
    # Header change 2: specs/0012 "Errors" names ten new messages, and each added
    # one must be quoted there, read from the spec file rather than typed here.
    # The spec is prose wrapped at a column, so a quoted message can carry a line
    # break inside it; the search runs over the spec with its line breaks turned
    # into spaces and runs of spaces squeezed, which is the form the sentence
    # reads in (header change 8).
    note "P3's library code adds no message (header change 2)" "$(is [ "$nadded_msg" = 0 ])"
    : >"$B/added-not-in-spec"
    tr '\n' ' ' <"$MAIN/specs/0012-styles.md" | tr -s ' ' >"$B/spec-flat"
    while IFS= read -r m; do
      if [ "$(count_matches -F "\"$m\"" "$B/spec-flat")" = 0 ]; then
        printf '%s\n' "$m" >>"$B/added-not-in-spec"
      fi
    done <"$B/added-messages"
    echo "  the spec, its line breaks turned into spaces: $(wc -c <"$B/spec-flat") bytes"
    echo "  added messages specs/0012-styles.md does not quote: $(count_lines "$B/added-not-in-spec")"
    note "every added message is quoted in specs/0012-styles.md" \
      "$(is [ "$(count_lines "$B/added-not-in-spec")" = 0 ])"
    note "control: the same search finds no quotation of a message the spec never names" \
      "$(is [ "$(count_matches -F '"no such message anywhere"' "$B/spec-flat")" = 0 ])"
    # And the positive control for the flattening, in the same command form: a
    # message the spec quotes ACROSS a line break is found in the flat form.
    note "control: the same search finds a message the spec quotes across a line break" \
      "$(is [ "$(count_matches -F '"a style index is out of range"' "$B/spec-flat")" -ge 1 ])"
    # The eight specs/0011 "Errors" names, read from the committed catalogue
    # rather than typed: the lines after "The cell edits add" in package.rs's
    # module header, each `//! - "<message>"`, joined where one wraps. The block
    # after the C family counts which of them the E family reaches.
    python3 - "$MAIN/crates/emend/src/package.rs" >"$B/catalogued-cell-edit" <<'CAT_PY'
    import re
    import sys
    
    text = open(sys.argv[1], encoding="utf-8").read()
    start = text.index("//! The cell edits add ")
    block = text[start:].split("\n//!\n", 2)[1]
    joined = re.sub(r"\n//!   ", " ", block)
    for message in re.findall(r'^//! - "([^"]*)"', joined, re.M):
        print(message)
    CAT_PY
    sort -u "$B/catalogued-cell-edit" -o "$B/catalogued-cell-edit"
    ncat=$(count_lines "$B/catalogued-cell-edit")
    echo "  cell-edit messages the package module's catalogue lists: $ncat"
    sed 's/^/    catalogued: /' "$B/catalogued-cell-edit"
    note "the catalogue lists eight cell-edit messages" "$(is [ "$ncat" = 8 ])"
    nincat=$(comm -12 "$B/catalogued-cell-edit" "$B/messages" | wc -l)
    note "every catalogued cell-edit message is one the source raises ($nincat)" "$(is [ "$nincat" = 8 ])"
    # The tool's two messages P2 adds that a command line can reach, read from
    # the tool's source: the Display arm of each variant.
    tool_msg() {
      sed -n "s/^ *Error::$1 => f.write_str(\"\(.*\)\"),\$/\1/p" "$MAIN/tools/emend-copy/src/main.rs"
    }
    NOWS_MSG=$(tool_msg NoWorksheet)
    NOROW_MSG=$(tool_msg NoNewRow)
    # P3's first code commit adds ReadOutput, a formatted message; its Display
    # arm is printed from the source. No case here reaches it (header change 4).
    echo "command: grep -n 'Error::ReadOutput(kind) =>' tools/emend-copy/src/main.rs"
    LC_ALL=C "$G" -n 'Error::ReadOutput(kind) =>' "$MAIN/tools/emend-copy/src/main.rs" | sed 's/^/    /'
    note "the tool's ReadOutput arm is in its source once" \
      "$(is [ "$(count_matches -F 'Error::ReadOutput(kind) =>' "$MAIN/tools/emend-copy/src/main.rs")" = 1 ])"
    echo "  the tool's NoWorksheet message read from its source: [$NOWS_MSG]"
    echo "  the tool's NoNewRow message read from its source: [$NOROW_MSG]"
    both_tool_msgs() { [ -n "$NOWS_MSG" ] && [ -n "$NOROW_MSG" ]; }
    note "both were read and neither is empty" "$(is both_tool_msgs)"
    note "control: the same form reads no message for a variant the tool does not have" \
      "$(is [ -z "$(tool_msg NoSuchVariant)" ])"
    msg_of() { LC_ALL=C "$G" -F "$1" "$B/messages"; }
    msg_one() { [ "$(count_matches -F "$1" "$B/messages")" = 1 ]; }
    # The control for the selector, in the same form: a key no message holds
    # selects none, so an empty expected message cannot read as a pass.
    note "control: a key no message holds selects nothing" "$(isnot msg_one 'no such message anywhere')"
    # specs/0001, as this phase amended it: a negated condition goes through a
    # helper that negates, WITH a control showing `isnot true` reports UNEXPECTED.
    # The line above is this log's only negated condition, so without this control
    # a mis-defined helper would make it vacuous and nothing else here would
    # notice. Independent check 2 of this phase caught the omission.
    note "control: isnot reports a passing command as UNEXPECTED, so it can fail" \
      "$(is [ "$(isnot true)" = UNEXPECTED ])"
    
    # ec_case <label> <expected exit> <expected stderr, empty for none> <args...>
    #
    # The whole stderr line is compared, not its "error: " prefix, and the note
    # beside it says exactly what was checked.
    ec_case() {
      local label=$1 expect_rc=$2 expect_err=$3
      shift 3
      ( cd "$B" && "$EC" "$@" ) >"$B/$label.out" 2>"$B/$label.err"
      local rc=$?
      local errlines got
      errlines=$(count_lines "$B/$label.err")
      got=$(cat "$B/$label.err")
      echo "  $label: exit $rc; stderr lines $errlines"
      hide <"$B/$label.err" | sed 's/^/      /'
      ec_ok() {
        [ "$rc" -eq "$expect_rc" ] || return 1
        [ "$got" = "$expect_err" ] || return 1
        if [ -z "$expect_err" ]; then [ "$errlines" = 0 ]; else [ "$errlines" = 1 ]; fi
      }
      local said
      if [ -z "$expect_err" ]; then
        said="and says nothing on stderr"
      else
        said="and stderr is exactly the expected line"
      fi
      note "$label exits $expect_rc $said" "$(is ec_ok)"
    }
    
    # left_none <label> <output path>: no output file and no temporary of the
    # tool's own survived the case. The temporary forms are
    # .<name>.emend-copy[-kind]-<pid>.tmp, all of which the runner's leftover glob
    # matches; a refusal must leave none.
    left_none() {
      local label=$1 out=$2 ntmp
      ntmp=$(find "$B" -maxdepth 1 -name '.*emend-copy*.tmp' | wc -l)
      echo "  $label: output present: $([ -e "$out" ] && echo yes || echo no); temporaries of the tool: $ntmp"
      no_leftovers() {
        [ ! -e "$out" ] || return 1
        [ "$ntmp" = 0 ] || return 1
      }
      note "$label left no output and no temporary" "$(is no_leftovers)"
    }
    
    echo
    echo "## N1 to N4: two operations at once"
    echo "command: emend-copy <scratch>/sound.xlsx <scratch>/out-N1.xlsx --xml-null-rewrite --replace [Content_Types].xml"
    ec_case N1 2 "error: $USAGE" sound.xlsx out-N1.xlsx --xml-null-rewrite --replace '[Content_Types].xml'
    left_none N1 "$B/out-N1.xlsx"
    echo "command: emend-copy ... --replace [Content_Types].xml --xml-null-rewrite"
    ec_case N2 2 "error: $USAGE" sound.xlsx out-N2.xlsx --replace '[Content_Types].xml' --xml-null-rewrite
    left_none N2 "$B/out-N2.xlsx"
    echo "command: emend-copy ... --xml-null-rewrite --xml-null-rewrite"
    ec_case N3 2 "error: $USAGE" sound.xlsx out-N3.xlsx --xml-null-rewrite --xml-null-rewrite
    left_none N3 "$B/out-N3.xlsx"
    # P2's operation in the pair. In P1 --survey alone was the unknown-operation
    # case; it is a real operation now, so what must be refused is TWO of them.
    echo "command: emend-copy ... --survey --xml-null-rewrite"
    ec_case N4 2 "error: $USAGE" sound.xlsx out-N4.xlsx --survey --xml-null-rewrite
    left_none N4 "$B/out-N4.xlsx"
    
    echo
    echo "## N5 and N6: an unknown operation"
    echo "command: emend-copy ... --xml-null (a letter away from the real name)"
    ec_case N5 2 "error: $USAGE" sound.xlsx out-N5.xlsx --xml-null
    left_none N5 "$B/out-N5.xlsx"
    echo "command: emend-copy ... --replace-all [Content_Types].xml"
    ec_case N6 2 "error: $USAGE" sound.xlsx out-N6.xlsx --replace-all '[Content_Types].xml'
    left_none N6 "$B/out-N6.xlsx"
    
    echo
    echo "## N7 and N8: an operation before the paths"
    echo "command: emend-copy --xml-null-rewrite <scratch>/sound.xlsx <scratch>/out-N7.xlsx"
    ec_case N7 2 "error: $USAGE" --xml-null-rewrite sound.xlsx out-N7.xlsx
    left_none N7 "$B/out-N7.xlsx"
    echo "command: emend-copy --survey <scratch>/pkg.xlsx <scratch>/out-N8.xlsx"
    ec_case N8 2 "error: $USAGE" --survey pkg.xlsx out-N8.xlsx
    left_none N8 "$B/out-N8.xlsx"
    
    echo
    echo "## N9 to N11: the operation's own arguments"
    echo "command: emend-copy ... --replace (with no name)"
    ec_case N9 2 "error: $USAGE" sound.xlsx out-N9.xlsx --replace
    left_none N9 "$B/out-N9.xlsx"
    echo "command: emend-copy ... --xml-null-rewrite [Content_Types].xml (an argument it does not take)"
    ec_case N10 2 "error: $USAGE" sound.xlsx out-N10.xlsx --xml-null-rewrite '[Content_Types].xml'
    left_none N10 "$B/out-N10.xlsx"
    echo "command: emend-copy ... --survey [Content_Types].xml (an argument it does not take)"
    ec_case N11 2 "error: $USAGE" sound.xlsx out-N11.xlsx --survey '[Content_Types].xml'
    left_none N11 "$B/out-N11.xlsx"
    
    echo
    echo "## N12 to N15: the accepted forms, so the refusals above are not vacuous"
    echo "command: emend-copy <scratch>/sound.xlsx <scratch>/out-N12.xlsx --xml-null-rewrite"
    ec_case N12 0 "" sound.xlsx out-N12.xlsx --xml-null-rewrite
    n12_same=$(cmp -s "$B/sound.xlsx" "$B/out-N12.xlsx" && echo yes || echo no)
    echo "  N12 the output exists: $([ -e "$B/out-N12.xlsx" ] && echo yes || echo no); byte-identical to the input: $n12_same"
    note "N12 the accepted form produced an output" "$(is [ -e "$B/out-N12.xlsx" ])"
    # The null rewrite REPLACES its XML entries, so the file is not expected to be
    # byte-identical: the entries are recompressed by the zip crate. What must hold
    # is that the harness reports every XML entry recompressed or identical and
    # never changed, which P1's run log measured over the corpus; here the diff
    # tool is run on the one generated pair to show the same thing in miniature.
    echo "command: xlsx-diff <scratch>/sound.xlsx <scratch>/out-N12.xlsx"
    ( cd "$B" && "$XD" sound.xlsx out-N12.xlsx ) >"$B/N12.diff" 2>"$B/N12.diff.err"
    ndrc=$?
    echo "  diff exit: $ndrc; stderr bytes: $(wc -c <"$B/N12.diff.err")"
    hide <"$B/N12.diff" | sed 's/^/      /'
    # The tool's OWN accounting is read, from its archive summary lines, rather
    # than counted out of the entry rows: those lines are what specs/0004 fixes
    # and what the runner's summary columns come from.
    diff_value() {
      awk -F'\t' -v k="$2" '$1 == "archive" && $2 == k { print $3 }' "$1"
    }
    n_entries=$(diff_value "$B/N12.diff" entries_in)
    n_identical=$(diff_value "$B/N12.diff" identical)
    n_recompressed=$(diff_value "$B/N12.diff" recompressed)
    n_changed=$(diff_value "$B/N12.diff" changed)
    n_dropped=$(diff_value "$B/N12.diff" dropped)
    n_added=$(diff_value "$B/N12.diff" added)
    n_flagged=$(diff_value "$B/N12.diff" flagged)
    n_order=$(diff_value "$B/N12.diff" order_preserved)
    echo "  entries_in $n_entries; identical $n_identical; recompressed $n_recompressed; changed $n_changed; dropped $n_dropped; added $n_added; flagged $n_flagged; order_preserved $n_order"
    n12_statuses() {
      [ "$n_changed" = 0 ] || return 1
      [ "$n_dropped" = 0 ] || return 1
      [ "$n_added" = 0 ] || return 1
      [ "$n_flagged" = 0 ] || return 1
      [ "$n_order" = yes ] || return 1
      [ "$((n_identical + n_recompressed))" = "$n_entries" ] || return 1
    }
    note "N12 every entry is identical or recompressed, none changed, dropped, added or flagged" "$(is n12_statuses)"
    # The control for diff_value, through the same command form: a key the tool
    # never prints yields nothing, so a silent empty value cannot read as a pass.
    n12_missing=$(diff_value "$B/N12.diff" no_such_key)
    note "control: diff_value yields nothing for a key the tool does not print" "$(is [ -z "$n12_missing" ])"
    echo "command: emend-copy <scratch>/sound.xlsx <scratch>/out-N13.xlsx --replace [Content_Types].xml"
    ec_case N13 0 "" sound.xlsx out-N13.xlsx --replace '[Content_Types].xml'
    note "N13 the accepted form produced an output" "$(is [ -e "$B/out-N13.xlsx" ])"
    echo "command: emend-copy <scratch>/sound.xlsx <scratch>/out-N14.xlsx (no operation)"
    ec_case N14 0 "" sound.xlsx out-N14.xlsx
    n14_same=$(cmp -s "$B/sound.xlsx" "$B/out-N14.xlsx" && echo yes || echo no)
    echo "  N14 byte-identical to the input: $n14_same"
    note "N14 a no-operation copy is byte-identical" "$(is [ "$n14_same" = yes ])"
    echo "command: emend-copy <scratch>/pkg.xlsx <scratch>/out-N15.xlsx --survey"
    ec_case N15 0 "" pkg.xlsx out-N15.xlsx --survey
    n15_same=$(cmp -s "$B/pkg.xlsx" "$B/out-N15.xlsx" && echo yes || echo no)
    echo "  N15 byte-identical to the input: $n15_same"
    note "N15 the accepted --survey produced a byte-identical output" "$(is [ "$n15_same" = yes ])"
    
    echo
    echo "## N16 to N19: --drop-calc-chain among the operations, refused in pairs"
    # The operation P3 adds. In P2 --drop-calc-chain was an unknown operation and
    # a P2 case asserting it refused for THAT reason would now be asserting the
    # opposite of the truth; the cases below refuse it only where two operations
    # meet, where an operation comes before the paths, or where it is handed an
    # argument it does not take.
    echo "command: emend-copy <scratch>/pkg-chain.xlsx <scratch>/out-N16.xlsx --drop-calc-chain --survey"
    ec_case N16 2 "error: $USAGE" pkg-chain.xlsx out-N16.xlsx --drop-calc-chain --survey
    left_none N16 "$B/out-N16.xlsx"
    echo "command: emend-copy ... --survey --drop-calc-chain"
    ec_case N17 2 "error: $USAGE" pkg-chain.xlsx out-N17.xlsx --survey --drop-calc-chain
    left_none N17 "$B/out-N17.xlsx"
    echo "command: emend-copy ... --drop-calc-chain --drop-calc-chain"
    ec_case N18 2 "error: $USAGE" pkg-chain.xlsx out-N18.xlsx --drop-calc-chain --drop-calc-chain
    left_none N18 "$B/out-N18.xlsx"
    echo "command: emend-copy ... --xml-null-rewrite --drop-calc-chain"
    ec_case N19 2 "error: $USAGE" pkg-chain.xlsx out-N19.xlsx --xml-null-rewrite --drop-calc-chain
    left_none N19 "$B/out-N19.xlsx"
    
    echo
    echo "## N20 and N21: --drop-calc-chain misplaced, and given an argument"
    echo "command: emend-copy --drop-calc-chain <scratch>/pkg-chain.xlsx <scratch>/out-N20.xlsx"
    ec_case N20 2 "error: $USAGE" --drop-calc-chain pkg-chain.xlsx out-N20.xlsx
    left_none N20 "$B/out-N20.xlsx"
    echo "command: emend-copy ... --drop-calc-chain xl/calcChain.xml (an argument it does not take)"
    ec_case N21 2 "error: $USAGE" pkg-chain.xlsx out-N21.xlsx --drop-calc-chain xl/calcChain.xml
    left_none N21 "$B/out-N21.xlsx"
    
    echo
    echo "## N22: the accepted --drop-calc-chain, on a package with a chain and on one without"
    # The positive control for P3's own operation, and the only place in this log
    # where the recipe actually edits. What is asserted is the recipe's whole
    # contract as specs/0009 states it: the chain's entry gone, its override and
    # its relationship gone, every other entry byte for byte, and a package with no
    # chain returned unchanged.
    echo "command: emend-copy <scratch>/pkg-chain.xlsx <scratch>/out-N22.xlsx --drop-calc-chain"
    ec_case N22 0 "" pkg-chain.xlsx out-N22.xlsx --drop-calc-chain
    python3 - "$B/pkg-chain.xlsx" "$B/out-N22.xlsx" >"$B/N22.check" 2>&1 <<'N22_PY'
    import sys, zipfile
    
    src, out = zipfile.ZipFile(sys.argv[1]), zipfile.ZipFile(sys.argv[2])
    sn, on = src.namelist(), out.namelist()
    print("entries in %d, entries out %d" % (len(sn), len(on)))
    print("the chain's entry is gone: %s" % ("yes" if "xl/calcChain.xml" not in on else "no"))
    print("order preserved among the entries that stayed: %s"
          % ("yes" if [n for n in sn if n in on] == on else "no"))
    ct = out.read("[Content_Types].xml").decode()
    rels = out.read("xl/_rels/workbook.xml.rels").decode()
    print("the chain's override is gone: %s" % ("yes" if "calcChain" not in ct else "no"))
    print("the chain's relationship is gone: %s" % ("yes" if "calcChain" not in rels else "no"))
    rest = [n for n in on if n not in ("[Content_Types].xml", "xl/_rels/workbook.xml.rels")]
    same = [n for n in rest if src.read(n) == out.read(n)]
    print("other parts %d, of them byte-identical %d" % (len(rest), len(same)))
    N22_PY
    sed 's/^/      /' "$B/N22.check"
    n22_recipe() {
      [ "$(count_matches -Fx "the chain's entry is gone: yes" "$B/N22.check")" = 1 ] || return 1
      [ "$(count_matches -Fx "the chain's override is gone: yes" "$B/N22.check")" = 1 ] || return 1
      [ "$(count_matches -Fx "the chain's relationship is gone: yes" "$B/N22.check")" = 1 ] || return 1
      [ "$(count_matches -Fx "entries in 6, entries out 5" "$B/N22.check")" = 1 ] || return 1
      [ "$(count_matches -Fx "order preserved among the entries that stayed: yes" "$B/N22.check")" = 1 ] || return 1
      [ "$(count_matches -Fx "other parts 3, of them byte-identical 3" "$B/N22.check")" = 1 ] || return 1
    }
    note "N22 the recipe dropped the chain's three things and left every other entry alone" \
      "$(is n22_recipe)"
    echo "command: emend-copy <scratch>/pkg.xlsx <scratch>/out-N22b.xlsx --drop-calc-chain"
    ec_case N22b 0 "" pkg.xlsx out-N22b.xlsx --drop-calc-chain
    n22b_same=$(cmp -s "$B/pkg.xlsx" "$B/out-N22b.xlsx" && echo yes || echo no)
    echo "  N22b byte-identical to the input: $n22b_same"
    note "N22b a package with no chain comes back byte for byte" "$(is [ "$n22b_same" = yes ])"
    
    echo
    echo "## N23 to N28: --shared-strings among the operations, refused in pairs"
    # The operation part 3 P1 adds. In part 2 --shared-strings was an unknown
    # operation, so a part 2 case asserting it refused for THAT reason would now
    # assert the opposite of the truth; the cases below refuse it only where two
    # operations meet, where an operation comes before the paths, or where it is
    # handed an argument it does not take. Its accepted form is the T family.
    echo "command: emend-copy <scratch>/pkg-sst.xlsx <scratch>/out-N23.xlsx --shared-strings --survey"
    ec_case N23 2 "error: $USAGE" pkg-sst.xlsx out-N23.xlsx --shared-strings --survey
    left_none N23 "$B/out-N23.xlsx"
    echo "command: emend-copy ... --survey --shared-strings"
    ec_case N24 2 "error: $USAGE" pkg-sst.xlsx out-N24.xlsx --survey --shared-strings
    left_none N24 "$B/out-N24.xlsx"
    echo "command: emend-copy ... --shared-strings --shared-strings"
    ec_case N25 2 "error: $USAGE" pkg-sst.xlsx out-N25.xlsx --shared-strings --shared-strings
    left_none N25 "$B/out-N25.xlsx"
    echo "command: emend-copy ... --shared-strings --drop-calc-chain"
    ec_case N26 2 "error: $USAGE" pkg-sst.xlsx out-N26.xlsx --shared-strings --drop-calc-chain
    left_none N26 "$B/out-N26.xlsx"
    echo "command: emend-copy --shared-strings <scratch>/pkg-sst.xlsx <scratch>/out-N27.xlsx (before the paths)"
    ec_case N27 2 "error: $USAGE" --shared-strings pkg-sst.xlsx out-N27.xlsx
    left_none N27 "$B/out-N27.xlsx"
    echo "command: emend-copy ... --shared-strings items (an argument it does not take)"
    ec_case N28 2 "error: $USAGE" pkg-sst.xlsx out-N28.xlsx --shared-strings items
    left_none N28 "$B/out-N28.xlsx"
    
    echo
    echo "## N29 to N34: --cells among the operations, refused in pairs"
    # The operation part 3 P2 adds. In part 3 P1 --cells was an unknown operation,
    # so a P1 case asserting it refused for THAT reason would now assert the
    # opposite of the truth; the cases below refuse it only where two operations
    # meet, where an operation comes before the paths, or where it is handed an
    # argument it does not take. Its accepted form is the U family.
    echo "command: emend-copy <scratch>/pkg-cells.xlsx <scratch>/out-N29.xlsx --cells --survey"
    ec_case N29 2 "error: $USAGE" pkg-cells.xlsx out-N29.xlsx --cells --survey
    left_none N29 "$B/out-N29.xlsx"
    echo "command: emend-copy ... --survey --cells"
    ec_case N30 2 "error: $USAGE" pkg-cells.xlsx out-N30.xlsx --survey --cells
    left_none N30 "$B/out-N30.xlsx"
    echo "command: emend-copy ... --cells --cells"
    ec_case N31 2 "error: $USAGE" pkg-cells.xlsx out-N31.xlsx --cells --cells
    left_none N31 "$B/out-N31.xlsx"
    echo "command: emend-copy ... --cells --shared-strings"
    ec_case N32 2 "error: $USAGE" pkg-cells.xlsx out-N32.xlsx --cells --shared-strings
    left_none N32 "$B/out-N32.xlsx"
    echo "command: emend-copy --cells <scratch>/pkg-cells.xlsx <scratch>/out-N33.xlsx (before the paths)"
    ec_case N33 2 "error: $USAGE" --cells pkg-cells.xlsx out-N33.xlsx
    left_none N33 "$B/out-N33.xlsx"
    echo "command: emend-copy ... --cells sheet1 (an argument it does not take)"
    ec_case N34 2 "error: $USAGE" pkg-cells.xlsx out-N34.xlsx --cells sheet1
    left_none N34 "$B/out-N34.xlsx"
    
    # The usage text the cases above expect must NAME both operations part 3 adds,
    # or every one of them would pass against a usage line that had never heard of
    # either. The two are checked separately: one check covering both would pass
    # on a usage line naming only the older one.
    printf '%s\n' "$USAGE" >"$B/usage.txt"
    nusage_op=$(count_matches -F '--shared-strings' "$B/usage.txt")
    echo "  the usage text read from the source names --shared-strings: $nusage_op time(s)"
    note "the usage line the refusals above quote names part 3 P1's operation" \
      "$(is [ "$nusage_op" -ge 1 ])"
    nusage_cells=$(count_matches -F '--cells' "$B/usage.txt")
    echo "  the usage text read from the source names --cells: $nusage_cells time(s)"
    note "the usage line the refusals above quote names --cells, part 3 P2's operation" \
      "$(is [ "$nusage_cells" -ge 1 ])"
    # The control for the form, in the same command form: an operation the tool
    # has no such flag for is named nowhere in the usage text.
    nusage_ctl=$(count_matches -F '--no-such-operation' "$B/usage.txt")
    echo "  the usage text names --no-such-operation: $nusage_ctl time(s)"
    note "control: a flag the tool does not have is named nowhere in the usage text" \
      "$(is [ "$nusage_ctl" = 0 ])"
    
    echo
    echo "## N35 to N41: --edit-sample among the operations (part 4 P2)"
    echo "command: emend-copy <scratch>/pkg-edit.xlsx <scratch>/out-N35.xlsx --edit-sample --cells"
    ec_case N35 2 "error: $USAGE" pkg-edit.xlsx out-N35.xlsx --edit-sample --cells
    left_none N35 "$B/out-N35.xlsx"
    echo "command: emend-copy ... --cells --edit-sample"
    ec_case N36 2 "error: $USAGE" pkg-edit.xlsx out-N36.xlsx --cells --edit-sample
    left_none N36 "$B/out-N36.xlsx"
    echo "command: emend-copy ... --edit-sample --edit-sample"
    ec_case N37 2 "error: $USAGE" pkg-edit.xlsx out-N37.xlsx --edit-sample --edit-sample
    left_none N37 "$B/out-N37.xlsx"
    echo "command: emend-copy ... --edit-sample --drop-calc-chain"
    ec_case N38 2 "error: $USAGE" pkg-edit.xlsx out-N38.xlsx --edit-sample --drop-calc-chain
    left_none N38 "$B/out-N38.xlsx"
    echo "command: emend-copy --edit-sample <scratch>/pkg-edit.xlsx <scratch>/out-N39.xlsx (before the paths)"
    ec_case N39 2 "error: $USAGE" --edit-sample pkg-edit.xlsx out-N39.xlsx
    left_none N39 "$B/out-N39.xlsx"
    echo "command: emend-copy ... --edit-sample A1 (an argument it does not take)"
    ec_case N40 2 "error: $USAGE" pkg-edit.xlsx out-N40.xlsx --edit-sample A1
    left_none N40 "$B/out-N40.xlsx"
    printf '%s\n' "$USAGE" >"$B/usage-p2.txt"
    nusage_edit=$(count_matches -F '--edit-sample' "$B/usage-p2.txt")
    echo "  the usage text read from the source names --edit-sample: $nusage_edit time(s)"
    note "the usage line the refusals above quote names --edit-sample" "$(is [ "$nusage_edit" -ge 1 ])"
    echo "command: emend-copy <scratch>/pkg-edit.xlsx <scratch>/out-N41.xlsx --edit-sample (the accepted form)"
    ec_case N41 0 "" pkg-edit.xlsx out-N41.xlsx --edit-sample
    note "N41 wrote an output" "$(is [ -f "$B/out-N41.xlsx" ])"
    
    echo
    echo "## N42 to N48: --edit-formula-sample among the operations (part 4 P3)"
    echo "command: emend-copy <scratch>/pkg-fs-chain.xlsx <scratch>/out-N42.xlsx --edit-formula-sample --edit-sample"
    ec_case N42 2 "error: $USAGE" pkg-fs-chain.xlsx out-N42.xlsx --edit-formula-sample --edit-sample
    left_none N42 "$B/out-N42.xlsx"
    echo "command: emend-copy ... --edit-sample --edit-formula-sample"
    ec_case N43 2 "error: $USAGE" pkg-fs-chain.xlsx out-N43.xlsx --edit-sample --edit-formula-sample
    left_none N43 "$B/out-N43.xlsx"
    echo "command: emend-copy ... --edit-formula-sample --edit-formula-sample"
    ec_case N44 2 "error: $USAGE" pkg-fs-chain.xlsx out-N44.xlsx --edit-formula-sample --edit-formula-sample
    left_none N44 "$B/out-N44.xlsx"
    echo "command: emend-copy ... --edit-formula-sample --drop-calc-chain"
    ec_case N45 2 "error: $USAGE" pkg-fs-chain.xlsx out-N45.xlsx --edit-formula-sample --drop-calc-chain
    left_none N45 "$B/out-N45.xlsx"
    echo "command: emend-copy --edit-formula-sample <scratch>/pkg-fs-chain.xlsx <scratch>/out-N46.xlsx (before the paths)"
    ec_case N46 2 "error: $USAGE" --edit-formula-sample pkg-fs-chain.xlsx out-N46.xlsx
    left_none N46 "$B/out-N46.xlsx"
    echo "command: emend-copy ... --edit-formula-sample C2 (an argument it does not take)"
    ec_case N47 2 "error: $USAGE" pkg-fs-chain.xlsx out-N47.xlsx --edit-formula-sample C2
    left_none N47 "$B/out-N47.xlsx"
    nusage_formula=$(count_matches -F '--edit-formula-sample' "$B/usage-p2.txt")
    echo "  the usage text read from the source names --edit-formula-sample: $nusage_formula time(s)"
    note "the usage line the refusals above quote names --edit-formula-sample" "$(is [ "$nusage_formula" -ge 1 ])"
    echo "command: emend-copy <scratch>/pkg-fs-chain.xlsx <scratch>/out-N48.xlsx --edit-formula-sample (the accepted form)"
    ec_case N48 0 "" pkg-fs-chain.xlsx out-N48.xlsx --edit-formula-sample
    note "N48 wrote an output" "$(is [ -f "$B/out-N48.xlsx" ])"
    
    echo
    echo "## N49 to N55: --styles among the operations (part 5 P1)"
    echo "command: emend-copy <scratch>/pkg-styles.xlsx <scratch>/out-N49.xlsx --styles --survey"
    ec_case N49 2 "error: $USAGE" pkg-styles.xlsx out-N49.xlsx --styles --survey
    left_none N49 "$B/out-N49.xlsx"
    echo "command: emend-copy ... --cells --styles"
    ec_case N50 2 "error: $USAGE" pkg-styles.xlsx out-N50.xlsx --cells --styles
    left_none N50 "$B/out-N50.xlsx"
    echo "command: emend-copy ... --styles --styles"
    ec_case N51 2 "error: $USAGE" pkg-styles.xlsx out-N51.xlsx --styles --styles
    left_none N51 "$B/out-N51.xlsx"
    echo "command: emend-copy ... --styles --edit-sample"
    ec_case N52 2 "error: $USAGE" pkg-styles.xlsx out-N52.xlsx --styles --edit-sample
    left_none N52 "$B/out-N52.xlsx"
    echo "command: emend-copy --styles <scratch>/pkg-styles.xlsx <scratch>/out-N53.xlsx (before the paths)"
    ec_case N53 2 "error: $USAGE" --styles pkg-styles.xlsx out-N53.xlsx
    left_none N53 "$B/out-N53.xlsx"
    echo "command: emend-copy ... --styles xl/styles.xml (an argument it does not take)"
    ec_case N54 2 "error: $USAGE" pkg-styles.xlsx out-N54.xlsx --styles xl/styles.xml
    left_none N54 "$B/out-N54.xlsx"
    nusage_styles=$(count_matches -F '--styles' "$B/usage-p2.txt")
    echo "  the usage text read from the source names --styles: $nusage_styles time(s)"
    note "the usage line the refusals above quote names --styles" "$(is [ "$nusage_styles" -ge 1 ])"
    echo "command: emend-copy <scratch>/pkg-styles.xlsx <scratch>/out-N55.xlsx --styles (the accepted form)"
    ec_case N55 0 "" pkg-styles.xlsx out-N55.xlsx --styles
    note "N55 wrote an output" "$(is [ -f "$B/out-N55.xlsx" ])"
    
    # e_line <label>: the one line a case printed on stdout, tabs shown as |.
    e_line() { tr '\t' '|' <"$B/$1.out"; }
    # only_sheet_changed <input> <output>: python3's zipfile reads both archives;
    # the entry names and order are the same, the worksheet part's bytes differ,
    # and every other entry's bytes, CRC and method are the input's. Prints yes
    # or the first entry that breaks it (an entry NAME of a generated fixture).
    only_sheet_changed() {
      python3 - "$1" "$2" <<'ZIP_PY'
    import sys, zipfile
    a, b = (zipfile.ZipFile(p) for p in sys.argv[1:3])
    ia, ib = a.infolist(), b.infolist()
    if [i.filename for i in ia] != [i.filename for i in ib]:
        print("the entry names or their order differ"); sys.exit(0)
    for x, y in zip(ia, ib):
        same = (a.read(x) == b.read(y) and x.CRC == y.CRC
                and x.compress_type == y.compress_type)
        if x.filename == "xl/worksheets/sheet1.xml":
            if same:
                print("the worksheet part is unchanged"); sys.exit(0)
        elif not same:
            print("changed: " + x.filename); sys.exit(0)
    print("yes")
    ZIP_PY
    }
    
    echo
    echo "## E1 and E2: the accepted --edit-sample, the positive controls for the E family"
    # E1 is the U family's six-cell worksheet: A1 a styled number (A), B1 an
    # unstyled shared string (B, dropped by its clear), C1 a boolean and A2, B2
    # formulas that are not candidates, C2 empty; M is 2. E2 is an empty
    # <sheetData/>: no A, no B, M 0. The lines are the integration tests'.
    echo "command: emend-copy <scratch>/pkg-edit.xlsx <scratch>/out-E1.xlsx --edit-sample"
    ec_case E1 0 "" pkg-edit.xlsx out-E1.xlsx --edit-sample
    echo "  E1 stdout: $(e_line E1)"
    note "E1 prints the line for set 3, cleared 1, dropped 1, 6 cells before and 7 after, read_back 3" \
      "$(is [ "$(e_line E1)" = "edit|set=3|cleared=1|dropped=1|rows_added=1|cells_before=6|cells_after=7|read_back=3" ])"
    e1_zip=$(only_sheet_changed "$B/pkg-edit.xlsx" "$B/out-E1.xlsx")
    echo "  E1 entries: $e1_zip"
    note "E1 changed the worksheet part and no other entry" "$(is [ "$e1_zip" = yes ])"
    echo "command: emend-copy <scratch>/pkg-edit-empty.xlsx <scratch>/out-E2.xlsx --edit-sample"
    ec_case E2 0 "" pkg-edit-empty.xlsx out-E2.xlsx --edit-sample
    echo "  E2 stdout: $(e_line E2)"
    note "E2 prints the line for set 2, nothing cleared, 0 cells before and 2 after, read_back 2" \
      "$(is [ "$(e_line E2)" = "edit|set=2|cleared=0|dropped=0|rows_added=1|cells_before=0|cells_after=2|read_back=2" ])"
    e2_zip=$(only_sheet_changed "$B/pkg-edit-empty.xlsx" "$B/out-E2.xlsx")
    echo "  E2 entries: $e2_zip"
    note "E2 changed the worksheet part and no other entry" "$(is [ "$e2_zip" = yes ])"
    # The control for the comparison form: an archive compared with itself is
    # found to have an unchanged worksheet part, so "yes" is not what it always
    # says.
    ectl_zip=$(only_sheet_changed "$B/pkg-edit.xlsx" "$B/pkg-edit.xlsx")
    echo "  control, pkg-edit against itself: $ectl_zip"
    note "control: the comparison form reports an unchanged worksheet part" \
      "$(is [ "$ectl_zip" = "the worksheet part is unchanged" ])"
    
    echo
    echo "## E3 to E7: five cell-edit messages, through the built binary"
    echo "command: emend-copy <scratch>/pkg-edit-order.xlsx <scratch>/out-E3.xlsx --edit-sample"
    ec_case E3 2 "error: $(msg_of 'a worksheet whose rows or cells are out of order cannot be edited')" \
      pkg-edit-order.xlsx out-E3.xlsx --edit-sample
    left_none E3 "$B/out-E3.xlsx"
    echo "command: emend-copy <scratch>/pkg-edit-noref.xlsx <scratch>/out-E4.xlsx --edit-sample"
    ec_case E4 2 "error: $(msg_of 'a worksheet without explicit references cannot be edited')" \
      pkg-edit-noref.xlsx out-E4.xlsx --edit-sample
    left_none E4 "$B/out-E4.xlsx"
    echo "command: emend-copy <scratch>/pkg-edit-cm.xlsx <scratch>/out-E5.xlsx --edit-sample"
    ec_case E5 2 "error: $(msg_of 'a cell carries an attribute this layer does not model')" \
      pkg-edit-cm.xlsx out-E5.xlsx --edit-sample
    left_none E5 "$B/out-E5.xlsx"
    echo "command: emend-copy <scratch>/pkg-edit-array.xlsx <scratch>/out-E6.xlsx --edit-sample"
    ec_case E6 2 "error: $(msg_of 'a cell in a shared, array or data table formula cannot be edited')" \
      pkg-edit-array.xlsx out-E6.xlsx --edit-sample
    left_none E6 "$B/out-E6.xlsx"
    echo "command: emend-copy <scratch>/pkg-edit-nodata.xlsx <scratch>/out-E7.xlsx --edit-sample"
    ec_case E7 2 "error: $(msg_of 'a worksheet without sheetData cannot be edited')" \
      pkg-edit-nodata.xlsx out-E7.xlsx --edit-sample
    left_none E7 "$B/out-E7.xlsx"
    for key in 'a worksheet whose rows or cells are out of order cannot be edited' \
               'a worksheet without explicit references cannot be edited' \
               'a cell carries an attribute this layer does not model' \
               'a cell in a shared, array or data table formula cannot be edited' \
               'a worksheet without sheetData cannot be edited'; do
      note "the key [$key] names exactly one message" "$(is msg_one "$key")"
    done
    
    echo
    echo "## E8 and E9: the tool's own refusals"
    echo "command: emend-copy <scratch>/pkg-edit-chart.xlsx <scratch>/out-E8.xlsx --edit-sample"
    ec_case E8 2 "error: $NOWS_MSG" pkg-edit-chart.xlsx out-E8.xlsx --edit-sample
    left_none E8 "$B/out-E8.xlsx"
    echo "command: emend-copy <scratch>/pkg-edit-lastrow.xlsx <scratch>/out-E9.xlsx --edit-sample"
    ec_case E9 2 "error: $NOROW_MSG" pkg-edit-lastrow.xlsx out-E9.xlsx --edit-sample
    left_none E9 "$B/out-E9.xlsx"
    
    echo
    echo "## E10: no refused --edit-sample printed a line"
    nrefused_out=0
    for l in E3 E4 E5 E6 E7 E8 E9; do
      n=$(wc -c <"$B/$l.out")
      echo "  $l stdout bytes: $n"
      nrefused_out=$((nrefused_out + n))
    done
    note "the seven refused runs printed nothing on stdout" "$(is [ "$nrefused_out" = 0 ])"
    note "control: the same count on E1's stdout is not zero" "$(is [ "$(wc -c <"$B/E1.out")" -gt 0 ])"
    
    # entries_class <input> <output>: python3's zipfile reads both archives and
    # prints, on one line, each input entry's name and whether the output holds it
    # identical (bytes, CRC and method), changed, or dropped, then any entry the
    # output adds. Entry names of generated fixtures only.
    entries_class() {
      python3 - "$1" "$2" <<'ZIP_PY'
    import sys, zipfile
    a, b = (zipfile.ZipFile(p) for p in sys.argv[1:3])
    nb = {i.filename: i for i in b.infolist()}
    parts = []
    for x in a.infolist():
        y = nb.pop(x.filename, None)
        if y is None:
            parts.append(x.filename + " dropped")
        elif (a.read(x) == b.read(y) and x.CRC == y.CRC
              and x.compress_type == y.compress_type):
            parts.append(x.filename + " identical")
        else:
            parts.append(x.filename + " changed")
    for name in nb:
        parts.append(name + " added")
    print("; ".join(parts))
    ZIP_PY
    }
    # sheet_cells <archive>: each cell of the worksheet part as reference, s, t,
    # whether it has a formula, and its value text, one line per cell.
    sheet_cells() {
      python3 - "$1" <<'CELLS_PY'
    import sys, zipfile
    import xml.etree.ElementTree as ET
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    root = ET.fromstring(zipfile.ZipFile(sys.argv[1]).read("xl/worksheets/sheet1.xml"))
    for c in root.iter(M + "c"):
        v = c.find(M + "v")
        print("%s s=%s t=%s f=%s v=%s" % (c.get("r"), c.get("s"), c.get("t"),
              "yes" if c.find(M + "f") is not None else "no",
              None if v is None else v.text))
    CELLS_PY
    }
    
    echo
    echo "## F1 to F3: the accepted --edit-formula-sample, the positive controls for the F family"
    # F1 and F2 are the integration tests' formula worksheet: the first normal
    # formula in document order is C2, which becomes the number 1 with its s
    # kept; five cells before and after. F1's package has a chain, F2's has none.
    # F3 is pkg-edit, whose only formulas are shared: no normal formula.
    echo "command: emend-copy <scratch>/pkg-fs-chain.xlsx <scratch>/out-F1.xlsx --edit-formula-sample"
    ec_case F1 0 "" pkg-fs-chain.xlsx out-F1.xlsx --edit-formula-sample
    echo "  F1 stdout: $(e_line F1)"
    note "F1 prints formula_replaced 1, chain_dropped 1, cells_after 5, read_back 1" \
      "$(is [ "$(e_line F1)" = "edit|formula_replaced=1|chain_dropped=1|cells_after=5|read_back=1" ])"
    f1_entries=$(entries_class "$B/pkg-fs-chain.xlsx" "$B/out-F1.xlsx")
    echo "  F1 entries: $f1_entries"
    note "F1 changed the sheet, the content types and the workbook's rels, dropped the chain, and kept the rest" \
      "$(is [ "$f1_entries" = "[Content_Types].xml changed; _rels/.rels identical; xl/workbook.xml identical; xl/_rels/workbook.xml.rels changed; xl/worksheets/sheet1.xml changed; xl/calcChain.xml dropped" ])"
    sheet_cells "$B/pkg-fs-chain.xlsx" >"$B/F1.cells-in"
    sheet_cells "$B/out-F1.xlsx" >"$B/F1.cells-out"
    echo "  F1 cells in, then out:"
    sed 's/^/    in:  /' "$B/F1.cells-in"
    sed 's/^/    out: /' "$B/F1.cells-out"
    # The input's cells with C2's line replaced by the edit, built from the input
    # by the script rather than typed.
    sed 's/^C2 s=3 t=None f=yes v=3$/C2 s=3 t=None f=no v=1/' "$B/F1.cells-in" >"$B/F1.cells-want"
    f1_cells_as_edited() {
      cmp -s "$B/F1.cells-want" "$B/F1.cells-out" || return 1
      if cmp -s "$B/F1.cells-in" "$B/F1.cells-want"; then return 1; fi
    }
    note "F1's cells are the input's with C2 alone replaced by the number 1, its s kept and its formula gone" \
      "$(is f1_cells_as_edited)"
    echo "command: emend-copy <scratch>/pkg-fs-nochain.xlsx <scratch>/out-F2.xlsx --edit-formula-sample"
    ec_case F2 0 "" pkg-fs-nochain.xlsx out-F2.xlsx --edit-formula-sample
    echo "  F2 stdout: $(e_line F2)"
    note "F2 prints formula_replaced 1, chain_dropped 0, cells_after 5, read_back 1" \
      "$(is [ "$(e_line F2)" = "edit|formula_replaced=1|chain_dropped=0|cells_after=5|read_back=1" ])"
    f2_entries=$(only_sheet_changed "$B/pkg-fs-nochain.xlsx" "$B/out-F2.xlsx")
    echo "  F2 entries: $f2_entries"
    note "F2 changed the worksheet part and no other entry" "$(is [ "$f2_entries" = yes ])"
    echo "command: emend-copy <scratch>/pkg-edit.xlsx <scratch>/out-F3.xlsx --edit-formula-sample"
    ec_case F3 0 "" pkg-edit.xlsx out-F3.xlsx --edit-formula-sample
    echo "  F3 stdout: $(e_line F3)"
    note "F3 prints every key 0 (cells_after 0: no sheet was read)" \
      "$(is [ "$(e_line F3)" = "edit|formula_replaced=0|chain_dropped=0|cells_after=0|read_back=0" ])"
    note "F3's output is the input's bytes" "$(is cmp -s "$B/pkg-edit.xlsx" "$B/out-F3.xlsx")"
    # The control for the entry classes: an archive against itself is identical
    # in every entry, and F1's input against F2's output is not.
    fctl_same=$(entries_class "$B/pkg-fs-chain.xlsx" "$B/pkg-fs-chain.xlsx")
    echo "  control, pkg-fs-chain against itself: $fctl_same"
    note "control: the class form reads an archive against itself as identical throughout" \
      "$(is [ "$(printf '%s' "$fctl_same" | LC_ALL=C "$G" -o -E ' (changed|dropped|added)' | wc -l)" = 0 ])"
    
    echo
    echo "## F4 and F5: the missing-r and array refusals, through --edit-sample"
    # Part 4 P3 ruling 7's two fixtures, through --edit-sample under this family's
    # labels. Their probe runs (F4b, F5b) and the probe's positive control (F6)
    # need the release probe a size log builds; P1 has none (header change 3).
    NOREF_MSG="error: $(msg_of 'a worksheet without explicit references cannot be edited')"
    ARRAY_MSG="error: $(msg_of 'a cell in a shared, array or data table formula cannot be edited')"
    echo "command: emend-copy <scratch>/pkg-edit-noref.xlsx <scratch>/out-F4a.xlsx --edit-sample"
    ec_case F4a 2 "$NOREF_MSG" pkg-edit-noref.xlsx out-F4a.xlsx --edit-sample
    left_none F4a "$B/out-F4a.xlsx"
    echo "command: emend-copy <scratch>/pkg-edit-array.xlsx <scratch>/out-F5a.xlsx --edit-sample"
    ec_case F5a 2 "$ARRAY_MSG" pkg-edit-array.xlsx out-F5a.xlsx --edit-sample
    left_none F5a "$B/out-F5a.xlsx"
    
    echo
    echo "## F7: the forbidden-text message, reached by no binary (ruling 7)"
    # Every binary writes its own constant text ("emend", "probe"), so no command
    # line can bring a character XML forbids into a written text. The message is
    # named from the source that raises it and beside the package test that
    # reaches it.
    FORBID='a text holds a character XML cannot carry'
    echo "command: grep -n for the message in crates/emend/src/cells.rs and crates/emend/src/package/tests.rs"
    LC_ALL=C "$G" -n -F "$FORBID" "$MAIN/crates/emend/src/cells.rs" "$MAIN/crates/emend/src/package/tests.rs" |
      sed "s#$MAIN/##; s/^/    /"
    echo "command: grep -n 'fn a_text_with_a_character_xml_forbids_is_refused' crates/emend/src/package/tests.rs"
    LC_ALL=C "$G" -n 'fn a_text_with_a_character_xml_forbids_is_refused' "$MAIN/crates/emend/src/package/tests.rs" | sed 's/^/    /'
    f7_named() {
      [ "$(count_matches -F "Err(Error::Package(\"$FORBID\"))" "$MAIN/crates/emend/src/cells.rs")" = 1 ] || return 1
      [ "$(count_matches -F 'fn a_text_with_a_character_xml_forbids_is_refused()' "$MAIN/crates/emend/src/package/tests.rs")" = 1 ] || return 1
      [ "$(count_matches -F "\"$FORBID\"" "$MAIN/crates/emend/src/package/tests.rs")" -ge 1 ]
    }
    note "the message is raised once in cells.rs, and the package test that asserts it exists" "$(is f7_named)"
    note "the message is in the library's list" "$(is msg_one "$FORBID")"
    
    echo
    echo "## Y1 and Y2: the accepted --styles, the positive controls for the Y family"
    # Without these the refusals below could be the fixture builder's fault. The
    # line is asserted IN FULL, key by key, and the output is asserted to be the
    # input's bytes: --styles records no edit. The expected lines are the
    # fixture's own hand count (see STYLES_SOUND in the generator): four cell
    # formats, two custom number formats, two xfs whose format is a date (built-in
    # 14 and the custom date), date1904 0, and 1 for the same styles part in a
    # workbook that sets date1904.
    YTAB=$(printf '\t')
    Y1_EXPECT="styles${YTAB}xfs=4${YTAB}num_fmts=2${YTAB}custom=2${YTAB}dated=2${YTAB}date1904=0"
    Y2_EXPECT="styles${YTAB}xfs=4${YTAB}num_fmts=2${YTAB}custom=2${YTAB}dated=2${YTAB}date1904=1"
    echo "command: emend-copy <scratch>/pkg-styles.xlsx <scratch>/out-Y1.xlsx --styles"
    ec_case Y1 0 "" pkg-styles.xlsx out-Y1.xlsx --styles
    echo "  Y1 stdout: $(e_line Y1)"
    note "Y1 printed the line the fixture calls for, key by key" "$(is [ "$(cat "$B/Y1.out")" = "$Y1_EXPECT" ])"
    note "Y1 the output is the input's bytes" "$(is cmp -s "$B/pkg-styles.xlsx" "$B/out-Y1.xlsx")"
    echo "command: emend-copy <scratch>/pkg-styles-1904.xlsx <scratch>/out-Y2.xlsx --styles"
    ec_case Y2 0 "" pkg-styles-1904.xlsx out-Y2.xlsx --styles
    echo "  Y2 stdout: $(e_line Y2)"
    note "Y2 printed the same line with date1904=1" "$(is [ "$(cat "$B/Y2.out")" = "$Y2_EXPECT" ])"
    note "Y2 the output is the input's bytes" "$(is cmp -s "$B/pkg-styles-1904.xlsx" "$B/out-Y2.xlsx")"
    # The control for the full-line comparison, in the same command form: Y1's
    # line is not Y2's, so the comparison is not one that accepts either.
    note "control: Y1's line is not the line Y2 calls for" "$(isnot [ "$(cat "$B/Y1.out")" = "$Y2_EXPECT" ])"
    
    echo
    echo "## Y3 to Y7: the five reading messages, each through --styles"
    # specs/0012, "Errors": the five the reading raises, each reached from the
    # command line and each message read from the committed source by msg_of.
    y_case() {
      local label=$1 fixture=$2 key=$3 msg
      note "$label: the key names exactly one of the layer's messages" "$(is msg_one "$key")"
      msg=$(msg_of "$key")
      echo "command: emend-copy <scratch>/$fixture.xlsx <scratch>/out-$label.xlsx --styles"
      ec_case "$label" 2 "error: $msg" "$fixture.xlsx" "out-$label.xlsx" --styles
      left_none "$label" "$B/out-$label.xlsx"
      note "$label printed no styles line" "$(is [ ! -s "$B/$label.out" ])"
    }
    y_case Y3 pkg 'the workbook has no styles part'
    y_case Y4 pkg-styles-root "the styles part's root is not styleSheet"
    y_case Y5 pkg-styles-nocode 'a numFmt lacks numFmtId or formatCode'
    y_case Y6 pkg-styles-notanum 'a style attribute is not a number'
    y_case Y7 pkg-styles-two 'the styles part has more than one numFmts or cellXfs'
    
    echo
    echo "## Y8: the five messages of the additions and the write, named in the package tests"
    # P1 wrote this family when no binary added a cell format; the W family below
    # now reaches three of these five, and the V family says which (header). Each
    # is named from
    # the library's list (it must be one the source raises), from the package
    # module's catalogue (the lines after the lead sentence the second code commit
    # wrote), and beside a package test that asserts it.
    python3 - "$MAIN/crates/emend/src/package.rs" >"$B/catalogued-write" <<'CATW_PY'
    import re
    import sys
    
    text = open(sys.argv[1], encoding="utf-8").read()
    start = text.index("//! The additions and the style edits add five more")
    block = text[start:].split("\n//!\n", 2)[1]
    joined = re.sub(r"\n//!   ", " ", block)
    for message in re.findall(r'^//! - "([^"]*)"', joined, re.M):
        print(message)
    CATW_PY
    ncatw=$(count_lines "$B/catalogued-write")
    echo "  messages the catalogue lists after the second code commit's lead sentence: $ncatw"
    note "the catalogue lists five messages there" "$(is [ "$ncatw" = 5 ])"
    while IFS= read -r m; do
      in_list=$(count_matches -Fx "$m" "$B/messages")
      in_tests=$(count_matches -F "\"$m\"" "$MAIN/crates/emend/src/package/tests.rs")
      echo "  [$m]: in the library's list $in_list, quoted in the package tests $in_tests"
      y8_named() { [ "$in_list" = 1 ] && [ "$in_tests" -ge 1 ]; }
      note "the message is one the source raises and a package test asserts it" "$(is y8_named)"
    done <"$B/catalogued-write"
    note "control: a message no source raises is not in the library's list" \
      "$(is [ "$(count_matches -Fx 'no such message anywhere' "$B/messages")" = 0 ])"
    
    echo
    echo "## N56 to N62: --style-sample among the operations (part 5 P2)"
    echo "command: emend-copy <scratch>/pkg-styles.xlsx <scratch>/out-N56.xlsx --style-sample --survey"
    ec_case N56 2 "error: $USAGE" pkg-styles.xlsx out-N56.xlsx --style-sample --survey
    left_none N56 "$B/out-N56.xlsx"
    echo "command: emend-copy ... --styles --style-sample"
    ec_case N57 2 "error: $USAGE" pkg-styles.xlsx out-N57.xlsx --styles --style-sample
    left_none N57 "$B/out-N57.xlsx"
    echo "command: emend-copy ... --style-sample --style-sample"
    ec_case N58 2 "error: $USAGE" pkg-styles.xlsx out-N58.xlsx --style-sample --style-sample
    left_none N58 "$B/out-N58.xlsx"
    echo "command: emend-copy ... --style-sample --edit-sample"
    ec_case N59 2 "error: $USAGE" pkg-styles.xlsx out-N59.xlsx --style-sample --edit-sample
    left_none N59 "$B/out-N59.xlsx"
    echo "command: emend-copy --style-sample <scratch>/pkg-styles.xlsx <scratch>/out-N60.xlsx (before the paths)"
    ec_case N60 2 "error: $USAGE" --style-sample pkg-styles.xlsx out-N60.xlsx
    left_none N60 "$B/out-N60.xlsx"
    echo "command: emend-copy ... --style-sample xl/styles.xml (an argument it does not take)"
    ec_case N61 2 "error: $USAGE" pkg-styles.xlsx out-N61.xlsx --style-sample xl/styles.xml
    left_none N61 "$B/out-N61.xlsx"
    nusage_sample=$(count_matches -F '--style-sample' "$B/usage-p2.txt")
    echo "  the usage text read from the source names --style-sample: $nusage_sample time(s)"
    note "the usage line the refusals above quote names --style-sample" "$(is [ "$nusage_sample" -ge 1 ])"
    echo "command: emend-copy <scratch>/pkg-styles.xlsx <scratch>/out-N62.xlsx --style-sample (the accepted form)"
    ec_case N62 0 "" pkg-styles.xlsx out-N62.xlsx --style-sample
    note "N62 wrote an output" "$(is [ -f "$B/out-N62.xlsx" ])"
    
    echo
    echo "## Z1 and Z2: the accepted --style-sample, the positive controls for the Z family"
    # Without these the refusals below could be the fixture builder's fault. Each
    # line is asserted IN FULL, key by key, and each is this fixture's own hand
    # count: the styles part holds four cell formats and two custom number
    # formats, so xfs_before is 4 and xfs_after 6, and the code the sample adds is
    # one the part does not define, so formats_added is 1. pkg-styles-cells holds
    # the six cells of the U family, whose first is a styled number with a value
    # and no formula, so styled is 1 and read_back 3; pkg-styles has no cell at
    # all, so styled is 0, the sample styles the new cell alone and read_back is
    # 2. The outputs are NOT the input's bytes: this operation edits.
    ZTAB=$(printf '\t')
    Z1_EXPECT="edit${ZTAB}styled=1${ZTAB}added=1${ZTAB}xfs_before=4${ZTAB}xfs_after=6\
    ${ZTAB}formats_added=1${ZTAB}cells_before=6${ZTAB}cells_after=7${ZTAB}read_back=3"
    Z2_EXPECT="edit${ZTAB}styled=0${ZTAB}added=1${ZTAB}xfs_before=4${ZTAB}xfs_after=6\
    ${ZTAB}formats_added=1${ZTAB}cells_before=0${ZTAB}cells_after=1${ZTAB}read_back=2"
    echo "command: emend-copy <scratch>/pkg-styles-cells.xlsx <scratch>/out-Z1.xlsx --style-sample"
    ec_case Z1 0 "" pkg-styles-cells.xlsx out-Z1.xlsx --style-sample
    echo "  Z1 stdout: $(e_line Z1)"
    note "Z1 printed the line the fixture calls for, key by key" "$(is [ "$(cat "$B/Z1.out")" = "$Z1_EXPECT" ])"
    note "Z1 the output is not the input's bytes, since the sample edits" \
      "$(isnot cmp -s "$B/pkg-styles-cells.xlsx" "$B/out-Z1.xlsx")"
    echo "command: emend-copy <scratch>/pkg-styles.xlsx <scratch>/out-Z2.xlsx --style-sample"
    ec_case Z2 0 "" pkg-styles.xlsx out-Z2.xlsx --style-sample
    echo "  Z2 stdout: $(e_line Z2)"
    note "Z2 printed the line its own fixture calls for" "$(is [ "$(cat "$B/Z2.out")" = "$Z2_EXPECT" ])"
    note "Z2 the output is not the input's bytes either" \
      "$(isnot cmp -s "$B/pkg-styles.xlsx" "$B/out-Z2.xlsx")"
    # The control for the full-line comparison, in the same command form: Z1's
    # line is not Z2's, so the comparison is not one that accepts either.
    note "control: Z1's line is not the line Z2 calls for" "$(isnot [ "$(cat "$B/Z1.out")" = "$Z2_EXPECT" ])"
    
    echo
    echo "## Z3 and Z4: the two refusals --style-sample reaches from the command line"
    # The sample adds a cell format before it writes, so a workbook with no styles
    # part and one whose styles part the reader refuses both stop the run before
    # any output exists. The messages are read from the committed source, as the
    # Y family's are.
    z_case() {
      local label=$1 fixture=$2 key=$3 msg
      note "$label: the key names exactly one of the layer's messages" "$(is msg_one "$key")"
      msg=$(msg_of "$key")
      echo "command: emend-copy <scratch>/$fixture.xlsx <scratch>/out-$label.xlsx --style-sample"
      ec_case "$label" 2 "error: $msg" "$fixture.xlsx" "out-$label.xlsx" --style-sample
      left_none "$label" "$B/out-$label.xlsx"
      note "$label printed no edit line" "$(is [ ! -s "$B/$label.out" ])"
    }
    z_case Z3 pkg 'the workbook has no styles part'
    z_case Z4 pkg-styles-root "the styles part's root is not styleSheet"
    
    echo
    echo "## Z5: the tool's own assertion on the cell format count, reached by no fixture"
    # The sample asserts that the output's styles part holds exactly the formats
    # the edits imply, and removes the output when it does not. No fixture can
    # raise it while the library is sound, so it is named from the tool's source
    # and shown to be the message the tool would print, as F7 does for the
    # library message no binary reaches.
    XFS_MSG='the output.s styles part holds'
    nxfs_msg=$(count_matches -E "$XFS_MSG" "$MAIN/tools/emend-copy/src/main.rs")
    echo "  lines of the tool's source carrying the assertion's message: $nxfs_msg"
    note "the tool's source carries the message exactly once" "$(is [ "$nxfs_msg" = 1 ])"
    # The variant's declaration inside the enum carries no Error:: prefix, so
    # the pattern is the bare name: the three mentions are the declaration, the
    # display arm and the raise.
    nxfs_err=$(count_matches -F 'XfsAfter' "$MAIN/tools/emend-copy/src/main.rs")
    echo "  mentions of the assertion's error in the tool's source: $nxfs_err"
    # P3's date sample asserts the same count after its own write, so the error
    # is raised in two places now (header, Z1 to Z5).
    note "the error is declared, displayed, and raised by the style and date samples (four mentions)" \
      "$(is [ "$nxfs_err" = 4 ])"
    nremoves=$(count_matches -F 'let _ = fs::remove_file(output);' "$MAIN/tools/emend-copy/src/main.rs")
    echo "  places the tool removes a finished output after a failed check: $nremoves"
    note "the style sample removes its output on a failed check, as the edit sample does" \
      "$(is [ "$nremoves" -ge 2 ])"
    note "control: a message the tool's source does not carry is not found" \
      "$(is [ "$(count_matches -F 'no such tool message anywhere' "$MAIN/tools/emend-copy/src/main.rs")" = 0 ])"
    
    echo
    echo "## N63 to N69: --date-sample among the operations (part 5 P3)"
    echo "command: emend-copy <scratch>/pkg-styles.xlsx <scratch>/out-N63.xlsx --date-sample --survey"
    ec_case N63 2 "error: $USAGE" pkg-styles.xlsx out-N63.xlsx --date-sample --survey
    left_none N63 "$B/out-N63.xlsx"
    echo "command: emend-copy ... --style-sample --date-sample"
    ec_case N64 2 "error: $USAGE" pkg-styles.xlsx out-N64.xlsx --style-sample --date-sample
    left_none N64 "$B/out-N64.xlsx"
    echo "command: emend-copy ... --date-sample --date-sample"
    ec_case N65 2 "error: $USAGE" pkg-styles.xlsx out-N65.xlsx --date-sample --date-sample
    left_none N65 "$B/out-N65.xlsx"
    echo "command: emend-copy ... --date-sample --styles"
    ec_case N66 2 "error: $USAGE" pkg-styles.xlsx out-N66.xlsx --date-sample --styles
    left_none N66 "$B/out-N66.xlsx"
    echo "command: emend-copy --date-sample <scratch>/pkg-styles.xlsx <scratch>/out-N67.xlsx (before the paths)"
    ec_case N67 2 "error: $USAGE" --date-sample pkg-styles.xlsx out-N67.xlsx
    left_none N67 "$B/out-N67.xlsx"
    echo "command: emend-copy ... --date-sample xl/styles.xml (an argument it does not take)"
    ec_case N68 2 "error: $USAGE" pkg-styles.xlsx out-N68.xlsx --date-sample xl/styles.xml
    left_none N68 "$B/out-N68.xlsx"
    nusage_date=$(count_matches -F '--date-sample' "$B/usage-p2.txt")
    echo "  the usage text read from the source names --date-sample: $nusage_date time(s)"
    note "the usage line the refusals above quote names --date-sample" "$(is [ "$nusage_date" -ge 1 ])"
    echo "command: emend-copy <scratch>/pkg-styles.xlsx <scratch>/out-N69.xlsx --date-sample (the accepted form)"
    ec_case N69 0 "" pkg-styles.xlsx out-N69.xlsx --date-sample
    note "N69 wrote an output" "$(is [ -f "$B/out-N69.xlsx" ])"
    
    echo
    echo "## A1 and A2: the accepted --date-sample, the positive controls for the A family"
    # Each line is asserted IN FULL, key by key, and each is the fixture's own
    # hand count: the styles part holds four cell formats, so xfs_before is 4 and
    # xfs_after 5, the sample adding one; the sheet holds the U family's six
    # cells, so cells_before is 6 and cells_after 7. The serial is the tool's
    # constant 2024-02-29 12:00 in the workbook's epoch, the values specs/0012
    # pins: 45351.5 in the 1900 system and 43889.5 in the 1904 system. read_back
    # is 1: the new cell holds the serial with the new format, and from_serial of
    # it is the date written.
    ATAB=$(printf '\t')
    A1_EXPECT="edit${ATAB}date1904=0${ATAB}serial=45351.5${ATAB}added=1${ATAB}xfs_before=4${ATAB}xfs_after=5\
    ${ATAB}cells_before=6${ATAB}cells_after=7${ATAB}read_back=1"
    A2_EXPECT="edit${ATAB}date1904=1${ATAB}serial=43889.5${ATAB}added=1${ATAB}xfs_before=4${ATAB}xfs_after=5\
    ${ATAB}cells_before=6${ATAB}cells_after=7${ATAB}read_back=1"
    echo "command: emend-copy <scratch>/pkg-styles-cells.xlsx <scratch>/out-A1.xlsx --date-sample"
    ec_case A1 0 "" pkg-styles-cells.xlsx out-A1.xlsx --date-sample
    echo "  A1 stdout: $(e_line A1)"
    note "A1 printed the line the fixture calls for, key by key" "$(is [ "$(cat "$B/A1.out")" = "$A1_EXPECT" ])"
    note "A1 the output is not the input's bytes, since the sample edits" \
      "$(isnot cmp -s "$B/pkg-styles-cells.xlsx" "$B/out-A1.xlsx")"
    echo "command: emend-copy <scratch>/pkg-styles-cells-1904.xlsx <scratch>/out-A2.xlsx --date-sample"
    ec_case A2 0 "" pkg-styles-cells-1904.xlsx out-A2.xlsx --date-sample
    echo "  A2 stdout: $(e_line A2)"
    note "A2 printed the line its own fixture calls for, in the 1904 system" "$(is [ "$(cat "$B/A2.out")" = "$A2_EXPECT" ])"
    note "A2 the output is not the input's bytes either" \
      "$(isnot cmp -s "$B/pkg-styles-cells-1904.xlsx" "$B/out-A2.xlsx")"
    # The control for the full-line comparison, in the same command form: A1's
    # line is not A2's, so the epoch was read from each workbook.
    note "control: A1's line is not the line A2 calls for" "$(isnot [ "$(cat "$B/A1.out")" = "$A2_EXPECT" ])"
    
    echo
    echo "## A3 and A4: the two refusals --date-sample shares with --style-sample"
    a_case() {
      local label=$1 fixture=$2 key=$3 msg
      note "$label: the key names exactly one of the layer's messages" "$(is msg_one "$key")"
      msg=$(msg_of "$key")
      echo "command: emend-copy <scratch>/$fixture.xlsx <scratch>/out-$label.xlsx --date-sample"
      ec_case "$label" 2 "error: $msg" "$fixture.xlsx" "out-$label.xlsx" --date-sample
      left_none "$label" "$B/out-$label.xlsx"
      note "$label printed no edit line" "$(is [ ! -s "$B/$label.out" ])"
    }
    a_case A3 pkg 'the workbook has no styles part'
    a_case A4 pkg-styles-root "the styles part's root is not styleSheet"
    
    # pr_case <label> <input> <code>: the release probe on a fixture, its first
    # output out-<label>-1.xlsx and its second out-<label>-2.xlsx, the part it
    # replaces and the sheet it edits the worksheet part, the override a theme,
    # the number at A1, the text at E1, the boolean at A2, the clear at B1, and
    # the code given. It prints the exit, the stdout line count and stdout, the
    # stderr, and both outputs' presence and byte counts as measured (specs/0011
    # P3 ruling 8).
    pr_case() {
      local label=$1 input=$2 code=$3
      echo "command: probe-emend-styles-write-xml <scratch>/$input <scratch>/out-$label-1.xlsx xl/worksheets/sheet1.xml /xl/theme/theme1.xml application/x-theme xl/worksheets/sheet1.xml A1 E1 A2 B1 <scratch>/out-$label-2.xlsx '$code'"
      ( cd "$B" && "$PR" "$input" "out-$label-1.xlsx" xl/worksheets/sheet1.xml /xl/theme/theme1.xml \
          application/x-theme xl/worksheets/sheet1.xml A1 E1 A2 B1 "out-$label-2.xlsx" "$code" ) \
        >"$B/$label.out" 2>"$B/$label.err"
      PR_RC=$?
      echo "  $label: exit $PR_RC; stdout lines $(count_lines "$B/$label.out"); stdout bytes $(wc -c <"$B/$label.out"); stderr lines $(count_lines "$B/$label.err")"
      hide <"$B/$label.err" | sed 's/^/      /'
      local n
      for n in 1 2; do
        if [ -e "$B/out-$label-$n.xlsx" ]; then
          echo "  $label output $n: present, $(wc -c <"$B/out-$label-$n.xlsx") bytes"
        else
          echo "  $label output $n: absent"
        fi
      done
    }
    # pr_refused <label> <expected stderr line>: exit 2, stderr exactly that one
    # line, stdout empty (ruling 8's three assertions for the probe).
    pr_refused() {
      local label=$1 want=$2
      pr_ok() {
        [ "$PR_RC" -eq 2 ] || return 1
        [ "$(cat "$B/$label.err")" = "$want" ] || return 1
        [ "$(count_lines "$B/$label.err")" = 1 ] || return 1
        [ "$(wc -c <"$B/$label.out")" = 0 ]
      }
      note "$label the probe exits 2, stderr is exactly the expected line, stdout is empty" "$(is pr_ok)"
    }
    
    echo
    echo "## W1 to W6: the no-cellXfs and non-numeric numFmtId fixtures, through --style-sample and the release probe (ruling 6)"
    # The source lines that raise each message, printed by command rather than
    # typed: the line numbers move whenever the file above them does.
    echo "command: grep -n for the raise sites in crates/emend/src/package.rs and crates/emend/src/styles.rs"
    LC_ALL=C "$G" -n -E 'return Err\((STYLE_OUT_OF_RANGE|NO_CELL_XFS|CODE_REFUSED)\);' \
      "$MAIN/crates/emend/src/package.rs" | sed 's#^#    crates/emend/src/package.rs:#'
    LC_ALL=C "$G" -n -F 'ok_or(NOT_A_NUMBER)' "$MAIN/crates/emend/src/styles.rs" | sed 's#^#    crates/emend/src/styles.rs:#'
    # The out-of-range raise the probe reaches is the FIRST in package.rs, the base
    # check at the top of add_cell_style; the function's own line is printed so a
    # reader sees the raise is inside it.
    LC_ALL=C "$G" -n -F 'pub fn add_cell_style(' "$MAIN/crates/emend/src/package.rs" | sed 's#^#    crates/emend/src/package.rs:#'
    ADD_AT=$(LC_ALL=C "$G" -n -F 'pub fn add_cell_style(' "$MAIN/crates/emend/src/package.rs" | cut -d: -f1)
    RANGE_AT=$(LC_ALL=C "$G" -n -F 'return Err(STYLE_OUT_OF_RANGE);' "$MAIN/crates/emend/src/package.rs" | head -n 1 | cut -d: -f1)
    echo "  add_cell_style begins at line $ADD_AT; the first out-of-range raise is at line $RANGE_AT"
    range_in_add() { [ -n "$ADD_AT" ] && [ -n "$RANGE_AT" ] && [ "$RANGE_AT" -gt "$ADD_AT" ] && [ "$((RANGE_AT - ADD_AT))" -lt 20 ]; }
    note "the first out-of-range raise is within add_cell_style's first twenty lines" "$(is range_in_add)"
    # And the probe's own order: the second output is created after the two
    # additions, so a refusal from add_cell_style leaves it absent.
    echo "command: grep -n for the additions and the output creations in tools/size-probe/src/bin/probe-emend-styles-write-xml.rs"
    LC_ALL=C "$G" -n -E 'File::create\((output|second)\)|add_cell_style\(|let result = run\(input, output, &names\)' \
      "$MAIN/tools/size-probe/src/bin/probe-emend-styles-write-xml.rs" | sed 's/^/    /'
    NOXFS_MSG="error: $(msg_of 'a styles part without cellXfs cannot take a style')"
    RANGE_MSG="error: $(msg_of 'a style index is out of range')"
    NOTANUM_MSG="error: $(msg_of 'a style attribute is not a number')"
    CODE_MSG="error: $(msg_of 'a number format code is empty or holds a character XML cannot carry')"
    for k in 'a styles part without cellXfs cannot take a style' 'a style index is out of range' \
             'a style attribute is not a number' \
             'a number format code is empty or holds a character XML cannot carry'; do
      note "the key [$k] names exactly one of the layer's messages" "$(is msg_one "$k")"
    done
    echo "command: emend-copy <scratch>/pkg-styles-noxfs.xlsx <scratch>/out-W1.xlsx --style-sample"
    ec_case W1 2 "$NOXFS_MSG" pkg-styles-noxfs.xlsx out-W1.xlsx --style-sample
    left_none W1 "$B/out-W1.xlsx"
    note "W1 printed no edit line" "$(is [ ! -s "$B/W1.out" ])"
    pr_case W2 pkg-styles-noxfs.xlsx '0.000'
    pr_refused W2 "$RANGE_MSG"
    note "W2 the probe's second output was never created" "$(is [ ! -e "$B/out-W2-2.xlsx" ])"
    echo "command: emend-copy <scratch>/pkg-styles-notanum.xlsx <scratch>/out-W3.xlsx --style-sample"
    ec_case W3 2 "$NOTANUM_MSG" pkg-styles-notanum.xlsx out-W3.xlsx --style-sample
    left_none W3 "$B/out-W3.xlsx"
    note "W3 printed no edit line" "$(is [ ! -s "$B/W3.out" ])"
    pr_case W4 pkg-styles-notanum.xlsx '0.000'
    pr_refused W4 "$NOTANUM_MSG"
    note "W4 the probe's second output was never created" "$(is [ ! -e "$B/out-W4-2.xlsx" ])"
    # W5, the probe's positive control, on the sound styles package, whose sheet
    # is empty: the number, the text and the boolean make three cells (the clear
    # takes a cell that is not there); four cell formats become six; the code
    # 0.000 is not one of its two, so one numFmt is added; the new formats are
    # indices 4 and 5.
    pr_case W5 pkg-styles.xlsx '0.000'
    hide <"$B/W5.out" | sed 's/^/      /'
    W5_TAIL=$(printf 'written 3\nxfs_before 4\nnumfmts_before 2\nxfs_after 6\nnumfmts_after 3\nnumber_style 4\ntext_style 5')
    w5_ok() {
      [ "$PR_RC" -eq 0 ] || return 1
      [ "$(count_lines "$B/W5.out")" = 13 ] || return 1
      [ "$(tail -n 7 "$B/W5.out")" = "$W5_TAIL" ] || return 1
      [ "$(wc -c <"$B/W5.err")" = 0 ]
    }
    note "W5 the probe exits 0, prints thirteen lines ending in the seven its fixture implies, and nothing on stderr" "$(is w5_ok)"
    pr_case W6 pkg-styles.xlsx ''
    pr_refused W6 "$CODE_MSG"
    note "W6 the probe's second output was never created" "$(is [ ! -e "$B/out-W6-2.xlsx" ])"
    
    echo
    echo "## S0: the positive control, a sound package surveys and edits nothing"
    # The refusals below prove nothing unless a package the layer CAN read comes
    # back with exit 0, one line of the fixed shape, and the input's own bytes.
    # The tab is built with printf: grep -E reads a backslash followed by t as
    # the letter t, so a pattern written with that escape matches nothing and the
    # count reads as a failure however sound the line is. The first round of this
    # log failed exactly that way.
    TAB=$(printf '\t')
    SHAPE="^survey(${TAB}[a-z_]+=[0-9]+)+\$"
    echo "  the shape asserted: survey, then one or more tab separated key=count pairs"
    s0_line=$(count_matches -E "$SHAPE" "$B/N15.out")
    echo "  survey lines of the fixed shape in N15's stdout: $s0_line"
    sed 's/^/      /' "$B/N15.out"
    s0_ok() {
      [ "$n15_same" = yes ] || return 1
      [ "$s0_line" = 1 ] || return 1
    }
    note "S0 one line of the fixed shape, and the output is the input's bytes" "$(is s0_ok)"
    # The control for the shape, in the same command form: a line that is not of
    # that shape is not counted, so the count above is not vacuous.
    printf 'survey entries=1\n' >"$B/c-shape"
    printf 'survey%sentries=x\n' "$TAB" >>"$B/c-shape"
    s0_ctl=$(count_matches -E "$SHAPE" "$B/c-shape")
    note "control: a space separated line and a non-numeric value are not of the shape" \
      "$(is [ "$s0_ctl" = 0 ])"
    
    echo
    echo "## S1 to S14: the package layer's refusals, each through --survey"
    # s_case <label> <fixture> <key>: the key selects the layer's message from the
    # extracted list, and the whole stderr line must be "error: " and that message.
    s_case() {
      local label=$1 fixture=$2 key=$3 msg
      note "$label: the key names exactly one of the layer's messages" "$(is msg_one "$key")"
      msg=$(msg_of "$key")
      echo "command: emend-copy <scratch>/$fixture.xlsx <scratch>/out-$label.xlsx --survey"
      ec_case "$label" 2 "error: $msg" "$fixture.xlsx" "out-$label.xlsx" --survey
      left_none "$label" "$B/out-$label.xlsx"
      note "$label printed no survey line" "$(is [ ! -s "$B/$label.out" ])"
    }
    s_case S1 pkg-noct 'no [Content_Types].xml part'
    s_case S2 pkg-ctroot 'content types part whose root'
    s_case S3 pkg-incomplete 'lacks a required attribute'
    s_case S4 pkg-relsroot 'relationships part whose root'
    s_case S5 pkg-dupid 'two relationships with the same id'
    s_case S6 pkg-above 'target outside the package'
    s_case S7 pkg-noffice 'no officeDocument relationship'
    s_case S8 pkg-twooffice 'more than one officeDocument'
    s_case S9 pkg-dangling 'names no entry'
    s_case S10 pkg-wbroot 'root is not workbook'
    s_case S11 pkg-nosheetid 'lacks name, sheetId or r:id'
    s_case S12 pkg-sheetid 'sheetId that is not a number'
    s_case S13 pkg-missingrel "sheet's relationship is missing"
    s_case S14 pkg-unbound 'prefix its document does not bind'
    
    echo
    echo "## D1 to D4: the same refusals through --drop-calc-chain, which EDITS"
    # --survey reads and writes the input's bytes back; --drop-calc-chain edits. So
    # the question these cases answer is whether the recipe validates the package
    # before it writes anything: a layer that opened, began writing and then failed
    # would leave an output file behind, and left_none is what catches that.
    d_case() {
      local label=$1 fixture=$2 key=$3 msg
      note "$label: the key names exactly one of the layer's messages" "$(is msg_one "$key")"
      msg=$(msg_of "$key")
      echo "command: emend-copy <scratch>/$fixture.xlsx <scratch>/out-$label.xlsx --drop-calc-chain"
      ec_case "$label" 2 "error: $msg" "$fixture.xlsx" "out-$label.xlsx" --drop-calc-chain
      left_none "$label" "$B/out-$label.xlsx"
    }
    d_case D1 pkg-chain-noct 'no [Content_Types].xml part'
    d_case D2 pkg-wbroot 'root is not workbook'
    d_case D3 pkg-dangling 'names no entry'
    d_case D4 pkg-unbound 'prefix its document does not bind'
    
    echo
    echo "## D5: the same fault with NOTHING to drop, NOW REFUSED (part 2 P3 ruling 6)"
    # THE ONE CASE THIS PHASE INVERTS, and the reason it is worth the space.
    # pkg-noct has no content types part AND no calculation chain. Part 2 P3
    # measured it and recorded a question: the recipe asked the workbook part for a
    # chain relationship, found none, and stopped, never asking for a content types
    # part, so a package --survey refused was copied through byte for byte and the
    # run exited 0.
    #
    # Planning ruled (part 2 P3 ruling 6) that an operation which edits validates
    # the package before deciding the edit is empty: "a tool operation that edits a
    # package validates it is a package before deciding the edit is empty.
    # --drop-calc-chain reads the content types part first, as --survey does, so a
    # package with no [Content_Types].xml is refused by both". Part 3 P1's first
    # code commit made that change, and this case is now a REFUSAL where part 2's
    # log recorded an acceptance.
    #
    # The library's own rule is untouched and this case does not test it: a Package
    # with no edits recorded still writes a copy. What changed is that the tool
    # reads the part for the refusal before it asks whether there is anything to
    # drop.
    echo "command: emend-copy <scratch>/pkg-noct.xlsx <scratch>/out-D5.xlsx --drop-calc-chain"
    ec_case D5 2 "error: $(msg_of 'no [Content_Types].xml part')" pkg-noct.xlsx out-D5.xlsx --drop-calc-chain
    left_none D5 "$B/out-D5.xlsx"
    # And the same fixture under --survey, side by side, so the two operations are
    # shown agreeing in one log rather than the agreement being inferred across
    # two families. This is the property the ruling asked for: not that either
    # refuses, but that both do.
    echo "  the same fixture under --survey is S1 above, refused as [$(msg_of 'no [Content_Types].xml part')]"
    d5_survey=$(count_matches -F "error: $(msg_of 'no [Content_Types].xml part')" "$B/S1.err")
    d5_drop=$(count_matches -F "error: $(msg_of 'no [Content_Types].xml part')" "$B/D5.err")
    echo "  S1's stderr lines carrying that message: $d5_survey; D5's: $d5_drop"
    both_refuse() { [ "$d5_survey" = 1 ] && [ "$d5_drop" = 1 ]; }
    note "D5 the same package is refused by --survey and by --drop-calc-chain, with the same message" \
      "$(is both_refuse)"
    # What part 2 P3's log recorded for this fixture, read from that committed log
    # rather than described from memory, so a reader sees the inversion as a
    # difference between two primaries.
    P3NEG=records/logs/m1p2-p3/negative.log
    # The VERDICT line, not the words: the same sentence also appears in the
    # script that log prints, so a count over the sentence alone is 2 and says
    # only that the script held it. The verdict says the previous phase ran the
    # case and recorded the opposite result, which is the claim being made.
    PREV_D5='D5 a package with no chain is copied byte for byte, its content types part never read: as-expected'
    prev_d5=$(count_matches -F "$PREV_D5" "$P3NEG")
    echo "  part 2 P3's negative.log recording the old behaviour as-expected for D5: $prev_d5 line(s)"
    echo "  (that log is superseded on this case alone, by ruling 6; it is not edited)"
    note "the previous phase's log is on record as having asserted the opposite" \
      "$(is [ "$prev_d5" = 1 ])"
    
    echo
    echo "## T1: the accepted --shared-strings, the positive control for the T family"
    # Without this the two refusals below could be the fixture builder's fault.
    # The line the tool prints is asserted in full, and the output is asserted to
    # be the input's bytes: --shared-strings records no edit.
    echo "command: emend-copy <scratch>/pkg-sst.xlsx <scratch>/out-T1.xlsx --shared-strings"
    ec_case T1 0 "" pkg-sst.xlsx out-T1.xlsx --shared-strings
    t1_line=$(cat "$B/T1.out")
    echo "  the line it printed: [$t1_line]"
    # pkg-sst holds two items, "a" and "b", one byte each: this fixture's own
    # strings are the script's, not a workbook's, so quoting them is no leak.
    note "T1 printed the line the two-item fixture calls for" \
      "$(is [ "$t1_line" = "strings${TAB}items=2${TAB}bytes=2" ])"
    t1_same=$(cmp -s "$B/pkg-sst.xlsx" "$B/out-T1.xlsx" && echo yes || echo no)
    echo "  T1 byte-identical to the input: $t1_same"
    note "T1 the accepted --shared-strings produced a byte-identical output" \
      "$(is [ "$t1_same" = yes ])"
    
    echo
    echo "## T2 and T3: the two refusals part 3 P1 adds, through the built binary"
    # specs/0010, "Errors": the two messages cells.rs raises. Both are reached from
    # the command line, which is what makes them more than unit tests; each is read
    # from the committed source by msg_of, never typed here.
    echo "command: emend-copy <scratch>/pkg-sstroot.xlsx <scratch>/out-T2.xlsx --shared-strings"
    ec_case T2 2 "error: $(msg_of "the shared strings part's root is not sst")" \
      pkg-sstroot.xlsx out-T2.xlsx --shared-strings
    left_none T2 "$B/out-T2.xlsx"
    echo "command: emend-copy <scratch>/pkg-sstentity.xlsx <scratch>/out-T3.xlsx --shared-strings"
    ec_case T3 2 "error: $(msg_of 'a cell holds a reference this layer cannot expand')" \
      pkg-sstentity.xlsx out-T3.xlsx --shared-strings
    left_none T3 "$B/out-T3.xlsx"
    # Each key names exactly one message, as in the S family: a key matching two
    # would make the expectation above ambiguous.
    note "the root key names exactly one message" \
      "$(is msg_one "the shared strings part's root is not sst")"
    note "the reference key names exactly one message" \
      "$(is msg_one 'a cell holds a reference this layer cannot expand')"
    
    echo
    echo "## T4: a workbook with no shared strings relationship is not an error"
    # The other half of the contract, and the case a reader is most likely to
    # doubt: an ABSENT table is an empty table, not a refusal. pkg has no shared
    # strings part at all, so the tool must exit 0 and report a table of no items.
    echo "command: emend-copy <scratch>/pkg.xlsx <scratch>/out-T4.xlsx --shared-strings"
    ec_case T4 0 "" pkg.xlsx out-T4.xlsx --shared-strings
    t4_line=$(cat "$B/T4.out")
    echo "  the line it printed: [$t4_line]"
    note "T4 a package with no shared strings relationship reports an empty table" \
      "$(is [ "$t4_line" = "strings${TAB}items=0${TAB}bytes=0" ])"
    t4_same=$(cmp -s "$B/pkg.xlsx" "$B/out-T4.xlsx" && echo yes || echo no)
    echo "  T4 byte-identical to the input: $t4_same"
    note "T4 the output is the input's bytes" "$(is [ "$t4_same" = yes ])"
    
    echo
    echo "## U1: the accepted --cells, the positive control for the U family"
    # Without this the refusals below could be the fixture builder's fault. The
    # line the tool prints is asserted IN FULL, key by key, and the output is
    # asserted to be the input's bytes: --cells records no edit.
    #
    # The expected line is this fixture's own measurement: six cells, of which
    # four are numbers (A1 1.5, A2 3, B2 3, C2 which has no value), one a shared
    # string and one a boolean; five carry a value and C2 carries neither value
    # nor formula; two carry a formula, a shared master and its follower; three
    # numbers parse, since C2 has no value to parse; one boolean parses; the one
    # shared index resolves; the furthest cell is row 2 column 3; and A1 alone
    # carries an s. The same fixture is asserted cell by cell in the crate's own
    # integration test, so the two agree or one of them is wrong.
    echo "command: emend-copy <scratch>/pkg-cells.xlsx <scratch>/out-U1.xlsx --cells"
    ec_case U1 0 "" pkg-cells.xlsx out-U1.xlsx --cells
    u1_line=$(cat "$B/U1.out")
    echo "  the line it printed: [$u1_line]"
    U1_EXPECT="cells${TAB}sheets=1${TAB}cells=6${TAB}number=4${TAB}shared=1${TAB}inline=0"
    U1_EXPECT="$U1_EXPECT${TAB}formula_string=0${TAB}boolean=1${TAB}error=0${TAB}date=0"
    U1_EXPECT="$U1_EXPECT${TAB}values=5${TAB}empty=1${TAB}formulas=2${TAB}shared_master=1"
    U1_EXPECT="$U1_EXPECT${TAB}shared_follower=1${TAB}array=0${TAB}data_table=0"
    U1_EXPECT="$U1_EXPECT${TAB}numbers_parsed=3${TAB}booleans_parsed=1${TAB}resolved=1"
    U1_EXPECT="$U1_EXPECT${TAB}unresolved=0${TAB}max_row=2${TAB}max_col=3${TAB}styled=1"
    echo "  the line this fixture calls for: [$U1_EXPECT]"
    note "U1 printed the line the six-cell fixture calls for, key by key" \
      "$(is [ "$u1_line" = "$U1_EXPECT" ])"
    u1_same=$(cmp -s "$B/pkg-cells.xlsx" "$B/out-U1.xlsx" && echo yes || echo no)
    echo "  U1 byte-identical to the input: $u1_same"
    note "U1 the accepted --cells produced a byte-identical output" "$(is [ "$u1_same" = yes ])"
    # The line names no cell value and no shared string: a count is not content
    # (specs/0010, "Harness runs"; the corpus rule in CLAUDE.md). The fixture's
    # own values are this script's, but the check is on the SHAPE of the line, so
    # it would fail on a corpus file too.
    printf '%s\n' "$u1_line" >"$B/U1.line"
    nu1_pairs=$(awk -F'\t' '{ n = 0; for (i = 2; i <= NF; i++) if ($i ~ /^[a-z_]+=[0-9]+$/) n++; print n }' "$B/U1.line")
    nu1_fields=$(awk -F'\t' '{ print NF - 1 }' "$B/U1.line")
    echo "  fields after the word cells: $nu1_fields; of them key=number pairs: $nu1_pairs"
    u1_counts_only() { [ "$nu1_fields" = "$nu1_pairs" ] && [ "$nu1_pairs" = 23 ]; }
    note "every field of the line is a key and a NUMBER, and there are 23 of them" \
      "$(is u1_counts_only)"
    # The control for that form, in the same command form: a line carrying a
    # value instead of a number is not counted as a pair, so the check above
    # cannot be one that accepts anything.
    printf 'cells\tsheets=1\tfirst=some text\n' >"$B/c-U1.line"
    nctl_pairs=$(awk -F'\t' '{ n = 0; for (i = 2; i <= NF; i++) if ($i ~ /^[a-z_]+=[0-9]+$/) n++; print n }' "$B/c-U1.line")
    nctl_fields=$(awk -F'\t' '{ print NF - 1 }' "$B/c-U1.line")
    echo "  control, a line with one key=number and one key=text: fields $nctl_fields, pairs $nctl_pairs"
    note "control: a field holding text is not counted as a key and a number" \
      "$(is [ "$nctl_pairs" != "$nctl_fields" ])"
    
    echo
    echo "## U2 to U8: the seven messages the cell reader raises that stop a run"
    # specs/0010, "Errors": each is reached FROM THE COMMAND LINE, which is what
    # makes these more than unit tests, and each message is read from the
    # committed source by msg_of, never typed here. The two the reader raises for
    # a shared string index are not here, because a failed resolve is counted and
    # not fatal: U11 to U13 are those, and they exit 0.
    echo "command: emend-copy <scratch>/pkg-cellroot.xlsx <scratch>/out-U2.xlsx --cells"
    ec_case U2 2 "error: $(msg_of "the worksheet part's root is not worksheet")" \
      pkg-cellroot.xlsx out-U2.xlsx --cells
    left_none U2 "$B/out-U2.xlsx"
    echo "command: emend-copy <scratch>/pkg-cellref.xlsx <scratch>/out-U3.xlsx --cells"
    ec_case U3 2 "error: $(msg_of 'a cell reference is not of the form A1')" \
      pkg-cellref.xlsx out-U3.xlsx --cells
    left_none U3 "$B/out-U3.xlsx"
    echo "command: emend-copy <scratch>/pkg-cellrow.xlsx <scratch>/out-U4.xlsx --cells"
    ec_case U4 2 "error: $(msg_of 'a row number is not a number')" \
      pkg-cellrow.xlsx out-U4.xlsx --cells
    left_none U4 "$B/out-U4.xlsx"
    echo "command: emend-copy <scratch>/pkg-cellstyle.xlsx <scratch>/out-U5.xlsx --cells"
    ec_case U5 2 "error: $(msg_of "a cell's style index is not a number")" \
      pkg-cellstyle.xlsx out-U5.xlsx --cells
    left_none U5 "$B/out-U5.xlsx"
    echo "command: emend-copy <scratch>/pkg-celltype.xlsx <scratch>/out-U6.xlsx --cells"
    ec_case U6 2 "error: $(msg_of 'a cell has a type this layer does not know')" \
      pkg-celltype.xlsx out-U6.xlsx --cells
    left_none U6 "$B/out-U6.xlsx"
    echo "command: emend-copy <scratch>/pkg-cellftype.xlsx <scratch>/out-U7.xlsx --cells"
    ec_case U7 2 "error: $(msg_of 'a formula has a type this layer does not know')" \
      pkg-cellftype.xlsx out-U7.xlsx --cells
    left_none U7 "$B/out-U7.xlsx"
    echo "command: emend-copy <scratch>/pkg-cellnosi.xlsx <scratch>/out-U8.xlsx --cells"
    ec_case U8 2 "error: $(msg_of 'a shared formula has no index')" \
      pkg-cellnosi.xlsx out-U8.xlsx --cells
    left_none U8 "$B/out-U8.xlsx"
    # Each key names exactly one message, as in the S and T families: a key
    # matching two would make the expectation above ambiguous.
    for key in "the worksheet part's root is not worksheet" \
               'a cell reference is not of the form A1' \
               'a row number is not a number' \
               "a cell's style index is not a number" \
               'a cell has a type this layer does not know' \
               'a formula has a type this layer does not know' \
               'a shared formula has no index'; do
      note "the key [$key] names exactly one message" "$(is msg_one "$key")"
    done
    
    echo
    echo "## U9 and U10: the two P1 messages, raised now from a <v> and not a <t>"
    # One function assembles the text of a <t>, a <v> and an <f> (P1 ruling 4), so
    # these two refusals must be reachable through a cell's value as well as
    # through a shared string item. T3 above raises the first from a <t>; U9
    # raises it from a <v>, which is what makes the sharing visible from outside.
    echo "command: emend-copy <scratch>/pkg-cellentity.xlsx <scratch>/out-U9.xlsx --cells"
    ec_case U9 2 "error: $(msg_of 'a cell holds a reference this layer cannot expand')" \
      pkg-cellentity.xlsx out-U9.xlsx --cells
    left_none U9 "$B/out-U9.xlsx"
    echo "command: emend-copy <scratch>/pkg-cellelem.xlsx <scratch>/out-U10.xlsx --cells"
    ec_case U10 2 "error: $(msg_of 'a text element holds an element')" \
      pkg-cellelem.xlsx out-U10.xlsx --cells
    left_none U10 "$B/out-U10.xlsx"
    
    echo
    echo "## U11 to U13: a shared string index that does not resolve is COUNTED"
    # The other half of the contract, and the part a reader is most likely to
    # doubt: specs/0010 says the run continues past a failed resolve so the count
    # is complete, so these three exit 0 and report unresolved=1. A reader that
    # refused instead would be right about the workbook and wrong about the
    # operation, and the corpus run's unresolved=0 would then mean nothing,
    # because no corpus file would ever have got that far.
    u_unresolved() {  # <label> <fixture> <expected unresolved>
      local label=$1 fixture=$2 want=$3 line got_un got_res
      echo "command: emend-copy <scratch>/$fixture <scratch>/out-$label.xlsx --cells"
      ec_case "$label" 0 "" "$fixture" "out-$label.xlsx" --cells
      line=$(cat "$B/$label.out")
      echo "  the line it printed: [$line]"
      printf '%s\n' "$line" >"$B/$label.line"
      got_un=$(count_matches -F "${TAB}unresolved=$want${TAB}" "$B/$label.line")
      got_res=$(count_matches -F "${TAB}resolved=0${TAB}" "$B/$label.line")
      echo "  fields reading unresolved=$want: $got_un; fields reading resolved=0: $got_res"
      counted() { [ "$got_un" = 1 ] && [ "$got_res" = 1 ]; }
      note "$label exits 0 and counts the failure as unresolved rather than refusing" \
        "$(is counted)"
    }
    u_unresolved U11 pkg-cellrange.xlsx 1
    u_unresolved U12 pkg-cellnotanum.xlsx 1
    # U13: the same index in a workbook with NO shared strings part at all. The
    # spec makes this the same answer and not a case of its own: an absent table
    # is an empty table, so the index is out of range of it.
    u_unresolved U13 pkg-cellnotable.xlsx 1
    
    echo
    echo "## U14: the sheet is named and the part is not there"
    # specs/0010, "P3": the tool on a package whose named sheet part is missing.
    # The workbook still lists the sheet and the relationship still names the
    # target; only the entry is gone, so this is the package layer's "no such
    # part" reached through --cells rather than through an edit.
    echo "command: emend-copy <scratch>/pkg-nosheetpart.xlsx <scratch>/out-U14.xlsx --cells"
    ec_case U14 2 "error: $(msg_of 'no such part')" \
      pkg-nosheetpart.xlsx out-U14.xlsx --cells
    left_none U14 "$B/out-U14.xlsx"
    note "the key [no such part] names exactly one message" "$(is msg_one 'no such part')"
    
    echo
    echo "## U15 to U18: ruling 2's refusals, through the built binary"
    # M1 part 3 P2 ruling 2: a decimal u32 is ASCII digits only, no sign and no
    # leading zero except 0 itself, and a row is numbered from 1. Every one of
    # these four was ACCEPTED before this part: r="0" gave a cell whose a1() was
    # A0, which CellRef::parse refuses, and the other three were read as 3, 7 and
    # 1. Each is here so that the ruling is measured where a caller meets it, at
    # the command line, and not in the unit tests alone.
    #
    # The si case is refused with the message for an absent index, which is
    # ruling 4: one message covers every si this layer cannot read.
    echo "command: emend-copy <scratch>/pkg-cellrow0.xlsx <scratch>/out-U15.xlsx --cells"
    ec_case U15 2 "error: $(msg_of 'a row number is not a number')" \
      pkg-cellrow0.xlsx out-U15.xlsx --cells
    left_none U15 "$B/out-U15.xlsx"
    echo "command: emend-copy <scratch>/pkg-cellrowplus.xlsx <scratch>/out-U16.xlsx --cells"
    ec_case U16 2 "error: $(msg_of 'a row number is not a number')" \
      pkg-cellrowplus.xlsx out-U16.xlsx --cells
    left_none U16 "$B/out-U16.xlsx"
    echo "command: emend-copy <scratch>/pkg-cellstylepad.xlsx <scratch>/out-U17.xlsx --cells"
    ec_case U17 2 "error: $(msg_of "a cell's style index is not a number")" \
      pkg-cellstylepad.xlsx out-U17.xlsx --cells
    left_none U17 "$B/out-U17.xlsx"
    echo "command: emend-copy <scratch>/pkg-cellsiplus.xlsx <scratch>/out-U18.xlsx --cells"
    ec_case U18 2 "error: $(msg_of 'a shared formula has no index')" \
      pkg-cellsiplus.xlsx out-U18.xlsx --cells
    left_none U18 "$B/out-U18.xlsx"
    # And the control for the three, in the same command form: U1's own line,
    # whose index does resolve, must read unresolved=0, so the unresolved=1 above
    # cannot be what every run prints.
    u1_un0=$(count_matches -F "${TAB}unresolved=0${TAB}" "$B/U1.line")
    echo "  control: fields of U1's line reading unresolved=0: $u1_un0"
    note "control: the sound fixture's line reads unresolved=0" "$(is [ "$u1_un0" = 1 ])"
    
    echo
    echo "## C: every message of the catalogue accounted for"
    # specs/0009 P3: every message in the catalogue is tested or marked untested.
    # The messages come from the source (extracted above) and the coverage from two
    # places, neither of them typed here: the stderr this log's own cases captured,
    # and the package module's test file. A message in neither is listed, and the
    # count of such messages is asserted against the ones this phase can name a
    # reason for.
    cat "$B"/*.err >"$B/all-stderr" 2>/dev/null
    # The path is printed RELATIVE to the repository root. An absolute path of this
    # machine in a committed log is a defect (the T0 P6d ruling), and the first
    # round of this log printed one here: "$MAIN/crates/..." expanded to a home
    # directory. hide would have caught it in piped output; this line is an echo,
    # so it needs the relative form rather than the filter.
    # TWO test files from this phase on: the cells module's messages are pinned by
    # cells/tests.rs, so a coverage form reading the package tests alone would
    # report this phase's own two messages as uncovered. Each file is named and
    # hashed, and the counts below are the sum over both.
    TESTS_REL=crates/emend/src/package/tests.rs
    TESTS=$MAIN/$TESTS_REL
    CTESTS_REL=crates/emend/src/cells/tests.rs
    CTESTS=$MAIN/$CTESTS_REL
    # Part 5 P1: the styles module's reading messages are pinned by its own tests.
    STESTS_REL=crates/emend/src/styles/tests.rs
    STESTS=$MAIN/$STESTS_REL
    for t in "$TESTS_REL" "$CTESTS_REL" "$STESTS_REL"; do
      echo "  a test file read for coverage: $t"
      echo "  (sha256 $(sha256sum <"$MAIN/$t" | cut -d' ' -f1))"
    done
    : >"$B/uncovered"
    while IFS= read -r m; do
      in_log=$(count_matches -F "$m" "$B/all-stderr")
      in_tests=$(count_matches -F "$m" "$TESTS" "$CTESTS" "$STESTS")
      echo "  [$m]: raised by a case here $in_log, named in the module tests $in_tests"
      covered() {
        [ "$in_log" != error ] && [ "$in_tests" != error ] &&
          { [ "$in_log" -gt 0 ] || [ "$in_tests" -gt 0 ]; }
      }
      if ! covered; then printf '%s\n' "$m" >>"$B/uncovered"; fi
    done <"$B/messages"
    nuncovered=$(count_lines "$B/uncovered")
    echo "  messages raised by no case here and named in no package test: $nuncovered"
    if [ "$nuncovered" != 0 ]; then sed 's/^/    uncovered: /' "$B/uncovered"; fi
    note "every message of the catalogue is raised by a case here or named in the module tests" \
      "$(is [ "$nuncovered" = 0 ])"
    # The control for the coverage form, in the same command form: a message no
    # source holds is counted in neither, so a form that counted everything as
    # covered would show up here.
    printf 'no case and no test holds this message\n' >"$B/c-uncovered"
    c_in_log=$(count_matches -F "$(cat "$B/c-uncovered")" "$B/all-stderr")
    c_in_tests=$(count_matches -F "$(cat "$B/c-uncovered")" "$TESTS" "$CTESTS" "$STESTS")
    note "control: a message neither source holds is counted in neither ($c_in_log, $c_in_tests)" \
      "$(is [ "$((c_in_log + c_in_tests))" = 0 ])"
    # And which messages this log reaches through the BINARY as against which only
    # the unit tests reach, printed because the difference is the interesting part:
    # the tool's only edit path is the guarded recipe, so P3's own six messages,
    # which guard an edit a caller asks for by name, cannot be reached from the
    # command line at all.
    nbinary=0
    nonly_tests=0
    while IFS= read -r m; do
      if [ "$(count_matches -F "$m" "$B/all-stderr")" -gt 0 ]; then
        nbinary=$((nbinary + 1))
      else
        nonly_tests=$((nonly_tests + 1))
        printf '%s\n' "$m" >>"$B/tests-only"
      fi
    done <"$B/messages"
    echo "  messages this log raises through the built binary: $nbinary"
    echo "  messages only the package module's tests reach: $nonly_tests"
    if [ -s "$B/tests-only" ]; then sed 's/^/    tests only: /' "$B/tests-only"; fi
    note "every message is in one of those two groups" \
      "$(is [ "$((nbinary + nonly_tests))" = "$nmsg" ])"
    
    echo
    echo "## the eight cell-edit messages: which the E and F families reach"
    # P3 adds no reachable one: F4 and F5 reach two of the five E reaches, and F7
    # names the forbidden-text message as unreached.
    # From what this log's cases printed, never typed: a catalogued message is
    # reached when a captured stderr holds it. P2's operation reaches five; the
    # three it cannot (it writes 42.5, "emend" and true, and edits no part it
    # replaces) must still be named in the package tests.
    : >"$B/cat-reached"
    : >"$B/cat-unreached"
    while IFS= read -r m; do
      in_log=$(count_matches -F "$m" "$B/all-stderr")
      in_tests=$(count_matches -F "$m" "$TESTS")
      echo "  [$m]: raised by a case here $in_log, named in the package tests $in_tests"
      if [ "$in_log" -gt 0 ]; then printf '%s\n' "$m" >>"$B/cat-reached"; else printf '%s\n' "$m" >>"$B/cat-unreached"; fi
    done <"$B/catalogued-cell-edit"
    ncat_reached=$(count_lines "$B/cat-reached")
    ncat_unreached=$(count_lines "$B/cat-unreached")
    echo "  reached through --edit-sample: $ncat_reached; reached by no case here: $ncat_unreached"
    note "the E and F families reach five of the eight cell-edit messages" "$(is [ "$ncat_reached" = 5 ])"
    unreached_in_tests() {
      local m
      while IFS= read -r m; do
        [ "$(count_matches -F "$m" "$TESTS")" -gt 0 ] || return 1
      done <"$B/cat-unreached"
    }
    note "each of the three it cannot reach is named in the package tests" "$(is unreached_in_tests)"
    sed 's/^/    not reached here: /' "$B/cat-unreached"
    
    echo
    echo "## V: the five messages of the additions and the write, reached and unreached"
    # specs/0012 "P3": the messages no binary can reach are named as unreached
    # from the source beside the test that raises each. The five are Y8's list,
    # read from the catalogue; a message is reached when a captured stderr of this
    # log holds it, never by a typed list.
    : >"$B/v-reached"
    : >"$B/v-unreached"
    while IFS= read -r m; do
      in_log=$(count_matches -F "$m" "$B/all-stderr")
      echo "  [$m]: raised by a case here $in_log"
      if [ "$in_log" -gt 0 ]; then printf '%s\n' "$m" >>"$B/v-reached"; else printf '%s\n' "$m" >>"$B/v-unreached"; fi
    done <"$B/catalogued-write"
    nv_reached=$(count_lines "$B/v-reached")
    nv_unreached=$(count_lines "$B/v-unreached")
    echo "  reached here: $nv_reached; reached by no case here: $nv_unreached"
    note "the W family reaches three of the five" "$(is [ "$nv_reached" = 3 ])"
    # Each unreached message beside the package test that raises it: the name of
    # the test function enclosing each quotation of the message, read from the
    # test file, and the line that raises it in package.rs.
    cat >"$B/enclosing.py" <<'ENCL_PY'
    import re
    import sys
    
    lines = open(sys.argv[1], encoding="utf-8").read().split("\n")
    message = sys.argv[2]
    current = None
    seen = []
    for line in lines:
        found = re.match(r"^fn ([a-z_0-9]+)\(", line)
        if found:
            current = found.group(1)
        if '"%s"' % message in line and current and current not in seen:
            seen.append(current)
    for name in seen:
        print(name)
    ENCL_PY
    v_named() {
      local m names
      while IFS= read -r m; do
        names=$(python3 "$B/enclosing.py" "$TESTS" "$m")
        [ -n "$names" ] || return 1
      done <"$B/v-unreached"
    }
    while IFS= read -r m; do
      echo "  not reached here: [$m]"
      python3 "$B/enclosing.py" "$TESTS" "$m" | sed "s#^#    the test that raises it: $TESTS_REL, fn #"
      LC_ALL=C "$G" -n -F "\"$m\"" "$MAIN/crates/emend/src/package.rs" | sed 's#^#    the message in crates/emend/src/package.rs:#'
    done <"$B/v-unreached"
    note "each unreached message is named beside a package test that raises it" "$(is v_named)"
    note "control: the same reader names no test for a message no test quotes" \
      "$(is [ -z "$(python3 "$B/enclosing.py" "$TESTS" 'no such message anywhere')" ])"
    # Why no binary reaches the two: every addition a binary makes names a built-in
    # id below 164 (the tool's 22 and the probe's 14), and no binary replaces the
    # styles part it adds to. The two constants those binaries pass are printed
    # from their sources.
    echo "command: grep -n 'NumberFormat::BuiltIn(' in the tool and the styles probe"
    LC_ALL=C "$G" -n -F 'NumberFormat::BuiltIn(' "$MAIN/tools/emend-copy/src/main.rs" | sed 's#^#    tools/emend-copy/src/main.rs:#'
    LC_ALL=C "$G" -n -F 'NumberFormat::BuiltIn(' "$MAIN/tools/size-probe/src/bin/probe-emend-styles-write-xml.rs" | sed 's#^#    tools/size-probe/src/bin/probe-emend-styles-write-xml.rs:#'
    nbig=$(cat "$MAIN/tools/emend-copy/src/main.rs" "$MAIN/tools/size-probe/src/bin/probe-emend-styles-write-xml.rs" |
      LC_ALL=C "$G" -o -E 'NumberFormat::BuiltIn\([0-9]+\)' | LC_ALL=C "$G" -o -E '[0-9]+' | awk '$1 >= 164' | wc -l)
    echo "  built-in ids of 164 or more those two sources pass: $nbig"
    note "no binary passes a built-in id of 164 or more" "$(is [ "$nbig" = 0 ])"
    
    echo
    echo "## X1: a part that is not XML under an XML name"
    echo "command: emend-copy <scratch>/badxml.xlsx <scratch>/out-X1.xlsx --xml-null-rewrite"
    ec_case X1 2 "$XML_MSG" badxml.xlsx out-X1.xlsx --xml-null-rewrite
    left_none X1 "$B/out-X1.xlsx"
    # The index is the FAILING entry's: the fixture's sound content types part is
    # entry 0 and the bad sheet is entry 1, so a message naming 0 would mean the
    # index was not carried through.
    x1_index=$(count_matches -F '(entry 1)' "$B/X1.err")
    x1_zero=$(count_matches -F '(entry 0)' "$B/X1.err")
    echo "  X1 stderr naming entry 1: $x1_index; naming entry 0: $x1_zero"
    note "X1 names the failing entry's index, not zero" "$(is [ "$x1_index" = 1 ])"
    note "X1 does not name entry 0" "$(is [ "$x1_zero" = 0 ])"
    # And the control: the same archive copied with NO operation is fine, so the
    # refusal comes from parsing the part and not from the archive itself.
    echo "command: emend-copy <scratch>/badxml.xlsx <scratch>/out-X2.xlsx (no operation)"
    ec_case X2 0 "" badxml.xlsx out-X2.xlsx
    x2_same=$(cmp -s "$B/badxml.xlsx" "$B/out-X2.xlsx" && echo yes || echo no)
    echo "  X2 byte-identical to the input: $x2_same"
    note "X2 the same archive copies verbatim with no operation" "$(is [ "$x2_same" = yes ])"
    
    echo
    echo "## R1: a --tool-arg value holding a tab is refused"
    # The runner refuses during argument parsing, before any tool runs, so the
    # real binary is given as --passthrough and never invoked.
    ( cd "$CLONE" && scripts/passthrough-run.sh --label host --passthrough "$EC" \
        --xlsx-diff "$XD" --corpus "$B/corpus" --out "$B/run-R1" --timeout 60 \
        --tool-arg "$(printf -- '--xml-null-rewrite\tx')" ) >"$B/R1.out" 2>"$B/R1.err"
    r1rc=$?
    echo "command: scripts/passthrough-run.sh ... --out <scratch>/run-R1 --tool-arg '<a value holding a tab>'"
    echo "  exit: $r1rc"
    hide <"$B/R1.err" | sed 's/^/    /'
    r1_refusal=$(count_matches -F "error: $TAB_FMT" "$B/R1.err")
    echo "  stderr lines carrying the runner's tab refusal: $r1_refusal"
    note "R1 exits 2" "$(is [ "$r1rc" -eq 2 ])"
    note "R1 refuses with the message read from the runner's source" "$(is [ "$r1_refusal" = 1 ])"
    note "R1 wrote no run row" "$(is [ ! -e "$B/run-R1/run.host.tsv" ])"
    
    echo
    echo "## R2: the control, the same invocation with the tab removed"
    ( cd "$CLONE" && scripts/passthrough-run.sh --label host --passthrough "$EC" \
        --xlsx-diff "$XD" --corpus "$B/corpus" --out "$B/run-R2" --timeout 60 \
        --tool-arg '--xml-null-rewrite' ) >"$B/R2.out" 2>"$B/R2.err"
    r2rc=$?
    echo "command: scripts/passthrough-run.sh ... --out <scratch>/run-R2 --tool-arg --xml-null-rewrite"
    echo "  exit: $r2rc"
    hide <"$B/R2.err" | sed 's/^/    /'
    r2_refusal=$(count_matches -F "error: $TAB_FMT" "$B/R2.err")
    echo "  stderr lines carrying the tab refusal: $r2_refusal"
    note "R2 exits 0" "$(is [ "$r2rc" -eq 0 ])"
    note "R2 carries no tab refusal" "$(is [ "$r2_refusal" = 0 ])"
    note "R2 wrote a run row" "$(is [ -e "$B/run-R2/run.host.tsv" ])"
    if [ -e "$B/run-R2/summary.host.tsv" ]; then
      echo "  the summary row's columns, printed as the runner wrote them:"
      hide <"$B/run-R2/summary.host.tsv" | sed 's/^/      /'
      r2_args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next }
                            k && NR == 2 { print $k }' "$B/run-R2/run.host.tsv")
      echo "  the run row's tool_args column: [$r2_args]"
      note "R2 the run row records the operation" "$(is [ "$r2_args" = '--xml-null-rewrite' ])"
    fi
    
    echo
    echo "## G1 and G2: the gate's doc step, on the fault it was added for"
    # P3 ruling 4 added the doc step because an ambiguous intra-doc link in
    # tools/emend-copy passed every other step of the gate and broke nothing a
    # build would notice. The negative case is that fault itself, planted in a
    # scratch clone: a link to a name rustdoc cannot resolve. --only doc runs that
    # step alone, so this costs a doc build and not a whole gate.
    GC=$B/gate-clone
    git clone --quiet --shared "$MAIN" "$GC" 2>/dev/null
    git -C "$GC" checkout --quiet "$C"
    echo "command: git clone --shared <repo> <scratch>/gate-clone; git checkout $C"
    note "the clone is at the phase commit" "$(is [ "$(git -C "$GC" rev-parse HEAD)" = "$C" ])"
    # G2 first, the control: the clone as committed must PASS, or G1's failure
    # would say nothing about the fault.
    echo "command: (cd <scratch>/gate-clone && scripts/check.sh --only doc)"
    ( cd "$GC" && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never scripts/check.sh --only doc ) \
      >"$B/G2.out" 2>"$B/G2.err"
    g2rc=$?
    echo "  G2 exit: $g2rc"
    hide <"$B/G2.out" | sed 's/^/      /'
    hide <"$B/G2.err" | sed 's/^/      /'
    g2_pass=$(count_matches -Fx 'PASS doc' "$B/G2.out")
    g2_ok() { [ "$g2rc" -eq 0 ] && [ "$g2_pass" = 1 ]; }
    note "G2 the clone as committed passes the doc step" "$(is g2_ok)"
    # G1: the fault. The link is planted in the library's own crate docs, in a
    # doc comment, written as a link to a name that does not exist. The file is
    # chosen from git rather than named by position: it is the crate root.
    DOC_TARGET=$GC/crates/emend/src/lib.rs
    note "the file the fault is planted in exists in the clone" "$(is [ -f "$DOC_TARGET" ])"
    python3 - "$DOC_TARGET" >"$B/plant.out" 2>&1 <<'PLANT_PY'
    import sys
    
    path = sys.argv[1]
    source = open(path, encoding="utf-8").read()
    marker = "//!"
    at = source.index(marker)
    end = source.index("\n", at)
    # A doc link to a name no item carries: rustdoc resolves intra-doc links and
    # -D warnings turns the unresolved one into an error.
    planted = source[:end] + "\n//!\n//! A link to [`no_such_item_anywhere`].\n" + source[end:]
    open(path, "w", encoding="utf-8").write(planted)
    print("planted a doc link to a name the crate does not define")
    PLANT_PY
    sed 's/^/      /' "$B/plant.out"
    nplanted=$(count_matches -F 'no_such_item_anywhere' "$DOC_TARGET")
    echo "  lines of the clone's crate root naming the planted link: $nplanted"
    note "the fault is in the clone's source" "$(is [ "$nplanted" = 1 ])"
    echo "command: (cd <scratch>/gate-clone && scripts/check.sh --only doc) with the fault planted"
    ( cd "$GC" && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never scripts/check.sh --only doc ) \
      >"$B/G1.out" 2>"$B/G1.err"
    g1rc=$?
    echo "  G1 exit: $g1rc"
    hide <"$B/G1.out" | sed 's/^/      /'
    hide <"$B/G1.err" | sed 's/^/      /'
    g1_fail=$(count_matches -E '^FAIL doc' "$B/G1.out" "$B/G1.err")
    g1_pass=$(count_matches -Fx 'PASS doc' "$B/G1.out")
    echo "  G1 lines reporting FAIL doc: $g1_fail; lines reporting PASS doc: $g1_pass"
    g1_ok() {
      [ "$g1rc" -ne 0 ] || return 1
      [ "$g1_fail" -ge 1 ] || return 1
      [ "$g1_pass" = 0 ] || return 1
    }
    note "G1 the doc step fails on an unresolvable intra-doc link, and does not print PASS" \
      "$(is g1_ok)"
    # The main tree was never touched: the fault lives only in the clone.
    nmain_fault=$(count_matches -F 'no_such_item_anywhere' "$MAIN/crates/emend/src/lib.rs")
    echo "  lines of the MAIN tree's crate root naming the planted link: $nmain_fault"
    note "the planted fault never reached the main working tree" "$(is [ "$nmain_fault" = 0 ])"
    
    echo
    echo "## no temporary of emend-copy's own survived any case"
    ntmp_all=$(find "$B" -name '.*emend-copy*.tmp' | wc -l)
    echo "  temporaries anywhere under <scratch>: $ntmp_all"
    note "no temporary survived" "$(is [ "$ntmp_all" = 0 ])"
    # The control for the form above: a planted file of the same shape is found,
    # so the zero means absence and not a broken find.
    : >"$B/.planted.emend-copy-0.tmp"
    ntmp_ctl=$(find "$B" -name '.*emend-copy*.tmp' | wc -l)
    echo "  control, with one planted temporary of the same shape: $ntmp_ctl"
    note "control: the find form reports a planted temporary" "$(is [ "$ntmp_ctl" = 1 ])"
    rm -f "$B/.planted.emend-copy-0.tmp"
    
    echo
    echo "## the main working tree was never used"
    echo "command: git -C <repo> status --porcelain"
    st_all=$(run_lines git -C "$MAIN" status --porcelain)
    st_log=$(run_matches -E '^(\?\?| ?[MARCD]) (records/logs/m1p5-p3|records/m1p5-p3-|records/size-m1p5-)' git -C "$MAIN" status --porcelain)
    # Header change 6: planning's files modified and uncommitted, should any stand,
    # each printed by name with its sha256.
    st_spec=$(run_matches -E '^ M (specs/0012-styles[.]md|ROADMAP[.]md)$' git -C "$MAIN" status --porcelain)
    echo "status lines in the main tree: $st_all; of them this phase's logs or records: $st_log; planning's files modified and uncommitted: $st_spec"
    git -C "$MAIN" status --porcelain | LC_ALL=C "$G" -E '^ M (specs/0012-styles[.]md|ROADMAP[.]md)$' | cut -c4- |
      while IFS= read -r pf; do echo "  $pf: sha256 $(sha256sum <"$MAIN/$pf" | cut -d' ' -f1)"; done
    main_untouched() {
      [ "$st_all" != error ] && [ "$st_log" != error ] && [ "$st_spec" != error ] \
        && [ "$st_all" = "$((st_log + st_spec))" ]
    }
    note "the main working tree holds nothing but this phase's logs, its records and planning's files" "$(is main_untouched)"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"
    
    

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

