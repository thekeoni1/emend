    import sys
    
    DATES = "crates/emend/src/dates.rs"
    TOOL = "tools/emend-copy/src/main.rs"
    
    MUTATIONS = {
        # The phantom day one later: 1900-03-01 becomes serial 60.
        "D1": [(DATES, "                if count >= PHANTOM_DAY {",
                "                if count > PHANTOM_DAY {")],
        # Milliseconds truncated, so nothing carries into the next day.
        "D2": [(DATES, "        let total = (serial * DAY_MS as f64).round();",
                "        let total = (serial * DAY_MS as f64).floor();")],
        # Ruling 2 broken: the first-day refusal reads the unrounded serial. The
        # product is parenthesised: attempt 1 of this log wrote it bare, and Rust
        # read `f64 <` as the start of a generic argument, so the mutated tree did
        # not compile.
        "D3": [(DATES, "        if total < (epoch.first() * DAY_MS) as f64 ",
                "        if (serial * DAY_MS as f64) < (epoch.first() * DAY_MS) as f64 ")],
        # Ruling 3 broken: hour 24 passes.
        "D4": [(DATES, "            || self.hour > 23", "            || self.hour > 24")],
        "T1": [(TOOL, "    let epoch = Epoch::of(workbook);", "    let epoch = Epoch::Y1900;")],
        "T2": [(TOOL, "    let dated = package.add_cell_style(None, NumberFormat::BuiltIn(22))?;",
                "    let dated = package.add_cell_style(None, NumberFormat::BuiltIn(14))?;")],
        "T3": [(TOOL, "DateTime::from_serial(epoch, n)) == Some(SAMPLE_DATE)",
                "DateTime::from_serial(epoch, n)) != Some(SAMPLE_DATE)")],
    }
    
    which = sys.argv[1]
    root = sys.argv[2]
    for path, old, new in MUTATIONS[which]:
        full = root + "/" + path
        body = open(full).read()
        found = body.count(old)
        if found != 1:
            print("REFUSED %s: the text to replace in %s occurs %d times, not once" % (which, path, found))
            sys.exit(2)
        body = body.replace(old, new, 1)
        open(full, "w").write(body)
        print("    applied %s to %s: %d bytes -> %d bytes" % (which, path, len(old), len(new)))
