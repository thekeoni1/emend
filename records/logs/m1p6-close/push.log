    #!/usr/bin/env bash
    # Milestone 1 part 6 close-out push.log (specs/0013-formulas.md "Close-out push
    # (after P3)": "As part 5's, with the close-out scripts as part 5 ran them, one
    # record commit after the push unless the maintainer chooses the split again,
    # the scan rerun last, the `ANTHROPIC_API_KEY` check").
    #
    # DERIVED FROM part 5's close-out script as records/logs/m1p5-close/push.log
    # printed it (the file part 5 ran, kept in the session's scratch directory)
    # and audited against specs/0001 "Rules for every phase" before this run.
    # Every check, control and helper is part 5's, unchanged. What changed, and
    # why:
    #  1. The names are part 6's, and the spec cited is specs/0013.
    #  2. The base is part 5's close-out doc commit (77d2b50 when this was
    #     written), the last commit part 5 pushed, resolved from git by its subject
    #     and the pattern asserted to match exactly one commit. Part 5's record
    #     commit (b0c21ef) was made after its push and is in this range.
    #  3. Part 5's other header items stand as they were: the record is not split
    #     (one record commit after the push holds this log, ci-run.log and
    #     scan.log); ANTHROPIC_API_KEY unset is a check; the denylist is checked
    #     present, readable and not empty with entries counted, never printed;
    #     each mode's captured output gets the path check with its planted
    #     control; the gate has nine steps.
    #
    # Usage: M1CLOSE_LIB=<lib> m1p6close-push.sh pre <phase commit> > <scratch file>
    #          step 2: the environment, hook, core.hooksPath and denylist checks
    #          and the full gate; records the base (origin/main) and the count of
    #          commits to push. NO PUSH, and this mode can never push.
    #        M1CLOSE_LIB=<lib> m1p6close-push.sh push <base> >> <scratch file>
    #          steps 3 and 4: refuses unless origin/main still equals <base>,
    #          pushes, and checks the hook's range, the count and git's report
    #          against <base> as recorded by pre, never against origin/main read
    #          after the push.
    #
    # THE MAINTAINER'S AUTHORISATION. specs/0003-ci.md, the section on the push,
    # requires three preconditions: the phase DONE, planning's word, and the
    # maintainer typing authorisation in the implementing session. push mode is
    # only ever run after that sentence has been typed. Planning's word does not
    # stand in for it, and neither does this script.
    #
    # Every commit id this log reports is read from git at run time by a command
    # the log prints; none is typed.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    MODE=${1:?pre or push}
    LIB=${M1CLOSE_LIB:?the path to the counting library is required}
    . "$LIB"
    REPO=thekeoni1/emend
    URL=https://github.com/thekeoni1/emend.git
    BASE_PATTERN='^M1 part 5 close-out: planning.s verification and rulings on P3$'
    DENY_FILE=$HOME/.config/emend/private-denylist.txt
    export GIT_TERMINAL_PROMPT=0 RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    
    show() { echo "$1:"; sed 's/^/    /' "$2"; }
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # exit_and_bytes <exit> <bytes> <want exit> <want bytes>: both match, in one
    # function so neither condition is dropped.
    exit_and_bytes() { [ "$1" -eq "$3" ] && [ "$2" = "$4" ]; }
    # same_nonempty <a> <b>: both set and equal.
    same_nonempty() { [ -n "$1" ] && [ "$1" = "$2" ]; }
    # holds_once <file> <line>: the file holds that whole line exactly once.
    holds_once() { [ "$(count_matches -F "$2" "$1")" = 1 ]; }
    # tree_clean: git status ran and printed nothing.
    tree_clean() { [ "$(run_lines git status --porcelain)" = 0 ]; }
    # files_listed <n>: the range's file list was read and is not empty.
    files_listed() { [ "$1" != error ] && [ "$1" -gt 0 ]; }
    # hook_scanned <file> <commits>: the hook's summary names that many commits and
    # zero findings.
    hook_scanned() {
      [ "$(count_matches -E "^privacy: $2 commit[(]s[)], [0-9]+ blob[(]s[)] scanned, 0 finding[(]s[)]$" "$1")" = 1 ]
    }
    # The phase commit guard (specs/0001, M1 part 3 P1 ruling 11): a full 40-hex
    # sha equal to HEAD. /usr/bin/grep explicitly, as every scan form.
    NULL_SHA=0000000000000000000000000000000000000000
    full_sha() { printf '%s' "$1" | LC_ALL=C /usr/bin/grep -qE '^[0-9a-f]{40}$'; }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    not_head() { if is_head "$1"; then return 1; else return 0; fi; }
    # one_line <n>: a count that was read and is exactly 1.
    one_line() { [ "$1" != error ] && [ "$1" = 1 ]; }
    # The path form (header change 6): lines naming a home, mount, temp or corpus
    # path. no_paths <files...>: the form read every file and found none.
    PATH_RE='(/home/|/mnt/|/Users/|/tmp/|emend-testing)'
    no_paths() { [ "$(count_matches -E "$PATH_RE" "$@")" = 0 ]; }
    # path_control: a planted path, assembled at run time so this script's own text
    # carries none, must count 1 through the same form, and a clean line 0. It
    # prints its two counts and sets path_ctl_ok; it is not run inside yn, so its
    # printed line is not swallowed.
    path_control() {
      printf 'x %s%s%s y\n' '/ho' 'me/someone/' 'emend-testing/corpus/x.xlsx' >"$T/path-plant"
      printf 'x clean y\n' >"$T/path-clean"
      local a b
      a=$(count_matches -E "$PATH_RE" "$T/path-plant")
      b=$(count_matches -E "$PATH_RE" "$T/path-clean")
      echo "  control: the path form on a planted path: $a (expect 1); on a clean line: $b (expect 0)"
      path_ctl_ok=no
      if [ "$a" = 1 ] && [ "$b" = 0 ]; then path_ctl_ok=yes; fi
    }
    # denylist_usable <n>: the denylist was read and has entries.
    denylist_usable() { [ "$1" != error ] && [ "$1" -gt 0 ]; }
    
    case "$MODE" in
      pre)
        C=${2:?the phase commit is required}
        HEAD_SHA=$(git rev-parse HEAD)
        echo "command: git rev-parse HEAD"
        echo "about: M1 part 6 close-out push of main at $(git rev-parse main); HEAD at run: $HEAD_SHA"
        echo "  the phase commit given to this script: $C"
        echo "  git rev-parse HEAD at this run:        $HEAD_SHA"
        check "the phase commit given to this script is HEAD" "$(yn is_head "$C")"
        check "control: the same form refuses a commit that is not HEAD" "$(yn not_head "$NULL_SHA")"
        check "control: the same form refuses a short sha of the real commit" "$(yn not_head "$(printf '%s' "$C" | cut -c1-7)")"
        echo "phase: Milestone 1 part 6 close-out (specs/0013-formulas.md \"Close-out push (after P3)\") push.log, step 2; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
        KSET=$([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)
        check "ANTHROPIC_API_KEY is unset in this shell (set: $KSET)" "$(yn [ "$KSET" = no ])"
        echo "THIS MODE DOES NOT PUSH. The push (push mode, appended below) runs only"
        echo "on planning's word and the maintainer's authorisation typed in the"
        echo "implementing session (specs/0003-ci.md, the section on the push). The"
        echo "record is not split: this log, ci-run.log and scan.log go in one record"
        echo "commit after the push."
        echo
        echo "## script that wrote this log"
        sed 's/^/    /' "$0"
        echo
        echo "## the shared counting library this log sources"
        sed 's/^/    /' "$LIB"
        echo
        echo "## counting controls (every form, before any of them is used)"
        counting_controls
        check "every counting form behaves on a match, a miss and an unreadable file" "$(yn [ "$counting_controls_ok" = yes ])"
        echo
    
        echo "command: git status --porcelain -> $(run_lines git status --porcelain) line(s)"
        check "working tree clean before the run" "$(yn tree_clean)"
        MAIN=$(git rev-parse main)
        echo "command: git rev-parse main -> $MAIN"
        echo "command: git symbolic-ref --short HEAD -> $(git symbolic-ref --short HEAD)"
        echo "command: git rev-list --count main -> $(git rev-list --count main)"
        check "HEAD is main" "$(yn [ "$HEAD_SHA" = "$MAIN" ])"
        RURL=$(git remote get-url origin)
        echo "command: git remote get-url origin -> $RURL"
        check "origin is $URL" "$(yn [ "$RURL" = "$URL" ])"
    
        echo
        echo "## the base, read from git and not typed"
        BASE=$(git rev-parse origin/main)
        echo "command: git rev-parse origin/main -> $BASE"
        echo "command: git log --format='%H' --grep='$BASE_PATTERN'"
        git log --format='%H' --grep="$BASE_PATTERN" >"$T/base-matches"
        NB=$(count_lines "$T/base-matches")
        echo "  commits matching the pattern: $NB"
        check "the base pattern matches exactly one commit" "$(yn one_line "$NB")"
        EXPECT=$(git rev-parse "$(git log --format='%H' --grep="$BASE_PATTERN" -n 1)" 2>/dev/null)
        echo "  part 5's close-out doc commit, the last one pushed, resolves to: $EXPECT"
        check "origin/main is part 5's close-out doc commit, resolved from git by its subject" "$(yn same_nonempty "$BASE" "$EXPECT")"
        echo "command: git ls-remote origin refs/heads/main"
        git ls-remote origin refs/heads/main > "$T/ls0" 2> "$T/ls0err" </dev/null
        rc=$?
        show stdout "$T/ls0"
        show stderr "$T/ls0err"
        echo "exit: $rc"
        check "ls-remote exit is 0" "$(yn [ "$rc" -eq 0 ])"
        check "the remote's main is the base (the tracking ref is not stale)" "$(yn same_nonempty "$(cut -f1 "$T/ls0")" "$BASE")"
        COUNT=$(git rev-list --count "$BASE..$MAIN")
        echo "command: git rev-list --count $BASE..$MAIN -> $COUNT"
        check "there is something to push: $COUNT commit(s)" "$(yn [ "$COUNT" -gt 0 ])"
        echo "base recorded before the push: $BASE"
        echo "commits to push (oldest first; the record commit holding this log is"
        echo "made after the push and is not among them):"
        git log --reverse --format='    %H %s' "$BASE..$MAIN"
        NFILES=$(run_lines git diff --name-only "$BASE..$MAIN")
        echo "command: git diff --name-only $BASE..$MAIN -> $NFILES file(s)"
        check "the range's file list was read and is not empty" "$(yn files_listed "$NFILES")"
    
        echo
        echo "## step 2: pre-push state and full gate"
        DSET=$([ -n "${EMEND_PRIVATE_DENYLIST+set}" ] && echo yes || echo no)
        check "EMEND_PRIVATE_DENYLIST is unset (set: $DSET)" "$(yn [ "$DSET" = no ])"
        echo "command: the private denylist at <home>/.config/emend/private-denylist.txt, entries counted and never printed"
        check "the denylist file is present and readable" "$(yn [ -r "$DENY_FILE" ])"
        LC_ALL=C "$G" -v -E '^[[:space:]]*(#|$)' "$DENY_FILE" >"$T/deny" 2>/dev/null
        ND=$(count_lines "$T/deny")
        echo "  mode $(stat -c %a "$DENY_FILE" 2>/dev/null); entries: $ND"
        check "the denylist has entries" "$(yn denylist_usable "$ND")"
        echo "command: git config --get core.hooksPath"
        git config --get core.hooksPath > "$T/out" 2>&1
        rc=$?
        show output "$T/out"
        n=$(count_bytes '\000-\377' "$T/out")
        check "exit $rc and output bytes $n (expect exit 1 and 0 bytes)" "$(yn exit_and_bytes "$rc" "$n" 1 0)"
        echo "command: ls -l .git/hooks/pre-push"
        ls -l .git/hooks/pre-push | sed 's/^/    /'
        check "hook is executable" "$(yn [ -x .git/hooks/pre-push ])"
        awk '/^cat >"\$hook" <<.HOOK.$/ { p = 1; next } /^HOOK$/ { p = 0 } p' scripts/install-hooks.sh > "$T/heredoc"
        n=$(count_lines "$T/heredoc")
        # Both conditions in one named function: the label says "more than 0", so
        # the check must test that and not merely that the count did not error.
        heredoc_nonempty() { [ "$1" != error ] && [ "$1" -gt 0 ]; }
        check "installer heredoc lines: $n (expect more than 0)" "$(yn heredoc_nonempty "$n")"
        echo "hook sha256 $(sha256sum < .git/hooks/pre-push | cut -d' ' -f1); installer heredoc sha256 $(sha256sum < "$T/heredoc" | cut -d' ' -f1)"
        check "hook equals what scripts/install-hooks.sh writes" "$(yn cmp -s .git/hooks/pre-push "$T/heredoc")"
        echo "command: scripts/check.sh"
        scripts/check.sh > "$T/out" 2> "$T/err" </dev/null
        rc=$?
        show stdout "$T/out"
        show stderr "$T/err"
        echo "exit: $rc; stderr bytes: $(count_bytes '\000-\377' "$T/err")"
        check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
        check "stderr is empty" "$(yn [ "$(count_bytes '\000-\377' "$T/err")" = 0 ])"
        printf 'PASS host\nPASS i686\nPASS fmt\nPASS clippy\nPASS doc\nPASS native (allowlisted -sys: none)\nPASS licences\nPASS hygiene\nPASS privacy\n' > "$T/want"
        check "stdout is exactly the nine PASS lines in order, doc among them" "$(yn cmp -s "$T/out" "$T/want")"
        for s in out err; do
          n=$(count_bytes "$CTRL_CLASS" "$T/$s")
          check "check.sh std$s control bytes: $n (expect 0)" "$(yn [ "$n" = 0 ])"
        done
        echo "command: git status --porcelain -> $(run_lines git status --porcelain) line(s)"
        check "working tree clean after the gate" "$(yn tree_clean)"
        check "HEAD is still the phase commit after the gate" "$(yn [ "$(git rev-parse HEAD)" = "$C" ])"
        echo
        echo "## no path in this mode's captured output"
        path_control
        check "the path form can count a planted path" "$path_ctl_ok"
        cat "$T/ls0" "$T/ls0err" "$T/out" "$T/err" >"$T/pre-captured"
        echo "  lines naming a home, mount, temp or corpus path in the captured output: $(count_matches -E "$PATH_RE" "$T/pre-captured")"
        check "the captured output (ls-remote and the gate) names no such path" "$(yn no_paths "$T/pre-captured")"
        echo
        echo "pre checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
        echo "The base recorded above is what push mode compares against."
        ;;
    
      push)
        BASE=${2:?the base recorded by pre is required}
        echo
        echo "# push mode, steps 3 and 4 (appended to the same log); run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "command: git rev-parse HEAD -> $(git rev-parse HEAD)"
        if [ -n "${EMEND_PRIVATE_DENYLIST+set}" ]; then echo "refusing: EMEND_PRIVATE_DENYLIST is set"; exit 1; fi
        if [ -n "$(git config --get core.hooksPath)" ]; then echo "refusing: core.hooksPath is set"; exit 1; fi
        if [ "$(git rev-parse origin/main)" != "$BASE" ]; then echo "refusing: origin/main is no longer the base recorded by pre"; exit 1; fi
        echo "EMEND_PRIVATE_DENYLIST unset, core.hooksPath empty, and origin/main still the recorded base (the script refuses otherwise)"
        MAIN=$(git rev-parse main)
        COUNT=$(git rev-list --count "$BASE..$MAIN")
        echo "main is $MAIN; base (recorded by pre) is $BASE; commits in base..main: $COUNT"
        echo
        echo "## step 3: push"
        echo "command: git push origin main"
        git push origin main > "$T/out" 2> "$T/err" </dev/null
        rc=$?
        show stdout "$T/out"
        show stderr "$T/err"
        echo "exit: $rc"
        check "push exit is 0" "$(yn [ "$rc" -eq 0 ])"
        cat "$T/out" "$T/err" > "$T/both"
        check "the hook printed PASS privacy" "$(yn holds_once "$T/both" 'PASS privacy')"
        check "the hook's range is $BASE..$MAIN (the base recorded by pre)" \
          "$(yn holds_once "$T/both" "pre-push: scripts/privacy.sh --range $BASE..$MAIN (refs/heads/main)")"
        check "the hook scanned $COUNT commits with 0 findings" "$(yn hook_scanned "$T/both" "$COUNT")"
        check "git reported ${BASE:0:7}..${MAIN:0:7} for main" \
          "$(yn holds_once "$T/both" "   ${BASE:0:7}..${MAIN:0:7}  main -> main")"
        n=$(count_bytes "$CTRL_CLASS" "$T/both")
        check "push output control bytes: $n (expect 0)" "$(yn [ "$n" = 0 ])"
        echo
        echo "## step 4: remote main equals local main, repository still private"
        echo "command: git ls-remote origin refs/heads/main"
        git ls-remote origin refs/heads/main > "$T/ls" 2> "$T/lserr" </dev/null
        rc=$?
        show stdout "$T/ls"
        show stderr "$T/lserr"
        echo "exit: $rc"
        check "ls-remote exit is 0" "$(yn [ "$rc" -eq 0 ])"
        REMOTE=$(cut -f1 "$T/ls")
        echo "command: git rev-parse main -> $MAIN"
        check "remote main equals local main" "$(yn same_nonempty "$REMOTE" "$MAIN")"
        echo "command: gh repo view $REPO --json visibility"
        gh repo view "$REPO" --json visibility > "$T/vis" 2> "$T/viserr" </dev/null
        rc=$?
        show stdout "$T/vis"
        show stderr "$T/viserr"
        echo "exit: $rc"
        check "gh exit is 0" "$(yn [ "$rc" -eq 0 ])"
        check "still PRIVATE" "$(yn holds_once "$T/vis" '{"visibility":"PRIVATE"}')"
        echo "command: git status --porcelain -> $(run_lines git status --porcelain) line(s)"
        check "working tree clean" "$(yn tree_clean)"
        echo
        echo "## no path in this mode's captured output"
        path_control
        check "the path form can count a planted path" "$path_ctl_ok"
        cat "$T/both" "$T/ls" "$T/lserr" "$T/vis" "$T/viserr" >"$T/push-captured"
        echo "  lines naming a home, mount, temp or corpus path in the captured output: $(count_matches -E "$PATH_RE" "$T/push-captured")"
        check "the captured output (push, ls-remote, gh) names no such path" "$(yn no_paths "$T/push-captured")"
        echo "push checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
        ;;
      *)
        echo "unknown mode" >&2
        exit 2
        ;;
    esac
    exit "$fail"
    

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

