        "c-af-chain": (
            '<sheetData>'
            '<row r="1"><c r="A1" t="s"><v>0</v></c><c r="B1" s="1"><v>7</v></c>'
            '<c r="C1"><f>B1+1</f><v>8</v></c></row>'
            '<row r="2"><c r="A2" t="inlineStr"><is><t>x</t></is></c>'
            '<c r="B2"><f>C1*2</f><v>16</v></c><c r="C2" s="1"/></row>'
            '<row r="4"><c r="D4"><v>3</v></c></row>'
            '</sheetData>',
            '<calcPr calcId="191029"/>', True),
        "c-a-nof": (
            '<sheetData>'
            '<row r="1"><c r="A1" t="s"><v>0</v></c></row>'
