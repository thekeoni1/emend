## the checks this log runs (python3, zipfile and expat), copied once
command: sed 's/^/    /' <scratch>/p2/p2check.py; sha256 33c2905ac0ec84c9605d81d60e9e5ec69397a6739afe112af41b6e5487c3ecd3, 28661 bytes
    """The P2 run log's own checks of --formula-sample (specs/0013, "Harness runs").
    
    Usage: p2check.py pick <input>
           p2check.py parts <input>
           p2check.py cmp <input> <output> [--plant <flag>]
           p2check.py computed <input> <output> <work dir> <image> <timeout s> [--plant <flag>]
    
    Reads the packages with zipfile and expat, sharing no code with the library
    or the tool, and makes its own pick of the edit --formula-sample should have
    made: the first sheet whose workbook relationship is of kind worksheet, in
    <sheets> order, and in it, in document order, A (the first cell whose t is
    absent or "n", which has a <v> or an <is> and no <f>), F (the first cell with
    an <f> whose t is absent or "normal") and M (the largest row number among its
    cells, 0 for none). A cell's reference is its own r, else the column after
    the previous cell of its row; a row's number is its own r, else the one
    after the previous row's.
    
    pick prints the counts the log derives its expectations from: a (1 when A
    exists), f (1 when F exists), chain (1 when the workbook part's relationships
    hold a calcChain relationship), cells (the sheet's cell count), calc_prs (the
    calcPr children of the workbook root) and calc_pr_flag (1 when the first
    already has fullCalcOnLoad). No reference, value or text.
    
    parts prints four part names on four lines, for the log to compare with the
    runner's entry rows and never print: the first worksheet, the workbook part,
    the workbook part's relationships part and the chain part (an empty line with
    no chain).
    
    cmp compares input and output and prints ONE line of counts and yes/no flags.
    When A exists:
      ws_prefix_same, ws_suffix_same  the sheet's bytes before <sheetData and
                         after </sheetData> identical;
      changed_as_edited  the changed cells are exactly A and F (A alone without
                         F), and no other cell's (s, t, formula, value) tuple moved;
      a_as_edited        A keeps its s, has no t other than "n", no formula, and
                         the value text 21;
      f_as_edited        F keeps its s, has no t, no value, and a normal formula
                         whose text is 2+3 (yes when there is no F);
      added_as_edited    the added cells are exactly (M + 1, 1) and (M + 1, 2),
                         each with no s, no t, no value and a normal formula with
                         no other attribute;
      texts_ok           their formula texts equal the texts composed from A:
                         A's reference followed by *2, and 1+1;
      nothing_removed    no input cell is missing from the output;
      wb_outside_same    workbook.xml byte-identical outside the calcPr start tag;
      calc_pr_as_edited  that tag equal to the input's with fullCalcOnLoad="1"
                         inserted after its last attribute's closing quote;
      chain_entry_ok, chain_override_ok, chain_rel_ok
                         the calcChain entry, its content-types override and its
                         workbook relationship absent from the output exactly
                         when the input has a chain, and each otherwise as the
                         input had it;
      rels_rest_same, types_rest_same
                         every other workbook relationship and every other
                         content-types element as the input's.
    When A does not exist the tool records nothing, so every flag asks for the
    input's bytes: no cell changed or added, workbook.xml identical, the chain
    as it was.
    
    computed converts the output (or a planted copy of it) once through the
    pinned LibreOffice image, the runner's own route (podman run --rm
    --network=none --userns=keep-id, the output's directory read-only as /in,
    a work directory as /out) with --convert-to xlsx, reads the converted sheet
    of the same name, and prints v_new1 (the value at (M + 1, 1) is 42), v_new2
    (at (M + 1, 2) is 2) and v_f (at F is 5, "na" without F), each yes or no;
    the converted file is deleted after the read. No value is printed.
    
    --plant <flag> makes one planted difference in the output, chosen so that
    the named flag turns from yes to no, and prints planted=no when the plant
    cannot apply to the pair (so the log can require it applied where it must).
    """
    import os
    import posixpath
    import re
    import shutil
    import subprocess
    import sys
    import xml.parsers.expat
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    TYPES = "http://schemas.openxmlformats.org/package/2006/content-types"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    CMP_PLANTS = (
        "ws_prefix_same", "ws_suffix_same", "changed_as_edited", "a_as_edited",
        "f_as_edited", "added_as_edited", "texts_ok", "nothing_removed",
        "wb_outside_same", "calc_pr_as_edited", "chain_entry_ok",
        "chain_override_ok", "chain_rel_ok", "rels_rest_same", "types_rest_same",
    )
    COMPUTED_PLANTS = ("v_new1", "v_new2", "v_f")
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def parse_rels(data, part):
        d = posixpath.dirname(part)
        found = []
    
        def start(tag, attrs):
            if tag == RELS + " Relationship":
                found.append(dict(attrs))
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.Parse(data, True)
        out = []
        for a in found:
            target = a.get("Target", "")
            if a.get("TargetMode") == "External":
                resolved = None
            else:
                resolved = (target[1:] if target.startswith("/")
                            else posixpath.normpath(posixpath.join(d, target)))
            out.append((a.get("Id"), a.get("Type", ""), resolved, tuple(sorted(a.items()))))
        return out
    
    
    def rels_of(parts, part):
        name = rels_name(part)
        return parse_rels(parts[name], part) if name in parts else []
    
    
    def workbook_of(parts):
        office = [t for (_, ty, t, _) in rels_of(parts, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def first_worksheet(parts, workbook):
        """(part, sheet name) of the first sheet of kind worksheet, in order."""
        by_id = {i: (ty, t) for (i, ty, t, _) in rels_of(parts, workbook)}
        order = []
    
        def start(tag, attrs):
            ns, _, local = tag.rpartition(" ")
            if ns in MAIN and local == "sheet":
                for a in ATTR:
                    if a + " id" in attrs:
                        order.append((attrs[a + " id"], attrs.get("name")))
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.Parse(parts[workbook], True)
        for rid, name in order:
            ty, target = by_id.get(rid, ("", None))
            if ty.endswith("/worksheet") and target in parts:
                return target, name
        return None, None
    
    
    def chain_of(parts, workbook):
        return [(i, t) for (i, ty, t, _) in rels_of(parts, workbook) if ty.endswith("/calcChain")]
    
    
    def col_of(ref):
        m = re.match(r"([A-Za-z]+)", ref or "")
        n = 0
        for ch in (m.group(1).upper() if m else ""):
            n = n * 26 + (ord(ch) - 64)
        return n
    
    
    def row_of(ref):
        m = re.search(r"(\d+)$", ref or "")
        return int(m.group(1)) if m else 0
    
    
    def a1(row, col):
        name = ""
        while col > 0:
            col, rest = divmod(col - 1, 26)
            name = chr(65 + rest) + name
        return "%s%d" % (name, row)
    
    
    def cells(data):
        """{reference: tuple} and the document order. The tuple is (s, t, has
        formula, formula t, formula attributes other than t, formula text, value
        or None); the value is the <v> text, else the <is> text."""
        out = {}
        order = []
        stack = []
        st = {"cell": None, "text": None, "row": 0, "col": 0}
    
        def start(tag, attrs):
            ns, _, local = tag.rpartition(" ")
            local = local if ns in MAIN else None
            stack.append(local)
            if local == "row" and stack[-2:-1] == ["sheetData"]:
                r = attrs.get("r")
                st["row"] = int(r) if r and r.isdigit() else st["row"] + 1
                st["col"] = 0
            if local == "c" and stack[-2:-1] == ["row"] and stack[-3:-2] == ["sheetData"]:
                r = attrs.get("r")
                if r:
                    ref = r
                else:
                    ref = a1(st["row"], st["col"] + 1)
                st["col"] = col_of(ref)
                st["cell"] = {"r": ref, "s": attrs.get("s"), "t": attrs.get("t"),
                              "f": False, "ft": None, "fa": (), "ftext": None,
                              "v": None, "is": None}
            elif st["cell"] is not None:
                if local == "f" and stack[-2:-1] == ["c"]:
                    st["cell"]["f"] = True
                    st["cell"]["ft"] = attrs.get("t")
                    st["cell"]["fa"] = tuple(sorted((k, v) for k, v in attrs.items() if k != "t"))
                    st["cell"]["ftext"] = ""
                    st["text"] = "ftext"
                elif local == "v" and stack[-2:-1] == ["c"]:
                    st["cell"]["v"] = ""
                    st["text"] = "v"
                elif local == "is" and stack[-2:-1] == ["c"]:
                    st["cell"]["is"] = ""
                elif local == "t" and "is" in stack:
                    st["text"] = "is"
    
        def end(tag):
            local = stack.pop()
            if local in ("v", "t", "f"):
                st["text"] = None
            if local == "c" and st["cell"] is not None and stack[-1:] == ["row"]:
                c = st["cell"]
                value = c["v"] if c["v"] is not None else c["is"]
                out[c["r"]] = (c["s"], c["t"], c["f"], c["ft"], c["fa"], c["ftext"], value)
                order.append(c["r"])
                st["cell"] = None
    
        def chars(text):
            if st["cell"] is not None and st["text"] is not None:
                st["cell"][st["text"]] += text
    
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.CharacterDataHandler = chars
        p.buffer_text = True
        p.Parse(data, True)
        return out, order
    
    
    def sampled(data):
        """A, F and M of one sheet, and its cells."""
        found, order = cells(data)
        a = f = None
        top = 0
        for ref in order:
            (s, t, has_f, ft, fa, ftext, value) = found[ref]
            top = max(top, row_of(ref))
            if a is None and t in (None, "n") and value is not None and not has_f:
                a = ref
            if f is None and has_f and ft in (None, "normal"):
                f = ref
        return a, f, top, found
    
    
    def calc_pr_spans(data):
        """(start, end) of every calcPr start tag among the root's children."""
        spans = []
        for m in re.finditer(rb"<([A-Za-z_][\w.-]*:)?calcPr[\s/>]", data):
            close = data.find(b">", m.start())
            spans.append((m.start(), close + 1))
        return spans
    
    
    def expected_calc_pr(tag):
        """The input's calcPr start tag with fullCalcOnLoad="1" after its last
        attribute's closing quote, or after the name with none."""
        attrs = list(re.finditer(rb"""\s[A-Za-z_][\w.:-]*\s*=\s*("[^"]*"|'[^']*')""", tag))
        if attrs:
            at = attrs[-1].end()
        else:
            at = re.match(rb"<([A-Za-z_][\w.-]*:)?calcPr", tag).end()
        return tag[:at] + b' fullCalcOnLoad="1"' + tag[at:]
    
    
    def bounds(data):
        start = re.search(rb"<([A-Za-z_][\w.-]*:)?sheetData[\s/>]", data)
        if start is None:
            return None
        close = data.find(b">", start.start())
        if data[close - 1:close] == b"/":
            return start.start(), close + 1
        ends = list(re.finditer(rb"</([A-Za-z_][\w.-]*:)?sheetData\s*>", data))
        if not ends:
            return None
        return start.start(), ends[-1].end()
    
    
    def cell_spans(data):
        spans = []
        for hit in re.finditer(rb"<([A-Za-z_][\w.-]*:)?c[\s/>]", data):
            at = hit.start()
            close = data.find(b">", at)
            if data[close - 1:close] == b"/":
                spans.append((at, close + 1))
                continue
            end = re.compile(rb"</([A-Za-z_][\w.-]*:)?c\s*>").search(data, close)
            if end is None:
                break
            spans.append((at, end.end()))
        return spans
    
    
    def span_of(data, ref):
        for (s, e) in cell_spans(data):
            m = re.search(rb'\sr\s*=\s*"([^"]*)"', data[s:e])
            if m and m.group(1).decode("ascii", "replace") == ref:
                return s, e
        return None
    
    
    def read_zip(path):
        z = zipfile.ZipFile(path)
        return {n: z.read(n) for n in z.namelist()}, z.namelist()
    
    
    def types_elements(data):
        """(Defaults, Overrides) of a content-types part as sets of attribute tuples."""
        defaults, overrides = set(), set()
    
        def start(tag, attrs):
            if tag == TYPES + " Default":
                defaults.add(tuple(sorted(attrs.items())))
            elif tag == TYPES + " Override":
                overrides.add(tuple(sorted(attrs.items())))
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.Parse(data, True)
        return defaults, overrides
    
    
    def pick(parts):
        workbook = workbook_of(parts)
        if workbook is None:
            return None
        sheet, name = first_worksheet(parts, workbook)
        if sheet is None:
            return None
        a, f, top, found = sampled(parts[sheet])
        return {"workbook": workbook, "sheet": sheet, "name": name, "a": a, "f": f,
                "top": top, "cells": found, "chain": chain_of(parts, workbook),
                "calc_prs": calc_pr_spans(parts[workbook])}
    
    
    def plant_cmp(parts, names, flag, pk):
        """Plants one difference in the output parts; returns applied."""
        sheet, workbook = pk["sheet"], pk["workbook"]
        a, f, top = pk["a"], pk["f"], pk["top"]
        new1, new2 = a1(top + 1, 1), a1(top + 1, 2)
        data = parts[sheet]
        b = bounds(data)
        if flag == "ws_prefix_same":
            parts[sheet] = data[:b[0]] + b"<!-- planted -->" + data[b[0]:]
            return True
        if flag == "ws_suffix_same":
            parts[sheet] = data[:b[1]] + b"<!-- planted -->" + data[b[1]:]
            return True
        if flag in ("changed_as_edited", "nothing_removed"):
            spans = []
            for (s, e) in cell_spans(data):
                m = re.search(rb'\sr\s*=\s*"([^"]*)"', data[s:e])
                ref = m.group(1).decode("ascii", "replace") if m else None
                if ref not in (a, f, new1, new2):
                    spans.append((s, e))
            if not spans:
                return False
            s, e = spans[-1]
            if flag == "nothing_removed":
                parts[sheet] = data[:s] + data[e:]
                return True
            cell = data[s:e]
            other = re.sub(rb'\ss\s*=\s*"[^"]*"', b' s="999"', cell, count=1)
            if other == cell:
                close = cell.find(b">")
                cut = close - 1 if cell[close - 1:close] == b"/" else close
                other = cell[:cut] + b' s="999"' + cell[cut:]
            parts[sheet] = data[:s] + other + data[e:]
            return True
        if flag == "a_as_edited" and a is not None:
            s, e = span_of(data, a)
            parts[sheet] = data[:s] + data[s:e].replace(b">21<", b">22<") + data[e:]
            return True
        if flag == "f_as_edited" and f is not None and a is not None:
            s, e = span_of(data, f)
            parts[sheet] = data[:s] + data[s:e].replace(b"2+3", b"2+4") + data[e:]
            return True
        if flag == "added_as_edited" and a is None:
            # With no A nothing may be added: one planted cell in the last row.
            close = data.rfind(b"</row>", 0, b[1])
            if close < 0:
                return False
            parts[sheet] = data[:close] + b'<c r="ZZ999998"><v>0</v></c>' + data[close:]
            return True
        if flag == "added_as_edited" and a is not None:
            s, e = span_of(data, new2)
            cell = data[s:e]
            close = cell.find(b">")
            parts[sheet] = data[:s] + cell[:close] + b' s="0"' + cell[close:] + data[e:]
            return True
        if flag == "texts_ok" and a is not None:
            s, e = span_of(data, new1)
            parts[sheet] = data[:s] + data[s:e].replace(b"*2<", b"*3<") + data[e:]
            return True
        wb = parts[workbook]
        spans = calc_pr_spans(wb)
        if flag == "wb_outside_same" and spans:
            at = spans[0][0]
            parts[workbook] = wb[:at] + b"<!-- planted -->" + wb[at:]
            return True
        if flag == "calc_pr_as_edited" and spans:
            s, e = spans[0]
            tag = wb[s:e]
            other = tag.replace(b'fullCalcOnLoad="1"', b'fullCalcOnLoad="0"')
            if other == tag:
                other = tag[:-2] + b' fullCalcOnLoad="0"' + tag[-2:] if tag.endswith(b"/>") \
                    else tag[:-1] + b' fullCalcOnLoad="0"' + tag[-1:]
            parts[workbook] = wb[:s] + other + wb[e:]
            return True
        chain_part = pk["chain"][0][1] if pk["chain"] else "xl/calcChain.xml"
        if flag == "chain_entry_ok":
            if chain_part in parts:
                del parts[chain_part]
                names.remove(chain_part)
            else:
                parts[chain_part] = b"<calcChain/>"
                names.append(chain_part)
            return True
        if flag == "chain_override_ok":
            ct = parts["[Content_Types].xml"]
            override = re.search(rb'<Override[^>]*PartName="/' + re.escape(chain_part.encode()) + rb'"[^>]*/>', ct)
            if override:
                parts["[Content_Types].xml"] = ct[:override.start()] + ct[override.end():]
            else:
                at = ct.rfind(b"</Types>")
                parts["[Content_Types].xml"] = ct[:at] + (
                    b'<Override PartName="/' + chain_part.encode() + b'" ContentType='
                    b'"application/vnd.openxmlformats-officedocument.spreadsheetml.calcChain+xml"/>') + ct[at:]
            return True
        rels = rels_name(workbook)
        if flag == "chain_rel_ok":
            data = parts[rels]
            rel = re.search(rb'<Relationship[^>]*Type="[^"]*/calcChain"[^>]*/>', data)
            if rel:
                parts[rels] = data[:rel.start()] + data[rel.end():]
            else:
                at = data.rfind(b"</Relationships>")
                parts[rels] = data[:at] + (
                    b'<Relationship Id="rIdPlanted" Type="http://schemas.openxmlformats.org/'
                    b'officeDocument/2006/relationships/calcChain" Target="calcChain.xml"/>') + data[at:]
            return True
        if flag == "rels_rest_same":
            data = parts[rels]
            at = data.rfind(b"</Relationships>")
            parts[rels] = data[:at] + (b'<Relationship Id="rIdPlanted2" Type="http://example.invalid/'
                                       b'planted" Target="planted.xml"/>') + data[at:]
            return True
        if flag == "types_rest_same":
            ct = parts["[Content_Types].xml"]
            at = ct.rfind(b"</Types>")
            parts["[Content_Types].xml"] = ct[:at] + b'<Default Extension="planted" ContentType="x/y"/>' + ct[at:]
            return True
        return False
    
    
    def compare(pin, nin, pout, nout, pk):
        """Every flag and the counts."""
        sheet, workbook = pk["sheet"], pk["workbook"]
        a, f, top = pk["a"], pk["f"], pk["top"]
        edited = a is not None
        new1, new2 = a1(top + 1, 1), a1(top + 1, 2)
        din, dout = pin[sheet], pout.get(sheet, b"")
        bi, bo = bounds(din), bounds(dout)
        fl = {}
        fl["ws_prefix_same"] = bi is not None and bo is not None and din[:bi[0]] == dout[:bo[0]]
        fl["ws_suffix_same"] = bi is not None and bo is not None and din[bi[1]:] == dout[bo[1]:]
        cin = pk["cells"]
        cout, _ = cells(dout)
        unchanged = changed = removed = 0
        changed_refs = set()
        for ref, tup in cin.items():
            if ref not in cout:
                removed += 1
            elif cout[ref] == tup:
                unchanged += 1
            else:
                changed += 1
                changed_refs.add(ref)
        added_refs = set(cout) - set(cin)
        want_changed = set()
        if edited:
            want_changed.add(a)
            if f is not None:
                want_changed.add(f)
        fl["changed_as_edited"] = changed_refs == want_changed
        if edited:
            at = cout.get(a)
            fl["a_as_edited"] = at is not None and at[0] == cin[a][0] and at[1] in (None, "n") \
                and not at[2] and at[6] == "21"
        else:
            fl["a_as_edited"] = True
        if edited and f is not None:
            ft = cout.get(f)
            fl["f_as_edited"] = ft is not None and ft[0] == cin[f][0] and ft[1] is None \
                and ft[2] and ft[3] is None and ft[4] == () and ft[5] == "2+3" and ft[6] is None
        else:
            fl["f_as_edited"] = True
    
        def plain_formula(ref):
            c = cout.get(ref)
            return c is not None and c[0] is None and c[1] is None and c[2] and c[3] is None \
                and c[4] == () and c[6] is None
        if edited:
            fl["added_as_edited"] = added_refs == {new1, new2} and plain_formula(new1) \
                and plain_formula(new2)
            fl["texts_ok"] = cout.get(new1, (None,) * 7)[5] == a + "*2" \
                and cout.get(new2, (None,) * 7)[5] == "1+1"
        else:
            fl["added_as_edited"] = added_refs == set()
            fl["texts_ok"] = True
        fl["nothing_removed"] = removed == 0
    
        win, wout = pin[workbook], pout.get(workbook, b"")
        sin, sout = calc_pr_spans(win), calc_pr_spans(wout)
        if len(sin) == 1 and len(sout) == 1:
            fl["wb_outside_same"] = win[:sin[0][0]] == wout[:sout[0][0]] \
                and win[sin[0][1]:] == wout[sout[0][1]:]
            tin, tout = win[sin[0][0]:sin[0][1]], wout[sout[0][0]:sout[0][1]]
            fl["calc_pr_as_edited"] = tout == (expected_calc_pr(tin) if edited else tin)
        else:
            fl["wb_outside_same"] = False
            fl["calc_pr_as_edited"] = False
    
        chain = pk["chain"]
        drop = edited and bool(chain)
        chain_part = chain[0][1] if chain else None
        # The chain part as the input names it, or the name the plants use.
        name = chain_part or "xl/calcChain.xml"
        fl["chain_entry_ok"] = (name in pout) == ((name in pin) and not drop)
        oin = {o for o in types_elements(pin["[Content_Types].xml"])[1]
               if dict(o).get("PartName") == "/" + name}
        dfin, ovin = types_elements(pin["[Content_Types].xml"])
        dfout, ovout = types_elements(pout.get("[Content_Types].xml", b"<Types/>"))
        oout = {o for o in ovout if dict(o).get("PartName") == "/" + name}
        fl["chain_override_ok"] = oout == (set() if drop else oin)
        rin = rels_of(pin, workbook)
        rout = rels_of(pout, workbook)
        cin_rel = {r[3] for r in rin if r[1].endswith("/calcChain")}
        cout_rel = {r[3] for r in rout if r[1].endswith("/calcChain")}
        fl["chain_rel_ok"] = cout_rel == (set() if drop else cin_rel)
        fl["rels_rest_same"] = {r[3] for r in rin if not r[1].endswith("/calcChain")} \
            == {r[3] for r in rout if not r[1].endswith("/calcChain")}
        fl["types_rest_same"] = dfin == dfout and (ovin - oin) == (ovout - oout)
        counts = {"cells_in": len(cin), "cells_out": len(cout), "unchanged": unchanged,
                  "changed": changed, "added": len(added_refs), "removed": removed}
        return fl, counts
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main_pick(path):
        parts, _ = read_zip(path)
        pk = pick(parts)
        if pk is None:
            print("found=0")
            return
        wb = parts[pk["workbook"]]
        spans = pk["calc_prs"]
        flagged = bool(spans) and b"fullCalcOnLoad" in wb[spans[0][0]:spans[0][1]]
        print("found=1 a=%d f=%d chain=%d cells=%d calc_prs=%d calc_pr_flag=%d" % (
            pk["a"] is not None, pk["f"] is not None, bool(pk["chain"]), len(pk["cells"]),
            len(spans), flagged))
    
    
    def main_parts(path):
        parts, _ = read_zip(path)
        pk = pick(parts)
        if pk is None:
            return
        print(pk["sheet"])
        print(pk["workbook"])
        print(rels_name(pk["workbook"]))
        print(pk["chain"][0][1] if pk["chain"] else "")
    
    
    def main_cmp(pin_path, pout_path, plant):
        pin, nin = read_zip(pin_path)
        pout, nout = read_zip(pout_path)
        pk = pick(pin)
        if pk is None:
            print("found=0")
            return
        planted = True
        if plant is not None:
            if plant not in CMP_PLANTS:
                print("error=unknown-plant")
                return
            planted = plant_cmp(pout, nout, plant, pk)
        fl, counts = compare(pin, nin, pout, nout, pk)
        print(" ".join(["found=1", "planted=%s" % yn(planted),
                        "a=%d" % (pk["a"] is not None), "f=%d" % (pk["f"] is not None),
                        "chain_in=%d" % bool(pk["chain"])]
                       + ["%s=%d" % kv for kv in counts.items()]
                       + ["%s=%s" % (k, yn(fl[k])) for k in CMP_PLANTS]))
    
    
    def converted_values(path, name, refs):
        """The <v> text at each reference of the sheet called name, or None."""
        parts, _ = read_zip(path)
        workbook = workbook_of(parts)
        if workbook is None:
            return None
        by_id = {i: t for (i, ty, t, _) in rels_of(parts, workbook)}
        target = []
    
        def start(tag, attrs):
            ns, _, local = tag.rpartition(" ")
            if ns in MAIN and local == "sheet" and attrs.get("name") == name:
                for a in ATTR:
                    if a + " id" in attrs:
                        target.append(by_id.get(attrs[a + " id"]))
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.Parse(parts[workbook], True)
        if len(target) != 1 or target[0] not in parts:
            return None
        found, _ = cells(parts[target[0]])
        out = {}
        for ref in refs:
            c = found.get(ref)
            v = None
            if c is not None:
                # (s, t, has f, ft, fa, ftext, value): the value is <v>'s text.
                v = c[6]
            out[ref] = v
        return out
    
    
    def number_is(v, want):
        try:
            return v is not None and float(v) == want
        except ValueError:
            return False
    
    
    def main_computed(pin_path, pout_path, work, image, timeout, plant):
        pin, _ = read_zip(pin_path)
        pk = pick(pin)
        if pk is None or pk["a"] is None:
            print("computed=na")
            return
        if plant is not None and plant not in COMPUTED_PLANTS:
            print("error=unknown-plant")
            return
        top, f, sheet = pk["top"], pk["f"], pk["sheet"]
        new1, new2 = a1(top + 1, 1), a1(top + 1, 2)
        indir = os.path.join(work, "in")
        outdir = os.path.join(work, "out")
        shutil.rmtree(work, ignore_errors=True)
        os.makedirs(indir)
        os.makedirs(outdir)
        base = "converted.xlsx"
        planted = True
        if plant is None:
            shutil.copyfile(pout_path, os.path.join(indir, base))
        else:
            # The planted copy: one formula's text changed so its value moves.
            pout, names = read_zip(pout_path)
            data = pout[sheet]
            ref, old, new = {"v_new1": (new1, b"*2<", b"*3<"), "v_new2": (new2, b"1+1", b"1+2"),
                             "v_f": (f, b"2+3", b"2+4")}[plant]
            span = span_of(data, ref) if ref is not None else None
            if span is None:
                planted = False
            else:
                s, e = span
                pout[sheet] = data[:s] + data[s:e].replace(old, new) + data[e:]
            with zipfile.ZipFile(os.path.join(indir, base), "w", zipfile.ZIP_DEFLATED) as z:
                for n in names:
                    z.writestr(n, pout[n])
        try:
            rc = subprocess.run(
                ["timeout", "--signal=KILL", str(timeout), "podman", "run", "--rm",
                 "--network=none", "--userns=keep-id", "-v", indir + ":/in:ro",
                 "-v", outdir + ":/out", image, "--convert-to", "xlsx", "--outdir", "/out",
                 "/in/" + base],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL).returncode
            converted = os.path.join(outdir, base)
            if rc != 0 or not os.path.isfile(converted):
                print("computed=error exit=%d planted=%s" % (rc, yn(planted)))
                return
            refs = [new1, new2] + ([f] if f is not None else [])
            values = converted_values(converted, pk["name"], refs)
            if values is None:
                print("computed=error sheet=missing planted=%s" % yn(planted))
                return
            v_f = "na" if f is None else yn(number_is(values[f], 5.0))
            print("computed=1 planted=%s v_new1=%s v_new2=%s v_f=%s" % (
                yn(planted), yn(number_is(values[new1], 42.0)),
                yn(number_is(values[new2], 2.0)), v_f))
        finally:
            # The converted files never outlive the read.
            shutil.rmtree(work, ignore_errors=True)
    
    
    def plant_arg(argv):
        return argv[argv.index("--plant") + 1] if "--plant" in argv else None
    
    
    if __name__ == "__main__":
        mode = sys.argv[1]
        if mode == "pick":
            main_pick(sys.argv[2])
        elif mode == "parts":
            main_parts(sys.argv[2])
        elif mode == "cmp":
            main_cmp(sys.argv[2], sys.argv[3], plant_arg(sys.argv))
        elif mode == "computed":
            main_computed(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6],
                          plant_arg(sys.argv))
        else:
            print("error=unknown-mode")
