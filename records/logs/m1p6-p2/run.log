                       '<worksheet xmlns="%s"><dimension ref="A1:D4"/>%s'
                       '<pageMargins left="0.7" right="0.7" top="0.75" bottom="0.75" header="0.3" '
                       'footer="0.3"/></worksheet>' % (NS, sheet_data))
            z.writestr("xl/sharedStrings.xml",
                       '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                       '<sst xmlns="%s" count="1" uniqueCount="1"><si><t>x</t></si></sst>' % NS)
            z.writestr("xl/styles.xml",
                       '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                       '<styleSheet xmlns="%s"><fonts count="1"><font><sz val="11"/></font></fonts>'
                       '<fills count="1"><fill><patternFill patternType="none"/></fill></fills>'
                       '<borders count="1"><border/></borders><cellStyleXfs count="1"><xf/>'
                       '</cellStyleXfs><cellXfs count="2"><xf/><xf numFmtId="2" applyNumberFormat="1"/>'
                       '</cellXfs></styleSheet>' % NS)
            if chain:
                z.writestr("xl/calcChain.xml",
                           '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                           '<calcChain xmlns="%s"><c r="C1" i="1"/><c r="B2"/></calcChain>' % NS)
    
    
    if __name__ == "__main__":
        d = sys.argv[1]
        for name, (data, calc_pr, chain) in SHEETS.items():
            build("%s/%s.xlsx" % (d, name), data, calc_pr, chain)

