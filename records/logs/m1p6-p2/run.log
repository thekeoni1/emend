                       'Target="xl/workbook.xml"/></Relationships>' % (P, R))
            z.writestr("xl/workbook.xml",
                       '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                       '<workbook xmlns="%s" xmlns:r="%s"><workbookPr/><bookViews><workbookView/>'
                       '</bookViews><sheets><sheet name="Fictional" sheetId="1" r:id="rId1"/>'
                       '</sheets>%s</workbook>' % (NS, R, calc_pr))
            z.writestr("xl/_rels/workbook.xml.rels",
                       '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                       '<Relationships xmlns="%s">%s</Relationships>' % (P, rels))
            z.writestr("xl/worksheets/sheet1.xml",
