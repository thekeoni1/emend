    #!/usr/bin/env bash
    # Milestone 1 part 6 P2 test.log (specs/0013-formulas.md, "### P2" and
    # "Harness runs", with "Planning verification and rulings on P1
    # (2026-09-23)"): cargo test for the workspace on the host and with --target
    # i686-unknown-linux-musl, colour off; the emend crate alone with the dates
    # feature off and on, on both targets; clippy on the crate with the feature
    # off, once, on the host; the tests this phase adds, derived from the source
    # and each asserted to pass on both targets; the ignored tests against the
    # base; what each code commit's message claims and counts; and the mutations
    # that show the tests bite. Each check is evaluated once (specs/0001: a check
    # with more than one condition lives in one function that returns yes or no).
    #
    # WRITTEN FOR M1 part 6 P2 from part 6 P1's final test script
    # (records/logs/m1p6-p1/test.log), audited against specs/0001 "Rules for
    # every phase" and P1's verification rulings, and grepped for P1's names,
    # paths, commit ids and typed counts. What differs from that one, and why:
    #  1. The phase, the log directory and the status terms are part 6 P2's; the
    #     previous phase's figures and names are read from
    #     records/logs/m1p6-p1/test.log.
    #  2. The commits by role come right after the shape greps: the P1 record
    #     commit, the doc commit, C1 (ruling 3's assertion and finding F2's
    #     comment), C2 (--formula-sample) and C3 (the shared string before the
    #     first number in the A-only sample test, the phase commit), each resolved by
    #     its subject with a printed command, and checked against the phase
    #     commit's parents, read by a printed rev-parse. No id is typed.
    #  3. The claims blocks are P2's. C1: its cells.rs change is comment lines
    #     alone, its test change lies in the one test it names, and the counts its
    #     message states in words ("once each", "neither", "one entry fewer") are
    #     derived from that test's source at C1 and compared with the words. C2:
    #     the tests its message names exist at C2 and not at its parent, the
    #     usage cases and the ReadBack error are added, and its message states no
    #     count: the numerals it carries are the values the spec's "Harness runs"
    #     names, checked there, and its count words are behaviours checked in the
    #     source. C3: every line it changes lies in the one test it names, the
    #     fixture puts a shared string before the number, and A becomes the
    #     number after it; its message states no count.
    #  4. The mutation block runs P1's M1 to M8 unchanged and adds M9 to M14.
    #     A mutation expected to bite is a check on each named test, M11 among
    #     them since C3. M13 is a measurement: its run is printed, and one that
    #     does not bite is a FINDING, printed with the reason, not hidden and not
    #     counted as a failed check. M9 bites, and what its failures show is
    #     printed as a FINDING: the named test fails at its direct call before
    #     write_to, and the write refuses a second recording itself, so C1's
    #     assertions after write_to are never reached under M9.
    #  5. The target directory is named once, as <scratch>/p2/target, the same
    #     in this header and in the body (P1 verification ruling 6), and the
    #     script's directory is written <scratch>/p2.
    #  6. Everything else is P1's final form: lines 1 to 3 are the command, the
    #     invocation and "about:"; then the three shape greps over this script
    #     with their controls; the SERIALIZED line with the cargo and rustc
    #     processes at entry; the by-name comparison with the previous log; the
    #     added tests derived from the source; the ignored tests derived from the
    #     source; the dates feature runs; the size-probe feature builds; the
    #     comparison of the two targets. The counts this log prints are read from
    #     the runs, never typed.
    #  7. None of the three shapes specs/0001 forbids appears here; the shapes
    #     are described rather than written out.
    #
    # Usage: m1p6-p2-test.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m1p6-p2/test.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    export CARGO_TARGET_DIR=$SELF_DIR/target
    T=$(mktemp -d)
    MUTTREE=$(mktemp -d)
    cleanup_worktree() {
      git worktree remove --force "$MUTTREE/tree" >/dev/null 2>&1
      rm -rf "$MUTTREE"
    }
    trap 'cleanup_worktree; rm -rf "$T"' EXIT INT TERM HUP
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # One function, two conditions (specs/0001).
    passed_matches() { [ "$passed" -gt 0 ] && [ "$passed" -eq "$nok" ]; }
    
    # specs/0001 "Rules for every phase": the phase commit is GIVEN to the script
    # and compared with HEAD, with a control, and both are printed. The hard guard
    # is here, before a line of log exists; the printed comparison and its control
    # are in the body below, where a reader sees them.
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    
    # The entry guard: every change must be under this phase's log directory, be
    # one of its records, or be planning's uncommitted file.
    entry_all=$(run_lines git status --porcelain)
    entry_log=$(run_matches -E '^((\?\?| ?[MARCD]) (records/logs/m1p6-p2|records/m1p6-p2-)| M (specs/0013-formulas[.]md|ROADMAP[.]md)$)' git status --porcelain)
    entry_clean() {
      [ "$entry_all" != error ] && [ "$entry_log" != error ] &&
        [ "$entry_all" = "$entry_log" ]
    }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's records" >&2
      exit 2
    fi
    
    # Every printed line passes through this scrub (header change 5): the
    # repository first, since it lies inside the home directory.
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p2#g" -e "s#$MUTTREE#<scratch>/mut#g" \
        -e "s#$T#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    # The invocation as run, with the script's directory written as <repo> or
    # <scratch>: an absolute machine path in a log is a defect (T0 P6d ruling).
    inv_path=$0
    case "$inv_path" in
      "$MAIN"/*) inv_path="<repo>/${inv_path#"$MAIN"/}" ;;
      /*) inv_path="<scratch>/p2/$(basename "$inv_path")" ;;
    esac
    echo "invocation: bash $inv_path $*"
    echo "about: M1 part 6 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001; P1 check 1's F4)"
    # It comes right after the "about:" line (independent check 2's G2: the
    # command, the invocation and "about:" are the log's first three lines, as
    # specs/0001 asks), and before any other work.
    # specs/0001: the scan greps every printed script for three forbidden shapes,
    # and the spec asks that they run over a script before its log does. They run
    # here, first, over this script's own file, each with a positive control
    # through the same command form. The patterns and the fixture are assembled
    # from pieces at run time, so this script's text holds none of the shapes.
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    SHAPE_DIR=$(mktemp -d)
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$SHAPE_DIR/fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$SHAPE_DIR/fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      SHAPE_RESULT_SELF=$n_self
      SHAPE_RESULT_FIX=$n_fix
      check "$shape: this script holds none" "$(yn [ "$SHAPE_RESULT_SELF" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$SHAPE_RESULT_FIX" = 1 ])"
    done
    rm -rf "$SHAPE_DIR"
    
    echo
    echo "## the phase's commits by role, read from git (header change 2)"
    check_fn() { local label=$1; shift; check "$label" "$(yn "$@")"; }
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M1 part 6 P1 record: ')
    DOC=$(by_subject 'M1 part 6 P2: commit planning docs (the P1 verification and rulings)')
    CODE1=$(by_subject 'M1 part 6 P2: the recipe-once assertion after write_to, and the escape comment')
    CODE2=$(by_subject 'M1 part 6 P2: emend-copy --formula-sample')
    CODE3=$(by_subject 'M1 part 6 P2: a shared string before the first number in the A-only sample test')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  the P1 record commit: ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  C1: ${CODE1:-none}"
    echo "  C2: ${CODE2:-none}"
    echo "  C3: ${CODE3:-none}"
    echo "command: git rev-parse <phase commit> <phase commit>^ <phase commit>^^ <phase commit>^^^ <phase commit>^^^^"
    git rev-parse "$C" "$C^" "$C^^" "$C^^^" "$C^^^^" | sed 's/^/    /'
    roles_in_order() {
      [ -n "$REC" ] && [ -n "$DOC" ] && [ -n "$CODE1" ] && [ -n "$CODE2" ] && [ -n "$CODE3" ] || return 1
      [ "$CODE3" = "$C" ] || return 1
      [ "$(git rev-parse "$C^")" = "$CODE2" ] || return 1
      [ "$(git rev-parse "$C^^")" = "$CODE1" ] || return 1
      [ "$(git rev-parse "$C^^^")" = "$DOC" ] || return 1
      [ "$(git rev-parse "$C^^^^")" = "$REC" ]
    }
    check_fn "C3 is the phase commit, C2 its parent, C1 C2's, the doc commit C1's, the P1 record commit the doc commit's" roles_in_order
    roles_ctl() { local CODE2=$CODE3; if roles_in_order; then return 1; else return 0; fi; }
    check_fn "control: roles_in_order refuses C3 named as C2" roles_ctl
    no_such_subject() { [ -z "$(by_subject 'M1 part 6 P2: no such subject anywhere')" ]; }
    check_fn "control: a subject no commit has resolves to nothing" no_such_subject
    echo "phase: Milestone 1 part 6 P2 (specs/0013-formulas.md) test.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      # specs/0001 "Rules for every phase": every sha256 a log cites, a superseded
      # attempt's included, is PRINTED BY A COMMAND run over a file that exists at
      # run time, never typed from memory.
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    # SERIALIZED as the coordinator arranged: no other log run started while
    # this one ran. The claim is backed by a measurement at entry: the cargo and
    # rustc processes running before this script starts any. The script still
    # uses its own target directory, <scratch>/p2/target (header change 5).
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight (the coordinator's arrangement); cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory, <scratch>/p2/target (CARGO_TARGET_DIR)"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR; CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS; $(rustc --version)"
    echo "at entry: status lines $entry_all: this phase's logs and records, or planning's uncommitted file, $entry_log"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    # The control for the comparison, in the same command form: the same function
    # against a commit that is not HEAD must say no.
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    check "control: the same comparison against a short sha of the real commit says no" \
      "$(yn not_head "$(printf '%s' "$C" | cut -c1-7)")"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    for target in host i686-unknown-linux-musl; do
      echo
      echo "## cargo test --workspace ($target)"
      if [ "$target" = host ]; then
        echo "command: cargo test --workspace"
        cargo test --workspace >"$T/$target.out" 2>&1 </dev/null
      else
        echo "command: cargo test --workspace --target $target"
        cargo test --workspace --target "$target" >"$T/$target.out" 2>&1 </dev/null
      fi
      rc=$?
      echo "exit: $rc"
      check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
      echo "Running lines, test lines and summary lines:"
      LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test .* \.\.\. |^test result: ' "$T/$target.out" | sed 's/^ */    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/$target.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/$target.names"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      ignored=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^ignored;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      nok=$(count_lines "$T/$target.names")
      echo "$target: passed $passed; failed $failed; ignored $ignored; test lines ending ok: $nok"
      check "$target: failed is 0" "$(yn [ "$failed" -eq 0 ])"
      check "$target: passed is more than 0 and equals the ok test lines" "$(yn passed_matches)"
      n=$(count_bytes "$CTRL_CLASS" "$T/$target.out")
      check "$target: control bytes in the cargo output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
      echo "$passed" >"$T/$target.count"
    done
    
    echo
    echo "## the tests per binary, which planning asked this log for"
    # For each Running or Doc-tests line, the binary it names and how many of its
    # tests passed, taken from the test result line that closes its block. The
    # binary's hash suffix is stripped, so the same table can be compared with
    # another run's: a suffix changes whenever the crate is rebuilt and carries no
    # information about the tests.
    per_binary() {
      awk '
        /^ *Running / {
          # The label comes from the compiled binary in parentheses, with its hash
          # suffix removed, because that names the CRATE; the words before it are
          # only "unittests src/lib.rs" or the tests/ file, which repeat across
          # crates. unittests and integration tests are distinguished, so a
          # library and an integration binary of the same crate stay apart.
          path = $NF
          gsub(/[()]/, "", path)
          parts = split(path, piece, "/")
          label = piece[parts]
          sub(/-[0-9a-f]+$/, "", label)
          current = (($2 == "unittests") ? "unittests " : "integration ") label
          next
        }
        /^ *Doc-tests / { current = "doc-tests " $2; next }
        /^test result: / {
          if (current == "") next
          for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n = $i
          printf "%s %d\n", current, n
          current = ""
        }
      ' "$1" | sort
    }
    for target in host i686-unknown-linux-musl; do
      per_binary "$T/$target.out" >"$T/$target.per"
    done
    # The tool's integration binary's own names, from its section of the host
    # run, used by the by-name comparison below.
    awk '
      /^ *Running tests\/null_rewrite\.rs/ { inblock = 1; next }
      inblock && /^test result: / { inblock = 0 }
      inblock && /^test .* \.\.\. ok$/ { sub(/^test /, ""); sub(/ \.\.\. ok$/, ""); print }
    ' "$T/host.out" | sort >"$T/tool.sorted"
    sed 's/^/    /' "$T/host.per"
    sum_per=$(awk '{ n += $NF } END { print n + 0 }' "$T/host.per")
    echo "  the per-binary counts sum to $sum_per; the run's own passed total was $(cat "$T/host.count")"
    check "the per-binary counts sum to the run's passed total" \
      "$(yn [ "$sum_per" = "$(cat "$T/host.count")" ])"
    check "the two targets produce the same per-binary breakdown" \
      "$(yn cmp -s "$T/host.per" "$T/i686-unknown-linux-musl.per")"
    # The control for the extraction, in the same command form: a stream with no
    # Running line yields no rows, so a silent awk failure cannot read as "no
    # tests" indistinguishably from a correct empty answer.
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n' >"$T/c-per"
    per_binary "$T/c-per" >"$T/c-per.out"
    nctl_per=$(count_lines "$T/c-per.out")
    echo "  control: a result line with no Running line above it yields $nctl_per rows"
    check "control: the per-binary form attributes nothing to a binary it never saw named" \
      "$(yn [ "$nctl_per" = 0 ])"
    # A positive control for the same form, so the 0 above cannot be a form that
    # never counts anything: a Running line and its result must yield one row.
    printf '     Running unittests src/lib.rs (target/debug/deps/libctl-0123456789abcdef)\ntest result: ok. 7 passed; 0 failed; 0 ignored\n' >"$T/c-per-hit"
    per_binary "$T/c-per-hit" >"$T/c-per-hit.out"
    sed 's/^/    control row: /' "$T/c-per-hit.out"
    check "control: a Running line and its result yield one row naming the crate and its count" \
      "$(yn [ "$(cat "$T/c-per-hit.out")" = "unittests libctl 7" ])"
    # The library's figure and the workspace total beside the previous phase's,
    # read from that phase's committed log rather than typed.
    LIB_NOW=$(awk '$1 == "unittests" && $2 == "emend" { n += $3 } END { print n + 0 }' "$T/host.per")
    PREV_LOG=records/logs/m1p6-p1/test.log
    PREV_TOTAL=$(sed -n 's/^host executed \([0-9]*\) tests;.*/\1/p' "$PREV_LOG")
    NOW_TOTAL=$(cat "$T/host.count")
    echo "  the library's own tests in this run: $LIB_NOW"
    echo "  the workspace total: this phase $NOW_TOTAL, the previous phase $PREV_TOTAL (read from $PREV_LOG)"
    check "the previous phase's total was read from its committed log" "$(yn [ -n "$PREV_TOTAL" ])"
    awk '
      /^## cargo test --workspace \(host\)$/ { inblock = 1; next }
      /^## / { inblock = 0 }
      inblock && /^    test .* \.\.\. ok$/ { sub(/^    test /, ""); sub(/ \.\.\. ok$/, ""); print }
    ' "$PREV_LOG" | sort >"$T/prev.names"
    nprev_names=$(count_lines "$T/prev.names")
    echo "  test names the previous log's host run printed: $nprev_names"
    check "the previous log's names account for its whole host total" "$(yn [ "$nprev_names" = "$PREV_TOTAL" ])"
    comm -13 "$T/prev.names" "$T/host.names" >"$T/added.names"
    comm -23 "$T/prev.names" "$T/host.names" >"$T/removed.names"
    nadded=$(count_lines "$T/added.names")
    nremoved=$(count_lines "$T/removed.names")
    echo "  test names added since the previous phase: $nadded; removed: $nremoved"
    sed 's/^/    added: /' "$T/added.names"
    sed 's/^/    removed: /' "$T/removed.names"
    total_moved_by_names() {
      [ -n "$PREV_TOTAL" ] && [ "$NOW_TOTAL" -eq "$((PREV_TOTAL + nadded - nremoved))" ]
    }
    check "this phase's workspace total is the previous phase's plus the names added less the names removed" \
      "$(yn total_moved_by_names)"
    # The control for the comparison, through the same command form: the previous
    # names against themselves add and remove nothing, and a list with one name
    # more adds exactly that one.
    comm -3 "$T/prev.names" "$T/prev.names" >"$T/c-names"
    check "control: the same comparison of a list with itself finds no difference" \
      "$(yn [ "$(count_lines "$T/c-names")" = 0 ])"
    { cat "$T/prev.names"; echo "zzz::control::name"; } | sort >"$T/c-names-plus"
    check "control: a list with one name more is found to add exactly one" \
      "$(yn [ "$(comm -13 "$T/prev.names" "$T/c-names-plus" | wc -l)" = 1 ])"
    
    echo
    echo "## the tests this phase adds and removes, derived from the source (header change 6)"
    # The base is resolved from git as gate.log resolves it: the parent of the
    # first doc commit, found by its subject.
    BASE_DOC=$(git log --format='%H' -n 1 --grep='^M1 part 6 P2: commit planning docs [(]the P1 verification and rulings')
    BASE=$(git rev-parse --verify "$BASE_DOC^" 2>/dev/null)
    echo "command: git log --format=%H -n 1 --grep=<the first doc commit's subject>, and its parent"
    echo "  the first doc commit: $BASE_DOC; the phase base: $BASE"
    check "the phase base resolved from git" "$(yn [ -n "$BASE" ])"
    # #[test] functions of one file at one commit: the name of the first fn line
    # after a #[test] line, other attribute lines between them allowed.
    tests_attr() { git show "$1:$2" 2>/dev/null | tests_in; }
    tests_in() {
      awk '
        /^[ \t]*#\[test\][ \t]*$/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]/ {
          sub(/^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next
        }
        t { t = 0 }' | sort
    }
    git diff --name-only "$BASE" "$C" -- '*.rs' >"$T/changed-rs"
    echo "  the .rs files the phase changed:"
    sed 's/^/    /' "$T/changed-rs"
    : >"$T/src-added"
    : >"$T/src-removed"
    while IFS= read -r f; do
      tests_attr "$C" "$f" >"$T/at-c"
      tests_attr "$BASE" "$f" >"$T/at-base"
      comm -13 "$T/at-base" "$T/at-c" | sed "s#^#$f #" >>"$T/src-added"
      comm -23 "$T/at-base" "$T/at-c" | sed "s#^#$f #" >>"$T/src-removed"
    done <"$T/changed-rs"
    echo "  #[test] functions at the phase commit and not at the base, by file:"
    sed 's/^/    /' "$T/src-added"
    echo "  #[test] functions at the base and not at the phase commit, by file:"
    sed 's/^/    /' "$T/src-removed"
    nsrc_added=$(count_lines "$T/src-added")
    nsrc_removed=$(count_lines "$T/src-removed")
    check "the source adds tests in this phase ($nsrc_added)" "$(yn [ "$nsrc_added" -ge 1 ])"
    # The run's added and removed names, module prefix dropped, against the
    # source's: each set exactly the other.
    awk '{ print $2 }' "$T/src-added" | sort >"$T/src-added.names"
    awk '{ print $2 }' "$T/src-removed" | sort >"$T/src-removed.names"
    sed 's/^.*:://' "$T/added.names" | sort >"$T/run-added.names"
    sed 's/^.*:://' "$T/removed.names" | sort >"$T/run-removed.names"
    check "the names the run added are exactly the tests the source added" \
      "$(yn cmp -s "$T/run-added.names" "$T/src-added.names")"
    check "the names the run lost are exactly the tests the source removed" \
      "$(yn cmp -s "$T/run-removed.names" "$T/src-removed.names")"
    # Every added test passed, by name, on each target.
    passed_on() { count_matches -E "(^|::)$1\$" "$T/$2.names"; }
    both_passed() {
      [ "$(passed_on "$1" host)" = 1 ] && [ "$(passed_on "$1" i686-unknown-linux-musl)" = 1 ]
    }
    echo "  each added test, and whether it ran and passed on each target:"
    while read -r f name; do
      echo "    $name ($f): host $(passed_on "$name" host), i686-unknown-linux-musl $(passed_on "$name" i686-unknown-linux-musl)"
      check "  $name passed on both targets" "$(yn both_passed "$name")"
    done <"$T/src-added"
    # Controls in the same forms: a name no run holds is not found, a fixture file
    # with one #[test] behind another attribute yields its name, and a file absent
    # at a commit yields none.
    not_passed_ctl() { if both_passed zzz_no_such_test_anywhere; then return 1; else return 0; fi; }
    check "control: both_passed refuses a name no run holds" "$(yn not_passed_ctl)"
    printf '#[test]\n#[should_panic]\nfn ctl_one() {}\nfn not_a_test() {}\n#[test]\nfn ctl_two() -> Result<(), ()> { Ok(()) }\n' >"$T/c-src"
    tests_in <"$T/c-src" >"$T/c-src.names"
    sed 's/^/    control name: /' "$T/c-src.names"
    check "control: tests_in reads a #[test] behind another attribute and skips a plain fn" \
      "$(yn [ "$(tr '\n' ' ' <"$T/c-src.names")" = "ctl_one ctl_two " ])"
    check "control: tests_attr yields no name for a file absent at the base" \
      "$(yn [ "$(tests_attr "$BASE" crates/emend/src/no-such-file.rs | count_lines /dev/stdin)" = 0 ])"
    
    echo
    echo "## the library's modules' tests, named, on both targets"
    # Each module's names are printed so a reader checks them against the spec's
    # lists case by case; the count on each target is compared (a test compiled
    # out on one target is what T6 P1 case B3 exists for). The previous phase's
    # per-module figures are subsumed by the whole-set comparison above (header
    # change 2).
    for mod in archive xml package cells styles dates; do
      echo "### $mod"
      LC_ALL=C "$G" -E "^$mod::tests::" "$T/host.names" | sed 's/^/    /'
      nmod=$(count_matches -E "^$mod::tests::" "$T/host.names")
      nmod_i686=$(count_matches -E "^$mod::tests::" "$T/i686-unknown-linux-musl.names")
      echo "  $mod module tests: host $nmod, i686-unknown-linux-musl $nmod_i686"
      check "the $mod module runs tests" "$(yn [ "$nmod" -ge 1 ])"
      check "the $mod module's test count is the same on both targets" "$(yn [ "$nmod" = "$nmod_i686" ])"
    done
    
    echo
    echo "## the core alone, the dates feature off and on (part 5 P3 ruling 4, kept: header change 6)"
    # The workspace runs above unify the feature on (emend-copy enables it), so they
    # cannot show the crate builds and tests without it. These runs can: the plain
    # run must hold NO dates test and the feature run exactly the workspace run's
    # dates names, and the two must agree on every other name.
    lib_names() {
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$1" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort
    }
    LC_ALL=C "$G" -E '^dates::tests::' "$T/host.names" >"$T/ws-dates.names"
    for target in host i686-unknown-linux-musl; do
      if [ "$target" = host ]; then tflag=(); else tflag=(--target "$target"); fi
      for feat in off on; do
        if [ "$feat" = on ]; then fflag=(--features dates); else fflag=(); fi
        echo "command: cargo test -p emend ${fflag[*]} ${tflag[*]}"
        cargo test -p emend "${fflag[@]}" "${tflag[@]}" >"$T/lib-$feat-$target.out" 2>&1 </dev/null
        rc=$?
        echo "exit: $rc"
        LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$T/lib-$feat-$target.out" | sed 's/^ */    /'
        check "$target, feature $feat: cargo test -p emend exits 0" "$(yn [ "$rc" -eq 0 ])"
        lib_names "$T/lib-$feat-$target.out" >"$T/lib-$feat-$target.names"
        n_all=$(count_lines "$T/lib-$feat-$target.names")
        n_dates=$(count_matches -E '^dates::tests::' "$T/lib-$feat-$target.names")
        echo "  $target, feature $feat: tests ending ok $n_all; of them dates tests $n_dates"
      done
      n_off=$(count_matches -E '^dates::tests::' "$T/lib-off-$target.names")
      check "$target: the plain run holds no dates test ($n_off)" "$(yn [ "$n_off" = 0 ])"
      LC_ALL=C "$G" -E '^dates::tests::' "$T/lib-on-$target.names" >"$T/lib-on-$target.dates"
      check "$target: the feature run holds exactly the workspace run's dates names" \
        "$(yn cmp -s "$T/lib-on-$target.dates" "$T/ws-dates.names")"
      LC_ALL=C "$G" -vE '^dates::tests::' "$T/lib-on-$target.names" >"$T/lib-on-$target.rest"
      check "$target: apart from the dates tests the two runs ran the same names" \
        "$(yn cmp -s "$T/lib-off-$target.names" "$T/lib-on-$target.rest")"
    done
    # The control for the absence, through the same count: the feature run's own
    # file does hold dates names, so the zero above is the plain run's and not a
    # pattern that never matches.
    n_ctl=$(count_matches -E '^dates::tests::' "$T/lib-on-host.names")
    check "control: the same count over the host feature run finds its dates tests ($n_ctl)" \
      "$(yn [ "$n_ctl" -ge 1 ])"
    check "the plain runs agree across the two targets" \
      "$(yn cmp -s "$T/lib-off-host.names" "$T/lib-off-i686-unknown-linux-musl.names")"
    echo "command: cargo clippy -p emend --all-targets -- -D warnings"
    cargo clippy -p emend --all-targets -- -D warnings >"$T/lib-clippy-off.out" 2>&1 </dev/null
    rc=$?
    echo "exit: $rc"
    # cargo names the crate's directory; the repository root is written as <repo>
    # (part 5 P3's attempt 1 printed it bare, an absolute machine path); the
    # log's scrub would catch it too.
    sed "s#$(pwd)#<repo>#g; s/^/    /" "$T/lib-clippy-off.out"
    check "host: clippy on the core with the dates feature off passes" "$(yn [ "$rc" -eq 0 ])"
    
    echo
    echo "## the tool's integration tests, named"
    # Taken from the null_rewrite binary's OWN section of the cargo output, not by
    # a name prefix: the xlsx-diff and passthrough integration tests carry no
    # module prefix either, so a prefix filter would count them as the tool's.
    for target in host i686-unknown-linux-musl; do
      awk '
        /^ *Running tests\/null_rewrite\.rs/ { inblock = 1; next }
        inblock && /^test result: / { inblock = 0 }
        inblock && /^test .* \.\.\. ok$/ {
          sub(/^test /, ""); sub(/ \.\.\. ok$/, ""); print
        }
      ' "$T/$target.out" | sort >"$T/$target.tool"
    done
    sed 's/^/    /' "$T/host.tool"
    ntool=$(count_lines "$T/host.tool")
    ntool_i686=$(count_lines "$T/i686-unknown-linux-musl.tool")
    echo "  tests in the tool's null_rewrite binary: host $ntool, i686-unknown-linux-musl $ntool_i686"
    PREV_TOOL=$(sed -n "s/^  tests in the tool's null_rewrite binary: host \\([0-9]*\\),.*/\\1/p" "$PREV_LOG")
    echo "  the previous phase's tool count, read from $PREV_LOG: $PREV_TOOL"
    check "the previous phase's tool count was read from its committed log" "$(yn [ -n "$PREV_TOOL" ])"
    # The tool's added and removed names are the source's for its test file.
    ntool_added=$(count_matches -E '^tools/emend-copy/tests/null_rewrite[.]rs ' "$T/src-added")
    ntool_removed=$(count_matches -E '^tools/emend-copy/tests/null_rewrite[.]rs ' "$T/src-removed")
    echo "  the tool's tests the source added: $ntool_added; removed: $ntool_removed"
    tool_moved_by_names() {
      [ -n "$PREV_TOOL" ] && [ "$ntool" -eq "$((PREV_TOOL + ntool_added - ntool_removed))" ]
    }
    check "the tool's integration tests are the previous phase's plus the source's added less its removed" \
      "$(yn tool_moved_by_names)"
    check "the tool's tests are the same names on both targets" "$(yn cmp -s "$T/host.tool" "$T/i686-unknown-linux-musl.tool")"
    # The control for the extraction above, through the same command form: a
    # Running line that is not the tool's yields none of the tool's names.
    awk '
      /^ *Running tests\/no-such-binary\.rs/ { inblock = 1; next }
      inblock && /^test result: / { inblock = 0 }
      inblock && /^test .* \.\.\. ok$/ { print }
    ' "$T/host.out" >"$T/tool-control"
    nctl=$(count_lines "$T/tool-control")
    check "control: the same extraction for a binary that does not exist yields 0 names ($nctl)" "$(yn [ "$nctl" = 0 ])"
    
    echo
    echo "## the ignored tests, derived from the source (header change 6)"
    # The functions under an #[ignore] attribute, at the base and at the phase
    # commit, across every tracked .rs file; each run's ignored tests must be
    # exactly that set, so no test this phase touched is ignored.
    ignored_in() {
      awk '
        /^[ \t]*#\[ignore/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?fn[ \t]/ { sub(/^[ \t]*(pub[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next }
        t { t = 0 }'
    }
    ignored_at() {
      git ls-tree -r --name-only "$1" | LC_ALL=C "$G" -E '[.]rs$' | while IFS= read -r f; do
        git show "$1:$f" | ignored_in
      done | sort
    }
    ignored_at "$BASE" >"$T/ign-base"
    ignored_at "$C" >"$T/ign-c"
    sed 's/^/    ignored in the source at the base: /' "$T/ign-base"
    sed 's/^/    ignored in the source at the phase commit: /' "$T/ign-c"
    check "the phase commit ignores exactly the tests the base ignored" "$(yn cmp -s "$T/ign-base" "$T/ign-c")"
    for target in host i686-unknown-linux-musl; do
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" | sed 's/^/    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" |
        sed -E 's/^test ([^ ]*) \.\.\. ignored.*/\1/; s/^.*:://' | sort >"$T/ign-run-$target"
      check "$target: the run's ignored tests are exactly the source's ($(count_lines "$T/ign-run-$target"))" \
        "$(yn cmp -s "$T/ign-run-$target" "$T/ign-c")"
    done
    # Controls in the same forms: a fixture with one ignored fn behind a second
    # attribute yields that name alone, and the run comparison refuses a set one
    # name longer.
    printf '#[test]\n#[ignore = "why"]\n#[cfg(unix)]\nfn ctl_ignored() {}\n#[test]\nfn ctl_run() {}\n' | ignored_in >"$T/c-ign"
    check "control: ignored_in reads the one ignored fixture test ($(tr '\n' ' ' <"$T/c-ign"))" \
      "$(yn [ "$(cat "$T/c-ign")" = ctl_ignored ])"
    { cat "$T/ign-c"; echo zzz_control; } | sort >"$T/c-ign-plus"
    check "control: the same comparison refuses a set one name longer" \
      "$(yn [ "$(comm -3 "$T/c-ign-plus" "$T/ign-c" | count_lines /dev/stdin)" = 1 ])"
    
    echo
    echo "## size-probe with the xml feature (the workspace runs above skip probe-zip-xml, which requires it)"
    for target in host i686-unknown-linux-musl; do
      if [ "$target" = host ]; then tflag=(); else tflag=(--target "$target"); fi
      echo "command: cargo build -p size-probe --features xml --all-targets ${tflag[*]}"
      cargo build -p size-probe --features xml --all-targets "${tflag[@]}" >"$T/xml-build-$target.out" 2>&1 </dev/null
      rc=$?
      echo "exit: $rc"
      check "$target: size-probe builds with the xml feature" "$(yn [ "$rc" -eq 0 ])"
      echo "command: cargo clippy -p size-probe --features xml --all-targets ${tflag[*]} -- -D warnings"
      cargo clippy -p size-probe --features xml --all-targets "${tflag[@]}" -- -D warnings >"$T/xml-clippy-$target.out" 2>&1 </dev/null
      rc=$?
      echo "exit: $rc"
      check "$target: clippy with the xml feature passes" "$(yn [ "$rc" -eq 0 ])"
      n=$(count_bytes "$CTRL_CLASS" "$T/xml-clippy-$target.out")
      check "$target: control bytes in the clippy output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
    done
    
    echo
    echo "## the core builds and passes clippy with both features of the probes"
    # quick-xml is now a dependency of the core itself, so the emend probes link it
    # transitively. Both feature sets are built here, because a feature that no
    # workspace member enables is in no build at all (T0 P4).
    for target in host i686-unknown-linux-musl; do
      if [ "$target" = host ]; then tflag=(); else tflag=(--target "$target"); fi
      echo "command: cargo clippy -p size-probe --features emend,xml --all-targets ${tflag[*]} -- -D warnings"
      cargo clippy -p size-probe --features emend,xml --all-targets "${tflag[@]}" -- -D warnings \
        >"$T/both-clippy-$target.out" 2>&1 </dev/null
      rc=$?
      echo "exit: $rc"
      check "$target: clippy with both features passes" "$(yn [ "$rc" -eq 0 ])"
    done
    
    echo
    echo "## the probes' dates feature set (part 5 P3's block, kept: header change 6)"
    # Only probe-emend-dates-write-xml requires it; the feature set is the one the
    # size log builds that probe with.
    for target in host i686-unknown-linux-musl; do
      if [ "$target" = host ]; then tflag=(); else tflag=(--target "$target"); fi
      echo "command: cargo clippy -p size-probe --features dates --all-targets ${tflag[*]} -- -D warnings"
      cargo clippy -p size-probe --features dates --all-targets "${tflag[@]}" -- -D warnings \
        >"$T/dates-clippy-$target.out" 2>&1 </dev/null
      rc=$?
      echo "exit: $rc"
      check "$target: clippy with the dates feature set passes" "$(yn [ "$rc" -eq 0 ])"
    done
    
    echo
    echo "## the mutations, and what each one broke"
    # specs/0001 "Rules for every phase": a claim that a test BITES is a printed
    # measurement in test.log. Each mutation is applied to a DETACHED WORKTREE of
    # the phase commit, with its own CARGO_TARGET_DIR, so nothing touches the tree
    # this log is being written from. The applier refuses a mutation whose text it
    # cannot find exactly once, so a mutation that applied to nothing cannot read
    # as a test that failed to bite.
    git worktree add --detach "$MUTTREE/tree" "$C" >"$T/worktree.out" 2>&1
    wt=$?
    echo "command: git worktree add --detach <scratch>/mut/tree $C"
    echo "exit: $wt"
    check "the worktree for the mutations was created at the phase commit" "$(yn [ "$wt" -eq 0 ])"
    check "the worktree's HEAD is the phase commit" "$(yn [ "$(git -C "$MUTTREE/tree" rev-parse HEAD)" = "$C" ])"
    
    cat >"$MUTTREE/mutate.py" <<'PYEOF'
    import sys
    
    CELLS = "crates/emend/src/cells.rs"
    PACKAGE = "crates/emend/src/package.rs"
    STYLES = "crates/emend/src/styles.rs"
    TOOL = "tools/emend-copy/src/main.rs"
    
    MUTATIONS = {
        # M1: the formula text escaped with escape, which also escapes quotes,
        # instead of partial_escape (ruling 2).
        "M1": [(CELLS, "quick_xml::escape::partial_escape(text.as_str())",
                "quick_xml::escape::escape(text.as_str())")],
        # M2: the formula-change rule drops the chain but records no flag.
        "M2": [(PACKAGE,
                "        self.drop_calc_chain_once()?;\n        self.edits.recalculate = true;\n        self.validate()\n",
                "        self.drop_calc_chain_once()?;\n        self.validate()\n")],
        # M3: definedNames missing from the nine children before calcPr.
        "M3": [(PACKAGE, "const BEFORE_CALC_PR: [&[u8]; 9] = [", "const BEFORE_CALC_PR: [&[u8]; 8] = ["),
               (PACKAGE, "    b\"definedNames\",\n", "")],
        # M4: the attribute appended at the tag's end, after its closing >,
        # instead of after the last attribute's closing quote. The field is made
        # crate-visible so the mutation compiles.
        "M4": [(STYLES, "    end: usize,\n", "    pub(crate) end: usize,\n"),
               (PACKAGE, "        Some(last) => last.value.end + 1,\n", "        Some(_) => tag.end,\n")],
        # M5: validation no longer refuses two calcPr.
        "M5": [(PACKAGE, "            if self.calc_prs > 1 {\n                return Err(TWO_CALC_PRS);\n            }\n", "")],
        # M6: writes_formula asks whether ANY value edit is a formula, not the
        # last one for its reference.
        "M6": [(PACKAGE,
                "        self.cell_parts().iter().any(|part| {\n"
                "            self.cell_edits_of(part)\n"
                "                .iter()\n"
                "                .any(|(_, edit)| matches!(edit.value, Some(Some(Value::Formula(_)))))\n"
                "        })\n",
                "        self.cell_edits\n"
                "            .iter()\n"
                "            .any(|(_, _, value)| matches!(value, Some(Value::Formula(_))))\n")],
        # M7: the leading "=" refusal removed.
        "M7": [(CELLS,
                "            Value::Formula(text) if text.starts_with('=') => {\n"
                "                Err(Error::Package(\"a formula text starts with an equals sign\"))\n"
                "            }\n", "")],
        # M8: --calc prints full_calc from the chain's presence.
        "M8": [(TOOL, "    let full_calc = u64::from(workbook.full_calc_on_load);",
                "    let full_calc = u64::from(workbook.calc_chain.is_some());")],
        # M9: drop_calc_chain_once always records the recipe, so a caller's
        # drop and the rule's record it twice.
        "M9": [(PACKAGE,
                "        if !self.calc_chain_pending()? {\n            self.drop_calc_chain()?;\n        }\n",
                "        self.drop_calc_chain()?;\n")],
        # M10: the sample's F edit removed.
        "M10": [(TOOL,
                 "        if let Some(normal) = before.normal {\n            written.push((normal, \"2+3\".to_string()));\n        }\n",
                 "")],
        # M11: the A candidate accepts a SharedString cell too.
        "M11": [(TOOL,
                 "        let number = cell.kind == Kind::Number && cell.value.is_some() && cell.formula.is_none();",
                 "        let number = (cell.kind == Kind::Number || cell.kind == Kind::SharedString)\n            && cell.value.is_some()\n            && cell.formula.is_none();")],
        # M12: the composed text multiplies by 3.
        "M12": [(TOOL, "            format!(\"{}*2\", number.a1()),", "            format!(\"{}*3\", number.a1()),")],
        # M13: the read-back's text comparison removed.
        "M13": [(TOOL, "                    formula.kind == FormulaKind::Normal && formula.text == *text",
                 "                    formula.kind == FormulaKind::Normal")],
        # M14: without A the sample still writes 1+1 in the new row.
        "M14": [(TOOL, "    let added = if before.number.is_some() { 2 } else { 0 };",
                 "    if before.number.is_none() {\n"
                 "        let row = before.max_row + 1;\n"
                 "        package.set_cell(&part, CellRef { row, col: 2 }, Value::Formula(\"1+1\".to_string()));\n"
                 "    }\n"
                 "    let added = if before.number.is_some() { 2 } else { 0 };")],
    }
    
    which = sys.argv[1]
    root = sys.argv[2]
    for path, old, new in MUTATIONS[which]:
        full = root + "/" + path
        body = open(full).read()
        found = body.count(old)
        if found != 1:
            print("REFUSED %s: the text to replace in %s occurs %d times, not once" % (which, path, found))
            sys.exit(2)
        body = body.replace(old, new, 1)
        open(full, "w").write(body)
        print("    applied %s to %s: %d bytes -> %d bytes" % (which, path, len(old), len(new)))
    PYEOF
    echo
    echo "## the mutation applier this block runs"
    sed 's/^/    /' "$MUTTREE/mutate.py"
    
    mut_expect() {
      case "$1" in
        M1) echo "package::tests::a_formula_text_is_escaped_and_reads_back_equal" ;;
        M2) echo "package::tests::a_written_formula_drops_the_chain_and_sets_the_flag" ;;
        M3) echo "package::tests::an_absent_calc_pr_goes_after_the_last_of_the_nine" ;;
        M4) echo "package::tests::a_present_calc_pr_gains_or_takes_the_attribute_and_keeps_every_other_byte" ;;
        M5) echo "package::tests::a_workbook_with_two_calc_prs_is_refused_at_write_with_no_output" ;;
        M6) echo "package::tests::a_formula_overridden_by_a_number_leaves_the_chain_and_calc_pr" ;;
        M7) echo "package::tests::a_formula_text_starting_with_an_equals_sign_is_refused" ;;
        M8) echo "calc_prints_the_two_flags_and_edits_nothing" ;;
        M9) echo "package::tests::the_callers_drop_then_a_written_formula_records_the_recipe_once" ;;
        M10) echo "the_part6_formula_sample_writes_a_and_f_and_drops_the_chain" ;;
        M11) echo "the_part6_formula_sample_with_a_and_no_f_adds_the_row_alone" ;;
        M12) echo "the_part6_formula_sample_writes_a_and_f_and_drops_the_chain the_part6_formula_sample_with_a_and_no_f_adds_the_row_alone" ;;
        M13) echo "the_part6_formula_sample_writes_a_and_f_and_drops_the_chain" ;;
        M14) echo "the_part6_formula_sample_with_neither_is_byte_identical" ;;
        *) echo "" ;;
      esac
    }
    mut_crate() {
      case "$1" in
        M8|M10|M11|M12|M13|M14) echo emend-copy ;;
        *) echo emend ;;
      esac
    }
    # M13 is measured (header change 4): its run and failures are printed, and a
    # run in which every test passes is a FINDING.
    mut_mode() {
      case "$1" in
        M13) echo measure ;;
        *) echo bite ;;
      esac
    }
    : >"$T/findings"
    # A compiler error line: rustc's coded form, or cargo's "could not compile".
    # cargo's "test failed" and "target(s) failed" lines are not compiler errors.
    compile_errors() { count_matches -E '^error(\[E[0-9]+\]|: could not compile )' "$1"; }
    printf 'error[E0308]: mismatched types\nerror: could not compile `emend` (lib test) due to 1 previous error\n' >"$T/c-compile"
    printf 'error: test failed, to rerun pass `-p emend --lib`\nerror: 1 target failed:\n' >"$T/c-testfail"
    check "control: the compiler-error form counts a coded error and a could-not-compile line ($(compile_errors "$T/c-compile"))" \
      "$(yn [ "$(compile_errors "$T/c-compile")" = 2 ])"
    check "control: the compiler-error form counts none of cargo's test-failure lines ($(compile_errors "$T/c-testfail"))" \
      "$(yn [ "$(compile_errors "$T/c-testfail")" = 0 ])"
    blocks() {
      awk '/^---- .* stdout ----$/ { inb = 1; print; next }
           /^note: run with/ || /^failures:$/ { inb = 0 }
           inb && NF { print }' "$1"
    }
    
    : >"$T/mut-table"
    for m in M1 M2 M3 M4 M5 M6 M7 M8 M9 M10 M11 M12 M13 M14; do
      echo
      echo "### $m"
      ( cd "$MUTTREE/tree" && git checkout -q -- . ) || fail=1
      python3 "$MUTTREE/mutate.py" "$m" "$MUTTREE/tree" >"$T/mut-$m.apply" 2>&1
      arc=$?
      sed 's/^/  /' "$T/mut-$m.apply"
      check "$m: the applier found its text exactly once and replaced it" "$(yn [ "$arc" -eq 0 ])"
      if [ "$arc" -ne 0 ]; then echo "$m applier-refused" >>"$T/mut-table"; continue; fi
      echo "  the planted change, as git diff prints it in the worktree:"
      git -C "$MUTTREE/tree" diff | sed 's/^/    /'
      crate=$(mut_crate "$m")
      echo "command: cargo test --no-fail-fast -p $crate (in the mutated worktree)"
      ( cd "$MUTTREE/tree" && CARGO_TARGET_DIR="$MUTTREE/target" \
          cargo test --no-fail-fast -p "$crate" ) \
        >"$T/mut-$m.out" 2>&1 </dev/null
      rc=$?
      echo "exit: $rc"
      mode=$(mut_mode "$m")
      if [ "$mode" = bite ]; then
        check "$m: the mutated tree does not pass its tests" "$(yn [ "$rc" -ne 0 ])"
      fi
      # A mutation that does not compile would also fail; the failing test must
      # be named below, so a build failure cannot pass for a test that bites.
      echo "  cargo's error lines:"
      LC_ALL=C "$G" -E '^error' "$T/mut-$m.out" | sed 's/^/    /'
      nerr=$(compile_errors "$T/mut-$m.out")
      check "$m: the mutated tree compiles ($nerr compiler error lines)" "$(yn [ "$nerr" = 0 ])"
      echo "  the failures, with what each assertion printed:"
      blocks "$T/mut-$m.out" | sed 's/^/    /'
      LC_ALL=C "$G" -E '^test result: FAILED' "$T/mut-$m.out" | sed 's/^/    /'
      nmsg_lines=$(blocks "$T/mut-$m.out" | awk '!/^---- / && !/panicked at/ { n++ } END { print n + 0 }')
      if [ "$mode" = bite ]; then
        check "$m: the failure output carries the assertion's own message or values ($nmsg_lines lines)" \
          "$(yn [ "$nmsg_lines" -ge 1 ])"
      fi
      LC_ALL=C "$G" -E '^ +[a-z_:0-9]+$' "$T/mut-$m.out" | sed 's/^ *//' | sort -u >"$T/mut-$m.failed"
      echo "  the failing test names this run reports:"
      sed 's/^/    /' "$T/mut-$m.failed"
      hit=0
      nwant=0
      for want in $(mut_expect "$m"); do
        nwant=$((nwant + 1))
        h=$(count_matches -E "^${want}\$" "$T/mut-$m.failed")
        if [ "$mode" = bite ]; then
          check "$m: $want fails" "$(yn [ "$h" -ge 1 ])"
        else
          echo "  MEASURED $m: $want fails: $([ "$h" -ge 1 ] && echo yes || echo no)"
        fi
        if [ "$h" -ge 1 ]; then hit=$((hit + 1)); fi
      done
      if [ "$mode" = measure ]; then
        if [ "$rc" -eq 0 ]; then
          echo "  FINDING $m: every test passes with the mutation planted; it does not bite"
          echo "$m" >>"$T/findings"
        else
          echo "  MEASURED $m: the mutated tree fails $(count_lines "$T/mut-$m.failed") test(s); it bites"
        fi
      fi
      echo "$m $crate mode=$mode exit=$rc named_tests_failed=$hit/$nwant failing_tests=$(count_lines "$T/mut-$m.failed")" >>"$T/mut-table"
    done
    
    # The control for this whole block, in the same command form: the UNMUTATED
    # worktree at the same commit must pass both crates' tests, so a failure
    # above is the mutation's.
    echo
    echo "### control: the same worktree with no mutation applied"
    ( cd "$MUTTREE/tree" && git checkout -q -- . ) || fail=1
    check "control: the worktree carries no change after the reset" \
      "$(yn [ "$(git -C "$MUTTREE/tree" status --porcelain | count_lines /dev/stdin)" = 0 ])"
    for crate in emend emend-copy; do
      echo "command: cargo test --no-fail-fast -p $crate (in the clean worktree)"
      ( cd "$MUTTREE/tree" && CARGO_TARGET_DIR="$MUTTREE/target" \
          cargo test --no-fail-fast -p "$crate" ) \
        >"$T/mut-clean-$crate.out" 2>&1 </dev/null
      rc=$?
      echo "exit: $rc"
      LC_ALL=C "$G" -E '^test result: ' "$T/mut-clean-$crate.out" | sed 's/^/    /'
      check "control: the unmutated worktree passes $crate, so each failure above is the mutation's" \
        "$(yn [ "$rc" -eq 0 ])"
    done
    # And the failing-name search's control: the clean runs name no failing test.
    LC_ALL=C "$G" -hE '^ +[a-z_:0-9]+$' "$T/mut-clean-emend.out" "$T/mut-clean-emend-copy.out" >"$T/clean.failed"
    check "control: the same failing-name search over the clean runs finds none" \
      "$(yn [ "$(count_lines "$T/clean.failed")" = 0 ])"
    echo
    echo "## the mutation table"
    sed 's/^/    /' "$T/mut-table"
    echo "  measured mutations that did not bite (findings): $(tr '\n' ' ' <"$T/findings")"
    echo "  FINDING M13, why no test can bite: formula_sample compares the text it"
    echo "  reads back with the text it wrote itself, so the comparison fails only if"
    echo "  the library writes or reads a formula text wrongly; it guards the library,"
    echo "  not the tool, and the library's own tests (M1's escape case among them)"
    echo "  cover that."
    echo
    echo "## M9's failures, measured (header change 4)"
    # From M9's run above: where the named test fails, and what the other failing
    # tests report. Read from the run's output and the test's source at the phase
    # commit.
    RECIPE_T=the_callers_drop_then_a_written_formula_records_the_recipe_once
    m9_panic=$(sed -nE "s/^thread 'package::tests::$RECIPE_T' .* panicked at crates\/emend\/src\/package\/tests[.]rs:([0-9]+):[0-9]+:$/\1/p" "$T/mut-M9.out")
    m9_written=$(git show "$C:crates/emend/src/package/tests.rs" | awk -v n="$RECIPE_T" '
      $0 ~ "^fn " n "[(]" { t = 1 } t && /let output = written[(]package[)];/ { print NR; exit }')
    echo "  the named test panics at line ${m9_panic:-none} of the tests; its write_to call (written) is at line ${m9_written:-none}"
    m9_before_write() { [ -n "$m9_panic" ] && [ -n "$m9_written" ] && [ "$m9_panic" -lt "$m9_written" ]; }
    check "M9: the named test fails at its direct-call assertion, before write_to" "$(yn m9_before_write)"
    LC_ALL=C "$G" -E '^ +[a-z_:0-9]+$' "$T/mut-M9.out" | sed 's/^ *//' | sort -u | LC_ALL=C "$G" -vx "package::tests::$RECIPE_T" >"$T/m9.others"
    echo "  the other tests M9 fails:"
    sed 's/^/    /' "$T/m9.others"
    # Each other failing test, and whether its failure is the write's refusal.
    : >"$T/m9.write"
    while IFS= read -r t; do
      n=$(awk -v t="$t" '$0 ~ "^---- " t " stdout ----$" { b = 1; next } b && /^---- / { b = 0 } b' "$T/mut-M9.out" |
        count_matches -F 'two changes for one entry' /dev/stdin)
      echo "    $t: lines reporting two changes for one entry $n"
      if [ "$n" -ge 1 ]; then echo "$t" >>"$T/m9.write"; fi
    done <"$T/m9.others"
    n_m9_write=$(count_lines "$T/m9.write")
    echo "  other tests M9 fails: $(count_lines "$T/m9.others"); of them failing inside the write with two changes for one entry: $n_m9_write"
    check "M9: the write itself refuses the second recording in at least one other test" "$(yn [ "$n_m9_write" -ge 1 ])"
    n_two_changes=$(count_matches -F 'two changes for one entry' "$T/mut-M9.out")
    echo "  lines of M9's run reporting two changes for one entry: $n_two_changes"
    echo "  FINDING M9: the named test fails at its direct-call assertion before write_to, and"
    echo "  under M9 the write itself refuses a second recording, so C1's assertions after"
    echo "  write_to are never reached: M9 does not show that those assertions bite."
    check "control: the panic-line form reads nothing from a clean run" \
      "$(yn [ -z "$(sed -nE "s/^thread 'package::tests::$RECIPE_T' .* panicked at .*:([0-9]+):[0-9]+:$/\1/p" "$T/mut-clean-emend.out")" ])"
    cleanup_worktree
    trap 'rm -rf "$T"' EXIT INT TERM HUP
    
    echo
    echo "## the two runs"
    echo "host executed $(cat "$T/host.count") tests; i686-unknown-linux-musl executed $(cat "$T/i686-unknown-linux-musl.count") tests"
    check "the i686 run executed the same test names as the host run" "$(yn cmp -s "$T/host.names" "$T/i686-unknown-linux-musl.names")"
    check "the two counts are equal" "$(yn [ "$(cat "$T/host.count")" = "$(cat "$T/i686-unknown-linux-musl.count")" ])"
    
    echo
    echo "## what C1's message claims, read at C1 and at its parent (header change 3)"
    PKG_TESTS=crates/emend/src/package/tests.rs
    TOOL_TESTS=tools/emend-copy/tests/null_rewrite.rs
    TOOL_SRC=tools/emend-copy/src/main.rs
    CELLS_SRC=crates/emend/src/cells.rs
    has_test() { tests_attr "$1" "$2" | LC_ALL=C "$G" -qx -e "$3"; }
    lacks_test() { if has_test "$1" "$2" "$3"; then return 1; else return 0; fi; }
    fn_body() { git show "$1:$2" | awk -v n="$3" '$0 ~ "^fn " n "[(]" { t = 1 } t { print } t && /^}$/ { exit }'; }
    changed_lines() {
      git show --format= -U0 "$1" -- "$2" | LC_ALL=C "$G" -E '^[-+]' | LC_ALL=C "$G" -vE '^(\+\+\+|---) '
    }
    # The functions holding each line a commit changes in one file: removed lines
    # at its parent, added lines at it.
    enclosing() {
      git show "$1:$2" | awk -v want="$3" '
        BEGIN { while ((getline l < want) > 0) w[l] = 1 }
        /^fn [a-z_0-9]+[(]/ { name = $0; sub(/^fn /, "", name); sub(/[(].*/, "", name) }
        (NR in w) { print name }'
    }
    changed_fns() {
      git show --format= -U0 "$1" -- "$2" | awk -v o="$T/cf.old" -v n="$T/cf.new" '
        /^@@ / { split($2, a, ","); split($3, b, ","); ol = substr(a[1], 2) + 0; nl = substr(b[1], 2) + 0; next }
        /^---|^\+\+\+/ { next }
        /^-/ { print ol >> o; ol++; next }
        /^\+/ { print nl >> n; nl++; next }'
      { enclosing "$1^" "$2" "$T/cf.old"; enclosing "$1" "$2" "$T/cf.new"; } | sort -u
      rm -f "$T/cf.old" "$T/cf.new"
    }
    echo "command: git show --name-only --format= <C1>"
    git show --name-only --format= "$CODE1" | sed 's/^/    /'
    printf '%s\n' "$CELLS_SRC" "$PKG_TESTS" >"$T/c1.want-files"
    git show --name-only --format= "$CODE1" | sort >"$T/c1.files"
    check "C1 changes cells.rs and the package module's tests alone" "$(yn cmp -s "$T/c1.files" "$T/c1.want-files")"
    changed_lines "$CODE1" "$CELLS_SRC" >"$T/c1.cells"
    sed 's/^/    /' "$T/c1.cells"
    n_cells=$(count_lines "$T/c1.cells")
    n_cells_comment=$(count_matches -E '^[-+] *//' "$T/c1.cells")
    echo "  lines C1 changes in cells.rs: $n_cells; of them comment lines: $n_cells_comment"
    cells_comments_only() { [ "$n_cells" -ge 1 ] && [ "$n_cells" = "$n_cells_comment" ]; }
    check "every line C1 changes in cells.rs is a comment (finding F2's comment)" "$(yn cells_comments_only)"
    RECIPE=the_callers_drop_then_a_written_formula_records_the_recipe_once
    changed_fns "$CODE1" "$PKG_TESTS" >"$T/c1.fns"
    echo "  the functions holding every line C1 changes in the package module's tests:"
    sed 's/^/    /' "$T/c1.fns"
    check "every line C1 changes in the tests lies in $RECIPE" "$(yn [ "$(cat "$T/c1.fns")" = "$RECIPE" ])"
    CTL_FN=a_formula_and_a_style_edit_on_one_cell_both_apply
    git show "$CODE1:$PKG_TESTS" | awk -v n="$CTL_FN" '$0 ~ "^fn " n "[(]" { print NR + 1; exit }' >"$T/c-line"
    check "control: enclosing maps a line inside $CTL_FN to it" \
      "$(yn [ "$(enclosing "$CODE1" "$PKG_TESTS" "$T/c-line")" = "$CTL_FN" ])"
    check "C1's #[test] names are its parent's" \
      "$(yn [ "$(tests_attr "$CODE1" "$PKG_TESTS")" = "$(tests_attr "$CODE1^" "$PKG_TESTS")" ])"
    
    echo "### the counts C1's message states in words, derived from the test at C1"
    # The message: "the input names the chain's override and relationship once
    # each and the output neither, and that the output holds one entry fewer than
    # the input". Each word is read from the message (lines joined), mapped to its
    # number, and compared with what the test at C1 asserts.
    word_num() {
      case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
        neither|none|zero) echo 0 ;; one|once) echo 1 ;; two|twice) echo 2 ;; three) echo 3 ;;
        four) echo 4 ;; five) echo 5 ;; *) echo error ;;
      esac
    }
    msg_body() { git log -1 --format=%b "$1" | LC_ALL=C "$G" -v '^Co-Authored-By:'; }
    msg_body "$CODE1" | tr '\n' ' ' | tr -s ' ' >"$T/c1.joined"
    w_each=$(sed -nE 's/.*override and relationship ([a-z]+) each.*/\1/p' "$T/c1.joined")
    w_out=$(sed -nE 's/.*and the output ([a-z]+),.*/\1/p' "$T/c1.joined")
    w_fewer=$(sed -nE 's/.*holds ([a-z]+) entry fewer.*/\1/p' "$T/c1.joined")
    echo "  the words: the override and relationship '$w_each' each; the output '$w_out'; '$w_fewer' entry fewer"
    fn_body "$CODE1" "$PKG_TESTS" "$RECIPE" >"$T/recipe.body"
    echo "command: the body of $RECIPE at C1; its lines naming what is counted:"
    LC_ALL=C "$G" -nE 'PartName=|Target=|assert_eq!\(count|^ +0,$|len\(\) - ' "$T/recipe.body" | sed 's/^/    /'
    # The things counted: the needles in the for-array, one per place.
    n_places=$(count_matches -E 'b"(PartName=\\"/xl/calcChain[.]xml|Target=\\"calcChain[.]xml)\\""' "$T/recipe.body")
    # The count asserted in the input and in the output, and the entries removed.
    in_count=$(sed -nE 's/^ *assert_eq!\(count\(input\(part\), needle\), ([0-9]+), .*/\1/p' "$T/recipe.body")
    out_count=$(awk '/count\(stored_data\(&output, part\), needle\),/ { getline; gsub(/[ ,]/, ""); print; exit }' "$T/recipe.body")
    fewer=$(sed -nE 's/.*entries[.]len\(\), parts[.]len\(\) - ([0-9]+),.*/\1/p' "$T/recipe.body")
    echo "  derived: places counted $n_places (the override and the relationship); each in the input $in_count; in the output $out_count; entries fewer $fewer"
    check "the test counts two places, the override and the relationship" "$(yn [ "$n_places" = 2 ])"
    check "'$w_each each' is the input count the test asserts ($in_count)" "$(yn [ "$(word_num "$w_each")" = "$in_count" ])"
    check "'the output $w_out' is the output count the test asserts ($out_count)" "$(yn [ "$(word_num "$w_out")" = "$out_count" ])"
    check "'$w_fewer entry fewer' is the entries the test asserts removed ($fewer)" "$(yn [ "$(word_num "$w_fewer")" = "$fewer" ])"
    # Controls, each through the same form as its check.
    printf '    assert_eq!(count(input(part), needle), 3, "x");\n' >"$T/c-in"
    check "control: the input-count form reads 3 from a fixture" \
      "$(yn [ "$(sed -nE 's/^ *assert_eq!\(count\(input\(part\), needle\), ([0-9]+), .*/\1/p' "$T/c-in")" = 3 ])"
    printf '    assert_eq!(entries.len(), parts.len() - 2, "two");\n' >"$T/c-fewer"
    check "control: the entries form reads 2 from a fixture" \
      "$(yn [ "$(sed -nE 's/.*entries[.]len\(\), parts[.]len\(\) - ([0-9]+),.*/\1/p' "$T/c-fewer")" = 2 ])"
    check "control: word_num maps neither to 0 and once to 1" "$(yn [ "$(word_num neither)$(word_num once)" = 01 ])"
    check "control: word_num refuses a word that is not a count" "$(yn [ "$(word_num blue)" = error ])"
    echo "### numerals in C1's message body"
    NUM_RE='(^|[^A-Za-z0-9_.])[0-9]+([^A-Za-z0-9_]|$)'
    msg_body "$CODE1" | LC_ALL=C "$G" -nE "$NUM_RE" | sed 's/^/    /'
    echo "  accounted for: a ruling's number, a finding's and a check's names, and quick-xml's version; none is a count"
    
    echo
    echo "## what C2's message claims, read at C2 and at its parent (header change 3)"
    echo "command: git show --name-only --format= <C2>"
    git show --name-only --format= "$CODE2" | sed 's/^/    /'
    printf '%s\n' "$TOOL_SRC" "$TOOL_TESTS" | sort >"$T/c2.want-files"
    git show --name-only --format= "$CODE2" | sort >"$T/c2.files"
    check "C2 changes the tool's source and its integration tests alone" "$(yn cmp -s "$T/c2.files" "$T/c2.want-files")"
    for t in the_part6_formula_sample_writes_a_and_f_and_drops_the_chain \
             the_part6_formula_sample_with_a_and_no_f_adds_the_row_alone \
             the_part6_formula_sample_with_neither_is_byte_identical; do
      new_at_c2() { has_test "$CODE2" "$TOOL_TESTS" "$t" && lacks_test "$CODE2^" "$TOOL_TESTS" "$t"; }
      check "the test $t, which C2's message names, is at C2 and not at its parent" "$(yn new_at_c2)"
    done
    # "a sheet with neither, and one with a normal formula and no number": the
    # neither test's two labels.
    fn_body "$CODE2" "$TOOL_TESTS" the_part6_formula_sample_with_neither_is_byte_identical >"$T/neither.body"
    n_labels=$(count_matches -E '"part6-sample-(neither|f-alone)",' "$T/neither.body")
    check "the neither test runs a sheet with neither and one with a normal formula alone ($n_labels labels)" "$(yn [ "$n_labels" = 2 ])"
    n_usage=$(changed_lines "$CODE2" "$TOOL_TESTS" | count_matches -E '^[+].*"[-][-]formula-sample"' /dev/stdin)
    echo "  lines C2 adds to the tool's tests naming the flag: $n_usage"
    check "C2 adds the usage cases for the flag" "$(yn [ "$n_usage" -ge 1 ])"
    readback_new() {
      [ "$(git show "$CODE2:$TOOL_SRC" | count_matches -E '^    ReadBack [{]' /dev/stdin)" = 1 ] &&
        [ "$(git show "$CODE2^:$TOOL_SRC" | count_matches -E '^    ReadBack [{]' /dev/stdin)" = 0 ]
    }
    check "C2 adds the error ReadBack" "$(yn readback_new)"
    check "control: has_test refuses a name that is not at C2" "$(yn lacks_test "$CODE2" "$TOOL_TESTS" no_such_test_anywhere)"
    echo "### C2's message states no count"
    # The numerals in C2's body are the values the spec's "Harness runs" names
    # for the sample (21, the *2 suffix, 1+1, 2+3): each is looked for in the
    # spec at C2, lines joined, and removed before the count of any other number.
    msg_body "$CODE2" >"$T/c2.body"
    LC_ALL=C "$G" -nE "$NUM_RE" "$T/c2.body" | sed 's/^/    /'
    spec_flat() { git show "$1:specs/0013-formulas.md" | tr '\n' ' ' | tr -s ' ' | tr -d '`'; }
    spec_flat "$CODE2" >"$T/spec.flat"
    for v in 'Number(21)' '*2' '1+1' '2+3'; do
      n=$(count_matches -F "$v" "$T/spec.flat")
      check "the value $v in C2's message is one the spec names ($n)" "$(yn [ "$n" -ge 1 ])"
    done
    # The other numerals are not counts either: the spec's file name, the two
    # columns the spec places the new cells in, (M + 1, 1) and (M + 1, 2), and
    # the tool's exit status, which the spec gives as exit 2. Each is looked for
    # in the spec too (this log's attempt 1 counted them as counts).
    for v in '(M + 1, 1)' '(M + 1, 2)' 'exit 2'; do
      n=$(count_matches -F "$v" "$T/spec.flat")
      check "the position or status $v, which C2's message uses, is the spec's ($n)" "$(yn [ "$n" -ge 1 ])"
    done
    check "the file name specs/0013-formulas.md in C2's message is the spec's own, present at C2" \
      "$(yn git cat-file -e "$CODE2:specs/0013-formulas.md")"
    sed -e 's/Number(21)//g' -e 's/[*]2//g' -e 's/1+1//g' -e 's/2+3//g' \
      -e 's#specs/0013-formulas[.]md##g' -e 's/column [12]//g' -e 's/exits 2//g' "$T/c2.body" >"$T/c2.rest"
    n_nums=$(count_matches -E "$NUM_RE" "$T/c2.rest")
    echo "  body lines with a number standing alone once the spec's values are removed: $n_nums"
    check "C2's message states no count in numerals" "$(yn [ "$n_nums" = 0 ])"
    printf 'A takes Number(21) in 3 cells\n' | sed -e 's/Number(21)//g' >"$T/c-rest"
    check "control: removing the spec's values leaves a real count to be found" "$(yn [ "$(count_matches -E "$NUM_RE" "$T/c-rest")" = 1 ])"
    COUNT_WORDS='one|two|three|four|five|once|twice|both|single|neither'
    echo "command: grep -niwE <count words> over C2's message body"
    LC_ALL=C "$G" -niwE "$COUNT_WORDS" "$T/c2.body" | sed 's/^/    /'
    fn_body "$CODE2" "$TOOL_SRC" formula_sample >"$T/fs.body"
    n_reads=$(count_matches -F 'package.cells(&part)' "$T/fs.body")
    n_lines=$(count_matches -F 'print_line(&format!(' "$T/fs.body")
    echo "  in formula_sample at C2: reads of the sheet $n_reads; lines printed $n_lines"
    check "'read once': formula_sample reads the sheet through Package::cells once" "$(yn [ "$n_reads" = 1 ])"
    check "'one line': formula_sample prints one line" "$(yn [ "$n_lines" = 1 ])"
    echo "  accounted for: 'neither' and 'one with a normal formula' are the two fixtures checked above"
    
    echo
    echo "## what C3's message claims, read at C3 and at its parent (header change 3)"
    echo "command: git show --name-only --format= <C3>"
    git show --name-only --format= "$CODE3" | sed 's/^/    /'
    check "C3 changes the tool's integration tests alone" \
      "$(yn [ "$(git show --name-only --format= "$CODE3")" = "$TOOL_TESTS" ])"
    check "C3's #[test] names are its parent's" \
      "$(yn [ "$(tests_attr "$CODE3" "$TOOL_TESTS")" = "$(tests_attr "$CODE3^" "$TOOL_TESTS")" ])"
    AONLY=the_part6_formula_sample_with_a_and_no_f_adds_the_row_alone
    changed_fns "$CODE3" "$TOOL_TESTS" >"$T/c3.fns"
    echo "  the functions holding every line C3 changes:"
    sed 's/^/    /' "$T/c3.fns"
    check "every line C3 changes lies in $AONLY, the test its message names" "$(yn [ "$(cat "$T/c3.fns")" = "$AONLY" ])"
    changed_lines "$CODE3" "$TOOL_TESTS" >"$T/c3.changed"
    sed 's/^/    /' "$T/c3.changed"
    # "now holds a shared-string cell ahead of the number, so A is the number
    # after it and the composed text names that number's reference": in the
    # test at C3, a cell with t="s" comes before the first plain number in the
    # fixture's row, and the expected sheet holds that number's reference
    # followed by *2 in row 3.
    fn_body "$CODE3" "$TOOL_TESTS" "$AONLY" >"$T/aonly.body"
    fixture=$(awk '/part6_sample_specs[(]/ { t = 1; next } t { print } t && /,$/ && !/\\$/ { exit }' "$T/aonly.body" | tr -d ' \n\\')
    echo "  the fixture's row at C3, joined: $fixture"
    ss_pos=$(printf '%s' "$fixture" | awk '{ print index($0, "t=\"s\"") }')
    first_num_ref=$(printf '%s' "$fixture" | sed -nE 's/.*<c ?r=\\?"([A-Z]+[0-9]+)\\?"><v>[0-9]+<\/v><\/c><\/row>.*/\1/p')
    num_pos=$(printf '%s' "$fixture" | awk -v r="$first_num_ref" '{ print index($0, "r=\"" r "\"><v>") }')
    echo "  position of the shared-string cell: $ss_pos; the plain number's reference: ${first_num_ref:-none}, at position $num_pos"
    ss_first() { [ "$ss_pos" -gt 0 ] && [ -n "$first_num_ref" ] && [ "$num_pos" -gt "$ss_pos" ]; }
    check "the fixture holds a shared-string cell ahead of the number" "$(yn ss_first)"
    n_composed=$(count_matches -F "<f>${first_num_ref}*2</f>" "$T/aonly.body")
    check "the expected sheet's composed text names that number's reference, ${first_num_ref}*2 ($n_composed)" "$(yn [ "$n_composed" -ge 1 ])"
    n_old=$(fn_body "$CODE3^" "$TOOL_TESTS" "$AONLY" | count_matches -F 't=\"s\"' /dev/stdin)
    echo "  shared-string cells in the test at C3's parent: $n_old"
    check "the test held no shared-string cell before C3" "$(yn [ "$n_old" = 0 ])"
    check "control: the composed-text count finds nothing for a reference the test does not use" \
      "$(yn [ "$(count_matches -F '<f>Z99*2</f>' "$T/aonly.body")" = 0 ])"
    echo "### C3's message states no count"
    msg_body "$CODE3" >"$T/c3.body"
    n_nums=$(count_matches -E "$NUM_RE" "$T/c3.body")
    n_words=$(count_matches_i -E "(^|[^A-Za-z])($COUNT_WORDS)([^A-Za-z]|$)" "$T/c3.body")
    echo "  body lines with a number standing alone: $n_nums; with a count word: $n_words"
    LC_ALL=C "$G" -nE "$NUM_RE" "$T/c3.body" | sed 's/^/    /'
    LC_ALL=C "$G" -niwE "$COUNT_WORDS" "$T/c3.body" | sed 's/^/    /'
    c3_no_counts() { [ "$n_nums" = 0 ] && [ "$n_words" = 0 ]; }
    check "C3's message states no count, in numerals or in words" "$(yn c3_no_counts)"
    printf 'it adds two cells\n' >"$T/c-words"
    check "control: the count-word form finds a count word" \
      "$(yn [ "$(count_matches_i -E "(^|[^A-Za-z])($COUNT_WORDS)([^A-Za-z]|$)" "$T/c-words")" = 1 ])"
    
    echo
    echo "## status after the runs"
    # This phase's logs and records, and planning's uncommitted file should one
    # stand, nothing else (header change 1).
    st_all=$(run_lines git status --porcelain)
    st_untracked_log=$(run_matches -E '^[?][?] records/logs/m1p6-p2' git status --porcelain)
    st_tracked_log=$(run_matches -E '^ ?[MARCD] records/logs/m1p6-p2' git status --porcelain)
    st_record=$(run_matches -E '^(\?\?| ?[MARCD]) records/m1p6-p2-' git status --porcelain)
    st_planning=$(run_matches -E '^ M (specs/0013-formulas[.]md|ROADMAP[.]md)$' git status --porcelain)
    echo "status lines: $st_all; untracked under the log directory: $st_untracked_log; tracked and modified under it: $st_tracked_log; the phase's record pair: $st_record; planning's files modified and uncommitted: $st_planning"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_untracked_log" != error ] &&
        [ "$st_tracked_log" != error ] && [ "$st_record" != error ] &&
        [ "$st_planning" != error ] &&
        [ "$st_all" = "$((st_untracked_log + st_tracked_log + st_record + st_planning))" ]
    }
    check "every change in the working tree is one of this phase's logs, its records or planning's uncommitted file" "$(yn status_accounted)"
    check "the mutation worktree is gone from git's list" \
      "$(yn [ "$(git worktree list --porcelain | count_matches -F "$MUTTREE" /dev/stdin)" = 0 ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    # Close the scrub's input and wait for it, so the log's last line is written
    # before the script exits.
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
  control count_matches with a regular expression: 2 (expect 2)
  control count_matches on an unreadable file: error (expect error)
  control count_matches on readable plus unreadable: error (expect error)
  control count_from_file on the same file: 2 (expect 2)
  control count_from_file on a file with none: 0 (expect 0)
  control count_from_file on an unreadable file: error (expect error)
  control count_bytes, control bytes in a file with ESC, ESC and SI: 3 (expect 3)
  control count_bytes, non-ASCII bytes in a file with one two-byte character: 2 (expect 2)
  control count_bytes on a clean file: 0 (expect 0)
  control count_bytes on an unreadable file: error (expect error)
  control count_lines on a three-line file: 3 (expect 3)
  control count_lines on an unreadable file: error (expect error)
  control count_matches_i on mixed case: 2 (expect 2)
  control count_matches on the same file, case sensitive: 1 (expect 1)
  control count_matches_i on an unreadable file: error (expect error)
  control run_lines on a command printing three lines: 3 (expect 3)
  control run_lines on a command printing nothing: 0 (expect 0)
  control run_lines on a FAILING command: error (expect error)
  control run_lines on a command that cannot run: error (expect error)
  control run_matches on a command printing one match: 1 (expect 1)
  control run_matches on a FAILING command: error (expect error)
  counting controls: all as expected

