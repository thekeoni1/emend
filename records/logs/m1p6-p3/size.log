tools/size-probe/Cargo.toml (sha256 3cc6e8cb305fe50567fae75b6e1f90c32128eb1ab86babf704bbfaea30e0372c):
    [package]
    name = "size-probe"
    version = "0.1.0"
    edition.workspace = true
    license.workspace = true
    publish = false
    
    [dependencies]
    zip = { version = "=8.6.0", default-features = false, features = ["deflate-flate2-zlib-rs"] }
    quick-xml = { version = "=0.42.0", default-features = false, optional = true }
    # emend's core, for the three emend probes (specs/0008-zip-layer.md, "Size").
    # Optional, so probe-zip and probe-zip-xml are built exactly as the baseline
    # built them, with nothing of emend compiled in.
    emend = { path = "../../crates/emend", optional = true }
    
    [features]
    # Enables quick-xml, for probe-zip-xml, probe-zip-xml-write,
    # probe-emend-edit-xml, probe-emend-package-xml, probe-emend-cells-xml,
    # probe-emend-cells-write-xml, probe-emend-styles-write-xml,
    # probe-emend-formulas-write-xml and probe-emend-dates-write-xml; probe-zip
    # is built without it.
    xml = ["dep:quick-xml"]
    # Enables emend, for probe-emend-copy, probe-emend-edit,
    # probe-emend-edit-xml, probe-emend-package-xml, probe-emend-cells-xml,
    # probe-emend-cells-write-xml, probe-emend-styles-write-xml,
    # probe-emend-formulas-write-xml and probe-emend-dates-write-xml.
    emend = ["dep:emend"]
    # Enables emend's own `dates` feature, for probe-emend-dates-write-xml alone
    # (specs/0012-styles.md, "Planning rulings during P3", ruling 7). Each probe
    # is built with its own feature set, so no other probe links it.
    dates = ["emend", "xml", "emend/dates"]
    
    [[bin]]
    name = "probe-zip"
    path = "src/bin/probe-zip.rs"
    
    [[bin]]
    name = "probe-zip-xml"
    path = "src/bin/probe-zip-xml.rs"
    required-features = ["xml"]
    
    [[bin]]
    name = "probe-zip-xml-write"
    path = "src/bin/probe-zip-xml-write.rs"
    required-features = ["xml"]
    
    [[bin]]
    name = "probe-emend-copy"
    path = "src/bin/probe-emend-copy.rs"
    required-features = ["emend"]
    
    [[bin]]
    name = "probe-emend-edit"
    path = "src/bin/probe-emend-edit.rs"
    required-features = ["emend"]
    
    [[bin]]
    name = "probe-emend-edit-xml"
    path = "src/bin/probe-emend-edit-xml.rs"
    required-features = ["emend", "xml"]
    
    [[bin]]
    name = "probe-emend-package-xml"
    path = "src/bin/probe-emend-package-xml.rs"
    required-features = ["emend", "xml"]
    
    [[bin]]
    name = "probe-emend-cells-xml"
    path = "src/bin/probe-emend-cells-xml.rs"
    required-features = ["emend", "xml"]
    
    [[bin]]
    name = "probe-emend-cells-write-xml"
    path = "src/bin/probe-emend-cells-write-xml.rs"
    required-features = ["emend", "xml"]
    
    [[bin]]
    name = "probe-emend-styles-write-xml"
    path = "src/bin/probe-emend-styles-write-xml.rs"
    required-features = ["emend", "xml"]
    
    [[bin]]
    name = "probe-emend-formulas-write-xml"
    path = "src/bin/probe-emend-formulas-write-xml.rs"
    required-features = ["emend", "xml"]
    
