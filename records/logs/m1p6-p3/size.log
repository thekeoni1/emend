    #!/usr/bin/env bash
    # Milestone 1 part 6 P3 size.log (specs/0013-formulas.md, "Size" and "### P3",
    # with "Planning verification and rulings on P2 (2026-09-23)"): the TWELVE
    # size probes built in the size profile for i686-unknown-linux-musl, each with
    # its own feature set, as part 5 built its eleven
    # (records/logs/m1p5-p3/size.log); part 5's eleven compared with
    # records/size-m1p5-2026-09-22-f565868.md by the byte classifier with every
    # difference classified; the figures the spec asks for; the core built with
    # the dates feature off and on, on both targets; the twelve probes run on
    # generated fictional packages; the release binaries the corpus run and the
    # negative log use; and the record.
    #
    # What "Size" asks this log to print, all of it measured here:
    #  - for all twelve probes, the file size, the section total and .text from
    #    `size -A`;
    #  - part 5's eleven probes against part 5's record, every difference
    #    classified from the bytes: identical, the build id, panic-location line
    #    numbers, or code, the last with the commits that could have caused it;
    #  - the budget figure, probe-emend-formulas-write-xml over probe-zip-xml,
    #    against the ceiling of 393216 section bytes (specs/0010 "Size"), with the
    #    file delta beside it;
    #  - part 6's own cost, the same probe over probe-emend-styles-write-xml, and
    #    beside it the budget figure's whole growth since part 5's 304412, with
    #    the drift of the earlier probes classified (specs/0011 P3 verification
    #    ruling 4);
    #  - the dates feature's cost, probe-emend-dates-write-xml over
    #    probe-emend-styles-write-xml, recorded beside the budget and outside it;
    #  - beside them, planning's expectation (specs/0013 "Size": "not a
    #    measurement"): under 6000 section bytes for the part. It is PRINTED,
    #    compared and not a check, for part 6's own cost and for the whole
    #    growth: an expectation that did not hold would be a finding to report,
    #    not a failed measurement.
    #
    # WRITTEN FOR M1 part 6 P3 from part 5 P3's size script
    # (records/logs/m1p5-p3/size.log). What differs from that one, and why:
    #  1. The phase, the log directory, the record names and planning's file
    #     (specs/0013-formulas.md) are part 6 P3's; the previous record and log
    #     are part 5's, and part 5's budget figure is read from its record and
    #     checked against the 304412 and 88804 specs/0013 states.
    #  2. Twelve probes: part 5's eleven and probe-emend-formulas-write-xml
    #     (features emend,xml). All eleven earlier probes, the styles and dates
    #     probes among them, are rebuilt at part 5's commit and compared.
    #  3. The budget and the own cost are judged on the formulas probe; the dates
    #     feature's cost stays over the styles probe, which the dates probe
    #     extends. The drift that makes up the rest of the growth is the styles
    #     probe's less probe-zip-xml's, and its owner is read from the subjects of
    #     the commits that touched crates/emend/src (those naming M1 part 6).
    #  4. A probe's causes now include tools/size-probe/Cargo.toml, which C2
    #     edits (a manifest can change what a probe is built with), and, for a
    #     probe that links emend, crates/emend/Cargo.toml.
    #  5. The formulas probe runs on part 5's fixture and on the same with a
    #     calcPr of calcId alone, so the calcPr insertion and the attribute
    #     rewrite are both shown; its second output is read by a reader that is
    #     not emend's: the calcPr start tag, the workbook part otherwise the
    #     input's, the styles part and the sheet cell by cell with the formula
    #     cell's text.
    #  6. Lines 1 to 3 are the command, the invocation and "about:"; then the
    #     three shape greps over this script with their controls; then the
    #     phase's commits by role, read from git. No commit id is typed.
    #  7. The target directory is named once, as <scratch>/p3/target
    #     (CARGO_TARGET_DIR), in this header and in the body (P1 verification
    #     ruling 6). The second root has one header line saying which spelled
    #     path stands for it and that the roots are distinct (P2 verification
    #     ruling 5): <scratch>/w, this run's mktemp -d directory, holding the
    #     fixtures, the outputs and the scratch clone at part 5's commit with its
    #     own target. The SERIALIZED line carries the cargo and rustc process
    #     counts at entry (P2 verification ruling 6).
    #  8. Every printed line passes through one scrub, the repository first since
    #     it lies inside the home directory.
    #  9. The release binaries' and the probe's sha256 are printed twice: in the
    #     sentences part 5 printed, and as "hash: <name> <target> <sha256>" lines,
    #     one per binary, for the run and negative logs to read back by command.
    #
    # THE RELEASE BINARIES. specs/0013 "P3" has the corpus run use "the release
    # binaries the size log hashed", and the negative log run the release probe.
    # This log builds emend-copy and xlsx-diff in the release profile for both
    # targets and hashes them; the probe is the i686 size-profile build measured
    # below, the profile that inherits release.
    #
    # File sizes on this target move in 4096-byte steps (the DIFFERENCES between
    # probes are whole pages, the sizes are not); the section figures resolve to
    # the byte. Both are printed, and the record says why.
    #
    # PLANNING'S FILES. None stood modified and uncommitted when this script was
    # written. The entry guard and the status check count any that does, by name,
    # and print its sha256 at entry and at the end.
    #
    # Usage: m1p6-p3-size.sh <phase commit> <record output file> > <scratch file>,
    # run from the repository root; the caller moves the output to
    # records/logs/m1p6-p3/size.log and the record to
    # records/size-m1p6-<utc-date>-<shortsha>.md.
    #
    # Every check with more than one condition is a named function, defined on the
    # line before it and called through yn (specs/0001-bootstrap.md, "Rules for
    # every phase"). None of the three shapes that file forbids appears here; the
    # shapes are described rather than written out.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    RECORD_OUT=${2:?record output file required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    export CARGO_TARGET_DIR=$SELF_DIR/target
    I686=i686-unknown-linux-musl
    PREV_REC=records/size-m1p5-2026-09-22-f565868.md
    PREV_LOG=records/logs/m1p5-p3/size.log
    # The checkpoint ruling recorded in specs/0010, "Size", which specs/0013
    # "Size" keeps. What part 5 spent is read from its record below, not typed.
    CEILING=393216
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT INT TERM HUP
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # The whole of stdout is scrubbed below; hide is kept as a pass-through for
    # the blocks that call it.
    hide() { cat; }
    # static_i686_stripped <binary>: file(1) reports a stripped static 32-bit i386 ELF.
    static_i686_stripped() {
      local d
      d=$(file -b "$1")
      [[ "$d" == *"ELF 32-bit LSB executable, Intel i386"* ]] && [[ "$d" == *"statically linked"* ]] && [[ "$d" == *", stripped"* ]]
    }
    # section <binary> <name>: a section's size from `size -A`, or "error".
    section() {
      local out
      out=$(size -A "$1" 2>/dev/null) || { printf 'error'; return; }
      printf '%s\n' "$out" | awk -v s="$2" '$1 == s { print $2; found = 1 } END { if (!found) print "error" }'
    }
    
    # specs/0001 "Rules for every phase": the phase commit is GIVEN to the script
    # and compared with HEAD, both printed, with a control that refuses a
    # fabricated commit. The hard guard is here, before a line of log exists.
    HEAD_SHA=$(git rev-parse HEAD)
    NULL_SHA=0000000000000000000000000000000000000000
    full_sha() {
      printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'
    }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    not_head() { if is_head "$1"; then return 1; else return 0; fi; }
    if is_head "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    # The entry guard: every change must be under this phase's log directory, or be
    # its run record pair or size record, or one of planning's files modified and
    # uncommitted, should one stand (header).
    PLANNING_RE='^ M (specs/0013-formulas[.]md|ROADMAP[.]md)$'
    PLANNING_FILES=$(git status --porcelain | LC_ALL=C "$G" -E "$PLANNING_RE" | cut -c4-)
    entry_all=$(run_lines git status --porcelain)
    entry_log=$(run_matches -E '^(\?\?| ?[MARCD]) (records/logs/m1p6-p3|records/m1p6-p3-|records/size-m1p6-)' git status --porcelain)
    entry_planning=$(run_matches -E "$PLANNING_RE" git status --porcelain)
    entry_clean() {
      [ "$entry_all" != error ] && [ "$entry_log" != error ] && [ "$entry_planning" != error ] &&
        [ "$entry_all" = "$((entry_log + entry_planning))" ]
    }
    if entry_clean; then :; else echo "the working tree holds changes outside this phase's records" >&2; exit 2; fi
    
    # Every printed line passes through this scrub (header change 8).
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p3#g" \
        -e "s#$T#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    # The invocation as run, the script's directory written as <repo> or <scratch>:
    # an absolute machine path in a log is a defect (T0 P6d ruling).
    inv_path=$0
    case "$inv_path" in
      "$MAIN"/*) inv_path="<repo>/${inv_path#"$MAIN"/}" ;;
      /*) inv_path="<scratch>/p3/$(basename "$inv_path")" ;;
    esac
    echo "invocation: bash $inv_path $*"
    echo "about: M1 part 6 P3 phase commit $C; HEAD at run: $HEAD_SHA"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001; P1 check 1's F4)"
    # specs/0001: the scan greps every printed script for three forbidden shapes,
    # and they run here, first, over this script's own file, each with a positive
    # control through the same command form. The patterns and the fixture are
    # assembled from pieces at run time, so this script's text holds none of them.
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    SHAPE_DIR=$(mktemp -d -p "$T")
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$SHAPE_DIR/fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
