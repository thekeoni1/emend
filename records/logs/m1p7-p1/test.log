    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  the part 6 close-out record commit: ${REC:-none}"
    echo "  the first doc commit: ${DOC1:-none}"
    echo "  the second doc commit: ${DOC2:-none}"
    echo "  the first code commit: ${CODE1:-none}"
