    echo "root: <scratch>/w stands for this run's mktemp -d working directory, a directory distinct from <scratch>/p1"
    echo "root: <scratch>/mut stands for this run's mktemp -d mutation directory (its worktree and its own target), a directory distinct from <scratch>/p1 and from <scratch>/w"
