    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight (the coordinator's arrangement); cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory, <scratch>/p1/target (CARGO_TARGET_DIR)"
    # P2 verification ruling 5: one line per second root, saying which spelled
