## script
    #!/usr/bin/env bash
    # Milestone 1 part 7 P2 negative.log (specs/0014-xml-comparison.md, "### P2";
    # the negative log specs/0001 asks each phase for). Two families:
    #
    # (A) the built xlsx-diff binary, both targets, on generated fixtures: P1's
    #     cases N0 to N10 again with the same derivations, and two new ones from
    #     P1 verification ruling 6: N11, an entry starting with a UTF-16 byte
    #     order mark on the output side (a parse row ok and error; the offset is
    #     quick-xml's and is printed, not derived: the Limits say the tool reads
    #     UTF-8 only, and name no offset), and N12, an attribute holding a CR LF
    #     against one holding an LF (equal values, XML 1.0 section 3.3.3).
    # (B) the record script's own test, as "### P2" asks ("with its own test on
    #     a fixture diff file (the script's existing test pattern)"), the
    #     pattern specs/0006's: scripts/passthrough-record.py over a scratch run
    #     directory this script builds, for host and i686. The summary, entries
    #     and run tables take their headers from the record script's own
    #     constants, read by importing a copy of the script at the phase commit;
    #     each workbook's <id>/diff.<label>.tsv is the real binary's stdout on a
    #     generated pair: W1 with xml rows including a parse error, W2
    #     identical, W3 an outcome other than ok, which has no diff file and
    #     must not be read. The .txt's third table and the .md's "XML comparison
    #     of changed entries" tables are compared with what this script derives
    #     from the diff files by its own reading; then seven refusals, each on a
    #     copy of the run directory changed in one place, each message read
    #     from the record script's source and formatted by this script, with a
    #     control. A fictional sentinel in the fixtures' values must reach none
    #     of the record script's stdout, stderr, .txt or .md.
    #
    # The log opens as specs/0001 asks: line 1 the command, line 2 the
    # invocation, line 3 the about line naming the phase commit and HEAD. The
    # first block after them runs the three shape greps specs/0001 forbids over
    # this script's own file, each with a positive control through the same
    # command form. The next prints the phase's commits by role, read from git
    # by subject; no commit id is typed here.
    #
    # Roots (P1 verification ruling 3: every root a log uses has its own line):
    # <scratch>/w, this run's working directory, made fresh by mkdir and removed
    # at exit; <scratch>/p2, the directory this script, its gate log and its
    # output live in; <scratch>/p2/target, the build directory the P2 gate built
    # the two debug xlsx-diff binaries in. The binaries are copied into
    # <scratch>/w and each sha256 is compared with the one gate.log printed,
    # read by command. Nothing is rebuilt. Every fixture is GENERATED by
    # python3's zipfile from fictional XML; no corpus file is copied or read.
    # Running in a made scratch directory needs no worktree or clone (P1
    # verification ruling 2), so no departure line is printed.
    #
    # WRITTEN FOR M1 part 7 P2 from part 7 P1's negative script (the log
    # committed as records/logs/m1p7-p1/negative.log). What differs from it:
    #  1. The phase, the gate log, the build directory and the subject prefix
    #     ("M1 part 7 P2: ") are P2's; the gate log's about-line control is P1's
    #     committed gate log.
    #  2. The departure line is gone (ruling 2); the roots are four lines
    #     (ruling 3; <repo> added on the rerun after check 1 F3).
    #  3. N11 and N12 join family A. An expectation's offset "*" means "digits,
    #     printed, not derived" (N11 alone). The counts that grow with the case
    #     list (expectations, parse rows, stream files, cases) are derived from
    #     the generator's expectations file, not typed.
    #  4. Family B is new: B1 the record, B2 the refusals R1 to R8.
    #
    # RERUN AFTER INDEPENDENT CHECK 1 (at the same phase commit): F3, <repo>
    # had no root line though the log reads it; it has one now. F6, the record
    # script ran from the main tree; family B now runs the copy it already made
    # by git show at the phase commit (still compared with the tree's file).
    # F5, the 04ba408 script's acceptance of a repeated archive row was printed
    # only by a superseded log; case B3m now runs the script at the phase
    # commit's parent code commit, read by role from git, on R8's mutated copy
    # and prints what it does. The closing check compares the main tree's
    # status before and after this log instead of requiring it clean (this
    # phase's uncommitted logs are in it). Nothing else changed.
    #
    # RERUN AT A NEW PHASE COMMIT: the phase gained a third code commit,
    # ea37ad7's subject "refuse a repeated xml archive row in the record
    # script", after this log's 04ba408 run measured (its case B3, measured and
    # not asserted) that the record script accepted a diff file holding an xml
    # archive row twice. That 04ba408 run and its script are kept and hashed on
    # the rerun lines; they were committed nowhere, superseded because the phase
    # commit moved. Change: B3 is gone and becomes refusal R8, asserted like the
    # other seven; the other refusals and every other case are unchanged.
    #
    # RERUN (attempt 2 at 04ba408): attempt 1 (its log and script hashed on the rerun
    # lines) printed every assertion as-expected, but its measured-only case B3
    # measured nothing: its grep read wb1/diff.host.tsv and appended to the same
    # file, which grep refuses ("input file is also the output", on the run's
    # stderr), so no duplicate row was added and the exit 0 it printed says
    # nothing about a duplicate. B3 now reads the row into a file of its own and
    # prints the count of the row in the copy before the run. Nothing else
    # changed.
    #
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    GATE_ARG=${2:?gate log required}
    BIN_ARG=${3:?build directory required}
    SROOT=$(cd "$(dirname "$0")/.." && pwd)
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    B="$SROOT/w"
    mkdir "$B" || { echo "refused: $B exists" >&2; exit 2; }
    BSHOWN="<scratch>/w"
    trap 'rm -rf "$B"' EXIT INT TERM HUP
    fail=0
    note() { echo "  $1: $2"; [ "$2" = as-expected ] || fail=1; }
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    # Negation goes through a helper, never by passing the shell's negation
    # keyword as the first argument of `is` (specs/0001).
    isnot() { if "$@"; then echo UNEXPECTED; else echo as-expected; fi; }
    hide() { sed "s#$B#$BSHOWN#g; s#$SROOT#<scratch>#g; s#$MAIN#<repo>#g"; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { LC_ALL=C printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if ! full_sha "$C"; then echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if ! head_is "$C"; then echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    
    echo "command: git rev-parse HEAD"
    inv_path=$0
    case "$inv_path" in
      "$MAIN"/*) inv_path="<repo>/${inv_path#"$MAIN"/}" ;;
      "$SROOT"/*) inv_path="<scratch>/${inv_path#"$SROOT"/}" ;;
      /*) inv_path="<scratch>/$(basename "$inv_path")" ;;
    esac
    inv_args=""
    for a in "$@"; do
      case "$a" in
        "$MAIN"/*) a="<repo>/${a#"$MAIN"/}" ;;
        "$SROOT"/*) a="<scratch>/${a#"$SROOT"/}" ;;
        /*) a="<scratch>/$(basename "$a")" ;;
      esac
      [ -n "$a" ] || a="''"
      inv_args="$inv_args $a"
    done
    echo "invocation: bash $inv_path$inv_args"
    echo "about: M1 part 7 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    
    echo
    echo "## the three shape greps over this script's own file"
    echo "command: sha256sum $inv_path"
    echo "  $(sha256sum <"$0" | cut -d' ' -f1)  $(wc -c <"$0") bytes"
    SHAPE_CHAIN='[$][(](yn|is|isnot) .*(&&|[|][|])'
    SHAPE_BANG='[$][(](yn|is|isnot) [!]'
    SHAPE_ASSIGN='[$][(](yn|is|isnot) [A-Za-z_][A-Za-z_0-9]*='
    printf 'x %s(is [ a = a ] && [ b = b ])\n' '$' >"$B/shape-chain"
    printf 'x %s(is %s f a b)\n' '$' '!' >"$B/shape-bang"
    printf 'x %s(isnot %s%s /usr/bin/grep -q x f)\n' '$' 'LC_ALL' '=C' >"$B/shape-assign"
    shape_hits_self=0
    for pair in chain:SHAPE_CHAIN bang:SHAPE_BANG assign:SHAPE_ASSIGN; do
      kind=${pair%%:*}
      pat_name=${pair#*:}
      pat=${!pat_name}
      n_self=$(count_matches -E "$pat" "$0")
      n_ctl=$(count_matches -E "$pat" "$B/shape-$kind")
      echo "command: count_matches -E <the $kind pattern> over $inv_path, and over a control fixture holding the $kind shape"
      echo "  the $kind pattern: $pat"
      echo "  hits on this script: $n_self; hits on the control: $n_ctl"
      note "the $kind shape: no hit on this script" "$(is [ "$n_self" = 0 ])"
      note "control: the $kind pattern finds its shape in the fixture, through the same form" "$(is [ "$n_ctl" = 1 ])"
      if [ "$n_self" != 0 ]; then shape_hits_self=1; fi
    done
    if [ "$shape_hits_self" != 0 ]; then echo "a forbidden shape is in this script; stopping before any case" >&2; exit 2; fi
    
    echo
    echo "## the phase's commits, by role, read from git"
    echo "command: git log --reverse --format='%H %s' --grep='^M1 part 7 P2: ' (planning doc commits printed and set apart)"
    git log --reverse --format='%H %s' --grep='^M1 part 7 P2: ' >"$B/phase-commits"
    LC_ALL=C "$G" -F 'commit planning docs' "$B/phase-commits" | sed 's/^/    planning doc commit: /'
    LC_ALL=C "$G" -v -F 'commit planning docs' "$B/phase-commits" >"$B/code-commits"
    awk '{ printf "    code commit %d: %s\n", NR, $0 }' "$B/code-commits"
    ncode=$(count_lines "$B/code-commits")
    last_code=$(tail -n 1 "$B/code-commits" | cut -d' ' -f1)
    echo "  code commits: $ncode; the last: $last_code"
    some_code() { [ "$ncode" != error ] && [ "$ncode" -ge 1 ]; }
    note "the phase has at least one code commit" "$(is some_code)"
    last_is_phase() { [ -n "$last_code" ] && [ "$last_code" = "$C" ]; }
    note "the last code commit, read from git, is the phase commit given to this script" "$(is last_is_phase)"
    first_doc=$(LC_ALL=C "$G" -F 'commit planning docs' "$B/phase-commits" | head -n 1 | cut -d' ' -f1)
    doc_is_phase() { [ -n "$first_doc" ] && [ "$first_doc" = "$C" ]; }
    note "control: the first planning doc commit is not the phase commit" "$(isnot doc_is_phase)"
    
    echo
    echo "phase: Milestone 1 part 7 P2 (specs/0014-xml-comparison.md) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt the rerun line names (the hashes it points at, printed here directly under it)"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight (the coordinator's arrangement); cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc"
    note "no cargo or rustc process was running at entry" "$(is [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "root: $BSHOWN stands for this run's working directory (the fixtures, the outputs and the binaries' copies), created fresh by mkdir (refused if present) and removed at exit"
    echo "root: <scratch>/p2 stands for the directory this script, the P2 gate log it reads and its own output live in"
    echo "root: <scratch>/p2/target stands for the build directory the P2 gate built the two xlsx-diff binaries in"
    echo "root: <repo> stands for the main working tree: read by git, the shared counting library sourced from it, P1's gate log read; nothing in it is run or written by this log"
    git -C "$MAIN" status --porcelain >"$B/status-before"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    note "the working directory and the build directory are distinct, neither inside the other" "$(is apart "$B" "$BIN_ARG")"
    apart_ctl() { if apart "$SROOT/p2" "$SROOT"; then return 1; else return 0; fi; }
    note "the working directory and <scratch>/p2 are distinct, neither inside the other" "$(is apart "$B" "$SROOT/p2")"
    note "control: apart refuses a directory inside another" "$(is apart_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    echo "every fixture is generated; no corpus file is copied or read"
    note "the phase commit given to this script is a full sha" "$(is full_sha "$C")"
    note "the phase commit given to this script is HEAD" "$(is head_is "$C")"
    note "control: the same comparison against the null commit says no" "$(isnot head_is "$NULL_SHA")"
    note "control: the same comparison against a short sha of the real commit says no" \
      "$(isnot head_is "$(printf '%s' "$C" | cut -c1-7)")"
    isnot_says_unexpected() { [ "$(isnot true)" = UNEXPECTED ]; }
    note "control: isnot reports UNEXPECTED on a passing command" "$(is isnot_says_unexpected)"
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the gate's binaries"
    BIN_SHOWN="<scratch>/${BIN_ARG#"$SROOT"/}"
    GATE_SHOWN="<scratch>/${GATE_ARG#"$SROOT"/}"
    mkdir -p "$B/bin"
    declare -A XD
    bins_ok=yes
    for t in host i686; do
      case $t in
        host) rel=debug/xlsx-diff ;;
        i686) rel=i686-unknown-linux-musl/debug/xlsx-diff ;;
      esac
      if cp "$BIN_ARG/$rel" "$B/bin/xlsx-diff-$t" 2>/dev/null; then
        echo "  copied $BIN_SHOWN/$rel: sha256 $(sha256sum <"$B/bin/xlsx-diff-$t" | cut -d' ' -f1), bytes $(wc -c <"$B/bin/xlsx-diff-$t")"
      else
        echo "  copied $BIN_SHOWN/$rel: FAILED"
        bins_ok=no
      fi
      XD[$t]=$B/bin/xlsx-diff-$t
    done
    both_executable() {
      [ "$bins_ok" = yes ] || return 1
      [ -x "${XD[host]}" ] || return 1
      [ -x "${XD[i686]}" ] || return 1
      return 0
    }
    note "both binaries were copied in and both are executable" "$(is both_executable)"
    echo "command: read the two xlsx-diff hashes from $GATE_SHOWN (sha256 $(sha256sum <"$GATE_ARG" | cut -d' ' -f1), $(wc -c <"$GATE_ARG") bytes)"
    gate_is_phase() { [ "$(count_matches -E "^about: M1 part 7 P2 .*$C" "$GATE_ARG")" = 1 ]; }
    note "the gate log read is part 7 P2's and names this phase commit on its about line" "$(is gate_is_phase)"
    gate_is_other() { [ "$(count_matches -E "^about: M1 part 7 P2 .*$C" "$MAIN/records/logs/m1p7-p1/gate.log")" = 1 ]; }
    note "control: the same check on part 7 P1's committed gate log says no" "$(isnot gate_is_other)"
    gate_hash() { sed -n "s#^  <scratch>/p2/target/$1: sha256 \([0-9a-f]\{64\}\), bytes [0-9]*\$#\1#p" "$GATE_ARG"; }
    nsame_gate=0
    for t in host i686; do
      case $t in
        host) rel=debug/xlsx-diff ;;
        i686) rel=i686-unknown-linux-musl/debug/xlsx-diff ;;
      esac
      want=$(gate_hash "$rel")
      got=$(sha256sum <"${XD[$t]}" | cut -d' ' -f1)
      echo "  $BIN_SHOWN/$rel: gate.log $want; copied $got"
      if [ -n "$want" ] && [ "$want" = "$got" ]; then nsame_gate=$((nsame_gate + 1)); fi
    done
    note "both copied binaries are the ones gate.log hashed" "$(is [ "$nsame_gate" = 2 ])"
    note "control: the same reader finds no hash for a binary gate.log does not name" \
      "$(is [ -z "$(gate_hash debug/no-such-binary)" ])"
    echo "  (nothing is rebuilt here)"
    
    echo
    echo "## what the spec and the source say, read at the phase commit"
    echo "command: git show $C:specs/0014-xml-comparison.md | grep the parse row of the Output table, the archive keys and the P1 negative-log sentence"
    git show "$C:specs/0014-xml-comparison.md" >"$B/spec.md"
    parse_line=$(LC_ALL=C "$G" -F '| `parse` |' "$B/spec.md")
    echo "    $parse_line"
    neg_line=$(LC_ALL=C "$G" -n -F 'malformed entry, an unknown prefix and a non-zip' "$B/spec.md")
    echo "    $neg_line"
    keys_line=$(LC_ALL=C "$G" -F '`xml_compared` (the' "$B/spec.md")
    echo "    $keys_line"
    spec_found() { [ -n "$parse_line" ] && [ -n "$neg_line" ] && [ -n "$keys_line" ]; }
    note "the three spec lines are found, non-empty" "$(is spec_found)"
    # The parse row's width: xml, the name and the kind word, then the columns the
    # table lists after the kind, separated by semicolons.
    parse_cols=$(printf '%s\n' "$parse_line" | awk -F'|' '{ print $3 }' | awk -F';' '{ print NF }')
    PARSE_WIDTH=$((3 + parse_cols))
    echo "  columns after the kind word, read from the table: $parse_cols; so a parse row is $PARSE_WIDTH columns wide"
    note "the table gives five columns after the kind word (two statuses, the offset, two raw counts)" "$(is [ "$parse_cols" = 5 ])"
    echo "command: git show $C:tools/xlsx-diff/src/lib.rs | grep the not-a-zip message"
    git show "$C:tools/xlsx-diff/src/lib.rs" >"$B/lib.rs"
    nz_src=$(LC_ALL=C "$G" -o -E '"the \{side\} file is not a readable zip archive"' "$B/lib.rs" | head -n 1)
    echo "    $nz_src"
    NOTZIP_MSG="error: $(printf '%s' "$nz_src" | sed 's/^"//; s/"$//; s/{side}/output/')"
    echo "  expected stderr for N3: $NOTZIP_MSG"
    note "the message is read from the source, non-empty" "$(is [ -n "$nz_src" ])"
    
    echo
    echo "## the generated fixtures"
    cat >"$B/gen.py" <<'GEN_PY'
    import os, sys, zipfile
    
    base = sys.argv[1]
    NS = "urn:example:fictional"
    NAME = "xl/worksheets/sheet1.xml"
    
    
    def archive(path, data):
        with zipfile.ZipFile(path, "w") as z:
            z.writestr("[Content_Types].xml", b"<Types/>", zipfile.ZIP_STORED)
            z.writestr(NAME, data, zipfile.ZIP_DEFLATED)
    
    
    # The sentinel, from pieces, so the whole string is in no source.
    sentinel = "".join(["zq", "-sent", "inel-", "m1p7", "-neg"])
    
    good = ('<a xmlns="%s"><b c="1">x</b></a>' % NS).encode()
    other = ('<a xmlns="%s"><b c="2">x</b></a>' % NS).encode()
    
    
    def lt_of_unclosed(doc):
        """A syntax error at the end of input inside markup is at the `<` that
        opens that markup: the last `<` of the document."""
        return doc.rfind(b"<")
    
    
    def end_of(doc, tag):
        """An unknown prefix is at the end of the tag that holds it."""
        return doc.index(tag) + len(tag)
    
    
    def lt_of(doc, markup):
        """A mismatched end tag is at its `<`."""
        return doc.index(markup)
    
    
    def leak(s):
        return ('<a xmlns="%s" v="%s"><t>%s</t><u><![CDATA[%s]]></u></a>'
                % (NS, s, s, s)).encode()
    
    
    cases = []
    # (case, input, output, in status, out status, offset or "", kind)
    cases.append(("N0", good, other, "ok", "ok", "", "parsed"))
    malformed = b"<a><b"
    cases.append(("N1", good, malformed, "ok", "error", str(lt_of_unclosed(malformed)), "error"))
    prefixed = b"<a><p:b/></a>"
    cases.append(("N2", prefixed, good, "error", "ok", str(end_of(prefixed, b"<p:b/>")), "error"))
    mismatched = b"<a>x</b>"
    cases.append(("N4", good, mismatched, "ok", "error", str(lt_of(mismatched, b"</b")), "error"))
    attr = b'<a><b p:c="1"/></a>'
    cases.append(("N5", good, attr, "ok", "error", str(end_of(attr, b'<b p:c="1"/>')), "error"))
    open_in = b"<a><b>x"
    # Both sides fail: the input's offset (ruling 2). The input's element is
    # open at the end of input, so its offset is the input's length.
    cases.append(("N6", open_in, malformed, "error", "error", str(len(open_in)), "error"))
    leak_bad = leak(sentinel)[:-2]  # ends inside the end tag markup
    cases.append(("N7a", leak(sentinel), leak_bad, "ok", "error", str(lt_of_unclosed(leak_bad)), "error"))
    cases.append(("N7b", leak(sentinel), leak(sentinel + "-2"), "ok", "ok", "", "parsed"))
    # N10: a CR, a comment, then an LF are two line ends, as two LFs are.
    cases.append(("N10", b"<a>x\n\ny</a>", b"<a>x\r<!--c-->\ny</a>", "ok", "ok", "", "equal"))
    # N11: the output entry starts with a UTF-16 byte order mark; the tool reads
    # UTF-8 only (the Limits), so that side is an error. The offset is
    # quick-xml's: "*" asks for digits, printed, not derived.
    bom16 = b"\xff\xfe" + "<a>x</a>".encode("utf-16-le")
    cases.append(("N11", good, bom16, "ok", "error", "*", "error"))
    # N12: an attribute value holding a CR LF against one holding an LF: equal
    # after attribute-value normalisation (XML 1.0 section 3.3.3).
    cases.append(("N12", b'<a b="x\r\ny"/>', b'<a b="x\ny"/>', "ok", "ok", "", "equal"))
    
    with open(os.path.join(base, "expected.tsv"), "w") as handle:
        for case, a, b, si, so, off, kind in cases:
            d = os.path.join(base, case)
            os.makedirs(d)
            archive(os.path.join(d, "in.zip"), a)
            archive(os.path.join(d, "out.zip"), b)
            # "-" stands for an empty offset: read splits on tabs and would
            # merge an empty field with its neighbour.
            handle.write("\t".join([case, si, so, off or "-", kind]) + "\n")
    
    # N3: the output is not a zip archive.
    d = os.path.join(base, "N3")
    os.makedirs(d)
    archive(os.path.join(d, "in.zip"), good)
    with open(os.path.join(d, "out.zip"), "wb") as handle:
        handle.write(b"fictional bytes, not a zip archive\n")
    
    # The sentinel and its hex, one per line, for grep -f, never printed; and a
    # planted copy for the control.
    with open(os.path.join(base, "sentinel.pat"), "w") as handle:
        handle.write(sentinel + "\n" + sentinel.encode().hex() + "\n")
    with open(os.path.join(base, "planted.txt"), "w") as handle:
        handle.write("xml\tplanted\t" + sentinel + "\n")
    GEN_PY
    sed 's/^/    /' "$B/gen.py"
    echo "command: python3 <scratch>/w/gen.py <scratch>/w/cases  (python3 $(python3 -c 'import sys; print(sys.version.split()[0])'))"
    mkdir "$B/cases"
    python3 "$B/gen.py" "$B/cases" 2>&1 | hide | sed 's/^/    /'
    echo "  expected, as the generator derived them from the fixtures (case, input, output, offset, kind):"
    sed 's/^/    /' "$B/cases/expected.tsv"
    # The case counts below are derived from the generator, not typed: one
    # expectation per cases.append in it, and N3 on top.
    n_append=$(count_matches -F 'cases.append((' "$B/gen.py")
    n_exp=$(count_lines "$B/cases/expected.tsv")
    echo "  cases the generator appends: $n_append; expectations it wrote: $n_exp"
    note "the generator wrote one expectation per case it appends" "$(is [ "$n_exp" = "$n_append" ])"
    n_dirs=$((n_exp + 1))
    
    # Runs one case through one binary; keeps stdout, stderr and the status.
    run_case() {
      local case=$1 t=$2 d=$B/cases/$1
      "${XD[$t]}" "$d/in.zip" "$d/out.zip" >"$d/stdout.$t" 2>"$d/stderr.$t"
      echo $? >"$d/status.$t"
    }
    show_case() {
      local d=$B/cases/$1 t=$2
      echo "  [$1 $t] exit status: $(cat "$d/status.$t")"
      echo "  [$1 $t] stdout:"
      sed 's/^/      /' "$d/stdout.$t"
      echo "  [$1 $t] stderr:"
      sed 's/^/      /' "$d/stderr.$t" | hide
    }
    # Assertions over one parsed-or-failed case's rows.
    xml_count() { awk -F'\t' -v k="$2" '$1 == "xml" && $3 == k' "$1" | wc -l; }
    xml_other() { awk -F'\t' '$1 == "xml" && $3 != "parse"' "$1" | wc -l; }
    arch() { awk -F'\t' -v k="$2" '$1 == "archive" && $2 == k { print $3 }' "$1"; }
    parse_is() {
      local f=$1 want=$2 got
      got=$(awk -F'\t' '$1 == "xml" && $3 == "parse" { print $4 "\t" $5 "\t" $6 }' "$f")
      case "$want" in
        *"$TAB*")
          # "*": the offset is quick-xml's, digits, printed by the caller.
          [ "${got%"$TAB"*}" = "${want%"$TAB"*}" ] || return 1
          printf '%s\n' "${got##*"$TAB"}" | LC_ALL=C "$G" -qE '^[0-9]+$'
          ;;
        *) [ "$got" = "$want" ] ;;
      esac
    }
    parse_offset() { awk -F'\t' '$1 == "xml" && $3 == "parse" { print $6 }' "$1"; }
    entry_changed() { [ "$(awk -F'\t' -v n="$2" '$1 == "entry" && $2 == n { print $3 }' "$1")" = changed ]; }
    error_archive() {
      local f=$1
      [ "$(arch "$f" xml_compared)" = 1 ] && [ "$(arch "$f" xml_parse_errors)" = 1 ] \
        && [ "$(arch "$f" xml_names_equal)" = 0 ] && [ "$(arch "$f" xml_values_equal)" = 0 ]
    }
    parsed_archive() {
      local f=$1
      [ "$(arch "$f" xml_compared)" = 1 ] && [ "$(arch "$f" xml_parse_errors)" = 0 ] \
        && [ "$(arch "$f" xml_names_equal)" = 1 ] && [ "$(arch "$f" xml_values_equal)" = 0 ]
    }
    equal_archive() {
      local f=$1
      [ "$(arch "$f" xml_compared)" = 1 ] && [ "$(arch "$f" xml_parse_errors)" = 0 ] \
        && [ "$(arch "$f" xml_names_equal)" = 1 ] && [ "$(arch "$f" xml_values_equal)" = 1 ]
    }
    values_equal_row() {
      [ "$(awk -F'\t' '$1 == "xml" && $3 == "values" { print $6 "\t" $7 }' "$1")" = "0$TAB""0" ]
    }
    stderr_empty() { [ ! -s "$1" ]; }
    TAB=$(printf '\t')
    
    echo
    echo "## N0 to N12 but N3: the cases, through both binaries"
    while IFS="$TAB" read -r case si so off kind; do
      [ "$off" = - ] && off=""
      for t in host i686; do
        run_case "$case" "$t"
        show_case "$case" "$t"
        d=$B/cases/$case
        note "[$case $t] exit status 1" "$(is [ "$(cat "$d/status.$t")" = 1 ])"
        note "[$case $t] stderr empty" "$(is stderr_empty "$d/stderr.$t")"
        note "[$case $t] the entry row says changed" "$(is entry_changed "$d/stdout.$t" xl/worksheets/sheet1.xml)"
        note "[$case $t] one parse row, reading $si $so and offset '$off' as derived" \
          "$(is parse_is "$d/stdout.$t" "$si$TAB$so$TAB$off")"
        note "[$case $t] exactly one parse row" "$(is [ "$(xml_count "$d/stdout.$t" parse)" = 1 ])"
        if [ "$off" = "*" ]; then
          echo "  [$case $t] the offset quick-xml gives, printed and not derived: $(parse_offset "$d/stdout.$t")"
        fi
        if [ "$kind" = error ]; then
          note "[$case $t] no element, attribute or values row after a parse error" "$(is [ "$(xml_other "$d/stdout.$t")" = 0 ])"
          note "[$case $t] archive: xml_compared 1, xml_parse_errors 1, xml_names_equal 0, xml_values_equal 0" "$(is error_archive "$d/stdout.$t")"
        elif [ "$kind" = equal ]; then
          note "[$case $t] one values row" "$(is [ "$(xml_count "$d/stdout.$t" values)" = 1 ])"
          note "[$case $t] the values row has in_only 0 and out_only 0" "$(is values_equal_row "$d/stdout.$t")"
          note "[$case $t] archive: xml_compared 1, xml_parse_errors 0, xml_names_equal 1, xml_values_equal 1" "$(is equal_archive "$d/stdout.$t")"
        else
          note "[$case $t] one values row" "$(is [ "$(xml_count "$d/stdout.$t" values)" = 1 ])"
          note "[$case $t] archive: xml_compared 1, xml_parse_errors 0, xml_names_equal 1, xml_values_equal 0" "$(is parsed_archive "$d/stdout.$t")"
        fi
      done
    done <"$B/cases/expected.tsv"
    # A control on the assertion form: N0's parse row does not read as N1's.
    note "control: parse_is says no to N1's expectation on N0's rows" \
      "$(isnot parse_is "$B/cases/N0/stdout.host" "ok${TAB}error${TAB}3")"
    note "control: error_archive says no on N0's rows" "$(isnot error_archive "$B/cases/N0/stdout.host")"
    note "control: parse_is with a starred offset says no to N0's rows, whose output side parsed" \
      "$(isnot parse_is "$B/cases/N0/stdout.host" "ok${TAB}error${TAB}*")"
    note "control: values_equal_row says no on N0's rows, whose values differ" "$(isnot values_equal_row "$B/cases/N0/stdout.host")"
    note "control: equal_archive says no on N0's rows" "$(isnot equal_archive "$B/cases/N0/stdout.host")"
    
    echo
    echo "## N3: the output file is not a zip archive"
    for t in host i686; do
      run_case N3 "$t"
      show_case N3 "$t"
      d=$B/cases/N3
      note "[N3 $t] exit status 2" "$(is [ "$(cat "$d/status.$t")" = 2 ])"
      note "[N3 $t] stdout empty" "$(is stderr_empty "$d/stdout.$t")"
      note "[N3 $t] stderr is exactly the message read from the source" "$(is [ "$(cat "$d/stderr.$t")" = "$NOTZIP_MSG" ])"
    done
    
    echo
    echo "## N7: no value reaches stdout or stderr"
    echo "command: count_from_file -F <the sentinel and its hex, one per line, never printed> over every case's stdout and stderr, both targets"
    outs=$(ls "$B"/cases/*/stdout.* "$B"/cases/*/stderr.*)
    nfiles=$(printf '%s\n' "$outs" | wc -l)
    # shellcheck disable=SC2086
    nleak=$(count_from_file -F "$B/cases/sentinel.pat" $outs)
    nplant=$(count_from_file -F "$B/cases/sentinel.pat" "$B/cases/planted.txt")
    echo "  files scanned: $nfiles; lines holding a sentinel form: $nleak; control, the planted copy: $nplant"
    note "no sentinel form in any stdout or stderr" "$(is [ "$nleak" = 0 ])"
    note "control: the same form finds the planted copy" "$(is [ "$nplant" = 1 ])"
    note "every case wrote its two streams on both targets ($n_dirs cases, two streams, two targets)" "$(is [ "$nfiles" = "$((n_dirs * 4))" ])"
    
    echo
    echo "## N8: every parse row's width and column order"
    echo "command: awk over every case's stdout, both targets: kind word parse, statuses ok or error, offset digits or empty, two raw counts in digits, width $PARSE_WIDTH"
    bad_rows=$(cat "$B"/cases/*/stdout.* | awk -F'\t' -v w="$PARSE_WIDTH" '
      $1 == "xml" && $3 == "parse" {
        n++
        if (NF != w || ($4 != "ok" && $4 != "error") || ($5 != "ok" && $5 != "error") \
            || $6 !~ /^[0-9]*$/ || $7 !~ /^[0-9]+$/ || $8 !~ /^[0-9]+$/) bad++
      }
      END { print n + 0, bad + 0 }')
    echo "  parse rows, and rows out of shape: $bad_rows"
    note "$((n_exp * 2)) parse rows ($n_exp cases, two targets), none out of shape" "$(is [ "$bad_rows" = "$((n_exp * 2)) 0" ])"
    printf 'xml\ta.xml\tparse\tok\tfine\t\t0\t0\n' >"$B/bad-row"
    bad_ctl=$(awk -F'\t' -v w="$PARSE_WIDTH" '
      $1 == "xml" && $3 == "parse" {
        n++
        if (NF != w || ($4 != "ok" && $4 != "error") || ($5 != "ok" && $5 != "error") \
            || $6 !~ /^[0-9]*$/ || $7 !~ /^[0-9]+$/ || $8 !~ /^[0-9]+$/) bad++
      }
      END { print n + 0, bad + 0 }' "$B/bad-row")
    note "control: the same awk reports a row whose output status is neither ok nor error" "$(is [ "$bad_ctl" = "1 1" ])"
    
    echo
    echo "## N9: host and i686 print the same bytes"
    nsame=0 ncases=0
    for d in "$B"/cases/N*; do
      ncases=$((ncases + 1))
      if cmp -s "$d/stdout.host" "$d/stdout.i686" && cmp -s "$d/stderr.host" "$d/stderr.i686" \
         && cmp -s "$d/status.host" "$d/status.i686"; then
        nsame=$((nsame + 1))
      else
        echo "  $(basename "$d"): differs between the targets"
      fi
    done
    echo "  cases: $ncases; identical on both targets (stdout, stderr, status): $nsame"
    note "every case identical on both targets" "$(is [ "$nsame" = "$ncases" ])"
    note "$n_dirs cases compared" "$(is [ "$ncases" = "$n_dirs" ])"
    cmp_ctl() { cmp -s "$B/cases/N0/stdout.host" "$B/cases/N1/stdout.host"; }
    note "control: cmp says no on two cases' different stdout" "$(isnot cmp_ctl)"
    
    echo
    echo "## family B: the record script's own test on a scratch run directory"
    echo "command: git show $C:scripts/passthrough-record.py, compared with the working tree's file; the copy is imported (bytecode off) for its constants and is the script every case runs"
    git show "$C:scripts/passthrough-record.py" >"$B/record-copy.py"
    rec_blob=$(sha256sum <"$B/record-copy.py" | cut -d' ' -f1)
    rec_tree=$(sha256sum <"$MAIN/scripts/passthrough-record.py" | cut -d' ' -f1)
    echo "  the script at the phase commit: sha256 $rec_blob; the working tree's: $rec_tree"
    note "the record script run is the one at the phase commit" "$(is [ "$rec_blob" = "$rec_tree" ])"
    REC="$B/record-copy.py"
    R_NAME="$(date -u +%Y-%m-%d)-$(git rev-parse --short=7 "$C")"
    R="$B/runs/$R_NAME"
    mkdir -p "$R" "$B/rec"
    echo "root note: the run directory is <scratch>/w/runs/$R_NAME, named <utc-date>-<shortsha> as the record script's default stem wants; the record goes to <scratch>/w/rec"
    cat >"$B/gen_b.py" <<'GEN_B'
    import os, sys, zipfile
    
    base = sys.argv[1]
    NS = "urn:example:fictional"
    # The sentinel, from pieces, so the whole string is in no source.
    sentinel = "".join(["zq", "-sent", "inel-", "m1p7", "-rec"])
    
    
    def archive(path, entries):
        with zipfile.ZipFile(path, "w") as z:
            for name, data in entries:
                z.writestr(name, data, zipfile.ZIP_DEFLATED)
    
    
    ct_in = '<Types xmlns="%s"><Default Extension="%s" ContentType="a"/></Types>' % (NS, sentinel)
    ct_out = '<Types xmlns="%s"><Default Extension="%s-2" ContentType="a"/></Types>' % (NS, sentinel)
    sheet1_in = '<ws xmlns="%s"><c r="A1">%s</c></ws>' % (NS, sentinel)
    sheet1_out = '<ws xmlns="%s"><c r="A1">%s-2</c><c r="B1"/></ws>' % (NS, sentinel)
    sheet2_in = '<ws><c r="A1" s="1"/></ws>'
    sheet2_out = '<ws><c s="1" r="A1"/></ws>'
    wb_in = '<workbook><sheets/></workbook>'
    wb_out = '<workbook><sheets'
    app = '<Properties>fictional</Properties>'
    
    common = [("docProps/app.xml", app)]
    w1_in = [("[Content_Types].xml", ct_in), ("xl/workbook.xml", wb_in),
             ("xl/worksheets/sheet1.xml", sheet1_in), ("xl/worksheets/sheet2.xml", sheet2_in),
             ("xl/media/image1.bin", "fictional-bytes-1")] + common
    w1_out = [("[Content_Types].xml", ct_out), ("xl/workbook.xml", wb_out),
              ("xl/worksheets/sheet1.xml", sheet1_out), ("xl/worksheets/sheet2.xml", sheet2_out),
              ("xl/media/image1.bin", "fictional-bytes-2")] + common
    w2 = [("[Content_Types].xml", ct_in), ("xl/workbook.xml", wb_in)] + common
    for wid, a, b in (("wb1", w1_in, w1_out), ("wb2", w2, w2)):
        d = os.path.join(base, "pairs", wid)
        os.makedirs(d)
        archive(os.path.join(d, "in.zip"), a)
        archive(os.path.join(d, "out.zip"), b)
    # wb2's two sides must be the same bytes: write the output as a copy.
    with open(os.path.join(base, "pairs", "wb2", "in.zip"), "rb") as h:
        same = h.read()
    with open(os.path.join(base, "pairs", "wb2", "out.zip"), "wb") as h:
        h.write(same)
    with open(os.path.join(base, "sentinel-b.pat"), "w") as h:
        h.write(sentinel + "\n" + sentinel.encode().hex() + "\n")
    with open(os.path.join(base, "planted-b.txt"), "w") as h:
        h.write("| worksheet | " + sentinel + " |\n")
    GEN_B
    sed 's/^/    /' "$B/gen_b.py"
    python3 "$B/gen_b.py" "$B" 2>&1 | hide | sed 's/^/    /'
    echo "command: each binary on each pair, stdout to <run>/<id>/diff.<label>.tsv, as scripts/passthrough-run.sh writes it"
    for wid in wb1 wb2; do
      mkdir -p "$R/$wid"
      for t in host i686; do
        "${XD[$t]}" "$B/pairs/$wid/in.zip" "$B/pairs/$wid/out.zip" >"$R/$wid/diff.$t.tsv" 2>"$B/pairs/$wid/stderr.$t"
        echo $? >"$B/pairs/$wid/status.$t"
        echo "  [$wid $t] exit $(cat "$B/pairs/$wid/status.$t"); stderr bytes $(wc -c <"$B/pairs/$wid/stderr.$t"); diff file:"
        sed 's/^/      /' "$R/$wid/diff.$t.tsv"
      done
    done
    pair_status() { [ "$(cat "$B/pairs/$1/status.host")" = "$2" ] && [ "$(cat "$B/pairs/$1/status.i686")" = "$2" ]; }
    note "wb1 exits 1 on both targets" "$(is pair_status wb1 1)"
    note "wb2 exits 0 on both targets" "$(is pair_status wb2 0)"
    note "wb1's host and i686 diff files are the same bytes" "$(is cmp -s "$R/wb1/diff.host.tsv" "$R/wb1/diff.i686.tsv")"
    
    cat >"$B/build_run.py" <<'BUILD_RUN'
    import importlib.util, os, sys
    
    sys.dont_write_bytecode = True
    copy, run_dir = sys.argv[1:3]
    spec = importlib.util.spec_from_file_location("record", copy)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    SUMMARY, ENTRIES, RUN = record.SUMMARY_HEADER, record.ENTRIES_HEADER, record.RUN_HEADER
    print("headers read from the script's constants: summary %d columns, entries %d, run %d"
          % (len(SUMMARY), len(ENTRIES), len(RUN)))
    
    
    def archive_values(path):
        out = {}
        for line in open(path).read().split("\n"):
            cells = line.split("\t")
            if cells[0] == "archive" and len(cells) == 3:
                out[cells[1]] = cells[2]
        return out
    
    
    def entry_rows(path):
        # As scripts/passthrough-run.sh appends them: id, label, then the whole
        # entry row, its kind word "entry" standing in the "row" column.
        return [line.split("\t") for line in open(path).read().split("\n")
                if line.startswith("entry\t")]
    
    
    for label in ("host", "i686"):
        summary, entries = [], []
        for wid, status in (("wb1", "1"), ("wb2", "0")):
            diff = os.path.join(run_dir, wid, "diff.%s.tsv" % label)
            a = archive_values(diff)
            row = dict.fromkeys(SUMMARY, "")
            row.update(id=wid, label=label, producer="generated", tags="generated", outcome="ok",
                       exit="0", signal="", wall_s="0.01", peak_rss_kb="1000", in_bytes="1",
                       out_bytes="1", diff_exit=status, leftover="no", lo="-", lo_in="-")
            for k in ("identical", "recompressed", "changed", "dropped", "added", "flagged",
                      "order_preserved", "comment_equal", "files_identical"):
                row[k] = a[k]
            summary.append(row)
            for cells in entry_rows(diff):
                entries.append([wid, label] + cells)
        # wb3: an outcome other than ok; it has no directory, so reading its
        # diff file would fail.
        row = dict.fromkeys(SUMMARY, "")
        row.update(id="wb3", label=label, producer="generated", tags="generated", outcome="error",
                   exit="2", leftover="no", lo="-", lo_in="-")
        summary.append(row)
        with open(os.path.join(run_dir, "summary.%s.tsv" % label), "w") as h:
            h.write("\t".join(SUMMARY) + "\n")
            for r in summary:
                h.write("\t".join(r[k] for k in SUMMARY) + "\n")
        with open(os.path.join(run_dir, "entries.%s.tsv" % label), "w") as h:
            h.write("\t".join(ENTRIES) + "\n")
            for cells in entries:
                assert len(cells) == len(ENTRIES), (len(cells), len(ENTRIES))
                h.write("\t".join(cells) + "\n")
        run = dict.fromkeys(RUN, "")
        run.update(commit="0000000", started="2026-09-23T00:00:00Z", ended="2026-09-23T00:00:01Z",
                   rustc="fictional", zip="fictional", timeout_s="1", lo_timeout_s="1",
                   memory_mib="1", passthrough_sha256="0", xlsx_diff_sha256="0", files="3",
                   tool_args="")
        with open(os.path.join(run_dir, "run.%s.tsv" % label), "w") as h:
            h.write("\t".join(RUN) + "\n" + "\t".join(run[k] for k in RUN) + "\n")
    BUILD_RUN
    sed 's/^/    /' "$B/build_run.py"
    echo "command: python3 <scratch>/w/build_run.py <scratch>/w/record-copy.py <the run directory>"
    python3 "$B/build_run.py" "$B/record-copy.py" "$R" 2>&1 | hide | sed 's/^/    /'
    note "no bytecode was written beside the copy or in the repository" "$(is [ "$(find "$B" "$MAIN/scripts" -name '__pycache__' | wc -l)" = 0 ])"
    for f in summary entries run; do
      for t in host i686; do
        echo "  $f.$t.tsv:"
        sed 's/^/      /' "$R/$f.$t.tsv"
      done
    done
    
    echo
    echo "### B1: the record script over the run directory"
    echo "command: python3 <scratch>/w/record-copy.py --run <scratch>/w/runs/$R_NAME --out <scratch>/w/rec"
    python3 "$REC" --run "$R" --out "$B/rec" >"$B/rec.stdout" 2>"$B/rec.stderr"
    echo $? >"$B/rec.status"
    echo "  exit status: $(cat "$B/rec.status")"
    echo "  stdout:"; sed 's/^/      /' "$B/rec.stdout"
    echo "  stderr:"; hide <"$B/rec.stderr" | sed 's/^/      /'
    note "exit status 0" "$(is [ "$(cat "$B/rec.status")" = 0 ])"
    note "stderr empty" "$(is stderr_empty "$B/rec.stderr")"
    STEM="step0-$R_NAME"
    note "the .txt and the .md were written under the default stem" "$(is [ -f "$B/rec/$STEM.txt" ] )"
    note "the .md was written" "$(is [ -f "$B/rec/$STEM.md" ])"
    echo "  $STEM.txt:"; sed 's/^/      /' "$B/rec/$STEM.txt"
    echo "  $STEM.md:"; sed 's/^/      /' "$B/rec/$STEM.md"
    no_path() { ! LC_ALL=C "$G" -q -F -e "$B" -e "$MAIN" -e "$SROOT" "$1"; }
    note "the record script's stdout names no absolute path" "$(is no_path "$B/rec.stdout")"
    printf 'wrote into %s\n' "$B/rec" >"$B/path-planted"
    note "control: the same check sees a planted path" "$(isnot no_path "$B/path-planted")"
    
    cat >"$B/check_b.py" <<'CHECK_B'
    import os, sys
    
    run_dir, txt, md, out = sys.argv[1:5]
    labels = ("host", "i686")
    # This script's own family mapping for the fixture's names, from the rules of
    # specs/0000-step-zero-plan.md for these three parts; any other name stops it.
    FAM = {"[Content_Types].xml": "content-types", "xl/workbook.xml": "workbook"}
    ORDER = ("content-types", "workbook", "worksheet")
    
    
    def fam(name):
        if name in FAM:
            return FAM[name]
        if name.startswith("xl/worksheets/"):
            return "worksheet"
        raise SystemExit("an xml row name outside the fixture's three families")
    
    
    def summary_rows(label):
        lines = open(os.path.join(run_dir, "summary.%s.tsv" % label)).read().split("\n")
        head = lines[0].split("\t")
        return [dict(zip(head, l.split("\t"))) for l in lines[1:] if l]
    
    
    exp_third, counts = [], {}
    for label in labels:
        tally = {}
        for row in summary_rows(label):
            if row["outcome"] != "ok" or row["diff_exit"] not in ("0", "1"):
                continue
            for line in open(os.path.join(run_dir, row["id"], "diff.%s.tsv" % label)).read().split("\n"):
                cells = line.split("\t")
                if cells[0] != "xml":
                    continue
                exp_third.append("\t".join([row["id"], label] + cells + [""] * (10 - 2 - len(cells))))
        # The .md counts, derived entry by entry from the rows.
        entries = []
        for line in exp_third:
            cells = line.split("\t")
            if cells[1] != label:
                continue
            if cells[4] == "parse":
                entries.append({"name": cells[3], "ok": cells[5] == "ok" and cells[6] == "ok",
                                "names": False, "values": None})
            elif cells[4] in ("element", "attribute"):
                entries[-1]["names"] = True
            elif cells[4] == "values":
                entries[-1]["values"] = (int(cells[7]), int(cells[8]))
        for e in entries:
            t = tally.setdefault(fam(e["name"]), [0] * 6)
            t[0] += 1
            t[1] += 0 if e["ok"] else 1
            t[2] += 1 if e["ok"] and not e["names"] else 0
            t[3] += 1 if e["values"] == (0, 0) else 0
            t[4] += e["values"][0] if e["values"] else 0
            t[5] += e["values"][1] if e["values"] else 0
        lines = ["| family | compared | parse_errors | names_equal | values_equal | in_only | out_only |",
                 "| --- | --- | --- | --- | --- | --- | --- |"]
        total = [0] * 6
        for f in ORDER:
            if f in tally:
                lines.append("| " + " | ".join([f] + [str(v) for v in tally[f]]) + " |")
                total = [a + b for a, b in zip(total, tally[f])]
        lines.append("| " + " | ".join(["total"] + [str(v) for v in total]) + " |")
        with open(os.path.join(out, "exp-md-%s" % label), "w") as h:
            h.write("\n".join(lines) + "\n")
        got = open(md).read().split("\n")
        head = "## XML comparison of changed entries: %s" % label
        got_lines = []
        if head in got:
            i = got.index(head) + 2
            while i < len(got) and got[i]:
                got_lines.append(got[i])
                i += 1
        with open(os.path.join(out, "got-md-%s" % label), "w") as h:
            h.write("\n".join(got_lines) + "\n")
    with open(os.path.join(out, "exp-txt3"), "w") as h:
        h.write("\n".join(exp_third) + "\n")
    # The .txt's third table: the lines after its second blank line, header
    # first.
    parts = open(txt).read().split("\n\n")
    third = parts[2].rstrip("\n").split("\n") if len(parts) >= 3 else []
    with open(os.path.join(out, "got-txt3-header"), "w") as h:
        h.write((third[0] if third else "") + "\n")
    with open(os.path.join(out, "got-txt3"), "w") as h:
        h.write("\n".join(third[1:]) + "\n")
    print("xml rows derived: %d; .txt third-table rows: %d" % (len(exp_third), max(len(third) - 1, 0)))
    CHECK_B
    sed 's/^/    /' "$B/check_b.py"
    mkdir "$B/chk"
    echo "command: python3 <scratch>/w/check_b.py <run> <the .txt> <the .md> <scratch>/w/chk"
    python3 "$B/check_b.py" "$R" "$B/rec/$STEM.txt" "$B/rec/$STEM.md" "$B/chk" 2>&1 | hide | sed 's/^/    /'
    for f in exp-txt3 got-txt3 exp-md-host got-md-host exp-md-i686 got-md-i686; do
      echo "  $f:"; sed 's/^/      /' "$B/chk/$f"
    done
    xml_header_expected=$(python3 -c 'import sys, importlib.util
    sys.dont_write_bytecode = True
    s = importlib.util.spec_from_file_location("r", sys.argv[1]); m = importlib.util.module_from_spec(s); s.loader.exec_module(m)
    print("\t".join(m.XML_HEADER))' "$B/record-copy.py")
    note "the .txt's third table starts with the script's XML_HEADER" "$(is [ "$(cat "$B/chk/got-txt3-header")" = "$xml_header_expected" ])"
    note "the .txt's third table equals the diff files' xml rows, prefixed by id and label and padded" "$(is cmp -s "$B/chk/exp-txt3" "$B/chk/got-txt3")"
    nonempty_rows() { [ "$(count_lines "$B/chk/exp-txt3")" -ge 5 ]; }
    note "the derived table is not empty (wb1 holds xml rows on both labels)" "$(is nonempty_rows)"
    note "the .md's host XML table equals the derivation, total row included" "$(is cmp -s "$B/chk/exp-md-host" "$B/chk/got-md-host")"
    note "the .md's i686 XML table equals the derivation, total row included" "$(is cmp -s "$B/chk/exp-md-i686" "$B/chk/got-md-i686")"
    sed 's/| 1 | 0 | 1 |/| 1 | 0 | 0 |/' "$B/chk/exp-md-host" >"$B/chk/exp-md-host-wrong"
    note "control: the table compare says no to a table with one count changed" "$(isnot cmp -s "$B/chk/exp-md-host-wrong" "$B/chk/got-md-host")"
    note "control: the changed table does differ from the derivation" "$(isnot cmp -s "$B/chk/exp-md-host-wrong" "$B/chk/exp-md-host")"
    no_sentinel_b() {
      [ "$(count_from_file -F "$B/sentinel-b.pat" "$B/rec.stdout" "$B/rec.stderr" "$B/rec/$STEM.txt" "$B/rec/$STEM.md")" = 0 ]
    }
    note "no sentinel form in the record script's stdout, stderr, .txt or .md" "$(is no_sentinel_b)"
    note "control: the same form finds the planted copy" "$(is [ "$(count_from_file -F "$B/sentinel-b.pat" "$B/planted-b.txt")" = 1 ])"
    note "control: the sentinel is in the fixture pairs' XML (read unzipped)" "$(is python3 -c 'import sys, zipfile
    z = zipfile.ZipFile(sys.argv[1]); p = open(sys.argv[2]).read().split()[0]
    sys.exit(0 if p in z.read("xl/worksheets/sheet1.xml").decode() else 1)' "$B/pairs/wb1/in.zip" "$B/sentinel-b.pat")"
    
    echo
    echo "### B2: the refusals, each on a copy of the run directory changed in one place"
    echo "command: python3 over the record script's source (ast): the string constant holding each refusal's words, printed"
    cat >"$B/msgs.py" <<'MSGS'
    import ast, sys
    
    src = open(sys.argv[1]).read()
    consts = [n.value for n in ast.walk(ast.parse(src)) if isinstance(n, ast.Constant) and isinstance(n.value, str)]
    for key, words in (("read", "cannot read %s: %s"),
                       ("kind", "is not an xml row of a known kind and width"),
                       ("count", "has a count that is not a decimal number"),
                       ("state", "has a parse state other than ok or error"),
                       ("disagree", "disagrees with its xml rows"),
                       ("missing", "does not hold the four xml archive rows once each")):
        found = sorted(set(c for c in consts if words in c))
        print("%s\t%s" % (key, found[0] if len(found) == 1 else ""))
    MSGS
    sed 's/^/    /' "$B/msgs.py"
    python3 "$B/msgs.py" "$B/record-copy.py" >"$B/msgs.tsv"
    sed 's/^/    /' "$B/msgs.tsv"
    msgs_ok() { [ "$(awk -F'\t' '$2 != ""' "$B/msgs.tsv" | wc -l)" = 6 ]; }
    note "each of the six message forms is found once in the source, non-empty" "$(is msgs_ok)"
    msg() { awk -F'\t' -v k="$1" '$1 == k { print $2 }' "$B/msgs.tsv"; }
    WHAT="wb1/diff.host.tsv"
    # The line of the first row of a kind in wb1's host diff file, 1-based over
    # all its lines.
    line_of() { awk -F'\t' -v k="$1" '$1 == "xml" && $3 == k { print NR; exit }' "$R/wb1/diff.host.tsv"; }
    L_VALUES=$(line_of values)
    L_PARSE=$(line_of parse)
    echo "  in $WHAT: the first values row is line $L_VALUES, the first parse row line $L_PARSE"
    ENOENT_TEXT=$(python3 -c 'import errno, os; print(os.strerror(errno.ENOENT))')
    # refusal <n> <label> <expected message> <mutation, as a python snippet over d (the copy's wb1/diff.host.tsv lines)>
    refusal() {
      local n=$1 label=$2 want=$3 snippet=$4 dir="$B/ref-$1/$R_NAME" out="$B/ref-$1-out"
      mkdir -p "$B/ref-$n" "$out"
      cp -R "$R" "$dir"
      python3 - "$dir" "$snippet" <<'MUT'
    import os, sys
    run, snippet = sys.argv[1:3]
    path = os.path.join(run, "wb1", "diff.host.tsv")
    d = open(path).read().split("\n")
    exec(snippet)
    if d is not None:
        open(path, "w").write("\n".join(d))
    MUT
      echo "  [$n] $label"
      echo "    mutation (python, over the lines d of wb1/diff.host.tsv in the copy): $snippet"
      python3 "$REC" --run "$dir" --out "$out" >"$B/ref-$n.stdout" 2>"$B/ref-$n.stderr"
      echo $? >"$B/ref-$n.status"
      echo "    exit status: $(cat "$B/ref-$n.status"); stdout bytes: $(wc -c <"$B/ref-$n.stdout"); stderr:"
      hide <"$B/ref-$n.stderr" | sed 's/^/      /'
      echo "    expected stderr: error: $want"
      printf 'error: %s\n' "$want" >"$B/ref-$n.want"
      note "[$n] exit status 2" "$(is [ "$(cat "$B/ref-$n.status")" = 2 ])"
      note "[$n] stderr is exactly the one expected error line" "$(is cmp -s "$B/ref-$n.stderr" "$B/ref-$n.want")"
      note "[$n] stdout empty and nothing written" "$(is empty_run "$n" "$out")"
    }
    empty_run() { [ ! -s "$B/ref-$1.stdout" ] && [ "$(find "$2" -type f | wc -l)" = 0 ]; }
    fmt() { python3 -c 'import sys; print(sys.argv[1] % tuple(sys.argv[2:]))' "$@"; }
    fmt_d() { python3 -c 'import sys; print(sys.argv[1] % (sys.argv[2], int(sys.argv[3])))' "$@"; }
    refusal R1 "a missing diff file for an ok row" "$(fmt "$(msg read)" "$WHAT" "$ENOENT_TEXT")" \
      'os.remove(path); d = None'
    refusal R2 "an xml row of an unknown kind" "$(fmt_d "$(msg kind)" "$WHAT" "$L_VALUES")" \
      "c = d[$L_VALUES - 1].split('\t'); c[2] = 'valuez'; d[$L_VALUES - 1] = '\t'.join(c)"
    refusal R3 "an xml row of the wrong width" "$(fmt_d "$(msg kind)" "$WHAT" "$L_PARSE")" \
      "d[$L_PARSE - 1] += '\t0'"
    refusal R4 "a count that is not a decimal number" "$(fmt_d "$(msg count)" "$WHAT" "$L_VALUES")" \
      "c = d[$L_VALUES - 1].split('\t'); c[5] = '0x1'; d[$L_VALUES - 1] = '\t'.join(c)"
    refusal R5 "a parse state other than ok or error" "$(fmt_d "$(msg state)" "$WHAT" "$L_PARSE")" \
      "c = d[$L_PARSE - 1].split('\t'); c[3] = 'fine'; d[$L_PARSE - 1] = '\t'.join(c)"
    refusal R6 "archive xml_compared disagreeing with the rows" "$(fmt "$(msg disagree)" "$WHAT" xml_compared)" \
      "i = [k for k, l in enumerate(d) if l.startswith('archive\txml_compared\t')][0]; d[i] = 'archive\txml_compared\t' + str(int(d[i].split('\t')[2]) + 1)"
    refusal R7 "a diff file missing the xml archive rows" "$(fmt "$(msg missing)" "$WHAT")" \
      "d = [l for l in d if not l.startswith('archive\txml_')]"
    refusal R8 "a diff file holding an xml archive row twice (the same value)" "$(fmt "$(msg missing)" "$WHAT")" \
      "i = [k for k, l in enumerate(d) if l.startswith('archive\txml_compared\t')][0]; d.insert(i + 1, d[i])"
    note "control: R2's stderr is not R4's expected line" "$(isnot cmp -s "$B/ref-R2.stderr" "$B/ref-R4.want")"
    note "control: R6's stderr is not R7's expected line" "$(isnot cmp -s "$B/ref-R6.stderr" "$B/ref-R7.want")"
    
    echo
    echo "### B3m: the record script at the parent code commit on R8's copy (measured)"
    # ea37ad7's message states that the script at the code commit before it
    # accepted a repeated xml archive row; this prints that measurement.
    prev_code=$(tail -n 2 "$B/code-commits" | head -n 1 | cut -d' ' -f1)
    echo "  the code commit before the phase commit, read by role above: $prev_code"
    prev_is_parent() { [ -n "$prev_code" ] && [ "$(git rev-parse "$C~1")" = "$prev_code" ]; }
    note "it is the phase commit's parent" "$(is prev_is_parent)"
    echo "command: git show $prev_code:scripts/passthrough-record.py > <scratch>/w/record-prev.py"
    git show "$prev_code:scripts/passthrough-record.py" >"$B/record-prev.py"
    echo "  sha256 $(sha256sum <"$B/record-prev.py" | cut -d' ' -f1)"
    prev_differs() { cmp -s "$B/record-prev.py" "$B/record-copy.py"; }
    note "it differs from the phase commit's script" "$(isnot prev_differs)"
    dup_rows=$(awk -F'\t' '$1 == "archive" && $2 == "xml_compared"' "$B/ref-R8/$R_NAME/wb1/diff.host.tsv" | wc -l)
    echo "  archive xml_compared rows in R8's copy of wb1/diff.host.tsv: $dup_rows"
    note "R8's copy holds the row twice" "$(is [ "$dup_rows" = 2 ])"
    mkdir -p "$B/b3m-out"
    echo "command: python3 <scratch>/w/record-prev.py --run <scratch>/w/ref-R8/$R_NAME --out <scratch>/w/b3m-out"
    python3 "$B/record-prev.py" --run "$B/ref-R8/$R_NAME" --out "$B/b3m-out" >"$B/b3m.stdout" 2>"$B/b3m.stderr"
    echo $? >"$B/b3m.status"
    echo "  exit status: $(cat "$B/b3m.status"); stderr bytes: $(wc -c <"$B/b3m.stderr"); files written: $(find "$B/b3m-out" -type f | wc -l)"
    note "the parent code commit's script accepts the repeated row: exit status 0" "$(is [ "$(cat "$B/b3m.status")" = 0 ])"
    note "control: the phase commit's script refused the same copy (R8's exit status 2)" "$(is [ "$(cat "$B/ref-R8.status")" = 2 ])"
    no_sentinel_ref() { [ "$(count_from_file -F "$B/sentinel-b.pat" "$B"/ref-R*.stderr "$B"/ref-R*.stdout)" = 0 ]; }
    note "no sentinel form in any refusal's stdout or stderr" "$(is no_sentinel_ref)"
    
    echo
    echo "## the main working tree was not changed by this log"
    echo "command: git -C <repo> status --porcelain, before (taken at the root lines) and now"
    git -C "$MAIN" status --porcelain >"$B/status-after"
    echo "  status lines before: $(count_lines "$B/status-before"); now: $(count_lines "$B/status-after")"
    note "the main tree's status is the same as before" "$(is cmp -s "$B/status-before" "$B/status-after")"
    printf '?? planted\n' >>"$B/status-ctl"; cat "$B/status-before" >>"$B/status-ctl"
    note "control: the same comparison refuses a status with one line more" "$(isnot cmp -s "$B/status-before" "$B/status-ctl")"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

