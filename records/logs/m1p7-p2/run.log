    #!/usr/bin/env bash
    # Milestone 1 part 7 P2 run.log (specs/0014-xml-comparison.md, "### P2" and
    # "Harness runs" as "Planning verification and rulings on P1" F1 amends it):
    # the corpus run of --tool-arg --formula-sample on both targets with this
    # phase's xlsx-diff, which now prints xml rows for every changed entry; the
    # log's own derivation of those rows from each input, each assertion with a
    # control; the record pair, its XML table and xml rows checked against the
    # diff files; the entry statuses compared with part 6 P3's record.
    #
    # WRITTEN FOR M1 part 7 P2 from part 6 P3's run script (its printed copy is
    # in records/logs/m1p6-p3/run.log), audited against specs/0001 and the
    # rulings of specs/0013 and specs/0014 before the run. It carries that
    # script's rules: lines 1 to 3 are the command, the invocation and about:,
    # then the phase-commit guard, the three shape greps over this file, the
    # phase's commits by role read from git; no commit id and no count the phase
    # can grow is typed here. What differs, and why:
    #  1. THIS LOG BUILDS. P2 has no size log to hash its binaries, so the phase
    #     commit's tree is extracted with git archive into the working directory
    #     and emend-copy and xlsx-diff are built from it in the release profile,
    #     for the host and for i686-unknown-linux-musl, into the build directory
    #     <scratch>/p2/target-run, which only this log uses and no gate or test
    #     rerun cleans (part 6 P1 verification ruling 6). The commands and each
    #     binary's sha256 are printed. The runner's scripts are compared with
    #     the phase commit's blobs by git show.
    #  2. The checks are a new helper, xmlexpect.py, printed with its sha256
    #     below: part 6's p2check.py pick rules restated, and the xml rows
    #     derived from each input as the amended "Harness runs" says. Part 6's
    #     comparison and computation checks are not rerun: this phase changes
    #     the harness, not the library, and the emend-copy outputs are compared
    #     byte for byte with part 6 P3's run directory's when it still exists.
    #  3. Superseded run directories are removed before the run and printed
    #     (specs/0014 "Phases", carrying specs/0013 P3 verification ruling 4;
    #     independent check 1 F4 on this log's first attempt, which dropped
    #     it). Every directory under <corpus>/runs whose name is of the
    #     date-and-commit form and whose commit, read from git, is a part 7
    #     commit is superseded: part 7 P1 had no corpus run, so each is an
    #     earlier attempt of this phase. Part 6 P3's hash readers of size.log
    #     and of P2's committed run.log are gone.
    #  4. specs/0014 P1 verification ruling 3: a root line for every root this
    #     log uses: <scratch>/p2 (this script, the helper and the record pair's
    #     directory <scratch>/p2/out/records), <scratch>/p2/target-run (the
    #     build), <corpus> (the inputs and the run directory) and the mktemp -d
    #     working directory, each with the check that holds it apart.
    #  5. The phase-commit guard gains a control on a fabricated commit (the
    #     phase commit with its last hex digit changed).
    #  6. The SERIALIZED line counts cargo, rustc, emend-copy, xlsx-diff and
    #     podman processes at entry, and the log checks the count is 0.
    #  7. No typed count the phase can grow: part 6 P3's "P3 has two code
    #     commits" and "the 9 chains of the spec's Facts" are gone. Every
    #     expected xml row, count and total is derived by xmlexpect.py from its
    #     own read of each input; the manifest's rows give the workbook count.
    #     A disagreement between the tool and the derivation is a finding and
    #     reads UNEXPECTED; nothing observed is typed back as an expectation.
    #  9. Rerun after independent check 1 (F4, F7): the removal above, and the
    #     control line on part 6 P3's diff file no longer ends in a colon.
    #  8. The status check counts this phase's logs and records
    #     (records/logs/m1p7-p2/, records/m1p7-p2-*) as the phase's files, and
    #     specs/0014-xml-comparison.md or ROADMAP.md modified as planning's.
    #
    # None of the three shapes specs/0001 forbids appears here: every compound
    # condition is a named function and every negated one goes through isnot,
    # whose control is below; the shapes are described rather than written out.
    #
    # Workbooks appear as ids only, and the checks print counts and yes/no flags
    # only: no reference, no cell value, no formula text, no sheet name and no
    # part name. The derived rows (which carry entry names) are written to the
    # working directory and compared there, never printed. The corpus directory
    # is written <corpus>.
    #
    # Usage: m1p7-p2-run.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m1p7-p2/run.log. Started detached and polled.
    set -uo pipefail
    SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
    P2DIR=$(dirname "$SELF")
    SCR=$(dirname "$P2DIR")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    LO_IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    DATE=$(date -u +%Y-%m-%d)
    REC_DIR=$P2DIR/out/records
    BT=$P2DIR/target-run
    HEAD_SHA=$(git rev-parse HEAD)
    NULL_SHA=0000000000000000000000000000000000000000
    EDIT=--formula-sample
    fail=0
    
    nbad=0; nunexp=0
    note() {
      echo "  $1: $2"
      if [ "$2" != as-expected ]; then
        fail=1; nbad=$((nbad + 1))
        [ "$2" = UNEXPECTED ] && nunexp=$((nunexp + 1))
      fi
    }
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    isnot() { if "$@"; then echo UNEXPECTED; else echo as-expected; fi; }
    hide() { sed "s#$CORPUS#<corpus>#g; s#$SCR#<scratch>#g; s#$MAIN#<repo>#g; s#$HOME#<home>#g"; }
    bad() { fail=1; nbad=$((nbad + 1)); }
    
    G=/usr/bin/grep
    TAB=$(printf '\t')
    mkdir -p "$REC_DIR" || exit 2
    W=$(mktemp -d "$P2DIR/w.XXXXXX") || exit 2
    trap 'rm -rf "$W"' EXIT INT TERM HUP
    
    nrows() { awk -F'\t' 'NR > 1 { n++ } END { print n + 0 }' "$1"; }
    count_where() {
      awk -F'\t' -v c="$2" -v v="$3" '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next }
        k && $k == v { n++ } END { print n + 0 }' "$1"
    }
    # kv <line> <key>: the value of key=value in a line split on tabs or spaces.
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    kvn() {
      local v
      v=$(kv "$1" "$2")
      case "$v" in '' | *[!0-9]*) echo 0 ;; *) echo "$v" ;; esac
    }
    
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    if ! is_head "$C"; then echo "the phase commit must be HEAD as a full sha, not $C" >&2; exit 2; fi
    
    echo "command: git rev-parse HEAD"
    inv_path=$SELF
    case "$inv_path" in
      "$MAIN"/*) inv_path="<repo>/${inv_path#"$MAIN"/}" ;;
      "$SCR"/*) inv_path="<scratch>/${inv_path#"$SCR"/}" ;;
      /*) inv_path="<scratch>/$(basename "$inv_path")" ;;
    esac
    echo "invocation: bash $inv_path $*"
    echo "about: M1 part 7 P2 phase commit $C; HEAD at run: $HEAD_SHA"
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $HEAD_SHA"
    # A fabricated commit: the phase commit with its last hex digit changed.
    last_digit=$(printf '%s' "$C" | cut -c40)
    case "$last_digit" in 0) other_digit=1 ;; *) other_digit=0 ;; esac
    FABRICATED=$(printf '%s' "$C" | cut -c1-39)$other_digit
    echo "  a fabricated commit for the control (the last hex digit changed): $FABRICATED"
    note "the phase commit given to this script is a full sha" "$(is full_sha "$C")"
    note "the phase commit given to this script is HEAD" "$(is is_head "$C")"
    note "control: the same comparison refuses a fabricated commit" "$(isnot is_head "$FABRICATED")"
    note "control: the same comparison refuses the null commit" "$(isnot is_head "$NULL_SHA")"
    note "control: the same comparison refuses a short sha of the real commit" \
      "$(isnot is_head "$(printf '%s' "$C" | cut -c1-7)")"
    note "control: isnot reports a passing command as UNEXPECTED, so it can fail" \
      "$(is [ "$(isnot true)" = UNEXPECTED ])"
    
    # The three shape greps over this script's own file. The patterns are
    # bracket forms, which do not match themselves; the fixtures are assembled
    # by printf.
    SHAPE_CHAIN='[$][(](yn|is|isnot) .*(&&|[|][|])'
    SHAPE_BANG='[$][(](yn|is|isnot) [!]'
    SHAPE_ASSIGN='[$][(](yn|is|isnot) [A-Za-z_][A-Za-z_0-9]*='
    printf 'x %s(is [ a = a ] && [ b = b ])\n' '$' >"$W/shape-chain"
    printf 'x %s(is %s f a b)\n' '$' '!' >"$W/shape-bang"
    printf 'x %s(isnot %s%s /usr/bin/grep -q x f)\n' '$' 'LC_ALL' '=C' >"$W/shape-assign"
    echo
    echo "## the three shape greps over this script's own file"
    echo "command: sha256sum <scratch>/p2/$(basename "$SELF")"
    echo "  $(sha256sum <"$SELF" | cut -d' ' -f1)  $(wc -c <"$SELF") bytes"
    shape_hit=0
    for shape in chain bang assign; do
      case $shape in chain) pat=$SHAPE_CHAIN ;; bang) pat=$SHAPE_BANG ;; assign) pat=$SHAPE_ASSIGN ;; esac
      echo "command: count_matches -E <the $shape pattern> over <scratch>/p2/$(basename "$SELF"), and over a control fixture holding the $shape shape"
      echo "  the $shape pattern: $pat"
      on_self=$(count_matches -E "$pat" "$SELF")
      on_ctl=$(count_matches -E "$pat" "$W/shape-$shape")
      echo "  hits on this script: $on_self; hits on the control: $on_ctl"
      note "the $shape shape: no hit on this script" "$(is [ "$on_self" = 0 ])"
      note "control: the $shape pattern finds its shape in the fixture, through the same form" "$(is [ "$on_ctl" = 1 ])"
      [ "$on_self" = 0 ] || shape_hit=1
    done
    if [ "$shape_hit" != 0 ]; then
      echo "a shape grep hit this script (or could not read it): stopping before any case"
      exit 1
    fi
    
    # code_commits <part>: the code commits of one phase by role, oldest first,
    # as "<sha> <subject>" lines; the planning doc commits are set apart.
    code_commits() {
      git log --reverse --format='%H %s' --grep="^M1 part 7 $1: " | LC_ALL=C "$G" -v -F 'commit planning docs'
    }
    echo
    echo "## the phase's commits, by role, read from git"
    echo "command: git log --reverse --format='%H %s' --grep='^M1 part 7 P2: ' (planning doc commits printed and set apart)"
    git log --reverse --format='%H %s' --grep='^M1 part 7 P2: ' >"$W/phase-commits"
    LC_ALL=C "$G" -F 'commit planning docs' "$W/phase-commits" | sed 's/^/    planning doc commit: /'
    code_commits P2 >"$W/code-commits"
    awk '{ printf "    code commit %d: %s\n", NR, $0 }' "$W/code-commits"
    ncode=$(count_lines "$W/code-commits")
    last_code=$(tail -n 1 "$W/code-commits" | cut -d' ' -f1)
    echo "  code commits: $ncode; the last: $last_code"
    last_is_phase() { [ -n "$last_code" ] && [ "$last_code" = "$C" ]; }
    note "the last code commit, read from git, is the phase commit given to this script" "$(is last_is_phase)"
    fabricated_is_last() { [ "$last_code" = "$FABRICATED" ]; }
    note "control: the same comparison refuses the fabricated commit" "$(isnot fabricated_is_last)"
    echo "command: git rev-parse --short <the phase commit>"
    SHORT=$(git rev-parse --short "$C")
    echo "  $SHORT"
    RUN_TAG=${RUN_TAG:-}
    RUN=$DATE-$SHORT$RUN_TAG
    OUT=$CORPUS/runs/$RUN
    STEM=m1p7-p2-$DATE-$SHORT
    echo "  run directory: <corpus>/runs/$RUN; record stem: $STEM; build directory: <scratch>/p2/target-run"
    
    echo "phase: Milestone 1 part 7 P2 (specs/0014-xml-comparison.md) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above (kept in <scratch>/p2/out/superseded)"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    n_procs=0
    for pn in cargo rustc emend-copy xlsx-diff podman; do
      n_procs=$((n_procs + $(pgrep -x "$pn" | wc -l)))
    done
    echo "SERIALIZED: no other log run was in flight (the coordinator's arrangement); cargo, rustc, emend-copy, xlsx-diff and podman processes at entry: $n_procs"
    note "no such process was running at entry" "$(is [ "$n_procs" = 0 ])"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    under() { case "$1/" in "$2"/*) return 0 ;; esac; return 1; }
    echo "root: <scratch>/p2 stands for the directory holding this script and xmlexpect.py; the record pair is written to <scratch>/p2/out/records"
    echo "root: <scratch>/p2/target-run stands for this log's build directory (CARGO_TARGET_DIR), used by no other log, and cleaned by no gate or test rerun"
    echo "root: <corpus> stands for the private corpus directory (the inputs under <corpus>/corpus, the manifest, and the run directory <corpus>/runs/$RUN)"
    echo "root: <scratch>/p2/$(basename "$W") stands for this run's mktemp -d working directory (the extracted tree, the derived rows, the checks' outputs), created inside <scratch>/p2 and removed at exit"
    note "the working directory and the build directory are distinct, neither inside the other" "$(is apart "$W" "$BT")"
    note "the record directory and the build directory are distinct, neither inside the other" "$(is apart "$REC_DIR" "$BT")"
    note "the corpus and <scratch>/p2 are distinct, neither inside the other" "$(is apart "$CORPUS" "$P2DIR")"
    note "the run directory is inside the corpus directory" "$(is under "$OUT" "$CORPUS/runs")"
    note "control: apart refuses a directory inside another" "$(isnot apart "$BT/release" "$BT")"
    note "control: under refuses a directory outside another" "$(isnot under "$BT" "$CORPUS")"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go"
    echo "  to a scratch file, polled from later calls."
    echo "TERMS: this log's two release builds finish before the runner starts;"
    echo "  order host then i686; no mid-run tuning, and a copy or conversion that"
    echo "  timed out or was killed would be recorded and listed apart, never rerun"
    echo "  with a larger value."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the copy child and"
    echo "  --lo-timeout 600 per conversion, the figures part 6 P3's corpus run used."
    echo "  Neither is tuned during the run; each workbook's wall time is in the"
    echo "  record's summary table (wall_s)."
    echo "Workbooks are cited by id only. The corpus directory's PATH is written"
    echo "  <corpus> wherever this log prints a path; its NAME appears in the"
    echo "  script printed below, in the line that takes the default CLAUDE.md"
    echo "  gives. What is private is the corpus's contents and file names."
    
    echo
    echo "## script"
    echo "command: sed 's/^/    /' <this script>; sha256 $(sha256sum <"$SELF" | cut -d' ' -f1), $(wc -c <"$SELF") bytes"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    echo "command: sed 's/^/    /' scripts/counting.sh; sha256 $(sha256sum <scripts/counting.sh | cut -d' ' -f1)"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then
      echo "  the counting controls did not all hold"
      bad
    fi
    
    echo
    echo "## the check this log runs (python3, zipfile and expat), copied once"
    cp "$P2DIR/xmlexpect.py" "$W/xmlexpect.py" || exit 2
    echo "command: sed 's/^/    /' <scratch>/p2/xmlexpect.py; sha256 $(sha256sum <"$W/xmlexpect.py" | cut -d' ' -f1), $(wc -c <"$W/xmlexpect.py") bytes"
    sed 's/^/    /' "$W/xmlexpect.py"
    XE=$W/xmlexpect.py
    PLANTS='entries_ok parse_ok sheet_shape_ok sheet_elements_ok sheet_attributes_ok sheet_values_ok wb_ok types_ok rels_ok archive_ok archive_agree'
    
    echo
    echo "## the phase commit's tree, the runner's scripts and this log's own builds"
    PHASE_FILES='^(\?\?| ?[MARCD]) (records/logs/m1p7-p2/|records/m1p7-p2-)'
    PLANNING_FILES='^ M (specs/0014-xml-comparison[.]md|ROADMAP[.]md)$'
    # status_accounted <all> <phase> [<planning>]: every status line is this
    # phase's logs or records, or planning's file modified.
    status_accounted() {
      [ "$1" != error ] && [ "$2" != error ] && [ "${3:-0}" != error ] && [ "$1" = "$(($2 + ${3:-0}))" ]
    }
    planning_status() {
      st_plan=$(run_matches -E "$PLANNING_FILES" git status --porcelain)
      git status --porcelain | LC_ALL=C "$G" -E "$PLANNING_FILES" | cut -c4- |
        while IFS= read -r pf; do echo "  planning's file $pf: sha256 $(sha256sum <"$pf" | cut -d' ' -f1)"; done
    }
    echo "command: git status --porcelain"
    st_before=$(run_lines git status --porcelain)
    st_before_phase=$(run_matches -E "$PHASE_FILES" git status --porcelain)
    planning_status
    echo "  status lines before the build: $st_before; of them this phase's logs or records: $st_before_phase; planning's files modified: $st_plan"
    note "every change in the working tree before the build is this phase's logs or records, or planning's file" \
      "$(is status_accounted "$st_before" "$st_before_phase" "$st_plan")"
    printf '?? records/logs/m1p7-p2/\n?? crates/emend/src/x.rs\n' >"$W/status-ctl"
    st_ctl_all=$(count_lines "$W/status-ctl")
    st_ctl_phase=$(count_matches -E "$PHASE_FILES" "$W/status-ctl")
    printf ' M specs/0014-xml-comparison.md\n M specs/0001-bootstrap.md\n' >"$W/status-plan-ctl"
    st_ctl_plan=$(count_matches -E "$PLANNING_FILES" "$W/status-plan-ctl")
    note "control: the planning form counts specs/0014 and not another spec ($st_ctl_plan of 2)" \
      "$(is [ "$st_ctl_plan" = 1 ])"
    note "control: the same test refuses a status holding a source change" \
      "$(isnot status_accounted "$st_ctl_all" "$st_ctl_phase")"
    same_as_commit() { git show "$C:$1" | cmp -s - "$MAIN/$1"; }
    for s in scripts/passthrough-run.sh scripts/passthrough-record.py scripts/counting.sh; do
      echo "command: git show <the phase commit>:$s | cmp - $s"
      echo "  $s: sha256 $(sha256sum <"$MAIN/$s" | cut -d' ' -f1)"
      note "$s in the working tree is the phase commit's blob" "$(is same_as_commit "$s")"
    done
    differs_from_commit() { printf 'x\n' | cmp -s - "$MAIN/scripts/counting.sh"; }
    note "control: the same comparison refuses a file that differs" "$(isnot differs_from_commit)"
    SRC=$W/src
    mkdir -p "$SRC" || exit 2
    echo "command: git archive <the phase commit> | tar -x -C <scratch>/p2/$(basename "$W")/src"
    git archive "$C" | tar -x -C "$SRC"
    arc=$?
    note "git archive of the phase commit extracts" "$(is [ "$arc" -eq 0 ])"
    tree_files=$(git ls-tree -r --name-only "$C" | wc -l)
    src_files=$(cd "$SRC" && find . -type f | wc -l)
    echo "  files in the phase commit's tree: $tree_files; files extracted: $src_files"
    note "every file of the phase commit's tree was extracted" "$(is [ "$tree_files" = "$src_files" ])"
    I686=i686-unknown-linux-musl
    build() {
      local label=$1
      shift
      echo "command: cargo build --locked --release -p emend-copy -p xlsx-diff $* (in the extracted tree, CARGO_TARGET_DIR=<scratch>/p2/target-run)"
      (cd "$SRC" && CARGO_TARGET_DIR=$BT cargo build --locked --release -p emend-copy -p xlsx-diff "$@") \
        >"$W/build-$label.out" 2>"$W/build-$label.err"
      local rc=$?
      echo "  exit $rc; the build's last line: $(tail -1 "$W/build-$label.err" | hide | sed 's/ in [0-9.]*s$//')"
      build_rc=$rc
    }
    build host
    note "the host release build of the phase commit succeeds" "$(is [ "$build_rc" -eq 0 ])"
    build i686 --target "$I686"
    note "the i686 release build of the phase commit succeeds" "$(is [ "$build_rc" -eq 0 ])"
    PT_host=$BT/release/emend-copy
    XD_host=$BT/release/xlsx-diff
    PT_i686=$BT/$I686/release/emend-copy
    XD_i686=$BT/$I686/release/xlsx-diff
    echo "command: sha256sum and wc -c over the four binaries"
    nbin=0
    for b in "$PT_host" "$XD_host" "$PT_i686" "$XD_i686"; do
      if [ -x "$b" ]; then
        echo "  hash: <scratch>/${b#"$SCR"/}: sha256 $(sha256sum <"$b" | cut -d' ' -f1), bytes $(wc -c <"$b")"
        nbin=$((nbin + 1))
      else
        echo "  <scratch>/${b#"$SCR"/}: MISSING"
      fi
    done
    note "all four release binaries exist" "$(is [ "$nbin" = 4 ])"
    newer_than_tree() { [ "$1" -nt "$SRC/Cargo.toml" ]; }
    for b in "$PT_host" "$XD_host" "$PT_i686" "$XD_i686"; do
      note "<scratch>/${b#"$SCR"/} was written after this log extracted the tree" "$(is newer_than_tree "$b")"
    done
    note "control: the same test refuses a file older than the extraction" "$(isnot newer_than_tree "$MAIN/Cargo.toml")"
    header_hex() { od -A n -t x1 -j "$2" -N "$3" "$1" | tr -d ' \n'; }
    is_i686_elf() {
      [ "$(header_hex "$1" 0 4)" = 7f454c46 ] || return 1
      [ "$(header_hex "$1" 4 1)" = 01 ] || return 1
      [ "$(header_hex "$1" 18 2)" = 0300 ]
    }
    note "the i686 emend-copy is a 32-bit ELF for i386" "$(is is_i686_elf "$PT_i686")"
    note "the i686 xlsx-diff is a 32-bit ELF for i386" "$(is is_i686_elf "$XD_i686")"
    note "control: the same test refuses the host emend-copy" "$(isnot is_i686_elf "$PT_host")"
    
    # check_holds <check line>: found, derivation ok, and every flag yes.
    check_holds() {
      case "$1" in found=1\ planted=na\ *) ;; *) return 1 ;; esac
      [ "$(kv "$1" derivation)" = ok ] || return 1
      [ "$(printf '%s' "$1" | tr ' ' '\n' | LC_ALL=C "$G" -c '=no$')" = 0 ]
    }
    # plant_caught <plant line> <flag>: the plant applied and the named flag
    # reads no. Other flags may read no too; the line is printed.
    plant_caught() {
      [ "$(kv "$1" planted)" = yes ] || return 1
      [ "$(kv "$1" "$2")" = no ]
    }
    note "control: check_holds refuses a line with one flag no" \
      "$(isnot check_holds 'found=1 planted=na a=1 wb_ok=no derivation=ok')"
    note "control: check_holds refuses a derivation that does not cover the input" \
      "$(isnot check_holds 'found=1 planted=na a=1 derivation=calcPr_not_one_unflagged')"
    note "control: check_holds refuses a planted line" \
      "$(isnot check_holds 'found=1 planted=yes a=1 derivation=ok')"
    note "control: plant_caught refuses a plant that did not apply" \
      "$(isnot plant_caught 'found=1 planted=no wb_ok=no' wb_ok)"
    note "control: plant_caught refuses a plant whose flag still reads yes" \
      "$(isnot plant_caught 'found=1 planted=yes wb_ok=yes parse_ok=no' wb_ok)"
    
    if [ "$fail" -ne 0 ]; then
      echo "a check before the corpus run failed ($nbad so far): stopping before any run directory is touched"
      echo "verdict rows other than as-expected: $nbad; of them marked UNEXPECTED: $nunexp"
      echo "run log checks all as expected: no"
      exit 1
    fi
    
    echo
    echo "## superseded run directories of this part, removed before the run"
    # The names are read from <corpus>/runs; a name's commit is resolved by git
    # and its subject read, so no commit id and no directory name is typed here.
    RUNS=$CORPUS/runs
    # removable <runs dir> <name>: part 6 P3's test, unchanged.
    removable() {
      printf '%s' "$2" | LC_ALL=C "$G" -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{7,12}(-[a-z])?$' || return 1
      [ -d "$1/$2" ] || return 1
      [ -L "$1/$2" ] && return 1
      [ "$(cd "$1/$2/.." && pwd -P)" = "$(cd "$1" && pwd -P)" ]
    }
    mkdir -p "$W/runs-ctl/2026-01-01-abcdef0" "$W/runs-ctl/not-a-run" "$W/elsewhere"
    : >"$W/runs-ctl/2026-01-01-abcdef1"
    ln -s "$W/elsewhere" "$W/runs-ctl/2026-01-01-abcdef2"
    note "control: removable accepts a directory of the form" "$(is removable "$W/runs-ctl" 2026-01-01-abcdef0)"
    note "control: removable refuses a file of the form" "$(isnot removable "$W/runs-ctl" 2026-01-01-abcdef1)"
    note "control: removable refuses a symbolic link of the form" "$(isnot removable "$W/runs-ctl" 2026-01-01-abcdef2)"
    note "control: removable refuses a directory of another form" "$(isnot removable "$W/runs-ctl" not-a-run)"
    note "control: removable refuses a path that climbs out" "$(isnot removable "$W/runs-ctl" ../elsewhere)"
    # part7_run <name>: the name is of the form and its commit, resolved by git,
    # has a subject starting "M1 part 7 ".
    part7_run() {
      local hex subj
      printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{7,12}(-[a-z])?$' || return 1
      hex=$(printf '%s' "$1" | cut -d- -f4)
      subj=$(git log -1 --format=%s "$hex^{commit}" -- 2>/dev/null) || return 1
      case "$subj" in "M1 part 7 "*) return 0 ;; esac
      return 1
    }
    note "control: part7_run accepts this phase commit's bare run name" "$(is part7_run "$DATE-$SHORT")"
    note "control: part7_run refuses a run name of part 6 P3's commit" "$(isnot part7_run "2026-01-01-$(git rev-parse --short "$(git log -1 --format=%H --grep='^M1 part 6 P3: ')")")"
    note "control: part7_run refuses a name of another form" "$(isnot part7_run not-a-run)"
    echo "command: ls <corpus>/runs, each name of the date-and-commit form tested by part7_run"
    : >"$W/stale"
    for d in "$RUNS"/*; do
      name=$(basename "$d")
      if [ -d "$d" ] && part7_run "$name"; then printf '%s\n' "$name" >>"$W/stale"; fi
    done
    echo "  run directories under <corpus>/runs: $(find "$RUNS" -mindepth 1 -maxdepth 1 -type d | wc -l); of them part 7's, so superseded: $(count_lines "$W/stale")"
    sed 's/^/    superseded: /' "$W/stale"
    P6_KEEP=$(sed -n 's/^Written by .* from the run directory `\([^`]*\)`.*/\1/p' "$MAIN/$(git ls-files 'records/m1p6-p3-*.md')")
    echo "  the run directory part 6 P3's record cites: $P6_KEEP"
    p6_is_stale() { LC_ALL=C "$G" -qxF -- "$P6_KEEP" "$W/stale"; }
    note "part 6 P3's cited directory is not among the superseded" "$(isnot p6_is_stale)"
    while IFS= read -r name; do
      present() { [ -e "$RUNS/$name" ]; }
      echo "  before: <corpus>/runs/$name present: $(present && echo yes || echo no); a run directory of the form: $(removable "$RUNS" "$name" && echo yes || echo no)"
      note "<corpus>/runs/$name is there to remove" "$(is removable "$RUNS" "$name")"
      if removable "$RUNS" "$name"; then
        echo "command: rm -rf -- <corpus>/runs/$name"
        rm -rf -- "${RUNS:?}/$name"
      fi
      echo "  after: <corpus>/runs/$name present: $(present && echo yes || echo no)"
      note "<corpus>/runs/$name removed" "$(isnot present)"
    done <"$W/stale"
    p6_kept_there() { removable "$RUNS" "$P6_KEEP"; }
    note "part 6 P3's cited run directory, <corpus>/runs/$P6_KEEP, still stands" "$(is p6_kept_there)"
    
    echo
    echo "## settings"
    echo "  --timeout 300 (the copy child only); --lo-timeout 600 (per conversion);"
    echo "  image $LO_IMAGE; --tool-arg $EDIT"
    echo "  out directory: <corpus>/runs/$RUN"
    echo "  record stem: $STEM; record directory: <scratch>/p2/out/records"
    manifest_rows=$(nrows "$CORPUS/manifest.tsv")
    echo "  corpus manifest rows: $manifest_rows (every later count of workbooks is compared with this, never with a typed number)"
    { cat "$CORPUS/manifest.tsv"; printf 'planted\n'; } >"$W/manifest-plus"
    note "control: the same reader counts one more row on a manifest with one planted" \
      "$(is [ "$(nrows "$W/manifest-plus")" = "$((manifest_rows + 1))" ])"
    no_summary() {
      local f
      for f in "$1"/summary.*.tsv; do
        [ -e "$f" ] && return 1
      done
      return 0
    }
    mkdir -p "$W/ctl-run"
    note "control: no_summary accepts an empty directory" "$(is no_summary "$W/ctl-run")"
    : >"$W/ctl-run/summary.host.tsv"
    note "control: no_summary refuses a directory holding a summary" "$(isnot no_summary "$W/ctl-run")"
    note "the run directory <corpus>/runs/$RUN holds no summary before the runner" "$(is no_summary "$OUT")"
    if [ -e "$OUT/summary.host.tsv" ] || [ -e "$OUT/summary.i686.tsv" ]; then
      echo "  refusing to run over an earlier run's summary"
      exit 1
    fi
    P6_REC=$(git ls-files 'records/m1p6-p3-*.txt')
    P6_MD=$(git ls-files 'records/m1p6-p3-*.md')
    P6=$CORPUS/runs/$(sed -n 's/^Written by .* from the run directory `\([^`]*\)`.*/\1/p' "$MAIN/$P6_MD")
    echo "command: git ls-files 'records/m1p6-p3-*.txt' 'records/m1p6-p3-*.md'; and sed for the run directory the .md cites"
    echo "  part 6 P3's record: $P6_REC; its run directory: <corpus>/runs/$(basename "$P6")"
    if [ -d "$P6" ]; then P6_THERE=yes; else P6_THERE=no; fi
    echo "  part 6 P3's run directory still exists: $P6_THERE"
    
    echo
    echo "## the log's own read of every input (counts only)"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' \
      "$CORPUS/manifest.tsv" >"$W/ids"
    note "the ids read cover the manifest's rows" "$(is [ "$(count_lines "$W/ids")" = "$manifest_rows" ])"
    n_expected_rows=0
    while IFS=$'\t' read -r id ext; do
      python3 "$XE" expect "$CORPUS/corpus/$id.$ext" "$W/expect-$id"
      n_expected_rows=$((n_expected_rows + $(count_lines "$W/expect-$id")))
    done <"$W/ids"
    echo "  xml rows derived over all inputs: $n_expected_rows (per label)"
    
    for label in host i686; do
      if [ "$label" = host ]; then PT=$PT_host; XD=$XD_host; else PT=$PT_i686; XD=$XD_i686; fi
      echo
      echo "## $label run, --tool-arg $EDIT"
      echo "command: scripts/passthrough-run.sh --label $label --passthrough <scratch>/${PT#"$SCR"/} --xlsx-diff <scratch>/${XD#"$SCR"/} --out <corpus>/runs/$RUN --libreoffice $LO_IMAGE --lo-timeout 600 --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" \
        --out "$OUT" --libreoffice "$LO_IMAGE" --lo-timeout 600 --timeout 300 \
        --tool-arg "$EDIT" \
        >"$W/run-$label.stdout" 2>"$W/run-$label.stderr"
      rc=$?
      ended=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      echo "  started $started; ended $ended; exit $rc; stderr bytes: $(wc -c <"$W/run-$label.stderr")"
      hide <"$W/run-$label.stdout" | sed 's/^/    /'
      if [ -s "$W/run-$label.stderr" ]; then hide <"$W/run-$label.stderr" | sed 's/^/    stderr: /'; fi
      note "$label the run exits 0" "$(is [ "$rc" -eq 0 ])"
      note "$label the run's stderr is empty" "$(is [ "$(wc -c <"$W/run-$label.stderr")" -eq 0 ])"
      SUM=$OUT/summary.$label.tsv
      if [ ! -f "$SUM" ]; then
        echo "  the run wrote no summary"; bad; continue
      fi
      rows=$(nrows "$SUM")
      ok=$(count_where "$SUM" outcome ok)
      lo=$(count_where "$SUM" lo ok)
      lo_in=$(count_where "$SUM" lo_in ok)
      echo "  summary rows: $rows; outcome ok: $ok; lo ok: $lo; lo_in ok: $lo_in"
      note "$label every manifest workbook produced a summary row ($rows of $manifest_rows)" "$(is [ "$rows" = "$manifest_rows" ])"
      note "$label every outcome is ok" "$(is [ "$ok" = "$rows" ])"
      note "$label lo is ok on every file" "$(is [ "$lo" = "$rows" ])"
      note "$label lo_in is ok on every file" "$(is [ "$lo_in" = "$rows" ])"
      awk -F'\t' 'BEGIN { OFS = "\t" } NR == 1 { for (i = 1; i <= NF; i++) if ($i == "outcome") k = i }
        NR == 2 { $k = "planted" } { print }' "$SUM" >"$W/sum-planted"
      ok_planted=$(count_where "$W/sum-planted" outcome ok)
      note "$label control: the same count of outcome ok is one less on a summary with one row planted not ok ($ok_planted)" \
        "$(is [ "$ok_planted" = "$((ok - 1))" ])"
    
      echo "  per workbook: id, then the check's line (counts and yes/no only); the plants on each workbook are counted below"
      nhold=0; nrows_same=0; nnone=0; n_a=0
      declare -A CAUGHT=() APPLIED=()
      while IFS=$'\t' read -r id ext; do
        D=$OUT/$id/diff.$label.tsv
        python3 "$XE" check "$CORPUS/corpus/$id.$ext" "$D" --plants >"$W/check-$label-$id"
        line=$(head -n 1 "$W/check-$label-$id")
        printf '    %s %s\n' "$id" "$line"
        if check_holds "$line"; then nhold=$((nhold + 1)); else echo "    $id: THE TOOL'S XML ROWS ARE NOT THE ONES THE LOG'S OWN READ DERIVES"; fi
        LC_ALL=C "$G" "^xml$TAB" "$D" >"$W/tool-$label-$id"
        if cmp -s "$W/tool-$label-$id" "$W/expect-$id"; then nrows_same=$((nrows_same + 1)); fi
        if [ "$(kv "$line" a)" = 1 ]; then
          n_a=$((n_a + 1))
        elif [ "$(count_lines "$W/tool-$label-$id")" = 0 ]; then
          nnone=$((nnone + 1))
        fi
        for flag in $PLANTS; do
          pl=$(sed -n "s/^plant $flag: //p" "$W/check-$label-$id")
          if [ "$(kv "$pl" planted)" = yes ]; then
            APPLIED[$flag]=$((${APPLIED[$flag]:-0} + 1))
            if plant_caught "$pl" "$flag"; then
              CAUGHT[$flag]=$((${CAUGHT[$flag]:-0} + 1))
            else
              echo "    $id plant $flag: applied, and $flag did NOT read no: $pl"
            fi
          fi
        done
      done <"$W/ids"
      echo "  workbooks: $manifest_rows; the check holding: $nhold; the tool's xml rows byte-identical to the derived rows: $nrows_same; with A: $n_a; without A and with no xml row: $nnone"
      note "$label on every workbook the tool's xml rows and archive rows are what the log's own read derives" "$(is [ "$nhold" = "$manifest_rows" ])"
      note "$label on every workbook the tool's xml rows are byte-identical to the derived rows, in order" "$(is [ "$nrows_same" = "$manifest_rows" ])"
      note "$label every workbook without A has no xml row" "$(is [ "$nnone" = "$((manifest_rows - n_a))" ])"
      # caught_every_time <applied> <caught>: applied at least once, caught on
      # every workbook where it applied.
      caught_every_time() { [ "$1" -ge 1 ] || return 1; [ "$2" = "$1" ]; }
      for flag in $PLANTS; do
        echo "  $label plant $flag: applied on ${APPLIED[$flag]:-0} workbooks, caught on ${CAUGHT[$flag]:-0}"
        note "$label control: the plant for $flag applied at least once and was caught every time it applied" \
          "$(is caught_every_time "${APPLIED[$flag]:-0}" "${CAUGHT[$flag]:-0}")"
      done
      note "control: caught_every_time refuses a plant that never applied" "$(isnot caught_every_time 0 0)"
      note "control: caught_every_time refuses a plant missed once" "$(isnot caught_every_time 3 2)"
      first_a=$(while IFS=$'\t' read -r id ext; do [ -s "$W/expect-$id" ] && echo "$id"; done <"$W/ids" | head -n 1)
      sed "1s/$TAB[0-9]*\$/${TAB}999999/" "$W/expect-$first_a" >"$W/expect-planted"
      note "$label control: the byte comparison refuses derived rows with one count changed" \
        "$(isnot cmp -s "$W/tool-$label-$first_a" "$W/expect-planted")"
      unset CAUGHT APPLIED
    done
    
    echo
    echo "## the two labels agree"
    same_diffs() {
      local id ext
      while IFS=$'\t' read -r id ext; do
        cmp -s "$OUT/$id/diff.host.tsv" "$OUT/$id/diff.i686.tsv" || return 1
      done <"$W/ids"
    }
    note "host and i686 wrote byte-identical diff files for every workbook" "$(is same_diffs)"
    same_outputs() {
      local id ext
      while IFS=$'\t' read -r id ext; do
        cmp -s "$OUT/$id/out.host.$ext" "$OUT/$id/out.i686.$ext" || return 1
      done <"$W/ids"
    }
    note "host and i686 wrote byte-identical outputs" "$(is same_outputs)"
    first_id=$(head -n 1 "$W/ids" | cut -f1)
    sed '1s/^/x/' "$OUT/$first_id/diff.i686.tsv" >"$W/diff-planted"
    note "control: the same comparison finds one planted diff file differ" \
      "$(isnot cmp -s "$OUT/$first_id/diff.host.tsv" "$W/diff-planted")"
    
    echo
    echo "## the emend-copy outputs against part 6 P3's run directory"
    echo "  part 6 P3's run directory still exists: $P6_THERE"
    same_as_p6() {
      local id ext label
      for label in host i686; do
        while IFS=$'\t' read -r id ext; do
          cmp -s "$OUT/$id/out.$label.$ext" "$P6/$id/out.$label.$ext" || return 1
        done <"$W/ids"
      done
    }
    if [ "$P6_THERE" = yes ]; then
      note "every output of both labels is byte-identical to part 6 P3's" "$(is same_as_p6)"
      p6_differs() { cmp -s "$OUT/$first_id/diff.host.tsv" "$P6/$first_id/diff.host.tsv"; }
      echo "  the control below uses the first workbook's diff file, which gained xml and archive rows since part 6 P3"
      note "control: the same byte comparison refuses a file that changed" "$(isnot p6_differs)"
    else
      echo "  not compared: the directory is gone"
    fi
    
    echo
    echo "## the run rows both labels appended"
    for label in host i686; do
      R=$OUT/run.$label.tsv
      if [ -f "$R" ]; then
        echo "  run.$label.tsv header: $(head -1 "$R")"
        echo "  run.$label.tsv row: $(sed -n 2p "$R" | hide)"
        args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next }
                           k && NR == 2 { print $k }' "$R")
        echo "  run.$label.tsv tool_args: [$args]"
        note "$label the run row records the operation" "$(is [ "$args" = "$EDIT" ])"
      else
        echo "  run.$label.tsv: MISSING"; bad
      fi
    done
    
    echo
    echo "## the record pair (written to <scratch>/p2/out/records)"
    echo "command: scripts/passthrough-record.py --run <corpus>/runs/$RUN --out <scratch>/p2/out/records --stem $STEM"
    scripts/passthrough-record.py --run "$OUT" --out "$REC_DIR" --stem "$STEM" >"$W/record.out" 2>&1
    rrc=$?
    hide <"$W/record.out" | sed 's/^/    /'
    note "the record script exits 0" "$(is [ "$rrc" -eq 0 ])"
    for ext in md txt; do
      f=$REC_DIR/$STEM.$ext
      if [ -f "$f" ]; then
        echo "  <scratch>/p2/out/records/$STEM.$ext: $(wc -c <"$f") bytes, sha256 $(sha256sum <"$f" | cut -d' ' -f1)"
      else
        echo "  <scratch>/p2/out/records/$STEM.$ext: MISSING"; bad
      fi
    done
    MD=$REC_DIR/$STEM.md
    TXT=$REC_DIR/$STEM.txt
    # own_totals <label>: family-free totals over the diff files, read here with
    # awk and not with the record script: compared, parse errors, names equal,
    # values equal, in_only, out_only.
    own_totals() {
      local id ext
      while IFS=$'\t' read -r id ext; do
        cat "$OUT/$id/diff.$1.tsv"
      done <"$W/ids" | awk -F'\t' '
        $1 != "xml" { next }
        $3 == "parse" { c++; parsed = ($4 == "ok" && $5 == "ok"); if (!parsed) pe++; names = 1 }
        $3 == "element" || $3 == "attribute" { names = 0 }
        $3 == "values" { if (parsed && names) ne++; if ($6 == "0" && $7 == "0") ve++; io += $6; oo += $7 }
        END { printf "%d %d %d %d %d %d", c, pe, ne, ve, io, oo }'
    }
    # md_total <label>: the total row of the .md's XML table for the label.
    md_total() {
      awk -v want="## XML comparison of changed entries: $1" '
        $0 == want { on = 1; next }
        on && /^## / { on = 0 }
        on && /^[|] total [|]/ { gsub(/[|]/, " "); print $2 " " $3 " " $4 " " $5 " " $6 " " $7; exit }' "$2"
    }
    own_xml_rows() {
      local id ext label n=0
      for label in host i686; do
        while IFS=$'\t' read -r id ext; do
          n=$((n + $(count_matches -E "^xml$TAB" "$OUT/$id/diff.$label.tsv")))
        done <"$W/ids"
      done
      echo "$n"
    }
    # txt_xml_rows: the rows of the .txt's third table, the one whose header
    # starts with id, label, row, name, kind.
    txt_xml_rows() {
      awk -F'\t' '
        $1 == "id" && $2 == "label" && $3 == "row" && $4 == "name" && $5 == "kind" { on = 1; next }
        on && NF > 0 { n++ } END { print n + 0 }' "$1"
    }
    for label in host i686; do
      own=$(own_totals "$label")
      mdt=$(md_total "$label" "$MD")
      echo "  $label totals from the diff files (compared parse_errors names_equal values_equal in_only out_only): $own; the .md's total row: $mdt"
      note "$label the .md's XML total row equals the diff files' totals" "$(is [ "$own" = "$mdt" ])"
    done
    sed 's/^| total | \([0-9]*\) |/| total | 9\1 |/' "$MD" >"$W/md-planted"
    note "control: the same reader sees a planted .md total differ" \
      "$(isnot [ "$(own_totals host)" = "$(md_total host "$W/md-planted")" ])"
    ownx=$(own_xml_rows)
    txtx=$(txt_xml_rows "$TXT")
    echo "  xml rows in the diff files of both labels: $ownx; rows of the .txt's third table: $txtx"
    note "the .txt's third table holds every xml row of the diff files" "$(is [ "$ownx" = "$txtx" ])"
    note "the xml rows of both labels are the derived rows twice" "$(is [ "$ownx" = "$((2 * n_expected_rows))" ])"
    { cat "$TXT"; printf 'planted\trow\n'; } >"$W/txt-planted"
    note "control: the same reader counts one more row on a .txt with one planted" \
      "$(is [ "$(txt_xml_rows "$W/txt-planted")" = "$((txtx + 1))" ])"
    
    echo
    echo "## the entry statuses against part 6 P3's record"
    # statuses <.txt>: id, label, name and status of every row of the entry
    # table, the one whose header starts with id, label, row, name, status.
    statuses() {
      awk -F'\t' '
        $1 == "id" && $2 == "label" && $3 == "row" && $4 == "name" { on = ($5 == "status"); next }
        on && NF > 0 { print $1 "\t" $2 "\t" $4 "\t" $5 }' "$1" | sort
    }
    statuses "$TXT" >"$W/st-new"
    statuses "$MAIN/$P6_REC" >"$W/st-p6"
    echo "  entry rows: this record $(count_lines "$W/st-new"); part 6 P3's $(count_lines "$W/st-p6")"
    nonempty() { [ -s "$1" ]; }
    note "the entry table was read from this record" "$(is nonempty "$W/st-new")"
    note "every entry status equals part 6 P3's record" "$(is cmp -s "$W/st-new" "$W/st-p6")"
    awk -F'\t' 'BEGIN { OFS = "\t" } NR == 1 { $4 = ($4 == "changed" ? "identical" : "changed") } { print }' "$W/st-p6" >"$W/st-planted"
    note "control: the same comparison refuses one status flipped" "$(isnot cmp -s "$W/st-new" "$W/st-planted")"
    
    echo
    echo "## the record pair holds no corpus path and no absolute path"
    for ext in md txt; do
      f=$REC_DIR/$STEM.$ext
      [ -f "$f" ] || continue
      n=$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$f")
      echo "  <scratch>/p2/out/records/$STEM.$ext: lines naming a home, mount, temporary or corpus path: $n"
      note "$STEM.$ext carries no such path" "$(is [ "$n" = 0 ])"
    done
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x.xlsx' >"$W/path-control"
    nctl=$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$W/path-control")
    note "control: the path form finds a planted path ($nctl)" "$(is [ "$nctl" = 1 ])"
    
    echo
    echo "## status after the runs"
    echo "command: git status --porcelain"
    st_all=$(run_lines git status --porcelain)
    st_phase=$(run_matches -E "$PHASE_FILES" git status --porcelain)
    planning_status
    echo "status lines: $st_all; of them this phase's logs or record pair: $st_phase; planning's files modified: $st_plan"
    note "every change in the working tree is this phase's logs or record pair, or planning's file" \
      "$(is status_accounted "$st_all" "$st_phase" "$st_plan")"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "verdict rows other than as-expected: $nbad; of them marked UNEXPECTED: $nunexp"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

