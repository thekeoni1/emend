command: sed 's/^/    /' <scratch>/p2/xmlexpect.py; sha256 0af6982401dd4f8b031860301b4b8577d1d23dfcbe5754741ba620432fdb4147, 24370 bytes
    """The P2 run log's own derivation of the xml rows (specs/0014, "Harness runs"
    as P1 verification F1 amends it) and its check of the tool's rows.
    
    Usage: xmlexpect.py expect <input> <rows file>
           xmlexpect.py check <input> <diff file> [--plants]
    
    Reads the input package with zipfile and expat, sharing no code with the
    library or the tool, and makes its own pick of the edit --formula-sample
    makes (the rules of part 6's p2check.py, restated here): the first sheet whose
    workbook relationship is of kind worksheet, in <sheets> order, and in it, in
    document order, A (the first cell whose t is absent or "n", which has a <v> or
    an <is> and no <f>), F (the first cell with an <f> whose t is absent or
    "normal") and M (the largest row number among its cells). A cell's reference
    is its own r, else the column after the previous cell of its row; a row's
    number is its own r, else the one after the previous row's.
    
    From that read alone it derives the xml rows the tool must print. The values
    the edit removes (X) and writes (Y), as (kind, element, attribute, value)
    tuples hashed by the tool:
      X  every element, attribute and text value of A's subtree and of F's;
      Y  A written as <c r s?><v>21</v></c>, F as <c r s?><f>2+3</f></c> (a
         replaced cell keeps its own s and nothing else), the two new cells
         <c r="A{M+1}"><f>{A's reference}*2</f></c> and <c r="B{M+1}"><f>1+1</f></c>,
         and <row r="{M+1}"> when no row element numbered M+1 exists.
    The first worksheet's element and attribute rows are the names whose counts
    X and Y move, with the input's whole-entry count and that count plus the
    move; its values row is (input values, input values - |X| + |Y|, |X - Y|,
    |Y - X|) as multisets, since whatever the edit leaves is on both sides. The
    workbook part gains calcPr@fullCalcOnLoad="1" (one value). A chained
    workbook's content types lose the calcChain Override and the workbook
    relationships its Relationship, each with its attributes. Without A nothing
    changes and no xml row is expected. Every parse row is ok on both sides with
    0 raw values. The archive's four xml rows follow from those blocks.
    
    expect writes the derived rows to a file, never printed by the log (they
    carry entry names). check prints ONE line of counts and yes/no flags:
      a, f, row_new, chain       the pick (1 or 0)
      blocks, rows               the derived compared entries and xml rows
      entries_ok       the tool's compared entries are exactly the derived ones,
                       in the input's entry order
      parse_ok         every parse row of the tool is ok ok, no offset, 0 0 raw
      sheet_shape_ok   the first worksheet's element deltas are exactly
                       planning's reading: c +2, f +2, row +1 when row M+1 was
                       new, v -1 when F exists, and no other (yes with no A)
      sheet_elements_ok, sheet_attributes_ok, sheet_values_ok
                       the first worksheet's element, attribute and values rows
                       equal the derivation (yes with no A)
      wb_ok            the workbook part's rows equal the derivation and are the
                       one attribute row calcPr@{}fullCalcOnLoad 0 1, no element
                       row, values in_only 0 and out_only 1 (yes with no A)
      types_ok, rels_ok
                       the content types' and workbook relationships' rows equal
                       the derivation: Override (Relationship) -1, one attribute
                       row per attribute the lost element carried, in_only that
                       count, out_only 0 (yes when neither chained nor with A)
      archive_ok       the tool's four xml archive rows are the derived counts
      archive_agree    the tool's four xml archive rows are the tally of its own
                       xml rows
      derivation       ok, or the reason the derivation does not cover the input
    --plants then prints one more line per flag, "plant <flag>: " and the line
    for a copy of the tool's rows changed in memory so that the named flag should
    read no; planted=no when the plant cannot apply to the workbook.
    """
    import posixpath
    import re
    import sys
    import xml.parsers.expat
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    TYPES = "http://schemas.openxmlformats.org/package/2006/content-types"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    WS = " \t\n\r"
    PLANTS = ("entries_ok", "parse_ok", "sheet_shape_ok", "sheet_elements_ok",
              "sheet_attributes_ok", "sheet_values_ok", "wb_ok", "types_ok",
              "rels_ok", "archive_ok", "archive_agree")
    ARCHIVE = ("xml_compared", "xml_parse_errors", "xml_names_equal", "xml_values_equal")
    
    
    class Uncovered(Exception):
        pass
    
    
    def resolved(name):
        """expat's 'uri local' (or bare local) as the tool writes it."""
        uri, sep, local = name.rpartition(" ")
        return "{%s}%s" % (uri, local) if sep else "{}" + name
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def resolve_target(part, target):
        if target.startswith("/"):
            return target[1:]
        return posixpath.normpath(posixpath.join(posixpath.dirname(part), target))
    
    
    def relationships(z, names, part):
        """(attrs, resolved target) of every Relationship of part's rels part."""
        name = rels_name(part)
        if name not in names:
            return []
        found = []
    
        def start(tag, attrs):
            if tag == RELS + " Relationship":
                found.append(dict(attrs))
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.Parse(z.read(name), True)
        out = []
        for a in found:
            t = None if a.get("TargetMode") == "External" else resolve_target(part, a.get("Target", ""))
            out.append((a, t))
        return out
    
    
    def col_of(ref):
        m = re.match(r"([A-Za-z]+)", ref or "")
        n = 0
        for ch in (m.group(1).upper() if m else ""):
            n = n * 26 + (ord(ch) - 64)
        return n
    
    
    def row_of(ref):
        m = re.search(r"(\d+)$", ref or "")
        return int(m.group(1)) if m else 0
    
    
    def a1(row, col):
        name = ""
        while col > 0:
            col, rest = divmod(col - 1, 26)
            name = chr(65 + rest) + name
        return "%s%d" % (name, row)
    
    
    class Reader:
        """One streaming pass over an entry: whole-entry counts of element names,
        attribute names and values, and, for a sheet, each cell's own values."""
    
        def __init__(self, sheet):
            self.sheet = sheet
            self.elements = {}
            self.attributes = {}
            self.values = 0
            self.stack = []
            self.text = []
            self.cell = None
            self.cell_depth = 0
            self.row = 0
            self.col = 0
            self.rows = set()
            self.a = self.f = None
            self.top = 0
            self.ns = None
            self.override = []
            self.relationship = []
    
        def local(self, name):
            uri, sep, local = name.rpartition(" ")
            return local if sep and uri in MAIN else None
    
        def value(self, item):
            self.values += 1
            if self.cell is not None:
                self.cell["items"].append(item)
    
        def flush(self, enclosing):
            text = "".join(self.text)
            self.text = []
            if text.strip(WS):
                self.value(("t", resolved(enclosing) if enclosing else "", "", text))
    
        def start(self, name, attrs):
            self.flush(self.stack[-1] if self.stack else None)
            el = resolved(name)
            self.elements[el] = self.elements.get(el, 0) + 1
            local = self.local(name)
            parent = self.local(self.stack[-1]) if self.stack else None
            grand = self.local(self.stack[-2]) if len(self.stack) > 1 else None
            self.stack.append(name)
            if self.sheet and local == "sheetData":
                self.ns = name.rpartition(" ")[0]
            if self.sheet and local == "row" and parent == "sheetData":
                r = attrs.get("r")
                self.row = int(r) if r and r.isdigit() else self.row + 1
                self.col = 0
                self.rows.add(self.row)
            if self.sheet and local == "c" and parent == "row" and grand == "sheetData":
                ref = attrs.get("r") or a1(self.row, self.col + 1)
                self.col = col_of(ref)
                self.cell = {"r": ref, "has_r": "r" in attrs, "s": attrs.get("s"), "t": attrs.get("t"),
                             "f": False, "ft": None, "value": False, "items": []}
                self.cell_depth = len(self.stack)
            elif self.cell is not None and parent == "c" and len(self.stack) == self.cell_depth + 1:
                if local == "f":
                    self.cell["f"] = True
                    self.cell["ft"] = attrs.get("t")
                elif local in ("v", "is"):
                    self.cell["value"] = True
            if self.cell is not None:
                self.cell["items"].append(("e", el, "", ""))
            for k, v in attrs.items():
                an = el + "@" + resolved(k)
                self.attributes[an] = self.attributes.get(an, 0) + 1
                self.value(("a", el, resolved(k), v))
            if name == TYPES + " Override":
                self.override.append(dict(attrs))
            if name == RELS + " Relationship":
                self.relationship.append(dict(attrs))
    
        def end(self, name):
            self.flush(name)
            self.stack.pop()
            if self.cell is not None and len(self.stack) == self.cell_depth - 1:
                c = self.cell
                self.cell = None
                self.top = max(self.top, row_of(c["r"]))
                if self.a is None and c["t"] in (None, "n") and c["value"] and not c["f"]:
                    self.a = c
                if self.f is None and c["f"] and c["ft"] in (None, "normal"):
                    self.f = c
    
        def chars(self, data):
            self.text.append(data)
    
        def run(self, stream):
            p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
            p.StartElementHandler = self.start
            p.EndElementHandler = self.end
            p.CharacterDataHandler = self.chars
            p.buffer_text = True
            p.ParseFile(stream)
            self.flush(None)
            return self
    
    
    def read(z, name, sheet=False):
        with z.open(name) as stream:
            return Reader(sheet).run(stream)
    
    
    def delta(items):
        el, at = {}, {}
        for kind, e, a, _ in items:
            if kind == "e":
                el[e] = el.get(e, 0) + 1
            elif kind == "a":
                at[e + "@" + a] = at.get(e + "@" + a, 0) + 1
        return el, at
    
    
    def one_sided(xs, ys):
        left = list(xs)
        extra = 0
        for y in ys:
            if y in left:
                left.remove(y)
            else:
                extra += 1
        return len(left), extra
    
    
    def block(name, rd, x, y):
        """The tool's rows for one compared entry, from the input's read and the
        values the edit removes (x) and writes (y)."""
        ex, ax = delta(x)
        ey, ay = delta(y)
        rows = [(name, "parse", "ok", "ok", "", "0", "0")]
        for kind, bx, by, whole in (("element", ex, ey, rd.elements), ("attribute", ax, ay, rd.attributes)):
            for key in sorted(set(bx) | set(by), key=lambda s: s.encode("utf-8")):
                move = by.get(key, 0) - bx.get(key, 0)
                if move:
                    n = whole.get(key, 0)
                    rows.append((name, kind, key, str(n), str(n + move)))
        x = [i for i in x if i[0] != "e"]
        y = [i for i in y if i[0] != "e"]
        in_only, out_only = one_sided(x, y)
        rows.append((name, "values", str(rd.values), str(rd.values - len(x) + len(y)),
                     str(in_only), str(out_only)))
        return rows
    
    
    def derive(path):
        """(facts, blocks): blocks is [(entry name, role, rows)] in the input's
        entry order; facts the pick's flags."""
        z = zipfile.ZipFile(path)
        names = z.namelist()
        office = [t for (a, t) in relationships(z, names, "") if a.get("Type", "").endswith("/officeDocument")]
        if len(office) != 1 or office[0] not in names:
            raise Uncovered("no_workbook")
        wb = office[0]
        wb_rels = relationships(z, names, wb)
        by_id = {a.get("Id"): (a.get("Type", ""), t) for (a, t) in wb_rels}
        order = []
    
        def start(tag, attrs):
            uri, _, local = tag.rpartition(" ")
            if uri in MAIN and local == "sheet":
                for ns in ATTR:
                    if ns + " id" in attrs:
                        order.append(attrs[ns + " id"])
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.Parse(z.read(wb), True)
        sheet = None
        for rid in order:
            ty, t = by_id.get(rid, ("", None))
            if ty.endswith("/worksheet") and t in names:
                sheet = t
                break
        if sheet is None:
            raise Uncovered("no_worksheet")
        chains = [(a, t) for (a, t) in wb_rels if a.get("Type", "").endswith("/calcChain")]
        sr = read(z, sheet, sheet=True)
        facts = {"a": int(sr.a is not None), "f": int(sr.f is not None), "row_new": 0,
                 "chain": int(bool(chains))}
        if sr.a is None:
            return facts, []
        a, f = sr.a, sr.f
        if not a["has_r"] or (f is not None and not f["has_r"]):
            raise Uncovered("a_or_f_without_r")
        if sr.ns is None:
            raise Uncovered("no_sheetData")
        c_el, v_el, f_el, row_el = ("{%s}%s" % (sr.ns, n) for n in ("c", "v", "f", "row"))
        x = list(a["items"])
        y = [("e", c_el, "", ""), ("a", c_el, "{}r", a["r"])]
        if a["s"] is not None:
            y.append(("a", c_el, "{}s", a["s"]))
        y += [("e", v_el, "", ""), ("t", v_el, "", "21")]
        if f is not None:
            x += f["items"]
            y += [("e", c_el, "", ""), ("a", c_el, "{}r", f["r"])]
            if f["s"] is not None:
                y.append(("a", c_el, "{}s", f["s"]))
            y += [("e", f_el, "", ""), ("t", f_el, "", "2+3")]
        m = sr.top
        for col, text in ((1, a["r"] + "*2"), (2, "1+1")):
            y += [("e", c_el, "", ""), ("a", c_el, "{}r", a1(m + 1, col)),
                  ("e", f_el, "", ""), ("t", f_el, "", text)]
        if (m + 1) not in sr.rows:
            facts["row_new"] = 1
            y += [("e", row_el, "", ""), ("a", row_el, "{}r", str(m + 1))]
        blocks = {sheet: ("sheet", block(sheet, sr, x, y))}
    
        wr = Reader(False)
        calc = []
    
        def wstart(tag, attrs):
            wr.start(tag, attrs)
            uri, _, local = tag.rpartition(" ")
            if uri in MAIN and local == "calcPr" and len(wr.stack) == 2:
                calc.append((tag, dict(attrs)))
        p = xml.parsers.expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = wstart
        p.EndElementHandler = wr.end
        p.CharacterDataHandler = wr.chars
        p.buffer_text = True
        p.Parse(z.read(wb), True)
        wr.flush(None)
        if len(calc) != 1 or "fullCalcOnLoad" in calc[0][1]:
            raise Uncovered("calcPr_not_one_unflagged")
        cel = resolved(calc[0][0])
        blocks[wb] = ("workbook", block(wb, wr, [], [("a", cel, "{}fullCalcOnLoad", "1")]))
    
        if chains:
            if len(chains) != 1:
                raise Uncovered("chains_not_one")
            crel, cpart = chains[0]
            rels = rels_name(wb)
            rr = read(z, rels)
            el = "{%s}Relationship" % RELS
            lost = [("e", el, "", "")] + [("a", el, resolved(k), v) for k, v in crel.items()]
            blocks[rels] = ("rels", block(rels, rr, lost, []))
            tr = read(z, "[Content_Types].xml")
            hits = [o for o in tr.override if o.get("PartName") == "/" + cpart]
            if len(hits) != 1:
                raise Uncovered("chain_override_not_one")
            el = "{%s}Override" % TYPES
            lost = [("e", el, "", "")] + [("a", el, resolved(k), v) for k, v in hits[0].items()]
            blocks["[Content_Types].xml"] = ("types", block("[Content_Types].xml", tr, lost, []))
        for n in blocks:
            if not re.fullmatch(r"[\x21-\x5b\x5d-\x7e]+", n):
                raise Uncovered("entry_name_needs_escaping")
        return facts, [(n, blocks[n][0], blocks[n][1]) for n in names if n in blocks]
    
    
    def tool_rows(diff):
        rows, archive = [], {}
        with open(diff, encoding="utf-8", newline="\n") as handle:
            for line in handle.read().split("\n"):
                cells = line.split("\t")
                if cells[0] == "xml":
                    rows.append(tuple(cells[1:]))
                elif cells[0] == "archive" and len(cells) == 3 and cells[1] in ARCHIVE:
                    archive.setdefault(cells[1], []).append(cells[2])
        return rows, archive
    
    
    def by_entry(rows):
        out, order = {}, []
        for r in rows:
            if r[0] not in out:
                order.append(r[0])
                out[r[0]] = []
            out[r[0]].append(r)
        return out, order
    
    
    def tally(rows):
        got, _ = by_entry(rows)
        t = dict.fromkeys(ARCHIVE, 0)
        for rs in got.values():
            t["xml_compared"] += 1
            parsed = rs[0][1] == "parse" and rs[0][2:4] == ("ok", "ok")
            if not parsed:
                t["xml_parse_errors"] += 1
            vals = [r for r in rs if r[1] == "values"]
            if parsed and vals and not any(r[1] in ("element", "attribute") for r in rs):
                t["xml_names_equal"] += 1
            if vals and vals[0][4:6] == ("0", "0"):
                t["xml_values_equal"] += 1
        return t
    
    
    def plant(rows, archive, flag, roles):
        """Changes the tool's rows in memory; returns applied."""
        def find(pred):
            for i, r in enumerate(rows):
                if pred(r):
                    return i
            return None
        sheet = roles.get("sheet")
        if flag == "entries_ok":
            rows += [("planted.xml", "parse", "ok", "ok", "", "0", "0"), ("planted.xml", "values", "1", "1", "0", "0")]
            return True
        if flag == "parse_ok" and rows:
            i = find(lambda r: r[1] == "parse")
            rows[i] = rows[i][:5] + ("1",) + rows[i][6:]
            return True
        if flag == "sheet_shape_ok" and sheet:
            i = find(lambda r: r[0] == sheet and r[1] == "element" and r[2].endswith("}c"))
            if i is None:
                return False
            rows[i] = rows[i][:4] + (str(int(rows[i][4]) + 1),)
            return True
        if flag == "sheet_elements_ok" and sheet:
            i = find(lambda r: r[0] == sheet and r[1] == "element" and r[2].endswith("}c"))
            if i is None:
                return False
            rows[i] = rows[i][:3] + (str(int(rows[i][3]) + 1), str(int(rows[i][4]) + 1))
            return True
        if flag == "sheet_attributes_ok" and sheet:
            i = find(lambda r: r[0] == sheet and r[1] == "attribute" and r[2].endswith("}c@{}r"))
            if i is None:
                return False
            del rows[i]
            return True
        if flag == "sheet_values_ok" and sheet:
            i = find(lambda r: r[0] == sheet and r[1] == "values")
            rows[i] = rows[i][:5] + (str(int(rows[i][5]) + 1),)
            return True
        if flag == "wb_ok" and roles.get("workbook"):
            i = find(lambda r: r[0] == roles["workbook"] and r[1] == "attribute")
            if i is None:
                return False
            rows[i] = rows[i][:4] + ("2",)
            return True
        if flag in ("types_ok", "rels_ok") and roles.get(flag[:-3]):
            i = find(lambda r: r[0] == roles[flag[:-3]] and r[1] == "values")
            rows[i] = rows[i][:4] + (str(int(rows[i][4]) + 1),) + rows[i][5:]
            return True
        if flag == "archive_ok":
            archive["xml_compared"] = [str(int(archive.get("xml_compared", ["0"])[0]) + 1)]
            return True
        if flag == "archive_agree":
            archive["xml_values_equal"] = [str(int(archive.get("xml_values_equal", ["0"])[0]) + 1)]
            return True
        return False
    
    
    def main_local(name):
        """The local name of a resolved name in a main namespace, else the name."""
        uri, _, local = name[1:].partition("}")
        return local if name.startswith("{") and uri in MAIN else name
    
    
    def yn(b):
        return "yes" if b else "no"
    
    
    def evaluate(facts, blocks, rows, archive, planted):
        """The check line for the tool's rows against the derived blocks."""
        derivation = "ok"
        roles = {role: name for (name, role, _) in blocks}
        got, order = by_entry(rows)
        want = {name: rs for (name, _, rs) in blocks}
        entries_ok = order == [name for (name, _, _) in blocks]
        parse_ok = all(r[2:] == ("ok", "ok", "", "0", "0") for r in rows if r[1] == "parse")
    
        def part(name, kinds):
            return ([r for r in got.get(name, []) if r[1] in kinds],
                    [r for r in want.get(name, []) if r[1] in kinds])
        sheet = roles.get("sheet")
        if sheet:
            g, w = part(sheet, ("element",))
            sheet_elements_ok = g == w
            moves = {main_local(r[2]): int(r[4]) - int(r[3]) for r in g}
            shape = {"c": 2, "f": 2}
            if facts["row_new"]:
                shape["row"] = 1
            if facts["f"]:
                shape["v"] = -1
            sheet_shape_ok = moves == shape and len(g) == len(shape)
            g, w = part(sheet, ("attribute",))
            sheet_attributes_ok = g == w
            g, w = part(sheet, ("values",))
            sheet_values_ok = g == w
        else:
            sheet_shape_ok = sheet_elements_ok = sheet_attributes_ok = sheet_values_ok = True
        wbn = roles.get("workbook")
        if wbn:
            g = got.get(wbn, [])
            body = [r for r in g if r[1] != "parse"]
            wb_ok = (g == want[wbn] and len(body) == 2 and body[0][1] == "attribute"
                     and body[0][2].endswith("}calcPr@{}fullCalcOnLoad")
                     and body[0][2].partition("}")[0][1:] in MAIN
                     and body[0][3:] == ("0", "1") and body[1][1] == "values" and body[1][4:] == ("0", "1"))
        else:
            wb_ok = True
        lost_counts = {}
        for role, local in (("types", "Override"), ("rels", "Relationship")):
            name = roles.get(role)
            if not name:
                lost_counts[role] = True
                continue
            g = got.get(name, [])
            els = [r for r in g if r[1] == "element"]
            ats = [r for r in g if r[1] == "attribute"]
            vals = [r for r in g if r[1] == "values"]
            lost_counts[role] = (g == want[name] and len(els) == 1 and els[0][2].endswith("}" + local)
                                 and int(els[0][4]) - int(els[0][3]) == -1
                                 and all(int(r[4]) - int(r[3]) == -1 for r in ats)
                                 and len(vals) == 1 and vals[0][4:] == (str(len(ats)), "0"))
        expect_archive = tally([r for (_, _, rs) in blocks for r in rs])
        once = all(len(archive.get(k, [])) == 1 for k in ARCHIVE)
        archive_ok = once and all(archive[k][0] == str(expect_archive[k]) for k in ARCHIVE)
        own = tally(rows)
        archive_agree = once and all(archive[k][0] == str(own[k]) for k in ARCHIVE)
        nrows = sum(len(rs) for (_, _, rs) in blocks)
        return ("found=1 planted=%s a=%d f=%d row_new=%d chain=%d blocks=%d rows=%d tool_rows=%d "
              "entries_ok=%s parse_ok=%s sheet_shape_ok=%s sheet_elements_ok=%s sheet_attributes_ok=%s "
              "sheet_values_ok=%s wb_ok=%s types_ok=%s rels_ok=%s archive_ok=%s archive_agree=%s derivation=%s" % (
                  planted, facts["a"], facts["f"], facts["row_new"], facts["chain"], len(blocks), nrows,
                  len(rows), yn(entries_ok), yn(parse_ok), yn(sheet_shape_ok), yn(sheet_elements_ok),
                  yn(sheet_attributes_ok), yn(sheet_values_ok), yn(wb_ok), yn(lost_counts["types"]),
                  yn(lost_counts["rels"]), yn(archive_ok), yn(archive_agree), derivation))
    
    
    def main_check(path, diff, flags):
        """The unplanted line, then with flags one line per plant, each on a
        fresh copy of the tool's rows; the derivation is made once."""
        try:
            facts, blocks = derive(path)
        except Uncovered as err:
            print("found=1 derivation=%s" % err)
            return
        rows, archive = tool_rows(diff)
        roles = {role: name for (name, role, _) in blocks}
        print(evaluate(facts, blocks, list(rows), dict(archive), "na"))
        for flag in flags:
            r, a = list(rows), {k: list(v) for k, v in archive.items()}
            applied = plant(r, a, flag, roles)
            print("plant %s: %s" % (flag, evaluate(facts, blocks, r, a, yn(applied))))
    
    
    def main_expect(path, out):
        facts, blocks = derive(path)
        with open(out, "w", encoding="utf-8", newline="\n") as handle:
            for (_, _, rs) in blocks:
                for r in rs:
                    handle.write("xml\t" + "\t".join(r) + "\n")
    
    
    if __name__ == "__main__":
        if sys.argv[1] == "expect":
            main_expect(sys.argv[2], sys.argv[3])
        elif sys.argv[1] == "check":
            main_check(sys.argv[2], sys.argv[3], PLANTS if "--plants" in sys.argv else ())
        else:
            sys.exit(__doc__)

