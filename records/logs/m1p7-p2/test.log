    tests_attr "$CODE1" tools/xlsx-diff/tests/p7.rs >"$T/p7-at-c1"
    comm -13 "$T/p7-at-rec" "$T/p7-at-c1" >"$T/p7-new-fns"
    comm -23 "$T/p7-at-rec" "$T/p7-at-c1" >"$T/p7-gone-fns"
    echo "  #[test] functions tests/p7.rs gained in the first code commit: $(count_lines "$T/p7-new-fns"); lost: $(count_lines "$T/p7-gone-fns")"
    sed 's/^/    gained: /' "$T/p7-new-fns"
    gained_as_ruled() {
