      check "$target: passed is more than 0 and equals the ok test lines" "$(yn passed_matches)"
      n=$(count_bytes "$CTRL_CLASS" "$T/$target.out")
      check "$target: control bytes in the cargo output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
      echo "$passed" >"$T/$target.count"
    done
    
    echo
    echo "## the tests per binary, which planning asked this log for"
    # For each Running or Doc-tests line, the binary it names and how many of its
    # tests passed, taken from the test result line that closes its block. The
    # binary's hash suffix is stripped, so the same table can be compared with
    # another run's: a suffix changes whenever the crate is rebuilt and carries no
    # information about the tests.
    per_binary() {
      awk '
        /^ *Running / {
          # The label comes from the compiled binary in parentheses, with its hash
          # suffix removed, because that names the CRATE; the words before it are
          # only "unittests src/lib.rs" or the tests/ file, which repeat across
          # crates. unittests and integration tests are distinguished, so a
          # library and an integration binary of the same crate stay apart.
          path = $NF
          gsub(/[()]/, "", path)
          parts = split(path, piece, "/")
          label = piece[parts]
          sub(/-[0-9a-f]+$/, "", label)
          current = (($2 == "unittests") ? "unittests " : "integration ") label
          next
        }
        /^ *Doc-tests / { current = "doc-tests " $2; next }
        /^test result: / {
          if (current == "") next
          for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n = $i
          printf "%s %d\n", current, n
          current = ""
        }
      ' "$1" | sort
    }
    for target in host i686-unknown-linux-musl; do
      per_binary "$T/$target.out" >"$T/$target.per"
    done
    sed 's/^/    /' "$T/host.per"
    sum_per=$(awk '{ n += $NF } END { print n + 0 }' "$T/host.per")
    echo "  the per-binary counts sum to $sum_per; the run's own passed total was $(cat "$T/host.count")"
    check "the per-binary counts sum to the run's passed total" \
      "$(yn [ "$sum_per" = "$(cat "$T/host.count")" ])"
    check "the two targets produce the same per-binary breakdown" \
      "$(yn cmp -s "$T/host.per" "$T/i686-unknown-linux-musl.per")"
    # The control for the extraction, in the same command form: a stream with no
    # Running line yields no rows, so a silent awk failure cannot read as "no
    # tests" indistinguishably from a correct empty answer.
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n' >"$T/c-per"
    per_binary "$T/c-per" >"$T/c-per.out"
    nctl_per=$(count_lines "$T/c-per.out")
    echo "  control: a result line with no Running line above it yields $nctl_per rows"
    check "control: the per-binary form attributes nothing to a binary it never saw named" \
      "$(yn [ "$nctl_per" = 0 ])"
    # A positive control for the same form, so the 0 above cannot be a form that
    # never counts anything: a Running line and its result must yield one row.
    printf '     Running unittests src/lib.rs (target/debug/deps/libctl-0123456789abcdef)\ntest result: ok. 7 passed; 0 failed; 0 ignored\n' >"$T/c-per-hit"
    per_binary "$T/c-per-hit" >"$T/c-per-hit.out"
    sed 's/^/    control row: /' "$T/c-per-hit.out"
    check "control: a Running line and its result yield one row naming the crate and its count" \
      "$(yn [ "$(cat "$T/c-per-hit.out")" = "unittests libctl 7" ])"
    # The library's figure and the workspace total beside the previous phase's,
    # read from that phase's committed log rather than typed.
    LIB_NOW=$(awk '$1 == "unittests" && $2 == "emend" { n += $3 } END { print n + 0 }' "$T/host.per")
    PREV_LOG=records/logs/m1p7-p1/test.log
    PREV_TOTAL=$(sed -n 's/^host executed \([0-9]*\) tests;.*/\1/p' "$PREV_LOG")
    NOW_TOTAL=$(cat "$T/host.count")
    echo "  the library's own tests in this run: $LIB_NOW"
    echo "  the workspace total: this phase $NOW_TOTAL, the previous phase $PREV_TOTAL (read from $PREV_LOG)"
    check "the previous phase's total was read from its committed log" "$(yn [ -n "$PREV_TOTAL" ])"
    awk '
      /^## cargo test --workspace \(host\)$/ { inblock = 1; next }
      /^## / { inblock = 0 }
      inblock && /^    test .* \.\.\. ok$/ { sub(/^    test /, ""); sub(/ \.\.\. ok$/, ""); print }
    ' "$PREV_LOG" | sort >"$T/prev.names"
    nprev_names=$(count_lines "$T/prev.names")
    echo "  test names the previous log's host run printed: $nprev_names"
    check "the previous log's names account for its whole host total" "$(yn [ "$nprev_names" = "$PREV_TOTAL" ])"
    comm -13 "$T/prev.names" "$T/host.names" >"$T/added.names"
    comm -23 "$T/prev.names" "$T/host.names" >"$T/removed.names"
    nadded=$(count_lines "$T/added.names")
    nremoved=$(count_lines "$T/removed.names")
    echo "  test names added since the previous phase: $nadded; removed: $nremoved"
    sed 's/^/    added: /' "$T/added.names"
    sed 's/^/    removed: /' "$T/removed.names"
    total_moved_by_names() {
      [ -n "$PREV_TOTAL" ] && [ "$NOW_TOTAL" -eq "$((PREV_TOTAL + nadded - nremoved))" ]
    }
    check "this phase's workspace total is the previous phase's plus the names added less the names removed" \
      "$(yn total_moved_by_names)"
    # The control for the comparison, through the same command form: the previous
    # names against themselves add and remove nothing, and a list with one name
    # more adds exactly that one.
    comm -3 "$T/prev.names" "$T/prev.names" >"$T/c-names"
    check "control: the same comparison of a list with itself finds no difference" \
      "$(yn [ "$(count_lines "$T/c-names")" = 0 ])"
    { cat "$T/prev.names"; echo "zzz::control::name"; } | sort >"$T/c-names-plus"
    check "control: a list with one name more is found to add exactly one" \
      "$(yn [ "$(comm -13 "$T/prev.names" "$T/c-names-plus" | wc -l)" = 1 ])"
    
    echo
    echo "## the tests this phase adds and removes, derived from the source (header change 6)"
    # The base is resolved from git as gate.log resolves it: the parent of the
    # first doc commit, found by its subject.
    BASE_DOC=$(git log --format='%H' -n 1 --grep='^M1 part 7 P2: commit planning docs [(]the P1 verification and rulings')
    BASE=$(git rev-parse --verify "$BASE_DOC^" 2>/dev/null)
    echo "command: git log --format=%H -n 1 --grep=<the doc commit's subject>, and its parent"
    echo "  the doc commit: $BASE_DOC; the phase base: $BASE"
    check "the phase base is the P1 record commit" "$(yn [ "$BASE" = "$REC" ])"
    check "the phase base resolved from git" "$(yn [ -n "$BASE" ])"
    # #[test] functions of one file at one commit: the name of the first fn line
    # after a #[test] line, other attribute lines between them allowed.
    tests_attr() { git show "$1:$2" 2>/dev/null | tests_in; }
    tests_in() {
      awk '
        /^[ \t]*#\[test\][ \t]*$/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]/ {
          sub(/^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next
        }
        t { t = 0 }' | sort
    }
    git diff --name-only "$BASE" "$C" -- '*.rs' >"$T/changed-rs"
    echo "  the .rs files the phase changed:"
    sed 's/^/    /' "$T/changed-rs"
    : >"$T/src-added"
    : >"$T/src-removed"
    while IFS= read -r f; do
      tests_attr "$C" "$f" >"$T/at-c"
      tests_attr "$BASE" "$f" >"$T/at-base"
      comm -13 "$T/at-base" "$T/at-c" | sed "s#^#$f #" >>"$T/src-added"
      comm -23 "$T/at-base" "$T/at-c" | sed "s#^#$f #" >>"$T/src-removed"
    done <"$T/changed-rs"
    echo "  #[test] functions at the phase commit and not at the base, by file:"
    sed 's/^/    /' "$T/src-added"
    echo "  #[test] functions at the base and not at the phase commit, by file:"
    sed 's/^/    /' "$T/src-removed"
    nsrc_added=$(count_lines "$T/src-added")
    nsrc_removed=$(count_lines "$T/src-removed")
    # P1 adds tests (p7.rs and the pinned-hash unit test in xml.rs) and removes
    # none; the added set is derived here, compared with the run below, and each
    # added name must pass on both targets.
    check "the source adds tests in this phase ($nsrc_added)" "$(yn [ "$nsrc_added" -ge 1 ])"
    check "the source removes no test in this phase ($nsrc_removed)" "$(yn [ "$nsrc_removed" = 0 ])"
    n_p1_tests=$(tests_attr "$C" tools/xlsx-diff/tests/p1.rs | count_lines /dev/stdin)
    check "control: the same form finds the #[test] functions of an unchanged file, tests/p1.rs, at the phase commit ($n_p1_tests)" "$(yn [ "$n_p1_tests" -ge 1 ])"
    # The run's added and removed names, module prefix dropped, against the
    # source's: each set exactly the other.
    awk '{ print $2 }' "$T/src-added" | sort >"$T/src-added.names"
    awk '{ print $2 }' "$T/src-removed" | sort >"$T/src-removed.names"
    sed 's/^.*:://' "$T/added.names" | sort >"$T/run-added.names"
    sed 's/^.*:://' "$T/removed.names" | sort >"$T/run-removed.names"
    check "the names the run added are exactly the tests the source added" \
      "$(yn cmp -s "$T/run-added.names" "$T/src-added.names")"
    check "the names the run lost are exactly the tests the source removed" \
      "$(yn cmp -s "$T/run-removed.names" "$T/src-removed.names")"
    # Every added test passed, by name, on each target.
    passed_on() { count_matches -E "(^|::)$1\$" "$T/$2.names"; }
    both_passed() {
      [ "$(passed_on "$1" host)" = 1 ] && [ "$(passed_on "$1" i686-unknown-linux-musl)" = 1 ]
    }
    echo "  each added test, and whether it ran and passed on each target:"
    while read -r f name; do
      echo "    $name ($f): host $(passed_on "$name" host), i686-unknown-linux-musl $(passed_on "$name" i686-unknown-linux-musl)"
      check "  $name passed on both targets" "$(yn both_passed "$name")"
    done <"$T/src-added"
    # Controls in the same forms: a name no run holds is not found, a fixture file
    # with one #[test] behind another attribute yields its name, and a file absent
    # at a commit yields none.
    not_passed_ctl() { if both_passed zzz_no_such_test_anywhere; then return 1; else return 0; fi; }
    check "control: both_passed refuses a name no run holds" "$(yn not_passed_ctl)"
    printf '#[test]\n#[should_panic]\nfn ctl_one() {}\nfn not_a_test() {}\n#[test]\nfn ctl_two() -> Result<(), ()> { Ok(()) }\n' >"$T/c-src"
    tests_in <"$T/c-src" >"$T/c-src.names"
    sed 's/^/    control name: /' "$T/c-src.names"
    check "control: tests_in reads a #[test] behind another attribute and skips a plain fn" \
      "$(yn [ "$(tr '\n' ' ' <"$T/c-src.names")" = "ctl_one ctl_two " ])"
    check "control: tests_attr yields no name for a path absent at the base" \
      "$(yn [ "$(tests_attr "$BASE" tools/xlsx-diff/tests/no-such-file.rs | count_lines /dev/stdin)" = 0 ])"
    
    echo
    echo "## the ignored tests, derived from the source"
    # The functions under an #[ignore] attribute, at the base and at the phase
    # commit, across every tracked .rs file; each run's ignored tests must be
    # exactly that set, so no test this phase touched is ignored.
    ignored_in() {
      awk '
        /^[ \t]*#\[ignore/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?fn[ \t]/ { sub(/^[ \t]*(pub[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next }
        t { t = 0 }'
    }
    ignored_at() {
      git ls-tree -r --name-only "$1" | LC_ALL=C "$G" -E '[.]rs$' | while IFS= read -r f; do
        git show "$1:$f" | ignored_in
      done | sort
    }
    ignored_at "$BASE" >"$T/ign-base"
    ignored_at "$C" >"$T/ign-c"
    sed 's/^/    ignored in the source at the base: /' "$T/ign-base"
    sed 's/^/    ignored in the source at the phase commit: /' "$T/ign-c"
    check "the phase commit ignores exactly the tests the base ignored" "$(yn cmp -s "$T/ign-base" "$T/ign-c")"
    for target in host i686-unknown-linux-musl; do
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" | sed 's/^/    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" |
        sed -E 's/^test ([^ ]*) \.\.\. ignored.*/\1/; s/^.*:://' | sort >"$T/ign-run-$target"
      check "$target: the run's ignored tests are exactly the source's ($(count_lines "$T/ign-run-$target"))" \
        "$(yn cmp -s "$T/ign-run-$target" "$T/ign-c")"
    done
    # Controls in the same forms: a fixture with one ignored fn behind a second
    # attribute yields that name alone, and the run comparison refuses a set one
    # name longer.
    printf '#[test]\n#[ignore = "why"]\n#[cfg(unix)]\nfn ctl_ignored() {}\n#[test]\nfn ctl_run() {}\n' | ignored_in >"$T/c-ign"
    check "control: ignored_in reads the one ignored fixture test ($(tr '\n' ' ' <"$T/c-ign"))" \
      "$(yn [ "$(cat "$T/c-ign")" = ctl_ignored ])"
    { cat "$T/ign-c"; echo zzz_control; } | sort >"$T/c-ign-plus"
    check "control: the same comparison refuses a set one name longer" \
      "$(yn [ "$(comm -3 "$T/c-ign-plus" "$T/ign-c" | count_lines /dev/stdin)" = 1 ])"
    
    echo
    echo "## xlsx-diff's p7 tests and its unit tests, by name, on both targets (header change 4)"
    # Each name is taken from its binary's OWN section of the cargo output: the
    # integration tests carry no module prefix, so a prefix filter cannot tell a
    # p7 test from another binary's.
    section_names() {
      awk -v want="$2" '
        /^ *Running / { inblock = (index($0, want) > 0); next }
        /^ *Doc-tests / { inblock = 0; next }
        inblock && /^test result: / { inblock = 0 }
        inblock && /^test .* \.\.\. ok$/ { sub(/^test /, ""); sub(/ \.\.\. ok$/, ""); print }
      ' "$1" | sort
    }
    for target in host i686-unknown-linux-musl; do
      section_names "$T/$target.out" "Running tests/p7.rs" >"$T/$target.p7"
      # xlsx-diff's library unit tests: the "unittests src/lib.rs" section whose
      # binary is xlsx_diff.
      awk '
        /^ *Running / { inblock = ($0 ~ /unittests src\/lib\.rs/ && $0 ~ /xlsx_diff-/); next }
        /^ *Doc-tests / { inblock = 0; next }
        inblock && /^test result: / { inblock = 0 }
        inblock && /^test .* \.\.\. ok$/ { sub(/^test /, ""); sub(/ \.\.\. ok$/, ""); print }
      ' "$T/$target.out" | sort >"$T/$target.xdunit"
    done
    echo "  p7 tests that passed on the host:"
    sed 's/^/    /' "$T/host.p7"
    echo "  xlsx-diff unit tests that passed on the host:"
    sed 's/^/    /' "$T/host.xdunit"
    np7=$(count_lines "$T/host.p7")
    np7_i686=$(count_lines "$T/i686-unknown-linux-musl.p7")
    np7_src=$(tests_attr "$C" tools/xlsx-diff/tests/p7.rs | count_lines /dev/stdin)
    echo "  p7 tests passed: host $np7, i686-unknown-linux-musl $np7_i686; #[test] functions in tests/p7.rs at the phase commit: $np7_src"
    check "every #[test] of tests/p7.rs passed on the host" "$(yn [ "$np7" = "$np7_src" ])"
    check "the p7 tests are the same names on both targets" "$(yn cmp -s "$T/host.p7" "$T/i686-unknown-linux-musl.p7")"
    tests_attr "$C" tools/xlsx-diff/tests/p7.rs >"$T/p7.src"
    check "the p7 names that passed are exactly the source's #[test] functions" "$(yn cmp -s "$T/host.p7" "$T/p7.src")"
    pin_on() { count_matches -Fx 'xml::tests::value_hash_is_pinned' "$T/$1.xdunit"; }
    echo "  xml::tests::value_hash_is_pinned passed: host $(pin_on host), i686-unknown-linux-musl $(pin_on i686-unknown-linux-musl)"
    pin_both() { [ "$(pin_on host)" = 1 ] && [ "$(pin_on i686-unknown-linux-musl)" = 1 ]; }
    check "the pinned-hash unit test passed on both targets (P1 ruling 7)" "$(yn pin_both)"
    pin_ctl() { if [ "$(count_matches -Fx 'xml::tests::no_such_test' "$T/host.xdunit")" = 1 ]; then return 1; else return 0; fi; }
    check "control: the same form does not find a name the unit tests lack" "$(yn pin_ctl)"
    check "control: the section form finds no names under a binary that does not exist" \
      "$(yn [ "$(section_names "$T/host.out" "Running tests/no-such-binary.rs" | count_lines /dev/stdin)" = 0 ])"
    
    echo
    echo "## the cases of \"### P1\" and the rulings, each mapped to the test that holds it (header change 4)"
    # A case maps to a #[test] function and a string that function's body must
    # hold; the body is read from the source at the phase commit, from its fn
    # line to its closing brace. The mapping is the reader's
    # to check against the spec: the strings are the fixtures' own labels.
    git show "$C:tools/xlsx-diff/tests/p7.rs" >"$T/p7.rs"
    git show "$C:tools/xlsx-diff/src/xml.rs" >"$T/xml.rs"
    fn_body() {
      awk -v fn="$2" '
        $0 ~ "^(pub )?fn " fn "[(<]" { on = 1 }
        on { print }
        on && /^}$/ { on = 0 }
      ' "$1"
    }
    unit_body() {
      awk -v fn="$2" '
        $0 ~ "^    fn " fn "[(<]" { on = 1 }
        on { print }
        on && /^    }$/ { on = 0 }
      ' "$1"
    }
    : >"$T/casemap"
    case_holds() {
      local file=$1 fn=$2 needle=$3
      if [ "$file" = unit ]; then unit_body "$T/xml.rs" "$fn" >"$T/body"; else fn_body "$T/p7.rs" "$fn" >"$T/body"; fi
      [ "$(count_lines "$T/body")" -ge 2 ] || return 1
      [ "$(count_matches -F "$needle" "$T/body")" -ge 1 ] || return 1
      if [ "$file" = unit ]; then
        [ "$(count_matches -Fx "xml::tests::$fn" "$T/host.xdunit")" = 1 ]
      elif [ "$file" = helper ]; then
        [ "$(count_matches -Fx "$fn" "$T/host.p7")" = 0 ]
      else
        [ "$(count_matches -Fx "$fn" "$T/host.p7")" = 1 ]
      fi
    }
    while IFS='|' read -r label file fn needle; do
      [ -n "$label" ] || continue
      echo "  $label -> $fn, holding: $needle"
      check "  case held and passed: $label" "$(yn case_holds "$file" "$fn" "$needle")"
    done <<'CASES'
    P1: an entry equal after recompression, no xml row|p7|an_entry_equal_after_recompression_has_no_xml_row|recompressed
    P1: one element added|p7|elements_and_attributes_added_removed_and_changed|"one element added"
    P1: one element removed|p7|elements_and_attributes_added_removed_and_changed|"one element removed"
    P1: one attribute added|p7|elements_and_attributes_added_removed_and_changed|"one attribute added"
    P1: one attribute's value changed (names equal, values 1 and 1), the fixture|p7|elements_and_attributes_added_removed_and_changed|"one attribute's value changed"
    P1: one attribute's value changed (names equal, values 1 and 1), its expected rows|p7|elements_and_attributes_added_removed_and_changed|equal_names("a.xml", ["2", "2", "1", "1"])
    P1 verification ruling 7: all four at once, its own case|p7|elements_and_attributes_added_removed_and_changed|"all four at once"
    P1: prefix choice differing with the same namespace|p7|spellings_that_mean_the_same_compare_equal|prefix choice
    P1: attribute order differing|p7|spellings_that_mean_the_same_compare_equal|attribute order
    P1: whitespace-only text, a comment and a processing instruction added|p7|spellings_that_mean_the_same_compare_equal|whitespace-only text, a comment and a processing instruction added
    P1: an entity on one side and a literal on the other|p7|spellings_that_mean_the_same_compare_equal|an entity against a literal
    P1: a CDATA section against escaped text|p7|spellings_that_mean_the_same_compare_equal|a CDATA section against escaped text
    P1 and ruling 6: a raw CR against &#13; differs|p7|a_raw_cr_against_a_cr_reference_differs|&#13;
    P1: an unbound name against a bound one, an element row for each|p7|an_unbound_name_against_a_bound_one|{}b
    P1: an unknown prefix on one side, parse error and offset, no values row|p7|parse_errors_end_the_entry_at_its_parse_row|unknown prefix on the output
    P1: malformed XML on the output side, the entry row unchanged|p7|parse_errors_end_the_entry_at_its_parse_row|the entry row is unchanged
    P1: an entity the tool does not know, hashed raw and counted|p7|a_reference_the_tool_does_not_know_is_hashed_raw|&fictional;
    P1: a .vml and a .rels name compared, a .bin name not|p7|which_names_are_compared|c.bin
    P1: a .XML upper-case name compared|p7|which_names_are_compared|D.XML
    P1: a dropped and an added XML entry, no xml row|p7|dropped_and_added_xml_entries_have_no_xml_row|dropped.xml
    P1: 100000 values on each side differing in one|p7|one_hundred_thousand_values_differing_in_one|"100000"
    P1: the no-leak test|p7|no_value_in_any_output|sentinels()
    P1: archive rows, two compared entries, one with a parse error|p7|archive_rows_with_two_compared_entries_one_failing|"2", "1", "1", "0"
    P1: exit status 1 never 2 (every pair through one())|helper|one|assert_eq!(result.status, 1
    P1: exit 2 for a genuinely unreadable archive|p7|an_unreadable_archive_is_still_exit_2|result.status, 2
    Ruling 2: both sides failing, the input's offset|p7|parse_errors_end_the_entry_at_its_parse_row|both sides, the input's offset
    Ruling 2: raw values counted up to the failure|p7|parse_errors_end_the_entry_at_its_parse_row|raw values counted up to the failure
    Ruling 5: an unclosed element|p7|parse_errors_end_the_entry_at_its_parse_row|an element left open
    Ruling 6: the transparent comment|p7|spellings_that_mean_the_same_compare_equal|a comment inside text is transparent
    Ruling 6: CR LF against LF|p7|spellings_that_mean_the_same_compare_equal|a raw CR LF against a raw LF
    Ruling 7: one hash pinned to a constant|unit|value_hash_is_pinned|PINNED
    Check 1 F1: a CR, a comment and an LF against two LFs, equal|p7|spellings_that_mean_the_same_compare_equal|a CR, a comment, an LF against two LFs
    Check 1 F1: a CR, a comment and an LF against one LF, which differs|p7|a_cr_and_an_lf_either_side_of_markup_are_two_line_ends|"<a>x\r<!--c-->\ny</a>"
    Check 1 F1: a CR ending a CDATA section, then an LF, against two LFs|p7|spellings_that_mean_the_same_compare_equal|a CR ending a CDATA section, then an LF
    Check 1: a byte order mark on one side|p7|spellings_that_mean_the_same_compare_equal|a byte order mark on one side
    Check 1: an xml:space attribute with no declaration, equal|p7|spellings_that_mean_the_same_compare_equal|an xml:space attribute, the xml prefix bound without a declaration
    Check 1: xml:space resolves to the XML namespace|p7|the_xml_prefix_resolves_to_its_namespace|{http://www.w3.org/XML/1998/namespace}space
    Check 1: an added entry's row stands before the first xml row|p7|archive_rows_with_two_compared_entries_one_failing|["d.txt", "added"]
    P1 verification ruling 6: an attribute CR LF against an LF, equal|p7|an_attribute_cr_lf_against_an_lf_compares_equal|equal_names("a.xml", ["1", "1", "0", "0"])
    P1 verification ruling 6: an entry starting with a UTF-16 byte order mark, a parse row with error|p7|a_utf16_entry_is_a_parse_error|&["ok", "error", "0", "0", "0"]
    CASES
    # Controls in the same form: a string the function does not hold, and a
    # function that does not exist, are refused.
    # Ruling 7's pairing, checked as a line pairing: the fixture label and its
    # expected rows stand on consecutive lines of the body (label, then input,
    # then the rows), so the parenthetical's values belong to that fixture.
    paired_1_1() {
      fn_body "$T/p7.rs" elements_and_attributes_added_removed_and_changed |
        awk '/"one attribute.s value changed",/ { l = NR } l && NR == l + 2 && /equal_names[(]"a.xml", [[]"2", "2", "1", "1"[]][)]/ { ok = 1 } END { exit !ok }'
    }
    check "ruling 7: the values-1-and-1 rows are the one attribute's value changed fixture's" "$(yn paired_1_1)"
    paired_ctl() {
      fn_body "$T/p7.rs" elements_and_attributes_added_removed_and_changed |
        awk '/"all four at once",/ { l = NR } l && NR == l + 2 && /equal_names[(]"a.xml", [[]"2", "2", "1", "1"[]][)]/ { ok = 1 } END { exit !ok }'
    }
    paired_ctl_no() { if paired_ctl; then return 1; else return 0; fi; }
    check "control: the same pairing refuses those rows for the all-four fixture" "$(yn paired_ctl_no)"
    case_ctl_needle() { if case_holds p7 which_names_are_compared "zz-no-such-fixture-label"; then return 1; else return 0; fi; }
    case_ctl_fn() { if case_holds p7 no_such_test_function "recompressed"; then return 1; else return 0; fi; }
    check "control: case_holds refuses a string the function does not hold" "$(yn case_ctl_needle)"
    check "control: case_holds refuses a function that does not exist" "$(yn case_ctl_fn)"
    # "one" is a helper, not a test: its row is checked by its body and by its
    # absence from the passed names; every single-entry case calls it.
    ncalls=$(count_matches -F 'let result = one(' "$T/p7.rs")
    echo "  (the exit-1 case maps to the helper one(), not a #[test]; call sites of one( in tests/p7.rs: $ncalls)"
    check "one() is called by the p7 cases" "$(yn [ "$ncalls" -ge 1 ])"
    
    echo
    echo "## the mutation worktree, and ruling 8: which pre-existing tests print xml rows (header change 4)"
    git worktree add --detach "$MUTTREE/tree" "$C" >"$T/worktree.out" 2>&1
    wt=$?
    echo "command: git worktree add --detach <scratch>/mut/tree $C"
    echo "exit: $wt"
    check "the worktree for the mutations was created at the phase commit" "$(yn [ "$wt" -eq 0 ])"
    check "the worktree's HEAD is the phase commit" "$(yn [ "$(git -C "$MUTTREE/tree" rev-parse HEAD)" = "$C" ])"
    cat >"$MUTTREE/mutate.py" <<'PYEOF'
    import sys
    
    XML = "tools/xlsx-diff/src/xml.rs"
    LIB = "tools/xlsx-diff/src/lib.rs"
    
    MUTATIONS = {
        # PROBE (ruling 8, not a mutation): every comparison that prints xml
        # rows appends its test thread's name to the file XML_ROW_PROBE names.
        "PROBE": [(LIB, "    let name = input.entries[i].name().to_vec();\n    let mut a = read_xml(input, i)?;\n",
                   "    if let Some(path) = std::env::var_os(\"XML_ROW_PROBE\") {\n"
                   "        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {\n"
                   "            let _ = f.write_all(format!(\"{}\\n\", std::thread::current().name().unwrap_or(\"main\")).as_bytes());\n"
                   "        }\n"
                   "    }\n"
                   "    let name = input.entries[i].name().to_vec();\n    let mut a = read_xml(input, i)?;\n"),
                  # and every call of run() appends its thread's name to the file
                  # XML_RUN_PROBE names: the control for the passthrough count.
                  (LIB, "    match compare(input, output, stdout) {\n",
                   "    if let Some(path) = std::env::var_os(\"XML_RUN_PROBE\") {\n"
                   "        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {\n"
                   "            let _ = f.write_all(format!(\"{}\\n\", std::thread::current().name().unwrap_or(\"main\")).as_bytes());\n"
                   "        }\n"
                   "    }\n"
                   "    match compare(input, output, stdout) {\n")],
        # M1: whitespace-only text counted as a value.
        "M1": [(XML, "            .bytes()\n            .all(|b| matches!(b, b' ' | b'\\t' | b'\\n' | b'\\r'))\n",
                "            .is_empty()\n")],
        # M2: comments and processing instructions end a text node.
        "M2": [(XML, "            Event::Comment(_) | Event::PI(_) => state.text.markup(),\n",
                "            Event::Comment(_) | Event::PI(_) => state.flush_text(),\n")],
        # M3: no line-end normalisation: a literal CR is kept as a CR.
        "M3": [(XML, "                '\\r' => {\n                    self.content.push('\\n');\n                    self.after_cr = true;\n                }\n", "")],
        # M4: the end of input with an element still open is not an error.
        "M4": [(XML, "                if !state.open.is_empty() {\n                    state.read.error = Some(reader.buffer_position());\n                }\n", "")],
        # M5: xmlns declarations counted as attributes.
        "M5": [(XML, "            if attribute.key.as_namespace_binding().is_some() {\n                continue;\n            }\n", "")],
        # M6: names_equal counts a parse-error entry (ruling 3).
        "M6": [(LIB, "        counts.parse_errors += 1;\n        return Ok(());\n",
                "        counts.parse_errors += 1;\n        counts.names_equal += 1;\n        return Ok(());\n")],
        # M7: the offset column takes the output's when both sides fail (ruling 2).
        "M7": [(LIB, "    let offset = a\n        .error\n        .or(b.error)\n", "    let offset = b\n        .error\n        .or(a.error)\n")],
        # M8: values compared in document order, not as multisets (no sort).
        "M8": [(XML, "    a.sort_unstable();\n    b.sort_unstable();\n", "")],
        # M9: the hash framed with Hash for [u8], a usize length prefix.
        "M9": [(XML, "        hasher.write_u64(part.len() as u64);\n        hasher.write(part);\n",
                "        std::hash::Hash::hash(*part, &mut hasher);\n")],
        # M10: a value reaches a printed column: the attribute value appended to
        # the attribute's name key.
        "M10": [(XML, "            key.extend_from_slice(&attr.written());\n",
                 "            key.extend_from_slice(&attr.written());\n            key.extend_from_slice(attribute.value.as_bytes());\n")],
        # M12: attribute values hashed as written, not through normalized_value.
        "M12": [(XML, "            let value = match attribute.normalized_value(XmlVersion::Implicit1_0) {\n"
                      "                Ok(value) => value.into_owned(),\n"
                      "                Err(_) => {\n"
                      "                    self.read.raw += 1;\n"
                      "                    attribute.value.into_owned()\n"
                      "                }\n"
                      "            };\n",
                 "            let _ = XmlVersion::Implicit1_0;\n"
                 "            let value = attribute.value.into_owned();\n")],
        # M11: Text::markup a no-op, so the CR state crosses comments, PIs and
        # CDATA delimiters again (the fix of part 7 P1's second code commit undone).
        "M11": [(XML, "    fn markup(&mut self) {\n        self.after_cr = false;\n    }\n",
                 "    fn markup(&mut self) {}\n")],
    }
    
    which = sys.argv[1]
    root = sys.argv[2]
    for path, old, new in MUTATIONS[which]:
        full = root + "/" + path
        body = open(full).read()
        found = body.count(old)
        if found != 1:
            print("REFUSED %s: the text to replace in %s occurs %d times, not once" % (which, path, found))
            sys.exit(2)
        body = body.replace(old, new, 1)
        open(full, "w").write(body)
        print("    applied %s to %s: %d bytes -> %d bytes" % (which, path, len(old), len(new)))
    PYEOF
    echo "## the mutation applier this log runs"
    sed 's/^/    /' "$MUTTREE/mutate.py"
    in_tree_test() {
      # $1 label, then the cargo test arguments.
      local label=$1
      shift
      ( cd "$MUTTREE/tree" && CARGO_TARGET_DIR="$MUTTREE/target" cargo test -p xlsx-diff --no-fail-fast "$@" ) >"$T/tree-$label.out" 2>&1 </dev/null
    }
    failed_names() {
      LC_ALL=C "$G" -E '^test .* \.\.\. FAILED$' "$1" | sed -E 's/^test (.*) \.\.\. FAILED$/\1/' | sort -u
    }
    ok_names() {
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$1" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort -u
    }
    echo
    echo "### ruling 8, part 1: the probe over the pre-existing tests p1 to p6, and over p7 as the control"
    ( cd "$MUTTREE/tree" && git checkout -q -- . ) || fail=1
    python3 "$MUTTREE/mutate.py" PROBE "$MUTTREE/tree" >"$T/probe.apply" 2>&1
    prc=$?
    sed 's/^/  /' "$T/probe.apply"
    check "the probe was planted" "$(yn [ "$prc" -eq 0 ])"
    git -C "$MUTTREE/tree" diff | sed 's/^/    /'
    : >"$T/probe-old"
    echo "command: XML_ROW_PROBE=<scratch>/w/probe-old cargo test -p xlsx-diff --no-fail-fast --test p1 --test p2 --test p3 --test p4 --test p5 --test p6 (in the worktree)"
    export XML_ROW_PROBE="$T/probe-old"
    in_tree_test probe-old --test p1 --test p2 --test p3 --test p4 --test p5 --test p6
    orc=$?
    echo "exit: $orc"
    LC_ALL=C "$G" -E '^test result: ' "$T/tree-probe-old.out" | sed 's/^/    /'
    check "the pre-existing tests all pass with the probe planted" "$(yn [ "$orc" -eq 0 ])"
    sort -u "$T/probe-old" >"$T/probe-old.names"
    nold=$(count_lines "$T/probe-old.names")
    echo "  pre-existing tests whose comparison printed xml rows: $nold"
    sed 's/^/    printed xml rows: /' "$T/probe-old.names"
    : >"$T/probe-new"
    export XML_ROW_PROBE="$T/probe-new"
    echo "command: XML_ROW_PROBE=<scratch>/w/probe-new cargo test -p xlsx-diff --no-fail-fast --test p7 (in the worktree)"
    in_tree_test probe-new --test p7
    nrc=$?
    echo "exit: $nrc"
    unset XML_ROW_PROBE
    sort -u "$T/probe-new" >"$T/probe-new.names"
    nnew=$(count_lines "$T/probe-new.names")
    echo "  control: p7 tests whose comparison printed xml rows: $nnew"
    sed 's/^/    printed xml rows: /' "$T/probe-new.names"
    check "control: the probe records p7's comparisons, so the pre-existing count is a measurement ($nnew)" "$(yn [ "$nnew" -ge 1 ])"
    check "ruling 8: no pre-existing test prints xml rows ($nold)" "$(yn [ "$nold" = 0 ])"
    
    echo
    echo "### ruling 8, part 1b: the workspace's other users of xlsx_diff::run (check 1 F8)"
    echo "command: git grep -n 'xlsx_diff::run' <phase commit> -- ':!tools/xlsx-diff' ':!records'"
    git grep -n 'xlsx_diff::run' "$C" -- ':!tools/xlsx-diff' ':!records' | sed "s#^$C:##" >"$T/run-users"
    sed 's/^/    /' "$T/run-users"
    # A caller is a line calling compare( that is not the function's own fn line.
    callers_of_compare() {
      LC_ALL=C "$G" -E '(^|[^_[:alnum:]])compare[(]' "$1" | LC_ALL=C "$G" -v -E 'fn compare[(]' || :
    }
    echo "command: git grep -n -E '(^|[^_[:alnum:]])compare[(]' <phase commit> -- tools/passthrough/tests/*.rs tools/passthrough/tests/*/*.rs, less each fn compare( line, file names kept"
    git grep -n -E '(^|[^_[:alnum:]])compare[(]' "$C" -- 'tools/passthrough/tests/*.rs' 'tools/passthrough/tests/*/*.rs' | sed "s#^$C:##" >"$T/compare-lines"
    sed 's/^/    /' "$T/compare-lines"
    callers_of_compare "$T/compare-lines" | cut -d: -f1 | sort -u >"$T/compare-users"
    printf '%s\n' 'a.rs:1:pub fn compare(input: &Path) -> Outcome {' 'b.rs:2:    let outcome = compare(input, &output);' 'c.rs:3:fn copy_and_compare(dir: &TempDir) {' >"$T/c-compare-lines"
    ctl_callers() { [ "$(callers_of_compare "$T/c-compare-lines" | cut -d: -f1 | tr '\n' ' ')" = "b.rs " ]; }
    check "control: callers_of_compare keeps a call, drops the fn line and a longer name" "$(yn ctl_callers)"
    sed 's/^/    calls common::compare: /' "$T/compare-users"
    users_as_said() {
      [ "$(count_matches -E '^tools/passthrough/tests/common/mod[.]rs:[0-9]+:.*xlsx_diff::run[(]' "$T/run-users")" = 1 ] &&
        [ "$(tr '\n' ' ' <"$T/compare-users")" = "tools/passthrough/tests/copies.rs " ]
    }
    check "outside xlsx-diff, xlsx_diff::run is called by passthrough's common::compare, used by tests/copies.rs alone" "$(yn users_as_said)"
    : >"$T/probe-pt"
    : >"$T/probe-pt-run"
    export XML_ROW_PROBE="$T/probe-pt"
    export XML_RUN_PROBE="$T/probe-pt-run"
    echo "command: XML_ROW_PROBE=<scratch>/w/probe-pt XML_RUN_PROBE=<scratch>/w/probe-pt-run cargo test -p passthrough --no-fail-fast --test copies (in the worktree, the probe planted)"
    ( cd "$MUTTREE/tree" && CARGO_TARGET_DIR="$MUTTREE/target" cargo test -p passthrough --no-fail-fast --test copies ) >"$T/tree-probe-pt.out" 2>&1 </dev/null
    ptrc=$?
    unset XML_ROW_PROBE XML_RUN_PROBE
    echo "exit: $ptrc"
    LC_ALL=C "$G" -E '^test result: ' "$T/tree-probe-pt.out" | sed 's/^/    /'
    check "passthrough's copies tests all pass with the probe planted" "$(yn [ "$ptrc" -eq 0 ])"
    sort -u "$T/probe-pt" >"$T/probe-pt.names"
    sort -u "$T/probe-pt-run" >"$T/probe-pt-run.names"
    npt=$(count_lines "$T/probe-pt.names")
    nptrun=$(count_lines "$T/probe-pt-run.names")
    echo "  copies tests whose comparison printed xml rows: $npt"
    sed 's/^/    printed xml rows: /' "$T/probe-pt.names"
    echo "  control: copies tests that called xlsx_diff::run: $nptrun"
    sed 's/^/    called run: /' "$T/probe-pt-run.names"
    check "control: the run probe records copies' calls of xlsx_diff::run, so the xml-row count is a measurement ($nptrun)" "$(yn [ "$nptrun" -ge 1 ])"
    check "ruling 8 (check 1 F8): no copies test prints xml rows ($npt)" "$(yn [ "$npt" = 0 ])"
    
    echo
    echo "### ruling 8, part 2: the test files this phase changed (header change 4)"
    git diff --name-only "$BASE" "$C" -- 'tools/xlsx-diff/tests/*.rs' 'tools/xlsx-diff/tests/*/*.rs' 'tools/passthrough/tests/*.rs' 'tools/passthrough/tests/*/*.rs' >"$T/test-files"
    sed 's/^/    test file changed by the phase: /' "$T/test-files"
    only_p7() { [ "$(tr '\n' ' ' <"$T/test-files")" = "tools/xlsx-diff/tests/p7.rs " ]; }
    check "the phase changed tests/p7.rs and no other test file, so no pre-existing test or helper changed" "$(yn only_p7)"
    printf 'tools/xlsx-diff/tests/p7.rs\ntools/xlsx-diff/tests/common/mod.rs\n' >"$T/c-test-files"
    only_p7_ctl() { local T=$T/c; mkdir -p "$T"; cp "$T/../c-test-files" "$T/test-files"; if only_p7; then return 1; else return 0; fi; }
    check "control: only_p7 refuses a list that also holds the helpers" "$(yn only_p7_ctl)"
    ( cd "$MUTTREE/tree" && git checkout -q -- . ) || fail=1
    
    echo
    echo "## the mutations of the comparison, and what each one failed (header change 4)"
    # Each mutation names the test expected to fail. It bites when that test
    # fails and the mutated crate compiled (a build failure is cargo's
    # "could not compile"; attempt 1 counted cargo's own "error: test failed"
    # summary lines as build errors, see the rerun note). A bite-mode mutation
    # that does not bite is printed as a FINDING and fails its check; it is
    # never re-typed. M9 on the host is MEASURED, not expected to bite: Hash for
    # [u8] frames its length with write_usize, which on a 64-bit host writes the
    # same eight bytes as write_u64, so only the 32-bit target can tell them
    # apart (P1 ruling 7's reason for pinning the hash on both targets).
    mut_expect() {
      case "$1" in
        M1) echo spellings_that_mean_the_same_compare_equal ;;
        M2) echo spellings_that_mean_the_same_compare_equal ;;
        M3) echo a_raw_cr_against_a_cr_reference_differs ;;
        M4) echo parse_errors_end_the_entry_at_its_parse_row ;;
        M5) echo spellings_that_mean_the_same_compare_equal ;;
        M6) echo archive_rows_with_two_compared_entries_one_failing ;;
        M7) echo parse_errors_end_the_entry_at_its_parse_row ;;
        M8) echo spellings_that_mean_the_same_compare_equal ;;
        M9) echo xml::tests::value_hash_is_pinned ;;
        M10) echo no_value_in_any_output ;;
        M11) echo spellings_that_mean_the_same_compare_equal a_cr_and_an_lf_either_side_of_markup_are_two_line_ends ;;
        M12) echo an_attribute_cr_lf_against_an_lf_compares_equal ;;
      esac
    }
    mut_mode() { if [ "$1-$2" = M9-host ]; then echo measure; else echo bite; fi; }
    : >"$T/findings"
    : >"$T/mut-table"
    for m in M1 M2 M3 M4 M5 M6 M7 M8 M9 M10 M11 M12; do
      echo
      echo "### $m (expected to fail: $(mut_expect "$m"))"
      ( cd "$MUTTREE/tree" && git checkout -q -- . ) || fail=1
      python3 "$MUTTREE/mutate.py" "$m" "$MUTTREE/tree" >"$T/mut-$m.apply" 2>&1
      arc=$?
      sed 's/^/  /' "$T/mut-$m.apply"
      check "$m: the applier found its text exactly once and replaced it" "$(yn [ "$arc" -eq 0 ])"
      if [ "$arc" -ne 0 ]; then echo "$m applier-refused" >>"$T/mut-table"; continue; fi
      echo "  the planted change, as git diff prints it in the worktree:"
      git -C "$MUTTREE/tree" diff | sed 's/^/    /'
      targets=(host)
      if [ "$m" = M9 ]; then targets=(host i686-unknown-linux-musl); fi
      for target in "${targets[@]}"; do
        if [ "$target" = host ]; then tflag=(); else tflag=(--target "$target"); fi
        echo "command: cargo test -p xlsx-diff --no-fail-fast ${tflag[*]} (in the mutated worktree)"
        in_tree_test "$m-$target" "${tflag[@]}"
        mrc=$?
        echo "  exit: $mrc"
        LC_ALL=C "$G" -E '^error' "$T/tree-$m-$target.out" | sed 's/^/    cargo: /'
        LC_ALL=C "$G" -E '^test result: ' "$T/tree-$m-$target.out" | sed 's/^/    /'
        failed_names "$T/tree-$m-$target.out" >"$T/mut-$m-$target.failed"
        sed 's/^/    failed: /' "$T/mut-$m-$target.failed"
        want=$(mut_expect "$m")
        nwant=0
        nhit=0
        for w in $want; do
          nwant=$((nwant + 1))
          nhit=$((nhit + $(count_matches -Fx "$w" "$T/mut-$m-$target.failed")))
          echo "  the failing assertion of $w, as the run printed it (first lines):"
          awk -v w="---- $w stdout ----" '$0 == w { on = 1; n = 0 } on { print; n++ } on && n >= 8 { on = 0 }' "$T/tree-$m-$target.out" |
            cut -c1-240 | sed 's/^/    /'
        done
        nbuild=$(count_matches -F 'error: could not compile' "$T/tree-$m-$target.out")
        # Bites only when every expected name failed.
        hit=$([ "$nhit" = "$nwant" ] && echo 1 || echo 0)
        echo "  expected names that failed: $nhit of $nwant"
        nfail=$(count_lines "$T/mut-$m-$target.failed")
        mode=$(mut_mode "$m" "$target")
        echo "  failing tests: $nfail; could-not-compile lines: $nbuild; mode: $mode"
        if [ "$hit" = 1 ] && [ "$nbuild" = 0 ]; then
          echo "  $m on $target bites: $want fails ($nfail failing tests in all)"
          echo "$m $target mode=$mode bites expected=$want failing=$nfail" >>"$T/mut-table"
        elif [ "$mode" = measure ]; then
          echo "  MEASURED $m on $target: $want does not fail (failing tests $nfail, could-not-compile $nbuild), as the framing argument above expects"
          echo "$m $target mode=$mode does-not-bite expected=$want failing=$nfail" >>"$T/mut-table"
        else
          echo "  FINDING $m on $target: $want did not fail (failing tests $nfail, could-not-compile $nbuild)"
          echo "$m $target mode=$mode FINDING expected=$want failing=$nfail build=$nbuild" >>"$T/mut-table"
          echo "$m-$target" >>"$T/findings"
        fi
        if [ "$mode" = bite ]; then
          bit() { [ "$hit" = 1 ] && [ "$nbuild" = 0 ]; }
          check "$m on $target: $want fails and the crate compiled" "$(yn bit)"
        fi
      done
    done
    echo
    echo "### control: the same worktree with no mutation applied"
    ( cd "$MUTTREE/tree" && git checkout -q -- . ) || fail=1
    check "control: the worktree carries no change after the reset" \
      "$(yn [ "$(git -C "$MUTTREE/tree" status --porcelain | count_lines /dev/stdin)" = 0 ])"
    in_tree_test clean
    crc=$?
    echo "  exit: $crc"
    LC_ALL=C "$G" -E '^test result: ' "$T/tree-clean.out" | sed 's/^/    /'
    check "control: the unmutated worktree's xlsx-diff tests all pass, so each failure above is the mutation's" \
      "$(yn [ "$crc" -eq 0 ])"
    check "control: the unmutated run fails nothing" "$(yn [ "$(failed_names "$T/tree-clean.out" | count_lines /dev/stdin)" = 0 ])"
    ok_names "$T/tree-clean.out" >"$T/clean.ok"
    bites_ctl() {
      local w
      for w in $(mut_expect M12) $(mut_expect M11) $(mut_expect M10); do [ "$(count_matches -Fx "$w" "$T/clean.ok")" = 1 ] || return 1; done
    }
    build_form_ctl() { [ "$(printf 'error: could not compile `x` (lib test) due to 1 previous error\nerror: test failed, to rerun pass x\n' | count_matches -F 'error: could not compile' /dev/stdin)" = 1 ]; }
    check "control: the build-failure form counts a could-not-compile line and not cargo's test-failed line" "$(yn build_form_ctl)"
    check "control: the names the bite test looks for (M10's, M11's and M12's) are ones the unmutated run passes" "$(yn bites_ctl)"
    m11_half() { local nhit=1 nwant=2; [ "$nhit" = "$nwant" ]; }
    m11_half_ctl() { if m11_half; then return 1; else return 0; fi; }
    check "control: the all-names rule refuses one expected name of two" "$(yn m11_half_ctl)"
    echo
    echo "## the mutation table"
    sed 's/^/    /' "$T/mut-table"
    echo "  mutations that did not bite (findings): $(tr '\n' ' ' <"$T/findings")"
    nbites=$(count_matches -E ' bites ' "$T/mut-table")
    no_findings() { [ "$(count_lines "$T/findings")" = 0 ]; }
    check "no bite-mode mutation failed to bite" "$(yn no_findings)"
    nrows=$(count_lines "$T/mut-table")
    echo "  rows that bite: $nbites of $nrows"
    cleanup_worktree
    trap 'rm -rf "$T"' EXIT INT TERM HUP
    
    cp "$T/mut-table" "$T/mut-table-final" 2>/dev/null || :
    echo
    echo "## what the first code commit's message claims (header change 6)"
