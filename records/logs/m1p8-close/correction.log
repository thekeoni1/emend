## script that wrote this log
    #!/usr/bin/env bash
    # Milestone 1 part 8 close-out correction.log (specs/0015-open-checks.md
    # "Planning verification and rulings on the close-out (2026-09-24)", ruling 3),
    # in the form of records/logs/m1p2-close/correction.log.
    #
    # What it records: records/logs/m1p8-close/push.log stands as written (ruling
    # 2). Two identity checks in that log's printed script each held a compound
    # condition inside one helper call, so only the first condition decided the
    # printed answer. This log names them by line number and by place, never by
    # their text; runs the three shape greps, each with a control, over this
    # script's own source and over the fixed push script before printing either;
    # prints the fixed script, in which each check goes through a named function;
    # and reruns the identity read, the mismatch count and the three controls over
    # the pushed range through those functions (the fixed script's identity mode,
    # which never pushes). It cites push.log, ci-run.log and the superseded scan
    # attempt 1 by sha256 read from the files at run time.
    #
    # Usage: M1CLOSE_LIB=<lib> m1p8close-correction.sh <fixed push script> \
    #          <push.log> <ci-run.log> <scan attempt 1> > <scratch file>
    # The caller moves the output to records/logs/m1p8-close/correction.log.
    #
    # Every commit id is read from git by a command the log prints; none is typed.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    FIXED=${1:?the fixed push script is required}
    PUSHLOG=${2:?push.log is required}
    CILOG=${3:?ci-run.log is required}
    SCAN1=${4:?scan attempt 1 is required}
    LIB=${M1CLOSE_LIB:?the path to the counting library is required}
    . "$LIB"
    BASE_PATTERN='^M1 part 7 close-out: commit planning docs [(]the P2 verification and rulings, Milestone 2 proposed[)]$'
    TIP_PATTERN='^M1 part 8 close-out: commit planning docs [(]the P2 rulings 8 to 11, the P2 verification[)]$'
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    one_line() { [ "$1" != error ] && [ "$1" = 1 ]; }
    is_zero() { [ "$1" != error ] && [ "$1" = 0 ]; }
    is_one() { [ "$1" != error ] && [ "$1" = 1 ]; }
    is_two() { [ "$1" != error ] && [ "$1" = 2 ]; }
    # shapes_clean <chained> <bang> <assign>: all three counts read and 0.
    shapes_clean() { is_zero "$1" && is_zero "$2" && is_zero "$3"; }
    # refuses <function> <args...>: the function returns false on these args.
    refuses() { if "$@"; then return 1; else return 0; fi; }
    # rerun_clean <exit>: identity mode exited 0 and wrote nothing to stderr.
    rerun_clean() { [ "$1" -eq 0 ] && [ ! -s "$T/iderr" ]; }
    
    # The three shapes specs/0001 forbids, patterns and fixtures as the close-out
    # scan builds them, from pieces, so this script's text cannot trip them.
    SHAPE='[$][(](yn|is|isnot) .*(&&|[|][|])'
    BANG='[$][(](yn|is|isnot) [!]'
    ASSIGN='[$][(](yn|is|isnot) [A-Za-z_][A-Za-z_0-9]*='
    f_shape() { count_matches -E "$SHAPE" "$1"; }
    f_bang() { count_matches -E "$BANG" "$1"; }
    f_assign() { count_matches -E "$ASSIGN" "$1"; }
    # script_of: the lines of a log's printed script section.
    script_of() { awk '/^## script/ { on = 1; next } /^## / { on = 0 } on { sub(/^    /, ""); print }' "$1"; }
    # shape_lines <log>: "<log line> <script line>" for each chained-form hit in
    # the log's printed script. Numbers only; no matched text leaves awk.
    shape_lines() {
      awk -v re="$SHAPE" '/^## script/ { on = 1; n = 0; next } /^## / { on = 0 } on { n++; if ($0 ~ re) print NR, n }' "$1"
    }
    
    echo "command: git rev-parse HEAD"
    echo "about: M1 part 8 close-out correction.log; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: Milestone 1 part 8 close-out (specs/0015-open-checks.md \"Planning verification and rulings on the close-out (2026-09-24)\", ruling 3) correction.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    KSET=$([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)
    check "ANTHROPIC_API_KEY is unset in this shell (set: $KSET)" "$(yn [ "$KSET" = no ])"
    echo "commit ids in this log are read from git by the commands printed below,"
    echo "never typed. No matched line is printed anywhere in this log: the"
    echo "superseded checks are named by line number and by place only."
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$LIB"
    echo
    echo "## counting controls (every form, before any of them is used)"
    counting_controls
    check "every counting form behaves on a match, a miss and an unreadable file" "$(yn [ "$counting_controls_ok" = yes ])"
    
    echo
    echo "## the logs cited, by sha256 read at run time"
    for f in "$PUSHLOG" "$CILOG" "$SCAN1"; do
      printf '    %s  %s bytes  %s\n' "$(sha256sum <"$f" | cut -d' ' -f1)" "$(wc -c <"$f")" "$(basename "$(dirname "$f")")/$(basename "$f")"
    done
    echo "  push.log and ci-run.log are committed beside this log as written."
    echo "  attempt1/scan.log is the superseded scan attempt 1 (ruling 2); it is"
    echo "  not committed and is named here and in the rerun's header by sha256."
    
    echo
    echo "## the pushed range, resolved from git by subject"
    echo "command: git log --format='%H' --grep='$BASE_PATTERN'"
    git log --format='%H' --grep="$BASE_PATTERN" >"$T/b"
    check "the base pattern matches exactly one commit" "$(yn one_line "$(count_lines "$T/b")")"
    BASE=$(head -n 1 "$T/b")
    echo "command: git log --format='%H' --grep='$TIP_PATTERN'"
    git log --format='%H' --grep="$TIP_PATTERN" >"$T/t"
    check "the tip pattern matches exactly one commit" "$(yn one_line "$(count_lines "$T/t")")"
    TIP=$(head -n 1 "$T/t")
    echo "  base $BASE; tip $TIP"
    ORIGIN=$(git rev-parse origin/main)
    echo "command: git rev-parse origin/main -> $ORIGIN"
    check "origin/main is the tip (the range as pushed)" "$(yn [ "$ORIGIN" = "$TIP" ])"
    echo "  the push log's own range line, counted: $(count_matches -F "base recorded before the push: $BASE" "$PUSHLOG") (expect 1)"
    check "push.log recorded this base" "$(yn is_one "$(count_matches -F "base recorded before the push: $BASE" "$PUSHLOG")")"
    
    echo
    echo "## controls: each shape grep reports a planted hit and passes a named function"
    printf 'x %s(is [ a = a ] && [ b = b ])\n' '$' >"$T/c-shape"
    printf 'x %s(is %s f a b)\n' '$' '!' >"$T/c-bang"
    printf 'x %s(isnot %s%s /usr/bin/grep -q x f)\n' '$' 'LC_ALL' '=C' >"$T/c-assign"
    printf 'ok() { [ a = a ] || return 1; [ b = b ] || return 1; }\nnote "x" "%s(is ok)"\n' '$' >"$T/c-ok"
    ctl_ok=yes
    for pair in "f_shape c-shape 1" "f_bang c-bang 1" "f_assign c-assign 1" \
                "f_shape c-ok 0" "f_bang c-ok 0" "f_assign c-ok 0"; do
      set -- $pair
      n=$("$1" "$T/$2")
      echo "  control $1 on $2: $n (expect $3)"
      [ "$n" = "$3" ] || ctl_ok=no
    done
    check "each shape grep counts its planted fixture and passes the named function" "$(yn [ "$ctl_ok" = yes ])"
    
    echo
    echo "## the three shape greps over this script's source and the fixed script, before printing either"
    for f in "$0" "$FIXED"; do
      s=$(f_shape "$f"); b=$(f_bang "$f"); a=$(f_assign "$f")
      echo "  $(basename "$f"): chained=$s leading-bang=$b assignment=$a"
      check "$(basename "$f") writes none of the three shapes" "$(yn shapes_clean "$s" "$b" "$a")"
    done
    
    echo
    echo "## what is superseded, named by number and by place"
    echo "file: records/logs/m1p8-close/push.log (committed as written, ruling 2)"
    script_of "$PUSHLOG" >"$T/pushscript"
    s=$(f_shape "$T/pushscript"); b=$(f_bang "$T/pushscript"); a=$(f_assign "$T/pushscript")
    echo "command: the three shape greps over push.log's printed script -> chained=$s leading-bang=$b assignment=$a"
    check "push.log's printed script holds exactly 2 chained-form hits" "$(yn is_two "$s")"
    check "and no hit of the other two forms" "$(yn shapes_clean 0 "$b" "$a")"
    shape_lines "$PUSHLOG" >"$T/where"
    echo "command: the chained form's hits in push.log, as <log line> <printed-script line>"
    sed 's/^/  -> /' "$T/where"
    check "the hits are exactly two lines" "$(yn is_two "$(count_lines "$T/where")")"
    set -- $(tr '\n' ' ' <"$T/where")
    echo "  printed-script line $2 (push.log line $1): in pre mode, the section on"
    echo "    the author and committer identity of every commit in the range, the"
    echo "    check that git log read one identity line per commit in the range."
    echo "  printed-script line $4 (push.log line $3): in the same section, the"
    echo "    check that the identity form's control counted a planted mismatch in"
    echo "    each case."
    echo "In each, only the first condition decided the printed answer. The values"
    echo "the checks meant to assert are printed on the lines above them in"
    echo "push.log (the exit, the commits read against the range, and the three"
    echo "control counts against their expectations); the identity is rerun below"
    echo "through the fixed checks. The lines are NOT quoted here, by ruling 3."
    
    echo
    echo "## the fixed checks: named functions, read from the fixed script"
    awk '/^ident_read_ok\(\) \{/ || /^ident_controls_ok\(\) \{/' "$FIXED" >"$T/fns"
    check "the fixed script defines both named functions, one line each" "$(yn is_two "$(count_lines "$T/fns")")"
    . "$T/fns"
    echo "  ident_read_ok 0 17 17 -> $(yn ident_read_ok 0 17 17) (expect yes)"
    echo "  ident_read_ok 0 16 17 -> $(yn ident_read_ok 0 16 17) (expect no: the second condition decides)"
    echo "  ident_read_ok 1 17 17 -> $(yn ident_read_ok 1 17 17) (expect no)"
    echo "  ident_controls_ok 0 1 1 -> $(yn ident_controls_ok 0 1 1) (expect yes)"
    echo "  ident_controls_ok 0 1 0 -> $(yn ident_controls_ok 0 1 0) (expect no: the third condition decides)"
    echo "  ident_controls_ok 0 0 1 -> $(yn ident_controls_ok 0 0 1) (expect no: the second condition decides)"
    echo "  ident_controls_ok 1 1 1 -> $(yn ident_controls_ok 1 1 1) (expect no)"
    fns_behave() {
      ident_read_ok 0 17 17 && refuses ident_read_ok 0 16 17 && refuses ident_read_ok 1 17 17 &&
        ident_controls_ok 0 1 1 && refuses ident_controls_ok 0 1 0 &&
        refuses ident_controls_ok 0 0 1 && refuses ident_controls_ok 1 1 1
    }
    check "each named function answers on every condition, not only the first" "$(yn fns_behave)"
    
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$0"
    echo
    echo "## script: the fixed push script (sha256 $(sha256sum <"$FIXED" | cut -d' ' -f1))"
    sed 's/^/    /' "$FIXED"
    
    echo
    echo "## the identity rerun over the pushed range, through the fixed checks"
    echo "command: M1CLOSE_LIB=<lib> <the fixed push script> identity $BASE $TIP"
    M1CLOSE_LIB="$LIB" "$FIXED" identity "$BASE" "$TIP" >"$T/id" 2>"$T/iderr" </dev/null
    rc=$?
    sed 's/^/    /' "$T/id"
    echo "  stderr:"
    sed 's/^/    /' "$T/iderr"
    echo "exit: $rc"
    check "identity mode exit is 0 and stderr is empty" "$(yn rerun_clean "$rc")"
    check "identity mode ends all as expected" "$(yn is_one "$(count_matches -E '^identity checks all as expected: yes$' "$T/id")")"
    check "no line of identity mode ends in no" "$(yn is_zero "$(count_matches -E ': no$' "$T/id")")"
    
    echo
    echo "## this log's own output"
    PATH_RE='(/home/|/mnt/|/Users/|/tmp/|emend-testing)'
    printf 'x %s%s%s y\n' '/ho' 'me/someone/' 'emend-testing/corpus/x.xlsx' >"$T/path-plant"
    echo "  control: the path form on a planted path: $(count_matches -E "$PATH_RE" "$T/path-plant") (expect 1)"
    check "the path form counts a planted path" "$(yn is_one "$(count_matches -E "$PATH_RE" "$T/path-plant")")"
    cat "$T/id" "$T/iderr" "$T/where" >"$T/captured"
    echo "  lines naming a home, mount, temp or corpus path in the captured output: $(count_matches -E "$PATH_RE" "$T/captured")"
    check "the captured output names no such path" "$(yn is_zero "$(count_matches -E "$PATH_RE" "$T/captured")")"
    echo "command: git status --porcelain -> $(run_lines git status --porcelain) line(s)"
    git status --porcelain 2>&1 | sed 's/^/    /'
    check "working tree clean" "$(yn is_zero "$(run_lines git status --porcelain)")"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "correction log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

## script: the fixed push script (sha256 6cd51bb7a995228bebf4d6594d01594d32b06e7a5d07f0f12a7f0754ac6fb984)
    #!/usr/bin/env bash
    # Milestone 1 part 8 close-out push.log (specs/0015-open-checks.md, planning's
    # close-out instruction: "Pre-push checks as in part 7's close-out: the commit
    # list since origin/main 4bc741e including 9232e61, the blob scan, the author
    # identity on every commit, and no ANTHROPIC_API_KEY in the environment").
    #
    # DERIVED FROM part 7's close-out script as records/logs/m1p7-close/push.log
    # printed it (extracted from that committed log into the session's scratch
    # directory). Every check, control and helper is part 7's, unchanged, except:
    #  1. The names are part 8's, and the spec cited is specs/0015.
    #  2. The base is part 7's close-out doc commit (4bc741e when this was
    #     written), the last commit part 7 pushed, resolved from git by its subject
    #     and the pattern asserted to match exactly one commit. Part 7's record
    #     commit (9232e61) was made after its push and is in this range; a check
    #     says so.
    #  3. Added in pre mode: the author and committer identity of every commit in
    #     the range, compared with scripts/privacy-identity.txt by count, with a
    #     planted-mismatch control; no name or email is printed.
    #  4. Added in pre mode: the blob scan, scripts/privacy.sh --range base..main,
    #     before the push (the hook runs the same scan again at push time).
    #  5. Planning's P2 verification ruling 2 (F1): every tree-status check prints
    #     the status lines themselves, not only their count.
    #  6. FIXED AFTER THE PUSH (specs/0015 "Planning verification and rulings on
    #     the close-out (2026-09-24)", rulings 1 and 3). The run of 2026-09-24
    #     that pushed 4bc741e..b06e0a7 used an earlier text of this script, printed
    #     in records/logs/m1p8-close/push.log, in which two identity checks each
    #     held a compound condition inside one helper call, so only the first
    #     condition decided the printed answer. In this text each goes through a
    #     named function, ident_read_ok and ident_controls_ok. The identity section
    #     is one function, identity_section, called by pre mode and by a third
    #     mode, identity, which runs that section alone over a given range and
    #     never pushes; records/logs/m1p8-close/correction.log runs it. Nothing
    #     else in the script changed.
    #  7. Part 7's other header items stand: the record is not split (one record
    #     commit after the push holds this log, ci-run.log and scan.log);
    #     ANTHROPIC_API_KEY unset is a check; the denylist is checked present,
    #     readable and not empty with entries counted, never printed; each mode's
    #     captured output gets the path check with its planted control; the gate
    #     has nine steps.
    #
    # Usage: M1CLOSE_LIB=<lib> m1p8close-push.sh pre <phase commit> > <scratch file>
    #          step 2: the environment, identity, blob-scan, hook, core.hooksPath
    #          and denylist checks and the full gate; records the base
    #          (origin/main) and the count of commits to push. NO PUSH, and this
    #          mode can never push.
    #        M1CLOSE_LIB=<lib> m1p8close-push.sh identity <base> <tip>
    #          the identity section alone over base..tip (change 6). NO PUSH.
    #        M1CLOSE_LIB=<lib> m1p8close-push.sh push <base> >> <scratch file>
    #          steps 3 and 4: refuses unless origin/main still equals <base>,
    #          pushes, and checks the hook's range, the count and git's report
    #          against <base> as recorded by pre, never against origin/main read
    #          after the push.
    #
    # THE MAINTAINER'S AUTHORISATION. specs/0003-ci.md, the section on the push,
    # requires three preconditions: the phase DONE, planning's word, and the
    # maintainer typing authorisation in the implementing session. push mode is
    # only ever run after that sentence has been typed. Planning's word does not
    # stand in for it, and neither does this script.
    #
    # Every commit id this log reports is read from git at run time by a command
    # the log prints; none is typed.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    MODE=${1:?pre or push}
    LIB=${M1CLOSE_LIB:?the path to the counting library is required}
    . "$LIB"
    REPO=thekeoni1/emend
    URL=https://github.com/thekeoni1/emend.git
    BASE_PATTERN='^M1 part 7 close-out: commit planning docs [(]the P2 verification and rulings, Milestone 2 proposed[)]$'
    P7_RECORD_PATTERN='^M1 part 7 close-out record'
    ID_FILE=scripts/privacy-identity.txt
    DENY_FILE=$HOME/.config/emend/private-denylist.txt
    export GIT_TERMINAL_PROMPT=0 RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    
    show() { echo "$1:"; sed 's/^/    /' "$2"; }
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # exit_and_bytes <exit> <bytes> <want exit> <want bytes>: both match, in one
    # function so neither condition is dropped.
    exit_and_bytes() { [ "$1" -eq "$3" ] && [ "$2" = "$4" ]; }
    # same_nonempty <a> <b>: both set and equal.
    same_nonempty() { [ -n "$1" ] && [ "$1" = "$2" ]; }
    # holds_once <file> <line>: the file holds that whole line exactly once.
    holds_once() { [ "$(count_matches -F "$2" "$1")" = 1 ]; }
    # tree_clean: git status ran and printed nothing.
    tree_clean() { [ "$(run_lines git status --porcelain)" = 0 ]; }
    # show_status: the status lines themselves and their count (P2 verification
    # ruling 2, F1).
    show_status() {
      echo "command: git status --porcelain -> $(run_lines git status --porcelain) line(s)"
      git status --porcelain 2>&1 | sed 's/^/    /'
    }
    # files_listed <n>: the range's file list was read and is not empty.
    files_listed() { [ "$1" != error ] && [ "$1" -gt 0 ]; }
    # hook_scanned <file> <commits>: the hook's summary names that many commits and
    # zero findings.
    hook_scanned() {
      [ "$(count_matches -E "^privacy: $2 commit[(]s[)], [0-9]+ blob[(]s[)] scanned, 0 finding[(]s[)]$" "$1")" = 1 ]
    }
    # The phase commit guard (specs/0001, M1 part 3 P1 ruling 11): a full 40-hex
    # sha equal to HEAD. /usr/bin/grep explicitly, as every scan form.
    NULL_SHA=0000000000000000000000000000000000000000
    full_sha() { printf '%s' "$1" | LC_ALL=C /usr/bin/grep -qE '^[0-9a-f]{40}$'; }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    not_head() { if is_head "$1"; then return 1; else return 0; fi; }
    # one_line <n>: a count that was read and is exactly 1.
    # id_usable <name> <email>: both set, the email with an @.
    id_usable() { [ -n "$1" ] && [ -n "$2" ] && [ "${2#*@}" != "$2" ]; }
    # ident_read_ok <exit> <commits read> <commits in range>: git log exited 0 and
    # read one line per commit.
    ident_read_ok() { [ "$1" -eq 0 ] && [ "$2" = "$3" ]; }
    # ident_controls_ok <ok> <bad author email> <bad committer name>: the identity
    # counts 0 and each planted mismatch counts 1.
    ident_controls_ok() { [ "$1" = 0 ] && [ "$2" = 1 ] && [ "$3" = 1 ]; }
    # ident_lines <range> <out>: one line per commit, "<an>|<ae>|<cn>|<ce>".
    ident_lines() { git log --format='%an|%ae|%cn|%ce' "$1" >"$2" 2>/dev/null; }
    # ident_mismatches <file> <name> <email>: lines not equal to the identity in all
    # four fields; prints a count, never a field.
    ident_mismatches() {
      awk -F'|' -v n="$2" -v e="$3" 'NF != 4 || $1 != n || $2 != e || $3 != n || $4 != e { c++ } END { print c + 0 }' "$1"
    }
    one_line() { [ "$1" != error ] && [ "$1" = 1 ]; }
    # The path form (header change 6): lines naming a home, mount, temp or corpus
    # path. no_paths <files...>: the form read every file and found none.
    PATH_RE='(/home/|/mnt/|/Users/|/tmp/|emend-testing)'
    no_paths() { [ "$(count_matches -E "$PATH_RE" "$@")" = 0 ]; }
    # path_control: a planted path, assembled at run time so this script's own text
    # carries none, must count 1 through the same form, and a clean line 0. It
    # prints its two counts and sets path_ctl_ok; it is not run inside yn, so its
    # printed line is not swallowed.
    path_control() {
      printf 'x %s%s%s y\n' '/ho' 'me/someone/' 'emend-testing/corpus/x.xlsx' >"$T/path-plant"
      printf 'x clean y\n' >"$T/path-clean"
      local a b
      a=$(count_matches -E "$PATH_RE" "$T/path-plant")
      b=$(count_matches -E "$PATH_RE" "$T/path-clean")
      echo "  control: the path form on a planted path: $a (expect 1); on a clean line: $b (expect 0)"
      path_ctl_ok=no
      if [ "$a" = 1 ] && [ "$b" = 0 ]; then path_ctl_ok=yes; fi
    }
    # denylist_usable <n>: the denylist was read and has entries.
    denylist_usable() { [ "$1" != error ] && [ "$1" -gt 0 ]; }
    
    # identity_section <base> <main> <count>: the author and committer identity of
    # every commit in base..main against the identity file, counted and never
    # printed, with its controls (change 6).
    identity_section() {
        local BASE=$1 MAIN=$2 COUNT=$3 IDN IDE rc NI MI a b c
        echo
        echo "## the author and committer identity of every commit in the range"
        echo "command: git log --format='%an|%ae|%cn|%ce' $BASE..$MAIN, compared with $ID_FILE lines 1 and 2; no field printed"
        IDN=$(sed -n 1p "$ID_FILE"); IDE=$(sed -n 2p "$ID_FILE")
        check "$ID_FILE holds a name and an email-shaped line 2" "$(yn id_usable "$IDN" "$IDE")"
        ident_lines "$BASE..$MAIN" "$T/ids"; rc=$?
        NI=$(count_lines "$T/ids")
        MI=$(ident_mismatches "$T/ids" "$IDN" "$IDE")
        echo "  exit $rc; commits read: $NI; commits whose author or committer name or email differs: $MI"
        check "one identity line per commit in the range ($NI of $COUNT)" "$(yn ident_read_ok "$rc" "$NI" "$COUNT")"
        check "every commit's author and committer equal the identity file (mismatches $MI)" "$(yn [ "$MI" = 0 ])"
        printf '%s|%s|%s|%s\n' "$IDN" "$IDE" "$IDN" "$IDE" >"$T/id-ok"
        printf '%s|%s|%s|%s\n' "$IDN" "x$IDE" "$IDN" "$IDE" >"$T/id-bad-ae"
        printf '%s|%s|%s|%s\n' "$IDN" "$IDE" "x$IDN" "$IDE" >"$T/id-bad-cn"
        a=$(ident_mismatches "$T/id-ok" "$IDN" "$IDE"); b=$(ident_mismatches "$T/id-bad-ae" "$IDN" "$IDE"); c=$(ident_mismatches "$T/id-bad-cn" "$IDN" "$IDE")
        echo "  control: the same form on the identity itself: $a (expect 0); a planted author-email mismatch: $b (expect 1); a planted committer-name mismatch: $c (expect 1)"
        check "control: the identity form counts a planted mismatch in each case" "$(yn ident_controls_ok "$a" "$b" "$c")"
    }
    case "$MODE" in
      pre)
        C=${2:?the phase commit is required}
        HEAD_SHA=$(git rev-parse HEAD)
        echo "command: git rev-parse HEAD"
        echo "about: M1 part 8 close-out push of main at $(git rev-parse main); HEAD at run: $HEAD_SHA"
        echo "  the phase commit given to this script: $C"
        echo "  git rev-parse HEAD at this run:        $HEAD_SHA"
        check "the phase commit given to this script is HEAD" "$(yn is_head "$C")"
        check "control: the same form refuses a commit that is not HEAD" "$(yn not_head "$NULL_SHA")"
        check "control: the same form refuses a short sha of the real commit" "$(yn not_head "$(printf '%s' "$C" | cut -c1-7)")"
        echo "phase: Milestone 1 part 8 close-out (specs/0015-open-checks.md, planning's close-out instruction) push.log, step 2; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
        KSET=$([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)
        check "ANTHROPIC_API_KEY is unset in this shell (set: $KSET)" "$(yn [ "$KSET" = no ])"
        echo "THIS MODE DOES NOT PUSH. The push (push mode, appended below) runs only"
        echo "on planning's word and the maintainer's authorisation typed in the"
        echo "implementing session (specs/0003-ci.md, the section on the push). The"
        echo "record is not split: this log, ci-run.log and scan.log go in one record"
        echo "commit after the push."
        echo
        echo "## script that wrote this log"
        sed 's/^/    /' "$0"
        echo
        echo "## the shared counting library this log sources"
        sed 's/^/    /' "$LIB"
        echo
        echo "## counting controls (every form, before any of them is used)"
        counting_controls
        check "every counting form behaves on a match, a miss and an unreadable file" "$(yn [ "$counting_controls_ok" = yes ])"
        echo
    
        show_status
        check "working tree clean before the run" "$(yn tree_clean)"
        MAIN=$(git rev-parse main)
        echo "command: git rev-parse main -> $MAIN"
        echo "command: git symbolic-ref --short HEAD -> $(git symbolic-ref --short HEAD)"
        echo "command: git rev-list --count main -> $(git rev-list --count main)"
        check "HEAD is main" "$(yn [ "$HEAD_SHA" = "$MAIN" ])"
        RURL=$(git remote get-url origin)
        echo "command: git remote get-url origin -> $RURL"
        check "origin is $URL" "$(yn [ "$RURL" = "$URL" ])"
    
        echo
        echo "## the base, read from git and not typed"
        BASE=$(git rev-parse origin/main)
        echo "command: git rev-parse origin/main -> $BASE"
        echo "command: git log --format='%H' --grep='$BASE_PATTERN'"
        git log --format='%H' --grep="$BASE_PATTERN" >"$T/base-matches"
        NB=$(count_lines "$T/base-matches")
        echo "  commits matching the pattern: $NB"
        check "the base pattern matches exactly one commit" "$(yn one_line "$NB")"
        EXPECT=$(git rev-parse "$(git log --format='%H' --grep="$BASE_PATTERN" -n 1)" 2>/dev/null)
        echo "  part 7's close-out doc commit, the last one pushed, resolves to: $EXPECT"
        check "origin/main is part 7's close-out doc commit, resolved from git by its subject" "$(yn same_nonempty "$BASE" "$EXPECT")"
        echo "command: git ls-remote origin refs/heads/main"
        git ls-remote origin refs/heads/main > "$T/ls0" 2> "$T/ls0err" </dev/null
        rc=$?
        show stdout "$T/ls0"
        show stderr "$T/ls0err"
        echo "exit: $rc"
        check "ls-remote exit is 0" "$(yn [ "$rc" -eq 0 ])"
        check "the remote's main is the base (the tracking ref is not stale)" "$(yn same_nonempty "$(cut -f1 "$T/ls0")" "$BASE")"
        COUNT=$(git rev-list --count "$BASE..$MAIN")
        echo "command: git rev-list --count $BASE..$MAIN -> $COUNT"
        check "there is something to push: $COUNT commit(s)" "$(yn [ "$COUNT" -gt 0 ])"
        echo "base recorded before the push: $BASE"
        echo "commits to push (oldest first; the record commit holding this log is"
        echo "made after the push and is not among them):"
        git log --reverse --format='    %H %s' "$BASE..$MAIN"
        NFILES=$(run_lines git diff --name-only "$BASE..$MAIN")
        echo "command: git diff --name-only $BASE..$MAIN -> $NFILES file(s)"
        check "the range's file list was read and is not empty" "$(yn files_listed "$NFILES")"
        echo "command: git log --format='%H %s' --grep='$P7_RECORD_PATTERN' $BASE..$MAIN"
        git log --format='%H %s' --grep="$P7_RECORD_PATTERN" "$BASE..$MAIN" | sed 's/^/    /' | tee "$T/p7rec"
        check "part 7's record commit, made after part 7's push, is in the range exactly once" "$(yn one_line "$(count_lines "$T/p7rec")")"
    
        identity_section "$BASE" "$MAIN" "$COUNT"
    
        echo
        echo "## the blob scan over the range, before the push"
        echo "command: scripts/privacy.sh --range $BASE..$MAIN"
        scripts/privacy.sh --range "$BASE..$MAIN" > "$T/pv" 2> "$T/pverr" </dev/null
        rc=$?
        show stdout "$T/pv"
        show stderr "$T/pverr"
        echo "exit: $rc"
        check "privacy exit is 0" "$(yn [ "$rc" -eq 0 ])"
        printf 'PASS privacy\n' > "$T/pvwant"
        check "stdout is exactly PASS privacy" "$(yn cmp -s "$T/pv" "$T/pvwant")"
        check "stderr is the summary: $COUNT commits, 0 findings" "$(yn hook_scanned "$T/pverr" "$COUNT")"
    
        echo
        echo "## step 2: pre-push state and full gate"
        DSET=$([ -n "${EMEND_PRIVATE_DENYLIST+set}" ] && echo yes || echo no)
        check "EMEND_PRIVATE_DENYLIST is unset (set: $DSET)" "$(yn [ "$DSET" = no ])"
        echo "command: the private denylist at <home>/.config/emend/private-denylist.txt, entries counted and never printed"
        check "the denylist file is present and readable" "$(yn [ -r "$DENY_FILE" ])"
        LC_ALL=C "$G" -v -E '^[[:space:]]*(#|$)' "$DENY_FILE" >"$T/deny" 2>/dev/null
        ND=$(count_lines "$T/deny")
        echo "  mode $(stat -c %a "$DENY_FILE" 2>/dev/null); entries: $ND"
        check "the denylist has entries" "$(yn denylist_usable "$ND")"
        echo "command: git config --get core.hooksPath"
        git config --get core.hooksPath > "$T/out" 2>&1
        rc=$?
        show output "$T/out"
        n=$(count_bytes '\000-\377' "$T/out")
        check "exit $rc and output bytes $n (expect exit 1 and 0 bytes)" "$(yn exit_and_bytes "$rc" "$n" 1 0)"
        echo "command: ls -l .git/hooks/pre-push"
        ls -l .git/hooks/pre-push | sed 's/^/    /'
        check "hook is executable" "$(yn [ -x .git/hooks/pre-push ])"
        awk '/^cat >"\$hook" <<.HOOK.$/ { p = 1; next } /^HOOK$/ { p = 0 } p' scripts/install-hooks.sh > "$T/heredoc"
        n=$(count_lines "$T/heredoc")
        # Both conditions in one named function: the label says "more than 0", so
        # the check must test that and not merely that the count did not error.
        heredoc_nonempty() { [ "$1" != error ] && [ "$1" -gt 0 ]; }
        check "installer heredoc lines: $n (expect more than 0)" "$(yn heredoc_nonempty "$n")"
        echo "hook sha256 $(sha256sum < .git/hooks/pre-push | cut -d' ' -f1); installer heredoc sha256 $(sha256sum < "$T/heredoc" | cut -d' ' -f1)"
        check "hook equals what scripts/install-hooks.sh writes" "$(yn cmp -s .git/hooks/pre-push "$T/heredoc")"
        echo "command: scripts/check.sh"
        scripts/check.sh > "$T/out" 2> "$T/err" </dev/null
        rc=$?
        show stdout "$T/out"
        show stderr "$T/err"
        echo "exit: $rc; stderr bytes: $(count_bytes '\000-\377' "$T/err")"
        check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
        check "stderr is empty" "$(yn [ "$(count_bytes '\000-\377' "$T/err")" = 0 ])"
        printf 'PASS host\nPASS i686\nPASS fmt\nPASS clippy\nPASS doc\nPASS native (allowlisted -sys: none)\nPASS licences\nPASS hygiene\nPASS privacy\n' > "$T/want"
        check "stdout is exactly the nine PASS lines in order, doc among them" "$(yn cmp -s "$T/out" "$T/want")"
        for s in out err; do
          n=$(count_bytes "$CTRL_CLASS" "$T/$s")
          check "check.sh std$s control bytes: $n (expect 0)" "$(yn [ "$n" = 0 ])"
        done
        show_status
        check "working tree clean after the gate" "$(yn tree_clean)"
        check "HEAD is still the phase commit after the gate" "$(yn [ "$(git rev-parse HEAD)" = "$C" ])"
        echo
        echo "## no path in this mode's captured output"
        path_control
        check "the path form can count a planted path" "$path_ctl_ok"
        cat "$T/ls0" "$T/ls0err" "$T/p7rec" "$T/pv" "$T/pverr" "$T/out" "$T/err" >"$T/pre-captured"
        echo "  lines naming a home, mount, temp or corpus path in the captured output: $(count_matches -E "$PATH_RE" "$T/pre-captured")"
        check "the captured output (ls-remote, the record line, the scan and the gate) names no such path" "$(yn no_paths "$T/pre-captured")"
        echo
        echo "pre checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
        echo "The base recorded above is what push mode compares against."
        ;;
    
      identity)
        BASE=${2:?the base is required}
        TIP=${3:?the tip is required}
        COUNT=$(git rev-list --count "$BASE..$TIP")
        echo "command: git rev-list --count $BASE..$TIP -> $COUNT"
        identity_section "$BASE" "$TIP" "$COUNT"
        echo "identity checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
        ;;
    
      push)
        BASE=${2:?the base recorded by pre is required}
        echo
        echo "# push mode, steps 3 and 4 (appended to the same log); run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "command: git rev-parse HEAD -> $(git rev-parse HEAD)"
        if [ -n "${EMEND_PRIVATE_DENYLIST+set}" ]; then echo "refusing: EMEND_PRIVATE_DENYLIST is set"; exit 1; fi
        if [ -n "$(git config --get core.hooksPath)" ]; then echo "refusing: core.hooksPath is set"; exit 1; fi
        if [ "$(git rev-parse origin/main)" != "$BASE" ]; then echo "refusing: origin/main is no longer the base recorded by pre"; exit 1; fi
        echo "EMEND_PRIVATE_DENYLIST unset, core.hooksPath empty, and origin/main still the recorded base (the script refuses otherwise)"
        MAIN=$(git rev-parse main)
        COUNT=$(git rev-list --count "$BASE..$MAIN")
        echo "main is $MAIN; base (recorded by pre) is $BASE; commits in base..main: $COUNT"
        echo
        echo "## step 3: push"
        echo "command: git push origin main"
        git push origin main > "$T/out" 2> "$T/err" </dev/null
        rc=$?
        show stdout "$T/out"
        show stderr "$T/err"
        echo "exit: $rc"
        check "push exit is 0" "$(yn [ "$rc" -eq 0 ])"
        cat "$T/out" "$T/err" > "$T/both"
        check "the hook printed PASS privacy" "$(yn holds_once "$T/both" 'PASS privacy')"
        check "the hook's range is $BASE..$MAIN (the base recorded by pre)" \
          "$(yn holds_once "$T/both" "pre-push: scripts/privacy.sh --range $BASE..$MAIN (refs/heads/main)")"
        check "the hook scanned $COUNT commits with 0 findings" "$(yn hook_scanned "$T/both" "$COUNT")"
        check "git reported ${BASE:0:7}..${MAIN:0:7} for main" \
          "$(yn holds_once "$T/both" "   ${BASE:0:7}..${MAIN:0:7}  main -> main")"
        n=$(count_bytes "$CTRL_CLASS" "$T/both")
        check "push output control bytes: $n (expect 0)" "$(yn [ "$n" = 0 ])"
        echo
        echo "## step 4: remote main equals local main, repository still private"
        echo "command: git ls-remote origin refs/heads/main"
        git ls-remote origin refs/heads/main > "$T/ls" 2> "$T/lserr" </dev/null
        rc=$?
        show stdout "$T/ls"
        show stderr "$T/lserr"
        echo "exit: $rc"
        check "ls-remote exit is 0" "$(yn [ "$rc" -eq 0 ])"
        REMOTE=$(cut -f1 "$T/ls")
        echo "command: git rev-parse main -> $MAIN"
        check "remote main equals local main" "$(yn same_nonempty "$REMOTE" "$MAIN")"
        echo "command: gh repo view $REPO --json visibility"
        gh repo view "$REPO" --json visibility > "$T/vis" 2> "$T/viserr" </dev/null
        rc=$?
        show stdout "$T/vis"
        show stderr "$T/viserr"
        echo "exit: $rc"
        check "gh exit is 0" "$(yn [ "$rc" -eq 0 ])"
        check "still PRIVATE" "$(yn holds_once "$T/vis" '{"visibility":"PRIVATE"}')"
        show_status
        check "working tree clean" "$(yn tree_clean)"
        echo
        echo "## no path in this mode's captured output"
        path_control
        check "the path form can count a planted path" "$path_ctl_ok"
        cat "$T/both" "$T/ls" "$T/lserr" "$T/vis" "$T/viserr" >"$T/push-captured"
        echo "  lines naming a home, mount, temp or corpus path in the captured output: $(count_matches -E "$PATH_RE" "$T/push-captured")"
        check "the captured output (push, ls-remote, gh) names no such path" "$(yn no_paths "$T/push-captured")"
        echo "push checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
        ;;
      *)
        echo "unknown mode" >&2
        exit 2
        ;;
    esac
    exit "$fail"
    
    

