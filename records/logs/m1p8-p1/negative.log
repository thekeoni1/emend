    rows_match() {
      local txt=$B/rec-$1/m1p8-negative-$1.txt keep=$2 t n=1
      [ "$(head -n 1 "$txt")" = "$TXT_HEADER" ] || return 1
      [ "$(($(count_lines "$txt") - 1))" = "$(find "$keep" -name '*.in.xlsx' | wc -l)" ] || return 1
      for t in $(find "$keep" -name '*.in.xlsx' -printf '%f\n' | sed 's/\.in\.xlsx$//' | LC_ALL=C sort); do
        n=$((n + 1))
        [ "$(sed -n "${n}p" "$txt" | cut -f1-5)" = "$t$TAB$(stat -c %s "$keep/$t.in.xlsx")$TAB$(sha256sum <"$keep/$t.in.xlsx" | cut -d' ' -f1)$TAB$(stat -c %s "$keep/$t.out.xlsx")$TAB$(sha256sum <"$keep/$t.out.xlsx" | cut -d' ' -f1)" ] || return 1
      done
    }
    # row_is <case> <test> <lo_in> <lo>
    row_is() { [ "$(awk -F'\t' -v t="$2" '$1 == t { print $6 " " $7 }' "$B/rec-$1/m1p8-negative-$1.txt")" = "$3 $4" ]; }
    # listed_under <case> <section heading> <test>: the test is a list item in
    # that section of the .md and in no other list section.
    listed_under() {
      local md=$B/rec-$1/m1p8-negative-$1.md
      [ "$(awk -v h="## $2" '$0 == h { on = 1; next } /^## / { on = 0 } on' "$md" | count_matches -xF "- \`$3\`" /dev/stdin)" = 1 ] &&
        [ "$(count_matches -xF "- \`$3\`" "$md")" = 1 ]
    }
    none_under() { [ "$(awk -v h="## $2" '$0 == h { on = 1; next } /^## / { on = 0 } on && NF' "$B/rec-$1/m1p8-negative-$1.md")" = None. ]; }
    SEC_IN="Inputs LibreOffice refuses (allowed: a fixture that is not a workbook)"
    SEC_OUT="Outputs refused on an input LibreOffice accepted (a finding)"
    SEC_ERR="Checks that did not run (error)"
    show_record() {
      echo "  the record's .txt:"; sed 's/^/    /' "$B/rec-$1/m1p8-negative-$1.txt"
      echo "  the record's .md:"; sed 's/^/    /' "$B/rec-$1/m1p8-negative-$1.md"
    }
    show_reasons() {
      local f
      for f in $(find "$B/tmp-$1" -name '*-reason.txt' | LC_ALL=C sort); do
        echo "    reason ${f#"$B/tmp-$1/"}: $(cat "$f")"
      done
    }
    
    echo
    echo "### S1: a planted output that cannot open (the truncated archive)"
    mkdir "$B/keep-s1"
    keep_pair "$B/keep-s1" fixture.sound "$W/healthy.xlsx" "$W/healthy.xlsx"
    keep_pair "$B/keep-s1" fixture.cut "$W/healthy.xlsx" "$W/truncated.xlsx"
    run_oc s1 "$B/keep-s1" "$IMAGE"
    show_record s1
    show_reasons s1
    check "S1: exit 1" "$(yn status_is s1 1)"
    check "S1: the planted pair reads lo_in ok, lo fail" "$(yn row_is s1 fixture.cut ok fail)"
    check "S1: the sound pair reads ok, ok" "$(yn row_is s1 fixture.sound ok ok)"
    check "S1: the planted pair is listed as a finding, and nowhere else" "$(yn listed_under s1 "$SEC_OUT" fixture.cut)"
    check "S1: no input refused, no check errored" "$(yn none_under s1 "$SEC_IN")"
    check "S1: the .txt rows are the keep's files, byte counts and hashes" "$(yn rows_match s1 "$B/keep-s1")"
    
    echo
    echo "### S2: a planted input that cannot open"
    mkdir "$B/keep-s2"
    keep_pair "$B/keep-s2" fixture.sound "$W/healthy.xlsx" "$W/healthy.xlsx"
    keep_pair "$B/keep-s2" fixture.notbook "$W/truncated.xlsx" "$W/truncated.xlsx"
    run_oc s2 "$B/keep-s2" "$IMAGE"
    show_record s2
    show_reasons s2
    check "S2: exit 0" "$(yn status_is s2 0)"
    check "S2: the planted pair reads lo_in fail" "$(yn [ "$(awk -F'\t' '$1 == "fixture.notbook" { print $6 }' "$B/rec-s2/m1p8-negative-s2.txt")" = fail ])"
    check "S2: the planted pair is listed among the refused inputs, and nowhere else" "$(yn listed_under s2 "$SEC_IN" fixture.notbook)"
    check "S2: no finding" "$(yn none_under s2 "$SEC_OUT")"
    check "S2: no check errored" "$(yn none_under s2 "$SEC_ERR")"
    check "S2: the .txt rows are the keep's files" "$(yn rows_match s2 "$B/keep-s2")"
    
    echo
    echo "### S3: an image that is not there"
    echo "command: podman image exists $NO_IMAGE; podman image exists $IMAGE (the control)"
    no_such_image() { if podman image exists "$NO_IMAGE"; then return 1; else return 0; fi; }
    check "S3: the image is not there" "$(yn no_such_image)"
    check "control: the pinned image is there, through the same command" "$(yn podman image exists "$IMAGE")"
    mkdir "$B/keep-s3"
    keep_pair "$B/keep-s3" fixture.sound "$W/healthy.xlsx" "$W/healthy.xlsx"
    run_oc s3 "$B/keep-s3" "$NO_IMAGE"
    show_record s3
    show_reasons s3
    check "S3: exit 2" "$(yn status_is s3 2)"
    check "S3: the pair reads error, error" "$(yn row_is s3 fixture.sound error error)"
    check "S3: the pair is listed among the checks that did not run, and nowhere else" "$(yn listed_under s3 "$SEC_ERR" fixture.sound)"
    podman_reason() { [ "$(find "$B/tmp-s3" -name '*-reason.txt' -exec cat {} + | LC_ALL=C sort -u)" = "podman could not run the container, exit 125" ]; }
    check "S3: both reasons say podman could not run the container" "$(yn podman_reason)"
    check "S3: the .txt rows are the keep's files" "$(yn rows_match s3 "$B/keep-s3")"
    
    echo
    echo "### S4: an empty keep directory"
    mkdir "$B/keep-s4"
    run_oc s4 "$B/keep-s4" "$IMAGE"
    refused_with() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ "$(cat "$B/$1.stderr")" = "$2" ]; }
    check "S4: exit 2, no stdout, stderr exactly the refusal" "$(yn refused_with s4 'error: the keep directory holds no pairs')"
    check "S4: no record written" "$(yn [ "$(find "$B/rec-s4" -type f | wc -l)" = 0 ])"
    check "S4: no reasons directory made" "$(yn [ "$(find "$B/tmp-s4" -mindepth 1 | wc -l)" = 0 ])"
    check "control: the same count finds S1's reasons directory" "$(yn [ "$(find "$B/tmp-s1" -mindepth 1 -maxdepth 1 | wc -l)" = 1 ])"
    
    echo
    echo "### S5 and S6: two refusals beyond the four (no container runs)"
    mkdir "$B/keep-s5"
    cp "$W/healthy.xlsx" "$B/keep-s5/fixture.half.in.xlsx"
    run_oc s5 "$B/keep-s5" "$IMAGE"
    check "S5: half a pair: exit 2, no stdout, stderr exactly the refusal" "$(yn refused_with s5 'error: the keep directory holds half a pair')"
    mkdir -p "$B/rec-s6"
    : >"$B/rec-s6/m1p8-negative-s6.md"
    run_oc s6 "$B/keep-s1" "$IMAGE"
    check "S6: a record already there: exit 2, no stdout, stderr exactly the refusal" "$(yn refused_with s6 'error: the record m1p8-negative-s6 is already there')"
    check "S6: the record already there is untouched (empty)" "$(yn [ ! -s "$B/rec-s6/m1p8-negative-s6.md" ])"
    not_refused() { if refused_with "$1" 'error: the keep directory holds no pairs'; then return 1; else return 0; fi; }
    check "control: refused_with says no on S1's run" "$(yn not_refused s1)"
    
    echo
    echo "## family R: the runner's T3 P3 open-check cases, at the phase commit and at the base"
    echo "command: git worktree add --detach <build>/base-tree <base>"
    git worktree add --detach "$BASETREE" "$REC" >/dev/null 2>&1
    check "the base worktree was added at the base" "$(yn [ "$(git -C "$BASETREE" rev-parse HEAD)" = "$REC" ])"
    base_inline() { [ "$(count_matches -E '^lo_check\(\) \{' "$BASETREE/scripts/passthrough-run.sh")" = 1 ] && [ ! -e "$BASETREE/scripts/lo-check.sh" ]; }
    phase_sources() { [ "$(count_matches -E '^lo_check\(\) \{' scripts/passthrough-run.sh)" = 0 ] && [ "$(count_matches -F '/lo-check.sh"' scripts/passthrough-run.sh)" = 1 ]; }
    check "the base runner defines lo_check inline and has no scripts/lo-check.sh" "$(yn base_inline)"
    check "the phase runner defines no lo_check and sources scripts/lo-check.sh" "$(yn phase_sources)"
    mkdir -p "$B/fakebin" "$B/fakebin-py"
    cat >"$B/fakebin/podman" <<'SH'
    #!/usr/bin/env bash
    # Test wrapper (T3 P3's C8): runs the real podman, then adds one line to stderr.
    /usr/bin/podman "$@"
    rc=$?
    printf '%s\n' "${FAKE_PODMAN_LINE:?}" >&2
    exit "$rc"
    SH
    cat >"$B/fakebin-py/python3" <<'SH'
    #!/usr/bin/env bash
    # Test wrapper (T3 P3's C11): python3 that always fails.
    exit 1
    SH
    chmod 755 "$B/fakebin/podman" "$B/fakebin-py/python3"
    id_of healthy >"$B/ids-healthy"
    field() { awk -F'\t' -v id="$2" -v name="$3" 'NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next } $1 == id { print $col[name] }' "$1"; }
    lo_is() { local s=$1/summary.host.tsv id; id=$(id_of "$2"); [ "$(field "$s" "$id" lo)" = "$3" ] && [ "$(field "$s" "$id" lo_in)" = "$4" ]; }
    all_dash() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next } $col["lo"] == "-" && $col["lo_in"] == "-" { n++ } END { print n + 0 }' "$1/summary.host.tsv")" = "${#NAMES[@]}" ]; }
    reason_held() { [ -s "$1/$(id_of "$2")/$3-reason.host.txt" ]; }
    count_container_words() { cat "$@" | LC_ALL=C "$G" -a -c -E 'Error|Warning|javaldx'; }
    # runner <which> <out name> [extra args...]: the runner of that side over the
    # scratch corpus, stdout and stderr kept beside the run directory.
    runner() {
      local which=$1 out=$2 script
      shift 2
      case $which in
        phase) script=$MAIN/scripts/passthrough-run.sh ;;
        base) script=$BASETREE/scripts/passthrough-run.sh ;;
      esac
      "$script" --label host --passthrough "$PT" --xlsx-diff "$XD" --corpus "$CORPUS" \
        --out "$B/$which/$out" --timeout 120 "$@" >"$B/$which/$out.stdout" 2>"$B/$which/$out.stderr" </dev/null
      echo $? >"$B/$which/$out.status"
    }
    rstatus() { cat "$B/$1/$2.status"; }
    for which in phase base; do
      R=$B/$which
      mkdir -p "$R"
      echo
      echo "### the $which runner"
      echo "command: <the $which runner> --label host --passthrough <build>/target/debug/passthrough --xlsx-diff <build>/target/debug/xlsx-diff --corpus <scratch>/w/corpus --out <scratch>/w/$which/<run> --timeout 120 [--libreoffice $IMAGE] [--ids <scratch>/w/ids-healthy], with PATH changes for C8 and C11"
      runner "$which" run-lo --libreoffice "$IMAGE"
      runner "$which" run-nolo
      FAKE_PODMAN_LINE='Warning: a second warning the allowance does not cover' PATH=$B/fakebin:$PATH \
        runner "$which" run-extra --libreoffice "$IMAGE" --ids "$B/ids-healthy"
      FAKE_PODMAN_LINE='Warning: failed to launch javaldx - java may not function correctly' PATH=$B/fakebin:$PATH \
        runner "$which" run-allowed --libreoffice "$IMAGE" --ids "$B/ids-healthy"
      PATH=$B/fakebin-py:$PATH runner "$which" run-error --libreoffice "$IMAGE" --ids "$B/ids-healthy"
      runner "$which" run-badimage --libreoffice 'not an image!'
      for r in run-lo run-nolo run-extra run-allowed run-error run-badimage; do
        echo "  $r: exit $(rstatus "$which" "$r"); stdout lines $(count_lines "$R/$r.stdout"); stderr bytes $(wc -c <"$R/$r.stderr")"
      done
      echo "  outcome, lo and lo_in per workbook (run-lo):"
      for name in "${NAMES[@]}"; do
        printf '    %-9s outcome=%s lo=%s lo_in=%s\n' "$name" "$(field "$R/run-lo/summary.host.tsv" "$(id_of "$name")" outcome)" \
          "$(field "$R/run-lo/summary.host.tsv" "$(id_of "$name")" lo)" "$(field "$R/run-lo/summary.host.tsv" "$(id_of "$name")" lo_in)"
      done
      check "[$which] C1: the run exits 0" "$(yn [ "$(rstatus "$which" run-lo)" = 0 ])"
      check "[$which] C1 healthy: lo ok, lo_in ok" "$(yn lo_is "$R/run-lo" healthy ok ok)"
      check "[$which] C2 truncated: lo_in fail" "$(yn [ "$(field "$R/run-lo/summary.host.tsv" "$(id_of truncated)" lo_in)" = fail ])"
      check "[$which] C2 truncated: the reason is kept in the run subdirectory" "$(yn reason_held "$R/run-lo" truncated lo-in)"
      check "[$which] C3 noct: lo_in fail" "$(yn [ "$(field "$R/run-lo/summary.host.tsv" "$(id_of noct)" lo_in)" = fail ])"
      check "[$which] C4 ghost: lo ok and lo_in ok (T3 P3's recorded finding)" "$(yn lo_is "$R/run-lo" ghost ok ok)"
      check "[$which] C5 nopart: lo ok and lo_in ok (the same finding)" "$(yn lo_is "$R/run-lo" nopart ok ok)"
      echo "  [$which] C6 badxml, as measured: lo=$(field "$R/run-lo/summary.host.tsv" "$(id_of badxml)" lo) lo_in=$(field "$R/run-lo/summary.host.tsv" "$(id_of badxml)" lo_in)"
      run_all_dash() { [ "$(rstatus "$which" run-nolo)" = 0 ] && all_dash "$R/run-nolo"; }
      check "[$which] C7: without --libreoffice the run exits 0 and every row has lo and lo_in \"-\"" "$(yn run_all_dash)"
      check "[$which] C8a: a second Warning line fails the healthy workbook on both sides" "$(yn lo_is "$R/run-extra" healthy fail fail)"
      check "[$which] C8b: the allowed line repeated still passes" "$(yn lo_is "$R/run-allowed" healthy ok ok)"
      OUTS=("$R/run-lo.stdout" "$R/run-lo.stderr" "$R/run-nolo.stdout" "$R/run-nolo.stderr" "$R/run-extra.stdout" "$R/run-extra.stderr" "$R/run-allowed.stdout" "$R/run-allowed.stderr")
      n=$(count_container_words "${OUTS[@]}")
      check "[$which] C9: lines with Error, Warning or javaldx in the runner's stdout and stderr: $n (expect 0)" "$(yn [ "$n" = 0 ])"
      nctl=$(count_container_words "$R/run-lo/$(id_of truncated)/lo-in.host/stderr.txt")
      check "[$which] control: the same count finds the container's lines in the stderr file kept in the run directory ($nctl)" "$(yn [ "$nctl" -ge 1 ])"
      check "[$which] C11: python3 failing reads error on both sides, not fail" "$(yn lo_is "$R/run-error" healthy error error)"
      c11_reason() { [ "$(cat "$R/run-error/$(id_of healthy)/lo-in-reason.host.txt")" = "cannot count sheets and tables" ]; }
      check "[$which] C11: the reason names the count step" "$(yn c11_reason)"
      c12_refused() { [ "$(rstatus "$which" run-badimage)" = 2 ] && [ ! -s "$R/run-badimage.stdout" ] && [ "$(cat "$R/run-badimage.stderr")" = 'error: --libreoffice must name an image' ] && [ ! -e "$R/run-badimage" ]; }
      check "[$which] C12: exit 2, no stdout, stderr exactly the refusal, no run directory" "$(yn c12_refused)"
    done
    
    echo
    echo "### the two runners compared"
    # The summary's outcome, lo and lo_in columns per run, and every reason file,
    # byte for byte. Other columns (timings, commit) differ by nature.
    cols() { awk -F'\t' -v OFS='\t' 'NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i } { print $col["id"], $col["outcome"], $col["lo"], $col["lo_in"] }' "$1"; }
    same_cols=0
    nruns=0
    for r in run-lo run-nolo run-extra run-allowed run-error; do
      nruns=$((nruns + 1))
      cols "$B/phase/$r/summary.host.tsv" >"$B/cols-phase-$r"
      cols "$B/base/$r/summary.host.tsv" >"$B/cols-base-$r"
      if cmp -s "$B/cols-phase-$r" "$B/cols-base-$r"; then same_cols=$((same_cols + 1)); else echo "    $r: the columns differ"; fi
    done
    echo "  runs whose id, outcome, lo and lo_in columns are the same on both runners: $same_cols of $nruns"
    check "every run's id, outcome, lo and lo_in columns are the same on both runners" "$(yn [ "$same_cols" = "$nruns" ])"
    (cd "$B/phase" && find . -name '*-reason.host.txt' | LC_ALL=C sort) >"$B/reasons-phase"
    (cd "$B/base" && find . -name '*-reason.host.txt' | LC_ALL=C sort) >"$B/reasons-base"
    nreasons=$(count_lines "$B/reasons-phase")
    same_reasons=0
    while IFS= read -r f; do
      if cmp -s "$B/phase/$f" "$B/base/$f"; then same_reasons=$((same_reasons + 1)); else echo "    $f differs"; fi
    done <"$B/reasons-phase"
    echo "  reason files: phase $nreasons, base $(count_lines "$B/reasons-base"); the same bytes on both: $same_reasons"
    reasons_same() { cmp -s "$B/reasons-phase" "$B/reasons-base" && [ "$nreasons" -ge 1 ] && [ "$same_reasons" = "$nreasons" ]; }
    check "both runners kept the same reason files, byte for byte" "$(yn reasons_same)"
    echo "  the verdicts compared, as run-lo gave them (id, outcome, lo, lo_in):"
    sed 's/^/    /' "$B/cols-phase-run-lo"
    cols_ctl() { if cmp -s "$B/cols-phase-run-lo" "$B/cols-phase-run-extra"; then return 1; else return 0; fi; }
    check "control: the same comparison tells run-lo from run-extra" "$(yn cols_ctl)"
    verdicts_seen() {
      cat "$B"/cols-phase-* | awk -F'\t' '{ print $3; print $4 }' | LC_ALL=C "$G" -xE 'ok|fail|error' | LC_ALL=C sort -u | tr '\n' ' '
    }
    echo "  lo and lo_in verdicts the compared runs hold: $(verdicts_seen)"
    check "the compared runs hold ok, fail and error" "$(yn [ "$(verdicts_seen)" = "error fail ok " ])"
    git worktree remove --force "$BASETREE" >/dev/null 2>&1
    check "the base worktree is gone from git's list" "$(yn [ "$(git worktree list --porcelain | count_matches -F "$BASETREE" /dev/stdin)" = 0 ])"
    
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.stdout "$B"/*.stderr "$B"/phase/*.stdout "$B"/phase/*.stderr "$B"/base/*.stdout "$B"/base/*.stderr; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs, its record pair or planning's uncommitted spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

