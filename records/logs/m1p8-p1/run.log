    sed 's/^/    /' "$B/nowb-tool.pairs"
    check "ruling 8: the refused tool inputs are exactly the tool pairs whose kept input has no xl/workbook.xml entry" "$(yn cmp -s "$B/refused-tool.pairs" "$B/nowb-tool.pairs")"
    sed -E 's/\.[0-9]+$//' "$B/refused-tool.pairs" | LC_ALL=C sort -u >"$B/refused-tool.tests"
    sed -E 's/\.[0-9]+$//' "$B/nowb-tool.pairs" | LC_ALL=C sort -u >"$B/nowb-tool.tests"
    echo "  as tests: refused $(count_lines "$B/refused-tool.tests"); without the entry $(count_lines "$B/nowb-tool.tests")"
    check "ruling 8: the same, as sets of tests" "$(yn cmp -s "$B/refused-tool.tests" "$B/nowb-tool.tests")"
    some_refused() { [ "$(count_lines "$B/refused-tool.pairs")" -ge 1 ]; }
    check "ruling 8's set is not empty, so the comparison compares something" "$(yn some_refused)"
    python3 -c '
    import sys, zipfile
    with zipfile.ZipFile(sys.argv[1] + "/with.in.xlsx", "w") as z: z.writestr("xl/workbook.xml", "<workbook/>")
