        try:
            names = zipfile.ZipFile(path).namelist()
            print("%s\t%s" % (path.rsplit("/", 1)[1][: -len(".in.xlsx")], "yes" if "xl/workbook.xml" in names else "no"))
        except zipfile.BadZipFile:
            print("%s\tunreadable" % path.rsplit("/", 1)[1][: -len(".in.xlsx")])
    PY
