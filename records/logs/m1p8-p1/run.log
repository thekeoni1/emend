    awk -F'\t' '$1 == "tool" && $3 == "fail" { print $2 }' "$B/verdicts" | LC_ALL=C sort >"$B/refused-tool.pairs"
    LC_ALL=C "$G" '^emend-copy\.' "$B/nowb.pairs" | LC_ALL=C sort >"$B/nowb-tool.pairs"
    echo "  tool pairs whose input LibreOffice refused:"
    sed 's/^/    /' "$B/refused-tool.pairs"
