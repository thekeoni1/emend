    #!/usr/bin/env bash
    # Milestone 1 part 8 P1 run.log (specs/0015-open-checks.md, "### P1", with
    # planning's rulings 1 to 8 of 2026-09-23): cargo test for the workspace on
    # the host and on i686-unknown-linux-musl with EMEND_KEEP_DIR naming a fresh
    # keep directory for each; the same test counts and names as the phase's run
    # without the variable; the two keep directories compared byte for byte;
    # scripts/edit-open-check.sh on the host keep, writing the record pair
    # m1p8-open-<utc-date>-<shortsha>.md and .txt; the record checked against the
    # keep's files, row by row; the kept tests against the tests that reach
    # `written` and `emend_copy` with a successful write, counted from the source
    # by this log; the acceptance (no output refused on an accepted input, every
    # kept test named in the record); and ruling 8 (the refused tool inputs are
    # exactly the tool tests whose kept input has no xl/workbook.xml entry, derived
    # from the kept files).
    #
    # WRITTEN FOR M1 part 8 P1 from part 7 P2's run script (printed in
    # records/logs/m1p7-p2/run.log), keeping its rules: lines 1 to 3 are the
    # command, the invocation and "about:"; the shape greps with controls; the
    # phase's commits by role, by subject; a root line for every root; the
    # SERIALIZED line; no count the phase can grow is typed, and every expected
    # set is derived. What differs, and why:
    #  1. No corpus is read. The inputs are the tests' own fixtures, which the
    #     keep writes; they are fictional or generated (specs/0015, "The keep").
    #  2. The build is cargo test's, into <home>/.cache/emend-build/m1p8-p1-run
    #     on the disk, not /tmp, a tmpfs that filled during gate.log's first
    #     attempt.
    #  3. "the same test counts as the gate's run without it": the gate's
    #     check.sh prints PASS lines, not counts, so the counts and names without
    #     the variable are read from this phase's test.log (both targets, the
    #     variable unset), which the caller passes as the second argument; its
    #     about line must name this phase commit.
    #  4. The source count is reach.py's, printed below with its sha256: the
    #     #[test] functions of each file that reach `written` (package tests),
    #     `keep` (the cells test) or `emend_copy` (the tool's tests), through
    #     functions of the same file; less those whose body names override_keep
    #     (they point the keep at their own directory or at none) and those
    #     carrying #[should_panic]; for the tool, less those that never assert a
    #     run's exit status 0 on the way (a refused run is not kept, ruling 4).
    #  5. The record pair is written into <scratch>/p1/out/records; the caller
    #     moves it to records/ with the logs.
    #  6. Planning's rulings 7 and 8 sit in specs/0015 uncommitted: the status
    #     checks allow that one path, printed as planning's uncommitted spec, and
    #     this phase's logs and record pair; nothing else may differ.
    #
    # Usage: m1p8-p1-run.sh <phase commit> <this phase's test.log> > <scratch file>
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    TEST_LOG=${2:?this phase test.log required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    SPEC_SHA=f5ca180a39d8fb1efcae218823a6b649d7822bca62a37332ee73079facaaf214
    BUILD_ROOT=$HOME/.cache/emend-build/m1p8-p1-run
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    RECORDS=$SELF_DIR/out/records
    REACH=$SELF_DIR/reach.py
    B=$(mktemp -d)
    trap 'rm -rf "$B"' EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    TAB=$(printf '\t')
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    OURS='^((\?\?| ?[MARCD]) records/logs/m1p8-p1|(\?\?| ?[MARCD]) records/m1p8-open-| M specs/0015-open-checks[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's records and planning's spec" >&2
      exit 2
    fi
    SHORT=$(git rev-parse --short=7 "$C")
    STEM="m1p8-open-$(date -u +%Y-%m-%d)-$SHORT"
    mkdir -p "$RECORDS" || exit 2
    if [ -e "$RECORDS/$STEM.md" ] || [ -e "$RECORDS/$STEM.txt" ]; then
      echo "the record $STEM is already in <scratch>/p1/out/records; move it to superseded first" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p1#g" -e "s#$BUILD_ROOT#<build>#g" \
        -e "s#$B#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scratch>/p1/$(basename "$0") $*"
    echo "about: M1 part 8 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M1 part 7 close-out record:')
    DOC1=$(by_subject 'M1 part 8 P1: commit planning docs (the part 7 close-out rulings, the part 8 spec)')
    DOC2=$(by_subject 'M1 part 8 P1: commit planning docs (the P1 rulings before code)')
    CODE1=$(by_subject "M1 part 8 P1: the keep in the crate's tests")
    CODE2=$(by_subject "M1 part 8 P1: the keep in the tool's tests")
    CODE3=$(by_subject 'M1 part 8 P1: the open check moves to scripts/lo-check.sh')
    CODE4=$(by_subject 'M1 part 8 P1: scripts/edit-open-check.sh')
    CODE5=$(by_subject "M1 part 8 P1: real content types in the tool's package fixtures")
    CODE6=$(by_subject "M1 part 8 P1: the open-check script's scratch rows file is .txt")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  the part 7 close-out record commit (the base): ${REC:-none}"
    echo "  the first doc commit: ${DOC1:-none}"
    echo "  the second doc commit: ${DOC2:-none}"
    for k in 1 2 3 4 5 6; do var=CODE$k; echo "  code commit $k: ${!var:-none}"; done
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~8"
    for k in 0 1 2 3 4 5 6 7 8; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CODE6" "$CODE5" "$CODE4" "$CODE3" "$CODE2" "$CODE1" "$DOC2" "$DOC1" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "code commits 6 to 1, the second and first doc commits and the base, each the next one's parent, the last code commit the phase commit" "$(yn roles_in_order)"
    roles_ctl() { local CODE1=$CODE2; if roles_in_order; then return 1; else return 0; fi; }
    check "control: roles_in_order refuses code commit 2 named as code commit 1" "$(yn roles_ctl)"
    echo
    echo "phase: Milestone 1 part 8 P1 (specs/0015-open-checks.md) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    n_podman=$(pgrep -x podman | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc: $n_rustc; podman: $n_podman; this run used its own target directory, <build>/target (CARGO_TARGET_DIR)"
    check "no cargo, rustc or podman process was running at entry" "$(yn [ "$((n_cargo + n_rustc + n_podman))" = 0 ])"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh is sourced from it and scripts/edit-open-check.sh, which sources scripts/lo-check.sh, is run from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p1 stands for this script's own directory: the script, reach.py, this phase's test.log (out/test.log) and the record pair's directory (out/records)"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory (the two keep directories, the script's reasons directory), removed at exit"
    echo "root: <build> stands for <home>/.cache/emend-build/m1p8-p1-run on the disk; the tests build into <build>/target"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      apart "$B" "$SELF_DIR" && apart "$B" "$BUILD_ROOT" && apart "$B" "$MAIN" &&
        apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR"
    }
    check "the roots other than <home> are distinct, none inside another" "$(yn roots_distinct)"
    roots_ctl() { if apart "$RECORDS" "$SELF_DIR"; then return 1; else return 0; fi; }
    check "control: apart refuses <scratch>/p1/out/records against <scratch>/p1, which holds it" "$(yn roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    echo "image: $IMAGE (rootless podman, --network=none); podman: $(podman --version); $(rustc --version)"
    echo "at entry: status lines $entry_all; of them this phase's records or planning's spec $entry_ours"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    echo "the record stem: $STEM (the UTC date at run and the phase commit's seven-digit short sha)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the source counter this log runs (<scratch>/p1/reach.py, sha256 $(sha256sum <"$REACH" | cut -d' ' -f1))"
    sed 's/^/    /' "$REACH"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts and the tests, against the phase commit"
    tree_is_commit() { [ "$(sha256sum <"$1" | cut -d' ' -f1)" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/edit-open-check.sh scripts/lo-check.sh crates/emend/src/testing.rs crates/emend/src/package/tests.rs crates/emend/src/cells/tests.rs tools/emend-copy/tests/null_rewrite.rs; do
      check "$s in the main tree is the phase commit's (sha256 $(sha256sum <"$s" | cut -d' ' -f1))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { if [ "$(git show "$REC:scripts/passthrough-run.sh" | sha256sum | cut -d' ' -f1)" = "$(sha256sum <scripts/passthrough-run.sh | cut -d' ' -f1)" ]; then return 1; else return 0; fi; }
    check "control: the same hash comparison tells the base's scripts/passthrough-run.sh from the tree's" "$(yn tree_ctl)"
    spec_now=$(sha256sum <specs/0015-open-checks.md | cut -d' ' -f1)
    echo "  planning's uncommitted spec: specs/0015-open-checks.md, sha256 $spec_now (rulings 7 and 8; expected $SPEC_SHA)"
    check "planning's uncommitted spec is the one planning named" "$(yn [ "$spec_now" = "$SPEC_SHA" ])"
    
    echo
    echo "## the phase's run without the variable, read from its test.log"
    echo "command: read <scratch>/p1/out/test.log (sha256 $(sha256sum <"$TEST_LOG" | cut -d' ' -f1), $(wc -c <"$TEST_LOG") bytes)"
    tl_is_phase() { [ "$(count_matches -E "^about: M1 part 8 P1 phase commit $C; HEAD at run: $C\$" "$TEST_LOG")" = 1 ]; }
    check "the test.log read is this phase's, at this phase commit" "$(yn tl_is_phase)"
    tl_ctl() { local C=$NULL_SHA; if tl_is_phase; then return 1; else return 0; fi; }
    check "control: the same check says no for the null commit" "$(yn tl_ctl)"
    tl_unset() { [ "$(count_matches -xF 'EMEND_KEEP_DIR set when this script started: no; unset for the whole log (header change 5): yes' "$TEST_LOG")" = 1 ]; }
    check "the test.log ran with the variable unset" "$(yn tl_unset)"
    tl_all_yes() { [ "$(count_matches -xF 'test log checks all as expected: yes' "$TEST_LOG")" = 1 ]; }
    check "the test.log ends all as expected" "$(yn tl_all_yes)"
    for target in host i686-unknown-linux-musl; do
      awk -v h="## cargo test --workspace ($target)" '
        $0 == h { on = 1; next }
        /^## / { on = 0 }
        on && /^    test .* \.\.\. ok$/ { sub(/^    test /, ""); sub(/ \.\.\. ok$/, ""); print }
      ' "$TEST_LOG" | sort >"$B/unset-$target.names"
      sed -n "s/^$target: passed \\([0-9]*\\); failed 0; ignored \\([0-9]*\\); test lines ending ok: [0-9]*\$/\\1 \\2/p" "$TEST_LOG" >"$B/unset-$target.count"
      echo "  $target without the variable: passed and ignored $(cat "$B/unset-$target.count"); names read $(count_lines "$B/unset-$target.names")"
      names_match_count() { [ -s "$B/unset-$target.count" ] && [ "$(count_lines "$B/unset-$target.names")" = "$(cut -d' ' -f1 "$B/unset-$target.count")" ]; }
      check "$target: the names read account for the passed count read" "$(yn names_match_count)"
    done
    
    echo
    echo "## the tests with the variable set, one keep directory per target"
    mkdir "$B/keep-host" "$B/keep-i686"
    for target in host i686-unknown-linux-musl; do
      case $target in host) K=$B/keep-host; targs=() ;; *) K=$B/keep-i686; targs=(--target "$target") ;; esac
      echo
      echo "### cargo test --workspace ($target), EMEND_KEEP_DIR=<scratch>/w/${K##*/}"
      echo "command: EMEND_KEEP_DIR=<scratch>/w/${K##*/} cargo test --workspace ${targs[*]}"
      EMEND_KEEP_DIR=$K cargo test --workspace "${targs[@]}" >"$B/$target.out" 2>&1 </dev/null
      rc=$?
      echo "  exit: $rc"
      check "$target: exit 0" "$(yn [ "$rc" -eq 0 ])"
      echo "  summary lines:"
      LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$B/$target.out" | sed 's/^ */    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$B/$target.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$B/set-$target.names"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      ignored=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^ignored;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      echo "  $target with the variable: passed $passed; failed $failed; ignored $ignored; test lines ending ok $(count_lines "$B/set-$target.names")"
      check "$target: failed is 0" "$(yn [ "$failed" = 0 ])"
      check "$target: passed and ignored are the run's without the variable ($(cat "$B/unset-$target.count"))" "$(yn [ "$passed $ignored" = "$(cat "$B/unset-$target.count")" ])"
      check "$target: the test names that passed are the run's without the variable" "$(yn cmp -s "$B/set-$target.names" "$B/unset-$target.names")"
      echo "  files in the keep: $(find "$K" -type f | wc -l); entries that are not regular files: $(find "$K" -mindepth 1 ! -type f | wc -l)"
    done
    { head -n 1 "$B/unset-host.names"; cat "$B/unset-host.names"; } | sort >"$B/c-names"
    cmp_ctl() { if cmp -s "$B/c-names" "$B/unset-host.names"; then return 1; else return 0; fi; }
    check "control: the same comparison tells a name list with one name doubled from the real one" "$(yn cmp_ctl)"
    
    echo
    echo "## the two keep directories compared"
    (cd "$B/keep-host" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/host.files"
    (cd "$B/keep-i686" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/i686.files"
    nfiles=$(count_lines "$B/host.files")
    same=0
    while IFS= read -r f; do
      if cmp -s "$B/keep-host/$f" "$B/keep-i686/$f"; then same=$((same + 1)); else echo "    differs: $f"; fi
