    no_path_but_reasons() { [ "$(cat "$TXT" "$MD" | count_matches -F "$B" /dev/stdin)" = 0 ] && [ "$(cat "$TXT" "$MD" | count_matches -F "$HOME" /dev/stdin)" = 0 ] && [ "$(cat "$TXT" "$MD" | count_matches -F "/tmp" /dev/stdin)" = 0 ] && [ "$(LC_ALL=C "$G" -v '^reasons: ' "$B/oc.stdout" | count_matches -F "$B" /dev/stdin)" = 0 ]; }
