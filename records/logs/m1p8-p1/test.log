    #!/usr/bin/env bash
    # Milestone 1 part 8 P1 test.log (specs/0015-open-checks.md, "### P1", with
    # "Planning rulings during P1 (2026-09-23)" 1 to 8): cargo test for the
    # workspace on the host and with --target i686-unknown-linux-musl, colour off,
    # with EMEND_KEEP_DIR unset; the tests this phase adds, derived from the
    # source and found by name in both runs; the tests each code commit adds,
    # against what its message says; each test case "### P1" and the rulings name,
    # mapped to the test that holds it; that no test sets the variable; the
    # ignored tests against the base; the mutations K1 to K5 of the keep, each
    # planted in a detached worktree and run, with the failing tests printed. The
    # runs WITH the variable set are run.log's. Each check is evaluated once
    # (specs/0001: a check with more than one condition lives in one function
    # that returns yes or no).
    #
    # WRITTEN FOR M1 part 8 P1 from part 7 P2's final test script (the script
    # printed in records/logs/m1p7-p2/test.log), audited against specs/0001
    # "Rules for every phase", specs/0013's rulings, specs/0014's P2
    # verification rulings 4, 5 and 7 and specs/0015's P1 rulings, and grepped
    # for part 7's names, paths and subjects. What differs from that one, and why:
    #  1. The phase, the log directory and the status terms are part 8 P1's
    #     (records/logs/m1p8-p1); the previous phase's figures and names are read
    #     from records/logs/m1p7-p2/test.log.
    #  2. The commits by role, as gate.log resolves them: the part 7 close-out
    #     record commit (the base), two doc commits and six code commits, each by
    #     its full subject, all beginning "M1 part 8 P1: ". No id is typed.
    #  3. The xlsx-diff blocks (p7 by name, the pinned hash, ruling 8's probes)
    #     are dropped: this phase changes no xlsx-diff file. In their place: the
    #     tests each code commit adds, derived per commit from the source, beside
    #     the count its message states ("Eight new tests", "Five new tests");
    #     the case map for the keep (the three cases of "### P1" and rulings 2 to
    #     4); and a source check that no test sets EMEND_KEEP_DIR (ruling 3).
    #  4. The mutations are the keep's: K1 the refusal of a name already there
    #     removed, K2 written's fixture checks switched off, K4 the thread-local
    #     override ignored, K5 the pair counter stuck at 1, each expected to fail
    #     the test named; K3, the tool keep's exit-status condition removed, is
    #     MEASURED, not expected to bite, because a refused run of the tool writes
    #     no output file and the keep's other condition (the output is a file)
    #     already stops it; the log prints what happens.
    #  5. The variable is unset for this whole log, and the log says so, so a
    #     run from a shell that has it set cannot keep anything here.
    #  6. Build directories: the log builds on the disk, under
    #     <home>/.cache/emend-build/m1p8-p1-test, not in /tmp (a tmpfs that
    #     filled during gate.log's first attempt); the mutation worktree and its
    #     target live there too. Each root has its own line.
    #  7. Planning's rulings 7 and 8 sit in specs/0015 uncommitted; the entry
    #     guard and the status block allow that one path and nothing else but
    #     this phase's logs and record pair.
    #  8. Everything else is part 7 P2's final form: lines 1 to 3 are the
    #     command, the invocation and "about:"; the three shape greps with
    #     controls; the by-name comparison with the previous log; the added and
    #     ignored tests derived from the source; the comparison of the two
    #     targets. No count the phase can grow is typed. None of the three shapes
    #     specs/0001 forbids appears here.
    #
    # Usage: m1p8-p1-test.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m1p8-p1/test.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    KEEP_WAS_SET=$([ -n "${EMEND_KEEP_DIR+x}" ] && echo yes || echo no)
    unset EMEND_KEEP_DIR
    BUILD_ROOT=$HOME/.cache/emend-build/m1p8-p1-test
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    T=$(mktemp -d)
    MUTTREE=$(mktemp -d "$BUILD_ROOT/mut.XXXXXX")
    cleanup_worktree() {
      git worktree remove --force "$MUTTREE/tree" >/dev/null 2>&1
      rm -rf "$MUTTREE"
    }
    trap 'cleanup_worktree; rm -rf "$T"' EXIT INT TERM HUP
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    passed_matches() { [ "$passed" -gt 0 ] && [ "$passed" -eq "$nok" ]; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    
    # The entry guard: every change must be this phase's log directory, its record
    # pair or planning's uncommitted spec (header change 7).
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E '^((\?\?| ?[MARCD]) records/logs/m1p8-p1|(\?\?| ?[MARCD]) records/m1p8-open-| M specs/0015-open-checks[.]md$)' git status --porcelain)
    entry_clean() {
      [ "$entry_all" != error ] && [ "$entry_ours" != error ] &&
        [ "$entry_all" = "$entry_ours" ]
    }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's records and planning's spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p1#g" -e "s#$MUTTREE#<build>/mut#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$T#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    inv_path=$0
    case "$inv_path" in
      "$MAIN"/*) inv_path="<repo>/${inv_path#"$MAIN"/}" ;;
      /*) inv_path="<scratch>/p1/$(basename "$inv_path")" ;;
    esac
    echo "invocation: bash $inv_path $*"
    echo "about: M1 part 8 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    SHAPE_DIR=$(mktemp -d)
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$SHAPE_DIR/fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$SHAPE_DIR/fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      SHAPE_RESULT_SELF=$n_self
      SHAPE_RESULT_FIX=$n_fix
      check "$shape: this script holds none" "$(yn [ "$SHAPE_RESULT_SELF" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$SHAPE_RESULT_FIX" = 1 ])"
    done
    rm -rf "$SHAPE_DIR"
    
    echo
    echo "## the phase's commits by role, read from git (header change 2)"
    check_fn() { local label=$1; shift; check "$label" "$(yn "$@")"; }
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M1 part 7 close-out record:')
    DOC1=$(by_subject 'M1 part 8 P1: commit planning docs (the part 7 close-out rulings, the part 8 spec)')
    DOC2=$(by_subject 'M1 part 8 P1: commit planning docs (the P1 rulings before code)')
    CODE1=$(by_subject "M1 part 8 P1: the keep in the crate's tests")
    CODE2=$(by_subject "M1 part 8 P1: the keep in the tool's tests")
    CODE3=$(by_subject 'M1 part 8 P1: the open check moves to scripts/lo-check.sh')
    CODE4=$(by_subject 'M1 part 8 P1: scripts/edit-open-check.sh')
    CODE5=$(by_subject "M1 part 8 P1: real content types in the tool's package fixtures")
    CODE6=$(by_subject "M1 part 8 P1: the open-check script's scratch rows file is .txt")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  the part 7 close-out record commit: ${REC:-none}"
    echo "  the first doc commit: ${DOC1:-none}"
    echo "  the second doc commit: ${DOC2:-none}"
    for k in 1 2 3 4 5 6; do var=CODE$k; echo "  code commit $k: ${!var:-none}"; done
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~8"
    for k in 0 1 2 3 4 5 6 7 8; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r
      for r in "$REC" "$DOC1" "$DOC2" "$CODE1" "$CODE2" "$CODE3" "$CODE4" "$CODE5" "$CODE6"; do
        [ -n "$r" ] || return 1
      done
      [ "$CODE6" = "$C" ] || return 1
      [ "$(git rev-parse "$C~1")" = "$CODE5" ] || return 1
      [ "$(git rev-parse "$C~2")" = "$CODE4" ] || return 1
      [ "$(git rev-parse "$C~3")" = "$CODE3" ] || return 1
      [ "$(git rev-parse "$C~4")" = "$CODE2" ] || return 1
      [ "$(git rev-parse "$C~5")" = "$CODE1" ] || return 1
      [ "$(git rev-parse "$C~6")" = "$DOC2" ] || return 1
      [ "$(git rev-parse "$C~7")" = "$DOC1" ] || return 1
      [ "$(git rev-parse "$C~8")" = "$REC" ]
    }
    check_fn "code commits 6 to 1, the second and first doc commits and the part 7 close-out record commit, each the next one's parent" roles_in_order
    roles_ctl1() { local CODE1=$CODE2; if roles_in_order; then return 1; else return 0; fi; }
    check_fn "control: roles_in_order refuses code commit 2 named as code commit 1" roles_ctl1
    git log --format='%s' "$REC..$C" >"$T/subjects"
    nsub=$(count_lines "$T/subjects")
    nprefix=$(count_matches -E '^M1 part 8 P1: ' "$T/subjects")
    echo "command: git log --format=%s <part 7 close-out record commit>..<phase commit>"
    sed 's/^/    /' "$T/subjects"
    echo "  subjects in the range: $nsub; beginning \"M1 part 8 P1: \": $nprefix"
    prefix_all() { [ "$nsub" -ge 1 ] && [ "$nsub" = "$nprefix" ]; }
    check_fn "every commit in the range carries the phase's subject prefix" prefix_all
    printf 'M1 part 8 P1: x\nM1 part 7 P2: y\n' >"$T/c-subjects"
    check "control: the same count finds one prefixed subject of two" "$(yn [ "$(count_matches -E '^M1 part 8 P1: ' "$T/c-subjects")" = 1 ])"
    no_such_subject() { [ -z "$(by_subject 'M1 part 8 P1: no such subject anywhere')" ]; }
    check_fn "control: a subject no commit has resolves to nothing" no_such_subject
    echo "phase: Milestone 1 part 8 P1 (specs/0015-open-checks.md) test.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory, <build>/target (CARGO_TARGET_DIR)"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to (it lies inside <home>, so it is scrubbed first); scripts/counting.sh is sourced from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p1 stands for this script's own directory, which holds the script"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory, a directory distinct from <scratch>/p1"
    echo "root: <build> stands for <home>/.cache/emend-build/m1p8-p1-test, this log's build directory's parent on the disk (header change 6); the runs build into <build>/target"
    echo "root: <build>/mut stands for this run's mktemp -d mutation directory inside <build> (its worktree and its own target), distinct from <build>/target"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      apart "$T" "$SELF_DIR" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$T" "$BUILD_ROOT" &&
        apart "$MAIN" "$SELF_DIR" && apart "$MAIN" "$T" && apart "$MAIN" "$BUILD_ROOT" &&
        apart "$MUTTREE" "$CARGO_TARGET_DIR"
    }
    check "the directory roots other than <home> are distinct, none inside another (the mutation directory apart from <build>/target)" "$(yn roots_distinct)"
    roots_ctl() { if apart "$MUTTREE" "$BUILD_ROOT"; then return 1; else return 0; fi; }
    check "control: apart refuses the mutation directory against <build>, which holds it" "$(yn roots_ctl)"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR; CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS; $(rustc --version)"
    echo "EMEND_KEEP_DIR set when this script started: $KEEP_WAS_SET; unset for the whole log (header change 5): $([ -n "${EMEND_KEEP_DIR+x}" ] && echo no || echo yes)"
    echo "at entry: status lines $entry_all; of them this phase's records or planning's spec $entry_ours"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    check "control: the same comparison against a short sha of the real commit says no" \
      "$(yn not_head "$(printf '%s' "$C" | cut -c1-7)")"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    for target in host i686-unknown-linux-musl; do
      echo
      echo "## cargo test --workspace ($target)"
      if [ "$target" = host ]; then
        echo "command: cargo test --workspace"
        cargo test --workspace >"$T/$target.out" 2>&1 </dev/null
      else
        echo "command: cargo test --workspace --target $target"
        cargo test --workspace --target "$target" >"$T/$target.out" 2>&1 </dev/null
      fi
      rc=$?
      echo "exit: $rc"
      check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
      echo "Running lines, test lines and summary lines:"
      LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test .* \.\.\. |^test result: ' "$T/$target.out" | sed 's/^ */    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/$target.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/$target.names"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      ignored=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^ignored;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      nok=$(count_lines "$T/$target.names")
      echo "$target: passed $passed; failed $failed; ignored $ignored; test lines ending ok: $nok"
      check "$target: failed is 0" "$(yn [ "$failed" -eq 0 ])"
      check "$target: passed is more than 0 and equals the ok test lines" "$(yn passed_matches)"
      n=$(count_bytes "$CTRL_CLASS" "$T/$target.out")
      check "$target: control bytes in the cargo output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
      echo "$passed" >"$T/$target.count"
    done
    
    echo
    echo "## the tests per binary"
    per_binary() {
      awk '
        /^ *Running / {
          path = $NF
          gsub(/[()]/, "", path)
          parts = split(path, piece, "/")
          label = piece[parts]
          sub(/-[0-9a-f]+$/, "", label)
          current = (($2 == "unittests") ? "unittests " : "integration ") label
          next
        }
        /^ *Doc-tests / { current = "doc-tests " $2; next }
        /^test result: / {
          if (current == "") next
          for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n = $i
          printf "%s %d\n", current, n
          current = ""
        }
      ' "$1" | sort
    }
    for target in host i686-unknown-linux-musl; do
      per_binary "$T/$target.out" >"$T/$target.per"
    done
    sed 's/^/    /' "$T/host.per"
    sum_per=$(awk '{ n += $NF } END { print n + 0 }' "$T/host.per")
    echo "  the per-binary counts sum to $sum_per; the run's own passed total was $(cat "$T/host.count")"
    check "the per-binary counts sum to the run's passed total" \
      "$(yn [ "$sum_per" = "$(cat "$T/host.count")" ])"
    check "the two targets produce the same per-binary breakdown" \
      "$(yn cmp -s "$T/host.per" "$T/i686-unknown-linux-musl.per")"
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n' >"$T/c-per"
    per_binary "$T/c-per" >"$T/c-per.out"
    nctl_per=$(count_lines "$T/c-per.out")
    echo "  control: a result line with no Running line above it yields $nctl_per rows"
    check "control: the per-binary form attributes nothing to a binary it never saw named" \
      "$(yn [ "$nctl_per" = 0 ])"
    printf '     Running unittests src/lib.rs (target/debug/deps/libctl-0123456789abcdef)\ntest result: ok. 7 passed; 0 failed; 0 ignored\n' >"$T/c-per-hit"
    per_binary "$T/c-per-hit" >"$T/c-per-hit.out"
    sed 's/^/    control row: /' "$T/c-per-hit.out"
    check "control: a Running line and its result yield one row naming the crate and its count" \
      "$(yn [ "$(cat "$T/c-per-hit.out")" = "unittests libctl 7" ])"
    PREV_LOG=records/logs/m1p7-p2/test.log
    PREV_TOTAL=$(sed -n 's/^host executed \([0-9]*\) tests;.*/\1/p' "$PREV_LOG")
    NOW_TOTAL=$(cat "$T/host.count")
    echo "  the workspace total: this phase $NOW_TOTAL, the previous phase $PREV_TOTAL (read from $PREV_LOG)"
    check "the previous phase's total was read from its committed log" "$(yn [ -n "$PREV_TOTAL" ])"
    awk '
      /^## cargo test --workspace \(host\)$/ { inblock = 1; next }
      /^## / { inblock = 0 }
      inblock && /^    test .* \.\.\. ok$/ { sub(/^    test /, ""); sub(/ \.\.\. ok$/, ""); print }
    ' "$PREV_LOG" | sort >"$T/prev.names"
    nprev_names=$(count_lines "$T/prev.names")
    echo "  test names the previous log's host run printed: $nprev_names"
    check "the previous log's names account for its whole host total" "$(yn [ "$nprev_names" = "$PREV_TOTAL" ])"
    comm -13 "$T/prev.names" "$T/host.names" >"$T/added.names"
    comm -23 "$T/prev.names" "$T/host.names" >"$T/removed.names"
    nadded=$(count_lines "$T/added.names")
    nremoved=$(count_lines "$T/removed.names")
    echo "  test names added since the previous phase: $nadded; removed: $nremoved"
    sed 's/^/    added: /' "$T/added.names"
    sed 's/^/    removed: /' "$T/removed.names"
    total_moved_by_names() {
      [ -n "$PREV_TOTAL" ] && [ "$NOW_TOTAL" -eq "$((PREV_TOTAL + nadded - nremoved))" ]
    }
    check "this phase's workspace total is the previous phase's plus the names added less the names removed" \
      "$(yn total_moved_by_names)"
    comm -3 "$T/prev.names" "$T/prev.names" >"$T/c-names"
    check "control: the same comparison of a list with itself finds no difference" \
      "$(yn [ "$(count_lines "$T/c-names")" = 0 ])"
    { cat "$T/prev.names"; echo "zzz::control::name"; } | sort >"$T/c-names-plus"
    check "control: a list with one name more is found to add exactly one" \
      "$(yn [ "$(comm -13 "$T/prev.names" "$T/c-names-plus" | wc -l)" = 1 ])"
    
    echo
    echo "## the tests this phase adds and removes, derived from the source"
    BASE_DOC=$(git log --format='%H' -n 1 --grep='^M1 part 8 P1: commit planning docs [(]the part 7 close-out rulings')
    BASE=$(git rev-parse --verify "$BASE_DOC^" 2>/dev/null)
    echo "command: git log --format=%H -n 1 --grep=<the first doc commit's subject>, and its parent"
    echo "  the first doc commit: $BASE_DOC; the phase base: $BASE"
    check "the phase base is the part 7 close-out record commit" "$(yn [ "$BASE" = "$REC" ])"
    check "the phase base resolved from git" "$(yn [ -n "$BASE" ])"
    tests_attr() { git show "$1:$2" 2>/dev/null | tests_in; }
    tests_in() {
      awk '
        /^[ \t]*#\[test\][ \t]*$/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]/ {
          sub(/^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next
        }
        t { t = 0 }' | sort
    }
    added_between() {
      # $1 older commit, $2 newer commit: "<file> <name>" per #[test] the newer
      # commit has in a .rs file the pair's diff touches and the older lacks.
      local f
      git diff --name-only "$1" "$2" -- '*.rs' | while IFS= read -r f; do
        tests_attr "$2" "$f" >"$T/ab-new"
        tests_attr "$1" "$f" >"$T/ab-old"
        comm -13 "$T/ab-old" "$T/ab-new" | sed "s#^#$f #"
      done
    }
    removed_between() { added_between "$2" "$1"; }
    git diff --name-only "$BASE" "$C" -- '*.rs' >"$T/changed-rs"
    echo "  the .rs files the phase changed:"
    sed 's/^/    /' "$T/changed-rs"
    added_between "$BASE" "$C" >"$T/src-added"
    removed_between "$BASE" "$C" >"$T/src-removed"
    echo "  #[test] functions at the phase commit and not at the base, by file:"
    sed 's/^/    /' "$T/src-added"
    echo "  #[test] functions at the base and not at the phase commit, by file:"
    sed 's/^/    /' "$T/src-removed"
    nsrc_added=$(count_lines "$T/src-added")
    nsrc_removed=$(count_lines "$T/src-removed")
    check "the source adds tests in this phase ($nsrc_added)" "$(yn [ "$nsrc_added" -ge 1 ])"
    check "the source removes no test in this phase ($nsrc_removed)" "$(yn [ "$nsrc_removed" = 0 ])"
    n_ctl_tests=$(tests_attr "$C" crates/emend/src/archive/tests.rs | count_lines /dev/stdin)
    check "control: the same form finds the #[test] functions of an unchanged file, archive/tests.rs, at the phase commit ($n_ctl_tests)" "$(yn [ "$n_ctl_tests" -ge 1 ])"
    awk '{ print $2 }' "$T/src-added" | sort >"$T/src-added.names"
    awk '{ print $2 }' "$T/src-removed" | sort >"$T/src-removed.names"
    sed 's/^.*:://' "$T/added.names" | sort >"$T/run-added.names"
    sed 's/^.*:://' "$T/removed.names" | sort >"$T/run-removed.names"
    check "the names the run added are exactly the tests the source added" \
      "$(yn cmp -s "$T/run-added.names" "$T/src-added.names")"
    check "the names the run lost are exactly the tests the source removed" \
      "$(yn cmp -s "$T/run-removed.names" "$T/src-removed.names")"
    passed_on() { count_matches -E "(^|::)$1\$" "$T/$2.names"; }
    both_passed() {
      [ "$(passed_on "$1" host)" = 1 ] && [ "$(passed_on "$1" i686-unknown-linux-musl)" = 1 ]
    }
    echo "  each added test, and whether it ran and passed on each target:"
    while read -r f name; do
      echo "    $name ($f): host $(passed_on "$name" host), i686-unknown-linux-musl $(passed_on "$name" i686-unknown-linux-musl)"
      check "  $name passed on both targets" "$(yn both_passed "$name")"
    done <"$T/src-added"
    not_passed_ctl() { if both_passed zzz_no_such_test_anywhere; then return 1; else return 0; fi; }
    check "control: both_passed refuses a name no run holds" "$(yn not_passed_ctl)"
    printf '#[test]\n#[should_panic]\nfn ctl_one() {}\nfn not_a_test() {}\n#[test]\nfn ctl_two() -> Result<(), ()> { Ok(()) }\n' >"$T/c-src"
    tests_in <"$T/c-src" >"$T/c-src.names"
    sed 's/^/    control name: /' "$T/c-src.names"
    check "control: tests_in reads a #[test] behind another attribute and skips a plain fn" \
      "$(yn [ "$(tr '\n' ' ' <"$T/c-src.names")" = "ctl_one ctl_two " ])"
    
    echo
    echo "## the tests each code commit adds, against its message (header change 3)"
    # A commit message's count is one a committed log prints (specs/0001). Each
    # code commit's added and removed #[test] functions are derived from the
    # source between it and its parent; the message is read with its line breaks
    # as spaces, since a sentence may wrap.
    : >"$T/per-commit"
    for k in 1 2 3 4 5 6; do
      var=CODE$k; at=${!var}
      added_between "$at^" "$at" >"$T/add-$k"
      removed_between "$at^" "$at" >"$T/rem-$k"
      echo "  code commit $k ($(git log -1 --format=%h "$at")): tests added $(count_lines "$T/add-$k"), removed $(count_lines "$T/rem-$k")"
      sed 's/^/    added: /' "$T/add-$k"
      echo "$k $(count_lines "$T/add-$k") $(count_lines "$T/rem-$k")" >>"$T/per-commit"
    done
    sum_added=$(awk '{ n += $2 } END { print n + 0 }' "$T/per-commit")
    echo "  added over the six commits: $sum_added; added over the phase: $nsrc_added"
    check "the per-commit additions sum to the phase's" "$(yn [ "$sum_added" = "$nsrc_added" ])"
    flat_msg() { git log -1 --format=%B "$1" | tr '\n' ' ' | sed 's/  */ /g'; }
    claims_count() {
      # $1 commit number, $2 the count word the message uses, $3 the count.
      local var=CODE$1
      [ "$(flat_msg "${!var}" | count_matches -F "$2 new tests" /dev/stdin)" = 1 ] &&
        [ "$(awk -v k="$1" '$1 == k { print $2 }' "$T/per-commit")" = "$3" ] &&
        [ "$(awk -v k="$1" '$1 == k { print $3 }' "$T/per-commit")" = 0 ]
    }
    check "code commit 1's message says \"Eight new tests\", and it adds eight and removes none" "$(yn claims_count 1 Eight 8)"
    check "code commit 2's message says \"Five new tests\", and it adds five and removes none" "$(yn claims_count 2 Five 5)"
    none_after() {
      local k
      for k in 3 4 5 6; do
        [ "$(awk -v k="$k" '$1 == k { print $2 + $3 }' "$T/per-commit")" = 0 ] || return 1
      done
    }
    check "code commits 3 to 6 add and remove no test" "$(yn none_after)"
    claims_ctl() { if claims_count 1 Eight 7; then return 1; else return 0; fi; }
    check "control: the same claim check refuses a count one short" "$(yn claims_ctl)"
    
    echo
    echo "## the keep's cases, each mapped to the test that holds it (header change 3)"
    # The three cases "### P1" names, and rulings 2 to 4, each mapped to the tests
    # that hold it, by name; each must be a #[test] at the phase commit and must
    # have passed on both targets. The mapping is the reader's to check against
    # the spec.
    : >"$T/casemap"
    while IFS='|' read -r case name; do
      echo "  $case -> $name: host $(passed_on "$name" host), i686-unknown-linux-musl $(passed_on "$name" i686-unknown-linux-musl)"
      check "  $case: $name passed on both targets" "$(yn both_passed "$name")"
    done <<'CASES'
    P1, the keep writes the pair named after the test (crate)|the_keep_names_each_pair_after_the_test_and_numbers_them
    P1, the keep writes the pair named after the test (written)|written_keeps_the_fixture_and_the_output
    P1, the keep writes the pair named after the test (tool)|a_run_that_writes_is_kept_under_the_test_and_numbered
    P1, a second write of the name is refused (crate)|the_keep_refuses_a_name_already_there_and_writes_neither_file
    P1, a second write of the name is refused (tool)|the_tool_keep_refuses_a_name_already_there_and_writes_neither_file
    P1, unset, nothing is written (crate)|with_no_keep_directory_nothing_is_written
    P1, unset, nothing is written (written)|written_with_no_keep_needs_no_fixture
    P1, unset, nothing is written (tool)|with_no_tool_keep_directory_nothing_is_kept
    ruling 2, a keep with no recorded fixture is refused|written_with_a_keep_refuses_a_package_whose_fixture_was_not_recorded
    ruling 2, a stale fixture is refused|written_with_a_keep_refuses_a_fixture_the_package_was_not_opened_from
    ruling 3, a named directory that is not there fails the test (crate)|a_keep_directory_that_is_not_there_fails_the_test
    ruling 3, a named directory that is not there fails the test (tool)|a_tool_keep_directory_that_is_not_there_fails_the_test
    ruling 4, a refused tool run is not kept|a_refused_run_is_not_kept
    CASES
    
    echo
    echo "## no test sets EMEND_KEEP_DIR (ruling 3)"
    # The variable's name appears in the source only as the two KEEP_VARIABLE
    # constants, and nothing under crates/ or tools/ calls set_var or remove_var.
    echo "command: git grep -n -F EMEND_KEEP_DIR <phase commit> -- crates tools"
    git grep -n -F EMEND_KEEP_DIR "$C" -- crates tools | sed "s#^$C:##" >"$T/keep-var"
    sed 's/^/    /' "$T/keep-var"
    only_constants() {
      [ "$(count_lines "$T/keep-var")" = 2 ] &&
        [ "$(count_matches -E 'const KEEP_VARIABLE: &str = "EMEND_KEEP_DIR";$' "$T/keep-var")" = 2 ]
    }
    check "EMEND_KEEP_DIR is named only by the two KEEP_VARIABLE constants" "$(yn only_constants)"
    echo "command: git grep -n -E 'set_var|remove_var' <phase commit> -- crates tools"
    git grep -n -E 'set_var|remove_var' "$C" -- crates tools | sed "s#^$C:##" >"$T/set-var"
    sed 's/^/    /' "$T/set-var"
    check "nothing under crates/ or tools/ calls set_var or remove_var ($(count_lines "$T/set-var"))" "$(yn [ "$(count_lines "$T/set-var")" = 0 ])"
    printf 'x.rs:1:    unsafe { std::env::set_var("EMEND_KEEP_DIR", "d") };\n' >"$T/c-set-var"
    check "control: the same pattern finds a set_var line" "$(yn [ "$(count_matches -E 'set_var|remove_var' "$T/c-set-var")" = 1 ])"
    
    echo
    echo "## the ignored tests, derived from the source"
    ignored_in() {
      awk '
        /^[ \t]*#\[ignore/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?fn[ \t]/ { sub(/^[ \t]*(pub[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next }
        t { t = 0 }'
    }
    ignored_at() {
      git ls-tree -r --name-only "$1" | LC_ALL=C "$G" -E '[.]rs$' | while IFS= read -r f; do
        git show "$1:$f" | ignored_in
      done | sort
    }
    ignored_at "$BASE" >"$T/ign-base"
    ignored_at "$C" >"$T/ign-c"
    sed 's/^/    ignored in the source at the base: /' "$T/ign-base"
    sed 's/^/    ignored in the source at the phase commit: /' "$T/ign-c"
    check "the phase commit ignores exactly the tests the base ignored" "$(yn cmp -s "$T/ign-base" "$T/ign-c")"
    for target in host i686-unknown-linux-musl; do
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" | sed 's/^/    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" |
        sed -E 's/^test ([^ ]*) \.\.\. ignored.*/\1/; s/^.*:://' | sort >"$T/ign-run-$target"
      check "$target: the run's ignored tests are exactly the source's ($(count_lines "$T/ign-run-$target"))" \
        "$(yn cmp -s "$T/ign-run-$target" "$T/ign-c")"
    done
    printf '#[test]\n#[ignore = "why"]\n#[cfg(unix)]\nfn ctl_ignored() {}\n#[test]\nfn ctl_run() {}\n' | ignored_in >"$T/c-ign"
    check "control: ignored_in reads the one ignored fixture test ($(tr '\n' ' ' <"$T/c-ign"))" \
      "$(yn [ "$(cat "$T/c-ign")" = ctl_ignored ])"
    { cat "$T/ign-c"; echo zzz_control; } | sort >"$T/c-ign-plus"
    check "control: the same comparison refuses a set one name longer" \
      "$(yn [ "$(comm -3 "$T/c-ign-plus" "$T/ign-c" | count_lines /dev/stdin)" = 1 ])"
    
    echo
    echo "## the mutations of the keep, and what each one failed (header change 4)"
    git worktree add --detach "$MUTTREE/tree" "$C" >/dev/null 2>&1
    check "the mutation worktree was added at the phase commit" \
      "$(yn [ "$(git -C "$MUTTREE/tree" rev-parse HEAD)" = "$C" ])"
    cat >"$MUTTREE/mutate.py" <<'PYEOF'
    import sys
    MUTATIONS = {
        "K1": [("crates/emend/src/testing.rs",
                "        assert!(\n            !path.exists(),\n            \"the keep refuses {}: the name is already there\",",
                "        assert!(\n            true || !path.exists(),\n            \"the keep refuses {}: the name is already there\",")],
        "K2": [("crates/emend/src/package/tests.rs",
                "    if keeping {\n        let fixture = fixture\n",
                "    if keeping && false {\n        let fixture = fixture\n")],
        "K3": [("tools/emend-copy/tests/null_rewrite.rs",
                "        && out.status.code() == Some(0)\n",
                "")],
        "K4": [("crates/emend/src/testing.rs",
                "    let dir = KEEP_OVERRIDE\n        .with(|slot| slot.borrow().clone())\n",
                "    let dir = KEEP_OVERRIDE\n        .with(|_slot| None::<Option<std::path::PathBuf>>)\n")],
        "K5": [("crates/emend/src/testing.rs",
                "        count.set(count.get() + 1);\n",
                "        count.set(1);\n")],
    }
    which = sys.argv[1]
    root = sys.argv[2]
    for path, old, new in MUTATIONS[which]:
        full = root + "/" + path
        body = open(full).read()
        found = body.count(old)
        if found != 1:
            print("REFUSED %s: the text to replace in %s occurs %d times, not once" % (which, path, found))
            sys.exit(2)
        body = body.replace(old, new, 1)
        open(full, "w").write(body)
        print("    applied %s to %s: %d bytes -> %d bytes" % (which, path, len(old), len(new)))
    PYEOF
    echo "## the mutation applier this log runs"
    sed 's/^/    /' "$MUTTREE/mutate.py"
    in_tree_test() {
      # $1 label, $2 package, then cargo test's own arguments.
      local label=$1 pkg=$2
      shift 2
      ( cd "$MUTTREE/tree" && CARGO_TARGET_DIR="$MUTTREE/target" cargo test -p "$pkg" --no-fail-fast "$@" ) >"$T/tree-$label.out" 2>&1 </dev/null
    }
    failed_names() {
      LC_ALL=C "$G" -E '^test .* \.\.\. FAILED$' "$1" | sed -E 's/^test (.*) \.\.\. FAILED$/\1/' | sort -u
    }
    ok_names() {
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$1" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort -u
    }
    mut_expect() {
      case "$1" in
        K1) echo testing::tests::the_keep_refuses_a_name_already_there_and_writes_neither_file ;;
        K2) echo package::tests::written_with_a_keep_refuses_a_package_whose_fixture_was_not_recorded package::tests::written_with_a_keep_refuses_a_fixture_the_package_was_not_opened_from ;;
        K3) echo a_refused_run_is_not_kept ;;
        K4) echo testing::tests::the_keep_names_each_pair_after_the_test_and_numbers_them ;;
        K5) echo testing::tests::the_keep_names_each_pair_after_the_test_and_numbers_them ;;
      esac
    }
    mut_pkg() { if [ "$1" = K3 ]; then echo emend-copy; else echo emend; fi; }
    mut_args() { if [ "$1" = K3 ]; then echo --test null_rewrite; else echo --lib; fi; }
    mut_mode() { if [ "$1" = K3 ]; then echo measure; else echo bite; fi; }
    : >"$T/findings"
    : >"$T/mut-table"
    for m in K1 K2 K3 K4 K5; do
      echo
      echo "### $m (expected to fail: $(mut_expect "$m"); mode $(mut_mode "$m"))"
      ( cd "$MUTTREE/tree" && git checkout -q -- . ) || fail=1
      python3 "$MUTTREE/mutate.py" "$m" "$MUTTREE/tree" >"$T/mut-$m.apply" 2>&1
      arc=$?
      sed 's/^/  /' "$T/mut-$m.apply"
      check "$m: the applier found its text exactly once and replaced it" "$(yn [ "$arc" -eq 0 ])"
      if [ "$arc" -ne 0 ]; then echo "$m applier-refused" >>"$T/mut-table"; continue; fi
      echo "  the planted change, as git diff prints it in the worktree:"
      git -C "$MUTTREE/tree" diff | sed 's/^/    /'
      echo "command: cargo test -p $(mut_pkg "$m") --no-fail-fast $(mut_args "$m") (in the mutated worktree)"
      # shellcheck disable=SC2046
      in_tree_test "$m" "$(mut_pkg "$m")" $(mut_args "$m")
      mrc=$?
      echo "  exit: $mrc"
      LC_ALL=C "$G" -E '^error' "$T/tree-$m.out" | sed 's/^/    cargo: /'
      LC_ALL=C "$G" -E '^test result: ' "$T/tree-$m.out" | sed 's/^/    /'
      failed_names "$T/tree-$m.out" >"$T/mut-$m.failed"
      sed 's/^/    failed: /' "$T/mut-$m.failed"
      want=$(mut_expect "$m")
      nwant=0
      nhit=0
      for w in $want; do
        nwant=$((nwant + 1))
        nhit=$((nhit + $(count_matches -Fx "$w" "$T/mut-$m.failed")))
        echo "  the failing assertion of $w, as the run printed it (first lines):"
        awk -v w="---- $w stdout ----" '$0 == w { on = 1; n = 0 } on { print; n++ } on && n >= 8 { on = 0 }' "$T/tree-$m.out" |
          cut -c1-240 | sed 's/^/    /'
      done
      nbuild=$(count_matches -F 'error: could not compile' "$T/tree-$m.out")
      hit=$([ "$nhit" = "$nwant" ] && echo 1 || echo 0)
      echo "  expected names that failed: $nhit of $nwant"
      nfail=$(count_lines "$T/mut-$m.failed")
      mode=$(mut_mode "$m")
      echo "  failing tests: $nfail; could-not-compile lines: $nbuild; mode: $mode"
      if [ "$hit" = 1 ] && [ "$nbuild" = 0 ]; then
        echo "  $m bites: $want fails ($nfail failing tests in all)"
        echo "$m mode=$mode bites expected=$want failing=$nfail" >>"$T/mut-table"
      elif [ "$mode" = measure ]; then
        echo "  MEASURED $m: $want does not fail (failing tests $nfail, could-not-compile $nbuild), as header change 4 expects: a refused run writes no output file, so the keep's other condition stops it"
        echo "$m mode=$mode does-not-bite expected=$want failing=$nfail build=$nbuild" >>"$T/mut-table"
        measured_clean() { [ "$nbuild" = 0 ] && [ "$mrc" -eq 0 ]; }
        check "$m: the mutated crate compiled and its tests all passed, so the measurement is of the tests and not of the build" "$(yn measured_clean)"
      else
        echo "  FINDING $m: $want did not fail (failing tests $nfail, could-not-compile $nbuild)"
        echo "$m mode=$mode FINDING expected=$want failing=$nfail build=$nbuild" >>"$T/mut-table"
        echo "$m" >>"$T/findings"
      fi
      if [ "$mode" = bite ]; then
        bit() { [ "$hit" = 1 ] && [ "$nbuild" = 0 ]; }
        check "$m: $want fails and the crate compiled" "$(yn bit)"
      fi
    done
    
    echo
    echo "### control: the same worktree with no mutation applied"
    ( cd "$MUTTREE/tree" && git checkout -q -- . ) || fail=1
    check "control: the worktree carries no change after the reset" \
      "$(yn [ "$(git -C "$MUTTREE/tree" status --porcelain | count_lines /dev/stdin)" = 0 ])"
    in_tree_test clean-emend emend --lib
    crc1=$?
    in_tree_test clean-tool emend-copy --test null_rewrite
    crc2=$?
    echo "  exit: emend --lib $crc1; emend-copy --test null_rewrite $crc2"
    LC_ALL=C "$G" -E '^test result: ' "$T/tree-clean-emend.out" "$T/tree-clean-tool.out" | sed "s#^$T/##; s/^/    /"
    clean_passes() { [ "$crc1" -eq 0 ] && [ "$crc2" -eq 0 ]; }
    check "control: the unmutated worktree's tests all pass, so each failure above is the mutation's" "$(yn clean_passes)"
    cat "$T/tree-clean-emend.out" "$T/tree-clean-tool.out" >"$T/tree-clean.out"
    ok_names "$T/tree-clean.out" >"$T/clean.ok"
    bites_ctl() {
      local w
      for w in $(mut_expect K1) $(mut_expect K2) $(mut_expect K3) $(mut_expect K4); do [ "$(count_matches -Fx "$w" "$T/clean.ok")" = 1 ] || return 1; done
    }
    check "control: every name a mutation looks for is one the unmutated run passes" "$(yn bites_ctl)"
    build_form_ctl() { [ "$(printf 'error: could not compile `x` (lib test) due to 1 previous error\nerror: test failed, to rerun pass x\n' | count_matches -F 'error: could not compile' /dev/stdin)" = 1 ]; }
    check "control: the build-failure form counts a could-not-compile line and not cargo's test-failed line" "$(yn build_form_ctl)"
    half() { local nhit=1 nwant=2; [ "$nhit" = "$nwant" ]; }
    half_ctl() { if half; then return 1; else return 0; fi; }
    check "control: the all-names rule refuses one expected name of two" "$(yn half_ctl)"
    echo
    echo "## the mutation table"
    sed 's/^/    /' "$T/mut-table"
    echo "  mutations that did not bite (findings): $(tr '\n' ' ' <"$T/findings")"
    no_findings() { [ "$(count_lines "$T/findings")" = 0 ]; }
    check "no bite-mode mutation failed to bite" "$(yn no_findings)"
    echo "  rows that bite: $(count_matches -E ' bites ' "$T/mut-table") of $(count_lines "$T/mut-table")"
    cleanup_worktree
    trap 'rm -rf "$T"' EXIT INT TERM HUP
    
    echo
    echo "## the two runs"
    echo "host executed $(cat "$T/host.count") tests; i686-unknown-linux-musl executed $(cat "$T/i686-unknown-linux-musl.count") tests"
    check "the i686 run executed the same test names as the host run" "$(yn cmp -s "$T/host.names" "$T/i686-unknown-linux-musl.names")"
    echo
    echo "## status after the runs"
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E '^((\?\?| ?[MARCD]) records/logs/m1p8-p1|(\?\?| ?[MARCD]) records/m1p8-open-| M specs/0015-open-checks[.]md$)' git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs, its record pair or planning's uncommitted spec: $st_ours"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]
    }
    check "every change in the working tree is one of this phase's logs, its record pair or planning's uncommitted spec" "$(yn status_accounted)"
    check "the mutation worktree is gone from git's list" \
      "$(yn [ "$(git worktree list --porcelain | count_matches -F "$MUTTREE" /dev/stdin)" = 0 ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

