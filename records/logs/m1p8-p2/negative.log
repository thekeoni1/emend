## this log's generator for families L and S (header change 5)
    """Fictional fixtures for M1 part 8 P2's negative log: every file is built
    here from literals; none is copied or derived from a corpus file.
    
    Usage: gen-p2.py <out dir>. Writes, into <out dir>:
      sample.xlsx    a workbook whose first sheet holds a number (A), a normal
                     formula (F) and a highest row of 2;
      plain.xlsx     a workbook whose first sheet holds only a shared string, so
                     it has no A;
      prefixed.xlsx  the sample, its workbook and worksheet under an x: prefix;
      nosheet.xlsx   a workbook whose workbook root has no children;
      foreign.xlsx   the sample with one more sheet element, of a foreign
                     namespace, inside extLst, which LibreOffice does not read;
      truncated.xlsx the first half of sample.xlsx's bytes.
    """
    import os
    import sys
    import zipfile
    
    MAIN = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    REL = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    PKG = "http://schemas.openxmlformats.org/package/2006/relationships"
    CT = "http://schemas.openxmlformats.org/package/2006/content-types"
    WB_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"
    WS_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"
    SST_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"
    DECL = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    
    
    def content_types(strings):
        extra = ('<Override PartName="/xl/sharedStrings.xml" ContentType="%s"/>' % SST_TYPE) if strings else ""
        return (DECL + '<Types xmlns="%s">'
                '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
                '<Default Extension="xml" ContentType="application/xml"/>'
                '<Override PartName="/xl/workbook.xml" ContentType="%s"/>'
                '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="%s"/>%s'
                '</Types>' % (CT, WB_TYPE, WS_TYPE, extra))
    
    
    ROOT_RELS = (DECL + '<Relationships xmlns="%s"><Relationship Id="rId1" Type="%s/officeDocument"'
                 ' Target="xl/workbook.xml"/></Relationships>' % (PKG, REL))
    
    
    def workbook_rels(strings):
        extra = ('<Relationship Id="rId2" Type="%s/sharedStrings" Target="sharedStrings.xml"/>' % REL) if strings else ""
        return (DECL + '<Relationships xmlns="%s"><Relationship Id="rId1" Type="%s/worksheet"'
                ' Target="worksheets/sheet1.xml"/>%s</Relationships>' % (PKG, REL, extra))
    
    
    def workbook(p="", extra=""):
        x = ("xmlns:%s" % p[:-1]) if p else "xmlns"
        return (DECL + '<%sworkbook %s="%s" xmlns:r="%s"><%ssheets><%ssheet name="S1" sheetId="1" r:id="rId1"/>'
                '</%ssheets>%s</%sworkbook>' % (p, x, MAIN, REL, p, p, p, extra, p))
    
    
    def sample_sheet(p=""):
        x = ("xmlns:%s" % p[:-1]) if p else "xmlns"
        return (DECL + '<{p}worksheet {x}="{m}"><{p}sheetData>'
                '<{p}row r="1"><{p}c r="A1"><{p}v>7</{p}v></{p}c></{p}row>'
                '<{p}row r="2"><{p}c r="B2"><{p}f>A1+1</{p}f><{p}v>8</{p}v></{p}c></{p}row>'
                '</{p}sheetData></{p}worksheet>').format(p=p, x=x, m=MAIN)
    
    
    PLAIN_SHEET = (DECL + '<worksheet xmlns="%s"><sheetData><row r="1"><c r="A1" t="s"><v>0</v></c></row>'
                   '</sheetData></worksheet>' % MAIN)
    STRINGS = DECL + '<sst xmlns="%s" count="1" uniqueCount="1"><si><t>label</t></si></sst>' % MAIN
    FOREIGN = '<extLst><ext uri="urn:emend:fixture"><y:sheet xmlns:y="urn:emend:fixture" name="Y"/></ext></extLst>'
    
    
    def package(path, wb, sheet, strings=False):
        # Every entry carries the same fixed time, so the bytes, and so every hash
        # the log prints, are the same on every run.
        parts = [("[Content_Types].xml", content_types(strings)), ("_rels/.rels", ROOT_RELS),
                 ("xl/workbook.xml", wb), ("xl/_rels/workbook.xml.rels", workbook_rels(strings)),
                 ("xl/worksheets/sheet1.xml", sheet)]
        if strings:
            parts.append(("xl/sharedStrings.xml", STRINGS))
        with zipfile.ZipFile(path, "w") as z:
            for name, text in parts:
                z.writestr(zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0)), text, zipfile.ZIP_DEFLATED)
    
    
    def main():
        out = sys.argv[1]
        package(os.path.join(out, "sample.xlsx"), workbook(), sample_sheet())
        package(os.path.join(out, "plain.xlsx"), workbook(), PLAIN_SHEET, strings=True)
        package(os.path.join(out, "prefixed.xlsx"), workbook("x:"), sample_sheet("x:"))
        package(os.path.join(out, "nosheet.xlsx"), DECL + '<workbook xmlns="%s"/>' % MAIN, sample_sheet())
        package(os.path.join(out, "foreign.xlsx"), workbook(extra=FOREIGN), sample_sheet())
        data = open(os.path.join(out, "sample.xlsx"), "rb").read()
        open(os.path.join(out, "truncated.xlsx"), "wb").write(data[: len(data) // 2])
        for name in sorted(os.listdir(out)):
            print("%s %d" % (name, os.path.getsize(os.path.join(out, name))))
    
    
    main()
