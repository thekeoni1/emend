    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh is sourced from it by this log; nothing in it is run: the two scripts under test are run or read from git-show copies in <scratch>/w/scripts"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p1 stands for this script's own directory, which holds the script"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory (this log's generator and its fixtures, the generated corpus roots, keep, records and lists, the base's list script, the PowerShell script's planted copies), removed at exit"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$B" "$SELF_DIR" && apart "$B" "$MAIN" && apart "$MAIN" "$SELF_DIR"; }
    check "the roots other than <home> are distinct, none inside another" "$(yn roots_distinct)"
    roots_ctl() { if apart "$B/lroot" "$B"; then return 1; else return 0; fi; }
