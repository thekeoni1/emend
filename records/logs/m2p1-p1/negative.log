    echo "  the Excel check 1 record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  the code commit: ${CODE1:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~2"
    for k in 0 1 2; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CODE1" "$DOC1" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the code commit, the doc commit and the base, each the next one's parent, the code commit the phase commit" "$(yn roles_in_order)"
    roles_ctl() { local CODE1=$DOC1; if roles_in_order; then return 1; else return 0; fi; }
    check "control: roles_in_order refuses the doc commit named as the code commit" "$(yn roles_ctl)"
    echo
    echo "phase: Milestone 2 part 1 P1 (specs/0016-new-workbook-and-sheets.md) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
