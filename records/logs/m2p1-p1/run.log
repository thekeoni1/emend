  the driver, <scratch>/w/derive.py (sha256 e5b411cc1821683ecbcb31556744a4090413d3266ae4ec7f5e62e6e54da76d0c):
    """This log's derivation of each corpus input's three references, with part 6
    P2's own reader (p2check.py, imported, not changed), and the formula line's
    added and replaced counts that follow from it: with A, 2 added and 1 replaced
    when there is F, else 0; without A, 0 and 0. Writes one tab-separated row per
    manifest row to the file named last; prints only counts."""
    import sys
    sys.dont_write_bytecode = True
    sys.path.insert(0, sys.argv[1])
    import p2check
    root, out = sys.argv[2], sys.argv[3]
    rows = [l.rstrip("\n").split("\t") for l in open(root + "/manifest.tsv")][1:]
    n_a = n_f = 0
    with open(out, "w") as f:
        for r in rows:
            parts, _ = p2check.read_zip("%s/corpus/%s.%s" % (root, r[0], r[3]))
            pk = p2check.pick(parts)
            a = pk["a"] if pk else None
            fr = pk["f"] if pk else None
            if a is None:
                refs, counts = ("", "", "", "", "", ""), ("0", "0")
            else:
                top = pk["top"]
                refs = (p2check.a1(top + 1, 1), "42", p2check.a1(top + 1, 2), "2",
                        fr or "", "5" if fr else "")
                counts = ("2", "1" if fr else "0")
                n_a += 1
                n_f += 1 if fr else 0
            f.write("\t".join((r[0],) + refs + counts) + "\n")
    print("derived rows %d; with A %d; with A and F %d" % (len(rows), n_a, n_f))
