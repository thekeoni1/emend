    wrote m2p1-p1-2026-09-25-ade3c49.txt and m2p1-p1-2026-09-25-ade3c49.md: labels host; files 27; entry rows 870; xml rows 825
  the record script exits 0: yes
  the record checked against the run directory (specs/0014 P2 verification ruling 5): <scratch>/w/reccheck.py, below
    """This log's check of a single-label passthrough record against its run
    directory. Reads the record's .txt and .md and the run directory's
    summary.host.tsv, entries.host.tsv and each workbook's diff.host.tsv; prints
    one "name: yes|no" line per check and one line of counts. It shares no code
    with scripts/passthrough-record.py except the part-family rules, which it
    imports from that script, so the check covers the record's tables and its
    counting, not the family names."""
    import importlib.util
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md = sys.argv[1:5]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    tables = "\n".join(lines(txt)).split("\n\n")
    summary = lines(run_dir + "/summary.host.tsv")
    entries = lines(run_dir + "/entries.host.tsv")
    xml = ["\t".join(record.XML_HEADER)]
    for row in summary[1:]:
        cells = dict(zip(summary[0].split("\t"), row.split("\t")))
        if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
            continue
        for line in lines("%s/%s/diff.host.tsv" % (run_dir, cells["id"])):
            c = line.split("\t")
            if c[0] == "xml":
                xml.append("\t".join([cells["id"], "host"] + c + [""] * (10 - 2 - len(c))))
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is summary.host.tsv", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is entries.host.tsv", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows, in summary order", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    # Entries by part family, counted here from entries.host.tsv.
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    head = entries[0].split("\t")
    fam_counts = {}
    for line in entries[1:]:
        e = dict(zip(head, line.split("\t")))
        c = fam_counts.setdefault(record.family(e["name"]), dict.fromkeys(cols, 0))
        c["entries"] += 1
        c[e["status"]] = c.get(e["status"], 0) + 1
        flags = [f for f in e["flags"].split(",") if f]
        c["flagged"] += 1 if flags else 0
        for f in flags:
            c[f] = c.get(f, 0) + 1
    want = [row([f] + [fam_counts[f][k] for k in cols]) for f in record.FAMILIES if f in fam_counts]
    want.append(row(["total"] + [sum(fam_counts[f][k] for f in fam_counts) for k in cols]))
    got = section("Entries by part family: host")
    checks.append(("each family row of Entries by part family is counted from entries.host.tsv", got == want))
    # The XML comparison of changed entries, counted here from the xml rows by
    # the rule the record's docstring states: an entry is compared once per parse
    # row; names equal when both sides parsed and no element or attribute row
    # follows; values equal when its values row has both one-sided counts 0.
    x = {}
    cur = None
    for line in xml[1:]:
        c = line.split("\t")
        name, kind = c[3], c[4]
        if kind == "parse":
            cur = x.setdefault(record.family(name), {"compared": 0, "parse_errors": 0, "names_equal": 0,
                                                     "values_equal": 0, "in_only": 0, "out_only": 0})
            cur["compared"] += 1
            parsed = c[5] == "ok" and c[6] == "ok"
            cur["parse_errors"] += 0 if parsed else 1
            differ = False
        elif kind in ("element", "attribute"):
            differ = True
        elif kind == "values":
            cur["names_equal"] += 1 if parsed and not differ else 0
            cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
            cur["in_only"] += int(c[7])
            cur["out_only"] += int(c[8])
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    want = [row([f] + [x[f][k] for k in xcols]) for f in record.FAMILIES if f in x]
    want.append(row(["total"] + [sum(x[f][k] for f in x) for k in xcols]))
    got = section("XML comparison of changed entries: host")
    checks.append(("each family row of the XML comparison is counted from the xml rows", got == want))
    checks.append(("the xml families are worksheet and styles alone", sorted(x) == ["styles", "worksheet"]))
    checks.append(("the entry families with a changed entry are worksheet and styles alone",
                   sorted(f for f in fam_counts if fam_counts[f]["changed"]) == ["styles", "worksheet"]))
    checks.append(("the record's Targets line is host alone", "- Targets: host" in text))
    checks.append(("the record's Tool arguments line is --style-sample", "- Tool arguments: --style-sample" in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("summary rows %d; entry rows %d; xml rows %d; entry families %d; xml families %d"
          % (len(summary) - 1, len(entries) - 1, len(xml) - 1, len(fam_counts), len(x)))
  exit: 0
    three tables: yes
    the summary table is summary.host.tsv: yes
    the entries table is entries.host.tsv: yes
    the xml table is every compared workbook's xml rows, in summary order: yes
    each family row of Entries by part family is counted from entries.host.tsv: yes
    each family row of the XML comparison is counted from the xml rows: yes
    the xml families are worksheet and styles alone: yes
    the entry families with a changed entry are worksheet and styles alone: yes
    the record's Targets line is host alone: yes
    the record's Tool arguments line is --style-sample: yes
