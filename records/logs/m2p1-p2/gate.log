    #!/usr/bin/env bash
    # Milestone 2 part 1 P2 gate.log (specs/0016-new-workbook-and-sheets.md,
    # "P2: the template and `Package::new`", with "Planning verification and
    # rulings on P1 (2026-09-25)" and "Planning rulings during P2 (2026-09-25)"):
    # the full gate on a cold cache, the phase's commits by role and by the paths
    # they touch, each commit message's form, the doc commit's two files against
    # the hashes planning's message gave, each commit's diff hashed with the
    # command that produced it, each code commit held to its area, no lock or
    # manifest change, the gate files specs/0001 names checked against the diff,
    # the scripts parsed and the list script compiled, the new and modified
    # sources scored against the gate they must pass, the four DEBUG binary hashes
    # the gate built, and the working tree's status with planning's uncommitted
    # spec named and its lines printed.
    #
    # Usage: m2p1-p2-gate.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m2p1-p2/gate.log. The log prints its own invocation.
    #
    # This is a FILE, not an inline block, so "$0" names it and the log prints the
    # script rather than the shell binary.
    #
    # Its own text is committed inside the log, so it holds no office file name, no
    # path shape and no address: the office regex is read from check.sh, the
    # pre-P6d path forms are read from git, and every control fixture is assembled
    # at run time from pieces (specs/0001-bootstrap.md, as in every earlier gate log).
    #
    # WRITTEN FOR M2 part 1 P2 from P1's gate script (the script printed in
    # records/logs/m2p1-p2/gate.log), audited against specs/0001 "Rules for every
    # phase" and specs/0016's P1 verification rulings and P2 rulings, and grepped
    # for P1's names, paths and subjects. What differs from that one, and why:
    #  1. The phase, the log directory and the status terms are P2's
    #     (records/logs/m2p1-p2); the script's directory is <scratch>/p2, and the
    #     build directory <home>/.cache/emend-build/m2p1-p2-gate.
    #  2. The commits by role: the P1 record commit (the base, by its subject
    #     "M2 part 1 P1 record:"), one doc commit and two code commits, each by
    #     its full subject, all beginning "M2 part 1 P2: ". roles_in_order walks
    #     the phase commit's parents. No id is typed.
    #  3. The doc commit carries specs/0016-new-workbook-and-sheets.md and
    #     ROADMAP.md; each blob is hashed from git and compared with "the hash
    #     planning's message gave", at the doc commit and at the phase commit.
    #  4. Code commit 1 is held to scripts/excel-check-open.ps1 and
    #     crates/emend/src/styles.rs; code commit 2 to crates/emend/template/,
    #     crates/emend/src/package.rs, crates/emend/src/package/tests.rs and
    #     tools/emend-copy/src/main.rs and tests/null_rewrite.rs. P1's "no crate
    #     or tool file" check is gone: this phase changes the crate. No
    #     Cargo.lock and no manifest in the range, still.
    #  5. The modes block adds the template files, none executable.
    #  6. The code-commit control of commit_class names its commit by what it
    #     did: the last commit in the range that added a file under
    #     crates/emend/template/.
    #  7. Planning's P2 rulings 1 to 6 sit in specs/0016 uncommitted (they go in
    #     P3's first doc commit). The status block names that one path, prints
    #     its sha256 beside the hash planning's message gave, prints the status
    #     lines, and asserts nothing else differs but this phase's logs and its
    #     open-check record pair.
    #  8. Roots: scripts/counting.sh is sourced from <repo>, and its root line
    #     says so.
    #  9. None of the three shapes specs/0001 forbids appears here; the shapes
    #     are described rather than written out.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    # Header change 1: the build directory is on the disk, not in /tmp.
    BUILD_ROOT=$HOME/.cache/emend-build/m2p1-p2-gate
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    # Every printed line passes through this scrub: the repository first, since it
    # lies inside the home directory.
    W=$(mktemp -d)
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p2#g" -e "s#$W#<scratch>/w#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    . scripts/counting.sh
    
    trap 'rm -rf "$W"' EXIT INT TERM HUP
    fail=0
    note() { echo "  $1: $2"; [ "$2" = as-expected ] || fail=1; }
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    # For a control that must FAIL. `is ! f x` cannot express it: `!` is a shell
    # keyword, so "$@" would try to run a command named "!" and the helper would
    # print UNEXPECTED whatever f did.
    isnot() { if "$@"; then echo UNEXPECTED; else echo as-expected; fi; }
    ctl() {
      local label=$1 want=$2 n r
      shift 2
      n=$("$@")
      r=$([ "$n" = "$want" ] && echo as-expected || echo UNEXPECTED)
      echo "  control $label count=$n expected=$want: $r"
      [ "$r" = as-expected ] || fail=1
    }
    
    # specs/0001-bootstrap.md, "Rules for every phase" (M1 part 3 P1 ruling 11):
    # the phase commit is GIVEN to the script and compared with git rev-parse
    # HEAD before the run, with a control that refuses a fabricated commit.
    C=${1:?phase commit required}
    HEAD_SHA=$(git rev-parse HEAD)
    NULL_SHA=0000000000000000000000000000000000000000
    full_sha() {
      printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'
    }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    not_head() { if is_head "$1"; then return 1; else return 0; fi; }
    echo "command: git rev-parse HEAD"
    inv_path=$0
    case "$inv_path" in
      "$(git rev-parse --show-toplevel)"/*) inv_path="<repo>/${inv_path#"$(git rev-parse --show-toplevel)"/}" ;;
      /*) inv_path="<scratch>/p2/$(basename "$inv_path")" ;;
    esac
    echo "invocation: bash $inv_path $*"
    echo "about: M2 part 1 P2 phase commits, last is $C; HEAD at run: $HEAD_SHA"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    # specs/0001: the scan greps every printed script for three forbidden shapes,
    # and they run here first, over this script's own file, each with a positive
    # control through the same command form. The patterns and the fixture are
    # assembled from pieces at run time, so this script's text holds none.
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    SHAPE_DIR=$(mktemp -d)
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$SHAPE_DIR/fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$SHAPE_DIR/fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      SHAPE_RESULT_SELF=$n_self
      SHAPE_RESULT_FIX=$n_fix
      note "$shape: this script holds none" "$(is [ "$SHAPE_RESULT_SELF" = 0 ])"
      note "control: $shape: the same form finds the fixture's one line" "$(is [ "$SHAPE_RESULT_FIX" = 1 ])"
    done
    rm -rf "$SHAPE_DIR"
    
    echo
    echo "## the phase's commits by role, read from git (header change 2)"
    note_fn() { local label=$1; shift; note "$label" "$(is "$@")"; }
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M2 part 1 P1 record:')
    DOC1=$(by_subject 'M2 part 1 P2: commit planning docs (the P1 rulings and verification)')
    CODE1=$(by_subject 'M2 part 1 P2: the .ps1 close in a try, and the styles precondition in the crate')
    CODE2=$(by_subject 'M2 part 1 P2: the template, Package::new and --new-sample')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  the P1 record commit: ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  code commit 1: ${CODE1:-none}"
    echo "  code commit 2: ${CODE2:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~3"
    for k in 0 1 2 3; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r
      for r in "$REC" "$DOC1" "$CODE1" "$CODE2"; do
        [ -n "$r" ] || return 1
      done
      [ "$CODE2" = "$C" ] || return 1
      [ "$(git rev-parse "$C~1")" = "$CODE1" ] || return 1
      [ "$(git rev-parse "$C~2")" = "$DOC1" ] || return 1
      [ "$(git rev-parse "$C~3")" = "$REC" ]
    }
    note_fn "code commits 2 and 1, the doc commit and the P1 record commit, each the next one's parent" roles_in_order
    roles_ctl1() { local CODE1=$CODE2; if roles_in_order; then return 1; else return 0; fi; }
    roles_ctl2() { local DOC1=$REC; if roles_in_order; then return 1; else return 0; fi; }
    note_fn "control: roles_in_order refuses code commit 2 named as code commit 1" roles_ctl1
    note_fn "control: roles_in_order refuses the base named as the doc commit" roles_ctl2
    echo "command: git log --format=%s <P1 record commit>..<phase commit>"
    git log --format='%s' "$REC..$C" >"$W/subjects"
    sed 's/^/    /' "$W/subjects"
    PREFIX_RE='^M2 part 1 P2: '
    nsub=$(count_lines "$W/subjects")
    nprefix=$(count_matches -E "$PREFIX_RE" "$W/subjects")
    echo "  subjects in the range: $nsub; beginning \"M2 part 1 P2: \": $nprefix"
    prefix_all() { [ "$nsub" -ge 1 ] && [ "$nsub" = "$nprefix" ]; }
    note_fn "every commit in the range carries the phase's subject prefix" prefix_all
    printf 'M2 part 1 P2: x\nM2 part 1 P1: y\nM2 part 1: z\n' >"$W/c-subjects"
    ctl "one subject of three with the prefix, same command form" 1 count_matches -E "$PREFIX_RE" "$W/c-subjects"
    no_such_subject() { [ -z "$(by_subject 'M2 part 1 P2: no such subject anywhere')" ]; }
    note_fn "control: a subject no commit has resolves to nothing" no_such_subject
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $HEAD_SHA"
    note "the phase commit given to this script is a full sha" "$(is full_sha "$C")"
    note "the phase commit given to this script is HEAD" "$(is is_head "$C")"
    note "control: the same comparison refuses the null commit" \
      "$(is not_head "$NULL_SHA")"
    note "control: the same comparison refuses a short sha of the real commit" \
      "$(is not_head "$(printf '%s' "$C" | cut -c1-7)")"
    echo "phase: Milestone 2 part 1 P2 (specs/0016-new-workbook-and-sheets.md) gate.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      # specs/0014 P2 verification ruling 4: a rerun line names only hashes the
      # command under it prints.
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    # SERIALIZED: backed by a measurement at entry, the cargo and rustc processes
    # running before this script starts any.
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory, <build>/target (CARGO_TARGET_DIR)"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to (it lies inside <home>, so it is scrubbed first); scripts/counting.sh is sourced from it, and the gate script is run from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p2 stands for this script's own directory, which holds the script"
    echo "root: <build> stands for <home>/.cache/emend-build/m2p1-p2-gate, this log's build directory's parent on the disk (header change 1); the gate builds into <build>/target"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory, a directory distinct from <scratch>/p2"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    note_fn "<scratch>/w and <scratch>/p2 are distinct directories, neither inside the other" apart "$W" "$SELF_DIR"
    note_fn "<scratch>/w and <repo> are distinct directories, neither inside the other" apart "$W" "$MAIN"
    note_fn "<scratch>/p2 and <repo> are distinct directories, neither inside the other" apart "$SELF_DIR" "$MAIN"
    note_fn "<build> and <scratch>/p2 are distinct directories, neither inside the other" apart "$BUILD_ROOT" "$SELF_DIR"
    note_fn "<build> and <repo> are distinct directories, neither inside the other" apart "$BUILD_ROOT" "$MAIN"
    note_fn "<build> and <scratch>/w are distinct directories, neither inside the other" apart "$BUILD_ROOT" "$W"
    apart_ctl() { if apart "$BUILD_ROOT/target" "$BUILD_ROOT"; then return 1; else return 0; fi; }
    note_fn "control: apart refuses a directory inside another" apart_ctl
    note "no cargo or rustc process was running at entry" "$(is [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    echo "DEPARTURE: CARGO_BUILD_JOBS=4 (this box stopped two T0 P6d gate runs for low memory)"
    echo
    echo "## script"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the phase base, resolved from git and checked for ambiguity"
    # specs/0001 requires the base to be read from git by the first doc commit's
    # subject, never typed; its parent is the base. The count of doc commits is
    # deliberately NOT asserted (a typed count of something the phase may grow is
    # not a property); structure_sound below asserts the structure instead.
    DOC_PATTERN='^M2 part 1 P2: commit planning docs [(]the P1 rulings and verification'
    echo "command: git log --format='%H' --grep='$DOC_PATTERN'"
    git log --format='%H' --grep="$DOC_PATTERN" >"$W/doc-matches"
    nmatch=$(count_lines "$W/doc-matches")
    echo "  commits matching the first doc commit's pattern: $nmatch"
    note "the first doc commit's pattern matches exactly one commit" "$(is [ "$nmatch" = 1 ])"
    DOC=$(git log --format='%H' --grep="$DOC_PATTERN" -n 1)
    BASE=$(git rev-parse --verify "$DOC^" 2>/dev/null)
    echo "  the first doc commit is $DOC"
    echo "  its parent, the phase base, is $BASE"
    note "the base resolved from git, not typed" "$(is [ -n "$BASE" ])"
    CLOSE_REC=$(git log --format='%H' -n 1 --grep='^M2 part 1 P1 record:')
    echo "  the P1 record commit, by subject: ${CLOSE_REC:-none found}"
    note "the phase base is the P1 record commit" "$(is [ "$BASE" = "$CLOSE_REC" ])"
    note "control: the same comparison refuses the first doc commit as the base" \
      "$(isnot [ "$DOC" = "$CLOSE_REC" ])"
    
    echo
    echo "## the phase's commits"
    echo "command: git log --reverse --format='%H %s' <base>..<phase commit>"
    git log --reverse --format='    %H %s' "$BASE..$C"
    ncommits=$(git rev-list --count "$BASE..$C")
    echo "  commits in the range: $ncommits"
    # Each commit is classified by the paths it touches, and the sequence is
    # checked as one property in one function: a mixed or empty commit fails, the
    # range opens with a doc commit and holds at least one code commit.
    commit_class() {
      git show --name-only --format= "$1" | awk '
        NF { total++; if ($0 ~ /^specs\// || $0 == "ROADMAP.md" || $0 == "CLAUDE.md") docs++ }
        END {
          if (total == 0) { print "empty"; exit }
          if (docs == total) print "doc"; else if (docs == 0) print "code"; else print "mixed"
        }'
    }
    structure_sound() {
      awk 'NR == 1 && $1 != "doc" { bad = 1 }
           $1 == "mixed" || $1 == "empty" { bad = 1 }
           $1 == "code" { code = 1 }
           END { exit (bad || !code || NR == 0) }' "$1"
    }
    : >"$W/classes"
    for h in $(git rev-list --reverse "$BASE..$C"); do
      printf '%s %s\n' "$(commit_class "$h")" "$(git log --format='%h %s' -n 1 "$h")" >>"$W/classes"
    done
    sed 's/^/    /' "$W/classes"
    note "every commit is planning docs alone or code alone, the range opens with a doc commit and holds code" \
      "$(is structure_sound "$W/classes")"
    ndoc=$(count_matches -E '^doc ' "$W/classes")
    ncode=$(count_matches -E '^code ' "$W/classes")
    echo "  of the $ncommits commits in the range: $ndoc planning-doc, $ncode code"
    note "the phase holds at least one doc commit, counted in the range" \
      "$(is [ "$ndoc" -ge 1 ])"
    note "control: the same count finds this phase's code commits too" \
      "$(is [ "$ncode" -ge 1 ])"
    note "control: the two classes account for every commit in the range" \
      "$(is [ "$((ndoc + ncode))" = "$ncommits" ])"
    note "control: commit_class calls the first doc commit a doc commit" \
      "$(is [ "$(commit_class "$DOC")" = doc ])"
    # Header change 6: the code-commit control names its commit by what that
    # commit DID: the last commit in the range that modified
    # scripts/edit-open-check.sh.
    CODEC=$(git log --format='%H' -n 1 --diff-filter=A "$BASE..$C" -- crates/emend/template)
    echo "  the last commit in the range that added a file under crates/emend/template/: ${CODEC:-none found}"
    note "the commit that added the template resolved from git" "$(is [ -n "$CODEC" ])"
    note "control: commit_class calls the commit that added the template a code commit" \
      "$(is [ "$(commit_class "$CODEC")" = code ])"
    note "control: the first doc commit carries ROADMAP.md, a term the classifier reads" \
      "$(is [ "$(git show --name-only --format= "$DOC" | count_matches -Fx ROADMAP.md /dev/stdin)" = 1 ])"
    printf 'doc a docs\ncode b code\ndoc c docs\ncode d code\n' >"$W/c-ord-ok"
    printf 'code a code\ndoc b docs\n'                        >"$W/c-ord-first"
    printf 'doc a docs\nmixed b both\ncode c code\n'          >"$W/c-ord-mixed"
    printf 'doc a docs\nempty b nothing\ncode c code\n'       >"$W/c-ord-empty"
    printf 'doc a docs\ndoc b docs\n'                         >"$W/c-ord-nocode"
    note "control: structure_sound accepts docs and code interleaved" \
      "$(is structure_sound "$W/c-ord-ok")"
    note "control: structure_sound rejects a range that opens with a code commit" \
      "$(isnot structure_sound "$W/c-ord-first")"
    note "control: structure_sound rejects a commit mixing docs and code" \
      "$(isnot structure_sound "$W/c-ord-mixed")"
    note "control: structure_sound rejects an empty commit" \
      "$(isnot structure_sound "$W/c-ord-empty")"
    note "control: isnot reports a passing command as UNEXPECTED, so it can fail" \
      "$(is [ "$(isnot true)" = UNEXPECTED ])"
    note "control: structure_sound rejects a range with no code commit" \
      "$(isnot structure_sound "$W/c-ord-nocode")"
    
    echo
    echo "## every commit message in the range: ASCII, ending with the Co-Authored-By line only"
    COAUTHOR='Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>'
    msg_form_ok() {
      local last nco nsess nna ntrail
      last=$(awk 'NF { l = $0 } END { print l }' "$1")
      nco=$(count_matches -E '^Co-Authored-By:' "$1")
      nsess=$(count_matches_i -F 'claude-session' "$1")
      nna=$(count_bytes "$NONASCII_CLASS" "$1")
      ntrail=$(git interpret-trailers --parse <"$1" | count_lines /dev/stdin)
      [ "$last" = "$COAUTHOR" ] || return 1
      [ "$nco" = 1 ] || return 1
      [ "$nsess" = 0 ] || return 1
      [ "$ntrail" = 1 ] || return 1
      [ "$nna" = 0 ]
    }
    for h in $(git rev-list --reverse "$BASE..$C"); do
      git log -1 --format=%B "$h" >"$W/msg"
      echo "  $(git log -1 --format=%h "$h"): message lines $(count_lines "$W/msg"), non-ASCII bytes $(count_bytes "$NONASCII_CLASS" "$W/msg"), trailers git parses:"
      git interpret-trailers --parse <"$W/msg" | sed 's/^/      /'
      note "$(git log -1 --format=%h "$h")'s message is ASCII and ends with the Co-Authored-By line only" \
        "$(is msg_form_ok "$W/msg")"
    done
    printf 'subject\n\nbody\n\n%s\n' "$COAUTHOR" >"$W/c-msg-ok"
    printf 'subject\n\nbody\n\n%s\n%s: x\n' "$COAUTHOR" 'Claude-Session' >"$W/c-msg-session"
    printf 'subj\303\251ct\n\n%s\n' "$COAUTHOR" >"$W/c-msg-nonascii"
    printf 'subject\n\n%s\n%s\n' "$COAUTHOR" "$COAUTHOR" >"$W/c-msg-twice"
    printf 'subject\n\nbody\n' >"$W/c-msg-none"
    note "control: msg_form_ok accepts a message ending with the line" "$(is msg_form_ok "$W/c-msg-ok")"
    note "control: msg_form_ok refuses a session line after it" "$(isnot msg_form_ok "$W/c-msg-session")"
    note "control: msg_form_ok refuses a non-ASCII byte" "$(isnot msg_form_ok "$W/c-msg-nonascii")"
    note "control: msg_form_ok refuses the line twice" "$(isnot msg_form_ok "$W/c-msg-twice")"
    note "control: msg_form_ok refuses a message without it" "$(isnot msg_form_ok "$W/c-msg-none")"
    
    echo
    echo "## the doc commit's files against the hashes planning's message gave (header change 3)"
    # The expected values are typed because they are planning's: each is
    # labelled "the hash planning's message gave". Every computed hash is printed
    # by the command that made it.
    echo "  the doc commit: $DOC1"
    blob_sha() { git show "$1:$2" | sha256sum | cut -d' ' -f1; }
    blob_matches() {
      git cat-file -e "$1:$2" 2>/dev/null || return 1
      [ "$(blob_sha "$1" "$2")" = "$3" ]
    }
    while read -r which path given; do
      case "$which" in doc1) at=$DOC1 ;; head) at=$C ;; esac
      if git cat-file -e "$at:$path" 2>/dev/null; then got=$(blob_sha "$at" "$path"); else got=absent; fi
      echo "  $which $(git rev-parse --short "$at") $path"
      echo "    command: git show <commit>:$path | sha256sum"
      echo "    sha256 $got"
      echo "    the hash planning's message gave: $given"
      note "$which's $path is the blob planning's message gave" "$(is blob_matches "$at" "$path" "$given")"
    done <<'HASHES'
    doc1 ROADMAP.md 9e10adfe3381e4583b02fcca824d8b656f1882d6edb7679add1895fad62258d4
    doc1 specs/0016-new-workbook-and-sheets.md 75479a6b9fee78c587fc8f9fd6561ebfa5852ed9317cd767799d8654ec1c0a64
    head ROADMAP.md 9e10adfe3381e4583b02fcca824d8b656f1882d6edb7679add1895fad62258d4
    head specs/0016-new-workbook-and-sheets.md 75479a6b9fee78c587fc8f9fd6561ebfa5852ed9317cd767799d8654ec1c0a64
    HASHES
    # The "head" rows say no commit after the doc commit changed planning's files.
    git show --name-only --format= "$DOC1" | sort >"$W/doc1-files"
    printf 'ROADMAP.md\nspecs/0016-new-workbook-and-sheets.md\n' >"$W/doc1-want"
    sed 's/^/    the doc commit carries: /' "$W/doc1-files"
    note "the doc commit carries exactly the two files planning's message hashed" "$(is cmp -s "$W/doc1-files" "$W/doc1-want")"
    note "control: blob_matches refuses the message's ROADMAP hash at the base, before the doc commit" \
      "$(isnot blob_matches "$BASE" ROADMAP.md 9e10adfe3381e4583b02fcca824d8b656f1882d6edb7679add1895fad62258d4)"
    note "control: blob_matches refuses the message's 0016 hash at the base, before the doc commit" \
      "$(isnot blob_matches "$BASE" specs/0016-new-workbook-and-sheets.md 75479a6b9fee78c587fc8f9fd6561ebfa5852ed9317cd767799d8654ec1c0a64)"
    note "control: blob_matches refuses a path absent at the commit" \
      "$(isnot blob_matches "$BASE" crates/emend/template/xl/styles.xml 75479a6b9fee78c587fc8f9fd6561ebfa5852ed9317cd767799d8654ec1c0a64)"
    printf 'ROADMAP.md\n' >"$W/c-doc-short"
    note "control: the file comparison refuses a list one file short" "$(isnot cmp -s "$W/c-doc-short" "$W/doc1-want")"
    
    echo
    echo "## each commit's diff and the phase's combined diff, hashed with the command that produced each"
    for h in $(git rev-list --reverse "$BASE..$C"); do
      cmd="git show --no-color --no-ext-diff --format= $h"
      echo "  command: $cmd | sha256sum"
      echo "    $($cmd | sha256sum | cut -d' ' -f1)  $(git log -1 --format=%s "$h")"
    done
    cmd="git diff --no-color --no-ext-diff $BASE $C"
    echo "  command: $cmd | sha256sum"
    echo "    $($cmd | sha256sum | cut -d' ' -f1)  the phase's combined diff"
    h1=$(git show --no-color --no-ext-diff --format= "$C" | sha256sum | cut -d' ' -f1)
    h2=$(git show --no-color --no-ext-diff --format= "$C" | sha256sum | cut -d' ' -f1)
    h3=$(git show --no-color --no-ext-diff --format= "$C^" | sha256sum | cut -d' ' -f1)
    note "control: the phase commit's diff hashes the same twice" "$(is [ "$h1" = "$h2" ])"
    note "control: its parent's diff hashes differently" "$(isnot [ "$h1" = "$h3" ])"
    
    echo
    echo "## the changed files at the phase commit"
    for f in $(git diff --name-only --diff-filter=d "$BASE" "$C"); do
      git show "$C:$f" >"$W/f" 2>/dev/null || { echo "$f: READ ERROR"; fail=1; continue; }
      echo "$f: sha256 $(sha256sum <"$W/f" | cut -d' ' -f1), bytes $(wc -c <"$W/f"), mode $(git ls-tree "$C" -- "$f" | awk '{print $1}')"
    done
    git diff --name-only --diff-filter=d "$BASE" "$C" >"$W/difffiles"
    echo "  files in the diff: $(count_lines "$W/difffiles")"
    new_mode() { [ "$(git ls-tree "$C" -- "$1" | awk '{print $1}')" = 100755 ]; }
    note "scripts/excel-check-open.ps1 is not executable: PowerShell runs it by -File on another machine" "$(isnot new_mode scripts/excel-check-open.ps1)"
    for t in $(git ls-tree -r --name-only "$C" -- crates/emend/template); do
      note "$t is not executable" "$(isnot new_mode "$t")"
    done
    note "control: the same mode check finds the runner executable" "$(is new_mode scripts/passthrough-run.sh)"
    
    echo
    echo "## the gate files this phase changed, and the self-test they require"
    # specs/0001-bootstrap.md, "Rules for every phase": a phase that changes no
    # gate file LISTS IN gate.log the gate files it checked against the diff.
    cat >"$W/gate-files" <<'EOF'
    scripts/check.sh
    scripts/privacy.sh
    scripts/privacy-patterns.txt
    scripts/privacy-identity.txt
    scripts/sys-allowlist.txt
    scripts/install-hooks.sh
    scripts/counting.sh
    scripts/gate-self-test.sh
    .gitignore
    .github/workflows/ci.yml
    EOF
    echo "command: awk over specs/0001-bootstrap.md, the bullet opening '- A phase that changes a gate file' up to its first 'runs', backticked names"
    awk '/^- A phase that changes a gate file/ { on = 1 } on { print } on && /runs/ { exit }' specs/0001-bootstrap.md >"$W/gate-sentence"
    sed 's/^/    /' "$W/gate-sentence"
    tr -d '\n' <"$W/gate-sentence" | LC_ALL=C "$G" -o -E '`[^`]+`' | tr -d '`' | LC_ALL=C "$G" -v -E ' ' | sort >"$W/gate-from-spec"
    LC_ALL=C "$G" -v -Fx .github/workflows/ci.yml "$W/gate-files" | sort >"$W/gate-typed"
    sed 's/^/    named in specs\/0001: /' "$W/gate-from-spec"
    ci_named() { [ "$(count_matches -F 'the CI workflow' "$W/gate-sentence")" = 1 ]; }
    note "the typed gate-file list is specs/0001's backticked names plus the CI workflow" "$(is cmp -s "$W/gate-from-spec" "$W/gate-typed")"
    note "specs/0001's sentence names the CI workflow" "$(is ci_named)"
    LC_ALL=C "$G" -v -Fx scripts/counting.sh "$W/gate-typed" >"$W/c-gate-typed"
    note "control: the comparison refuses the typed list one name short" "$(isnot cmp -s "$W/gate-from-spec" "$W/c-gate-typed")"
    echo "  the gate files specs/0001 names, each checked against the phase diff:"
    sed 's/^/    checked: /' "$W/gate-files"
    touched=0
    while IFS= read -r g; do
      if LC_ALL=C "$G" -Fxq -- "$g" "$W/difffiles"; then
        echo "  gate file in the diff: $g"
        touched=$((touched + 1))
      fi
    done <"$W/gate-files"
    echo "  gate files checked: $(count_lines "$W/gate-files"); of them in the phase diff: $touched"
    note "no gate file is in the phase diff, so specs/0001 asks for this listing and no self-test" \
      "$(is [ "$touched" = 0 ])"
    FIRST_DIFF=$(sed -n '1p' "$W/difffiles")
    echo "  a file that IS in the phase diff, taken from the diff: $FIRST_DIFF"
    found_first=$(count_matches -Fx "$FIRST_DIFF" "$W/difffiles")
    note "control: the same search finds a name the diff does hold" \
      "$(is [ "$found_first" -ge 1 ])"
    for s in scripts/excel-check-open.ps1 crates/emend/src/styles.rs crates/emend/src/package.rs crates/emend/src/package/tests.rs tools/emend-copy/src/main.rs tools/emend-copy/tests/null_rewrite.rs; do
      echo "  $s: in the phase diff $(count_matches -Fx "$s" "$W/difffiles") times; in the gate-file list $(count_matches -Fx "$s" "$W/gate-files") times"
      in_diff_not_gate() {
        [ "$(count_matches -Fx "$1" "$W/difffiles")" = 1 ] &&
          [ "$(count_matches -Fx "$1" "$W/gate-files")" = 0 ]
      }
      note "$s is in the diff and is not a gate file" "$(is in_diff_not_gate "$s")"
    done
    ST=records/logs/m2p1-p2/self-test.log
    echo "  $ST: $([ -e "$ST" ] && echo PRESENT || echo "absent, as a phase with no gate-file change requires")"
    note "this phase committed no self-test log, having changed no gate file" \
      "$(is [ ! -e "$ST" ])"
    
    echo
    echo "## each code commit touches its own area only, and no lock or manifest changed (header change 4)"
    outside_count() {
      local all inside
      all=$(count_lines "$1"); inside=$(count_matches -E "$2" "$1")
      printf '%s' "$((all - inside))"
    }
    AREA_1='^(scripts/excel-check-open[.]ps1|crates/emend/src/styles[.]rs)$'
    AREA_2='^(crates/emend/template/.+|crates/emend/src/package([.]rs|/tests[.]rs)|tools/emend-copy/(src/main|tests/null_rewrite)[.]rs)$'
    for k in 1 2; do
      var=CODE$k; at=${!var}; avar=AREA_$k; area=${!avar}
      echo "command: git show --name-only --format= <code commit $k>"
      git show --name-only --format= "$at" >"$W/code-files-$k"
      sed "s/^/    code commit $k touches: /" "$W/code-files-$k"
      nall=$(count_lines "$W/code-files-$k")
      nout=$(outside_count "$W/code-files-$k" "$area")
      echo "  paths: $nall; outside $area: $nout"
      touches_only() { [ "$nall" -ge 1 ] && [ "$nout" = 0 ]; }
      note "code commit $k touches something, and nothing outside its area" "$(is touches_only)"
    done
    ntemplate=$(count_matches -E '^crates/emend/template/' "$W/code-files-2")
    echo "  template files code commit 2 adds: $ntemplate"
    note "code commit 2 carries the six template files of the spec's list" "$(is [ "$ntemplate" = 6 ])"
    printf 'crates/emend/src/styles.rs\nscripts/passthrough-run.sh\n' >"$W/c-code-files"
    ctl "one path outside code commit 1's area (the runner), same command form" 1 outside_count "$W/c-code-files" "$AREA_1"
    ctl "two paths outside code commit 2's area, same command form" 2 outside_count "$W/c-code-files" "$AREA_2"
    nlock=$(count_matches -Fx Cargo.lock "$W/difffiles")
    nmanifest=$(count_matches -E '(^|/)Cargo[.]toml$' "$W/difffiles")
    echo "  Cargo.lock in the phase diff: $nlock; manifests in the phase diff: $nmanifest"
    note "the phase changes no Cargo.lock and no Cargo.toml, so no dependency moved" "$(is [ "$((nlock + nmanifest))" = 0 ])"
    printf 'Cargo.lock\ntools/xlsx-diff/Cargo.toml\n' >"$W/c-lock"
    ctl "a lock file in a list, same command form" 1 count_matches -Fx Cargo.lock "$W/c-lock"
    ctl "a manifest in a list, same command form" 1 count_matches -E '(^|/)Cargo[.]toml$' "$W/c-lock"
    
    echo
    echo "## the scripts this phase runs parse, and the list script compiles"
    for s in scripts/check.sh scripts/counting.sh scripts/passthrough-run.sh scripts/lo-check.sh scripts/edit-open-check.sh; do
      git show "$C:$s" >"$W/parse.sh"
      bash -n "$W/parse.sh" 2>/dev/null
      note "$s parses at the phase commit" "$(is [ $? -eq 0 ])"
    done
    printf 'if then\n' >"$W/c-parse.sh"
    parse_ctl() { bash -n "$W/c-parse.sh" 2>/dev/null; }
    note "control: the same parse refuses a broken if" "$(isnot parse_ctl)"
    echo "command: python3 --version"
    python3 --version 2>&1 | sed 's/^/    /'
    py_compiles() { python3 -c 'import py_compile, sys; py_compile.compile(sys.argv[1], cfile=sys.argv[2], doraise=True)' "$1" "$W/compiled.pyc" 2>/dev/null; }
    git show "$C:scripts/excel-check-list.py" >"$W/list.py"
    note "scripts/excel-check-list.py compiles at the phase commit (py_compile, doraise)" "$(is py_compiles "$W/list.py")"
    printf 'def f(:\n    pass\n' >"$W/c-broken.py"
    note "control: the same compile refuses a broken def" "$(isnot py_compiles "$W/c-broken.py")"
    
    echo
    echo "## the new sources scored against the gate they must pass, with controls"
    OFF=$(sed -n "s/^readonly OFFICE_RE='\(.*\)'\$/\1/p" scripts/check.sh)
    note "OFFICE_RE was read from check.sh and is non-empty" "$(is [ -n "$OFF" ])"
    PRE_COMMIT=$(git log --format='%H' --grep='^T0 P6d: narrow the three path patterns' -n 1)
    note "the P6d narrowing commit resolved from git" "$(is [ -n "$PRE_COMMIT" ])"
    git show "$PRE_COMMIT^:scripts/privacy-patterns.txt" >"$W/pre-all" 2>/dev/null || fail=1
    sed -n '8p;10p;11p' "$W/pre-all" >"$W/pre-patterns"
    note "three pre-P6d forms read from the narrowing commit's parent" \
      "$(is [ "$(count_lines "$W/pre-patterns")" = 3 ])"
    
    f_nonascii() { count_bytes "$NONASCII_CLASS" "$1"; }
    f_ctrl()     { count_bytes "$CTRL_CLASS" "$1"; }
    f_live()     { count_from_file -E scripts/privacy-patterns.txt "$1"; }
    f_pre()      { count_from_file -E "$W/pre-patterns" "$1"; }
    f_office()   { count_matches -E "$OFF" "$1"; }
    # P1 gate header change 7, kept: an office extension whose file name is a literal, the
    # name running back from the extension to a space, a quote, a slash, an
    # equals sign or the line's start with no shell expansion in it.
    f_office_literal() { count_matches -E "(^|[ \"'=/])[^ \"'=/\$]+$OFF" "$1"; }
    
    rep() { printf "$1%.0s" $(seq 1 "$2"); }
    printf 'plain\nhas \303\251 byte\n' >"$W/c-nonascii"
    printf 'x \033[31mred\033[m\017 y\n' >"$W/c-ctrl"
    printf 'x %s%s%s y\n' 'gh' 'p_' "$(rep a 24)" >"$W/c-live"
    printf 'x %s%s%s y\n' '/mnt/' 'c/' 'Users/' >"$W/c-pre"
    printf 'name.%s%s\n' 'xl' 'sx' >"$W/c-office"
    printf 'input=$KEEP/$test.in.%s%s\n' 'xl' 'sx' >"$W/c-office-expanded"
    printf 'plain ascii only\n' >"$W/c-clean"
    ctl "f_nonascii on a two-byte character" 2 f_nonascii "$W/c-nonascii"
    ctl "f_ctrl on ESC, ESC and SI" 3 f_ctrl "$W/c-ctrl"
    ctl "f_live on a token shape" 1 f_live "$W/c-live"
    ctl "f_pre on a bare path shape" 1 f_pre "$W/c-pre"
    ctl "f_office on an office file name" 1 f_office "$W/c-office"
    ctl "f_office_literal on the same literal name" 1 f_office_literal "$W/c-office"
    ctl "f_office on a name built from variables" 1 f_office "$W/c-office-expanded"
    ctl "f_office_literal on the same built name" 0 f_office_literal "$W/c-office-expanded"
    for f in f_nonascii f_ctrl f_live f_pre f_office f_office_literal; do
      ctl "$f on a clean file" 0 "$f" "$W/c-clean"
    done
    
    git diff --name-only --diff-filter=A "$BASE" "$C" >"$W/added"
    echo "  files added in this phase: $(count_lines "$W/added")"
    nscored=0
    while IFS= read -r s; do
      git show "$C:$s" >"$W/a-at-head" 2>/dev/null || { echo "$s: READ ERROR"; fail=1; continue; }
      echo "$s (new in this phase):"
      echo "  non-ASCII bytes: $(f_nonascii "$W/a-at-head")"
      echo "  control bytes: $(f_ctrl "$W/a-at-head")"
      echo "  hits against all $(count_lines scripts/privacy-patterns.txt) live privacy patterns: $(f_live "$W/a-at-head")"
      echo "  hits against the three pre-P6d bare forms: $(f_pre "$W/a-at-head")"
      echo "  lines with an office extension: $(f_office "$W/a-at-head"); of them a literal file name: $(f_office_literal "$W/a-at-head")"
      clean_source() {
        [ "$(f_nonascii "$1")" = 0 ] && [ "$(f_ctrl "$1")" = 0 ] &&
          [ "$(f_live "$1")" = 0 ] && [ "$(f_pre "$1")" = 0 ] && [ "$(f_office_literal "$1")" = 0 ]
      }
      note "$s is clean on the five forms, office names counted as literals" "$(is clean_source "$W/a-at-head")"
      nscored=$((nscored + 1))
    done <"$W/added"
    
    echo
    echo "## the files this phase MODIFIED, scored by change rather than absolutely"
    git diff --name-only --diff-filter=M "$BASE" "$C" >"$W/modified"
    echo "  files modified in this phase: $(count_lines "$W/modified")"
    while IFS= read -r M; do
      git show "$BASE:$M" >"$W/m-at-base" 2>/dev/null || { echo "$M: READ ERROR at base"; fail=1; continue; }
      git show "$C:$M" >"$W/m-at-head" 2>/dev/null || { echo "$M: READ ERROR at the phase commit"; fail=1; continue; }
      git diff -U0 "$BASE" "$C" -- "$M" |
        LC_ALL=C "$G" '^+' | LC_ALL=C "$G" -v '^+++' | sed 's/^+//' >"$W/m-added"
      echo "$M (modified in this phase):"
      echo "  added lines: $(count_lines "$W/m-added")"
      for form in f_nonascii f_ctrl f_live f_pre f_office_literal f_office; do
        at_base=$("$form" "$W/m-at-base")
        added=$("$form" "$W/m-added")
        at_head=$("$form" "$W/m-at-head")
        echo "  $form: at the base $at_base, in the added lines $added, at the phase commit $at_head"
        if [ "$form" = f_office ]; then
          # Printed only: a moved or rebuilt line can lower the count, and the
          # literal form above is the one held to "nothing new".
          continue
        fi
        unchanged_by_this_phase() {
          [ "$added" = 0 ] && [ "$at_base" != error ] && [ "$at_head" != error ] &&
            [ "$at_base" = "$at_head" ]
        }
        note "$M: $form introduces nothing new in this phase" "$(is unchanged_by_this_phase)"
      done
      nscored=$((nscored + 1))
    done <"$W/modified"
    
    echo
    echo "## every file in the diff was scored"
    ndiff=$(count_lines "$W/difffiles")
    echo "  files in the diff: $ndiff; files scored as new or modified: $nscored"
    note "every file in the phase diff was scored" "$(is [ "$ndiff" = "$nscored" ])"
    
    echo
    echo "## full run on a cold cache, started from / by absolute path"
    echo "command: cargo clean"
    RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never cargo clean 2>&1 | sed 's/^/    /'
    GATE=$MAIN/scripts/check.sh
    echo "command: (cd / && <repo>/scripts/check.sh)"
    ( cd / && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4 "$GATE" ) >"$W/gate.out" 2>"$W/gate.err"
    grc=$?
    sed 's/^/    /' "$W/gate.out"
    echo "exit: $grc; stderr bytes: $(wc -c <"$W/gate.err")"
    npass=$(count_matches -E '^PASS ' "$W/gate.out")
    ndoc_step=$(count_matches -E '^PASS doc$' "$W/gate.out")
    note "the gate exits 0" "$(is [ "$grc" -eq 0 ])"
    note "nine PASS lines" "$(is [ "$npass" = 9 ])"
    note "the doc step is one of them, by name" "$(is [ "$ndoc_step" = 1 ])"
    note "stderr is empty" "$(is [ "$(wc -c <"$W/gate.err")" -eq 0 ])"
    LC_ALL=C "$G" -a -E '^PASS ' "$W/gate.out" | sed 's/^/    /'
    
    echo
    echo "## the binaries the gate built, both targets"
    bins_ok=yes
    for b in "$CARGO_TARGET_DIR"/debug/emend-copy "$CARGO_TARGET_DIR"/debug/xlsx-diff \
             "$CARGO_TARGET_DIR"/i686-unknown-linux-musl/debug/emend-copy \
             "$CARGO_TARGET_DIR"/i686-unknown-linux-musl/debug/xlsx-diff; do
      if [ -x "$b" ]; then
        echo "  $b: sha256 $(sha256sum <"$b" | cut -d' ' -f1), bytes $(wc -c <"$b")"
      else
        echo "  $b: MISSING or not executable"
        bins_ok=no
      fi
    done
    note "the gate left all four binaries, both targets, executable" "$(is [ "$bins_ok" = yes ])"
    
    echo
    echo "## status after the run, with planning's uncommitted spec named and the lines printed (header change 7)"
    # run_lines and run_matches read the command's own exit status. Planning's
    # P2 rulings 1 to 6 sit in specs/0016 in the working tree, uncommitted; that
    # path is named, hashed, and allowed, and nothing else may differ but this
    # phase's logs and its open-check record pair.
    PLANNING_SPEC=specs/0016-new-workbook-and-sheets.md
    PLANNING_GAVE=3d8b8aa8872d5a25e664ceca73fa9dcd614b38cbd03f135e5678947ac0f69e6f
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_untracked_log=$(run_matches -E '^[?][?] records/logs/m2p1-p2' git status --porcelain)
    st_tracked_log=$(run_matches -E '^ ?[MARCD] records/logs/m2p1-p2' git status --porcelain)
    st_record=$(run_matches -E '^(\?\?| ?[MARCD]) records/m2p1-open-' git status --porcelain)
    st_planning=$(run_matches -E '^ M specs/0016-new-workbook-and-sheets[.]md$' git status --porcelain)
    echo "status lines: $st_all; untracked under the log directory: $st_untracked_log; tracked and modified under it: $st_tracked_log; the phase's open-check record pair: $st_record; planning's spec modified and uncommitted: $st_planning"
    echo "  command: sha256sum $PLANNING_SPEC (the working tree's copy)"
    echo "    sha256 $(sha256sum <"$PLANNING_SPEC" | cut -d' ' -f1)"
    echo "    the hash planning's message gave: $PLANNING_GAVE"
    note "planning's uncommitted spec is the file planning's message hashed" "$(is [ "$(sha256sum <"$PLANNING_SPEC" | cut -d' ' -f1)" = "$PLANNING_GAVE" ])"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_untracked_log" != error ] &&
        [ "$st_tracked_log" != error ] && [ "$st_record" != error ] &&
        [ "$st_planning" != error ] &&
        [ "$st_all" = "$((st_untracked_log + st_tracked_log + st_record + st_planning))" ]
    }
    note "every change in the working tree is one of this phase's logs, its record pair or planning's uncommitted spec" "$(is status_accounted)"
    printf ' M specs/0016-new-workbook-and-sheets.md\n M scripts/check.sh\n' >"$W/c-status"
    ctl "planning's spec in a status listing, same pattern" 1 count_matches -E '^ M specs/0016-new-workbook-and-sheets[.]md$' "$W/c-status"
    printf '?? records/m2p1-open-2026-01-01-abcdef0.md\n?? records/m2p1-p1-2026-01-01-abcdef0.txt\n?? records/m2p1-p2-x.md\n' >"$W/c-rec"
    ctl "the open-check record stem in a listing of three, same pattern" 1 count_matches -E '^(\?\?| ?[MARCD]) records/m2p1-open-' "$W/c-rec"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "gate log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

