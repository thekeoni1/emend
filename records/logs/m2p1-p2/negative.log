    #!/usr/bin/env bash
    # Milestone 2 part 1 P2 negative.log (specs/0016-new-workbook-and-sheets.md,
    # "P2: the template and `Package::new`": "The negative log: nothing new is
    # reachable through the binary; the log says so"; with the P1 verification
    # rulings 1, 3 and 4 and the P2 rulings 4). Two families:
    #
    # (N) tools/emend-copy's --new-sample, run from a detached worktree of the
    #     phase commit (P1 verification ruling 1: a negative log that runs a
    #     built binary uses a worktree or clone) with the gate's built binary
    #     copied in rather than rebuilt (specs/0001, "How this task runs"), its
    #     sha256 checked against the one this phase's gate.log printed; each
    #     command printed as it is run, naming the copy (ruling 4):
    #       N0 the sound run, the control: exit 0, the one line, both files;
    #       N1 to N3 the usage refusals the operation adds (a name after it, it
    #          with another operation, in either order): exit 2, the usage line,
    #          no file written;
    #       N4 the first path in a directory that is not there: exit 2, the
    #          existing "cannot create the output file" message, no file at
    #          either path;
    #       N5 the second path in a directory that is not there: exit 2, the same
    #          message, the first file written and kept (the order ruling 4
    #          gives a failed write of the second);
    #     and the statement the spec asks for: Package::new adds no message, and
    #     its fixed bytes reach none of write_to's or open's; --new-sample's two
    #     assertions (cells and read_back, the new "written value(s)" message
    #     among them) cannot fail on the template through the binary, so no case
    #     here reaches them. The tool's test covers the sound line; nothing new
    #     is refused through the binary but the usage shapes above.
    # (P) scripts/excel-check-open.ps1, changed in this phase (the Close fix, P1
    #     verification ruling 3), read from a git-show copy: it is ASCII and
    #     holds no absolute path, with a planted control for each form, as P1's
    #     family P; and the close sits inside a try with close-error written.
    #
    # WRITTEN FOR M2 part 1 P2 from P1's negative script (printed in
    # records/logs/m2p1-p1/negative.log, attempt 3). From it: lines 1 to 3, the
    # shape greps with controls, the roles by subject, the rerun block,
    # SERIALIZED, the root lines, the counting controls, the scripts checked
    # against the phase commit, the helpers run and refused_with, family P and
    # the log's own byte count. What differs, and why:
    #  1. The phase, the log directory and the subjects are P2's.
    #  2. Family L is gone: this phase does not change the list script. Family N
    #     is new, and runs the gate's binary copied into a worktree under
    #     <home>/.cache/emend-build/m2p1-p2-negative.
    #
    # ATTEMPT 2, after independent check 1 (F1, F9): attempt 1 rebuilt the
    # binary in the worktree instead of copying the gate's in, and its root line
    # said the binary was built in <tree>. Now nothing is built: the gate's host
    # debug binary is copied into <tree>/bin and checked by hash against
    # gate.log. Nothing else changed.
    #  3. The status checks print the status lines and allow planning's
    #     uncommitted spec and this phase's logs and open-check record pair.
    #
    # Usage: m2p1-p2-negative.sh <phase commit> > <scratch file>; the caller moves
    # the output to records/logs/m2p1-p2/negative.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    BUILD_ROOT=$HOME/.cache/emend-build/m2p1-p2-negative
    GATE_BIN=$HOME/.cache/emend-build/m2p1-p2-gate/target/debug/emend-copy
    GATE_LOG=records/logs/m2p1-p2/gate.log
    mkdir -p "$BUILD_ROOT" || exit 2
    TREE=$BUILD_ROOT/tree
    if [ -e "$TREE" ]; then echo "$TREE is already there" >&2; exit 2; fi
    B=$(mktemp -d)
    cleanup() {
      git worktree remove --force "$TREE" >/dev/null 2>&1
      rm -rf "$B"
    }
    trap cleanup EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    TAB=$(printf '\t')
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    OURS='^((\?\?| ?[MARCD]) records/logs/m2p1-p2|(\?\?| ?[MARCD]) records/m2p1-open-| M specs/0016-new-workbook-and-sheets[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's records and planning's spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p2#g" -e "s#$TREE#<tree>#g" -e "s#$BUILD_ROOT#<build>#g" \
        -e "s#$HOME/.cache/emend-build/m2p1-p2-gate#<gatebuild>#g" \
        -e "s#$B#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scratch>/p2/$(basename "$0") $*"
    echo "about: M2 part 1 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M2 part 1 P1 record:')
    DOC1=$(by_subject 'M2 part 1 P2: commit planning docs (the P1 rulings and verification)')
    CODE1=$(by_subject 'M2 part 1 P2: the .ps1 close in a try, and the styles precondition in the crate')
    CODE2=$(by_subject 'M2 part 1 P2: the template, Package::new and --new-sample')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  the P1 record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  code commit 1: ${CODE1:-none}"
    echo "  code commit 2: ${CODE2:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~3"
    for k in 0 1 2 3; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CODE2" "$CODE1" "$DOC1" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "code commits 2 and 1, the doc commit and the base, each the next one's parent, code commit 2 the phase commit" "$(yn roles_in_order)"
    roles_ctl() { local CODE2=$CODE1; if roles_in_order; then return 1; else return 0; fi; }
    check "control: roles_in_order refuses code commit 1 named as code commit 2" "$(yn roles_ctl)"
    echo
    echo "phase: Milestone 2 part 1 P2 (specs/0016-new-workbook-and-sheets.md) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this log builds nothing"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh is sourced from it by this log and its records/logs/m2p1-p2/gate.log is read for the binary's hash; nothing in it is run: the binary under test is the gate's, copied into <tree>/bin and run from there, and the PowerShell script is read from a git-show copy in <scratch>/w/scripts"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p2 stands for this script's own directory, which holds the script"
    echo "root: <build> stands for <home>/.cache/emend-build/m2p1-p2-negative on the disk; <tree> stands for <build>/tree, the detached worktree of the phase commit, which holds the copied binary in <tree>/bin, removed at exit"
    echo "root: <gatebuild> stands for <home>/.cache/emend-build/m2p1-p2-gate, the gate's build directory, from which the gate's host debug binary is copied; read only"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory (the cases' directories and outputs, the PowerShell script's copy and its planted copies), removed at exit"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$B" "$SELF_DIR" && apart "$B" "$MAIN" && apart "$MAIN" "$SELF_DIR" && apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$B"; }
    check "the roots other than <home> are distinct, none inside another" "$(yn roots_distinct)"
    roots_ctl() { if apart "$TREE" "$BUILD_ROOT"; then return 1; else return 0; fi; }
    check "control: apart refuses <tree> against <build>, which holds it" "$(yn roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    echo "at entry: status lines $entry_all; of them this phase's records or planning's spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    echo "no fixture is read: the binary writes its own files; no corpus file is copied or read"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    echo
    echo "## the script read, against the phase commit"
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    echo "command: sha256sum of scripts/excel-check-open.ps1 in the main tree, and of git show <phase commit>:scripts/excel-check-open.ps1"
    echo "    tree $(sha_of scripts/excel-check-open.ps1); commit $(git show "$C:scripts/excel-check-open.ps1" | sha256sum | cut -d' ' -f1)"
    check "scripts/excel-check-open.ps1 in the main tree is the phase commit's" "$(yn tree_is_commit scripts/excel-check-open.ps1)"
    tree_ctl() { if [ "$(git show "$REC:scripts/excel-check-open.ps1" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/excel-check-open.ps1)" ]; then return 1; else return 0; fi; }
    check "control: the same hash comparison tells the base's script from the phase commit's (the Close fix changed it)" "$(yn tree_ctl)"
    
    echo
    echo "## family N: --new-sample through the gate's binary, copied into a worktree"
    echo "command: git worktree add --detach <tree> <phase commit>"
    git worktree add --detach "$TREE" "$C" >/dev/null 2>&1
    check "the worktree is at the phase commit" "$(yn [ "$(git -C "$TREE" rev-parse HEAD)" = "$C" ])"
    GATED=$(sed -n "s#^  <build>/target/debug/emend-copy: sha256 \([0-9a-f]\{64\}\), bytes [0-9]*\$#\1#p" "$GATE_LOG")
    echo "command: sed for the host emend-copy hash in $GATE_LOG (sha256 $(sha_of "$GATE_LOG")): $GATED"
    echo "command: mkdir <tree>/bin; cp <gatebuild>/target/debug/emend-copy <tree>/bin/emend-copy"
    mkdir "$TREE/bin" && cp "$GATE_BIN" "$TREE/bin/emend-copy" >"$B/build.out" 2>&1
    BIN=$TREE/bin/emend-copy
    echo "  <tree>/bin/emend-copy: sha256 $(sha_of "$BIN")"
    check "the copied binary is the one gate.log hashed, not a rebuild" "$(yn [ "$(sha_of "$BIN")" = "$GATED" ])"
    check "control: the reader found a hash in gate.log" "$(yn [ -n "$GATED" ])"
    # run_bin <case> <args...>: the worktree's binary, the command printed with
    # the paths it names, stdout, stderr and exit kept.
    run_bin() {
      local case=$1
      shift
      "$BIN" "$@" >"$B/$case.stdout" 2>"$B/$case.stderr" </dev/null
      echo $? >"$B/$case.status"
      echo "command: <tree>/bin/emend-copy $*"
      echo "  exit: $(cat "$B/$case.status")"
      echo "  stdout:"; sed 's/^/    /' "$B/$case.stdout"
      echo "  stderr:"; sed 's/^/    /' "$B/$case.stderr"
    }
    status_is() { [ "$(cat "$B/$1.status")" = "$2" ]; }
    refused_with() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ "$(cat "$B/$1.stderr")" = "$2" ]; }
    usage_refused() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ "$(count_matches -F 'error: usage: emend-copy' "$B/$1.stderr")" = 1 ]; }
    files_in() { find "$1" -type f | wc -l; }
    
    echo
    echo "### N0: the sound run (the control)"
    mkdir "$B/n0"
    run_bin n0 "$B/n0/a.xlsx" "$B/n0/b.xlsx" --new-sample
    check "N0: exit 0" "$(yn status_is n0 0)"
    check "N0: the line" "$(yn [ "$(cat "$B/n0.stdout")" = "$(printf 'new\tentries=6\tsheets=1\tcells=3\tread_back=3')" ])"
    check "N0: no stderr" "$(yn [ ! -s "$B/n0.stderr" ])"
    check "N0: the two files and nothing else" "$(yn [ "$(files_in "$B/n0")" = 2 ])"
    usage_ctl() { if usage_refused n0; then return 1; else return 0; fi; }
    check "control: usage_refused says no on N0's run" "$(yn usage_ctl)"
    
    echo
    echo "### N1 to N3: the usage shapes the operation adds"
    k=0
    for shape in "--new-sample extra" "--new-sample --formula-sample" "--formula-sample --new-sample"; do
      k=$((k + 1))
      mkdir "$B/n$k"
      # shellcheck disable=SC2086
      run_bin "n$k" "$B/n$k/a.xlsx" "$B/n$k/b.xlsx" $shape
      check "N$k: exit 2, no stdout, the usage line" "$(yn usage_refused "n$k")"
      check "N$k: no file written" "$(yn [ "$(files_in "$B/n$k")" = 0 ])"
    done
    
    echo
    echo "### N4 and N5: a path in a directory that is not there"
    mkdir "$B/n4" "$B/n5"
    run_bin n4 "$B/n4/missing/a.xlsx" "$B/n4/b.xlsx" --new-sample
    check "N4: exit 2, no stdout, stderr exactly the existing message" "$(yn refused_with n4 'error: cannot create the output file: entity not found')"
    check "N4: no file at either path" "$(yn [ "$(files_in "$B/n4")" = 0 ])"
    run_bin n5 "$B/n5/a.xlsx" "$B/n5/missing/b.xlsx" --new-sample
    check "N5: exit 2, no stdout, stderr exactly the existing message" "$(yn refused_with n5 'error: cannot create the output file: entity not found')"
    n5_first_kept() { [ "$(files_in "$B/n5")" = 1 ] && cmp -s "$B/n5/a.xlsx" "$B/n0/a.xlsx"; }
    check "N5: the first file is written and kept, byte for byte N0's, and nothing else is there" "$(yn n5_first_kept)"
    not_n4() { if refused_with n0 'error: cannot create the output file: entity not found'; then return 1; else return 0; fi; }
    check "control: refused_with says no on N0's run" "$(yn not_n4)"
    
    echo
    echo "### what the binary cannot reach (the spec's statement)"
    echo "  Package::new adds no message: on the template's fixed bytes neither write_to nor open refuses (package's module header, and new_is_the_empty_archive_with_the_template_added)."
    echo "  --new-sample's assertions, cells 3 and read_back 3 with the message \"reads back ... written value(s)\", hold on every run from the fixed template, so no input to the binary reaches them; N0 is that run."
    echo "  Nothing else new is refused through the binary: N1 to N3 are the operation's usage shapes, and N4 and N5 reach a message the tool already had."
    NEWMSG=$(git show "$C:tools/emend-copy/src/main.rs" | count_matches -F 'written value(s) and the edits imply' /dev/stdin)
