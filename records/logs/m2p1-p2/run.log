### the first file's entries against the template files (python3 zipfile, not the layer)
    import hashlib, subprocess, sys, zipfile
    archive, commit = sys.argv[1], sys.argv[2]
    want = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
            "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    z = zipfile.ZipFile(archive)
    names = z.namelist()
    print("names in order are the spec's: %s" % ("yes" if names == want else "no"))
    same = 0
    for n in names:
        ref = subprocess.run(["git", "show", "%s:crates/emend/template/%s" % (commit, n)], capture_output=True).stdout
        same += 1 if z.read(n) == ref and len(ref) > 0 else 0
    print("entries byte for byte their template file: %d of %d" % (same, len(names)))
    print("testzip: %s; comment bytes: %d" % (z.testzip() or "ok", len(z.comment)))
    names in order are the spec's: yes
    entries byte for byte their template file: 6 of 6
    testzip: ok; comment bytes: 0
  the first file holds the six template files in the spec's order, byte for byte: yes
  control: the same check on the second file finds five of six, the worksheet edited: yes

