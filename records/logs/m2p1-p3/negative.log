    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    echo "command: sha256sum of scripts/excel-check-open.ps1 in the main tree, and of git show <phase commit>:scripts/excel-check-open.ps1"
