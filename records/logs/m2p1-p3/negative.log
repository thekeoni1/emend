    #!/usr/bin/env bash
    # Milestone 2 part 1 P3 negative.log (specs/0016-new-workbook-and-sheets.md,
    # "P3: `sheets`, `add_sheet`, `rename_sheet`, `move_sheet`": "The negative log
    # through the binary: the refusals `--sheet-sample` can reach (none by name,
    # since the tool names its own sheet; the log says so)"; with the P2
    # verification rulings 2 and 3 and the P3 rulings). Two families:
    #
    # (S) tools/emend-copy's --sheet-sample, the gate's host debug binary copied
    #     into a detached worktree of the phase commit and checked against
    #     gate.log's hash (specs/0001, "How this task runs"; P1 verification
    #     ruling 1), each command printed naming the copy it runs (ruling 4), on
    #     fictional packages this log builds from the phase commit's template
    #     files with one workbook part changed each:
    #       S0 the template itself, the control: exit 0, the one line;
    #       S1 a prefixed workbook root: "a sheet cannot be added to a prefixed
    #          workbook";
    #       S2 a root binding no prefix for the relationships namespace (the
    #          sheet binds its own): "the workbook root binds no prefix for the
    #          relationships namespace";
    #       S3 a comment inside <sheets>: "a sheets element holds something other
    #          than sheet elements";
    #       S4 a defined name whose localSheetId is not a number, which the move
    #          to 0 must remap: "a sheet edit no longer applies at the write"
    #          (P3 ruling 5);
    #     each refusal exit 2, stdout empty, stderr exactly the message, and no
    #     output file; and two usage shapes. The name refusals cannot be reached
    #     through the binary, which names its own sheet: the log says so.
    # (P) scripts/excel-check-open.ps1, changed in this phase (P2 verification
    #     ruling 2), read from a git-show copy: ASCII and no absolute path, with a
    #     planted control per form, as before; the close in a try; and a
    #     close-error after a read-error appended after "; ", never replacing it.
    #
    # WRITTEN FOR M2 part 1 P3 from P2's negative script (printed in
    # records/logs/m2p1-p2/negative.log, attempt 2). What differs, and why:
    #  1. The phase, the log directory and the subjects are P3's.
    #  2. Family N is replaced by family S, on fixtures this log builds.
    #  3. Family P gains the append check.
    #  4. Attempt 2 adds family O (P3 ruling 9): the phase's edit open check
    #     counts an output against its own sheets, run on two pairs from git-show
    #     copies, with the base's copy as the control.
    #
    # Usage: m2p1-p3-negative.sh <phase commit> > <scratch file>; the caller moves
    # the output to records/logs/m2p1-p3/negative.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    BUILD_ROOT=$HOME/.cache/emend-build/m2p1-p3-negative
    GATE_BIN=$HOME/.cache/emend-build/m2p1-p3-gate/target/debug/emend-copy
    GATE_LOG=records/logs/m2p1-p3/gate.log
    mkdir -p "$BUILD_ROOT" || exit 2
    TREE=$BUILD_ROOT/tree
    if [ -e "$TREE" ]; then echo "$TREE is already there" >&2; exit 2; fi
    B=$(mktemp -d)
    cleanup() {
      git worktree remove --force "$TREE" >/dev/null 2>&1
      rm -rf "$B"
    }
    trap cleanup EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    TAB=$(printf '\t')
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
