    cat >"$B/gen-p3.py" <<'PY'
    """Fictional packages for M2 part 1 P3's negative log: the phase commit's
    template files, zipped in the template's order, with the workbook part
    replaced per case. Usage: gen-p3.py <template dir> <out dir>."""
    import os
    import sys
    import zipfile
    
    M = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    R = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    D = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    VIEWS = '<bookViews><workbookView activeTab="0"/></bookViews>'
    SHEET = '<sheet name="Sheet1" sheetId="1" r:id="rId1"/>'
    CASES = {
        "s0": None,
        "s1": D + '<x:workbook xmlns:x="%s" xmlns:r="%s"><x:workbookPr/><x:bookViews><x:workbookView activeTab="0"/>'
              '</x:bookViews><x:sheets><x:sheet name="Sheet1" sheetId="1" r:id="rId1"/></x:sheets></x:workbook>' % (M, R),
        "s2": D + '<workbook xmlns="%s"><workbookPr/>%s<sheets><sheet xmlns:q="%s" name="Sheet1" sheetId="1" q:id="rId1"/>'
              '</sheets></workbook>' % (M, VIEWS, R),
        "s3": D + '<workbook xmlns="%s" xmlns:r="%s"><workbookPr/>%s<sheets>%s<!-- c --></sheets></workbook>' % (M, R, VIEWS, SHEET),
        "s4": D + '<workbook xmlns="%s" xmlns:r="%s"><workbookPr/>%s<sheets>%s</sheets><definedNames>'
              '<definedName name="a" localSheetId="x">Sheet1!A1</definedName></definedNames></workbook>' % (M, R, VIEWS, SHEET),
        "o1": D + '<workbook xmlns="%s" xmlns:r="%s"><workbookPr/>%s<sheets>%s</sheets><extLst><ext uri="urn:emend:fixture">'
              '<y:sheet xmlns:y="urn:emend:fixture" name="Y"/></ext></extLst></workbook>' % (M, R, VIEWS, SHEET),
    }
    src, out = sys.argv[1], sys.argv[2]
    for case, workbook in CASES.items():
        with zipfile.ZipFile(os.path.join(out, case + ".xlsx"), "w") as z:
            for name in ORDER:
                data = open(os.path.join(src, name), "rb").read()
                if name == "xl/workbook.xml" and workbook is not None:
                    data = workbook.encode()
                z.writestr(zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0)), data, zipfile.ZIP_DEFLATED)
    for name in sorted(os.listdir(out)):
        print("%s %d" % (name, os.path.getsize(os.path.join(out, name))))
    PY
    sed 's/^/    /' "$B/gen-p3.py"
