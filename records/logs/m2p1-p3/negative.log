    }
    status_is() { [ "$(cat "$B/$1.status")" = "$2" ]; }
    refused_with() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ "$(cat "$B/$1.stderr")" = "$2" ]; }
    usage_refused() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ "$(count_matches -F 'error: usage: emend-copy' "$B/$1.stderr")" = 1 ]; }
    mkdir "$B/out"
    echo
    echo "### S0: the template, the control"
    run_bin s0 "$B/fx/s0.xlsx" "$B/out/s0.xlsx" --sheet-sample
    check "S0: exit 0" "$(yn status_is s0 0)"
    check "S0: the line" "$(yn [ "$(cat "$B/s0.stdout")" = "$(printf 'sheet\tsheets_before=1\tsheets_after=2\tfirst=1\tcells=1\tnames=0\tactive_before=0\tactive_after=1')" ])"
    check "S0: the output is there" "$(yn [ -s "$B/out/s0.xlsx" ])"
    echo
    echo "### S1 to S4: the refusals --sheet-sample can reach"
    for spec in "s1:a sheet cannot be added to a prefixed workbook" \
                "s2:the workbook root binds no prefix for the relationships namespace" \
                "s3:a sheets element holds something other than sheet elements" \
                "s4:a sheet edit no longer applies at the write"; do
      case=${spec%%:*}
      message=${spec#*:}
      run_bin "$case" "$B/fx/$case.xlsx" "$B/out/$case.xlsx" --sheet-sample
      check "${case^^}: exit 2, no stdout, stderr exactly \"error: $message\"" "$(yn refused_with "$case" "error: $message")"
      check "${case^^}: no output file" "$(yn [ ! -e "$B/out/$case.xlsx" ])"
    done
    not_refused() { if refused_with s0 'error: a sheet edit no longer applies at the write'; then return 1; else return 0; fi; }
    check "control: refused_with says no on S0's run" "$(yn not_refused)"
    check "no temporary is left beside the outputs" "$(yn [ "$(find "$B/out" -type f | wc -l)" = 1 ])"
    echo
    echo "### two usage shapes"
    run_bin u1 "$B/fx/s0.xlsx" "$B/out/u1.xlsx" --sheet-sample extra
    check "U1: exit 2, the usage line" "$(yn usage_refused u1)"
    run_bin u2 "$B/fx/s0.xlsx" "$B/out/u2.xlsx" --sheet-sample --new-sample
    check "U2: exit 2, the usage line" "$(yn usage_refused u2)"
    usage_ctl() { if usage_refused s0; then return 1; else return 0; fi; }
    check "control: usage_refused says no on S0's run" "$(yn usage_ctl)"
    echo
    echo "### what the binary cannot reach (the spec's statement)"
    echo "  The name refusals (empty, long, a character Excel refuses, an apostrophe, History, in use, a character XML cannot carry) cannot be reached: the tool names its own sheet, emend or emendN, the first free. \"no sheet of that name\" and \"a sheet position is past the end\" cannot either: it moves the sheet it added, to 0. The crate's tests cover each."
    git worktree remove --force "$TREE" >/dev/null 2>&1
    check "the worktree is gone from git's list" "$(yn [ "$(git worktree list --porcelain | count_matches -F "$TREE" /dev/stdin)" = 0 ])"
    
    echo
    echo "## family O: the open check counts an output against its own sheets (P3 ruling 9)"
    # The phase's scripts/edit-open-check.sh and scripts/lo-check.sh, and the
    # base's, each from a git-show copy (P1 verification ruling 1), on a keep of
    # two pairs built here: o.grown, the template in and S0's output out (one
    # sheet more, which LibreOffice shows); o.foreign, the template in and o1
    # out, whose workbook declares a second sheet element of a foreign namespace
    # that LibreOffice does not read, so its table count differs from its own
    # declared count.
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    for side in phase base; do
      case $side in phase) at=$C ;; base) at=$REC ;; esac
      mkdir "$B/oc-$side"
      git show "$at:scripts/edit-open-check.sh" >"$B/oc-$side/edit-open-check.sh"
      git show "$at:scripts/lo-check.sh" >"$B/oc-$side/lo-check.sh"
      chmod 755 "$B/oc-$side/edit-open-check.sh"
      echo "command: git show <$side commit>:scripts/edit-open-check.sh and :scripts/lo-check.sh > <scratch>/w/oc-$side/ (sha256 $(sha_of "$B/oc-$side/edit-open-check.sh") and $(sha_of "$B/oc-$side/lo-check.sh"))"
    done
    differs_by_ruling() { [ "$(diff "$B/oc-base/edit-open-check.sh" "$B/oc-phase/edit-open-check.sh" | LC_ALL=C "$G" -c '^> .*lo_check "\$output" .* "\$output"$')" = 1 ]; }
    check "the phase's copy passes the output as its own reference and the base's does not" "$(yn differs_by_ruling)"
    mkdir "$B/okeep"
    cp "$B/fx/s0.xlsx" "$B/okeep/o.grown.in.xlsx"; cp "$B/out/s0.xlsx" "$B/okeep/o.grown.out.xlsx"
    cp "$B/fx/s0.xlsx" "$B/okeep/o.foreign.in.xlsx"; cp "$B/fx/o1.xlsx" "$B/okeep/o.foreign.out.xlsx"
    for side in phase base; do
      mkdir "$B/otmp-$side" "$B/orec-$side"
      echo "command: TMPDIR=<scratch>/w/otmp-$side <scratch>/w/oc-$side/edit-open-check.sh --keep <scratch>/w/okeep --libreoffice $IMAGE --lo-timeout 300 --out <scratch>/w/orec-$side --stem m2p1-negative-o"
      TMPDIR=$B/otmp-$side "$B/oc-$side/edit-open-check.sh" --keep "$B/okeep" --libreoffice "$IMAGE" --lo-timeout 300 \
        --out "$B/orec-$side" --stem m2p1-negative-o >"$B/o-$side.stdout" 2>"$B/o-$side.stderr" </dev/null
      echo $? >"$B/o-$side.status"
      echo "  exit: $(cat "$B/o-$side.status")"
      echo "  stdout:"; sed 's/^/    /' "$B/o-$side.stdout"
      echo "  the rows (test, lo_in, lo, reason_in, reason_out):"
      tail -n +2 "$B/orec-$side/m2p1-negative-o.txt" | cut -f1,6,7,8,9 | sed 's/^/    /'
      echo "  the reasons kept:"
      find "$B/otmp-$side" -name '*-reason.txt' | LC_ALL=C sort | while IFS= read -r f; do echo "    ${f##*/emend-open-check.}: $(cat "$f")" | sed 's#^    [^/]*/#    #'; done
    done
    row_of() { awk -F'\t' -v t="$2" '$1 == t { print $6 " " $7 " " $8 " " $9 }' "$B/orec-$1/m2p1-negative-o.txt"; }
    check "O1: the phase's check accepts the grown output (ok ok none none): its tables are its own sheets" "$(yn [ "$(row_of phase o.grown)" = "ok ok none none" ])"
    check "O2: the phase's check still refuses the foreign output on the count (ok fail none count), the control" "$(yn [ "$(row_of phase o.foreign)" = "ok fail none count" ])"
    check "O2: so the phase's check exits 1, one finding" "$(yn [ "$(cat "$B/o-phase.status")" = 1 ])"
    check "control: the base's check refused the grown output on the count, so the change is what accepts it" "$(yn [ "$(row_of base o.grown)" = "ok fail none count" ])"
    
    echo
    mkdir "$B/scripts"
    git show "$C:scripts/excel-check-open.ps1" >"$B/scripts/excel-check-open.ps1"
    echo "command: git show <phase commit>:scripts/excel-check-open.ps1 > <scratch>/w/scripts/excel-check-open.ps1"
    echo "## family P: scripts/excel-check-open.ps1 is ASCII and holds no absolute path, and its close is in a try"
    PS1=$B/scripts/excel-check-open.ps1
    echo "  scripts/excel-check-open.ps1, its git-show copy <scratch>/w/scripts/excel-check-open.ps1: sha256 $(sha_of "$PS1"), $(wc -c <"$PS1") bytes, $(count_lines "$PS1") lines"
    # The four path forms, built from pieces so this script's own text holds
    # none: a drive letter and a separator; two backslashes before a name; a
    # slash that opens a path after the start, a space, a quote, an equals sign
    # or a parenthesis; a tilde and a separator.
    # BS is an escaped backslash for the pattern; SL is one backslash, for the
    # planted lines.
    BS='\\'
    SL='\'
    P_DRIVE="[A-Za-z]:[${SL}/]"
    P_UNC="${BS}${BS}[A-Za-z0-9._-]"
    P_ROOT="(^|[ \"'=(])/[A-Za-z0-9._-]"
    P_HOME="~[${SL}/]"
    ABS_RE="$P_DRIVE|$P_UNC|$P_ROOT|$P_HOME"
    echo "  the absolute-path form, as built: $ABS_RE"
    n_na=$(count_bytes "$NONASCII_CLASS" "$PS1")
    n_ctrl=$(count_bytes "$CTRL_CLASS" "$PS1")
    n_abs=$(count_matches -E "$ABS_RE" "$PS1")
    echo "  non-ASCII bytes: $n_na; control bytes: $n_ctrl; lines holding an absolute path: $n_abs"
    check "the PowerShell script is ASCII" "$(yn [ "$n_na" = 0 ])"
    check "it holds no control byte" "$(yn [ "$n_ctrl" = 0 ])"
    check "it holds no absolute path" "$(yn [ "$n_abs" = 0 ])"
    plant() { { cat "$PS1"; printf '%s\n' "$2"; } >"$B/ps1-$1"; }
    plant nonascii "# caf$(printf '\303\251')"
    plant drive "\$x = \"Q:${SL}data${SL}f\""
    plant unc "\$x = \"${SL}${SL}server${SL}share\""
    plant root "\$x = \"/srv/data\""
    plant home "\$x = \"~/data\""
    echo "  the planted copies, each the script with one line appended; nonascii's line is a comment holding one two-byte character, not printed, since a log holds no non-ASCII byte; the others' lines are printed after the name:"
    for k in drive unc root home; do echo "    $k: $(tail -n 1 "$B/ps1-$k")"; done
    check "control: the same byte count finds the planted non-ASCII character (2 bytes)" "$(yn [ "$(count_bytes "$NONASCII_CLASS" "$B/ps1-nonascii")" = 2 ])"
    for k in drive unc root home; do
      check "control: the same form finds the planted $k path on one line" "$(yn [ "$(count_matches -E "$ABS_RE" "$B/ps1-$k")" = 1 ])"
    done
    rel_ok() { printf '%s\n' '$p = Join-Path $root "files\corpus"' 'scripts/excel-check-list.py' '$r.file -replace "/", "\"' >"$B/ps1-rel"; [ "$(count_matches -E "$ABS_RE" "$B/ps1-rel")" = 0 ]; }
    check "control: the same form passes the relative shapes the script uses (a backslash inside a relative path, a repository path, the slash replacement)" "$(yn rel_ok)"
    own_dir() { [ "$(count_matches -F '$root = $PSScriptRoot' "$PS1")" = 1 ] && [ "$(count_matches -F 'Join-Path $root' "$PS1")" -ge 3 ]; }
    check "every path the script opens or writes is built from its own directory (\$PSScriptRoot, then Join-Path)" "$(yn own_dir)"
    close_in_try() { awk '/^ *try \{$/ { t = NR } /\$wb\.Close\(\$false\)/ { c = NR } END { exit !(c == t + 1) }' "$PS1" && [ "$(count_matches -F 'close-error' "$PS1")" -ge 1 ]; }
    check "the close is the first line of a try, and close-error is written (P1 verification ruling 3)" "$(yn close_in_try)"
    git show "$(git log --format=%H -n 1 --grep='^M2 part 1 P1 record:')":scripts/excel-check-open.ps1 >"$B/ps1-base"
    close_ctl_p1() { if awk '/^ *try \{$/ { t = NR } /\$wb\.Close\(\$false\)/ { c = NR } END { exit !(c == t + 1) }' "$B/ps1-base"; then return 1; else return 0; fi; }
    check "control: the same test says no on P1's script, whose close was outside a try" "$(yn close_ctl_p1)"
    appends() { [ "$(count_matches -F 'if ($message) { $message = $message + "; " + $closed } else { $message = $closed }' "$PS1")" = 1 ]; }
    check "a close-error after a read-error is appended after \"; \", never replacing it (P2 verification ruling 2)" "$(yn appends)"
    git show "$REC:scripts/excel-check-open.ps1" >"$B/ps1-p2"
    append_ctl() { [ "$(count_matches -F 'if ($message) { $message = $message + "; " + $closed } else { $message = $closed }' "$B/ps1-p2")" = 0 ]; }
    check "control: the same count finds no append in the base's script" "$(yn append_ctl)"
    
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.stdout "$B"/*.stderr "$B"/gen-p3.out; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs, its record pairs or planning's uncommitted spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
  control count_matches with a regular expression: 2 (expect 2)
  control count_matches on an unreadable file: error (expect error)
  control count_matches on readable plus unreadable: error (expect error)
  control count_from_file on the same file: 2 (expect 2)
  control count_from_file on a file with none: 0 (expect 0)
