    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p3 stands for this script's own directory, which holds the script"
    echo "root: <build> stands for <home>/.cache/emend-build/m2p1-p3-negative on the disk; <tree> stands for <build>/tree, the detached worktree of the phase commit, which holds the copied binary in <tree>/bin, removed at exit"
