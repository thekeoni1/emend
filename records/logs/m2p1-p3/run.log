## the run log's comparison (python3, zipfile and expat, P3 ruling 8)
command: sed 's/^/    /' <scratch>/w/sheetcmp.py; sha256 826df53ef38c337e268262b891ae031d41578da2c226586c9651eae25189ad79, 11949 bytes
    """The run log's own sheet comparison (specs/0016-new-workbook-and-sheets.md,
    "Harness runs", P3, with the planning rulings during P3, 1 and 8).
    
    Usage: sheetcmp.py <input archive> <output archive> <template worksheet> [--plant <flag>]
    
    Reads both archives with zipfile and expat, sharing no code with the layer or
    the tool, and compares them as --sheet-sample should have changed them. Prints
    ONE line of counts and yes/no flags: no sheet name, no defined name's text,
    no part name.
    
    Flags:
      others_same      every entry but the workbook part, its rels part and the
                       content types is byte for byte the input's, and the output
                       has exactly one entry more
      added_bytes      that entry is the template worksheet with <sheetData/>
                       replaced by the one row the cell rewrite writes (ruling 1)
      added_cell       read with expat, it holds one cell, A1, value 7
      outside_same     the workbook part's bytes outside <sheets>, <definedNames>
                       and <bookViews> are the input's
      sheets_first     the output's sheet elements are one new element followed by
                       the input's own, byte for byte, in order
      new_sheet_ok     the new element names the added part through a new
                       relationship and carries sheetId one more than the largest
      names_shifted    every definedName start tag is the input's with a present
                       localSheetId one more, in the same order and number
      views_shifted    every workbookView start tag is the input's with activeTab
                       one more (absent read 0, so appended) and firstSheet
                       unchanged (ruling 8)
      rels_plus_one    the workbook's rels part is the input's plus one worksheet
                       relationship before its end tag
      types_plus_one   the content types are the input's plus one Override for the
                       added part before its end tag, or unchanged when a Default
                       for xml of the worksheet type covers it
    
    --plant <flag> changes the output as read, before the comparison, so that the
    named flag turns to no; it prints planted=yes when it changed something and
    planted=no when the pair gives it nothing to change.
    """
    import re
    import sys
    import zipfile
    from xml.parsers import expat
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    REL = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
           "http://purl.oclc.org/ooxml/officeDocument/relationships")
    WS_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"
    FLAGS = ["others_same", "added_bytes", "added_cell", "outside_same", "sheets_first",
             "new_sheet_ok", "names_shifted", "views_shifted", "rels_plus_one", "types_plus_one"]
    
    
    def read(path):
        z = zipfile.ZipFile(path)
        return [(i.filename, z.read(i.filename)) for i in z.infolist()]
    
    
    def rels_part(part):
        folder, _, name = part.rpartition("/")
        return (folder + "/" if folder else "") + "_rels/" + name + ".rels"
    
    
    def workbook_name(entries):
        rels = dict(entries)["_rels/.rels"]
        found = []
    
        def start(tag, attrs):
            if tag.endswith("Relationship") and attrs.get("Type", "").endswith("/officeDocument"):
                found.append(attrs["Target"].lstrip("/"))
        p = expat.ParserCreate()
        p.StartElementHandler = start
        p.Parse(rels, True)
        return found[0]
    
    
    def region(raw, local):
        """(start, end) byte span of the root child <local ...>...</local> or
        <local .../>, prefix-tolerant; None when absent."""
        m = re.search(rb"<(\w+:)?" + local + rb"(\s[^>]*)?/>", raw)
        m2 = re.search(rb"<(\w+:)?" + local + rb"(\s[^>]*)?>", raw)
        if m2 and not raw[m2.start():m2.end()].endswith(b"/>"):
            close = re.search(rb"</(\w+:)?" + local + rb">", raw[m2.end():])
            return (m2.start(), m2.end() + close.end())
        if m:
            return (m.start(), m.end())
        return None
    
    
    def children(raw, span, local):
        """The byte strings of <local .../> or <local ...>...</local> elements
        inside span, in order, prefix-tolerant."""
        if span is None:
            return []
        inner = raw[span[0]:span[1]]
        return [m.group(0) for m in re.finditer(
            rb"<(\w+:)?" + local + rb"(\s[^>]*?)?(/>|>.*?</(\w+:)?" + local + rb">)", inner, re.S)]
    
    
    def start_tag(element):
        return element[:element.index(b">") + 1]
    
    
    def attr(tag, name):
        m = re.search(rb"\s" + name + rb"\s*=\s*([\"'])(.*?)\1", tag, re.S)
        return None if m is None else m.group(2)
    
    
    def with_attr(tag, name, value):
        m = re.search(rb"(\s" + name + rb"\s*=\s*)([\"'])(.*?)\2", tag, re.S)
        if m:
            return tag[:m.start(3)] + value + tag[m.end(3):]
        end = len(tag) - (2 if tag.endswith(b"/>") else 1)
        body = tag[:end].rstrip() if False else tag[:end]
        return body + b" " + name + b"=\"" + value + b"\"" + tag[end:]
    
    
    def main():
        args = sys.argv[1:]
        plant = args[args.index("--plant") + 1] if "--plant" in args else None
        inp, outp, template = args[0], args[1], args[2]
        before = read(inp)
        after = read(outp)
        tmpl = open(template, "rb").read()
        wb = workbook_name(before)
        wb_rels = rels_part(wb)
        b = dict(before)
        a = dict(after)
        planted = None
    
        def plant_here(flag):
            return plant == flag
    
        # --- entries
        special = {wb, wb_rels, "[Content_Types].xml"}
        added = [n for n, _ in after if n not in b]
        if plant_here("others_same"):
            for n, _ in before:
                if n not in special:
                    a[n] = a[n] + b" "
                    planted = "yes"
                    break
        others_same = (len(after) == len(before) + 1 and len(added) == 1
                       and all(a.get(n) == d for n, d in before if n not in special))
        part = added[0] if added else ""
        if plant_here("added_bytes") and part:
            a[part] = a[part] + b" "
            planted = "yes"
        want = tmpl.replace(b"<sheetData/>", b"<sheetData><row r=\"1\"><c r=\"A1\"><v>7</v></c></row></sheetData>")
        added_bytes = bool(part) and a.get(part) == want
        cells = []
        if part:
            data = a[part]
            if plant_here("added_cell"):
                data = data.replace(b"<v>7</v>", b"<v>8</v>")
                planted = "yes"
            state = {"in": None, "v": False, "text": ""}
    
            def s(tag, attrs):
                local = tag.rsplit(" ", 1)[-1]
                if local == "c":
                    state["in"] = attrs.get("r")
                    state["text"] = ""
                elif local == "v":
                    state["v"] = True
    
            def e(tag):
                local = tag.rsplit(" ", 1)[-1]
                if local == "v":
                    state["v"] = False
                elif local == "c":
                    cells.append((state["in"], state["text"]))
    
            def t(text):
                if state["v"]:
                    state["text"] += text
            p = expat.ParserCreate(namespace_separator=" ")
            p.StartElementHandler, p.EndElementHandler, p.CharacterDataHandler = s, e, t
            try:
                p.Parse(data, True)
            except expat.ExpatError:
                cells = [("error", "")]
        added_cell = cells == [("A1", "7")]
    
        # --- workbook part
        wi, wo = b[wb], a[wb]
        if plant_here("outside_same"):
            wo = wo.replace(b"<", b" <", 1) if not wo.startswith(b"\xef\xbb\xbf") else wo[:3] + b" " + wo[3:]
            planted = "yes"
        spans_i = {k: region(wi, k) for k in (b"sheets", b"definedNames", b"bookViews")}
        spans_o = {k: region(wo, k) for k in (b"sheets", b"definedNames", b"bookViews")}
    
        def outside(raw, spans):
            cut = sorted(s for s in spans.values() if s)
            out, at = b"", 0
            for s0, s1 in cut:
                out += raw[at:s0] + b"|"
                at = s1
            return out + raw[at:]
        outside_same = outside(wi, spans_i) == outside(wo, spans_o) and \
            [k for k in spans_i if spans_i[k]] == [k for k in spans_o if spans_o[k]]
        sh_i = children(wi, spans_i[b"sheets"], b"sheet")
        sh_o = children(wo, spans_o[b"sheets"], b"sheet")
        if plant_here("sheets_first") and len(sh_o) > 1:
            sh_o = [sh_o[0]] + sh_o[2:] + [sh_o[1]]
            planted = "yes" if len(sh_o) > 2 else "no"
        sheets_first = len(sh_o) == len(sh_i) + 1 and sh_o[1:] == sh_i
        rels_i, rels_o = b[wb_rels], a[wb_rels]
        new_id = attr(start_tag(sh_o[0]), rb"\w+:id") if sh_o else None
        ids = [int(x) for x in re.findall(rb"sheetId\s*=\s*[\"'](\d+)", b"".join(sh_i))]
        new_sheet_id = attr(start_tag(sh_o[0]), b"sheetId") if sh_o else None
        if plant_here("new_sheet_ok") and new_sheet_id is not None:
            new_sheet_id = b"0"
            planted = "yes"
        rel_targets = dict(re.findall(rb"Id\s*=\s*\"([^\"]+)\"[^>]*Target\s*=\s*\"([^\"]+)\"", rels_o))
        target = rel_targets.get(new_id, b"").decode()
        folder = wb.rpartition("/")[0]
        new_sheet_ok = (new_id is not None and new_id not in dict(re.findall(rb"Id\s*=\s*\"([^\"]+)\"()", rels_i))
                        and (folder + "/" + target if folder else target) == part
                        and new_sheet_id == str(max(ids, default=0) + 1).encode())
        # definedNames
        dn_i = [start_tag(x) for x in children(wi, spans_i[b"definedNames"], b"definedName")]
        dn_o = [start_tag(x) for x in children(wo, spans_o[b"definedNames"], b"definedName")]
        if plant_here("names_shifted"):
            hit = [k for k, t in enumerate(dn_o) if attr(t, b"localSheetId") is not None]
            if hit:
                dn_o[hit[0]] = with_attr(dn_o[hit[0]], b"localSheetId", b"99999")
                planted = "yes"
            else:
                planted = "no"
        def shifted(tag):
            v = attr(tag, b"localSheetId")
            return tag if v is None else with_attr(tag, b"localSheetId", str(int(v) + 1).encode())
        names_shifted = [shifted(t) for t in dn_i] == dn_o
        # bookViews
        bv_i = [start_tag(x) for x in children(wi, spans_i[b"bookViews"], b"workbookView")]
        bv_o = [start_tag(x) for x in children(wo, spans_o[b"bookViews"], b"workbookView")]
        if plant_here("views_shifted") and bv_o:
            bv_o[0] = with_attr(bv_o[0], b"firstSheet", b"7")
            planted = "yes"
        def view(tag):
            v = attr(tag, b"activeTab")
            return with_attr(tag, b"activeTab", str((int(v) if v is not None else 0) + 1).encode())
        views_shifted = [view(t) for t in bv_i] == bv_o
        # rels
        if plant_here("rels_plus_one"):
            rels_o = rels_o.replace(b"<Relationship ", b"<Relationship  ", 1)
            planted = "yes"
        end_i = rels_i.rfind(b"</")
        added_rel = rels_o[end_i:len(rels_o) - (len(rels_i) - end_i)]
        rels_plus_one = (rels_o[:end_i] == rels_i[:end_i] and rels_o.endswith(rels_i[end_i:])
                         and added_rel.count(b"<Relationship ") == 1 and b"/worksheet\"" in added_rel)
        # content types
        ti, to = b["[Content_Types].xml"], a["[Content_Types].xml"]
        if plant_here("types_plus_one"):
            to = to + b" "
            planted = "yes"
        covered = re.search(rb"<Default[^>]*Extension=\"xml\"[^>]*ContentType=\"" + WS_TYPE.encode() + rb"\"", ti) is not None
        end_t = ti.rfind(b"</")
        added_ct = to[end_t:len(to) - (len(ti) - end_t)]
        types_plus_one = (to == ti) if covered else (
            to[:end_t] == ti[:end_t] and to.endswith(ti[end_t:])
            and added_ct == b"<Override PartName=\"/" + part.encode() + b"\" ContentType=\"" + WS_TYPE.encode() + b"\"/>")
        values = [others_same, added_bytes, added_cell, outside_same, sheets_first, new_sheet_ok,
                  names_shifted, views_shifted, rels_plus_one, types_plus_one]
        out = ["sheets_in=%d" % len(sh_i), "sheets_out=%d" % len(sh_o), "names=%d" % len(dn_i),
               "names_local=%d" % sum(1 for t in dn_i if attr(t, b"localSheetId") is not None),
               "views=%d" % len(bv_i), "override=%d" % (0 if covered else 1)]
        out += ["%s=%s" % (f, "yes" if v else "no") for f, v in zip(FLAGS, values)]
        if plant:
            out.append("planted=%s" % (planted or "no"))
        print("\t".join(out))
    
    
    main()
