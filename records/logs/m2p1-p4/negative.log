    #!/usr/bin/env bash
    # Milestone 2 part 1 P4 negative.log (specs/0016-new-workbook-and-sheets.md,
    # "P4: `remove_sheet`, the catalogue and limits, the size record": "The
    # negative log through the binary: `--remove-sample` on a one-sheet workbook
    # (identical output, `removed` 0) and on a workbook whose only other sheet is
    # hidden"; with the P4 rulings). One family:
    #
    # (R) tools/emend-copy's --remove-sample, the gate's host debug binary copied
    #     into a detached worktree of the phase commit and checked against
    #     gate.log's hash (specs/0001, "How this task runs"; P1 verification
    #     ruling 1), each command printed naming the copy it runs, on fictional
    #     packages this log builds from the phase commit's template files:
    #       R0 two sheets, the control: exit 0, removed 1, the one line;
    #       R1 the template, one sheet: exit 0, removed 0, the output the input's
    #          bytes (the last sheet is not removed);
    #       R2 two sheets, the first hidden: exit 0, removed 0, the output the
    #          input's bytes (the last visible sheet is not removed);
    #       R3 two sheets, the first with state="visible": exit 0, removed 1
    #          (P4 ruling 1 through the binary);
    #       R4 two sheets, the second active, a defined name scoped to each:
    #          exit 0, removed 1, local_removed 1, the active tab to 0;
    #       R5 two sheets and a defined name whose localSheetId is not a number:
    #          exit 2, "a sheet edit no longer applies at the write", no output;
    #     and two usage shapes. What the binary cannot reach is stated.
    #
    # WRITTEN FOR M2 part 1 P4 from P3's negative script (printed in
    # records/logs/m2p1-p3/negative.log). What differs, and why:
    #  1. The phase, the log directory and the subjects are P4's.
    #  2. Family S is replaced by family R, on fixtures this log builds.
    #  3. Families O and P are gone: this phase changes neither the open check nor
    #     the PowerShell script.
    #
    # Usage: m2p1-p4-negative.sh <phase commit> > <scratch file>; the caller moves
    # the output to records/logs/m2p1-p4/negative.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    BUILD_ROOT=$HOME/.cache/emend-build/m2p1-p4-negative
    GATE_BIN=$HOME/.cache/emend-build/m2p1-p4-gate/target/debug/emend-copy
    GATE_LOG=records/logs/m2p1-p4/gate.log
    mkdir -p "$BUILD_ROOT" || exit 2
    TREE=$BUILD_ROOT/tree
    if [ -e "$TREE" ]; then echo "$TREE is already there" >&2; exit 2; fi
    B=$(mktemp -d)
    cleanup() {
      git worktree remove --force "$TREE" >/dev/null 2>&1
      rm -rf "$B"
    }
    trap cleanup EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    TAB=$(printf '\t')
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    OURS='^((\?\?| ?[MARCD]) records/logs/m2p1-p4|(\?\?| ?[MARCD]) records/(m2p1-(p4|open)|size-m2p1)-| M specs/0016-new-workbook-and-sheets[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's records and planning's spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p4#g" -e "s#$TREE#<tree>#g" -e "s#$BUILD_ROOT#<build>#g" \
        -e "s#$HOME/.cache/emend-build/m2p1-p4-gate#<gatebuild>#g" \
        -e "s#$B#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scratch>/p4/$(basename "$0") $*"
