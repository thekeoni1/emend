### this log's generator, from the phase commit's template files
    """Fictional packages for M2 part 1 P4's negative log: the phase commit's
    template files, zipped in the template's order; every case but r1 gains a
    second worksheet (its part the template's blank worksheet, an Override and a
    relationship) and its own workbook part. Usage: gen-p4.py <template dir>
    <out dir>."""
    import os
    import sys
    import zipfile
    
    M = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    R = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    D = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    WS = "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    
    
    def workbook(first_state, active, names):
        state = '' if first_state is None else ' state="%s"' % first_state
        return (D + '<workbook xmlns="%s" xmlns:r="%s"><workbookPr/><bookViews><workbookView activeTab="%d"/>'
                '</bookViews><sheets><sheet name="One"%s sheetId="1" r:id="rId1"/>'
                '<sheet name="Two" sheetId="2" r:id="rId3"/></sheets>%s</workbook>'
                % (M, R, active, state, names))
    
    
    SCOPED = ('<definedNames><definedName name="a" localSheetId="0">One!A1</definedName>'
              '<definedName name="b" localSheetId="1">Two!A1</definedName></definedNames>')
    NOT_A_NUMBER = '<definedNames><definedName name="a" localSheetId="x">One!A1</definedName></definedNames>'
    CASES = {
        "r0": workbook(None, 0, ""),
        "r1": None,
        "r2": workbook("hidden", 1, ""),
        "r3": workbook("visible", 0, ""),
        "r4": workbook(None, 1, SCOPED),
        "r5": workbook(None, 0, NOT_A_NUMBER),
    }
    src, out = sys.argv[1], sys.argv[2]
    for case, book in CASES.items():
        with zipfile.ZipFile(os.path.join(out, case + ".xlsx"), "w") as z:
            def put(name, data):
                z.writestr(zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0)), data, zipfile.ZIP_DEFLATED)
            for name in ORDER:
                data = open(os.path.join(src, name), "rb").read()
                if book is not None and name == "[Content_Types].xml":
                    data = data.replace(b"</Types>", ('<Override PartName="/xl/worksheets/sheet2.xml" '
                                                       'ContentType="%s"/></Types>' % WS).encode())
                if book is not None and name == "xl/workbook.xml":
                    data = book.encode()
                if book is not None and name == "xl/_rels/workbook.xml.rels":
                    data = data.replace(b"</Relationships>", ('<Relationship Id="rId3" Type="%s/worksheet" '
                                                               'Target="worksheets/sheet2.xml"/></Relationships>'
                                                               % R).encode())
                put(name, data)
            if book is not None:
                put("xl/worksheets/sheet2.xml", open(os.path.join(src, "xl/worksheets/sheet1.xml"), "rb").read())
    for name in sorted(os.listdir(out)):
        print("%s %d" % (name, os.path.getsize(os.path.join(out, name))))
