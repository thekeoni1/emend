    build_probe committed
    rc_committed=$?
    measure committed
    check "the committed probe builds" "$(yn [ "$rc_committed" = 0 ])"
    reproduces() { [ "${SHA[committed]}" = "$WAS_SHA" ] && [ "${SECT[committed]}" = "$WAS_SECT" ] && [ "${FILE[committed]}" = "$WAS_FILE" ]; }
    check "the rebuild reproduces size.log attempt 3's sha256 and figures, so the variants are measured as size.log measures" "$(yn reproduces)"
    
    # plant <from> <to>: the one occurrence of <from> in the worktree's probe
