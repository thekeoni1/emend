    #!/usr/bin/env bash
    # Milestone 2 part 1 P4 size-attribution.log (specs/0016-new-workbook-and-sheets.md,
    # "Planning rulings during P4", ruling 10): after size.log attempt 3 measured
    # the budget figure over its ceiling, three variants of
    # probe-emend-sheets-write-xml are built and measured exactly as size.log
    # measures the probes, in a detached worktree of the phase commit, each
    # variant's diff printed:
    #   (a) no Package::new call: the third output is not written, new_bytes 0;
    #   (b) no sheet edits: add_sheet, move_sheet, rename_sheet and remove_sheet
    #       removed with the name of the sheet that was first, the rest kept;
    #   (c) Package::new's bytes written to a file and reopened through
    #       BufReader<File>, the byte count taken from the reopened package, so
    #       the probe's own code names only one reader type. Package::new's own
    #       body opens and writes a Package over a Cursor, so the crate's
    #       instantiation for that reader stays whatever the probe does; the
    #       figure measures what the probe's side can change.
    # Each variant's section bytes, file bytes and .text are printed, and its
    # section bytes' difference from the committed probe's, which this log
    # rebuilds first as the control and checks against size.log attempt 3's
    # figures and sha256.
    #
    # WRITTEN FOR M2 part 1 P4 from this phase's size script (its build and
    # measure forms: the size profile, i686-unknown-linux-musl, features
    # emend,xml, `size -A` for the section total and .text). No crate code is
    # changed: the variants change the probe's source in the worktree alone, and
    # the worktree is removed at the end.
    #
    # Usage: m2p1-p4-size-attribution.sh <phase commit> <size.log attempt 3> > <scratch file>
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    SIZE3=${2:?size.log attempt 3 required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    I686=i686-unknown-linux-musl
    PROBE=probe-emend-sheets-write-xml
    SRC=tools/size-probe/src/bin/$PROBE.rs
    BUILD_ROOT=$HOME/.cache/emend-build/m2p1-p4-attr
    TREE=$BUILD_ROOT/tree
    if [ -e "$TREE" ]; then echo "$TREE is already there" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    T=$(mktemp -d)
    cleanup() {
      git worktree remove --force "$TREE" >/dev/null 2>&1
      rm -rf "$T"
    }
    trap cleanup EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    section() {
      local out
      out=$(size -A "$1" 2>/dev/null) || { printf 'error'; return; }
      printf '%s\n' "$out" | awk -v s="$2" '$1 == s { print $2; found = 1 } END { if (!found) print "error" }'
    }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    OURS='^((\?\?| ?[MARCD]) records/logs/m2p1-p4|(\?\?| ?[MARCD]) records/(m2p1-(p4|open)|size-m2p1)-| M specs/0016-new-workbook-and-sheets[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's records and planning's spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p4#g" -e "s#$TREE#<tree>#g" -e "s#$BUILD_ROOT#<build>#g" \
        -e "s#$T#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scratch>/p4/$(basename "$0") $1 <scratch>/p4/$(basename "$(dirname "$SIZE3")")/$(basename "$SIZE3")"
    echo "about: M2 part 1 P4 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$T/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$T/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M2 part 1 P3 record:')
    DOC1=$(by_subject 'M2 part 1 P4: commit planning docs (the P3 rulings and verification)')
    CODE1=$(by_subject 'M2 part 1 P4: remove_sheet, the walk, the chain rule, the catalogue and limits')
    CODE2=$(by_subject 'M2 part 1 P4: probe-emend-sheets-write-xml and --remove-sample')
    CODE3=$(by_subject 'M2 part 1 P4: a removed rels part loses its Override too')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  the P3 record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  code commit 1: ${CODE1:-none}"
    echo "  code commit 2: ${CODE2:-none}"
    echo "  code commit 3: ${CODE3:-none}"
    roles_in_order() {
      local r k=0
      for r in "$CODE3" "$CODE2" "$CODE1" "$DOC1" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "code commits 3, 2 and 1, the doc commit and the base, each the next one's parent, code commit 3 the phase commit" "$(yn roles_in_order)"
    roles_ctl() { local CODE3=$CODE2; if roles_in_order; then return 1; else return 0; fi; }
    check "control: roles_in_order refuses code commit 2 named as code commit 3" "$(yn roles_ctl)"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    echo
    echo "phase: Milestone 2 part 1 P4 (specs/0016-new-workbook-and-sheets.md) size-attribution.log, P4 ruling 10; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory, <build>/target (CARGO_TARGET_DIR)"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh is sourced from it; nothing in it is built or changed"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p4 stands for this script's own directory, which holds the script and size.log attempt 3, read for the committed probe's figures"
    echo "root: <build> stands for <home>/.cache/emend-build/m2p1-p4-attr on the disk: <build>/target the size builds, <tree> = <build>/tree the detached worktree of the phase commit whose probe source the variants change, removed at exit"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory (the shape fixture, the build outputs and the variant binaries' copies), removed at exit"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$T" "$SELF_DIR" && apart "$T" "$MAIN" && apart "$MAIN" "$SELF_DIR" && apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$T"; }
