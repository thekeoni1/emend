    plant() {
      python3 - "$TREE/$SRC" "$1" "$2" <<'PLANT_PY'
    import sys
    path, old, new = sys.argv[1], sys.argv[2], sys.argv[3]
    text = open(path, encoding="utf-8").read()
    if text.count(old) != 1:
        sys.exit(1)
    open(path, "w", encoding="utf-8").write(text.replace(old, new))
    PLANT_PY
    }
    unplant() { git -C "$TREE" checkout -- "$SRC"; }
    variant() {
      # variant <label> <description>, after its plants: the diff, the build,
      # the figures, the difference from the committed probe; then restored.
      local label=$1
      echo "command: git -C <tree> diff -- $SRC"
