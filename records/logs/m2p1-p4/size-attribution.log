      build_probe "$label"
      local rc=$?
      check "variant $label builds" "$(yn [ "$rc" = 0 ])"
      measure "$label"
      echo "  variant $label: sections ${SECT[$label]}, the committed probe's ${SECT[committed]}: difference $((SECT[$label] - SECT[committed])); file difference $((FILE[$label] - FILE[committed])); .text difference $((TEXT[$label] - TEXT[committed]))"
      unplant
      clean_again() { [ -z "$(git -C "$TREE" status --porcelain)" ]; }
      check "variant $label: the worktree is clean again after it" "$(yn clean_again)"
    }
    
    echo
    echo "## variant (a): no Package::new call"
    plant 'Ok((counts, written, new_workbook(third)?))' 'Ok((counts, written, {
                let _ = third;
                0u64
            }))'
    pa1=$?
    plant '/// `Package::new()` written to `third`, and the bytes written.' '/// `Package::new()` written to `third`, and the bytes written.
    #[allow(dead_code)]'
    pa2=$?
    check "variant a: both plants applied, exactly one occurrence each" "$(yn [ "$((pa1 + pa2))" = 0 ])"
    variant a
    
    echo
    echo "## variant (b): no sheet edits"
    plant '    let first = package
            .sheets()
            .map_err(|e| e.to_string())?
            .first()
            .map(|sheet| sheet.name.clone())
            .ok_or("the workbook has no sheet")?;
        package.add_sheet(&edits.added).map_err(|e| e.to_string())?;
        package
            .move_sheet(&edits.added, 0)
            .map_err(|e| e.to_string())?;
        package
            .rename_sheet(&edits.added, &edits.renamed)
            .map_err(|e| e.to_string())?;
        package.remove_sheet(&first).map_err(|e| e.to_string())?;
    ' '    let _ = (&edits.added, &edits.renamed);
    '
    pb=$?
    check "variant b: the plant applied, exactly one occurrence" "$(yn [ "$pb" = 0 ])"
    variant b
    
    echo
    echo "## variant (c): Package::new's bytes written to a file and reopened through BufReader<File>"
    plant '    let bytes = std::fs::metadata(third)
            .map_err(|e| e.kind().to_string())?
            .len();
        Ok(bytes)' '    let reopened = Package::open(BufReader::new(
            File::open(third).map_err(|e| e.kind().to_string())?,
        ))
        .map_err(|e| e.to_string())?;
        Ok(reopened.archive().entries().len() as u64)'
    pc=$?
    check "variant c: the plant applied, exactly one occurrence" "$(yn [ "$pc" = 0 ])"
    variant c
    
    echo
    echo "## the figures"
    echo "  the committed probe: sections ${SECT[committed]} (size.log attempt 3: $WAS_SECT)"
    for v in a b c; do
      echo "  variant $v: sections ${SECT[$v]}; difference from the committed probe $((SECT[$v] - SECT[committed]))"
    done
    all_measured() { local v; for v in committed a b c; do [ "${SECT[$v]:-error}" != error ] || return 1; done; }
    check "all four builds were measured" "$(yn all_measured)"
    
