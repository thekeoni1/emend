    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## toolchain"
    rustc --version
    cargo --version
    echo "command: size --version"
    size --version | head -1 | sed 's/^/    /'
    
    echo
    echo "## the committed probe's figures, read from size.log attempt 3"
    echo "command: sha256sum <scratch>/p4/out/size.log (attempt 3, at $C); sed for the probe's figures line"
    echo "  size.log attempt 3: sha256 $(sha_of "$SIZE3"), $(wc -c <"$SIZE3") bytes"
    ROW=$(LC_ALL=C "$G" -E "^<build>/target/$I686/size/$PROBE: file " "$SIZE3")
    echo "  its line: $ROW"
    WAS_FILE=$(printf '%s\n' "$ROW" | sed -n 's/.*: file \([0-9]*\) bytes;.*/\1/p')
    WAS_SECT=$(printf '%s\n' "$ROW" | sed -n 's/.* sections \([0-9]*\);.*/\1/p')
    WAS_SHA=$(printf '%s\n' "$ROW" | sed -n 's/.* sha256 \([0-9a-f]\{64\}\)$/\1/p')
    echo "  read: file $WAS_FILE, sections $WAS_SECT, sha256 $WAS_SHA"
    was_read() { [ -n "$WAS_FILE" ] && [ -n "$WAS_SECT" ] && [ "${#WAS_SHA}" = 64 ]; }
    check "the committed probe's figures and sha256 were read from size.log attempt 3" "$(yn was_read)"
    about_at_c() { [ "$(sed -n 's/^about: M2 part 1 P4 phase commit \([0-9a-f]*\);.*/\1/p' "$SIZE3")" = "$C" ]; }
    check "size.log attempt 3 was measured at this phase commit" "$(yn about_at_c)"
    
    echo
    echo "## the worktree, and the committed probe rebuilt as the control"
    echo "command: git worktree add --detach <tree> <phase commit>"
    git worktree add --detach "$TREE" "$C" >"$T/wt.out" 2>&1
    sed 's/^/    /' "$T/wt.out"
    check "the worktree is at the phase commit" "$(yn [ "$(git -C "$TREE" rev-parse HEAD)" = "$C" ])"
    build_probe() {
      # build_probe <label>: the size build of the probe from the worktree, its
      # output kept, the binary copied to <scratch>/w/<label>.
      echo "command: (cd <tree> && cargo build -p size-probe --bin $PROBE --features emend,xml --profile size --target $I686 --offline)"
      (cd "$TREE" && cargo build -p size-probe --bin "$PROBE" --features emend,xml --profile size --target "$I686" --offline) >"$T/b-$1.out" 2>&1 </dev/null
      local rc=$?
      echo "  exit: $rc; build output lines $(count_lines "$T/b-$1.out"), of them warnings or errors $(count_matches -E '^(warning|error)' "$T/b-$1.out")"
      LC_ALL=C "$G" -E '^(warning|error)' -A 6 "$T/b-$1.out" | sed 's/^/    /'
      cp "$CARGO_TARGET_DIR/$I686/size/$PROBE" "$T/$1" 2>/dev/null
      return "$rc"
    }
    declare -A FILE SECT TEXT SHA
    measure() {
      FILE[$1]=$(stat -c %s "$T/$1")
      SECT[$1]=$(section "$T/$1" Total)
      TEXT[$1]=$(section "$T/$1" .text)
      SHA[$1]=$(sha_of "$T/$1")
      echo "  $1: file ${FILE[$1]} bytes; sections ${SECT[$1]}; .text ${TEXT[$1]}; sha256 ${SHA[$1]}"
