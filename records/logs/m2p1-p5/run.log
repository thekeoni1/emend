## the run log's comparison (python3, zipfile, expat and byte spans, with its own walk)
command: sed 's/^/    /' <scratch>/w/removecmp.py; sha256 3fb2e4b643ccc1c6f3291bbc01d6a29c3f9a4704c0d7d67fb225a6f89b11e40b, 14537 bytes
    """The run log's own removal comparison (specs/0016-new-workbook-and-sheets.md,
    "Harness runs", P4, with the planning rulings during P4, 1 to 5).
    
    Usage: removecmp.py <input archive> <output archive> [--plant <flag>]
    
    Reads both archives with zipfile, expat and byte spans, sharing no code with
    the layer or the tool, walks the input's relationships itself, and compares
    the output with what --remove-sample should have made of the input: the last
    sheet of the list removed when another visible sheet stays, nothing changed
    otherwise. Prints ONE line of counts and yes/no flags: no sheet name, no
    defined name's text, no part name.
    
    A sheet is visible when its state is absent or exactly "visible" (P4 ruling
    1). The walk: R is every entry reachable from the removed sheet's part
    through internal relationships, the part included; K is every entry
    reachable from the package relationships with the removed sheet's
    relationship left out and no edge followed out of its part. The removed set
    is R less K, each with its rels part when there is one, and the calculation
    chain's entry when the workbook has a calcChain relationship.
    
    Flags:
      removed_set     the entries the output lacks are exactly the walk's set,
                      and the output adds none
      kept_same       every other entry but the workbook part, its rels part and
                      the content types is byte for byte the input's
      outside_same    the workbook part's bytes outside <sheets>, <definedNames>,
                      <bookViews> and <calcPr> are the input's
      sheets_minus    the output's sheet elements are the input's, byte for byte,
                      less the last when it was removed
      names_local     the definedName elements are the input's, byte for byte,
                      less those whose localSheetId is the removed sheet's index
      views_remapped  every workbookView start tag is the input's with an
                      activeTab naming the removed sheet sent to the first visible
                      sheet's index, and a present firstSheet less the removed
                      sheets before it, clamped to the last index (ruling 8)
      rels_minus      the workbook's rels part is the input's less the removed
                      sheet's Relationship element and the chain's
      types_minus     the content types are the input's less the Override
                      elements of the removed entries
      chain_rule      with a chain before: no calcChain relationship after, and a
                      calcPr carrying fullCalcOnLoad="1"; without one: the calcPr
                      span unchanged
    
    --plant <flag> changes the output as read, before the comparison, so that the
    named flag turns to no; it prints planted=yes when it changed something and
    planted=no when the pair gives it nothing to change.
    """
    import posixpath
    import re
    import sys
    import zipfile
    from xml.parsers import expat
    
    FLAGS = ["removed_set", "kept_same", "outside_same", "sheets_minus", "names_local",
             "views_remapped", "rels_minus", "types_minus", "chain_rule"]
    
    
    def read(path):
        z = zipfile.ZipFile(path)
        return [(i.filename, z.read(i.filename)) for i in z.infolist()]
    
    
    def rels_part(source):
        if source == "":
            return "_rels/.rels"
        folder, _, name = source.rpartition("/")
        return (folder + "/" if folder else "") + "_rels/" + name + ".rels"
    
    
    def relationships(entries, source):
        """(id, type, target entry or None, external, element bytes) per
        Relationship of source's rels part, in order."""
        data = entries.get(rels_part(source))
        if data is None:
            return []
        found = []
    
        def start(tag, attrs):
            if tag.rsplit(" ", 1)[-1] == "Relationship":
                found.append(attrs)
        p = expat.ParserCreate(namespace_separator=" ")
        p.StartElementHandler = start
        p.Parse(data, True)
        elements = re.findall(rb"<(?:\w+:)?Relationship\s[^>]*?/>|<(?:\w+:)?Relationship\s[^>]*?>.*?</(?:\w+:)?Relationship>",
                              data, re.S)
        out = []
        for k, attrs in enumerate(found):
            external = attrs.get("TargetMode") == "External"
            target = attrs.get("Target", "")
            entry = None
            if not external:
                if target.startswith("/"):
                    path = target[1:]
                else:
                    path = posixpath.join(source.rpartition("/")[0], target)
                parts = []
                ok = True
                for seg in path.split("/"):
                    if seg in ("", "."):
                        continue
                    if seg == "..":
                        if not parts:
                            ok = False
                            break
                        parts.pop()
                    else:
                        parts.append(seg)
                if ok and parts:
                    entry = "/".join(parts)
            element = elements[k] if k < len(elements) else b""
            out.append((attrs.get("Id"), attrs.get("Type", ""), entry, external, element))
        return out
    
    
    def reach(entries, root, skip, stops):
        found, seen = [], set()
        if root:
            if root not in entries:
                return found
            found.append(root)
            seen.add(root)
        queue = [root]
        while queue:
            source = queue.pop(0)
            if source in stops:
                continue
            for rid, _, entry, external, _ in relationships(entries, source):
                if external or (source, rid) in skip or entry is None or entry not in entries:
                    continue
                if entry not in seen:
                    seen.add(entry)
                    found.append(entry)
                    queue.append(entry)
        return found
    
    
    def region(raw, local):
        """(start, end) byte span of the root child <local ...>...</local> or
        <local .../>, prefix-tolerant; None when absent."""
        m2 = re.search(rb"<(\w+:)?" + local + rb"(\s[^>]*)?>", raw)
        if m2 is None:
            return None
        if raw[m2.start():m2.end()].endswith(b"/>"):
            return (m2.start(), m2.end())
        close = re.search(rb"</(\w+:)?" + local + rb">", raw[m2.end():])
        return (m2.start(), m2.end() + close.end())
    
    
    def children(raw, span, local):
        if span is None:
            return []
        inner = raw[span[0]:span[1]]
        return [m.group(0) for m in re.finditer(
            rb"<(\w+:)?" + local + rb"(\s[^>]*?)?(/>|>.*?</(\w+:)?" + local + rb">)", inner, re.S)]
    
    
    def start_tag(element):
        return element[:element.index(b">") + 1]
    
    
    def attr(tag, name):
        m = re.search(rb"\s" + name + rb"\s*=\s*([\"'])(.*?)\1", tag, re.S)
        return None if m is None else m.group(2)
    
    
    def with_attr(tag, name, value):
        m = re.search(rb"(\s" + name + rb"\s*=\s*)([\"'])(.*?)\2", tag, re.S)
        if m:
            return tag[:m.start(3)] + value + tag[m.end(3):]
        end = len(tag) - (2 if tag.endswith(b"/>") else 1)
        return tag[:end] + b" " + name + b"=\"" + value + b"\"" + tag[end:]
    
    
    def visible(element):
        state = attr(start_tag(element), b"state")
        return state is None or state == b"visible"
    
    
    def main():
        args = sys.argv[1:]
        plant = args[args.index("--plant") + 1] if "--plant" in args else None
        before, after = read(args[0]), read(args[1])
        b, a = dict(before), dict(after)
        planted = None
    
        def plant_here(flag):
            return plant == flag
    
        wb = [e for _, t, e, x, _ in relationships(b, "") if t.endswith("/officeDocument") and not x][0]
        wb_rels = rels_part(wb)
        wi, wo = b[wb], a[wb]
        spans_i = {k: region(wi, k) for k in (b"sheets", b"definedNames", b"bookViews", b"calcPr")}
        sh_i = children(wi, spans_i[b"sheets"], b"sheet")
        last = len(sh_i) - 1
        removable = len(sh_i) > 1 and any(visible(x) for x in sh_i[:-1])
        rels_i = relationships(b, wb)
        chain_rels = [r for r in rels_i if r[1].endswith("/calcChain")]
        chain_before = bool(chain_rels)
    
        # --- the walk, from the input alone
        expected = set()
        last_rid = attr(start_tag(sh_i[-1]), rb"\w+:id") if sh_i else None
        last_rel = [r for r in rels_i if last_rid is not None and r[0] == last_rid.decode()]
        if removable and last_rel:
            part = last_rel[0][2]
            stops = {part}
            r_set = reach(b, part, set(), set())
            k_set = set(reach(b, "", {(wb, last_rel[0][0])}, stops))
            for e in r_set:
                if e not in k_set:
                    expected.add(e)
                    if rels_part(e) in b:
                        expected.add(rels_part(e))
            for r in chain_rels[:1]:
                if r[2] in b:
                    expected.add(r[2])
    
        # --- entries
        special = {wb, wb_rels, "[Content_Types].xml"}
        if plant_here("removed_set"):
            for n, _ in after:
                if n not in special:
                    del a[n]
                    planted = "yes"
                    break
        gone = set(b) - set(a)
        removed_set = gone == expected and not (set(a) - set(b))
        if plant_here("kept_same"):
            for n, _ in after:
                if n not in special and n in a:
                    a[n] = a[n] + b" "
                    planted = "yes"
                    break
        kept_same = all(a[n] == d for n, d in before if n not in special and n in a)
    
        # --- workbook part
        if plant_here("outside_same"):
            wo = wo.replace(b"<", b" <", 1) if not wo.startswith(b"\xef\xbb\xbf") else wo[:3] + b" " + wo[3:]
            planted = "yes"
        spans_o = {k: region(wo, k) for k in (b"sheets", b"definedNames", b"bookViews", b"calcPr")}
    
        def outside(raw, spans):
            cut = sorted(s for s in spans.values() if s)
            out, at = b"", 0
            for s0, s1 in cut:
                out += raw[at:s0] + b"|"
                at = s1
            return out + raw[at:]
    
        def regions_equal():
            present_i = [k for k in spans_i if spans_i[k]]
            present_o = [k for k in spans_o if spans_o[k]]
            if chain_before and removable:
                present_i = [k for k in present_i if k != b"calcPr"]
                present_o = [k for k in present_o if k != b"calcPr"]
                return present_i == present_o and outside(wi, spans_i).replace(b"|", b"") == outside(wo, spans_o).replace(b"|", b"")
            return present_i == present_o and outside(wi, spans_i) == outside(wo, spans_o)
        outside_same = regions_equal()
        sh_o = children(wo, spans_o[b"sheets"], b"sheet")
        if plant_here("sheets_minus"):
            sh_o = sh_o + sh_o[:1]
            planted = "yes"
        sheets_minus = sh_o == (sh_i[:-1] if removable else sh_i)
        dn_i = children(wi, spans_i[b"definedNames"], b"definedName")
        dn_o = children(wo, spans_o[b"definedNames"], b"definedName")
        if plant_here("names_local"):
            dn_o = dn_o + [b"<definedName name=\"planted\">1</definedName>"]
            planted = "yes"
    
        def scoped(element):
            v = attr(start_tag(element), b"localSheetId")
            return v is not None and v.isdigit() and int(v) == last
        want_names = [x for x in dn_i if not (removable and scoped(x))]
        names_local = dn_o == want_names
        local = len(dn_i) - len(want_names)
        bv_i = [start_tag(x) for x in children(wi, spans_i[b"bookViews"], b"workbookView")]
        bv_o = [start_tag(x) for x in children(wo, spans_o[b"bookViews"], b"workbookView")]
        if plant_here("views_remapped") and bv_o:
            bv_o[0] = with_attr(bv_o[0], b"firstSheet", b"77")
            planted = "yes"
        first_visible = next((k for k, x in enumerate(sh_o) if visible(x)), 0)
    
        def view(tag):
            if not removable:
                return tag
            active = attr(tag, b"activeTab")
            if active is not None and active.isdigit() and int(active) == last:
                tag = with_attr(tag, b"activeTab", str(first_visible).encode())
            first = attr(tag, b"firstSheet")
            if first is not None and first.isdigit():
                v = int(first)
                moved = min(v - (1 if last < v else 0), len(sh_i) - 2)
                if moved != v:
                    tag = with_attr(tag, b"firstSheet", str(moved).encode())
            return tag
        views_remapped = [view(t) for t in bv_i] == bv_o
    
        # --- rels and content types
        ri, ro = b[wb_rels], a[wb_rels]
        if plant_here("rels_minus"):
            ro = ro + b" "
            planted = "yes"
        want_rels = ri
        if removable and last_rel:
            want_rels = want_rels.replace(last_rel[0][4], b"", 1)
            for r in chain_rels[:1]:
                want_rels = want_rels.replace(r[4], b"", 1)
        rels_minus = ro == want_rels
        ti, to = b["[Content_Types].xml"], a["[Content_Types].xml"]
        if plant_here("types_minus"):
            to = to + b" "
            planted = "yes"
        want_types = ti
        for e in sorted(expected):
            m = re.search(rb"<(\w+:)?Override\s[^>]*PartName\s*=\s*\"/" + re.escape(e.encode()) + rb"\"[^>]*/>", want_types)
            if m:
                want_types = want_types[:m.start()] + want_types[m.end():]
        types_minus = to == want_types
    
        # --- the chain rule
        rels_o = relationships(dict(a, **{wb_rels: ro}), wb) if wb_rels in a else []
        chain_after = any(r[1].endswith("/calcChain") for r in rels_o)
        calc_o = wo[spans_o[b"calcPr"][0]:spans_o[b"calcPr"][1]] if spans_o[b"calcPr"] else b""
        calc_i = wi[spans_i[b"calcPr"][0]:spans_i[b"calcPr"][1]] if spans_i[b"calcPr"] else b""
        if plant_here("chain_rule"):
            if chain_before and removable:
                calc_o = calc_o.replace(b"fullCalcOnLoad=\"1\"", b"fullCalcOnLoad=\"0\"")
                planted = "yes" if calc_o != wo[spans_o[b"calcPr"][0]:spans_o[b"calcPr"][1]] else "no"
            else:
                calc_o = calc_o + b" "
                planted = "yes"
        if chain_before and removable:
            chain_rule = not chain_after and attr(calc_o, b"fullCalcOnLoad") in (b"1", b"true")
        else:
            chain_rule = calc_o == calc_i and chain_after == chain_before
    
        active_i = attr(bv_i[0], b"activeTab") if bv_i else None
        active_o = attr(bv_o[0], b"activeTab") if bv_o else None
        values = [removed_set, kept_same, outside_same, sheets_minus, names_local, views_remapped,
                  rels_minus, types_minus, chain_rule]
        out = ["sheets_in=%d" % len(sh_i), "sheets_out=%d" % len(sh_o), "removable=%d" % (1 if removable else 0),
               "parts=%d" % len(gone), "chain_before=%d" % (1 if chain_before else 0),
               "chain_after=%d" % (1 if chain_after else 0), "names_in=%d" % len(dn_i), "names_out=%d" % len(dn_o),
               "local=%d" % (local if removable else 0),
               "active_in=%s" % (int(active_i) if active_i and active_i.isdigit() else 0),
               "active_out=%s" % (int(active_o) if active_o and active_o.isdigit() else 0)]
        out += ["%s=%s" % (f, "yes" if v else "no") for f, v in zip(FLAGS, values)]
        if plant:
            out.append("planted=%s" % (planted or "no"))
        print("\t".join(out))
    
    
    main()
