    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line:
                out.append(line)
        return out
    
    
    def listed(names):
        return ["- `%s`" % n for n in names] if names else ["None."]
    
    
    def count(col, v):
