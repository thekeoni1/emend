    #!/usr/bin/env bash
    # Milestone 2 part 1 P5 size.log (specs/0016-new-workbook-and-sheets.md, "P5:
    # one copy of the read and write paths", with "Planning rulings during P5"):
    # the THIRTEEN size probes built in the size profile for
    # i686-unknown-linux-musl, each with its own feature set, as P4 built them
    # (records/logs/m2p1-p5/size.log); all thirteen compared with P4's record,
    # records/size-m2p1-2026-09-25-3bd4257.md, by the byte classifier with every
    # difference classified; the figures "P5" asks for; the core built with the
    # dates feature off and on, on both targets; the thirteen probes run on
    # generated fictional packages; the release binaries the corpus run uses; and
    # the record.
    #
    # What "P5" asks this log to print, all of it measured here:
    #  - for all thirteen probes, the file size, the section total and .text from
    #    `size -A`;
    #  - all thirteen against P4's record: the rebuild at P4's commit reproducing
    #    P4's log's sha256, every difference classified from the bytes, the sheets
    #    probe's difference from P4's 1012208 and every earlier probe's
    #    difference from its P4 figure;
    #  - the budget figure, probe-emend-sheets-write-xml over probe-zip-xml,
    #    against the ceiling of 393216 section bytes, with the headroom or the
    #    excess in words and the file delta beside it;
    #  - the largest growth among the twelve earlier probes;
    #  - the whole growth since part 6's 312812 restated, with the part's own cost
    #    (the sheets probe over the formulas probe) and the formulas probe's
    #    drift since part 6's commit beside it;
    #  - the dates feature's cost, outside the budget, as P4's record carries it.
    #  - P5's acceptance: the sheets probe at least 100000 section bytes below
    #    1012208, and the budget figure under 393216, each a check.
    #
    # WRITTEN FOR M2 part 1 P5 from P4's size script (attempt 6, printed in
    # records/logs/m2p1-p5/size.log), audited against specs/0001 "Rules for every
    # phase" and specs/0016's P4 verification rulings and P5 rulings, and grepped
    # for P4's names, paths, subjects and typed lists. What differs, and why:
    #  1. The phase, the log directory, the record names and planning's file are
    #     P5's; the previous record and log are P4's, its commit read from the
    #     record. Part 6's record is still read, for the growth since part 6 and
    #     the two figures specs/0016 states (312812, 80404).
    #  2. All thirteen probes are rebuilt at P4's commit and compared, the sheets
    #     probe included; P4's log wrote its target directory as <build>/target,
    #     which is how its hashes are read back.
    #  3. The figures block is rebuilt for "P5": the sheets probe against P4's
    #     figure with P5's acceptance, every earlier probe's difference and the
    #     largest growth, the budget figure against P4's and against the
    #     ceiling, and the growth since part 6. P4's attribution block and its
    #     finding section go: they were P4 rulings 10 and 11's.
    #  4. The record is P5's: the probes against P4 with a difference column, the
    #     ceiling sentence in ruling 11's words ("above the ceiling by <n>" when
    #     above, "<n> under the ceiling" when under), and, above the ceiling, the
    #     sentence that the maintainer re-rules before P5's record commit.
    #  5. The build directory is <home>/.cache/emend-build/m2p1-p5-size; the
    #     run log reads the release binaries back from there. Lines 1 to 3 are
    #     the command, the invocation and "about:"; then the three shape greps,
    #     then the phase's commits by role. No commit id is typed.
    #  6. The last lines name every check that was not as expected (P4 attempt 4,
    #     kept).
    #
    # THE RELEASE BINARIES. specs/0016 "P5" has the corpus run use the binaries
    # this log hashed. This log builds emend-copy and xlsx-diff in the release
    # profile for both targets and hashes them, each on a line
    # "hash: <name> <target> <sha256>" for the run log to read back by command.
    #
    # File sizes on this target move in 4096-byte steps (the DIFFERENCES between
    # probes are whole pages, the sizes are not); the section figures resolve to
    # the byte. Both are printed, and the record says why.
    #
    # PLANNING'S FILES. specs/0016 stands modified and uncommitted (the P5
    # rulings); the entry guard and the status check count it by name, and print
    # its sha256 at entry and at the end.
    #
    # Usage: m2p1-p5-size.sh <phase commit> <record output file> > <scratch file>,
    # run from the repository root; the caller moves the output to
    # records/logs/m2p1-p5/size.log and the record to
    # records/size-m2p1-<utc-date>-<shortsha>.md.
    #
    # Every check with more than one condition is a named function, defined on the
    # line before it and called through yn (specs/0001-bootstrap.md, "Rules for
    # every phase"). None of the three shapes that file forbids appears here; the
    # shapes are described rather than written out.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    RECORD_OUT=${2:?record output file required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    BUILD_ROOT=$HOME/.cache/emend-build/m2p1-p5-size
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    I686=i686-unknown-linux-musl
    PREV_REC=records/size-m2p1-2026-09-25-3bd4257.md
    PREV_LOG=records/logs/m2p1-p4/size.log
    P6_REC=records/size-m1p6-2026-09-23-e0a7b95.md
    # The checkpoint ruling recorded in specs/0010, "Size", which specs/0016
    # "Size" keeps. What part 6 spent is read from its record below, not typed.
    CEILING=393216
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT INT TERM HUP
    fail=0
    FAILED=()
    check() { echo "$1: $2"; [ "$2" = yes ] || { fail=1; FAILED+=("$1"); }; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # The whole of stdout is scrubbed below; hide is kept as a pass-through for
    # the blocks that call it.
    hide() { cat; }
    # static_i686_stripped <binary>: file(1) reports a stripped static 32-bit i386 ELF.
    static_i686_stripped() {
      local d
      d=$(file -b "$1")
      [[ "$d" == *"ELF 32-bit LSB executable, Intel i386"* ]] && [[ "$d" == *"statically linked"* ]] && [[ "$d" == *", stripped"* ]]
    }
    # section <binary> <name>: a section's size from `size -A`, or "error".
    section() {
      local out
      out=$(size -A "$1" 2>/dev/null) || { printf 'error'; return; }
      printf '%s\n' "$out" | awk -v s="$2" '$1 == s { print $2; found = 1 } END { if (!found) print "error" }'
    }
    
    # specs/0001 "Rules for every phase": the phase commit is GIVEN to the script
    # and compared with HEAD, both printed, with a control that refuses a
    # fabricated commit. The hard guard is here, before a line of log exists.
    HEAD_SHA=$(git rev-parse HEAD)
    NULL_SHA=0000000000000000000000000000000000000000
    full_sha() {
      printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'
    }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    not_head() { if is_head "$1"; then return 1; else return 0; fi; }
    if is_head "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    # The entry guard: every change must be under this phase's log directory, or be
    # one of its record pairs or its size record, or one of planning's files
    # modified and uncommitted (header).
    PLANNING_RE='^ M (specs/0016-new-workbook-and-sheets[.]md|ROADMAP[.]md)$'
    PLANNING_FILES=$(git status --porcelain | LC_ALL=C "$G" -E "$PLANNING_RE" | cut -c4-)
    entry_all=$(run_lines git status --porcelain)
    entry_log=$(run_matches -E '^(\?\?| ?[MARCD]) (records/logs/m2p1-p5|records/m2p1-(p4|open)-|records/size-m2p1-)' git status --porcelain)
    entry_planning=$(run_matches -E "$PLANNING_RE" git status --porcelain)
    entry_clean() {
      [ "$entry_all" != error ] && [ "$entry_log" != error ] && [ "$entry_planning" != error ] &&
        [ "$entry_all" = "$((entry_log + entry_planning))" ]
    }
    if entry_clean; then :; else echo "the working tree holds changes outside this phase's records" >&2; exit 2; fi
    
    # Every printed line passes through this scrub (header change 8).
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p5#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$T#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    # The invocation as run, the script's directory written as <repo> or <scratch>:
    # an absolute machine path in a log is a defect (T0 P6d ruling).
    inv_path=$0
    case "$inv_path" in
      "$MAIN"/*) inv_path="<repo>/${inv_path#"$MAIN"/}" ;;
      /*) inv_path="<scratch>/p5/$(basename "$inv_path")" ;;
    esac
    echo "invocation: bash $inv_path $*"
    echo "about: M2 part 1 P5 phase commit $C; HEAD at run: $HEAD_SHA"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001; P1 check 1's F4)"
    # specs/0001: the scan greps every printed script for three forbidden shapes,
    # and they run here, first, over this script's own file, each with a positive
    # control through the same command form. The patterns and the fixture are
    # assembled from pieces at run time, so this script's text holds none of them.
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    SHAPE_DIR=$(mktemp -d -p "$T")
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$SHAPE_DIR/fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$SHAPE_DIR/fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      SHAPE_RESULT_SELF=$n_self
      SHAPE_RESULT_FIX=$n_fix
      check "$shape: this script holds none" "$(yn [ "$SHAPE_RESULT_SELF" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$SHAPE_RESULT_FIX" = 1 ])"
    done
    rm -rf "$SHAPE_DIR"
    
    echo
    echo "## the phase's commits by role, read from git (header change 6)"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M2 part 1 P4 record: ')
    DOC=$(by_subject 'M2 part 1 P5: commit planning docs (the P4 rulings and verification, P5)')
    CODE1=$(by_subject "M2 part 1 P5: the archive's reader erased once, at Archive::open")
    CODE2=$(by_subject "M2 part 1 P5: the package's method bodies compiled once, on Parts")
    CODE3=$(by_subject 'M2 part 1 P5: the cell walk compiled once, on Walk')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  the P4 record commit: ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  code commit 1: ${CODE1:-none}"
    echo "  code commit 2: ${CODE2:-none}"
    echo "  code commit 3: ${CODE3:-none}"
    echo "command: git rev-parse <phase commit> <phase commit>^ <phase commit>^^ <phase commit>^^^ <phase commit>^^^^"
    git rev-parse "$C" "$C^" "$C^^" "$C^^^" "$C^^^^" | sed 's/^/    /'
    roles_in_order() {
      [ -n "$REC" ] && [ -n "$DOC" ] && [ -n "$CODE1" ] && [ -n "$CODE2" ] && [ -n "$CODE3" ] || return 1
      [ "$CODE3" = "$C" ] || return 1
      [ "$(git rev-parse "$C^")" = "$CODE2" ] || return 1
      [ "$(git rev-parse "$C^^")" = "$CODE1" ] || return 1
      [ "$(git rev-parse "$C^^^")" = "$DOC" ] || return 1
      [ "$(git rev-parse "$C^^^^")" = "$REC" ]
    }
    check "code commit 3 is the phase commit, code commits 2 and 1 its parents in turn, the doc commit code commit 1's, the P4 record commit the doc commit's" "$(yn roles_in_order)"
    roles_ctl() { local CODE2=$CODE3; if roles_in_order; then return 1; else return 0; fi; }
    check "control: roles_in_order refuses code commit 3 named as code commit 2" "$(yn roles_ctl)"
    no_such_subject() { [ -z "$(by_subject 'M2 part 1 P5: no such subject anywhere')" ]; }
    check "control: a subject no commit has resolves to nothing" "$(yn no_such_subject)"
    echo
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $HEAD_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn is_head "$C")"
    check "control: the same comparison refuses the null commit" "$(yn not_head "$NULL_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" \
      "$(yn not_head "$(printf '%s' "$C" | cut -c1-7)")"
    echo "phase: Milestone 2 part 1 P5 (specs/0016-new-workbook-and-sheets.md) size.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      # specs/0001 "Rules for every phase": every sha256 a log cites, a superseded
      # attempt's included, is PRINTED BY A COMMAND run over a file that exists at
      # run time, never typed from memory.
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    # SERIALIZED as the coordinator arranged, backed by a measurement at entry
