    #!/usr/bin/env bash
    # Milestone 2 part 2 P1 negative.log (specs/0017-fuller-styles.md, "P1: the
    # types, fonts and fills, the five-container rewrite": "The negative log
    # through the binary: `--font-sample` on a workbook whose styles part lacks
    # `fonts` (refused, ..., no output; a fixture built from the template with
    # the collection removed)"; the expected exit is 2, "Planning rulings during
    # P1 (2026-09-25)" ruling 4). One family:
    #
    # (F) tools/emend-copy's --font-sample, the gate's host debug binary copied
    #     into a detached worktree of the phase commit and checked against
    #     gate.log's hash (specs/0001, "How this task runs"), each command
    #     printed naming the copy it runs, on fictional packages this log builds
    #     from the phase commit's template files:
    #       F0 the template, the control: exit 0, the one line (no cell to
    #          restyle, so styled 0; one font, one fill and two cell formats
    #          added; the new cell A1 read back);
    #       F1 the template without `fonts`: exit 2, "a style addition needs a
    #          collection the styles part lacks", no stdout, no output (the
    #          spec's case, ruling 4);
    #       F2 the template without `fills`: the same refusal;
    #       F3 the template with a second, empty `fonts`: exit 2, the widened
    #          two-containers message ("Module `styles`: the counts"), no output;
    #     and two usage shapes. What the binary cannot reach is stated.
    #
    # WRITTEN FOR M2 part 2 P1 from M2 part 1 P4's negative script (printed in
    # records/logs/m2p1-p4/negative.log; part 1 P5 wrote none). What differs, and
    # why:
    #  1. The phase, the log directory, the subjects and the build directories
    #     are P1's of part 2; the gate's binary and hash are this phase's
    #     (records/logs/m2p2-p1/gate.log).
    #  2. Family R is replaced by family F, on fixtures this log builds.
    #  3. Planning's P1 rulings sit in specs/0017 uncommitted; the entry guard
    #     and the status block allow that one path and this phase's logs and
    #     its two record pairs.
    #  4. None of the three shapes specs/0001 forbids appears here.
    #
    # Usage: m2p2-p1-negative.sh <phase commit> > <scratch file>; the caller moves
    # the output to records/logs/m2p2-p1/negative.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    BUILD_ROOT=$HOME/.cache/emend-build/m2p2-p1-negative
    GATE_BIN=$HOME/.cache/emend-build/m2p2-p1-gate/target/debug/emend-copy
    GATE_LOG=records/logs/m2p2-p1/gate.log
    mkdir -p "$BUILD_ROOT" || exit 2
    TREE=$BUILD_ROOT/tree
    if [ -e "$TREE" ]; then echo "$TREE is already there" >&2; exit 2; fi
    B=$(mktemp -d)
    cleanup() {
      git worktree remove --force "$TREE" >/dev/null 2>&1
      rm -rf "$B"
    }
    trap cleanup EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    TAB=$(printf '\t')
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    OURS='^((\?\?| ?[MARCD]) records/logs/m2p2-p1|(\?\?| ?[MARCD]) records/m2p2-(p1|open)-| M specs/0017-fuller-styles[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's records and planning's spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p1#g" -e "s#$TREE#<tree>#g" -e "s#$BUILD_ROOT#<build>#g" \
        -e "s#$HOME/.cache/emend-build/m2p2-p1-gate#<gatebuild>#g" \
        -e "s#$B#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
