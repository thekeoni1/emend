    # form. What differs, and why:
    #  1. The phase, the log directory and the status terms are P1's of part 2
    #     (records/logs/m2p2-p1); the previous phase's figures and names are read
    #     from records/logs/m2p1-p5/test.log, the last test log committed.
    #  2. The commits by role: part 1's close-out record commit (the base), the
    #     doc commit and the three code commits, each by its full subject.
    #  3. P1 adds tests and removes none: the checks that P5 added and removed
    #     none become checks that the source adds at least one, removes none,
    #     and that every added test passed on both targets; the run's added names
    #     are the source's.
    #  4. New block: the keyword test run alone on the host with --nocapture, its
    #     "keyword" lines printed; each keyword is its variant's name with the
    #     first letter lowered, which is the lower camel case every schema
    #     keyword the spec names takes; the lines printed are as many as the
    #     test's rows in the source.
    #  5. Build directories: <home>/.cache/emend-build/m2p2-p1-test.
    #  6. Planning's P1 rulings sit in specs/0017 uncommitted; the entry guard
    #     and the status block allow that one path and this phase's logs and its
    #     two record pairs, and print the status lines.
    #  7. No planted mutation is carried and none is claimed anywhere: no P1
    #     ruling asks for one (specs/0016 P4 ruling 8 stands: such a claim is a
    #     test.log measurement or is not made).
    #  8. Everything else is P5's final form. None of the three shapes specs/0001
    #     forbids appears here.
    #
    # Usage: m2p2-p1-test.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m2p2-p1/test.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    KEEP_WAS_SET=$([ -n "${EMEND_KEEP_DIR+x}" ] && echo yes || echo no)
    unset EMEND_KEEP_DIR
    BUILD_ROOT=$HOME/.cache/emend-build/m2p2-p1-test
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT INT TERM HUP
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    passed_matches() { [ "$passed" -gt 0 ] && [ "$passed" -eq "$nok" ]; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
