    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh is sourced from it by this log and its records/logs/m2p2-p2/gate.log is read for the binary's hash and the template files are read from it by git show; nothing in it is run: the binary under test is the gate's, copied into <tree>/bin and run from there"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p2 stands for this script's own directory, which holds the script and, in <scratch>/p2/out, its own standard error (ruling 7)"
