    #       B2 the template with a second, empty `borders`: exit 2, the widened
    #          two-containers message, no output;
    #     and two usage shapes. What the binary cannot reach is stated.
    #
    # CARRIED TO M2 part 2 P2 from P1's negative script (printed in
    # records/logs/m2p2-p1/negative.log). What differs, and why:
    #  A. The phase, the log directory, the subjects and the build directories
    #     are P2's; the gate's binary and hash are this phase's
    #     (records/logs/m2p2-p2/gate.log).
    #  B. Family F is replaced by family B, on fixtures this log builds.
    #  C. Ruling 7: this script's standard error goes to <scratch>/p2/out/
    #     negative.stderr from its start and is counted at the end, expecting 0,
    #     with a control on a copy one byte longer.
    #  D. Planning's spec is committed; should rulings stand in specs/0017
    #     uncommitted, the entry guard and the status block allow that path.
    #
    # Usage: m2p2-p2-negative.sh <phase commit> > <scratch file>; the caller moves
    # the output to records/logs/m2p2-p2/negative.log.
    set -uo pipefail
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # Ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/negative.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    BUILD_ROOT=$HOME/.cache/emend-build/m2p2-p2-negative
    GATE_BIN=$HOME/.cache/emend-build/m2p2-p2-gate/target/debug/emend-copy
    GATE_LOG=records/logs/m2p2-p2/gate.log
    mkdir -p "$BUILD_ROOT" || exit 2
    TREE=$BUILD_ROOT/tree
    if [ -e "$TREE" ]; then echo "$TREE is already there" >&2; exit 2; fi
    B=$(mktemp -d)
    cleanup() {
      git worktree remove --force "$TREE" >/dev/null 2>&1
      rm -rf "$B"
