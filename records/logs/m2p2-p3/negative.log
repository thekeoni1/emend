    #!/usr/bin/env bash
    # Milestone 2 part 2 P3 negative.log (specs/0017-fuller-styles.md, "P3":
    # "the negative log through the binary with every refusal of this part
    # reachable through the binary run once (the two collection refusals; a name
    # or a range refusal is not reachable, since the tool's constants are fixed,
    # and the log says so)"). One family:
    #
    # (R) tools/emend-copy's --font-sample and --border-sample, the gate's host
    #     debug binary copied into a detached worktree of the phase commit and
    #     checked against gate.log's hash, on fictional packages this log builds
    #     from the phase commit's template files:
    #       R0 the template, --font-sample, the control: exit 0, its line;
    #       R1 the template, --border-sample, the control: exit 0, its line;
    #       R2 without fonts, --font-sample: exit 2, "a style addition needs a
    #          collection the styles part lacks", no output;
    #       R3 without fills, --font-sample: the same;
    #       R4 without borders, --border-sample: the same;
    #       R5 a second fonts, --font-sample: exit 2, the widened two-containers
    #          message, no output;
    #     and two usage shapes. What the binary cannot reach is stated.
    #
    # CARRIED TO M2 part 2 P3 from P2's negative script (printed in
    # records/logs/m2p2-p2/negative.log; P1's family F is in
    # records/logs/m2p2-p1/negative.log). What differs, and why:
    #  E. The phase, the log directory, the subjects and the build directories
    #     are P3's; the gate's binary and hash are this phase's
    #     (records/logs/m2p2-p3/gate.log).
    #  F. Family B is replaced by family R, P1's and P2's refusals together, on
    #     fixtures this log builds.
    #  G. Planning's P3 rulings stand in specs/0017 uncommitted; the entry guard
    #     and the status block allow that path and this phase's logs and records,
    #     the size record among them.
    #
    # Usage: m2p2-p3-negative.sh <phase commit> > <scratch file>; the caller moves
    # the output to records/logs/m2p2-p3/negative.log.
    set -uo pipefail
    set -uo pipefail
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # Ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/negative.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    BUILD_ROOT=$HOME/.cache/emend-build/m2p2-p3-negative
    GATE_BIN=$HOME/.cache/emend-build/m2p2-p3-gate/target/debug/emend-copy
    GATE_LOG=records/logs/m2p2-p3/gate.log
    mkdir -p "$BUILD_ROOT" || exit 2
    TREE=$BUILD_ROOT/tree
    if [ -e "$TREE" ]; then echo "$TREE is already there" >&2; exit 2; fi
    B=$(mktemp -d)
    cleanup() {
      git worktree remove --force "$TREE" >/dev/null 2>&1
      rm -rf "$B"
    }
    trap cleanup EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    TAB=$(printf '\t')
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    OURS='^((\?\?| ?[MARCD]) records/logs/m2p2-p3|(\?\?| ?[MARCD]) records/(m2p2-(p3-font|p3-border|open)|size-m2p2)-| M specs/0017-fuller-styles[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's records and planning's spec" >&2
      exit 2
    fi
    
    scrub() {
