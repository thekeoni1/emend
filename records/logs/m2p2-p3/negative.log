### this log's generator, from the phase commit's template files
    """Fictional packages for M2 part 2 P3's negative log: the phase commit's
    template files, zipped in the template's order, with the styles part as the
    template has it (r0, r1), without its fonts (r2), without its fills (r3),
    without its borders (r4), or with a second, empty fonts after the first (r5).
    Usage: gen-p3.py <template dir> <out dir>."""
    import os
    import re
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    src, out = sys.argv[1], sys.argv[2]
    styles = open(os.path.join(src, "xl/styles.xml"), "rb").read()
    
    
    def without(name):
        pattern = re.compile(rb"<" + name + rb"[ >].*?</" + name + rb">", re.S)
        assert len(pattern.findall(styles)) == 1
        return pattern.sub(b"", styles)
    
    
    CASES = {
        "r0": styles,
        "r1": styles,
        "r2": without(b"fonts"),
        "r3": without(b"fills"),
        "r4": without(b"borders"),
        "r5": styles.replace(b"</fonts>", b'</fonts><fonts count="0"/>', 1),
    }
    for case, part in CASES.items():
        with zipfile.ZipFile(os.path.join(out, case + ".xlsx"), "w") as z:
            for name in ORDER:
                data = part if name == "xl/styles.xml" else open(os.path.join(src, name), "rb").read()
                z.writestr(zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0)), data, zipfile.ZIP_DEFLATED)
        print("%s %d fonts:%d fills:%d borders:%d" % (
            case + ".xlsx", os.path.getsize(os.path.join(out, case + ".xlsx")),
            part.count(b"<fonts"), part.count(b"<fills"), part.count(b"<borders")))
