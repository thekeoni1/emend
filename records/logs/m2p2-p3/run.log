## --font-sample: the run log's comparison (python3, zipfile, ElementTree and byte spans)
command: sed 's/^/    /' <scratch>/w/fontcmp.py; sha256 4ba6e166fb4ccabc34ce30761ce003ee5452ef3230879bf63c8c14144e79fcc0, 23741 bytes
    """The run log's own font comparison (specs/0017-fuller-styles.md, "Harness
    runs", --font-sample and P1).
    
    Usage: fontcmp.py <input archive> <output archive> [--plant <flag>]
           fontcmp.py <input archive> --parts
    
    Reads both archives with zipfile and ElementTree, sharing no code with the
    library or the tool, and makes its own pick of the edit --font-sample should
    have made: the workbook the package's officeDocument relationship names, the
    first sheet of kind worksheet in <sheets> order, and in it A, the first cell in
    document order whose t is absent, "n" or "s", which has a <v> with text and no
    <f>, and M, the largest row number among its cells (0 for none). From the
    styles part it takes X (the xf children of cellXfs), F and I (the font and
    fill children of fonts and fills), and A's base, the xf A's s names (none when
    A has no s or there is no A).
    
    For the styles part, by byte spans:
    
      head_same         the bytes before <fonts are the input's
      fonts_fills_gap   the bytes from </fonts> to <fills are the input's
      fills_xfs_gap     the bytes from </fills> to <cellXfs are the input's
      tail_same         the bytes from </cellXfs> to the end are the input's
      fonts_prefix      inside fonts, the input's children's bytes begin the output's
      font_added        exactly one element follows them, byte for byte F1's
                        element as the spec gives it, with the container's prefix
      fonts_count_grew  the output's count is its own font children's number, one
                        more than the input's
      fills_prefix, fill_added, fills_count_grew
                        the same over fills, with L1's element
      xfs_prefix        inside cellXfs, the input's children's bytes begin the
                        output's
      xfs_added         exactly two elements follow them
      first_xf_ok       the first carries fontId F, fillId I, applyFont "1" and
                        applyFill "1", and every other attribute and value is A's
                        base's, read with ElementTree; with no base it is the
                        no-base form with F and I
      first_xf_content  its content, between its start and end tags, is byte for
                        byte its base's (none for an empty base or no base)
      second_xf_ok      the second is byte for byte
                        <xf numFmtId="0" fontId="F" fillId="0" borderId="0" xfId="0" applyFont="1"/>
                        with the container's prefix
      xf_count_grew     the output's count is its own xf children's number, two
                        more than the input's
    
    For the worksheet, as specs/0012 P2's comparison: the bytes outside sheetData
    the input's (ws_prefix_same, ws_suffix_same), every cell as the tuple
    (reference, s, t, formula presence, value text, has <v>) counted unchanged,
    changed, added and removed; changed_as_styled: the changed references are A
    alone when A exists and none when it does not, with A's t, formula presence
    and value the input's and its s X; added_as_edited: the one added reference
    is (M + 1, 1), its s X + 1 and its value 7; nothing_removed.
    
    It prints ONE line of counts and yes/no flags: no reference, no value, no
    text, no name and no part name. Two more words report whether the input's
    own count attributes agreed with their children (not flags: a property of
    the input).
    
    --parts prints the two part names the comparison picks, the sheet and the
    styles part, on two lines, for the log to compare with the runner's changed
    rows; the log never prints them.
    
    --plant <flag> changes the output as read, before the comparison, so that
    the named flag turns from yes to no; the line then says planted=yes, or
    planted=no when this pair gives the plant nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    # F1 and L1 of "Harness runs", as the spec's "The elements" composes them; the
    # names take the container's prefix, put in by `named`.
    F1 = b"<font><b/><sz val=\"12\"/><color rgb=\"FF336699\"/><name val=\"emend\"/></font>"
    L1 = (b"<fill><patternFill patternType=\"solid\"><fgColor rgb=\"FFDDEEFF\"/>"
          b"<bgColor indexed=\"64\"/></patternFill></fill>")
    
    STYLE_FLAGS = ("head_same", "fonts_fills_gap", "fills_xfs_gap", "tail_same",
                   "fonts_prefix", "font_added", "fonts_count_grew",
                   "fills_prefix", "fill_added", "fills_count_grew",
                   "xfs_prefix", "xfs_added", "first_xf_ok", "first_xf_content",
                   "second_xf_ok", "xf_count_grew")
    SHEET_FLAGS = ("ws_prefix_same", "ws_suffix_same", "changed_as_styled",
                   "added_as_edited", "nothing_removed")
    FLAGS = STYLE_FLAGS + SHEET_FLAGS
    # Not a flag: a second plant for second_xf_ok that keeps its attributes and
    # values and only reorders them, which byte equality must catch.
    PLANTS = FLAGS + ("second_xf_order",)
    
    
    def local(tag):
        """(namespace, local name) of an ElementTree tag."""
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def named(element, prefix):
        """element with prefix put before every element name in it."""
        return re.sub(rb"<(/?)([A-Za-z])", lambda m: b"<" + m.group(1) + prefix + m.group(2), element)
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(id, type, resolved target) of each internal relationship of part."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            if el.get("TargetMode") == "External":
                continue
            target = el.get("Target", "")
            resolved = (target[1:] if target.startswith("/")
                        else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def pick(z):
        """The workbook part, its first worksheet part and its styles part."""
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        if len(office) != 1:
            return None, None, None
        workbook = office[0]
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        first = None
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty.endswith("/worksheet") and target in z.namelist():
                    first = target
                    break
        styles = [t for (_, ty, t) in rels_of(z, workbook) if ty.endswith("/styles")]
        styles = styles[0] if styles and styles[0] in z.namelist() else None
        return workbook, first, styles
    
    
    def container(data, name):
        """(start of the start tag, start of the children, end of the children,
        end of the element) of the first element named name, prefix-tolerant, or
        None. An empty element has equal child bounds."""
        start = re.search(rb"<([A-Za-z_][\w.-]*:)?" + name + rb"[\s/>]", data)
        if start is None:
            return None
        close = data.find(b">", start.start())
        if close < 0:
            return None
        if data[close - 1:close] == b"/":
            return start.start(), close + 1, close + 1, close + 1
        ends = list(re.finditer(rb"</([A-Za-z_][\w.-]*:)?" + name + rb"\s*>", data))
        if not ends:
            return None
        return start.start(), close + 1, ends[-1].start(), ends[-1].end()
    
    
    def prefix_of(data, span):
        """The qualified-name prefix, with its colon, of the start tag at span."""
        m = re.match(rb"<([A-Za-z_][\w.-]*:)?", data[span[0]:span[1]])
        return m.group(1) or b""
    
    
    def count_attribute(data, span):
        tag = data[span[0]:span[1]]
        found = re.search(rb"\scount\s*=\s*(\"[^\"]*\"|'[^']*')", tag)
        if found is None:
            return None
        try:
            return int(found.group(1)[1:-1])
        except ValueError:
            return None
    
    
    def top_level(data):
        """One (start, end) span per top-level element of a container's
        children."""
        spans = []
        depth = 0
        at = 0
        i = 0
        while i < len(data):
            if data[i:i + 1] == b"<" and data[i + 1:i + 2] not in (b"/", b"!", b"?"):
                if depth == 0:
                    at = i
                close = data.find(b">", i)
                if close < 0:
                    break
                if data[close - 1:close] == b"/":
                    if depth == 0:
                        spans.append((at, close + 1))
                else:
                    depth += 1
                i = close + 1
                continue
            if data[i:i + 2] == b"</":
                close = data.find(b">", i)
                if close < 0:
                    break
                depth -= 1
                if depth == 0:
                    spans.append((at, close + 1))
                i = close + 1
                continue
            i += 1
        return spans
    
    
    def children(data, span):
        """The byte strings of a container's top-level children."""
        inner = data[span[1]:span[2]]
        return [inner[a:b] for (a, b) in top_level(inner)]
    
    
    def element_of(raw, prefix):
        """raw, one element, parsed with ElementTree with its prefix bound."""
        p = prefix[:-1].decode() if prefix else None
        decl = ('xmlns:%s="%s"' % (p, MAIN[0])) if p else ('xmlns="%s"' % MAIN[0])
        return ET.fromstring(("<r %s>" % decl).encode() + raw + b"</r>")[0]
    
    
    def content_of(raw):
        """The bytes between an element's start tag and its end tag; b"" for an
        empty element."""
        close = raw.find(b">")
        if raw[close - 1:close] == b"/":
            return b""
        return raw[close + 1:raw.rfind(b"<")]
    
    
    def row_of(reference):
        digits = re.search(r"\d+", reference or "")
        return int(digits.group(0)) if digits else 0
    
    
    def a1(row, col):
        name = ""
        while col > 0:
            col, rest = divmod(col - 1, 26)
            name = chr(65 + rest) + name
        return "%s%d" % (name, row)
    
    
    def cells(data):
        """{reference: tuple} and the document order of sheetData's cells."""
        out = {}
        order = []
        root = ET.fromstring(data)
        for sheet_data in root:
            ns, name = local(sheet_data.tag)
            if ns not in MAIN or name != "sheetData":
                continue
            for row in sheet_data:
                if local(row.tag) not in [(m, "row") for m in MAIN]:
                    continue
                for c in row:
                    if local(c.tag) not in [(m, "c") for m in MAIN]:
                        continue
                    f = v = inline = None
                    for child in c:
                        cns, cname = local(child.tag)
                        if cns not in MAIN:
                            continue
                        if cname == "f":
                            f = child
                        elif cname == "v":
                            v = child
                        elif cname == "is":
                            inline = "".join(t.text or "" for t in child.iter()
                                             if local(t.tag)[1] == "t")
                    value = (v.text or "") if v is not None else inline
                    ref = c.get("r")
                    out[ref] = (ref, c.get("s"), c.get("t"), f is not None, value, v is not None)
                    order.append(ref)
        return out, order
    
    
    def sampled(data):
        """A, M and the cells of one sheet."""
        found, order = cells(data)
        a = None
        top = 0
        for ref in order:
            (_, _, t, formula, value, has_v) = found[ref]
            top = max(top, row_of(ref))
            if a is None and t in (None, "n", "s") and has_v and value and not formula:
                a = ref
        return a, top, found
    
    
    def bounds(data):
        """(start of sheetData, start of its end tag or None for <sheetData/>, its end)."""
        start = re.search(rb"<([A-Za-z_][\w.-]*:)?sheetData[\s/>]", data)
        if start is None:
            return None
        close = data.find(b">", start.start())
        if data[close - 1:close] == b"/":
            return start.start(), None, close + 1
        ends = list(re.finditer(rb"</([A-Za-z_][\w.-]*:)?sheetData\s*>", data))
        if not ends:
            return None
        return start.start(), ends[-1].start(), ends[-1].end()
    
    
    COMMENT = b"<!-- planted -->"
    
    
    def insert(data, at, what):
        return data[:at] + what + data[at:]
    
    
    def replace_child(data, span, which, new):
        """data with the which-th top-level child of the container at span
        replaced by new."""
        inner = top_level(data[span[1]:span[2]])
        a, b = inner[which]
        return data[:span[1] + a] + new + data[span[1] + b:]
    
    
    def plant_styles(data, flag, base_raw):
        """The planted difference for a styles flag, and whether it applied."""
        fo, fi, xs = container(data, b"fonts"), container(data, b"fills"), container(data, b"cellXfs")
        if flag == "head_same":
            return insert(data, fo[0], COMMENT), True
        if flag == "fonts_fills_gap":
            return insert(data, fo[3], COMMENT), True
        if flag == "fills_xfs_gap":
            return insert(data, fi[3], COMMENT), True
        if flag == "tail_same":
            return insert(data, xs[3], COMMENT), True
        for name, span, kid in (("fonts", fo, b"<font/>"), ("fills", fi, b"<fill/>")):
            if flag == name + "_prefix":
                return insert(data, span[1], COMMENT), True
            if flag == name[:-1] + "_added":
                return insert(data, span[2], kid), True
            if flag == name + "_count_grew":
                tag = re.sub(rb'count\s*=\s*"\d+"', b'count="0"', data[span[0]:span[1]], count=1)
                return data[:span[0]] + tag + data[span[1]:], True
        if flag == "xfs_prefix":
            return insert(data, xs[1], COMMENT), True
        if flag == "xfs_added":
            return insert(data, xs[2], b"<xf/>"), True
        spans = top_level(data[xs[1]:xs[2]])
        if len(spans) < 2:
            return data, False
        first = data[xs[1] + spans[-2][0]:xs[1] + spans[-2][1]]
        if flag == "first_xf_ok":
            # fontId changed to one the flag cannot expect.
            other = re.sub(rb'fontId="\d+"', b'fontId="999999"', first, count=1)
            return replace_child(data, xs, -2, other), other != first
        if flag == "first_xf_content":
            close = first.find(b">")
            if first[close - 1:close] == b"/":
                other = first[:close - 1] + b"><extLst/></" + first[1:first.find(b" ")] + b">"
            else:
                other = first[:first.rfind(b"<")] + b"<extLst/>" + first[first.rfind(b"<"):]
            return replace_child(data, xs, -2, other), True
        if flag == "second_xf_ok":
            return replace_child(data, xs, -1, b'<xf numFmtId="0"/>'), True
        if flag == "second_xf_order":
            second = data[xs[1] + spans[-1][0]:xs[1] + spans[-1][1]]
            other = re.sub(rb'(numFmtId="\d+") (fontId="\d+")', rb"\2 \1", second, count=1)
            return replace_child(data, xs, -1, other), other != second
        if flag == "xf_count_grew":
            tag = re.sub(rb'count\s*=\s*"\d+"', b'count="0"', data[xs[0]:xs[1]], count=1)
            return data[:xs[0]] + tag + data[xs[1]:], True
        return data, False
    
    
    def cell_spans(data, upto):
        spans = []
        for hit in re.finditer(rb"<([A-Za-z_][\w.-]*:)?c[\s/>]", data[:upto]):
            at = hit.start()
            close = data.find(b">", at)
            if close < 0:
                break
            if data[close - 1:close] == b"/":
                spans.append((at, close + 1))
                continue
            end = re.compile(rb"</([A-Za-z_][\w.-]*:)?c\s*>").search(data, close)
            if end is None:
                break
            spans.append((at, end.end()))
        return spans
    
    
    def reference_of(span_bytes):
        hit = re.search(rb'\sr\s*=\s*"([^"]*)"', span_bytes)
        return hit.group(1).decode("ascii", "replace") if hit else ""
    
    
    def plant_sheet(data, flag, a, added):
        """The planted difference for a worksheet flag, as specs/0012 P2's
        comparison plants it; never on A or the added cell."""
        span = bounds(data)
        if span is None:
            return data, False
        rows = list(re.finditer(rb"<([A-Za-z_][\w.-]*:)?row[\s/>]", data))
        prefix = rows[-1].group(1) if rows and rows[-1].group(1) else b""
        at = span[1] if span[1] is not None else span[2]
        if flag == "ws_prefix_same":
            return insert(data, span[0], COMMENT), True
        if flag == "ws_suffix_same":
            return insert(data, span[2], COMMENT), True
        if flag == "added_as_edited":
            cell = (b"<" + prefix + b'c r="ZZ999998" s="0"><' + prefix + b"v>0</"
                    + prefix + b"v></" + prefix + b"c>")
            close = data.rfind(b"</" + prefix + b"row>", 0, at)
            if close < 0:
                return data, False
            return insert(data, close, cell), True
        if flag in ("changed_as_styled", "nothing_removed"):
            spans = [s for s in cell_spans(data, at)
                     if reference_of(data[s[0]:s[1]]) not in (a, added)]
            if not spans:
                return data, False
            start, end = spans[-1]
            if flag == "nothing_removed":
                return data[:start] + data[end:], True
            cell = data[start:end]
            if re.search(rb'\ss\s*=\s*"[^"]*"', cell):
                other = re.sub(rb'\ss\s*=\s*"[^"]*"', b' s="0"', cell, count=1)
                if other == cell:
                    other = re.sub(rb'\ss\s*=\s*"[^"]*"', b' s="1"', cell, count=1)
            else:
                close = cell.find(b">")
                cut = close - 1 if cell[close - 1:close] == b"/" else close
                other = cell[:cut] + b' s="0"' + cell[cut:]
            return data[:start] + other + data[end:], other != cell
        return data, False
    
    
    def grew(din, dout, sin, sout, by):
        """The output's count is its own children's number, which is the input's
        plus by; and whether the input's own count agreed with its children."""
        n_in, n_out = len(children(din, sin)), len(children(dout, sout))
        c_out = count_attribute(dout, sout)
        return (c_out is not None and c_out == n_out and n_out == n_in + by,
                count_attribute(din, sin) == n_in, n_in, n_out)
    
    
    def main():
        args = sys.argv[1:]
        plant = args[args.index("--plant") + 1] if "--plant" in args else None
        if plant is not None and plant not in PLANTS:
            print("error=unknown-plant")
            return
        zin = zipfile.ZipFile(args[0])
        workbook, part, styles = pick(zin)
        if args[1:2] == ["--parts"]:
            print(part or "")
            print(styles or "")
            return
        zout = zipfile.ZipFile(args[1])
        yn = lambda v: "yes" if v else "no"
        if part is None or styles is None:
            print("found=0")
            return
        sin, sout = zin.read(styles), zout.read(styles)
        din, dout = zin.read(part), zout.read(part)
        a, top, cin = sampled(din)
        added = a1(top + 1, 1)
    
        fo_i, fi_i, xs_i = container(sin, b"fonts"), container(sin, b"fills"), container(sin, b"cellXfs")
        if None in (fo_i, fi_i, xs_i):
            print("error=no-container")
            return
        xfs_in = children(sin, xs_i)
        X, F, I = len(xfs_in), len(children(sin, fo_i)), len(children(sin, fi_i))
        s_a = cin[a][1] if a is not None else None
        base_raw = xfs_in[int(s_a)] if s_a is not None and s_a.isdigit() and int(s_a) < X else None
    
        planted = True
        if plant is not None:
            sout, in_styles = plant_styles(sout, plant, base_raw)
            dout, in_sheet = plant_sheet(dout, plant, a, added)
            planted = in_styles or in_sheet
    
        fo_o, fi_o, xs_o = container(sout, b"fonts"), container(sout, b"fills"), container(sout, b"cellXfs")
        flags = {}
        flags["head_same"] = sin[:fo_i[0]] == sout[:fo_o[0]]
        flags["fonts_fills_gap"] = sin[fo_i[3]:fi_i[0]] == sout[fo_o[3]:fi_o[0]]
        flags["fills_xfs_gap"] = sin[fi_i[3]:xs_i[0]] == sout[fi_o[3]:xs_o[0]]
        flags["tail_same"] = sin[xs_i[3]:] == sout[xs_o[3]:]
        counts_in_matched = []
        for name, si, so, want in (("fonts", fo_i, fo_o, F1), ("fills", fi_i, fi_o, L1)):
            kids_in = sin[si[1]:si[2]]
            kids_out = sout[so[1]:so[2]]
            flags[name + "_prefix"] = kids_out.startswith(kids_in)
            rest = kids_out[len(kids_in):]
            new = [rest[x:y] for (x, y) in top_level(rest)]
            flags[name[:-1] + "_added"] = new == [named(want, prefix_of(sout, so))]
            ok, matched, _, _ = grew(sin, sout, si, so, 1)
            flags[name + "_count_grew"] = ok
            counts_in_matched.append(matched)
        kids_in = sin[xs_i[1]:xs_i[2]]
        kids_out = sout[xs_o[1]:xs_o[2]]
        flags["xfs_prefix"] = kids_out.startswith(kids_in)
        rest = kids_out[len(kids_in):]
        new = [rest[x:y] for (x, y) in top_level(rest)]
        flags["xfs_added"] = len(new) == 2
        xp = prefix_of(sout, xs_o)
        first = new[0] if len(new) == 2 else None
        second = new[1] if len(new) == 2 else None
        if first is not None:
            got = dict(element_of(first, xp).attrib)
            if base_raw is not None:
                want = dict(element_of(base_raw, prefix_of(sin, xs_i)).attrib)
                want.update({"fontId": str(F), "fillId": str(I), "applyFont": "1", "applyFill": "1"})
            else:
                want = {"numFmtId": "0", "fontId": str(F), "fillId": str(I), "borderId": "0",
                        "xfId": "0", "applyFont": "1", "applyFill": "1"}
            flags["first_xf_ok"] = got == want
            flags["first_xf_content"] = content_of(first) == (content_of(base_raw) if base_raw else b"")
        else:
            flags["first_xf_ok"] = flags["first_xf_content"] = False
        second_want = named(b'<xf numFmtId="0" fontId="%d" fillId="0" borderId="0" xfId="0" '
                            b'applyFont="1"/>' % F, xp)
        flags["second_xf_ok"] = second == second_want
        ok, matched, _, xfs_after = grew(sin, sout, xs_i, xs_o, 2)
        flags["xf_count_grew"] = ok
        counts_in_matched.append(matched)
    
        bi, bo = bounds(din), bounds(dout)
        if bi is None or bo is None:
            print("error=no-sheetData")
            return
        flags["ws_prefix_same"] = din[:bi[0]] == dout[:bo[0]]
        if bi[1] is not None and bo[1] is not None:
            flags["ws_suffix_same"] = din[bi[1]:] == dout[bo[1]:]
        else:
            flags["ws_suffix_same"] = din[bi[2]:] == dout[bo[2]:]
        cout, _ = cells(dout)
        unchanged = changed = removed = 0
        changed_refs = set()
        for ref, tup in cin.items():
            if ref not in cout:
                removed += 1
            elif cout[ref] == tup:
                unchanged += 1
            else:
                changed += 1
                changed_refs.add(ref)
        added_refs = set(cout) - set(cin)
        styled = 1 if a is not None else 0
        if a is not None and a in cout:
            a_kept = cout[a][2:] == cin[a][2:] and cout[a][1] == str(X)
        else:
            a_kept = a is None
        flags["changed_as_styled"] = changed == styled and changed_refs == ({a} if a else set()) \
            and a_kept
        flags["added_as_edited"] = added_refs == {added} and cout[added][1] == str(X + 1) \
            and cout[added][4] == "7" and cout[added][2] in (None, "n")
        flags["nothing_removed"] = removed == 0
        fonts_added = len(children(sout, fo_o)) - F
        fills_added = len(children(sout, fi_o)) - I
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted), "styled=%d" % styled,
             "xfs_before=%d" % X, "xfs_after=%d" % xfs_after,
             "fonts_added=%d" % fonts_added, "fills_added=%d" % fills_added,
             "cells_in=%d" % len(cin), "cells_out=%d" % len(cout),
             "unchanged=%d" % unchanged, "changed=%d" % changed,
             "added=%d" % len(added_refs), "removed=%d" % removed]
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS]
            + ["counts_in_matched=%s" % yn(all(counts_in_matched))]))
    
    
    main()
