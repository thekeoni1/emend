    #!/usr/bin/env bash
    # Milestone 2 part 2 P3 run.log (specs/0017-fuller-styles.md, "P3: the
    # catalogue and limits, the probe, the size record", with "Planning rulings
    # during P3 (2026-09-25)" ruling 1 and "Planning verification and rulings on
    # P2" ruling 6):
    #   1. the release binaries records/logs/m2p2-p3/size.log built and hashed,
    #      run where it built them, each checked against its "hash:" line;
    #   2. --font-sample over the corpus on both targets into
    #      runs/<date>-<sha>-font, recorded as m2p2-p3-font-<date>-<sha>.md and
    #      .txt; fontcmp.py over every output with its plants; every output
    #      byte-identical by sha256 to P1's run directory's for the same file;
    #   3. --border-sample likewise into runs/<date>-<sha>-border, recorded as
    #      m2p2-p3-border-<date>-<sha>.md and .txt; bordercmp.py with its plants,
    #      the swap plant among them (F10: the ElementTree half of
    #      first_xf_content turns alone); every output byte-identical to P2's;
    #   4. the keep regenerated on both targets, compared, and against P2's
    #      committed open-check record; the edit open check over the host keep,
    #      recorded as m2p2-open-<date>-<sha>;
    #   5. this script's own standard error counted (P1 verification ruling 7).
    # No cell value, text, reference or part name is printed.
    #
    # CARRIED TO M2 part 2 P3 from P2's run script (printed in
    # records/logs/m2p2-p2/run.log) for its head, its border section and its
    # keep, and from P1's (records/logs/m2p2-p1/run.log) for its font section.
    # What differs, and why:
    #  A. The phase, the log directory, the subjects and the build directories
    #     are P3's; the base is P2's record commit.
    #  B. Two run directories and two record pairs (P3 ruling 1), one log.
    #  C. No release build here: the binaries are size.log's, read back by their
    #     hash lines, as part 1 P5's run log read its size log's.
    #  D. Each section adds the byte identity against the earlier phase's run
    #     directory, named by the corpus record that phase's record commit added.
    #  E. bordercmp.py gains the swap plant and reports its two halves
    #     (P2 verification ruling 6, F10).
    #  F. A superseded run directory is moved, never removed; a rerun takes
    #     RUN_SUFFIX before the -font and -border suffixes.
    #  G. Attempt 2. Attempt 1 failed one check, the script's: "every new pair is
    #     kept by a test this phase adds" required at least one new keep pair,
    #     carried from phases whose new tests wrote pairs, and P3's one new test
    #     writes none. The check now passes on no new pair, the count printed.
    #     SUPERSEDED_RUNS moves attempt 1's two run directories.
    #
    # Usage: m2p2-p3-run.sh <phase commit> <this phase's test.log> > <scratch file>
    set -uo pipefail
    set -uo pipefail
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # Ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    TEST_LOG=${2:?this phase test.log required}
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    LO_TIMEOUT_S=600
    SPEC=specs/0017-fuller-styles.md
    SPEC_SHA=${SPEC_SHA:-none given}
    SIZE_BUILD=$HOME/.cache/emend-build/m2p2-p3-size
    SIZE_LOG=records/logs/m2p2-p3/size.log
    BUILD_ROOT=$HOME/.cache/emend-build/m2p2-p3-run
    KEEP=$HOME/.cache/emend-build/m2p2-p3-keep-host
    I686=i686-unknown-linux-musl
    for d in "$KEEP"; do
      if [ -e "$d" ]; then echo "$d is already there; move it aside first" >&2; exit 2; fi
    done
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    RECORDS=$SELF_DIR/out/records
    B=$(mktemp -d)
    trap 'rm -rf "$B"' EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    OURS='^((\?\?| ?[MARCD]) records/logs/m2p2-p3|(\?\?| ?[MARCD]) records/(m2p2-(p3-font|p3-border|open)|size-m2p2)-2[^ ]*-'"$(git rev-parse --short=7 "$C")"'[.](md|txt)$| M specs/0017-fuller-styles[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's records and planning's spec" >&2
      exit 2
    fi
    SHORT=$(git rev-parse --short=7 "$C")
    DATE=$(date -u +%Y-%m-%d)
    STEM_OPEN=m2p2-open-$DATE-$SHORT
    STEM_F=m2p2-p3-font-$DATE-$SHORT
    STEM_B=m2p2-p3-border-$DATE-$SHORT
    # A rerun takes a suffix, so its run directory is never the superseded one.
    RUN_SUFFIX=${RUN_SUFFIX:-}
    case $RUN_SUFFIX in '' | -[b-z]) ;; *) echo "RUN_SUFFIX is -b to -z or nothing" >&2; exit 2 ;; esac
    RUN_F=$DATE-$SHORT$RUN_SUFFIX-font
    RUN_B=$DATE-$SHORT$RUN_SUFFIX-border
    OUT_F=$CORPUS/runs/$RUN_F
    OUT_B=$CORPUS/runs/$RUN_B
    mkdir -p "$RECORDS" || exit 2
    # A rerun names the superseded run directory, which is MOVED into
