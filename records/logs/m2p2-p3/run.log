    # must be another run of this phase, not this one.
    # The superseded run directories, each MOVED, never removed (attempt 2: two
    # of them, the -font and -border of attempt 1).
    SUPERSEDED_RUNS=${SUPERSEDED_RUNS:-}
    for sr in $SUPERSEDED_RUNS; do
      case $sr in
        20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-font | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-border | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[b-z]-font | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[b-z]-border) ;;
        *) echo "SUPERSEDED_RUNS holds a name that is not a run directory's" >&2; exit 2 ;;
      esac
      if [ "$sr" = "$RUN_F" ] || [ "$sr" = "$RUN_B" ]; then echo "SUPERSEDED_RUNS names this run's own directory" >&2; exit 2; fi
    done
    for f in "$OUT_F" "$OUT_B" "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "records/$STEM_OPEN.md" "records/$STEM_OPEN.txt" \
             "$RECORDS/$STEM_F.md" "$RECORDS/$STEM_F.txt" "records/$STEM_F.md" "records/$STEM_F.txt" \
             "$RECORDS/$STEM_B.md" "$RECORDS/$STEM_B.txt" "records/$STEM_B.md" "records/$STEM_B.txt"; do
      if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
    done
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p3#g" -e "s#$KEEP#<keep>#g" \
        -e "s#$SIZE_BUILD#<sizebuild>#g" -e "s#$BUILD_ROOT#<build>#g" -e "s#$CORPUS#<corpus>#g" -e "s#$B#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
