    #!/usr/bin/env bash
    # Milestone 2 part 2 P3 size.log (specs/0017-fuller-styles.md, "P3: the
    # catalogue and limits, the probe, the size record" and "Size", with decision
    # 1 taken as A and "Planning verification and rulings on P2"): the FOURTEEN
    # size probes built in the size profile for i686-unknown-linux-musl, each
