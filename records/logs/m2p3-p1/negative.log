    OURS='^((\?\?| ?[MARCD]) records/logs/m2p3-p1|(\?\?| ?[MARCD]) records/m2p3-(p1|open)-| M specs/0018-rows-and-columns[.]md$)'
    entry_all=$(run_lines git status --porcelain)
