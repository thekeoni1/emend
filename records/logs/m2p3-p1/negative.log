    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p1 stands for this script's own directory, which holds the script and, in <scratch>/p1/out, its own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <build> stands for <home>/.cache/emend-build/m2p3-p1-negative on the disk; <tree> stands for <build>/tree, the detached worktree of the phase commit, which holds the copied binary in <tree>/bin, removed at exit"
    echo "root: <gatebuild> stands for <home>/.cache/emend-build/m2p3-p1-gate, the gate's build directory, from which the gate's host debug binary is copied; read only"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory (the generator, its fixtures and the cases' outputs), removed at exit"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
