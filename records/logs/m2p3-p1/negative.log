    #          no output (specs/0017 close-out ruling 4, carrying P3
    #          verification ruling 4);
    #       N2 the template, --format-sample, the control: exit 0, its line;
    #       N3 a cols whose two col elements overlap, --format-sample: exit 2, "a
    #          worksheet whose cols are out of order or overlap cannot be
    #          edited", no output;
    #       N4 two mergeCells, --format-sample: exit 2, "a worksheet has two
    #          cols, sheetViews or mergeCells elements, or a sheetViews without a
    #          sheetView", no output;
    #     and two usage shapes. What the binary cannot reach in P1 is stated.
    #
    # CARRIED TO M2 part 3 P1 from part 2 P3's negative script (printed in
    # records/logs/m2p2-p3/negative.log; its change list E to G is there). What
    # differs, and why:
    #  H. The phase, the log directory, the subjects and the build directories
    #     are P1's of part 3; the gate's binary and hash are this phase's
    #     (records/logs/m2p3-p1/gate.log).
    #  I. Family R is replaced by family N: the carried unbound-prefix case and
    #     P1's two fixture refusals, each beside its control.
    #  J. Planning's P1 rulings stand in specs/0018 uncommitted; the entry guard
    #     and the status block allow that path and this phase's logs and records.
    #
    # Usage: m2p3-p1-negative.sh <phase commit> > <scratch file>; the caller moves
    # the output to records/logs/m2p3-p1/negative.log.
    set -uo pipefail
    set -uo pipefail
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
