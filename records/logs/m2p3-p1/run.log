    rc_i=$?
    echo "  exit: host $rc_h, $I686 $rc_i"
    check "both release builds exit 0" "$(yn [ "$((rc_h + rc_i))" = 0 ])"
    PT_host=$CARGO_TARGET_DIR/release/emend-copy
    XD_host=$CARGO_TARGET_DIR/release/xlsx-diff
    PT_i686=$CARGO_TARGET_DIR/$I686/release/emend-copy
    XD_i686=$CARGO_TARGET_DIR/$I686/release/xlsx-diff
    for b in "$PT_host" "$XD_host" "$PT_i686" "$XD_i686"; do echo "  $b: sha256 $(sha_of "$b"), bytes $(stat -c %s "$b")"; done
    echo "  $(rustc --version)"
    
    echo
    echo "## the run log's comparison (python3, zipfile, byte spans and ElementTree)"
    cat >"$B/fmtcmp.py" <<'CMP_PY'
    """The run log's own format comparison (specs/0018-rows-and-columns.md,
    "Harness runs", --format-sample and P1, with P1 ruling 1).
    
    Usage: fmtcmp.py <input archive> <output archive> [--plant <flag>]
           fmtcmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no
    code with the library or the tool, and makes its own pick of the part
    --format-sample edits: W, the first worksheet in <sheets> order, and in it M,
    the largest row number of a cell. From W's input bytes it builds, by the
    design's rules, what W's output must hold, and compares:
    
      rest_same         W with every root child named sheetViews, cols,
                        sheetData or mergeCells cut out is the input's, byte for
                        byte (whitespace, comments and every other child kept)
      root_order        the root children's names, in order, are the input's
                        with each of sheetViews, cols and mergeCells the input
                        lacks inserted before the first main-namespace root
                        child that comes later in ECMA-376 18.3.1.99's sequence
                        (the log's own copy of the 39 names), or at the end
      view_tag_same     the first sheetView's start tag is the input's (opened
                        up when the input's was empty), or the created
                        <sheetViews><sheetView workbookViewId="0"> when the
                        input had no sheetViews
      view_content      the first sheetView's content is the pane and selection
                        for B2 (built here) followed by the input's content with
                        every pane and selection child cut out, byte for byte
      other_views_same  the sheetViews element with its first sheetView cut
                        out is the input's, byte for byte: its tags, every other
                        sheetView and whatever lies between them
      cols_bytes        the cols element is byte for byte what the split rule
                        gives from the input's (built here: a covering col split
                        so column 2 alone carries width="20.5" customWidth="1"
                        and column 3 alone hidden="1", every other piece the
                        input's attributes with min and max set; an uncovered
                        column its own col placed by min), or the created one
      cols_effective    read with ElementTree, for every column from 1 to the
                        largest max either side has, the attributes other than
                        min and max are the input's, except column 2 (width
                        20.5, customWidth 1) and column 3 (hidden 1)
      cols_ordered      the output's col elements are in increasing min order
                        and disjoint
      sheetdata_bytes   sheetData is byte for byte the input's with row 2
                        retagged ht="30" customHeight="1" and row 3 hidden="1"
                        (every other attribute and every child kept), each
                        created empty in row order when absent
      rows_attrs        read with ElementTree, row 2 has ht 30 and customHeight
                        1 and row 3 hidden 1, every other attribute of both the
                        input's, and every other row's attributes the input's
      cells_same        read with ElementTree, every cell of the input is in the
                        output with the same reference, s, t, formula and value,
                        and there is no other cell
      merges_ok         mergeCells holds the input's children byte for byte, then
                        <mergeCell ref="A(M+1):B(M+1)"/>, and count equals its
                        own mergeCell children, one more than the input's; or
                        the created element with that one child
    
    It prints ONE line of counts and yes/no flags and no reference, value, text,
    name or part name. --parts prints the part name it picks, for the log to
    compare with the runner's rows without printing it. --plant <flag> changes
    the output as read so that the named flag turns to no; the line then says
    planted=yes, or planted=no when the pair gives the plant nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    # ECMA-376 Part 1, 18.3.1.99, the worksheet root's children in order: this
    # log's own copy, not the crate's.
    SEQUENCE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    FOUR = ("sheetViews", "cols", "sheetData", "mergeCells")
    
    FLAGS = ("rest_same", "root_order", "view_tag_same", "view_content",
             "other_views_same", "cols_bytes", "cols_effective", "cols_ordered",
             "sheetdata_bytes", "rows_attrs", "cells_same", "merges_ok")
    
    PANE_B2 = (b'<pane xSplit="1" ySplit="1" topLeftCell="B2" activePane="bottomRight" '
               b'state="frozen"/><selection pane="bottomRight"/>')
    COMMENT = b"<!-- planted -->"
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def named(element, prefix):
        """element with prefix put before every element name in it."""
        return re.sub(rb"<(/?)([A-Za-z])", lambda m: b"<" + m.group(1) + prefix + m.group(2), element)
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            if el.get("TargetMode") == "External":
                continue
            target = el.get("Target", "")
            resolved = (target[1:] if target.startswith("/")
                        else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def pick(z):
        """The first worksheet part in <sheets> order."""
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        if len(office) != 1:
            return None
        workbook = office[0]
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty.endswith("/worksheet") and target in z.namelist():
                    return target
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def is_empty(raw):
        tag = start_tag(raw)
        return tag.endswith(b"/>")
    
    
    def inner(raw):
        """(offset of the content, offset of its end) in an element's bytes."""
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return len(tag), len(tag)
        return len(tag), raw.rfind(b"</")
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def attributes(tag):
        """(name, value) of every attribute of a start tag, in order."""
        return [(m.group(1).decode(), m.group(3)[1:-1].decode())
                for m in re.finditer(rb'\s([^\s=/>]+)\s*=\s*(("[^"]*")|(\'[^\']*\'))', tag)]
    
    
    def with_attr(tag, name, value):
        """The unprefixed attribute set: replaced between its quotes, else put
        after the last attribute's closing quote, else after the name."""
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def attr_value(tag, name):
        m = re.search(ATTR_RE % re.escape(name), tag)
        return m.group(1)[1:-1] if m else None
    
    
    def root_span(data):
        """(start of the root's content, end of it) and the root's prefix."""
        m = None
        for m in re.finditer(rb"<([^\s/>?!]+)", data):
            break
        close = data.find(b">", m.start())
        if data[close - 1:close] == b"/":
            return close + 1, close + 1, split_name(m.group(1))[0]
        end = data.rfind(b"</")
        return close + 1, end, split_name(m.group(1))[0]
    
    
    def children(data, a, b, root_prefix):
        """[(start, end, main local name or None)] of the root's children."""
        out = []
        for (x, y) in top_level(data[a:b]):
            p, n = split_name(qname(data[a + x:a + y]))
            out.append((a + x, a + y, n if p == root_prefix else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def cells(data):
        """{reference: (s, t, formula, value)} of every cell in every sheetData,
        and the rows' attribute dicts by number, read with ElementTree."""
        out, rows = {}, {}
        root = ET.fromstring(data)
        for sd in root:
            ns, name = local(sd.tag)
            if ns not in MAIN or name != "sheetData":
                continue
            for row in sd:
                if local(row.tag) not in [(m, "row") for m in MAIN]:
                    continue
                rows[int(row.get("r", "0"))] = dict(row.attrib)
                for c in row:
                    if local(c.tag) not in [(m, "c") for m in MAIN]:
                        continue
                    f = v = None
                    for child in c:
                        cns, cname = local(child.tag)
                        if cns in MAIN and cname == "f":
                            f = (child.get("t"), child.text)
                        elif cns in MAIN and cname in ("v", "is"):
                            v = ET.tostring(child)
                    out[c.get("r")] = (c.get("s"), c.get("t"), f, v)
        return out, rows
    
    
    def max_row(found):
        top = 0
        for ref in found:
            digits = re.search(r"\d+", ref or "")
            top = max(top, int(digits.group(0)) if digits else 0)
        return top
    
    
    def expected_cols(items, prefix):
        """The cols content the split rule gives, and whether any col is left."""
        edits = [(2, "width"), (3, "hidden")]
    
        def edited(tag, column):
            tag = with_attr(with_attr(tag, b"min", str(column).encode()), b"max", str(column).encode())
            if column == 2:
                return with_attr(with_attr(tag, b"width", b"20.5"), b"customWidth", b"1")
            return with_attr(tag, b"hidden", b"1")
    
        def created(column):
            return edited(b"<" + prefix + b"col/>", column)
    
        out, anyc, nxt = b"", False, 0
        for item in items:
            if item[0] == "other":
                out += item[1]
                continue
            _, tag, rest, lo, hi = item
            while nxt < len(edits) and edits[nxt][0] < lo:
                out += created(edits[nxt][0])
                anyc = True
                nxt += 1
            frm = lo
            while nxt < len(edits) and edits[nxt][0] <= hi:
                column = edits[nxt][0]
                if column > frm:
                    out += with_attr(with_attr(tag, b"min", str(frm).encode()), b"max", str(column - 1).encode()) + rest
                    anyc = True
                out += edited(tag, column) + rest
                anyc = True
                frm = column + 1
                nxt += 1
            if frm <= hi:
                out += (tag if frm == lo else with_attr(with_attr(tag, b"min", str(frm).encode()),
                                                        b"max", str(hi).encode())) + rest
                anyc = True
        for (column, _) in edits[nxt:]:
            out += created(column)
            anyc = True
        return out, anyc
    
    
    def col_items(raw):
        """The cols content as items: ("col", start tag, rest, min, max) or
        ("other", bytes)."""
        a, b = inner(raw)
        content = raw[a:b]
        items, at = [], 0
        for (x, y) in top_level(content):
            if x > at:
                items.append(("other", content[at:x]))
            el = content[x:y]
            p, n = split_name(qname(el))
            if n == "col":
                tag = start_tag(el)
                items.append(("col", tag, el[len(tag):], int(attr_value(tag, b"min")),
                              int(attr_value(tag, b"max"))))
            else:
                items.append(("other", el))
            at = y
        if at < len(content):
            items.append(("other", content[at:]))
        return items
    
    
    def effective(raw, prefix):
        """{column: attributes other than min and max} of a cols element."""
        out = {}
        if raw is None:
            return out
        p = prefix[:-1].decode() if prefix else None
        decl = ('xmlns:%s="%s"' % (p, MAIN[0])) if p else ('xmlns="%s"' % MAIN[0])
        el = ET.fromstring(("<r %s>" % decl).encode() + raw + b"</r>")[0]
        for c in el:
            if local(c.tag)[1] != "col":
                continue
            rest = {k: v for k, v in c.attrib.items() if k not in ("min", "max")}
            for column in range(int(c.get("min")), int(c.get("max")) + 1):
                out[column] = rest
        return out
    
    
    def expected_sheetdata(raw, prefix):
        """sheetData as the rule gives it from the input's."""
        tag = start_tag(raw)
        a, b = inner(raw)
        content = raw[a:b]
        spans = top_level(content)
        have = set()
        for (x, y) in spans:
            el = content[x:y]
            if split_name(qname(el))[1] == "row":
                have.add(int(attr_value(start_tag(el), b"r") or b"0"))
    
        def formatted(t, r):
            if r == 2:
                return with_attr(with_attr(t, b"ht", b"30"), b"customHeight", b"1")
            return with_attr(t, b"hidden", b"1")
    
        def created(r):
            return formatted(b"<" + prefix + b'row r="%d"/>' % r, r)
    
        pending = [r for r in (2, 3) if r not in have]
        parts, at = [], 0
        for (x, y) in spans:
            parts.append(content[at:x])
            el = content[x:y]
            if split_name(qname(el))[1] == "row":
                r = int(attr_value(start_tag(el), b"r") or b"0")
                while pending and pending[0] < r:
                    parts.append(created(pending.pop(0)))
                if r in (2, 3):
                    t = start_tag(el)
                    el = formatted(t, r) + el[len(t):]
            parts.append(el)
            at = y
        parts.append(content[at:])
        for r in pending:
            parts.append(created(r))
        out = b"".join(parts)
        if tag.endswith(b"/>"):
            if not out:
                return raw
            return opened(tag) + out + b"</" + qname(raw) + b">"
        return tag + out + raw[b:]
    
    
    def insert(data, at, what):
        return data[:at] + what + data[at:]
    
    
    def find_child(data, name):
        a, b, rp = root_span(data)
        for (x, y, n) in children(data, a, b, rp):
            if n == name:
                return x, y
        return None
    
    
    def plant(dout, flag):
        """The planted difference for a flag, and whether it applied."""
        a, b, rp = root_span(dout)
        if flag == "rest_same":
            return insert(dout, a, COMMENT), True
        if flag == "root_order":
            sv = find_child(dout, "sheetViews")
            if sv is None:
                return dout, False
            el = dout[sv[0]:sv[1]]
            d = dout[:sv[0]] + dout[sv[1]:]
            return insert(d, d.rfind(b"</"), el), True
        sv = find_child(dout, "sheetViews")
        if flag in ("view_tag_same", "view_content", "other_views_same"):
            if sv is None:
                return dout, False
            el = dout[sv[0]:sv[1]]
            ia, ib = inner(el)
            views = [(sv[0] + ia + x, sv[0] + ia + y) for (x, y) in top_level(el[ia:ib])]
            if flag == "other_views_same":
                return insert(dout, sv[0] + ib, COMMENT), True
            x, y = views[0]
            if flag == "view_tag_same":
                t = start_tag(dout[x:y])
                return dout[:x] + with_attr(t, b"zzPlanted", b"1") + dout[x + len(t):], True
            v = dout[x:y]
            w = v.replace(b'state="frozen"', b'state="split"', 1)
            return dout[:x] + w + dout[y:], w != v
        cl = find_child(dout, "cols")
        if flag in ("cols_bytes", "cols_effective", "cols_ordered"):
            if cl is None:
                return dout, False
            el = dout[cl[0]:cl[1]]
            if flag == "cols_bytes":
                w = el.replace(b'width="20.5"', b"width='20.5'", 1)
            elif flag == "cols_effective":
                w = el.replace(b'width="20.5"', b'width="21"', 1)
            else:
                ia, ib = inner(el)
                spans = top_level(el[ia:ib])
                if len(spans) < 2:
                    return dout, False
                (x0, y0), (x1, y1) = spans[0], spans[-1]
                c = el[ia:ib]
                w = el[:ia] + c[x1:y1] + c[y0:x1] + c[x0:y0] + c[y1:] + el[ib:]
            return dout[:cl[0]] + w + dout[cl[1]:], w != el
        sd = find_child(dout, "sheetData")
        if flag in ("sheetdata_bytes", "rows_attrs", "cells_same"):
            if sd is None:
                return dout, False
            el = dout[sd[0]:sd[1]]
            if flag == "sheetdata_bytes":
                if is_empty(el):
                    return dout, False
                return insert(dout, sd[0] + inner(el)[0], COMMENT), True
            if flag == "rows_attrs":
                w = el.replace(b'ht="30" customHeight="1"', b'ht="31" customHeight="1"', 1)
                return dout[:sd[0]] + w + dout[sd[1]:], w != el
            m = re.search(rb"<(\w+:)?v>([^<]*)</", el)
            if m is None:
                return dout, False
            w = el[:m.start(2)] + b"123456789" + el[m.end(2):]
            return dout[:sd[0]] + w + dout[sd[1]:], w != el
        mc = find_child(dout, "mergeCells")
        if flag == "merges_ok":
            if mc is None:
                return dout, False
            el = dout[mc[0]:mc[1]]
            k = el.rfind(b'ref="')
            w = el[:k] + b'ref="ZZ1:ZZ2"' + el[el.find(b'"', k + 5) + 1:]
            return dout[:mc[0]] + w + dout[mc[1]:], w != el
        return dout, False
    
    
    def main():
        args = sys.argv[1:]
        planted_flag = args[args.index("--plant") + 1] if "--plant" in args else None
        if planted_flag is not None and planted_flag not in FLAGS:
            print("error=unknown-plant")
            return
        zin = zipfile.ZipFile(args[0])
        part = pick(zin)
        if args[1:2] == ["--parts"]:
            print(part or "")
            return
        zout = zipfile.ZipFile(args[1])
        yn = lambda v: "yes" if v else "no"
        if part is None:
            print("found=0")
            return
        din, dout = zin.read(part), zout.read(part)
        planted = True
        if planted_flag is not None:
            dout, planted = plant(dout, planted_flag)
    
        ai, bi, rp = root_span(din)
        ao, bo, rpo = root_span(dout)
        kin = children(din, ai, bi, rp)
        kout = children(dout, ao, bo, rpo)
        flags = {}
        flags["rest_same"] = (cut(din, [(x, y) for (x, y, n) in kin if n in FOUR])
                              == cut(dout, [(x, y) for (x, y, n) in kout if n in FOUR]))
    
        names_in = [n if n is not None else "?" for (_, _, n) in kin]
        want = list(names_in)
        for created in ("sheetViews", "cols", "mergeCells"):
            if created in want:
                continue
            p = SEQUENCE.index(created)
            at = next((i for i, n in enumerate(want) if n in SEQUENCE and SEQUENCE.index(n) > p), len(want))
            want.insert(at, created)
        got = [n if n is not None else "?" for (_, _, n) in kout]
        flags["root_order"] = got == want
    
        def first(kids, data, name):
            for (x, y, n) in kids:
                if n == name:
                    return data[x:y]
            return None
    
        # The views.
        sv_in, sv_out = first(kin, din, "sheetViews"), first(kout, dout, "sheetViews")
        views_out = []
        if sv_out is not None:
            oa, ob = inner(sv_out)
            views_out = [sv_out[oa + x:oa + y] for (x, y) in top_level(sv_out[oa:ob])]
        if sv_in is None:
            created = (named(b'<sheetViews><sheetView workbookViewId="0">', rp) + named(PANE_B2, rp)
                       + named(b"</sheetView></sheetViews>", rp))
            flags["view_tag_same"] = sv_out is not None and sv_out.startswith(
                named(b'<sheetViews><sheetView workbookViewId="0">', rp))
            flags["view_content"] = sv_out == created
            flags["other_views_same"] = sv_out == created
        else:
            ia, ib = inner(sv_in)
            views_in = [sv_in[ia + x:ia + y] for (x, y) in top_level(sv_in[ia:ib])]
            v_in, v_out = views_in[0], (views_out[0] if views_out else b"")
            t_in = start_tag(v_in)
            want_tag = opened(t_in) if t_in.endswith(b"/>") else t_in
            flags["view_tag_same"] = start_tag(v_out) == want_tag
            vp = split_name(qname(v_in))[0]
            va, vb = inner(v_in)
            content = v_in[va:vb]
            drop = [(x, y) for (x, y) in top_level(content)
                    if split_name(qname(content[x:y]))[1] in ("pane", "selection")
                    and split_name(qname(content[x:y]))[0] == vp]
            want_content = named(PANE_B2, vp) + cut(content, drop)
            oa, ob = inner(v_out) if v_out else (0, 0)
            flags["view_content"] = v_out[oa:ob] == want_content and v_out[ob:] == b"</" + qname(v_in) + b">"
            first_in = top_level(sv_in[ia:ib])[0]
            oa2, ob2 = inner(sv_out)
            first_out = top_level(sv_out[oa2:ob2])[0] if views_out else (0, 0)
            flags["other_views_same"] = (
                cut(sv_in, [(ia + first_in[0], ia + first_in[1])])
                == cut(sv_out, [(oa2 + first_out[0], oa2 + first_out[1])]))
    
        # The cols.
        cl_in, cl_out = first(kin, din, "cols"), first(kout, dout, "cols")
        if cl_in is None:
            content, _ = expected_cols([], rp)
            want_cols = named(b"<cols>", rp) + content + named(b"</cols>", rp)
            cp = rp
        else:
            cp = split_name(qname(cl_in))[0]
            content, anyc = expected_cols(col_items(cl_in), cp)
            tag = start_tag(cl_in)
            head = opened(tag) if tag.endswith(b"/>") else tag
            want_cols = head + content + b"</" + qname(cl_in) + b">" if anyc else None
        flags["cols_bytes"] = cl_out == want_cols
        eff_in = effective(cl_in, cp)
        eff_out = effective(cl_out, cp) if cl_out is not None else {}
        top = max(list(eff_in) + list(eff_out) + [3])
        ok = True
        for column in range(1, top + 1):
            want_attrs = dict(eff_in.get(column, {}))
            if column == 2:
                want_attrs.update({"width": "20.5", "customWidth": "1"})
            if column == 3:
                want_attrs.update({"hidden": "1"})
            if eff_out.get(column, {}) != want_attrs:
                ok = False
        flags["cols_effective"] = ok
        ordered = cl_out is not None
        if cl_out is not None:
            last = 0
            for item in col_items(cl_out):
                if item[0] == "col":
                    if item[3] <= last or item[4] < item[3]:
                        ordered = False
                    last = item[4]
        flags["cols_ordered"] = ordered
    
        # The rows and cells.
        sd_in, sd_out = first(kin, din, "sheetData"), first(kout, dout, "sheetData")
        if sd_in is None or sd_out is None:
            print("error=no-sheetData")
            return
        flags["sheetdata_bytes"] = sd_out == expected_sheetdata(sd_in, split_name(qname(sd_in))[0])
        cin, rows_in = cells(din)
        cout, rows_out = cells(dout)
        want_rows = {r: dict(a) for r, a in rows_in.items()}
        want_rows.setdefault(2, {"r": "2"}).update({"ht": "30", "customHeight": "1"})
        want_rows.setdefault(3, {"r": "3"}).update({"hidden": "1"})
        flags["rows_attrs"] = rows_out == want_rows
        flags["cells_same"] = cin == cout
    
        # The merges.
        m = max_row(cin)
        ref = b'<mergeCell ref="A%d:B%d"/>' % (m + 1, m + 1)
        mc_in, mc_out = first(kin, din, "mergeCells"), first(kout, dout, "mergeCells")
        merges_in = 0
        if mc_in is None:
            want_mc = named(b'<mergeCells count="1">', rp) + named(ref, rp) + named(b"</mergeCells>", rp)
        else:
            mp = split_name(qname(mc_in))[0]
            ia, ib = inner(mc_in)
            merges_in = sum(1 for (x, y) in top_level(mc_in[ia:ib])
                            if split_name(qname(mc_in[ia + x:ia + y]))[1] == "mergeCell")
            tag = with_attr(start_tag(mc_in), b"count", str(merges_in + 1).encode())
            head = opened(tag) if tag.endswith(b"/>") else tag
            want_mc = head + mc_in[ia:ib] + named(ref, mp) + b"</" + qname(mc_in) + b">"
        flags["merges_ok"] = mc_out == want_mc
        merges_out = 0
        if mc_out is not None:
            oa, ob = inner(mc_out)
            merges_out = sum(1 for (x, y) in top_level(mc_out[oa:ob])
                             if split_name(qname(mc_out[oa + x:oa + y]))[1] == "mergeCell")
            count_ok = attr_value(start_tag(mc_out), b"count") == str(merges_out).encode()
            flags["merges_ok"] = flags["merges_ok"] and count_ok and merges_out == merges_in + 1
    
        def row_count(sd):
            a, b = inner(sd)
            return sum(1 for (x, y) in top_level(sd[a:b]) if split_name(qname(sd[a + x:a + y]))[1] == "row")
    
        rows_n_in, rows_n_out = row_count(sd_in), row_count(sd_out)
        created_rows = sum(1 for r in (2, 3) if r not in rows_in)
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted),
             "cells_in=%d" % len(cin), "cells_out=%d" % len(cout),
             "rows_in=%d" % rows_n_in, "rows_out=%d" % rows_n_out,
             "rows_created=%d" % created_rows,
             "merges_in=%d" % merges_in, "merges_out=%d" % merges_out,
             "views_created=%d" % (1 if sv_in is None else 0),
             "cols_created=%d" % (1 if cl_in is None else 0),
             "merges_created=%d" % (1 if mc_in is None else 0),
             "views_in=%d" % (0 if sv_in is None else len(top_level(sv_in[inner(sv_in)[0]:inner(sv_in)[1]])))]
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS]))
    
    
    main()
    CMP_PY
    echo "command: sed 's/^/    /' <scratch>/w/fmtcmp.py; sha256 $(sha_of "$B/fmtcmp.py"), $(wc -c <"$B/fmtcmp.py") bytes"
    sed 's/^/    /' "$B/fmtcmp.py"
    FLAGS="rest_same root_order view_tag_same view_content other_views_same cols_bytes cols_effective cols_ordered sheetdata_bytes rows_attrs cells_same merges_ok"
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    all_yes() { local f; for f in $FLAGS; do [ "$(kv "$1" "$f")" = yes ] || return 1; done; }
    # tool_and_cmp <tool line> <comparison line>: the counts the two share.
    tool_and_cmp() {
      [ "$(kv "$1" cells_before)" = "$(kv "$2" cells_in)" ] || return 1
      [ "$(kv "$1" cells_after)" = "$(kv "$2" cells_out)" ] || return 1
      [ "$(kv "$1" rows_before)" = "$(kv "$2" rows_in)" ] || return 1
      [ "$(kv "$1" rows_after)" = "$(kv "$2" rows_out)" ] || return 1
      [ "$(kv "$1" merges_before)" = "$(kv "$2" merges_in)" ] || return 1
      [ "$(kv "$1" merges_after)" = "$(kv "$2" merges_out)" ]
    }
    # line_as_spec <tool line> <comparison line>: what "Harness runs" and P1
    # ruling 1 expect of the line: the cells equal, the rows grown by the
    # comparison's count of rows 2 and 3 absent in the input, one merge more.
    line_as_spec() {
      [ "$(kv "$1" cells_after)" = "$(kv "$1" cells_before)" ] || return 1
      [ "$(kv "$1" rows_after)" = "$(($(kv "$1" rows_before) + $(kv "$2" rows_created)))" ] || return 1
      [ "$(kv "$1" merges_after)" = "$(($(kv "$1" merges_before) + 1))" ]
    }
    ay_ctl() { if all_yes "found=1"; then return 1; else return 0; fi; }
    check "control: all_yes refuses a line with no flags" "$(yn ay_ctl)"
    lin_ctl() { if line_as_spec "$(printf 'format\tcells_before=3\tcells_after=3\trows_before=2\trows_after=3\tmerges_before=1\tmerges_after=1')" "rows_created=1"; then return 1; else return 0; fi; }
    check "control: line_as_spec refuses a line whose merges did not grow" "$(yn lin_ctl)"
    lin_ok() { line_as_spec "$(printf 'format\tcells_before=3\tcells_after=3\trows_before=2\trows_after=3\tmerges_before=1\tmerges_after=2')" "rows_created=1"; }
    check "control: line_as_spec accepts the same line with one merge more" "$(yn lin_ok)"
    
    manifest_rows=$(awk -F'\t' 'NR > 1 { n++ } END { print n + 0 }' "$CORPUS/manifest.tsv")
    echo "  corpus manifest rows: $manifest_rows"
    check "the corpus holds its 27 workbooks" "$(yn [ "$manifest_rows" = 27 ])"
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    sum_col() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { n += $k } END { print n + 0 }' "$1"; }
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      echo
      echo "## $label run, --tool-arg $EDIT"
      echo "command: scripts/passthrough-run.sh --label $label --passthrough <build>/target/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <build>/target/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --out <corpus>/runs/$RUN --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$OUT" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
        >"$B/run-$label.stdout" 2>"$B/run-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$label.stderr")"
      sed 's/^/    /' "$B/run-$label.stdout"
      check "$label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$label: its stderr is empty" "$(yn [ ! -s "$B/run-$label.stderr" ])"
      SUM=$OUT/summary.$label.tsv
      ENT=$OUT/entries.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      echo "  summary rows: $rows; outcome ok: $(count_where "$SUM" outcome ok); lo ok: $(count_where "$SUM" lo ok); lo_in ok: $(count_where "$SUM" lo_in ok); leftover no: $(count_where "$SUM" leftover no)"
      echo "  order_preserved yes: $(count_where "$SUM" order_preserved yes); comment_equal yes: $(count_where "$SUM" comment_equal yes); files_identical no: $(count_where "$SUM" files_identical no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      summary_ok() {
        local col
        [ "$rows" = "$manifest_rows" ] || return 1
        for col in "outcome ok" "lo ok" "lo_in ok" "leftover no" "order_preserved yes" "comment_equal yes" "files_identical no"; do
          [ "$(count_where "$SUM" ${col% *} ${col#* })" = "$rows" ] || return 1
        done
        [ "$(sum_col "$SUM" changed)" = "$rows" ] || return 1
        [ "$(sum_col "$SUM" recompressed)$(sum_col "$SUM" dropped)$(sum_col "$SUM" added)" = 000 ]
      }
      check "$label: every workbook ok, lo and lo_in ok, no leftover, order and comment kept, one entry changed in each, none recompressed, dropped or added" "$(yn summary_ok)"
      # entries_p1 <id> <parts file>: the runner's rows for one workbook: one
      # changed row, exactly the sheet the comparison picks,
      # flagged descriptor at most; every other row identical and unflagged.
      # Names are read and never printed.
      entries_p1() {
        awk -F'\t' -v id="$1" -v parts="$2" '
          BEGIN { while ((getline line < parts) > 0) if (line != "") want[line] = 1 }
          NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next }
          $k["id"] != id { next }
          { n++; name = $k["name"]; status = $k["status"]; flags = $k["flags"]
            if (status == "changed") {
              changed++
              if (!(name in want)) bad++
              if (flags != "" && flags != "descriptor") bad++
            } else if (status != "identical" || flags != "") bad++ }
          END { exit (n == 0 || changed != 1 || length(want) != 1 || bad > 0) }' "$ENT"
      }
      echo "  per workbook: id, the tool's line, the comparison's line (counts and yes/no only)"
      : >"$B/lines-$label"
      nwb=0; nflags=0; nagree=0; nline=0; nentries=0; t_rows=0; t_merges=0; t_views=0; t_cols=0; t_mc=0
      while IFS="$TAB" read -r id ext; do
        nwb=$((nwb + 1))
        e=$(cat "$OUT/$id/stdout.$label.txt")
        c=$(python3 "$B/fmtcmp.py" "$CORPUS/corpus/$id.$ext" "$OUT/$id/out.$label.$ext")
        python3 "$B/fmtcmp.py" "$CORPUS/corpus/$id.$ext" --parts >"$B/parts-$id"
        printf '%s\t%s\n' "$id" "$e" >>"$B/lines-$label"
        printf '    %s %s\n' "$id" "$(printf '%s' "$e" | tr '\t' ' ')"
        printf '    %s cmp %s\n' "$id" "$(printf '%s' "$c" | tr '\t' ' ')"
        if all_yes "$c"; then nflags=$((nflags + 1)); else echo "    $id: a flag of the comparison does not hold"; fi
        if tool_and_cmp "$e" "$c"; then nagree=$((nagree + 1)); else echo "    $id: the tool and the comparison disagree"; fi
        if line_as_spec "$e" "$c"; then nline=$((nline + 1)); else echo "    $id: the tool's line is not what the edits imply"; fi
        if entries_p1 "$id" "$B/parts-$id"; then nentries=$((nentries + 1)); else echo "    $id: the entry rows are not the picked sheet changed and the rest identical"; fi
        t_rows=$((t_rows + $(kv "$c" rows_created))); t_merges=$((t_merges + $(kv "$e" merges_after) - $(kv "$e" merges_before)))
        t_views=$((t_views + $(kv "$c" views_created))); t_cols=$((t_cols + $(kv "$c" cols_created))); t_mc=$((t_mc + $(kv "$c" merges_created)))
      done < <(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv")
      echo "  workbooks: $nwb; every flag holds: $nflags; the tool and the comparison agree: $nagree; the line as the spec reads: $nline; entry rows as P1 expects: $nentries"
      echo "  totals: rows created $t_rows; merges added $t_merges; created sheetViews $t_views, cols $t_cols, mergeCells $t_mc"
      check "$label: every flag of the comparison holds in every workbook" "$(yn [ "$nflags" = "$manifest_rows" ])"
      check "$label: the tool and the comparison agree in every workbook" "$(yn [ "$nagree" = "$manifest_rows" ])"
      check "$label: every line is what the edits imply" "$(yn [ "$nline" = "$manifest_rows" ])"
      check "$label: every workbook's entry rows are as P1 expects" "$(yn [ "$nentries" = "$manifest_rows" ])"
      check "$label: one merge added in every workbook ($t_merges)" "$(yn [ "$t_merges" = "$manifest_rows" ])"
      R=$OUT/run.$label.tsv
      args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$R")
      bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
      check "$label: the run row records $EDIT, the two release binaries by sha256 and the phase commit" "$(yn bins_in_row)"
      [ "$args" = "$EDIT" ] || { echo "  $label: tool_args [$args]"; fail=1; }
    done
    entries_ctl() {
      local id
      id=$(awk -F'\t' 'NR == 1 { print $1; exit }' "$B/lines-host")
      local ENT=$OUT/entries.host.tsv
      printf 'no/such/part.xml\n' >"$B/c-parts"
      if entries_p1 "$id" "$B/c-parts"; then return 1; else return 0; fi
    }
    check "control: entries_p1 refuses the first workbook's rows against a part it does not change" "$(yn entries_ctl)"
    
    echo
    echo "### the planted-flag controls, host, each on the first workbook in manifest order where it applies"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv" >"$B/order"
    nbit=0
    nplants=0
    for f in $FLAGS; do
      nplants=$((nplants + 1))
      flag=$f
      where=none; planted=""
      while IFS="$TAB" read -r id ext; do
        planted=$(python3 "$B/fmtcmp.py" "$CORPUS/corpus/$id.$ext" "$OUT/$id/out.host.$ext" --plant "$f")
        if [ "$(kv "$planted" planted)" = yes ]; then where=$id; break; fi
      done <"$B/order"
      turned() { [ "$where" != none ] && [ "$(kv "$planted" "$flag")" = no ] && [ "$(kv "$planted" planted)" = yes ]; }
      echo "  plant $f: applied on $where; $flag=$(kv "$planted" "$flag")"
      if turned; then nbit=$((nbit + 1)); fi
      check "control: the plant $f applies on some workbook and turns $flag to no there" "$(yn turned)"
    done
    echo "  plants: $nplants; plants that turned their own flag: $nbit"
    unknown_plant() { [ "$(python3 "$B/fmtcmp.py" "$CORPUS/corpus/$(head -n 1 "$B/order" | cut -f1).$(head -n 1 "$B/order" | cut -f2)" "$OUT/$(head -n 1 "$B/order" | cut -f1)/out.host.$(head -n 1 "$B/order" | cut -f2)" --plant no_such_flag)" = error=unknown-plant ]; }
    check "control: the comparison refuses a plant it does not know" "$(yn unknown_plant)"
    
    echo
    echo "### the two labels' outputs"
    same_out=0
    while IFS="$TAB" read -r id ext; do
      if cmp -s "$OUT/$id/out.host.$ext" "$OUT/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
    done <"$B/order"
    echo "  workbooks whose host and i686 outputs are byte for byte the same: $same_out"
    check "every output is the same on both targets" "$(yn [ "$same_out" = "$manifest_rows" ])"
    check "both targets printed the same line for every workbook" "$(yn cmp -s "$B/lines-host" "$B/lines-i686")"
    
    echo
    echo "## the corpus record pair"
    echo "command: scripts/passthrough-record.py --run <corpus>/runs/$RUN --out <scratch>/p1/out/records --stem $STEM_RUN"
    scripts/passthrough-record.py --run "$OUT" --out "$RECORDS" --stem "$STEM_RUN" >"$B/record.out" 2>&1
    rrc=$?
    sed 's/^/    /' "$B/record.out"
    check "the record script exits 0" "$(yn [ "$rrc" = 0 ])"
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md = sys.argv[1:5]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        checks.append(("%s: the xml family is worksheet alone" % label, sorted(xf) == ["worksheet"]))
        checks.append(("%s: the changed entries' family is worksheet alone" % label,
                       sorted(f for f in fam if fam[f].get("changed")) == ["worksheet"]))
        checks.append(("%s: no entry is added" % label,
                       sorted(f for f in fam if fam[f].get("added")) == []))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: --format-sample" in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    sed 's/^/    /' "$B/reccheck.py"
