## the run log's comparison (python3, zipfile, byte spans and ElementTree)
command: sed 's/^/    /' <scratch>/w/fmtcmp.py; sha256 fafccabdd09f34f27d6cb9242cd9c2629a002556550fd7f33fb2fe4cf5d096b2, 26966 bytes
    """The run log's own format comparison (specs/0018-rows-and-columns.md,
    "Harness runs", --format-sample and P1, with P1 ruling 1).
    
    Usage: fmtcmp.py <input archive> <output archive> [--plant <flag>]
           fmtcmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no
    code with the library or the tool, and makes its own pick of the part
    --format-sample edits: W, the first worksheet in <sheets> order, and in it M,
    the largest row number of a cell. From W's input bytes it builds, by the
    design's rules, what W's output must hold, and compares:
    
      rest_same         W with every root child named sheetViews, cols,
                        sheetData or mergeCells cut out is the input's, byte for
                        byte (whitespace, comments and every other child kept)
      root_order        the root children's names, in order, are the input's
                        with each of sheetViews, cols and mergeCells the input
                        lacks inserted before the first main-namespace root
                        child that comes later in ECMA-376 18.3.1.99's sequence
                        (the log's own copy of the 39 names), or at the end
      view_tag_same     the first sheetView's start tag is the input's (opened
                        up when the input's was empty), or the created
                        <sheetViews><sheetView workbookViewId="0"> when the
                        input had no sheetViews
      view_content      the first sheetView's content is the pane and selection
                        for B2 (built here) followed by the input's content with
                        every pane and selection child cut out, byte for byte
      other_views_same  the sheetViews element with its first sheetView cut
                        out is the input's, byte for byte: its tags, every other
                        sheetView and whatever lies between them
      cols_bytes        the cols element is byte for byte what the split rule
                        gives from the input's (built here: a covering col split
                        so column 2 alone carries width="20.5" customWidth="1"
                        and column 3 alone hidden="1", every other piece the
                        input's attributes with min and max set; an uncovered
                        column its own col placed by min), or the created one
      cols_effective    read with ElementTree, for every column from 1 to the
                        largest max either side has, the attributes other than
                        min and max are the input's, except column 2 (width
                        20.5, customWidth 1) and column 3 (hidden 1)
      cols_ordered      the output's col elements are in increasing min order
                        and disjoint
      sheetdata_bytes   sheetData is byte for byte the input's with row 2
                        retagged ht="30" customHeight="1" and row 3 hidden="1"
                        (every other attribute and every child kept), each
                        created empty in row order when absent
      rows_attrs        read with ElementTree, row 2 has ht 30 and customHeight
                        1 and row 3 hidden 1, every other attribute of both the
                        input's, and every other row's attributes the input's
      cells_same        read with ElementTree, every cell of the input is in the
                        output with the same reference, s, t, formula and value,
                        and there is no other cell
      merges_ok         mergeCells holds the input's children byte for byte, then
                        <mergeCell ref="A(M+1):B(M+1)"/>, and count equals its
                        own mergeCell children, one more than the input's; or
                        the created element with that one child
    
    It prints ONE line of counts and yes/no flags and no reference, value, text,
    name or part name. --parts prints the part name it picks, for the log to
    compare with the runner's rows without printing it. --plant <flag> changes
    the output as read so that the named flag turns to no; the line then says
    planted=yes, or planted=no when the pair gives the plant nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    # ECMA-376 Part 1, 18.3.1.99, the worksheet root's children in order: this
    # log's own copy, not the crate's.
    SEQUENCE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    FOUR = ("sheetViews", "cols", "sheetData", "mergeCells")
    
    FLAGS = ("rest_same", "root_order", "view_tag_same", "view_content",
             "other_views_same", "cols_bytes", "cols_effective", "cols_ordered",
             "sheetdata_bytes", "rows_attrs", "cells_same", "merges_ok")
    
    PANE_B2 = (b'<pane xSplit="1" ySplit="1" topLeftCell="B2" activePane="bottomRight" '
               b'state="frozen"/><selection pane="bottomRight"/>')
    COMMENT = b"<!-- planted -->"
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def named(element, prefix):
        """element with prefix put before every element name in it."""
        return re.sub(rb"<(/?)([A-Za-z])", lambda m: b"<" + m.group(1) + prefix + m.group(2), element)
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            if el.get("TargetMode") == "External":
                continue
            target = el.get("Target", "")
            resolved = (target[1:] if target.startswith("/")
                        else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def pick(z):
        """The first worksheet part in <sheets> order."""
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        if len(office) != 1:
            return None
        workbook = office[0]
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty.endswith("/worksheet") and target in z.namelist():
                    return target
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def is_empty(raw):
        tag = start_tag(raw)
        return tag.endswith(b"/>")
    
    
    def inner(raw):
        """(offset of the content, offset of its end) in an element's bytes."""
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return len(tag), len(tag)
        return len(tag), raw.rfind(b"</")
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def attributes(tag):
        """(name, value) of every attribute of a start tag, in order."""
        return [(m.group(1).decode(), m.group(3)[1:-1].decode())
                for m in re.finditer(rb'\s([^\s=/>]+)\s*=\s*(("[^"]*")|(\'[^\']*\'))', tag)]
    
    
    def with_attr(tag, name, value):
        """The unprefixed attribute set: replaced between its quotes, else put
        after the last attribute's closing quote, else after the name."""
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def attr_value(tag, name):
        m = re.search(ATTR_RE % re.escape(name), tag)
        return m.group(1)[1:-1] if m else None
    
    
    def root_span(data):
        """(start of the root's content, end of it) and the root's prefix."""
        m = None
        for m in re.finditer(rb"<([^\s/>?!]+)", data):
            break
        close = data.find(b">", m.start())
        if data[close - 1:close] == b"/":
            return close + 1, close + 1, split_name(m.group(1))[0]
        end = data.rfind(b"</")
        return close + 1, end, split_name(m.group(1))[0]
    
    
    def children(data, a, b, root_prefix):
        """[(start, end, main local name or None)] of the root's children."""
        out = []
        for (x, y) in top_level(data[a:b]):
            p, n = split_name(qname(data[a + x:a + y]))
            out.append((a + x, a + y, n if p == root_prefix else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def cells(data):
        """{reference: (s, t, formula, value)} of every cell in every sheetData,
        and the rows' attribute dicts by number, read with ElementTree."""
        out, rows = {}, {}
        root = ET.fromstring(data)
        for sd in root:
            ns, name = local(sd.tag)
            if ns not in MAIN or name != "sheetData":
                continue
            for row in sd:
                if local(row.tag) not in [(m, "row") for m in MAIN]:
                    continue
                rows[int(row.get("r", "0"))] = dict(row.attrib)
                for c in row:
                    if local(c.tag) not in [(m, "c") for m in MAIN]:
                        continue
                    f = v = None
                    for child in c:
                        cns, cname = local(child.tag)
                        if cns in MAIN and cname == "f":
                            f = (child.get("t"), child.text)
                        elif cns in MAIN and cname in ("v", "is"):
                            v = ET.tostring(child)
                    out[c.get("r")] = (c.get("s"), c.get("t"), f, v)
        return out, rows
    
    
    def max_row(found):
        top = 0
        for ref in found:
            digits = re.search(r"\d+", ref or "")
            top = max(top, int(digits.group(0)) if digits else 0)
        return top
    
    
    def expected_cols(items, prefix):
        """The cols content the split rule gives, and whether any col is left."""
        edits = [(2, "width"), (3, "hidden")]
    
        def edited(tag, column):
            tag = with_attr(with_attr(tag, b"min", str(column).encode()), b"max", str(column).encode())
            if column == 2:
                return with_attr(with_attr(tag, b"width", b"20.5"), b"customWidth", b"1")
            return with_attr(tag, b"hidden", b"1")
    
        def created(column):
            return edited(b"<" + prefix + b"col/>", column)
    
        out, anyc, nxt = b"", False, 0
        for item in items:
            if item[0] == "other":
                out += item[1]
                continue
            _, tag, rest, lo, hi = item
            while nxt < len(edits) and edits[nxt][0] < lo:
                out += created(edits[nxt][0])
                anyc = True
                nxt += 1
            frm = lo
            while nxt < len(edits) and edits[nxt][0] <= hi:
                column = edits[nxt][0]
                if column > frm:
                    out += with_attr(with_attr(tag, b"min", str(frm).encode()), b"max", str(column - 1).encode()) + rest
                    anyc = True
                out += edited(tag, column) + rest
                anyc = True
                frm = column + 1
                nxt += 1
            if frm <= hi:
                out += (tag if frm == lo else with_attr(with_attr(tag, b"min", str(frm).encode()),
                                                        b"max", str(hi).encode())) + rest
                anyc = True
        for (column, _) in edits[nxt:]:
            out += created(column)
            anyc = True
        return out, anyc
    
    
    def col_items(raw):
        """The cols content as items: ("col", start tag, rest, min, max) or
        ("other", bytes)."""
        a, b = inner(raw)
        content = raw[a:b]
        items, at = [], 0
        for (x, y) in top_level(content):
            if x > at:
                items.append(("other", content[at:x]))
            el = content[x:y]
            p, n = split_name(qname(el))
            if n == "col":
                tag = start_tag(el)
                items.append(("col", tag, el[len(tag):], int(attr_value(tag, b"min")),
                              int(attr_value(tag, b"max"))))
            else:
                items.append(("other", el))
            at = y
        if at < len(content):
            items.append(("other", content[at:]))
        return items
    
    
    def effective(raw, prefix):
        """{column: attributes other than min and max} of a cols element."""
        out = {}
        if raw is None:
            return out
        p = prefix[:-1].decode() if prefix else None
        decl = ('xmlns:%s="%s"' % (p, MAIN[0])) if p else ('xmlns="%s"' % MAIN[0])
        el = ET.fromstring(("<r %s>" % decl).encode() + raw + b"</r>")[0]
        for c in el:
            if local(c.tag)[1] != "col":
                continue
            rest = {k: v for k, v in c.attrib.items() if k not in ("min", "max")}
            for column in range(int(c.get("min")), int(c.get("max")) + 1):
                out[column] = rest
        return out
    
    
    def expected_sheetdata(raw, prefix):
        """sheetData as the rule gives it from the input's."""
        tag = start_tag(raw)
        a, b = inner(raw)
        content = raw[a:b]
        spans = top_level(content)
        have = set()
        for (x, y) in spans:
            el = content[x:y]
            if split_name(qname(el))[1] == "row":
                have.add(int(attr_value(start_tag(el), b"r") or b"0"))
    
        def formatted(t, r):
            if r == 2:
                return with_attr(with_attr(t, b"ht", b"30"), b"customHeight", b"1")
            return with_attr(t, b"hidden", b"1")
    
        def created(r):
            return formatted(b"<" + prefix + b'row r="%d"/>' % r, r)
    
        pending = [r for r in (2, 3) if r not in have]
        parts, at = [], 0
        for (x, y) in spans:
            parts.append(content[at:x])
            el = content[x:y]
            if split_name(qname(el))[1] == "row":
                r = int(attr_value(start_tag(el), b"r") or b"0")
                while pending and pending[0] < r:
                    parts.append(created(pending.pop(0)))
                if r in (2, 3):
                    t = start_tag(el)
                    el = formatted(t, r) + el[len(t):]
            parts.append(el)
            at = y
        parts.append(content[at:])
        for r in pending:
            parts.append(created(r))
        out = b"".join(parts)
        if tag.endswith(b"/>"):
            if not out:
                return raw
            return opened(tag) + out + b"</" + qname(raw) + b">"
        return tag + out + raw[b:]
    
    
    def insert(data, at, what):
        return data[:at] + what + data[at:]
    
    
    def find_child(data, name):
        a, b, rp = root_span(data)
        for (x, y, n) in children(data, a, b, rp):
            if n == name:
                return x, y
        return None
    
    
    def plant(dout, flag):
        """The planted difference for a flag, and whether it applied."""
        a, b, rp = root_span(dout)
        if flag == "rest_same":
            return insert(dout, a, COMMENT), True
        if flag == "root_order":
            sv = find_child(dout, "sheetViews")
            if sv is None:
                return dout, False
            el = dout[sv[0]:sv[1]]
            d = dout[:sv[0]] + dout[sv[1]:]
            return insert(d, d.rfind(b"</"), el), True
        sv = find_child(dout, "sheetViews")
        if flag in ("view_tag_same", "view_content", "other_views_same"):
            if sv is None:
                return dout, False
            el = dout[sv[0]:sv[1]]
            ia, ib = inner(el)
            views = [(sv[0] + ia + x, sv[0] + ia + y) for (x, y) in top_level(el[ia:ib])]
            if flag == "other_views_same":
                return insert(dout, sv[0] + ib, COMMENT), True
            x, y = views[0]
            if flag == "view_tag_same":
                t = start_tag(dout[x:y])
                return dout[:x] + with_attr(t, b"zzPlanted", b"1") + dout[x + len(t):], True
            v = dout[x:y]
            w = v.replace(b'state="frozen"', b'state="split"', 1)
            return dout[:x] + w + dout[y:], w != v
        cl = find_child(dout, "cols")
        if flag in ("cols_bytes", "cols_effective", "cols_ordered"):
            if cl is None:
                return dout, False
            el = dout[cl[0]:cl[1]]
            if flag == "cols_bytes":
                w = el.replace(b'width="20.5"', b"width='20.5'", 1)
            elif flag == "cols_effective":
                w = el.replace(b'width="20.5"', b'width="21"', 1)
            else:
                ia, ib = inner(el)
                spans = top_level(el[ia:ib])
                if len(spans) < 2:
                    return dout, False
                (x0, y0), (x1, y1) = spans[0], spans[-1]
                c = el[ia:ib]
                w = el[:ia] + c[x1:y1] + c[y0:x1] + c[x0:y0] + c[y1:] + el[ib:]
            return dout[:cl[0]] + w + dout[cl[1]:], w != el
        sd = find_child(dout, "sheetData")
        if flag in ("sheetdata_bytes", "rows_attrs", "cells_same"):
            if sd is None:
                return dout, False
            el = dout[sd[0]:sd[1]]
            if flag == "sheetdata_bytes":
                if is_empty(el):
                    return dout, False
                return insert(dout, sd[0] + inner(el)[0], COMMENT), True
            if flag == "rows_attrs":
                w = el.replace(b'ht="30" customHeight="1"', b'ht="31" customHeight="1"', 1)
                return dout[:sd[0]] + w + dout[sd[1]:], w != el
            m = re.search(rb"<(\w+:)?v>([^<]*)</", el)
            if m is None:
                return dout, False
            w = el[:m.start(2)] + b"123456789" + el[m.end(2):]
            return dout[:sd[0]] + w + dout[sd[1]:], w != el
        mc = find_child(dout, "mergeCells")
        if flag == "merges_ok":
            if mc is None:
                return dout, False
            el = dout[mc[0]:mc[1]]
            k = el.rfind(b'ref="')
            w = el[:k] + b'ref="ZZ1:ZZ2"' + el[el.find(b'"', k + 5) + 1:]
            return dout[:mc[0]] + w + dout[mc[1]:], w != el
        return dout, False
    
    
    def main():
        args = sys.argv[1:]
        planted_flag = args[args.index("--plant") + 1] if "--plant" in args else None
        if planted_flag is not None and planted_flag not in FLAGS:
            print("error=unknown-plant")
            return
        zin = zipfile.ZipFile(args[0])
        part = pick(zin)
        if args[1:2] == ["--parts"]:
            print(part or "")
            return
        zout = zipfile.ZipFile(args[1])
        yn = lambda v: "yes" if v else "no"
        if part is None:
            print("found=0")
            return
        din, dout = zin.read(part), zout.read(part)
        planted = True
        if planted_flag is not None:
            dout, planted = plant(dout, planted_flag)
    
        ai, bi, rp = root_span(din)
        ao, bo, rpo = root_span(dout)
        kin = children(din, ai, bi, rp)
        kout = children(dout, ao, bo, rpo)
        flags = {}
        flags["rest_same"] = (cut(din, [(x, y) for (x, y, n) in kin if n in FOUR])
                              == cut(dout, [(x, y) for (x, y, n) in kout if n in FOUR]))
    
        names_in = [n if n is not None else "?" for (_, _, n) in kin]
        want = list(names_in)
        for created in ("sheetViews", "cols", "mergeCells"):
            if created in want:
                continue
            p = SEQUENCE.index(created)
            at = next((i for i, n in enumerate(want) if n in SEQUENCE and SEQUENCE.index(n) > p), len(want))
            want.insert(at, created)
        got = [n if n is not None else "?" for (_, _, n) in kout]
        flags["root_order"] = got == want
    
        def first(kids, data, name):
            for (x, y, n) in kids:
                if n == name:
                    return data[x:y]
            return None
    
        # The views.
        sv_in, sv_out = first(kin, din, "sheetViews"), first(kout, dout, "sheetViews")
        views_out = []
        if sv_out is not None:
            oa, ob = inner(sv_out)
            views_out = [sv_out[oa + x:oa + y] for (x, y) in top_level(sv_out[oa:ob])]
        if sv_in is None:
            created = (named(b'<sheetViews><sheetView workbookViewId="0">', rp) + named(PANE_B2, rp)
                       + named(b"</sheetView></sheetViews>", rp))
            flags["view_tag_same"] = sv_out is not None and sv_out.startswith(
                named(b'<sheetViews><sheetView workbookViewId="0">', rp))
            flags["view_content"] = sv_out == created
            flags["other_views_same"] = sv_out == created
        else:
            ia, ib = inner(sv_in)
            views_in = [sv_in[ia + x:ia + y] for (x, y) in top_level(sv_in[ia:ib])]
            v_in, v_out = views_in[0], (views_out[0] if views_out else b"")
            t_in = start_tag(v_in)
            want_tag = opened(t_in) if t_in.endswith(b"/>") else t_in
            flags["view_tag_same"] = start_tag(v_out) == want_tag
            vp = split_name(qname(v_in))[0]
            va, vb = inner(v_in)
            content = v_in[va:vb]
            drop = [(x, y) for (x, y) in top_level(content)
                    if split_name(qname(content[x:y]))[1] in ("pane", "selection")
                    and split_name(qname(content[x:y]))[0] == vp]
            want_content = named(PANE_B2, vp) + cut(content, drop)
            oa, ob = inner(v_out) if v_out else (0, 0)
            flags["view_content"] = v_out[oa:ob] == want_content and v_out[ob:] == b"</" + qname(v_in) + b">"
            first_in = top_level(sv_in[ia:ib])[0]
            oa2, ob2 = inner(sv_out)
            first_out = top_level(sv_out[oa2:ob2])[0] if views_out else (0, 0)
            flags["other_views_same"] = (
                cut(sv_in, [(ia + first_in[0], ia + first_in[1])])
                == cut(sv_out, [(oa2 + first_out[0], oa2 + first_out[1])]))
    
        # The cols.
        cl_in, cl_out = first(kin, din, "cols"), first(kout, dout, "cols")
        if cl_in is None:
            content, _ = expected_cols([], rp)
            want_cols = named(b"<cols>", rp) + content + named(b"</cols>", rp)
            cp = rp
        else:
            cp = split_name(qname(cl_in))[0]
            content, anyc = expected_cols(col_items(cl_in), cp)
            tag = start_tag(cl_in)
            head = opened(tag) if tag.endswith(b"/>") else tag
            want_cols = head + content + b"</" + qname(cl_in) + b">" if anyc else None
        flags["cols_bytes"] = cl_out == want_cols
        eff_in = effective(cl_in, cp)
        eff_out = effective(cl_out, cp) if cl_out is not None else {}
        top = max(list(eff_in) + list(eff_out) + [3])
        ok = True
        for column in range(1, top + 1):
            want_attrs = dict(eff_in.get(column, {}))
            if column == 2:
                want_attrs.update({"width": "20.5", "customWidth": "1"})
            if column == 3:
                want_attrs.update({"hidden": "1"})
            if eff_out.get(column, {}) != want_attrs:
                ok = False
        flags["cols_effective"] = ok
        ordered = cl_out is not None
        if cl_out is not None:
            last = 0
            for item in col_items(cl_out):
                if item[0] == "col":
                    if item[3] <= last or item[4] < item[3]:
                        ordered = False
                    last = item[4]
        flags["cols_ordered"] = ordered
    
        # The rows and cells.
        sd_in, sd_out = first(kin, din, "sheetData"), first(kout, dout, "sheetData")
        if sd_in is None or sd_out is None:
            print("error=no-sheetData")
            return
        flags["sheetdata_bytes"] = sd_out == expected_sheetdata(sd_in, split_name(qname(sd_in))[0])
        cin, rows_in = cells(din)
        cout, rows_out = cells(dout)
        want_rows = {r: dict(a) for r, a in rows_in.items()}
        want_rows.setdefault(2, {"r": "2"}).update({"ht": "30", "customHeight": "1"})
        want_rows.setdefault(3, {"r": "3"}).update({"hidden": "1"})
        flags["rows_attrs"] = rows_out == want_rows
        flags["cells_same"] = cin == cout
    
        # The merges.
        m = max_row(cin)
        ref = b'<mergeCell ref="A%d:B%d"/>' % (m + 1, m + 1)
        mc_in, mc_out = first(kin, din, "mergeCells"), first(kout, dout, "mergeCells")
        merges_in = 0
        if mc_in is None:
            want_mc = named(b'<mergeCells count="1">', rp) + named(ref, rp) + named(b"</mergeCells>", rp)
        else:
            mp = split_name(qname(mc_in))[0]
            ia, ib = inner(mc_in)
            merges_in = sum(1 for (x, y) in top_level(mc_in[ia:ib])
                            if split_name(qname(mc_in[ia + x:ia + y]))[1] == "mergeCell")
            tag = with_attr(start_tag(mc_in), b"count", str(merges_in + 1).encode())
            head = opened(tag) if tag.endswith(b"/>") else tag
            want_mc = head + mc_in[ia:ib] + named(ref, mp) + b"</" + qname(mc_in) + b">"
        flags["merges_ok"] = mc_out == want_mc
        merges_out = 0
        if mc_out is not None:
            oa, ob = inner(mc_out)
            merges_out = sum(1 for (x, y) in top_level(mc_out[oa:ob])
                             if split_name(qname(mc_out[oa + x:oa + y]))[1] == "mergeCell")
            count_ok = attr_value(start_tag(mc_out), b"count") == str(merges_out).encode()
            flags["merges_ok"] = flags["merges_ok"] and count_ok and merges_out == merges_in + 1
    
        def row_count(sd):
            a, b = inner(sd)
            return sum(1 for (x, y) in top_level(sd[a:b]) if split_name(qname(sd[a + x:a + y]))[1] == "row")
    
        rows_n_in, rows_n_out = row_count(sd_in), row_count(sd_out)
        created_rows = sum(1 for r in (2, 3) if r not in rows_in)
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted),
             "cells_in=%d" % len(cin), "cells_out=%d" % len(cout),
             "rows_in=%d" % rows_n_in, "rows_out=%d" % rows_n_out,
             "rows_created=%d" % created_rows,
             "merges_in=%d" % merges_in, "merges_out=%d" % merges_out,
             "views_created=%d" % (1 if sv_in is None else 0),
             "cols_created=%d" % (1 if cl_in is None else 0),
             "merges_created=%d" % (1 if mc_in is None else 0),
             "views_in=%d" % (0 if sv_in is None else len(top_level(sv_in[inner(sv_in)[0]:inner(sv_in)[1]])))]
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS]))
    
    
    main()
