    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p2 stands for this script's own directory, which holds the script and, in <scratch>/p2/out, its own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <build> stands for <home>/.cache/emend-build/m2p3-p2-negative on the disk; <tree> stands for <build>/tree, the detached worktree of the phase commit, which holds the copied binary in <tree>/bin, removed at exit"
