        fi
      done
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; each build used its own target directory under <build>"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to (inside <home>, so scrubbed first); scripts/counting.sh is sourced from it, and part 2's size record and size log are read from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p2 stands for this script's own directory, which holds the script and, in <scratch>/p2/out, its own standard error"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory, removed at exit"
    echo "root: <build> stands for <home>/.cache/emend-build/m2p3-p2-size on the disk: <build>/tree-<short sha> a detached worktree of each commit, removed at exit, and <build>/target-<short sha> its target directory, kept"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$T" "$SELF_DIR" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$T" "$BUILD_ROOT" && apart "$MAIN" "$BUILD_ROOT" && apart "$MAIN" "$T" && apart "$MAIN" "$SELF_DIR"; }
    check "the roots other than <home> are distinct, none inside another" "$(yn roots_distinct)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## toolchain"
    rustc --version
    cargo --version
    echo "command: size --version"
    size --version | head -1 | sed 's/^/    /'
    
    echo
    echo "## the two probes at three commits (changes A and B)"
    declare -A SECT FILE TEXT SHA
    build_at() {
      # build_at <commit>: both probes in the size profile, in a worktree of it.
      local c=$1 short tree target b feat rc
      short=$(git rev-parse --short=7 "$c")
      tree=$BUILD_ROOT/tree-$short
      target=$BUILD_ROOT/target-$short
      echo "command: git worktree add --detach <build>/tree-$short $short"
      git worktree add --detach "$tree" "$c" >/dev/null 2>&1
      echo "  worktree at: $(git -C "$tree" rev-parse HEAD)"
      for b in probe-zip-xml probe-emend-fullstyles-write-xml; do
        case $b in probe-zip-xml) feat=xml ;; *) feat=emend,xml ;; esac
        echo "command: (cd <build>/tree-$short && CARGO_TARGET_DIR=<build>/target-$short cargo build -p size-probe --bin $b --features $feat --profile size --target $I686 --offline)"
        (cd "$tree" && CARGO_TARGET_DIR=$target cargo build -p size-probe --bin "$b" --features "$feat" --profile size --target "$I686" --offline) >"$T/b-$short-$b" 2>&1 </dev/null
        rc=$?
        echo "  exit: $rc; build output lines $(count_lines "$T/b-$short-$b"), of them warnings or errors $(count_matches -E '^(warning|error)' "$T/b-$short-$b")"
        built_clean() { [ "$rc" = 0 ] && [ "$(count_matches -E '^(warning|error)' "$T/b-$short-$b")" = 0 ]; }
        check "$b at $short: built, no warning or error line" "$(yn built_clean)"
        local f=$target/$I686/size/$b
        FILE[$short.$b]=$(stat -c %s "$f")
        SECT[$short.$b]=$(section "$f" Total)
        TEXT[$short.$b]=$(section "$f" .text)
        SHA[$short.$b]=$(sha256sum <"$f" | cut -d' ' -f1)
        echo "<build>/target-$short/$I686/size/$b: file ${FILE[$short.$b]} bytes; sections ${SECT[$short.$b]}; .text ${TEXT[$short.$b]}; sha256 ${SHA[$short.$b]}"
      done
      git worktree remove --force "$tree" >/dev/null 2>&1
    }
    for c in "$P2REC" "$P1C" "$C"; do build_at "$c"; done
    S0=$(git rev-parse --short=7 "$P2REC"); S1=$(git rev-parse --short=7 "$P1C"); S2=$(git rev-parse --short=7 "$C")
    
    echo
    echo "## the 1fc8327 build against part 2 P3's size.log and record (change C)"
    echo "command: sed for each probe's hash line in $PREV_LOG (sha256 $(sha256sum <"$PREV_LOG" | cut -d' ' -f1))"
    for b in probe-zip-xml probe-emend-fullstyles-write-xml; do
      line=$(LC_ALL=C "$G" -E "/size/$b: file [0-9]+ bytes; sections [0-9]+; " "$PREV_LOG" | head -1)
      prev_sha=$(printf '%s' "$line" | sed -n 's/.*sha256 \([0-9a-f]\{64\}\)$/\1/p')
      prev_sect=$(printf '%s' "$line" | sed -n 's/.*; sections \([0-9]*\);.*/\1/p')
      echo "  $b: part 2 P3's log sha256 $prev_sha, sections $prev_sect; this build ${SHA[$S0.$b]}, ${SECT[$S0.$b]}"
      reproduced() { [ -n "$prev_sha" ] && [ "$prev_sha" = "${SHA[$S0.$b]}" ] && [ "$prev_sect" = "${SECT[$S0.$b]}" ]; }
      check "$b at 1fc8327 reproduces part 2 P3's log, byte for byte" "$(yn reproduced)"
    done
    REC_BUDGET=$(sed -n 's/^| the budget, `probe-emend-fullstyles-write-xml` over `probe-zip-xml` | \([0-9]*\) |.*/\1/p' "$PREV_REC")
    echo "  part 2's record ($PREV_REC, sha256 $(sha256sum <"$PREV_REC" | cut -d' ' -f1)): the budget figure $REC_BUDGET"
    budget0=$((SECT[$S0.probe-emend-fullstyles-write-xml] - SECT[$S0.probe-zip-xml]))
    check "the 1fc8327 build's budget figure, $budget0, is the record's" "$(yn [ "$budget0" = "$REC_BUDGET" ])"
    wrong_ctl() { if [ "$budget0" = "$((REC_BUDGET + 1))" ]; then return 1; else return 0; fi; }
    check "control: the same comparison refuses the record's figure plus one" "$(yn wrong_ctl)"
    
    echo
    echo "## the figures specs/0018 \"The size question\" A and ruling 12 ask for"
    budget1=$((SECT[$S1.probe-emend-fullstyles-write-xml] - SECT[$S1.probe-zip-xml]))
    budget2=$((SECT[$S2.probe-emend-fullstyles-write-xml] - SECT[$S2.probe-zip-xml]))
    growth=$((budget2 - budget0))
    growth_p1=$((budget1 - budget0))
    growth_p2=$((budget2 - budget1))
    echo "  the budget figure, probe-emend-fullstyles-write-xml over probe-zip-xml, in section bytes:"
    echo "    at 1fc8327 (part 2): ${SECT[$S0.probe-emend-fullstyles-write-xml]} - ${SECT[$S0.probe-zip-xml]} = $budget0"
    echo "    at b8595ce (P1):     ${SECT[$S1.probe-emend-fullstyles-write-xml]} - ${SECT[$S1.probe-zip-xml]} = $budget1"
    echo "    at $S2 (P2):     ${SECT[$S2.probe-emend-fullstyles-write-xml]} - ${SECT[$S2.probe-zip-xml]} = $budget2"
    echo "  probe-zip-xml's drift: 1fc8327 to b8595ce $((SECT[$S1.probe-zip-xml] - SECT[$S0.probe-zip-xml])); b8595ce to $S2 $((SECT[$S2.probe-zip-xml] - SECT[$S1.probe-zip-xml]))"
    echo "  the whole growth since 1fc8327: $growth (P1's growth over 1fc8327: $growth_p1; P2's growth over b8595ce: $growth_p2)"
    sum_ok() { [ "$growth" = "$((growth_p1 + growth_p2))" ]; }
    check "the two phases' growths sum to the whole" "$(yn sum_ok)"
    if [ "$growth" -gt "$CHECKPOINT" ]; then
      echo "  THE CHECKPOINT: the whole growth $growth is ABOVE the $CHECKPOINT checkpoint of decision 1 A by $((growth - CHECKPOINT)); the maintainer re-rules before P3's code (ruling 12, decision 7)"
    else
      echo "  THE CHECKPOINT: the whole growth $growth is at or below the $CHECKPOINT checkpoint of decision 1 A by $((CHECKPOINT - growth))"
    fi
    if [ "$budget2" -le "$CEILING" ]; then
      echo "  THE CEILING: the budget figure $budget2 is $((CEILING - budget2)) under the Milestone 2 ceiling of $CEILING (judged at P4's record, not here)"
    else
      echo "  THE CEILING: the budget figure $budget2 is $((budget2 - CEILING)) over the Milestone 2 ceiling of $CEILING (judged at P4's record, not here)"
    fi
    echo "  file sizes, for the record: probe-emend-fullstyles-write-xml ${FILE[$S0.probe-emend-fullstyles-write-xml]}, ${FILE[$S1.probe-emend-fullstyles-write-xml]}, ${FILE[$S2.probe-emend-fullstyles-write-xml]}; probe-zip-xml ${FILE[$S0.probe-zip-xml]}, ${FILE[$S1.probe-zip-xml]}, ${FILE[$S2.probe-zip-xml]}"
    figures_read() {
      local k
      for k in "${!SECT[@]}"; do [ "${SECT[$k]}" != error ] || return 1; done
      [ "${#SECT[@]}" = 6 ]
    }
    check "all six section totals were read" "$(yn figures_read)"
    
    echo
