    #!/usr/bin/env bash
    # Milestone 2 part 3 P2 size.log (specs/0018-rows-and-columns.md, "The size
    # question" A, "Size" and "P2", with "Planning rulings during P2
    # (2026-09-26)" 12): the interim measurement. probe-emend-fullstyles-write-xml
    # and probe-zip-xml built in the size profile for i686-unknown-linux-musl at
    # three commits, each in its own detached worktree and target directory:
    # 1fc8327 (part 2's record commit of the budget, its hashes and figures
    # checked against part 2 P3's size.log and record), b8595ce (P1's phase
    # commit, ruling 12) and the phase commit. Printed: each probe's file size,
    # section total, .text and sha256; the budget figure (the first over the
    # second) at each commit; the whole growth since 1fc8327 against the 40000
    # checkpoint of decision 1 A, P1's growth over 1fc8327 and P2's over b8595ce
    # beside it; the headroom to the Milestone 2 ceiling of 458752. No record
    # file (P2). The checkpoint is a figure for the maintainer, not a check of
    # this log: its trip is ruling 12's decision 7.
    #
    # WRITTEN FOR M2 part 3 P2 from part 2 P3's size script (printed in
    # records/logs/m2p2-p3/size.log): its head (the phase commit given and
    # compared with HEAD, the scrub, the root lines, the shape greps over its
    # own source, the counting library, the stderr count) is carried; its
    # fourteen-probe body is replaced by the two probes ruling 12 names, at the
    # three commits. What differs, and why:
    #  A. Two probes, not fourteen: "P2" asks for these two alone.
    #  B. Each commit is built in a detached worktree of it, with its own
    #     target directory, so the three builds share nothing but the
    #     toolchain; the worktrees are removed at exit.
    #  C. The 1fc8327 build reproduces part 2 P3's size.log hash lines for both
    #     probes, the control that the profile and toolchain are the same.
    #
    # Usage: m2p3-p2-size.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m2p3-p2/size.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error,
    # kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/size.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    BUILD_ROOT=$HOME/.cache/emend-build/m2p3-p2-size
    I686=i686-unknown-linux-musl
    PREV_REC=records/size-m2p2-2026-09-26-1fc8327.md
    PREV_LOG=records/logs/m2p2-p3/size.log
    CEILING=458752
    CHECKPOINT=40000
    T=$(mktemp -d)
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    section() {
      local out
      out=$(size -A "$1" 2>/dev/null) || { printf 'error'; return; }
      printf '%s\n' "$out" | awk -v s="$2" '$1 == s { print $2; found = 1 } END { if (!found) print "error" }'
    }
    HEAD_SHA=$(git rev-parse HEAD)
    NULL_SHA=0000000000000000000000000000000000000000
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    not_head() { if is_head "$1"; then return 1; else return 0; fi; }
    if is_head "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    if [ -e "$BUILD_ROOT" ]; then echo "$BUILD_ROOT is already there; move it aside first" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    OURS='^((\?\?| ?[MARCD]) records/logs/m2p3-p2|(\?\?| ?[MARCD]) records/m2p3-(p2-insert|p2-delete|open)-| M specs/0018-rows-and-columns[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else echo "the working tree holds changes outside this phase's records and planning's spec" >&2; exit 2; fi
    cleanup() {
      local w
      for w in "$BUILD_ROOT"/tree-*; do
        [ -d "$w" ] && git worktree remove --force "$w" >/dev/null 2>&1
      done
      rm -rf "$T"
    }
    trap cleanup EXIT INT TERM HUP
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p2#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$T#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scratch>/p2/$(basename "$0") $*"
    echo "about: M2 part 3 P2 phase commit $C; HEAD at run: $HEAD_SHA"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$T/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$T/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    echo
    echo "## the commits, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    CODE3=$(by_subject 'M2 part 3 P2: emend-copy --insert-rows-sample and --delete-rows-sample')
    P1C=$(by_subject 'M2 part 3 P1: emend-copy --format-sample')
    P2REC=$(by_subject 'M2 part 2 P3: probe-emend-fullstyles-write-xml')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  code commit 3, the phase commit: ${CODE3:-none}"
    echo "  P1's phase commit (ruling 12): ${P1C:-none}"
    echo "  part 2 P3's phase commit, whose figures part 2's record carries: ${P2REC:-none}"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn is_head "$C")"
    check "the phase commit is code commit 3, by its subject" "$(yn [ "$CODE3" = "$C" ])"
    check "control: the same comparison refuses the null commit" "$(yn not_head "$NULL_SHA")"
    p1_is() { [ "$(git rev-parse --short=7 "$P1C")" = b8595ce ]; }
    p2_is() { [ "$(git rev-parse --short=7 "$P2REC")" = 1fc8327 ]; }
    check "P1's phase commit is b8595ce, as ruling 12 names it" "$(yn p1_is)"
    check "part 2's commit is 1fc8327, as the record's name gives it" "$(yn p2_is)"
    echo "phase: Milestone 2 part 3 P2 (specs/0018-rows-and-columns.md) size.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
