command: scripts/passthrough-record.py --run <corpus>/runs/2026-09-26-f52684c-insert --out <scratch>/p3/out/records --stem m2p3-p3-insert-2026-09-26-f52684c
    wrote m2p3-p3-insert-2026-09-26-f52684c.txt and m2p3-p3-insert-2026-09-26-f52684c.md: labels host,i686; files 27,27; entry rows 870,870; xml rows 98,98
  the record script exits 0: yes
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, tool_arg, moved, chained = sys.argv[1:8]
    # Ruling 11's families: the worksheet always; the workbook part when some
    # workbook moved a formula; its rels part and [Content_Types].xml changed
    # and the chain dropped when one of those also had a chain.
    want_changed = sorted(["worksheet"] + (["workbook"] if int(moved) else [])
                          + (["content-types", "rels"] if int(chained) else []))
    want_dropped = ["calcChain"] if int(chained) else []
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
