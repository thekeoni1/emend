    echo "root: <scratch>/w stands for this run's mktemp -d working directory (the comparison script and its outputs, derived tables, the i686 keep's listing), removed at exit"
    echo "root: <build> stands for <home>/.cache/emend-build/m2p3-p3-run on the disk: <build>/target the builds (release binaries and tests), <build>/keep-i686.<pid> the i686 keep, removed after the comparison"
    echo "root: <keep> stands for <home>/.cache/emend-build/m2p3-p3-keep-host on the disk, this phase's host keep; kept after the run for planning"
    echo "root: <corpus> stands for the private corpus directory (the manifest and the inputs under <corpus>/corpus, read; this log's run directories <corpus>/runs/$RUN_INSERT and <corpus>/runs/$RUN_DELETE, written)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$B" "$SELF_DIR" "$BUILD_ROOT" "$MAIN" "$KEEP" "$CORPUS")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots other than <home> are distinct, none inside another" "$(yn roots_distinct)"
    roots_ctl() { if apart "$CARGO_TARGET_DIR" "$BUILD_ROOT"; then return 1; else return 0; fi; }
    check "control: apart refuses <build>/target against <build>, which holds it" "$(yn roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    echo "the run directories: <corpus>/runs/$RUN_INSERT and <corpus>/runs/$RUN_DELETE; the record stems: $STEM_INSERT, $STEM_DELETE and $STEM_OPEN"
    echo "at entry: status lines $entry_all; of them this phase's records or planning's spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts, against the phase commit, and planning's uncommitted spec"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh scripts/edit-open-check.sh; do
      check "$s in the main tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { if [ "$(git show "$C:scripts/excel-check-list.py" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/edit-open-check.sh)" ]; then return 1; else return 0; fi; }
    check "control: the same hash comparison tells two different scripts apart" "$(yn tree_ctl)"
    spec_now=$(sha_of "$SPEC")
    echo "  planning's spec: $SPEC, sha256 $spec_now in the tree; the hash planning gave for an uncommitted copy: $SPEC_SHA"
    spec_ok() { tree_is_commit "$SPEC" || [ "$spec_now" = "$SPEC_SHA" ]; }
    check "planning's spec is the committed one, or the uncommitted copy planning named" "$(yn spec_ok)"
    echo "command: podman image exists $IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    
    
    echo
    echo "## the release binaries, built here at the phase commit, both targets"
    echo "command: cargo build --release -p emend-copy -p xlsx-diff; the same with --target $I686"
    cargo build --release -p emend-copy -p xlsx-diff >"$B/build-host.out" 2>&1 </dev/null
    rc_h=$?
    cargo build --release -p emend-copy -p xlsx-diff --target "$I686" >"$B/build-i686.out" 2>&1 </dev/null
    rc_i=$?
    echo "  exit: host $rc_h, $I686 $rc_i"
    check "both release builds exit 0" "$(yn [ "$((rc_h + rc_i))" = 0 ])"
    PT_host=$CARGO_TARGET_DIR/release/emend-copy
    XD_host=$CARGO_TARGET_DIR/release/xlsx-diff
    PT_i686=$CARGO_TARGET_DIR/$I686/release/emend-copy
    XD_i686=$CARGO_TARGET_DIR/$I686/release/xlsx-diff
    for b in "$PT_host" "$XD_host" "$PT_i686" "$XD_i686"; do echo "  $b: sha256 $(sha_of "$b"), bytes $(stat -c %s "$b")"; done
    echo "  $(rustc --version)"
    
    echo
    echo "## the run log's comparison (python3, zipfile, byte spans and ElementTree)"
    cat >"$B/shiftcmp.py" <<'CMP_PY'
    """The run log's own shift comparison (specs/0018-rows-and-columns.md,
    "Harness runs", the row samples of P2 and the column samples of P3, with
    "Planning rulings during P2" 1 to 8 and "Planning rulings during P3" 1 to
    3).
    
    Usage: shiftcmp.py <mode> <input archive> <output archive> [--plant <flag>]
           shiftcmp.py <mode> <input archive> --predict
           shiftcmp.py <mode> <input archive> --unchanged
           shiftcmp.py <mode> <input archive> --parts
    <mode> is insert or delete (the row samples: two rows inserted at k, or
    row k deleted) or insert-columns or delete-columns (the column samples: one
    column inserted at c, or column c deleted).
    
    Reads the archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool. It makes its own pick of W (the first
    worksheet in <sheets> order) and of the point: max(2, T + 1), T the largest
    last row (on the column axis U, the largest last column) of the ref of every
    table part and the location ref of every pivot table part W's relationships
    name. From W's input bytes it builds, by "The shift rule" as the P2 and P3
    rulings read it (this script's own model), what W's output must hold.
    Flags on both axes:
    
      rest_same         W with every root child the rule names cut out is the
                        input's: sheetData, dimension, mergeCells,
                        conditionalFormatting, dataValidations, hyperlinks,
                        autoFilter, and on the column axis cols
      sheetdata_bytes   sheetData is byte for byte the model's: on the row axis
                        every row at or after k with r as the rule gives, a
                        deleted row cut out whole; on the column axis every row
                        kept with its spans as the rule gives, a deleted
                        column's cell cut out whole; every cell's r as the rule
                        gives and a shared, array or data table ref moved whole,
                        every other byte the input's
      cells_moved       read with ElementTree, every input cell before the point
                        is in the output at its reference and every one after is
                        at its moved reference, each with the same s, t, formula
                        and value, a deleted cell absent, no other cell
      dimension_ok      dimension as the rule gives, clipped, A1 when emptied
      merges_ok         mergeCells as the rule gives: each ref moved, grown or
                        cut, dropped when removed or reduced to one cell, count
                        its children, the container dropped when emptied
      lists_ok          every conditionalFormatting, dataValidations,
                        hyperlinks and autoFilter element as the rule gives:
                        each range moved or cut, dropped from its list, an
                        element whose list empties dropped with its content,
                        dataValidations' count its children, an emptied
                        dataValidations or hyperlinks dropped
      calc_ok           the output's workbook asks for a full calculation on
                        load exactly when a formula sits at or after the point,
                        and its calculation chain is gone exactly then (when it
                        had one)
    
    On the row axis only:
    
      rows_before_same  sheetData's content before its first row at or after
                        k is the input's, byte for byte
    
    On the column axis only:
    
      cells_before_same every cell element left of c, in document order, is the
                        input's byte for byte
      spans_ok          every row's start tag is the model's: the input's, with
                        spans as P3 ruling 2 gives (each a:b item moved, grown,
                        cut or clipped, an item the rule removes dropped, the
                        attribute dropped when none is left)
      cols_ok           every cols element as the rule gives: each col's min and
                        max moved, grown, cut or clipped at 16384, a col the rule
                        removes dropped, a cols left with no col dropped; order
                        and overlap are not checked (P3 ruling 1)
    
    An input container with no content (an empty-element tag) is copied as it
    is on both axes: the rule leaves nothing in it to drop.
    
    --parts prints W, the workbook part, its rels part and its calculation
    chain part (an empty line when there is none), for the log to match the
    runner's entry rows without printing a name. --unchanged prints whether the
    model leaves W's bytes as the input's (unchanged=yes|no), so the log expects
    W `recompressed` there and `changed` elsewhere (P2 ruling 13). --predict
    prints whether the rule refuses this input (refuse=yes|no) and nothing
    else: a shared, array or data table ref the rule would grow or cut or push
    past the grid, a row or cell pushed past the grid, a table or pivot range at
    or after the point, a range or spans item that does not parse, or a
    malformed col (P3 ruling 1). The comparison prints ONE line of counts and
    yes/no flags and no reference, value, text, name or part name. --plant
    <flag> changes the output as read so that the named flag turns to no; the
    line then says planted=yes, or planted=no when the pair gives the plant
    nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def named(element, prefix):
        """element with prefix put before every element name in it."""
        return re.sub(rb"<(/?)([A-Za-z])", lambda m: b"<" + m.group(1) + prefix + m.group(2), element)
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            if el.get("TargetMode") == "External":
                continue
            target = el.get("Target", "")
            resolved = (target[1:] if target.startswith("/")
                        else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def pick(z):
        """The first worksheet part in <sheets> order."""
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        if len(office) != 1:
            return None
        workbook = office[0]
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty.endswith("/worksheet") and target in z.namelist():
                    return target
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def is_empty(raw):
        tag = start_tag(raw)
        return tag.endswith(b"/>")
    
    
    def inner(raw):
        """(offset of the content, offset of its end) in an element's bytes."""
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return len(tag), len(tag)
        return len(tag), raw.rfind(b"</")
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def attributes(tag):
        """(name, value) of every attribute of a start tag, in order."""
        return [(m.group(1).decode(), m.group(3)[1:-1].decode())
                for m in re.finditer(rb'\s([^\s=/>]+)\s*=\s*(("[^"]*")|(\'[^\']*\'))', tag)]
    
    
    def with_attr(tag, name, value):
        """The unprefixed attribute set: replaced between its quotes, else put
        after the last attribute's closing quote, else after the name."""
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def attr_value(tag, name):
        m = re.search(ATTR_RE % re.escape(name), tag)
        return m.group(1)[1:-1] if m else None
    
    
    def root_span(data):
        """(start of the root's content, end of it) and the root's prefix."""
        m = None
        for m in re.finditer(rb"<([^\s/>?!]+)", data):
            break
        close = data.find(b">", m.start())
        if data[close - 1:close] == b"/":
            return close + 1, close + 1, split_name(m.group(1))[0]
        end = data.rfind(b"</")
        return close + 1, end, split_name(m.group(1))[0]
    
    
    def children(data, a, b, root_prefix):
        """[(start, end, main local name or None)] of the root's children."""
        out = []
        for (x, y) in top_level(data[a:b]):
            p, n = split_name(qname(data[a + x:a + y]))
            out.append((a + x, a + y, n if p == root_prefix else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    
    GRID_ROWS = 1048576
    GRID_COLUMNS = 16384
    LISTS = ("conditionalFormatting", "dataValidations", "hyperlinks", "autoFilter")
    NAMED_ROWS = ("sheetData", "dimension", "mergeCells") + LISTS
    NAMED_COLUMNS = NAMED_ROWS + ("cols",)
    FLAGS_ROWS = ("rest_same", "rows_before_same", "sheetdata_bytes", "cells_moved",
                  "dimension_ok", "merges_ok", "lists_ok", "calc_ok")
    FLAGS_COLUMNS = ("rest_same", "cells_before_same", "sheetdata_bytes", "cells_moved",
                     "spans_ok", "dimension_ok", "merges_ok", "cols_ok", "lists_ok", "calc_ok")
    DECIMAL_RE = re.compile(rb"(0|[1-9][0-9]*)")
    COMMENT = b"<!-- planted -->"
    A1_RE = re.compile(rb"^([A-Z]{1,7})([1-9][0-9]*)$")
    
    
    class Refused(Exception):
        pass
    
    
    def ref_parse(text):
        """(row, col) of an A1 reference, or None."""
        m = A1_RE.match(text)
        if not m:
            return None
        col = 0
        for ch in m.group(1):
            col = col * 26 + (ch - 64)
        return int(m.group(2)), col
    
    
    def a1(row, col):
        name = ""
        while col > 0:
            col, rest = divmod(col - 1, 26)
            name = chr(65 + rest) + name
        return "%s%d" % (name, row)
    
    
    def area_parse(text):
        """((r1, c1), (r2, c2)) normalised, or None."""
        halves = text.split(b":")
        if len(halves) > 2:
            return None
        a = ref_parse(halves[0])
        b = ref_parse(halves[1]) if len(halves) == 2 else a
        if a is None or b is None:
            return None
        return (min(a[0], b[0]), min(a[1], b[1])), (max(a[0], b[0]), max(a[1], b[1]))
    
    
    def area_a1(area):
        (r1, c1), (r2, c2) = area
        return (a1(r1, c1) if (r1, c1) == (r2, c2) else a1(r1, c1) + ":" + a1(r2, c2)).encode()
    
    
    def decimal(text):
        """The library's decimal u32: digits, no leading zero, below 2^32."""
        if DECIMAL_RE.fullmatch(text) is None or int(text) >= 1 << 32:
            return None
        return int(text)
    
    
    class Rule:
        def __init__(self, insert, k, n, columns=False):
            self.insert, self.k, self.n, self.columns = insert, k, n, columns
            self.limit = GRID_COLUMNS if columns else GRID_ROWS
    
        def on_axis(self, cell):
            """A (row, col) cell's index on the rule's axis."""
            return cell[1] if self.columns else cell[0]
    
        def index(self, i):
            if i < self.k:
                return i
            if self.insert:
                return i + self.n
            if i < self.k + self.n:
                return None
            return i - self.n
    
        def interval(self, a, b):
            """("whole"|"changed", a, b) or ("gone",)."""
            k, n = self.k, self.n
            if b < k:
                return ("whole", a, b)
            if self.insert:
                return ("whole", a + n, b + n) if a >= k else ("changed", a, b + n)
            last = k + n - 1
            if a > last:
                return ("whole", a - n, b - n)
            if a >= k and b <= last:
                return ("gone",)
            return ("changed", a if a < k else k, b - n if b > last else k - 1)
    
        def interval_clipped(self, a, b):
            """[a, b] through the rule and the clip, or None when removed or
            moved wholly past the grid."""
            got = self.interval(a, b)
            if got[0] == "gone" or got[1] > self.limit:
                return None
            return got[1], min(got[2], self.limit)
    
        def clipped(self, area):
            (r1, c1), (r2, c2) = area
            if self.columns:
                got = self.interval_clipped(c1, c2)
                return None if got is None else ((r1, got[0]), (r2, got[1]))
            got = self.interval_clipped(r1, r2)
            return None if got is None else ((got[0], c1), (got[1], c2))
    
    
    def moved_list(value, rule):
        """The list through the rule: None when it empties; the input's bytes
        when nothing changed; else single spaces, unchanged ranges as written."""
        kept, changed = [], False
        for rng in value.split():
            area = area_parse(rng)
            if area is None:
                raise Refused()
            got = rule.clipped(area)
            if got == area:
                kept.append(rng)
            elif got is None:
                changed = True
            else:
                changed = True
                kept.append(area_a1(got))
        if not kept:
            return None
        return b" ".join(kept) if changed else value
    
    
    def list_element(el, name, rule):
        """An element whose attribute name is a list, through the rule, or
        None when the list empties."""
        tag = start_tag(el)
        value = attr_value(tag, name)
        if value is None:
            return el
        got = moved_list(value, rule)
        if got is None:
            return None
        if got == value:
            return el
        return with_attr(tag, name, got) + el[len(tag):]
    
    
    def counted(el, child, rule, per_child):
        """A counted container through the rule: its children run through
        per_child, dropped ones cut, count its kept children; None when none is
        kept. One with no content is copied as it is."""
        if is_empty(el):
            return el
        a, b = inner(el)
        content = el[a:b]
        parts, at, kept = [], 0, 0
        for (x, y) in top_level(content):
            parts.append(content[at:x])
            c = content[x:y]
            at = y
            if split_name(qname(c))[1] == child:
                got = per_child(c)
                if got is None:
                    continue
                kept += 1
                parts.append(got)
            else:
                parts.append(c)
        parts.append(content[at:])
        if kept == 0:
            return None
        return with_attr(start_tag(el), b"count", str(kept).encode()) + b"".join(parts) + el[b:]
    
    
    def merge_child(c, rule):
        tag = start_tag(c)
        value = attr_value(tag, b"ref")
        if value is None:
            return c
        area = area_parse(value)
        if area is None:
            raise Refused()
        got = rule.clipped(area)
        if got == area:
            return c
        if got is None or got[0] == got[1]:
            return None
        return with_attr(tag, b"ref", area_a1(got)) + c[len(tag):]
    
    
    def moved_formula(tag, rule, dropping):
        t = attr_value(tag, b"t")
        if t not in (b"shared", b"array", b"dataTable"):
            return tag
        value = attr_value(tag, b"ref")
        if value is None:
            return tag
        area = area_parse(value)
        if area is None:
            raise Refused()
        first, last = rule.on_axis(area[0]), rule.on_axis(area[1])
        got = rule.interval(first, last)
        if got[0] == "gone":
            return tag
        if got[0] == "changed" or dropping or got[2] > rule.limit:
            raise Refused()
        if got[1] == first:
            return tag
        if rule.columns:
            moved = ((area[0][0], got[1]), (area[1][0], got[2]))
        else:
            moved = ((got[1], area[0][1]), (got[2], area[1][1]))
        return with_attr(tag, b"ref", area_a1(moved))
    
    
    def without_attr(tag, name):
        """The unprefixed attribute and the whitespace before it cut out; the
        tag as it is when it has none."""
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m is None:
            return tag
        at = m.start()
        while at > 0 and tag[at - 1:at] in (b" ", b"\t", b"\n", b"\r"):
            at -= 1
        return tag[:at] + tag[m.end():]
    
    
    def moved_spans(tag, rule):
        """A row's start tag with its spans through the column rule (P3 ruling
        2)."""
        value = attr_value(tag, b"spans")
        if value is None:
            return tag
        kept, changed = [], False
        for item in re.split(rb"[ \t\n\r]+", value):
            if not item:
                continue
            a_text, colon, b_text = item.partition(b":")
            a, b = decimal(a_text), decimal(b_text)
            if not colon or a is None or b is None or a < 1 or a > b:
                raise Refused()
            got = rule.interval_clipped(a, b)
            if got == (a, b):
                kept.append(item)
            elif got is None:
                changed = True
            else:
                changed = True
                kept.append(b"%d:%d" % got)
        if not changed:
            return tag
        if not kept:
            return without_attr(tag, b"spans")
        return with_attr(tag, b"spans", b" ".join(kept))
    
    
    def moved_col(c, rule):
        """A col through the column rule: None when removed or moved wholly past
        the grid; a malformed min or max refused (P3 ruling 1)."""
        tag = start_tag(c)
        lo_text, hi_text = attr_value(tag, b"min"), attr_value(tag, b"max")
        lo = decimal(lo_text) if lo_text is not None else None
        hi = decimal(hi_text) if hi_text is not None else None
        if lo is None or hi is None or lo == 0 or lo > hi:
            raise Refused()
        got = rule.interval_clipped(lo, hi)
        if got is None:
            return None
        if got == (lo, hi):
            return c
        tag2 = with_attr(with_attr(tag, b"min", str(got[0]).encode()), b"max", str(got[1]).encode())
        return tag2 + c[len(tag):]
    
    
    def dropping_container(el, child, per_child):
        """A container streamed under the rule (hyperlinks, cols): children
        named child run through per_child and a dropped one cut, every other
        byte kept; None when no child is kept; one with no content copied as it
        is."""
        if is_empty(el):
            return el
        ia, ib = inner(el)
        content = el[ia:ib]
        parts, at, kept = [], 0, 0
        for (hx, hy) in top_level(content):
            parts.append(content[at:hx])
            at = hy
            h = content[hx:hy]
            if split_name(qname(h))[1] != child:
                parts.append(h)
                continue
            got = per_child(h)
            if got is not None:
                kept += 1
                parts.append(got)
        parts.append(content[at:])
        return el[:ia] + b"".join(parts) + el[ib:] if kept else None
    
    
    def expected_sheetdata(raw, rule):
        """sheetData through the rule, and whether a formula sits at or after
        k."""
        a, b = inner(raw)
        content = raw[a:b]
        parts, at, reaches = [], 0, False
        for (x, y) in top_level(content):
            parts.append(content[at:x])
            at = y
            row = content[x:y]
            if split_name(qname(row))[1] != "row":
                parts.append(row)
                continue
            rtag = start_tag(row)
            r = int(attr_value(rtag, b"r"))
            if rule.columns:
                to = r
                rtag = moved_spans(rtag, rule)
            else:
                to = rule.index(r)
            dropping = to is None
            if not rule.columns and not dropping and to > rule.limit:
                raise Refused()
            ra, rb = inner(row)
            rc = row[ra:rb]
            rparts, rat = [], 0
            for (cx, cy) in top_level(rc):
                rparts.append(rc[rat:cx])
                rat = cy
                cell = rc[cx:cy]
                if split_name(qname(cell))[1] != "c":
                    rparts.append(cell)
                    continue
                ctag = start_tag(cell)
                row_col = ref_parse(attr_value(ctag, b"r"))
                cell_dropping = dropping
                if rule.columns:
                    cto = rule.index(row_col[1])
                    cell_dropping = cto is None
                    if cto is not None and cto > rule.limit:
                        raise Refused()
                    if cto is not None and cto != row_col[1]:
                        ctag = with_attr(ctag, b"r", a1(r, cto).encode())
                elif to is not None and to != r:
                    ctag = with_attr(ctag, b"r", a1(to, row_col[1]).encode())
                ca, cb = inner(cell)
                cc = cell[ca:cb]
                cparts, cat = [], 0
                for (fx, fy) in top_level(cc):
                    cparts.append(cc[cat:fx])
                    cat = fy
                    f = cc[fx:fy]
                    if split_name(qname(f))[1] == "f":
                        if rule.on_axis(row_col) >= rule.k:
                            reaches = True
                        ft = start_tag(f)
                        f = moved_formula(ft, rule, cell_dropping) + f[len(ft):]
                    cparts.append(f)
                cparts.append(cc[cat:])
                if cell_dropping and rule.columns:
                    continue
                rparts.append(ctag if is_empty(cell) else ctag + b"".join(cparts) + cell[cb:])
            rparts.append(rc[rat:])
            if dropping:
                continue
            if to != r:
                rtag = with_attr(rtag, b"r", str(to).encode())
            parts.append(rtag if is_empty(row) else rtag + b"".join(rparts) + row[rb:])
        parts.append(content[at:])
        if is_empty(raw):
            return raw, reaches
        return raw[:a] + b"".join(parts) + raw[b:], reaches
    
    
    def table_top(z, part, columns):
        """T (U on the column axis): the largest last row (column) of W's table
        and pivot ranges; raises Refused for a range that does not parse or a
        part that is not there, as the library refuses both (P2 ruling 2)."""
        top = 0
        for (_, ty, target) in rels_of(z, part):
            location = ty.endswith("/pivotTable")
            if not (location or ty.endswith("/table")):
                continue
            if target not in z.namelist():
                raise Refused()
            root = ET.fromstring(z.read(target))
            el = root
            if location:
                el = next((e for e in root.iter() if local(e.tag)[1] == "location"), None)
            value = el.get("ref") if el is not None else None
            area = area_parse(value.encode()) if value else None
            if area is None:
                raise Refused()
            top = max(top, area[1][1] if columns else area[1][0])
        return top
    
    
    def model(din, rule):
        """{root child name: [expected element bytes or None]} for the named
        children, the sheetData bytes, and whether a formula reaches k."""
        a, b, rp = root_span(din)
        out = {}
        reaches = False
        for (x, y, n) in children(din, a, b, rp):
            el = din[x:y]
            if n == "sheetData" and "sheetData" not in out:
                got, reaches = expected_sheetdata(el, rule)
            elif n == "dimension":
                value = attr_value(start_tag(el), b"ref")
                area = area_parse(value) if value is not None else None
                if value is not None and area is None:
                    raise Refused()
                got = el
                if area is not None:
                    moved = rule.clipped(area)
                    if moved is None:
                        got = with_attr(start_tag(el), b"ref", b"A1") + el[len(start_tag(el)):]
                    elif moved != area:
                        got = with_attr(start_tag(el), b"ref", area_a1(moved)) + el[len(start_tag(el)):]
            elif n == "mergeCells":
                got = counted(el, "mergeCell", rule, lambda c: merge_child(c, rule))
            elif n == "dataValidations":
                got = counted(el, "dataValidation", rule, lambda c: list_element(c, b"sqref", rule))
            elif n == "hyperlinks":
                got = dropping_container(el, "hyperlink", lambda h: list_element(h, b"ref", rule))
            elif n == "cols" and rule.columns:
                got = dropping_container(el, "col", lambda c: moved_col(c, rule))
            elif n == "conditionalFormatting":
                got = list_element(el, b"sqref", rule)
            elif n == "autoFilter":
                got = list_element(el, b"ref", rule)
            else:
                continue
            out.setdefault(n, []).append(got)
        return out, reaches
    
    
    def calc_state(z):
        """(fullCalcOnLoad is 1 or true, a calcChain relationship exists)."""
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        wb = office[0]
        full = False
        for el in ET.fromstring(z.read(wb)).iter():
            if local(el.tag)[1] == "calcPr":
                full = el.get("fullCalcOnLoad") in ("1", "true")
                break
        chain = any(ty.endswith("/calcChain") for (_, ty, _) in rels_of(z, wb))
        return full, chain
    
    
    def cell_map(data):
        out = {}
        for el in ET.fromstring(data).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "c":
                f = v = None
                for child in el:
                    cns, cname = local(child.tag)
                    if cns in MAIN and cname == "f":
                        f = (child.get("t"), child.text, child.get("si"))
                    elif cns in MAIN and cname in ("v", "is"):
                        v = ET.tostring(child)
                out[el.get("r")] = (el.get("s"), el.get("t"), f, v)
        return out
    
    
    def sheet_rows(sd):
        """[(row start tag, [(col, cell bytes)])] of a sheetData element."""
        out = []
        if is_empty(sd):
            return out
        a, b = inner(sd)
        content = sd[a:b]
        for (x, y) in top_level(content):
            row = content[x:y]
            if split_name(qname(row))[1] != "row":
                continue
            cells = []
            if not is_empty(row):
                ra, rb = inner(row)
                rc = row[ra:rb]
                for (cx, cy) in top_level(rc):
                    cell = rc[cx:cy]
                    if split_name(qname(cell))[1] != "c":
                        continue
                    cells.append((ref_parse(attr_value(start_tag(cell), b"r"))[1], cell))
            out.append((start_tag(row), cells))
        return out
    
    
    def plant(dout, flag, k):
        a, b, rp = root_span(dout)
        kids = children(dout, a, b, rp)
        first = {}
        for (x, y, n) in kids:
            first.setdefault(n, (x, y))
        if flag == "rest_same":
            return dout[:a] + COMMENT + dout[a:], True
        if flag in ("rows_before_same", "sheetdata_bytes", "cells_moved",
                    "cells_before_same", "spans_ok"):
            if "sheetData" not in first:
                return dout, False
            x, y = first["sheetData"]
            el = dout[x:y]
            ia, ib = inner(el)
            if flag == "rows_before_same":
                if ia == ib:
                    return dout, False
                return dout[:x + ia] + COMMENT + dout[x + ia:], True
            if flag == "sheetdata_bytes":
                m = re.search(rb'(<(?:\w+:)?c\b[^>]*?)\s*/?>', el)
                if m is None:
                    return dout, False
                t = m.group(0)
                w = t.replace(b' r="', b'  r="', 1)
                return dout[:x + m.start()] + w + dout[x + m.end():], w != t
            if flag == "cells_before_same":
                # The first cell left of the point, one space doubled in its tag.
                for m in re.finditer(rb'<(?:\w+:)?c\b[^>]*?\sr="([A-Z]+)[0-9]+"[^>]*>', el):
                    if ref_parse(m.group(1) + b"1")[1] < k:
                        t = m.group(0)
                        w = t.replace(b' r="', b'  r="', 1)
                        return dout[:x + m.start()] + w + dout[x + m.end():], w != t
                return dout, False
            if flag == "spans_ok":
                m = re.search(rb'<(?:\w+:)?row\b[^>]*>', el)
                if m is None:
                    return dout, False
                t = m.group(0)
                w = t.replace(b' r="', b'  r="', 1)
                return dout[:x + m.start()] + w + dout[x + m.end():], w != t
            m = re.search(rb"<(\w+:)?v>([^<]*)</", el)
            if m is None:
                return dout, False
            return dout[:x + m.start(2)] + b"123456789" + dout[x + m.end(2):], True
        if flag == "dimension_ok":
            if "dimension" not in first:
                return dout, False
            x, y = first["dimension"]
            el = dout[x:y]
            w = with_attr(start_tag(el), b"ref", b"ZZ1") + el[len(start_tag(el)):]
            return dout[:x] + w + dout[y:], True
        if flag in ("merges_ok", "cols_ok"):
            name = "mergeCells" if flag == "merges_ok" else "cols"
            if name not in first:
                return dout, False
            x, y = first[name]
            return dout[:x] + dout[y:], True
        if flag == "calc_ok":
            # Applied in main, to the workbook part as read.
            return dout, True
        if flag == "lists_ok":
            for n in LISTS:
                if n in first:
                    x, y = first[n]
                    return dout[:x] + dout[y:], True
            return dout, False
        return dout, False
    
    
    MODES = {"insert": (True, False), "delete": (False, False),
             "insert-columns": (True, True), "delete-columns": (False, True)}
    
    
    def main():
        args = sys.argv[1:]
        mode = args[0]
        if mode not in MODES:
            print("error=unknown-mode")
            return
        rule_insert, columns = MODES[mode]
        flags_all = FLAGS_COLUMNS if columns else FLAGS_ROWS
        named_all = NAMED_COLUMNS if columns else NAMED_ROWS
        zin = zipfile.ZipFile(args[1])
        part = pick(zin)
        if args[2:3] == ["--parts"]:
            # W, the workbook part, its rels part and its chain part (empty when
            # there is none), one per line, for the log to compare with the
            # runner's rows without printing them.
            office = [t for (_, ty, t) in rels_of(zin, "") if ty.endswith("/officeDocument")]
            wb = office[0] if office else ""
            chain = [t for (_, ty, t) in rels_of(zin, wb) if ty.endswith("/calcChain")] if wb else []
            print(part or "")
            print(wb)
            print(rels_name(wb) if wb else "")
            print(chain[0] if chain else "")
            return
        if part is None:
            print("found=0")
            return
        din = zin.read(part)
        try:
            k = max(2, table_top(zin, part, columns) + 1)
        except Refused:
            k = 2
            table_refused = True
        else:
            table_refused = False
        # The row samples insert two rows; the column samples one column; a
        # deletion takes one (specs/0018 "Harness runs", P3 ruling 3).
        rule = Rule(rule_insert, k, 2 if rule_insert and not columns else 1, columns)
        try:
            expected, reaches = model(din, rule)
            refuse = table_refused
        except Refused:
            expected, reaches, refuse = None, False, True
        if args[2:3] == ["--predict"]:
            print("refuse=%s" % ("yes" if refuse else "no"))
            return
        if args[2:3] == ["--unchanged"]:
            # Whether the model leaves W's bytes as they are: every element the
            # rule names comes out as the input's (P2 ruling 13).
            same = not refuse
            if same:
                a0, b0, rp0 = root_span(din)
                kids0 = children(din, a0, b0, rp0)
                for n in expected:
                    kept = [e for e in expected[n] if e is not None]
                    have = [din[x2:y2] for (x2, y2, n2) in kids0 if n2 == n]
                    if kept != have:
                        same = False
            print("unchanged=%s" % ("yes" if same else "no"))
            return
        planted_flag = args[args.index("--plant") + 1] if "--plant" in args else None
        if planted_flag is not None and planted_flag not in flags_all:
            print("error=unknown-plant")
            return
        if refuse:
            print("error=refused-input")
            return
        zout = zipfile.ZipFile(args[2])
        dout = zout.read(part)
        planted = True
        if planted_flag is not None:
            dout, planted = plant(dout, planted_flag, k)
        yn = lambda v: "yes" if v else "no"
        ai, bi, rp = root_span(din)
        ao, bo, rpo = root_span(dout)
        kin = children(din, ai, bi, rp)
        kout = children(dout, ao, bo, rpo)
        flags = {}
        flags["rest_same"] = (cut(din, [(x, y) for (x, y, n) in kin if n in named_all])
                              == cut(dout, [(x, y) for (x, y, n) in kout if n in named_all]))
        got = {}
        for (x, y, n) in kout:
            if n in named_all:
                got.setdefault(n, []).append(dout[x:y])
    
        def same(name):
            want = [e for e in expected.get(name, []) if e is not None]
            return got.get(name, []) == want
    
        sd_in = next(din[x:y] for (x, y, n) in kin if n == "sheetData")
        sd_out = got.get("sheetData", [b""])[0]
        if columns:
            rows_in = sheet_rows(sd_in)
            rows_out = sheet_rows(sd_out) if sd_out else []
            left_in = [c for (_, cells) in rows_in for (col, c) in cells if col < k]
            left_out = [c for (_, cells) in rows_out for (col, c) in cells if col < k]
            flags["cells_before_same"] = left_in == left_out
            want_sd = [e for e in expected.get("sheetData", []) if e is not None]
            want_tags = [t for (t, _) in sheet_rows(want_sd[0])] if want_sd else []
            flags["spans_ok"] = [t for (t, _) in rows_out] == want_tags
            flags["cols_ok"] = same("cols")
        else:
            ia, ib = inner(sd_in)
            oa, ob = inner(sd_out) if sd_out else (0, 0)
            first_at = ib
            for (x, y) in top_level(sd_in[ia:ib]):
                row = sd_in[ia + x:ia + y]
                if split_name(qname(row))[1] == "row" and int(attr_value(start_tag(row), b"r")) >= k:
                    first_at = ia + x
                    break
            prefix = sd_in[ia:first_at]
            flags["rows_before_same"] = sd_out[oa:oa + len(prefix)] == prefix and sd_out[:oa] == sd_in[:ia]
        flags["sheetdata_bytes"] = same("sheetData")
        cin, cout = cell_map(din), cell_map(dout)
        want_cells = {}
        for ref, tup in cin.items():
            row, col = ref_parse(ref.encode())
            to = rule.index(col if columns else row)
            if to is not None:
                want_cells[a1(row, to) if columns else a1(to, col)] = tup
        flags["cells_moved"] = cout == want_cells
        flags["dimension_ok"] = same("dimension")
        flags["merges_ok"] = same("mergeCells")
        flags["lists_ok"] = all(same(n) for n in LISTS)
        full_in, chain_in = calc_state(zin)
        full_out, chain_out = calc_state(zout)
        if planted_flag == "calc_ok":
            # The workbook part as read says the opposite about the flag.
            full_out = not full_out
        if reaches:
            flags["calc_ok"] = full_out and not chain_out
        else:
            flags["calc_ok"] = full_out == full_in and chain_out == chain_in
        moved_formulas = sum(1 for ref, tup in cin.items()
                             if tup[2] is not None and rule.on_axis(ref_parse(ref.encode())) >= k)
        fields = ["found=1", "planted=%s" % yn(planted), "at=%d" % k,
                  "cells_in=%d" % len(cin), "cells_out=%d" % len(cout),
                  "formulas_moved=%d" % moved_formulas,
                  "chain_in=%d" % chain_in, "chain_out=%d" % chain_out, "full_out=%d" % full_out]
        print(" ".join(fields + ["%s=%s" % (f, yn(flags[f])) for f in flags_all]))
    
    
    main()
    CMP_PY
    echo "command: sed 's/^/    /' <scratch>/w/shiftcmp.py; sha256 $(sha_of "$B/shiftcmp.py"), $(wc -c <"$B/shiftcmp.py") bytes"
    sed 's/^/    /' "$B/shiftcmp.py"
    FLAGS="rest_same cells_before_same sheetdata_bytes cells_moved spans_ok dimension_ok merges_ok cols_ok lists_ok calc_ok"
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    all_yes() { local f; for f in $FLAGS; do [ "$(kv "$1" "$f")" = yes ] || return 1; done; }
    # tool_and_cmp <tool line> <comparison line>: the counts the two share.
    tool_and_cmp() {
      [ "$(kv "$1" at)" = "$(kv "$2" at)" ] || return 1
      [ "$(kv "$1" cells_before)" = "$(kv "$2" cells_in)" ] || return 1
      [ "$(kv "$1" cells_after)" = "$(kv "$2" cells_out)" ] || return 1
      [ "$(kv "$1" formulas_moved)" = "$(kv "$2" formulas_moved)" ] || return 1
      [ "$(kv "$1" chain_before)" = "$(kv "$2" chain_in)" ] || return 1
      [ "$(kv "$1" chain_after)" = "$(kv "$2" chain_out)" ] || return 1
      [ "$(kv "$1" full_calc)" = "$(kv "$2" full_out)" ]
    }
    # line_as_spec <tool line> <op>: what "Harness runs" and P3 ruling 3 expect
    # of the line.
    line_as_spec() {
      [ "$(kv "$1" count)" = 1 ] || return 1
      if [ "$2" = insert ]; then
        [ "$(printf '%s' "$1" | cut -f1)" = insert_columns ] || return 1
        [ "$(kv "$1" cells_after)" = "$(kv "$1" cells_before)" ] || return 1
        [ -n "$(kv "$1" from_c_before)" ] || return 1
        [ "$(kv "$1" from_c1_after)" = "$(kv "$1" from_c_before)" ]
      else
        [ "$(printf '%s' "$1" | cut -f1)" = delete_columns ] || return 1
        [ -n "$(kv "$1" from_c1_before)" ] || return 1
        [ "$(kv "$1" from_c_after)" = "$(kv "$1" from_c1_before)" ]
      fi
    }
    ay_ctl() { if all_yes "found=1"; then return 1; else return 0; fi; }
    check "control: all_yes refuses a line with no flags" "$(yn ay_ctl)"
    lin_ctl() { if line_as_spec "$(printf 'insert_columns\tat=2\tcount=1\tcells_before=3\tcells_after=3\tfrom_c_before=2\tfrom_c1_after=1')" insert; then return 1; else return 0; fi; }
    check "control: line_as_spec refuses an insertion line whose moved cells differ" "$(yn lin_ctl)"
    lin_ok() { line_as_spec "$(printf 'insert_columns\tat=2\tcount=1\tcells_before=3\tcells_after=3\tfrom_c_before=2\tfrom_c1_after=2')" insert; }
    lin_row_ctl() { if line_as_spec "$(printf 'insert_rows\tat=2\tcount=1\tcells_before=3\tcells_after=3\tfrom_c_before=2\tfrom_c1_after=2')" insert; then return 1; else return 0; fi; }
    check "control: line_as_spec refuses the same line under a row sample's word" "$(yn lin_row_ctl)"
    check "control: line_as_spec accepts the same line with them equal" "$(yn lin_ok)"
    
    manifest_rows=$(awk -F'\t' 'NR > 1 { n++ } END { print n + 0 }' "$CORPUS/manifest.tsv")
    echo "  corpus manifest rows: $manifest_rows"
    check "the corpus holds its 27 workbooks" "$(yn [ "$manifest_rows" = 27 ])"
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    sum_col() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { n += $k } END { print n + 0 }' "$1"; }
    # sample_block <insert|delete>: the corpus runs, the comparison, the plants
    # and the record pair of one column sample (changes L and R); the
    # comparison runs in its column mode, <op>-columns.
    sample_block() {
    OP=$1
    if [ "$OP" = insert ]; then EDIT=--insert-columns-sample; RUN=$RUN_INSERT; STEM_RUN=$STEM_INSERT; else EDIT=--delete-columns-sample; RUN=$RUN_DELETE; STEM_RUN=$STEM_DELETE; fi
    CMP_OP=$OP-columns
    OUT=$CORPUS/runs/$RUN
    echo
    echo "## the $OP sample: $EDIT into <corpus>/runs/$RUN"
    echo "### the refusal set, computed from the inputs before the run (P2 ruling 6)"
    : >"$B/$OP-refused"
    while IFS="$TAB" read -r id ext; do
      if [ "$(python3 "$B/shiftcmp.py" "$CMP_OP" "$CORPUS/corpus/$id.$ext" --predict)" = refuse=yes ]; then printf '%s\n' "$id" >>"$B/$OP-refused"; fi
    done < <(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv")
    NREF=$(count_lines "$B/$OP-refused")
    echo "  workbooks the comparison predicts the rule refuses: $NREF"
    echo "### the workbooks whose W the model leaves as it is, before the run (P2 ruling 13)"
    : >"$B/$OP-unchanged"
    while IFS="$TAB" read -r id ext; do
      if [ "$(python3 "$B/shiftcmp.py" "$CMP_OP" "$CORPUS/corpus/$id.$ext" --unchanged)" = unchanged=yes ]; then printf '%s\n' "$id" >>"$B/$OP-unchanged"; fi
    done < <(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv")
    NUNCH=$(count_lines "$B/$OP-unchanged")
    echo "  workbooks whose W the rule leaves byte for byte: $NUNCH"
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      echo
      echo "## $label run, --tool-arg $EDIT"
      echo "command: scripts/passthrough-run.sh --label $label --passthrough <build>/target/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <build>/target/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --out <corpus>/runs/$RUN --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$OUT" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
        >"$B/run-$label.stdout" 2>"$B/run-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$label.stderr")"
      sed 's/^/    /' "$B/run-$label.stdout"
      check "$label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$label: its stderr is empty" "$(yn [ ! -s "$B/run-$label.stderr" ])"
      SUM=$OUT/summary.$label.tsv
      ENT=$OUT/entries.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      echo "  summary rows: $rows; outcome ok: $(count_where "$SUM" outcome ok); lo ok: $(count_where "$SUM" lo ok); lo_in ok: $(count_where "$SUM" lo_in ok); leftover no: $(count_where "$SUM" leftover no)"
      echo "  order_preserved yes: $(count_where "$SUM" order_preserved yes); comment_equal yes: $(count_where "$SUM" comment_equal yes); files_identical no: $(count_where "$SUM" files_identical no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      # The refused workbooks (P2 ruling 6): outcome error, no output file, the
      # tool's message on its stderr; every other workbook as before.
      summary_ok() {
        local col ok_rows=$((rows - NREF))
        [ "$rows" = "$manifest_rows" ] || return 1
        [ "$(count_where "$SUM" outcome ok)" = "$ok_rows" ] || return 1
        [ "$(count_where "$SUM" outcome error)" = "$NREF" ] || return 1
        for col in "lo ok" "lo_in ok" "leftover no" "order_preserved yes" "comment_equal yes" "files_identical no"; do
          [ "$(count_where "$SUM" ${col% *} ${col#* })" = "$ok_rows" ] || return 1
        done
        [ "$(sum_col "$SUM" recompressed)" = "$NUNCH" ] || return 1
        [ "$(sum_col "$SUM" added)" = 0 ]
      }
      check "$label: every workbook ok but the predicted refusals, those outcome error; lo and lo_in ok, no leftover, order and comment kept, one entry recompressed per workbook the model leaves unchanged (P2 ruling 13) and none added" "$(yn summary_ok)"
      refused_as_ruled() {
        local id
        while IFS= read -r id; do
          [ ! -e "$OUT/$id/out.$label.xlsx" ] && [ ! -e "$OUT/$id/out.$label.xltx" ] || return 1
          [ ! -s "$OUT/$id/stdout.$label.txt" ] || return 1
          [ "$(count_matches -E '^error: ' "$OUT/$id/stderr.$label.txt")" = 1 ] || return 1
        done <"$B/$OP-refused"
      }
      check "$label: each of the $NREF predicted refusals has no output, no line and one error line" "$(yn refused_as_ruled)"
      # entries_ruled <id> <parts file> <formulas moved>: the runner's rows for one
      # workbook, as ruling 11 gives them: W changed; the workbook part changed
      # when a formula moved; its rels part and [Content_Types].xml changed and
      # the chain entry dropped when the input also has a chain; descriptor
      # alone allowed on a changed entry; every other row identical and
      # unflagged. Names are read from the parts file and never printed.
      entries_ruled() {
        awk -F'\t' -v id="$1" -v parts="$2" -v moved="$3" -v same="$4" '
          BEGIN {
            getline w < parts; getline wb < parts; getline wbr < parts; getline chain < parts
            want[w] = (same == "yes") ? "recompressed" : "changed"
            if (moved > 0) want[wb] = "changed"
            if (moved > 0 && chain != "") { want[wbr] = "changed"; want["[Content_Types].xml"] = "changed"; want[chain] = "dropped" }
          }
          NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next }
          $k["id"] != id { next }
          { n++; name = $k["name"]; status = $k["status"]; flags = $k["flags"]
            if (name in want) {
              seen[name] = 1
              if (status != want[name]) bad++
              if (flags != "" && flags != "descriptor") bad++
            } else if (status != "identical" || flags != "") bad++ }
          END { for (x in want) if (!(x in seen)) bad++; exit (n == 0 || bad > 0) }' "$ENT"
      }
      echo "  per workbook: id, the tool's line, the comparison's line (counts and yes/no only)"
      : >"$B/$OP-lines-$label"
      nwb=0; nflags=0; nagree=0; nline=0; nentries=0; t_moved=0; t_chain=0
      : >"$B/$OP-moved-ids"
      while IFS="$TAB" read -r id ext; do
        nwb=$((nwb + 1))
        if LC_ALL=C "$G" -qFx "$id" "$B/$OP-refused"; then
          printf '    %s refused as predicted\n' "$id"
          continue
        fi
        e=$(cat "$OUT/$id/stdout.$label.txt")
        c=$(python3 "$B/shiftcmp.py" "$CMP_OP" "$CORPUS/corpus/$id.$ext" "$OUT/$id/out.$label.$ext")
        python3 "$B/shiftcmp.py" "$CMP_OP" "$CORPUS/corpus/$id.$ext" --parts >"$B/$OP-parts-$id"
        printf '%s\t%s\n' "$id" "$e" >>"$B/$OP-lines-$label"
        printf '    %s %s\n' "$id" "$(printf '%s' "$e" | tr '\t' ' ')"
        printf '    %s cmp %s\n' "$id" "$(printf '%s' "$c" | tr '\t' ' ')"
        if all_yes "$c"; then nflags=$((nflags + 1)); else echo "    $id: a flag of the comparison does not hold"; fi
        if tool_and_cmp "$e" "$c"; then nagree=$((nagree + 1)); else echo "    $id: the tool and the comparison disagree"; fi
        if line_as_spec "$e" "$OP"; then nline=$((nline + 1)); else echo "    $id: the tool's line is not what the edits imply"; fi
        same=no; if LC_ALL=C "$G" -qFx "$id" "$B/$OP-unchanged"; then same=yes; fi
        printf '%s\t%s\n' "$id" "$(kv "$c" formulas_moved)" >>"$B/$OP-moved-ids"
        if entries_ruled "$id" "$B/$OP-parts-$id" "$(kv "$c" formulas_moved)" "$same"; then nentries=$((nentries + 1)); else echo "    $id: the entry rows are not ruling 11's"; fi
        if [ "$(kv "$c" formulas_moved)" -gt 0 ]; then t_moved=$((t_moved + 1)); fi
        if [ "$(kv "$c" formulas_moved)" -gt 0 ] && [ "$(kv "$c" chain_in)" = 1 ]; then t_chain=$((t_chain + 1)); fi
      done < <(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv")
      NOK=$((manifest_rows - NREF))
      echo "  workbooks: $nwb, of them compared (not refused): $NOK; every flag holds: $nflags; the tool and the comparison agree: $nagree; the line as the spec reads: $nline; entry rows as ruling 11 gives: $nentries"
      echo "  workbooks with a formula at or after the point: $t_moved; of them with a chain: $t_chain"
      check "$label: every flag of the comparison holds in every compared workbook" "$(yn [ "$nflags" = "$NOK" ])"
      check "$label: the tool and the comparison agree in every compared workbook" "$(yn [ "$nagree" = "$NOK" ])"
      check "$label: every line is what the edits imply" "$(yn [ "$nline" = "$NOK" ])"
      check "$label: every compared workbook's entry rows are as ruling 11 gives" "$(yn [ "$nentries" = "$NOK" ])"
      echo "$t_moved $t_chain" >"$B/$OP-moved-$label"
      R=$OUT/run.$label.tsv
      args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$R")
      bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
      check "$label: the run row records $EDIT, the two release binaries by sha256 and the phase commit" "$(yn bins_in_row)"
      [ "$args" = "$EDIT" ] || { echo "  $label: tool_args [$args]"; fail=1; }
    done
    entries_ctl() {
      local id
      id=$(awk -F'\t' 'NR == 1 { print $1; exit }' "$B/$OP-lines-host")
      local ENT=$OUT/entries.host.tsv
      printf 'no/such/part.xml\n\n\n\n' >"$B/c-parts"
      if entries_ruled "$id" "$B/c-parts" 0 no; then return 1; else return 0; fi
    }
    entries_same_ctl() {
      local id moved
      id=$(awk -F'\t' 'NR == 1 { print $1; exit }' "$B/$OP-lines-host")
      moved=$(awk -F'\t' -v i="$id" '$1 == i { print $2; exit }' "$B/$OP-moved-ids")
      local ENT=$OUT/entries.host.tsv
      if LC_ALL=C "$G" -qFx "$id" "$B/$OP-unchanged"; then return 1; fi
      if entries_ruled "$id" "$B/$OP-parts-$id" "$moved" yes; then return 1; else return 0; fi
    }
    check "control: entries_ruled refuses the first workbook's rows (W changed) when told W is unchanged" "$(yn entries_same_ctl)"
    check "control: entries_ruled refuses the first workbook's rows against a part it does not change" "$(yn entries_ctl)"
    check "both labels saw the same formula counts" "$(yn cmp -s "$B/$OP-moved-host" "$B/$OP-moved-i686")"
    read -r MOVED_WB CHAIN_WB <"$B/$OP-moved-host"
    
    echo
    echo "### the planted-flag controls, host, each on the first workbook in manifest order where it applies"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv" >"$B/order"
    nbit=0
    nplants=0
    for f in $FLAGS; do
      nplants=$((nplants + 1))
      flag=$f
      where=none; planted=""
      while IFS="$TAB" read -r id ext; do
        if LC_ALL=C "$G" -qFx "$id" "$B/$OP-refused"; then continue; fi
        planted=$(python3 "$B/shiftcmp.py" "$CMP_OP" "$CORPUS/corpus/$id.$ext" "$OUT/$id/out.host.$ext" --plant "$f")
        if [ "$(kv "$planted" planted)" = yes ]; then where=$id; break; fi
      done <"$B/order"
      turned() { [ "$where" != none ] && [ "$(kv "$planted" "$flag")" = no ] && [ "$(kv "$planted" planted)" = yes ]; }
      echo "  plant $f: applied on $where; $flag=$(kv "$planted" "$flag")"
      if turned; then nbit=$((nbit + 1)); fi
      check "control: the plant $f applies on some workbook and turns $flag to no there" "$(yn turned)"
    done
    echo "  plants: $nplants; plants that turned their own flag: $nbit"
    unknown_plant() { [ "$(python3 "$B/shiftcmp.py" "$CMP_OP" "$CORPUS/corpus/$(head -n 1 "$B/order" | cut -f1).$(head -n 1 "$B/order" | cut -f2)" "$OUT/$(head -n 1 "$B/order" | cut -f1)/out.host.$(head -n 1 "$B/order" | cut -f2)" --plant no_such_flag)" = error=unknown-plant ]; }
    check "control: the comparison refuses a plant it does not know" "$(yn unknown_plant)"
    
    echo
    echo "### the two labels' outputs"
    same_out=0
    while IFS="$TAB" read -r id ext; do
      if LC_ALL=C "$G" -qFx "$id" "$B/$OP-refused"; then continue; fi
      if cmp -s "$OUT/$id/out.host.$ext" "$OUT/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
    done <"$B/order"
    echo "  workbooks whose host and i686 outputs are byte for byte the same: $same_out"
    check "every output is the same on both targets" "$(yn [ "$same_out" = "$((manifest_rows - NREF))" ])"
    check "both targets printed the same line for every workbook" "$(yn cmp -s "$B/$OP-lines-host" "$B/$OP-lines-i686")"
    
    echo
    echo "## the corpus record pair"
    echo "command: scripts/passthrough-record.py --run <corpus>/runs/$RUN --out <scratch>/p3/out/records --stem $STEM_RUN"
    scripts/passthrough-record.py --run "$OUT" --out "$RECORDS" --stem "$STEM_RUN" >"$B/$OP-record.out" 2>&1
    rrc=$?
    sed 's/^/    /' "$B/$OP-record.out"
    check "the record script exits 0" "$(yn [ "$rrc" = 0 ])"
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, tool_arg, moved, chained = sys.argv[1:8]
    # Ruling 11's families: the worksheet always; the workbook part when some
    # workbook moved a formula; its rels part and [Content_Types].xml changed
    # and the chain dropped when one of those also had a chain.
    want_changed = sorted(["worksheet"] + (["workbook"] if int(moved) else [])
                          + (["content-types", "rels"] if int(chained) else []))
    want_dropped = ["calcChain"] if int(chained) else []
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        checks.append(("%s: the xml families are the changed families ruling 11 gives" % label, sorted(xf) == want_changed))
        checks.append(("%s: the changed entries' families are those ruling 11 gives" % label,
                       sorted(f for f in fam if fam[f].get("changed")) == want_changed))
        checks.append(("%s: the dropped entries' families are those ruling 11 gives" % label,
                       sorted(f for f in fam if fam[f].get("dropped")) == want_dropped))
        checks.append(("%s: no entry is added" % label,
                       sorted(f for f in fam if fam[f].get("added")) == []))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: " + tool_arg in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    sed 's/^/    /' "$B/reccheck.py"
    RTXT=$RECORDS/$STEM_RUN.txt
    RMD=$RECORDS/$STEM_RUN.md
    python3 "$B/reccheck.py" scripts/passthrough-record.py "$OUT" "$RTXT" "$RMD" "$EDIT" "$MOVED_WB" "$CHAIN_WB" >"$B/$OP-reccheck.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/$OP-reccheck.out"
    rec_all() { [ "$(count_matches -E ': yes$' "$B/$OP-reccheck.out")" = 18 ] && [ "$(count_matches -E ': no$' "$B/$OP-reccheck.out")" = 0 ]; }
    check "the record's three tables are the run directory's, and its family tables are counted from them (eighteen checks)" "$(yn rec_all)"
    awk '!done && /^[|] total [|]/ { done = 1; next } { print }' "$RMD" >"$B/c-rec.md"
    python3 "$B/reccheck.py" scripts/passthrough-record.py "$OUT" "$RTXT" "$B/c-rec.md" "$EDIT" "$MOVED_WB" "$CHAIN_WB" >"$B/c-reccheck.out" 2>&1
    sed '2d' "$RTXT" >"$B/c-rec.txt"
    python3 "$B/reccheck.py" scripts/passthrough-record.py "$OUT" "$B/c-rec.txt" "$RMD" "$EDIT" "$MOVED_WB" "$CHAIN_WB" >"$B/c-reccheck2.out" 2>&1
    rec_ctl() { [ "$(count_matches -E ': no$' "$B/c-reccheck.out")" -ge 1 ] && [ "$(count_matches -F "the summary table is every label's summary: no" "$B/c-reccheck2.out")" = 1 ]; }
    check "control: the same check finds an .md with a family table's total row dropped and a .txt one summary row short" "$(yn rec_ctl)"
    rm -rf scripts/__pycache__
    echo "command: install -m 644 <scratch>/p3/out/records/$STEM_RUN.md <scratch>/p3/out/records/$STEM_RUN.txt <repo>/records/"
    install -m 644 "$RMD" "$RTXT" records/
    echo "  exit: $?"
    for f in "$STEM_RUN.md" "$STEM_RUN.txt"; do
      echo "    installed <repo>/records/$f: sha256 $(sha_of "records/$f"), $(wc -c <"records/$f") bytes, mode $(stat -c %a "records/$f")"
      inst_same() { cmp -s "$RECORDS/$1" "records/$1" && [ "$(stat -c %a "records/$1")" = 644 ]; }
      check "the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
    done
    }
    sample_block insert
    sample_block delete
    echo
    echo "## the keep regenerated: the tests with the variable set, one keep directory per target"
    echo "command: read the test.log given (sha256 $(sha_of "$TEST_LOG"), $(wc -c <"$TEST_LOG") bytes)"
    tl_is_phase() { [ "$(count_matches -E "^about: M2 part 3 P3 phase commit $C; HEAD at run: $C\$" "$TEST_LOG")" = 1 ]; }
    check "the test.log read is this phase's, at this phase commit" "$(yn tl_is_phase)"
    tl_ctl() { local C=$NULL_SHA; if tl_is_phase; then return 1; else return 0; fi; }
    check "control: the same check says no for the null commit" "$(yn tl_ctl)"
    tl_unset() { [ "$(count_matches -xF 'EMEND_KEEP_DIR set when this script started: no; unset for the whole log (header change 6): yes' "$TEST_LOG")" = 1 ]; }
    check "the test.log ran with the variable unset" "$(yn tl_unset)"
    tl_all_yes() { [ "$(count_matches -xF 'test log checks all as expected: yes' "$TEST_LOG")" = 1 ]; }
    check "the test.log ends all as expected" "$(yn tl_all_yes)"
    for target in host i686-unknown-linux-musl; do
      awk -v h="## cargo test --workspace ($target)" '
        $0 == h { on = 1; next }
        /^## / { on = 0 }
        on && /^    test .* \.\.\. ok$/ { sub(/^    test /, ""); sub(/ \.\.\. ok$/, ""); print }
      ' "$TEST_LOG" | sort >"$B/unset-$target.names"
      sed -n "s/^$target: passed \\([0-9]*\\); failed 0; ignored \\([0-9]*\\); test lines ending ok: [0-9]*\$/\\1 \\2/p" "$TEST_LOG" >"$B/unset-$target.count"
      echo "  $target without the variable: passed and ignored $(cat "$B/unset-$target.count"); names read $(count_lines "$B/unset-$target.names")"
      names_match_count() { [ -s "$B/unset-$target.count" ] && [ "$(count_lines "$B/unset-$target.names")" = "$(cut -d' ' -f1 "$B/unset-$target.count")" ]; }
      check "$target: the names read account for the passed count read" "$(yn names_match_count)"
    done
    mkdir "$KEEP" "$BUILD_ROOT/keep-i686.$$" || exit 2
    KI=$BUILD_ROOT/keep-i686.$$
    for target in host i686-unknown-linux-musl; do
      case $target in host) K=$KEEP; targs=() ;; *) K=$KI; targs=(--target "$target") ;; esac
      echo
      echo "### cargo test --workspace ($target), EMEND_KEEP_DIR=$K"
      echo "command: EMEND_KEEP_DIR=$K cargo test --workspace ${targs[*]}"
      EMEND_KEEP_DIR=$K cargo test --workspace "${targs[@]}" >"$B/$target.out" 2>&1 </dev/null
      rc=$?
      echo "  exit: $rc"
      check "$target: exit 0" "$(yn [ "$rc" -eq 0 ])"
      echo "  summary lines:"
      LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$B/$target.out" | sed 's/^ */    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$B/$target.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$B/set-$target.names"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      ignored=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^ignored;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      echo "  $target with the variable: passed $passed; failed $failed; ignored $ignored; test lines ending ok $(count_lines "$B/set-$target.names")"
      check "$target: failed is 0" "$(yn [ "$failed" = 0 ])"
      check "$target: passed and ignored are the run's without the variable ($(cat "$B/unset-$target.count"))" "$(yn [ "$passed $ignored" = "$(cat "$B/unset-$target.count")" ])"
      check "$target: the test names that passed are the run's without the variable" "$(yn cmp -s "$B/set-$target.names" "$B/unset-$target.names")"
      echo "  files in the keep: $(find "$K" -type f | wc -l); entries that are not regular files: $(find "$K" -mindepth 1 ! -type f | wc -l)"
    done
    { head -n 1 "$B/unset-host.names"; cat "$B/unset-host.names"; } | sort >"$B/c-names"
    cmp_ctl() { if cmp -s "$B/c-names" "$B/unset-host.names"; then return 1; else return 0; fi; }
    check "control: the same comparison tells a name list with one name doubled from the real one" "$(yn cmp_ctl)"
    
    echo
    echo "## the two keep directories compared"
    (cd "$KEEP" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/host.files"
    (cd "$KI" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/i686.files"
    nfiles=$(count_lines "$B/host.files")
    same=0
    while IFS= read -r f; do
      if cmp -s "$KEEP/$f" "$KI/$f"; then same=$((same + 1)); else echo "    differs: $f"; fi
    done <"$B/host.files"
    echo "  files: host $nfiles, i686 $(count_lines "$B/i686.files"); the same bytes on both: $same"
    check "the two keeps hold the same names" "$(yn cmp -s "$B/host.files" "$B/i686.files")"
    keeps_same() { [ "$nfiles" -ge 2 ] && [ "$same" = "$nfiles" ]; }
    check "every file in the host keep is byte for byte the i686 keep's" "$(yn keeps_same)"
    first_kept=$(head -n 1 "$B/host.files")
    cp "$KEEP/$first_kept" "$B/c-copy"
    printf 'x' >>"$B/c-copy"
    cmp_bytes_ctl() { if cmp -s "$B/c-copy" "$KI/$first_kept"; then return 1; else return 0; fi; }
    check "control: cmp tells a kept file with one byte added from its original" "$(yn cmp_bytes_ctl)"
    n_in=$(count_matches -E '\.in\.xlsx$' "$B/host.files")
    n_out=$(count_matches -E '\.out\.xlsx$' "$B/host.files")
    n_other=$(count_matches -vE '^[A-Za-z0-9_.-]+\.[0-9]+\.(in|out)\.xlsx$' "$B/host.files")
    LC_ALL=C sed -nE 's/^(.*)\.in\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.names"
    LC_ALL=C sed -nE 's/^(.*)\.out\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.out.names"
    echo "  .in.xlsx $n_in; .out.xlsx $n_out; names not of the form <test>.<n>.in|out.xlsx: $n_other"
    all_pairs() { [ "$n_in" = "$n_out" ] && [ "$((n_in * 2))" = "$nfiles" ] && [ "$n_other" = 0 ] && cmp -s "$B/pair.names" "$B/pair.out.names"; }
    check "the keep holds only whole pairs named <test>.<n>" "$(yn all_pairs)"
    NPAIRS=$n_in
    rm -rf "$KI"
    check "the i686 keep is removed after the comparison; the host keep stays for planning" "$(yn [ ! -e "$KI" ])"
    
    echo
    echo "## the host keep against P2's committed open-check record"
    PREV_TXT=$(git show --name-only --format= "$PREV_OPEN_REC" | LC_ALL=C "$G" -E '^records/m2p3-open-.*[.]txt$')
    echo "command: git show --name-only --format= <P2's record commit>, the open-check .txt it added; git show <phase commit>:<it>"
    echo "  P2's record: $PREV_TXT (sha256 $(git show "$C:$PREV_TXT" | sha256sum | cut -d' ' -f1))"
    check "P2's record commit added exactly one open-check .txt" "$(yn [ "$(printf '%s\n' "$PREV_TXT" | count_lines /dev/stdin)" = 1 ])"
    no_later_open() { [ -z "$(git log --format=%H "$PREV_OPEN_REC..$C" -- 'records/*-open-*.txt')" ]; }
    check "no commit after it adds an open-check record, so it is the last committed" "$(yn no_later_open)"
    git show "$C:$PREV_TXT" >"$B/prev.txt"
    while IFS= read -r t; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$t" "$(stat -c %s "$KEEP/$t.in.xlsx")" "$(sha_of "$KEEP/$t.in.xlsx")" \
        "$(stat -c %s "$KEEP/$t.out.xlsx")" "$(sha_of "$KEEP/$t.out.xlsx")"
    done <"$B/pair.names" >"$B/keep.rows"
    tail -n +2 "$B/prev.txt" | cut -f1-5 | LC_ALL=C sort >"$B/prev.rows"
    LC_ALL=C sort "$B/keep.rows" >"$B/keep.sorted"
    n_prev=$(count_lines "$B/prev.rows")
    n_kept_prev=$(LC_ALL=C comm -12 "$B/prev.rows" "$B/keep.sorted" | count_lines /dev/stdin)
    cut -f1 "$B/prev.rows" >"$B/prev.names"
    LC_ALL=C comm -13 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/gone.pairs"
    echo "  rows: the regenerated keep $(count_lines "$B/keep.rows"), P2's record $n_prev; its rows found in the keep with the same name, bytes and both sha256s: $n_kept_prev"
    echo "  pairs in the keep and not in P2's record: $(count_lines "$B/new.pairs"); in its record and not in the keep: $(count_lines "$B/gone.pairs")"
    sed 's/^/    new: /' "$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.rows" "$B/keep.sorted" | cut -f1 >"$B/changed.pairs"
    echo "  pairs of P2's record whose bytes differ in the keep: $(count_lines "$B/changed.pairs")"
    sed 's/^/    changed: /' "$B/changed.pairs"
    check "every pair of P2's record is in the keep, byte for byte (the code under those tests did not change what they write)" "$(yn [ "$n_kept_prev" = "$n_prev" ])"
    check "no pair of P2's record is gone" "$(yn [ "$(count_lines "$B/gone.pairs")" = 0 ])"
    echo "command: the #[test] functions this phase adds, from git diff <base> <phase commit> -- '*.rs', as test.log derives them"
    git diff -U0 "$REC" "$C" -- '*.rs' | awk '/^\+[ \t]*#\[test\]/ { t = 1; next } t && /^\+[ \t]*fn[ \t]/ { sub(/^\+[ \t]*fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next } { t = 0 }' | LC_ALL=C sort >"$B/added.tests"
    sed 's/^/    added test: /' "$B/added.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/new.pairs" | LC_ALL=C sort -u >"$B/new.tests"
    # Change H: no new pair is a pass (part 2 P3's attempt 2 form), the count
    # printed above.
    new_from_added() { [ "$(LC_ALL=C comm -23 "$B/new.tests" "$B/added.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "no new pair, or every new pair is kept by a test this phase adds" "$(yn new_from_added)"
    printf 'zzz_not_a_new_test\n' | LC_ALL=C sort -m - "$B/new.tests" >"$B/c-new.tests"
    new_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-new.tests" "$B/added.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a pair of a test the phase did not add" "$(yn new_ctl)"
    
    echo
    echo "## scripts/edit-open-check.sh on the host keep (specs/0018 \"Harness runs\": every phase's run log runs it over its keep)"
    mkdir "$B/tmp"
    echo "command: TMPDIR=<scratch>/w/tmp scripts/edit-open-check.sh --keep <keep> --libreoffice $IMAGE --out <scratch>/p3/out/records --stem $STEM_OPEN"
    TMPDIR=$B/tmp scripts/edit-open-check.sh --keep "$KEEP" --libreoffice "$IMAGE" --out "$RECORDS" --stem "$STEM_OPEN" \
      >"$B/oc.stdout" 2>"$B/oc.stderr" </dev/null
    oc_rc=$?
    echo "  exit: $oc_rc"
    echo "  stdout:"; sed 's/^/    /' "$B/oc.stdout"
    echo "  stderr bytes: $(wc -c <"$B/oc.stderr")"
    check "the script exits 0 (no finding, no check errored)" "$(yn [ "$oc_rc" = 0 ])"
    check "its stderr is empty" "$(yn [ ! -s "$B/oc.stderr" ])"
    echo "  the reasons the script kept (its reasons directory under <scratch>/w/tmp), one line per refused side:"
    find "$B/tmp" -name '*-reason.txt' | LC_ALL=C sort | while IFS= read -r f; do echo "    ${f#"$B/tmp/"}: $(cat "$f")"; done
    TXT=$RECORDS/$STEM_OPEN.txt
    MD=$RECORDS/$STEM_OPEN.md
    TXT_HEADER=$(git show "$C:scripts/edit-open-check.sh" | sed -n "s/^readonly TXT_HEADER=\\$'\\(.*\\)'\$/\\1/p" | sed 's/\\t/\t/g')
    check "the .txt's header is the script's TXT_HEADER, read from the phase commit (nine columns)" "$(yn [ "$(head -n 1 "$TXT")" = "$TXT_HEADER" ])"
    tail -n +2 "$TXT" | cut -f1-5 >"$B/txt.rows"
    nrow_same=$(paste -d'\n' "$B/keep.rows" "$B/txt.rows" | awk 'NR % 2 == 1 { a = $0; next } a == $0 { n++ } END { print n + 0 }')
    echo "  rows: the keep $(count_lines "$B/keep.rows"), the .txt $(count_lines "$B/txt.rows"); rows whose name, bytes and hashes are the keep's, compared row by row: $nrow_same"
    rows_same() { [ "$(count_lines "$B/keep.rows")" = "$(count_lines "$B/txt.rows")" ] && [ "$nrow_same" = "$(count_lines "$B/keep.rows")" ] && [ "$nrow_same" = "$NPAIRS" ]; }
    check "every .txt row is one kept pair's name, byte counts and sha256s, in name order, one row per pair" "$(yn rows_same)"
    bad_rows=$(tail -n +2 "$TXT" | awk -F'\t' 'NF != 9 || $6 !~ /^(ok|fail|error)$/ || $7 !~ /^(ok|fail|error)$/ || $8 !~ /^(none|refused|count|error)$/ || $9 !~ /^(none|refused|count|error)$/' | wc -l)
    check "every row has nine columns, lo_in and lo each ok, fail or error, and each class none, refused, count or error ($bad_rows rows otherwise)" "$(yn [ "$bad_rows" = 0 ])"
    bad_fit=$(tail -n +2 "$TXT" | awk -F'\t' '{ print $6 ":" $8; print $7 ":" $9 }' | LC_ALL=C "$G" -cvxE 'ok:none|fail:refused|fail:count|error:error')
    check "every side's class fits its verdict ($bad_fit sides otherwise)" "$(yn [ "$bad_fit" = 0 ])"
    stdout_rows() { [ "$(awk -F'\t' 'NF == 3' "$B/oc.stdout")" = "$(tail -n +2 "$TXT" | cut -f1,6,7)" ]; }
    check "the script's per-pair stdout lines are the .txt's test, lo_in and lo columns" "$(yn stdout_rows)"
    echo "command: python3 <scratch>/w/wb.py over each kept input: its xl/workbook.xml entry, its sheet elements by local name (expat, no pattern) and of them those with a prefix"
    cat >"$B/wb.py" <<'PY'
    import sys, zipfile
    from xml.parsers import expat
    for path in sys.argv[1:]:
        name = path.rsplit("/", 1)[1][: -len(".in.xlsx")]
        try:
            z = zipfile.ZipFile(path)
        except zipfile.BadZipFile:
            print("%s\tunreadable\t-\t-" % name)
            continue
        if "xl/workbook.xml" not in z.namelist():
            print("%s\tno\t-\t-" % name)
            continue
        found = {"all": 0, "prefixed": 0}
    
        def start(tag, attrs):
            prefix, _, local = tag.rpartition(":")
            if local == "sheet":
                found["all"] += 1
                found["prefixed"] += 1 if prefix else 0
        p = expat.ParserCreate()
        p.StartElementHandler = start
        try:
            p.Parse(z.read("xl/workbook.xml"), True)
        except expat.ExpatError:
            print("%s\tyes\tunparsed\t-" % name)
            continue
        print("%s\tyes\t%d\t%d" % (name, found["all"], found["prefixed"]))
    PY
    sed 's/^/    /' "$B/wb.py"
    python3 "$B/wb.py" $(sed "s#^#$KEEP/#; s#\$#.in.xlsx#" "$B/pair.names") | LC_ALL=C sort >"$B/wb.all"
    echo "  kept inputs by workbook entry and sheet elements (entry, all, prefixed: pairs):"
    cut -f2- "$B/wb.all" | sort | uniq -c | sed 's/^/    /'
    echo "  the .md checked against the .txt and the kept inputs, with the heading specs/0015 P2 verification ruling 1 gives: <scratch>/w/mdcheck.py, below"
    cat >"$B/mdcheck.py" <<'PY'
    import sys
    txt, md, wb = sys.argv[1:4]
    rows = [l.split("\t") for l in open(txt).read().split("\n")[1:] if l]
    sheets = {l.split("\t")[0]: l.split("\t")[2] for l in open(wb).read().split("\n") if l}
    text = open(md).read().split("\n")
    REFUSED = ("Inputs refused by LibreOffice (allowed: a fixture LibreOffice cannot load: zip-level,"
               " or a package with no relationships part or an empty content-types root)")
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line:
                out.append(line)
        return out
    
    
    def listed(names):
        return ["- `%s`" % n for n in names] if names else ["None."]
    
    
    def count(col, v):
        return sum(1 for r in rows if r[col] == v)
    
    
    totals = [len(rows)] + [count(5, v) for v in ("ok", "fail", "error")] + [count(6, v) for v in ("ok", "fail", "error")]
    classes = ["| %s | " % side + " | ".join(str(count(col, c)) for c in ("none", "refused", "count", "error")) + " |"
               for side, col in (("reason_in", 7), ("reason_out", 8))]
    tot = section("Totals")
    checks = [
        ("Totals", tot[2:3] == ["| " + " | ".join(str(t) for t in totals) + " |"] and tot[5:] == classes),
        ("the refused-inputs heading reads as ruled, once", text.count("## " + REFUSED) == 1),
        ("Inputs refused by LibreOffice", section(REFUSED) == listed([r[0] for r in rows if r[7] == "refused"])),
        ("the sheet count did not apply", section("Inputs the sheet count did not apply to (allowed: a workbook fixture with no sheet element)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) == "0"])),
        ("counts differ", section("Inputs whose sheet and table counts differ (a finding)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) != "0"])),
        ("Outputs refused on an accepted input", section("Outputs refused on an input LibreOffice accepted (a finding)") == listed([r[0] for r in rows if r[6] == "fail" and r[5] == "ok"])),
        ("Checks that did not run", section("Checks that did not run (error)") == listed([r[0] for r in rows if "error" in (r[5], r[6])])),
        ("Pairs", section("Pairs")[2:] == ["| `%s` | %s | %s | %s | %s | %s | %s | %s | %s |" % tuple(r) for r in rows]),
        ("the Pairs line", ("- Pairs: %d" % len(rows)) in text),
    ]
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("totals: pairs %d; lo_in ok %d fail %d error %d; lo ok %d fail %d error %d" % tuple(totals))
    PY
    sed 's/^/    /' "$B/mdcheck.py"
    python3 "$B/mdcheck.py" "$TXT" "$MD" "$B/wb.all" >"$B/mdcheck.out"
    sed 's/^/    /' "$B/mdcheck.out"
    md_all() { [ "$(count_matches -E ': yes$' "$B/mdcheck.out")" = 9 ] && [ "$(count_matches -E ': no$' "$B/mdcheck.out")" = 0 ]; }
    check "the .md's nine parts are derived from the .txt and the kept inputs' sheet elements, the heading as ruled" "$(yn md_all)"
    head -n 2 "$TXT" >"$B/c-short.txt"
    python3 "$B/mdcheck.py" "$B/c-short.txt" "$MD" "$B/wb.all" >"$B/c-mdcheck.out"
    md_ctl() { [ "$(count_matches -E ': no$' "$B/c-mdcheck.out")" -ge 1 ]; }
    check "control: the same check on a .txt cut to one row finds the .md does not match it" "$(yn md_ctl)"
    OLD8=records/m1p8-open-2026-09-24-da080f1
    python3 "$B/mdcheck.py" "$OLD8.txt" "$OLD8.md" "$B/wb.all" >"$B/c-prevmd.out"
    old_heading() { [ "$(count_matches -F 'the refused-inputs heading reads as ruled, once: no' "$B/c-prevmd.out")" = 1 ]; }
    check "control: the same check on part 8 P2's committed .md finds the old heading, not the ruled one" "$(yn old_heading)"
    totals_line() { [ "$(sed -n 's/^wrote .*\.txt: \(pairs [^;]*; lo_in [^;]*; lo [^;]*\); inputs refused .*/\1/p' "$B/oc.stdout")" = "$(sed -n 's/^totals: //p' "$B/mdcheck.out")" ]; }
    check "the script's totals line is the totals derived from the .txt" "$(yn totals_line)"
    echo
    echo "### the verdicts against P2's record"
    join -t "$TAB" <(tail -n +2 "$B/prev.txt" | cut -f1,6,7,8,9 | LC_ALL=C sort) <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) >"$B/both"
    check "every pair of P2's record has a row in this record" "$(yn [ "$(count_lines "$B/both")" = "$n_prev" ])"
    awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9 { print $1 "\t" $2 "/" $3 "/" $4 "/" $5 " -> " $6 "/" $7 "/" $8 "/" $9 }' "$B/both" >"$B/moved"
    echo "  P2's pairs whose lo_in, lo or either class changed: $(count_lines "$B/moved")"
    sed 's/^/    /' "$B/moved"
    check "no verdict and no class of P2's pairs moved" "$(yn [ "$(count_lines "$B/moved")" = 0 ])"
    printf 'x\tok\tok\tnone\tnone\tok\tfail\tnone\trefused\n' >"$B/c-both"
    moved_ctl() { [ "$(awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9' "$B/c-both" | wc -l)" = 1 ]; }
    check "control: the same form finds a planted row whose lo moved" "$(yn moved_ctl)"
    echo "  the new pairs' verdicts (test, lo_in, lo, reason_in, reason_out):"
    join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) | sed 's/^/    /'
    no_new_finding() { [ "$(join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7 | LC_ALL=C sort) | awk -F'\t' '$2 == "ok" && $3 != "ok"' | wc -l)" = 0 ]; }
    check "no new pair's output is refused on an accepted input" "$(yn no_new_finding)"
    echo
    echo "### acceptance, and the inputs LibreOffice did not accept"
    tail -n +2 "$TXT" | awk -F'\t' -v OFS='\t' '{ print ($1 ~ /^emend-copy\./ ? "tool" : "crate"), $1, $6, $7, $8, $9 }' >"$B/verdicts"
    for side in crate tool; do
      n=$(awk -F'\t' -v s="$side" '$1 == s' "$B/verdicts" | wc -l)
      nfind=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "ok" && $4 == "fail"' "$B/verdicts" | wc -l)
      nerr=$(awk -F'\t' -v s="$side" '$1 == s && ($3 == "error" || $4 == "error")' "$B/verdicts" | wc -l)
      nin=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "fail"' "$B/verdicts" | wc -l)
      echo "  $side: pairs $n; inputs refused $nin; outputs refused on an accepted input $nfind; checks that did not run $nerr"
      check "$side: no output refused on an accepted input" "$(yn [ "$nfind" = 0 ])"
      check "$side: no check errored" "$(yn [ "$nerr" = 0 ])"
    done
    awk -F'\t' '$5 == "count" { print $2 }' "$B/verdicts" >"$B/count.pairs"
    awk -F'\t' '$2 == "yes" && $3 == "0" { print $1 }' "$B/wb.all" >"$B/zero.pairs"
    echo "  count-class inputs $(count_lines "$B/count.pairs"); kept inputs with a workbook entry and no sheet element $(count_lines "$B/zero.pairs")"
    check "the count-class inputs are exactly the kept inputs with a workbook entry and no sheet element, so no count differs" "$(yn cmp -s "$B/count.pairs" "$B/zero.pairs")"
    echo "  the pairs whose input LibreOffice did not accept, with the class of the input's reason:"
    awk -F'\t' '$3 != "ok" { print $2 "\t" $5 }' "$B/verdicts" | sed 's/^/    /'
    echo
    echo "### the open-check record installed into records/"
    echo "command: install -m 644 <scratch>/p3/out/records/$STEM_OPEN.md <scratch>/p3/out/records/$STEM_OPEN.txt <repo>/records/"
    install -m 644 "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" records/
    echo "  exit: $?"
    installed_same() { cmp -s "$RECORDS/$1" "records/$1" && [ "$(stat -c %a "records/$1")" = 644 ]; }
    for f in "$STEM_OPEN.md" "$STEM_OPEN.txt"; do
      echo "    written <scratch>/p3/out/records/$f: sha256 $(sha_of "$RECORDS/$f"), $(wc -c <"$RECORDS/$f") bytes"
      echo "    installed <repo>/records/$f: sha256 $(sha_of "records/$f"), $(wc -c <"records/$f") bytes, mode $(stat -c %a "records/$f")"
      check "the installed $f is the written one, byte for byte, mode 644" "$(yn installed_same "$f")"
    done
    TXT=records/$STEM_OPEN.txt
    
    echo
    echo "## the three record pairs hold no path"
    no_path() {
      local f
      for f in records/$STEM_OPEN.md records/$STEM_OPEN.txt records/$STEM_INSERT.md records/$STEM_INSERT.txt records/$STEM_DELETE.md records/$STEM_DELETE.txt; do
        [ "$(count_matches -F "$HOME" "$f")" = 0 ] || return 1
        [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$f")" = 0 ] || return 1
      done
    }
    check "no record file names <home>, a home, mount, temporary or corpus path" "$(yn no_path)"
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x' >"$B/c-path"
    path_ctl() { [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$B/c-path")" = 1 ]; }
    check "control: the same form finds a planted path" "$(yn path_ctl)"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  planning's uncommitted spec: $SPEC, sha256 $(sha_of "$SPEC")"
    echo "status lines: $st_all; of them this phase's logs, its record pairs or planning's uncommitted spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scratch>/p3/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"
    
    
    

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

