    #!/usr/bin/env bash
    # Milestone 2 part 3 P3 size.log (specs/0018-rows-and-columns.md, "Size" and
    # "P3", with decision 7 A): probe-emend-fullstyles-write-xml and
    # probe-zip-xml built in the size profile for i686-unknown-linux-musl at the
    # phase commit with the Cargo feature rowcol OFF, and at P2's phase commit
    # a4b55f0 as the control that the profile and toolchain reproduce P2's
    # size.log byte for byte. Printed: each probe's file size, section total,
    # .text and sha256; the evidence that the probe crate's build of emend
    # carries no rowcol feature; the budget figure (the first probe over the
    # second) at the phase commit, beside P1's 430372 and P2's 457044 as P2's
    # committed size.log prints them (read from it by a printed command); the
    # whole core growth since 1fc8327 (part 2's figure, read from the same log);
    # the headroom to the Milestone 2 ceiling of 458752. No record file (P3).
    # The comparison with P1's figure is a figure for planning, not a check of
    # this log: "the shift's cost gone from the core is the expectation, stated
    # as a comparison, not a check that fails".
    #
    # CARRIED TO M2 part 3 P3 from P2's size script (printed in
    # records/logs/m2p3-p2/size.log; its changes A to C are there), grepped for
    # P2's names, subjects, typed lists, hashes and the tokens p2 and P2 in
    # every form. What differs, and why:
    #  D. The phase is P3: the script's directory <scratch>/p3, the build
    #     directory <home>/.cache/emend-build/m2p3-p3-size; the phase commit is
    #     code commit 3 by its full subject ("M2 part 3 P3: emend-copy
    #     --insert-columns-sample and --delete-columns-sample").
    #  E. Two commits, not three: the phase commit (the measurement "P3" asks
    #     for) and P2's phase commit a4b55f0 (the control: its two hash lines
    #     and section totals equal P2's size.log's, as change C checked
    #     1fc8327 against part 2's log). 1fc8327 and b8595ce are not rebuilt:
    #     their figures are read from P2's committed size.log, which planning's
    #     own rebuild reproduced (P2 verification).
    #  F. The feature evidence: cargo tree -e features -i emend over size-probe
    #     with the probe's own feature set, in the phase commit's worktree,
    #     counted for the feature rowcol (0 expected); the control is the same
    #     command over emend-copy, which turns the feature on (1 or more).
    #  G. The figures read from P2's size.log (sha256 printed): the three
    #     budget lines at 1fc8327, b8595ce and a4b55f0, each parsed from the
    #     line the log prints; the comparison beside them; no checkpoint (the
    #     40000 checkpoint was P2's and tripped).
    #  H. specs/0017 close-out ruling 4's size-rerun rule (a size log rerun
    #     after the run log prints that its hash lines equal those of the
    #     attempt the run log cites) does not bite in P3: the run log builds
    #     its own release binaries of emend-copy and xlsx-diff, as P2's did, and
    #     cites no hash of this log. It applies at P4, whose corpus run uses the
    #     release binaries the size log hashed. Should this log be rerun after
    #     run.log, the rerun header names its predecessor by hash as usual.
    #  I. The status block allows records/logs/m2p3-p3, records/m2p3-p3-insert-,
    #     records/m2p3-p3-delete-, records/m2p3-open- and planning's
    #     uncommitted specs/0018 (P3 rulings, sha256 printed).
    #
    # Usage: m2p3-p3-size.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/m2p3-p3/size.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error,
    # kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/size.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    BUILD_ROOT=$HOME/.cache/emend-build/m2p3-p3-size
    I686=i686-unknown-linux-musl
    P2_LOG=records/logs/m2p3-p2/size.log
    CEILING=458752
    T=$(mktemp -d)
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    section() {
      local out
      out=$(size -A "$1" 2>/dev/null) || { printf 'error'; return; }
      printf '%s\n' "$out" | awk -v s="$2" '$1 == s { print $2; found = 1 } END { if (!found) print "error" }'
    }
    HEAD_SHA=$(git rev-parse HEAD)
    NULL_SHA=0000000000000000000000000000000000000000
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    not_head() { if is_head "$1"; then return 1; else return 0; fi; }
    if is_head "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    if [ -e "$BUILD_ROOT" ]; then echo "$BUILD_ROOT is already there; move it aside first" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    OURS='^((\?\?| ?[MARCD]) records/logs/m2p3-p3|(\?\?| ?[MARCD]) records/m2p3-(p3-insert|p3-delete|open)-| M specs/0018-rows-and-columns[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else echo "the working tree holds changes outside this phase's records and planning's spec" >&2; exit 2; fi
    cleanup() {
      local w
      for w in "$BUILD_ROOT"/tree-*; do
        [ -d "$w" ] && git worktree remove --force "$w" >/dev/null 2>&1
      done
      rm -rf "$T"
    }
    trap cleanup EXIT INT TERM HUP
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scratch>/p3#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$T#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scratch>/p3/$(basename "$0") $*"
    echo "about: M2 part 3 P3 phase commit $C; HEAD at run: $HEAD_SHA"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$T/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$T/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    echo
    echo "## the commits, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    CODE3=$(by_subject 'M2 part 3 P3: emend-copy --insert-columns-sample and --delete-columns-sample')
    P2C=$(by_subject 'M2 part 3 P2: emend-copy --insert-rows-sample and --delete-rows-sample')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  code commit 3, the phase commit: ${CODE3:-none}"
    echo "  P2's phase commit, the control build (change E): ${P2C:-none}"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn is_head "$C")"
    check "the phase commit is code commit 3, by its subject" "$(yn [ "$CODE3" = "$C" ])"
    check "control: the same comparison refuses the null commit" "$(yn not_head "$NULL_SHA")"
    p2_is() { [ -n "$P2C" ] && [ "$(git rev-parse --short=7 "$P2C")" = a4b55f0 ]; }
    check "P2's phase commit is a4b55f0, the commit P2's size.log names" "$(yn p2_is)"
    echo "phase: Milestone 2 part 3 P3 (specs/0018-rows-and-columns.md) size.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "planning's uncommitted spec: specs/0018-rows-and-columns.md, sha256 $(sha256sum <specs/0018-rows-and-columns.md | cut -d' ' -f1)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; each build used its own target directory under <build>"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to (inside <home>, so scrubbed first); scripts/counting.sh is sourced from it, and P2's size log is read from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scratch>/p3 stands for this script's own directory, which holds the script and, in <scratch>/p3/out, its own standard error"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory, removed at exit"
    echo "root: <build> stands for <home>/.cache/emend-build/m2p3-p3-size on the disk: <build>/tree-<short sha> a detached worktree of each commit, removed at exit, and <build>/target-<short sha> its target directory, kept"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$T" "$SELF_DIR" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$T" "$BUILD_ROOT" && apart "$MAIN" "$BUILD_ROOT" && apart "$MAIN" "$T" && apart "$MAIN" "$SELF_DIR"; }
    check "the roots other than <home> are distinct, none inside another" "$(yn roots_distinct)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## toolchain"
    rustc --version
    cargo --version
    echo "command: size --version"
    size --version | head -1 | sed 's/^/    /'
    
    echo
    echo "## the two probes at two commits (changes E and F)"
    declare -A SECT FILE TEXT SHA
    has_rowcol() { count_matches -F 'feature "rowcol"' "$1"; }
    build_at() {
      # build_at <commit>: both probes in the size profile, in a worktree of it.
      local c=$1 short tree target b feat rc
      short=$(git rev-parse --short=7 "$c")
      tree=$BUILD_ROOT/tree-$short
      target=$BUILD_ROOT/target-$short
      echo "command: git worktree add --detach <build>/tree-$short $short"
      git worktree add --detach "$tree" "$c" >/dev/null 2>&1
      echo "  worktree at: $(git -C "$tree" rev-parse HEAD)"
      if [ "$c" = "$C" ]; then
        # Change F: the probe's own feature set carries no rowcol; emend-copy's does.
        echo "command: (cd <build>/tree-$short && cargo tree -p size-probe --features emend,xml -e features -i emend --charset ascii --target $I686 --offline)"
        (cd "$tree" && CARGO_TARGET_DIR=$target cargo tree -p size-probe --features emend,xml -e features -i emend --charset ascii --target "$I686" --offline) >"$T/tree-probe" 2>&1 </dev/null
        sed 's/^/    /' "$T/tree-probe"
        echo "command: (cd <build>/tree-$short && cargo tree -p emend-copy -e features -i emend --charset ascii --target $I686 --offline)"
        (cd "$tree" && CARGO_TARGET_DIR=$target cargo tree -p emend-copy -e features -i emend --charset ascii --target "$I686" --offline) >"$T/tree-copy" 2>&1 </dev/null
        sed 's/^/    /' "$T/tree-copy"
        n_probe=$(has_rowcol "$T/tree-probe")
        n_copy=$(has_rowcol "$T/tree-copy")
        n_probe_emend=$(count_matches -E '^emend v' "$T/tree-probe")
        echo "  lines naming feature \"rowcol\": in size-probe's tree $n_probe; in emend-copy's tree $n_copy; size-probe's tree roots at emend: $n_probe_emend"
        check "the probe crate's build of emend carries no rowcol feature" "$(yn [ "$n_probe" = 0 ])"
        check "the probe tree was read: it names emend" "$(yn [ "$n_probe_emend" -ge 1 ])"
        check "control: the same count finds the feature in emend-copy's tree" "$(yn [ "$n_copy" -ge 1 ])"
      fi
      for b in probe-zip-xml probe-emend-fullstyles-write-xml; do
        case $b in probe-zip-xml) feat=xml ;; *) feat=emend,xml ;; esac
        echo "command: (cd <build>/tree-$short && CARGO_TARGET_DIR=<build>/target-$short cargo build -p size-probe --bin $b --features $feat --profile size --target $I686 --offline)"
        (cd "$tree" && CARGO_TARGET_DIR=$target cargo build -p size-probe --bin "$b" --features "$feat" --profile size --target "$I686" --offline) >"$T/b-$short-$b" 2>&1 </dev/null
        rc=$?
        echo "  exit: $rc; build output lines $(count_lines "$T/b-$short-$b"), of them warnings or errors $(count_matches -E '^(warning|error)' "$T/b-$short-$b")"
        built_clean() { [ "$rc" = 0 ] && [ "$(count_matches -E '^(warning|error)' "$T/b-$short-$b")" = 0 ]; }
        check "$b at $short: built, no warning or error line" "$(yn built_clean)"
        local f=$target/$I686/size/$b
        FILE[$short.$b]=$(stat -c %s "$f")
        SECT[$short.$b]=$(section "$f" Total)
        TEXT[$short.$b]=$(section "$f" .text)
        SHA[$short.$b]=$(sha256sum <"$f" | cut -d' ' -f1)
        echo "<build>/target-$short/$I686/size/$b: file ${FILE[$short.$b]} bytes; sections ${SECT[$short.$b]}; .text ${TEXT[$short.$b]}; sha256 ${SHA[$short.$b]}"
      done
      git worktree remove --force "$tree" >/dev/null 2>&1
    }
    for c in "$P2C" "$C"; do build_at "$c"; done
    SP=$(git rev-parse --short=7 "$P2C"); SC=$(git rev-parse --short=7 "$C")
    
    echo
    echo "## the a4b55f0 build against P2's size.log (change E)"
    echo "command: grep each probe's hash line at a4b55f0 in $P2_LOG (sha256 $(sha256sum <"$P2_LOG" | cut -d' ' -f1))"
    for b in probe-zip-xml probe-emend-fullstyles-write-xml; do
      line=$(LC_ALL=C "$G" -E "target-a4b55f0/$I686/size/$b: file [0-9]+ bytes; sections [0-9]+; " "$P2_LOG" | head -1)
      prev_sha=$(printf '%s' "$line" | sed -n 's/.*sha256 \([0-9a-f]\{64\}\)$/\1/p')
      prev_sect=$(printf '%s' "$line" | sed -n 's/.*; sections \([0-9]*\);.*/\1/p')
      echo "  $b: P2's log sha256 $prev_sha, sections $prev_sect; this build ${SHA[$SP.$b]}, ${SECT[$SP.$b]}"
      reproduced() { [ -n "$prev_sha" ] && [ "$prev_sha" = "${SHA[$SP.$b]}" ] && [ "$prev_sect" = "${SECT[$SP.$b]}" ]; }
      check "$b at a4b55f0 reproduces P2's log, byte for byte" "$(yn reproduced)"
      wrong_hash() { local prev_sha="${prev_sha}0"; if reproduced; then return 1; else return 0; fi; }
      check "control: the same comparison refuses the log's hash with a character appended" "$(yn wrong_hash)"
    done
    
    echo
    echo "## the figures P2's size.log prints, read from it (change G)"
    budget_line() {
      # budget_line <short sha>: the budget figure P2's log prints for that commit.
      LC_ALL=C "$G" -E "^    at $1 \\([^)]*\\): +[0-9]+ - [0-9]+ = [0-9]+$" "$P2_LOG" | head -1 | sed -n 's/.* = \([0-9]*\)$/\1/p'
    }
    echo "command: grep -E '^    at <short sha> (<phase>): <a> - <b> = <budget>' $P2_LOG, for 1fc8327, b8595ce and a4b55f0"
    LC_ALL=C "$G" -E '^    at [0-9a-f]{7} \([^)]*\): +[0-9]+ - [0-9]+ = [0-9]+$' "$P2_LOG" | sed 's/^/  /'
    B_PART2=$(budget_line 1fc8327)
    B_P1=$(budget_line b8595ce)
    B_P2=$(budget_line a4b55f0)
    echo "  read: part 2 (1fc8327) ${B_PART2:-none}; P1 (b8595ce) ${B_P1:-none}; P2 (a4b55f0) ${B_P2:-none}"
    figures_there() { [ -n "$B_PART2" ] && [ -n "$B_P1" ] && [ -n "$B_P2" ]; }
    check "the three budget figures were read from P2's log" "$(yn figures_there)"
    p1_figure() { [ "$B_P1" = 430372 ]; }
    check "P1's figure as the log prints it is the 430372 \"P3\" names" "$(yn p1_figure)"
    p2_again() { [ "$B_P2" = "$((SECT[$SP.probe-emend-fullstyles-write-xml] - SECT[$SP.probe-zip-xml]))" ]; }
    check "P2's figure as the log prints it is this run's a4b55f0 build's" "$(yn p2_again)"
    no_such_line() { [ -z "$(budget_line 0000000)" ]; }
    check "control: the same read finds nothing for a commit the log does not name" "$(yn no_such_line)"
    
    echo
    echo "## the figures specs/0018 \"P3\" asks for"
    budget=$((SECT[$SC.probe-emend-fullstyles-write-xml] - SECT[$SC.probe-zip-xml]))
    echo "  the budget figure at the phase commit, probe-emend-fullstyles-write-xml over probe-zip-xml, rowcol off, in section bytes:"
    echo "    at $SC (P3): ${SECT[$SC.probe-emend-fullstyles-write-xml]} - ${SECT[$SC.probe-zip-xml]} = $budget"
    echo "  beside it (from P2's size.log): P1 (b8595ce) $B_P1; P2 (a4b55f0) $B_P2; part 2 (1fc8327) $B_PART2"
    echo "  THE COMPARISON (a figure, not a check): the phase commit's budget figure less P1's: $((budget - B_P1)); less P2's: $((budget - B_P2))"
    echo "  probe-zip-xml's drift a4b55f0 to $SC: $((SECT[$SC.probe-zip-xml] - SECT[$SP.probe-zip-xml]))"
    echo "  the whole core growth since 1fc8327 at the phase commit: $((budget - B_PART2))"
    if [ "$budget" -le "$CEILING" ]; then
      echo "  THE CEILING: the budget figure $budget is $((CEILING - budget)) under the Milestone 2 ceiling of $CEILING (judged at P4's record on the core probe, not here)"
    else
      echo "  THE CEILING: the budget figure $budget is $((budget - CEILING)) over the Milestone 2 ceiling of $CEILING (judged at P4's record on the core probe, not here)"
    fi
    echo "  file sizes, for the record: probe-emend-fullstyles-write-xml ${FILE[$SP.probe-emend-fullstyles-write-xml]} at $SP, ${FILE[$SC.probe-emend-fullstyles-write-xml]} at $SC; probe-zip-xml ${FILE[$SP.probe-zip-xml]} at $SP, ${FILE[$SC.probe-zip-xml]} at $SC"
    figures_read() {
      local k
      for k in "${!SECT[@]}"; do [ "${SECT[$k]}" != error ] || return 1; done
      [ "${#SECT[@]}" = 4 ]
    }
    check "all four section totals were read" "$(yn figures_read)"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  planning's uncommitted spec: specs/0018-rows-and-columns.md, sha256 $(sha256sum <specs/0018-rows-and-columns.md | cut -d' ' -f1)"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    worktrees_gone() { [ "$(git worktree list --porcelain | count_matches -F "$BUILD_ROOT/tree-" /dev/stdin)" = 0 ]; }
    check "the two worktrees are gone from git's list" "$(yn worktrees_gone)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$T/c-err"; printf 'x' >>"$T/c-err"
    nerr_ctl=$(wc -c <"$T/c-err")
    echo "  command: wc -c <scratch>/p3/out/size.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "size log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

