### this log's generator, from the phase commit's template files
    """Fictional packages for M2 part 3 P4's negative log: the phase commit's
    template files, zipped in the template's order, the worksheet's
    `<sheetData/>` replaced as each case needs, and for the table cases a table
    part and the worksheet's relationships part naming it.
    Usage: gen-p4.py <template dir> <out dir>."""
    import os
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    MAIN = b"http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    RELS = (b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            b'<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
            b'<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/'
            b'relationships/table" Target="../tables/table1.xml"/></Relationships>')
    src, out = sys.argv[1], sys.argv[2]
    sheet = open(os.path.join(src, "xl/worksheets/sheet1.xml"), "rb").read()
    assert sheet.count(b"<sheetData/>") == 1
    
    
    def body(new):
        return sheet.replace(b"<sheetData/>", new)
    
    
    def rows(data):
        return body(b"<sheetData>" + data + b"</sheetData>")
    
    
    def table(ref):
        return (b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><table xmlns="' + MAIN
                + b'" id="1" name="T1" displayName="T1" ref="' + ref + b'"/>')
    
    
    VIEW = b'<sheetView workbookViewId="0"/>'
    MERGE = b'<sheetData/><mergeCells count="1"><mergeCell ref="%s"/></mergeCells>'
    SHARED = b'<row r="1"><c r="A1"><f t="shared" ref="%s" si="0">B1</f><v>1</v></c></row>'
    CASES = {
        "f0": (sheet, None),
        "f1": (body(b'<cols><col min="1" max="3" width="9"/><col min="3" max="4" width="9"/></cols><sheetData/>'), None),
        "f2": (body(b'<sheetData/><mergeCells count="1"><mergeCell ref="C1:D1"/></mergeCells>'
                    b'<mergeCells count="1"><mergeCell ref="C3:D3"/></mergeCells>'), None),
        "f3": (body(b"<sheetViews>" + VIEW + b"</sheetViews><sheetViews>" + VIEW + b"</sheetViews><sheetData/>"), None),
        "f4": (body(b"<sheetViews></sheetViews><sheetData/>"), None),
        "f5": (body(b"<sheetViews>" + VIEW + b"</sheetViews><sheetData/>"), None),
        "f6": (body(MERGE % b"A1:B1"), None),
        "f7": (body(MERGE % b"C3:D3"), None),
        "f8": (rows(b'<row r="1048576"><c r="A1048576"><v>1</v></c></row>'), None),
        "f9": (rows(b'<row r="1048575"><c r="A1048575"><v>1</v></c></row>'), None),
        "r0": (sheet, table(b"A1:B3")),
        "r1": (sheet, table(b"A1:")),
        "r2": (rows(SHARED % b"A1:C1"), None),
        "r3": (rows(SHARED % b"A1:A3"), None),
        "r4": (rows(b'<row r="1048574"><c r="A1048574"><v>1</v></c></row>'), None),
        "r5": (rows(b'<row r="1048576"><c r="A1048576"><v>1</v></c></row>'), None),
        "r6": (body(b'<dimension ref="A1:B2"/><sheetData/>'), None),
        "r7": (body(b'<dimension ref="A1:"/><sheetData/>'), None),
        "c0": (sheet, table(b"A1:B3")),
        "c1": (sheet, table(b"A1:")),
        "c2": (rows(SHARED % b"A1:A3"), None),
        "c3": (rows(SHARED % b"A1:C1"), None),
        "c4": (rows(b'<row r="1"><c r="XFC1"><v>1</v></c></row>'), None),
        "c5": (rows(b'<row r="1"><c r="XFD1"><v>1</v></c></row>'), None),
    }
    for case, (sh, tb) in CASES.items():
        with zipfile.ZipFile(os.path.join(out, case + ".xlsx"), "w") as z:
            for name in ORDER:
                data = sh if name == "xl/worksheets/sheet1.xml" else open(os.path.join(src, name), "rb").read()
                z.writestr(zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0)), data, zipfile.ZIP_DEFLATED)
            if tb is not None:
                z.writestr(zipfile.ZipInfo("xl/worksheets/_rels/sheet1.xml.rels", (1980, 1, 1, 0, 0, 0)),
                           RELS, zipfile.ZIP_DEFLATED)
                z.writestr(zipfile.ZipInfo("xl/tables/table1.xml", (1980, 1, 1, 0, 0, 0)), tb,
                           zipfile.ZIP_DEFLATED)
        print("%s %d table:%d col:%d mergeCells:%d sheetViews:%d sheetView:%d shared:%d rows:%d dimension:%d" % (
            case + ".xlsx", os.path.getsize(os.path.join(out, case + ".xlsx")), tb is not None,
            sh.count(b"<col "), sh.count(b"<mergeCells"), sh.count(b"<sheetViews>"), sh.count(b"<sheetView "),
            sh.count(b't="shared"'), sh.count(b"<row "), sh.count(b"<dimension")))
