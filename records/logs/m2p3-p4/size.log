    # probe-emend-formulas-write-xml, probe-emend-dates-write-xml,
    # probe-emend-sheets-write-xml, probe-emend-fullstyles-write-xml and
    # probe-emend-format-write-xml; probe-zip is built without it.
    xml = ["dep:quick-xml"]
    # Enables emend, for probe-emend-copy, probe-emend-edit,
    # probe-emend-edit-xml, probe-emend-package-xml, probe-emend-cells-xml,
    # probe-emend-cells-write-xml, probe-emend-styles-write-xml,
    # probe-emend-formulas-write-xml, probe-emend-dates-write-xml,
    # probe-emend-sheets-write-xml, probe-emend-fullstyles-write-xml and
