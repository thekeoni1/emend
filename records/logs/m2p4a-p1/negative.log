### this log's generator, from the phase commit's template files
    """Fictional packages for M2 part 4a P1's negative log: the phase commit's
    template files, zipped in the template's order, with each case's children
    inserted in the workbook part right after `</sheets>`.
    Usage: gen-p1.py <template dir> <out dir>."""
    import os
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    src, out = sys.argv[1], sys.argv[2]
    book = open(os.path.join(src, "xl/workbook.xml"), "rb").read()
    assert book.count(b"</sheets>") == 1
    
    
    def after(children):
        return book.replace(b"</sheets>", b"</sheets>" + children)
    
    
    def names(tag):
        return after(b"<definedNames>" + tag + b"1</definedName></definedNames>")
    
    
    CASES = {
        "n0": book,
        "n1": names(b'<definedName name="emend_global">'),
        "n2": names(b'<definedName name="EMEND_Global">'),
        "n3": names(b'<definedName name="emend_globalx">'),
        "n4": after(b"<definedNames/><definedNames/>"),
        "n5": after(b"<definedNames/>"),
        "n6": names(b'<definedName name="emend_global" localSheetId="0">'),
        "n7": names(b'<definedName name="a" q:x="1">'),
        "n8": names(b'<definedName name="a" xmlns:q="urn:q" q:x="1">'),
    }
    for case, wb in CASES.items():
        with zipfile.ZipFile(os.path.join(out, case + ".xlsx"), "w") as z:
            for name in ORDER:
                data = wb if name == "xl/workbook.xml" else open(os.path.join(src, name), "rb").read()
                z.writestr(zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0)), data, zipfile.ZIP_DEFLATED)
        print("%s %d definedNames:%d definedName:%d emend_global:%d case_variant:%d localSheetId:%d" % (
            case + ".xlsx", os.path.getsize(os.path.join(out, case + ".xlsx")), wb.count(b"<definedNames"),
            wb.count(b"<definedName "), wb.count(b'"emend_global"'), wb.count(b'"EMEND_Global"'),
            wb.count(b"localSheetId")))
