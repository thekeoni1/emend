    #      attempt 2's run directory and keep.
    #
    # Usage: m2p4a-p1-run.sh <phase commit> <this phase's test.log> > <file>
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    TEST_LOG=${2:?this phase test.log required}
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    LO_TIMEOUT_S=600
    SPEC=specs/0019-names-links-properties-protection.md
    SPEC_SHA=${SPEC_SHA:-none given}
    EDIT=--names-sample
    # The logged run leaves RUN_BUILD_ROOT and RUN_KEEP unset; a dry run points
    # them elsewhere so it leaves no keep where the logged run refuses one.
    BUILD_ROOT=${RUN_BUILD_ROOT:-$HOME/.cache/emend-build/m2p4a-p1/run}
    KEEP=${RUN_KEEP:-$HOME/.cache/emend-build/m2p4a-p1/keep-host}
    I686=i686-unknown-linux-musl
    # Change AK: where the record pairs are installed.
    RECORDS_DEST=${RECORDS_DEST:-records}
    # Change I: a keep in place is another attempt's, moved below once the
    # header can list it; without SUPERSEDED_KEEP naming the attempt it is
    # refused.
    SUPERSEDED_KEEP=${SUPERSEDED_KEEP:-}
    case $SUPERSEDED_KEEP in '' | attempt-[1-9]) ;; *) echo "SUPERSEDED_KEEP is attempt-<n> or nothing" >&2; exit 2 ;; esac
    if [ -e "$KEEP" ] && [ -z "$SUPERSEDED_KEEP" ]; then echo "$KEEP is already there; name its attempt in SUPERSEDED_KEEP" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    RECORDS=$SELF_DIR/out/records
    B=$(mktemp -d)
    trap 'rm -rf "$B"' EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    SHORT=$(git rev-parse --short=7 "$C")
    OURS='^((\?\?| ?[MARCD]) records/logs/m2p4a-p1|(\?\?| ?[MARCD]) records/m2p4a-(p1|open)-2[^ ]*-'"$SHORT"'[.](md|txt)$| M specs/0019-names-links-properties-protection[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's records and planning's spec" >&2
      exit 2
    fi
    DATE=$(date -u +%Y-%m-%d)
    STEM_OPEN=m2p4a-open-$DATE-$SHORT
    STEM_RUN=m2p4a-p1-$DATE-$SHORT
    # A rerun takes a suffix, so its run directory is never the superseded one.
    RUN_SUFFIX=${RUN_SUFFIX:-}
    case $RUN_SUFFIX in '' | -[b-z]) ;; *) echo "RUN_SUFFIX is -b to -z or nothing" >&2; exit 2 ;; esac
    RUN=$DATE-$SHORT$RUN_SUFFIX
    OUT=$CORPUS/runs/$RUN
    mkdir -p "$RECORDS" "$RECORDS_DEST" || exit 2
    # A rerun names the superseded run directory, which is MOVED into
    # <scripts>/out/superseded after the header prints it, never removed; it
    # must be another run of this phase, not this one.
    SUPERSEDED_RUN=${SUPERSEDED_RUN:-}
    case $SUPERSEDED_RUN in
      '' | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f] | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[b-z]) ;;
      *) echo "SUPERSEDED_RUN is not a run directory's name" >&2; exit 2 ;;
    esac
    if [ -n "$SUPERSEDED_RUN" ] && [ "$SUPERSEDED_RUN" = "$RUN" ]; then echo "SUPERSEDED_RUN names this run's own directory" >&2; exit 2; fi
    SUP_OUT=$CORPUS/runs/$SUPERSEDED_RUN
    SUP_TO=$SELF_DIR/out/superseded/run-$SUPERSEDED_RUN
    for f in "$OUT" "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt" \
             "$RECORDS/$STEM_RUN.md" "$RECORDS/$STEM_RUN.txt" "$RECORDS_DEST/$STEM_RUN.md" "$RECORDS_DEST/$STEM_RUN.txt"; do
      if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
    done
    # A run directory with a summary for either label before the runner starts
    # is another attempt's (memory: a same-day rerun reads the previous attempt's
    # files); refused here, before the runner, with the exact message.
    for sl in host i686; do
      if [ -e "$OUT/summary.$sl.tsv" ]; then echo "$OUT/summary.$sl.tsv is already there" >&2; exit 2; fi
    done
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$KEEP#<keep>#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$CORPUS#<corpus>#g" -e "s#$B#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M2 part 4a P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M2 part 3 close-out record:')
    CODE=$(by_subject 'M2 part 4a P1: emend-copy --names-sample')
    PREV_OPEN_REC=$(by_subject 'M2 part 3 P4 record:')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  part 3's close-out record commit (the base): ${REC:-none}"
    echo "  part 3 P4's record commit (the last to add an open-check record): ${PREV_OPEN_REC:-none}"
    echo "  the tool commit, the last code commit of the phase: ${CODE:-none}"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the tool commit, by its subject" "$(yn [ "$CODE" = "$C" ])"
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    check "control: not_head says no for HEAD itself, so it can fail" "$(yn [ "$(yn not_head "$C")" = no ])"
    echo "phase: Milestone 2 part 4a P1 (specs/0019-names-links-properties-protection.md) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    
    # Change AI: the two move checks as functions, run over planted inputs every
    # time below, and over a real moved keep or run directory when there is one.
    # keep_pairs_ok <listing>: the .in.xlsx lines times two equal the listing's
    # lines (P2 ruling 14 of specs/0018; the pattern in double quotes so the tab
    # is interpolated).
    keep_pairs_ok() {
      local pairs files
      pairs=$(count_matches -E "[.]in[.]xlsx${TAB}" "$1")
      files=$(count_lines "$1")
      [ "$files" -ge 2 ] && [ "$((pairs * 2))" = "$files" ]
    }
    # run_listing <dir> <listing>: the listing of a run directory, one line per
    # file, path and bytes (specs/0018 P2 verification ruling 4's form).
    run_listing() { (cd "$1" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$2"; }
    # run_listing_ok <dir> <listing>: the listing names each file once and at
    # least one.
    run_listing_ok() {
      local files lines uniq
      files=$(find "$1" -type f | wc -l)
      lines=$(count_lines "$2")
      uniq=$(cut -f1 "$2" | LC_ALL=C sort -u | count_lines /dev/stdin)
      [ "$files" -ge 1 ] && [ "$lines" = "$files" ] && [ "$uniq" = "$files" ]
    }
    
    if [ -n "$SUPERSEDED_RUN" ]; then
      echo "the superseded run directory, moved before this run: <corpus>/runs/$SUPERSEDED_RUN to <scripts>/out/superseded/run-$SUPERSEDED_RUN"
      if [ -d "$SUP_OUT" ]; then
        echo "command: sha256sum <corpus>/runs/$SUPERSEDED_RUN/summary.host.tsv and summary.i686.tsv; mv <corpus>/runs/$SUPERSEDED_RUN <scripts>/out/superseded/run-$SUPERSEDED_RUN"
        for sl in host i686; do
          if [ -f "$SUP_OUT/summary.$sl.tsv" ]; then echo "    summary.$sl.tsv sha256 $(sha_of "$SUP_OUT/summary.$sl.tsv")"; else echo "    summary.$sl.tsv: NO HASH EXISTS, the file is not there"; fi
        done
        run_listing "$SUP_OUT" "$B/superseded-run.listing"
        echo "command: (cd <corpus>/runs/$SUPERSEDED_RUN && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum"
        echo "    files $(find "$SUP_OUT" -type f | wc -l); listing lines $(count_lines "$B/superseded-run.listing"); listing sha256 $(sha_of "$B/superseded-run.listing")"
        check "the listing of $SUPERSEDED_RUN names each of its files once" "$(yn run_listing_ok "$SUP_OUT" "$B/superseded-run.listing")"
        mkdir -p "$SELF_DIR/out/superseded" && mv "$SUP_OUT" "$SUP_TO"
      fi
      sup_moved() { [ ! -e "$SUP_OUT" ] && [ -d "$SUP_TO" ]; }
      check "the superseded run directory is moved, not removed, before the run" "$(yn sup_moved)"
    fi
    if [ -n "$SUPERSEDED_KEEP" ]; then
      KEEP_TO=$SELF_DIR/out/superseded/keep-$SUPERSEDED_KEEP
      echo "the superseded keep (change I), moved before this run: <keep> to <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
      if [ -d "$KEEP" ]; then
        (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/superseded-keep.listing"
        echo "command: (cd <keep> && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum; the .in.xlsx files counted; mv <keep> <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
        echo "    pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/superseded-keep.listing"); files $(count_lines "$B/superseded-keep.listing"); listing sha256 $(sha_of "$B/superseded-keep.listing")"
        check "the moved keep's pairs times two equals its files" "$(yn keep_pairs_ok "$B/superseded-keep.listing")"
        if [ -e "$KEEP_TO" ]; then echo "    $KEEP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$KEEP" "$KEEP_TO"; fi
      else
        echo "    NO LISTING EXISTS: there is no keep in place to move"
      fi
      keep_moved() { [ ! -e "$KEEP" ] && [ -d "$KEEP_TO" ]; }
      check "the superseded keep is moved, not removed, before the run" "$(yn keep_moved)"
    fi
    echo "superseded run directory named: ${SUPERSEDED_RUN:-none}; superseded keep named: ${SUPERSEDED_KEEP:-none}"
    echo
    echo "## the two move checks over planted inputs, run every time (change AI)"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\n' "$TAB" "$TAB" >"$B/c-keep.listing"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\ny.1.out.xlsx%s1\n' "$TAB" "$TAB" "$TAB" >"$B/c-keep-odd.listing"
    echo "  planted keep listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep.listing"), files $(count_lines "$B/c-keep.listing"); with an unpaired output: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep-odd.listing"), files $(count_lines "$B/c-keep-odd.listing")"
    check "keep_pairs_ok passes a planted listing of one whole pair" "$(yn keep_pairs_ok "$B/c-keep.listing")"
    kp_ctl() { if keep_pairs_ok "$B/c-keep-odd.listing"; then return 1; else return 0; fi; }
    check "control: keep_pairs_ok refuses a planted listing with an unpaired output" "$(yn kp_ctl)"
    mkdir -p "$B/c-run/abc123" && printf 'a' >"$B/c-run/summary.host.tsv" && printf 'bb' >"$B/c-run/abc123/out.host.xlsx" && printf 'ccc' >"$B/c-run/abc123/stdout.host.txt"
    run_listing "$B/c-run" "$B/c-run.listing"
    echo "  planted run directory: files $(find "$B/c-run" -type f | wc -l); listing lines $(count_lines "$B/c-run.listing"); listing sha256 $(sha_of "$B/c-run.listing")"
    check "run_listing_ok passes the planted run directory's own listing" "$(yn run_listing_ok "$B/c-run" "$B/c-run.listing")"
    { cat "$B/c-run.listing"; head -n 1 "$B/c-run.listing"; } >"$B/c-run-dup.listing"
    rl_ctl() { if run_listing_ok "$B/c-run" "$B/c-run-dup.listing"; then return 1; else return 0; fi; }
    check "control: run_listing_ok refuses a listing that names one file twice" "$(yn rl_ctl)"
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory, <build>/target (CARGO_TARGET_DIR)"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the copy child and --lo-timeout $LO_TIMEOUT_S per conversion, the figures every corpus run of this milestone used; not tuned during the run."
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh is sourced from it by this log; scripts/passthrough-run.sh, scripts/passthrough-record.py and scripts/edit-open-check.sh are run from it, and the runner and the open check each source scripts/lo-check.sh, which is never run; the two record pairs are installed into its $RECORDS_DEST/; the test.log given is read from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scripts> stands for <home>/.cache/emend-build/m2p4a-p1/scripts on the disk, this script's own directory, which holds the script; the two record pairs are written into <scripts>/out/records first, a superseded run directory and a superseded keep are moved into <scripts>/out/superseded, and this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory (the comparison script and its outputs, derived tables, the planted listings and run directory, the i686 keep's listing), removed at exit"
    echo "root: <build> stands for <home>/.cache/emend-build/m2p4a-p1/run on the disk: <build>/target the builds (release binaries and tests), <build>/keep-i686.<pid> the i686 keep, removed after the comparison"
    echo "root: <keep> stands for <home>/.cache/emend-build/m2p4a-p1/keep-host on the disk, this phase's host keep; kept after the run for planning"
    echo "root: <corpus> stands for the private corpus directory (the manifest and the inputs under <corpus>/corpus, read; this log's run directory <corpus>/runs/$RUN, written)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$B" "$SELF_DIR" "$BUILD_ROOT" "$MAIN" "$KEEP" "$CORPUS")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots other than <home> are distinct, none inside another" "$(yn roots_distinct)"
    roots_ctl() { if apart "$CARGO_TARGET_DIR" "$BUILD_ROOT"; then return 1; else return 0; fi; }
    check "control: apart refuses <build>/target against <build>, which holds it" "$(yn roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    check "ANTHROPIC_API_KEY is not set" "$(yn [ -z "${ANTHROPIC_API_KEY:-}" ])"
    echo "the run directory: <corpus>/runs/$RUN; the record stems: $STEM_RUN and $STEM_OPEN; the records' destination: $RECORDS_DEST"
    echo "at entry: status lines $entry_all; of them this phase's records or planning's spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts, against the phase commit, and planning's uncommitted spec"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh scripts/edit-open-check.sh; do
      check "$s in the main tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { if [ "$(git show "$C:scripts/excel-check-list.py" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/edit-open-check.sh)" ]; then return 1; else return 0; fi; }
    check "control: the same hash comparison tells two different scripts apart" "$(yn tree_ctl)"
    spec_now=$(sha_of "$SPEC")
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "  planning's spec: $SPEC, sha256 $spec_now in the tree, $spec_committed at the phase commit; the hash planning gave for an uncommitted copy (change AJ, the pin): $SPEC_SHA"
    spec_ok() { [ "$spec_now" = "$SPEC_SHA" ] || [ "$spec_now" = "$spec_committed" ]; }
    check "planning's spec is the pinned uncommitted copy, or the committed one" "$(yn spec_ok)"
    spec_ctl() { local SPEC_SHA=$NULL_SHA spec_now=1111111111111111111111111111111111111111111111111111111111111111; if spec_ok; then return 1; else return 0; fi; }
    check "control: the same check refuses a spec at neither hash" "$(yn spec_ctl)"
    echo "command: podman image exists $IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    echo
    echo "## the release binaries, built here at the phase commit, both targets"
    echo "command: cargo build --release -p emend-copy -p xlsx-diff; the same with --target $I686"
    cargo build --release -p emend-copy -p xlsx-diff >"$B/build-host.out" 2>&1 </dev/null
    rc_h=$?
    cargo build --release -p emend-copy -p xlsx-diff --target "$I686" >"$B/build-i686.out" 2>&1 </dev/null
    rc_i=$?
    echo "  exit: host $rc_h, $I686 $rc_i"
    check "both release builds exit 0" "$(yn [ "$((rc_h + rc_i))" = 0 ])"
    PT_host=$CARGO_TARGET_DIR/release/emend-copy
    XD_host=$CARGO_TARGET_DIR/release/xlsx-diff
    PT_i686=$CARGO_TARGET_DIR/$I686/release/emend-copy
    XD_i686=$CARGO_TARGET_DIR/$I686/release/xlsx-diff
    for b in "$PT_host" "$XD_host" "$PT_i686" "$XD_i686"; do echo "  $b: sha256 $(sha_of "$b"), bytes $(stat -c %s "$b")"; done
    echo "  $(rustc --version)"
    
    
    echo
    echo "## the run log's comparison (python3, zipfile, byte spans and ElementTree)"
    cat >"$B/namescmp.py" <<'CMP_PY'
    """The run log's own names comparison (specs/0019-names-links-properties-
    protection.md, "Harness runs", --names-sample and P1).
    
    Usage: namescmp.py <input archive> <output archive> [--plant <flag>]
           namescmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool. It finds the workbook part through the package
    relationship, and W, the first <sheet> in <sheets> order whose relationship
    type is a worksheet's, by its index among the <sheet> elements, and S, W's
    sheet name. From the input workbook part it builds, by the design's rules,
    what the output's must hold, and compares:
    
      rest_same        the workbook part with every main-namespace root child
                       named definedNames or calcPr cut out is the input's, byte
                       for byte (the declaration, the root start tag, whitespace,
                       comments and every other child kept)
      names_prefix     the input's definedNames content (every definedName and
                       what lies between them) is a byte-identical prefix of the
                       output's, the container's start tag the input's (opened up
                       when the input's was empty) and its end tag of the same
                       name; trivially so when the input had none
      added_tags       after that prefix come exactly two top-level elements
                       whose start tags are the ones this log builds:
                       <definedName name="emend_global"> and
                       <definedName name="emend_local" localSheetId="W">, with
                       the root's prefix
      added_text_len   read with ElementTree, the two added elements' texts are
                       as long, in characters after unescaping, as the texts the
                       tool builds: 'S'!$A$1 and 'S'!$B$2, S with every
                       apostrophe doubled
      added_bytes      the two added elements are byte for byte the ones this
                       log builds, the texts escaped as a cell's text is (&, <,
                       >, ' and " as the five entities, a carriage return as
                       &#13;)
      container_place  an existing definedNames keeps its place among the main
                       children; a created one starts exactly where the last
                       main-namespace root child that the 19-name table of
                       ECMA-376 18.2.27 puts before definedNames ends (the root
                       start tag's end when there is none), this log's own copy
                       of the table
      calc_pr          the input's one calcPr start tag with fullCalcOnLoad set
                       to 1 (replaced between its own quotes, or appended after
                       the last attribute), every other byte of the element the
                       input's; or, with no calcPr in the input, the created
                       <calcPr fullCalcOnLoad="1"/> with the root's prefix,
                       starting exactly where the last main child the table puts
                       before calcPr ends in the output
      root_order       the output's main root children's names, in order, are
                       the input's with definedNames and calcPr each inserted,
                       when the input lacks it, before the first main child that
                       comes later in the table (a name outside the table counts
                       as later), or at the end
      one_each         the output has exactly one definedNames and one calcPr
                       among the root's main children
      names_read       read with ElementTree, the output's definedName elements
                       (name, localSheetId, hidden, text) are the input's
                       followed by the two added ones
    
    It prints ONE line of counts and yes/no flags and no name, text, sheet name,
    reference or part name. --parts prints, one per line, the workbook part's
    name, its rels part's name, the calcChain part's name (or -) and whether the
    content types part holds an Override for it (1 or 0), for the log to compare
    with the runner's rows without printing them. --plant <flag> changes the
    output as read so that the named flag turns to no; the line then says
    planted=yes, or planted=no when the pair gives the plant nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    TYPES = "http://schemas.openxmlformats.org/package/2006/content-types"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    # ECMA-376 Part 1, 18.2.27, the workbook root's children in order: this log's
    # own copy (specs/0019, "Creating an element in the workbook"), not the
    # crate's.
    TABLE = (
        "fileVersion fileSharing workbookPr workbookProtection bookViews sheets "
        "functionGroups externalReferences definedNames calcPr oleSize "
        "customWorkbookViews pivotCaches smartTagPr smartTagTypes webPublishing "
        "fileRecoveryPr webPublishObjects extLst").split()
    assert len(TABLE) == 19
    
    FLAGS = ("rest_same", "names_prefix", "added_tags", "added_text_len",
             "added_bytes", "container_place", "calc_pr", "root_order",
             "one_each", "names_read")
    
    COMMENT = b"<!-- planted -->"
    
    
    def pos(name):
        return TABLE.index(name) if name in TABLE else len(TABLE)
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def chain_of(z, workbook):
        found = [t for (_, ty, t) in rels_of(z, workbook) if ty.endswith("/calcChain")]
        return found[0] if found else None
    
    
    def pick_w(z, workbook, data):
        """(W's index among the <sheet> elements, S) or None."""
        by_id = {i: ty for (i, ty, _) in rels_of(z, workbook)}
        index = 0
        for el in ET.fromstring(data).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                if by_id.get(rid, "").endswith("/worksheet"):
                    return index, el.get("name", "")
                index += 1
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def inner(raw):
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return len(tag), len(tag)
        return len(tag), raw.rfind(b"</")
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def with_attr(tag, name, value):
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def attr_value(tag, name):
        m = re.search(ATTR_RE % re.escape(name), tag)
        return m.group(1)[1:-1] if m else None
    
    
    def root_span(data):
        """(start of the root's content, end of it, the root's prefix, the root's
        qualified name)."""
        m = None
        for m in re.finditer(rb"<([^\s/>?!]+)", data):
            break
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return close + 1, close + 1, split_name(q)[0], q
        end = data.rfind(b"</")
        return close + 1, end, split_name(q)[0], q
    
    
    def children(data, a, b, rp):
        """[(start, end, main local name or None)] of the root's children."""
        out = []
        for (x, y) in top_level(data[a:b]):
            p, n = split_name(qname(data[a + x:a + y]))
            out.append((a + x, a + y, n if p == rp else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def escaped(text):
        """quick-xml's escape of the five, and a carriage return as &#13;."""
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace("'", "&apos;").replace('"', "&quot;").replace("\r", "&#13;")).encode()
    
    
    def names_of(data):
        """(name, localSheetId, hidden, text) of every definedName of every
        main definedNames root child, in document order."""
        out = []
        for el in ET.fromstring(data):
            ns, name = local(el.tag)
            if ns not in MAIN or name != "definedNames":
                continue
            for d in el:
                dns, dname = local(d.tag)
                if dns in MAIN and dname == "definedName":
                    out.append((d.get("name"), d.get("localSheetId"), d.get("hidden"), d.text or ""))
        return out
    
    
    def full_calc(data, a, b, rp):
        for (x, y, n) in children(data, a, b, rp):
            if n == "calcPr":
                v = attr_value(start_tag(data[x:y]), b"fullCalcOnLoad")
                return v in (b"1", b"true")
        return False
    
    
    def after_last_before(kids, name, a):
        """Where an element created for `name` starts: the end of the last main
        child the table puts before it, or the root content's start."""
        at = a
        for (x, y, n) in kids:
            if n is not None and pos(n) < pos(name):
                at = y
        return at
    
    
    def expected_order(names_in):
        out = list(names_in)
        for created in ("definedNames", "calcPr"):
            if created in out:
                continue
            at = next((i for i, n in enumerate(out) if pos(n) > pos(created)), len(out))
            out.insert(at, created)
        return out
    
    
    def plant(flag, dout, a, b, rp, added_at):
        """dout changed so that `flag` turns to no, or None when the pair gives
        the plant nothing to change."""
        kids = children(dout, a, b, rp)
        dn = [(x, y) for (x, y, n) in kids if n == "definedNames"]
        cp = [(x, y) for (x, y, n) in kids if n == "calcPr"]
        if flag == "rest_same":
            return dout[:a] + COMMENT + dout[a:]
        if flag == "names_prefix":
            if not dn or added_at[1] == 0:
                return None
            x = dn[0][0] + inner(dout[dn[0][0]:dn[0][1]])[0]
            # A space doubled inside the first definedName's start tag.
            sp = dout.find(b" ", x)
            return dout[:sp] + b" " + dout[sp:]
        if flag == "added_tags":
            m = dout.find(b'name="emend_local" localSheetId=')
            if m < 0:
                return None
            return dout[:m] + b'hidden="1" ' + dout[m:]
        if flag == "added_text_len":
            m = dout.find(b'name="emend_global">')
            if m < 0:
                return None
            e = dout.find(b"</", m)
            return dout[:e] + b"X" + dout[e:]
        if flag == "added_bytes":
            m = dout.find(b'name="emend_global">')
            if m < 0:
                return None
            e = dout.find(b"&apos;", m)
            if e < 0:
                return None
            return dout[:e] + b"&#39;" + dout[e + len(b"&apos;"):]
        if flag == "container_place":
            # Only a created container has a place to lose.
            if added_at[2] or not dn:
                return None
            x = dn[0][0]
            return dout[:x] + COMMENT + dout[x:]
        if flag == "calc_pr":
            if not cp:
                return None
            x, y = cp[0]
            el = dout[x:y]
            tag = start_tag(el)
            return dout[:x] + with_attr(tag, b"fullCalcOnLoad", b"0") + el[len(tag):] + dout[y:]
        if flag == "root_order":
            if not dn or not cp:
                return None
            (x1, y1), (x2, y2) = sorted([dn[0], cp[0]])
            first, second = dout[x1:y1], dout[x2:y2]
            return dout[:x1] + second + dout[y1:x2] + first + dout[y2:]
        if flag == "one_each":
            return dout[:b] + b"<" + rp + b"definedNames/>" + dout[b:]
        if flag == "names_read":
            m = dout.find(b'name="emend_global"')
            if m < 0:
                return None
            return dout[:m] + b'name="emend_globaX"' + dout[m + len(b'name="emend_global"'):]
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        if args[1:] == ["--parts"]:
            chain = chain_of(zin, wb)
            override = 0
            if chain is not None and "[Content_Types].xml" in zin.namelist():
                for el in ET.fromstring(zin.read("[Content_Types].xml")).iter("{%s}Override" % TYPES):
                    if el.get("PartName", "").lstrip("/") == chain:
                        override = 1
            print(wb)
            print(rels_name(wb))
            print(chain if chain is not None else "-")
            print(override)
            return
        zout = zipfile.ZipFile(args[1])
        flag_plant = None
        if len(args) == 4 and args[2] == "--plant":
            flag_plant = args[3]
            if flag_plant not in FLAGS:
                print("error=unknown-plant")
                return
        din, dout = zin.read(wb), zout.read(wb)
        w = pick_w(zin, wb, din)
        if w is None:
            print("error=no-worksheet")
            return
        w_index, s_name = w
        ref = "'" + s_name.replace("'", "''") + "'!"
        texts = (ref + "$A$1", ref + "$B$2")
    
        ia, ib, rp, _ = root_span(din)
        kin = children(din, ia, ib, rp)
        din_dn = [(x, y) for (x, y, n) in kin if n == "definedNames"]
        din_cp = [(x, y) for (x, y, n) in kin if n == "calcPr"]
    
        # Where the added names begin in the output container's content: the
        # input's content length, the input's content, and whether the input
        # had a container (for the plants).
        in_content = b""
        if din_dn:
            el = din[din_dn[0][0]:din_dn[0][1]]
            x, y = inner(el)
            in_content = el[x:y]
        oa, ob, orp, _ = root_span(dout)
        added_at = (len(in_content), len(in_content), bool(din_dn))
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, dout, oa, ob, orp, added_at)
            if changed is not None:
                dout, planted = changed, True
                oa, ob, orp, _ = root_span(dout)
        kout = children(dout, oa, ob, orp)
        dn_out = [(x, y) for (x, y, n) in kout if n == "definedNames"]
        cp_out = [(x, y) for (x, y, n) in kout if n == "calcPr"]
        flags = dict.fromkeys(FLAGS, False)
    
        flags["rest_same"] = (
            cut(din, din_dn + din_cp) == cut(dout, dn_out + cp_out))
        flags["one_each"] = len(dn_out) == 1 and len(cp_out) == 1
    
        want_added = (
            b"<" + rp + b'definedName name="emend_global">' + escaped(texts[0])
            + b"</" + rp + b"definedName>"
            + b"<" + rp + b'definedName name="emend_local" localSheetId="%d">' % w_index
            + escaped(texts[1]) + b"</" + rp + b"definedName>")
        want_tags = [b"<" + rp + b'definedName name="emend_global">',
                     b"<" + rp + b'definedName name="emend_local" localSheetId="%d">' % w_index]
        added = b""
        if dn_out:
            el = dout[dn_out[0][0]:dn_out[0][1]]
            x, y = inner(el)
            content = el[x:y]
            tag = start_tag(el)
            if din_dn:
                tag_in = start_tag(din[din_dn[0][0]:din_dn[0][1]])
                head_ok = tag == (opened(tag_in) if tag_in.endswith(b"/>") else tag_in)
                end_ok = el.endswith(b"</" + qname(din[din_dn[0][0]:din_dn[0][1]]) + b">")
            else:
                head_ok = tag == b"<" + rp + b"definedNames>"
                end_ok = el.endswith(b"</" + rp + b"definedNames>")
            flags["names_prefix"] = head_ok and end_ok and content.startswith(in_content)
            added = content[len(in_content):] if content.startswith(in_content) else b""
            spans = top_level(added)
            tags = [start_tag(added[p:q]) for (p, q) in spans]
            flags["added_tags"] = (tags == want_tags and len(spans) == 2
                                   and spans[0][0] == 0 and spans[-1][1] == len(added))
            flags["added_bytes"] = added == want_added
            try:
                wrap = (b"<r>" if rp == b"" else
                        b'<r xmlns:' + rp[:-1] + b'="' + MAIN[0].encode() + b'">')
                got = [d.text or "" for d in ET.fromstring(wrap + added + b"</r>")]
                flags["added_text_len"] = [len(t) for t in got] == [len(t) for t in texts]
            except ET.ParseError:
                flags["added_text_len"] = False
    
        order_in = [n for (_, _, n) in kin if n is not None]
        order_out = [n for (_, _, n) in kout if n is not None]
        flags["root_order"] = order_out == expected_order(order_in)
        if din_dn:
            flags["container_place"] = order_out.index("definedNames") == order_in.index("definedNames") \
                if "definedNames" in order_out else False
        elif dn_out:
            # Created: it starts where the output's last main child the table puts
            # before definedNames ends. The output's children before it are the
            # input's, so their spans are the output's own.
            flags["container_place"] = dn_out[0][0] == after_last_before(
                [k for k in kout if k[0] < dn_out[0][0]], "definedNames", oa)
        if din_cp and cp_out:
            el_in = din[din_cp[0][0]:din_cp[0][1]]
            tag_in = start_tag(el_in)
            want = with_attr(tag_in, b"fullCalcOnLoad", b"1") + el_in[len(tag_in):]
            flags["calc_pr"] = dout[cp_out[0][0]:cp_out[0][1]] == want and len(din_cp) == 1
        elif cp_out:
            flags["calc_pr"] = (
                dout[cp_out[0][0]:cp_out[0][1]] == b"<" + rp + b'calcPr fullCalcOnLoad="1"/>'
                and cp_out[0][0] == after_last_before(
                    [k for k in kout if k[0] < cp_out[0][0]], "calcPr", oa))
    
        n_in = names_of(din)
        try:
            n_out = names_of(dout)
        except ET.ParseError:
            n_out = None
        want_names = n_in + [("emend_global", None, None, texts[0]),
                             ("emend_local", str(w_index), None, texts[1])]
        flags["names_read"] = n_out == want_names
    
        local_in = sum(1 for n in n_in if n[1] == str(w_index))
        local_out = sum(1 for n in (n_out or []) if n[1] == str(w_index))
        chain_in = 1 if chain_of(zin, wb) is not None else 0
        chain_out = 1 if chain_of(zout, wb) is not None else 0
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted),
             "names_in=%d" % len(n_in), "names_out=%d" % len(n_out or []),
             "local_in=%d" % local_in, "local_out=%d" % local_out,
             "container_created=%d" % (0 if din_dn else 1),
             "calc_created=%d" % (0 if din_cp else 1),
             "calc_in=%d" % len(din_cp),
             "chain_in=%d" % chain_in, "chain_out=%d" % chain_out,
             "full_calc_in=%d" % (1 if full_calc(din, ia, ib, rp) else 0),
             "full_calc_out=%d" % (1 if full_calc(dout, oa, ob, orp) else 0)]
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS]))
    
    
    main()
    CMP_PY
    echo "command: sed 's/^/    /' <scratch>/w/namescmp.py; sha256 $(sha_of "$B/namescmp.py"), $(wc -c <"$B/namescmp.py") bytes"
    sed 's/^/    /' "$B/namescmp.py"
    FLAGS="rest_same names_prefix added_tags added_text_len added_bytes container_place calc_pr root_order one_each names_read"
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    all_yes() { local f; for f in $FLAGS; do [ "$(kv "$1" "$f")" = yes ] || return 1; done; }
    # tool_and_cmp <tool line> <comparison line>: the counts the two share.
    tool_and_cmp() {
      [ "$(kv "$1" names_before)" = "$(kv "$2" names_in)" ] || return 1
      [ "$(kv "$1" names_after)" = "$(kv "$2" names_out)" ] || return 1
      [ "$(kv "$1" local_after)" = "$(kv "$2" local_out)" ] || return 1
      [ "$(kv "$1" chain_before)" = "$(kv "$2" chain_in)" ] || return 1
      [ "$(kv "$1" chain_after)" = "$(kv "$2" chain_out)" ] || return 1
      [ "$(kv "$1" full_calc)" = "$(kv "$2" full_calc_out)" ]
    }
    # line_as_spec <tool line> <comparison line>: what "Harness runs" expects of
    # the line: two names more, one more scoped to W than the input had, the
    # removal in memory leaving one more than the input, no chain after, the
    # flag set.
    line_as_spec() {
      local nb
      nb=$(kv "$1" names_before)
      [ -n "$nb" ] || return 1
      [ "$(kv "$1" names_after)" = "$((nb + 2))" ] || return 1
      [ "$(kv "$1" local_after)" = "$(($(kv "$2" local_in) + 1))" ] || return 1
      [ "$(kv "$1" names_removed)" = "$((nb + 1))" ] || return 1
      [ "$(kv "$1" chain_after)" = 0 ] || return 1
      [ "$(kv "$1" full_calc)" = 1 ]
    }
    ay_ctl() { if all_yes "found=1"; then return 1; else return 0; fi; }
    check "control: all_yes refuses a line with no flags" "$(yn ay_ctl)"
    lin_ok() { line_as_spec "$(printf 'names\tnames_before=3\tnames_after=5\tlocal_after=2\tchain_before=1\tchain_after=0\tfull_calc=1\tnames_removed=4')" "local_in=1"; }
    check "control: line_as_spec accepts a line as the spec reads" "$(yn lin_ok)"
    lin_ctl() { if line_as_spec "$(printf 'names\tnames_before=3\tnames_after=5\tlocal_after=2\tchain_before=1\tchain_after=0\tfull_calc=1\tnames_removed=5')" "local_in=1"; then return 1; else return 0; fi; }
    check "control: line_as_spec refuses the same line with the removal not seen" "$(yn lin_ctl)"
    tac_ctl() { if tool_and_cmp "$(printf 'names\tnames_before=3\tnames_after=5\tlocal_after=2\tchain_before=1\tchain_after=0\tfull_calc=1')" "names_in=3 names_out=5 local_out=2 chain_in=0 chain_out=0 full_calc_out=1"; then return 1; else return 0; fi; }
    check "control: tool_and_cmp refuses a pair that disagrees on the chain" "$(yn tac_ctl)"
    
    manifest_rows=$(awk -F'\t' 'NR > 1 { n++ } END { print n + 0 }' "$CORPUS/manifest.tsv")
    echo "  corpus manifest rows: $manifest_rows"
    check "the corpus holds its 27 workbooks" "$(yn [ "$manifest_rows" = 27 ])"
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    sum_col() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { n += $k } END { print n + 0 }' "$1"; }
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv" >"$B/order"
    # The parts each workbook's entry rows are checked against, read once from
    # the input by the comparison: the workbook part, its rels part, the chain
    # part (or -), and whether the content types part holds an Override for it.
    # Names are read and never printed.
    n_chain=0; n_chain_override=0
    while IFS="$TAB" read -r id ext; do
      python3 "$B/namescmp.py" "$CORPUS/corpus/$id.$ext" --parts >"$B/parts-$id"
      if [ "$(sed -n 3p "$B/parts-$id")" != - ]; then n_chain=$((n_chain + 1)); fi
      if [ "$(sed -n 4p "$B/parts-$id")" = 1 ]; then n_chain_override=$((n_chain_override + 1)); fi
    done <"$B/order"
    want_changed=$((manifest_rows + n_chain + n_chain_override))
    echo "  from the inputs: workbooks with a calculation chain $n_chain; of them with an Override for it $n_chain_override; so changed entries expected $want_changed, dropped $n_chain, added 0, recompressed 0"
    # entries_names <entries> <id> <parts file>: the runner's rows for one
    # workbook: the workbook part changed; with a chain, the chain dropped, the
    # workbook's rels part changed, and [Content_Types].xml changed when it holds
    # an Override for the chain and identical otherwise; a changed row flagged
    # descriptor at most; every other row identical and unflagged.
    entries_names() {
      local wb rels cpart over
      wb=$(sed -n 1p "$3"); rels=$(sed -n 2p "$3"); cpart=$(sed -n 3p "$3"); over=$(sed -n 4p "$3")
      awk -F'\t' -v id="$2" -v wb="$wb" -v rels="$rels" -v cpart="$cpart" -v over="$over" '
        NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next }
        $k["id"] != id { next }
        {
          n++
          name = $k["name"]
          want = "identical"
          if (name == wb) want = "changed"
          if (cpart != "-" && name == rels) want = "changed"
          if (cpart != "-" && over == 1 && name == "[Content_Types].xml") want = "changed"
          if (cpart != "-" && name == cpart) want = "dropped"
          if ($k["status"] != want) bad++
          if (want == "changed" && $k["flags"] != "" && $k["flags"] != "descriptor") bad++
          if (want != "changed" && $k["flags"] != "") bad++
          if (want == "changed") nch++
          if (want == "dropped") ndr++
        }
        END {
          if (n == 0 || bad > 0) exit 1
          if (nch != 1 + (cpart != "-" ? 1 + (over == 1 ? 1 : 0) : 0)) exit 1
          if (ndr != (cpart != "-" ? 1 : 0)) exit 1
        }' "$1"
    }
    printf 'wb.xml\nr.rels\nc.xml\n1\n' >"$B/parts-ctl"
    {
      printf 'id\tname\tstatus\tflags\n'
      printf 'w\twb.xml\tchanged\t\nw\tr.rels\tchanged\tdescriptor\n'
      printf 'w\t[Content_Types].xml\tchanged\t\nw\tc.xml\tdropped\t\nw\to.xml\tidentical\t\n'
    } >"$B/e-ctl.tsv"
    check "control: entries_names accepts the expected rows of a chained workbook" "$(yn entries_names "$B/e-ctl.tsv" w "$B/parts-ctl")"
    sed 's/o.xml\tidentical\t$/o.xml\tchanged\t/' "$B/e-ctl.tsv" >"$B/e-extra.tsv"
    en_extra() { if entries_names "$B/e-extra.tsv" w "$B/parts-ctl"; then return 1; else return 0; fi; }
    check "control: entries_names refuses a fourth changed row" "$(yn en_extra)"
    sed 's/c.xml\tdropped\t$/c.xml\tidentical\t/' "$B/e-ctl.tsv" >"$B/e-kept.tsv"
    en_kept() { if entries_names "$B/e-kept.tsv" w "$B/parts-ctl"; then return 1; else return 0; fi; }
    check "control: entries_names refuses a chain left in place" "$(yn en_kept)"
    sed 's/wb.xml\tchanged\t$/wb.xml\tchanged\trecompressed/' "$B/e-ctl.tsv" >"$B/e-flag.tsv"
    en_flag() { if entries_names "$B/e-flag.tsv" w "$B/parts-ctl"; then return 1; else return 0; fi; }
    check "control: entries_names refuses a changed row flagged other than descriptor" "$(yn en_flag)"
    printf 'wb.xml\nr.rels\n-\n0\n' >"$B/parts-ctl-nochain"
    printf 'id\tname\tstatus\tflags\nw\twb.xml\tchanged\t\nw\tr.rels\tidentical\t\n' >"$B/e-nochain.tsv"
    check "control: entries_names accepts a workbook with no chain, its part alone changed" "$(yn entries_names "$B/e-nochain.tsv" w "$B/parts-ctl-nochain")"
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      echo
      echo "## $label run, --tool-arg $EDIT"
      echo "command: scripts/passthrough-run.sh --label $label --passthrough <build>/target/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <build>/target/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --out <corpus>/runs/$RUN --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$OUT" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
        >"$B/run-$label.stdout" 2>"$B/run-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$label.stderr")"
      sed 's/^/    /' "$B/run-$label.stdout"
      check "$label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$label: its stderr is empty" "$(yn [ ! -s "$B/run-$label.stderr" ])"
      SUM=$OUT/summary.$label.tsv
      ENT=$OUT/entries.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      echo "  summary rows: $rows; outcome ok: $(count_where "$SUM" outcome ok); lo ok: $(count_where "$SUM" lo ok); lo_in ok: $(count_where "$SUM" lo_in ok); leftover no: $(count_where "$SUM" leftover no)"
      echo "  order_preserved yes: $(count_where "$SUM" order_preserved yes); comment_equal yes: $(count_where "$SUM" comment_equal yes); files_identical no: $(count_where "$SUM" files_identical no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      summary_ok() {
        local col
        [ "$rows" = "$manifest_rows" ] || return 1
        for col in "outcome ok" "lo ok" "lo_in ok" "leftover no" "order_preserved yes" "comment_equal yes" "files_identical no"; do
          [ "$(count_where "$SUM" ${col% *} ${col#* })" = "$rows" ] || return 1
        done
        [ "$(sum_col "$SUM" changed)" = "$want_changed" ] || return 1
        [ "$(sum_col "$SUM" dropped)" = "$n_chain" ] || return 1
        [ "$(sum_col "$SUM" recompressed)$(sum_col "$SUM" added)" = 00 ]
      }
      check "$label: every workbook ok, lo and lo_in ok, no leftover, order and comment kept, files not identical, the changed and dropped entries the inputs imply ($want_changed and $n_chain), none recompressed or added" "$(yn summary_ok)"
      echo "  per workbook: id, the tool's line, the comparison's line (counts and yes/no only)"
      : >"$B/lines-$label"
      nwb=0; nflags=0; nagree=0; nline=0; nentries=0; t_created=0; t_calc_created=0; t_names=0
      while IFS="$TAB" read -r id ext; do
        nwb=$((nwb + 1))
        e=$(cat "$OUT/$id/stdout.$label.txt")
        c=$(python3 "$B/namescmp.py" "$CORPUS/corpus/$id.$ext" "$OUT/$id/out.$label.$ext")
        printf '%s\t%s\n' "$id" "$e" >>"$B/lines-$label"
        printf '    %s %s\n' "$id" "$(printf '%s' "$e" | tr '\t' ' ')"
        printf '    %s cmp %s\n' "$id" "$(printf '%s' "$c" | tr '\t' ' ')"
        if all_yes "$c"; then nflags=$((nflags + 1)); else echo "    $id: a flag of the comparison does not hold"; fi
        if tool_and_cmp "$e" "$c"; then nagree=$((nagree + 1)); else echo "    $id: the tool and the comparison disagree"; fi
        if line_as_spec "$e" "$c"; then nline=$((nline + 1)); else echo "    $id: the tool's line is not what the edits imply"; fi
        if entries_names "$ENT" "$id" "$B/parts-$id"; then nentries=$((nentries + 1)); else echo "    $id: the entry rows are not what the names imply"; fi
        t_created=$((t_created + $(kv "$c" container_created))); t_calc_created=$((t_calc_created + $(kv "$c" calc_created)))
        t_names=$((t_names + $(kv "$c" names_in)))
      done <"$B/order"
      echo "  workbooks: $nwb; every flag holds: $nflags; the tool and the comparison agree: $nagree; the line as the spec reads: $nline; entry rows as P1 expects: $nentries"
      echo "  totals: the inputs' defined names $t_names; containers created $t_created; calcPr created $t_calc_created"
      check "$label: the comparison read every workbook of the manifest" "$(yn [ "$nwb" = "$manifest_rows" ])"
      check "$label: every flag of the comparison holds in every workbook" "$(yn [ "$nflags" = "$manifest_rows" ])"
      check "$label: the tool and the comparison agree in every workbook" "$(yn [ "$nagree" = "$manifest_rows" ])"
      check "$label: every line is what the edits imply" "$(yn [ "$nline" = "$manifest_rows" ])"
      check "$label: every workbook's entry rows are as P1 expects" "$(yn [ "$nentries" = "$manifest_rows" ])"
      # The totals against the spec's corpus facts (specs/0019, "Facts planning
      # checked"): 160 names in 16 workbooks, so 11 containers created.
      check "$label: the inputs hold 160 defined names, the spec's count" "$(yn [ "$t_names" = 160 ])"
      check "$label: a container created in 11 workbooks, the 27 less the spec's 16 that have one" "$(yn [ "$t_created" = 11 ])"
      R=$OUT/run.$label.tsv
      args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$R")
      bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
      check "$label: the run row records the two release binaries by sha256 and the phase commit" "$(yn bins_in_row)"
      check "$label: the run row's tool_args is $EDIT" "$(yn [ "$args" = "$EDIT" ])"
    done
    entries_ctl() {
      local id
      id=$(head -n 1 "$B/order" | cut -f1)
      printf 'no/such/part.xml\nno/such.rels\n-\n0\n' >"$B/c-parts"
      if entries_names "$OUT/entries.host.tsv" "$id" "$B/c-parts"; then return 1; else return 0; fi
    }
    check "control: entries_names refuses the first workbook's rows against a part it does not change" "$(yn entries_ctl)"
    
    echo
    echo "### the planted-flag controls, host, each on the first workbook in manifest order where it applies"
    nbit=0
    nplants=0
    for f in $FLAGS; do
      nplants=$((nplants + 1))
      flag=$f
      where=none; planted=""
      while IFS="$TAB" read -r id ext; do
        planted=$(python3 "$B/namescmp.py" "$CORPUS/corpus/$id.$ext" "$OUT/$id/out.host.$ext" --plant "$f")
        if [ "$(kv "$planted" planted)" = yes ]; then where=$id; break; fi
      done <"$B/order"
      turned() { [ "$where" != none ] && [ "$(kv "$planted" "$flag")" = no ] && [ "$(kv "$planted" planted)" = yes ]; }
      echo "  plant $f: applied on $where; $flag=$(kv "$planted" "$flag")"
      if turned; then nbit=$((nbit + 1)); fi
      check "control: the plant $f applies on some workbook and turns $flag to no there" "$(yn turned)"
    done
    echo "  plants: $nplants; plants that turned their own flag: $nbit"
    check "every flag has a plant that turned it ($nbit of $nplants)" "$(yn [ "$nbit" = "$nplants" ])"
    unknown_plant() { [ "$(python3 "$B/namescmp.py" "$CORPUS/corpus/$(head -n 1 "$B/order" | cut -f1).$(head -n 1 "$B/order" | cut -f2)" "$OUT/$(head -n 1 "$B/order" | cut -f1)/out.host.$(head -n 1 "$B/order" | cut -f2)" --plant no_such_flag)" = error=unknown-plant ]; }
    check "control: the comparison refuses a plant it does not know" "$(yn unknown_plant)"
    
    echo
    echo "### the two labels' outputs"
    same_out=0
    while IFS="$TAB" read -r id ext; do
      if cmp -s "$OUT/$id/out.host.$ext" "$OUT/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
    done <"$B/order"
    echo "  workbooks whose host and i686 outputs are byte for byte the same: $same_out"
    check "every output is the same on both targets" "$(yn [ "$same_out" = "$manifest_rows" ])"
    check "both targets printed the same line for every workbook" "$(yn cmp -s "$B/lines-host" "$B/lines-i686")"
    cp "$B/lines-host" "$B/c-lines"; printf 'x\n' >>"$B/c-lines"
    lines_ctl() { if cmp -s "$B/c-lines" "$B/lines-i686"; then return 1; else return 0; fi; }
    check "control: the same comparison tells a line list with one line added" "$(yn lines_ctl)"
    
    echo
    echo
    echo "## the corpus record pair"
    echo "command: scripts/passthrough-record.py --run <corpus>/runs/$RUN --out <scripts>/out/records --stem $STEM_RUN"
    scripts/passthrough-record.py --run "$OUT" --out "$RECORDS" --stem "$STEM_RUN" >"$B/record.out" 2>&1
    rrc=$?
    sed 's/^/    /' "$B/record.out"
    check "the record script exits 0" "$(yn [ "$rrc" = 0 ])"
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md = sys.argv[1:5]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        changed_f = sorted(f for f in fam if fam[f].get("changed"))
        dropped_f = sorted(f for f in fam if fam[f].get("dropped"))
        # Change AG: the workbook always; rels and content-types only where a
        # chain was dropped (and content-types only then, when it had an
        # Override for the chain).
        fam_ok = ("workbook" in changed_f
                  and set(changed_f) <= {"workbook", "rels", "content-types"}
                  and ((dropped_f == ["calcChain"]) == ("rels" in changed_f))
                  and ("content-types" not in changed_f or dropped_f == ["calcChain"]))
        checks.append(("%s: the xml families are the changed entries' families" % label, sorted(xf) == changed_f))
        checks.append(("%s: the changed entries' families are workbook, and rels and content-types with a dropped chain" % label, fam_ok))
        checks.append(("%s: the dropped entries' family is calcChain alone, or none" % label, dropped_f in ([], ["calcChain"])))
        checks.append(("%s: no entry is added" % label,
                       sorted(f for f in fam if fam[f].get("added")) == []))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: --names-sample" in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    sed 's/^/    /' "$B/reccheck.py"
    RTXT=$RECORDS/$STEM_RUN.txt
    RMD=$RECORDS/$STEM_RUN.md
    python3 "$B/reccheck.py" scripts/passthrough-record.py "$OUT" "$RTXT" "$RMD" >"$B/reccheck.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/reccheck.out"
    rec_all() { [ "$(count_matches -E ': yes$' "$B/reccheck.out")" = 18 ] && [ "$(count_matches -E ': no$' "$B/reccheck.out")" = 0 ]; }
    check "the record's three tables are the run directory's, and its family tables are counted from them (eighteen checks: four, six per label, two)" "$(yn rec_all)"
    awk '!done && /^[|] total [|]/ { done = 1; next } { print }' "$RMD" >"$B/c-rec.md"
    python3 "$B/reccheck.py" scripts/passthrough-record.py "$OUT" "$RTXT" "$B/c-rec.md" >"$B/c-reccheck.out" 2>&1
    sed '2d' "$RTXT" >"$B/c-rec.txt"
    python3 "$B/reccheck.py" scripts/passthrough-record.py "$OUT" "$B/c-rec.txt" "$RMD" >"$B/c-reccheck2.out" 2>&1
    rec_ctl() { [ "$(count_matches -E ': no$' "$B/c-reccheck.out")" -ge 1 ] && [ "$(count_matches -F "the summary table is every label's summary: no" "$B/c-reccheck2.out")" = 1 ]; }
    check "control: the same check finds an .md with a family table's total row dropped and a .txt one summary row short" "$(yn rec_ctl)"
    rm -rf scripts/__pycache__
    echo "command: install -m 644 <scripts>/out/records/$STEM_RUN.md <scripts>/out/records/$STEM_RUN.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RMD" "$RTXT" "$RECORDS_DEST"/
    echo "  exit: $?"
    for f in "$STEM_RUN.md" "$STEM_RUN.txt"; do
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      inst_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
      check "the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
    done
    echo
    echo "## the keep regenerated: the tests with the variable set, one keep directory per target"
    echo "command: read the test.log given (sha256 $(sha_of "$TEST_LOG"), $(wc -c <"$TEST_LOG") bytes)"
    tl_is_phase() { [ "$(count_matches -E "^about: M2 part 4a P1 phase commit $C; HEAD at run: $C\$" "$TEST_LOG")" = 1 ]; }
    check "the test.log read is this phase's, at this phase commit" "$(yn tl_is_phase)"
    tl_ctl() { local C=$NULL_SHA; if tl_is_phase; then return 1; else return 0; fi; }
    check "control: the same check says no for the null commit" "$(yn tl_ctl)"
    tl_unset() { [ "$(count_matches -xF 'EMEND_KEEP_DIR set when this script started: no; unset for the whole log: yes' "$TEST_LOG")" = 1 ]; }
    check "the test.log ran with the variable unset" "$(yn tl_unset)"
    tl_all_yes() { [ "$(count_matches -xF 'test log checks all as expected: yes' "$TEST_LOG")" = 1 ]; }
    check "the test.log ends all as expected" "$(yn tl_all_yes)"
    for target in host i686-unknown-linux-musl; do
      awk -v h="## cargo test --workspace ($target)" '
        $0 == h { on = 1; next }
        /^## / { on = 0 }
        on && /^    test .* \.\.\. ok$/ { sub(/^    test /, ""); sub(/ \.\.\. ok$/, ""); print }
      ' "$TEST_LOG" | sort >"$B/unset-$target.names"
      sed -n "s/^$target: passed \\([0-9]*\\); failed 0; ignored \\([0-9]*\\); test lines ending ok: [0-9]*\$/\\1 \\2/p" "$TEST_LOG" >"$B/unset-$target.count"
      echo "  $target without the variable: passed and ignored $(cat "$B/unset-$target.count"); names read $(count_lines "$B/unset-$target.names")"
      names_match_count() { [ -s "$B/unset-$target.count" ] && [ "$(count_lines "$B/unset-$target.names")" = "$(cut -d' ' -f1 "$B/unset-$target.count")" ]; }
      check "$target: the names read account for the passed count read" "$(yn names_match_count)"
    done
    mkdir "$KEEP" "$BUILD_ROOT/keep-i686.$$" || exit 2
    KI=$BUILD_ROOT/keep-i686.$$
    for target in host i686-unknown-linux-musl; do
      case $target in host) K=$KEEP; targs=() ;; *) K=$KI; targs=(--target "$target") ;; esac
      echo
      echo "### cargo test --workspace ($target), EMEND_KEEP_DIR=$K"
      echo "command: EMEND_KEEP_DIR=$K cargo test --workspace ${targs[*]}"
      EMEND_KEEP_DIR=$K cargo test --workspace "${targs[@]}" >"$B/$target.out" 2>&1 </dev/null
      rc=$?
      echo "  exit: $rc"
      check "$target: exit 0" "$(yn [ "$rc" -eq 0 ])"
      echo "  summary lines:"
      LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$B/$target.out" | sed 's/^ */    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$B/$target.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$B/set-$target.names"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      ignored=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^ignored;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      echo "  $target with the variable: passed $passed; failed $failed; ignored $ignored; test lines ending ok $(count_lines "$B/set-$target.names")"
      check "$target: failed is 0" "$(yn [ "$failed" = 0 ])"
      check "$target: passed and ignored are the run's without the variable ($(cat "$B/unset-$target.count"))" "$(yn [ "$passed $ignored" = "$(cat "$B/unset-$target.count")" ])"
      check "$target: the test names that passed are the run's without the variable" "$(yn cmp -s "$B/set-$target.names" "$B/unset-$target.names")"
      echo "  files in the keep: $(find "$K" -type f | wc -l); entries that are not regular files: $(find "$K" -mindepth 1 ! -type f | wc -l)"
    done
    { head -n 1 "$B/unset-host.names"; cat "$B/unset-host.names"; } | sort >"$B/c-names"
    cmp_ctl() { if cmp -s "$B/c-names" "$B/unset-host.names"; then return 1; else return 0; fi; }
    check "control: the same comparison tells a name list with one name doubled from the real one" "$(yn cmp_ctl)"
    
    echo
    echo "## the two keep directories compared"
    (cd "$KEEP" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/host.files"
    (cd "$KI" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/i686.files"
    nfiles=$(count_lines "$B/host.files")
    same=0
    while IFS= read -r f; do
      if cmp -s "$KEEP/$f" "$KI/$f"; then same=$((same + 1)); else echo "    differs: $f"; fi
    done <"$B/host.files"
    echo "  files: host $nfiles, i686 $(count_lines "$B/i686.files"); the same bytes on both: $same"
    check "the two keeps hold the same names" "$(yn cmp -s "$B/host.files" "$B/i686.files")"
    keeps_same() { [ "$nfiles" -ge 2 ] && [ "$same" = "$nfiles" ]; }
    check "every file in the host keep is byte for byte the i686 keep's" "$(yn keeps_same)"
    first_kept=$(head -n 1 "$B/host.files")
    cp "$KEEP/$first_kept" "$B/c-copy"
    printf 'x' >>"$B/c-copy"
    cmp_bytes_ctl() { if cmp -s "$B/c-copy" "$KI/$first_kept"; then return 1; else return 0; fi; }
    check "control: cmp tells a kept file with one byte added from its original" "$(yn cmp_bytes_ctl)"
    n_in=$(count_matches -E '\.in\.xlsx$' "$B/host.files")
    n_out=$(count_matches -E '\.out\.xlsx$' "$B/host.files")
    n_other=$(count_matches -vE '^[A-Za-z0-9_.-]+\.[0-9]+\.(in|out)\.xlsx$' "$B/host.files")
    LC_ALL=C sed -nE 's/^(.*)\.in\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.names"
    LC_ALL=C sed -nE 's/^(.*)\.out\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.out.names"
    echo "  .in.xlsx $n_in; .out.xlsx $n_out; names not of the form <test>.<n>.in|out.xlsx: $n_other"
    all_pairs() { [ "$n_in" = "$n_out" ] && [ "$((n_in * 2))" = "$nfiles" ] && [ "$n_other" = 0 ] && cmp -s "$B/pair.names" "$B/pair.out.names"; }
    check "the keep holds only whole pairs named <test>.<n>" "$(yn all_pairs)"
    NPAIRS=$n_in
    (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/keep.listing"
    echo "  the host keep's listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/keep.listing"); files $(count_lines "$B/keep.listing"); listing sha256 $(sha_of "$B/keep.listing")"
    check "the host keep's pairs times two equals its files (keep_pairs_ok)" "$(yn keep_pairs_ok "$B/keep.listing")"
    rm -rf "$KI"
    check "the i686 keep is removed after the comparison; the host keep stays for planning" "$(yn [ ! -e "$KI" ])"
    
    echo
    echo "## the host keep against part 3 P4's committed open-check record (change AH)"
    PREV_TXT=$(git show --name-only --format= "$PREV_OPEN_REC" | LC_ALL=C "$G" -E '^records/m2p3-open-.*[.]txt$')
    echo "command: git show --name-only --format= <part 3 P4's record commit>, the open-check .txt it added; git show <phase commit>:<it>"
    echo "  part 3 P4's record: $PREV_TXT (sha256 $(git show "$C:$PREV_TXT" | sha256sum | cut -d' ' -f1))"
    check "part 3 P4's record commit added exactly one open-check .txt" "$(yn [ "$(printf '%s\n' "$PREV_TXT" | count_lines /dev/stdin)" = 1 ])"
    no_later_open() { [ -z "$(git log --format=%H "$PREV_OPEN_REC..$C" -- 'records/*-open-*.txt')" ]; }
    check "no commit after it adds an open-check record, so it is the last committed" "$(yn no_later_open)"
    git show "$C:$PREV_TXT" >"$B/prev.txt"
    while IFS= read -r t; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$t" "$(stat -c %s "$KEEP/$t.in.xlsx")" "$(sha_of "$KEEP/$t.in.xlsx")" \
        "$(stat -c %s "$KEEP/$t.out.xlsx")" "$(sha_of "$KEEP/$t.out.xlsx")"
    done <"$B/pair.names" >"$B/keep.rows"
    tail -n +2 "$B/prev.txt" | cut -f1-5 | LC_ALL=C sort >"$B/prev.rows"
    LC_ALL=C sort "$B/keep.rows" >"$B/keep.sorted"
    n_prev=$(count_lines "$B/prev.rows")
    n_kept_prev=$(LC_ALL=C comm -12 "$B/prev.rows" "$B/keep.sorted" | count_lines /dev/stdin)
    cut -f1 "$B/prev.rows" >"$B/prev.names"
    LC_ALL=C comm -13 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/gone.pairs"
    echo "  rows: the regenerated keep $(count_lines "$B/keep.rows"), part 3 P4's record $n_prev; its rows found in the keep with the same name, bytes and both sha256s: $n_kept_prev"
    echo "  pairs in the keep and not in part 3 P4's record: $(count_lines "$B/new.pairs"); in its record and not in the keep: $(count_lines "$B/gone.pairs")"
    sed 's/^/    new: /' "$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.rows" "$B/keep.sorted" | cut -f1 >"$B/changed.pairs"
    echo "  pairs of part 3 P4's record whose bytes differ in the keep: $(count_lines "$B/changed.pairs")"
    sed 's/^/    changed: /' "$B/changed.pairs"
    check "every pair of part 3 P4's record is in the keep, byte for byte (the code under those tests did not change what they write)" "$(yn [ "$n_kept_prev" = "$n_prev" ])"
    check "no pair of part 3 P4's record is gone" "$(yn [ "$(count_lines "$B/gone.pairs")" = 0 ])"
    echo "command: the #[test] functions this phase adds, from git diff <base> <phase commit> -- '*.rs', as test.log derives them"
    git diff -U0 "$REC" "$C" -- '*.rs' | awk '/^\+[ \t]*#\[test\]/ { t = 1; next } t && /^\+[ \t]*fn[ \t]/ { sub(/^\+[ \t]*fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next } { t = 0 }' | LC_ALL=C sort >"$B/added.tests"
    sed 's/^/    added test: /' "$B/added.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/new.pairs" | LC_ALL=C sort -u >"$B/new.tests"
    # Change H: no new pair is a pass (part 2 P3's attempt 2 form), the count
    # printed above.
    new_from_added() { [ "$(LC_ALL=C comm -23 "$B/new.tests" "$B/added.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "no new pair, or every new pair is kept by a test this phase adds" "$(yn new_from_added)"
    printf 'zzz_not_a_new_test\n' | LC_ALL=C sort -m - "$B/new.tests" >"$B/c-new.tests"
    new_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-new.tests" "$B/added.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a pair of a test the phase did not add" "$(yn new_ctl)"
    
    echo
    echo "## scripts/edit-open-check.sh on the host keep (specs/0018 \"Harness runs\": every phase's run log runs it over its keep)"
    mkdir "$B/tmp"
    echo "command: TMPDIR=<scratch>/w/tmp scripts/edit-open-check.sh --keep <keep> --libreoffice $IMAGE --out <scripts>/out/records --stem $STEM_OPEN"
    TMPDIR=$B/tmp scripts/edit-open-check.sh --keep "$KEEP" --libreoffice "$IMAGE" --out "$RECORDS" --stem "$STEM_OPEN" \
      >"$B/oc.stdout" 2>"$B/oc.stderr" </dev/null
    oc_rc=$?
    echo "  exit: $oc_rc"
    echo "  stdout:"; sed 's/^/    /' "$B/oc.stdout"
    echo "  stderr bytes: $(wc -c <"$B/oc.stderr")"
    check "the script exits 0 (no finding, no check errored)" "$(yn [ "$oc_rc" = 0 ])"
    check "its stderr is empty" "$(yn [ ! -s "$B/oc.stderr" ])"
    echo "  the reasons the script kept (its reasons directory under <scratch>/w/tmp), one line per refused side:"
    find "$B/tmp" -name '*-reason.txt' | LC_ALL=C sort | while IFS= read -r f; do echo "    ${f#"$B/tmp/"}: $(cat "$f")"; done
    TXT=$RECORDS/$STEM_OPEN.txt
    MD=$RECORDS/$STEM_OPEN.md
    TXT_HEADER=$(git show "$C:scripts/edit-open-check.sh" | sed -n "s/^readonly TXT_HEADER=\\$'\\(.*\\)'\$/\\1/p" | sed 's/\\t/\t/g')
    check "the .txt's header is the script's TXT_HEADER, read from the phase commit (nine columns)" "$(yn [ "$(head -n 1 "$TXT")" = "$TXT_HEADER" ])"
    tail -n +2 "$TXT" | cut -f1-5 >"$B/txt.rows"
    nrow_same=$(paste -d'\n' "$B/keep.rows" "$B/txt.rows" | awk 'NR % 2 == 1 { a = $0; next } a == $0 { n++ } END { print n + 0 }')
    echo "  rows: the keep $(count_lines "$B/keep.rows"), the .txt $(count_lines "$B/txt.rows"); rows whose name, bytes and hashes are the keep's, compared row by row: $nrow_same"
    rows_same() { [ "$(count_lines "$B/keep.rows")" = "$(count_lines "$B/txt.rows")" ] && [ "$nrow_same" = "$(count_lines "$B/keep.rows")" ] && [ "$nrow_same" = "$NPAIRS" ]; }
    check "every .txt row is one kept pair's name, byte counts and sha256s, in name order, one row per pair" "$(yn rows_same)"
    bad_rows=$(tail -n +2 "$TXT" | awk -F'\t' 'NF != 9 || $6 !~ /^(ok|fail|error)$/ || $7 !~ /^(ok|fail|error)$/ || $8 !~ /^(none|refused|count|error)$/ || $9 !~ /^(none|refused|count|error)$/' | wc -l)
    check "every row has nine columns, lo_in and lo each ok, fail or error, and each class none, refused, count or error ($bad_rows rows otherwise)" "$(yn [ "$bad_rows" = 0 ])"
    bad_fit=$(tail -n +2 "$TXT" | awk -F'\t' '{ print $6 ":" $8; print $7 ":" $9 }' | LC_ALL=C "$G" -cvxE 'ok:none|fail:refused|fail:count|error:error')
    check "every side's class fits its verdict ($bad_fit sides otherwise)" "$(yn [ "$bad_fit" = 0 ])"
    stdout_rows() { [ "$(awk -F'\t' 'NF == 3' "$B/oc.stdout")" = "$(tail -n +2 "$TXT" | cut -f1,6,7)" ]; }
    check "the script's per-pair stdout lines are the .txt's test, lo_in and lo columns" "$(yn stdout_rows)"
    echo "command: python3 <scratch>/w/wb.py over each kept input: its xl/workbook.xml entry, its sheet elements by local name (expat, no pattern) and of them those with a prefix"
    cat >"$B/wb.py" <<'PY'
    import sys, zipfile
    from xml.parsers import expat
    for path in sys.argv[1:]:
        name = path.rsplit("/", 1)[1][: -len(".in.xlsx")]
        try:
            z = zipfile.ZipFile(path)
        except zipfile.BadZipFile:
            print("%s\tunreadable\t-\t-" % name)
            continue
        if "xl/workbook.xml" not in z.namelist():
            print("%s\tno\t-\t-" % name)
            continue
        found = {"all": 0, "prefixed": 0}
    
        def start(tag, attrs):
            prefix, _, local = tag.rpartition(":")
            if local == "sheet":
                found["all"] += 1
                found["prefixed"] += 1 if prefix else 0
        p = expat.ParserCreate()
        p.StartElementHandler = start
        try:
            p.Parse(z.read("xl/workbook.xml"), True)
        except expat.ExpatError:
            print("%s\tyes\tunparsed\t-" % name)
            continue
        print("%s\tyes\t%d\t%d" % (name, found["all"], found["prefixed"]))
    PY
    sed 's/^/    /' "$B/wb.py"
    python3 "$B/wb.py" $(sed "s#^#$KEEP/#; s#\$#.in.xlsx#" "$B/pair.names") | LC_ALL=C sort >"$B/wb.all"
    echo "  kept inputs by workbook entry and sheet elements (entry, all, prefixed: pairs):"
    cut -f2- "$B/wb.all" | sort | uniq -c | sed 's/^/    /'
    echo "  the .md checked against the .txt and the kept inputs, with the heading specs/0015 P2 verification ruling 1 gives: <scratch>/w/mdcheck.py, below"
    cat >"$B/mdcheck.py" <<'PY'
    import sys
    txt, md, wb = sys.argv[1:4]
    rows = [l.split("\t") for l in open(txt).read().split("\n")[1:] if l]
    sheets = {l.split("\t")[0]: l.split("\t")[2] for l in open(wb).read().split("\n") if l}
    text = open(md).read().split("\n")
    REFUSED = ("Inputs refused by LibreOffice (allowed: a fixture LibreOffice cannot load: zip-level,"
               " or a package with no relationships part or an empty content-types root)")
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line:
                out.append(line)
        return out
    
    
    def listed(names):
        return ["- `%s`" % n for n in names] if names else ["None."]
    
    
    def count(col, v):
        return sum(1 for r in rows if r[col] == v)
    
    
    totals = [len(rows)] + [count(5, v) for v in ("ok", "fail", "error")] + [count(6, v) for v in ("ok", "fail", "error")]
    classes = ["| %s | " % side + " | ".join(str(count(col, c)) for c in ("none", "refused", "count", "error")) + " |"
               for side, col in (("reason_in", 7), ("reason_out", 8))]
    tot = section("Totals")
    checks = [
        ("Totals", tot[2:3] == ["| " + " | ".join(str(t) for t in totals) + " |"] and tot[5:] == classes),
        ("the refused-inputs heading reads as ruled, once", text.count("## " + REFUSED) == 1),
        ("Inputs refused by LibreOffice", section(REFUSED) == listed([r[0] for r in rows if r[7] == "refused"])),
        ("the sheet count did not apply", section("Inputs the sheet count did not apply to (allowed: a workbook fixture with no sheet element)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) == "0"])),
        ("counts differ", section("Inputs whose sheet and table counts differ (a finding)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) != "0"])),
        ("Outputs refused on an accepted input", section("Outputs refused on an input LibreOffice accepted (a finding)") == listed([r[0] for r in rows if r[6] == "fail" and r[5] == "ok"])),
        ("Checks that did not run", section("Checks that did not run (error)") == listed([r[0] for r in rows if "error" in (r[5], r[6])])),
        ("Pairs", section("Pairs")[2:] == ["| `%s` | %s | %s | %s | %s | %s | %s | %s | %s |" % tuple(r) for r in rows]),
        ("the Pairs line", ("- Pairs: %d" % len(rows)) in text),
    ]
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("totals: pairs %d; lo_in ok %d fail %d error %d; lo ok %d fail %d error %d" % tuple(totals))
    PY
    sed 's/^/    /' "$B/mdcheck.py"
    python3 "$B/mdcheck.py" "$TXT" "$MD" "$B/wb.all" >"$B/mdcheck.out"
    sed 's/^/    /' "$B/mdcheck.out"
    md_all() { [ "$(count_matches -E ': yes$' "$B/mdcheck.out")" = 9 ] && [ "$(count_matches -E ': no$' "$B/mdcheck.out")" = 0 ]; }
    check "the .md's nine parts are derived from the .txt and the kept inputs' sheet elements, the heading as ruled" "$(yn md_all)"
    head -n 2 "$TXT" >"$B/c-short.txt"
    python3 "$B/mdcheck.py" "$B/c-short.txt" "$MD" "$B/wb.all" >"$B/c-mdcheck.out"
    md_ctl() { [ "$(count_matches -E ': no$' "$B/c-mdcheck.out")" -ge 1 ]; }
    check "control: the same check on a .txt cut to one row finds the .md does not match it" "$(yn md_ctl)"
    OLD8=records/m1p8-open-2026-09-24-da080f1
    python3 "$B/mdcheck.py" "$OLD8.txt" "$OLD8.md" "$B/wb.all" >"$B/c-prevmd.out"
    old_heading() { [ "$(count_matches -F 'the refused-inputs heading reads as ruled, once: no' "$B/c-prevmd.out")" = 1 ]; }
    check "control: the same check on part 8 P2's committed .md finds the old heading, not the ruled one" "$(yn old_heading)"
    totals_line() { [ "$(sed -n 's/^wrote .*\.txt: \(pairs [^;]*; lo_in [^;]*; lo [^;]*\); inputs refused .*/\1/p' "$B/oc.stdout")" = "$(sed -n 's/^totals: //p' "$B/mdcheck.out")" ]; }
    check "the script's totals line is the totals derived from the .txt" "$(yn totals_line)"
    echo
    echo "### the verdicts against part 3 P4's record"
    join -t "$TAB" <(tail -n +2 "$B/prev.txt" | cut -f1,6,7,8,9 | LC_ALL=C sort) <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) >"$B/both"
    check "every pair of part 3 P4's record has a row in this record" "$(yn [ "$(count_lines "$B/both")" = "$n_prev" ])"
    awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9 { print $1 "\t" $2 "/" $3 "/" $4 "/" $5 " -> " $6 "/" $7 "/" $8 "/" $9 }' "$B/both" >"$B/moved"
    echo "  part 3 P4's pairs whose lo_in, lo or either class changed: $(count_lines "$B/moved")"
    sed 's/^/    /' "$B/moved"
    check "no verdict and no class of part 3 P4's pairs moved" "$(yn [ "$(count_lines "$B/moved")" = 0 ])"
    printf 'x\tok\tok\tnone\tnone\tok\tfail\tnone\trefused\n' >"$B/c-both"
    moved_ctl() { [ "$(awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9' "$B/c-both" | wc -l)" = 1 ]; }
    check "control: the same form finds a planted row whose lo moved" "$(yn moved_ctl)"
    echo "  the new pairs' verdicts (test, lo_in, lo, reason_in, reason_out):"
    join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) | sed 's/^/    /'
    no_new_finding() { [ "$(join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7 | LC_ALL=C sort) | awk -F'\t' '$2 == "ok" && $3 != "ok"' | wc -l)" = 0 ]; }
    check "no new pair's output is refused on an accepted input" "$(yn no_new_finding)"
    echo
    echo "### acceptance, and the inputs LibreOffice did not accept"
    tail -n +2 "$TXT" | awk -F'\t' -v OFS='\t' '{ print ($1 ~ /^emend-copy\./ ? "tool" : "crate"), $1, $6, $7, $8, $9 }' >"$B/verdicts"
    for side in crate tool; do
      n=$(awk -F'\t' -v s="$side" '$1 == s' "$B/verdicts" | wc -l)
      nfind=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "ok" && $4 == "fail"' "$B/verdicts" | wc -l)
      nerr=$(awk -F'\t' -v s="$side" '$1 == s && ($3 == "error" || $4 == "error")' "$B/verdicts" | wc -l)
      nin=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "fail"' "$B/verdicts" | wc -l)
      echo "  $side: pairs $n; inputs refused $nin; outputs refused on an accepted input $nfind; checks that did not run $nerr"
      check "$side: no output refused on an accepted input" "$(yn [ "$nfind" = 0 ])"
      check "$side: no check errored" "$(yn [ "$nerr" = 0 ])"
    done
    awk -F'\t' '$5 == "count" { print $2 }' "$B/verdicts" >"$B/count.pairs"
    awk -F'\t' '$2 == "yes" && $3 == "0" { print $1 }' "$B/wb.all" >"$B/zero.pairs"
    echo "  count-class inputs $(count_lines "$B/count.pairs"); kept inputs with a workbook entry and no sheet element $(count_lines "$B/zero.pairs")"
    check "the count-class inputs are exactly the kept inputs with a workbook entry and no sheet element, so no count differs" "$(yn cmp -s "$B/count.pairs" "$B/zero.pairs")"
    echo "  the pairs whose input LibreOffice did not accept, with the class of the input's reason:"
    awk -F'\t' '$3 != "ok" { print $2 "\t" $5 }' "$B/verdicts" | sed 's/^/    /'
    echo
    echo "### the open-check record installed into records/"
    echo "command: install -m 644 <scripts>/out/records/$STEM_OPEN.md <scripts>/out/records/$STEM_OPEN.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST"/
    echo "  exit: $?"
    installed_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
    for f in "$STEM_OPEN.md" "$STEM_OPEN.txt"; do
      echo "    written <scripts>/out/records/$f: sha256 $(sha_of "$RECORDS/$f"), $(wc -c <"$RECORDS/$f") bytes"
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, byte for byte, mode 644" "$(yn installed_same "$f")"
    done
    TXT=$RECORDS_DEST/$STEM_OPEN.txt
    
    echo
    echo "## the two record pairs hold no path"
    no_path() {
      local f
      for f in "$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt" "$RECORDS_DEST/$STEM_RUN.md" "$RECORDS_DEST/$STEM_RUN.txt"; do
        [ "$(count_matches -F "$HOME" "$f")" = 0 ] || return 1
        [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$f")" = 0 ] || return 1
      done
    }
    check "no record file names <home>, a home, mount, temporary or corpus path" "$(yn no_path)"
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x' >"$B/c-path"
    path_ctl() { [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$B/c-path")" = 1 ]; }
    check "control: the same form finds a planted path" "$(yn path_ctl)"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  planning's uncommitted spec: $SPEC, sha256 $(sha_of "$SPEC")"
    echo "status lines: $st_all; of them this phase's logs, its record pairs or planning's uncommitted spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"
    
    
    
    

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

