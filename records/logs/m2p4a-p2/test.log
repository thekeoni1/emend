      check "$target: failed is 0" "$(yn [ "$failed" -eq 0 ])"
      check "$target: passed is more than 0 and equals the ok test lines" "$(yn passed_matches)"
      n=$(count_bytes "$CTRL_CLASS" "$T/$target.out")
      check "$target: control bytes in the cargo output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
      echo "$passed" >"$T/$target.count"
    done
    
    echo
    echo "## the feature on in the workspace run, read from the run (change AI)"
    # The names and links modules' tests compile only with `metadata`, and
    # emend-copy turns it on for the workspace (features unify), so both runs hold
    # them.
    for target in host i686-unknown-linux-musl; do
      nnames=$(count_matches -E '^package::tests::names::' "$T/$target.names")
      nlinks=$(count_matches -E '^package::tests::links::' "$T/$target.names")
      echo "  $target: names module tests passed $nnames; links module tests passed $nlinks"
      check "$target: the run holds the names module's tests, so the feature metadata was on" "$(yn [ "$nnames" -ge 1 ])"
      check "$target: the run holds the links module's tests" "$(yn [ "$nlinks" -ge 1 ])"
    done
    printf 'package::tests::rowcol::a\npackage::tests::names::b\n' >"$T/c-feat"
    check "control: the same count finds one names test in a list of two" "$(yn [ "$(count_matches -E '^package::tests::names::' "$T/c-feat")" = 1 ])"
    
    
    echo
    echo "## the tests per binary"
    per_binary() {
      awk '
        /^ *Running / {
          path = $NF
          gsub(/[()]/, "", path)
          parts = split(path, piece, "/")
          label = piece[parts]
          sub(/-[0-9a-f]+$/, "", label)
          current = (($2 == "unittests") ? "unittests " : "integration ") label
          next
        }
        /^ *Doc-tests / { current = "doc-tests " $2; next }
        /^test result: / {
          if (current == "") next
          for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n = $i
          printf "%s %d\n", current, n
          current = ""
        }
      ' "$1" | sort
    }
    for target in host i686-unknown-linux-musl; do
      per_binary "$T/$target.out" >"$T/$target.per"
    done
    sed 's/^/    /' "$T/host.per"
    sum_per=$(awk '{ n += $NF } END { print n + 0 }' "$T/host.per")
    echo "  the per-binary counts sum to $sum_per; the run's own passed total was $(cat "$T/host.count")"
    check "the per-binary counts sum to the run's passed total" \
      "$(yn [ "$sum_per" = "$(cat "$T/host.count")" ])"
    check "the two targets produce the same per-binary breakdown" \
      "$(yn cmp -s "$T/host.per" "$T/i686-unknown-linux-musl.per")"
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n' >"$T/c-per"
    per_binary "$T/c-per" >"$T/c-per.out"
    nctl_per=$(count_lines "$T/c-per.out")
    echo "  control: a result line with no Running line above it yields $nctl_per rows"
    check "control: the per-binary form attributes nothing to a binary it never saw named" \
      "$(yn [ "$nctl_per" = 0 ])"
    printf '     Running unittests src/lib.rs (target/debug/deps/libctl-0123456789abcdef)\ntest result: ok. 7 passed; 0 failed; 0 ignored\n' >"$T/c-per-hit"
    per_binary "$T/c-per-hit" >"$T/c-per-hit.out"
    sed 's/^/    control row: /' "$T/c-per-hit.out"
    check "control: a Running line and its result yield one row naming the crate and its count" \
      "$(yn [ "$(cat "$T/c-per-hit.out")" = "unittests libctl 7" ])"
    PREV_LOG=records/logs/m2p4a-p1/test.log
    PREV_TOTAL=$(sed -n 's/^host executed \([0-9]*\) tests;.*/\1/p' "$PREV_LOG")
    NOW_TOTAL=$(cat "$T/host.count")
    echo "  the workspace total: this phase $NOW_TOTAL, the previous phase $PREV_TOTAL (read from $PREV_LOG)"
    check "the previous phase's total was read from its committed log" "$(yn [ -n "$PREV_TOTAL" ])"
    awk '
      /^## cargo test --workspace \(host\)$/ { inblock = 1; next }
      /^## / { inblock = 0 }
      inblock && /^    test .* \.\.\. ok$/ { sub(/^    test /, ""); sub(/ \.\.\. ok$/, ""); print }
    ' "$PREV_LOG" | sort >"$T/prev.names"
    nprev_names=$(count_lines "$T/prev.names")
    echo "  test names the previous log's host run printed: $nprev_names"
    check "the previous log's names account for its whole host total" "$(yn [ "$nprev_names" = "$PREV_TOTAL" ])"
    comm -13 "$T/prev.names" "$T/host.names" >"$T/added.names"
    comm -23 "$T/prev.names" "$T/host.names" >"$T/removed.names"
    nadded=$(count_lines "$T/added.names")
    nremoved=$(count_lines "$T/removed.names")
    echo "  test names added since the previous phase: $nadded; removed: $nremoved"
    sed 's/^/    added: /' "$T/added.names"
    sed 's/^/    removed: /' "$T/removed.names"
    total_moved_by_names() {
      [ -n "$PREV_TOTAL" ] && [ "$NOW_TOTAL" -eq "$((PREV_TOTAL + nadded - nremoved))" ]
    }
    check "this phase's workspace total is the previous phase's plus the names added less the names removed" \
      "$(yn total_moved_by_names)"
    comm -3 "$T/prev.names" "$T/prev.names" >"$T/c-names"
    check "control: the same comparison of a list with itself finds no difference" \
      "$(yn [ "$(count_lines "$T/c-names")" = 0 ])"
    { cat "$T/prev.names"; echo "zzz::control::name"; } | sort >"$T/c-names-plus"
    check "control: a list with one name more is found to add exactly one" \
      "$(yn [ "$(comm -13 "$T/prev.names" "$T/c-names-plus" | wc -l)" = 1 ])"
    
    echo
    echo "## the tests this phase adds and removes, and the tests the feature gates off, derived from the source (change AI)"
    BASE_DOC=$(git log --format='%H' -n 1 --grep='^M2 part 4a P2: commit planning docs [(]the P1 rulings and verification[)]' "$C")
    BASE=$(git rev-parse --verify "$BASE_DOC^" 2>/dev/null)
    echo "command: git log --format=%H -n 1 --grep=<the first doc commit's subject> <phase commit>, and its parent"
    echo "  the first doc commit: $BASE_DOC; the phase base: $BASE"
    check "the phase base resolved from git" "$(yn [ -n "$BASE" ])"
    check "the phase base is P1's record commit" "$(yn [ "$BASE" = "$REC" ])"
    tests_attr() { git show "$1:$2" 2>/dev/null | tests_in; }
    tests_in() {
      awk '
        /^[ \t]*#\[test\][ \t]*$/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]/ {
          sub(/^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next
        }
        t { t = 0 }' | sort
    }
    # gated_off_in: the tests whose attributes, before the fn line, hold the
    # metadata feature's negation and #[test].
    gated_off_in() {
      awk '
        index($0, "#[cfg(not(feature = \"metadata\"))]") { g = 1; next }
        /^[ \t]*#\[test\][ \t]*$/ { if (g) t = 1; next }
        /^[ \t]*#\[/ { next }
        /^[ \t]*(pub[ \t]+)?fn[ \t]/ {
          if (t) { sub(/^[ \t]*(pub[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print }
          g = 0; t = 0; next
        }
        { g = 0; t = 0 }' | sort
    }
    added_between() {
      # $1 older commit, $2 newer commit: "<file> <name>" per #[test] the newer
      # commit has in a .rs file the pair's diff touches and the older lacks.
      local f
      git diff --name-only "$1" "$2" -- '*.rs' | while IFS= read -r f; do
        tests_attr "$2" "$f" >"$T/ab-new"
        tests_attr "$1" "$f" >"$T/ab-old"
        comm -13 "$T/ab-old" "$T/ab-new" | sed "s#^#$f #"
      done
    }
    removed_between() { added_between "$2" "$1"; }
    git diff --name-only "$BASE" "$C" -- '*.rs' >"$T/changed-rs"
    echo "  the .rs files the phase changed: $(count_lines "$T/changed-rs")"
    sed 's/^/    /' "$T/changed-rs"
    added_between "$BASE" "$C" >"$T/src-added"
    removed_between "$BASE" "$C" >"$T/src-removed"
    : >"$T/src-gated"
    : >"$T/src-gated-base"
    while IFS= read -r f; do
      git show "$C:$f" 2>/dev/null | gated_off_in | sed "s#^#$f #" >>"$T/src-gated"
      git show "$BASE:$f" 2>/dev/null | gated_off_in | sed "s#^#$f #" >>"$T/src-gated-base"
    done <"$T/changed-rs"
    echo "  #[test] functions at the phase commit and not at the base, by file:"
    sed 's/^/    /' "$T/src-added"
    echo "  #[test] functions at the base and not at the phase commit, by file:"
    sed 's/^/    /' "$T/src-removed"
    echo "  #[test] functions the phase commit gates off under the feature metadata, by file:"
    sed 's/^/    /' "$T/src-gated"
    echo "  #[test] functions the base gates off under the feature metadata, in the same files:"
    sed 's/^/    /' "$T/src-gated-base"
    LC_ALL=C comm -13 <(LC_ALL=C sort "$T/src-gated-base") <(LC_ALL=C sort "$T/src-gated") >"$T/src-newly-gated"
    nsrc_added=$(count_lines "$T/src-added")
    nsrc_removed=$(count_lines "$T/src-removed")
    nsrc_gated=$(count_lines "$T/src-gated")
    check "the source adds tests in this phase ($nsrc_added)" "$(yn [ "$nsrc_added" -ge 1 ])"
    check "the source removes no test in this phase ($nsrc_removed)" "$(yn [ "$nsrc_removed" = 0 ])"
    check "the source gates at least one test off under the feature ($nsrc_gated)" "$(yn [ "$nsrc_gated" -ge 1 ])"
    check "the phase gates off no test the base did not ($(count_lines "$T/src-newly-gated"))" "$(yn [ "$(count_lines "$T/src-newly-gated")" = 0 ])"
    awk '{ print $2 }' "$T/src-added" | sort >"$T/src-added.names"
    { awk '{ print $2 }' "$T/src-removed"; awk '{ print $2 }' "$T/src-newly-gated"; } | sort >"$T/src-lost.names"
    sed 's/^.*:://' "$T/added.names" | sort >"$T/run-added.names"
    sed 's/^.*:://' "$T/removed.names" | sort >"$T/run-removed.names"
    check "the names the workspace run added are exactly the tests the source added" \
      "$(yn cmp -s "$T/run-added.names" "$T/src-added.names")"
    check "the names the workspace run lost are exactly the tests the source removed or newly gates off under the feature" \
      "$(yn cmp -s "$T/run-removed.names" "$T/src-lost.names")"
    printf '#[cfg(not(feature = "metadata"))]\n#[test]\nfn ctl_gated() {}\n#[test]\nfn ctl_plain() {}\n#[cfg(feature = "metadata")]\n#[test]\nfn ctl_on() {}\n' >"$T/c-gated"
    gated_off_in <"$T/c-gated" >"$T/c-gated.names"
    check "control: gated_off_in reads the one test gated off and neither the plain nor the gated-on one" "$(yn [ "$(cat "$T/c-gated.names")" = ctl_gated ])"
    passed_on() { count_matches -E "(^|::)$1\$" "$T/$2.names"; }
    both_passed() {
      [ "$(passed_on "$1" host)" = 1 ] && [ "$(passed_on "$1" i686-unknown-linux-musl)" = 1 ]
    }
    echo "  each added test, and whether it ran and passed on each target:"
    while read -r f name; do
      echo "    $name ($f): host $(passed_on "$name" host), i686-unknown-linux-musl $(passed_on "$name" i686-unknown-linux-musl)"
      check "  $name passed on both targets" "$(yn both_passed "$name")"
    done <"$T/src-added"
    not_passed_ctl() { if both_passed zzz_no_such_test_anywhere; then return 1; else return 0; fi; }
    check "control: both_passed refuses a name no run holds" "$(yn not_passed_ctl)"
    n_ctl_tests=$(tests_attr "$C" crates/emend/src/archive/tests.rs | count_lines /dev/stdin)
    check "control: the same form finds the #[test] functions of archive/tests.rs at the phase commit ($n_ctl_tests)" "$(yn [ "$n_ctl_tests" -ge 1 ])"
    
    echo
    echo "## the crate's own tests with the feature off and with metadata on, both targets (change AI)"
    CRATE_TARGET=$BUILD_ROOT/crate-target
    for target in host i686-unknown-linux-musl; do
      for feat in off on; do
        args=(test -p emend)
        [ "$target" = host ] || args+=(--target "$target")
        [ "$feat" = on ] && args+=(--features metadata)
        echo "command: CARGO_TARGET_DIR=<build>/crate-target cargo ${args[*]}"
        CARGO_TARGET_DIR=$CRATE_TARGET cargo "${args[@]}" >"$T/crate-$target-$feat.out" 2>&1 </dev/null
        rc=$?
        LC_ALL=C "$G" -E '^test result: ' "$T/crate-$target-$feat.out" | sed 's/^/    /'
        LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/crate-$target-$feat.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/crate-$target-$feat.names"
        cfail=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$T/crate-$target-$feat.out")
        cn=$(count_lines "$T/crate-$target-$feat.names")
        cnames=$(count_matches -E '^package::tests::(names|links)::' "$T/crate-$target-$feat.names")
        echo "  $target, feature $feat: exit $rc; failed $cfail; ok test lines $cn; of them in the names and links modules $cnames"
        crate_ok() { [ "$1" = 0 ] && [ "$2" = 0 ] && [ "$3" -gt 0 ]; }
        check "$target, feature $feat: the crate's tests exit 0, none failed, some ran" "$(yn crate_ok "$rc" "$cfail" "$cn")"
        if [ "$feat" = on ]; then
          check "$target, feature on: the names and links modules' tests ran" "$(yn [ "$cnames" -ge 1 ])"
        else
          check "$target, feature off: no names or links module test ran" "$(yn [ "$cnames" = 0 ])"
        fi
        while read -r f name; do
          ngated=$(count_matches -E "(^|::)$name\$" "$T/crate-$target-$feat.names")
          echo "    the gated-off test $name ran and passed $ngated time(s)"
          if [ "$feat" = on ]; then
            check "$target, feature on: $name does not run" "$(yn [ "$ngated" = 0 ])"
          else
            check "$target, feature off: $name runs and passes" "$(yn [ "$ngated" = 1 ])"
          fi
        done <"$T/src-gated"
      done
    done
    check "the host and i686 crate runs pass the same names with the feature off" "$(yn cmp -s "$T/crate-host-off.names" "$T/crate-i686-unknown-linux-musl-off.names")"
    check "the host and i686 crate runs pass the same names with the feature on" "$(yn cmp -s "$T/crate-host-on.names" "$T/crate-i686-unknown-linux-musl-on.names")"
    check "control: the same comparison finds the off and on runs differ" "$(yn [ "$(comm -3 "$T/crate-host-off.names" "$T/crate-host-on.names" | count_lines /dev/stdin)" -ge 1 ])"
    
    echo
    echo "## the workspace's emend unit-test binary beside the crate's own runs (change AB)"
    # The workspace builds emend with dates, rowcol and metadata, since emend-copy
    # enables all three. Both crate runs are made here and read per binary.
    for feats in rowcol,metadata dates,rowcol,metadata; do
      echo "command: CARGO_TARGET_DIR=<build>/crate-target cargo test -p emend --features $feats (host)"
      CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --features "$feats" >"$T/crate-$feats.out" 2>&1 </dev/null
      printf '%s' "$?" >"$T/crate-$feats.rc"
      echo "  exit: $(cat "$T/crate-$feats.rc")"
      per_binary "$T/crate-$feats.out" >"$T/crate-$feats.per"
      sed 's/^/    /' "$T/crate-$feats.per"
    done
    unit_row() { awk '$1 == "unittests" && $2 == "emend" { print $3 }' "$1"; }
    UW=$(unit_row "$T/host.per")
    URM=$(unit_row "$T/crate-rowcol,metadata.per")
    UDRM=$(unit_row "$T/crate-dates,rowcol,metadata.per")
    NDATES=$(count_matches -E '^dates::' "$T/host.names")
    echo "  the emend unit-test binary: the workspace run $UW; the crate with rowcol and metadata $URM; the crate with dates, rowcol and metadata $UDRM"
    echo "  test names under dates:: in the workspace's host run: $NDATES; the workspace's binary less the rowcol and metadata run's: $(( ${UW:-0} - ${URM:-0} ))"
    crate_runs_ok() { [ "$(cat "$T/crate-rowcol,metadata.rc")" = 0 ] && [ "$(cat "$T/crate-dates,rowcol,metadata.rc")" = 0 ] && [ -n "$UW" ] && [ -n "$URM" ] && [ -n "$UDRM" ]; }
    check "both crate runs exit 0 and every emend unit-test row was read" "$(yn crate_runs_ok)"
    check "the crate with dates, rowcol and metadata runs the workspace's emend binary, test for test by count" "$(yn [ "$UDRM" = "$UW" ])"
    dates_is_difference() { [ "$NDATES" -ge 1 ] && [ "$((UW - URM))" = "$NDATES" ]; }
    check "the workspace's binary less the rowcol and metadata run's is exactly the dates module's tests" "$(yn dates_is_difference)"
    printf 'unittests emend 5\nunittests emend_copy 0\nintegration p1 3\n' >"$T/c-unit"
    check "control: unit_row reads the emend row and no other" "$(yn [ "$(unit_row "$T/c-unit")" = 5 ])"
    
    echo
    echo "## the links template test's printed worksheet and rels part (change AJ; specs/0019 \"P2\")"
    TPL_TEST=package::tests::links::the_template_part_is_retagged_and_its_container_and_rels_part_created_at_the_end
    echo "command: cargo test -p emend --features metadata --lib $TPL_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features metadata --lib "$TPL_TEST" -- --exact --nocapture >"$T/tpl.out" 2>&1 </dev/null
    tplrc=$?
    echo "exit: $tplrc"
    TPL_SHEET='template worksheet after the links: '
    TPL_RELS="template worksheet's created rels part: "
    # Each printed part is the declaration, a line feed and the root, so a
    # printed part is the prefixed line and the one after it.
    printed_part() { awk -v p="$1" 'index($0, p) == 1 { print; getline; print; exit }' "$2"; }
    printed_part "$TPL_SHEET" "$T/tpl.out" >"$T/tpl.sheet"
    printed_part "$TPL_RELS" "$T/tpl.out" >"$T/tpl.rels"
    sed 's/^/    /' "$T/tpl.sheet"
    sed 's/^/    /' "$T/tpl.rels"
    LC_ALL=C "$G" -E '^test result: ' "$T/tpl.out" | sed 's/^/    /'
    tpl_passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/tpl.out")
    MAIN_URI=http://schemas.openxmlformats.org/spreadsheetml/2006/main
    REL_URI=http://schemas.openxmlformats.org/officeDocument/2006/relationships
    SHEET_ROOT="<worksheet xmlns=\"$MAIN_URI\" xmlns:r=\"$REL_URI\"><sheetData/><hyperlinks><hyperlink ref=\"A1\" r:id=\"rId1\"/><hyperlink ref=\"B1\" location=\"Sheet1!A1\"/></hyperlinks></worksheet>"
    RELS_TAIL="<Relationship Id=\"rId1\" Type=\"$REL_URI/hyperlink\" Target=\"https://example.com/\" TargetMode=\"External\"/></Relationships>"
    sheet_is() { [ "$(count_lines "$1")" = 2 ] && [ "$(sed -n 2p "$1")" = "$SHEET_ROOT" ]; }
    rels_end() { [ "$(count_lines "$1")" = 2 ] && [ "$(awk -v t="$RELS_TAIL" 'NR == 2 { print (substr($0, length($0) - length(t) + 1) == t) }' "$1")" = 1 ]; }
    tpl_ran() { [ "$tplrc" = 0 ] && [ "$tpl_passed" = 1 ]; }
    check "the links template test ran alone and passed" "$(yn tpl_ran)"
    check "it printed the worksheet, its root line the retagged root, the sheet data and the created container" "$(yn sheet_is "$T/tpl.sheet")"
    check "it printed the created rels part, its root line ending with the one external relationship" "$(yn rels_end "$T/tpl.rels")"
    printf '%s<?xml version="1.0"?>\n<worksheet xmlns="%s"><sheetData/></worksheet>\n' "$TPL_SHEET" "$MAIN_URI" >"$T/c-tpl"
    sheet_ctl() { if sheet_is "$T/c-tpl"; then return 1; else return 0; fi; }
    check "control: the same check refuses a worksheet not retagged and without links" "$(yn sheet_ctl)"
    printf '%s<?xml version="1.0"?>\n<Relationships></Relationships>\n' "$TPL_RELS" >"$T/c-rels"
    rels_ctl() { if rels_end "$T/c-rels"; then return 1; else return 0; fi; }
    check "control: the same check refuses a rels part without the relationship" "$(yn rels_ctl)"
    
    echo
    echo "## the calcPr tests, unedited since the base and passing (P1's change AD, kept)"
    # test_body <commit> <file> <name>: the #[test] fn's lines, from the fn line
    # to the first line that is a closing brace at the left margin.
    test_body() {
      git show "$1:$2" 2>/dev/null | awk -v n="$3" '
        $0 ~ "^fn " n "[(]" { on = 1 }
        on { print }
        on && /^}$/ { exit }'
    }
    PKG_TESTS=crates/emend/src/package/tests.rs
    tests_attr "$C" "$PKG_TESTS" | LC_ALL=C "$G" -E 'calc_pr|full_calc|recalculate' >"$T/calc-tests" || :
    echo "  the calcPr tests in $PKG_TESTS at the phase commit, by name:"
    sed 's/^/    /' "$T/calc-tests"
    check "some calcPr tests were found" "$(yn [ "$(count_lines "$T/calc-tests")" -ge 1 ])"
    body_same() {
      test_body "$BASE" "$2" "$1" >"$T/body-base"
      test_body "$C" "$2" "$1" >"$T/body-head"
      [ "$(count_lines "$T/body-base")" -ge 2 ] && cmp -s "$T/body-base" "$T/body-head"
    }
    while IFS= read -r name; do
      echo "    $name: body lines at the base $(test_body "$BASE" "$PKG_TESTS" "$name" | count_lines /dev/stdin), at the phase commit $(test_body "$C" "$PKG_TESTS" "$name" | count_lines /dev/stdin); passed host $(passed_on "$name" host), i686 $(passed_on "$name" i686-unknown-linux-musl)"
      check "  $name: its body is the base's, byte for byte" "$(yn body_same "$name" "$PKG_TESTS")"
      check "  $name: passed on both targets" "$(yn both_passed "$name")"
    done <"$T/calc-tests"
    body_ctl() { if body_same a_second_defined_names_is_refused crates/emend/src/package/tests/names.rs; then return 1; else return 0; fi; }
    check "control: the same comparison finds the names test this phase edits changed" "$(yn body_ctl)"
    
    echo
    echo "## the shift rule's table, printed by its test (specs/0018 \"P2\", P2's change L, kept)"
    SH_TEST=package::tests::shift::the_rule_moves_indices_and_intervals_as_the_table_gives
    echo "command: cargo test -p emend --features rowcol --lib $SH_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features rowcol --lib "$SH_TEST" -- --exact --nocapture >"$T/sh.out" 2>&1 </dev/null
    shrc=$?
    echo "exit: $shrc"
    LC_ALL=C "$G" -E '^shift ' "$T/sh.out" >"$T/sh.lines"
    sed 's/^/    /' "$T/sh.lines"
    LC_ALL=C "$G" -E '^test result: ' "$T/sh.out" | sed 's/^/    /'
    sh_passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/sh.out")
    nsh=$(count_lines "$T/sh.lines")
    # The cases the test pins, counted in its source at the phase commit: an
    # index row (shift, i, Some|None), an interval row (shift, a, b, Moved::),
    # and each clip call.
    SH_ROW_RE='^ *[(](ins|del), [0-9]+, (Some[(][0-9]+[)]|None|[0-9]+, Moved::[A-Za-z]+([(][0-9]+, [0-9]+[)])?)[)],$'
    git show "$C:crates/emend/src/package/tests/shift.rs" >"$T/sh-src"
    nsh_rows=$(count_matches -E "$SH_ROW_RE" "$T/sh-src")
    nsh_clips=$(count_matches -F '.area_clipped(Area::parse(' "$T/sh-src")
    echo "  shift lines printed: $nsh; rows the test pins: $nsh_rows; clip calls: $nsh_clips; tests the run passed: $sh_passed"
    sh_ran() { [ "$shrc" -eq 0 ] && [ "$sh_passed" = 1 ]; }
    check "the shift table test ran alone and passed" "$(yn sh_ran)"
    sh_rows() { [ "$nsh" -ge 1 ] && [ "$nsh" = "$((nsh_rows + nsh_clips))" ]; }
    check "one printed line per pinned case, and at least one" "$(yn sh_rows)"
    printf '        (ins, 4, Some(4)),\n        (del, 5, 6, Moved::Gone),\n        (del, 3, 5, Moved::Changed(3, 4)),\n    let x = 1;\n' >"$T/c-sh"
    check "control: the row form counts three pinned rows of four lines" "$(yn [ "$(count_matches -E "$SH_ROW_RE" "$T/c-sh")" = 3 ])"
    
    echo
    echo "## the keyword table, printed by its test (specs/0017 \"P1\")"
    KW_TEST=styles::elements::tests::every_keyword_is_the_schemas_spelling
    echo "command: cargo test -p emend --lib $KW_TEST -- --exact --nocapture (host)"
    cargo test -p emend --lib "$KW_TEST" -- --exact --nocapture >"$T/kw.out" 2>&1 </dev/null
    kwrc=$?
    echo "exit: $kwrc"
    LC_ALL=C "$G" -E '^keyword ' "$T/kw.out" >"$T/kw.lines"
    sed 's/^/    /' "$T/kw.lines"
    LC_ALL=C "$G" -E '^test result: ' "$T/kw.out" | sed 's/^/    /'
    kw_passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/kw.out")
    nkw=$(count_lines "$T/kw.lines")
    # The rows the test pins, counted in its source at the phase commit as
    # occurrences, not lines (two rows can share a line): a variant and a quoted
    # spelling in parentheses.
    ROW_RE='[(](Underline|VerticalAlign|Scheme|Pattern|BorderStyle|Horizontal|Vertical)::[A-Za-z0-9]+, "[A-Za-z0-9]+"[)]'
    rows_in() { LC_ALL=C "$G" -o -E "$ROW_RE" "$1" | count_lines /dev/stdin; }
    git show "$C:crates/emend/src/styles/elements/tests.rs" >"$T/kw-src"
    nrows=$(rows_in "$T/kw-src")
    echo "  keyword lines printed: $nkw; rows the test pins in its source: $nrows; tests the run passed: $kw_passed"
    kw_ran() { [ "$kwrc" -eq 0 ] && [ "$kw_passed" = 1 ]; }
    check "the keyword test ran alone and passed" "$(yn kw_ran)"
    kw_rows() { [ "$nkw" -ge 1 ] && [ "$nkw" = "$nrows" ]; }
    check "one printed line per pinned row, and at least one" "$(yn kw_rows)"
    # Each printed keyword is its variant's name with the first letter lowered,
    # which is the lower camel case every keyword specs/0017 names takes.
    lowered_mismatch() {
      awk '{ n = split($2, p, "::"); v = p[n]; want = tolower(substr(v, 1, 1)) substr(v, 2); if ($3 != want) bad++ } END { print bad + 0 }' "$1"
    }
    nbad=$(lowered_mismatch "$T/kw.lines")
    echo "  printed keywords that are not the variant's name with its first letter lowered: $nbad"
    check "every printed keyword is its variant's name with the first letter lowered" "$(yn [ "$nbad" = 0 ])"
    printf 'keyword Pattern::DarkGray darkgray\nkeyword Scheme::Major major\n' >"$T/c-kw"
    check "control: the same comparison finds one misspelled keyword of two" "$(yn [ "$(lowered_mismatch "$T/c-kw")" = 1 ])"
    printf '        &[(Scheme::Major, "major"), (Scheme::Minor, "minor")],\n        (BorderStyle::Thin, "thin")\n    pinned(\n' >"$T/c-rows"
    check "control: the row form counts three rows on two lines of three" "$(yn [ "$(rows_in "$T/c-rows")" = 3 ])"
    
    echo
    echo "## no test sets EMEND_KEEP_DIR (specs/0015 P1 ruling 3, unchanged by this phase)"
    # The variable's name appears in the source only as the two KEEP_VARIABLE
    # constants, and nothing under crates/ or tools/ calls set_var or remove_var.
    echo "command: git grep -n -F EMEND_KEEP_DIR <phase commit> -- crates tools"
    git grep -n -F EMEND_KEEP_DIR "$C" -- crates tools | sed "s#^$C:##" >"$T/keep-var"
    sed 's/^/    /' "$T/keep-var"
    only_constants() {
      [ "$(count_lines "$T/keep-var")" = 2 ] &&
        [ "$(count_matches -E 'const KEEP_VARIABLE: &str = "EMEND_KEEP_DIR";$' "$T/keep-var")" = 2 ]
    }
    check "EMEND_KEEP_DIR is named only by the two KEEP_VARIABLE constants" "$(yn only_constants)"
    echo "command: git grep -n -E 'set_var|remove_var' <phase commit> -- crates tools"
    git grep -n -E 'set_var|remove_var' "$C" -- crates tools | sed "s#^$C:##" >"$T/set-var"
    sed 's/^/    /' "$T/set-var"
    check "nothing under crates/ or tools/ calls set_var or remove_var ($(count_lines "$T/set-var"))" "$(yn [ "$(count_lines "$T/set-var")" = 0 ])"
    printf 'x.rs:1:    unsafe { std::env::set_var("EMEND_KEEP_DIR", "d") };\n' >"$T/c-set-var"
    check "control: the same pattern finds a set_var line" "$(yn [ "$(count_matches -E 'set_var|remove_var' "$T/c-set-var")" = 1 ])"
    
    echo
    echo "## the ignored tests, derived from the source"
    ignored_in() {
      awk '
        /^[ \t]*#\[ignore/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?fn[ \t]/ { sub(/^[ \t]*(pub[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next }
        t { t = 0 }'
    }
    ignored_at() {
      git ls-tree -r --name-only "$1" | LC_ALL=C "$G" -E '[.]rs$' | while IFS= read -r f; do
        git show "$1:$f" | ignored_in
      done | sort
    }
    ignored_at "$BASE" >"$T/ign-base"
    ignored_at "$C" >"$T/ign-c"
    sed 's/^/    ignored in the source at the base: /' "$T/ign-base"
    sed 's/^/    ignored in the source at the phase commit: /' "$T/ign-c"
    check "the phase commit ignores exactly the tests the base ignored" "$(yn cmp -s "$T/ign-base" "$T/ign-c")"
    for target in host i686-unknown-linux-musl; do
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" | sed 's/^/    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" |
        sed -E 's/^test ([^ ]*) \.\.\. ignored.*/\1/; s/^.*:://' | sort >"$T/ign-run-$target"
      check "$target: the run's ignored tests are exactly the source's ($(count_lines "$T/ign-run-$target"))" \
        "$(yn cmp -s "$T/ign-run-$target" "$T/ign-c")"
    done
    printf '#[test]\n#[ignore = "why"]\n#[cfg(unix)]\nfn ctl_ignored() {}\n#[test]\nfn ctl_run() {}\n' | ignored_in >"$T/c-ign"
    check "control: ignored_in reads the one ignored fixture test ($(tr '\n' ' ' <"$T/c-ign"))" \
      "$(yn [ "$(cat "$T/c-ign")" = ctl_ignored ])"
    { cat "$T/ign-c"; echo zzz_control; } | sort >"$T/c-ign-plus"
    check "control: the same comparison refuses a set one name longer" \
      "$(yn [ "$(comm -3 "$T/c-ign-plus" "$T/ign-c" | count_lines /dev/stdin)" = 1 ])"
    
    echo
    echo "## seven planted changes to this phase's code, each against its named test (change AK)"
    # An archive copy of the phase commit, never <repo>. Each plant replaces one
    # exact text, found once, in a fresh copy of its file; the named test runs
    # alone. The control is the same test in the unplanted copy, which passes.
    SRC=$T/src
    mkdir -p "$SRC" || fail=1
    echo "command: git archive <phase commit> | tar -x -C <scratch>/w/src"
    git archive "$C" | tar -x -C "$SRC"
    echo "  files extracted: $(find "$SRC" -type f | count_lines /dev/stdin)"
    PLANT_TARGET=$BUILD_ROOT/plant-target
    # plant_apply <id> <file>: replaces the plant's text in <file>, printing the
    # number of times the text was found before the replacement.
    plant_apply() {
      python3 - "$1" "$2" <<'PLANTS'
    import sys
    pid, path = sys.argv[1:3]
    plants = {
        "L1": (".filter(|(_, (at, _))| Some(*at) == cell)",
               ".filter(|(_, (at, _))| Some(*at) == cell && false)"),
        "L2": ("self.dropped.push(attribute.value.as_bytes().to_vec());",
               "let _ = attribute.value.as_bytes();"),
        "L3": ("if buffer.kept == 0 && sets.is_empty() {",
               "if false && buffer.kept == 0 && sets.is_empty() {"),
        "L4": ("if !external {", "if true || !external {"),
        "L5": ("if matches!(edit, LinkEdit::Remove) && !self.found[which] {",
               "if false && matches!(edit, LinkEdit::Remove) && !self.found[which] {"),
        "L6": ('name.eq_ignore_ascii_case("r")', 'name.is_empty()'),
        "L7": ("if links_after != links_before + 2 {", "if links_after != links_before + 3 {"),
    }
    old, new = plants[pid]
    text = open(path).read()
    print(text.count(old))
    if text.count(old) == 1:
        open(path, "w").write(text.replace(old, new))
    PLANTS
    }
    # id | file | what the plant does | cargo arguments before the name | the test
    cat >"$T/plants" <<'TABLE'
    L1|crates/emend/src/package.rs|a link on an edited cell is never matched, so never skipped|-p emend --features metadata --lib|package::tests::links::a_set_on_a_linked_cell_replaces_the_link_and_removes_its_relationship
    L2|crates/emend/src/package.rs|a skipped link's r:id is never recorded, so its relationship stays|-p emend --features metadata --lib|package::tests::links::a_removal_drops_a_link_with_or_without_r_id_and_the_last_drops_the_container
    L3|crates/emend/src/package.rs|a hyperlinks the write empties is never dropped|-p emend --features metadata --lib|package::tests::links::a_removal_drops_a_link_with_or_without_r_id_and_the_last_drops_the_container
    L4|crates/emend/src/package.rs|a root binding no relationships prefix is never retagged|-p emend --features metadata --lib|package::tests::links::the_template_part_is_retagged_and_its_container_and_rels_part_created_at_the_end
    L5|crates/emend/src/package.rs|a removal of a link the part does not have is not refused|-p emend --features metadata --lib|package::tests::links::a_removal_of_an_absent_link_or_of_one_whose_ref_is_a_range_is_refused
    L6|crates/emend/src/package.rs|the name rule's clause refusing R alone is dropped|-p emend --features metadata --lib|package::tests::names::the_name_rule_refuses_each_clause_and_records_nothing
    L7|tools/emend-copy/src/main.rs|the tool asserts three more links where the sample adds two|-p emend-copy --test null_rewrite|the_link_sample_adds_a_cell_and_two_links_and_retags_a_root_with_no_r_prefix
    TABLE
    sed 's/^/    plant: /' "$T/plants"
    nplants=$(count_lines "$T/plants")
    echo "  plants in the table: $nplants"
    check "the table holds seven plants" "$(yn [ "$nplants" = 7 ])"
    # run_one <label> <cargo args> <test>: runs one test in the archive copy; the
    # exit status and the output go to <scratch>/w/plant-<label>.
    run_one() {
      local label=$1 args=$2 name=$3
      ( cd "$SRC" && CARGO_TARGET_DIR=$PLANT_TARGET cargo test $args "$name" -- --exact ) \
        >"$T/plant-$label.out" 2>&1 </dev/null
      echo $? >"$T/plant-$label.rc"
    }
    # The lines a failing test prints that say what failed: its FAILED line, the
    # panic line, the message line after it (P1's change AF), and the assertion's
    # left and right.
    failure_lines() {
      awk '/panicked at/ { print; if ((getline line) > 0) print line; next }
           /^test .* \.\.\. (ok|FAILED)$|^  left:|^ right:|^assertion/ { print }' "$1" | head -n 14
    }
    test_line_is() { LC_ALL=C "$G" -a -qxF "test $1 ... $2" "$3"; }
    plant_ok() {
      local id=$1 name=$2
      [ "$(cat "$T/plant-$id.found")" = 1 ] || return 1
      [ "$(cat "$T/plant-$id-clean.rc")" = 0 ] || return 1
      test_line_is "$name" ok "$T/plant-$id-clean.out" || return 1
      [ "$(cat "$T/plant-$id.rc")" != 0 ] || return 1
      test_line_is "$name" FAILED "$T/plant-$id.out"
    }
    while IFS='|' read -r id file what args name; do
      echo "  plant $id: $what ($file)"
      echo "    command (control, unplanted): cargo test $args $name -- --exact"
      run_one "$id-clean" "$args" "$name"
      echo "    control exit: $(cat "$T/plant-$id-clean.rc")"
      failure_lines "$T/plant-$id-clean.out" | sed 's/^/      /'
      cp "$SRC/$file" "$T/pristine"
      plant_apply "$id" "$SRC/$file" >"$T/plant-$id.found"
      echo "    the plant's text found in the file: $(cat "$T/plant-$id.found") time(s)"
      echo "    command (planted): cargo test $args $name -- --exact"
      run_one "$id" "$args" "$name"
      echo "    planted exit: $(cat "$T/plant-$id.rc")"
      failure_lines "$T/plant-$id.out" | sed 's/^/      /'
      cp "$T/pristine" "$SRC/$file"
      check "  plant $id: found once, the test passes unplanted and fails planted" "$(yn plant_ok "$id" "$name")"
    done <"$T/plants"
    restored() { git show "$C:tools/emend-copy/src/main.rs" | cmp -s - "$SRC/tools/emend-copy/src/main.rs"; }
    check "the last plant's file is restored to the phase commit's bytes" "$(yn restored)"
    printf "thread 'x' panicked at a.rs:1:1:\nthe planted message\n" >"$T/c-panic"
    fl_message() { [ "$(failure_lines "$T/c-panic" | sed -n 2p)" = "the planted message" ]; }
    check "control: failure_lines prints the message line after a panic line" "$(yn fl_message)"
    printf 'test x::y ... ok\n' >"$T/c-tl"
    check "control: test_line_is finds an ok line" "$(yn test_line_is x::y ok "$T/c-tl")"
    not_failed_ctl() { if test_line_is x::y FAILED "$T/c-tl"; then return 1; else return 0; fi; }
    check "control: test_line_is refuses FAILED for a test that passed" "$(yn not_failed_ctl)"
    printf 'no such text\n' >"$T/c-plant.rs"
    check "control: plant_apply finds L1's text 0 times in a file without it" "$(yn [ "$(plant_apply L1 "$T/c-plant.rs")" = 0 ])"
    
    echo
    echo "## the two runs"
    echo "host executed $(cat "$T/host.count") tests; i686-unknown-linux-musl executed $(cat "$T/i686-unknown-linux-musl.count") tests"
    check "the i686 run executed the same test names as the host run" "$(yn cmp -s "$T/host.names" "$T/i686-unknown-linux-musl.names")"
    echo
    echo "## status after the runs"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS_RE" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or its records: $st_ours"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]
    }
    check "every change in the working tree is one of this phase's logs or its records" "$(yn status_accounted)"
    printf '?? records/m2p4a-open-x.md\n M scripts/check.sh\n?? records/m2p4a-p2-x.md\n?? records/m2p4a-p1-x.md\n M specs/0019-names-links-properties-protection.md\n' >"$T/c-status"
    check "control: the same pattern finds two of five status lines" "$(yn [ "$(count_matches -E "$OURS_RE" "$T/c-status")" = 2 ])"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$T/c-err"; printf 'x' >>"$T/c-err"
    nerr_ctl=$(wc -c <"$T/c-err")
    echo "  command: wc -c <phase>/out/test.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
