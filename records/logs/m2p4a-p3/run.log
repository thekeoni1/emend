    #!/usr/bin/env bash
    # Milestone 2 part 4a P3 run.log (specs/0019-names-links-properties-
    # protection.md, "P3: properties and protection" and "Harness runs",
    # `--props-sample` and `--protect-sample` and P3, with "Planning verification
    # and rulings on P2", ruling 8):
    #   1. the release binaries built at the phase commit on both targets and
    #      hashed;
    #   2. two corpus runs, each on both targets in its own run directory:
    #      --tool-arg --props-sample into <date>-<short>-props and
    #      --tool-arg --protect-sample into <date>-<short>-protect, recorded as
    #      m2p4a-p3-props-<utc-date>-<shortsha> and m2p4a-p3-protect-<utc-date>-
    #      <shortsha>, .md and .txt, each record checked against its run
    #      directory table by table;
    #   3. the run log's own comparisons (propscmp.py and protectcmp.py,
    #      python3, zipfile, byte spans and ElementTree, printed below) over every
    #      output of both labels of each sample, each tool line's counts against
    #      the comparison's, a planted control per flag, the two labels' outputs
    #      byte for byte;
    #   4. P2 verification ruling 8: the retag planted on a byte-built workbook
    #      whose root binds no relationships prefix (the template's parts at the
    #      phase commit), --link-sample on it and P2's linkscmp.py over the pair;
    #   5. the keep regenerated on both targets, compared, and against P2's
    #      committed open-check record; the edit open check over the host keep,
    #      recorded as m2p4a-open-<utc-date>-<shortsha>;
    #   6. this script's own standard error counted (specs/0017 P1 verification
    #      ruling 7).
    # No value, text, sheet name, reference, target or part name from the corpus
    # is printed.
    #
    # CARRIED TO M2 part 4a P3 from P2's run script (printed in
    # records/logs/m2p4a-p2/run.log; its change list AO to AU is there, with P1's
    # AE to AN before it). What differs, and why:
    #  AV. The phase, the log directory, the subjects, the script directory
    #      (<scripts>, <home>/.cache/emend-build/m2p4a-p3/scripts, on the disk),
    #      the build directory (m2p4a-p3/run) and the keep (m2p4a-p3/keep-host)
    #      are this phase's; the base is P2's record commit ("M2 part 4a P2
    #      record:"), also the last to add an open-check record. Two samples,
    #      two run directories, two record pairs: linkscmp.py is replaced by
    #      propscmp.py and protectcmp.py for the corpus, each with its flags, its
    #      line check and its entry expectation (props: the core part changed,
    #      or added with _rels/.rels and [Content_Types].xml changed; protect: W
    #      and the workbook part changed), and the record check takes the
    #      sample's families on its command line (props: docProps required, rels
    #      and content-types allowed, docProps added allowed; protect: worksheet
    #      and workbook), with a control that requires a family the sample does
    #      not change. SUPERSEDED_RUN takes both directories' names.
    #  AW. P2 verification ruling 8 (G5): HOME and ANTHROPIC_API_KEY join the
    #      labelled input lines; the key's value is never printed, only whether
    #      it is set.
    #  AX. P2 verification ruling 8 (F11): the spec is committed, so it is
    #      labelled so, checked equal to the phase commit's, and the status
    #      checks allow no uncommitted planning file.
    #  AY. P2 verification ruling 8 (F6): the retag block, step 4 above: the
    #      comparison's root_tag holds on the fictional pair, its plant turns it
    #      to no, and the output with its added declaration taken out fails it.
    #  AZ. The comparisons are files beside this script, copied into <scratch>/w
    #      and printed from there, since three of them are too long to keep in
    #      heredocs.
    #
    # Usage: m2p4a-p3-run.sh <phase commit> <this phase's test.log> > <file>
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    TEST_LOG=${2:?this phase test.log required}
    # Change AS: every environment input, as it was set, before any is unset.
    INPUT_NAMES="SPEC_SHA RUN_SUFFIX SUPERSEDED_RUN SUPERSEDED_KEEP RERUN_NOTE RERUN_FILES RECORDS_DEST RUN_KEEP RUN_BUILD_ROOT EMEND_CORPUS_DIR HOME ANTHROPIC_API_KEY"
    declare -A INPUT_SEEN
    for v in $INPUT_NAMES; do
      if [ -n "${!v+x}" ]; then INPUT_SEEN[$v]=${!v}; else INPUT_SEEN[$v]=unset; fi
      # Change AW: the key's value is never printed, only whether it is set.
      if [ "$v" = ANTHROPIC_API_KEY ] && [ "${INPUT_SEEN[$v]}" != unset ]; then INPUT_SEEN[$v]="set (value not printed)"; fi
    done
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    LO_TIMEOUT_S=600
    SPEC=specs/0019-names-links-properties-protection.md
    SPEC_SHA=${SPEC_SHA:-}
    if [ -z "$SPEC_SHA" ]; then echo "SPEC_SHA, the spec's sha256, is a required input (change AR)" >&2; exit 2; fi
    # The logged run leaves RUN_BUILD_ROOT and RUN_KEEP unset; a dry run points
    # them elsewhere so it leaves no keep where the logged run refuses one.
    BUILD_ROOT=${RUN_BUILD_ROOT:-$HOME/.cache/emend-build/m2p4a-p3/run}
    KEEP=${RUN_KEEP:-$HOME/.cache/emend-build/m2p4a-p3/keep-host}
    I686=i686-unknown-linux-musl
    # Change AK: where the record pairs are installed.
    RECORDS_DEST=${RECORDS_DEST:-records}
    # Change I: a keep in place is another attempt's, moved below once the
    # header can list it; without SUPERSEDED_KEEP naming the attempt it is
    # refused.
    SUPERSEDED_KEEP=${SUPERSEDED_KEEP:-}
    case $SUPERSEDED_KEEP in '' | attempt-[1-9]) ;; *) echo "SUPERSEDED_KEEP is attempt-<n> or nothing" >&2; exit 2 ;; esac
    if [ -e "$KEEP" ] && [ -z "$SUPERSEDED_KEEP" ]; then echo "$KEEP is already there; name its attempt in SUPERSEDED_KEEP" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    RECORDS=$SELF_DIR/out/records
    B=$(mktemp -d)
    trap 'rm -rf "$B"' EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    SHORT=$(git rev-parse --short=7 "$C")
    OURS='^((\?\?| ?[MARCD]) records/logs/m2p4a-p3|(\?\?| ?[MARCD]) records/m2p4a-(p3-props|p3-protect|open)-2[^ ]*-'"$SHORT"'[.](md|txt)$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs and records" >&2
      exit 2
    fi
    DATE=$(date -u +%Y-%m-%d)
    STEM_OPEN=m2p4a-open-$DATE-$SHORT
    STEM_props=m2p4a-p3-props-$DATE-$SHORT
    STEM_protect=m2p4a-p3-protect-$DATE-$SHORT
    # A rerun takes a suffix, so its run directories are never the superseded
    # ones. Change AV: two samples, two run directories.
    RUN_SUFFIX=${RUN_SUFFIX:-}
    case $RUN_SUFFIX in '' | -[b-z]) ;; *) echo "RUN_SUFFIX is -b to -z or nothing" >&2; exit 2 ;; esac
    RUN_props=$DATE-$SHORT-props$RUN_SUFFIX
    RUN_protect=$DATE-$SHORT-protect$RUN_SUFFIX
    OUT_props=$CORPUS/runs/$RUN_props
    OUT_protect=$CORPUS/runs/$RUN_protect
    mkdir -p "$RECORDS" "$RECORDS_DEST" || exit 2
    # A rerun names the superseded run directories, space-separated, which are
    # MOVED into <scripts>/out/superseded after the header prints them, never
    # removed; each must be another run of this phase's samples, not this one's.
    SUPERSEDED_RUN=${SUPERSEDED_RUN:-}
    RUN_NAME='20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f]{7}-(props|protect)(-[b-z])?'
    for sr in $SUPERSEDED_RUN; do
      if printf '%s' "$sr" | LC_ALL=C "$G" -qxE "$RUN_NAME"; then :; else echo "SUPERSEDED_RUN holds a name that is not a run directory's" >&2; exit 2; fi
      if [ "$sr" = "$RUN_props" ] || [ "$sr" = "$RUN_protect" ]; then echo "SUPERSEDED_RUN names this run's own directory" >&2; exit 2; fi
    done
    for f in "$OUT_props" "$OUT_protect" "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt" \
             "$RECORDS/$STEM_props.md" "$RECORDS/$STEM_props.txt" "$RECORDS_DEST/$STEM_props.md" "$RECORDS_DEST/$STEM_props.txt" \
             "$RECORDS/$STEM_protect.md" "$RECORDS/$STEM_protect.txt" "$RECORDS_DEST/$STEM_protect.md" "$RECORDS_DEST/$STEM_protect.txt"; do
      if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
    done
    # A run directory with a summary for either label before the runner starts
    # is another attempt's (memory: a same-day rerun reads the previous attempt's
    # files); refused here, before the runner, with the exact message.
    for o in "$OUT_props" "$OUT_protect"; do
      for sl in host i686; do
        if [ -e "$o/summary.$sl.tsv" ]; then echo "$o/summary.$sl.tsv is already there" >&2; exit 2; fi
      done
    done
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$KEEP#<keep>#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$CORPUS#<corpus>#g" -e "s#$B#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M2 part 4a P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # Change AS: the environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M2 part 4a P2 record:')
    CODE=$(by_subject 'M2 part 4a P3: emend-copy --props-sample and --protect-sample')
    PREV_OPEN_REC=$(by_subject 'M2 part 4a P2 record:')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  P2's record commit (the base): ${REC:-none}"
    echo "  P2's record commit again, the last to add an open-check record: ${PREV_OPEN_REC:-none}"
    echo "  the tool commit, the last code commit of the phase: ${CODE:-none}"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the tool commit, by its subject" "$(yn [ "$CODE" = "$C" ])"
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    check "control: not_head says no for HEAD itself, so it can fail" "$(yn [ "$(yn not_head "$C")" = no ])"
    echo "phase: Milestone 2 part 4a P3 (specs/0019-names-links-properties-protection.md) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in (change AT)"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    
    # Change AI: the two move checks as functions, run over planted inputs every
