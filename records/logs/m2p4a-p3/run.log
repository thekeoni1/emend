                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved, el.get("TargetMode")))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t, _) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def pick_w(z, workbook):
        """(W's part, S) or None."""
        by_id = {i: (ty, t) for (i, ty, t, _) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty.endswith("/worksheet"):
                    return target, el.get("name", "")
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def inner(raw):
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return len(tag), len(tag)
        return len(tag), raw.rfind(b"</")
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def with_attr(tag, name, value):
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def attr_value(tag, name):
        m = re.search(ATTR_RE % re.escape(name), tag)
        return m.group(1)[1:-1] if m else None
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def children(data, a, b, rp):
        """[(start, end, main local name or None)] of the root's children."""
        out = []
        for (x, y) in top_level(data[a:b]):
            p, n = split_name(qname(data[a + x:a + y]))
            out.append((a + x, a + y, n if p == rp else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def attr_escaped(text):
        """The layer's attribute escape: the five, and tab, line feed and
        carriage return as character references."""
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace("'", "&apos;").replace('"', "&quot;").replace("\t", "&#9;")
                .replace("\n", "&#10;").replace("\r", "&#13;")).encode()
    
    
    def declarations(tag):
        """{prefix: namespace} of a start tag's xmlns:<p> declarations."""
        return {m.group(1): m.group(2)[1:-1]
                for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag)}
    
    
    def rels_prefix(tag):
        """The first prefix a start tag binds to the relationships namespace."""
        for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            if m.group(2)[1:-1].decode() in ATTR:
                return m.group(1)
        return None
    
    
    def cells_and_m(data):
        """(the <c> elements of every main sheetData root child, the largest row
        number among them)."""
        n, m = 0, 0
        root = ET.fromstring(data)
        for sd in root:
            ns, name = local(sd.tag)
            if ns not in MAIN or name != "sheetData":
                continue
            for row in sd:
                for c in row:
                    cns, cname = local(c.tag)
                    if cns in MAIN and cname == "c":
                        n += 1
                        got = re.match(r"^[A-Z]+([0-9]+)$", c.get("r", ""))
                        if got:
                            m = max(m, int(got.group(1)))
        return n, m
    
    
    def links_of(data):
        """(ref, relationships id, location, tooltip) of every hyperlink of every
        main hyperlinks root child, in document order."""
        out = []
        for el in ET.fromstring(data):
            ns, name = local(el.tag)
            if ns not in MAIN or name != "hyperlinks":
                continue
            for h in el:
                hns, hname = local(h.tag)
                if hns in MAIN and hname == "hyperlink":
                    rid = next((h.get("{%s}id" % a) for a in ATTR if h.get("{%s}id" % a) is not None), None)
                    out.append((h.get("ref"), rid, h.get("location"), h.get("tooltip")))
        return out
    
    
    def ext_links(z, part):
        return sum(1 for (_, ty, _, mode) in rels_of(z, part)
                   if mode == "External" and ty in tuple(a + "/hyperlink" for a in ATTR))
    
    
    def plant(flag, dout, rout, state):
        """(dout, rout) changed so that `flag` turns to no, or None when the pair
        gives the plant nothing to change."""
        ts, te, a, b, rp = root_span(dout)
        kids = children(dout, a, b, rp)
        hl = [(x, y) for (x, y, n) in kids if n == "hyperlinks"]
        sd = [(x, y) for (x, y, n) in kids if n == "sheetData"]
        if flag == "rest_same":
            return dout[:te] + COMMENT + dout[te:], rout
        if flag == "root_tag":
            return dout[:te - 1] + b' planted="1"' + dout[te - 1:], rout
        if flag == "links_prefix":
            if not hl or not state["in_content"]:
                return None
            x = hl[0][0] + inner(dout[hl[0][0]:hl[0][1]])[0]
            sp = dout.find(b" ", x)
            return dout[:sp] + b" " + dout[sp:], rout
        if flag in ("added_tags", "added_bytes"):
            t = b'tooltip="' + TOOLTIP.encode() + b'"'
            at = dout.rfind(t)
            if at < 0:
                return None
            new = t + b' display="x"' if flag == "added_tags" else b"tooltip='" + TOOLTIP.encode() + b"'"
            return dout[:at] + new + dout[at + len(t):], rout
        if flag == "rel_target":
            if rout is None or rout.rfind(TARGET.encode()) < 0:
                return None
            at = rout.rfind(TARGET.encode())
            return dout, rout[:at] + b"https://example.org/" + rout[at + len(TARGET):]
        if flag == "rels_bytes":
            t = b'TargetMode="External"/>'
            if rout is None or rout.rfind(t) < 0:
                return None
            at = rout.rfind(t)
            return dout, rout[:at] + b"TargetMode='External'/>" + rout[at + len(t):]
        if flag == "sheet_data":
            at = dout.find(b">emend link<")
            if at < 0:
                return None
            return dout[:at] + b">emend linX<" + dout[at + len(b">emend link<"):], rout
        if flag == "container_place":
            if state["had_container"] or not hl:
                return None
            return dout[:hl[0][1]] + COMMENT + dout[hl[0][1]:], rout
        if flag == "root_order":
            if not hl or not sd:
                return None
            (x1, y1), (x2, y2) = sorted([hl[0], sd[0]])
            first, second = dout[x1:y1], dout[x2:y2]
            return dout[:x1] + second + dout[y1:x2] + first + dout[y2:], rout
        if flag == "one_each":
            return dout[:b] + b"<" + rp + b"hyperlinks/>" + dout[b:], rout
        if flag == "links_read":
            t = b'ref="B%d"' % state["n"]
            at = dout.rfind(t)
            if at < 0:
                return None
            return dout[:at] + b'ref="C%d"' % state["n"] + dout[at + len(t):], rout
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        w = pick_w(zin, wb)
        if w is None or w[0] not in zin.namelist():
            print("error=no-worksheet")
            return
        part, s_name = w
        rname = rels_name(part)
        if args[1:] == ["--parts"]:
            print(part)
            print(rname)
            print(1 if rname in zin.namelist() else 0)
            return
        zout = zipfile.ZipFile(args[1])
        flag_plant = None
        if len(args) == 4 and args[2] == "--plant":
            flag_plant = args[3]
            if flag_plant not in FLAGS:
                print("error=unknown-plant")
                return
        din, dout = zin.read(part), zout.read(part)
        rin = zin.read(rname) if rname in zin.namelist() else None
        rout = zout.read(rname) if rname in zout.namelist() else None
    
        cells_in, m = cells_and_m(din)
        n = m + 1
        loc = "'" + s_name.replace("'", "''") + "'!A1"
    
        its, ite, ia, ib, rp = root_span(din)
        tag_in = din[its:ite]
        kin = children(din, ia, ib, rp)
        hl_in = [(x, y) for (x, y, nm) in kin if nm == "hyperlinks"]
        sd_in = [(x, y) for (x, y, nm) in kin if nm == "sheetData"]
        in_content = b""
        if hl_in:
            el = din[hl_in[0][0]:hl_in[0][1]]
            x, y = inner(el)
            in_content = el[x:y]
        state = {"in_content": in_content, "had_container": bool(hl_in), "n": n}
    
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, dout, rout, state)
            if changed is not None:
                dout, rout = changed
                planted = True
    
        ots, ote, oa, ob, orp = root_span(dout)
        tag_out = dout[ots:ote]
        kout = children(dout, oa, ob, orp)
        hl_out = [(x, y) for (x, y, nm) in kout if nm == "hyperlinks"]
        sd_out = [(x, y) for (x, y, nm) in kout if nm == "sheetData"]
        flags = dict.fromkeys(FLAGS, False)
    
        # The root start tag, and the relationships prefix the links use.
        bound = rels_prefix(tag_in)
        if bound is not None:
            want_tag = tag_in
            rpre = bound
        else:
            taken = declarations(tag_in)
            k = 0
            while True:
                rpre = b"r" if k == 0 else b"r%d" % k
                if rpre not in taken:
                    break
                k += 1
            root_ns = local(ET.fromstring(din).tag)[0]
            ns = ATTR[1] if root_ns == MAIN[1] else ATTR[0]
            want_tag = with_attr(tag_in, b"xmlns:" + rpre, ns.encode())
        flags["root_tag"] = tag_out == want_tag
        flags["rest_same"] = (
            cut(din, [(its, ite)] + hl_in + sd_in) == cut(dout, [(ots, ote)] + hl_out + sd_out))
        flags["one_each"] = len(hl_out) == 1
    
        # The relationship the link was given, as the design writes it.
        in_rels = rels_of(zin, part)
        highest = 0
        for (rid, _, _, _) in in_rels:
            got = re.match(r"^rId([0-9]+)$", rid or "")
            if got:
                highest = max(highest, int(got.group(1)))
        rid_want = "rId%d" % (highest + 1)
        kind = ATTR[1] + "/hyperlink" if any(ty == ATTR[1] + "/hyperlink" for (_, ty, _, _) in in_rels) \
            else ATTR[0] + "/hyperlink"
        rel_el = (b'<Relationship Id="' + rid_want.encode() + b'" Type="' + kind.encode()
                  + b'" Target="' + TARGET.encode() + b'" TargetMode="External"/>')
        if rout is not None:
            try:
                got = [el for el in ET.fromstring(rout).iter("{%s}Relationship" % RELS)
                       if el.get("Id") == rid_want]
            except ET.ParseError:
                got = []
            flags["rel_target"] = (len(got) == 1 and got[0].get("Type") == kind
                                   and got[0].get("Target") == TARGET
                                   and got[0].get("TargetMode") == "External")
            if rin is not None:
                end = rin.rfind(b"</")
                flags["rels_bytes"] = rout == rin[:end] + rel_el + rin[end:]
            elif "_rels/.rels" in zin.namelist():
                pkg = zin.read("_rels/.rels")
                head = pkg[:re.search(rb"<[^?!]", pkg).start()]
                flags["rels_bytes"] = rout == (head + b'<Relationships xmlns="' + RELS.encode()
                                               + b'">' + rel_el + b"</Relationships>")
    
        # The two added elements.
        p = split_name(qname(din[hl_in[0][0]:hl_in[0][1]]))[0] if hl_in else rp
        want_added = (
            b"<" + p + b'hyperlink ref="A%d" ' % n + rpre + b':id="' + rid_want.encode()
            + b'" tooltip="' + attr_escaped(TOOLTIP) + b'"/>'
            + b"<" + p + b'hyperlink ref="B%d" location="' % n + attr_escaped(loc) + b'"/>')
        if hl_out:
            el = dout[hl_out[0][0]:hl_out[0][1]]
            x, y = inner(el)
            content = el[x:y]
            tag = start_tag(el)
            if hl_in:
                tin = start_tag(din[hl_in[0][0]:hl_in[0][1]])
                head_ok = tag == (opened(tin) if tin.endswith(b"/>") else tin)
                end_ok = el.endswith(b"</" + qname(din[hl_in[0][0]:hl_in[0][1]]) + b">")
            else:
                head_ok = tag == b"<" + rp + b"hyperlinks>"
                end_ok = el.endswith(b"</" + rp + b"hyperlinks>")
            flags["links_prefix"] = head_ok and end_ok and content.startswith(in_content)
            added = content[len(in_content):] if content.startswith(in_content) else b""
            flags["added_bytes"] = added == want_added
            try:
                decls = declarations(tag_out)
                if p and p[:-1] not in decls:
                    decls[p[:-1]] = MAIN[0].encode()
                decl = b"".join(b' xmlns:%s="%s"' % (k, v) for (k, v) in decls.items())
                got = list(ET.fromstring(b"<w" + decl + b">" + added + b"</w>"))
                ns_r = decls.get(rpre, ATTR[0].encode()).decode()
                a_attrs = {"ref": "A%d" % n, "{%s}id" % ns_r: rid_want, "tooltip": TOOLTIP}
                b_attrs = {"ref": "B%d" % n, "location": loc}
                flags["added_tags"] = (
                    len(got) == 2 and all(local(e.tag)[1] == "hyperlink" for e in got)
                    and dict(got[0].attrib) == a_attrs and dict(got[1].attrib) == b_attrs
                    and len(top_level(added)) == 2)
            except ET.ParseError:
                flags["added_tags"] = False
    
        # sheetData: the one created cell, and its row when the input has none.
        if len(sd_in) >= 1 and len(sd_out) >= 1:
            s_in = din[sd_in[0][0]:sd_in[0][1]]
            s_out = dout[sd_out[0][0]:sd_out[0][1]]
            sp = split_name(qname(s_in))[0]
            cell = (b"<" + sp + b'c r="A%d" t="inlineStr"><' % n + sp + b"is><" + sp
                    + b't xml:space="preserve">emend link</' + sp + b"t></" + sp + b"is></" + sp + b"c>")
            norm_in = s_in
            if start_tag(s_in).endswith(b"/>"):
                norm_in = opened(s_in) + b"</" + qname(s_in) + b">"
            row_re = re.compile(rb"<" + re.escape(sp) + rb'row\s[^>]*?\br="%d"[^>]*?/>' % n)
            empty_row = row_re.search(norm_in)
            if empty_row:
                rt = empty_row.group(0)
                norm_in = (norm_in[:empty_row.start()] + opened(rt) + b"</" + sp + b"row>"
                           + norm_in[empty_row.end():])
            candidate = s_out.replace(cell, b"", 1) if s_out.count(cell) == 1 else None
            if candidate is not None and not empty_row:
                created = b"<" + sp + b'row r="%d"></' % n + sp + b"row>"
                candidate = candidate.replace(created, b"", 1) if candidate.count(created) == 1 else candidate
            flags["sheet_data"] = candidate == norm_in
    
        order_in = [nm for (_, _, nm) in kin if nm is not None]
        order_out = [nm for (_, _, nm) in kout if nm is not None]
        want_order = list(order_in)
        if "hyperlinks" not in want_order:
            pos = TABLE.index("hyperlinks")
            at = next((i for i, nm in enumerate(want_order) if nm in TABLE and TABLE.index(nm) > pos),
                      len(want_order))
            want_order.insert(at, "hyperlinks")
        flags["root_order"] = order_out == want_order
        if hl_in:
            flags["container_place"] = ("hyperlinks" in order_out
                                        and order_out.index("hyperlinks") == order_in.index("hyperlinks"))
        elif hl_out:
            pos = TABLE.index("hyperlinks")
            later = [x for (x, _, nm) in kout
                     if nm is not None and nm in TABLE and TABLE.index(nm) > pos and x >= hl_out[0][1]]
            flags["container_place"] = hl_out[0][1] == (later[0] if later else ob)
    
        l_in = links_of(din)
        try:
            l_out = links_of(dout)
        except ET.ParseError:
            l_out = None
        want_links = l_in + [("A%d" % n, rid_want, None, TOOLTIP), ("B%d" % n, None, loc, None)]
        flags["links_read"] = l_out == want_links
    
        try:
            cells_out = cells_and_m(dout)[0]
        except ET.ParseError:
            cells_out = -1
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted),
             "cells_in=%d" % cells_in, "cells_out=%d" % cells_out,
             "links_in=%d" % len(l_in), "links_out=%d" % len(l_out or []),
             "ext_in=%d" % ext_links(zin, part), "ext_out=%d" % ext_links(zout, part),
             "r_bound_in=%d" % (0 if bound is None else 1),
             "rels_in=%d" % (0 if rin is None else 1),
             "container_created=%d" % (0 if hl_in else 1)]
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS]))
    
    
    main()
  control: all_yes refuses a line with no flags: yes
  control: line_props accepts a line as the spec reads: yes
  control: line_props refuses the same line with the keywords not read back: yes
  control: line_protect accepts a line as the spec reads: yes
  control: line_protect refuses the same line with another hash: yes
  corpus manifest rows: 27
  the corpus holds its 27 workbooks: yes
  control: entries_rows accepts the expected rows of a planted workbook: yes
  control: entries_rows refuses the rows against an entry they do not change: yes
  control: entries_rows refuses the rows when an expected added entry is missing: yes
  from the inputs: a core part in 27 of 27
command: sed 's/^/    /' <scratch>/w/reccheck.py
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, tool_arg, required, allowed, added_ok = sys.argv[1:9]
    required, allowed, added_ok = [x.split(",") if x else [] for x in (required, allowed, added_ok)]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        changed_f = sorted(f for f in fam if fam[f].get("changed"))
        dropped_f = sorted(f for f in fam if fam[f].get("dropped"))
        added_f = sorted(f for f in fam if fam[f].get("added"))
        # Change AV: the families the sample's edit changes and adds, given on
        # the command line: every required one changed, none outside the allowed
        # set, the added ones within theirs, nothing dropped.
        fam_ok = set(required) <= set(changed_f) and set(changed_f) <= set(allowed)
        checks.append(("%s: the xml families are the changed entries' families" % label, sorted(xf) == changed_f))
        checks.append(("%s: the changed entries' families are the sample's" % label, fam_ok))
        checks.append(("%s: no entry is dropped" % label, dropped_f == []))
        checks.append(("%s: the added entries' families are the sample's, or none" % label, set(added_f) <= set(added_ok)))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: " + tool_arg in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))

