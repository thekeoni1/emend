## the run log's comparisons (python3, zipfile, byte spans and ElementTree)
command: sed 's/^/    /' <scratch>/w/propscmp.py (copied from <scripts>/propscmp.py); sha256 7645ee980f87bc1a9575fb49ff37968c5d86e1d5e3113589390a88aa250be28d, 12769 bytes
    """The run log's own properties comparison (specs/0019-names-links-
    properties-protection.md, "Harness runs", --props-sample and P3).
    
    Usage: propscmp.py <input archive> <output archive> [--plant <flag>]
           propscmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool. It finds the core-properties part through the
    package relationship (either form of the type) and compares, the three
    edited properties being dc:title, cp:keywords and dcterms:modified with the
    tool's values "emend sample", "emend" and "2026-01-01T00:00:00Z":
    
      root_tag         the core part's root start tag is the input's, byte for
                       byte
      rest_same        the root's children other than the three, and the bytes
                       between children, are the input's in the input's order
                       (the output with the three cut out and the appended tail
                       cut off is the input with the three cut out)
      three_once       the output has exactly one element of each of the three
      three_text       read with ElementTree, each of the three holds its value
      in_place         each of the three the input had stands where the input's
                       stood (the same child index), its start tag the input's
                       (opened up when it was empty)
      appended         each of the three the input lacked is appended before the
                       root's end tag, in the order title, keywords, modified, with
                       the prefix the root binds to its namespace
      element_bytes    each of the three is byte for byte the element this log
                       builds: an in-place one the input's start tag, the escaped
                       value and the end tag of the same name; an appended one
                       <p:name>value</p:name>, modified with xsi:type="<p>:W3CDTF"
      xsi_type         the output's modified carries xsi:type ending ":W3CDTF"
      props_read       read with ElementTree, the output holds every one of the
                       thirteen properties the input held, and those three
    
    It prints ONE line of counts and yes/no flags and no value, text or part
    name. --parts prints the core part's name, "1" when the input has one, and
    the package rels part's name, for the log to compare with the runner's rows
    without printing them. --plant <flag> changes the output as read so that the
    named flag turns to no; the line then says planted=yes, or planted=no when
    the pair gives the plant nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    CORE_TYPES = (
        "http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties",
        "http://schemas.openxmlformats.org/officeDocument/2006/relationships/metadata/core-properties",
    )
    CP = "http://schemas.openxmlformats.org/package/2006/metadata/core-properties"
    DC = "http://purl.org/dc/elements/1.1/"
    DCTERMS = "http://purl.org/dc/terms/"
    XSI = "http://www.w3.org/2001/XMLSchema-instance"
    THIRTEEN = [(DC, n) for n in ("title", "subject", "creator", "description", "language")] + \
        [(CP, n) for n in ("keywords", "lastModifiedBy", "revision", "category", "contentStatus", "version")] + \
        [(DCTERMS, n) for n in ("created", "modified")]
    EDITED = [((DC, "title"), "emend sample"), ((CP, "keywords"), "emend"),
              ((DCTERMS, "modified"), "2026-01-01T00:00:00Z")]
    FLAGS = ("root_tag", "rest_same", "three_once", "three_text", "in_place", "appended",
             "element_bytes", "xsi_type", "props_read")
    COMMENT = b"<!-- planted -->"
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def core_of(z):
        if "_rels/.rels" not in z.namelist():
            return None
        for el in ET.fromstring(z.read("_rels/.rels")).iter("{%s}Relationship" % RELS):
            if el.get("Type") in CORE_TYPES and el.get("TargetMode") != "External":
                t = el.get("Target", "")
                return t[1:] if t.startswith("/") else posixpath.normpath(t)
        return None
    
    
    def root_span(data):
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1
        return m.start(), close + 1, close + 1, data.rfind(b"</")
    
    
    def declarations(tag):
        return {m.group(1).decode(): m.group(2)[1:-1].decode()
                for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag)}
    
    
    def default_ns(tag):
        m = re.search(rb'\sxmlns\s*=\s*("[^"]*"|\'[^\']*\')', tag)
        return m.group(1)[1:-1].decode() if m else None
    
    
    def children(data, a, b, decls, dflt):
        """[(start, end, (namespace, local))] of the root's children."""
        out, depth, at = [], 0, 0
        for m in TOKEN.finditer(data, a, b):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    out.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    out.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        named = []
        for (x, y) in out:
            q = re.match(rb"<([^\s/>]+)", data[x:y]).group(1).decode()
            p, _, n = q.rpartition(":")
            own = declarations(data[x:data.find(b">", x) + 1])
            ns = (own.get(p) or decls.get(p)) if p else (default_ns(data[x:data.find(b">", x) + 1]) or dflt)
            named.append((x, y, (ns, n)))
        return named
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def escaped(text):
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace("'", "&apos;").replace('"', "&quot;").replace("\r", "&#13;")).encode()
    
    
    def prefix_for(decls, dflt, ns):
        if dflt == ns:
            return ""
        for p, u in decls.items():
            if u == ns:
                return p
        return None
    
    
    def colon(p):
        return (p + ":").encode() if p else b""
    
    
    def expected(key, value, din, kin, decls, dflt):
        """The bytes the design gives for an edited property: in place from the
        input's element, appended with the root's prefixes."""
        have = [k for k in kin if k[2] == key]
        if have:
            x, y, _ = have[0]
            raw = din[x:y]
            tag = raw[:raw.find(b">") + 1]
            q = re.match(rb"<([^\s/>]+)", tag).group(1)
            if tag.endswith(b"/>"):
                slash = tag.rfind(b"/")
                tag = tag[:slash] + tag[slash + 1:]
            return tag + escaped(value) + b"</" + q + b">"
        p = prefix_for(decls, dflt, key[0])
        if p is None:
            return None
        name = colon(p) + key[1].encode()
        out = b"<" + name
        if key == (DCTERMS, "modified"):
            out += b" " + colon(prefix_for(decls, dflt, XSI) or "") + b'type="' + colon(p) + b'W3CDTF"'
        return out + b">" + escaped(value) + b"</" + name + b">"
    
    
    def props(data):
        root = ET.fromstring(data)
        got = {}
        for el in root:
            if el.tag.startswith("{"):
                ns, _, n = el.tag[1:].partition("}")
                if (ns, n) in THIRTEEN:
                    got.setdefault((ns, n), []).append(el)
        return got
    
    
    def compare(din, dout):
        f = {}
        ts, te, a, b = root_span(din)
        decls, dflt = declarations(din[ts:te]), default_ns(din[ts:te])
        kin = children(din, a, b, decls, dflt)
        ots, ote, oa, ob = root_span(dout)
        odecls, odflt = declarations(dout[ots:ote]), default_ns(dout[ots:ote])
        kout = children(dout, oa, ob, odecls, odflt)
        keys = [k for (k, _) in EDITED]
        f["root_tag"] = din[ts:te] == dout[ots:ote] or (din[ts:te].endswith(b"/>") and
                                                        dout[ots:ote] == din[ts:te - 2] + b">")
        ein = [k for k in kin if k[2] in keys]
        eout = [k for k in kout if k[2] in keys]
        missing = [k for k in keys if not any(e[2] == k for e in ein)]
        rest_in = cut(din[a:b], [(x - a, y - a) for (x, y, _) in ein])
        appended_out = [k for k in kout[len(kin):]] if len(kout) >= len(kin) else []
        tail = appended_out[0][0] if appended_out else ob
        rest_out = cut(dout[oa:tail], [(x - oa, y - oa) for (x, y, _) in eout if x < tail])
        outside = din[:ts] == dout[:ots] and (din[b:] == dout[ob:] if a != b else True)
        f["rest_same"] = outside and rest_in == rest_out
        counts = {k: sum(1 for e in kout if e[2] == k) for k in keys}
        f["three_once"] = all(v == 1 for v in counts.values())
        got = props(dout)
        f["three_text"] = all(len(got.get(k, [])) == 1 and (got[k][0].text or "") == v for (k, v) in EDITED)
        in_place = True
        for (x, y, k) in ein:
            idx = kin.index((x, y, k))
            if idx >= len(kout) or kout[idx][2] != k:
                in_place = False
        f["in_place"] = in_place
        f["appended"] = [e[2] for e in appended_out] == missing
        ok = True
        for (k, v) in EDITED:
            want = expected(k, v, din, kin, decls, dflt)
            have = [dout[x:y] for (x, y, kk) in kout if kk == k]
            if want is None or have != [want]:
                ok = False
        f["element_bytes"] = ok
