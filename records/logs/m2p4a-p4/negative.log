    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    echo
    echo "## the names, links, properties and protection families through the gate's binary, copied into a worktree"
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    echo "command: git worktree add --detach <tree> <phase commit>"
    git worktree add --detach "$TREE" "$C" >/dev/null 2>&1
    check "the worktree is at the phase commit" "$(yn [ "$(git -C "$TREE" rev-parse HEAD)" = "$C" ])"
    HASH_FORM='^  <[a-z]+>/target/debug/emend-copy: sha256 [0-9a-f]{64}, bytes [0-9]+$'
    nhash=$(count_matches -E "$HASH_FORM" "$GATE_LOG")
    GATED=$(sed -n -E 's#^  <[a-z]+>/target/debug/emend-copy: sha256 ([0-9a-f]{64}), bytes [0-9]+$#\1#p' "$GATE_LOG" | head -n 1)
    echo "command: count_matches -E and sed for the host emend-copy hash line in $GATE_LOG (sha256 $(sha_of "$GATE_LOG")): lines $nhash; hash $GATED"
    check "gate.log holds exactly one host emend-copy hash line" "$(yn [ "$nhash" = 1 ])"
    printf '  <build>/target/debug/emend-copy: sha256 %s, bytes 1\n  <build>/target/i686-unknown-linux-musl/debug/emend-copy: sha256 %s, bytes 1\n' \
      "$(printf 'a' | sha256sum | cut -d' ' -f1)" "$(printf 'b' | sha256sum | cut -d' ' -f1)" >"$B/c-gate.log"
    check "control: the same form counts one line in a fixture holding a host and an i686 line" "$(yn [ "$(count_matches -E "$HASH_FORM" "$B/c-gate.log")" = 1 ])"
    echo "command: mkdir <tree>/bin; cp <gatebuild>/target/debug/emend-copy <tree>/bin/emend-copy"
    mkdir "$TREE/bin" && cp "$GATE_BIN" "$TREE/bin/emend-copy"
    BIN=$TREE/bin/emend-copy
    echo "  <tree>/bin/emend-copy: sha256 $(sha_of "$BIN")"
    check "the copied binary is the one gate.log hashed, not a rebuild" "$(yn [ "$(sha_of "$BIN")" = "$GATED" ])"
    check "control: the reader found a hash in gate.log" "$(yn [ -n "$GATED" ])"
    echo
    echo "### the messages, read from the phase commit's source by constant name (change X)"
    git show "$C:crates/emend/src/package.rs" >"$B/package.rs"
    cat >"$B/messages.py" <<'PY'
    """The Error::Package messages of a package.rs, by constant name, one per
    line as NAME<TAB>message in source order. With --part, only the eleven
    constants of M2 part 4a named below, each required found exactly once (exit
    1 otherwise).
    Usage: messages.py <package.rs> [--part]."""
    import re
    import sys
    
    PART = ["DEFINED_NAME_INVALID", "NAME_EXISTS", "NO_SUCH_NAME", "TWO_BOOK_ELEMENTS", "LINK_EMPTY",
            "NO_SUCH_LINK", "TWO_SHEET_ELEMENTS", "PROPERTY_INVALID", "PASSWORD_INVALID",
            "CORE_NO_PREFIX", "CORE_TWO"]
    text = open(sys.argv[1]).read()
    found = re.findall(r'^const ([A-Z_0-9]+): Error =\s*Error::Package\(\s*"([^"]*)",?\s*\);', text, re.M)
    if "--part" in sys.argv:
        names = [n for n, _ in found]
        missing = [n for n in PART if names.count(n) != 1]
        if missing:
            sys.exit("not found exactly once: " + " ".join(missing))
        found = [(n, m) for n, m in found if n in PART]
    for n, m in found:
        print("%s\t%s" % (n, m))
    PY
    sed 's/^/    /' "$B/messages.py"
    echo "command: python3 <scratch>/w/messages.py <scratch>/w/package.rs --part, the file from git show <phase commit>:crates/emend/src/package.rs"
    python3 "$B/messages.py" "$B/package.rs" --part >"$B/part.tsv"
    echo "  exit: $?"
    python3 "$B/messages.py" "$B/package.rs" >"$B/all.tsv"
    echo "command: python3 <scratch>/w/messages.py <scratch>/w/package.rs, the whole source, for NO_SUCH_PART (change X): $(count_lines "$B/all.tsv") constants"
    sed 's/^/    /' "$B/part.tsv"
    npart=$(count_lines "$B/part.tsv")
    nempty=$(awk -F"$TAB" '$2 == "" { n++ } END { print n + 0 }' "$B/part.tsv")
    echo "  this part's messages read by name: $npart; with an empty message: $nempty"
    part_ok() { [ "$npart" = 11 ] && [ "$nempty" = 0 ]; }
    check "the eleven constants are read, each once, and none is empty" "$(yn part_ok)"
    printf 'const A: Error = Error::Package("x");\nconst NAME_EXISTS: Error = Error::Package("one");\nconst B: Error =\n    Error::Package("two");\nconst CORE_TWO: Error =\n    Error::Package("three");\nconst LINK_EMPTY: Error = Error::Package(\n    "four",\n);\nconst C: Error = Error::Package("y");\n' >"$B/c-package.rs"
    for n in DEFINED_NAME_INVALID NO_SUCH_NAME TWO_BOOK_ELEMENTS NO_SUCH_LINK TWO_SHEET_ELEMENTS PROPERTY_INVALID PASSWORD_INVALID CORE_NO_PREFIX; do
      printf 'const %s: Error = Error::Package("z");\n' "$n" >>"$B/c-package.rs"
    done
    python3 "$B/messages.py" "$B/c-package.rs" --part >"$B/c-part.tsv"
    check "control: the reader takes the named constants, one-line, wrapped and multi-line, and none of the others" "$(yn [ "$(head -n 3 "$B/c-part.tsv" | cut -f2 | tr '\n' ' ')$(count_lines "$B/c-part.tsv")" = "one three four 11" ])"
    LC_ALL=C "$G" -v '^const CORE_TWO:' "$B/c-package.rs" >"$B/c-short.rs"
    short_refused() { if python3 "$B/messages.py" "$B/c-short.rs" --part >/dev/null 2>"$B/c-short.err"; then return 1; else return 0; fi; }
    check "control: the reader refuses a source lacking one of the eleven" "$(yn short_refused)"
    # msg <NAME>: the message the source holds for the constant, as the tool prints it.
    msg() { awk -F"$TAB" -v n="$1" '$1 == n { print "error: " $2 }' "$B/part.tsv"; }
    # msg_any <NAME>: the same over the whole source, for a constant outside the
    # eleven (NO_SUCH_PART).
    msg_any() { awk -F"$TAB" -v n="$1" '$1 == n { print "error: " $2 }' "$B/all.tsv"; }
    # Each message must stand in planning's spec, whitespace folded, since the
    # spec wraps its lines.
    python3 - "$B/part.tsv" "$SPEC" >"$B/in-spec.tsv" <<'PY'
    import re
    import sys
    spec = re.sub(r"\s+", " ", open(sys.argv[2]).read())
    for line in open(sys.argv[1]):
        name, message = line.rstrip("\n").split("\t", 1)
        print("%s\t%s" % (name, "yes" if message in spec else "no"))
    PY
    echo "command: each of the eleven messages, looked for in planning's $SPEC with its whitespace folded"
    sed 's/^/    /' "$B/in-spec.tsv"
    nin=$(count_matches -E "${TAB}yes\$" "$B/in-spec.tsv")
    all_in_spec() { [ "$nin" = "$npart" ]; }
    check "every one of the eleven messages is one planning's spec names" "$(yn all_in_spec)"
    echo
    echo "### this log's generator, from the phase commit's template files"
    mkdir "$B/template" "$B/fx"
    for f in '[Content_Types].xml' _rels/.rels xl/workbook.xml xl/_rels/workbook.xml.rels xl/worksheets/sheet1.xml xl/styles.xml; do
      mkdir -p "$B/template/$(dirname "$f")"
      git show "$C:crates/emend/template/$f" >"$B/template/$f"
    done
    cat >"$B/gen-p4.py" <<'PY'
    """Fictional packages for M2 part 4a P4's negative log: the phase commit's
    template files, zipped in the template's order. The N cases insert children
    in the workbook part right after `</sheets>`; the L and T cases in the
    worksheet part right after its empty `<sheetData/>`; the P cases add
    docProps/core.xml with its package relationship and its Override; M1 adds
    the package relationship alone, naming a part the archive lacks.
    Usage: gen-p4.py <template dir> <out dir>."""
    import os
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    MAIN = b"http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    CP = b"http://schemas.openxmlformats.org/package/2006/metadata/core-properties"
    DC = b"http://purl.org/dc/elements/1.1/"
    DCTERMS = b"http://purl.org/dc/terms/"
    DCMITYPE = b"http://purl.org/dc/dcmitype/"
    XSI = b"http://www.w3.org/2001/XMLSchema-instance"
    CORE_TYPE = b"http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties"
    CORE_CT = b"application/vnd.openxmlformats-package.core-properties+xml"
    DECL = b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    src, out = sys.argv[1], sys.argv[2]
    parts = {name: open(os.path.join(src, name), "rb").read() for name in ORDER}
    book = parts["xl/workbook.xml"]
    sheet = parts["xl/worksheets/sheet1.xml"]
    assert book.count(b"</sheets>") == 1
    assert sheet.count(b"<sheetData/>") == 1
    assert parts["_rels/.rels"].count(b"</Relationships>") == 1
    assert parts["[Content_Types].xml"].count(b"</Types>") == 1
    
    
    def with_book(children):
        p = dict(parts)
        p["xl/workbook.xml"] = book.replace(b"</sheets>", b"</sheets>" + children)
        return p
    
    
    def names(tag):
        return with_book(b"<definedNames>" + tag + b"1</definedName></definedNames>")
    
    
    def with_sheet(children):
        p = dict(parts)
        p["xl/worksheets/sheet1.xml"] = sheet.replace(b"<sheetData/>", b"<sheetData/>" + children)
        return p
    
    
    def core(dcterms, body):
        root = b'<cp:coreProperties xmlns:cp="' + CP + b'" xmlns:dc="' + DC + b'"'
        if dcterms:
            root += b' xmlns:dcterms="' + DCTERMS + b'" xmlns:dcmitype="' + DCMITYPE + b'"'
        root += b' xmlns:xsi="' + XSI + b'">'
        return DECL + root + body + b"</cp:coreProperties>"
    
    
    def with_rel(p):
        p = dict(p)
        p["_rels/.rels"] = p["_rels/.rels"].replace(
            b"</Relationships>",
            b'<Relationship Id="rId2" Type="' + CORE_TYPE + b'" Target="docProps/core.xml"/></Relationships>')
        return p
    
    
    def with_core(part):
        p = with_rel(parts)
        p["[Content_Types].xml"] = p["[Content_Types].xml"].replace(
            b"</Types>", b'<Override PartName="/docProps/core.xml" ContentType="' + CORE_CT + b'"/></Types>')
        p["docProps/core.xml"] = part
        return p
    
    
    CASES = {
        "n0": dict(parts),
        "n1": names(b'<definedName name="emend_global">'),
        "n2": names(b'<definedName name="EMEND_Global">'),
        "n3": names(b'<definedName name="emend_globalx">'),
        "n4": with_book(b"<definedNames/><definedNames/>"),
        "n5": with_book(b"<definedNames/>"),
        "n6": names(b'<definedName name="emend_global" localSheetId="0">'),
        "n7": names(b'<definedName name="a" q:x="1">'),
        "n8": names(b'<definedName name="a" xmlns:q="urn:q" q:x="1">'),
        "l0": dict(parts),
        "l1": with_sheet(b"<hyperlinks/><hyperlinks/>"),
        "l2": with_sheet(b"<hyperlinks/>"),
        "l3": with_sheet(b"<q:hyperlinks/>"),
        "l4": with_sheet(b'<q:hyperlinks xmlns:q="' + MAIN + b'"/>'),
        "p0": dict(parts),
        "p1": with_core(core(False, b"")),
        "p2": with_core(core(True, b"")),
        "p3": with_core(core(True, b"<dc:title>a</dc:title><dc:title>b</dc:title>")),
        "p4": with_core(core(True, b"<dc:title>a</dc:title>")),
        "m1": with_rel(parts),
        "t0": dict(parts),
        "t1": with_sheet(b'<sheetProtection sheet="1"/><sheetProtection sheet="1"/>'),
        "t2": with_sheet(b'<sheetProtection sheet="1"/>'),
    }
    for case, p in CASES.items():
        names_in = ORDER + (["docProps/core.xml"] if "docProps/core.xml" in p else [])
        with zipfile.ZipFile(os.path.join(out, case + ".xlsx"), "w") as z:
            for name in names_in:
                z.writestr(zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0)), p[name], zipfile.ZIP_DEFLATED)
        wb, ws, c = p["xl/workbook.xml"], p["xl/worksheets/sheet1.xml"], p.get("docProps/core.xml", b"")
        print("%s %d entries:%d definedNames:%d definedName:%d hyperlinks:%d q_bound:%d core_rel:%d core:%d"
              " dcterms_bound:%d titles:%d sheetProtection:%d" % (
                  case + ".xlsx", os.path.getsize(os.path.join(out, case + ".xlsx")), len(names_in),
                  wb.count(b"<definedNames"), wb.count(b"<definedName "), ws.count(b"hyperlinks"),
                  wb.count(b"xmlns:q=") + ws.count(b"xmlns:q="), p["_rels/.rels"].count(CORE_TYPE),
                  int("docProps/core.xml" in p), c.count(b"xmlns:dcterms="), c.count(b"<dc:title>"),
                  ws.count(b"<sheetProtection")))
    PY
    sed 's/^/    /' "$B/gen-p4.py"
    echo "command: python3 <scratch>/w/gen-p4.py <scratch>/w/template <scratch>/w/fx"
    python3 "$B/gen-p4.py" "$B/template" "$B/fx" >"$B/gen-p4.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/gen-p4.out"
    check "the twenty-three fixtures were written, and nothing else" "$(yn [ "$(find "$B/fx" -type f | wc -l)" = 23 ])"
    # run_bin <case> <args...>: the copied binary, the command printed with the
    # paths it names, stdout, stderr and exit kept.
    run_bin() {
      local case=$1
      shift
      "$BIN" "$@" >"$B/$case.stdout" 2>"$B/$case.stderr" </dev/null
      echo $? >"$B/$case.status"
      echo "command: <tree>/bin/emend-copy $*"
      echo "  exit: $(cat "$B/$case.status")"
      echo "  stdout:"; sed 's/^/    /' "$B/$case.stdout"
      echo "  stderr:"; sed 's/^/    /' "$B/$case.stderr"
    }
    status_is() { [ "$(cat "$B/$1.status")" = "$2" ]; }
    refused_with() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ -n "$2" ] && [ "$(cat "$B/$1.stderr")" = "$2" ]; }
    no_output() { [ ! -e "$B/out/$1.xlsx" ]; }
    has_output() { [ -s "$B/out/$1.xlsx" ]; }
    usage_refused() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ "$(count_matches -F 'error: usage: emend-copy' "$B/$1.stderr")" = 1 ]; }
    line_is() { status_is "$1" 0 && [ ! -s "$B/$1.stderr" ] && [ "$(cat "$B/$1.stdout")" = "$2" ] && has_output "$1"; }
    mkdir "$B/out"
    run_family() {
      local flag=$1 case
      shift
      for case in "$@"; do
        echo
        echo "### ${case^^} ($flag)"
        run_bin "$case" "$B/fx/$case.xlsx" "$B/out/$case.xlsx" "$flag"
      done
    }
    run_family --names-sample n0 n1 n2 n3 n6 n4 n5 n7 n8
    run_family --link-sample l0 l1 l2 l3 l4
    run_family --props-sample p0 p1 p2 p3 p4 m1
    run_family --protect-sample t0 t1 t2
    echo
    echo "### the checks"
    # N: the template has no defined name; the sample adds emend_global and
    # emend_local and removes one. L: the template's sheet has no cell, no rels
    # part and no relationships prefix; every control adds one cell, two links
    # and one external relationship. P: the template has no core part (P0's is
    # created); P2 holds a core part with no property, P4 one holding the
    # title. T: the template's sheet and workbook have no protection element.
    names_line() { printf 'names\tnames_before=%s\tnames_after=%s\tlocal_after=%s\tchain_before=0\tchain_after=0\tfull_calc=1\tnames_removed=%s' "$@"; }
    link_line() { printf 'link\tcells_before=0\tcells_after=1\tlinks_before=0\tlinks_after=%s\texternal_rels_before=0\texternal_rels_after=1\tr_bound_before=0' "$1"; }
    props_line() { printf 'props\tcore_before=%s\ttitle_after=1\tkeywords_after=1\tmodified_after=1\tprops_before=%s\tprops_after=%s' "$@"; }
    protect_line() { printf 'protect\tsheet_prot_before=%s\tsheet_prot_after=1\tbook_prot_before=0\tbook_prot_after=1\thash=C678' "$1"; }
    N_NONE=$(names_line 0 2 1 1)
    N_ONE=$(names_line 1 3 1 2)
    N_LOCAL=$(names_line 1 3 2 2)
    L_LINE=$(link_line 2)
    L_MORE=$(link_line 3)
    P_NONE=$(props_line 0 0 3)
    P_EMPTY=$(props_line 1 0 3)
    P_TITLE=$(props_line 1 1 3)
    T_NONE=$(protect_line 0)
    T_ONE=$(protect_line 1)
    # The refusals: case, constant, the control's case and its line. A refusal
    # that holds records its constant as reached.
    : >"$B/reached"
    refusal() {
      local case=$1 name=$2 ctl=$3 want=$4 expect
      expect=$(msg "$name")
      check "${ctl^^}: exit 0, its line, an output (the control for ${case^^})" "$(yn line_is "$ctl" "$want")"
      check "${case^^}: exit 2, no stdout, the error line exactly $name's message" "$(yn refused_with "$case" "$expect")"
      check "${case^^}: no output file" "$(yn no_output "$case")"
      if refused_with "$case" "$expect"; then printf '%s\n' "$name" >>"$B/reached"; fi
    }
    # reused <case> <label> <message> <control> <its line>: a refusal whose
    # message is outside the eleven (part 2's unbound prefix, NO_SUCH_PART).
    reused() {
      local case=$1 label=$2 expect=$3 ctl=$4 want=$5
      check "${ctl^^}: exit 0, its line, an output (the control for ${case^^})" "$(yn line_is "$ctl" "$want")"
      check "${case^^}: exit 2, no stdout, the error line exactly $label" "$(yn refused_with "$case" "$expect")"
      check "${case^^}: no output file" "$(yn no_output "$case")"
    }
    echo "#### N (--names-sample)"
    refusal n1 NAME_EXISTS n0 "$N_NONE"
    refusal n1 NAME_EXISTS n3 "$N_ONE"
    refusal n2 NAME_EXISTS n3 "$N_ONE"
    refusal n2 NAME_EXISTS n6 "$N_LOCAL"
    refusal n4 TWO_BOOK_ELEMENTS n5 "$N_NONE"
    refusal n4 TWO_BOOK_ELEMENTS n0 "$N_NONE"
    echo "command: git show <phase commit>:crates/emend/src/xml.rs | grep -o the quoted message that starts 'an element or attribute uses a prefix'"
    git show "$C:crates/emend/src/xml.rs" | LC_ALL=C "$G" -o '"an element or attribute uses a prefix[^"]*"' >"$B/unbound.found"
    echo "  found $(count_lines "$B/unbound.found") time(s): $(head -n 1 "$B/unbound.found")"
    check "part 2's unbound-prefix message is found once in the phase commit's xml.rs" "$(yn [ "$(count_lines "$B/unbound.found")" = 1 ])"
    UNBOUND="error: $(head -n 1 "$B/unbound.found" | tr -d '"')"
    check "the unbound-prefix message is not empty" "$(yn [ "$UNBOUND" != "error: " ])"
    reused n7 "part 2's unbound-prefix message" "$UNBOUND" n8 "$N_ONE"
    echo "#### L (--link-sample)"
    refusal l1 TWO_SHEET_ELEMENTS l2 "$L_LINE"
    refusal l1 TWO_SHEET_ELEMENTS l0 "$L_LINE"
    reused l3 "part 2's unbound-prefix message" "$UNBOUND" l4 "$L_LINE"
    reused l3 "part 2's unbound-prefix message" "$UNBOUND" l0 "$L_LINE"
    echo "#### P and M1 (--props-sample)"
    echo "  (change AB) M1: the sample reads the properties before any edit, so its refusal comes from that read; the write's refusal of P3 ruling 1 is reached by the crate tests alone"
    refusal p1 CORE_NO_PREFIX p2 "$P_EMPTY"
    refusal p1 CORE_NO_PREFIX p0 "$P_NONE"
    refusal p3 CORE_TWO p4 "$P_TITLE"
    refusal p3 CORE_TWO p2 "$P_EMPTY"
    NO_PART=$(msg_any NO_SUCH_PART)
    echo "  NO_SUCH_PART, read by name from the whole source: $NO_PART"
    check "NO_SUCH_PART's message was read and is not empty" "$(yn [ "$NO_PART" != "" ])"
    reused m1 "NO_SUCH_PART's message (P3 ruling 1)" "$NO_PART" p2 "$P_EMPTY"
    reused m1 "NO_SUCH_PART's message (P3 ruling 1)" "$NO_PART" p0 "$P_NONE"
    echo "#### T (--protect-sample)"
    refusal t1 TWO_SHEET_ELEMENTS t2 "$T_ONE"
    refusal t1 TWO_SHEET_ELEMENTS t0 "$T_NONE"
    echo "#### the helpers' controls"
    unbound_ctl() { if refused_with n8 "$UNBOUND"; then return 1; else return 0; fi; }
    check "control: refused_with says no on N8's run against the unbound-prefix message" "$(yn unbound_ctl)"
    l_unbound_ctl() { if refused_with l4 "$UNBOUND"; then return 1; else return 0; fi; }
    check "control: refused_with says no on L4's run against the unbound-prefix message" "$(yn l_unbound_ctl)"
    not_refused() { if refused_with n0 "$(msg NAME_EXISTS)"; then return 1; else return 0; fi; }
    check "control: refused_with says no on N0's run" "$(yn not_refused)"
    n_other() { if refused_with n1 "$(msg TWO_BOOK_ELEMENTS)"; then return 1; else return 0; fi; }
    check "control: refused_with says no on N1's run against the two-container message" "$(yn n_other)"
    l_other() { if refused_with l1 "$UNBOUND"; then return 1; else return 0; fi; }
    check "control: refused_with says no on L1's run against the unbound-prefix message" "$(yn l_other)"
    p_other() { if refused_with p1 "$(msg CORE_TWO)"; then return 1; else return 0; fi; }
    check "control: refused_with says no on P1's run against the two-elements message" "$(yn p_other)"
    m_other() { if refused_with m1 "$(msg CORE_NO_PREFIX)"; then return 1; else return 0; fi; }
    check "control: refused_with says no on M1's run against the no-prefix message" "$(yn m_other)"
    m_not() { if refused_with p2 "$NO_PART"; then return 1; else return 0; fi; }
    check "control: refused_with says no on P2's run against NO_SUCH_PART's message" "$(yn m_not)"
    t_other() { if refused_with t1 "$(msg CORE_NO_PREFIX)"; then return 1; else return 0; fi; }
    check "control: refused_with says no on T1's run against the no-prefix message" "$(yn t_other)"
    empty_message() { if refused_with p1 ""; then return 1; else return 0; fi; }
    check "control: refused_with says no against an empty message" "$(yn empty_message)"
    n_line_ctl() { if line_is n6 "$N_ONE"; then return 1; else return 0; fi; }
    check "control: line_is says no on N6's run against N3's line" "$(yn n_line_ctl)"
    l_line_ctl() { if line_is l2 "$L_MORE"; then return 1; else return 0; fi; }
    check "control: line_is says no on L2's run against a line with one link more" "$(yn l_line_ctl)"
    p_line_ctl() { if line_is p2 "$P_TITLE"; then return 1; else return 0; fi; }
    check "control: line_is says no on P2's run against P4's line" "$(yn p_line_ctl)"
    t_line_ctl() { if line_is t2 "$T_NONE"; then return 1; else return 0; fi; }
    check "control: line_is says no on T2's run against T0's line" "$(yn t_line_ctl)"
    out_ctl() { if line_is m1 ""; then return 1; else return 0; fi; }
    check "control: line_is says no on M1's refused run, which left no output" "$(yn out_ctl)"
    nout=$(find "$B/out" -type f | wc -l)
    echo "  output files: $nout, the thirteen controls' outputs (N0, N3, N5, N6, N8, L0, L2, L4, P0, P2, P4, T0, T2)"
    check "no output but the thirteen controls', and no temporary beside them" "$(yn [ "$nout" = 13 ])"
    echo
    echo "### P0's created core part against the bytes new_core_part builds (change Y, P3 verification ruling 7)"
    echo "command: git show <phase commit>:crates/emend/src/package.rs, the function new_core_part, from its signature to its closing brace"
    awk '/^fn new_core_part\(/ { on = 1 } on { print } on && /^}/ { exit }' "$B/package.rs" >"$B/new_core_part.rs"
    sed 's/^/    /' "$B/new_core_part.rs"
    check "the function was found and printed" "$(yn [ "$(count_matches -F 'fn new_core_part(' "$B/new_core_part.rs")" = 1 ])"
    cat >"$B/core-want.py" <<'PY'
    """The bytes new_core_part builds for the properties sample's three edits
    (the title "emend sample", the keywords "emend", the modified date
    2026-01-01T00:00:00Z, in the order the sample sets them): the declaration
    line, the root binding cp, dc, dcterms, dcmitype and xsi, in that order, to
    the five namespace constants read from the source by name, each element as
    core_element writes it (dc:title, cp:keywords, dcterms:modified with
    xsi:type="dcterms:W3CDTF"), and the root's end tag. With --drop, the same
    bytes without the dcmitype binding (the control).
    Usage: core-want.py <package.rs> <out> [--drop]."""
    import re
    import sys
    
    text = open(sys.argv[1]).read()
    ns = {}
    for name in ["CP_NS", "DC_NS", "DCTERMS_NS", "DCMITYPE_NS", "XSI_NS"]:
        got = re.findall(r'^const ' + name + r': &\[u8\] = b"([^"]*)";', text, re.M)
        assert len(got) == 1, name
        ns[name] = got[0].encode()
        print("%s %s" % (name, got[0]))
    root = b'<cp:coreProperties xmlns:cp="' + ns["CP_NS"] + b'" xmlns:dc="' + ns["DC_NS"] + b'"'
    root += b' xmlns:dcterms="' + ns["DCTERMS_NS"] + b'"'
    if "--drop" not in sys.argv:
        root += b' xmlns:dcmitype="' + ns["DCMITYPE_NS"] + b'"'
    root += b' xmlns:xsi="' + ns["XSI_NS"] + b'">'
    body = (b"<dc:title>emend sample</dc:title><cp:keywords>emend</cp:keywords>"
            b'<dcterms:modified xsi:type="dcterms:W3CDTF">2026-01-01T00:00:00Z</dcterms:modified>')
    want = b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n' + root + body + b"</cp:coreProperties>"
    open(sys.argv[2], "wb").write(want)
    PY
    sed 's/^/    /' "$B/core-want.py"
    echo "command: python3 <scratch>/w/core-want.py <scratch>/w/package.rs <scratch>/w/core-want.xml"
    python3 "$B/core-want.py" "$B/package.rs" "$B/core-want.xml" >"$B/core-want.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/core-want.out"
    python3 "$B/core-want.py" "$B/package.rs" "$B/core-drop.xml" --drop >/dev/null 2>&1
    echo "command: python3 -c (zipfile) reading docProps/core.xml from <scratch>/w/out/p0.xlsx into <scratch>/w/core-got.xml"
    python3 -c 'import sys, zipfile; open(sys.argv[2], "wb").write(zipfile.ZipFile(sys.argv[1]).read("docProps/core.xml"))' "$B/out/p0.xlsx" "$B/core-got.xml" >"$B/core-got.out" 2>&1
    echo "  exit: $?"
    echo "  the built bytes ($(wc -c <"$B/core-want.xml") bytes), shown:"
    sed 's/^/    /' "$B/core-want.xml"; echo
    echo "  P0's created part ($(wc -c <"$B/core-got.xml") bytes), shown:"
    sed 's/^/    /' "$B/core-got.xml"; echo
    WANT_SHA=$(sha_of "$B/core-want.xml")
    GOT_SHA=$(sha_of "$B/core-got.xml")
    DROP_SHA=$(sha_of "$B/core-drop.xml")
    echo "  sha256: built $WANT_SHA; P0's $GOT_SHA; the control's (no dcmitype binding) $DROP_SHA"
    check "the five namespace constants were read from the source" "$(yn [ "$(count_lines "$B/core-want.out")" = 5 ])"
    check "P0's created core part is byte for byte the bytes new_core_part builds, by sha256" "$(yn [ "$GOT_SHA" = "$WANT_SHA" ])"
    check "P0's created core part is not empty" "$(yn [ -s "$B/core-got.xml" ])"
    drop_ctl() { if [ "$GOT_SHA" = "$DROP_SHA" ]; then return 1; else return 0; fi; }
    check "control: the same comparison refuses the bytes without the dcmitype binding" "$(yn drop_ctl)"
    echo
    echo "### the messages reached and the messages stated unreachable, as sets (change X)"
    cat >"$B/unreachable" <<'UNR'
    DEFINED_NAME_INVALID	raised at the call; the sample's names emend_global and emend_local are the tool's constants, inside the rule, and its texts are never empty
    NO_SUCH_NAME	the sample removes emend_local for S from the output its own write gave emend_local for S, so the name and scope are always there
    LINK_EMPTY	raised at the call; the sample's external target is the tool's constant and its location a quoted sheet name, never empty
    NO_SUCH_LINK	the sample sets links and removes none, so no removal can find a cell without one
    PROPERTY_INVALID	raised at the call; the sample's modified date is the tool's constant, of the one form
    PASSWORD_INVALID	raised at the call; the sample's password is the tool's constant, five printable ASCII characters
    UNR
    echo "  reached here, from the checks above that held (each constant once):"
    LC_ALL=C sort -u "$B/reached" >"$B/reached.set"
    sed 's/^/    /' "$B/reached.set"
    echo "  stated unreachable, with the reason:"
    sed 's/^/    /' "$B/unreachable"
    cut -f1 "$B/unreachable" | LC_ALL=C sort -u >"$B/unreachable.set"
    cut -f1 "$B/part.tsv" | LC_ALL=C sort -u >"$B/part.set"
    LC_ALL=C sort -u "$B/reached.set" "$B/unreachable.set" >"$B/union.set"
    nboth=$(LC_ALL=C comm -12 "$B/reached.set" "$B/unreachable.set" | count_lines /dev/stdin)
    echo "  the eleven read by name $(count_lines "$B/part.set"); reached $(count_lines "$B/reached.set"); stated unreachable $(count_lines "$B/unreachable.set"); in both $nboth"
    check "five of the eleven reached, as P4 counts them" "$(yn [ "$(count_lines "$B/reached.set")" = 5 ])"
    union_is_part() { cmp -s "$B/union.set" "$B/part.set"; }
    check "reached and stated unreachable together are exactly the eleven constants" "$(yn union_is_part)"
    check "no constant is both reached and stated unreachable" "$(yn [ "$nboth" = 0 ])"
    reasons_ok() { [ "$(awk -F"$TAB" '$2 != "" { n++ } END { print n + 0 }' "$B/unreachable")" = "$(count_lines "$B/unreachable")" ]; }
    check "every unreachable constant carries its reason" "$(yn reasons_ok)"
    union_ctl() { if LC_ALL=C sort -u "$B/unreachable.set" | cmp -s - "$B/part.set"; then return 1; else return 0; fi; }
    check "control: the comparison refuses the stated-unreachable set alone, without the reached constants" "$(yn union_ctl)"
    echo
    echo "### six usage shapes (change Z)"
    run_bin u1 "$B/fx/n0.xlsx" "$B/out/u1.xlsx" --names-sample extra
    check "U1: exit 2, the usage line" "$(yn usage_refused u1)"
    run_bin u2 "$B/fx/l0.xlsx" "$B/out/u2.xlsx" --link-sample extra
    check "U2: exit 2, the usage line" "$(yn usage_refused u2)"
    run_bin u3 "$B/fx/p0.xlsx" "$B/out/u3.xlsx" --props-sample extra
    check "U3: exit 2, the usage line" "$(yn usage_refused u3)"
    run_bin u4 "$B/fx/t0.xlsx" "$B/out/u4.xlsx" --protect-sample extra
    check "U4: exit 2, the usage line" "$(yn usage_refused u4)"
    run_bin u5 "$B/fx/p0.xlsx" "$B/out/u5.xlsx" --props-sample --protect-sample
    check "U5: exit 2, the usage line" "$(yn usage_refused u5)"
    run_bin u6 "$B/fx/l0.xlsx" "$B/out/u6.xlsx" --link-sample --names-sample
    check "U6: exit 2, the usage line" "$(yn usage_refused u6)"
    usage_ctl() { if usage_refused p0; then return 1; else return 0; fi; }
    check "control: usage_refused says no on P0's run" "$(yn usage_ctl)"
    check "U1 to U6 left no output" "$(yn [ "$(find "$B/out" -type f | wc -l)" = 13 ])"
    git worktree remove --force "$TREE" >/dev/null 2>&1
    check "the worktree is gone from git's list" "$(yn [ "$(git worktree list --porcelain | count_matches -F "$TREE" /dev/stdin)" = 0 ])"
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.stdout "$B"/*.stderr "$B"/gen-p4.out "$B"/core-want.out "$B"/core-got.out; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or records: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's logs or records" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/negative.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
  control count_matches with a regular expression: 2 (expect 2)
  control count_matches on an unreadable file: error (expect error)
  control count_matches on readable plus unreadable: error (expect error)
  control count_from_file on the same file: 2 (expect 2)
  control count_from_file on a file with none: 0 (expect 0)
  control count_from_file on an unreadable file: error (expect error)
  control count_bytes, control bytes in a file with ESC, ESC and SI: 3 (expect 3)
  control count_bytes, non-ASCII bytes in a file with one two-byte character: 2 (expect 2)
  control count_bytes on a clean file: 0 (expect 0)
  control count_bytes on an unreadable file: error (expect error)
  control count_lines on a three-line file: 3 (expect 3)
  control count_lines on an unreadable file: error (expect error)
  control count_matches_i on mixed case: 2 (expect 2)
  control count_matches on the same file, case sensitive: 1 (expect 1)
  control count_matches_i on an unreadable file: error (expect error)
  control run_lines on a command printing three lines: 3 (expect 3)
  control run_lines on a command printing nothing: 0 (expect 0)
