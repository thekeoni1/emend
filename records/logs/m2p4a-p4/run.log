            elif m.group(2):
                if depth == 0:
                    out.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        named = []
        for (x, y) in out:
            q = re.match(rb"<([^\s/>]+)", data[x:y]).group(1).decode()
            p, _, n = q.rpartition(":")
            own = declarations(data[x:data.find(b">", x) + 1])
            ns = (own.get(p) or decls.get(p)) if p else (default_ns(data[x:data.find(b">", x) + 1]) or dflt)
            named.append((x, y, (ns, n)))
        return named
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def escaped(text):
