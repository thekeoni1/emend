    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    check "control: not_head says no for HEAD itself, so it can fail" "$(yn [ "$(yn not_head "$C")" = no ])"
    echo "phase: Milestone 2 part 4a P4 (specs/0019-names-links-properties-protection.md) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in (change AT)"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    
    # Change AI: the two move checks as functions, run over planted inputs every
    # time below, and over a real moved keep or run directory when there is one.
    # keep_pairs_ok <listing>: the .in.xlsx lines times two equal the listing's
    # lines (P2 ruling 14 of specs/0018; the pattern in double quotes so the tab
    # is interpolated).
    keep_pairs_ok() {
      local pairs files
      pairs=$(count_matches -E "[.]in[.]xlsx${TAB}" "$1")
      files=$(count_lines "$1")
      [ "$files" -ge 2 ] && [ "$((pairs * 2))" = "$files" ]
    }
    # run_listing <dir> <listing>: the listing of a run directory, one line per
    # file, path and bytes (specs/0018 P2 verification ruling 4's form).
    run_listing() { (cd "$1" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$2"; }
    # run_listing_ok <dir> <listing>: the listing names each file once and at
    # least one.
    run_listing_ok() {
      local files lines uniq
      files=$(find "$1" -type f | wc -l)
      lines=$(count_lines "$2")
      uniq=$(cut -f1 "$2" | LC_ALL=C sort -u | count_lines /dev/stdin)
      [ "$files" -ge 1 ] && [ "$lines" = "$files" ] && [ "$uniq" = "$files" ]
    }
    
    for sr in $SUPERSEDED_RUN; do
      SUP_OUT=$CORPUS/runs/$sr
      SUP_TO=$SELF_DIR/out/superseded/run-$sr
      echo "a superseded run directory, moved before this run: <corpus>/runs/$sr to <scripts>/out/superseded/run-$sr"
      if [ -d "$SUP_OUT" ]; then
        echo "command: sha256sum <corpus>/runs/$sr/summary.host.tsv and summary.i686.tsv; mv <corpus>/runs/$sr <scripts>/out/superseded/run-$sr"
        for sl in host i686; do
          if [ -f "$SUP_OUT/summary.$sl.tsv" ]; then echo "    summary.$sl.tsv sha256 $(sha_of "$SUP_OUT/summary.$sl.tsv")"; else echo "    summary.$sl.tsv: NO HASH EXISTS, the file is not there"; fi
        done
        run_listing "$SUP_OUT" "$B/superseded-run-$sr.listing"
        echo "command: (cd <corpus>/runs/$sr && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum"
        echo "    files $(find "$SUP_OUT" -type f | wc -l); listing lines $(count_lines "$B/superseded-run-$sr.listing"); listing sha256 $(sha_of "$B/superseded-run-$sr.listing")"
        check "the listing of $sr names each of its files once" "$(yn run_listing_ok "$SUP_OUT" "$B/superseded-run-$sr.listing")"
        mkdir -p "$SELF_DIR/out/superseded" && mv "$SUP_OUT" "$SUP_TO"
      fi
      sup_moved() { [ ! -e "$SUP_OUT" ] && [ -d "$SUP_TO" ]; }
      check "the superseded run directory $sr is moved, not removed, before the run" "$(yn sup_moved)"
    done
    if [ -n "$SUPERSEDED_KEEP" ]; then
      KEEP_TO=$SELF_DIR/out/superseded/keep-$SUPERSEDED_KEEP
      echo "the superseded keep (change I), moved before this run: <keep> to <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
      if [ -d "$KEEP" ]; then
        (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/superseded-keep.listing"
        echo "command: (cd <keep> && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum; the .in.xlsx files counted; mv <keep> <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
        echo "    pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/superseded-keep.listing"); files $(count_lines "$B/superseded-keep.listing"); listing sha256 $(sha_of "$B/superseded-keep.listing")"
        check "the moved keep's pairs times two equals its files" "$(yn keep_pairs_ok "$B/superseded-keep.listing")"
        if [ -e "$KEEP_TO" ]; then echo "    $KEEP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$KEEP" "$KEEP_TO"; fi
      else
        echo "    NO LISTING EXISTS: there is no keep in place to move"
      fi
      keep_moved() { [ ! -e "$KEEP" ] && [ -d "$KEEP_TO" ]; }
      check "the superseded keep is moved, not removed, before the run" "$(yn keep_moved)"
    fi
    echo "superseded run directories named: ${SUPERSEDED_RUN:-none}; superseded keep named: ${SUPERSEDED_KEEP:-none}"
    echo
    echo "## the two move checks over planted inputs, run every time (change AI)"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\n' "$TAB" "$TAB" >"$B/c-keep.listing"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\ny.1.out.xlsx%s1\n' "$TAB" "$TAB" "$TAB" >"$B/c-keep-odd.listing"
    echo "  planted keep listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep.listing"), files $(count_lines "$B/c-keep.listing"); with an unpaired output: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep-odd.listing"), files $(count_lines "$B/c-keep-odd.listing")"
    check "keep_pairs_ok passes a planted listing of one whole pair" "$(yn keep_pairs_ok "$B/c-keep.listing")"
    kp_ctl() { if keep_pairs_ok "$B/c-keep-odd.listing"; then return 1; else return 0; fi; }
    check "control: keep_pairs_ok refuses a planted listing with an unpaired output" "$(yn kp_ctl)"
    mkdir -p "$B/c-run/abc123" && printf 'a' >"$B/c-run/summary.host.tsv" && printf 'bb' >"$B/c-run/abc123/out.host.xlsx" && printf 'ccc' >"$B/c-run/abc123/stdout.host.txt"
    run_listing "$B/c-run" "$B/c-run.listing"
    echo "  planted run directory: files $(find "$B/c-run" -type f | wc -l); listing lines $(count_lines "$B/c-run.listing"); listing sha256 $(sha_of "$B/c-run.listing")"
    check "run_listing_ok passes the planted run directory's own listing" "$(yn run_listing_ok "$B/c-run" "$B/c-run.listing")"
    { cat "$B/c-run.listing"; head -n 1 "$B/c-run.listing"; } >"$B/c-run-dup.listing"
    rl_ctl() { if run_listing_ok "$B/c-run" "$B/c-run-dup.listing"; then return 1; else return 0; fi; }
    check "control: run_listing_ok refuses a listing that names one file twice" "$(yn rl_ctl)"
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory for the tests, <build>/target (CARGO_TARGET_DIR)"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the copy child and --lo-timeout $LO_TIMEOUT_S per conversion, the figures every corpus run of this milestone used; not tuned during the run."
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh is sourced from it by this log; scripts/passthrough-run.sh, scripts/passthrough-record.py and scripts/edit-open-check.sh are run from it, and the runner and the open check each source scripts/lo-check.sh, which is never run; the five record pairs are installed into its $RECORDS_DEST/; the template's parts are read from it by git show for the retag fixture; the test.log and size.log given are read from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scripts> stands for <home>/.cache/emend-build/m2p4a-p4/scripts on the disk, this script's own directory, which holds the script and the four comparisons namescmp.py, linkscmp.py, propscmp.py and protectcmp.py (copied into <scratch>/w and printed from there); the five record pairs are written into <scripts>/out/records first, a superseded run directory and a superseded keep are moved into <scripts>/out/superseded, and this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory (the comparison scripts and their outputs, derived tables, the planted listings and run directory, the retag fixture and its outputs, the i686 keep's listing), removed at exit"
    echo "root: <build> stands for <home>/.cache/emend-build/m2p4a-p4/run on the disk, or RUN_BUILD_ROOT when set: <build>/target the test builds for the keep, <build>/keep-i686.<pid> the i686 keep, removed after the comparison"
    echo "root: <sizebuild> stands for <home>/.cache/emend-build/m2p4a-p4/size on the disk, or RUN_SIZE_BUILD when set, size.log's build directory, from whose target the release binaries are run where size.log built them; read, never written"
    echo "root: <keep> stands for <home>/.cache/emend-build/m2p4a-p4/keep-host on the disk, or RUN_KEEP when set, this phase's host keep; kept after the run for planning"
    echo "root: <corpus> stands for the private corpus directory (the manifest and the inputs under <corpus>/corpus, and the phase run directories under <corpus>/runs, read; this log's four run directories <corpus>/runs/$DATE-$SHORT-<sample>$RUN_SUFFIX, written)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$B" "$SELF_DIR" "$BUILD_ROOT" "$MAIN" "$KEEP" "$CORPUS" "$SIZE_BUILD")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots other than <home> are distinct, none inside another" "$(yn roots_distinct)"
    roots_ctl() { if apart "$CARGO_TARGET_DIR" "$BUILD_ROOT"; then return 1; else return 0; fi; }
    check "control: apart refuses <build>/target against <build>, which holds it" "$(yn roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    check "ANTHROPIC_API_KEY is not set" "$(yn [ -z "${ANTHROPIC_API_KEY:-}" ])"
    for s in $SAMPLES; do echo "the $s sample: run directory <corpus>/runs/$(run_of "$s"); record stem $(stem_of "$s")"; done
    echo "the open-check record stem: $STEM_OPEN; the records' destination: $RECORDS_DEST"
    echo "at entry: status lines $entry_all; of them this phase's logs or records $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts, against the phase commit, and the committed spec"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh scripts/edit-open-check.sh; do
      check "$s in the main tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { if [ "$(git show "$C:scripts/excel-check-list.py" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/edit-open-check.sh)" ]; then return 1; else return 0; fi; }
    check "control: the same hash comparison tells two different scripts apart" "$(yn tree_ctl)"
    spec_now=$(sha_of "$SPEC")
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "  the spec, committed: $SPEC, sha256 $spec_now in the tree, $spec_committed at the phase commit; the pin, the input SPEC_SHA (change AR): $SPEC_SHA"
    spec_ok() { [ "$spec_now" = "$SPEC_SHA" ]; }
    check "the spec in the tree is at the one pinned hash" "$(yn spec_ok)"
    spec_same() { [ "$spec_now" = "$spec_committed" ]; }
    check "the spec in the tree is the phase commit's (committed, change AX)" "$(yn spec_same)"
    spec_ctl() { local spec_now=$spec_committed SPEC_SHA=1111111111111111111111111111111111111111111111111111111111111111; if spec_ok; then return 1; else return 0; fi; }
    check "control: the same check refuses the spec against another hash" "$(yn spec_ctl)"
    echo "command: git log --format=%H <P1's record commit>..<phase commit> -- scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh tools/xlsx-diff"
    P1_REC=$(by_subject 'M2 part 4a P1 record:')
    git log --format=%H "$P1_REC..$C" -- scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh tools/xlsx-diff >"$B/tooling.commits"
    echo "  commits since P1's record that touch the runner, the record script, lo-check.sh or xlsx-diff: $(count_lines "$B/tooling.commits")"
    check "the runner, the record script and xlsx-diff are those the phase runs used (no commit touches them since P1's record)" "$(yn [ "$(count_lines "$B/tooling.commits")" = 0 ])"
    echo "command: podman image exists $IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    
    echo
    echo "## the release binaries size.log hashed, run where it built them (change BB)"
    echo "command: sha256sum $SIZE_LOG, and sed for its hash: lines"
    echo "  $SIZE_LOG: sha256 $(sha_of "$SIZE_LOG"), $(wc -c <"$SIZE_LOG") bytes"
    size_log_phase() { [ "$(count_matches -E "^about: M2 part 4a P4 phase commit $C; HEAD at run: $C\$" "$SIZE_LOG")" = 1 ] && [ "$(count_matches -xF 'size log checks all as expected: yes' "$SIZE_LOG")" = 1 ]; }
    check "size.log is this phase's, at this phase commit, and ends all as expected" "$(yn size_log_phase)"
    size_ctl() { local C=$NULL_SHA; if size_log_phase; then return 1; else return 0; fi; }
    check "control: the same check says no for the null commit" "$(yn size_ctl)"
    size_hash() { sed -n "s/^hash: $1 $2 \([0-9a-f]\{64\}\)\$/\1/p" "$SIZE_LOG"; }
    PT_host=$SIZE_BUILD/target/release/emend-copy
    XD_host=$SIZE_BUILD/target/release/xlsx-diff
    PT_i686=$SIZE_BUILD/target/$I686/release/emend-copy
    XD_i686=$SIZE_BUILD/target/$I686/release/xlsx-diff
    bin_is_hashed() {
      local given
      given=$(size_hash "$1" "$2")
      [ -f "$3" ] && [ -n "$given" ] && [ "$(sha_of "$3")" = "$given" ] && [ "$(size_hash "$1" "$2" | count_lines /dev/stdin)" = 1 ]
    }
    # show_bin <name> <target> <path>: the binary's hash beside size.log's.
    show_bin() {
      if [ -f "$3" ]; then
        echo "  $3: sha256 $(sha_of "$3"), bytes $(stat -c %s "$3"); size.log's hash: line: $(size_hash "$1" "$2")"
      else
        echo "  $3: MISSING; size.log's hash: line: $(size_hash "$1" "$2")"
      fi
      check "$1 $2 is the binary size.log hashed, once" "$(yn bin_is_hashed "$1" "$2" "$3")"
    }
    show_bin emend-copy host "$PT_host"
    show_bin xlsx-diff host "$XD_host"
    show_bin emend-copy "$I686" "$PT_i686"
    show_bin xlsx-diff "$I686" "$XD_i686"
    hash_ctl() { [ -z "$(size_hash emend-copy no-such-target)" ]; }
    check "control: the hash reader finds nothing for a target size.log does not name" "$(yn hash_ctl)"
    hash_bin_ctl() { if bin_is_hashed emend-copy host "$XD_host"; then return 1; else return 0; fi; }
    check "control: bin_is_hashed refuses xlsx-diff offered as emend-copy" "$(yn hash_bin_ctl)"
    echo "  $(rustc --version)"
    
    manifest_rows=$(awk -F'\t' 'NR > 1 { n++ } END { print n + 0 }' "$CORPUS/manifest.tsv")
    echo "  corpus manifest rows: $manifest_rows"
    check "the corpus holds its 27 workbooks" "$(yn [ "$manifest_rows" = 27 ])"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv" >"$B/order"
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    sum_col() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { n += $k } END { print n + 0 }' "$1"; }
    # measured_out <summary.tsv>: the summary without its two measured columns,
    # wall_s and peak_rss_kb (part 3 P4's change Z).
    measured_out() { awk -F'\t' -v OFS='\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "wall_s" || $i == "peak_rss_kb") drop[i] = 1 } { out = ""; for (i = 1; i <= NF; i++) if (!(i in drop)) out = out (out == "" ? "" : OFS) $i; print out }' "$1"; }
    # same_file <a> <b>: both absent, or both present and byte-identical.
    same_file() { if [ -e "$1" ] || [ -e "$2" ]; then [ -f "$1" ] && [ -f "$2" ] && cmp -s "$1" "$2"; else return 0; fi; }
    # out_of <run dir> <id> <label> <ext>: the output file's path.
    out_of() { printf '%s/%s/out.%s.%s' "$1" "$2" "$3" "$4"; }
    
    echo
    echo "## the run log's comparisons (python3, zipfile, byte spans and ElementTree; changes BE to BG)"
    for cmp in namescmp linkscmp propscmp protectcmp; do
      cp "$SELF_DIR/$cmp.py" "$B/$cmp.py"
      echo "command: sed 's/^/    /' <scratch>/w/$cmp.py (copied from <scripts>/$cmp.py); sha256 $(sha_of "$B/$cmp.py"), $(wc -c <"$B/$cmp.py") bytes"
      sed 's/^/    /' "$B/$cmp.py"
    done
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    FLAGS_names="rest_same names_prefix added_tags added_text_len added_bytes container_place calc_pr root_order one_each names_read"
    FLAGS_link="rest_same root_tag links_prefix added_tags added_bytes rel_target rels_bytes sheet_data container_place root_order one_each links_read"
    FLAGS_props="root_tag rest_same three_once three_text in_place appended element_bytes xsi_type props_read"
    FLAGS_protect="hash sheet_rest sheet_elem sheet_place book_rest book_elem book_place read"
    all_yes() { local f; for f in $2; do [ "$(kv "$1" "$f")" = yes ] || return 1; done; }
    ay_ctl() { if all_yes "found=1" "$FLAGS_names"; then return 1; else return 0; fi; }
    check "control: all_yes refuses a line with no flags" "$(yn ay_ctl)"
    # Change BF: the protect line's hash is the comparison's own hash of the
    # tool's constant.
    hash_agrees() { [ -n "$(kv "$2" hash_value)" ] && [ "$(kv "$1" hash)" = "$(kv "$2" hash_value)" ]; }
    ha_ok() { hash_agrees "$(printf 'protect\thash=C678')" "hash_value=C678"; }
    check "control: hash_agrees accepts a line whose hash is the comparison's" "$(yn ha_ok)"
    ha_ctl() { if hash_agrees "$(printf 'protect\thash=C679')" "hash_value=C678"; then return 1; else return 0; fi; }
    check "control: hash_agrees refuses a line with another hash" "$(yn ha_ctl)"
    ha_ctl2() { if hash_agrees "$(printf 'protect\thash=')" "found=1"; then return 1; else return 0; fi; }
    check "control: hash_agrees refuses when neither side prints a hash" "$(yn ha_ctl2)"
    
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds, and of its entries and xml tables against
    the phase record's (part 3 P4's change AA, change BD). Reads the record's
    .txt and .md, the run directory's summary.<label>.tsv, entries.<label>.tsv
    and each workbook's diff.<label>.tsv, and the phase record's .txt; prints
    one "name: yes|no" line per check and one line of counts. It imports only
    the part-family rules from scripts/passthrough-record.py."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, tool_arg, phase_txt = sys.argv[1:7]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    phase = "\n".join(lines(phase_txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: " + tool_arg in text))
    checks.append(("the entries table is the phase record's", len(tables) == 3 and len(phase) == 3 and tables[1] == phase[1]))
    checks.append(("the xml table is the phase record's", len(tables) == 3 and len(phase) == 3 and tables[2] == phase[2]))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    echo
    echo "## the record check (python3), printed once, used for every sample (change BD)"
    sed 's/^/    /' "$B/reccheck.py"
    
    # sample_block <name>: the phase run directory, the corpus runs on both
    # targets with size.log's binaries, every output and table against the phase
    # run's, the comparison over every output with its plants, and the record
    # pair (changes BB to BF).
    sample_block() {
    NAME=$1
    EDIT=$(sample_flag "$NAME")
    RUN=$(run_of "$NAME")
    STEM_RUN=$(stem_of "$NAME")
    OUT=$CORPUS/runs/$RUN
    var=FLAGS_$NAME; FLAGS=${!var}
    echo
    echo "## the $NAME sample: $EDIT into <corpus>/runs/$RUN"
    echo "### the phase run directory, from its phase's record commit"
    PREC=$(by_subject "$(sample_phase_record "$NAME")")
    PMD=$(git show --name-only --format= "$PREC" | LC_ALL=C "$G" -E "$(sample_record_re "$NAME")")
    echo "command: git log --format=%H -n 1 -F --grep='$(sample_phase_record "$NAME")'; git show --name-only --format= <it>, the corpus record .md matching the sample; sed for the run directory its line 3 names"
    echo "  the record commit: ${PREC:-none}; its parent: $(git rev-parse "$PREC^" 2>/dev/null)"
    echo "  the corpus record: ${PMD:-none}"
    one_record() { [ -n "$PMD" ] && [ "$(printf '%s\n' "$PMD" | count_lines /dev/stdin)" = 1 ]; }
    check "the $NAME sample's record commit added exactly one matching corpus record .md" "$(yn one_record)"
    PDIR_NAME=$(git show "$C:$PMD" | sed -n 's/^Written by `scripts\/passthrough-record.py` from the run directory `\([^`]*\)`.*/\1/p')
    PDIR=$CORPUS/runs/$PDIR_NAME
    PTXT=${PMD%.md}.txt
    git show "$C:$PTXT" >"$B/$NAME-phase.txt"
    echo "  the phase run directory: <corpus>/runs/$PDIR_NAME; the one planning named: <corpus>/runs/$(sample_phase_dir "$NAME"); the phase record .txt: $PTXT (sha256 $(sha_of "$B/$NAME-phase.txt"))"
    check "the phase run directory the record names is the one planning named" "$(yn [ "$PDIR_NAME" = "$(sample_phase_dir "$NAME")" ])"
    prow() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } NR == 2 && k { print $k }' "$PDIR/run.$1.tsv"; }
    phase_dir_ok() {
      [ -n "$PDIR_NAME" ] && [ -d "$PDIR" ] || return 1
      local l
      for l in host i686; do
        [ -f "$PDIR/summary.$l.tsv" ] && [ -f "$PDIR/entries.$l.tsv" ] || return 1
        [ "$(prow "$l" commit)" = "$(git rev-parse "$PREC^")" ] || return 1
        [ "$(prow "$l" tool_args)" = "$EDIT" ] || return 1
      done
    }
    check "the phase run directory is there, both labels' tables in it, each run row naming the phase commit (its record commit's parent) and $EDIT" "$(yn phase_dir_ok)"
    PREFUSED=$(count_where "$PDIR/summary.host.tsv" outcome error)
    echo "  the phase run's refusals (outcome error, host): $PREFUSED; the phase run's rows: $(awk 'NR > 1' "$PDIR/summary.host.tsv" | wc -l)"
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      echo
      echo "### $label run, --tool-arg $EDIT"
      echo "command: scripts/passthrough-run.sh --label $label --passthrough <sizebuild>/target/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <sizebuild>/target/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --out <corpus>/runs/$RUN --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$OUT" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
        >"$B/run-$NAME-$label.stdout" 2>"$B/run-$NAME-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$NAME-$label.stderr")"
      sed 's/^/    /' "$B/run-$NAME-$label.stdout"
      check "$label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$label: its stderr is empty" "$(yn [ ! -s "$B/run-$NAME-$label.stderr" ])"
      SUM=$OUT/summary.$label.tsv
      PSUM=$PDIR/summary.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      echo "  summary rows: $rows; outcome ok: $(count_where "$SUM" outcome ok); outcome error: $(count_where "$SUM" outcome error); lo ok: $(count_where "$SUM" lo ok); lo_in ok: $(count_where "$SUM" lo_in ok); leftover no: $(count_where "$SUM" leftover no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      accepted() {
        local ok_rows=$((manifest_rows - PREFUSED)) col
        [ "$rows" = "$manifest_rows" ] || return 1
        [ "$(count_where "$SUM" outcome ok)" = "$ok_rows" ] || return 1
        [ "$(count_where "$SUM" outcome error)" = "$PREFUSED" ] || return 1
        for col in "lo ok" "lo_in ok" "leftover no" "order_preserved yes" "comment_equal yes" "files_identical no"; do
          [ "$(count_where "$SUM" ${col% *} ${col#* })" = "$ok_rows" ] || return 1
        done
        [ "$(sum_col "$SUM" recompressed)" = 0 ]
      }
      check "$label: 27 rows; every workbook ok but the phase run's refusals, lo and lo_in ok, no leftover, order and comment kept, files not identical, nothing recompressed" "$(yn accepted)"
      measured_out "$SUM" >"$B/$NAME-sum-$label"
      measured_out "$PSUM" >"$B/$NAME-psum-$label"
      check "$label: the summary is the phase run's, but for wall_s and peak_rss_kb" "$(yn cmp -s "$B/$NAME-sum-$label" "$B/$NAME-psum-$label")"
      check "$label: the entries table is the phase run's, byte for byte (every entry's status and flags)" "$(yn cmp -s "$OUT/entries.$label.tsv" "$PDIR/entries.$label.tsv")"
      nout=0; nline=0; ndiff=0; npresent=0
      while IFS="$TAB" read -r id ext; do
        a=$(out_of "$OUT" "$id" "$label" "$ext"); p=$(out_of "$PDIR" "$id" "$label" "$ext")
        if [ -f "$a" ]; then npresent=$((npresent + 1)); fi
        if same_file "$a" "$p"; then nout=$((nout + 1)); else echo "    $id: the output is not the phase run's"; fi
        if same_file "$OUT/$id/stdout.$label.txt" "$PDIR/$id/stdout.$label.txt"; then nline=$((nline + 1)); else echo "    $id: the tool's line is not the phase run's"; fi
        if same_file "$OUT/$id/diff.$label.tsv" "$PDIR/$id/diff.$label.tsv"; then ndiff=$((ndiff + 1)); else echo "    $id: the diff table is not the phase run's"; fi
      done <"$B/order"
      echo "  outputs present: $npresent; byte-identical to the phase run's by sha256 (or absent in both): $nout of $manifest_rows; tool lines the same: $nline; diff tables the same: $ndiff"
      check "$label: an output for every workbook but the phase run's refusals" "$(yn [ "$npresent" = "$((manifest_rows - PREFUSED))" ])"
      check "$label: every output byte-identical to the phase run's for the same workbook" "$(yn [ "$nout" = "$manifest_rows" ])"
      check "$label: every tool line the phase run's" "$(yn [ "$nline" = "$manifest_rows" ])"
      check "$label: every diff table the phase run's" "$(yn [ "$ndiff" = "$manifest_rows" ])"
      R=$OUT/run.$label.tsv
      bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] " " $k["tool_args"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C $EDIT" ]; }
      check "$label: the run row records the two binaries size.log hashed, the phase commit and $EDIT" "$(yn bins_in_row)"
      echo "  the comparison over every output, $label (change BE): id, then its line (counts and yes/no only)"
      nwb=0; nflags=0; nhash=0
      while IFS="$TAB" read -r id ext; do
        [ -f "$(out_of "$OUT" "$id" "$label" "$ext")" ] || continue
        nwb=$((nwb + 1))
        c=$(python3 "$B/$(cmp_of "$NAME").py" "$CORPUS/corpus/$id.$ext" "$(out_of "$OUT" "$id" "$label" "$ext")")
        printf '    %s cmp %s\n' "$id" "$(printf '%s' "$c" | tr '\t' ' ')"
        if all_yes "$c" "$FLAGS"; then nflags=$((nflags + 1)); else echo "    $id: a flag of the comparison does not hold"; fi
        if [ "$NAME" = protect ]; then
          if hash_agrees "$(cat "$OUT/$id/stdout.$label.txt")" "$c"; then nhash=$((nhash + 1)); else echo "    $id: the tool's hash is not the comparison's"; fi
        fi
      done <"$B/order"
      echo "  outputs compared: $nwb; every flag holds: $nflags"
      check "$label: the comparison read every output" "$(yn [ "$nwb" = "$npresent" ])"
      check "$label: every flag of the comparison holds on every output" "$(yn [ "$nflags" = "$nwb" ])"
      if [ "$NAME" = protect ]; then
        echo "  protect lines whose hash is the comparison's own hash of the tool's constant: $nhash"
        check "$label: every protect line's hash is the comparison's (change BF)" "$(yn [ "$nhash" = "$nwb" ])"
      fi
    done
    # The controls for the comparisons above, on this sample's own files.
    first_id=$(head -n 1 "$B/order" | cut -f1); first_ext=$(head -n 1 "$B/order" | cut -f2)
    second_id=$(sed -n 2p "$B/order" | cut -f1); second_ext=$(sed -n 2p "$B/order" | cut -f2)
    cp "$(out_of "$OUT" "$first_id" host "$first_ext")" "$B/c-out"
    printf 'x' >>"$B/c-out"
    out_ctl1() { if same_file "$B/c-out" "$(out_of "$PDIR" "$first_id" host "$first_ext")"; then return 1; else return 0; fi; }
    out_ctl2() { if same_file "$(out_of "$OUT" "$first_id" host "$first_ext")" "$(out_of "$PDIR" "$second_id" host "$second_ext")"; then return 1; else return 0; fi; }
    out_ctl3() { if same_file "$(out_of "$OUT" "$first_id" host "$first_ext")" "$B/no-such-file"; then return 1; else return 0; fi; }
    check "control: same_file tells the first output with one byte added from the phase run's" "$(yn out_ctl1)"
    check "control: same_file tells the first workbook's output from the second's in the phase run" "$(yn out_ctl2)"
    check "control: same_file tells a present output from an absent one" "$(yn out_ctl3)"
    awk -F'\t' -v OFS='\t' 'NR == 2 { for (i = 1; i <= NF; i++) if ($i == "ok") { $i = "error"; break } } { print }' "$B/$NAME-sum-host" >"$B/c-sum"
    sum_ctl() { if cmp -s "$B/c-sum" "$B/$NAME-psum-host"; then return 1; else return 0; fi; }
    check "control: the summary comparison tells a planted outcome from the phase run's" "$(yn sum_ctl)"
    measured_ctl() { [ "$(head -n 1 "$B/$NAME-sum-host" | tr '\t' '\n' | LC_ALL=C "$G" -cxE 'wall_s|peak_rss_kb')" = 0 ] && [ "$(head -n 1 "$OUT/summary.host.tsv" | tr '\t' '\n' | LC_ALL=C "$G" -cxE 'wall_s|peak_rss_kb')" = 2 ]; }
    check "control: measured_out drops exactly the two measured columns, which the summary holds" "$(yn measured_ctl)"
    
    echo
    echo "### $NAME: the planted-flag controls, host, each on the first workbook in manifest order where it applies"
    nbit=0; nplants=0
    for f in $FLAGS; do
      nplants=$((nplants + 1))
      flag=$f; where=none; planted=""
      while IFS="$TAB" read -r id ext; do
        [ -f "$(out_of "$OUT" "$id" host "$ext")" ] || continue
        planted=$(python3 "$B/$(cmp_of "$NAME").py" "$CORPUS/corpus/$id.$ext" "$(out_of "$OUT" "$id" host "$ext")" --plant "$f")
        if [ "$(kv "$planted" planted)" = yes ]; then where=$id; break; fi
      done <"$B/order"
      turned() { [ "$where" != none ] && [ "$(kv "$planted" "$flag")" = no ] && [ "$(kv "$planted" planted)" = yes ]; }
      echo "  plant $f: applied on $where; $flag=$(kv "$planted" "$flag")"
      if turned; then nbit=$((nbit + 1)); fi
      check "control: $NAME: the plant $f applies on some workbook and turns $flag to no there" "$(yn turned)"
    done
    echo "  plants: $nplants; plants that turned their own flag: $nbit"
    check "$NAME: every flag has a plant that turned it ($nbit of $nplants)" "$(yn [ "$nbit" = "$nplants" ])"
    unknown_plant() { [ "$(python3 "$B/$(cmp_of "$NAME").py" "$CORPUS/corpus/$first_id.$first_ext" "$(out_of "$OUT" "$first_id" host "$first_ext")" --plant no_such_flag)" = error=unknown-plant ]; }
    check "control: $NAME: the comparison refuses a plant it does not know" "$(yn unknown_plant)"
    if [ "$NAME" = protect ]; then
      # Change BF: the second hash plant, on the worksheet's attribute.
      hs=$(python3 "$B/protectcmp.py" "$CORPUS/corpus/$first_id.$first_ext" "$(out_of "$OUT" "$first_id" host "$first_ext")" --plant hash_sheet)
      echo "  plant hash_sheet on $first_id: planted=$(kv "$hs" planted); hash=$(kv "$hs" hash)"
      hs_turned() { [ "$(kv "$hs" planted)" = yes ] && [ "$(kv "$hs" hash)" = no ]; }
      check "control: protect: the plant hash_sheet, the worksheet's password attribute given another hash, turns hash to no" "$(yn hs_turned)"
    fi
    
    echo
    echo "### $NAME: the two labels' outputs"
    same_out=0
    while IFS="$TAB" read -r id ext; do
      if same_file "$(out_of "$OUT" "$id" host "$ext")" "$(out_of "$OUT" "$id" i686 "$ext")"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
    done <"$B/order"
    echo "  workbooks whose host and i686 outputs are byte for byte the same (or absent on both): $same_out"
    check "$NAME: every output is the same on both targets" "$(yn [ "$same_out" = "$manifest_rows" ])"
    
    echo
    echo "### $NAME: the corpus record pair"
    echo "command: scripts/passthrough-record.py --run <corpus>/runs/$RUN --out <scripts>/out/records --stem $STEM_RUN"
    scripts/passthrough-record.py --run "$OUT" --out "$RECORDS" --stem "$STEM_RUN" >"$B/$NAME-record.out" 2>&1
    rrc=$?
    sed 's/^/    /' "$B/$NAME-record.out"
    check "$NAME: the record script exits 0" "$(yn [ "$rrc" = 0 ])"
    RTXT=$RECORDS/$STEM_RUN.txt
    RMD=$RECORDS/$STEM_RUN.md
    echo "command: python3 <scratch>/w/reccheck.py scripts/passthrough-record.py <run directory> <.txt> <.md> $EDIT <the phase record .txt>"
    python3 "$B/reccheck.py" scripts/passthrough-record.py "$OUT" "$RTXT" "$RMD" "$EDIT" "$B/$NAME-phase.txt" >"$B/$NAME-reccheck.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/$NAME-reccheck.out"
    rec_all() { [ "$(count_matches -E ': yes$' "$B/$NAME-reccheck.out")" = 12 ] && [ "$(count_matches -E ': no$' "$B/$NAME-reccheck.out")" = 0 ]; }
    check "$NAME: the record's three tables are the run directory's, its family tables counted from them, its entries and xml tables the phase record's (twelve checks)" "$(yn rec_all)"
    awk '!done && /^[|] total [|]/ { done = 1; next } { print }' "$RMD" >"$B/c-rec.md"
    python3 "$B/reccheck.py" scripts/passthrough-record.py "$OUT" "$RTXT" "$B/c-rec.md" "$EDIT" "$B/$NAME-phase.txt" >"$B/c-reccheck.out" 2>&1
    sed '2d' "$RTXT" >"$B/c-rec.txt"
    python3 "$B/reccheck.py" scripts/passthrough-record.py "$OUT" "$B/c-rec.txt" "$RMD" "$EDIT" "$B/$NAME-phase.txt" >"$B/c-reccheck2.out" 2>&1
    awk 'BEGIN { t = 0 } /^$/ { t++ } t == 1 && !gone && /\t/ && !/^id\t/ { gone = 1; next } { print }' "$B/$NAME-phase.txt" >"$B/c-phase.txt"
    python3 "$B/reccheck.py" scripts/passthrough-record.py "$OUT" "$RTXT" "$RMD" "$EDIT" "$B/c-phase.txt" >"$B/c-reccheck3.out" 2>&1
    rec_ctl() { [ "$(count_matches -E ': no$' "$B/c-reccheck.out")" -ge 1 ] && [ "$(count_matches -F "the summary table is every label's summary: no" "$B/c-reccheck2.out")" = 1 ] && [ "$(count_matches -F "the entries table is the phase record's: no" "$B/c-reccheck3.out")" = 1 ]; }
    check "control: $NAME: the same check finds an .md with a family table's total row dropped, a .txt one summary row short, and a phase record one entries row short" "$(yn rec_ctl)"
    rm -rf scripts/__pycache__
    echo "command: install -m 644 <scripts>/out/records/$STEM_RUN.md <scripts>/out/records/$STEM_RUN.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RMD" "$RTXT" "$RECORDS_DEST"/
    echo "  exit: $?"
    for f in "$STEM_RUN.md" "$STEM_RUN.txt"; do
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      inst_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
      check "$NAME: the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
    done
    }
    for s in $SAMPLES; do sample_block "$s"; done
    
    echo
    echo "## the retag planted on a byte-built workbook whose root binds no relationships prefix (P2 verification ruling 8, kept; change BG)"
    # The corpus never exercises P2's retag (every corpus W binds a
    # relationships prefix), so the comparison's root_tag branch for an added
    # declaration is shown here on a fictional workbook: the template's six parts
    # at the phase commit, zipped; --link-sample on it with size.log's host
    # binary; linkscmp.py over the pair; its root_tag plant; the output with the
    # added declaration taken out, which the same flag must refuse; and (change
    # BG) the same input with W's workbook relationship given the strict type,
    # against which the transitional output must fail root_tag and rel_target,
    # so the form is read from the workbook's rels part.
    cat >"$B/retag-gen.py" <<'PY'
    """Writes retag.in.xlsx into the directory given, from the template's six
    parts at a commit ("make"); given an output there, retag.stripped.xlsx beside
    it: that output with the first xmlns:<p>="<relationships namespace>"
    declaration of its first worksheet's root start tag removed ("strip"); and
    retag.strictrel.xlsx: retag.in.xlsx with the worksheet relationship of
    xl/_rels/workbook.xml.rels given the strict worksheet type ("strictrel")."""
    import re
    import subprocess
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml",
             "xl/_rels/workbook.xml.rels", "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    TRANSITIONAL = b"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet"
    STRICT = b"http://purl.oclc.org/ooxml/officeDocument/relationships/worksheet"
    mode, commit, out = sys.argv[1:4]
    if mode == "make":
        with zipfile.ZipFile(out + "/retag.in.xlsx", "w") as z:
            for name in ORDER:
                data = subprocess.run(["git", "show", "%s:crates/emend/template/%s" % (commit, name)],
                                      capture_output=True, check=True).stdout
                z.writestr(zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0)), data, zipfile.ZIP_DEFLATED)
        print("written retag.in.xlsx")
    elif mode == "strip":
        src = zipfile.ZipFile(out + "/retag.out.xlsx")
        with zipfile.ZipFile(out + "/retag.stripped.xlsx", "w") as z:
            n = 0
            for info in src.infolist():
                data = src.read(info)
                if info.filename == "xl/worksheets/sheet1.xml":
                    data, n = re.subn(rb'\sxmlns:[A-Za-z0-9_]+="http://schemas\.openxmlformats\.org/officeDocument/2006/relationships"', b"", data, count=1)
                z.writestr(info, data)
        print("declarations removed: %d" % n)
    else:
        src = zipfile.ZipFile(out + "/retag.in.xlsx")
        with zipfile.ZipFile(out + "/retag.strictrel.xlsx", "w") as z:
            n = 0
            for info in src.infolist():
                data = src.read(info)
                if info.filename == "xl/_rels/workbook.xml.rels":
                    n = data.count(TRANSITIONAL)
                    data = data.replace(TRANSITIONAL, STRICT)
                z.writestr(info, data)
        print("worksheet relationships given the strict type: %d" % n)
    PY
    sed 's/^/    /' "$B/retag-gen.py"
    mkdir "$B/retag"
    echo "command: python3 <scratch>/w/retag-gen.py make <phase commit> <scratch>/w/retag"
    python3 "$B/retag-gen.py" make "$C" "$B/retag" 2>&1 | sed 's/^/    /'
    echo "command: <sizebuild>/target/release/emend-copy <scratch>/w/retag/retag.in.xlsx <scratch>/w/retag/retag.out.xlsx --link-sample"
    "$PT_host" "$B/retag/retag.in.xlsx" "$B/retag/retag.out.xlsx" --link-sample >"$B/retag.line" 2>"$B/retag.err" </dev/null
    rt_rc=$?
    echo "  exit: $rt_rc; stderr bytes: $(wc -c <"$B/retag.err"); the line: $(tr '\t' ' ' <"$B/retag.line")"
    check "retag: the link sample exits 0 on the fictional workbook, stderr empty" "$(yn [ "$rt_rc$(wc -c <"$B/retag.err")" = 00 ])"
    rt=$(python3 "$B/linkscmp.py" "$B/retag/retag.in.xlsx" "$B/retag/retag.out.xlsx")
    echo "  cmp: $(printf '%s' "$rt" | tr '\t' ' ')"
    check "retag: the fictional W's root binds no relationships prefix (r_bound_in=0)" "$(yn [ "$(kv "$rt" r_bound_in)" = 0 ])"
    check "retag: the tool's line says so too (r_bound_before=0)" "$(yn [ "$(kv "$(cat "$B/retag.line")" r_bound_before)" = 0 ])"
    check "retag: W's workbook relationship is of the transitional form (w_strict=0)" "$(yn [ "$(kv "$rt" w_strict)" = 0 ])"
    check "retag: every flag of the link comparison holds on it, root_tag included" "$(yn all_yes "$rt" "$FLAGS_link")"
    rtp=$(python3 "$B/linkscmp.py" "$B/retag/retag.in.xlsx" "$B/retag/retag.out.xlsx" --plant root_tag)
    echo "  plant root_tag: $(printf '%s' "$rtp" | tr '\t' ' ')"
    rt_plant() { [ "$(kv "$rtp" planted)" = yes ] && [ "$(kv "$rtp" root_tag)" = no ]; }
    check "control: retag: the root_tag plant turns root_tag to no on it" "$(yn rt_plant)"
    echo "command: python3 <scratch>/w/retag-gen.py strip <phase commit> <scratch>/w/retag"
    python3 "$B/retag-gen.py" strip "$C" "$B/retag" >"$B/retag-strip.out" 2>&1
    sed 's/^/    /' "$B/retag-strip.out"
    rts=$(python3 "$B/linkscmp.py" "$B/retag/retag.in.xlsx" "$B/retag/retag.stripped.xlsx")
    echo "  cmp over the output without its added declaration: $(printf '%s' "$rts" | tr '\t' ' ')"
    rt_strip() { [ "$(count_matches -xF 'declarations removed: 1' "$B/retag-strip.out")" = 1 ] && [ "$(kv "$rts" root_tag)" = no ]; }
    check "control: retag: the output with its added declaration taken out fails root_tag" "$(yn rt_strip)"
    echo "command: python3 <scratch>/w/retag-gen.py strictrel <phase commit> <scratch>/w/retag"
    python3 "$B/retag-gen.py" strictrel "$C" "$B/retag" >"$B/retag-strictrel.out" 2>&1
    sed 's/^/    /' "$B/retag-strictrel.out"
    rtx=$(python3 "$B/linkscmp.py" "$B/retag/retag.strictrel.xlsx" "$B/retag/retag.out.xlsx")
    echo "  cmp over the strict-relationship input and the transitional output: $(printf '%s' "$rtx" | tr '\t' ' ')"
    rt_strict() { [ "$(count_matches -xF 'worksheet relationships given the strict type: 1' "$B/retag-strictrel.out")" = 1 ] && [ "$(kv "$rtx" w_strict)" = 1 ] && [ "$(kv "$rtx" root_tag)" = no ] && [ "$(kv "$rtx" rel_target)" = no ]; }
    check "control: retag: with W's workbook relationship strict, the comparison reads w_strict=1 and the transitional output fails root_tag and rel_target (change BG)" "$(yn rt_strict)"
    
    echo
    echo "## the keep regenerated: the tests with the variable set, one keep directory per target"
    echo "command: read the test.log given (sha256 $(sha_of "$TEST_LOG"), $(wc -c <"$TEST_LOG") bytes)"
    tl_is_phase() { [ "$(count_matches -E "^about: M2 part 4a P4 phase commit $C; HEAD at run: $C\$" "$TEST_LOG")" = 1 ]; }
    check "the test.log read is this phase's, at this phase commit" "$(yn tl_is_phase)"
    tl_ctl() { local C=$NULL_SHA; if tl_is_phase; then return 1; else return 0; fi; }
    check "control: the same check says no for the null commit" "$(yn tl_ctl)"
    tl_unset() { [ "$(count_matches -xF 'EMEND_KEEP_DIR set when this script started: no; unset for the whole log: yes' "$TEST_LOG")" = 1 ]; }
    check "the test.log ran with the variable unset" "$(yn tl_unset)"
    tl_all_yes() { [ "$(count_matches -xF 'test log checks all as expected: yes' "$TEST_LOG")" = 1 ]; }
    check "the test.log ends all as expected" "$(yn tl_all_yes)"
    for target in host i686-unknown-linux-musl; do
      awk -v h="## cargo test --workspace ($target)" '
        $0 == h { on = 1; next }
        /^## / { on = 0 }
        on && /^    test .* \.\.\. ok$/ { sub(/^    test /, ""); sub(/ \.\.\. ok$/, ""); print }
      ' "$TEST_LOG" | sort >"$B/unset-$target.names"
      sed -n "s/^$target: passed \\([0-9]*\\); failed 0; ignored \\([0-9]*\\); test lines ending ok: [0-9]*\$/\\1 \\2/p" "$TEST_LOG" >"$B/unset-$target.count"
      echo "  $target without the variable: passed and ignored $(cat "$B/unset-$target.count"); names read $(count_lines "$B/unset-$target.names")"
      names_match_count() { [ -s "$B/unset-$target.count" ] && [ "$(count_lines "$B/unset-$target.names")" = "$(cut -d' ' -f1 "$B/unset-$target.count")" ]; }
      check "$target: the names read account for the passed count read" "$(yn names_match_count)"
    done
    mkdir "$KEEP" "$BUILD_ROOT/keep-i686.$$" || exit 2
    KI=$BUILD_ROOT/keep-i686.$$
    for target in host i686-unknown-linux-musl; do
      case $target in host) K=$KEEP; targs=() ;; *) K=$KI; targs=(--target "$target") ;; esac
      echo
      echo "### cargo test --workspace ($target), EMEND_KEEP_DIR=$K"
      echo "command: EMEND_KEEP_DIR=$K cargo test --workspace ${targs[*]}"
      EMEND_KEEP_DIR=$K cargo test --workspace "${targs[@]}" >"$B/$target.out" 2>&1 </dev/null
      rc=$?
      echo "  exit: $rc"
      check "$target: exit 0" "$(yn [ "$rc" -eq 0 ])"
      echo "  summary lines:"
      LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$B/$target.out" | sed 's/^ */    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$B/$target.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$B/set-$target.names"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      ignored=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^ignored;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      echo "  $target with the variable: passed $passed; failed $failed; ignored $ignored; test lines ending ok $(count_lines "$B/set-$target.names")"
      check "$target: failed is 0" "$(yn [ "$failed" = 0 ])"
      check "$target: passed and ignored are the run's without the variable ($(cat "$B/unset-$target.count"))" "$(yn [ "$passed $ignored" = "$(cat "$B/unset-$target.count")" ])"
      check "$target: the test names that passed are the run's without the variable" "$(yn cmp -s "$B/set-$target.names" "$B/unset-$target.names")"
      echo "  files in the keep: $(find "$K" -type f | wc -l); entries that are not regular files: $(find "$K" -mindepth 1 ! -type f | wc -l)"
    done
    { head -n 1 "$B/unset-host.names"; cat "$B/unset-host.names"; } | sort >"$B/c-names"
    cmp_ctl() { if cmp -s "$B/c-names" "$B/unset-host.names"; then return 1; else return 0; fi; }
    check "control: the same comparison tells a name list with one name doubled from the real one" "$(yn cmp_ctl)"
    
    echo
    echo "## the two keep directories compared"
    (cd "$KEEP" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/host.files"
    (cd "$KI" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/i686.files"
    nfiles=$(count_lines "$B/host.files")
    same=0
    while IFS= read -r f; do
      if cmp -s "$KEEP/$f" "$KI/$f"; then same=$((same + 1)); else echo "    differs: $f"; fi
    done <"$B/host.files"
    echo "  files: host $nfiles, i686 $(count_lines "$B/i686.files"); the same bytes on both: $same"
    check "the two keeps hold the same names" "$(yn cmp -s "$B/host.files" "$B/i686.files")"
    keeps_same() { [ "$nfiles" -ge 2 ] && [ "$same" = "$nfiles" ]; }
    check "every file in the host keep is byte for byte the i686 keep's" "$(yn keeps_same)"
    first_kept=$(head -n 1 "$B/host.files")
    cp "$KEEP/$first_kept" "$B/c-copy"
    printf 'x' >>"$B/c-copy"
    cmp_bytes_ctl() { if cmp -s "$B/c-copy" "$KI/$first_kept"; then return 1; else return 0; fi; }
    check "control: cmp tells a kept file with one byte added from its original" "$(yn cmp_bytes_ctl)"
    n_in=$(count_matches -E '\.in\.xlsx$' "$B/host.files")
    n_out=$(count_matches -E '\.out\.xlsx$' "$B/host.files")
    n_other=$(count_matches -vE '^[A-Za-z0-9_.-]+\.[0-9]+\.(in|out)\.xlsx$' "$B/host.files")
    LC_ALL=C sed -nE 's/^(.*)\.in\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.names"
    LC_ALL=C sed -nE 's/^(.*)\.out\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.out.names"
    echo "  .in.xlsx $n_in; .out.xlsx $n_out; names not of the form <test>.<n>.in|out.xlsx: $n_other"
    all_pairs() { [ "$n_in" = "$n_out" ] && [ "$((n_in * 2))" = "$nfiles" ] && [ "$n_other" = 0 ] && cmp -s "$B/pair.names" "$B/pair.out.names"; }
    check "the keep holds only whole pairs named <test>.<n>" "$(yn all_pairs)"
    NPAIRS=$n_in
    (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/keep.listing"
    echo "  the host keep's listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/keep.listing"); files $(count_lines "$B/keep.listing"); listing sha256 $(sha_of "$B/keep.listing")"
    check "the host keep's pairs times two equals its files (keep_pairs_ok)" "$(yn keep_pairs_ok "$B/keep.listing")"
    rm -rf "$KI"
    check "the i686 keep is removed after the comparison; the host keep stays for planning" "$(yn [ ! -e "$KI" ])"
    
    echo
    echo "## the host keep against P3's committed open-check record (change BH)"
    PREV_TXT=$(git show --name-only --format= "$PREV_OPEN_REC" | LC_ALL=C "$G" -E '^records/m2p4a-open-.*[.]txt$')
    echo "command: git show --name-only --format= <P3's record commit>, the open-check .txt it added; git show <phase commit>:<it>"
    echo "  P3's record: $PREV_TXT (sha256 $(git show "$C:$PREV_TXT" | sha256sum | cut -d' ' -f1))"
    check "P3's record commit added exactly one open-check .txt" "$(yn [ "$(printf '%s\n' "$PREV_TXT" | count_lines /dev/stdin)" = 1 ])"
    no_later_open() { [ -z "$(git log --format=%H "$PREV_OPEN_REC..$C" -- 'records/*-open-*.txt')" ]; }
    check "no commit after it adds an open-check record, so it is the last committed" "$(yn no_later_open)"
    git show "$C:$PREV_TXT" >"$B/prev.txt"
    while IFS= read -r t; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$t" "$(stat -c %s "$KEEP/$t.in.xlsx")" "$(sha_of "$KEEP/$t.in.xlsx")" \
        "$(stat -c %s "$KEEP/$t.out.xlsx")" "$(sha_of "$KEEP/$t.out.xlsx")"
    done <"$B/pair.names" >"$B/keep.rows"
    tail -n +2 "$B/prev.txt" | cut -f1-5 | LC_ALL=C sort >"$B/prev.rows"
    LC_ALL=C sort "$B/keep.rows" >"$B/keep.sorted"
    n_prev=$(count_lines "$B/prev.rows")
    n_kept_prev=$(LC_ALL=C comm -12 "$B/prev.rows" "$B/keep.sorted" | count_lines /dev/stdin)
    cut -f1 "$B/prev.rows" >"$B/prev.names"
    LC_ALL=C comm -13 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/gone.pairs"
    echo "  rows: the regenerated keep $(count_lines "$B/keep.rows"), P3's record $n_prev; its rows found in the keep with the same name, bytes and both sha256s: $n_kept_prev"
    echo "  pairs in the keep and not in P3's record: $(count_lines "$B/new.pairs"); in its record and not in the keep: $(count_lines "$B/gone.pairs")"
    sed 's/^/    new: /' "$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.rows" "$B/keep.sorted" | cut -f1 >"$B/changed.pairs"
    echo "  pairs of P3's record whose bytes differ in the keep: $(count_lines "$B/changed.pairs")"
    sed 's/^/    changed: /' "$B/changed.pairs"
    check "no pair of P3's record is gone" "$(yn [ "$(count_lines "$B/gone.pairs")" = 0 ])"
    check "every pair of P3's record is in the keep, unchanged or changed ($n_kept_prev + $(count_lines "$B/changed.pairs") = $n_prev)" "$(yn [ "$((n_kept_prev + $(count_lines "$B/changed.pairs")))" = "$n_prev" ])"
    echo "command: the #[test] functions this phase adds or whose body it edits, from the two commits' sources of every .rs file git diff --name-only <base> <phase commit> names: <scratch>/w/edited.py, below"
    cat >"$B/edited.py" <<'PY'
    """The #[test] functions whose body differs between two commits, or that
    the second adds: each file's text at both commits (git show), every
    function after a #[test] attribute (other attributes allowed between), its
    body from the fn line to the first line that is a lone closing brace in
    column one. Prints one test name per line."""
    import re
    import subprocess
    import sys
    
    base, head = sys.argv[1:3]
    TEST = re.compile(r"#\[test\]\s*(?:#\[[^\]]*\]\s*)*fn\s+([A-Za-z0-9_]+)")
    
    
    def show(rev, path):
        run = subprocess.run(["git", "show", "%s:%s" % (rev, path)], capture_output=True)
        return run.stdout.decode() if run.returncode == 0 else ""
    
    
    def tests(text):
        out = {}
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            out[m.group(1)] = text[m.start():end if end >= 0 else len(text)]
        return out
    
    
    names = subprocess.run(["git", "diff", "--name-only", base, head, "--", "*.rs"],
                           capture_output=True, check=True).stdout.decode().split()
    edited = set()
    for path in names:
        before, after = tests(show(base, path)), tests(show(head, path))
        for name, body in after.items():
            if before.get(name) != body:
                edited.add(name)
    for name in sorted(edited):
        print(name)
    PY
    sed 's/^/    /' "$B/edited.py"
    python3 "$B/edited.py" "$REC" "$C" | LC_ALL=C sort >"$B/edited.tests"
    sed 's/^/    added or edited test: /' "$B/edited.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/new.pairs" | LC_ALL=C sort -u >"$B/new.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/changed.pairs" | LC_ALL=C sort -u >"$B/changed.tests"
    echo "  tests with a new pair: $(count_lines "$B/new.tests"); tests with a changed pair: $(count_lines "$B/changed.tests"); tests added or edited: $(count_lines "$B/edited.tests")"
    check "some test is added or edited, so the list was read" "$(yn [ "$(count_lines "$B/edited.tests")" -ge 1 ])"
    new_from_edited() { [ "$(LC_ALL=C comm -23 "$B/new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every new pair is kept by a test this phase adds or edits" "$(yn new_from_edited)"
    changed_from_edited() { [ "$(LC_ALL=C comm -23 "$B/changed.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every changed pair of P3's record is kept by a test this phase edits (the code under the other tests did not change what they write)" "$(yn changed_from_edited)"
    printf 'zzz_not_an_edited_test\n' | LC_ALL=C sort -m - "$B/new.tests" >"$B/c-new.tests"
    new_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a pair of a test the phase did not add or edit" "$(yn new_ctl)"
    
    echo
    echo "## scripts/edit-open-check.sh on the host keep (specs/0018 \"Harness runs\": every phase's run log runs it over its keep)"
    mkdir "$B/tmp"
    echo "command: TMPDIR=<scratch>/w/tmp scripts/edit-open-check.sh --keep <keep> --libreoffice $IMAGE --out <scripts>/out/records --stem $STEM_OPEN"
    TMPDIR=$B/tmp scripts/edit-open-check.sh --keep "$KEEP" --libreoffice "$IMAGE" --out "$RECORDS" --stem "$STEM_OPEN" \
      >"$B/oc.stdout" 2>"$B/oc.stderr" </dev/null
    oc_rc=$?
    echo "  exit: $oc_rc"
    echo "  stdout:"; sed 's/^/    /' "$B/oc.stdout"
    echo "  stderr bytes: $(wc -c <"$B/oc.stderr")"
    check "the script exits 0 (no finding, no check errored)" "$(yn [ "$oc_rc" = 0 ])"
    check "its stderr is empty" "$(yn [ ! -s "$B/oc.stderr" ])"
    echo "  the reasons the script kept (its reasons directory under <scratch>/w/tmp), one line per refused side:"
    find "$B/tmp" -name '*-reason.txt' | LC_ALL=C sort | while IFS= read -r f; do echo "    ${f#"$B/tmp/"}: $(cat "$f")"; done
    TXT=$RECORDS/$STEM_OPEN.txt
    MD=$RECORDS/$STEM_OPEN.md
    TXT_HEADER=$(git show "$C:scripts/edit-open-check.sh" | sed -n "s/^readonly TXT_HEADER=\\$'\\(.*\\)'\$/\\1/p" | sed 's/\\t/\t/g')
    check "the .txt's header is the script's TXT_HEADER, read from the phase commit (nine columns)" "$(yn [ "$(head -n 1 "$TXT")" = "$TXT_HEADER" ])"
    tail -n +2 "$TXT" | cut -f1-5 >"$B/txt.rows"
    nrow_same=$(paste -d'\n' "$B/keep.rows" "$B/txt.rows" | awk 'NR % 2 == 1 { a = $0; next } a == $0 { n++ } END { print n + 0 }')
    echo "  rows: the keep $(count_lines "$B/keep.rows"), the .txt $(count_lines "$B/txt.rows"); rows whose name, bytes and hashes are the keep's, compared row by row: $nrow_same"
    rows_same() { [ "$(count_lines "$B/keep.rows")" = "$(count_lines "$B/txt.rows")" ] && [ "$nrow_same" = "$(count_lines "$B/keep.rows")" ] && [ "$nrow_same" = "$NPAIRS" ]; }
    check "every .txt row is one kept pair's name, byte counts and sha256s, in name order, one row per pair" "$(yn rows_same)"
    bad_rows=$(tail -n +2 "$TXT" | awk -F'\t' 'NF != 9 || $6 !~ /^(ok|fail|error)$/ || $7 !~ /^(ok|fail|error)$/ || $8 !~ /^(none|refused|count|error)$/ || $9 !~ /^(none|refused|count|error)$/' | wc -l)
    check "every row has nine columns, lo_in and lo each ok, fail or error, and each class none, refused, count or error ($bad_rows rows otherwise)" "$(yn [ "$bad_rows" = 0 ])"
    bad_fit=$(tail -n +2 "$TXT" | awk -F'\t' '{ print $6 ":" $8; print $7 ":" $9 }' | LC_ALL=C "$G" -cvxE 'ok:none|fail:refused|fail:count|error:error')
    check "every side's class fits its verdict ($bad_fit sides otherwise)" "$(yn [ "$bad_fit" = 0 ])"
    stdout_rows() { [ "$(awk -F'\t' 'NF == 3' "$B/oc.stdout")" = "$(tail -n +2 "$TXT" | cut -f1,6,7)" ]; }
    check "the script's per-pair stdout lines are the .txt's test, lo_in and lo columns" "$(yn stdout_rows)"
    echo "command: python3 <scratch>/w/wb.py over each kept input: its xl/workbook.xml entry, its sheet elements by local name (expat, no pattern) and of them those with a prefix"
    cat >"$B/wb.py" <<'PY'
    import sys, zipfile
    from xml.parsers import expat
    for path in sys.argv[1:]:
        name = path.rsplit("/", 1)[1][: -len(".in.xlsx")]
        try:
            z = zipfile.ZipFile(path)
        except zipfile.BadZipFile:
            print("%s\tunreadable\t-\t-" % name)
            continue
        if "xl/workbook.xml" not in z.namelist():
            print("%s\tno\t-\t-" % name)
            continue
        found = {"all": 0, "prefixed": 0}
    
        def start(tag, attrs):
            prefix, _, local = tag.rpartition(":")
            if local == "sheet":
                found["all"] += 1
                found["prefixed"] += 1 if prefix else 0
        p = expat.ParserCreate()
        p.StartElementHandler = start
        try:
            p.Parse(z.read("xl/workbook.xml"), True)
        except expat.ExpatError:
            print("%s\tyes\tunparsed\t-" % name)
            continue
        print("%s\tyes\t%d\t%d" % (name, found["all"], found["prefixed"]))
    PY
    sed 's/^/    /' "$B/wb.py"
    python3 "$B/wb.py" $(sed "s#^#$KEEP/#; s#\$#.in.xlsx#" "$B/pair.names") | LC_ALL=C sort >"$B/wb.all"
    echo "  kept inputs by workbook entry and sheet elements (entry, all, prefixed: pairs):"
    cut -f2- "$B/wb.all" | sort | uniq -c | sed 's/^/    /'
    echo "  the .md checked against the .txt and the kept inputs, with the heading specs/0015 P2 verification ruling 1 gives: <scratch>/w/mdcheck.py, below"
    cat >"$B/mdcheck.py" <<'PY'
    import sys
    txt, md, wb = sys.argv[1:4]
    rows = [l.split("\t") for l in open(txt).read().split("\n")[1:] if l]
    sheets = {l.split("\t")[0]: l.split("\t")[2] for l in open(wb).read().split("\n") if l}
    text = open(md).read().split("\n")
    REFUSED = ("Inputs refused by LibreOffice (allowed: a fixture LibreOffice cannot load: zip-level,"
               " or a package with no relationships part or an empty content-types root)")
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line:
                out.append(line)
        return out
    
    
    def listed(names):
        return ["- `%s`" % n for n in names] if names else ["None."]
    
    
    def count(col, v):
        return sum(1 for r in rows if r[col] == v)
    
    
    totals = [len(rows)] + [count(5, v) for v in ("ok", "fail", "error")] + [count(6, v) for v in ("ok", "fail", "error")]
    classes = ["| %s | " % side + " | ".join(str(count(col, c)) for c in ("none", "refused", "count", "error")) + " |"
               for side, col in (("reason_in", 7), ("reason_out", 8))]
    tot = section("Totals")
    checks = [
        ("Totals", tot[2:3] == ["| " + " | ".join(str(t) for t in totals) + " |"] and tot[5:] == classes),
        ("the refused-inputs heading reads as ruled, once", text.count("## " + REFUSED) == 1),
        ("Inputs refused by LibreOffice", section(REFUSED) == listed([r[0] for r in rows if r[7] == "refused"])),
        ("the sheet count did not apply", section("Inputs the sheet count did not apply to (allowed: a workbook fixture with no sheet element)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) == "0"])),
        ("counts differ", section("Inputs whose sheet and table counts differ (a finding)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) != "0"])),
        ("Outputs refused on an accepted input", section("Outputs refused on an input LibreOffice accepted (a finding)") == listed([r[0] for r in rows if r[6] == "fail" and r[5] == "ok"])),
        ("Checks that did not run", section("Checks that did not run (error)") == listed([r[0] for r in rows if "error" in (r[5], r[6])])),
        ("Pairs", section("Pairs")[2:] == ["| `%s` | %s | %s | %s | %s | %s | %s | %s | %s |" % tuple(r) for r in rows]),
        ("the Pairs line", ("- Pairs: %d" % len(rows)) in text),
    ]
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("totals: pairs %d; lo_in ok %d fail %d error %d; lo ok %d fail %d error %d" % tuple(totals))
