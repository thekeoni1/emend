    COMMENT = b"<!-- planted -->"
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def core_of(z):
        if "_rels/.rels" not in z.namelist():
            return None
        for el in ET.fromstring(z.read("_rels/.rels")).iter("{%s}Relationship" % RELS):
            if el.get("Type") in CORE_TYPES and el.get("TargetMode") != "External":
                t = el.get("Target", "")
                return t[1:] if t.startswith("/") else posixpath.normpath(t)
        return None
    
    
    def root_span(data):
