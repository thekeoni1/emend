    """The run log's own properties comparison (specs/0019-names-links-
    properties-protection.md, "Harness runs", --props-sample and P3).
    
    Usage: propscmp.py <input archive> <output archive> [--plant <flag>]
           propscmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool. It finds the core-properties part through the
    package relationship (either form of the type) and compares, the three
    edited properties being dc:title, cp:keywords and dcterms:modified with the
    tool's values "emend sample", "emend" and "2026-01-01T00:00:00Z":
    
      root_tag         the core part's root start tag is the input's, byte for
                       byte
      rest_same        the root's children other than the three, and the bytes
                       between children, are the input's in the input's order
                       (the output with the three cut out and the appended tail
                       cut off is the input with the three cut out)
      three_once       the output has exactly one element of each of the three
      three_text       read with ElementTree, each of the three holds its value
      in_place         each of the three the input had stands where the input's
                       stood (the same child index), its start tag the input's
                       (opened up when it was empty)
      appended         each of the three the input lacked is appended before the
                       root's end tag, in the order title, keywords, modified, with
                       the prefix the root binds to its namespace
      element_bytes    each of the three is byte for byte the element this log
                       builds: an in-place one the input's start tag, the escaped
                       value and the end tag of the same name; an appended one
                       <p:name>value</p:name>, modified with xsi:type="<p>:W3CDTF"
      xsi_type         the output's modified carries xsi:type ending ":W3CDTF"
      props_read       read with ElementTree, the output holds every one of the
                       thirteen properties the input held, and those three
    
    It prints ONE line of counts and yes/no flags and no value, text or part
    name. --parts prints the core part's name, "1" when the input has one, and
    the package rels part's name, for the log to compare with the runner's rows
    without printing them. --plant <flag> changes the output as read so that the
    named flag turns to no; the line then says planted=yes, or planted=no when
    the pair gives the plant nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    CORE_TYPES = (
        "http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties",
        "http://schemas.openxmlformats.org/officeDocument/2006/relationships/metadata/core-properties",
    )
    CP = "http://schemas.openxmlformats.org/package/2006/metadata/core-properties"
    DC = "http://purl.org/dc/elements/1.1/"
    DCTERMS = "http://purl.org/dc/terms/"
    XSI = "http://www.w3.org/2001/XMLSchema-instance"
    THIRTEEN = [(DC, n) for n in ("title", "subject", "creator", "description", "language")] + \
        [(CP, n) for n in ("keywords", "lastModifiedBy", "revision", "category", "contentStatus", "version")] + \
        [(DCTERMS, n) for n in ("created", "modified")]
    EDITED = [((DC, "title"), "emend sample"), ((CP, "keywords"), "emend"),
              ((DCTERMS, "modified"), "2026-01-01T00:00:00Z")]
    FLAGS = ("root_tag", "rest_same", "three_once", "three_text", "in_place", "appended",
