                for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag)}
    
    
    def default_ns(tag):
        m = re.search(rb'\sxmlns\s*=\s*("[^"]*"|\'[^\']*\')', tag)
        return m.group(1)[1:-1].decode() if m else None
    
    
