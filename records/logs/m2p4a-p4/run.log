    def legacy_hash(password):
        """ECMA-376 first edition Part 4's legacy hash, a rotation within
        fifteen bits (this log's own copy)."""
        h = 0
        for i, ch in enumerate(password.encode("ascii"), 1):
            r = i % 15
            h ^= ((ch << r) | (ch >> (15 - r))) & 0x7FFF
        return h ^ len(password) ^ 0xCE4B
    
    
    HASH = "%04X" % legacy_hash("emend")
    
    
    def local(tag):
