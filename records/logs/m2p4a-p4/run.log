        f["xsi_type"] = len(mod) == 1 and (mod[0].get("{%s}type" % XSI) or "").endswith(":W3CDTF")
        gin = props(din)
        f["props_read"] = all(k in got for k in gin) and all(k in got for k in keys)
        return f, len(gin), len(got), len(missing)
    
    
    def plant(flag, dout):
        ts, te, oa, ob = root_span(dout)
        decls, dflt = declarations(dout[ts:te]), default_ns(dout[ts:te])
        kout = children(dout, oa, ob, decls, dflt)
        keys = [k for (k, _) in EDITED]
        ed = [(x, y, k) for (x, y, k) in kout if k in keys]
        others = [(x, y, k) for (x, y, k) in kout if k not in keys]
        title = [e for e in ed if e[2] == keys[0]]
        mod = [e for e in ed if e[2] == keys[2]]
        if flag == "root_tag":
            return dout[:te - 1] + b' planted="1"' + dout[te - 1:]
        if flag == "rest_same":
            if not others:
                return None
            x, y, _ = others[0]
            return dout[:y] + COMMENT + dout[y:]
        if flag == "three_once":
            x, y, _ = title[0]
            return dout[:y] + dout[x:y] + dout[y:]
        if flag == "three_text":
            x, y, _ = title[0]
            raw = dout[x:y]
            return dout[:x] + raw.replace(b"emend sample", b"emend sampl") + dout[y:]
        if flag == "in_place":
            if len(kout) < 2 or ed[0] == kout[-1]:
                return None
            x, y, _ = ed[0]
            e = dout[x:y]
            rest = dout[:x] + dout[y:]
            at = rest.rfind(b"</")
            return rest[:at] + e + rest[at:]
        if flag == "appended":
            return dout[:ob] + b"<cp:planted/>" + dout[ob:]
        if flag == "element_bytes":
            x, y, _ = title[0]
            raw = dout[x:y]
            close = raw.find(b">")
            return dout[:x] + raw[:close] + b" " + raw[close:] + dout[y:] if not raw[:close].endswith(b" ") else None
        if flag == "xsi_type":
            x, y, _ = mod[0]
            raw = dout[x:y]
            return dout[:x] + raw.replace(b":W3CDTF", b":W3CDTX") + dout[y:]
        if flag == "props_read":
