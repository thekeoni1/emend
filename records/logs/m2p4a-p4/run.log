                .replace("'", "&apos;").replace('"', "&quot;").replace("\r", "&#13;")).encode()
    
    
    def prefix_for(decls, dflt, ns):
        if dflt == ns:
            return ""
        for p, u in decls.items():
            if u == ns:
                return p
        return None
    
    
    def colon(p):
        return (p + ":").encode() if p else b""
    
    
    def expected(key, value, din, kin, decls, dflt):
        """The bytes the design gives for an edited property: in place from the
        input's element, appended with the root's prefixes."""
        have = [k for k in kin if k[2] == key]
        if have:
            x, y, _ = have[0]
            raw = din[x:y]
            tag = raw[:raw.find(b">") + 1]
            q = re.match(rb"<([^\s/>]+)", tag).group(1)
            if tag.endswith(b"/>"):
                slash = tag.rfind(b"/")
                tag = tag[:slash] + tag[slash + 1:]
            return tag + escaped(value) + b"</" + q + b">"
        p = prefix_for(decls, dflt, key[0])
        if p is None:
            return None
        name = colon(p) + key[1].encode()
        out = b"<" + name
        if key == (DCTERMS, "modified"):
            out += b" " + colon(prefix_for(decls, dflt, XSI) or "") + b'type="' + colon(p) + b'W3CDTF"'
        return out + b">" + escaped(value) + b"</" + name + b">"
    
    
