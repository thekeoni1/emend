## the retag planted on a byte-built workbook whose root binds no relationships prefix (P2 verification ruling 8, kept; change BG)
    """Writes retag.in.xlsx into the directory given, from the template's six
    parts at a commit ("make"); given an output there, retag.stripped.xlsx beside
    it: that output with the first xmlns:<p>="<relationships namespace>"
    declaration of its first worksheet's root start tag removed ("strip"); and
    retag.strictrel.xlsx: retag.in.xlsx with the worksheet relationship of
    xl/_rels/workbook.xml.rels given the strict worksheet type ("strictrel")."""
    import re
    import subprocess
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml",
             "xl/_rels/workbook.xml.rels", "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    TRANSITIONAL = b"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet"
    STRICT = b"http://purl.oclc.org/ooxml/officeDocument/relationships/worksheet"
    mode, commit, out = sys.argv[1:4]
    if mode == "make":
        with zipfile.ZipFile(out + "/retag.in.xlsx", "w") as z:
            for name in ORDER:
                data = subprocess.run(["git", "show", "%s:crates/emend/template/%s" % (commit, name)],
                                      capture_output=True, check=True).stdout
                z.writestr(zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0)), data, zipfile.ZIP_DEFLATED)
        print("written retag.in.xlsx")
    elif mode == "strip":
        src = zipfile.ZipFile(out + "/retag.out.xlsx")
        with zipfile.ZipFile(out + "/retag.stripped.xlsx", "w") as z:
            n = 0
            for info in src.infolist():
                data = src.read(info)
                if info.filename == "xl/worksheets/sheet1.xml":
                    data, n = re.subn(rb'\sxmlns:[A-Za-z0-9_]+="http://schemas\.openxmlformats\.org/officeDocument/2006/relationships"', b"", data, count=1)
                z.writestr(info, data)
        print("declarations removed: %d" % n)
    else:
        src = zipfile.ZipFile(out + "/retag.in.xlsx")
        with zipfile.ZipFile(out + "/retag.strictrel.xlsx", "w") as z:
            n = 0
            for info in src.infolist():
                data = src.read(info)
                if info.filename == "xl/_rels/workbook.xml.rels":
                    n = data.count(TRANSITIONAL)
                    data = data.replace(TRANSITIONAL, STRICT)
                z.writestr(info, data)
        print("worksheet relationships given the strict type: %d" % n)
