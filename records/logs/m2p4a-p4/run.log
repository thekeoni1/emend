        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty.endswith("/worksheet"):
                    return target
        return None
    
    
    def root_span(data):
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        p = q.rpartition(b":")[0]
        prefix = p + b":" if p else b""
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, prefix
        return m.start(), close + 1, close + 1, data.rfind(b"</"), prefix
    
    
    def children(data, a, b, rp):
        """[(start, end, main local name or None)] of the root's children."""
        out, depth, at = [], 0, 0
        for m in TOKEN.finditer(data, a, b):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    out.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    out.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        named = []
        for (x, y) in out:
            q = re.match(rb"<([^\s/>]+)", data[x:y]).group(1)
            p, _, n = q.rpartition(b":")
            named.append((x, y, n.decode() if (p + b":" if p else b"") == rp else None))
        return named
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def prefix_of(raw):
        q = re.match(rb"<([^\s/>]+)", raw).group(1)
        p = q.rpartition(b":")[0]
        return p + b":" if p else b""
    
    
    def sheet_element(p):
        return (b"<" + p + b'sheetProtection password="' + HASH.encode() +
                b'" sheet="1" sort="0" autoFilter="0"/>')
    
    
    def book_element(p):
        return b"<" + p + b'workbookProtection workbookPassword="' + HASH.encode() + b'" lockStructure="1"/>'
    
    
    def check_part(din, dout, name, table, build, place_after):
        """(rest, elem, place, input count) for one part: `name` the element,
        `place_after` True for the workbook rule (after the last earlier child),
        False for the worksheet rule (before the first later child)."""
        ts, te, a, b, rp = root_span(din)
        kin = children(din, a, b, rp)
        ots, ote, oa, ob, orp = root_span(dout)
        kout = children(dout, oa, ob, orp)
        ein = [k for k in kin if k[2] == name]
        eout = [k for k in kout if k[2] == name]
        rest = cut(din, [(x, y) for (x, y, _) in ein]) == cut(dout, [(x, y) for (x, y, _) in eout])
        p = prefix_of(din[ein[0][0]:ein[0][1]]) if ein else rp
        elem = len(eout) == 1 and dout[eout[0][0]:eout[0][1]] == build(p)
        place = False
        if len(eout) == 1:
            at = eout[0][0]
            if ein:
                place = dout[:at] == din[:ein[0][0]]
            else:
                pos = table.index(name)
                if place_after:
                    earlier = [k for k in kin if k[2] in table and table.index(k[2]) < pos]
                    want = earlier[-1][1] if earlier else te
                else:
                    later = [k for k in kin if k[2] in table and table.index(k[2]) > pos]
                    want = later[0][0] if later else b
                place = dout[:at] == din[:want]
        return rest, elem, place, len(ein)
    
    
    def attrs_read(dout, name, want):
        root = ET.fromstring(dout)
        got = [el for el in root if local(el.tag)[0] in MAIN and local(el.tag)[1] == name]
        return len(got) == 1 and dict(got[0].attrib) == want
    
    
    def password_of(data, name, attr):
        """The attribute `attr` of the one main root child `name`, or None."""
        root = ET.fromstring(data)
        got = [el for el in root if local(el.tag)[0] in MAIN and local(el.tag)[1] == name]
        return got[0].get(attr) if len(got) == 1 else None
    
    
    def other_hash(data, attr):
        """`data` with attr="<HASH>" given another hash, or None."""
        t = attr + b'="' + HASH.encode() + b'"'
        if data.count(t) != 1:
            return None
        return data.replace(t, attr + b'="' + ("%04X" % legacy_hash("emenD")).encode() + b'"')
    
    
    def plant(flag, sout, bout):
        """(sout, bout) changed so `flag` turns to no."""
        def first(data, name):
            ts, te, a, b, rp = root_span(data)
            return [k for k in children(data, a, b, rp) if k[2] == name], te
        se, ste = first(sout, "sheetProtection")
        be, bte = first(bout, "workbookProtection")
        if flag == "hash":
            changed = other_hash(bout, b"workbookPassword")
            return None if changed is None else (sout, changed)
        if flag == "hash_sheet":
            changed = other_hash(sout, b"password")
            return None if changed is None else (changed, bout)
        if flag == "sheet_rest":
            return sout[:ste] + COMMENT + sout[ste:], bout
        if flag == "sheet_elem":
            x, y, _ = se[0]
            return sout[:x] + sout[x:y].replace(b'sort="0"', b'sort="1"') + sout[y:], bout
        if flag == "sheet_place":
            x, y, _ = se[0]
            e = sout[x:y]
            rest = sout[:x] + sout[y:]
            at = rest.rfind(b"</")
            if rest[:at] + e + rest[at:] == sout:
                return None
            return rest[:at] + e + rest[at:], bout
        if flag == "book_rest":
            return sout, bout[:bte] + COMMENT + bout[bte:]
        if flag == "book_elem":
            x, y, _ = be[0]
            return sout, bout[:x] + bout[x:y].replace(b'lockStructure="1"', b'lockStructure="0"') + bout[y:]
        if flag == "book_place":
            x, y, _ = be[0]
            e = bout[x:y]
            rest = bout[:x] + bout[y:]
            at = rest.rfind(b"</")
            return sout, rest[:at] + e + rest[at:]
        if flag == "read":
            x, y, _ = be[0]
            return sout, bout[:x] + bout[x:y].replace(b'/>', b' lockWindows="1"/>') + bout[y:]
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        book = workbook_of(zin)
        w = pick_w(zin, book) if book else None
        if len(args) == 2 and args[1] == "--parts":
            print(w or "-")
            print(book or "-")
            return
        zout = zipfile.ZipFile(args[1])
        flag_plant = None
        if len(args) == 4 and args[2] == "--plant":
            flag_plant = args[3]
            if flag_plant not in PLANTS:
                print("error=unknown-plant")
                return
        if not w:
            print("found=0")
            return
        sin, sout = zin.read(w), zout.read(w)
        bin_, bout = zin.read(book), zout.read(book)
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, sout, bout)
            if changed is not None:
                (sout, bout), planted = changed, True
        f = {}
        try:
            f["hash"] = (password_of(sout, "sheetProtection", "password") == HASH
                         and password_of(bout, "workbookProtection", "workbookPassword") == HASH)
            f["sheet_rest"], f["sheet_elem"], f["sheet_place"], s_in = check_part(
                sin, sout, "sheetProtection", SHEET_TABLE, sheet_element, False)
            f["book_rest"], f["book_elem"], f["book_place"], b_in = check_part(
                bin_, bout, "workbookProtection", BOOK_TABLE, book_element, True)
            f["read"] = attrs_read(sout, "sheetProtection", {
                "password": HASH, "sheet": "1", "sort": "0", "autoFilter": "0"}) and attrs_read(
                bout, "workbookProtection", {"workbookPassword": HASH, "lockStructure": "1"})
            ts, te, a, b, rp = root_span(sout)
            s_out = sum(1 for k in children(sout, a, b, rp) if k[2] == "sheetProtection")
            ts, te, a, b, rp = root_span(bout)
            b_out = sum(1 for k in children(bout, a, b, rp) if k[2] == "workbookProtection")
        except (ET.ParseError, AttributeError, IndexError, ValueError):
            f = {k: False for k in FLAGS}
            s_in = s_out = b_in = b_out = 0
        print("\t".join(["found=1", "planted=%s" % yn(planted), "sheet_in=%d" % s_in,
                         "sheet_out=%d" % s_out, "book_in=%d" % b_in, "book_out=%d" % b_out,
                         "hash_value=%s" % HASH] + ["%s=%s" % (k, yn(f[k])) for k in FLAGS]))
    
    
    main()
  control: all_yes refuses a line with no flags: yes
  control: hash_agrees accepts a line whose hash is the comparison's: yes
  control: hash_agrees refuses a line with another hash: yes
  control: hash_agrees refuses when neither side prints a hash: yes

## the record check (python3), printed once, used for every sample (change BD)
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds, and of its entries and xml tables against
    the phase record's (part 3 P4's change AA, change BD). Reads the record's
    .txt and .md, the run directory's summary.<label>.tsv, entries.<label>.tsv
    and each workbook's diff.<label>.tsv, and the phase record's .txt; prints
    one "name: yes|no" line per check and one line of counts. It imports only
    the part-family rules from scripts/passthrough-record.py."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, tool_arg, phase_txt = sys.argv[1:7]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    phase = "\n".join(lines(phase_txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: " + tool_arg in text))
    checks.append(("the entries table is the phase record's", len(tables) == 3 and len(phase) == 3 and tables[1] == phase[1]))
    checks.append(("the xml table is the phase record's", len(tables) == 3 and len(phase) == 3 and tables[2] == phase[2]))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))

