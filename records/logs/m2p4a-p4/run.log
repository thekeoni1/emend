            return dout[:x] + dout[y:]
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        core = core_of(zin)
        if len(args) == 2 and args[1] == "--parts":
            print(core or "-")
            print(1 if core and core in zin.namelist() else 0)
            print("_rels/.rels")
            return
        zout = zipfile.ZipFile(args[1])
        flag_plant = None
        if len(args) == 4 and args[2] == "--plant":
            flag_plant = args[3]
            if flag_plant not in FLAGS:
