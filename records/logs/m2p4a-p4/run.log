    SAMPLES="names link props protect"
    sample_flag() { printf -- '--%s-sample' "$1"; }
    # The sample's comparison script: namescmp, linkscmp, propscmp, protectcmp.
    cmp_of() { case $1 in link) echo linkscmp ;; *) echo "$1cmp" ;; esac; }
    sample_phase_record() {
      case $1 in
        names) echo 'M2 part 4a P1 record:' ;;
