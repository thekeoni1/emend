    """The run log's own link comparison (specs/0019-names-links-properties-
    protection.md, "Harness runs", --link-sample and P2).
    
    Usage: linkscmp.py <input archive> <output archive> [--plant <flag>]
           linkscmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool. It finds the workbook part through the package
    relationship; W, the first <sheet> in <sheets> order whose relationship type
    is a worksheet's, and its part; S, W's sheet name; and M, the largest row
    number of a <c> in W's sheetData elements (0 when there is none), N = M + 1.
    The form, transitional or strict, of the link's relationship type and of a
    retag's declaration is the form of W's own relationship in the workbook's rels
    part: the first relationship that is not external, of either worksheet type,
    whose target is W's part (strict when its type is the strict worksheet type,
    transitional otherwise and when there is none), as specs/0019 P2 verification
    ruling 2 gives it (P3 ruling 9, F10: P2's copy took the type from the rels
    part's existing hyperlinks and the declaration from the root's namespace).
    From the input it builds, by the design's rules, what the output must hold,
    and compares:
    
      rest_same        W with its root start tag and every main-namespace root
                       child named hyperlinks or sheetData cut out is the
                       input's, byte for byte
      root_tag         W's root start tag is the input's when the input's binds a
                       prefix to the relationships namespace, and otherwise the
                       input's with one declaration appended after its last
                       attribute: xmlns:r (or the first of r1, r2 and so on the
                       tag does not declare) bound to the relationships namespace
                       in the form of W's relationship
      links_prefix     the input's hyperlinks content is a byte-identical prefix
                       of the output's, the start tag the input's (opened up when
                       it was empty) and the end tag of the same name; trivially
                       so when the input had none
      added_tags       after that prefix come exactly two elements, read with
                       ElementTree: hyperlink ref=A<N> with the relationships id
                       and tooltip "emend sample", and hyperlink ref=B<N> with the
                       location 'S'!A1 (S's apostrophes doubled), and no other
                       attribute
      added_bytes      the two elements are byte for byte the ones this log
                       builds, with the container's prefix, the relationships
                       prefix, the id one past the input rels part's largest rId,
                       and the location escaped as an attribute (the five entities,
                       tab, line feed and carriage return as character references)
      rel_target       read with ElementTree, the output rels part holds a
                       relationship with that id, the hyperlink type in the form
                       of W's relationship, the target
                       https://example.com/ and TargetMode External
      rels_bytes       the output rels part is the input's with that one
                       Relationship element before its end tag, or, when the input
                       has none, the package rels part's bytes before its root
                       followed by a Relationships root holding that element alone
      sheet_data       W's sheetData is the input's but for the one created cell:
                       <c r="A<N>" t="inlineStr"> holding "emend link" as an
                       inline string, and the row <row r="<N>"> it goes into when
                       the input has none (an empty row N opened up)
      container_place  an existing hyperlinks keeps its place among the main
                       children; a created one ends exactly where the first main
                       child that the worksheet table of ECMA-376 18.3.1.99 puts
                       after hyperlinks starts (the root's end tag when there is
                       none), this log's own copy of the table
      root_order       the output's main root children's names are the input's
                       with hyperlinks inserted, when the input lacks it, before
                       the first main child the table puts after it, or at the end
      one_each         the output has exactly one hyperlinks among the root's
                       main children
      links_read       read with ElementTree, the output's hyperlink elements
                       (ref, relationships id, location, tooltip) are the input's
                       followed by the two added ones
    
    It prints ONE line of counts and yes/no flags and no name, text, sheet name,
    reference, target or part name. --parts prints W's part name, its rels part's
    name and whether the input has that rels part (1 or 0), for the log to
    compare with the runner's rows without printing them. --plant <flag> changes
    the output as read so that the named flag turns to no; the line then says
    planted=yes, or planted=no when the pair gives the plant nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    TARGET = "https://example.com/"
    TOOLTIP = "emend sample"
    
    # ECMA-376 Part 1, 18.3.1.99, the worksheet root's children in order: this
    # log's own copy (specs/0018, "Creating an element"), not the crate's.
    TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    assert len(TABLE) == 39
    
    FLAGS = ("rest_same", "root_tag", "links_prefix", "added_tags", "added_bytes",
             "rel_target", "rels_bytes", "sheet_data", "container_place",
             "root_order", "one_each", "links_read")
    
    COMMENT = b"<!-- planted -->"
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None, TargetMode) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved, el.get("TargetMode")))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t, _) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def sheet_strict(z, workbook, part):
        """Whether W's own relationship in the workbook's rels part is of the
        strict form (F10)."""
        kinds = tuple(a + "/worksheet" for a in ATTR)
        for (_, ty, target, mode) in rels_of(z, workbook):
            if mode != "External" and ty in kinds and target == part:
                return ty == kinds[1]
        return False
    
    
    def pick_w(z, workbook):
        """(W's part, S) or None."""
        by_id = {i: (ty, t) for (i, ty, t, _) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty.endswith("/worksheet"):
                    return target, el.get("name", "")
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def inner(raw):
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return len(tag), len(tag)
        return len(tag), raw.rfind(b"</")
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def with_attr(tag, name, value):
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def attr_value(tag, name):
        m = re.search(ATTR_RE % re.escape(name), tag)
        return m.group(1)[1:-1] if m else None
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def children(data, a, b, rp):
        """[(start, end, main local name or None)] of the root's children."""
        out = []
        for (x, y) in top_level(data[a:b]):
            p, n = split_name(qname(data[a + x:a + y]))
            out.append((a + x, a + y, n if p == rp else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def attr_escaped(text):
        """The layer's attribute escape: the five, and tab, line feed and
        carriage return as character references."""
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace("'", "&apos;").replace('"', "&quot;").replace("\t", "&#9;")
                .replace("\n", "&#10;").replace("\r", "&#13;")).encode()
    
    
    def declarations(tag):
        """{prefix: namespace} of a start tag's xmlns:<p> declarations."""
        return {m.group(1): m.group(2)[1:-1]
                for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag)}
    
    
    def rels_prefix(tag):
        """The first prefix a start tag binds to the relationships namespace."""
        for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            if m.group(2)[1:-1].decode() in ATTR:
                return m.group(1)
        return None
    
    
    def cells_and_m(data):
        """(the <c> elements of every main sheetData root child, the largest row
        number among them)."""
        n, m = 0, 0
        root = ET.fromstring(data)
        for sd in root:
            ns, name = local(sd.tag)
            if ns not in MAIN or name != "sheetData":
                continue
            for row in sd:
                for c in row:
                    cns, cname = local(c.tag)
                    if cns in MAIN and cname == "c":
                        n += 1
                        got = re.match(r"^[A-Z]+([0-9]+)$", c.get("r", ""))
                        if got:
                            m = max(m, int(got.group(1)))
        return n, m
    
    
    def links_of(data):
        """(ref, relationships id, location, tooltip) of every hyperlink of every
        main hyperlinks root child, in document order."""
        out = []
        for el in ET.fromstring(data):
            ns, name = local(el.tag)
            if ns not in MAIN or name != "hyperlinks":
                continue
            for h in el:
                hns, hname = local(h.tag)
                if hns in MAIN and hname == "hyperlink":
                    rid = next((h.get("{%s}id" % a) for a in ATTR if h.get("{%s}id" % a) is not None), None)
                    out.append((h.get("ref"), rid, h.get("location"), h.get("tooltip")))
        return out
    
    
    def ext_links(z, part):
        return sum(1 for (_, ty, _, mode) in rels_of(z, part)
                   if mode == "External" and ty in tuple(a + "/hyperlink" for a in ATTR))
    
    
    def plant(flag, dout, rout, state):
        """(dout, rout) changed so that `flag` turns to no, or None when the pair
        gives the plant nothing to change."""
        ts, te, a, b, rp = root_span(dout)
        kids = children(dout, a, b, rp)
        hl = [(x, y) for (x, y, n) in kids if n == "hyperlinks"]
        sd = [(x, y) for (x, y, n) in kids if n == "sheetData"]
        if flag == "rest_same":
            return dout[:te] + COMMENT + dout[te:], rout
        if flag == "root_tag":
            return dout[:te - 1] + b' planted="1"' + dout[te - 1:], rout
        if flag == "links_prefix":
            if not hl or not state["in_content"]:
                return None
            x = hl[0][0] + inner(dout[hl[0][0]:hl[0][1]])[0]
            sp = dout.find(b" ", x)
            return dout[:sp] + b" " + dout[sp:], rout
        if flag in ("added_tags", "added_bytes"):
            t = b'tooltip="' + TOOLTIP.encode() + b'"'
            at = dout.rfind(t)
            if at < 0:
                return None
            new = t + b' display="x"' if flag == "added_tags" else b"tooltip='" + TOOLTIP.encode() + b"'"
            return dout[:at] + new + dout[at + len(t):], rout
        if flag == "rel_target":
            if rout is None or rout.rfind(TARGET.encode()) < 0:
                return None
            at = rout.rfind(TARGET.encode())
            return dout, rout[:at] + b"https://example.org/" + rout[at + len(TARGET):]
        if flag == "rels_bytes":
            t = b'TargetMode="External"/>'
            if rout is None or rout.rfind(t) < 0:
                return None
            at = rout.rfind(t)
            return dout, rout[:at] + b"TargetMode='External'/>" + rout[at + len(t):]
        if flag == "sheet_data":
            at = dout.find(b">emend link<")
            if at < 0:
                return None
            return dout[:at] + b">emend linX<" + dout[at + len(b">emend link<"):], rout
        if flag == "container_place":
            if state["had_container"] or not hl:
                return None
            return dout[:hl[0][1]] + COMMENT + dout[hl[0][1]:], rout
        if flag == "root_order":
            if not hl or not sd:
                return None
            (x1, y1), (x2, y2) = sorted([hl[0], sd[0]])
            first, second = dout[x1:y1], dout[x2:y2]
            return dout[:x1] + second + dout[y1:x2] + first + dout[y2:], rout
        if flag == "one_each":
            return dout[:b] + b"<" + rp + b"hyperlinks/>" + dout[b:], rout
        if flag == "links_read":
            t = b'ref="B%d"' % state["n"]
            at = dout.rfind(t)
            if at < 0:
                return None
            return dout[:at] + b'ref="C%d"' % state["n"] + dout[at + len(t):], rout
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        w = pick_w(zin, wb)
        if w is None or w[0] not in zin.namelist():
            print("error=no-worksheet")
            return
        part, s_name = w
        rname = rels_name(part)
        if args[1:] == ["--parts"]:
            print(part)
            print(rname)
            print(1 if rname in zin.namelist() else 0)
            return
        strict = sheet_strict(zin, wb, part)
        zout = zipfile.ZipFile(args[1])
        flag_plant = None
        if len(args) == 4 and args[2] == "--plant":
            flag_plant = args[3]
            if flag_plant not in FLAGS:
                print("error=unknown-plant")
                return
        din, dout = zin.read(part), zout.read(part)
        rin = zin.read(rname) if rname in zin.namelist() else None
        rout = zout.read(rname) if rname in zout.namelist() else None
    
        cells_in, m = cells_and_m(din)
        n = m + 1
        loc = "'" + s_name.replace("'", "''") + "'!A1"
    
        its, ite, ia, ib, rp = root_span(din)
        tag_in = din[its:ite]
        kin = children(din, ia, ib, rp)
        hl_in = [(x, y) for (x, y, nm) in kin if nm == "hyperlinks"]
        sd_in = [(x, y) for (x, y, nm) in kin if nm == "sheetData"]
        in_content = b""
        if hl_in:
            el = din[hl_in[0][0]:hl_in[0][1]]
            x, y = inner(el)
            in_content = el[x:y]
        state = {"in_content": in_content, "had_container": bool(hl_in), "n": n}
    
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, dout, rout, state)
            if changed is not None:
                dout, rout = changed
                planted = True
    
        ots, ote, oa, ob, orp = root_span(dout)
        tag_out = dout[ots:ote]
        kout = children(dout, oa, ob, orp)
        hl_out = [(x, y) for (x, y, nm) in kout if nm == "hyperlinks"]
        sd_out = [(x, y) for (x, y, nm) in kout if nm == "sheetData"]
        flags = dict.fromkeys(FLAGS, False)
    
        # The root start tag, and the relationships prefix the links use.
        bound = rels_prefix(tag_in)
        if bound is not None:
            want_tag = tag_in
            rpre = bound
        else:
            taken = declarations(tag_in)
            k = 0
            while True:
                rpre = b"r" if k == 0 else b"r%d" % k
                if rpre not in taken:
                    break
                k += 1
            ns = ATTR[1] if strict else ATTR[0]
            want_tag = with_attr(tag_in, b"xmlns:" + rpre, ns.encode())
        flags["root_tag"] = tag_out == want_tag
        flags["rest_same"] = (
            cut(din, [(its, ite)] + hl_in + sd_in) == cut(dout, [(ots, ote)] + hl_out + sd_out))
        flags["one_each"] = len(hl_out) == 1
    
        # The relationship the link was given, as the design writes it.
        in_rels = rels_of(zin, part)
        highest = 0
        for (rid, _, _, _) in in_rels:
            got = re.match(r"^rId([0-9]+)$", rid or "")
            if got:
                highest = max(highest, int(got.group(1)))
        rid_want = "rId%d" % (highest + 1)
        kind = (ATTR[1] if strict else ATTR[0]) + "/hyperlink"
        rel_el = (b'<Relationship Id="' + rid_want.encode() + b'" Type="' + kind.encode()
                  + b'" Target="' + TARGET.encode() + b'" TargetMode="External"/>')
        if rout is not None:
            try:
                got = [el for el in ET.fromstring(rout).iter("{%s}Relationship" % RELS)
                       if el.get("Id") == rid_want]
            except ET.ParseError:
                got = []
            flags["rel_target"] = (len(got) == 1 and got[0].get("Type") == kind
                                   and got[0].get("Target") == TARGET
                                   and got[0].get("TargetMode") == "External")
            if rin is not None:
                end = rin.rfind(b"</")
                flags["rels_bytes"] = rout == rin[:end] + rel_el + rin[end:]
            elif "_rels/.rels" in zin.namelist():
                pkg = zin.read("_rels/.rels")
                head = pkg[:re.search(rb"<[^?!]", pkg).start()]
                flags["rels_bytes"] = rout == (head + b'<Relationships xmlns="' + RELS.encode()
                                               + b'">' + rel_el + b"</Relationships>")
    
        # The two added elements.
        p = split_name(qname(din[hl_in[0][0]:hl_in[0][1]]))[0] if hl_in else rp
        want_added = (
            b"<" + p + b'hyperlink ref="A%d" ' % n + rpre + b':id="' + rid_want.encode()
            + b'" tooltip="' + attr_escaped(TOOLTIP) + b'"/>'
            + b"<" + p + b'hyperlink ref="B%d" location="' % n + attr_escaped(loc) + b'"/>')
        if hl_out:
            el = dout[hl_out[0][0]:hl_out[0][1]]
            x, y = inner(el)
            content = el[x:y]
            tag = start_tag(el)
            if hl_in:
                tin = start_tag(din[hl_in[0][0]:hl_in[0][1]])
                head_ok = tag == (opened(tin) if tin.endswith(b"/>") else tin)
                end_ok = el.endswith(b"</" + qname(din[hl_in[0][0]:hl_in[0][1]]) + b">")
            else:
                head_ok = tag == b"<" + rp + b"hyperlinks>"
                end_ok = el.endswith(b"</" + rp + b"hyperlinks>")
            flags["links_prefix"] = head_ok and end_ok and content.startswith(in_content)
            added = content[len(in_content):] if content.startswith(in_content) else b""
            flags["added_bytes"] = added == want_added
            try:
                decls = declarations(tag_out)
                if p and p[:-1] not in decls:
                    decls[p[:-1]] = MAIN[0].encode()
                decl = b"".join(b' xmlns:%s="%s"' % (k, v) for (k, v) in decls.items())
                got = list(ET.fromstring(b"<w" + decl + b">" + added + b"</w>"))
                ns_r = decls.get(rpre, ATTR[0].encode()).decode()
                a_attrs = {"ref": "A%d" % n, "{%s}id" % ns_r: rid_want, "tooltip": TOOLTIP}
                b_attrs = {"ref": "B%d" % n, "location": loc}
                flags["added_tags"] = (
                    len(got) == 2 and all(local(e.tag)[1] == "hyperlink" for e in got)
                    and dict(got[0].attrib) == a_attrs and dict(got[1].attrib) == b_attrs
                    and len(top_level(added)) == 2)
            except ET.ParseError:
                flags["added_tags"] = False
    
        # sheetData: the one created cell, and its row when the input has none.
        if len(sd_in) >= 1 and len(sd_out) >= 1:
            s_in = din[sd_in[0][0]:sd_in[0][1]]
            s_out = dout[sd_out[0][0]:sd_out[0][1]]
