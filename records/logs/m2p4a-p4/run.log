    """The run log's own protection comparison (specs/0019-names-links-
    properties-protection.md, "Harness runs", --protect-sample and P3).
    
    Usage: protectcmp.py <input archive> <output archive> [--plant <flag>]
           protectcmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool. It finds the workbook part through the package
    relationship and W, the first <sheet> in <sheets> order whose relationship
    type is a worksheet's, and builds the two elements the design gives, with
    this log's own copy of the legacy hash of "emend":
    <p:sheetProtection password="HHHH" sheet="1" sort="0" autoFilter="0"/> and
    <p:workbookProtection workbookPassword="HHHH" lockStructure="1"/>, p the
    prefix of the input's element when it had one, else the root's. It compares:
    
      hash             read with ElementTree, the output's password attributes,
                       both elements (sheetProtection's password and
                       workbookProtection's workbookPassword, each on the one main
                       root child of its name), are this log's own hash of the
                       tool's constant "emend" (specs/0019 P3 verification ruling
                       5, F9: an output can turn it)
      sheet_rest       W with its root's main sheetProtection children cut out is
                       the input's with them cut out, byte for byte
      sheet_elem       W's root has exactly one main sheetProtection child, byte
                       for byte the element built here
      sheet_place      it stands where the input's stood, or, when the input had
                       none, it ends exactly where the first main root child the
                       worksheet table of ECMA-376 18.3.1.99 puts after
                       sheetProtection starts (the root's end tag when none does)
      book_rest        the workbook part with its root's main workbookProtection
                       children cut out is the input's with them cut out
      book_elem        the workbook root has exactly one main workbookProtection
                       child, byte for byte the element built here
      book_place       it stands where the input's stood, or, when the input had
                       none, it starts exactly where the last main root child the
                       workbook table of ECMA-376 18.2.27 puts before
                       workbookProtection ends (after the root's start tag when
                       none does)
      read             read with ElementTree, the two elements' attributes are the
                       ones built here and no other
    
    It prints ONE line of counts and yes/no flags and no part name. --parts
    prints W's part name and the workbook part's name, for the log to compare
    with the runner's rows without printing them. --plant <flag> changes the
    outputs as read so the named flag turns to no; besides the flags it takes
    hash_sheet, which changes the worksheet's password attribute where the plant
    hash changes the workbook's, so each element's attribute is shown read.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    SHEET_TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    BOOK_TABLE = (
        "fileVersion fileSharing workbookPr workbookProtection bookViews sheets "
        "functionGroups externalReferences definedNames calcPr oleSize "
        "customWorkbookViews pivotCaches smartTagPr smartTagTypes webPublishing "
        "fileRecoveryPr webPublishObjects extLst").split()
    assert len(SHEET_TABLE) == 39 and len(BOOK_TABLE) == 19
    FLAGS = ("hash", "sheet_rest", "sheet_elem", "sheet_place", "book_rest", "book_elem",
             "book_place", "read")
    PLANTS = FLAGS + ("hash_sheet",)
    COMMENT = b"<!-- planted -->"
