        root = ET.fromstring(data)
        got = {}
        for el in root:
            if el.tag.startswith("{"):
                ns, _, n = el.tag[1:].partition("}")
                if (ns, n) in THIRTEEN:
                    got.setdefault((ns, n), []).append(el)
        return got
    
    
    def compare(din, dout):
        f = {}
        ts, te, a, b = root_span(din)
        decls, dflt = declarations(din[ts:te]), default_ns(din[ts:te])
        kin = children(din, a, b, decls, dflt)
        ots, ote, oa, ob = root_span(dout)
        odecls, odflt = declarations(dout[ots:ote]), default_ns(dout[ots:ote])
        kout = children(dout, oa, ob, odecls, odflt)
        keys = [k for (k, _) in EDITED]
        f["root_tag"] = din[ts:te] == dout[ots:ote] or (din[ts:te].endswith(b"/>") and
                                                        dout[ots:ote] == din[ts:te - 2] + b">")
        ein = [k for k in kin if k[2] in keys]
        eout = [k for k in kout if k[2] in keys]
        missing = [k for k in keys if not any(e[2] == k for e in ein)]
        rest_in = cut(din[a:b], [(x - a, y - a) for (x, y, _) in ein])
        appended_out = [k for k in kout[len(kin):]] if len(kout) >= len(kin) else []
        tail = appended_out[0][0] if appended_out else ob
        rest_out = cut(dout[oa:tail], [(x - oa, y - oa) for (x, y, _) in eout if x < tail])
        outside = din[:ts] == dout[:ots] and (din[b:] == dout[ob:] if a != b else True)
        f["rest_same"] = outside and rest_in == rest_out
        counts = {k: sum(1 for e in kout if e[2] == k) for k in keys}
        f["three_once"] = all(v == 1 for v in counts.values())
        got = props(dout)
        f["three_text"] = all(len(got.get(k, [])) == 1 and (got[k][0].text or "") == v for (k, v) in EDITED)
        in_place = True
        for (x, y, k) in ein:
            idx = kin.index((x, y, k))
            if idx >= len(kout) or kout[idx][2] != k:
                in_place = False
        f["in_place"] = in_place
        f["appended"] = [e[2] for e in appended_out] == missing
        ok = True
        for (k, v) in EDITED:
            want = expected(k, v, din, kin, decls, dflt)
            have = [dout[x:y] for (x, y, kk) in kout if kk == k]
            if want is None or have != [want]:
