        print("\t".join(["found=1", "planted=%s" % yn(planted), "props_in=%d" % pin,
                         "props_out=%d" % pout, "appended_n=%d" % missing] +
                        ["%s=%s" % (k, yn(f[k])) for k in FLAGS]))
    
    
    main()
