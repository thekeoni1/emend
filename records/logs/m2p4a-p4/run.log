        if core is None or core not in zin.namelist():
            print("found=0")
            return
        din = zin.read(core)
        ocore = core_of(zout)
        dout = zout.read(ocore)
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, dout)
