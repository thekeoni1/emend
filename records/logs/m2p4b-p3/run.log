## the run log's comparison (python3, zipfile, byte spans and ElementTree)
command: cp <scripts>/scalecmp.py <scratch>/w/scalecmp.py; sed 's/^/    /' <scratch>/w/scalecmp.py; sha256 920d2874029b21cadfd9ed6c2b0835831e9562212e3b2be545cee8b87c1f6179, 19937 bytes
  the copy is the file beside this script, byte for byte: yes
    """The run log's own visual rule comparison (specs/0020-validation-and-
    conditional-formatting.md, "Harness runs", --scale-sample and P3, with P2
    ruling 5 and P3 ruling 1).
    
    Usage: scalecmp.py <input archive> <output archive> [--plant <flag>]
           scalecmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool. It finds the workbook part through the package
    relationship; W, the first <sheet> in <sheets> order whose relationship type
    is a worksheet's, and its part; the styles part through the workbook's
    styles relationship; M, the largest row number of a <c> in W's sheetData
    elements (0 when there is none), N = M + 1; and H, the highest priority of a
    main-namespace cfRule of a main-namespace conditionalFormatting root child
    of W (0 when there is none). From the input it builds, by the design's
    rules, what the output must hold, and compares:
    
      rest_same    W with every main-namespace root child named
                   conditionalFormatting cut out is the input's, byte for byte
      cf_prefix    the input's conditionalFormatting elements, in order, are a
                   byte-identical prefix of the output's
      added_bytes  after that prefix come exactly three, byte for byte the ones
                   this program builds with W's root prefix: a colour scale from
                   min in 00F8696B to max in 0063BE7B on A<N>:A<N+2> with
                   priority H + 1, a data bar from min to max in 00638EC6 on
                   B<N>:B<N+2> with priority H + 2, and a 3Arrows icon set of 0,
                   33 and 67 percent on C<N>:C<N+2> with priority H + 3, no dxfId
      added_tags   read with ElementTree, those three carry exactly those
                   attributes, one cfRule each with no formula and one child
                   holding those cfvo and color elements
      cf_place     the three added elements are adjacent and end exactly where
                   the first main child that the worksheet table puts after
                   conditionalFormatting starts, or at the root's end tag (P2
                   ruling 5), this program's own copy of the table
      root_order   the output's main root children's names are the input's with
                   three conditionalFormatting inserted before that child
      cf_read      read with ElementTree, the output's conditional formats (sqref,
                   each rule's attributes, formula texts and visual child) are
                   the input's followed by the three added ones
      styles_same  the styles part is the input's, byte for byte
    
    It prints ONE line of counts and yes/no flags and no formula, colour, text,
    reference, sheet name or part name. --parts prints W's part name and the
    styles part's, one per line, for the log to compare with the runner's rows
    without printing them. --plant <flag> changes the output as read so that the
    named flag turns to no; the line then says planted=yes, or planted=no when
    the pair gives the plant nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    # ECMA-376 Part 1, 18.3.1.99, the worksheet root's children in order: this
    # program's own copy (specs/0018, "Creating an element"), not the crate's.
    TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    assert len(TABLE) == 39
    
    FLAGS = ("rest_same", "cf_prefix", "added_bytes", "added_tags", "cf_place", "root_order",
             "cf_read", "styles_same")
    
    COMMENT = b"<!-- planted -->"
    CF = "conditionalFormatting"
    # The rule kinds the tool's line counts as visual.
    VISUAL = ("colorScale", "dataBar", "iconSet")
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def pick_w(z, workbook):
        """W's part, or None."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty.endswith("/worksheet"):
                    return target
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def inner(raw):
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return len(tag), len(tag)
        return len(tag), raw.rfind(b"</")
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def with_attr(tag, name, value):
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def children(data, a, b, rp, root_ns):
        """[(start, end, main local name or None)] of the root's children. A
        child is main when its prefix is the root's (the root is main) or when
        it declares the main namespace as its own default or prefix."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            p, n = split_name(qname(raw))
            tag = start_tag(raw)
            decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
            own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
            if own:
                main = own.group(1)[1:-1].decode() in MAIN
            else:
                main = p == rp and root_ns in MAIN
            out.append((a + x, a + y, n if main else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def attr_escaped(text):
        """The layer's attribute escape: the five, and tab, line feed and
        carriage return as character references."""
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace("'", "&apos;").replace('"', "&quot;").replace("\t", "&#9;")
                .replace("\n", "&#10;").replace("\r", "&#13;")).encode()
    
    
    def text_escaped(text):
        """An element text's escape: ampersand and the two angle brackets."""
        return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").encode()
    
    
    def styles_of(z, workbook):
        """The styles part's name, or None."""
        for (_, ty, t) in rels_of(z, workbook):
            if ty.endswith("/styles"):
                return t
        return None
    
    
    def m_of(data):
        """The largest row number of a <c> in every main sheetData root child."""
        m = 0
        for sd in ET.fromstring(data):
            ns, name = local(sd.tag)
            if ns not in MAIN or name != "sheetData":
                continue
            for row in sd:
                for c in row:
                    cns, cname = local(c.tag)
                    if cns in MAIN and cname == "c":
                        got = re.match(r"^\$?[A-Z]+\$?([0-9]+)$", c.get("r", ""))
                        if got:
                            m = max(m, int(got.group(1)))
        return m
    
    
    
    
    def signature(el):
        """An element's local name, sorted attributes and its children's
        signatures, recursively."""
        return (local(el.tag)[1], tuple(sorted(el.attrib.items())),
                tuple(signature(c) for c in el))
    
    
    def rules_of(data):
        """(sqref, [(sorted attributes, [formula texts], [child signatures])])
        of every main conditionalFormatting root child, in document order."""
        out = []
        for el in ET.fromstring(data):
            ns, name = local(el.tag)
            if ns not in MAIN or name != CF:
                continue
            rules = []
            for r in el:
                rns, rname = local(r.tag)
                if rns in MAIN and rname == "cfRule":
                    forms = [f.text or "" for f in r
                             if local(f.tag)[0] in MAIN and local(f.tag)[1] == "formula"]
                    kids = [signature(k) for k in r
                            if not (local(k.tag)[0] in MAIN and local(k.tag)[1] == "formula")]
                    rules.append((tuple(sorted(r.attrib.items())), forms, kids))
            out.append((el.get("sqref"), rules))
        return out
    
    
    def highest(rules):
        """The highest priority of the rules, 0 when there is none."""
        got = [int(dict(a)["priority"]) for (_, rs) in rules for (a, _, _) in rs
               if dict(a).get("priority", "").isdigit()]
        return max(got) if got else 0
    
    
    def counts(rules):
        """(rules, visual rules, rules holding a main extLst child)."""
        n = visual = extended = 0
        for (_, rs) in rules:
            for (a, _, kids) in rs:
                n += 1
                visual += 1 if dict(a).get("type") in VISUAL else 0
                extended += 1 if any(k[0] == "extLst" for k in kids) else 0
        return n, visual, extended
    
    
    def expected(n, h):
        """The three conditional formats the sample adds (tools/emend-copy,
        --scale-sample): sqref, the rule's attributes, the child's name and
        attributes, and the child's children (name, attributes)."""
        last = n + 2
        return [
            ("A%d:A%d" % (n, last), [("type", "colorScale"), ("priority", str(h + 1))],
             "colorScale", [],
             [("cfvo", [("type", "min")]), ("cfvo", [("type", "max")]),
              ("color", [("rgb", "00F8696B")]), ("color", [("rgb", "0063BE7B")])]),
            ("B%d:B%d" % (n, last), [("type", "dataBar"), ("priority", str(h + 2))],
             "dataBar", [],
             [("cfvo", [("type", "min")]), ("cfvo", [("type", "max")]),
              ("color", [("rgb", "00638EC6")])]),
            ("C%d:C%d" % (n, last), [("type", "iconSet"), ("priority", str(h + 3))],
             "iconSet", [("iconSet", "3Arrows")],
             [("cfvo", [("type", "percent"), ("val", "0")]),
              ("cfvo", [("type", "percent"), ("val", "33")]),
              ("cfvo", [("type", "percent"), ("val", "67")])]),
        ]
    
    
    def attrs_bytes(attrs):
        return b"".join(b" " + k.encode() + b'="' + attr_escaped(v) + b'"' for (k, v) in attrs)
    
    
    def cf_bytes(p, sqref, attrs, child, child_attrs, grand):
        out = b"<" + p + b'conditionalFormatting sqref="' + sqref.encode() + b'"><' + p + b"cfRule"
        out += attrs_bytes(attrs) + b"><" + p + child.encode() + attrs_bytes(child_attrs) + b">"
        for (name, a) in grand:
            out += b"<" + p + name.encode() + attrs_bytes(a) + b"/>"
        out += b"</" + p + child.encode() + b"></" + p + b"cfRule></" + p + b"conditionalFormatting>"
        return out
    
    
    def plant(flag, wout, sout, st):
        """(wout, sout) changed so that `flag` turns to no, or None when the pair
        gives the plant nothing to change."""
        ts, te, a, b, rp = root_span(wout)
        kids = children(wout, a, b, rp, st["root_ns"])
        cfs = [(x, y) for (x, y, n) in kids if n == CF]
        sd = [(x, y) for (x, y, n) in kids if n == "sheetData"]
        if flag == "rest_same":
            return wout[:te] + COMMENT + wout[te:], sout
        if flag == "cf_prefix":
            if not st["cf_in"] or not cfs:
                return None
            e = cfs[0][0] + len(start_tag(wout[cfs[0][0]:cfs[0][1]]))
            return wout[:e] + COMMENT + wout[e:], sout
        if flag in ("added_tags", "added_bytes"):
            t = b'iconSet="3Arrows"'
            at = wout.rfind(t)
            if at < 0:
                return None
            new = t + b' planted="1"' if flag == "added_tags" else b"iconSet='3Arrows'"
            return wout[:at] + new + wout[at + len(t):], sout
        if flag == "cf_place":
            if not cfs:
                return None
            return wout[:cfs[-1][1]] + COMMENT + wout[cfs[-1][1]:], sout
        if flag == "root_order":
            if not cfs or not sd:
                return None
            (x1, y1), (x2, y2) = sorted([cfs[-1], sd[0]])
            return wout[:x1] + wout[x2:y2] + wout[y1:x2] + wout[x1:y1] + wout[y2:], sout
        if flag == "cf_read":
            t = b'sqref="C%d:C%d"' % (st["n"], st["n"] + 2)
            at = wout.rfind(t)
            if at < 0:
                return None
            return wout[:at] + b'sqref="D%d:D%d"' % (st["n"], st["n"] + 2) + wout[at + len(t):], sout
        if flag == "styles_same":
            sts, ste, _, _, _ = root_span(sout)
            return wout, sout[:ste] + COMMENT + sout[ste:]
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        part = pick_w(zin, wb)
        if part is None or part not in zin.namelist():
            print("error=no-worksheet")
            return
        styles = styles_of(zin, wb)
        if styles is None or styles not in zin.namelist():
            print("error=no-styles")
            return
        if args[1:] == ["--parts"]:
            print(part)
            print(styles)
            return
        zout = zipfile.ZipFile(args[1])
        flag_plant = None
        if len(args) == 4 and args[2] == "--plant":
            flag_plant = args[3]
            if flag_plant not in FLAGS:
                print("error=unknown-plant")
                return
        win, wout = zin.read(part), zout.read(part)
        sin, sout = zin.read(styles), zout.read(styles)
    
        n = m_of(win) + 1
        root_ns = local(ET.fromstring(win).tag)[0]
        its, ite, ia, ib, rp = root_span(win)
        kin = children(win, ia, ib, rp, root_ns)
        cf_in = [(x, y) for (x, y, nm) in kin if nm == CF]
        rules_in = rules_of(win)
        h = highest(rules_in)
        st = {"cf_in": bool(cf_in), "n": n, "root_ns": root_ns}
    
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, wout, sout, st)
            if changed is not None:
                wout, sout = changed
                planted = True
    
        flags = dict.fromkeys(FLAGS, False)
        ots, ote, oa, ob, orp = root_span(wout)
        kout = children(wout, oa, ob, orp, root_ns)
        cf_out = [(x, y) for (x, y, nm) in kout if nm == CF]
        flags["rest_same"] = cut(win, cf_in) == cut(wout, cf_out)
        in_els = [win[x:y] for (x, y) in cf_in]
        out_els = [wout[x:y] for (x, y) in cf_out]
        flags["cf_prefix"] = out_els[:len(in_els)] == in_els
        want = expected(n, h)
        want_added = [cf_bytes(rp, *w) for w in want]
        added = out_els[len(in_els):]
        flags["added_bytes"] = added == want_added
        try:
            decl = b' xmlns:%s="%s"' % (rp[:-1], MAIN[0].encode()) if rp else b' xmlns="%s"' % MAIN[0].encode()
            got = list(ET.fromstring(b"<w" + decl + b">" + b"".join(added) + b"</w>"))
            ok = len(got) == 3
            for (e, (q, attrs, child, cattrs, grand)) in zip(got, want):
                rules = list(e)
                ok = ok and local(e.tag)[1] == CF and dict(e.attrib) == {"sqref": q} and len(rules) == 1
                ok = ok and local(rules[0].tag)[1] == "cfRule" and dict(rules[0].attrib) == dict(attrs)
                kids = list(rules[0])
                ok = ok and len(kids) == 1 and local(kids[0].tag)[1] == child
                ok = ok and dict(kids[0].attrib) == dict(cattrs)
                ok = ok and [(local(g.tag)[1], dict(g.attrib)) for g in kids[0]] == [(nm, dict(a)) for (nm, a) in grand]
            flags["added_tags"] = ok
        except (ET.ParseError, IndexError):
            flags["added_tags"] = False
        pos = TABLE.index(CF)
        later_in = [x for (x, _, nm) in kin if nm is not None and nm in TABLE and TABLE.index(nm) > pos]
        at_in = later_in[0] if later_in else ib
        later_out = [x for (x, _, nm) in kout if nm is not None and nm in TABLE and TABLE.index(nm) > pos]
        at_out = later_out[0] if later_out else ob
        add_spans = cf_out[len(cf_in):]
        flags["cf_place"] = (len(add_spans) == 3 and add_spans[0][1] == add_spans[1][0]
                             and add_spans[1][1] == add_spans[2][0]
                             and add_spans[2][1] == at_out
                             and wout[:add_spans[0][0]] == win[:at_in])
        order_in = [nm for (_, _, nm) in kin if nm is not None]
        order_out = [nm for (_, _, nm) in kout if nm is not None]
        at_name = next((i for i, nm in enumerate(order_in) if nm in TABLE and TABLE.index(nm) > pos),
                       len(order_in))
        flags["root_order"] = order_out == order_in[:at_name] + [CF, CF, CF] + order_in[at_name:]
        try:
            rules_out = rules_of(wout)
        except ET.ParseError:
            rules_out = None
        want_read = rules_in + [
            (q, [(tuple(sorted(a)), [],
                  [(child, tuple(sorted(ca)), tuple((nm, tuple(sorted(ga)), ()) for (nm, ga) in grand))])])
            for (q, a, child, ca, grand) in want]
        flags["cf_read"] = rules_out == want_read
        flags["styles_same"] = sin == sout
        n_in, v_in, e_in = counts(rules_in)
        n_out, v_out, _ = counts(rules_out or [])
    
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted),
             "cf_in=%d" % n_in, "cf_out=%d" % n_out,
             "visual_in=%d" % v_in, "visual_out=%d" % v_out,
             "extended_in=%d" % e_in, "priority_max_in=%d" % h]
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS]))
    
    
    main()
