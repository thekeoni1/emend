    use std::io::Cursor;
    
    #[allow(clippy::too_many_arguments)]
    pub fn rules(
        p: &mut emend::package::Package<Cursor<Vec<u8>>>,
        v: emend::Validation<'_>,
        e: &emend::ValidationEntry,
        k: emend::ValidationKind,
        o: emend::Operator,
        s: emend::ErrorStyle,
        r: emend::Rule<'_>,
        n: &emend::RuleEntry,
        style: &emend::Style,
        c: emend::Cfvo<'_>,
        ck: emend::CfvoKind<'_>,
        ik: emend::IconSetKind,
    ) -> usize {
        let _ = (e, k, o, s, n, c, ck, ik);
        let _ = p.add_validation(b"x", &[], v);
        let _ = p.remove_validation(b"x", &[]);
        let _ = p.add_differential_style(style);
        let _ = p.add_conditional_format(b"x", &[], r, None, None, false);
        let _ = p.remove_conditional_format(b"x", &[]);
        let _ = p.conditional_formats(b"x");
        p.validations(b"x").map_or(0, |list| list.len())
    }
