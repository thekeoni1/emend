    #!/usr/bin/env bash
    # Milestone 2 part 4b P4 gate.log (specs/0020-validation-and-conditional-
    # formatting.md, "P4: the catalogue and limits, the probe, the size record"
    # and "Phases"): the spec pinned by the hash of its committed blob, the full
    # gate on a cold cache, the phase's commits by role and by the paths they
    # touch, each commit message's form and the count rule on every commit, the
    # doc commit's two files against the hashes planning's message gave, each
    # commit's diff hashed, each code commit held to its area, the carry commit's
    # removals held to package.rs and its test added, the catalogue commit held to
    # //! lines, the probe crate's manifest edit and no lock change, the gate files
    # checked against the diff, the scripts parsed, the new and modified sources
    # scored, the public fn and const first lines listed with the feature `rules`
    # off and on (this phase adds none), the consumer crate that names the
    # seventeen items the feature gates with the feature off and on, clippy and
    # doc with the feature off and on and clippy over the probe crate's feature
    # sets, `rules` among them, the crate's tests with the feature off and on on
    # both targets, the tests of the base unedited, shown line by line, the four
    # DEBUG binary hashes, this script's own stderr counted, and the working
    # tree's status with planning's uncommitted spec named.
    #
    # Usage: m2p4b-p4-gate.sh <phase commit> > <file outside the tree>; the caller
    # moves the output to records/logs/m2p4b-p4/gate.log. The log prints its own
    # invocation, and every environment input it reads on a labelled line after it.
    #
    # This is a FILE, not an inline block, so "$0" names it and the log prints the
    # script rather than the shell binary.
    #
    # Its own text is committed inside the log, so it holds no office file name, no
    # path shape and no address: the office regex is read from check.sh, the
    # pre-P6d path forms are read from git, and every control fixture is assembled
    # at run time from pieces (specs/0001-bootstrap.md, as in every earlier gate log).
    #
    # CARRIED TO M2 part 4b P4 from part 4b P3's gate script (at the phase
    # commit 631c719, printed in records/logs/m2p4b-p3/gate.log; its change list
    # A9 to I9 is there), generated by <phase>/gen/gate.py, which asserts each
    # replacement once, and grepped for P3's names, subjects, typed lists, hashes
    # and the tokens m2p4b-p3, P3, c98838a0, 4c6bc56e, CODE4, the styles module's
    # checks and the visual module's declaration in every form; the catalogue and
    # probe checks follow part 4a P4's gate (printed in
    # records/logs/m2p4a-p4/gate.log, its change C6 and D6). What differs, and
    # why:
    #  A10. The phase is part 4b P4: the log directory records/logs/m2p4b-p4; the
    #       script in <scripts> on the disk, beside <phase>/out (this script's
    #       stderr) and <build> (<phase>/gate). The base is part 4b P3's record
    #       commit ("M2 part 4b P3 record:"); the doc commit and the three code
    #       commits by their full subjects, all beginning "M2 part 4b P4: ", the
    #       roles read back to <phase commit>~4. A rerun line names the
    #       superseded directory as <home>/.cache/emend-build/m2p4b-p4/superseded.
    #  B10. The spec is specs/0020, pinned by the hash of its COMMITTED blob
    #       (2b4afb62..., planning's word), at the doc commit and at the phase
    #       commit; the working tree's copy may hold planning's uncommitted
    #       rulings during P4 and is printed, not pinned. The doc commit's two
    #       files (ROADMAP.md 93150aa7..., specs/0020 2b4afb62...) against the
    #       hashes planning's message gave, typed here; the path-absent control
    #       names the new probe's source at the base, which lacks it.
    #  C10. The areas: code commit 1 (P3 verification ruling 2's carry) holds to
    #       package.rs and package/tests/visual.rs, removes lines from package.rs
    #       alone and adds the prefixed-root test the base lacks; code commit 2
    #       (the catalogue and limits) to package.rs, every line it adds or
    #       removes a //! line (part 4a P4's change C6); code commit 3 (the probe)
    #       to the probe crate's manifest and the new probe's source.
    #  D10. The one manifest in the phase diff is the probe crate's, touched by
    #       code commit 3 alone, its only non-comment changes the feature `rules`
    #       (turning on emend's, no dependency of its own) and the probe's [[bin]]
    #       entry (part 4a P4's change D6); no Cargo.lock.
    #  E10. The public first lines: this phase adds no pub item, so the lists
    #       with the feature rules off and on are the base's, line for line, as
    #       P3's E9 asserted; the consumer crate names the same seventeen items.
    #  F10. The base's tests: none gone and none edited; package/tests.rs is not
    #       changed by this phase.
    #  G10. Clippy and doc as P3, and clippy over the probe crate's feature sets
    #       with `rules` added; the crate's tests with rules off and on on both
    #       targets.
    #  H10. The status patterns name this phase's log directory, its record
    #       stems records/m2p4b-p4- (the three samples' records), records/m2p4b-
    #       open- and records/size-m2p4b-, and planning's uncommitted specs/0020,
    #       each with a control.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    PHASE_DIR=$(dirname "$SELF_DIR")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$PHASE_DIR/out" || exit 2
    ERR=$PHASE_DIR/out/gate.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    # Header change 1, kept: the build directory is on the disk, not in /tmp.
    BUILD_ROOT=$PHASE_DIR/gate
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    W=$(mktemp -d)
    # Every printed line passes through this scrub: the repository first, since it
    # lies inside the home directory, then the deeper directories before the
    # shallower ones.
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$W#<scratch>/w#g" -e "s#$BUILD_ROOT#<build>#g" \
        -e "s#$SELF_DIR#<scripts>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    C=${1:?phase commit required}
    # Change C3: the library at the phase commit, not the main tree's file.
    git show "$C:scripts/counting.sh" >"$W/counting.sh" || exit 2
    . "$W/counting.sh"
    
    trap 'rm -rf "$W"' EXIT INT TERM HUP
    fail=0
    note() { echo "  $1: $2"; [ "$2" = as-expected ] || fail=1; }
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    # For a control that must FAIL. `is ! f x` cannot express it: `!` is a shell
    # keyword, so "$@" would try to run a command named "!" and the helper would
    # print UNEXPECTED whatever f did.
    isnot() { if "$@"; then echo UNEXPECTED; else echo as-expected; fi; }
    ctl() {
      local label=$1 want=$2 n r
      shift 2
      n=$("$@")
      r=$([ "$n" = "$want" ] && echo as-expected || echo UNEXPECTED)
      echo "  control $label count=$n expected=$want: $r"
      [ "$r" = as-expected ] || fail=1
    }
    
    # specs/0001-bootstrap.md, "Rules for every phase" (M1 part 3 P1 ruling 11):
    # the phase commit is GIVEN to the script and compared with git rev-parse
    # HEAD before the run, with a control that refuses a fabricated commit.
    HEAD_SHA=$(git rev-parse HEAD)
    NULL_SHA=0000000000000000000000000000000000000000
    full_sha() {
      printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'
    }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    not_head() { if is_head "$1"; then return 1; else return 0; fi; }
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M2 part 4b P4 phase commits, last is $C; HEAD at run: $HEAD_SHA"
    # Change J4: every environment input this script reads, on a labelled line.
    echo "input (environment) RERUN_NOTE: $([ -n "${RERUN_NOTE:-}" ] && echo "set; its text is the rerun line below" || echo unset)"
    echo "input (environment) RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input (environment) ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset)"
    echo "input (environment) HOME: $([ -n "${HOME:-}" ] && echo "set; the scrub writes it <home>" || echo unset)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    # specs/0001: the scan greps every printed script for three forbidden shapes,
    # and they run here first, over this script's own file, each with a positive
    # control through the same command form. The patterns and the fixture are
    # assembled from pieces at run time, so this script's text holds none.
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    SHAPE_DIR=$(mktemp -d)
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$SHAPE_DIR/fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$SHAPE_DIR/fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      SHAPE_RESULT_SELF=$n_self
      SHAPE_RESULT_FIX=$n_fix
      note "$shape: this script holds none" "$(is [ "$SHAPE_RESULT_SELF" = 0 ])"
      note "control: $shape: the same form finds the fixture's one line" "$(is [ "$SHAPE_RESULT_FIX" = 1 ])"
    done
    rm -rf "$SHAPE_DIR"
    
    echo
    echo "## the spec, pinned by the hash of its committed blob (change B10; specs/0018 close-out ruling 4)"
    SPEC=specs/0020-validation-and-conditional-formatting.md
    # The hash planning's message gave for the doc commit's blob, typed (change B10).
    SPEC_GAVE=2b4afb62a1f9dddbda03bdeb2c3a8d04df5126e8544d91ca418482c603d12d7a
    echo "command: git show <phase commit>:$SPEC | sha256sum; sha256sum $SPEC (the working tree's copy, printed only)"
    SPEC_SHA=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_HEAD=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "  the phase commit's blob: sha256 $SPEC_HEAD"
    echo "  the hash planning's message gave: $SPEC_GAVE"
    echo "  the working tree's copy, planning's uncommitted rulings during P4 if any, not the pin: sha256 $SPEC_SHA"
    note "the spec at the phase commit is the blob planning's message hashed" "$(is [ "$SPEC_HEAD" = "$SPEC_GAVE" ])"
    note "control: the same comparison refuses another spec's blob (specs/0019 at the phase commit)" \
      "$(isnot [ "$(git show "$C:specs/0019-names-links-properties-protection.md" | sha256sum | cut -d' ' -f1)" = "$SPEC_GAVE" ])"
    
    echo
    echo "## the phase's commits by role, read from git (header change 2)"
    note_fn() { local label=$1; shift; note "$label" "$(is "$@")"; }
    by_subject() { git log --format='%H' -n 1 -F --grep="$1" "$C"; }
    REC=$(by_subject 'M2 part 4b P3 record: logs, corpus and open-check records, the independent checks')
    DOC1=$(by_subject 'M2 part 4b P4: commit planning docs (the P3 rulings and verification)')
    CODE1=$(by_subject "M2 part 4b P4: the P3 verification carry (the colour elements' prefix as bytes)")
    CODE2=$(by_subject 'M2 part 4b P4: the catalogue and limits of validations and conditional formats')
    CODE3=$(by_subject 'M2 part 4b P4: probe-emend-rules-write-xml')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject> <phase commit>, for each role"
    echo "  part 4b P3's record commit: ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  code commit 1 (the P3 verification carry): ${CODE1:-none}"
    echo "  code commit 2 (the catalogue and limits): ${CODE2:-none}"
    echo "  code commit 3 (the probe, the phase commit): ${CODE3:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r
      for r in "$REC" "$DOC1" "$CODE1" "$CODE2" "$CODE3"; do
        [ -n "$r" ] || return 1
      done
      [ "$CODE3" = "$C" ] || return 1
      [ "$(git rev-parse "$C~1")" = "$CODE2" ] || return 1
      [ "$(git rev-parse "$C~2")" = "$CODE1" ] || return 1
      [ "$(git rev-parse "$C~3")" = "$DOC1" ] || return 1
      [ "$(git rev-parse "$C~4")" = "$REC" ]
    }
    note_fn "code commits 3, 2 and 1, the doc commit and part 4b P3's record commit, each the next one's parent" roles_in_order
    roles_ctl1() { local CODE1=$CODE2; if roles_in_order; then return 1; else return 0; fi; }
    roles_ctl2() { local DOC1=$REC; if roles_in_order; then return 1; else return 0; fi; }
    note_fn "control: roles_in_order refuses code commit 2 named as code commit 1" roles_ctl1
    note_fn "control: roles_in_order refuses the base named as the doc commit" roles_ctl2
    echo "command: git log --format=%s <part 4b P3's record commit>..<phase commit>"
    git log --format='%s' "$REC..$C" >"$W/subjects"
    sed 's/^/    /' "$W/subjects"
    PREFIX_RE='^M2 part 4b P4: '
    nsub=$(count_lines "$W/subjects")
    nprefix=$(count_matches -E "$PREFIX_RE" "$W/subjects")
    echo "  subjects in the range: $nsub; beginning \"M2 part 4b P4: \": $nprefix"
    prefix_all() { [ "$nsub" -ge 1 ] && [ "$nsub" = "$nprefix" ]; }
    note_fn "every commit in the range carries the phase's subject prefix" prefix_all
    printf 'M2 part 4b P4: x\nM2 part 4b P3: y\nM2 part 4b: z\n' >"$W/c-subjects"
    ctl "one subject of three with the prefix, same command form" 1 count_matches -E "$PREFIX_RE" "$W/c-subjects"
    no_such_subject() { [ -z "$(by_subject 'M2 part 4b P4: no such subject anywhere')" ]; }
    note_fn "control: a subject no commit has resolves to nothing" no_such_subject
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $HEAD_SHA"
    note "the phase commit given to this script is a full sha" "$(is full_sha "$C")"
    note "the phase commit given to this script is HEAD" "$(is is_head "$C")"
    note "control: the same comparison refuses the null commit" \
      "$(is not_head "$NULL_SHA")"
    note "control: the same comparison refuses a short sha of the real commit" \
      "$(is not_head "$(printf '%s' "$C" | cut -c1-7)")"
    
    echo "phase: Milestone 2 part 4b P4 (specs/0020-validation-and-conditional-formatting.md) gate.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "  the superseded files are kept in <home>/${PHASE_DIR#"$HOME"/}/superseded (change A10)"
      # specs/0014 P2 verification ruling 4: a rerun line names only hashes the
      # command under it prints.
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    # SERIALIZED: backed by a measurement at entry, the cargo and rustc processes
    # running before this script starts any.
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory, <build>/target (CARGO_TARGET_DIR)"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to (it lies inside <home>, so it is scrubbed first); scripts/check.sh is run from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/${PHASE_DIR#"$HOME"/}, this phase's directory on the disk (change A10); <phase>/superseded keeps a superseded attempt's files; <phase>/out holds this script's own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <scripts> stands for <phase>/$(basename "$SELF_DIR"), the directory holding this script"
    echo "root: <build> stands for <phase>/$(basename "$BUILD_ROOT"), this log's build directory (header change 1); the gate builds into <build>/target, the crate's feature runs and its clippy and doc runs into <build>/feature-target, the probe crate's clippy runs (change G10) into <build>/probe-target, and the consumer crate lives in <build>/consumer and builds into <build>/consumer-target"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory; scripts/counting.sh is read at the phase commit into <scratch>/w/counting.sh and sourced from there (change C3)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    note_fn "<scratch>/w and <phase> are distinct directories, neither inside the other" apart "$W" "$PHASE_DIR"
    note_fn "<scratch>/w and <repo> are distinct directories, neither inside the other" apart "$W" "$MAIN"
    note_fn "<phase> and <repo> are distinct directories, neither inside the other" apart "$PHASE_DIR" "$MAIN"
    note_fn "<build> and <scripts> are distinct directories, neither inside the other" apart "$BUILD_ROOT" "$SELF_DIR"
    apart_ctl() { if apart "$BUILD_ROOT" "$PHASE_DIR"; then return 1; else return 0; fi; }
    note_fn "control: apart refuses a directory inside another (<build> inside <phase>)" apart_ctl
    note "no cargo or rustc process was running at entry" "$(is [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    note "ANTHROPIC_API_KEY is not set" "$(is key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    note "control: the same check refuses a shell where the variable is set" "$(isnot key_set_ctl)"
    echo "DEPARTURE: CARGO_BUILD_JOBS=4 (this box stopped two T0 P6d gate runs for low memory)"
    echo
    echo "## script"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$W/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the phase base, resolved from git and checked for ambiguity"
    # specs/0001 requires the base to be read from git by the first doc commit's
    # subject, never typed; its parent is the base. The count of doc commits is
    # deliberately NOT asserted; structure_sound below asserts the structure.
    DOC_PATTERN='^M2 part 4b P4: commit planning docs [(]the P3 rulings and verification[)]'
    echo "command: git log --format='%H' --grep='$DOC_PATTERN'"
    git log --format='%H' --grep="$DOC_PATTERN" >"$W/doc-matches"
    nmatch=$(count_lines "$W/doc-matches")
    echo "  commits matching the first doc commit's pattern: $nmatch"
    note "the first doc commit's pattern matches exactly one commit" "$(is [ "$nmatch" = 1 ])"
    DOC=$(git log --format='%H' --grep="$DOC_PATTERN" -n 1)
    BASE=$(git rev-parse --verify "$DOC^" 2>/dev/null)
    echo "  the first doc commit is $DOC"
    echo "  its parent, the phase base, is $BASE"
    note "the base resolved from git, not typed" "$(is [ -n "$BASE" ])"
    CLOSE_REC=$(git log --format='%H' -n 1 --grep='^M2 part 4b P3 record:')
    echo "  part 4b P3's record commit, by subject: ${CLOSE_REC:-none found}"
    note "the phase base is part 4b P3's record commit" "$(is [ "$BASE" = "$CLOSE_REC" ])"
    note "control: the same comparison refuses the first doc commit as the base" \
      "$(isnot [ "$DOC" = "$CLOSE_REC" ])"
    
    echo
    echo "## the phase's commits"
    echo "command: git log --reverse --format='%H %s' <base>..<phase commit>"
    git log --reverse --format='    %H %s' "$BASE..$C"
    ncommits=$(git rev-list --count "$BASE..$C")
    echo "  commits in the range: $ncommits"
    # Each commit is classified by the paths it touches, and the sequence is
    # checked as one property in one function: a mixed or empty commit fails, the
    # range opens with a doc commit and holds at least one code commit.
    commit_class() {
      git show --name-only --format= "$1" | awk '
        NF { total++; if ($0 ~ /^specs\// || $0 == "ROADMAP.md" || $0 == "CLAUDE.md") docs++ }
        END {
          if (total == 0) { print "empty"; exit }
          if (docs == total) print "doc"; else if (docs == 0) print "code"; else print "mixed"
        }'
    }
    structure_sound() {
      awk 'NR == 1 && $1 != "doc" { bad = 1 }
           $1 == "mixed" || $1 == "empty" { bad = 1 }
           $1 == "code" { code = 1 }
           END { exit (bad || !code || NR == 0) }' "$1"
    }
    : >"$W/classes"
    for h in $(git rev-list --reverse "$BASE..$C"); do
      printf '%s %s\n' "$(commit_class "$h")" "$(git log --format='%h %s' -n 1 "$h")" >>"$W/classes"
    done
    sed 's/^/    /' "$W/classes"
    note "every commit is planning docs alone or code alone, the range opens with a doc commit and holds code" \
      "$(is structure_sound "$W/classes")"
    ndoc=$(count_matches -E '^doc ' "$W/classes")
    ncode=$(count_matches -E '^code ' "$W/classes")
    echo "  of the $ncommits commits in the range: $ndoc planning-doc, $ncode code"
    note "the phase holds at least one doc commit, counted in the range" \
      "$(is [ "$ndoc" -ge 1 ])"
    note "control: the same count finds this phase's code commits too" \
      "$(is [ "$ncode" -ge 1 ])"
    note "control: the two classes account for every commit in the range" \
      "$(is [ "$((ndoc + ncode))" = "$ncommits" ])"
    note "control: commit_class calls the first doc commit a doc commit" \
      "$(is [ "$(commit_class "$DOC")" = doc ])"
    # The code-commit control names its commit by what that commit DID: the last
    # commit in the range that modified a crate source.
    CODEC=$(git log --format='%H' -n 1 --diff-filter=M "$BASE..$C" -- crates/emend/src)
    echo "  the last commit in the range that modified a source under crates/emend/src: ${CODEC:-none found}"
    note "the commit that modified a crate source resolved from git" "$(is [ -n "$CODEC" ])"
    note "control: commit_class calls the commit that modified a crate source a code commit" \
      "$(is [ "$(commit_class "$CODEC")" = code ])"
    note "control: the first doc commit carries ROADMAP.md, a term the classifier reads" \
      "$(is [ "$(git show --name-only --format= "$DOC" | count_matches -Fx ROADMAP.md /dev/stdin)" = 1 ])"
    printf 'doc a docs\ncode b code\ndoc c docs\ncode d code\n' >"$W/c-ord-ok"
    printf 'code a code\ndoc b docs\n'                        >"$W/c-ord-first"
    printf 'doc a docs\nmixed b both\ncode c code\n'          >"$W/c-ord-mixed"
    printf 'doc a docs\nempty b nothing\ncode c code\n'       >"$W/c-ord-empty"
    printf 'doc a docs\ndoc b docs\n'                         >"$W/c-ord-nocode"
    note "control: structure_sound accepts docs and code interleaved" \
      "$(is structure_sound "$W/c-ord-ok")"
    note "control: structure_sound rejects a range that opens with a code commit" \
      "$(isnot structure_sound "$W/c-ord-first")"
    note "control: structure_sound rejects a commit mixing docs and code" \
      "$(isnot structure_sound "$W/c-ord-mixed")"
    note "control: structure_sound rejects an empty commit" \
      "$(isnot structure_sound "$W/c-ord-empty")"
    note "control: isnot reports a passing command as UNEXPECTED, so it can fail" \
      "$(is [ "$(isnot true)" = UNEXPECTED ])"
    note "control: structure_sound rejects a range with no code commit" \
      "$(isnot structure_sound "$W/c-ord-nocode")"
    
    echo
    echo "## every commit message in the range: ASCII, ending with the Co-Authored-By line only"
    COAUTHOR='Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>'
    msg_form_ok() {
      local last nco nsess nna ntrail
      last=$(awk 'NF { l = $0 } END { print l }' "$1")
      nco=$(count_matches -E '^Co-Authored-By:' "$1")
      nsess=$(count_matches_i -F 'claude-session' "$1")
      nna=$(count_bytes "$NONASCII_CLASS" "$1")
      ntrail=$(git interpret-trailers --parse <"$1" | count_lines /dev/stdin)
      [ "$last" = "$COAUTHOR" ] || return 1
      [ "$nco" = 1 ] || return 1
      [ "$nsess" = 0 ] || return 1
      [ "$ntrail" = 1 ] || return 1
      [ "$nna" = 0 ]
    }
    for h in $(git rev-list --reverse "$BASE..$C"); do
      git log -1 --format=%B "$h" >"$W/msg"
      echo "  $(git log -1 --format=%h "$h"): message lines $(count_lines "$W/msg"), non-ASCII bytes $(count_bytes "$NONASCII_CLASS" "$W/msg"), trailers git parses:"
      git interpret-trailers --parse <"$W/msg" | sed 's/^/      /'
      note "$(git log -1 --format=%h "$h")'s message is ASCII and ends with the Co-Authored-By line only" \
        "$(is msg_form_ok "$W/msg")"
    done
    printf 'subject\n\nbody\n\n%s\n' "$COAUTHOR" >"$W/c-msg-ok"
    printf 'subject\n\nbody\n\n%s\n%s: x\n' "$COAUTHOR" 'Claude-Session' >"$W/c-msg-session"
    printf 'subj\303\251ct\n\n%s\n' "$COAUTHOR" >"$W/c-msg-nonascii"
    printf 'subject\n\n%s\n%s\n' "$COAUTHOR" "$COAUTHOR" >"$W/c-msg-twice"
    printf 'subject\n\nbody\n' >"$W/c-msg-none"
    note "control: msg_form_ok accepts a message ending with the line" "$(is msg_form_ok "$W/c-msg-ok")"
    note "control: msg_form_ok refuses a session line after it" "$(isnot msg_form_ok "$W/c-msg-session")"
    note "control: msg_form_ok refuses a non-ASCII byte" "$(isnot msg_form_ok "$W/c-msg-nonascii")"
    note "control: msg_form_ok refuses the line twice" "$(isnot msg_form_ok "$W/c-msg-twice")"
    note "control: msg_form_ok refuses a message without it" "$(isnot msg_form_ok "$W/c-msg-none")"
    # Change J3 (specs/0018 P2 verification ruling 5 and P3 verification ruling
    # 2, G9, carried in the scan script's form): the count rule on EVERY commit
    # of the phase. A message passes when it carries the diff-alone sentence,
    # read with its line breaks folded, or when it states no count. counts_in
    # prints the numbers left in the body (the trailer dropped) once identifiers
    # are removed: words holding a slash (paths), tokens such as P1 or M2, and the
    # number after "ruling", "decision", "part", "phase" or "section", with any
    # "to" or "and" range after it; what is left, a whole-word number in digits or
    # a number word to twenty, is a count.
    COUNT_SENTENCE='No log prints a count for this commit; the diff alone carries what it changes.'
    says_diff_alone() { tr '\n' ' ' <"$1" | tr -s ' ' | LC_ALL=C "$G" -qF "$COUNT_SENTENCE"; }
    counts_in() {
      python3 - "$1" <<'COUNTS'
    import re, sys
    text = open(sys.argv[1]).read()
    body = "\n".join(l for l in text.split("\n") if not re.match(r"^Co-Authored-By:", l))
    body = " ".join(body.split())
    body = " ".join(w for w in body.split(" ") if "/" not in w)
    body = re.sub(r"\b[A-Z][0-9]+\b", " ", body)
    num = r"(?:[0-9]+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)"
    body = re.sub(r"\b(?:rulings?|decisions?|parts?|phases?|sections?)\b[^.;:]*?\b" + num + r"\b(?:,? (?:to|and) " + num + r"\b)*", " ", body, flags=re.I)
    for m in re.finditer(r"\b" + num + r"\b", body, flags=re.I):
        print(m.group(0))
    COUNTS
    }
    states_no_count() { [ -z "$(counts_in "$1")" ]; }
    count_rule_ok() { says_diff_alone "$1" || states_no_count "$1"; }
    for h in $(git rev-list --reverse "$BASE..$C"); do
      git log -1 --format=%B "$h" >"$W/msg-rule"
      found=$(counts_in "$W/msg-rule" | tr '\n' ' ')
      sentence=$(says_diff_alone "$W/msg-rule" && echo yes || echo no)
      echo "  $(git log -1 --format=%h "$h"): counts left after the identifiers: ${found:-none}; the diff-alone sentence: $sentence"
      note "$(git log -1 --format=%h "$h")'s message states no count or says the diff alone carries its counts (change J3)" "$(is count_rule_ok "$W/msg-rule")"
    done
    printf 'subject\n\nNo log prints a count for this\ncommit; the diff alone carries what it changes.\n' >"$W/c-msg-folded"
    note "control: says_diff_alone reads the sentence across a line break" "$(is says_diff_alone "$W/c-msg-folded")"
    note "control: says_diff_alone refuses a message without it" "$(isnot says_diff_alone "$W/c-msg-ok")"
    printf 'M2 part 4b P4: x\n\nThe rulings during P4, 1 to 5, and decision 7 A; specs/0020-x.md.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-ids"
    printf 'M2 part 4b P4: x\n\nAdds three tests and 14 lines.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-count"
    printf 'M2 part 4b P4: x\n\nAdds three tests. No log prints a count for this commit; the\ndiff alone carries what it changes.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-both"
    note "control: count_rule_ok accepts a message whose numbers are identifiers and a trailer" "$(is count_rule_ok "$W/c-rule-ids")"
    note "control: count_rule_ok refuses a message stating counts without the sentence" "$(isnot count_rule_ok "$W/c-rule-count")"
    note "control: count_rule_ok accepts the same counts beside the sentence" "$(is count_rule_ok "$W/c-rule-both")"
    ctl "counts_in finds the two counts of the refused message, same command form" 2 run_lines counts_in "$W/c-rule-count"
    
    echo
    echo "## the doc commit's files against the hashes planning's message gave (header change 3)"
    # The expected values are typed because they are planning's: each is
    # labelled "the hash planning's message gave". Every computed hash is printed
    # by the command that made it.
    echo "  the doc commit: $DOC1"
    blob_sha() { git show "$1:$2" | sha256sum | cut -d' ' -f1; }
    blob_matches() {
      git cat-file -e "$1:$2" 2>/dev/null || return 1
      [ "$(blob_sha "$1" "$2")" = "$3" ]
    }
    while read -r which path given; do
      case "$which" in doc1) at=$DOC1 ;; head) at=$C ;; esac
      if git cat-file -e "$at:$path" 2>/dev/null; then got=$(blob_sha "$at" "$path"); else got=absent; fi
      echo "  $which $(git rev-parse --short "$at") $path"
      echo "    command: git show <commit>:$path | sha256sum"
      echo "    sha256 $got"
      echo "    the hash planning's message gave: $given"
      note "$which's $path is the blob planning's message gave" "$(is blob_matches "$at" "$path" "$given")"
    done <<'HASHES'
    doc1 specs/0020-validation-and-conditional-formatting.md 2b4afb62a1f9dddbda03bdeb2c3a8d04df5126e8544d91ca418482c603d12d7a
    doc1 ROADMAP.md 93150aa77c402084016b288470fa63315ee0bf96ae467100eb718b51cb8ecffc
    head specs/0020-validation-and-conditional-formatting.md 2b4afb62a1f9dddbda03bdeb2c3a8d04df5126e8544d91ca418482c603d12d7a
    head ROADMAP.md 93150aa77c402084016b288470fa63315ee0bf96ae467100eb718b51cb8ecffc
    HASHES
    # The "head" rows say no commit after the doc commit changed planning's files.
    git show --name-only --format= "$DOC1" | sort >"$W/doc1-files"
    printf 'ROADMAP.md\nspecs/0020-validation-and-conditional-formatting.md\n' >"$W/doc1-want"
    sed 's/^/    the doc commit carries: /' "$W/doc1-files"
    note "the doc commit carries exactly the two files planning's message hashed" "$(is cmp -s "$W/doc1-files" "$W/doc1-want")"
    note "control: blob_matches refuses the message's ROADMAP hash at the base, before the doc commit" \
      "$(isnot blob_matches "$BASE" ROADMAP.md 93150aa77c402084016b288470fa63315ee0bf96ae467100eb718b51cb8ecffc)"
    note "control: blob_matches refuses the message's 0020 hash at the base, before the doc commit" \
      "$(isnot blob_matches "$BASE" specs/0020-validation-and-conditional-formatting.md 2b4afb62a1f9dddbda03bdeb2c3a8d04df5126e8544d91ca418482c603d12d7a)"
    note "control: blob_matches refuses a path absent at the commit (the new probe's source at the base, change B10)" \
      "$(isnot blob_matches "$BASE" tools/size-probe/src/bin/probe-emend-rules-write-xml.rs 2b4afb62a1f9dddbda03bdeb2c3a8d04df5126e8544d91ca418482c603d12d7a)"
    printf 'ROADMAP.md\n' >"$W/c-doc-short"
    note "control: the file comparison refuses a list one file short" "$(isnot cmp -s "$W/c-doc-short" "$W/doc1-want")"
    
    echo
    echo "## each commit's diff and the phase's combined diff, hashed with the command that produced each"
    for h in $(git rev-list --reverse "$BASE..$C"); do
      cmd="git show --no-color --no-ext-diff --format= $h"
      echo "  command: $cmd | sha256sum"
      echo "    $($cmd | sha256sum | cut -d' ' -f1)  $(git log -1 --format=%s "$h")"
    done
    cmd="git diff --no-color --no-ext-diff $BASE $C"
    echo "  command: $cmd | sha256sum"
    echo "    $($cmd | sha256sum | cut -d' ' -f1)  the phase's combined diff"
    h1=$(git show --no-color --no-ext-diff --format= "$C" | sha256sum | cut -d' ' -f1)
    h2=$(git show --no-color --no-ext-diff --format= "$C" | sha256sum | cut -d' ' -f1)
    h3=$(git show --no-color --no-ext-diff --format= "$C^" | sha256sum | cut -d' ' -f1)
    note "control: the phase commit's diff hashes the same twice" "$(is [ "$h1" = "$h2" ])"
    note "control: its parent's diff hashes differently" "$(isnot [ "$h1" = "$h3" ])"
    
    echo
    echo "## the changed files at the phase commit"
    for f in $(git diff --name-only --diff-filter=d "$BASE" "$C"); do
      git show "$C:$f" >"$W/f" 2>/dev/null || { echo "$f: READ ERROR"; fail=1; continue; }
      echo "$f: sha256 $(sha256sum <"$W/f" | cut -d' ' -f1), bytes $(wc -c <"$W/f"), mode $(git ls-tree "$C" -- "$f" | awk '{print $1}')"
    done
    git diff --name-only --diff-filter=d "$BASE" "$C" >"$W/difffiles"
    echo "  files in the diff: $(count_lines "$W/difffiles")"
    new_mode() { [ "$(git ls-tree "$C" -- "$1" | awk '{print $1}')" = 100755 ]; }
    # Every source the phase adds or modifies, read from the diff, is checked.
    while IFS= read -r m; do
      note "$m, in this phase's diff, is not executable" "$(isnot new_mode "$m")"
    done <"$W/difffiles"
    note "control: the same mode check finds the runner executable" "$(is new_mode scripts/passthrough-run.sh)"
    
    echo
    echo "## the gate files this phase changed, and the self-test they require"
    # specs/0001-bootstrap.md, "Rules for every phase": a phase that changes no
    # gate file LISTS IN gate.log the gate files it checked against the diff.
    cat >"$W/gate-files" <<'EOF'
    scripts/check.sh
    scripts/privacy.sh
    scripts/privacy-patterns.txt
    scripts/privacy-identity.txt
    scripts/sys-allowlist.txt
    scripts/install-hooks.sh
    scripts/counting.sh
    scripts/gate-self-test.sh
    .gitignore
    .github/workflows/ci.yml
    EOF
    echo "command: awk over specs/0001-bootstrap.md, the bullet opening '- A phase that changes a gate file' up to its first 'runs', backticked names"
    git show "$C:specs/0001-bootstrap.md" | awk '/^- A phase that changes a gate file/ { on = 1 } on { print } on && /runs/ { exit }' >"$W/gate-sentence"
    sed 's/^/    /' "$W/gate-sentence"
    tr -d '\n' <"$W/gate-sentence" | LC_ALL=C "$G" -o -E '`[^`]+`' | tr -d '`' | LC_ALL=C "$G" -v -E ' ' | sort >"$W/gate-from-spec"
    LC_ALL=C "$G" -v -Fx .github/workflows/ci.yml "$W/gate-files" | sort >"$W/gate-typed"
    sed 's/^/    named in specs\/0001: /' "$W/gate-from-spec"
    ci_named() { [ "$(count_matches -F 'the CI workflow' "$W/gate-sentence")" = 1 ]; }
    note "the typed gate-file list is specs/0001's backticked names plus the CI workflow" "$(is cmp -s "$W/gate-from-spec" "$W/gate-typed")"
    note "specs/0001's sentence names the CI workflow" "$(is ci_named)"
    LC_ALL=C "$G" -v -Fx scripts/counting.sh "$W/gate-typed" >"$W/c-gate-typed"
    note "control: the comparison refuses the typed list one name short" "$(isnot cmp -s "$W/gate-from-spec" "$W/c-gate-typed")"
    echo "  the gate files specs/0001 names, each checked against the phase diff:"
    sed 's/^/    checked: /' "$W/gate-files"
    touched=0
    while IFS= read -r g; do
      if LC_ALL=C "$G" -Fxq -- "$g" "$W/difffiles"; then
        echo "  gate file in the diff: $g"
        touched=$((touched + 1))
      fi
    done <"$W/gate-files"
    echo "  gate files checked: $(count_lines "$W/gate-files"); of them in the phase diff: $touched"
    note "no gate file is in the phase diff, so specs/0001 asks for this listing and no self-test" \
      "$(is [ "$touched" = 0 ])"
    FIRST_DIFF=$(sed -n '1p' "$W/difffiles")
    echo "  a file that IS in the phase diff, taken from the diff: $FIRST_DIFF"
    found_first=$(count_matches -Fx "$FIRST_DIFF" "$W/difffiles")
    note "control: the same search finds a name the diff does hold" \
      "$(is [ "$found_first" -ge 1 ])"
    in_diff_not_gate() {
      [ "$(count_matches -Fx "$1" "$W/difffiles")" = 1 ] &&
        [ "$(count_matches -Fx "$1" "$W/gate-files")" = 0 ]
    }
    # Every file the phase diff holds, read from the diff rather than typed.
    while IFS= read -r s; do
      echo "  $s: in the phase diff $(count_matches -Fx "$s" "$W/difffiles") times; in the gate-file list $(count_matches -Fx "$s" "$W/gate-files") times"
      note "$s is in the diff and is not a gate file" "$(is in_diff_not_gate "$s")"
    done <"$W/difffiles"
    ST=records/logs/m2p4b-p4/self-test.log
    echo "  $ST: $([ -e "$ST" ] && echo PRESENT || echo "absent, as a phase with no gate-file change requires")"
    note "this phase committed no self-test log, having changed no gate file" \
      "$(is [ ! -e "$ST" ])"
    
    echo
    echo "## each code commit touches its own area only; the carry's removals are package.rs's; the catalogue commit is documentation; the probe crate's manifest edit and no lock (changes C10 and D10)"
    outside_count() {
      local all inside
      all=$(count_lines "$1"); inside=$(count_matches -E "$2" "$1")
      printf '%s' "$((all - inside))"
    }
    AREA_1='^crates/emend/src/(package[.]rs|package/tests/visual[.]rs)$'
    AREA_2='^crates/emend/src/package[.]rs$'
    AREA_3='^tools/size-probe/(Cargo[.]toml|src/bin/probe-emend-rules-write-xml[.]rs)$'
    touches_only() { [ "$1" -ge 1 ] && [ "$2" = 0 ]; }
    for k in 1 2 3; do
      var=CODE$k; at=${!var}; avar=AREA_$k; area=${!avar}
      echo "command: git show --name-only --format= <code commit $k>"
      git show --name-only --format= "$at" >"$W/code-files-$k"
      sed "s/^/    code commit $k touches: /" "$W/code-files-$k"
      nall=$(count_lines "$W/code-files-$k")
      nout=$(outside_count "$W/code-files-$k" "$area")
      echo "  paths: $nall; outside $area: $nout"
      note "code commit $k touches something, and nothing outside its area" "$(is touches_only "$nall" "$nout")"
    done
    printf 'crates/emend/src/package.rs\ncrates/emend/src/lib.rs\n' >"$W/c-code-files"
    ctl "one path outside code commit 1's area (lib.rs), same command form" 1 outside_count "$W/c-code-files" "$AREA_1"
    printf 'crates/emend/src/package.rs\ncrates/emend/src/package/tests/visual.rs\n' >"$W/c-code-files-2"
    ctl "one path outside code commit 2's area (package/tests/visual.rs), same command form" 1 outside_count "$W/c-code-files-2" "$AREA_2"
    printf 'tools/size-probe/Cargo.toml\ncrates/emend/src/package.rs\n' >"$W/c-code-files-3"
    ctl "one path outside code commit 3's area (package.rs), same command form" 1 outside_count "$W/c-code-files-3" "$AREA_3"
    printf 'tools/size-probe/src/bin/probe-emend-rules-write-xml.rs\ntools/size-probe/src/bin/probe-emend-metadata-write-xml.rs\n' >"$W/c-code-files-3p"
    ctl "another probe's source outside code commit 3's area, same command form" 1 outside_count "$W/c-code-files-3p" "$AREA_3"
    # Change C10: code commit 1, the carry, removes lines from package.rs alone
    # (the colour loop's prefix conversion) and adds the prefixed-root test the
    # base lacks (specs/0020 P3 verification ruling 2).
    removed_in() {
      git show -U0 --format= "$1" -- "$2" | LC_ALL=C "$G" -E '^-' | LC_ALL=C "$G" -vE '^--- ' || :
    }
    removed_in "$CODE1" crates/emend/src/package.rs >"$W/code1-removed-pkg"
    removed_in "$CODE1" crates/emend/src/package/tests/visual.rs >"$W/code1-removed-vis"
    echo "command: git show -U0 --format= <code commit 1> -- <each file>, the lines removed"
    echo "  code commit 1: lines removed from package.rs $(count_lines "$W/code1-removed-pkg"); from package/tests/visual.rs $(count_lines "$W/code1-removed-vis")"
    sed 's/^/    removed from package.rs: /' "$W/code1-removed-pkg"
    code1_removals() { [ "$(count_lines "$W/code1-removed-pkg")" -ge 1 ] && [ "$(count_lines "$W/code1-removed-vis")" = 0 ]; }
    note "code commit 1 removes lines from package.rs and none from the visual tests (change C10)" "$(is code1_removals)"
    conversion_gone() {
      [ "$(git show "$BASE:crates/emend/src/package.rs" | count_matches -F 'str::from_utf8(prefix).unwrap_or_default()' /dev/stdin)" = 1 ] &&
        [ "$(git show "$CODE1:crates/emend/src/package.rs" | count_matches -F 'str::from_utf8(prefix).unwrap_or_default()' /dev/stdin)" = 0 ]
    }
    note "the prefix's UTF-8 conversion is in package.rs at the base and gone at code commit 1 (P3 verification ruling 2)" "$(is conversion_gone)"
    conv_ctl() { local CODE1=$BASE; conversion_gone; }
    note "control: the same check refuses the base named as code commit 1" "$(isnot conv_ctl)"
    PREFIX_FN='fn a_prefixed_root_gives_its_prefix_to_the_child_its_points_and_its_colours() {'
    carry_test_added() {
      [ "$(git show "$CODE1:crates/emend/src/package/tests/visual.rs" | count_matches -Fx "$PREFIX_FN" /dev/stdin)" = 1 ] &&
        [ "$(git show "$BASE:crates/emend/src/package/tests/visual.rs" | count_matches -Fx "$PREFIX_FN" /dev/stdin)" = 0 ]
    }
    note "code commit 1 adds the prefixed-root test, which the base lacks (specs/0020 P3 verification ruling 2)" "$(is carry_test_added)"
    carry_ctl() { local CODE1=$BASE; carry_test_added; }
    note "control: the same check refuses the base named as code commit 1" "$(isnot carry_ctl)"
    # Change C10: every line code commit 2 adds or removes is a //! module-header
    # line, so the commit is documentation only (part 4a P4's change C6).
    changed_lines() {
      git show -U0 --format= "$1" | LC_ALL=C "$G" -E '^[-+]' | LC_ALL=C "$G" -vE '^(\+\+\+|---) ' || :
    }
    not_doc_lines() { LC_ALL=C "$G" -vE '^[-+][[:space:]]*//!' "$1" | count_lines /dev/stdin; }
    changed_lines "$CODE2" >"$W/code2-lines"
    changed_lines "$CODE1" >"$W/code1-lines"
    n2_all=$(count_lines "$W/code2-lines")
    n2_out=$(not_doc_lines "$W/code2-lines")
    n1_out=$(not_doc_lines "$W/code1-lines")
    echo "command: git show -U0 --format= <code commit 2>, the lines added or removed, less those whose text after the sign and any space begins //!"
    echo "  code commit 2: lines added or removed $n2_all; of them not a //! line $n2_out"
    note "code commit 2 changes //! module-header lines alone, and some (change C10)" "$(is touches_only "$n2_all" "$n2_out")"
    echo "  control: code commit 1's lines that are not a //! line: $n1_out"
    note "control: the same count finds code commit 1's code and test lines" "$(is [ "$n1_out" -ge 1 ])"
    printf '+//! a module line\n-    //! an indented one\n+/// an item doc line\n' >"$W/c-doc-lines"
    ctl "one line of three that is not a //! line (a /// line), same command form" 1 not_doc_lines "$W/c-doc-lines"
    # The styles module is not touched by this phase (P3's gated colour writer
    # is used as it stands).
    nstyles=$(count_matches -E '^crates/emend/src/styles([.]rs|/)' "$W/difffiles")
    echo "  files of the styles module in the phase diff: $nstyles"
    note "the phase changes no file of the styles module" "$(is [ "$nstyles" = 0 ])"
    printf 'crates/emend/src/styles.rs\ncrates/emend/src/styles/elements.rs\ncrates/emend/src/package.rs\n' >"$W/c-styles"
    ctl "two styles files in a list of three, same command form" 2 count_matches -E '^crates/emend/src/styles([.]rs|/)' "$W/c-styles"
    nlock=$(count_matches -Fx Cargo.lock "$W/difffiles")
    LC_ALL=C "$G" -E '(^|/)Cargo[.]toml$' "$W/difffiles" | LC_ALL=C sort >"$W/manifests" || :
    nmanifest=$(count_lines "$W/manifests")
    echo "  Cargo.lock in the phase diff: $nlock; manifests in the phase diff: $nmanifest"
    sed 's/^/    manifest in the phase diff: /' "$W/manifests"
    note "the phase changes no Cargo.lock" "$(is [ "$nlock" = 0 ])"
    printf 'tools/size-probe/Cargo.toml\n' >"$W/manifests-want"
    note "the one manifest in the phase diff is the probe crate's (change D10)" "$(is cmp -s "$W/manifests" "$W/manifests-want")"
    manifests_in() { git show --name-only --format= "$1" | count_matches -E '(^|/)Cargo[.]toml$' /dev/stdin; }
    echo "  manifests touched: by code commit 1 $(manifests_in "$CODE1"), by code commit 2 $(manifests_in "$CODE2"), by code commit 3 $(manifests_in "$CODE3")"
    only_code3_manifest() { [ "$(manifests_in "$CODE1")" = 0 ] && [ "$(manifests_in "$CODE2")" = 0 ] && [ "$(manifests_in "$CODE3")" = 1 ]; }
    note "the manifest edit is code commit 3's and no other code commit touches a manifest" "$(is only_code3_manifest)"
    # The non-comment, non-blank lines the manifest diff adds and removes, against
    # the edits "Size" rules: the probe crate's feature `rules`, which turns on
    # emend's, and the probe's [[bin]] entry.
    manifest_changes() {
      git diff -U0 "$BASE" "$C" -- "$1" | LC_ALL=C "$G" -E '^[-+]' | LC_ALL=C "$G" -vE '^(\+\+\+|---) ' |
        LC_ALL=C "$G" -vE '^[-+][[:space:]]*(#|$)' || :
    }
    echo "command: git diff <base> <phase commit> -- tools/size-probe/Cargo.toml"
    git diff "$BASE" "$C" -- tools/size-probe/Cargo.toml | sed 's/^/    /'
    manifest_changes tools/size-probe/Cargo.toml >"$W/man-probe"
    printf '%s\n' '+rules = ["emend", "xml", "emend/rules"]' \
      '+[[bin]]' '+name = "probe-emend-rules-write-xml"' '+path = "src/bin/probe-emend-rules-write-xml.rs"' \
      '+required-features = ["rules"]' >"$W/man-probe-want"
    echo "  the probe manifest's non-comment changes:"; sed 's/^/    /' "$W/man-probe"
    note "the probe manifest's only non-comment changes are the rules feature and the probe's [[bin]] entry (change D10)" "$(is cmp -s "$W/man-probe" "$W/man-probe-want")"
    printf '%s\n' '+rules = ["emend", "xml", "emend/rules", "dep:x"]' >"$W/c-man-probe"
    note "control: the comparison refuses a feature that brings a dependency" "$(isnot cmp -s "$W/c-man-probe" "$W/man-probe-want")"
    printf 'Cargo.lock\ntools/xlsx-diff/Cargo.toml\n' >"$W/c-lock"
    ctl "a lock file in a list, same command form" 1 count_matches -Fx Cargo.lock "$W/c-lock"
    ctl "a manifest in a list, same command form" 1 count_matches -E '(^|/)Cargo[.]toml$' "$W/c-lock"
    
    echo
    echo "## the scripts this phase runs parse, and the list script compiles"
    parse_ok() { bash -n "$1" 2>/dev/null; }
    for s in scripts/check.sh scripts/counting.sh scripts/passthrough-run.sh scripts/lo-check.sh scripts/edit-open-check.sh; do
      git show "$C:$s" >"$W/parse.sh"
      note "$s parses at the phase commit" "$(is parse_ok "$W/parse.sh")"
    done
    printf 'if then\n' >"$W/c-parse.sh"
    note "control: the same parse refuses a broken if" "$(isnot parse_ok "$W/c-parse.sh")"
    echo "command: python3 --version"
    python3 --version 2>&1 | sed 's/^/    /'
    py_compiles() { python3 -c 'import py_compile, sys; py_compile.compile(sys.argv[1], cfile=sys.argv[2], doraise=True)' "$1" "$W/compiled.pyc" 2>/dev/null; }
    git show "$C:scripts/excel-check-list.py" >"$W/list.py"
    note "scripts/excel-check-list.py compiles at the phase commit (py_compile, doraise)" "$(is py_compiles "$W/list.py")"
    printf 'def f(:\n    pass\n' >"$W/c-broken.py"
    note "control: the same compile refuses a broken def" "$(isnot py_compiles "$W/c-broken.py")"
    
    echo
    echo "## the new sources scored against the gate they must pass, with controls"
    OFF=$(git show "$C:scripts/check.sh" | sed -n "s/^readonly OFFICE_RE='\(.*\)'\$/\1/p")
    note "OFFICE_RE was read from check.sh and is non-empty" "$(is [ -n "$OFF" ])"
    PRE_COMMIT=$(git log --format='%H' --grep='^T0 P6d: narrow the three path patterns' -n 1)
    note "the P6d narrowing commit resolved from git" "$(is [ -n "$PRE_COMMIT" ])"
    git show "$PRE_COMMIT^:scripts/privacy-patterns.txt" >"$W/pre-all" 2>/dev/null || fail=1
    sed -n '8p;10p;11p' "$W/pre-all" >"$W/pre-patterns"
    note "three pre-P6d forms read from the narrowing commit's parent" \
      "$(is [ "$(count_lines "$W/pre-patterns")" = 3 ])"
    git show "$C:scripts/privacy-patterns.txt" >"$W/live-patterns"
    
    f_nonascii() { count_bytes "$NONASCII_CLASS" "$1"; }
    f_ctrl()     { count_bytes "$CTRL_CLASS" "$1"; }
    f_live()     { count_from_file -E "$W/live-patterns" "$1"; }
    f_pre()      { count_from_file -E "$W/pre-patterns" "$1"; }
    f_office()   { count_matches -E "$OFF" "$1"; }
    # P1 gate header change 7, kept: an office extension whose file name is a literal, the
    # name running back from the extension to a space, a quote, a slash, an
    # equals sign or the line's start with no shell expansion in it.
    f_office_literal() { count_matches -E "(^|[ \"'=/])[^ \"'=/\$]+$OFF" "$1"; }
    
    rep() { printf "$1%.0s" $(seq 1 "$2"); }
    printf 'plain\nhas \303\251 byte\n' >"$W/c-nonascii"
    printf 'x \033[31mred\033[m\017 y\n' >"$W/c-ctrl"
    printf 'x %s%s%s y\n' 'gh' 'p_' "$(rep a 24)" >"$W/c-live"
    printf 'x %s%s%s y\n' '/mnt/' 'c/' 'Users/' >"$W/c-pre"
    printf 'name.%s%s\n' 'xl' 'sx' >"$W/c-office"
    printf 'input=$KEEP/$test.in.%s%s\n' 'xl' 'sx' >"$W/c-office-expanded"
    printf 'plain ascii only\n' >"$W/c-clean"
    ctl "f_nonascii on a two-byte character" 2 f_nonascii "$W/c-nonascii"
    ctl "f_ctrl on ESC, ESC and SI" 3 f_ctrl "$W/c-ctrl"
    ctl "f_live on a token shape" 1 f_live "$W/c-live"
    ctl "f_pre on a bare path shape" 1 f_pre "$W/c-pre"
    ctl "f_office on an office file name" 1 f_office "$W/c-office"
    ctl "f_office_literal on the same literal name" 1 f_office_literal "$W/c-office"
    ctl "f_office on a name built from variables" 1 f_office "$W/c-office-expanded"
    ctl "f_office_literal on the same built name" 0 f_office_literal "$W/c-office-expanded"
    for f in f_nonascii f_ctrl f_live f_pre f_office f_office_literal; do
      ctl "$f on a clean file" 0 "$f" "$W/c-clean"
    done
    clean_source() {
      [ "$(f_nonascii "$1")" = 0 ] && [ "$(f_ctrl "$1")" = 0 ] &&
        [ "$(f_live "$1")" = 0 ] && [ "$(f_pre "$1")" = 0 ] && [ "$(f_office_literal "$1")" = 0 ]
    }
    
    git diff --name-only --diff-filter=A "$BASE" "$C" >"$W/added"
    echo "  files added in this phase: $(count_lines "$W/added")"
    nscored=0
    while IFS= read -r s; do
      git show "$C:$s" >"$W/a-at-head" 2>/dev/null || { echo "$s: READ ERROR"; fail=1; continue; }
      echo "$s (new in this phase):"
      echo "  non-ASCII bytes: $(f_nonascii "$W/a-at-head")"
      echo "  control bytes: $(f_ctrl "$W/a-at-head")"
      echo "  hits against all $(count_lines "$W/live-patterns") live privacy patterns: $(f_live "$W/a-at-head")"
      echo "  hits against the three pre-P6d bare forms: $(f_pre "$W/a-at-head")"
      echo "  lines with an office extension: $(f_office "$W/a-at-head"); of them a literal file name: $(f_office_literal "$W/a-at-head")"
      note "$s is clean on the five forms, office names counted as literals" "$(is clean_source "$W/a-at-head")"
      nscored=$((nscored + 1))
    done <"$W/added"
    
    echo
    echo "## the files this phase MODIFIED, scored by change rather than absolutely"
    git diff --name-only --diff-filter=M "$BASE" "$C" >"$W/modified"
    echo "  files modified in this phase: $(count_lines "$W/modified")"
    unchanged_by_this_phase() {
      [ "$added" = 0 ] && [ "$at_base" != error ] && [ "$at_head" != error ] &&
        [ "$at_base" = "$at_head" ]
    }
    while IFS= read -r M; do
      git show "$BASE:$M" >"$W/m-at-base" 2>/dev/null || { echo "$M: READ ERROR at base"; fail=1; continue; }
      git show "$C:$M" >"$W/m-at-head" 2>/dev/null || { echo "$M: READ ERROR at the phase commit"; fail=1; continue; }
      git diff -U0 "$BASE" "$C" -- "$M" |
        LC_ALL=C "$G" '^+' | LC_ALL=C "$G" -v '^+++' | sed 's/^+//' >"$W/m-added"
      echo "$M (modified in this phase):"
      echo "  added lines: $(count_lines "$W/m-added")"
      for form in f_nonascii f_ctrl f_live f_pre f_office_literal f_office; do
        at_base=$("$form" "$W/m-at-base")
        added=$("$form" "$W/m-added")
        at_head=$("$form" "$W/m-at-head")
        echo "  $form: at the base $at_base, in the added lines $added, at the phase commit $at_head"
        if [ "$form" = f_office ]; then
          # Printed only: a moved or rebuilt line can lower the count, and the
          # literal form above is the one held to "nothing new".
          continue
        fi
        note "$M: $form introduces nothing new in this phase" "$(is unchanged_by_this_phase)"
      done
      nscored=$((nscored + 1))
    done <"$W/modified"
    
    echo
    echo "## every file in the diff was scored"
    ndiff=$(count_lines "$W/difffiles")
    echo "  files in the diff: $ndiff; files scored as new or modified: $nscored"
    note "every file in the phase diff was scored" "$(is [ "$ndiff" = "$nscored" ])"
    
    echo
    echo "## the public fn and const first lines with the feature rules off and on (change E10; part 4b P1's change E7 and part 4a P4's D5, kept)"
    # The first line of every "pub fn" and "pub const" in crates/emend/src outside
    # the test files, leading space, "mut " before a parameter and a trailing brace
    # dropped, each beside the line before it when that line is an attribute
    # ("#[..."), else "-", sorted by the first line. With the feature rules off,
    # the lines whose attribute is the rules cfg are not compiled, so the off list
    # is the full list less those; the on list is all of them.
    pub_with_attrs() {
      local at=$1 f
      for f in $(git ls-tree -r --name-only "$at" -- crates/emend/src | LC_ALL=C "$G" -E '[.]rs$' | LC_ALL=C "$G" -vE '(/tests[.]rs|/testing[.]rs|/tests/)'); do
        git show "$at:$f" | awk '
          # Change D5, kept and widened by E7: an impl whose own attribute line is
          # a feature cfg gates every pub fn inside it with that line, up to the
          # impl'"'"'s closing brace at the margin.
          /^impl/ { gated = (prev ~ /^#\[cfg\(feature = "[a-z]+"\)\]$/) ? prev : "" }
          /^}/ { gated = "" }
          /^[[:space:]]*pub (fn|const) / {
            line = $0; sub(/^[[:space:]]*/, "", line); sub(/ [{]$/, "", line)
            gsub(/[(]mut /, "(", line); gsub(/, mut /, ", ", line)
            a = prev; sub(/^[[:space:]]*/, "", a)
            if (a !~ /^#\[/) a = (gated != "" ? gated : "-")
            print a "\t" line
          }
          { prev = $0 }'
      done | LC_ALL=C sort -t "$(printf '\t')" -k2
    }
    TAB=$(printf '\t')
    RULES_CFG='#[cfg(feature = "rules")]'
    META_CFG='#[cfg(feature = "metadata")]'
    ROWCOL_CFG='#[cfg(feature = "rowcol")]'
    echo "command: git show <commit>:<each crates/emend/src/*.rs outside the tests> | awk (a pub fn or pub const first line, beside the previous line when it is an attribute), sorted, at the base and at the phase commit"
    pub_with_attrs "$BASE" >"$W/pubattr-base"
    pub_with_attrs "$C" >"$W/pubattr-head"
    awk -F "$TAB" -v cfg="$RULES_CFG" '$1 != cfg' "$W/pubattr-head" >"$W/pubattr-off"
    echo "  at the phase commit with the feature rules OFF, every pub fn and pub const first line with its attribute:"
    sed 's/^/    /' "$W/pubattr-off"
    echo "  at the phase commit with the feature rules ON, the lines the off list lacks:"
    LC_ALL=C comm -13 <(LC_ALL=C sort "$W/pubattr-off") <(LC_ALL=C sort "$W/pubattr-head") | sed 's/^/    /'
    awk -F "$TAB" -v cfg="$RULES_CFG" '$1 != cfg' "$W/pubattr-base" | cut -f2 | LC_ALL=C sort >"$W/pub-base"
    cut -f2 "$W/pubattr-base" | LC_ALL=C sort >"$W/pub-base-on"
    cut -f2 "$W/pubattr-off" | LC_ALL=C sort >"$W/pub-off"
    cut -f2 "$W/pubattr-head" | LC_ALL=C sort >"$W/pub-on"
    echo "  pub first lines: at the base, feature rules off $(count_lines "$W/pub-base"), on $(count_lines "$W/pub-base-on"); at the phase commit, feature rules off $(count_lines "$W/pub-off"), feature rules on $(count_lines "$W/pub-on")"
    note "with the feature rules off the list is the base's with the feature off, line for line" "$(is cmp -s "$W/pub-base" "$W/pub-off")"
    LC_ALL=C comm -13 "$W/pub-off" "$W/pub-on" >"$W/pub-new"
    printf '%s\n' 'pub fn add_validation(' \
      'pub fn remove_validation(&mut self, part: &[u8], areas: &[Area]) -> Result<(), Error>' \
      'pub fn validations(&mut self, part: &[u8]) -> Result<Vec<ValidationEntry>, Error>' \
      'pub fn add_differential_style(&mut self, style: &Style) -> Result<u32, Error>' \
      'pub fn add_conditional_format(' \
      'pub fn remove_conditional_format(&mut self, part: &[u8], areas: &[Area]) -> Result<(), Error>' \
      'pub fn conditional_formats(&mut self, part: &[u8]) -> Result<Vec<RuleEntry>, Error>' |
      LC_ALL=C sort >"$W/pub-new-want"
    echo "  the lines the list with the feature rules on adds:"; sed 's/^/    /' "$W/pub-new"
    note "with the feature rules on the list adds exactly the seven calls the feature gates" "$(is cmp -s "$W/pub-new" "$W/pub-new-want")"
    LC_ALL=C comm -13 "$W/pub-base-on" "$W/pub-on" >"$W/pub-phase"
    echo "  the lines the phase adds to the base's list, both with the feature rules on:"; sed 's/^/    /' "$W/pub-phase"
    note "with the feature rules on the phase adds no pub fn or pub const to the base's list (change E10)" "$(is [ "$(count_lines "$W/pub-phase")" = 0 ])"
    note "with the feature rules on the list is the base's with it on, line for line" "$(is cmp -s "$W/pub-base-on" "$W/pub-on")"
    note "with the feature rules on the phase loses no line of the base's list" "$(is [ "$(LC_ALL=C comm -23 "$W/pub-base-on" "$W/pub-on" | count_lines /dev/stdin)" = 0 ])"
    LC_ALL=C comm -23 "$W/pub-off" "$W/pub-on" >"$W/pub-lost"
    note "with the feature on no line of the off list is lost" "$(is [ "$(count_lines "$W/pub-lost")" = 0 ])"
    gated_by() {
      awk -F "$TAB" -v cfg="$2" '$1 == cfg { print $2 }' "$1" |
        sed -E 's/^pub (fn|const) ([A-Za-z_0-9]+).*/\1 \2/' | LC_ALL=C sort
    }
    gated_by "$W/pubattr-head" "$RULES_CFG" >"$W/gated-rules"
    printf '%s\n' 'fn add_conditional_format' 'fn add_differential_style' 'fn add_validation' 'fn conditional_formats' 'fn remove_conditional_format' 'fn remove_validation' 'fn validations' | LC_ALL=C sort >"$W/gated-rules-want"
    echo "  the items whose attribute line, or whose impl's, is $RULES_CFG:"; sed 's/^/    /' "$W/gated-rules"
    note "exactly the seven calls carry the rules cfg line" "$(is cmp -s "$W/gated-rules" "$W/gated-rules-want")"
    gated_by "$W/pubattr-head" "$META_CFG" >"$W/gated-meta"
    gated_by "$W/pubattr-base" "$META_CFG" >"$W/gated-meta-base"
    echo "  the items whose attribute line, or whose impl's, is $META_CFG, at the phase commit:"; sed 's/^/    /' "$W/gated-meta"
    meta_same() { [ "$(count_lines "$W/gated-meta")" -ge 1 ] && cmp -s "$W/gated-meta" "$W/gated-meta-base"; }
    note "the metadata items are the base's, item for item, and there are some" "$(is meta_same)"
    gated_by "$W/pubattr-head" "$ROWCOL_CFG" >"$W/gated-rowcol"
    gated_by "$W/pubattr-base" "$ROWCOL_CFG" >"$W/gated-rowcol-base"
    printf '%s\n' 'const PIVOT_TABLE' 'const TABLE' 'fn delete_columns' 'fn delete_rows' 'fn insert_columns' 'fn insert_rows' >"$W/gated-rowcol-want"
    echo "  the items whose attribute line is $ROWCOL_CFG, at the phase commit:"; sed 's/^/    /' "$W/gated-rowcol"
    note "the six rowcol items keep their cfg line at the phase commit" "$(is cmp -s "$W/gated-rowcol" "$W/gated-rowcol-want")"
    note "and carried it at the base" "$(is cmp -s "$W/gated-rowcol-base" "$W/gated-rowcol-want")"
    sed '1d' "$W/pub-new-want" >"$W/c-pub-short"
    note "control: the comparison refuses a list one call short" "$(isnot cmp -s "$W/pub-new" "$W/c-pub-short")"
    awk -F "$TAB" -v cfg="$META_CFG" '$1 != cfg' "$W/pubattr-head" | cut -f2 | LC_ALL=C sort >"$W/c-pub-off-wrong"
    note "control: dropping the metadata lines instead gives a list that is not the base's with the feature off" "$(isnot cmp -s "$W/pub-base" "$W/c-pub-off-wrong")"
    printf '%s\n' "    $RULES_CFG" '    pub fn x(&self) {' '    /// doc' '    pub const Y: u8 = 1;' >"$W/c-attr.rs"
    c_attr() {
      awk '
        /^[[:space:]]*pub (fn|const) / { a = prev; sub(/^[[:space:]]*/, "", a); if (a !~ /^#\[/) a = "-"; print a }
        { prev = $0 }' "$W/c-attr.rs" | tr '\n' '|'
    }
    c_attr_ok() { [ "$(c_attr)" = "$RULES_CFG|-|" ]; }
    note "control: the attribute reader pairs a cfg line with the fn after it and a doc line with '-'" "$(is c_attr_ok)"
    # Change D5's control, widened by E7: the reader itself, over a fixture with
    # a gated impl and an ungated one, gives the pub fn inside the gated impl the
    # cfg line.
    printf '%s\n' "$RULES_CFG" 'impl A {' '    /// doc' '    pub fn inside(&self) {}' '}' 'impl B {' '    /// doc' '    pub fn outside(&self) {}' '}' >"$W/c-impl.rs"
    c_impl() {
      awk '
        /^impl/ { gated = (prev ~ /^#\[cfg\(feature = "[a-z]+"\)\]$/) ? prev : "" }
        /^}/ { gated = "" }
        /^[[:space:]]*pub (fn|const) / { a = prev; sub(/^[[:space:]]*/, "", a); if (a !~ /^#\[/) a = (gated != "" ? gated : "-"); print a }
        { prev = $0 }' "$W/c-impl.rs" | tr '\n' '|'
    }
    c_impl_ok() { [ "$(c_impl)" = "$RULES_CFG|-|" ]; }
    note "control: the reader gives a pub fn in a gated impl the cfg line and one in an ungated impl '-' (change D5)" "$(is c_impl_ok)"
    nunsafe=$(git grep -c -w -e unsafe "$C" -- crates/emend/src | awk -F: '{ n += $NF } END { print n + 0 }')
    nforbid=$(git show "$C:crates/emend/src/lib.rs" | count_matches -Fx '#![forbid(unsafe_code)]' /dev/stdin)
    echo "  lines holding the word unsafe under crates/emend/src at the phase commit: $nunsafe; lib.rs's forbid line: $nforbid"
    note "lib.rs still forbids unsafe code" "$(is [ "$nforbid" = 1 ])"
    
    echo
    echo "## the base's tests, unedited, shown line by line (change F6, kept; change F10)"
    git diff --name-only "$BASE" "$C" | LC_ALL=C "$G" -E '(/tests[.]rs|/tests/|^tools/.*/tests/)' >"$W/test-files" || :
    sed 's/^/    test file changed: /' "$W/test-files"
    # test_bodies <commit> <file>: "<name>\t<body with each line joined by a
    # form feed>" per #[test] fn, the body from the fn line to the first line
    # that is a closing brace at the left margin.
    test_bodies() {
      python3 - "$1" "$2" <<'BODIES'
    import re, subprocess, sys
    at, path = sys.argv[1:3]
    if subprocess.run(["git", "cat-file", "-e", at + "^{commit}"], capture_output=True).returncode != 0:
        sys.exit("no such commit")
    if subprocess.run(["git", "cat-file", "-e", f"{at}:{path}"], capture_output=True).returncode != 0:
        sys.exit(0)
    text = subprocess.run(["git", "show", f"{at}:{path}"], capture_output=True, text=True,
                          check=True).stdout.split("\n")
    i = 0
    while i < len(text):
        if text[i].strip() == "#[test]":
            j = i + 1
            while j < len(text) and not re.match(r"^\s*fn ", text[j]):
                j += 1
            if j >= len(text):
                break
            name = re.match(r"^\s*fn ([a-z0-9_]+)", text[j]).group(1)
            k = j
            while k < len(text) and text[k] != "}":
                k += 1
            print(name + "\t" + "\f".join(text[j:k + 1]))
            i = k
        i += 1
    BODIES
    }
    # added_in <base bodies> <head bodies> <file>: per base test, "gone", or one
    # line "<file> <test> - <line, stripped>" per line removed from its body and
    # "<file> <test> + <line, stripped>" per line added, by a line diff of the
    # body at the base against the body now (change I4).
    added_in() {
      python3 - "$1" "$2" "$3" <<'ADDED'
    import difflib, sys
    base = dict(l.rstrip("\n").split("\t", 1) for l in open(sys.argv[1]) if l.strip())
    head = dict(l.rstrip("\n").split("\t", 1) for l in open(sys.argv[2]) if l.strip())
    for name, body in sorted(base.items()):
        if name not in head:
            print("%s %s gone" % (sys.argv[3], name))
            continue
        old, new = body.split("\f"), head[name].split("\f")
        for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
            if tag in ("replace", "delete"):
                for line in old[i1:i2]:
                    print("%s %s - %s" % (sys.argv[3], name, line.strip()))
            if tag in ("replace", "insert"):
                for line in new[j1:j2]:
                    print("%s %s + %s" % (sys.argv[3], name, line.strip()))
    ADDED
    }
    : >"$W/tests-edited"; tb_fail=0
    nbase_tests=0
    while IFS= read -r tf; do
      test_bodies "$BASE" "$tf" >"$W/tb-base" || tb_fail=1
      test_bodies "$C" "$tf" >"$W/tb-head" || tb_fail=1
      nbase_tests=$((nbase_tests + $(count_lines "$W/tb-base")))
      added_in "$W/tb-base" "$W/tb-head" "$tf" >>"$W/tests-edited" || tb_fail=1
    done <"$W/test-files"
    echo "command: every #[test] fn of the base in each changed test file, read at the base and at the phase commit; the lines removed from it and added to it, by a line diff, and any gone"
    echo "  base tests read in the changed files: $nbase_tests"
    sed 's/^/    /' "$W/tests-edited"
    LC_ALL=C sort "$W/tests-edited" >"$W/tests-edited-sorted"
    # Change F10: no test of the base is edited or gone; the carry adds a test
    # alone.
    ngone=$(count_matches -E ' gone$' "$W/tests-edited")
    nedit=$(count_lines "$W/tests-edited")
    note "every test of the base and the phase commit was read, none failing" "$(is [ "$tb_fail" = 0 ])"
    note "some base tests were read" "$(is [ "$nbase_tests" -ge 1 ])"
    note "no test of the base is gone ($ngone)" "$(is [ "$ngone" = 0 ])"
    note "no test of the base is edited ($nedit lines of edit)" "$(is [ "$nedit" = 0 ])"
    printf '%s\n' 'x.rs t gone' >"$W/c-edited"
    ctl "a gone test in a list, same command form" 1 count_matches -E ' gone$' "$W/c-edited"
    printf '%s\n' 'x.rs t + let x = 1;' 'x.rs t - let x = 2;' >"$W/c-edited-lines"
    ctl "two edit lines in a list, same command form" 2 count_lines "$W/c-edited-lines"
    # package/tests.rs: the phase does not change it (change F10).
    PKG_TESTS=crates/emend/src/package/tests.rs
    git diff -U0 "$BASE" "$C" -- "$PKG_TESTS" | LC_ALL=C "$G" -E '^[-+]' | LC_ALL=C "$G" -vE '^(\+\+\+|---) ' >"$W/pkg-tests-lines"
    echo "command: git diff -U0 <base> <phase commit> -- $PKG_TESTS (the added and removed lines)"
    sed 's/^/    /' "$W/pkg-tests-lines"
    : >"$W/pkg-tests-want"
    note "package/tests.rs gains and loses no line in this phase" "$(is cmp -s "$W/pkg-tests-lines" "$W/pkg-tests-want")"
    gated_line_before() {
      git show "$C:$PKG_TESTS" | awk '
        /^fn a_local_sheet_id_that_is_not_a_number_refuses_a_move_at_the_write[(]/ { print p2 "|" p1; exit }
        { p2 = p1; p1 = $0 }'
    }
    echo "  the two lines before part 1's test's fn line at the phase commit: $(gated_line_before)"
    gated_ok() { [ "$(gated_line_before)" = '#[cfg(not(feature = "metadata"))]|#[test]' ]; }
    note "part 1's test at the write is still gated to the feature off" "$(is gated_ok)"
    printf '+mod x;\n' >"$W/c-pkg-tests"
    note "control: the comparison refuses a list holding one added line" "$(isnot cmp -s "$W/pkg-tests-lines" "$W/c-pkg-tests")"
    
    echo
    echo "## full run on a cold cache, started from / by absolute path"
    echo "command: cargo clean"
    RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never cargo clean 2>&1 | sed 's/^/    /'
    GATE=$MAIN/scripts/check.sh
    echo "command: (cd / && <repo>/scripts/check.sh)"
    ( cd / && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4 "$GATE" ) >"$W/gate.out" 2>"$W/gate.err"
    grc=$?
    sed 's/^/    /' "$W/gate.out"
    echo "exit: $grc; stderr bytes: $(wc -c <"$W/gate.err")"
    npass=$(count_matches -E '^PASS ' "$W/gate.out")
    ndoc_step=$(count_matches -E '^PASS doc$' "$W/gate.out")
    note "the gate exits 0" "$(is [ "$grc" -eq 0 ])"
    note "nine PASS lines" "$(is [ "$npass" = 9 ])"
    note "the doc step is one of them, by name" "$(is [ "$ndoc_step" = 1 ])"
    note "stderr is empty" "$(is [ "$(wc -c <"$W/gate.err")" -eq 0 ])"
    
    echo
    echo "## the binaries the gate built, both targets"
    bins_ok=yes
    for b in "$CARGO_TARGET_DIR"/debug/emend-copy "$CARGO_TARGET_DIR"/debug/xlsx-diff \
             "$CARGO_TARGET_DIR"/i686-unknown-linux-musl/debug/emend-copy \
             "$CARGO_TARGET_DIR"/i686-unknown-linux-musl/debug/xlsx-diff; do
      if [ -x "$b" ]; then
        echo "  $b: sha256 $(sha256sum <"$b" | cut -d' ' -f1), bytes $(wc -c <"$b")"
      else
        echo "  $b: MISSING or not executable"
        bins_ok=no
      fi
    done
    note "the gate left all four binaries, both targets, executable" "$(is [ "$bins_ok" = yes ])"
    
    echo
    echo "## clippy and doc with the feature off and on, and clippy over the probe crate's feature sets (change H4, kept; changes G6 and G10)"
    FEAT_TARGET=$BUILD_ROOT/feature-target
    PROBE_TARGET=$BUILD_ROOT/probe-target
    diag_lines() { count_matches -E '^(warning|error)(\[|:)' "$1"; }
    lint_clean() { [ "$1" = 0 ] && [ "$2" = 0 ]; }
    lint_run() {
      local label=$1 dir=$2 rc n
      shift 2
      echo "command: ${LINT_SHOWN}"
      ( cd "$MAIN" && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4 CARGO_TARGET_DIR=$dir "$@" ) >"$W/lint.out" 2>&1
      rc=$?
      n=$(diag_lines "$W/lint.out")
      LC_ALL=C "$G" -a -E '^(warning|error)(\[|:)' "$W/lint.out" | sed 's/^/    /'
      echo "  $label: exit $rc; warning or error lines $n"
      note "$label is clean: exit 0 and no warning or error line" "$(is lint_clean "$rc" "$n")"
    }
    LINT_SHOWN="CARGO_TARGET_DIR=<build>/feature-target cargo clippy -p emend --all-targets -- -D warnings"
    lint_run "clippy, the crate, feature off" "$FEAT_TARGET" cargo clippy -p emend --all-targets -- -D warnings
    LINT_SHOWN="CARGO_TARGET_DIR=<build>/feature-target cargo clippy -p emend --all-targets --features rules -- -D warnings"
    lint_run "clippy, the crate, rules on" "$FEAT_TARGET" cargo clippy -p emend --all-targets --features rules -- -D warnings
    LINT_SHOWN="CARGO_TARGET_DIR=<build>/feature-target cargo clippy -p emend --all-targets --all-features -- -D warnings"
    lint_run "clippy, the crate, every feature on" "$FEAT_TARGET" cargo clippy -p emend --all-targets --all-features -- -D warnings
    LINT_SHOWN="RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR=<build>/feature-target cargo doc -p emend --no-deps"
    lint_run "doc, the crate, feature off" "$FEAT_TARGET" env RUSTDOCFLAGS='-D warnings' cargo doc -p emend --no-deps
    LINT_SHOWN="RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR=<build>/feature-target cargo doc -p emend --no-deps --features rules"
    lint_run "doc, the crate, rules on" "$FEAT_TARGET" env RUSTDOCFLAGS='-D warnings' cargo doc -p emend --no-deps --features rules
    LINT_SHOWN="RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR=<build>/feature-target cargo doc -p emend --no-deps --all-features"
    lint_run "doc, the crate, every feature on" "$FEAT_TARGET" env RUSTDOCFLAGS='-D warnings' cargo doc -p emend --no-deps --all-features
    for pf in emend,xml dates rowcol metadata rules; do
      LINT_SHOWN="CARGO_TARGET_DIR=<build>/probe-target cargo clippy -p size-probe --all-targets --features $pf -- -D warnings"
      lint_run "clippy, the probe crate, features $pf" "$PROBE_TARGET" cargo clippy -p size-probe --all-targets --features "$pf" -- -D warnings
    done
    printf 'warning: unused variable: `x`\nerror[E0425]: cannot find value\n    Checking emend v0.1.0\nnote: warning is not at the start\n' >"$W/c-diag"
    ctl "diag_lines over two diagnostics and two other lines, same command form" 2 diag_lines "$W/c-diag"
    
    echo
    echo "## the crate's tests with the feature rules off and on, both targets (change G10)"
    # The workspace build above turns `rules` on through the tool's dependency
    # (features unify across the workspace), so the crate alone is built here with
    # the feature off and on, into its own target directory.
    passed_sum() { awk '/^test result: /{ for (i = 1; i <= NF; i++) if ($(i + 1) ~ /^passed;?$/) n += $i } END { print n + 0 }' "$1"; }
    failed_sum() { awk '/^test result: /{ for (i = 1; i <= NF; i++) if ($(i + 1) ~ /^failed;?$/) n += $i } END { print n + 0 }' "$1"; }
    ran_clean() { [ "$1" = 0 ] && [ "$2" = 0 ] && [ "$3" -gt 0 ]; }
    for target in host i686; do
      for feat in off on; do
        args=(test -p emend)
        [ "$target" = i686 ] && args+=(--target i686-unknown-linux-musl)
        [ "$feat" = on ] && args+=(--features rules)
        echo "command: CARGO_TARGET_DIR=<build>/feature-target cargo ${args[*]}"
        ( cd "$MAIN" && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4 CARGO_TARGET_DIR=$FEAT_TARGET cargo "${args[@]}" ) >"$W/t-$target-$feat.out" 2>"$W/t-$target-$feat.err"
        rc=$?
        LC_ALL=C "$G" -a -E '^test result: ' "$W/t-$target-$feat.out" | sed 's/^/    /'
        p=$(passed_sum "$W/t-$target-$feat.out"); fl=$(failed_sum "$W/t-$target-$feat.out")
        echo "  $target, feature $feat: exit $rc; passed $p; failed $fl"
        printf -v "P_${target}_${feat}" '%s' "$p"
        note "the crate's tests pass on $target with the feature $feat, some run and none failed" "$(is ran_clean "$rc" "$fl" "$p")"
      done
    done
    echo "  passed: host off $P_host_off, host on $P_host_on, i686 off $P_i686_off, i686 on $P_i686_on"
    note "with the feature on more tests run than with it off, on the host" "$(is [ "$P_host_on" -gt "$P_host_off" ])"
    note "with the feature on more tests run than with it off, on i686" "$(is [ "$P_i686_on" -gt "$P_i686_off" ])"
    note "the host and i686 run the same tests with the feature off" "$(is [ "$P_host_off" = "$P_i686_off" ])"
    note "the host and i686 run the same tests with the feature on" "$(is [ "$P_host_on" = "$P_i686_on" ])"
    printf 'test result: ok. 7 passed; 1 failed; 2 ignored; 0 measured; 0 filtered out\ntest result: ok. 3 passed; 0 failed; 0 ignored\n' >"$W/c-results"
    ctl "passed_sum over two result lines, same command form" 10 passed_sum "$W/c-results"
    ctl "failed_sum over the same lines, same command form" 1 failed_sum "$W/c-results"
    
    echo
    echo "## the consumer crate naming the seventeen items rules gates, feature off and on (part 4a P1's change G3, kept; change E10)"
    CONSUMER=$BUILD_ROOT/consumer
    rm -rf "$CONSUMER" "$BUILD_ROOT/consumer-target"
    mkdir -p "$CONSUMER/src" || fail=1
    {
      printf '[package]\nname = "rules-consumer"\nversion = "0.0.0"\nedition = "2024"\npublish = false\n\n'
      printf '[workspace]\n\n[dependencies]\nemend = { path = "%s" }\n\n' "$MAIN/crates/emend"
      printf '[features]\nrules = ["emend/rules"]\n'
    } >"$CONSUMER/Cargo.toml"
    cat >"$CONSUMER/src/lib.rs" <<'CONSUMER'
    //! Names, each once, the seven calls and the ten types that the feature
    //! `rules` gates (specs/0020-validation-and-conditional-formatting.md, P1 to
    //! P3).
    use std::io::Cursor;
    
    #[allow(clippy::too_many_arguments)]
    pub fn rules(
        p: &mut emend::package::Package<Cursor<Vec<u8>>>,
        v: emend::Validation<'_>,
        e: &emend::ValidationEntry,
        k: emend::ValidationKind,
        o: emend::Operator,
        s: emend::ErrorStyle,
        r: emend::Rule<'_>,
        n: &emend::RuleEntry,
        style: &emend::Style,
        c: emend::Cfvo<'_>,
        ck: emend::CfvoKind<'_>,
        ik: emend::IconSetKind,
    ) -> usize {
        let _ = (e, k, o, s, n, c, ck, ik);
        let _ = p.add_validation(b"x", &[], v);
        let _ = p.remove_validation(b"x", &[]);
        let _ = p.add_differential_style(style);
        let _ = p.add_conditional_format(b"x", &[], r, None, None, false);
        let _ = p.remove_conditional_format(b"x", &[]);
        let _ = p.conditional_formats(b"x");
        p.validations(b"x").map_or(0, |list| list.len())
    }
    CONSUMER
    # The workspace's lock, so the check resolves offline to the versions the
    # workspace pins.
    cp "$MAIN/Cargo.lock" "$CONSUMER/Cargo.lock" || fail=1
    echo "  <build>/consumer/Cargo.toml:"; sed 's/^/    /' "$CONSUMER/Cargo.toml"
    echo "  <build>/consumer/src/lib.rs:"; sed 's/^/    /' "$CONSUMER/src/lib.rs"
    for feat in off on; do
      args=(check --offline --message-format short)
      [ "$feat" = on ] && args+=(--features rules)
      echo "command: (cd <build>/consumer && CARGO_TARGET_DIR=<build>/consumer-target cargo ${args[*]})"
      ( cd "$CONSUMER" && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_TARGET_DIR=$BUILD_ROOT/consumer-target cargo "${args[@]}" ) >"$W/k-$feat.out" 2>&1
      printf -v "K_RC_$feat" '%s' "$?"
      LC_ALL=C "$G" -a -E '(error|warning)' "$W/k-$feat.out" | sed 's/^/    /'
    done
    nerr_off=$(count_matches -E 'error\[E[0-9]+\]' "$W/k-off.out")
    nerr_on=$(count_matches -E 'error' "$W/k-on.out")
    echo "  feature off: exit $K_RC_off, error lines with a code $nerr_off; feature on: exit $K_RC_on, lines naming an error $nerr_on"
    CONSUMER_ITEMS='add_validation remove_validation validations add_differential_style add_conditional_format remove_conditional_format conditional_formats Validation ValidationEntry ValidationKind Operator ErrorStyle Rule RuleEntry Cfvo CfvoKind IconSetKind'
    names_each_once() {
      local item n
      for item in $CONSUMER_ITEMS; do
        n=$(LC_ALL=C "$G" -E 'error\[E[0-9]+\]' "$1" | count_matches -F "\`$item\`" /dev/stdin)
        [ "$n" = 1 ] || return 1
      done
    }
    nitems=$(printf '%s\n' $CONSUMER_ITEMS | count_lines /dev/stdin)
    for item in $CONSUMER_ITEMS; do
      echo "  error lines naming \`$item\` with the feature off: $(LC_ALL=C "$G" -E 'error\[E[0-9]+\]' "$W/k-off.out" | count_matches -F "\`$item\`" /dev/stdin)"
    done
    note "with the feature off cargo check fails" "$(isnot [ "$K_RC_off" = 0 ])"
    note "with the feature off there is one error line per item named ($nitems)" "$(is [ "$nerr_off" = "$nitems" ])"
    note "with the feature off each item is named by exactly one error line" "$(is names_each_once "$W/k-off.out")"
    note "control: with the feature on cargo check passes" "$(is [ "$K_RC_on" = 0 ])"
    note "control: with the feature on no line names an error" "$(is [ "$nerr_on" = 0 ])"
    printf 'src/lib.rs:6:15: error[E0599]: no method named `add_validation` found\n' >"$W/c-k"
    note "control: names_each_once refuses output naming one item of the list" "$(isnot names_each_once "$W/c-k")"
    
    echo
    echo "## status after the run, the lines printed (change K4)"
    # run_lines and run_matches read the command's own exit status. Planning's
    # rulings during P4, if any, sit in specs/0020 in the working tree,
    # uncommitted; that path is named and allowed, and nothing else may differ but
    # this phase's logs, its run records, its open-check records and its size
    # record, by their stems (change H10).
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_untracked_log=$(run_matches -E '^[?][?] records/logs/m2p4b-p4' git status --porcelain)
    st_tracked_log=$(run_matches -E '^ ?[MARCD] records/logs/m2p4b-p4' git status --porcelain)
    st_record=$(run_matches -E '^(\?\?| ?[MARCD]) records/m2p4b-p4-' git status --porcelain)
    st_size=$(run_matches -E '^(\?\?| ?[MARCD]) records/size-m2p4b-' git status --porcelain)
    st_open=$(run_matches -E '^(\?\?| ?[MARCD]) records/m2p4b-open-' git status --porcelain)
    st_planning=$(run_matches -E '^ M specs/0020-validation-and-conditional-formatting[.]md$' git status --porcelain)
    echo "status lines: $st_all; untracked under the log directory: $st_untracked_log; tracked and modified under it: $st_tracked_log; the phase's run records: $st_record; the open-check records: $st_open; the size record: $st_size; planning's spec modified and uncommitted: $st_planning"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_untracked_log" != error ] &&
        [ "$st_tracked_log" != error ] && [ "$st_record" != error ] &&
        [ "$st_open" != error ] && [ "$st_size" != error ] && [ "$st_planning" != error ] &&
        [ "$st_all" = "$((st_untracked_log + st_tracked_log + st_record + st_open + st_size + st_planning))" ]
    }
    note "every change in the working tree is one of this phase's logs, its records (run, open-check and size) or planning's uncommitted spec" "$(is status_accounted)"
    printf '?? records/m2p4b-open-2026-01-01-abcdef0.md\n M scripts/check.sh\n' >"$W/c-status"
    ctl "the open-check stem in a status listing, same pattern" 1 count_matches -E '^(\?\?| ?[MARCD]) records/m2p4b-open-' "$W/c-status"
    printf ' M specs/0020-validation-and-conditional-formatting.md\n M specs/0019-names-links-properties-protection.md\n' >"$W/c-spec"
    ctl "planning's spec in a status listing, same pattern" 1 count_matches -E '^ M specs/0020-validation-and-conditional-formatting[.]md$' "$W/c-spec"
    printf '?? records/m2p4b-p4-cf-2026-01-01-abcdef0.md\n?? records/m2p4b-p3-x.md\n?? records/m2p4b-p2-x.md\n' >"$W/c-rec"
    ctl "the phase's record stem in a listing of three, same pattern" 1 count_matches -E '^(\?\?| ?[MARCD]) records/m2p4b-p4-' "$W/c-rec"
    printf '?? records/size-m2p4b-2026-01-01-abcdef0.md\n?? records/size-m2p4a-2026-01-01-abcdef0.md\n' >"$W/c-size"
    ctl "the size record's stem in a listing of two, same pattern" 1 count_matches -E '^(\?\?| ?[MARCD]) records/size-m2p4b-' "$W/c-size"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$W/c-err"; printf 'x' >>"$W/c-err"
    nerr_ctl=$(wc -c <"$W/c-err")
    echo "  command: wc -c <phase>/out/gate.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    note "this script wrote nothing to its standard error" "$(is [ "$nerr" = 0 ])"
    note "control: the same count reads one byte more in the copy" "$(is [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "gate log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

