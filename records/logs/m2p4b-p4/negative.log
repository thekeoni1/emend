### the messages, read from the phase commit's source by constant name (change BB)
    """The Error::Package messages of a package.rs, by constant name, one per
    line as NAME<TAB>message in source order. With --part, only the block from
    NO_AREA to RULE_UNPARSED, the fifteen messages of part 4b (specs/0020,
    "Errors").
    Usage: messages.py <package.rs> [--part]."""
    import re
    import sys
    
    text = open(sys.argv[1]).read()
    found = re.findall(r'^const ([A-Z_0-9]+): Error =\s*Error::Package\(\s*"([^"]*)",?\s*\);', text, re.M)
    if "--part" in sys.argv:
        names = [n for n, _ in found]
        a, b = names.index("NO_AREA"), names.index("RULE_UNPARSED")
        found = found[a:b + 1]
    for n, m in found:
        print("%s\t%s" % (n, m))
