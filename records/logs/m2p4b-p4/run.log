    """The run log's own visual rule comparison (specs/0020-validation-and-
    conditional-formatting.md, "Harness runs", --scale-sample and P3, with P2
    ruling 5 and P3 ruling 1).
    
    Usage: scalecmp.py <input archive> <output archive> [--plant <flag>]
           scalecmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool. It finds the workbook part through the package
    relationship; W, the first <sheet> in <sheets> order whose relationship type
    is a worksheet's, and its part; the styles part through the workbook's
    styles relationship; M, the largest row number of a <c> in W's sheetData
    elements (0 when there is none), N = M + 1; and H, the highest priority of a
    main-namespace cfRule of a main-namespace conditionalFormatting root child
    of W (0 when there is none). From the input it builds, by the design's
    rules, what the output must hold, and compares:
    
      rest_same    W with every main-namespace root child named
                   conditionalFormatting cut out is the input's, byte for byte
      cf_prefix    the input's conditionalFormatting elements, in order, are a
                   byte-identical prefix of the output's
      added_bytes  after that prefix come exactly three, byte for byte the ones
                   this program builds with W's root prefix: a colour scale from
                   min in 00F8696B to max in 0063BE7B on A<N>:A<N+2> with
                   priority H + 1, a data bar from min to max in 00638EC6 on
                   B<N>:B<N+2> with priority H + 2, and a 3Arrows icon set of 0,
                   33 and 67 percent on C<N>:C<N+2> with priority H + 3, no dxfId
      added_tags   read with ElementTree, those three carry exactly those
                   attributes, one cfRule each with no formula and one child
                   holding those cfvo and color elements
      cf_place     the three added elements are adjacent and end exactly where
                   the first main child that the worksheet table puts after
                   conditionalFormatting starts, or at the root's end tag (P2
                   ruling 5), this program's own copy of the table
      root_order   the output's main root children's names are the input's with
                   three conditionalFormatting inserted before that child
      cf_read      read with ElementTree, the output's conditional formats (sqref,
                   each rule's attributes, formula texts and visual child) are
                   the input's followed by the three added ones
      styles_same  the styles part is the input's, byte for byte
    
    It prints ONE line of counts and yes/no flags and no formula, colour, text,
    reference, sheet name or part name. --parts prints W's part name and the
    styles part's, one per line, for the log to compare with the runner's rows
    without printing them. --plant <flag> changes the output as read so that the
    named flag turns to no; the line then says planted=yes, or planted=no when
    the pair gives the plant nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    # ECMA-376 Part 1, 18.3.1.99, the worksheet root's children in order: this
    # program's own copy (specs/0018, "Creating an element"), not the crate's.
    TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    assert len(TABLE) == 39
    
    FLAGS = ("rest_same", "cf_prefix", "added_bytes", "added_tags", "cf_place", "root_order",
             "cf_read", "styles_same")
    
    COMMENT = b"<!-- planted -->"
    CF = "conditionalFormatting"
    # The rule kinds the tool's line counts as visual.
    VISUAL = ("colorScale", "dataBar", "iconSet")
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def pick_w(z, workbook):
        """W's part, or None."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty.endswith("/worksheet"):
                    return target
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def inner(raw):
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return len(tag), len(tag)
        return len(tag), raw.rfind(b"</")
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def with_attr(tag, name, value):
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def children(data, a, b, rp, root_ns):
        """[(start, end, main local name or None)] of the root's children. A
        child is main when its prefix is the root's (the root is main) or when
        it declares the main namespace as its own default or prefix."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            p, n = split_name(qname(raw))
            tag = start_tag(raw)
            decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
            own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
            if own:
                main = own.group(1)[1:-1].decode() in MAIN
            else:
                main = p == rp and root_ns in MAIN
            out.append((a + x, a + y, n if main else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def attr_escaped(text):
        """The layer's attribute escape: the five, and tab, line feed and
        carriage return as character references."""
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace("'", "&apos;").replace('"', "&quot;").replace("\t", "&#9;")
                .replace("\n", "&#10;").replace("\r", "&#13;")).encode()
    
    
    def text_escaped(text):
        """An element text's escape: ampersand and the two angle brackets."""
        return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").encode()
    
    
    def styles_of(z, workbook):
        """The styles part's name, or None."""
        for (_, ty, t) in rels_of(z, workbook):
            if ty.endswith("/styles"):
                return t
        return None
    
    
    def m_of(data):
        """The largest row number of a <c> in every main sheetData root child."""
        m = 0
        for sd in ET.fromstring(data):
            ns, name = local(sd.tag)
            if ns not in MAIN or name != "sheetData":
                continue
            for row in sd:
                for c in row:
                    cns, cname = local(c.tag)
                    if cns in MAIN and cname == "c":
                        got = re.match(r"^\$?[A-Z]+\$?([0-9]+)$", c.get("r", ""))
                        if got:
                            m = max(m, int(got.group(1)))
        return m
    
    
    
    
    def signature(el):
