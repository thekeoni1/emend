    """The run log's own conditional format comparison (specs/0020-validation-
    and-conditional-formatting.md, "Harness runs", --cf-sample and P2, with P2
    rulings 3 and 5).
    
    Usage: cfcmp.py <input archive> <output archive> [--plant <flag>]
           cfcmp.py --self-test
           cfcmp.py --tag-test [--plant-p2]
           cfcmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool. It finds the workbook part through the package
    relationship; W, the first <sheet> in <sheets> order whose relationship type
    is a worksheet's, and its part; the styles part through the workbook's
    styles relationship; M, the largest row number of a <c> in W's sheetData
    elements (0 when there is none), N = M + 1; H, the highest priority of a
    main-namespace cfRule of a main-namespace conditionalFormatting root child
    of W (0 when there is none); and D, the dxf children of the styles part's
    first main-namespace dxfs root child (0 when there is none). From the input
    it builds, by the design's rules, what the output must hold, and compares:
    
      rest_same    W with every main-namespace root child named
                   conditionalFormatting cut out is the input's, byte for byte
      cf_prefix    the input's conditionalFormatting elements, in order, are a
                   byte-identical prefix of the output's
      added_bytes  after that prefix come exactly two, byte for byte the ones
                   this program builds with W's root prefix: cellIs greaterThan
                   5 on A<N>:C<N> with dxfId D and priority H + 1, and expression
                   TRUE with stopIfTrue on A<N+1> with dxfId D and priority H + 2
      added_tags   read with ElementTree, those two carry exactly those
                   attributes and formula texts, one cfRule each
      cf_place     the two added elements are adjacent and end exactly where the
                   first main child that the worksheet table puts after
                   conditionalFormatting starts, or at the root's end tag (P2
                   ruling 5), this program's own copy of the table
      root_order   the output's main root children's names are the input's with
                   two conditionalFormatting inserted before that child
      cf_read      read with ElementTree, the output's conditional formats (sqref,
                   each rule's attributes and formula texts) are the input's
                   followed by the two added ones
      styles_rest  the styles part with its main dxfs root child cut out is the
                   input's, byte for byte; or, a FINDING the line reports
                   (corrected=...), the input's with the count of numFmts, fonts,
                   fills, borders or cellXfs set to its children as every styles
                   rewrite does (P2 ruling 3)
      dxfs_tag     the output dxfs start tag is the input's with its count
                   replaced by D + 1 when it has one and left without one when
                   it has none (part 2's rule for every styles container, P4
                   ruling 1), opened up when it was empty, every other byte
                   kept; or, when the input had none, <P:dxfs count="1"> with
                   the styles root's prefix; its end tag is of the same name.
                   --tag-test is its control
      dxf_prefix   the input dxfs content is a byte-identical prefix of the
                   output's; trivially so when the input had none
      dxf_bytes    after that prefix comes exactly one dxf, byte for byte the
                   one this program builds with the container's prefix
      dxfs_count   read with ElementTree, the output dxfs count is the number of
                   its dxf children, or absent when the input dxfs had none (P4
                   ruling 1)
      dxfs_place   an existing dxfs keeps its place among the main children; a
                   created one ends exactly where the first main tableStyles,
                   colors or extLst starts, or at the root's end tag
      one_dxfs     the output styles part has exactly one main dxfs root child
    
    It prints ONE line of counts and yes/no flags and no formula, colour, text,
    reference, sheet name or part name. --parts prints W's part name and the
    styles part's, one per line, for the log to compare with the runner's rows
    without printing them. --plant <flag> changes the output as read so that the
    named flag turns to no; the line then says planted=yes, or planted=no when
    the pair gives the plant nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    # ECMA-376 Part 1, 18.3.1.99, the worksheet root's children in order: this
    # program's own copy (specs/0018, "Creating an element"), not the crate's.
    TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    assert len(TABLE) == 39
    
    FLAGS = ("rest_same", "cf_prefix", "added_bytes", "added_tags", "cf_place", "root_order",
             "cf_read", "styles_rest", "dxfs_tag", "dxf_prefix", "dxf_bytes", "dxfs_count",
             "dxfs_place", "one_dxfs")
    
    COMMENT = b"<!-- planted -->"
    CF = "conditionalFormatting"
    DXFS = "dxfs"
    # The styles root's children before the first of which a created dxfs goes
    # (ECMA-376 Part 1, 18.8.39; "Differential styles").
    DXFS_BEFORE = ("tableStyles", "colors", "extLst")
    # The five containers every styles rewrite recounts (P2 ruling 3), with the
    # child each counts.
    RECOUNTED = (("numFmts", "numFmt"), ("fonts", "font"), ("fills", "fill"),
                 ("borders", "border"), ("cellXfs", "xf"))
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def pick_w(z, workbook):
        """W's part, or None."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty.endswith("/worksheet"):
                    return target
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def inner(raw):
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return len(tag), len(tag)
        return len(tag), raw.rfind(b"</")
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def with_attr(tag, name, value):
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def children(data, a, b, rp, root_ns):
        """[(start, end, main local name or None)] of the root's children. A
        child is main when its prefix is the root's (the root is main) or when
        it declares the main namespace as its own default or prefix."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            p, n = split_name(qname(raw))
            tag = start_tag(raw)
            decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
            own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
            if own:
                main = own.group(1)[1:-1].decode() in MAIN
            else:
                main = p == rp and root_ns in MAIN
            out.append((a + x, a + y, n if main else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def attr_escaped(text):
        """The layer's attribute escape: the five, and tab, line feed and
        carriage return as character references."""
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace("'", "&apos;").replace('"', "&quot;").replace("\t", "&#9;")
                .replace("\n", "&#10;").replace("\r", "&#13;")).encode()
    
    
    def text_escaped(text):
        """An element text's escape: ampersand and the two angle brackets."""
        return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").encode()
    
    
    def styles_of(z, workbook):
        """The styles part's name, or None."""
        for (_, ty, t) in rels_of(z, workbook):
            if ty.endswith("/styles"):
                return t
        return None
    
    
    def m_of(data):
        """The largest row number of a <c> in every main sheetData root child."""
        m = 0
        for sd in ET.fromstring(data):
            ns, name = local(sd.tag)
            if ns not in MAIN or name != "sheetData":
                continue
            for row in sd:
                for c in row:
                    cns, cname = local(c.tag)
                    if cns in MAIN and cname == "c":
                        got = re.match(r"^\$?[A-Z]+\$?([0-9]+)$", c.get("r", ""))
                        if got:
                            m = max(m, int(got.group(1)))
        return m
    
    
    def rules_of(data):
        """(sqref, [(sorted attributes, [formula texts])]) of every main
        conditionalFormatting root child, in document order."""
        out = []
        for el in ET.fromstring(data):
            ns, name = local(el.tag)
            if ns not in MAIN or name != CF:
                continue
            rules = []
            for r in el:
                rns, rname = local(r.tag)
                if rns in MAIN and rname == "cfRule":
                    forms = [f.text or "" for f in r if local(f.tag)[0] in MAIN and local(f.tag)[1] == "formula"]
                    rules.append((tuple(sorted(r.attrib.items())), forms))
            out.append((el.get("sqref"), rules))
        return out
    
    
    def highest(rules):
        """The highest priority of the rules, 0 when there is none."""
        got = [int(dict(a)["priority"]) for (_, rs) in rules for (a, _) in rs
               if dict(a).get("priority", "").isdigit()]
        return max(got) if got else 0
    
    
    def dxfs_of(data):
        """(present, dxf children of the first main dxfs root child)."""
        for el in ET.fromstring(data):
            ns, name = local(el.tag)
            if ns in MAIN and name == DXFS:
                return True, sum(1 for d in el if local(d.tag)[0] in MAIN and local(d.tag)[1] == "dxf")
        return False, 0
    
    
    def expected(n, d, h):
        """The two conditional formats the sample adds (tools/emend-copy,
        --cf-sample): sqref, the rule's attributes in the design's order, and
        the formula texts."""
        return [("A%d:C%d" % (n, n),
                 [("type", "cellIs"), ("dxfId", str(d)), ("priority", str(h + 1)),
                  ("operator", "greaterThan")], ["5"]),
                ("A%d" % (n + 1),
                 [("type", "expression"), ("dxfId", str(d)), ("priority", str(h + 2)),
                  ("stopIfTrue", "1")], ["TRUE"])]
    
    
    def cf_bytes(p, sqref, attrs, forms):
        out = b"<" + p + b'conditionalFormatting sqref="' + sqref.encode() + b'"><' + p + b"cfRule"
        for (k, v) in attrs:
            out += b" " + k.encode() + b'="' + attr_escaped(v) + b'"'
        out += b">"
        for f in forms:
            out += b"<" + p + b"formula>" + text_escaped(f) + b"</" + p + b"formula>"
        return out + b"</" + p + b"cfRule></" + p + b"conditionalFormatting>"
    
    
    def dxf_bytes(p):
        return (b"<%sdxf><%sfont><%sb/><%scolor rgb=\"009C0006\"/></%sfont><%sfill>"
                b"<%spatternFill patternType=\"solid\"><%sbgColor rgb=\"00FFC7CE\"/>"
                b"</%spatternFill></%sfill></%sdxf>") % ((p,) * 11)
    
    
    def recounted(data, kids):
        """The styles part as every styles rewrite writes it outside dxfs: each
        of the five recounted containers' count, when it has one, set to its
        children (P2 ruling 3); and the names of those whose count changed."""
        fixed, names = data, []
        tree = ET.fromstring(data)
        main = [el for el in tree if local(el.tag)[0] in MAIN]
        by_name = {}
        for el in main:
            by_name.setdefault(local(el.tag)[1], el)
        for (x, y, nm) in reversed(kids):
            for (cont, child) in RECOUNTED:
                if nm != cont or cont not in by_name:
                    continue
                el = by_name[cont]
                n = sum(1 for c in el if local(c.tag)[0] in MAIN and local(c.tag)[1] == child)
                raw = fixed[x:y]
                tag = start_tag(raw)
                m = re.search(ATTR_RE % b"count", tag)
                if not m or m.group(1)[1:-1] == b"%d" % n:
                    continue
                new = with_attr(tag, b"count", b"%d" % n)
                fixed = fixed[:x] + new + fixed[x + len(tag):]
                names.append(cont)
        return fixed, sorted(names)
    
    
    def plant(flag, wout, sout, st):
        """(wout, sout) changed so that `flag` turns to no, or None when the pair
        gives the plant nothing to change."""
        ts, te, a, b, rp = root_span(wout)
        kids = children(wout, a, b, rp, st["root_ns"])
        cfs = [(x, y) for (x, y, n) in kids if n == CF]
        sd = [(x, y) for (x, y, n) in kids if n == "sheetData"]
        sts, ste, sa, sb, srp = root_span(sout)
        skids = children(sout, sa, sb, srp, st["styles_ns"])
        dx = [(x, y) for (x, y, n) in skids if n == DXFS]
        if flag == "rest_same":
            return wout[:te] + COMMENT + wout[te:], sout
        if flag == "cf_prefix":
            if not st["cf_in"] or not cfs:
                return None
            e = cfs[0][0] + len(start_tag(wout[cfs[0][0]:cfs[0][1]]))
            return wout[:e] + COMMENT + wout[e:], sout
        if flag in ("added_tags", "added_bytes"):
            t = b'operator="greaterThan"'
            at = wout.rfind(t)
            if at < 0:
                return None
            new = t + b' planted="1"' if flag == "added_tags" else b"operator='greaterThan'"
            return wout[:at] + new + wout[at + len(t):], sout
        if flag == "cf_place":
            if not cfs:
                return None
            return wout[:cfs[-1][1]] + COMMENT + wout[cfs[-1][1]:], sout
        if flag == "root_order":
            if not cfs or not sd:
                return None
            (x1, y1), (x2, y2) = sorted([cfs[-1], sd[0]])
            return wout[:x1] + wout[x2:y2] + wout[y1:x2] + wout[x1:y1] + wout[y2:], sout
        if flag == "cf_read":
            t = b'sqref="A%d"' % (st["n"] + 1)
            at = wout.rfind(t)
            if at < 0:
                return None
            return wout[:at] + b'sqref="B%d"' % (st["n"] + 1) + wout[at + len(t):], sout
        if flag == "styles_rest":
            return wout, sout[:ste] + COMMENT + sout[ste:]
        if flag == "dxfs_tag":
            if not dx:
                return None
            e = dx[0][0] + len(start_tag(sout[dx[0][0]:dx[0][1]])) - 1
            return wout, sout[:e] + b' planted="1"' + sout[e:]
        if flag == "dxf_prefix":
            if not dx or not st["dxf_in"]:
                return None
            e = dx[0][0] + len(start_tag(sout[dx[0][0]:dx[0][1]]))
            return wout, sout[:e] + COMMENT + sout[e:]
        if flag == "dxf_bytes":
            t = b'patternType="solid"><'
            at = sout.rfind(t)
            if at < 0:
                return None
            return wout, sout[:at] + b"patternType='solid'><" + sout[at + len(t):]
        if flag == "dxfs_count":
            if not dx:
                return None
            tag = start_tag(sout[dx[0][0]:dx[0][1]])
            m = re.search(ATTR_RE % b"count", tag)
            if not m:
                return None
            new = with_attr(tag, b"count", b"%d" % (int(m.group(1)[1:-1]) + 1))
            return wout, sout[:dx[0][0]] + new + sout[dx[0][0] + len(tag):]
        if flag == "dxfs_place":
            if st["had_dxfs"] or not dx:
                return None
            return wout, sout[:dx[0][1]] + COMMENT + sout[dx[0][1]:]
        if flag == "one_dxfs":
            return wout, sout[:sb] + b"<" + srp + DXFS.encode() + b"/>" + sout[sb:]
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def self_test():
        """The recount finding's control: a planted styles part whose fonts
        count disagrees with its children is recounted, and one that agrees is
        not."""
        ns = MAIN[0].encode()
        bad = (b'<styleSheet xmlns="' + ns + b'"><fonts count="3"><font/></fonts>'
               b'<cellXfs count="1"><xf/></cellXfs></styleSheet>')
        good = bad.replace(b'count="3"', b'count="1"')
        for data, want in ((bad, ["fonts"]), (good, [])):
            _, _, a, b, rp = root_span(data)
            fixed, names = recounted(data, children(data, a, b, rp, MAIN[0]))
            if names != want or (want and fixed != good):
                return False
        return True
    
    
    def want_dxfs_tag_p2(src_tag, d):
        """The reading P4 ruling 1 withdrew, kept as the planted form of the
        control: count set to d + 1 in place or appended, a tag without one
        gaining it."""
        tin = with_attr(src_tag, b"count", b"%d" % (d + 1))
        return opened(tin) if tin.endswith(b"/>") else tin
    
    
    def want_dxfs_tag(src_tag, d):
        """The output dxfs start tag the rule gives for an input start tag with d
        dxf children and one addition: a count replaced by d + 1, a tag without
        one left without one (part 2's rule for every styles container, P4
        ruling 1), opened up when the input was empty."""
        tin = with_attr(src_tag, b"count", b"%d" % (d + 1)) if re.search(
            ATTR_RE % b"count", src_tag) else src_tag
        return opened(tin) if tin.endswith(b"/>") else tin
    
    
    def tag_test(want_of=None):
        """The control for dxfs_tag's expectation (P4 ruling 1): for an input dxfs
        with no count attribute, the tag left without one is accepted and a
        counted one refused; for one with a count, the count is replaced; an
        empty one is opened up."""
        cases = [
            (b"<dxfs>", 2, b"<dxfs>", [b'<dxfs count="3">']),
            (b'<x:dxfs count="2">', 2, b'<x:dxfs count="3">', [b'<x:dxfs count="2">']),
            (b"<dxfs/>", 0, b"<dxfs>", [b'<dxfs count="1">', b"<dxfs/>"]),
            (b'<dxfs a="b">', 1, b'<dxfs a="b">', [b'<dxfs a="b" count="2">']),
        ]
        want_of = want_of or want_dxfs_tag
        for src, d, good, bad in cases:
            want = want_of(src, d)
            if want != good or any(want == b for b in bad):
                return False
        return True
    
    
    def main():
        args = sys.argv[1:]
        if args == ["--self-test"]:
            print("recount_control=%s" % yn(self_test()))
            return
        if args == ["--tag-test"]:
            print("tag_control=%s" % yn(tag_test()))
            return
        if args == ["--tag-test", "--plant-p2"]:
            print("tag_control=%s" % yn(tag_test(want_dxfs_tag_p2)))
            return
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        part = pick_w(zin, wb)
        if part is None or part not in zin.namelist():
            print("error=no-worksheet")
            return
        styles = styles_of(zin, wb)
        if styles is None or styles not in zin.namelist():
            print("error=no-styles")
            return
        if args[1:] == ["--parts"]:
            print(part)
            print(styles)
            return
        zout = zipfile.ZipFile(args[1])
        flag_plant = None
        if len(args) == 4 and args[2] == "--plant":
            flag_plant = args[3]
            if flag_plant not in FLAGS:
                print("error=unknown-plant")
                return
        win, wout = zin.read(part), zout.read(part)
        sin, sout = zin.read(styles), zout.read(styles)
    
