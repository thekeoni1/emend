        if flag == "root_order":
            if not cfs or not sd:
                return None
            (x1, y1), (x2, y2) = sorted([cfs[-1], sd[0]])
            return wout[:x1] + wout[x2:y2] + wout[y1:x2] + wout[x1:y1] + wout[y2:], sout
        if flag == "cf_read":
            t = b'sqref="C%d:C%d"' % (st["n"], st["n"] + 2)
            at = wout.rfind(t)
            if at < 0:
                return None
            return wout[:at] + b'sqref="D%d:D%d"' % (st["n"], st["n"] + 2) + wout[at + len(t):], sout
        if flag == "styles_same":
            sts, ste, _, _, _ = root_span(sout)
            return wout, sout[:ste] + COMMENT + sout[ste:]
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        part = pick_w(zin, wb)
        if part is None or part not in zin.namelist():
            print("error=no-worksheet")
            return
        styles = styles_of(zin, wb)
        if styles is None or styles not in zin.namelist():
            print("error=no-styles")
            return
        if args[1:] == ["--parts"]:
            print(part)
            print(styles)
            return
        zout = zipfile.ZipFile(args[1])
        flag_plant = None
        if len(args) == 4 and args[2] == "--plant":
            flag_plant = args[3]
            if flag_plant not in FLAGS:
                print("error=unknown-plant")
                return
        win, wout = zin.read(part), zout.read(part)
        sin, sout = zin.read(styles), zout.read(styles)
    
        n = m_of(win) + 1
        root_ns = local(ET.fromstring(win).tag)[0]
        its, ite, ia, ib, rp = root_span(win)
        kin = children(win, ia, ib, rp, root_ns)
        cf_in = [(x, y) for (x, y, nm) in kin if nm == CF]
        rules_in = rules_of(win)
        h = highest(rules_in)
        st = {"cf_in": bool(cf_in), "n": n, "root_ns": root_ns}
    
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, wout, sout, st)
            if changed is not None:
                wout, sout = changed
                planted = True
    
        flags = dict.fromkeys(FLAGS, False)
        ots, ote, oa, ob, orp = root_span(wout)
        kout = children(wout, oa, ob, orp, root_ns)
        cf_out = [(x, y) for (x, y, nm) in kout if nm == CF]
        flags["rest_same"] = cut(win, cf_in) == cut(wout, cf_out)
        in_els = [win[x:y] for (x, y) in cf_in]
        out_els = [wout[x:y] for (x, y) in cf_out]
        flags["cf_prefix"] = out_els[:len(in_els)] == in_els
        want = expected(n, h)
        want_added = [cf_bytes(rp, *w) for w in want]
        added = out_els[len(in_els):]
        flags["added_bytes"] = added == want_added
        try:
            decl = b' xmlns:%s="%s"' % (rp[:-1], MAIN[0].encode()) if rp else b' xmlns="%s"' % MAIN[0].encode()
            got = list(ET.fromstring(b"<w" + decl + b">" + b"".join(added) + b"</w>"))
            ok = len(got) == 3
            for (e, (q, attrs, child, cattrs, grand)) in zip(got, want):
                rules = list(e)
                ok = ok and local(e.tag)[1] == CF and dict(e.attrib) == {"sqref": q} and len(rules) == 1
                ok = ok and local(rules[0].tag)[1] == "cfRule" and dict(rules[0].attrib) == dict(attrs)
                kids = list(rules[0])
                ok = ok and len(kids) == 1 and local(kids[0].tag)[1] == child
                ok = ok and dict(kids[0].attrib) == dict(cattrs)
                ok = ok and [(local(g.tag)[1], dict(g.attrib)) for g in kids[0]] == [(nm, dict(a)) for (nm, a) in grand]
            flags["added_tags"] = ok
        except (ET.ParseError, IndexError):
            flags["added_tags"] = False
        pos = TABLE.index(CF)
        later_in = [x for (x, _, nm) in kin if nm is not None and nm in TABLE and TABLE.index(nm) > pos]
        at_in = later_in[0] if later_in else ib
        later_out = [x for (x, _, nm) in kout if nm is not None and nm in TABLE and TABLE.index(nm) > pos]
        at_out = later_out[0] if later_out else ob
        add_spans = cf_out[len(cf_in):]
        flags["cf_place"] = (len(add_spans) == 3 and add_spans[0][1] == add_spans[1][0]
                             and add_spans[1][1] == add_spans[2][0]
                             and add_spans[2][1] == at_out
                             and wout[:add_spans[0][0]] == win[:at_in])
        order_in = [nm for (_, _, nm) in kin if nm is not None]
        order_out = [nm for (_, _, nm) in kout if nm is not None]
        at_name = next((i for i, nm in enumerate(order_in) if nm in TABLE and TABLE.index(nm) > pos),
                       len(order_in))
        flags["root_order"] = order_out == order_in[:at_name] + [CF, CF, CF] + order_in[at_name:]
        try:
            rules_out = rules_of(wout)
        except ET.ParseError:
            rules_out = None
        want_read = rules_in + [
            (q, [(tuple(sorted(a)), [],
                  [(child, tuple(sorted(ca)), tuple((nm, tuple(sorted(ga)), ()) for (nm, ga) in grand))])])
            for (q, a, child, ca, grand) in want]
        flags["cf_read"] = rules_out == want_read
        flags["styles_same"] = sin == sout
        n_in, v_in, e_in = counts(rules_in)
        n_out, v_out, _ = counts(rules_out or [])
    
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted),
             "cf_in=%d" % n_in, "cf_out=%d" % n_out,
             "visual_in=%d" % v_in, "visual_out=%d" % v_out,
             "extended_in=%d" % e_in, "priority_max_in=%d" % h]
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS]))
    
    
    main()
