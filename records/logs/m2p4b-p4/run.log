        signatures, recursively."""
        return (local(el.tag)[1], tuple(sorted(el.attrib.items())),
                tuple(signature(c) for c in el))
    
    
    def rules_of(data):
        """(sqref, [(sorted attributes, [formula texts], [child signatures])])
        of every main conditionalFormatting root child, in document order."""
        out = []
        for el in ET.fromstring(data):
            ns, name = local(el.tag)
            if ns not in MAIN or name != CF:
                continue
            rules = []
            for r in el:
                rns, rname = local(r.tag)
                if rns in MAIN and rname == "cfRule":
                    forms = [f.text or "" for f in r
                             if local(f.tag)[0] in MAIN and local(f.tag)[1] == "formula"]
                    kids = [signature(k) for k in r
                            if not (local(k.tag)[0] in MAIN and local(k.tag)[1] == "formula")]
                    rules.append((tuple(sorted(r.attrib.items())), forms, kids))
            out.append((el.get("sqref"), rules))
        return out
    
    
    def highest(rules):
        """The highest priority of the rules, 0 when there is none."""
        got = [int(dict(a)["priority"]) for (_, rs) in rules for (a, _, _) in rs
               if dict(a).get("priority", "").isdigit()]
        return max(got) if got else 0
    
    
    def counts(rules):
        """(rules, visual rules, rules holding a main extLst child)."""
        n = visual = extended = 0
        for (_, rs) in rules:
            for (a, _, kids) in rs:
                n += 1
                visual += 1 if dict(a).get("type") in VISUAL else 0
                extended += 1 if any(k[0] == "extLst" for k in kids) else 0
        return n, visual, extended
    
    
    def expected(n, h):
        """The three conditional formats the sample adds (tools/emend-copy,
        --scale-sample): sqref, the rule's attributes, the child's name and
        attributes, and the child's children (name, attributes)."""
        last = n + 2
        return [
            ("A%d:A%d" % (n, last), [("type", "colorScale"), ("priority", str(h + 1))],
             "colorScale", [],
             [("cfvo", [("type", "min")]), ("cfvo", [("type", "max")]),
              ("color", [("rgb", "00F8696B")]), ("color", [("rgb", "0063BE7B")])]),
            ("B%d:B%d" % (n, last), [("type", "dataBar"), ("priority", str(h + 2))],
             "dataBar", [],
             [("cfvo", [("type", "min")]), ("cfvo", [("type", "max")]),
              ("color", [("rgb", "00638EC6")])]),
            ("C%d:C%d" % (n, last), [("type", "iconSet"), ("priority", str(h + 3))],
             "iconSet", [("iconSet", "3Arrows")],
