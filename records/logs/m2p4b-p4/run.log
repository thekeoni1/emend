        out += attrs_bytes(attrs) + b"><" + p + child.encode() + attrs_bytes(child_attrs) + b">"
        for (name, a) in grand:
            out += b"<" + p + name.encode() + attrs_bytes(a) + b"/>"
        out += b"</" + p + child.encode() + b"></" + p + b"cfRule></" + p + b"conditionalFormatting>"
