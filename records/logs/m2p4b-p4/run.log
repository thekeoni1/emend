## the run log's comparisons (python3, zipfile, byte spans and ElementTree; changes CD and CE)
command: sed 's/^/    /' <scratch>/w/dvcmp.py (copied from <scripts>/dvcmp.py); sha256 8c4ba87a819b228a5e9f739052fe2c070a720ed0c8063f565bb6af9688e5cb41, 19819 bytes
  the copy of dvcmp.py is the file beside this script, byte for byte: yes
    """The run log's own validation comparison (specs/0020-validation-and-
    conditional-formatting.md, "Harness runs", --validate-sample and P1, with
    P1 ruling 2).
    
    Usage: dvcmp.py <input archive> <output archive> [--plant <flag>]
           dvcmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool. It finds the workbook part through the package
    relationship; W, the first <sheet> in <sheets> order whose relationship type
    is a worksheet's, and its part; and M, the largest row number of a <c> in W's
    sheetData elements (0 when there is none), N = M + 1. From the input it
    builds, by the design's rules, what the output must hold, and compares:
    
      rest_same        W with every main-namespace root child named
                       dataValidations cut out is the input's, byte for byte
      start_tag        the output container's start tag is the input's with
                       count set to its children (opened up when it was empty),
                       every other attribute and byte kept; or, when the input
                       had none, <P:dataValidations count="K"> with the root's
                       prefix; its end tag is of the same name
      dv_prefix        the input's container content is a byte-identical prefix
                       of the output's; trivially so when the input had none
      count_children   read with ElementTree, the output container's count is
                       the number of its dataValidation children
      added_tags       after that prefix come exactly two elements, read with
                       ElementTree: the list validation on A<N> and the
                       whole-number one on B<N>:B<N+1>, each with exactly the
                       attributes the design gives and its formula children,
                       no other child
      added_bytes      the two elements are byte for byte the ones this program
                       builds, attributes in the design's order, the container's
                       prefix on every element
      container_place  an existing container keeps its place among the main
                       children; a created one ends exactly where the first main
                       child that the worksheet table of ECMA-376 18.3.1.99 puts
                       after dataValidations starts (the root's end tag when there
                       is none), this program's own copy of the table
      root_order       the output's main root children's names are the input's
                       with dataValidations inserted, when the input lacks it,
                       before the first main child the table puts after it, or at
                       the end
      one_each         the output has exactly one dataValidations among the
                       root's main children
      dv_read          read with ElementTree, the output's dataValidation
                       elements (attributes and formula texts) are the input's
                       followed by the two added ones
    
    It prints ONE line of counts and yes/no flags and no formula, message,
    reference, sheet name or part name. --parts prints W's part name, for the
    log to compare with the runner's rows without printing it. --plant <flag>
    changes the output as read so that the named flag turns to no; the line then
    says planted=yes, or planted=no when the pair gives the plant nothing to
    change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    # ECMA-376 Part 1, 18.3.1.99, the worksheet root's children in order: this
    # program's own copy (specs/0018, "Creating an element"), not the crate's.
    TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    assert len(TABLE) == 39
    
    FLAGS = ("rest_same", "start_tag", "dv_prefix", "count_children", "added_tags",
             "added_bytes", "container_place", "root_order", "one_each", "dv_read")
    
    COMMENT = b"<!-- planted -->"
    DV = "dataValidations"
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def pick_w(z, workbook):
        """W's part, or None."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty.endswith("/worksheet"):
                    return target
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def inner(raw):
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return len(tag), len(tag)
        return len(tag), raw.rfind(b"</")
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def with_attr(tag, name, value):
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def children(data, a, b, rp, root_ns):
        """[(start, end, main local name or None)] of the root's children. A
        child is main when its prefix is the root's (the root is main) or when
        it declares the main namespace as its own default or prefix."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            p, n = split_name(qname(raw))
            tag = start_tag(raw)
            decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
            own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
            if own:
                main = own.group(1)[1:-1].decode() in MAIN
            else:
                main = p == rp and root_ns in MAIN
            out.append((a + x, a + y, n if main else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def attr_escaped(text):
        """The layer's attribute escape: the five, and tab, line feed and
        carriage return as character references."""
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace("'", "&apos;").replace('"', "&quot;").replace("\t", "&#9;")
                .replace("\n", "&#10;").replace("\r", "&#13;")).encode()
    
    
    def text_escaped(text):
        """An element text's escape: ampersand and the two angle brackets."""
        return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").encode()
    
    
    def m_of(data):
        """The largest row number of a <c> in every main sheetData root child."""
        m = 0
        root = ET.fromstring(data)
        for sd in root:
            ns, name = local(sd.tag)
            if ns not in MAIN or name != "sheetData":
                continue
            for row in sd:
                for c in row:
                    cns, cname = local(c.tag)
                    if cns in MAIN and cname == "c":
                        got = re.match(r"^\$?[A-Z]+\$?([0-9]+)$", c.get("r", ""))
                        if got:
                            m = max(m, int(got.group(1)))
        return m
    
    
    def dvs_of(data):
        """(sorted attributes, formula1 text, formula2 text) of every
        dataValidation of every main dataValidations root child, in document
        order."""
        out = []
        for el in ET.fromstring(data):
            ns, name = local(el.tag)
            if ns not in MAIN or name != DV:
                continue
            for d in el:
                dns, dname = local(d.tag)
                if dns in MAIN and dname == "dataValidation":
                    f = {}
                    for ch in d:
                        cns, cname = local(ch.tag)
                        if cns in MAIN and cname in ("formula1", "formula2"):
                            f[cname] = ch.text or ""
                    out.append((tuple(sorted(d.attrib.items())), f.get("formula1"), f.get("formula2")))
        return out
    
    
    # The sample's two validations (tools/emend-copy, --validate-sample): the
    # attributes in the design's order ("Data validation", P1 rulings 2 and 5),
    # and the formula children.
    def expected(n):
        first = [("type", "list"), ("allowBlank", "1"), ("showInputMessage", "1"),
                 ("showErrorMessage", "1"), ("errorStyle", "stop"), ("errorTitle", "emend"),
                 ("error", "not in the list"), ("promptTitle", "emend"), ("prompt", "pick one"),
                 ("sqref", "A%d" % n)]
        second = [("type", "whole"), ("operator", "between"), ("allowBlank", "0"),
                  ("showInputMessage", "0"), ("showErrorMessage", "0"),
                  ("sqref", "B%d:B%d" % (n, n + 1))]
        return [(first, [("formula1", '"emend,sample"')]),
                (second, [("formula1", "1"), ("formula2", "10")])]
    
    
    def element_bytes(p, attrs, kids):
        out = b"<" + p + b"dataValidation"
        for (k, v) in attrs:
            out += b" " + k.encode() + b'="' + attr_escaped(v) + b'"'
        out += b">"
        for (k, v) in kids:
            out += b"<" + p + k.encode() + b">" + text_escaped(v) + b"</" + p + k.encode() + b">"
        return out + b"</" + p + b"dataValidation>"
    
    
    def plant(flag, dout, state):
        """dout changed so that `flag` turns to no, or None when the pair gives
        the plant nothing to change."""
        ts, te, a, b, rp = root_span(dout)
        kids = children(dout, a, b, rp, state["root_ns"])
        dv = [(x, y) for (x, y, n) in kids if n == DV]
        sd = [(x, y) for (x, y, n) in kids if n == "sheetData"]
        if flag == "rest_same":
            return dout[:te] + COMMENT + dout[te:]
        if flag == "start_tag":
            if not dv:
                return None
            e = dv[0][0] + len(start_tag(dout[dv[0][0]:dv[0][1]])) - 1
            return dout[:e] + b' planted="1"' + dout[e:]
        if flag == "dv_prefix":
            if not dv or not state["in_content"]:
                return None
            x = dv[0][0] + inner(dout[dv[0][0]:dv[0][1]])[0]
            sp = dout.find(b" ", x)
            return dout[:sp] + b" " + dout[sp:]
        if flag == "count_children":
            if not dv:
                return None
            tag = start_tag(dout[dv[0][0]:dv[0][1]])
            m = re.search(ATTR_RE % b"count", tag)
            if not m:
                return None
            new = with_attr(tag, b"count", b"%d" % (int(m.group(1)[1:-1]) + 1))
            return dout[:dv[0][0]] + new + dout[dv[0][0] + len(tag):]
        if flag in ("added_tags", "added_bytes"):
            t = b'operator="between"'
            at = dout.rfind(t)
            if at < 0:
                return None
            new = t + b' planted="1"' if flag == "added_tags" else b"operator='between'"
            return dout[:at] + new + dout[at + len(t):]
        if flag == "container_place":
            if state["had_container"] or not dv:
                return None
            return dout[:dv[0][1]] + COMMENT + dout[dv[0][1]:]
        if flag == "root_order":
            if not dv or not sd:
                return None
            (x1, y1), (x2, y2) = sorted([dv[0], sd[0]])
            first, second = dout[x1:y1], dout[x2:y2]
            return dout[:x1] + second + dout[y1:x2] + first + dout[y2:]
        if flag == "one_each":
            return dout[:b] + b"<" + rp + DV.encode() + b"/>" + dout[b:]
        if flag == "dv_read":
            n = state["n"]
            t = b'sqref="B%d:B%d"' % (n, n + 1)
            at = dout.rfind(t)
            if at < 0:
                return None
            return dout[:at] + b'sqref="C%d:C%d"' % (n, n + 1) + dout[at + len(t):]
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        part = pick_w(zin, wb)
        if part is None or part not in zin.namelist():
            print("error=no-worksheet")
            return
        if args[1:] == ["--parts"]:
            print(part)
            return
        zout = zipfile.ZipFile(args[1])
        flag_plant = None
        if len(args) == 4 and args[2] == "--plant":
            flag_plant = args[3]
            if flag_plant not in FLAGS:
                print("error=unknown-plant")
                return
        din, dout = zin.read(part), zout.read(part)
    
        n = m_of(din) + 1
        root_ns = local(ET.fromstring(din).tag)[0]
        its, ite, ia, ib, rp = root_span(din)
        kin = children(din, ia, ib, rp, root_ns)
        dv_in = [(x, y) for (x, y, nm) in kin if nm == DV]
        in_content = b""
        if dv_in:
            el = din[dv_in[0][0]:dv_in[0][1]]
            x, y = inner(el)
            in_content = el[x:y]
        state = {"in_content": in_content, "had_container": bool(dv_in), "n": n,
                 "root_ns": root_ns}
    
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, dout, state)
            if changed is not None:
                dout = changed
                planted = True
    
        ots, ote, oa, ob, orp = root_span(dout)
        kout = children(dout, oa, ob, orp, root_ns)
        dv_out = [(x, y) for (x, y, nm) in kout if nm == DV]
        flags = dict.fromkeys(FLAGS, False)
    
        flags["rest_same"] = cut(din, dv_in) == cut(dout, dv_out)
        flags["one_each"] = len(dv_out) == 1
    
        l_in = dvs_of(din)
        try:
            l_out = dvs_of(dout)
        except ET.ParseError:
            l_out = None
        want = expected(n)
        p = split_name(qname(din[dv_in[0][0]:dv_in[0][1]]))[0] if dv_in else rp
        want_added = b"".join(element_bytes(p, a, k) for (a, k) in want)
        count_out = -1
        if dv_out:
            el = dout[dv_out[0][0]:dv_out[0][1]]
            x, y = inner(el)
            content = el[x:y]
            tag = start_tag(el)
            total = len(l_in) + 2
            if dv_in:
                src = din[dv_in[0][0]:dv_in[0][1]]
                tin = with_attr(start_tag(src), b"count", b"%d" % total)
                want_tag = opened(tin) if tin.endswith(b"/>") else tin
                end_ok = el.endswith(b"</" + qname(src) + b">")
            else:
                want_tag = b"<" + rp + DV.encode() + b' count="%d">' % total
                end_ok = el.endswith(b"</" + rp + DV.encode() + b">")
            flags["start_tag"] = tag == want_tag and end_ok
            flags["dv_prefix"] = content.startswith(in_content)
            added = content[len(in_content):] if content.startswith(in_content) else b""
            flags["added_bytes"] = added == want_added
            try:
                got_c = next(e for e in ET.fromstring(dout)
                             if local(e.tag)[0] in MAIN and local(e.tag)[1] == DV)
                cval = got_c.get("count")
                kids_n = sum(1 for d in got_c if local(d.tag)[1] == "dataValidation")
                count_out = int(cval) if cval is not None and cval.isdigit() else -1
                flags["count_children"] = count_out == kids_n
            except (ET.ParseError, StopIteration):
                flags["count_children"] = False
            try:
                decl = b' xmlns:%s="%s"' % (p[:-1], MAIN[0].encode()) if p else b' xmlns="%s"' % MAIN[0].encode()
                got = list(ET.fromstring(b"<w" + decl + b">" + added + b"</w>"))
                ok = len(got) == 2 and len(top_level(added)) == 2
                for (e, (attrs, kids)) in zip(got, want):
                    ok = ok and local(e.tag)[1] == "dataValidation" and dict(e.attrib) == dict(attrs)
                    ok = ok and [(local(c.tag)[1], c.text or "") for c in e] == kids
                flags["added_tags"] = ok
            except ET.ParseError:
                flags["added_tags"] = False
    
        order_in = [nm for (_, _, nm) in kin if nm is not None]
        order_out = [nm for (_, _, nm) in kout if nm is not None]
        want_order = list(order_in)
        if DV not in want_order:
            pos = TABLE.index(DV)
            at = next((i for i, nm in enumerate(want_order) if nm in TABLE and TABLE.index(nm) > pos),
                      len(want_order))
            want_order.insert(at, DV)
        flags["root_order"] = order_out == want_order
        if dv_in:
            flags["container_place"] = (DV in order_out and order_in.count(DV) == 1
                                        and order_out.index(DV) == order_in.index(DV))
        elif dv_out:
            pos = TABLE.index(DV)
            later = [x for (x, _, nm) in kout
                     if nm is not None and nm in TABLE and TABLE.index(nm) > pos and x >= dv_out[0][1]]
            flags["container_place"] = dv_out[0][1] == (later[0] if later else ob)
    
        want_read = l_in + [(tuple(sorted(a)), dict(k).get("formula1"), dict(k).get("formula2"))
                            for (a, k) in want]
        flags["dv_read"] = l_out == want_read
    
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted),
             "dv_in=%d" % len(l_in), "dv_out=%d" % len(l_out or []),
             "container_in=%d" % (1 if dv_in else 0),
             "count_out=%d" % count_out,
             "container_created=%d" % (0 if dv_in else 1)]
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS]))
    
    
    main()
