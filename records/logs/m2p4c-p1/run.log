            others = [(x, y) for (x, y, n) in kids if n not in (TP, "sheetData")]
            if not others:
                return None
            return wout[:others[0][0]] + COMMENT + wout[others[0][0]:], e
        if flag == "data_rows":
            if not sds:
                return None
            x, y = sds[0]
