    def table_parts_of(data):
        """(whether the root has a main tableParts child, its tablePart
        children, its count attribute or None), read with ElementTree."""
        for el in ET.fromstring(data):
            ns, name = local(el.tag)
            if ns in MAIN and name == TP:
                kids = [k for k in el if local(k.tag)[0] in MAIN and local(k.tag)[1] == "tablePart"]
                return True, len(kids), el.get("count")
        return False, 0, None
    
    
    def root_id(data):
        """A table part's root id as a number, or None."""
        try:
            got = ET.fromstring(data).get("id", "")
        except ET.ParseError:
            return None
        return int(got) if got.isdigit() else None
    
    
    def a1(col, row):
        s = ""
        while col:
            col, r = divmod(col - 1, 26)
            s = chr(65 + r) + s
        return "%s%d" % (s, row)
    
    
    def header_cells(p, n):
        return b"".join(
            b"<" + p + b'c r="' + a1(i + 1, n).encode() + b'" t="inlineStr"><' + p + b"is><" + p
            + b't xml:space="preserve">' + text + b"</" + p + b"t></" + p + b"is></" + p + b"c>"
            for i, text in enumerate(COLUMNS))
    
    
    def expected_data(raw, n):
        """The sheetData element with the header cells on row N, and the shape
        of the edit (appended, inserted, filled, opened)."""
        tag = start_tag(raw)
        p, _ = split_name(qname(raw))
        new_row = b"<" + p + b'row r="' + str(n).encode() + b'">' + header_cells(p, n) + b"</" + p + b"row>"
        if tag.endswith(b"/>"):
            return opened(tag) + new_row + b"</" + qname(raw) + b">", "opened"
        a, b = len(tag), raw.rfind(b"</")
        for (x, y) in top_level(raw[a:b]):
            row = raw[a + x:a + y]
            rp, name = split_name(qname(row))
            if name != "row":
                continue
            r = attr_value(start_tag(row), b"r")
            num = int(r) if r and r.isdigit() else 0
            if num == n:
                rtag = start_tag(row)
                if rtag.endswith(b"/>"):
                    filled = opened(rtag) + header_cells(rp, n) + b"</" + qname(row) + b">"
                else:
                    filled = row[:row.rfind(b"</")] + header_cells(rp, n) + row[row.rfind(b"</"):]
                return raw[:a + x] + filled + raw[a + y:], "filled"
            if num > n:
                return raw[:a + x] + new_row + raw[a + x:], "inserted"
        return raw[:b] + new_row + raw[b:], "appended"
    
    
    def part_bytes(tid, n):
        ref = ("A%d:B%d" % (n, n + 2)).encode()
        cols = b"".join(b'<tableColumn id="%d" name="' % (i + 1) + c + b'"/>' for i, c in enumerate(COLUMNS))
        return (b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<table xmlns="'
                + MAIN[0].encode() + b'" id="' + str(tid).encode() + b'" name="' + NAME
                + b'" displayName="' + NAME + b'" ref="' + ref + b'" totalsRowShown="0">'
                + b'<autoFilter ref="' + ref + b'"/><tableColumns count="2">' + cols
                + b'</tableColumns><tableStyleInfo name="TableStyleMedium2" showFirstColumn="0" '
                b'showLastColumn="0" showRowStripes="1" showColumnStripes="0"/></table>')
    
    
    def relative(src, dst):
        s = src.split("/")[:-1]
        d = dst.split("/")
        common = 0
        while common < len(s) and common < len(d) - 1 and s[common] == d[common]:
            common += 1
        return "../" * (len(s) - common) + "/".join(d[common:])
    
    
    def before_end(data, element):
