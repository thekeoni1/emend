    #!/usr/bin/env bash
    # Milestone 2 part 4c P1 run.log (specs/0021-tables.md, "P1: the types, the
    # part and the addition" and "Harness runs", `--table-sample` without its
    # removal, with the P1 rulings):
    #   1. the release binaries built at the phase commit on both targets and
    #      hashed;
    #   2. the corpus run with --tool-arg --table-sample on both targets,
    #      recorded as m2p4c-p1-<utc-date>-<shortsha>.md and .txt, the record
    #      checked against the run directory table by table;
    #   3. the run log's own comparison (tblcmp.py, python3, zipfile, byte spans
    #      and ElementTree, printed below) over every output of both labels: W's
    #      root start tag the input's, or retagged; W outside its root start tag,
    #      sheetData and tableParts byte-identical; the header row built here;
    #      the input's tablePart elements a byte-identical prefix of the output's
    #      and the one added exactly the bytes built here; count equal to the
    #      children; a created container in schema position (the log's own copy
    #      of the worksheet table) and the root children's order; W's rels part,
    #      the content types part and the added table part exactly the bytes
    #      built here, the entry name and the id derived as the rules give them;
    #      each tool line's counts against the comparison's; a planted control
    #      per flag on the first workbook in manifest order where it applies;
    #      the two labels' outputs byte for byte; a refusal by the layer counted
    #      by row and message, a finding;
    #   4. the keep regenerated on both targets, compared, and against part 4b
    #      P4's committed open-check record, named by its record commit; the edit
    #      open check over the host keep, recorded as
    #      m2p4c-open-<utc-date>-<shortsha>;
    #   5. this script's own standard error counted (specs/0017 P1 verification
    #      ruling 7).
    # No text, reference, sheet name or part name from the corpus is printed.
    #
    # CARRIED TO M2 part 4c P1 from part 4b P3's run script (at the phase commit
    # 631c719, printed in records/logs/m2p4b-p3/run.log; its change list BW to CA
    # is there, with P2's, P1's and part 4a's before it), generated by
    # <home>/.cache/emend-build/m2p4c-p1/gen/run.py, every replacement asserted
    # to occur once, and grepped for P3's names, subjects, stems, hashes, labels
    # and the tokens p3, scale-sample, scalecmp, visual, extended and the fourth
    # code commit in every form. What differs, and why:
    #  CB. The phase, the log directory, the subjects, the script directory
    #      (<scripts>, <home>/.cache/emend-build/m2p4c-p1/scripts, on the disk),
    #      the build directory (m2p4c-p1/run) and the keep (m2p4c-p1/keep-host)
    #      are this phase's; the base is part 4b's close-out record commit ("M2
    #      part 4b close-out record:"); the phase commit is P1's tool commit by
    #      its subject, P3's fourth-commit checks (its change CA) dropped; the
    #      record stems are m2p4c-p1- and m2p4c-open-.
    #  CC. specs/0020 P4 verification ruling 4: the committed open-check record
    #      the keep is compared with is named by its record commit, part 4b P4's
    #      2f7933bd..., typed here as planning's record, and checked to be a
    #      record commit that added exactly one open-check .txt with no later
    #      commit adding another; no phase directory is found by a search of
    #      subjects. This run compares against no earlier phase's run directory.
    #  CD. The comparison is tblcmp.py, written for this phase; the checks, the
    #      line's keys and the entry expectation are --table-sample's
    #      (specs/0021 "Harness runs"): W changed, W's rels part changed, or
    #      added where the input has none, [Content_Types].xml changed, each
    #      flagged descriptor at most; the table part added, unflagged; every
    #      other entry identical and unflagged; nothing recompressed or dropped.
    #      The line's relations are the spec's: tables_after, parts_after and
    #      rels_after one more than before, cells_after two more; the tool's
    #      counts equal the comparison's (tables, parts, relationships,
    #      container, relationships prefix, id and cells). The record's changed
    #      families are content-types, worksheet and rels where some input has
    #      W's rels part; its added families table and rels where some input
    #      has none, derived from the comparison's --parts lines.
    #  CE. The spec pin: planning's rulings during P1 stand uncommitted in the
    #      working tree's specs/0021 and the logs pin the committed spec at P1's
    #      doc commit (planning's word).
    #  CF. The shapes the comparison finds for the header row (appended,
    #      inserted, filled, opened) are printed per workbook and totalled; the
    #      spec's "exactly one appended <row>" reads a row the input already
    #      holds, empty, as the row the cells go into, which the design's cell
    #      pass does, and the log counts each shape.
    #
    # Usage: m2p4c-p1-run.sh <phase commit> <this phase's test.log> > <file>
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    TEST_LOG=${2:?this phase test.log required}
    # Change AS: every environment input, as it was set, before any is unset.
    INPUT_NAMES="SPEC_SHA RUN_SUFFIX SUPERSEDED_RUN SUPERSEDED_KEEP RERUN_NOTE RERUN_FILES RECORDS_DEST RUN_KEEP RUN_BUILD_ROOT EMEND_CORPUS_DIR HOME ANTHROPIC_API_KEY"
    declare -A INPUT_SEEN
    for v in $INPUT_NAMES; do
      if [ -n "${!v+x}" ]; then INPUT_SEEN[$v]=${!v}; else INPUT_SEEN[$v]=unset; fi
      # Change BL (part 4a P3's AW): the key's value is never printed, only whether it is set.
      if [ "$v" = ANTHROPIC_API_KEY ] && [ "${INPUT_SEEN[$v]}" != unset ]; then INPUT_SEEN[$v]="set (value not printed)"; fi
    done
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    LO_TIMEOUT_S=600
    SPEC=specs/0021-tables.md
    SPEC_SHA=${SPEC_SHA:-}
    if [ -z "$SPEC_SHA" ]; then echo "SPEC_SHA, the spec's sha256, is a required input (change AR)" >&2; exit 2; fi
    EDIT=--table-sample
    # The logged run leaves RUN_BUILD_ROOT and RUN_KEEP unset; a dry run points
    # them elsewhere so it leaves no keep where the logged run refuses one.
    BUILD_ROOT=${RUN_BUILD_ROOT:-$HOME/.cache/emend-build/m2p4c-p1/run}
    KEEP=${RUN_KEEP:-$HOME/.cache/emend-build/m2p4c-p1/keep-host}
    I686=i686-unknown-linux-musl
    # Change AK: where the record pairs are installed.
    RECORDS_DEST=${RECORDS_DEST:-records}
    # Change I: a keep in place is another attempt's, moved below once the
    # header can list it; without SUPERSEDED_KEEP naming the attempt it is
