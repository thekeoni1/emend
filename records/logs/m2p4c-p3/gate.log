    //! Names, each once, the three calls and the four types that the feature
    //! `tables` gates (specs/0021-tables.md, P1 and P2).
    use std::io::Cursor;
    
    pub fn tables(
        p: &mut emend::package::Package<Cursor<Vec<u8>>>,
        t: emend::Table<'_>,
        e: &emend::TableEntry,
        s: emend::TableStyle,
        i: emend::TableStyleInfo,
        area: emend::Area,
    ) -> usize {
        let _ = (e, s, i);
        let _ = p.add_table(b"x", area, t);
        let _ = p.remove_table(b"x", "x");
        p.tables(b"x").map_or(0, |list| list.len())
    }
