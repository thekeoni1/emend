### this log's generator, from the phase commit's template files
    """Fictional packages for M2 part 4c P3's negative log: the phase commit's
    template files, zipped in the template's order, the N cases inserting
    children in the worksheet part right after its empty `<sheetData/>`, a
    kept table's part, relationship and Override where the case holds one, and
    a defined name in the workbook part for N9.
    Usage: gen-n.py <template dir> <out dir>."""
    import os
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    SHEET_RELS = "xl/worksheets/_rels/sheet1.xml.rels"
    TABLE = "xl/tables/table1.xml"
    MAIN = b"http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    REL = b"http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    PKG = b"http://schemas.openxmlformats.org/package/2006/relationships"
    TABLE_TYPE = b"application/vnd.openxmlformats-officedocument.spreadsheetml.table+xml"
    DECL = b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    src, out = sys.argv[1], sys.argv[2]
    parts = {name: open(os.path.join(src, name), "rb").read() for name in ORDER}
    sheet = parts["xl/worksheets/sheet1.xml"]
    types = parts["[Content_Types].xml"]
    workbook = parts["xl/workbook.xml"]
    root = b'<worksheet xmlns="' + MAIN + b'">'
    assert workbook.count(b"</sheets>") == 1
    assert workbook.count(b"<definedNames") == 0
    assert sheet.count(b"<sheetData/>") == 1
    assert sheet.count(b"<c ") == 0
    assert sheet.count(root) == 1
    assert types.count(b"</Types>") == 1
    
    
    def with_sheet(children, bind=False):
        p = dict(parts)
        s = sheet.replace(b"<sheetData/>", b"<sheetData/>" + children)
        if bind:
            s = s.replace(root, b'<worksheet xmlns="' + MAIN + b'" xmlns:r="' + REL + b'">')
        p["xl/worksheets/sheet1.xml"] = s
        return p
    
    
    def with_table(name, ref, part=True):
        p = with_sheet(b'<tableParts count="1"><tablePart r:id="rId1"/></tableParts>', bind=True)
        p["[Content_Types].xml"] = types.replace(
            b"</Types>", b'<Override PartName="/' + TABLE.encode() + b'" ContentType="' + TABLE_TYPE
            + b'"/></Types>')
        p[SHEET_RELS] = (DECL + b'<Relationships xmlns="' + PKG + b'"><Relationship Id="rId1" Type="'
                         + REL + b'/table" Target="../tables/table1.xml"/></Relationships>')
        if part:
            p[TABLE] = (DECL + b'<table xmlns="' + MAIN + b'" id="1" name="' + name
                        + b'" displayName="' + name + b'" ref="' + ref + b'"><autoFilter ref="' + ref
                        + b'"/><tableColumns count="2"><tableColumn id="1" name="p"/><tableColumn '
                        b'id="2" name="q"/></tableColumns></table>')
        return p
    
    
    def with_name(name):
        p = dict(parts)
        p["xl/workbook.xml"] = workbook.replace(
            b"</sheets>", b'</sheets><definedNames><definedName name="' + name
            + b'">Sheet1!$A$1</definedName></definedNames>')
        return p
    
    
    CASES = {
        "n0": dict(parts),
        "n1": with_table(b"kept", b"A2:B3"),
        "n2": with_table(b"kept", b"D1:E3"),
        "n3": with_sheet(b"<tableParts/><tableParts/>"),
        "n4": with_sheet(b"<tableParts/>"),
        "n5": with_table(b"emend_table", b"D1:E3"),
        "n6": with_table(b"kept", b"D1:E3", part=False),
        "n7": with_sheet(b'<mergeCells count="1"><mergeCell ref="A2:B2"/></mergeCells>'),
        "n8": with_sheet(b'<autoFilter ref="A1:B3"/>'),
        "n9": with_name(b"EMEND_TABLE"),
    }
    for case, p in CASES.items():
        names = ORDER + [n for n in (SHEET_RELS, TABLE) if n in p]
        with zipfile.ZipFile(os.path.join(out, case + ".xlsx"), "w") as z:
            for name in names:
                z.writestr(zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0)), p[name], zipfile.ZIP_DEFLATED)
        s = p["xl/worksheets/sheet1.xml"]
        print("%s %d entries:%d tableParts:%d tablePart:%d rels:%d table_part:%d mergeCell:%d autoFilter:%d definedName:%d" % (
            case + ".xlsx", os.path.getsize(os.path.join(out, case + ".xlsx")), len(names),
            s.count(b"<tableParts"), s.count(b"<tablePart "), int(SHEET_RELS in p), int(TABLE in p),
            s.count(b"<mergeCell "), s.count(b"<autoFilter "), p["xl/workbook.xml"].count(b"<definedName ")))
