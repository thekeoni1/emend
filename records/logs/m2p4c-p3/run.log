    echo "    $(git log -1 --format=%s "$PREV_OPEN_REC")"
    prev_is_record() { git cat-file -e "$PREV_OPEN_REC^{commit}" && [ "$(git log -1 --format=%s "$PREV_OPEN_REC" | LC_ALL=C "$G" -cE '^M2 part 4c P2 record: ')" = 1 ] && git merge-base --is-ancestor "$PREV_OPEN_REC" "$C"; }
