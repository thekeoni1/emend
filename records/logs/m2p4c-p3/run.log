## the run log's comparison (python3, zipfile, byte spans and ElementTree)
command: cp <scripts>/tblcmp.py <scratch>/w/tblcmp.py; sed 's/^/    /' <scratch>/w/tblcmp.py; sha256 8815bff51e0a3a59b40cb73638541e8649c3c12a5a083a7d9ca3483d00b42c23, 25621 bytes
  the copy is the file beside this script, byte for byte: yes
    """The run log's own table comparison (specs/0021-tables.md, "Harness runs",
    --table-sample, with the P1 rulings).
    
    Usage: tblcmp.py <input archive> <output archive> [--plant <flag>]
           tblcmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool. It finds the workbook part through the package
    relationship; W, the first <sheet> in <sheets> order whose relationship type
    is a worksheet's, and its part; whether the workbook's relationship to W is
    of the strict form; M, the largest row number of a <c> in W's sheetData
    elements (0 when there is none), N = M + 1; W's rels part and its
    relationships; the entry name the rules give, xl/tables/tableT.xml with T
    the smallest positive integer no input entry has (ASCII case folded); the
    id, the smallest positive integer no table part of the workbook carries
    (every worksheet's table relationships' parts' root id); and the
    relationship id, rId one past the largest numbered id of W's rels part. From
    the input it builds, by the design's rules, what the output must hold, and
    compares:
    
      root_tag     W's root start tag is the input's, or, when the input's binds
                   no prefix to the relationships namespace, the input's with one
                   bound (r, or the first of r1, r2 and so on it does not declare)
                   to the namespace in the form of W's own relationship
      rest_same    W with its root start tag, its main sheetData and its main
                   tableParts cut out is the input's, byte for byte, but for a
                   created tableParts
      data_rows    W's sheetData is the input's with the two header cells on row
                   N, built here with the sheetData's or the row's prefix: a new
                   row appended, or inserted before the first row numbered past
                   N, or the cells written into an empty row N; an empty
                   sheetData opened up
      parts_prefix the input's tablePart elements are a byte-identical prefix of
                   the output's
      parts_added  after them comes exactly one tablePart, byte for byte the one
                   this program builds with the container's prefix and the
                   relationships prefix
      parts_count  the container's start tag is the input's with count set to
                   its children, opened up when it was empty, or the created one
      parts_place  a created container ends exactly where the root's main extLst
                   child starts, or at the root's end tag (this program's own
                   copy of the worksheet table)
      root_order   the output's main root children's names are the input's with
                   one tableParts inserted there when it was created
      rels_bytes   W's rels part is the input's with one Relationship of the
                   table type, in W's form, with the relative target, before its
                   end tag, or created in the package's own rels form
      types_bytes  the content types part is the input's with one Override of the
                   table content type for the entry, before its end tag
      part_bytes   the added entry holds exactly the bytes specs/0021 "The part"
                   gives, built here with the id
      tables_read  read with ElementTree, the output's tableParts has one child
                   more than the input's and its count is its children
    
    It prints ONE line of counts and yes/no flags and no text, reference, sheet
    name or part name. --parts prints W's part name, its rels part's name, the
    entry name the table takes, and 1 or 0 for whether the input has W's rels
    part, one per line, for the log to compare with the runner's rows without
    printing them. --plant <flag> changes the output as read so that the named
    flag turns to no; the line then says planted=yes, or planted=no when the pair
    gives the plant nothing to change.
    """
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    TABLE_TYPE = b"application/vnd.openxmlformats-officedocument.spreadsheetml.table+xml"
    
    # ECMA-376 Part 1, 18.3.1.99, the worksheet root's children in order: this
    # program's own copy (specs/0018, "Creating an element"), not the crate's.
    TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    assert len(TABLE) == 39
    
    FLAGS = ("root_tag", "rest_same", "data_rows", "parts_prefix", "parts_added", "parts_count",
             "parts_place", "root_order", "rels_bytes", "types_bytes", "part_bytes", "tables_read")
    
    COMMENT = b"<!-- planted -->"
    TP = "tableParts"
    # The sample's constants (tools/emend-copy, --table-sample).
    NAME = b"emend_table"
    COLUMNS = (b"emend_a", b"emend_b")
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def sheets_of(z, workbook):
        """(part, relationship type) of every <sheet>, in <sheets> order."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        out = []
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                out.append((target, ty))
        return out
    
    
    def pick_w(z, workbook):
        """(W's part, whether its relationship is strict), or (None, False)."""
        for (target, ty) in sheets_of(z, workbook):
            if ty in (ATTR[0] + "/worksheet", ATTR[1] + "/worksheet"):
                return target, ty.startswith(ATTR[1])
        return None, False
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def attr_value(tag, name):
        m = re.search(ATTR_RE % re.escape(name), tag)
        return m.group(1)[1:-1] if m else None
    
    
    def with_attr(tag, name, value):
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def children(data, a, b, rp, root_ns):
        """[(start, end, main local name or None)] of the root's children."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            p, n = split_name(qname(raw))
            tag = start_tag(raw)
            decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
            own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
            if own:
                main = own.group(1)[1:-1].decode() in MAIN
            else:
                main = p == rp and root_ns in MAIN
            out.append((a + x, a + y, n if main else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def rels_prefix_of(tag):
        """The prefix a start tag binds to the relationships namespace, either
        form, or None."""
        for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            if m.group(2)[1:-1].decode() in ATTR:
                return m.group(1)
        return None
    
    
    def m_of(data):
        """The largest row number of a <c> in every main sheetData root child,
        and the number of those cells."""
        m = n = 0
        for sd in ET.fromstring(data):
            ns, name = local(sd.tag)
            if ns not in MAIN or name != "sheetData":
                continue
            for row in sd:
                for c in row:
                    cns, cname = local(c.tag)
                    if cns in MAIN and cname == "c":
                        n += 1
                        got = re.match(r"^\$?[A-Z]+\$?([0-9]+)$", c.get("r", ""))
                        if got:
                            m = max(m, int(got.group(1)))
        return m, n
    
    
    def table_parts_of(data):
        """(whether the root has a main tableParts child, its tablePart
        children, its count attribute or None), read with ElementTree."""
        for el in ET.fromstring(data):
            ns, name = local(el.tag)
            if ns in MAIN and name == TP:
                kids = [k for k in el if local(k.tag)[0] in MAIN and local(k.tag)[1] == "tablePart"]
                return True, len(kids), el.get("count")
        return False, 0, None
    
    
    def root_id(data):
        """A table part's root id as a number, or None."""
        try:
            got = ET.fromstring(data).get("id", "")
        except ET.ParseError:
            return None
        return int(got) if got.isdigit() else None
    
    
    def a1(col, row):
        s = ""
        while col:
            col, r = divmod(col - 1, 26)
            s = chr(65 + r) + s
        return "%s%d" % (s, row)
    
    
    def header_cells(p, n):
        return b"".join(
            b"<" + p + b'c r="' + a1(i + 1, n).encode() + b'" t="inlineStr"><' + p + b"is><" + p
            + b't xml:space="preserve">' + text + b"</" + p + b"t></" + p + b"is></" + p + b"c>"
            for i, text in enumerate(COLUMNS))
    
    
    def expected_data(raw, n):
        """The sheetData element with the header cells on row N, and the shape
        of the edit (appended, inserted, filled, opened)."""
        tag = start_tag(raw)
        p, _ = split_name(qname(raw))
        new_row = b"<" + p + b'row r="' + str(n).encode() + b'">' + header_cells(p, n) + b"</" + p + b"row>"
        if tag.endswith(b"/>"):
            return opened(tag) + new_row + b"</" + qname(raw) + b">", "opened"
        a, b = len(tag), raw.rfind(b"</")
        for (x, y) in top_level(raw[a:b]):
            row = raw[a + x:a + y]
            rp, name = split_name(qname(row))
            if name != "row":
                continue
            r = attr_value(start_tag(row), b"r")
            num = int(r) if r and r.isdigit() else 0
            if num == n:
                rtag = start_tag(row)
                if rtag.endswith(b"/>"):
                    filled = opened(rtag) + header_cells(rp, n) + b"</" + qname(row) + b">"
                else:
                    filled = row[:row.rfind(b"</")] + header_cells(rp, n) + row[row.rfind(b"</"):]
                return raw[:a + x] + filled + raw[a + y:], "filled"
            if num > n:
                return raw[:a + x] + new_row + raw[a + x:], "inserted"
        return raw[:b] + new_row + raw[b:], "appended"
    
    
    def part_bytes(tid, n):
        ref = ("A%d:B%d" % (n, n + 2)).encode()
        cols = b"".join(b'<tableColumn id="%d" name="' % (i + 1) + c + b'"/>' for i, c in enumerate(COLUMNS))
        return (b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<table xmlns="'
                + MAIN[0].encode() + b'" id="' + str(tid).encode() + b'" name="' + NAME
                + b'" displayName="' + NAME + b'" ref="' + ref + b'" totalsRowShown="0">'
                + b'<autoFilter ref="' + ref + b'"/><tableColumns count="2">' + cols
                + b'</tableColumns><tableStyleInfo name="TableStyleMedium2" showFirstColumn="0" '
                b'showLastColumn="0" showRowStripes="1" showColumnStripes="0"/></table>')
    
    
    def relative(src, dst):
        s = src.split("/")[:-1]
        d = dst.split("/")
        common = 0
        while common < len(s) and common < len(d) - 1 and s[common] == d[common]:
            common += 1
        return "../" * (len(s) - common) + "/".join(d[common:])
    
    
    def before_end(data, element):
        """The bytes with element inserted before the root's end tag, the root
        opened up first when it is empty."""
        ts, te, a, b, _ = root_span(data)
        tag = data[ts:te]
        if tag.endswith(b"/>"):
            return data[:ts] + opened(tag) + element + b"</" + qname(tag) + b">" + data[te:]
        return data[:b] + element + data[b:]
    
    
    def package_prefix(z):
        """The bytes a created rels part begins with: the package's own
        _rels/.rels up to its root start tag."""
        data = z.read("_rels/.rels")
        return data[:root_span(data)[0]]
    
    
    def plant(flag, wout, extra, st):
        """(wout, extra) changed so that `flag` turns to no, or None when the
        pair gives the plant nothing to change. `extra` holds the rels, types and
        part bytes as read."""
        ts, te, a, b, rp = root_span(wout)
        kids = children(wout, a, b, rp, st["root_ns"])
        tps = [(x, y) for (x, y, n) in kids if n == TP]
        sds = [(x, y) for (x, y, n) in kids if n == "sheetData"]
        e = dict(extra)
        if flag == "root_tag":
            return wout[:te - 1] + b' planted="1"' + wout[te - 1:], e
        if flag == "rest_same":
            others = [(x, y) for (x, y, n) in kids if n not in (TP, "sheetData")]
            if not others:
                return None
            return wout[:others[0][0]] + COMMENT + wout[others[0][0]:], e
        if flag == "data_rows":
            if not sds:
                return None
            x, y = sds[0]
            at = wout.rfind(b"emend_b", x, y)
            return wout[:at] + b"emend_c" + wout[at + 7:], e
        if flag == "parts_prefix":
            if not st["tables_in"] or not tps:
                return None
            x, y = tps[0]
            at = x + len(start_tag(wout[x:y]))
            first = top_level(wout[at:y])[0]
            close = at + first[0] + len(start_tag(wout[at + first[0]:at + first[1]])) - 1
            close -= 1 if wout[close - 1:close] == b"/" else 0
            return wout[:close] + b' planted="1"' + wout[close:], e
        if flag == "parts_added":
            at = wout.rfind(st["rid"])
            if at < 0:
                return None
            return wout[:at] + b"rId0" + wout[at + len(st["rid"]):], e
        if flag == "parts_count":
            if not tps:
                return None
            x, y = tps[0]
            tag = start_tag(wout[x:y])
            return wout[:x] + with_attr(tag, b"count", b"99") + wout[x + len(tag):], e
        if flag == "parts_place":
            if st["container_in"] or not tps:
                return None
            x, y = tps[0]
            return wout[:y] + COMMENT + wout[y:], e
        if flag == "root_order":
            if not tps or not sds:
                return None
            (x1, y1), (x2, y2) = sorted([tps[0], sds[0]])
            return wout[:x1] + wout[x2:y2] + wout[y1:x2] + wout[x1:y1] + wout[y2:], e
        if flag in ("rels_bytes", "types_bytes", "part_bytes"):
            key = flag.split("_")[0]
            if e.get(key) is None:
                return None
            e[key] = e[key] + COMMENT
            return wout, e
        if flag == "tables_read":
            if not tps:
                return None
            x, y = tps[0]
            at = wout.rfind(b"</", x, y)
            return wout[:at] + b"<" + st["cp"] + b'tablePart ' + st["rp_attr"] + b':id="rId0"/>' + wout[at:], e
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
