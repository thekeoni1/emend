    """Every message a scale-gen.py raises as Refused(...), one per line, in
    source order: a string literal as it stands; a literal formatted with %
    by evaluating the module's own expression (the module is imported, its
    main is not run); a name by the module's value of it. Usage: messages.py
    <scale-gen.py>."""
    import ast
    import importlib.util
    import sys
    
    path = sys.argv[1]
    spec = importlib.util.spec_from_file_location("scale_gen", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    tree = ast.parse(open(path).read())
    seen = []
    for node in sorted((n for n in ast.walk(tree) if isinstance(n, ast.Raise)), key=lambda n: n.lineno):
        call = node.exc
        if not (isinstance(call, ast.Call) and isinstance(call.func, ast.Name) and call.func.id == "Refused"):
            continue
        arg = call.args[0]
        if isinstance(arg, ast.Constant):
            m = arg.value
        else:
            m = eval(compile(ast.Expression(arg), path, "eval"), vars(mod))
        if m not in seen:
            seen.append(m)
    for m in seen:
        print(m)
    PY
    python3 "$B/messages.py" "$B/scale-gen.py" >"$B/messages" 2>"$B/messages.err"
    echo "command: python3 <scratch>/w/messages.py <the phase commit's scale-gen.py>: exit $?; distinct messages $(count_lines "$B/messages"); stderr bytes $(wc -c <"$B/messages.err")"
    nempty=$(count_matches -E '^$' "$B/messages")
    echo "  the messages:"; sed 's/^/    /' "$B/messages"
    reader_ok() { [ "$(count_lines "$B/messages")" -ge 1 ] && [ "$nempty" = 0 ] && [ ! -s "$B/messages.err" ]; }
    check "the reader found the messages, none empty, and wrote no error" "$(yn reader_ok)"
    # msg <fixed phrase>: the one message holding the phrase, prefixed as the
    # generator prints it; empty unless exactly one holds it.
    msg() {
      local n
      n=$(count_matches -F "$1" "$B/messages")
      if [ "$n" = 1 ]; then printf 'refused: %s' "$(LC_ALL=C "$G" -F "$1" "$B/messages")"; fi
    }
    M_REPO=$(msg 'under the repository')
    M_TIER=$(msg 'unknown tier')
    M_USAGE=$(msg 'usage: scale-gen.py')
    M_HAS=$(msg 'already has a workbook in the manifest')
    M_PART=$(msg 'partial file')
    M_HEADER=$(msg 'manifest header')
    M_FILE=$(msg 'already in the corpus')
    M_ANCHOR=$(msg 'the anchor the generator expects')
    for v in M_REPO M_TIER M_USAGE M_HAS M_PART M_HEADER M_FILE M_ANCHOR; do
      check "the phrase for $v picks exactly one message" "$(ynnot [ -z "${!v}" ])"
    done
    check "control: a phrase no message holds picks none" "$(yn [ -z "$(msg 'no such phrase anywhere')" ])"
    
    echo
    echo "### the cases"
    # run_gen <case> <generator> <args...>: run it, keeping status, stdout and
    # stderr; prints nothing (it is called outside a check).
    run_gen() {
      local k=$1 g=$2
      shift 2
      python3 "$g" "$@" >"$B/$k.stdout" 2>"$B/$k.stderr"
      echo $? >"$B/$k.status"
    }
    status_is() { [ "$(cat "$B/$1.status")" = "$2" ]; }
    refused_with() { status_is "$1" 1 && [ ! -s "$B/$1.stdout" ] && [ -n "$2" ] && [ "$(cat "$B/$1.stderr")" = "$2" ]; }
    # listing <dir>: every path under it with its sha256 (a directory as "dir"),
    # sorted; "absent" when it does not exist.
    listing() {
      if [ -e "$1" ]; then
        (cd "$1" && find . -mindepth 1 | LC_ALL=C sort | while IFS= read -r p; do
          if [ -d "$p" ]; then printf '%s dir\n' "$p"; else printf '%s %s\n' "$p" "$(sha256sum <"$p" | cut -d' ' -f1)"; fi
        done)
      else
        echo absent
      fi
    }
    same_listing() { listing "$1" | cmp -s - "$2"; }
    GEN_FORM='^generated t [0-9a-f]{12} [0-9]+ [0-9a-f]{64} sheet_bytes=[0-9]+ seconds=[0-9]+[.][0-9]$'
    generated_ok() { status_is "$1" 0 && [ ! -s "$B/$1.stderr" ] && [ "$(count_lines "$B/$1.stdout")" = 1 ] && [ "$(count_matches -E "$GEN_FORM" "$B/$1.stdout")" = 1 ]; }
    show() { echo "  $1: exit $(cat "$B/$1.status"); stdout lines $(count_lines "$B/$1.stdout"); stderr: $(cat "$B/$1.stderr")"; }
    tree_clean() { [ -z "$(git -C "$TREE" status --porcelain --ignored)" ]; }
    
    echo "R1: the target is the worktree's root"
    listing "$TREE" >"$B/r1.before"
    run_gen r1 "$GEN" t "$TREE"; show r1
    check "R1 refused with the repository message" "$(yn refused_with r1 "$M_REPO")"
    check "R1 wrote nothing in the worktree (listing and hashes unchanged)" "$(yn same_listing "$TREE" "$B/r1.before")"
    check "R1 left the worktree clean, ignored files included" "$(yn tree_clean)"
    
    echo "R2: the target is a directory under the worktree that does not exist yet"
    run_gen r2 "$GEN" t "$TREE/scale"; show r2
    check "R2 refused with the repository message" "$(yn refused_with r2 "$M_REPO")"
    check "R2 did not create the directory" "$(ynnot [ -e "$TREE/scale" ])"
    check "R2 left the worktree clean, ignored files included" "$(yn tree_clean)"
    
    echo "R3: the target is a symbolic link outside the worktree pointing into it"
    mkdir -p "$TREE/inside"
    ln -s "$TREE/inside" "$B/link"
    echo "  the link resolves to <tree>/inside: $(yn [ "$(readlink -f "$B/link")" = "$TREE/inside" ])"
    listing "$TREE/inside" >"$B/r3.before"
    run_gen r3 "$GEN" t "$B/link"; show r3
    check "R3 refused with the repository message" "$(yn refused_with r3 "$M_REPO")"
    check "R3 wrote nothing through the link" "$(yn same_listing "$TREE/inside" "$B/r3.before")"
    rmdir "$TREE/inside"; rm "$B/link"
    
    echo "R4: unknown tiers"
    run_gen r4e "$GEN" e "$B/r4"; show r4e
    run_gen r4A "$GEN" A "$B/r4"; show r4A
    check "R4 tier e refused with the tier message" "$(yn refused_with r4e "$M_TIER")"
    check "R4 tier A refused with the tier message" "$(yn refused_with r4A "$M_TIER")"
    check "R4 created no target" "$(ynnot [ -e "$B/r4" ])"
    
    echo "R5: the wrong argument count"
    run_gen r5a "$GEN"; show r5a
    run_gen r5b "$GEN" t; show r5b
    run_gen r5c "$GEN" t "$B/r5" extra; show r5c
    check "R5 no argument refused with the usage" "$(yn refused_with r5a "$M_USAGE")"
    check "R5 one argument refused with the usage" "$(yn refused_with r5b "$M_USAGE")"
    check "R5 an extra argument refused with the usage" "$(yn refused_with r5c "$M_USAGE")"
    check "R5 created no target" "$(ynnot [ -e "$B/r5" ])"
    
    echo "R6: tier t generated, then the same call again without --force"
    T6=$B/r6
    run_gen r6a "$GEN" t "$T6"; echo "  r6a: exit $(cat "$B/r6a.status"); stdout lines $(count_lines "$B/r6a.stdout"); stderr bytes $(wc -c <"$B/r6a.stderr")"
    check "R6 the first call generates (exit 0, one line of the documented form, no stderr)" "$(yn generated_ok r6a)"
    ID6=$(cut -d' ' -f3 "$B/r6a.stdout")
    rows_t() { awk -F"$TAB" 'NR > 1 && $9 == "scale,tiert" { n++ } END { print n + 0 }' "$1/manifest.tsv"; }
    files_in() { find "$1/corpus" -type f | wc -l; }
    one_of_each() { [ "$(rows_t "$1")" = 1 ] && [ "$(files_in "$1")" = 1 ] && [ -f "$1/corpus/$2.xlsx" ]; }
    echo "  manifest rows tagged scale,tiert: $(rows_t "$T6"); files in the corpus: $(files_in "$T6")"
    check "R6 one manifest row and one workbook, named by the printed id" "$(yn one_of_each "$T6" "$ID6")"
    listing "$T6" >"$B/r6.before"
    run_gen r6b "$GEN" t "$T6"; show r6b
    check "R6 the second call without --force refused with the manifest message" "$(yn refused_with r6b "$M_HAS")"
    check "R6 the target unchanged (manifest and workbook by sha256)" "$(yn same_listing "$T6" "$B/r6.before")"
    check "control: refused_with refuses the first call, which passed" "$(ynnot refused_with r6a "$M_HAS")"
    check "control: refused_with refuses the right case with another message" "$(ynnot refused_with r6b "$M_PART")"
    check "control: refused_with refuses an empty message" "$(ynnot refused_with r6b "")"
    check "control: generated_ok refuses the refused call" "$(ynnot generated_ok r6b)"
    printf 'x\n' >"$B/c-listing"
    check "control: same_listing refuses a listing one line off" "$(ynnot same_listing "$T6" "$B/c-listing")"
    
    echo "R7: the same call with --force"
    run_gen r7 "$GEN" t "$T6" --force; echo "  r7: exit $(cat "$B/r7.status"); stdout lines $(count_lines "$B/r7.stdout"); stderr bytes $(wc -c <"$B/r7.stderr")"
    check "R7 generates (exit 0, one line of the documented form, no stderr)" "$(yn generated_ok r7)"
    ID7=$(cut -d' ' -f3 "$B/r7.stdout")
    echo "  manifest rows tagged scale,tiert: $(rows_t "$T6"); files in the corpus: $(files_in "$T6"); id the same as R6's: $(yn [ "$ID7" = "$ID6" ])"
    check "R7 still one manifest row and one workbook, named by the same id" "$(yn one_of_each "$T6" "$ID6")"
    check "R7 the id is R6's (deterministic)" "$(yn [ "$ID7" = "$ID6" ])"
    check "R7 no partial file left" "$(ynnot [ -e "$T6/.tier-t.xlsx.part" ])"
    check "control: one_of_each refuses another id" "$(ynnot one_of_each "$T6" 000000000000)"
    
    echo "R8: a leftover partial file, no --force"
    T8=$B/r8; mkdir -p "$T8"; printf 'partial\n' >"$T8/.tier-t.xlsx.part"
    listing "$T8" >"$B/r8.before"
    P8=$(sha_of "$T8/.tier-t.xlsx.part")
    run_gen r8 "$GEN" t "$T8"; show r8
    check "R8 refused with the partial-file message" "$(yn refused_with r8 "$M_PART")"
    check "R8 the partial file unchanged" "$(yn [ "$(sha_of "$T8/.tier-t.xlsx.part")" = "$P8" ])"
    check "R8 no manifest written" "$(ynnot [ -e "$T8/manifest.tsv" ])"
    check "R8 no workbook written" "$(yn [ "$(find "$T8" -name '*.xlsx' | wc -l)" = 0 ])"
    check "R8 the target exactly as before: no corpus directory either (attempt 2)" "$(yn same_listing "$T8" "$B/r8.before")"
    
    echo "R9: a manifest with another header"
    T9=$B/r9; mkdir -p "$T9"; printf 'id\tsha256\n' >"$T9/manifest.tsv"
    listing "$T9" >"$B/r9.before"
    run_gen r9 "$GEN" t "$T9"; show r9
    check "R9 refused with the header message" "$(yn refused_with r9 "$M_HEADER")"
    check "R9 the target exactly as before: the manifest unchanged, no corpus directory, no workbook (attempt 2)" "$(yn same_listing "$T9" "$B/r9.before")"
    check "R9 no workbook written" "$(yn [ "$(find "$T9" -name '*.xlsx*' | wc -l)" = 0 ])"
    
    echo "R10: the workbook's file already in the corpus, with no manifest row"
    T10=$B/r10; mkdir -p "$T10/corpus"; cp "$T6/corpus/$ID6.xlsx" "$T10/corpus/"
    listing "$T10" >"$B/r10.before"
    run_gen r10 "$GEN" t "$T10"; show r10
    check "R10 refused with the corpus-file message" "$(yn refused_with r10 "$M_FILE")"
    check "R10 the target unchanged: the file by sha256, no partial file, no manifest" "$(yn same_listing "$T10" "$B/r10.before")"
    
    echo "R11: the crate's template without the sheetData anchor"
    BR=$B/broken
    mkdir -p "$BR/scripts" "$BR/crates/emend"
    cp "$GEN" "$BR/scripts/scale-gen.py"
    cp -r "$TREE/crates/emend/template" "$BR/crates/emend/template"
    SH=$BR/crates/emend/template/xl/worksheets/sheet1.xml
    n_anchor=$(count_matches -F '<sheetData/>' "$SH")
    sed -i 's#<sheetData/>##' "$SH"
    echo "  the copy's worksheet held the anchor on $n_anchor line(s); after the edit $(count_matches -F '<sheetData/>' "$SH")"
    check "R11 the edit removed the one anchor" "$(yn [ "$n_anchor" = 1 ] )"
    run_gen r11 "$BR/scripts/scale-gen.py" t "$B/r11"; show r11
    check "R11 refused with the anchor message" "$(yn refused_with r11 "$M_ANCHOR")"
    check "R11 the target never created: no partial file, no manifest, no corpus directory (attempt 2)" "$(yn [ "$(listing "$B/r11")" = absent ])"
    mkdir -p "$B/r11-ctl/corpus"; echo absent >"$B/c-absent-listing"
    check "control: a target that is only an empty corpus directory is not absent (same listing form)" "$(ynnot same_listing "$B/r11-ctl" "$B/c-absent-listing")"
    check "control: an absent target lists as absent (same listing form)" "$(yn same_listing "$B/r11-ctl-none" "$B/c-absent-listing")"
    
    echo
    echo "### every message of the source reached by a case"
    for k in r1 r2 r3 r4e r4A r5a r5b r5c r6b r8 r9 r10 r11; do sed 's/^refused: //' "$B/$k.stderr"; echo; done | LC_ALL=C "$G" -v '^$' | LC_ALL=C sort -u >"$B/reached.set"
    LC_ALL=C sort -u "$B/messages" >"$B/messages.set"
    echo "  the source's messages $(count_lines "$B/messages.set"); reached $(count_lines "$B/reached.set")"
    all_reached() { cmp -s "$B/messages.set" "$B/reached.set"; }
    check "the messages reached are exactly the source's, as sets" "$(yn all_reached)"
    sed '1d' "$B/reached.set" >"$B/c-reached"
    reached_ctl() { cmp -s "$B/messages.set" "$B/c-reached"; }
    check "control: the same comparison refuses the reached set one message short" "$(ynnot reached_ctl)"
    
    git worktree remove --force "$TREE" >/dev/null 2>&1
    check "the worktree is gone from git's list" "$(yn [ "$(git worktree list --porcelain | count_matches -F "$TREE" /dev/stdin)" = 0 ])"
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.stdout "$B"/*.stderr; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or record or planning's spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's logs or record or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/negative.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

