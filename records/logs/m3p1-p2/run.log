    git show "$C:tools/emend-copy/src/main.rs" |
      LC_ALL=C "$G" -oE 'flag == "--[a-z-]+-sample"' | sed -E 's/^flag == "--(.*)-sample"$/\1/' |
      awk '!seen[$0]++' >"$B/samples-all"
    LC_ALL=C "$G" -vxF new "$B/samples-all" >"$B/samples-run-all"
    if [ -n "${SAMPLES:-}" ]; then printf '%s\n' $SAMPLES >"$B/samples"; else cp "$B/samples-run-all" "$B/samples"; fi
    # Every run directory and record stem this log will write, refused at entry
