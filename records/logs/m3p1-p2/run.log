    #!/usr/bin/env bash
    # Milestone 3 part 1 P2 run.log (specs/0023-scale.md, "The runs", "What is
    # measured and how it is read", "32-bit", "P2: the runs", the planning
    # verification and rulings on P1 3 to 7 and the planning rulings during P2
    # 1 to 4):
    #   1. the release binaries built at the phase commit on both targets and
    #      hashed; the pinned LibreOffice image present;
    #   2. TMPDIR exported as <scaletmp>, a directory on the disk under the
    #      scale directory, mode 700 (P1 verification ruling 4), and proved to
    #      reach the tool before any run (P2 ruling 3): the runner drives a
    #      stand-in copy tool that prints only whether its TMPDIR is the export,
    #      in a scratch run directory; a control with TMPDIR set elsewhere must
    #      print no;
    #   3. the runs: tiers a, b, d, c in that order; the 24 samples, the
    #      --<name>-sample flags of tools/emend-copy at the phase commit less
    #      --new-sample (P1 verification ruling 3); host then i686; one run
    #      directory per tier per sample, <scale>/runs/<utc-date>-<shortsha>-
    #      scale-<tier>-<sample>, both labels in it (P2 ruling 1); the runner
    #      unchanged with --memory 2048 --timeout 3600 on both labels,
    #      --libreoffice on tier a only, the host xlsx-diff for both labels on
    #      tier c; TMPDIR counted (files and bytes) before and after every run,
    #      0 after a completed run, a killed run's leftovers counted, removed
    #      and logged as a finding; one record pair per run directory,
    #      records/m3p1-scale-<tier>-<sample>-<utc-date>-<shortsha>.md and .txt,
    #      from the record script unchanged;
    #   4. the derivations (derive.py, printed below): a table per tier; the
    #      memory class per sample and label from tiers a and b (streams when
    #      tier b's peak RSS is under twice tier a's and under 64 MiB, else
    #      loads), beside the P1 survey's prediction, disagreements counted as
    #      findings; tier c's outcome per sample and label (ok, error with the
    #      tool's message, killed) beside the prediction after the grid fix,
    #      disagreements counted as findings; the zip64 check on tier c's input
    #      (its sheet entry's uncompressed size over 2^32, printed whole) before
    #      tier c's rows count; throughput, output bytes over wall time, per
    #      run and per label and tier; the 32-bit control on in_bytes,
    #      out_bytes and the sheet entry's sizes, with a planted truncation
    #      caught by the same comparison;
    #   5. the record pairs counted, installed and checked for paths; the
    #      status; this script's own standard error counted.
    # A run that errors, times out or is killed is a finding the derivations
    # print, never a failure of this log; the log fails only on its own
    # structural checks.
    #
    # CARRIED from part 4d P1's run script (records/logs/m2p4d-p1/run.log): the
    # standard error kept in <scripts>/out/run.stderr and counted at the end
    # (specs/0017 P1 verification ruling 7); the environment inputs on labelled
    # lines; the phase commit given, a full sha, compared with HEAD, with the
    # null-commit control (and, from P1 verification ruling 1, a short-sha
    # control); the entry status check against this phase's patterns; the scrub
    # of every printed line, with a root line per placeholder; the three shape
    # greps over this script before its log, here with ynnot in the helper set;
    # the roles by subject; the spec pinned by the hash of its committed blob;
    # the rerun note with superseded files hashed; SERIALIZED and the distinct
    # roots; the script and the sourced counting library printed, the counting
    # controls; the scripts the run uses checked against the phase commit; the
    # release builds into <build>/target; the record pairs written into
    # <scripts>/out/records and installed into RECORDS_DEST, refusing a file in
    # place; the no-path check on the records; the status after the run. New
    # for this phase: items 2 to 5 above. Not carried: the keep, the edit open
    # check and the comparison script, which this phase does not have.
    #
    # Dry runs (never logged) set SCALE, TIERS, SAMPLES, RECORDS_DEST and
    # RUN_BUILD_ROOT; each is printed as an input, and a dry run's last line
    # says so. The logged run sets none of them.
    #
    # Usage: m3p1-p2-run.sh <phase commit> <this phase's test.log> > <file>
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    PHASE_DIR=$(dirname "$SELF_DIR")
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    TEST_LOG=${2:?this phase test.log required}
