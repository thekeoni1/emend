    echo
    echo "## the test.log given"
    echo "command: read the test.log given (sha256 $(sha_of "$TEST_LOG"), $(wc -c <"$TEST_LOG") bytes)"
    tl_is_phase() { [ "$(count_matches -E "^about: M3 part 1 P2 phase commit $C; HEAD at run: $C\$" "$TEST_LOG")" = 1 ]; }
    tl_all_yes() { [ "$(count_matches -xF 'test log checks all as expected: yes' "$TEST_LOG")" = 1 ]; }
    check "the test.log is about this phase commit, run at it" "$(yn tl_is_phase)"
    check "the test.log ends all as expected" "$(yn tl_all_yes)"
    printf 'about: M3 part 1 P2 phase commit %s; HEAD at run: %s\ntest log checks all as expected: no\n' "$C" "$C" >"$B/c-test.log"
    tl_ctl() { local TEST_LOG=$B/c-test.log; tl_all_yes; }
    check "control: the same check refuses a test.log that ends no" "$(ynnot tl_ctl)"
    
    echo
    echo "## the release binaries, built here at the phase commit, both targets"
    echo "command: cargo build --release -p emend-copy -p xlsx-diff; the same with --target $I686"
    cargo build --release -p emend-copy -p xlsx-diff >"$B/build-host.out" 2>&1 </dev/null
    rc_h=$?
    cargo build --release -p emend-copy -p xlsx-diff --target "$I686" >"$B/build-i686.out" 2>&1 </dev/null
    rc_i=$?
    echo "  exit: host $rc_h, $I686 $rc_i"
    check "both release builds exit 0" "$(yn [ "$((rc_h + rc_i))" = 0 ])"
    PT_host=$CARGO_TARGET_DIR/release/emend-copy
    XD_host=$CARGO_TARGET_DIR/release/xlsx-diff
    PT_i686=$CARGO_TARGET_DIR/$I686/release/emend-copy
    XD_i686=$CARGO_TARGET_DIR/$I686/release/xlsx-diff
    for b in "$PT_host" "$XD_host" "$PT_i686" "$XD_i686"; do echo "  $b: sha256 $(sha_of "$b"), bytes $(stat -c %s "$b")"; done
    echo "  $(rustc --version)"
    echo "  on tier c both labels' runs take the host xlsx-diff, $XD_host (decision 4); the record names it by the sha256 the runner prints"
    
    echo
    echo "## the samples and the tiers"
    echo "command: git show <phase commit>:tools/emend-copy/src/main.rs | grep -oE 'flag == \"--[a-z-]+-sample\"', in source order, less new"
    echo "  the tool's sample flags: $(count_lines "$B/samples-all"); less --new-sample: $(count_lines "$B/samples-run-all")"
    sed 's/^/    /' "$B/samples-run-all"
    check "the tool has 25 sample flags and --new-sample is one of them (specs/0023, Facts)" "$(yn [ "$(count_lines "$B/samples-all")" = 25 ])"
    check "24 samples run, --new-sample left out (P1 verification ruling 3)" "$(yn [ "$(count_lines "$B/samples-run-all")" = 24 ])"
    printf 'edit\nnew\nstyle\n' >"$B/c-samples"
    c_left() { [ "$(LC_ALL=C "$G" -vxF new "$B/c-samples" | count_lines /dev/stdin)" = 2 ]; }
    check "control: the same filter leaves two of a planted three with new among them" "$(yn c_left)"
    echo "  the samples this run takes: $(count_lines "$B/samples")$([ -n "${SAMPLES:-}" ] && echo " (SAMPLES set: a dry run's subset)")"
    echo "  the tiers this run takes, in order: $TIERS"
    tier_id() { awk -F"$TAB" -v tag="scale,tier$1" 'NR > 1 && $9 == tag { print $1 }' "$SCALE/manifest.tsv"; }
    for tier in $TIERS; do
      id=$(tier_id "$tier")
      echo "  tier $tier: id ${id:-none}"
      one_id() { [ "$(printf '%s\n' "$id" | LC_ALL=C "$G" -cE '^[0-9a-f]{12}$')" = 1 ]; }
      check "tier $tier has one id in the scale manifest" "$(yn one_id)"
      printf '%s\n' "$id" >"$B/ids-$tier"
    done
    echo "  run directories: $(count_lines "$B/plan"); each holds both labels; record pairs to write: $(count_lines "$B/plan")"
    # The zip64 case (P1 ruling 1): tier c's sheet entry's uncompressed size over
    # 2^32, read from the input's central directory before any tier c row counts.
    cat >"$B/sheet-size.py" <<'PY'
    import sys, zipfile
    with zipfile.ZipFile(sys.argv[1]) as z:
        i = z.getinfo("xl/worksheets/sheet1.xml")
        print(i.file_size)
    PY
    over_u32() { python3 -c 'import sys; sys.exit(0 if sys.argv[1].isdigit() and int(sys.argv[1]) > 2**32 else 1)' "$1"; }
    for tier in $TIERS; do
      if [ "$tier" = c ]; then
        cid=$(cat "$B/ids-c")
        csz=$(python3 "$B/sheet-size.py" "$SCALE/corpus/$cid.xlsx")
        echo "command: python3 zipfile, the central directory's uncompressed size of xl/worksheets/sheet1.xml in tier c's input"
        echo "  tier c sheet entry uncompressed: $csz bytes; 2^32 = 4294967296"
        check "tier c's sheet entry is over 2^32, so tier c is the zip64 case" "$(yn over_u32 "$csz")"
        check "control: the same comparison refuses the figure truncated to 32 bits ($((csz % 4294967296)))" "$(ynnot over_u32 "$((csz % 4294967296))")"
      fi
    done
    
    echo
    echo "## TMPDIR on the disk, and the proof that it reaches the tool (P1 verification ruling 4, P2 ruling 3)"
    mkdir -p "$SCALE_TMP" && chmod 700 "$SCALE_TMP"
    echo "  <scaletmp>: mode $(stat -c %a "$SCALE_TMP"); filesystem $(stat -f -c %T "$SCALE_TMP")"
    check "<scaletmp> is mode 700" "$(yn [ "$(stat -c %a "$SCALE_TMP")" = 700 ])"
    tmp_files() { find "$SCALE_TMP" -mindepth 1 | wc -l; }
    tmp_bytes() { find "$SCALE_TMP" -type f -printf '%s\n' | awk '{ s += $1 } END { print s + 0 }'; }
    echo "  at entry: files $(tmp_files), bytes $(tmp_bytes)"
    check "<scaletmp> is empty at entry" "$(yn [ "$(tmp_files)" = 0 ])"
    # The stand-in copy tool: copies its input to its output and prints only
    # whether its TMPDIR is the export; the export's path is written into the
    # stand-in's own text, never passed through the environment it tests.
    cat >"$B/standin.sh" <<EOF
    #!/usr/bin/env bash
    cp -- "\$1" "\$2" || exit 2
    if [ "\${TMPDIR:-}" = "$SCALE_TMP" ]; then echo "tmpdir is the export: yes"; else echo "tmpdir is the export: no"; fi
    EOF
    chmod 700 "$B/standin.sh"
    echo "  the stand-in tool:"; sed 's/^/    /' "$B/standin.sh"
    first_tier=$(printf '%s\n' $TIERS | head -n 1)
    proof() {
      local tmp=$1 out=$2
      TMPDIR=$tmp scripts/passthrough-run.sh --label host --passthrough "$B/standin.sh" --xlsx-diff "$XD_host" \
        --corpus "$SCALE" --ids "$B/ids-$first_tier" --out "$out" --memory "$MEMORY_MIB" --timeout "$TIMEOUT_S" \
        >"$out.runner" 2>&1 </dev/null
    }
    mkdir -p "$B/othertmp"
    echo "command: TMPDIR=<scaletmp> scripts/passthrough-run.sh --label host --passthrough <scratch>/w/standin.sh --xlsx-diff <host xlsx-diff> --corpus <scale> --ids <tier $first_tier's id> --out <scratch>/w/proof --memory $MEMORY_MIB --timeout $TIMEOUT_S; the same with TMPDIR=<scratch>/w/othertmp into <scratch>/w/proof-ctl"
    proof "$SCALE_TMP" "$B/proof"; rc_p=$?
    proof "$B/othertmp" "$B/proof-ctl"; rc_c=$?
    pid=$(cat "$B/ids-$first_tier")
    echo "  runner exits: $rc_p and $rc_c; the stand-in's stdout: $(cat "$B/proof/$pid/stdout.host.txt" 2>/dev/null); the control's: $(cat "$B/proof-ctl/$pid/stdout.host.txt" 2>/dev/null)"
    proof_says() { [ "$(cat "$1/$pid/stdout.host.txt" 2>/dev/null)" = "tmpdir is the export: $2" ]; }
    check "the runner passes the exported TMPDIR through to the tool" "$(yn proof_says "$B/proof" yes)"
    check "control: with TMPDIR set elsewhere the same stand-in says no" "$(yn proof_says "$B/proof-ctl" no)"
    check "control: the same check refuses the control's run read as a yes" "$(ynnot proof_says "$B/proof-ctl" yes)"
    echo "  <scaletmp> after the proof: files $(tmp_files), bytes $(tmp_bytes)"
    check "the proof left nothing in <scaletmp> (the runner's own working directory removed at its exit)" "$(yn [ "$(tmp_files)" = 0 ])"
    export TMPDIR=$SCALE_TMP
    echo "  exported for the runs: TMPDIR=<scaletmp>"
    
    echo
    echo "## the runs: tiers $TIERS; host then i686; one run directory per tier per sample"
    echo "  disk available under <scale> before the runs: $(df -B1 --output=avail "$SCALE" | tail -n 1 | tr -d ' ') bytes"
    : >"$B/leftovers"
    : >"$B/rows"
    runner_ok() { [ "$1" = 0 ]; }
    one_row() { [ -f "$1/summary.$2.tsv" ] && [ "$(count_lines "$1/summary.$2.tsv")" = 2 ]; }
    while IFS="$TAB" read -r tier s dir stem; do
      echo
      echo "### tier $tier, --$s-sample: <scale>/runs/$RUN_PREFIX-$tier-$s"
      for label in host i686; do
        if [ "$label" = host ]; then PT=$PT_host XD=$XD_host; else PT=$PT_i686 XD=$XD_i686; fi
        if [ "$tier" = c ]; then XD=$XD_host; fi
        lo_args=()
        if [ "$tier" = a ]; then lo_args=(--libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S"); fi
        f0=$(tmp_files); b0=$(tmp_bytes)
        echo "  $label: started $(date -u +%Y-%m-%dT%H:%M:%SZ); <scaletmp> before: files $f0, bytes $b0"
        echo "  command: TMPDIR=<scaletmp> scripts/passthrough-run.sh --label $label --passthrough $PT --xlsx-diff $XD --corpus <scale> --ids <tier $tier's id> --out <scale>/runs/$RUN_PREFIX-$tier-$s --memory $MEMORY_MIB --timeout $TIMEOUT_S ${lo_args[*]} --tool-arg --$s-sample"
        scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --corpus "$SCALE" \
          --ids "$B/ids-$tier" --out "$dir" --memory "$MEMORY_MIB" --timeout "$TIMEOUT_S" ${lo_args[@]+"${lo_args[@]}"} \
          --tool-arg "--$s-sample" >"$B/runner.out" 2>"$B/runner.err" </dev/null
        rc=$?
        echo "  runner exit $rc; its stdout (id, label, outcome, diff exit, wall s, peak RSS kB; then the counts):"
        sed 's/^/    /' "$B/runner.out"
        if [ -s "$B/runner.err" ]; then echo "  runner stderr:"; sed 's/^/    /' "$B/runner.err"; fi
        check "tier $tier $s $label: the runner exits 0" "$(yn runner_ok "$rc")"
        check "tier $tier $s $label: the summary holds its one row" "$(yn one_row "$dir" "$label")"
        f1=$(tmp_files); b1=$(tmp_bytes)
        echo "  $label: ended $(date -u +%Y-%m-%dT%H:%M:%SZ); <scaletmp> after: files $f1, bytes $b1"
        if [ "$f1" != 0 ]; then
          printf '%s\t%s\t%s\t%s\t%s\n' "$tier" "$s" "$label" "$f1" "$b1" >>"$B/leftovers"
          echo "  FINDING: the run left $f1 file(s), $b1 bytes, in <scaletmp>; counted here and removed"
          find "$SCALE_TMP" -mindepth 1 -delete
          echo "  <scaletmp> after the removal: files $(tmp_files), bytes $(tmp_bytes)"
        fi
        printf '%s\t%s\t%s\t%s\n' "$tier" "$s" "$label" "$dir" >>"$B/rows"
      done
      echo "  command: scripts/passthrough-record.py --run <scale>/runs/$RUN_PREFIX-$tier-$s --out <scripts>/out/records --stem $stem"
      scripts/passthrough-record.py --run "$dir" --out "$RECORDS" --stem "$stem" >"$B/record.out" 2>&1
      rc=$?
      echo "  record script exit $rc"
      sed 's/^/    /' "$B/record.out"
      pair_there() { [ "$1" = 0 ] && [ -s "$RECORDS/$stem.md" ] && [ -s "$RECORDS/$stem.txt" ]; }
      check "tier $tier $s: the record pair is written" "$(yn pair_there "$rc")"
    done <"$B/plan"
    echo
    echo "  leftovers in <scaletmp> after a run, all runs: $(count_lines "$B/leftovers") run(s)"
    sed 's/^/    /' "$B/leftovers"
    
    echo
    echo "## the derivations (derive.py, printed here; python3, standard library)"
    cat >"$B/derive.py" <<'PY'
    """The derivations of specs/0023 "What is measured and how it is read" over
    the run directories this log wrote. Reads each run directory's
    summary.<label>.tsv and entries.<label>.tsv, the workbook's
    stderr.<label>.txt in its subdirectory, and
    the input's size; prints counts, outcomes and the tool's message when its
    shape is a constant's, never a value from a workbook. Exit 1 when a
    structural check fails; a disagreement with a prediction is a finding and
    never fails."""
    import os, re, sys
    
    rows_file, scale, full = sys.argv[1], sys.argv[2], sys.argv[3] == "yes"
    U32 = 2 ** 32
    LOADS = {"validate", "cf", "table", "comment", "names"}
    C_OK = {"edit-formula", "delete-rows", "insert-columns", "delete-columns", "link", "props",
            "protect", "sheet", "remove"}
    C_GRID = {"format", "validate", "cf", "scale", "table", "comment", "image", "edit", "style",
              "font", "border", "date", "formula"}
    C_OFF = {"insert-rows"}
    C_KILLED = {"names"}
    GRID = "a row or column index or count is out of range"
    OFF = "a row or column would be moved off the worksheet"
    MSG = re.compile(r"^error: [A-Za-z0-9 ,.;:()'_/-]{1,200}$")
    bad = 0
    
    
    def check(label, ok):
        global bad
        print("  %s: %s" % (label, "yes" if ok else "no"))
        if not ok:
            bad += 1
    
    
    def predicted_c(s):
        if s in C_OK:
            return "ok"
        if s in C_GRID:
            return "error: " + GRID
        if s in C_OFF:
            return "error: " + OFF
        if s in C_KILLED:
            return "killed"
        return "none"
    
    
    def tsv(path):
        with open(path, encoding="utf-8") as f:
            lines = f.read().split("\n")
        head = lines[0].split("\t")
        return [dict(zip(head, l.split("\t"))) for l in lines[1:] if l]
    
    
    def message(d, rid, label):
        p = os.path.join(d, rid, "stderr.%s.txt" % label)
        try:
            lines = open(p, encoding="utf-8", errors="replace").read().splitlines()
        except OSError:
            return "(no stderr file)"
        if not lines:
            return "(empty)"
        return lines[0] if MSG.match(lines[0]) else "(not printed: not a constant's shape)"
    
    
    def measured_c(r, msg):
        if r["outcome"] == "ok":
            return "ok"
        if r["outcome"] == "error":
            return msg
        return "killed"
    
    
    runs = []
    for line in open(rows_file):
        tier, s, label, d = line.rstrip("\n").split("\t")
        summ = tsv(os.path.join(d, "summary.%s.tsv" % label))
        check("tier %s %s %s: one summary row" % (tier, s, label), len(summ) == 1)
        if len(summ) != 1:
            continue
        r = summ[0]
        ents = [e for e in tsv(os.path.join(d, "entries.%s.tsv" % label))]
        sheet = [e for e in ents if e["name"] == "xl/worksheets/sheet1.xml"]
        runs.append({"tier": tier, "s": s, "label": label, "d": d, "r": r, "sheet": sheet[0] if sheet else None,
                     "msg": message(d, r["id"], label)})
    
    tiers = []
    for x in runs:
        if x["tier"] not in tiers:
            tiers.append(x["tier"])
    
    print()
    print("### the runs, per tier")
    cols = ("outcome", "exit", "signal", "wall_s", "peak_rss_kb", "in_bytes", "out_bytes", "diff_exit",
            "identical", "recompressed", "changed", "leftover", "lo", "lo_in")
    for t in tiers:
        print()
        print("tier %s: sample label %s message" % (t, " ".join(cols)))
        for x in runs:
            if x["tier"] == t:
                r = x["r"]
                print("  %s %s %s %s" % (x["s"], x["label"], " ".join(r[c] or "-" for c in cols),
                                         x["msg"] if r["outcome"] != "ok" else "-"))
        n = sum(1 for x in runs if x["tier"] == t)
        oc = {}
        for x in runs:
            if x["tier"] == t:
                oc[x["r"]["outcome"]] = oc.get(x["r"]["outcome"], 0) + 1
        print("  tier %s: runs %d; by outcome %s" % (t, n, " ".join("%s %d" % kv for kv in sorted(oc.items()))))
    
    if full:
        check("the runs number 192: four tiers, 24 samples, two labels", len(runs) == 192)
    else:
        print("  dry run: runs %d; the 192-run check is not made" % len(runs))
    
    print()
    print("### the memory class per sample and label, from tiers a and b")
    print("streams when tier b's peak RSS is under twice tier a's and under 65536 kB (64 MiB); else loads.")
    print("predicted: loads for %s (the tool's second write into memory, P1 survey); streams for the rest." %
          ", ".join(sorted(LOADS)))
    by = {(x["tier"], x["s"], x["label"]): x for x in runs}
    dis_class = 0
    compared = 0
    if "a" in tiers and "b" in tiers:
        for x in runs:
            if x["tier"] != "a":
                continue
            a = x
            b = by.get(("b", x["s"], x["label"]))
            if b is None:
                continue
            ra, rb = a["r"]["peak_rss_kb"], b["r"]["peak_rss_kb"]
            if not (ra.isdigit() and rb.isdigit()):
                meas = "unknown"
            else:
                meas = "streams" if int(rb) < 2 * int(ra) and int(rb) < 65536 else "loads"
            pred = "loads" if x["s"] in LOADS else "streams"
            agree = meas == pred
            compared += 1
            if not agree:
                dis_class += 1
            print("  %s %s: tier a %s kB (%s), tier b %s kB (%s); measured %s; predicted %s; %s" % (
                x["s"], x["label"], ra, a["r"]["outcome"], rb, b["r"]["outcome"], meas, pred,
                "agrees" if agree else "DISAGREES (a finding)"))
        print("  compared %d; disagreements %d (findings, never a failure)" % (compared, dis_class))
    else:
        print("  not derived: tiers a and b are not both in this run")
    
    print()
    print("### tier c: the outcome per sample and label, beside the prediction after the grid fix")
    dis_c = 0
    if "c" in tiers:
        zc = [x for x in runs if x["tier"] == "c"]
        for x in zc:
            r = x["r"]
            meas = measured_c(r, x["msg"])
            pred = predicted_c(x["s"])
            agree = meas == pred
            if not agree:
                dis_c += 1
            print("  %s %s: outcome %s, exit %s, signal %s; measured %s; predicted %s; %s" % (
                x["s"], x["label"], r["outcome"], r["exit"] or "-", r["signal"] or "-", meas, pred,
                "agrees" if agree else "DISAGREES (a finding)"))
        print("  tier c runs %d; disagreements %d (findings, never a failure)" % (len(zc), dis_c))
        if full:
            check("every sample has a tier c prediction",
                  all(predicted_c(x["s"]) != "none" for x in zc))
    else:
        print("  not derived: tier c is not in this run")
    
    print()
    print("### throughput: output bytes over wall time, per ok run and per label and tier")
    for t in tiers:
        for label in ("host", "i686"):
            ok = [x for x in runs if x["tier"] == t and x["label"] == label and x["r"]["outcome"] == "ok"
                  and x["r"]["out_bytes"].isdigit() and x["r"]["wall_s"]]
            ob = sum(int(x["r"]["out_bytes"]) for x in ok)
            ws = sum(float(x["r"]["wall_s"]) for x in ok)
            rate = "%.1f" % (ob / ws / 1e6) if ws > 0 else "-"
            print("  tier %s %s: ok runs %d; output bytes %d; wall s %.2f; MB/s %s" % (t, label, len(ok), ob, ws, rate))
            for x in ok:
                w = float(x["r"]["wall_s"])
                print("    %s: %s bytes / %s s = %s MB/s" % (x["s"], x["r"]["out_bytes"], x["r"]["wall_s"],
                                                           "%.1f" % (int(x["r"]["out_bytes"]) / w / 1e6) if w > 0 else "-"))
    
    print()
    print("### the 32-bit control (specs/0023 \"32-bit\")")
    print("tier c's archive is under 2^32 (its in_bytes); the u32 case is its sheet entry's uncompressed size.")
    
    
    def over(n):
        return n.isdigit() and int(n) > U32
    
    
    def whole(fig, real):
        return fig.isdigit() and int(fig) == real
    
    
    if "c" in tiers:
        for x in runs:
            if x["tier"] != "c":
                continue
            r = x["r"]
            inp = os.path.join(scale, "corpus", r["id"] + ".xlsx")
            real_in = os.path.getsize(inp)
            check("tier c %s %s: in_bytes %s printed whole, the input's size %d" % (x["s"], x["label"], r["in_bytes"], real_in),
                  whole(r["in_bytes"], real_in))
            if r["outcome"] == "ok":
                outp = os.path.join(x["d"], r["id"], "out.%s.xlsx" % x["label"])
                real_out = os.path.getsize(outp) if os.path.exists(outp) else -1
                check("tier c %s %s: out_bytes %s printed whole, the output's size %d" % (x["s"], x["label"], r["out_bytes"], real_out),
                      whole(r["out_bytes"], real_out))
                e = x["sheet"]
                if e is not None:
                    ui, uo = e["uncompressed_in"], e["uncompressed_out"]
                    print("  tier c %s %s: sheet entry status %s; uncompressed in %s, out %s" % (x["s"], x["label"], e["status"], ui, uo))
                    check("tier c %s %s: the sheet entry's uncompressed sizes are whole and over 2^32" % (x["s"], x["label"]),
                          over(ui) and over(uo))
                else:
                    check("tier c %s %s: the diff's entries name the sheet entry" % (x["s"], x["label"]), False)
        first = next((x for x in runs if x["tier"] == "c" and x["sheet"] is not None), None)
        if first is not None:
            n = first["sheet"]["uncompressed_in"]
            t = str(int(n) % U32)
            print("  planted truncation: %s read as %s (mod 2^32)" % (n, t))
            check("control: the same comparison refuses the truncated figure", not over(t))
            check("control: and accepts the whole one", over(n))
    else:
        print("  not derived: tier c is not in this run")
    
    print()
    print("findings: class disagreements %d; tier c outcome disagreements %d" % (dis_class, dis_c))
    print("derive structural checks failed: %d" % bad)
    sys.exit(1 if bad else 0)
    PY
    sed 's/^/    /' "$B/derive.py"
    FULL=no
    if [ "$DRY" = no ]; then FULL=yes; fi
    echo "command: python3 <scratch>/w/derive.py <the rows this log ran> <scale> $FULL"
    python3 "$B/derive.py" "$B/rows" "$SCALE" "$FULL" >"$B/derive.out" 2>"$B/derive.err"
    rc_d=$?
    cat "$B/derive.out"
    if [ -s "$B/derive.err" ]; then echo "  derive.py stderr:"; sed 's/^/    /' "$B/derive.err"; fi
    check "the derivations ran and their structural checks all passed (exit $rc_d)" "$(yn [ "$rc_d" = 0 ])"
    
    echo
    echo "## the record pairs"
    n_plan=$(count_lines "$B/plan")
    n_md=0 n_txt=0
    while IFS="$TAB" read -r tier s dir stem; do
      [ -s "$RECORDS/$stem.md" ] && n_md=$((n_md + 1))
      [ -s "$RECORDS/$stem.txt" ] && n_txt=$((n_txt + 1))
    done <"$B/plan"
    n_files=$(find "$RECORDS" -maxdepth 1 -type f -name "$STEM_PREFIX-*" | wc -l)
    echo "  run directories $n_plan; .md $n_md; .txt $n_txt; files in <scripts>/out/records $n_files"
    pairs_ok() { [ "$n_md" = "$n_plan" ] && [ "$n_txt" = "$n_plan" ] && [ "$n_files" = "$((2 * n_plan))" ]; }
    check "one record pair per run directory and nothing else" "$(yn pairs_ok)"
    if [ "$DRY" = no ]; then
      check "the record pairs number 96 (P2 ruling 1)" "$(yn [ "$n_plan" = 96 ])"
    fi
    pairs_ctl() { local n_md=$((n_plan - 1)); pairs_ok; }
    check "control: the same check refuses one .md short" "$(ynnot pairs_ctl)"
    # The path form, built from pieces so this script's own text holds no bare
    # home shape (specs/0001, the scan rules).
    PATH_FORM="(/ho""me/|/m""nt/|/Us""ers/|/t""mp/|emend-testing)"
    no_path() {
      local f
      for f in "$RECORDS"/"$STEM_PREFIX"-*; do
        [ "$(count_matches -F "$HOME" "$f")" = 0 ] || return 1
        [ "$(count_matches -E "$PATH_FORM" "$f")" = 0 ] || return 1
      done
    }
    check "no record file names <home>, a home, mount, temporary or corpus path" "$(yn no_path)"
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/scale/x' >"$B/c-path"
    path_ctl() { [ "$(count_matches -E "$PATH_FORM" "$B/c-path")" = 1 ]; }
    check "control: the same form finds a planted path" "$(yn path_ctl)"
    echo "command: mv <scripts>/out/records/$STEM_PREFIX-* $RECORDS_DEST/, refusing a file in place"
    install_ok=yes
    while IFS="$TAB" read -r tier s dir stem; do
      for ext in md txt; do
        if [ -e "$RECORDS_DEST/$stem.$ext" ]; then install_ok=no; else mv "$RECORDS/$stem.$ext" "$RECORDS_DEST/" || install_ok=no; fi
      done
    done <"$B/plan"
    check "every pair installed into $RECORDS_DEST/, none in place before" "$(yn [ "$install_ok" = yes ])"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  planning's uncommitted spec: $SPEC, sha256 $(sha_of "$SPEC")"
    echo "status lines: $st_all; of them this phase's logs, its record pairs or planning's uncommitted spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    printf '?? records/m3p1-scale-c-edit-formula-2026-01-01-%s.md\n?? records/m3p1-gen-2026-01-01-%s.md\n M specs/0023-scale.md\n' "$SHORT" "$SHORT" >"$B/c-status"
    check "control: the same pattern takes a scale record and planning's spec and not another phase's record" "$(yn [ "$(count_matches -E "$OURS" "$B/c-status")" = 2 ])"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ "$DRY" = yes ]; then echo "this was a DRY RUN; it is never a logged attempt"; fi
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

