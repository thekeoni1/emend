                if last is not None and local(last.tag)[1] == "oneCellAnchor" and local(last.tag)[0] in XDR:
                    kind, col, rw, embed = got_pics[-1] if got_pics else (None, None, None, None)
                    ext = [el for el in last if local(el.tag)[1] == "ext"]
                    ids = [el.get("id") for el in last.iter() if local(el.tag)[1] == "cNvPr"]
                    resolved = None
                    if extra["drawing_rels"] is not None:
