            want_d = ddata[:end] + anchor(x, a_p, r_p, dstrict, row, ident, rid_m) + ddata[end:]
            rel_el = b'<Relationship Id="' + rid_m + b'" Type="' + form + b'/image" Target="' + target + b'"/>'
            if drels in names:
                want_dr = before_end(zin.read(drels), rel_el)
            else:
                want_dr = package_prefix(zin) + b'<Relationships xmlns="' + RELS.encode() + b'">' + rel_el + b"</Relationships>"
            images_in = len(pictures(ddata))
            anchors_in = len(list(ET.fromstring(ddata)))
        st = {"root_ns": root_ns}
    
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, wout, extra, st)
            if changed is not None:
                wout, extra = changed
                planted = True
    
        flags = dict.fromkeys(FLAGS, False)
        ots, ote, oa, ob, orp = root_span(wout)
        kout = children(wout, oa, ob, orp, root_ns)
        dr_out = [(x, y) for (x, y, nm) in kout if nm == DR]
        flags["root_tag"] = wout[ots:ote] == want_tag and wout[:ots] == win[:its]
        cut_in = cut(win, [(its, ite)])
        cut_out = cut(wout, [(ots, ote)] + (dr_out if made else []))
        flags["rest_same"] = cut_in == cut_out
