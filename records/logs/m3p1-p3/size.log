    #      same crates as emend,xml's.
    #  BB. The core built with each of dates, rowcol, metadata, rules, tables,
    #      comments and images off and on, alone, on both targets: sixteen
    #      builds.
    #  BC. The comparison is with part 4c's record, rebuilt at its commit
    #      3c5f0b7 and reproducing part 4c P3's log's sha256 first; all nineteen
    #      of its probes are compared.
    #  BD. The cause control, as AT: the size-probe manifest, touched by this
    #      phase's probe commit, is listed apart and accounts for no verdict.
    #  BE. The core's growth is the format probe at the phase commit over the
    #      same probe rebuilt at 3c5f0b7 in the comparison's scratch clone, with
    #      a check that no commit after 3c5f0b7 touched the probe's own source
    #      and, as its control, the same count finding bcaa31d's change between
    #      b728fdf and 3c5f0b7. The budget figure's predecessor is read from part
    #      4c's record. Beside the two features' costs, the tables, rules,
    #      metadata, rowcol and dates features' costs measured here.
    #  BF. The generated packages run the comments probe and the images probe,
    #      on the two-sheet package, with the format probe's arguments, the
    #      comments probe then the author probe_author and the text probe_note.
    #      The comment's or image's cell AB10 is each probe's constant, past
    #      every edit the format probe's arguments name. Each prints the format
    #      probe's lines with its own third output's size, then comments 1 or
    #      images 1, with a control; its first and third outputs are the
    #      fullstyles and sheets probes' byte for byte; its second output is
    #      read by ElementTree and by bytes: the sheet's root children with the
    #      created legacyDrawing or drawing, the relationships and Overrides, the
    #      comment with its author and text and the note shape with idmap 1, id
    #      _x0000_s1025 and Row 9, Column 27; the drawing part's exact bytes as
    #      "Images: the parts" gives them, its rels part and the media entry
    #      byte-equal to the 82-byte PNG. Each with a control over the format
    #      probe's second output. The tables, rules and metadata probes' runs
    #      and checks are kept.
    #  BG. The hash lines name the comments and images probes where part 4c's
    #      named the tables probe: four release binaries, the budget probe and
    #      the two features' probes, seven lines, which the run log reads.
    #  BH. The record is written as size-m2p4d-<utc-date>-<shortsha>.md, its
    #      sha256 printed; the rerun line names <home>/.cache/emend-build/
    #      m2p4d-p4/superseded.
    #
    # CARRIED TO M3 part 1 P3 from M2 part 4d P4's size script (printed in
    # records/logs/m2p4d-p4/size.log; its change list AY to BH is above, and its
    # own header is kept as history above), generated by
    # <home>/.cache/emend-build/m3p1-p3/gen/size.py, which asserts each
    # replacement once, audited against specs/0001 "Rules for every phase" and
    # specs/0023, and grepped for part 4d P4's names, paths, subjects, hashes and
    # typed lists (m2p4d, 0022, 3c5f0b7, nineteen, part 4c). What differs, and
    # why:
    #  BI. The phase is M3 part 1 P3: <scripts> is <home>/.cache/emend-build/
    #      m3p1-p3/scripts, the build directory <home>/.cache/emend-build/
    #      m3p1-p3/size (refused if already there; SIZE_BUILD_ROOT points a dry
    #      run elsewhere), and the commits by their full subjects over P2's
    #      record commit ("M3 part 1 P2 record:"): the doc commit and ONE code
    #      commit, the catalogue, which is the phase commit.
    #  BJ. The spec is specs/0023, committed at P3's doc commit: the pin
    #      SPEC_SHA is compared with the phase commit's copy; planning's
    #      uncommitted specs/0023, should a ruling stand there, is accounted by
    #      the entry guard and the status block.
    #  BK. No probe changes (specs/0023 "Size"): the twenty-one probes are part
    #      4d's, every one compared with part 4d's record and none new; the
    #      count is read from the probe crate's [[bin]] list at the phase
    #      commit, not typed.
    #  BL. The comparison is with part 4d's record, rebuilt at its commit
    #      c1f6602 and reproducing part 4d P4's log's sha256 first.
    #  BM. The cause control, as AT and BD: the size-probe manifest is listed
    #      apart; no commit of this part touches it, so its count is 0, and a
    #      code verdict is accounted by crates/emend/src, which P2's fix and
    #      P3's catalogue touched.
    #  BN. The part's growth is the format probe at the phase commit over the
    #      same probe rebuilt at c1f6602 in the comparison's scratch clone, with
    #      the check that no commit after c1f6602 touched the probe's own source
    #      and, as its control, the same count finding bcaa31d's change between
    #      b728fdf and c1f6602. It is split by the format probe rebuilt at P2's
    #      fix commit in a second scratch clone: the fix's share (code) and the
    #      catalogue's (expected 0 section bytes and classified as not code,
    #      with a control showing the verdict test refusing code).
    #  BO. The ceiling stays 458752 (ROADMAP's Milestone 3 outline keeps
    #      Milestone 2's); part 4d's headroom is read from its record's budget
    #      figure and checked against the spec's 23528 ("What a finding leads
    #      to"), and this part's growth of the budget figure checked under it.
    #  BP. The release binaries and the hash lines are part 4d's arrangement
    #      unchanged (four release binaries, the budget probe and the comments
    #      and images probes, seven lines), which the run log reads.
    #  BQ. The record is written as size-m3p1-<utc-date>-<shortsha>.md, its
    #      sha256 printed; the rerun line names <home>/.cache/emend-build/
    #      m3p1-p3/superseded. The entry guard and the status block name this
    #      phase's records: its size record, the two corpus sample pairs
    #      m3p1-p3-, the open record m3p1-open-, the three scale read pairs
    #      m3p1-scale-c-cells-, m3p1-scale-d-cells-, m3p1-scale-d-shared-strings-
    #      and the decision record scale-m3p1-.
    #
    # ATTEMPT 2. Attempt 1 (kept under <home>/.cache/emend-build/m3p1-p3/
    # superseded/size-attempt-1 with its build directory and the record it
    # installed, hashed on the rerun lines) measured every figure and failed one
    # check: "the record's figures rows carry the figures this log printed"
    # counted each row's three figures alone, and the part's growth and P2's
    # fix share are the same three figures, so the count was 2. The check now
    # finds each row by its label and its figures, with two controls; nothing
    # else changed.
    #
    # Usage: SPEC_SHA=<sha256> m3p1-p3-size.sh <phase commit> > <scratch file>,
    # run from the repository root; the caller moves the output to
    # records/logs/m3p1-p3/size.log. The record is installed by the script.
    #
    # Every check with more than one condition is a named function, defined on the
    # line before it and called through yn (specs/0001-bootstrap.md, "Rules for
    # every phase"). None of the three shapes that file forbids appears here; the
    # shapes are described rather than written out.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # Change V: every environment input, as it was set, before any is used.
    INPUT_NAMES="SPEC_SHA RERUN_NOTE RERUN_FILES SIZE_BUILD_ROOT RECORDS_DEST CITED_SIZE_LOG RUN_LOG HOME ANTHROPIC_API_KEY"
    declare -A INPUT_SEEN
    for v in $INPUT_NAMES; do
      if [ -n "${!v+x}" ]; then INPUT_SEEN[$v]=${!v}; else INPUT_SEEN[$v]=unset; fi
      # The key's value is never printed, only whether it is set.
      if [ "$v" = ANTHROPIC_API_KEY ] && [ "${INPUT_SEEN[$v]}" != unset ]; then INPUT_SEEN[$v]="set (value not printed)"; fi
    done
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept
    # and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/size.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    SPEC=specs/0023-scale.md
    SPEC_SHA=${SPEC_SHA:-}
    if [ -z "$SPEC_SHA" ]; then echo "SPEC_SHA, the spec's sha256, is a required input (change BJ)" >&2; exit 2; fi
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    # Change U: the logged run leaves SIZE_BUILD_ROOT unset.
    BUILD_ROOT=${SIZE_BUILD_ROOT:-$HOME/.cache/emend-build/m3p1-p3/size}
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    # Change AD: the record's directory, under <repo> when relative.
    RECORDS_DEST=${RECORDS_DEST:-records}
    case "$RECORDS_DEST" in
      /*) REC_DIR=$RECORDS_DEST ;;
      *) REC_DIR=$MAIN/$RECORDS_DEST ;;
    esac
    I686=i686-unknown-linux-musl
    PREV_REC=records/size-m2p4d-2026-10-01-c1f6602.md
    PREV_LOG=records/logs/m2p4d-p4/size.log
    # Part 3's record, which carries the whole growth's base (change BE, kept).
    P3_REC=records/size-m2p3-2026-09-27-b728fdf.md
    # The part's growth base: part 4d's record's commit, after which no commit
    # touched the format probe's own source (specs/0023 "Size"; change BN), and
    # the format probe's section figure in part 3's record, the base of the whole
    # growth.
    CORE_BASE=c1f660235c62e103b21138dd95ae12ea66569400
    # The commit that changed the format probe's source between part 3's record
    # and CORE_BASE, the control's subject (change BE).
    SRC_CHANGE=bcaa31dd3a7916852e664ee339c9d598a882030e
    P3_AT=b728fdf4ea00b7752e2f6d54540a24e0e586887b
    WHOLE_BASE=967884
    # The Milestone 2 ceiling (specs/0017, "The size ceiling", decision 1 taken
    # as A), judged on the core probe since part 3 (specs/0018, decision 7 A).
    CEILING=458752
    # The headroom part 4d left, as specs/0023 "What a finding leads to" names
    # it; checked against part 4d's record's own budget figure (change BO).
    SPEC_HEADROOM=23528
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT INT TERM HUP
    fail=0
    FAILED=()
    check() { echo "$1: $2"; [ "$2" = yes ] || { fail=1; FAILED+=("$1"); }; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # isnot_same <a> <b>: the two files differ (a control's negation, a named
    # function, never a leading bang).
    isnot_same() { if cmp -s "$1" "$2"; then return 1; else return 0; fi; }
    # The whole of stdout is scrubbed below; hide is kept as a pass-through for
    # the blocks that call it.
    hide() { cat; }
    # static_i686_stripped <binary>: file(1) reports a stripped static 32-bit i386 ELF.
    static_i686_stripped() {
      local d
      d=$(file -b "$1")
      [[ "$d" == *"ELF 32-bit LSB executable, Intel i386"* ]] && [[ "$d" == *"statically linked"* ]] && [[ "$d" == *", stripped"* ]]
    }
    # section <binary> <name>: a section's size from `size -A`, or "error".
    section() {
      local out
      out=$(size -A "$1" 2>/dev/null) || { printf 'error'; return; }
      printf '%s\n' "$out" | awk -v s="$2" '$1 == s { print $2; found = 1 } END { if (!found) print "error" }'
    }
    
    # specs/0001 "Rules for every phase": the phase commit is GIVEN to the script
    # and compared with HEAD, both printed, with a control that refuses a
    # fabricated commit. The hard guard is here, before a line of log exists.
    HEAD_SHA=$(git rev-parse HEAD)
    NULL_SHA=0000000000000000000000000000000000000000
    full_sha() {
      printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'
    }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    not_head() { if is_head "$1"; then return 1; else return 0; fi; }
    if is_head "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    # Change U: the build directory is this run's alone; a rerun moves the old one
    # aside first.
    if [ -e "$BUILD_ROOT" ]; then echo "$BUILD_ROOT is already there; move it aside first" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    # The entry guard (changes AZ and BQ): every change must be under this phase's log
    # directory, or be one of its record pairs or its size record, or planning's
    # uncommitted spec.
    OURS_RE='^((\?\?| ?[MARCD]) (records/logs/m3p1-p3|records/(size-m3p1-|m3p1-p3-|m3p1-open-|m3p1-scale-[cd]-(shared-strings|cells)-|scale-m3p1-))| M specs/0023-scale[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS_RE" git status --porcelain)
    entry_clean() {
      [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]
    }
    if entry_clean; then :; else echo "the working tree holds changes outside this phase's records" >&2; exit 2; fi
    
    # Every printed line passes through this scrub; the script's directory and
    # the build directory lie inside <home>, so they are scrubbed before it.
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$T#<scratch>/w#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M3 part 1 P3 phase commit $C; HEAD at run: $HEAD_SHA"
    # Change V: the environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001; P1 check 1's F4)"
    # specs/0001: the scan greps every printed script for three forbidden shapes,
    # and they run here, first, over this script's own file, each with a positive
    # control through the same command form. The patterns and the fixture are
    # assembled from pieces at run time, so this script's text holds none of them.
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    SHAPE_DIR=$(mktemp -d -p "$T")
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$SHAPE_DIR/fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$SHAPE_DIR/fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      SHAPE_RESULT_SELF=$n_self
      SHAPE_RESULT_FIX=$n_fix
      check "$shape: this script holds none" "$(yn [ "$SHAPE_RESULT_SELF" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$SHAPE_RESULT_FIX" = 1 ])"
    done
    rm -rf "$SHAPE_DIR"
    
    echo
    echo
    echo "## the phase's commits by role, read from git (change BI)"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M3 part 1 P2 record: ')
    DOC=$(by_subject 'M3 part 1 P3: commit planning docs (the P2 rulings and verification)')
    CODE1=$(by_subject 'M3 part 1 P3: the package header'"'"'s block "What streams and what is held"')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  P2's record commit: ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  code commit 1, the catalogue: ${CODE1:-none}"
    echo "command: git rev-parse <phase commit> <phase commit>^ <phase commit>^^"
    git rev-parse "$C" "$C^" "$C^^" | sed 's/^/    /'
    roles_in_order() {
      [ -n "$REC" ] && [ -n "$DOC" ] && [ -n "$CODE1" ] || return 1
      [ "$CODE1" = "$C" ] || return 1
      [ "$(git rev-parse "$C^")" = "$DOC" ] || return 1
      [ "$(git rev-parse "$C^^")" = "$REC" ]
    }
    check "code commit 1 is the phase commit, the doc commit its parent, P2's record commit the doc commit's" "$(yn roles_in_order)"
    roles_ctl() { local DOC=$CODE1; if roles_in_order; then return 1; else return 0; fi; }
    check "control: roles_in_order refuses code commit 1 named as the doc commit" "$(yn roles_ctl)"
    no_such_subject() { [ -z "$(by_subject 'M3 part 1 P3: no such subject anywhere')" ]; }
    check "control: a subject no commit has resolves to nothing" "$(yn no_such_subject)"
    echo
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $HEAD_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn is_head "$C")"
    check "control: the same comparison refuses the null commit" "$(yn not_head "$NULL_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" \
      "$(yn not_head "$(printf '%s' "$C" | cut -c1-7)")"
    echo "phase: Milestone 3 part 1 P3 ($SPEC) size.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "rerun: a superseded attempt and its build directory are moved into <home>/.cache/emend-build/m3p1-p3/superseded before a rerun (change BQ)"
      # specs/0001 "Rules for every phase": every sha256 a log cites, a superseded
      # attempt's included, is PRINTED BY A COMMAND run over a file that exists at
      # run time, never typed from memory.
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    # SERIALIZED as the coordinator arranged, backed by a measurement at entry
    # (P2 verification ruling 6).
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight (the coordinator's arrangement); cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory, <build>/target (CARGO_TARGET_DIR)"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to (it lies inside <home>, so it is scrubbed first); scripts/counting.sh is sourced from it, and every committed file this log reads is read from it or from git"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scripts> stands for <home>/.cache/emend-build/m3p1-p3/scripts on the disk, this script's own directory, which holds the script and, in <scripts>/out, its own standard error (specs/0017 P1 verification ruling 7) and nothing this log builds"
    echo "root: <build> stands for the build directory, <home>/.cache/emend-build/m3p1-p3/size on the disk unless the input SIZE_BUILD_ROOT names another; <build>/target is this log's target directory (the size probes and the release binaries the run log reads back)"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory (the fixtures, the outputs, the scratch clone at part 4d P4's commit with its own target, and the second scratch clone at P2's fix commit with its own target)"
    echo "the record's directory: $REC_DIR (the input RECORDS_DEST, default records under <repo>)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$T" "$SELF_DIR" && apart "$T" "$BUILD_ROOT" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$BUILD_ROOT" "$MAIN"; }
    check "the three roots are distinct directories, none inside another, and <build> is outside <repo>" "$(yn roots_distinct)"
    roots_ctl() { if apart "$BUILD_ROOT/target" "$BUILD_ROOT"; then return 1; else return 0; fi; }
    check "control: apart refuses a directory inside another" "$(yn roots_ctl)"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    # Change V: the key, by whether it is set, with a control through the same
    # function over a value set here.
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_ctl() { local ANTHROPIC_API_KEY=x; if key_unset; then return 1; else return 0; fi; }
    check "control: the same test says set for a shell where it is set" "$(yn key_ctl)"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR; CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS"
    echo "at entry: status lines $entry_all, of them this phase's logs and records $entry_ours"
    # Change AP, kept (BQ): the entry guard's form, with controls: a listing that holds a
    # source file modified is refused by the same count, and one that holds
    # planning's uncommitted spec beside this phase's logs is accepted.
    printf '%s\n' "?? records/logs/m3p1-p3/" " M crates/emend/src/package.rs" >"$T/entry-ctl"
    entry_ctl_all=$(count_lines "$T/entry-ctl")
    entry_ctl_ours=$(count_matches -E "$OURS_RE" "$T/entry-ctl")
    entry_ctl() { if [ "$entry_ctl_all" = "$entry_ctl_ours" ]; then return 1; else return 0; fi; }
    check "control: the entry guard's count refuses a listing with a source file modified ($entry_ctl_ours of $entry_ctl_all lines this phase's)" "$(yn entry_ctl)"
    printf '%s\n' "?? records/logs/m3p1-p3/" " M $SPEC" >"$T/entry-ctl2"
    entry_ctl2() { [ "$(count_lines "$T/entry-ctl2")" = "$(count_matches -E "$OURS_RE" "$T/entry-ctl2")" ]; }
    check "control: the entry guard accepts planning's uncommitted spec beside this phase's logs" "$(yn entry_ctl2)"
    # Change AP: the committed spec against the pin at the phase commit, with a
    # control; the working tree's copy printed, not the pin.
    spec_now=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "  the spec: $SPEC, sha256 $spec_committed at the phase commit; the pin, the input SPEC_SHA: $SPEC_SHA; the working tree's copy (planning's, printed, not the pin): $spec_now"
    spec_ok() { [ "$spec_committed" = "$SPEC_SHA" ]; }
    check "the spec at the phase commit is at the pin" "$(yn spec_ok)"
    spec_ctl() { local SPEC_SHA=${SPEC_SHA}0; if spec_ok; then return 1; else return 0; fi; }
    check "control: the same comparison refuses the pin with a character appended" "$(yn spec_ctl)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## toolchain"
    RUSTC=$(rustc --version)
    CARGO=$(cargo --version)
    echo "$RUSTC"
    echo "$CARGO"
    echo "installed targets for the pinned toolchain:"
    rustup target list --installed | sed 's/^/    /'
    echo "command: size --version"
    size --version | head -1 | sed 's/^/    /'
    
    echo
    echo "## manifests at $C"
    for f in Cargo.toml tools/size-probe/Cargo.toml crates/emend/Cargo.toml; do
      echo "$f (sha256 $(git show "$C:$f" | sha256sum | cut -d' ' -f1)):"
      git show "$C:$f" | sed 's/^/    /'
    done
    ZIP_V=$(awk '$0 == "name = \"zip\"" { getline; gsub(/^version = "|"$/, ""); print; exit }' Cargo.lock)
    QX_V=$(awk '$0 == "name = \"quick-xml\"" { getline; gsub(/^version = "|"$/, ""); print; exit }' Cargo.lock)
    echo "Cargo.lock: zip $ZIP_V; quick-xml $QX_V"
    check "zip in Cargo.lock is 8.6.0" "$(yn [ "$ZIP_V" = 8.6.0 ])"
    check "quick-xml in Cargo.lock is 0.42.0" "$(yn [ "$QX_V" = 0.42.0 ])"
    
    echo
    echo "## dependency trees, by feature"
    tree_count() {
      # tree_count <features or empty> <crate>: lines naming that crate in the
      # normal-edge tree, or "error" if cargo tree failed.
      local out rc
      if [ -n "$1" ]; then
        out=$(cargo tree -p size-probe --features "$1" -e normal --prefix none --target "$I686" --offline 2>/dev/null); rc=$?
      else
        out=$(cargo tree -p size-probe -e normal --prefix none --target "$I686" --offline 2>/dev/null); rc=$?
      fi
      [ "$rc" -eq 0 ] || { printf 'error'; return; }
      printf '%s\n' "$out" | awk -v c="$2" '$1 == c { n++ } END { print n + 0 }'
    }
    for feat in "" xml emend emend,xml dates rowcol metadata rules tables comments images; do
      label=${feat:-none}
      echo "command: cargo tree -p size-probe ${feat:+--features $feat} -e normal --prefix none --target $I686 --offline"
      if [ -n "$feat" ]; then
        cargo tree -p size-probe --features "$feat" -e normal --prefix none --target "$I686" --offline 2>&1 | hide | sed 's/^/    /'
      else
        cargo tree -p size-probe -e normal --prefix none --target "$I686" --offline 2>&1 | hide | sed 's/^/    /'
      fi
      echo "  features $label: quick-xml lines $(tree_count "$feat" quick-xml); emend lines $(tree_count "$feat" emend)"
    done
    no_feature_is_bare() { [ "$(tree_count "" quick-xml)" = 0 ] && [ "$(tree_count "" emend)" = 0 ]; }
    check "with no feature, neither quick-xml nor emend is in the tree (probe-zip is built as the baseline was)" \
      "$(yn no_feature_is_bare)"
    xml_alone_is_xml() { [ "$(tree_count xml quick-xml)" -ge 1 ] && [ "$(tree_count xml emend)" = 0 ]; }
    check "with xml alone, quick-xml is in and emend is not (probe-zip-xml and probe-zip-xml-write are built as the baseline was)" \
      "$(yn xml_alone_is_xml)"
    # This check is NOT part 1's. Part 1 asserted that with the emend feature alone
    # quick-xml was absent from the tree, which was true when emend depended on zip
    # only. Part 2 P1 added quick-xml to the CORE, so quick-xml is now in the tree
    # whenever emend is, brought by emend rather than by the probe's own optional
    # dependency. Part 2 P3's size log is where that wording was corrected: its
    # first run carried part 1's sentence and failed on it, the figures being right
    # and the sentence stale (records/logs/m1p2-p3/size.log). The check asserts what
    # the manifests say.
    emend_alone_brings_quick_xml() {
      [ "$(tree_count emend emend)" -ge 1 ] && [ "$(tree_count emend quick-xml)" -ge 1 ]
    }
    check "with emend alone, emend is in and quick-xml comes with it, the core's own dependency since part 2 P1" \
      "$(yn emend_alone_brings_quick_xml)"
    # And the property that distinguishes the two features after that change: the
    # probe's own optional quick-xml is what feature xml adds, so with NO feature
    # neither crate is there, which the check above this block asserts.
    both_features_both_crates() { [ "$(tree_count emend,xml emend)" -ge 1 ] && [ "$(tree_count emend,xml quick-xml)" -ge 1 ]; }
    check "with emend and xml, both are in (probe-emend-edit-xml and probe-emend-package-xml)" \
      "$(yn both_features_both_crates)"
    # Ruling 7's dates set brings emend and quick-xml as emend,xml does, and no crate
    # beyond them: the feature is emend's own code.
    dates_like_both() {
      [ "$(tree_count dates emend)" -ge 1 ] && [ "$(tree_count dates quick-xml)" -ge 1 ]
    }
    check "with the dates set, emend and quick-xml are in, as with emend and xml" "$(yn dates_like_both)"
    tree_lines() {
      if [ -n "$1" ]; then
        cargo tree -p size-probe --features "$1" -e normal --prefix none --target "$I686" --offline 2>/dev/null | sort -u
      else
        cargo tree -p size-probe -e normal --prefix none --target "$I686" --offline 2>/dev/null | sort -u
      fi
    }
    tree_lines emend,xml >"$T/tree-ex"
    tree_lines dates >"$T/tree-dates"
    same_crates() { [ -s "$T/tree-ex" ] && cmp -s "$T/tree-ex" "$T/tree-dates"; }
    check "the dates set's tree names the same crates as emend and xml's" "$(yn same_crates)"
    # Part 3 P4 change L: the rowcol set likewise, the feature being emend's own code.
    tree_lines rowcol >"$T/tree-rowcol"
    same_crates_rowcol() { [ -s "$T/tree-ex" ] && cmp -s "$T/tree-ex" "$T/tree-rowcol"; }
    check "the rowcol set's tree names the same crates as emend and xml's" "$(yn same_crates_rowcol)"
    # Change X: the metadata set likewise, the feature being emend's own code.
    tree_lines metadata >"$T/tree-metadata"
    same_crates_metadata() { [ -s "$T/tree-ex" ] && cmp -s "$T/tree-ex" "$T/tree-metadata"; }
    check "the metadata set's tree names the same crates as emend and xml's" "$(yn same_crates_metadata)"
    # Change AH: the rules set likewise, the feature being emend's own code.
    tree_lines rules >"$T/tree-rules"
    same_crates_rules() { [ -s "$T/tree-ex" ] && cmp -s "$T/tree-ex" "$T/tree-rules"; }
    check "the rules set's tree names the same crates as emend and xml's" "$(yn same_crates_rules)"
    # Change AQ: the tables set likewise, the feature being emend's own code.
    tree_lines tables >"$T/tree-tables"
    same_crates_tables() { [ -s "$T/tree-ex" ] && cmp -s "$T/tree-ex" "$T/tree-tables"; }
    check "the tables set's tree names the same crates as emend and xml's" "$(yn same_crates_tables)"
    # Change BA: the comments and images sets likewise.
    tree_lines comments >"$T/tree-comments"
    tree_lines images >"$T/tree-images"
    same_crates_comments() { [ -s "$T/tree-ex" ] && cmp -s "$T/tree-ex" "$T/tree-comments"; }
    same_crates_images() { [ -s "$T/tree-ex" ] && cmp -s "$T/tree-ex" "$T/tree-images"; }
    check "the comments set's tree names the same crates as emend and xml's" "$(yn same_crates_comments)"
    check "the images set's tree names the same crates as emend and xml's" "$(yn same_crates_images)"
    # The control, in the same command form: the xml-alone tree names fewer crates,
    # so the comparison can say no.
    tree_lines xml >"$T/tree-x"
    differs_xml() { if cmp -s "$T/tree-ex" "$T/tree-x"; then return 1; else return 0; fi; }
    check "control: the same comparison against the xml-alone tree says they differ" "$(yn differs_xml)"
    # The core's rule from CLAUDE.md, read off the tree rather than asserted: with
    # emend and xml, the tree holds zip, quick-xml, emend and nothing else of
    # emend's own making. flate2 and its zlib-rs backend are zip's, not emend's.
    echo "command: cargo tree -p emend -e normal --prefix none --target $I686 --offline"
    cargo tree -p emend -e normal --prefix none --target "$I686" --offline 2>&1 | hide | sed 's/^/    /'
    core_tree_count() {
      local out rc
      out=$(cargo tree -p emend -e normal --prefix none --target "$I686" --offline 2>/dev/null); rc=$?
      [ "$rc" -eq 0 ] || { printf 'error'; return; }
      printf '%s\n' "$out" | awk -v c="$1" '$1 == c { n++ } END { print n + 0 }'
    }
    echo "  emend's own tree: zip lines $(core_tree_count zip); quick-xml lines $(core_tree_count quick-xml)"
    core_has_both() { [ "$(core_tree_count zip)" -ge 1 ] && [ "$(core_tree_count quick-xml)" -ge 1 ]; }
    check "the core's tree names zip and quick-xml" "$(yn core_has_both)"
    
    echo
    echo "## which of the probe crate's feature sets turn on emend's rowcol, metadata, rules, tables, comments and images (change BA)"
    # Part 3 P4's change L, widened: cargo tree -e features -i emend with each
    # feature set of the probe crate, counted for the features rowcol and
    # metadata. The core probes and the format probe are built with emend,xml,
    # the dates probe with dates, the rowcol probe with rowcol, the metadata
    # probe with metadata; emend-copy turns both on, a second control.
    has_feature() { count_matches -F "feature \"$1\"" "$2"; }
    ftree() {
      # ftree <package> <features or empty> <out>: the inverted feature tree of emend.
      if [ -n "$2" ]; then
        cargo tree -p "$1" --features "$2" -e features -i emend --charset ascii --target "$I686" --offline >"$3" 2>&1 </dev/null
      else
        cargo tree -p "$1" -e features -i emend --charset ascii --target "$I686" --offline >"$3" 2>&1 </dev/null
      fi
    }
    declare -A NROW NMETA NRULES NTABLES NCOMMENTS NIMAGES NEMEND
    for set in emend,xml dates rowcol metadata rules tables comments images; do
      echo "command: cargo tree -p size-probe --features $set -e features -i emend --charset ascii --target $I686 --offline"
      ftree size-probe "$set" "$T/ft-$set"
      sed 's/^/    /' "$T/ft-$set"
      NROW[$set]=$(has_feature rowcol "$T/ft-$set")
      NMETA[$set]=$(has_feature metadata "$T/ft-$set")
      NRULES[$set]=$(has_feature rules "$T/ft-$set")
      NTABLES[$set]=$(has_feature tables "$T/ft-$set")
      NCOMMENTS[$set]=$(has_feature comments "$T/ft-$set")
      NIMAGES[$set]=$(has_feature images "$T/ft-$set")
      NEMEND[$set]=$(count_matches -E '^emend v' "$T/ft-$set")
      echo "  size-probe with $set: lines naming feature \"rowcol\" ${NROW[$set]}; naming feature \"metadata\" ${NMETA[$set]}; naming feature \"rules\" ${NRULES[$set]}; naming feature \"tables\" ${NTABLES[$set]}; naming feature \"comments\" ${NCOMMENTS[$set]}; naming feature \"images\" ${NIMAGES[$set]}; the tree roots at emend ${NEMEND[$set]}"
      check "size-probe with $set: the tree was read, it names emend" "$(yn [ "${NEMEND[$set]}" -ge 1 ])"
    done
    echo "command: cargo tree -p emend-copy -e features -i emend --charset ascii --target $I686 --offline"
    ftree emend-copy "" "$T/ft-copy"
    sed 's/^/    /' "$T/ft-copy"
    NROW_COPY=$(has_feature rowcol "$T/ft-copy")
    NMETA_COPY=$(has_feature metadata "$T/ft-copy")
    NRULES_COPY=$(has_feature rules "$T/ft-copy")
    NTABLES_COPY=$(has_feature tables "$T/ft-copy")
    NCOMMENTS_COPY=$(has_feature comments "$T/ft-copy")
    NIMAGES_COPY=$(has_feature images "$T/ft-copy")
    echo "  emend-copy: lines naming feature \"rowcol\" $NROW_COPY; naming feature \"metadata\" $NMETA_COPY; naming feature \"rules\" $NRULES_COPY; naming feature \"tables\" $NTABLES_COPY; naming feature \"comments\" $NCOMMENTS_COPY; naming feature \"images\" $NIMAGES_COPY"
    check "the core probes' set, emend,xml, turns on no rowcol" "$(yn [ "${NROW[emend,xml]}" = 0 ])"
    check "the core probes' set, emend,xml, turns on no metadata" "$(yn [ "${NMETA[emend,xml]}" = 0 ])"
    check "the dates probe's set turns on no rowcol" "$(yn [ "${NROW[dates]}" = 0 ])"
    check "the dates probe's set turns on no metadata" "$(yn [ "${NMETA[dates]}" = 0 ])"
    check "the rowcol probe's set turns on no metadata" "$(yn [ "${NMETA[rowcol]}" = 0 ])"
    check "the metadata probe's set turns on no rowcol" "$(yn [ "${NROW[metadata]}" = 0 ])"
    check "control: the same count finds the feature rowcol in the rowcol probe's set" "$(yn [ "${NROW[rowcol]}" -ge 1 ])"
    check "control: the same count finds the feature metadata in the metadata probe's set" "$(yn [ "${NMETA[metadata]}" -ge 1 ])"
    check "the core probes' set, emend,xml, turns on no rules" "$(yn [ "${NRULES[emend,xml]}" = 0 ])"
    check "the dates probe's set turns on no rules" "$(yn [ "${NRULES[dates]}" = 0 ])"
    check "the rowcol probe's set turns on no rules" "$(yn [ "${NRULES[rowcol]}" = 0 ])"
    check "the metadata probe's set turns on no rules" "$(yn [ "${NRULES[metadata]}" = 0 ])"
    check "the rules probe's set turns on no rowcol" "$(yn [ "${NROW[rules]}" = 0 ])"
    check "the rules probe's set turns on no metadata" "$(yn [ "${NMETA[rules]}" = 0 ])"
    check "control: the same count finds the feature rules in the rules probe's set" "$(yn [ "${NRULES[rules]}" -ge 1 ])"
    # Change AQ: tables in no set but its own.
    for set in emend,xml dates rowcol metadata rules; do
      check "the $set set turns on no tables" "$(yn [ "${NTABLES[$set]}" = 0 ])"
    done
    check "the tables probe's set turns on no rowcol" "$(yn [ "${NROW[tables]}" = 0 ])"
    check "the tables probe's set turns on no metadata" "$(yn [ "${NMETA[tables]}" = 0 ])"
    check "the tables probe's set turns on no rules" "$(yn [ "${NRULES[tables]}" = 0 ])"
    check "control: the same count finds the feature tables in the tables probe's set" "$(yn [ "${NTABLES[tables]}" -ge 1 ])"
    # Change BA: comments and images each in no set but its own.
    for set in emend,xml dates rowcol metadata rules tables images; do
      check "the $set set turns on no comments" "$(yn [ "${NCOMMENTS[$set]}" = 0 ])"
    done
    for set in emend,xml dates rowcol metadata rules tables comments; do
      check "the $set set turns on no images" "$(yn [ "${NIMAGES[$set]}" = 0 ])"
    done
    for set in comments images; do
      none_other() { [ "${NROW[$set]}" = 0 ] && [ "${NMETA[$set]}" = 0 ] && [ "${NRULES[$set]}" = 0 ] && [ "${NTABLES[$set]}" = 0 ]; }
      check "the $set probe's set turns on none of rowcol, metadata, rules and tables" "$(yn none_other)"
    done
    check "control: the same count finds the feature comments in the comments probe's set" "$(yn [ "${NCOMMENTS[comments]}" -ge 1 ])"
    check "control: the same count finds the feature images in the images probe's set" "$(yn [ "${NIMAGES[images]}" -ge 1 ])"
    copy_has_all() { [ "$NROW_COPY" -ge 1 ] && [ "$NMETA_COPY" -ge 1 ] && [ "$NRULES_COPY" -ge 1 ] && [ "$NTABLES_COPY" -ge 1 ] && [ "$NCOMMENTS_COPY" -ge 1 ] && [ "$NIMAGES_COPY" -ge 1 ]; }
    check "control: the same counts find all six features in emend-copy's tree" "$(yn copy_has_all)"
    
    echo
    echo "## the core built with the dates, rowcol, metadata, rules, tables, comments and images features off and on, both targets (change BB)"
    # Part 3's check, kept and widened (specs/0012 "P3"; specs/0018 decision 7 A;
    # specs/0019 decision 1 A): the crate builds with each feature off and on. A
    # build of the package alone, so no other workspace member unifies a feature
    # on.
    crc=0
    for target in host "$I686"; do
      if [ "$target" = host ]; then tflag=(); else tflag=(--target "$target"); fi
      for feat in none dates rowcol metadata rules tables comments images; do
        if [ "$feat" = none ]; then fflag=(); else fflag=(--features "$feat"); fi
        echo "command: cargo build -p emend ${fflag[*]} ${tflag[*]} --offline"
        cargo build -p emend "${fflag[@]}" "${tflag[@]}" --offline >"$T/core-$feat-$target" 2>&1 </dev/null
        rc=$?
        echo "exit: $rc"
        warns=$(count_matches -E '^(warning|error)' "$T/core-$feat-$target")
        echo "  warning or error lines: $warns"
        core_built() { [ "$rc" -eq 0 ] && [ "$warns" = 0 ]; }
        check "$target, features $feat: cargo build -p emend exits 0 with no warning" "$(yn core_built)"
        [ "$rc" -eq 0 ] || crc=1
      done
    done
    check "all sixteen core builds exit 0" "$(yn [ "$crc" -eq 0 ])"
    
    echo
    echo "## the twenty-one size builds for $I686"
    echo "command: cargo clean -p size-probe --profile size --target $I686"
    cargo clean -p size-probe --profile size --target "$I686" 2>&1 | sed 's/^/    /'
    build() {
      # build <bin> <features or empty>
      local rc
      echo "command: cargo build -p size-probe --bin $1 ${2:+--features $2 }--profile size --target $I686 --offline"
      if [ -n "$2" ]; then
        cargo build -p size-probe --bin "$1" --features "$2" --profile size --target "$I686" --offline >"$T/b-$1" 2>&1 </dev/null; rc=$?
      else
        cargo build -p size-probe --bin "$1" --profile size --target "$I686" --offline >"$T/b-$1" 2>&1 </dev/null; rc=$?
      fi
      echo "exit: $rc"
      return "$rc"
    }
    brc=0
    PROBES_TO_BUILD="probe-zip probe-zip-xml probe-zip-xml-write probe-emend-copy probe-emend-edit probe-emend-edit-xml probe-emend-package-xml probe-emend-cells-xml probe-emend-cells-write-xml probe-emend-styles-write-xml probe-emend-dates-write-xml probe-emend-formulas-write-xml probe-emend-sheets-write-xml probe-emend-fullstyles-write-xml probe-emend-format-write-xml probe-emend-rowcol-write-xml probe-emend-metadata-write-xml probe-emend-rules-write-xml probe-emend-tables-write-xml probe-emend-comments-write-xml probe-emend-images-write-xml"
    # features_of <probe>: the Cargo features that probe needs, as its
    # required-features line in tools/size-probe/Cargo.toml says. ONE map, used by
    # the build here and by both rebuilds in the scratch clones below.
    features_of() {
      case $1 in
        probe-zip) echo "" ;;
        probe-zip-xml | probe-zip-xml-write) echo xml ;;
        probe-emend-copy | probe-emend-edit) echo emend ;;
        probe-emend-edit-xml | probe-emend-package-xml | probe-emend-cells-xml | probe-emend-cells-write-xml) echo emend,xml ;;
        probe-emend-styles-write-xml | probe-emend-formulas-write-xml | probe-emend-sheets-write-xml) echo emend,xml ;;
        probe-emend-fullstyles-write-xml | probe-emend-format-write-xml) echo emend,xml ;;
        probe-emend-dates-write-xml) echo dates ;;
        probe-emend-rowcol-write-xml) echo rowcol ;;
        probe-emend-metadata-write-xml) echo metadata ;;
        probe-emend-rules-write-xml) echo rules ;;
        probe-emend-tables-write-xml) echo tables ;;
        probe-emend-comments-write-xml) echo comments ;;
        probe-emend-images-write-xml) echo images ;;
        *) echo UNKNOWN ;;
      esac
    }
    for b in $PROBES_TO_BUILD; do
      build "$b" "$(features_of "$b")" || brc=1
    done
    check "all twenty-one size builds exit 0" "$(yn [ "$brc" -eq 0 ])"
    # A probe this map does not know would be built with the literal feature
    # UNKNOWN and fail; the control says the map answers for every probe named,
    # and refuses one it has never heard of.
    unknown_feat=$(features_of probe-that-does-not-exist)
    echo "  the feature map's answer for a probe it does not know: $unknown_feat"
    map_knows_all() {
      local b
      for b in $PROBES_TO_BUILD; do
        [ "$(features_of "$b")" != UNKNOWN ] || return 1
      done
      [ "$unknown_feat" = UNKNOWN ]
    }
    check "control: the feature map answers for all twenty-one probes and refuses one it does not know" \
      "$(yn map_knows_all)"
    # The map agrees with the manifest: each probe's required-features line in
    # tools/size-probe/Cargo.toml at the phase commit, read here.
    git show "$C:tools/size-probe/Cargo.toml" >"$T/probe-manifest"
    python3 - "$T/probe-manifest" >"$T/required" <<'REQ_PY'
    import re, sys
    text = open(sys.argv[1]).read()
    for block in text.split("[[bin]]")[1:]:
        name = re.search(r'^name = "([^"]+)"', block, re.M)
        req = re.search(r'^required-features = \[([^]]*)\]', block, re.M)
        feats = [] if req is None else re.findall(r'"([^"]+)"', req.group(1))
        print("%s %s" % (name.group(1), ",".join(feats)))
    REQ_PY
    echo "command: each [[bin]]'s name and required-features in tools/size-probe/Cargo.toml at the phase commit"
    sed 's/^/    /' "$T/required"
    for b in $PROBES_TO_BUILD; do printf '%s %s\n' "$b" "$(features_of "$b")"; done >"$T/mapped"
    LC_ALL=C sort "$T/required" >"$T/required-s"
    LC_ALL=C sort "$T/mapped" >"$T/mapped-s"
    map_is_manifest() { [ -s "$T/required-s" ] && cmp -s "$T/required-s" "$T/mapped-s"; }
    check "the feature map is the manifest's required-features, probe by probe" "$(yn map_is_manifest)"
    sed 's/ images$/ emend,xml/' "$T/mapped-s" >"$T/mapped-ctl"
    check "control: the same comparison refuses the map with the images probe's set replaced by emend,xml" \
      "$(yn isnot_same "$T/required-s" "$T/mapped-ctl")"
    for b in $PROBES_TO_BUILD; do
      warns=$(count_matches -E '^(warning|error)' "$T/b-$b")
      echo "  $b: build output lines $(count_lines "$T/b-$b"), of them warnings or errors $warns"
      check "$b built with no warning and no error line" "$(yn [ "$warns" = 0 ])"
    done
    
    D=$CARGO_TARGET_DIR/$I686/size
    PROBES="probe-zip probe-zip-xml probe-zip-xml-write probe-emend-copy probe-emend-edit probe-emend-edit-xml probe-emend-package-xml probe-emend-cells-xml probe-emend-cells-write-xml probe-emend-styles-write-xml probe-emend-dates-write-xml probe-emend-formulas-write-xml probe-emend-sheets-write-xml probe-emend-fullstyles-write-xml probe-emend-format-write-xml probe-emend-rowcol-write-xml probe-emend-metadata-write-xml probe-emend-rules-write-xml probe-emend-tables-write-xml probe-emend-comments-write-xml probe-emend-images-write-xml"
    check "the probes built and the probes measured are the same list" \
      "$(yn [ "$PROBES" = "$PROBES_TO_BUILD" ])"
    # Every probe part 4d's record tabulates, all twenty-one (change BK), which
    # are also the earlier probes for the largest growth; no probe is new in this
    # part.
    COMPARED=$PROBES
    EARLIER=$COMPARED
    echo "  probes measured: $(printf '%s\n' $PROBES | count_lines /dev/stdin); compared with part 4d's record: $(printf '%s\n' $COMPARED | count_lines /dev/stdin); new: none"
    # The count of probes, read from the probe crate's [[bin]] list at the phase
    # commit (change BK), against the list built and measured.
    N_BINS=$(git show "$C:tools/size-probe/Cargo.toml" | count_matches -Fx '[[bin]]' /dev/stdin)
    N_LIST=$(printf '%s\n' $PROBES | count_lines /dev/stdin)
    echo "command: git show <phase commit>:tools/size-probe/Cargo.toml | count_matches -Fx '[[bin]]': $N_BINS; the probes built and measured: $N_LIST"
    check "the probes built and measured are as many as the manifest's [[bin]] blocks" "$(yn [ "$N_BINS" = "$N_LIST" ])"
    printf '[[bin]]\nname = "x"\n[[bin]]\n' >"$T/bins-ctl"
    check "control: the same count reads 2 in a fixture with two [[bin]] lines" "$(yn [ "$(count_matches -Fx '[[bin]]' "$T/bins-ctl")" = 2 ])"
    # The twenty-one are exactly the probes part 4d's record tabulates, read from
    # it.
    awk -F'|' '$2 ~ /^ `probe-/ { gsub(/^ `|` $/, "", $2); print $2 }' "$PREV_REC" | sort -u >"$T/prev-probes"
    printf '%s\n' $COMPARED | sort -u >"$T/our-compared"
    echo "command: the probe names of $PREV_REC's probes table, sorted: $(count_lines "$T/prev-probes") names"
    check "the twenty-one compared are exactly the probes part 4d's record tabulates" "$(yn cmp -s "$T/prev-probes" "$T/our-compared")"
    printf '%s\n' $PROBES | sort -u | sed '$d' >"$T/our-short"
    check "control: the same comparison says no against the list one probe short" "$(yn isnot_same "$T/prev-probes" "$T/our-short")"
    declare -A FILE SECT TEXT SHA
    echo
    echo "## the figures"
    for b in $PROBES; do
      FILE[$b]=$(stat -c %s "$D/$b")
      SECT[$b]=$(section "$D/$b" Total)
      TEXT[$b]=$(section "$D/$b" .text)
      SHA[$b]=$(sha256sum <"$D/$b" | cut -d' ' -f1)
      echo "$D/$b: file ${FILE[$b]} bytes; sections ${SECT[$b]}; .text ${TEXT[$b]}; sha256 ${SHA[$b]}"
      echo "    $(file -b "$D/$b" | sed 's/, BuildID\[[^]]*\]=[0-9a-f]*//')"
      check "$b is a stripped static i386 ELF" "$(yn static_i686_stripped "$D/$b")"
      figures_read() { [ "${SECT[$b]}" != error ] && [ "${TEXT[$b]}" != error ]; }
      check "$b's section figures were read" "$(yn figures_read)"
    done
    
    # File sizes on this target change in whole 4096-byte steps, but they are NOT
    # whole multiples of a page: every probe carries the same remainder, so it is
    # the DIFFERENCES that come in whole pages (part 1 P3's size log, which failed
    # on the opposite claim before it was corrected).
    REM=$((FILE[probe-zip] % 4096))
    for b in $PROBES; do
      echo "  $b: ${FILE[$b]} = $((FILE[$b] / 4096)) pages of 4096 bytes + $((FILE[$b] % 4096))"
    done
    same_remainder() {
      local b
      for b in $PROBES; do
        [ $((FILE[$b] % 4096)) -eq "$REM" ] || return 1
      done
    }
    check "all twenty-one file sizes leave the same remainder modulo 4096, $REM bytes, so every difference between them is whole pages" \
      "$(yn same_remainder)"
    
    echo
    echo
    echo "## the twenty-one probes of part 4d's record, against it"
    # specs/0023, "Size": classify every probe against part 4d's record and every
    # difference. The figures come from the RECORD, which the
    # spec names; the sha256s come from the log that wrote it, since a record
    # carries no hashes. The commit both were measured at is read from the record
    # rather than from its file name.
    echo "command: read the figures from $PREV_REC (sha256 $(sha256sum <"$PREV_REC" | cut -d' ' -f1))"
    echo "command: read the hashes from $PREV_LOG (sha256 $(sha256sum <"$PREV_LOG" | cut -d' ' -f1))"
    PREV_AT=$(sed -n 's/^- Commit: \([0-9a-f]\{40\}\)$/\1/p' "$PREV_REC")
    LOG_AT=$(sed -n 's/^about: M2 part 4d P4 phase commit \([0-9a-f]*\);.*/\1/p' "$PREV_LOG")
    echo "  the record was measured at $PREV_AT"
    echo "  the log was measured at    $LOG_AT"
    check "part 4d's record names the commit it was measured at" "$(yn [ -n "$PREV_AT" ])"
    check "part 4d P4's log was measured at the same commit as its record" "$(yn [ "$PREV_AT" = "$LOG_AT" ])"
    check "part 4d's record's commit is the core's growth base" "$(yn [ "$PREV_AT" = "$CORE_BASE" ])"
    declare -A WAS_FILE WAS_SECT WAS_TEXT WAS_SHA
    for b in $COMPARED; do
      # The record's row for this probe: the last three cells of its table row.
      row=$(awk -F'|' -v p="\`$b\`" '$2 ~ /^ `probe-/ { gsub(/^ | $/, "", $2); if ($2 == p) { gsub(/ /, "", $4); gsub(/ /, "", $5); gsub(/ /, "", $6); print $4, $5, $6; exit } }' "$PREV_REC")
      WAS_FILE[$b]=$(printf '%s\n' "$row" | awk '{ print $1 }')
      WAS_SECT[$b]=$(printf '%s\n' "$row" | awk '{ print $2 }')
      WAS_TEXT[$b]=$(printf '%s\n' "$row" | awk '{ print $3 }')
      # Part 4d P4's log wrote its target directory as <build>/target.
      WAS_SHA[$b]=$(sed -n "s#^<build>/target/$I686/size/$b: file [0-9]* bytes; sections [0-9]*; \.text [0-9]*; sha256 \([0-9a-f]\{64\}\)\$#\1#p" "$PREV_LOG")
      echo "  $b: then file ${WAS_FILE[$b]}, sections ${WAS_SECT[$b]}, .text ${WAS_TEXT[$b]}, sha256 ${WAS_SHA[$b]}"
      echo "  $b: now  file ${FILE[$b]}, sections ${SECT[$b]}, .text ${TEXT[$b]}, sha256 ${SHA[$b]}"
      read_all() {
        [ -n "${WAS_FILE[$b]}" ] && [ -n "${WAS_SECT[$b]}" ] && [ -n "${WAS_TEXT[$b]}" ] &&
          [ "${#WAS_SHA[$b]}" -eq 64 ]
      }
      check "$b: part 4d's figures and hash were read" "$(yn read_all)"
    done
    
    # What could have moved these figures between the two measurements, listed from
    # git rather than assumed: emend's own source and manifest, each probe's own
    # source, the size-probe manifest, and the workspace
    # manifest and lock file, since the size profile and the dependency versions
    # live there. A probe is accounted for by the commits touching the
    # paths that are ITS OWN causes, which is why this is per probe: probe-zip
    # links no emend, so an emend commit explains nothing about it.
    echo "  what could move these figures, from git:"
    for paths in crates/emend/src crates/emend/Cargo.toml tools/size-probe/src tools/size-probe/Cargo.toml Cargo.toml Cargo.lock; do
      echo "command: git log --oneline $PREV_AT..$C -- $paths"
      git log --oneline "$PREV_AT..$C" -- "$paths" | sed 's/^/    /'
      echo "command: git diff --stat $PREV_AT..$C -- $paths"
      git diff --stat "$PREV_AT..$C" -- "$paths" | sed 's/^/    /'
    done
    # cause_paths <probe>: the paths whose change would explain that probe moving.
    cause_paths() {
      echo Cargo.toml Cargo.lock tools/size-probe/Cargo.toml "tools/size-probe/src/bin/$1.rs"
      case $1 in
        probe-emend-*) echo crates/emend/src crates/emend/Cargo.toml ;;
      esac
    }
    # cause_commits <probe>: how many commits between the two measurements touched
    # them, or "error" if git could not be read.
    cause_commits() {
      # shellcheck disable=SC2046
      run_lines git log --format=%H "$PREV_AT..$C" -- $(cause_paths "$1")
    }
    # Change AT (part 4b's P4 verification ruling 2): the size-probe manifest is
    # listed apart. source_paths <probe> is cause_paths less the manifest;
    # source_commits counts the commits touching those alone; MAN_COMMITS counts
    # the manifest's, the same for every probe.
    MANIFEST=tools/size-probe/Cargo.toml
    source_paths() { cause_paths "$1" | tr ' ' '\n' | LC_ALL=C "$G" -vFx "$MANIFEST" | tr '\n' ' '; }
    source_commits() {
      # shellcheck disable=SC2046
      run_lines git log --format=%H "$PREV_AT..$C" -- $(source_paths "$1")
    }
    MAN_COMMITS=$(run_lines git log --format=%H "$PREV_AT..$C" -- "$MANIFEST")
    echo "command: git log --format=%H $PREV_AT..$C -- $MANIFEST, counted: the manifest cause, listed apart (changes BD and BM)"
    git log --oneline "$PREV_AT..$C" -- "$MANIFEST" | sed 's/^/    /'
    echo "  commits that touched the size-probe manifest between the two measurements: $MAN_COMMITS"
    check "the manifest cause's count was read" "$(yn [ "$MAN_COMMITS" != error ])"
    src_paths_ctl() { [ "$(source_paths probe-zip | tr ' ' '\n' | count_matches -Fx "$MANIFEST" /dev/stdin)" = 0 ] && [ "$(cause_paths probe-zip | tr ' ' '\n' | count_matches -Fx "$MANIFEST" /dev/stdin)" = 1 ]; }
    check "control: source_paths drops the manifest that cause_paths names" "$(yn src_paths_ctl)"
    EMEND_COMMITS=$(run_lines git log --format=%H "$PREV_AT..$C" -- crates/emend/src)
    echo "  commits that touched crates/emend/src between the two measurements: $EMEND_COMMITS"
    check "the count of emend source commits was read" "$(yn [ "$EMEND_COMMITS" != error ])"
    declare -A CAUSES SRC_CAUSES
    for b in $COMPARED; do
      CAUSES[$b]=$(cause_commits "$b")
      SRC_CAUSES[$b]=$(source_commits "$b")
      echo "  $b: its own causes are $(cause_paths "$b" | tr '\n' ' '), touched by ${CAUSES[$b]} commits between the two measurements; its source causes, the manifest apart, $(source_paths "$b"), by ${SRC_CAUSES[$b]}; the manifest cause by $MAN_COMMITS"
      counts_read() { [ "${CAUSES[$b]}" != error ] && [ "${SRC_CAUSES[$b]}" != error ]; }
      check "$b: the counts of commits that could have moved it were read" "$(yn counts_read)"
    done
    
    # The classifier. It reads the ELF32 section table of both files and reports,
    # per section, how many bytes differ, then reaches one of four verdicts.
    cat >"$T/classify.py" <<'CLASSIFY_PY'
    import struct, sys
    
    old = open(sys.argv[1], "rb").read()
    new = open(sys.argv[2], "rb").read()
    
    
    def sections(data):
        shoff, = struct.unpack_from("<I", data, 32)
        shentsize, shnum, shstrndx = struct.unpack_from("<HHH", data, 46)
        heads = [struct.unpack_from("<IIIIII", data, shoff + i * shentsize) for i in range(shnum)]
        names_off = heads[shstrndx][4]
        out = {}
        for h in heads:
            end = data.index(b"\0", names_off + h[0])
            out[data[names_off + h[0]:end].decode()] = (h[4], h[5])
        return out
    
    
    so, sn = sections(old), sections(new)
    same_length = len(old) == len(new)
    same_layout = so == sn
    print("same length: %s" % ("yes" if same_length else "no"))
    print("same section layout: %s" % ("yes" if same_layout else "no"))
    diffs = [i for i in range(min(len(old), len(new))) if old[i] != new[i]]
    print("differing bytes: %d" % len(diffs))
    
    
    def where(i):
        for name, (off, size) in sn.items():
            if name and off <= i < off + size:
                return name
        return "no section"
    
    
    per = {}
    for i in diffs:
        per[where(i)] = per.get(where(i), 0) + 1
    for name in sorted(per):
        print("differing bytes in %s: %d" % (name, per[name]))
    touched = set(per)
    
    # The 4-byte slots in .data.rel.ro that changed, with their deltas: a
    # panic-location line number moves as a small signed change in one slot.
    rel = sn.get(".data.rel.ro")
    deltas = {}
    if rel is not None:
        slots = sorted({i - (i - rel[0]) % 4 for i in diffs if rel[0] <= i < rel[0] + rel[1]})
        for s in slots:
            if s + 4 <= min(len(old), len(new)):
                d = struct.unpack_from("<I", new, s)[0] - struct.unpack_from("<I", old, s)[0]
                deltas[d] = deltas.get(d, 0) + 1
        print(".data.rel.ro slots that changed: %d" % len(slots))
        shown = sorted(deltas.items(), key=lambda kv: -kv[1])[:8]
        print(".data.rel.ro slot deltas, commonest first: %s"
              % (" ".join("%+d x%d" % (d, n) for d, n in shown) or "none"))
    
    if not diffs and same_length and same_layout:
        verdict = "identical"
    elif same_length and same_layout and touched <= {".note.gnu.build-id"}:
        verdict = "build id alone"
    elif same_length and same_layout and touched <= {".note.gnu.build-id", ".data.rel.ro"}:
        verdict = "build id and panic-location line numbers"
    else:
        verdict = "code"
    print("verdict: %s" % verdict)
    CLASSIFY_PY
    
    # The classifier's own controls, in the same command form it is used in: a file
    # against itself must read identical, and a copy with ONE byte flipped inside
    # .text must read as code. Without the second, a classifier that never looked
    # at .text would pass everything as a build id.
    cp "$D/probe-zip" "$T/ctl-same"
    python3 "$T/classify.py" "$D/probe-zip" "$T/ctl-same" >"$T/ctl-same.out" 2>&1
    sed 's/^/    control, a file against itself: /' "$T/ctl-same.out"
    check "control: a file against itself reads identical" \
      "$(yn [ "$(count_matches -Fx 'verdict: identical' "$T/ctl-same.out")" = 1 ])"
    cp "$D/probe-zip" "$T/ctl-flip"
    python3 - "$T/ctl-flip" <<'FLIP_PY'
    import struct, sys
    
    p = sys.argv[1]
    data = bytearray(open(p, "rb").read())
    shoff, = struct.unpack_from("<I", data, 32)
    shentsize, shnum, shstrndx = struct.unpack_from("<HHH", data, 46)
    heads = [struct.unpack_from("<IIIIII", data, shoff + i * shentsize) for i in range(shnum)]
    names_off = heads[shstrndx][4]
    off = None
    for h in heads:
        end = data.index(b"\0", names_off + h[0])
        if data[names_off + h[0]:end] == b".text":
            off = h[4] + 16
    if off is None:
        raise SystemExit("no .text section")
    data[off] ^= 0xFF
    open(p, "wb").write(data)
    print("one byte flipped 16 bytes into .text")
    FLIP_PY
    python3 "$T/classify.py" "$D/probe-zip" "$T/ctl-flip" >"$T/ctl-flip.out" 2>&1
    sed 's/^/    control, one byte flipped in .text: /' "$T/ctl-flip.out"
    flip_is_code() {
      [ "$(count_matches -Fx 'verdict: code' "$T/ctl-flip.out")" = 1 ] &&
        [ "$(count_matches -Fx 'differing bytes in .text: 1' "$T/ctl-flip.out")" = 1 ]
    }
    check "control: one byte flipped in .text reads as code, and is counted in .text" "$(yn flip_is_code)"
    
    # The twenty-one probes rebuilt at part 4d's commit, in a scratch clone. The
    # rebuild is only trusted once it reproduces part 4d P4's log's own sha256,
    # which is what makes the comparison a comparison with that record and not
    # with a build of this session's making.
    O=$T/prev
    git clone --quiet --shared "$MAIN" "$O" 2>/dev/null
    git -C "$O" checkout --quiet "$PREV_AT"
    echo "command: git clone --quiet --shared <repo> <scratch>/w/prev; git -C <scratch>/w/prev checkout --quiet $PREV_AT"
    echo "  the scratch clone's HEAD: $(git -C "$O" rev-parse HEAD)"
    check "the scratch clone is at part 4d's commit" "$(yn [ "$(git -C "$O" rev-parse HEAD)" = "$PREV_AT" ])"
    echo "command: in the scratch clone at $PREV_AT, CARGO_TARGET_DIR=<scratch>/w/prev/target cargo build -p size-probe --bin <probe> [--features ...] --profile size --target $I686 --offline"
    declare -A VERDICT
    # accounted_by <verdict> <source-cause count>: a verdict other than code, or a
    # code verdict with at least one source cause (change BD).
    accounted_by() {
      [ "$1" != code ] || { [ "$2" != error ] && [ "$2" -gt 0 ]; }
    }
    # The controls (part 4b's P4 verification ruling 2): a code verdict with no
    # source cause fails even while the manifest cause is touched; the same
    # verdict with one source cause passes; a verdict other than code passes with
    # none.
    code_no_cause() { if accounted_by code 0; then return 1; else return 0; fi; }
    check "control: a code verdict with no source cause fails the accounting, the manifest cause ($MAN_COMMITS) notwithstanding" "$(yn code_no_cause)"
    check "control: a code verdict with one source cause passes the accounting" "$(yn accounted_by code 1)"
    check "control: a build-id verdict with no source cause passes the accounting" "$(yn accounted_by "build id alone" 0)"
    for b in $COMPARED; do
      feat=$(features_of "$b")
      if [ -n "$feat" ]; then
        ( cd "$O" && CARGO_TARGET_DIR="$O/target" cargo build -p size-probe --bin "$b" --features "$feat" \
            --profile size --target "$I686" --offline ) >"$T/prev-$b.out" 2>&1 </dev/null
      else
        ( cd "$O" && CARGO_TARGET_DIR="$O/target" cargo build -p size-probe --bin "$b" \
            --profile size --target "$I686" --offline ) >"$T/prev-$b.out" 2>&1 </dev/null
      fi
      rc=$?
      then_bin=$O/target/$I686/size/$b
      then_sha=$(sha256sum <"$then_bin" 2>/dev/null | cut -d' ' -f1)
      then_file=$(stat -c %s "$then_bin" 2>/dev/null || echo error)
      echo "  $b rebuilt at $PREV_AT (features ${feat:-none}): build exit $rc; file $then_file; sha256 $then_sha"
      check "$b rebuilt at part 4d's commit reproduces part 4d P4's log's sha256" \
        "$(yn [ "$then_sha" = "${WAS_SHA[$b]}" ])"
      python3 "$T/classify.py" "$then_bin" "$D/$b" >"$T/cl-$b.out" 2>&1
      sed "s/^/    $b: /" "$T/cl-$b.out"
      VERDICT[$b]=$(sed -n 's/^verdict: \(.*\)$/\1/p' "$T/cl-$b.out")
      echo "  $b: classified as ${VERDICT[$b]}"
      check "$b's difference was classified" "$(yn [ -n "${VERDICT[$b]}" ])"
      # A code verdict must be accounted for by a commit that touched one of THIS
      # probe's SOURCE causes (change BD: the manifest, a cause of every probe
      # this phase, is listed apart and accounts for nothing); a code verdict with
      # none would be a difference whose cause this log cannot name, which is a
      # finding, not a pass.
      check "$b: if the verdict is code, a commit that touched one of its source causes is named above" \
        "$(yn accounted_by "${VERDICT[$b]}" "${SRC_CAUSES[$b]}")"
    done
    FIG_UNCHANGED=0
    figures_kept() {
      [ "${WAS_FILE[$1]}" = "${FILE[$1]}" ] && [ "${WAS_SECT[$1]}" = "${SECT[$1]}" ] &&
        [ "${WAS_TEXT[$1]}" = "${TEXT[$1]}" ]
    }
    for b in $COMPARED; do
      if figures_kept "$b"; then
        FIG_UNCHANGED=$((FIG_UNCHANGED + 1))
        echo "  $b keeps all three of part 4d's figures"
      else
        echo "  $b moved: file $((FILE[$b] - WAS_FILE[$b])), sections $((SECT[$b] - WAS_SECT[$b])), .text $((TEXT[$b] - WAS_TEXT[$b]))"
      fi
    done
    N_COMPARED=$(printf '%s\n' $COMPARED | count_lines /dev/stdin)
    echo "  of the $N_COMPARED probes compared, $FIG_UNCHANGED keep every figure of part 4d's"
    # Tallies of the verdicts, for the record's sentence.
    declare -A VCOUNT
    for b in $COMPARED; do
      vk=${VERDICT[$b]:-none}; VCOUNT[$vk]=$(( ${VCOUNT[$vk]:-0} + 1 ))
    done
    for v in identical "build id alone" "build id and panic-location line numbers" code; do
      echo "  verdict $v: ${VCOUNT[$v]:-0}"
    done
    
    echo
    
    echo
    echo "## the format probe rebuilt at $CORE_BASE, the base of the core's growth (change BE)"
    # specs/0023 "Size": the part's growth is the format probe at the phase
    # commit over the same probe rebuilt at c1f6602, part 4d's record's commit;
    # that rebuild is the comparison's own, in the scratch clone above, and it
    # reproduced part 4d P4's log's sha256. No commit after it touched the
    # probe's own source, so the difference is the core's.
    NEW=probe-emend-format-write-xml
    COMMENTS=probe-emend-comments-write-xml
    IMAGES=probe-emend-images-write-xml
    TABLES=probe-emend-tables-write-xml
    RULES=probe-emend-rules-write-xml
    META=probe-emend-metadata-write-xml
    ROWCOL=probe-emend-rowcol-write-xml
    FULL=probe-emend-fullstyles-write-xml
    STY=probe-emend-styles-write-xml
    DATES=probe-emend-dates-write-xml
    FORM=probe-emend-formulas-write-xml
    SHEETS=probe-emend-sheets-write-xml
    echo "command: git log --oneline $CORE_BASE..$C -- tools/size-probe/src/bin/$NEW.rs; git log --oneline $P3_AT..$CORE_BASE -- tools/size-probe/src/bin/$NEW.rs"
    git log --oneline "$CORE_BASE..$C" -- "tools/size-probe/src/bin/$NEW.rs" | sed 's/^/    /'
    git log --oneline "$P3_AT..$CORE_BASE" -- "tools/size-probe/src/bin/$NEW.rs" | sed 's/^/    /'
    NEW_SRC_SINCE=$(run_lines git log --format=%H "$CORE_BASE..$C" -- "tools/size-probe/src/bin/$NEW.rs")
    NEW_SRC_BEFORE=$(run_lines git log --format=%H "$P3_AT..$CORE_BASE" -- "tools/size-probe/src/bin/$NEW.rs")
    NEW_SRC_WHICH=$(git log --format=%H "$P3_AT..$CORE_BASE" -- "tools/size-probe/src/bin/$NEW.rs")
    echo "  commits touching the format probe's source since $CORE_BASE: $NEW_SRC_SINCE; between part 3's commit and it: $NEW_SRC_BEFORE ($NEW_SRC_WHICH)"
    check "no commit after $CORE_BASE touched the format probe's own source" "$(yn [ "$NEW_SRC_SINCE" = 0 ])"
    src_ctl() { [ "$NEW_SRC_BEFORE" = 1 ] && [ "$NEW_SRC_WHICH" = "$SRC_CHANGE" ]; }
    check "control: the same count finds $SRC_CHANGE's change between part 3's commit and $CORE_BASE" "$(yn src_ctl)"
    BASE_BIN=$O/target/$I686/size/$NEW
    BASE_FILE=$(stat -c %s "$BASE_BIN" 2>/dev/null || echo error)
    BASE_SECT=$(section "$BASE_BIN" Total)
    BASE_TEXT=$(section "$BASE_BIN" .text)
    BASE_SHA=$(sha256sum <"$BASE_BIN" 2>/dev/null | cut -d' ' -f1)
    echo "  $NEW rebuilt at $CORE_BASE (the comparison's rebuild): file $BASE_FILE; sections $BASE_SECT; .text $BASE_TEXT; sha256 $BASE_SHA"
    base_built() { [ "$BASE_SECT" != error ] && [ "$BASE_TEXT" != error ] && [ "$BASE_FILE" != error ]; }
    check "the format probe rebuilt at $CORE_BASE was found and its figures were read" "$(yn base_built)"
    check "the rebuild at $CORE_BASE is the one that reproduced part 4d P4's log's sha256" "$(yn [ "$BASE_SHA" = "${WAS_SHA[$NEW]}" ])"
    base_is_record() { [ "$BASE_SECT" = "${WAS_SECT[$NEW]}" ] && [ "$BASE_FILE" = "${WAS_FILE[$NEW]}" ] && [ "$BASE_TEXT" = "${WAS_TEXT[$NEW]}" ]; }
    check "its figures are part 4d's record's for it" "$(yn base_is_record)"
    
    echo
    echo "## the format probe rebuilt at P2's fix commit, the split of the part's growth (change BN)"
    # specs/0023 "Size": the part's crate changes are P2's fix (the validate grid
    # check, code) and this phase's catalogue (//! lines alone). The format probe
    # rebuilt at the fix commit, in a second scratch clone with its own target,
    # splits the growth: the fix's share is it over the base, the catalogue's is
    # the probe at the phase commit over it, expected 0 section bytes and
    # classified as not code.
    FIX=$(by_subject 'M3 part 1 P2: the write refuses a cell edit off the grid')
    echo "command: git log --format=%H -n 1 -F --grep='M3 part 1 P2: the write refuses a cell edit off the grid'"
    echo "  P2's fix commit: ${FIX:-none}"
    check "P2's fix commit was found by its subject" "$(yn full_sha "${FIX:-}")"
    # Between the fix and the phase commit, crates/emend/src was touched by the
    # catalogue alone, and the catalogue touched nothing but //! lines.
    echo "command: git log --format=%H <fix>..<phase commit> -- crates/emend/src crates/emend/Cargo.toml tools/size-probe Cargo.toml Cargo.lock"
    git log --oneline "$FIX..$C" -- crates/emend/src crates/emend/Cargo.toml tools/size-probe Cargo.toml Cargo.lock | sed 's/^/    /'
    AFTER_FIX=$(git log --format=%H "$FIX..$C" -- crates/emend/src crates/emend/Cargo.toml tools/size-probe Cargo.toml Cargo.lock)
    only_catalogue_after() { [ "$AFTER_FIX" = "$CODE1" ]; }
    check "after the fix, the one commit touching a cause of the format probe is the catalogue, the phase commit" "$(yn only_catalogue_after)"
    git show -U0 --format= "$CODE1" | LC_ALL=C "$G" -E '^[-+]' | LC_ALL=C "$G" -vE '^(\+\+\+|---) ' >"$T/cat-lines"
    CAT_ALL=$(count_lines "$T/cat-lines")
    CAT_NOTDOC=$(LC_ALL=C "$G" -vE '^[-+]//!' "$T/cat-lines" | count_lines /dev/stdin)
    echo "  the catalogue commit's changed lines: $CAT_ALL; of them not a //! line: $CAT_NOTDOC"
    cat_doc_only() { [ "$CAT_ALL" -ge 1 ] && [ "$CAT_NOTDOC" = 0 ]; }
    check "the catalogue commit changes //! lines alone" "$(yn cat_doc_only)"
    printf '+//! a line\n+let x = 1;\n' >"$T/cat-ctl"
    check "control: the same count finds one line of two that is not a //! line" "$(yn [ "$(LC_ALL=C "$G" -vE '^[-+]//!' "$T/cat-ctl" | count_lines /dev/stdin)" = 1 ])"
    O2=$T/fix
    git clone --quiet --shared "$MAIN" "$O2" 2>/dev/null
    git -C "$O2" checkout --quiet "$FIX"
    echo "command: git clone --quiet --shared <repo> <scratch>/w/fix; git -C <scratch>/w/fix checkout --quiet $FIX"
    check "the second scratch clone is at P2's fix commit" "$(yn [ "$(git -C "$O2" rev-parse HEAD)" = "$FIX" ])"
    echo "command: in the second scratch clone, CARGO_TARGET_DIR=<scratch>/w/fix/target cargo build -p size-probe --bin $NEW --features $(features_of "$NEW") --profile size --target $I686 --offline"
    ( cd "$O2" && CARGO_TARGET_DIR="$O2/target" cargo build -p size-probe --bin "$NEW" --features "$(features_of "$NEW")" \
        --profile size --target "$I686" --offline ) >"$T/fix-build.out" 2>&1 </dev/null
    FIX_RC=$?
    FIX_BIN=$O2/target/$I686/size/$NEW
    FIX_FILE=$(stat -c %s "$FIX_BIN" 2>/dev/null || echo error)
    FIX_SECT=$(section "$FIX_BIN" Total)
    FIX_TEXT=$(section "$FIX_BIN" .text)
    FIX_SHA=$(sha256sum <"$FIX_BIN" 2>/dev/null | cut -d' ' -f1)
    echo "  $NEW rebuilt at $FIX: build exit $FIX_RC; file $FIX_FILE; sections $FIX_SECT; .text $FIX_TEXT; sha256 $FIX_SHA"
    fix_built() { [ "$FIX_RC" -eq 0 ] && [ "$FIX_SECT" != error ] && [ "$FIX_TEXT" != error ] && [ "$FIX_FILE" != error ]; }
    check "the format probe rebuilt at P2's fix commit was built and its figures were read" "$(yn fix_built)"
    python3 "$T/classify.py" "$FIX_BIN" "$D/$NEW" >"$T/cl-cat.out" 2>&1
    sed "s/^/    the catalogue's share, the fix's build against this commit's: /" "$T/cl-cat.out"
    CAT_VERDICT=$(sed -n 's/^verdict: \(.*\)$/\1/p' "$T/cl-cat.out")
    python3 "$T/classify.py" "$BASE_BIN" "$FIX_BIN" >"$T/cl-fix.out" 2>&1
    sed "s/^/    the fix's share, part 4d's build against the fix's: /" "$T/cl-fix.out"
    FIX_VERDICT=$(sed -n 's/^verdict: \(.*\)$/\1/p' "$T/cl-fix.out")
    FIXSHARE_SECT=$((FIX_SECT - BASE_SECT))
    FIXSHARE_FILE=$((FIX_FILE - BASE_FILE))
    FIXSHARE_TEXT=$((FIX_TEXT - BASE_TEXT))
    CATSHARE_SECT=$((SECT[$NEW] - FIX_SECT))
    CATSHARE_FILE=$((FILE[$NEW] - FIX_FILE))
    CATSHARE_TEXT=$((TEXT[$NEW] - FIX_TEXT))
    echo "  the fix's share: sections $FIX_SECT - $BASE_SECT = $FIXSHARE_SECT; file $FIXSHARE_FILE; .text $FIXSHARE_TEXT; verdict $FIX_VERDICT"
    echo "  the catalogue's share: sections ${SECT[$NEW]} - $FIX_SECT = $CATSHARE_SECT; file $CATSHARE_FILE; .text $CATSHARE_TEXT; verdict $CAT_VERDICT"
    check "the catalogue's share is 0 section bytes" "$(yn [ "$CATSHARE_SECT" = 0 ])"
    not_code() { [ -n "$1" ] && [ "$1" != code ]; }
    check "the catalogue's share is classified as not code" "$(yn not_code "$CAT_VERDICT")"
    code_ctl() { if not_code code; then return 1; else return 0; fi; }
    check "control: the same test refuses the verdict code" "$(yn code_ctl)"
    check "the fix's share was classified" "$(yn [ -n "$FIX_VERDICT" ])"
    
    echo
    echo "## the figures specs/0023 \"Size\" and \"P3\" ask for (changes BE, BN and BO)"
    CM_SECT=$((SECT[$COMMENTS] - SECT[$NEW]))
    CM_FILE=$((FILE[$COMMENTS] - FILE[$NEW]))
    CM_TEXT=$((TEXT[$COMMENTS] - TEXT[$NEW]))
    IM_SECT=$((SECT[$IMAGES] - SECT[$NEW]))
    IM_FILE=$((FILE[$IMAGES] - FILE[$NEW]))
    IM_TEXT=$((TEXT[$IMAGES] - TEXT[$NEW]))
    TB_SECT=$((SECT[$TABLES] - SECT[$NEW]))
    TB_FILE=$((FILE[$TABLES] - FILE[$NEW]))
    TB_TEXT=$((TEXT[$TABLES] - TEXT[$NEW]))
    RU_SECT=$((SECT[$RULES] - SECT[$NEW]))
    RU_FILE=$((FILE[$RULES] - FILE[$NEW]))
    RU_TEXT=$((TEXT[$RULES] - TEXT[$NEW]))
    MD_SECT=$((SECT[$META] - SECT[$NEW]))
    MD_FILE=$((FILE[$META] - FILE[$NEW]))
    MD_TEXT=$((TEXT[$META] - TEXT[$NEW]))
    CORE_SECT=$((SECT[$NEW] - BASE_SECT))
    CORE_FILE=$((FILE[$NEW] - BASE_FILE))
    CORE_TEXT=$((TEXT[$NEW] - BASE_TEXT))
    JUDGED_SECT=$((SECT[$NEW] - SECT[probe-zip-xml]))
    JUDGED_FILE=$((FILE[$NEW] - FILE[probe-zip-xml]))
    JUDGED_TEXT=$((TEXT[$NEW] - TEXT[probe-zip-xml]))
    RC_SECT=$((SECT[$ROWCOL] - SECT[$NEW]))
    RC_FILE=$((FILE[$ROWCOL] - FILE[$NEW]))
    RC_TEXT=$((TEXT[$ROWCOL] - TEXT[$NEW]))
    DT_SECT=$((SECT[$DATES] - SECT[$STY]))
    DT_FILE=$((FILE[$DATES] - FILE[$STY]))
    DT_TEXT=$((TEXT[$DATES] - TEXT[$STY]))
    # The whole growth's base, read from part 3's record and checked against the
    # number the spec names (change BE); the probe's file and .text there too.
    P3_ROW=$(awk -F'|' -v p="\`$NEW\`" '$2 ~ /^ `probe-/ { gsub(/^ | $/, "", $2); if ($2 == p) { gsub(/ /, "", $4); gsub(/ /, "", $5); gsub(/ /, "", $6); print $4, $5, $6; exit } }' "$P3_REC")
    P3_FILE=$(printf '%s\n' "$P3_ROW" | awk '{ print $1 }')
    REC_NEW_SECT=$(printf '%s\n' "$P3_ROW" | awk '{ print $2 }')
    P3_TEXT=$(printf '%s\n' "$P3_ROW" | awk '{ print $3 }')
    echo "command: the file, section and .text bytes of $P3_REC's probes-table row for $NEW (sha256 $(sha256sum <"$P3_REC" | cut -d' ' -f1))"
    echo "  part 3's record's figures for $NEW: file ${P3_FILE:-none}, sections ${REC_NEW_SECT:-none}, .text ${P3_TEXT:-none}; the spec's base: $WHOLE_BASE"
    check "part 3's record carries $WHOLE_BASE for the format probe's section bytes" "$(yn [ "${REC_NEW_SECT:-}" = "$WHOLE_BASE" ])"
    p3_read() { [ -n "$P3_FILE" ] && [ -n "$P3_TEXT" ]; }
    check "part 3's record's file and .text figures for it were read" "$(yn p3_read)"
    p3_ctl() { [ -z "$(awk -F'|' '$2 == " `probe-no-such` " { print $5 }' "$P3_REC")" ]; }
    check "control: the same read finds no row for a probe the record does not name" "$(yn p3_ctl)"
    WHOLE_SECT=$((SECT[$NEW] - WHOLE_BASE))
    # The read is printed as it runs, the expression itself and no stand-in.
    BUDGET_SED='s/^| the budget, `probe-emend-format-write-xml` over `probe-zip-xml` | \([0-9]*\) |.*/\1/p'
    PREV_BUDGET=$(sed -n "$BUDGET_SED" "$PREV_REC")
    echo "command: sed -n '$BUDGET_SED' $PREV_REC"
    echo "  part 4d's record's own budget figure, read from its figures table: ${PREV_BUDGET:-none}"
    prev_budget_consistent() { [ -n "$PREV_BUDGET" ] && [ "$PREV_BUDGET" = "$((WAS_SECT[$NEW] - WAS_SECT[probe-zip-xml]))" ]; }
    check "part 4d's record's budget figure is its own format probe over its own probe-zip-xml" "$(yn prev_budget_consistent)"
    no_budget_line() { [ -z "$(sed -n 's/^| the budget, `probe-no-such` over `probe-zip-xml` | \([0-9]*\) |.*/\1/p' "$PREV_REC")" ]; }
    check "control: the same read finds nothing for a probe the record does not name" "$(yn no_budget_line)"
    BUDGET_MOVE=$((JUDGED_SECT - ${PREV_BUDGET:-0}))
    if [ "$JUDGED_SECT" -gt "$CEILING" ]; then
      ABOVE=yes
      OVER_BY=$((JUDGED_SECT - CEILING))
      CEIL_WORDS="above the ceiling by $OVER_BY"
    else
      ABOVE=no
      OVER_BY=0
      CEIL_WORDS="$((CEILING - JUDGED_SECT)) under the ceiling"
    fi
    if [ "$CORE_SECT" -gt 2000 ]; then CORE_ABOVE=yes; else CORE_ABOVE=no; fi
    # Change BO: part 4d's headroom from its record, against the spec's figure,
    # and this part's growth of the budget figure under it.
    PREV_HEADROOM=$((CEILING - ${PREV_BUDGET:-0}))
    echo "  part 4d's headroom, the ceiling less its record's budget figure: $CEILING - ${PREV_BUDGET:-none} = $PREV_HEADROOM; the spec's: $SPEC_HEADROOM"
    check "part 4d's headroom read from its record is the spec's $SPEC_HEADROOM" "$(yn [ "$PREV_HEADROOM" = "$SPEC_HEADROOM" ])"
    check "the part's growth of the budget figure, $BUDGET_MOVE, is within part 4d's headroom" "$(yn [ "$BUDGET_MOVE" -le "$PREV_HEADROOM" ])"
    under_ctl() { if [ "$((PREV_HEADROOM + 1))" -le "$PREV_HEADROOM" ]; then return 1; else return 0; fi; }
    check "control: the same form says one byte over the headroom is not within it" "$(yn under_ctl)"
    echo "  1. the features' costs over $NEW at this commit: $COMMENTS: sections $CM_SECT, file $CM_FILE, .text $CM_TEXT; $IMAGES: sections $IM_SECT, file $IM_FILE, .text $IM_TEXT"
    echo "  2. the part's growth, $NEW at this commit over the same probe rebuilt at $CORE_BASE (part 4d's record's commit):"
    echo "     sections ${SECT[$NEW]} - $BASE_SECT = $CORE_SECT; file ${FILE[$NEW]} - $BASE_FILE = $CORE_FILE; .text ${TEXT[$NEW]} - $BASE_TEXT = $CORE_TEXT"
    echo "     above 2000 section bytes, which the report must tell planning: $CORE_ABOVE"
    echo "  3. the whole growth since b728fdf, $NEW at this commit over $WHOLE_BASE, probe bytes included:"
    echo "     sections ${SECT[$NEW]} - $WHOLE_BASE = $WHOLE_SECT"
    echo "  4. the budget figure, $NEW over probe-zip-xml:"
    echo "     sections $JUDGED_SECT, file $JUDGED_FILE, .text $JUDGED_TEXT; the ceiling is $CEILING (specs/0017 decision 1, A; kept for Milestone 3)"
    echo "     THE JUDGMENT, against the ceiling, in section bytes: $CEIL_WORDS"
    echo "     part 4d's record's budget figure $PREV_BUDGET; this one less it: $BUDGET_MOVE"
    echo "  5. beside them, measured here, outside the budget: the tables feature's cost, $TABLES over $NEW: sections $TB_SECT, file $TB_FILE, .text $TB_TEXT; the rules feature's cost, $RULES over $NEW: sections $RU_SECT, file $RU_FILE, .text $RU_TEXT; the metadata feature's cost, $META over $NEW: sections $MD_SECT, file $MD_FILE, .text $MD_TEXT; the rowcol feature's cost, $ROWCOL over $NEW: sections $RC_SECT, file $RC_FILE, .text $RC_TEXT; the dates feature's cost, $DATES over $STY: sections $DT_SECT, file $DT_FILE, .text $DT_TEXT"
    echo "  6. the part's growth split (change BN): the fix's share $FIXSHARE_SECT section bytes ($FIX_VERDICT); the catalogue's $CATSHARE_SECT ($CAT_VERDICT); together $((FIXSHARE_SECT + CATSHARE_SECT)), the part's growth $CORE_SECT"
    check "the two shares make the part's growth" "$(yn [ "$((FIXSHARE_SECT + CATSHARE_SECT))" = "$CORE_SECT" ])"
    check "the comments probe is larger than the format probe, by sections" "$(yn [ "$CM_SECT" -gt 0 ])"
    check "the images probe is larger than the format probe, by sections" "$(yn [ "$IM_SECT" -gt 0 ])"
    check "the tables probe is larger than the format probe, by sections" "$(yn [ "$TB_SECT" -gt 0 ])"
    check "the rules probe is larger than the format probe, by sections" "$(yn [ "$RU_SECT" -gt 0 ])"
    check "the metadata probe is larger than the format probe, by sections" "$(yn [ "$MD_SECT" -gt 0 ])"
    check "the rowcol probe is larger than the format probe, by sections" "$(yn [ "$RC_SECT" -gt 0 ])"
    check "the dates probe is larger than the styles probe, by sections" "$(yn [ "$DT_SECT" -gt 0 ])"
    over_ctl() { [ "$((CEILING + 1))" -gt "$CEILING" ]; }
    check "control: the ceiling comparison's form says a figure one above it is above it" "$(yn over_ctl)"
    core_ctl() { [ "$((2000 + 1))" -gt 2000 ]; }
    check "control: the core growth's form says 2001 is above 2000" "$(yn core_ctl)"
    # The whole growth, read beside the core's growth: the rest is the format
    # probe rebuilt at CORE_BASE over part 3's figure, the growth part 4d's record
    # carries (a figure, not a check; the two differences share a term by
    # construction).
    BASE_STEP=$((BASE_SECT - WHOLE_BASE))
    echo "  beside it: the format probe at $CORE_BASE over part 3's figure, $BASE_SECT - $WHOLE_BASE = $BASE_STEP; with the core's growth $CORE_SECT it makes the whole growth $WHOLE_SECT"
    
    echo
    echo "  against part 4d's record, $PREV_REC, every earlier probe's difference from its figure, sections (file, .text):"
    MAX_GROWTH=
    MAX_PROBE=
    for b in $EARLIER; do
      d=$((SECT[$b] - WAS_SECT[$b]))
      echo "    $b: ${WAS_SECT[$b]} to ${SECT[$b]}, $d ($((FILE[$b] - WAS_FILE[$b])), $((TEXT[$b] - WAS_TEXT[$b])))"
      if [ -z "$MAX_GROWTH" ] || [ "$d" -gt "$MAX_GROWTH" ]; then
        MAX_GROWTH=$d
        MAX_PROBE=$b
      fi
    done
    echo "  the largest growth among the twenty-one earlier probes: $MAX_GROWTH section bytes, $MAX_PROBE"
    max_read() { [ -n "$MAX_GROWTH" ] && [ -n "$MAX_PROBE" ]; }
    check "the largest growth among the twenty-one was read" "$(yn max_read)"
    echo
    echo "## the twenty-one probes on generated packages"
    # A fictional package, generated here: the smallest thing that has a workbook,
    # a calculation chain with its override and relationship, two parts the recipe
    # must not touch, and, added for this part, a shared strings table and a sheet
    # with cells to read. The cells are two numbers and two shared strings, so the
    # cells probe exercises the float parser and the table lookup rather than
    # counting an empty sheet. Part 5 gives it a styles part of one of each thing a
    # cell format names, so the styles probe has a cell format 0 to derive from.
    # Part 6 adds a third, the first with a calcPr of calcId alone after <sheets>,
    # so the formulas probe's calcPr rewrite is shown on a present element as well
    # as by insertion (header change 5). No corpus file is read by this log.
    python3 - "$T/probe.xlsx" "$T/probe1904.xlsx" "$T/probe-calc.xlsx" <<'FIXTURE_PY'
    import sys, zipfile
    
    CT = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
          '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
          '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
          '<Default Extension="xml" ContentType="application/xml"/>'
          '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>'
          '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>'
          '<Override PartName="/xl/calcChain.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.calcChain+xml"/>'
          '<Override PartName="/xl/sharedStrings.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"/>'
          '</Types>')
    ROOT_RELS = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                 '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
                 '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>'
                 '</Relationships>')
    WB = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
          '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" '
          'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">'
          '<sheets><sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets></workbook>')
    WB_RELS = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
               '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
               '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/>'
               '<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>'
               '<Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/calcChain" Target="calcChain.xml"/>'
               '<Relationship Id="rId4" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/sharedStrings" Target="sharedStrings.xml"/>'
               '</Relationships>')
    SHEET = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
             '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
             '<sheetData><row r="1"><c r="A1"><v>1.5</v></c><c r="B1" t="s"><v>0</v></c>'
             '<c r="C1" t="s"><v>1</v></c><c r="D1"><v>2.25</v></c>'
             '</row></sheetData></worksheet>')
    # Two items, of five and two bytes. The cells probe's `text` figure covers
    # EVERY cell, because `resolve` answers with a non-shared cell's own value: 5
    # and 2 for the items, plus "1.5" and "2.25", is 14.
    SST = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
           '<sst xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" count="2" uniqueCount="2">'
           '<si><t>alpha</t></si><si><t>bb</t></si></sst>')
    STYLES = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
              '<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
              '<fonts count="1"><font/></fonts><fills count="1"><fill/></fills>'
              '<borders count="1"><border/></borders>'
              '<cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>'
              '<cellXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/></cellXfs>'
              '</styleSheet>')
    WB1904 = WB.replace('<sheets>', '<workbookPr date1904="1"/><sheets>')
    WBCALC = WB.replace('</sheets>', '</sheets><calcPr calcId="191029"/>')
    CHAIN = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
             '<calcChain xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
             '<c r="A1" i="1"/></calcChain>')
    
    # The second fixture is the first with date1904 set on the workbook, and
    # nothing else changed.
    # The third is the first with a calcPr of calcId alone, and nothing else
    # changed.
    for path, workbook in ((sys.argv[1], WB), (sys.argv[2], WB1904), (sys.argv[3], WBCALC)):
        with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
            z.writestr("[Content_Types].xml", CT)
            z.writestr("_rels/.rels", ROOT_RELS)
            z.writestr("xl/workbook.xml", workbook)
            z.writestr("xl/_rels/workbook.xml.rels", WB_RELS)
            z.writestr("xl/worksheets/sheet1.xml", SHEET)
            z.writestr("xl/sharedStrings.xml", SST)
            z.writestr("xl/styles.xml", STYLES)
            z.writestr("xl/calcChain.xml", CHAIN)
    print("generated: 8 entries, a workbook with one sheet of four cells, a shared "
          "strings table of two items, a styles part of one cell format, a chain "
          "with its override and relationship; the same with date1904 set; and the "
          "same with a calcPr of calcId alone")
    FIXTURE_PY
    THEME_NAME=/xl/theme/theme1.xml
    THEME_TYPE=application/vnd.openxmlformats-officedocument.theme+xml
    "$D/probe-zip" "$T/probe.xlsx" >"$T/o-zip" 2>&1; R_ZIP=$?
    "$D/probe-zip-xml" "$T/probe.xlsx" xl/workbook.xml >"$T/o-zipxml" 2>&1; R_ZIPXML=$?
    "$D/probe-zip-xml-write" "$T/probe.xlsx" xl/workbook.xml "$T/written.zip" >"$T/o-write" 2>&1; R_WRITE=$?
    "$D/probe-emend-copy" "$T/probe.xlsx" "$T/copy.xlsx" >"$T/o-copy" 2>&1; R_COPY=$?
    "$D/probe-emend-edit" "$T/probe.xlsx" "$T/edit.xlsx" '[Content_Types].xml' xl/styles.xml added.xml >"$T/o-edit" 2>&1; R_EDIT=$?
    "$D/probe-emend-edit-xml" "$T/probe.xlsx" "$T/editx.xlsx" '[Content_Types].xml' xl/styles.xml added.xml >"$T/o-editx" 2>&1; R_EDITX=$?
    "$D/probe-emend-package-xml" "$T/probe.xlsx" "$T/pkg.xlsx" xl/worksheets/sheet1.xml "$THEME_NAME" "$THEME_TYPE" >"$T/o-pkg" 2>&1; R_PKG=$?
    "$D/probe-emend-cells-xml" "$T/probe.xlsx" "$T/cells.xlsx" xl/worksheets/sheet1.xml "$THEME_NAME" "$THEME_TYPE" xl/worksheets/sheet1.xml >"$T/o-cells" 2>&1; R_CELLS=$?
    declare -A RC
    RC[zip]=$R_ZIP; RC[zipxml]=$R_ZIPXML; RC[write]=$R_WRITE; RC[copy]=$R_COPY
    RC[edit]=$R_EDIT; RC[editx]=$R_EDITX; RC[pkg]=$R_PKG; RC[cells]=$R_CELLS
    for n in zip zipxml write copy edit editx pkg cells; do
      echo "  run $n (exit ${RC[$n]}):"
      hide <"$T/o-$n" | sed 's/^/    /'
    done
    zip_prints_count() { [ "$R_ZIP" -eq 0 ] && [ "$(cat "$T/o-zip")" = "entries 8" ]; }
    check "probe-zip prints the entry count" "$(yn zip_prints_count)"
    zipxml_prints_both() { [ "$R_ZIPXML" -eq 0 ] && [ "$(cat "$T/o-zipxml")" = "$(printf 'entries 8\nelements 3')" ]; }
    check "probe-zip-xml prints the entry count and the workbook's three elements" "$(yn zipxml_prints_both)"
    write_prints_both() { [ "$R_WRITE" -eq 0 ] && [ "$(cat "$T/o-write")" = "$(printf 'entries 8\nelements 3')" ]; }
    check "probe-zip-xml-write prints the same two counts" "$(yn write_prints_both)"
    python3 - "$T/written.zip" >"$T/o-written-names" 2>&1 <<'PY'
    import sys, zipfile
    z = zipfile.ZipFile(sys.argv[1])
    i = z.infolist()
    print("%d %s %d" % (len(i), i[0].filename, i[0].compress_type))
    PY
    echo "  the archive probe-zip-xml-write wrote, read by python's zipfile: $(cat "$T/o-written-names")"
    write_wrote_deflated() { [ "$R_WRITE" -eq 0 ] && [ "$(cat "$T/o-written-names")" = "1 xl/workbook.xml 8" ]; }
    check "probe-zip-xml-write wrote one deflated entry through the zip crate's writer" "$(yn write_wrote_deflated)"
    copy_identical() { [ "$R_COPY" -eq 0 ] && cmp -s "$T/probe.xlsx" "$T/copy.xlsx"; }
    check "probe-emend-copy exits 0 and its copy is byte-identical" "$(yn copy_identical)"
    python3 - "$T/edit.xlsx" >"$T/o-edit-names" 2>&1 <<'PY'
    import sys, zipfile
    print(" ".join(sorted(zipfile.ZipFile(sys.argv[1]).namelist())))
    PY
    echo "  names in the edited archive: $(cat "$T/o-edit-names")"
    edit_did_three() {
      [ "$R_EDIT" -eq 0 ] &&
        [ "$(cat "$T/o-edit-names")" = "$(printf '%s' '[Content_Types].xml _rels/.rels added.xml xl/_rels/workbook.xml.rels xl/calcChain.xml xl/sharedStrings.xml xl/workbook.xml xl/worksheets/sheet1.xml')" ]
    }
    check "probe-emend-edit exits 0; the replaced entry stays, styles.xml goes, added.xml appears" \
      "$(yn edit_did_three)"
    editx_same_archive() { [ "$R_EDITX" -eq 0 ] && cmp -s "$T/edit.xlsx" "$T/editx.xlsx"; }
    check "probe-emend-edit-xml writes the same archive as probe-emend-edit" "$(yn editx_same_archive)"
    
    # The package probe is the only place the whole layer runs on 32-bit in a
    # release build, so its output is checked part by part, not just by exit status.
    python3 - "$T/probe.xlsx" "$T/pkg.xlsx" "$THEME_NAME" >"$T/o-pkg-check" 2>&1 <<'PKG_PY'
    import sys, zipfile
    
    src, out, theme = zipfile.ZipFile(sys.argv[1]), zipfile.ZipFile(sys.argv[2]), sys.argv[3]
    sn, on = src.namelist(), out.namelist()
    print("entries in: %d; entries out: %d" % (len(sn), len(on)))
    print("order preserved among the entries that stayed: %s"
          % ("yes" if [n for n in sn if n in on] == on else "no"))
    print("the chain's entry is gone: %s" % ("yes" if "xl/calcChain.xml" not in on else "no"))
    ct = out.read("[Content_Types].xml").decode()
    print("the chain's override is gone: %s" % ("yes" if "calcChain.xml" not in ct else "no"))
    print("the theme override is there: %s" % ("yes" if ('PartName="%s"' % theme) in ct else "no"))
    rels = out.read("xl/_rels/workbook.xml.rels").decode()
    print("the chain's relationship is gone: %s" % ("yes" if "calcChain" not in rels else "no"))
    print("a theme relationship is there: %s"
          % ("yes" if "relationships/theme" in rels and ('Target="%s"' % theme) in rels else "no"))
    # Every other part, the REPLACED one included: it is replaced by its own bytes
    # passed through the token stream, so it must come back byte for byte too, and
    # a stream that did not reproduce it exactly would show up right here.
    rest = [n for n in on if n not in ("[Content_Types].xml", "xl/_rels/workbook.xml.rels")]
    same = [n for n in rest if src.read(n) == out.read(n)]
    print("parts outside the two the recipe rewrites: %d, of them byte-identical to the input: %d"
          % (len(rest), len(same)))
    PKG_PY
    sed 's/^/    /' "$T/o-pkg-check"
    # The replaced sheet is richer than part 2's: worksheet, sheetData, row, four
    # `<c>` and their four `<v>` is eleven elements.
    pkg_prints_counts() { [ "$R_PKG" -eq 0 ] && [ "$(cat "$T/o-pkg")" = "$(printf 'sheets 1\nelements 11')" ]; }
    check "probe-emend-package-xml exits 0 and prints the sheet count and the replaced part's elements" \
      "$(yn pkg_prints_counts)"
    pkg_recipe_held() {
      [ "$(count_matches -Fx "the chain's entry is gone: yes" "$T/o-pkg-check")" = 1 ] &&
        [ "$(count_matches -Fx "the chain's override is gone: yes" "$T/o-pkg-check")" = 1 ] &&
        [ "$(count_matches -Fx "the chain's relationship is gone: yes" "$T/o-pkg-check")" = 1 ]
    }
    check "the recipe removed the chain's entry, its override and its relationship" "$(yn pkg_recipe_held)"
    pkg_additions_held() {
      [ "$(count_matches -Fx "the theme override is there: yes" "$T/o-pkg-check")" = 1 ] &&
        [ "$(count_matches -Fx "a theme relationship is there: yes" "$T/o-pkg-check")" = 1 ]
    }
    check "the override and the relationship named on the command line were added" "$(yn pkg_additions_held)"
    pkg_rest_untouched() {
      [ "$(count_matches -Fx "entries in: 8; entries out: 7" "$T/o-pkg-check")" = 1 ] &&
        [ "$(count_matches -Fx "order preserved among the entries that stayed: yes" "$T/o-pkg-check")" = 1 ] &&
        [ "$(count_matches -Fx "parts outside the two the recipe rewrites: 5, of them byte-identical to the input: 5" "$T/o-pkg-check")" = 1 ]
    }
    check "every other part came through unchanged, in order" "$(yn pkg_rest_untouched)"
    
    # The cells probe: its own output, checked figure by figure against what the
    # fixture was built to contain rather than against whatever it printed.
    # sheets 1; elements 11, the replaced sheet's; items 2; cells 4; sum 3.75,
    # which is 1.5 + 2.25 and nothing from the two shared cells; text 14.
    cells_prints_counts() {
      [ "$R_CELLS" -eq 0 ] &&
        [ "$(cat "$T/o-cells")" = "$(printf 'sheets 1\nelements 11\nitems 2\ncells 4\nsum 3.75\ntext 14')" ]
    }
    check "probe-emend-cells-xml exits 0 and prints the six counts the fixture was built for" \
      "$(yn cells_prints_counts)"
    cells_copy_matches_pkg() { [ "$R_CELLS" -eq 0 ] && cmp -s "$T/pkg.xlsx" "$T/cells.xlsx"; }
    check "the cells probe writes the same package the package probe writes, so its reads changed nothing" \
      "$(yn cells_copy_matches_pkg)"
    
    
    # Part 4's probe, on the same package, checked as part 4's log checked it. Its
    # arguments put each edit where the
    # fixture makes it mean something: the number REPLACES A1 (1.5), the text is
    # a new cell E1 at the end of row 1, the boolean is a new row 2 at A2, and the
    # clear takes B1, an unstyled shared-string cell, which a clear removes. So the
    # sheet read back holds A1, C1, D1, E1 and A2: five cells.
    CW=probe-emend-cells-write-xml
    "$D/$CW" "$T/probe.xlsx" "$T/cw.xlsx" xl/worksheets/sheet1.xml "$THEME_NAME" "$THEME_TYPE" \
      xl/worksheets/sheet1.xml A1 E1 A2 B1 "$T/cw-second.xlsx" >"$T/o-cw" 2>&1
    R_CW=$?
    echo "  run cells-write, arguments <scratch>/probe.xlsx <scratch>/cw.xlsx xl/worksheets/sheet1.xml $THEME_NAME $THEME_TYPE xl/worksheets/sheet1.xml A1 E1 A2 B1 <scratch>/cw-second.xlsx (exit $R_CW):"
    hide <"$T/o-cw" | sed 's/^/    /'
    cw_prints_counts() {
      [ "$R_CW" -eq 0 ] &&
        [ "$(cat "$T/o-cw")" = "$(printf 'sheets 1\nelements 11\nitems 2\ncells 4\nsum 3.75\ntext 14\nwritten 5')" ]
    }
    check "$CW exits 0, prints the cells probe's six counts and then written 5" "$(yn cw_prints_counts)"
    cw_first_matches_cells() { [ "$R_CW" -eq 0 ] && cmp -s "$T/cells.xlsx" "$T/cw.xlsx"; }
    check "its first output is the package the cells probe writes, byte for byte" "$(yn cw_first_matches_cells)"
    
    # The second output, read part by part and the edited sheet cell by cell by a
    # reader that is not emend's. Each cell is printed as its reference, its t, its
    # s, its <v> and its inline text, in document order, and each row as its r.
    python3 - "$T/probe.xlsx" "$T/cw-second.xlsx" >"$T/o-cw-check" 2>&1 <<'CW_PY'
    import sys, zipfile
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    src, out = zipfile.ZipFile(sys.argv[1]), zipfile.ZipFile(sys.argv[2])
    sn, on = src.namelist(), out.namelist()
    print("entries in: %d; entries out: %d" % (len(sn), len(on)))
    print("order preserved among the entries that stayed: %s"
          % ("yes" if [n for n in sn if n in on] == on else "no"))
    print("the chain's entry is gone: %s" % ("yes" if "xl/calcChain.xml" not in on else "no"))
    ct = out.read("[Content_Types].xml").decode()
    print("the chain's override is gone: %s" % ("yes" if "calcChain.xml" not in ct else "no"))
    rels = out.read("xl/_rels/workbook.xml.rels").decode()
    print("the chain's relationship is gone: %s" % ("yes" if "calcChain" not in rels else "no"))
    rest = [n for n in on if n not in ("[Content_Types].xml", "xl/_rels/workbook.xml.rels",
                                       "xl/worksheets/sheet1.xml")]
    same = [n for n in rest if src.read(n) == out.read(n)]
    print("parts outside the chain recipe and the edited sheet: %d, of them byte-identical to the input: %d"
          % (len(rest), len(same)))
    sheet = ET.fromstring(out.read("xl/worksheets/sheet1.xml"))
    for row in sheet.iter(M + "row"):
        print("row r=%s" % row.get("r"))
        for c in row.findall(M + "c"):
            v = c.find(M + "v")
            t = c.find(M + "is/" + M + "t")
            print("  cell %s t=%s s=%s v=%s is=%s f=%s" % (
                c.get("r"), c.get("t"), c.get("s"),
                None if v is None else v.text, None if t is None else t.text,
                "yes" if c.find(M + "f") is not None else "no"))
    CW_PY
    sed 's/^/    /' "$T/o-cw-check"
    cw_recipe_held() {
      [ "$(count_matches -Fx "the chain's entry is gone: yes" "$T/o-cw-check")" = 1 ] &&
        [ "$(count_matches -Fx "the chain's override is gone: yes" "$T/o-cw-check")" = 1 ] &&
        [ "$(count_matches -Fx "the chain's relationship is gone: yes" "$T/o-cw-check")" = 1 ]
    }
    check "the second output: drop_calc_chain removed the chain's entry, its override and its relationship" \
      "$(yn cw_recipe_held)"
    cw_rest_untouched() {
      [ "$(count_matches -Fx "entries in: 8; entries out: 7" "$T/o-cw-check")" = 1 ] &&
        [ "$(count_matches -Fx "order preserved among the entries that stayed: yes" "$T/o-cw-check")" = 1 ] &&
        [ "$(count_matches -Fx "parts outside the chain recipe and the edited sheet: 4, of them byte-identical to the input: 4" "$T/o-cw-check")" = 1 ]
    }
    check "the second output: every other part came through unchanged, in order" "$(yn cw_rest_untouched)"
    # The sheet as the edits imply it, row by row and cell by cell.
    cat >"$T/cw-expected" <<'CW_EXPECTED'
    row r=1
      cell A1 t=None s=None v=2.5 is=None f=no
      cell C1 t=s s=None v=1 is=None f=no
      cell D1 t=None s=None v=2.25 is=None f=no
      cell E1 t=inlineStr s=None v=None is=probe f=no
    row r=2
      cell A2 t=b s=None v=1 is=None f=no
    CW_EXPECTED
    tail -n +7 "$T/o-cw-check" >"$T/cw-sheet"
    echo "  the sheet the edits imply, as the reader above prints it:"
    sed 's/^/    /' "$T/cw-expected"
    cw_sheet_as_edited() { cmp -s "$T/cw-expected" "$T/cw-sheet"; }
    check "the second output's sheet is exactly the edits: A1 2.5, B1 gone, E1 the text, a new row 2 with A2 true" \
      "$(yn cw_sheet_as_edited)"
    # The control, in the same command form: the expected sheet with B1 put back
    # must not compare equal, so the check above is a comparison and not a pass.
    { head -n 2 "$T/cw-expected"; echo "  cell B1 t=s s=None v=0 is=None f=no"; tail -n +3 "$T/cw-expected"; } >"$T/cw-control"
    cw_control_differs() { if cmp -s "$T/cw-control" "$T/cw-sheet"; then return 1; else return 0; fi; }
    check "control: the same comparison against the sheet with B1 kept says they differ" "$(yn cw_control_differs)"
    
    # The styles probe, with part 4's probe's arguments and the code 0.000. Its
    # edits land where part 4's do; then the coded format (base 0, the fixture's
    # only cell format) goes on the number cell A1 and BuiltIn(14) (base none) on
    # the text cell E1. The fixture has one cell format and no numFmts, so the
    # output must have three cell formats and one numFmt, id 164, the first free
    # custom id, and A1 s=1, E1 s=2.
    STYLE_ARGS="xl/worksheets/sheet1.xml $THEME_NAME $THEME_TYPE xl/worksheets/sheet1.xml A1 E1 A2 B1"
    # shellcheck disable=SC2086
    "$D/$STY" "$T/probe.xlsx" "$T/sw.xlsx" $STYLE_ARGS "$T/sw-second.xlsx" '0.000' >"$T/o-sw" 2>&1
    R_SW=$?
    echo "  run styles-write, arguments <scratch>/probe.xlsx <scratch>/sw.xlsx $STYLE_ARGS <scratch>/sw-second.xlsx 0.000 (exit $R_SW):"
    hide <"$T/o-sw" | sed 's/^/    /'
    SW_EXPECTED=$(printf 'sheets 1\nelements 11\nitems 2\ncells 4\nsum 3.75\ntext 14\nwritten 5\nxfs_before 1\nnumfmts_before 0\nxfs_after 3\nnumfmts_after 1\nnumber_style 1\ntext_style 2')
    sw_prints_counts() { [ "$R_SW" -eq 0 ] && [ "$(cat "$T/o-sw")" = "$SW_EXPECTED" ]; }
    check "$STY exits 0, prints part 4's probe's seven lines and then the six styles figures the fixture implies" \
      "$(yn sw_prints_counts)"
    sw_first_matches_cells() { [ "$R_SW" -eq 0 ] && cmp -s "$T/cells.xlsx" "$T/sw.xlsx"; }
    check "its first output is the package the cells probe writes, byte for byte" "$(yn sw_first_matches_cells)"
    
    # The second output, by a reader that is not emend's: every part outside the
    # chain recipe, the edited sheet and the styles part byte-identical; the
    # sheet cell by cell as the edits and the styles imply; the styles part's
    # numFmts and cellXfs, each count beside its children.
    cat >"$T/read-second.py" <<'SECOND_PY'
    import sys, zipfile
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    src, out = zipfile.ZipFile(sys.argv[1]), zipfile.ZipFile(sys.argv[2])
    sn, on = src.namelist(), out.namelist()
    print("entries in: %d; entries out: %d" % (len(sn), len(on)))
    print("order preserved among the entries that stayed: %s"
          % ("yes" if [n for n in sn if n in on] == on else "no"))
    print("the chain's entry is gone: %s" % ("yes" if "xl/calcChain.xml" not in on else "no"))
    rest = [n for n in on if n not in ("[Content_Types].xml", "xl/_rels/workbook.xml.rels",
                                       "xl/worksheets/sheet1.xml", "xl/styles.xml")]
    same = [n for n in rest if src.read(n) == out.read(n)]
    print("parts outside the chain recipe, the edited sheet and the styles part: %d, of them byte-identical to the input: %d"
          % (len(rest), len(same)))
    styles = ET.fromstring(out.read("xl/styles.xml"))
    fmts = styles.find(M + "numFmts")
    kids = [] if fmts is None else fmts.findall(M + "numFmt")
    print("numFmts count=%s children=%d" % (None if fmts is None else fmts.get("count"), len(kids)))
    for f in kids:
        print("  numFmt id=%s code=%s" % (f.get("numFmtId"), f.get("formatCode")))
    xfs = styles.find(M + "cellXfs")
    kids = xfs.findall(M + "xf")
    print("cellXfs count=%s children=%d" % (xfs.get("count"), len(kids)))
    for x in kids:
        print("  xf numFmtId=%s fontId=%s fillId=%s borderId=%s xfId=%s applyNumberFormat=%s" % (
            x.get("numFmtId"), x.get("fontId"), x.get("fillId"), x.get("borderId"),
            x.get("xfId"), x.get("applyNumberFormat")))
    sheet = ET.fromstring(out.read("xl/worksheets/sheet1.xml"))
    for row in sheet.iter(M + "row"):
        print("row r=%s" % row.get("r"))
        for c in row.findall(M + "c"):
            v = c.find(M + "v")
            t = c.find(M + "is/" + M + "t")
            print("  cell %s t=%s s=%s v=%s is=%s f=%s" % (
                c.get("r"), c.get("t"), c.get("s"),
                None if v is None else v.text, None if t is None else t.text,
                "yes" if c.find(M + "f") is not None else "no"))
    SECOND_PY
    python3 "$T/read-second.py" "$T/probe.xlsx" "$T/sw-second.xlsx" >"$T/o-sw-check" 2>&1
    sed 's/^/    /' "$T/o-sw-check"
    cat >"$T/sw-expected" <<'SW_EXPECTED'
    entries in: 8; entries out: 7
    order preserved among the entries that stayed: yes
    the chain's entry is gone: yes
    parts outside the chain recipe, the edited sheet and the styles part: 3, of them byte-identical to the input: 3
    numFmts count=1 children=1
      numFmt id=164 code=0.000
    cellXfs count=3 children=3
      xf numFmtId=0 fontId=0 fillId=0 borderId=0 xfId=0 applyNumberFormat=None
      xf numFmtId=164 fontId=0 fillId=0 borderId=0 xfId=0 applyNumberFormat=1
      xf numFmtId=14 fontId=0 fillId=0 borderId=0 xfId=0 applyNumberFormat=1
    row r=1
      cell A1 t=None s=1 v=2.5 is=None f=no
      cell C1 t=s s=None v=1 is=None f=no
      cell D1 t=None s=None v=2.25 is=None f=no
      cell E1 t=inlineStr s=2 v=None is=probe f=no
    row r=2
      cell A2 t=b s=None v=1 is=None f=no
    SW_EXPECTED
    echo "  the second output the edits imply, as the reader above prints it:"
    sed 's/^/    /' "$T/sw-expected"
    sw_second_as_edited() { [ "$R_SW" -eq 0 ] && cmp -s "$T/sw-expected" "$T/o-sw-check"; }
    check "the styles probe's second output is exactly the edits: the part 4 cells, one numFmt 164, two cell formats, A1 s=1 and E1 s=2" \
      "$(yn sw_second_as_edited)"
    # The control, in the same command form: the expected output with E1's style
    # taken away must not compare equal.
    sed 's/^  cell E1 t=inlineStr s=2 /  cell E1 t=inlineStr s=None /' "$T/sw-expected" >"$T/sw-control"
    sw_control_differs() { if cmp -s "$T/sw-control" "$T/o-sw-check"; then return 1; else return 0; fi; }
    check "control: the same comparison against the output with E1 unstyled says they differ" "$(yn sw_control_differs)"
    
    # The dates probe: the same arguments and the date 2024-02-29 12:00:00.000,
    # on both fixtures. The number cell holds the date's serial in the workbook's
    # epoch, 45351.5 in the 1900 system and 43889.5 in the 1904 system (the
    # serials specs/0012 pins), and the probe prints from_serial of the number read
    # back. Everything else is the styles probe's output, so the second outputs
    # must differ from the styles probe's in A1's value alone.
    for sys in 1900 1904; do
      if [ "$sys" = 1900 ]; then fx="$T/probe.xlsx"; serial=45351.5; else fx="$T/probe1904.xlsx"; serial=43889.5; fi
      # shellcheck disable=SC2086
      "$D/$DATES" "$fx" "$T/dw-$sys.xlsx" $STYLE_ARGS "$T/dw-$sys-second.xlsx" '0.000' 2024 2 29 12 0 0 0 >"$T/o-dw-$sys" 2>&1
      R_DW=$?
      echo "  run dates-write on the $sys fixture, arguments <scratch>/$(basename "$fx") <scratch>/dw-$sys.xlsx $STYLE_ARGS <scratch>/dw-$sys-second.xlsx 0.000 2024 2 29 12 0 0 0 (exit $R_DW):"
      hide <"$T/o-dw-$sys" | sed 's/^/    /'
      dw_prints() {
        [ "$R_DW" -eq 0 ] &&
          [ "$(cat "$T/o-dw-$sys")" = "$(printf '%s\ndate 2024-02-29 12:00:00.000' "$SW_EXPECTED")" ]
      }
      check "$sys: $DATES exits 0, prints the styles probe's lines and then the date read back" "$(yn dw_prints)"
      python3 "$T/read-second.py" "$fx" "$T/dw-$sys-second.xlsx" >"$T/o-dw-$sys-check" 2>&1
      sed "s/^  cell A1 t=None s=1 v=2.5 /  cell A1 t=None s=1 v=$serial /" "$T/sw-expected" >"$T/dw-$sys-expected"
      echo "  the $sys second output, as the reader prints it, against the styles probe's with A1 holding $serial:"
      diff "$T/dw-$sys-expected" "$T/o-dw-$sys-check" >"$T/dw-$sys.diff"
      drc=$?
      sed 's/^/    /' "$T/dw-$sys.diff"
      echo "    (diff exit $drc; no lines above means identical)"
      dw_second() { [ "$R_DW" -eq 0 ] && cmp -s "$T/dw-$sys-expected" "$T/o-dw-$sys-check"; }
      check "$sys: the second output is the styles probe's with A1 = $serial, the pinned serial in that epoch" "$(yn dw_second)"
    done
    # The control, in the same command form: the 1904 output against the 1900
    # expectation must differ, so the epoch was read and not assumed.
    dw_epoch_differs() { if cmp -s "$T/dw-1900-expected" "$T/o-dw-1904-check"; then return 1; else return 0; fi; }
    check "control: the 1904 fixture's output differs from the 1900 expectation" "$(yn dw_epoch_differs)"
    # And a date serial refuses: 2023-02-29 is no date, so the probe exits 2
    # before writing its second output.
    # shellcheck disable=SC2086
    "$D/$DATES" "$T/probe.xlsx" "$T/dw-bad.xlsx" $STYLE_ARGS "$T/dw-bad-second.xlsx" '0.000' 2023 2 29 12 0 0 0 >"$T/o-dw-bad" 2>&1
    R_BAD=$?
    echo "  run dates-write with 2023-02-29 (exit $R_BAD):"
    hide <"$T/o-dw-bad" | sed 's/^/    /'
    dw_refuses() {
      [ "$R_BAD" -eq 2 ] && [ ! -e "$T/dw-bad-second.xlsx" ] &&
        [ "$(cat "$T/o-dw-bad")" = "error: the date is not one the workbook's epoch can hold" ]
    }
    check "the dates probe refuses 2023-02-29 with exit 2 and its message, and writes no second output" "$(yn dw_refuses)"
    
    # The formulas probe (header change 5): the styles probe's arguments and code,
    # then the formula A1*2 at Z9, a reference the fixture's sheet does not hold,
    # so it is a new cell in a new row 9. It runs on the first fixture (no calcPr,
    # so the rewrite inserts one after <sheets>) and on the calcPr fixture (calcId
    # alone, so the rewrite appends the flag to that start tag). Its output is the
    # styles probe's lines with `written` one higher, the new cell being read back
    # too, then full_calc 1 (the rule set the flag), chain 0 (the probe drops the
    # chain itself, as the styles probe does) and formula_read_back 1.
    FORMULA_AT=Z9
    FORMULA_TEXT='A1*2'
    F_EXPECTED=$(printf '%s\n' "$SW_EXPECTED" | sed 's/^written 5$/written 6/'; printf 'full_calc 1\nchain 0\nformula_read_back 1')
    echo "  the formulas probe's expected output, the styles probe's lines with written 6, then the three:"
    printf '%s\n' "$F_EXPECTED" | sed 's/^/    /'
    # The second output, by a reader that is not emend's: the calcPr start tags in
    # the workbook part and whether that part is the input's with only that tag
    # set or inserted; the chain gone; the other parts byte-identical; then the
    # styles part and the sheet cell by cell, each cell's formula text printed.
    cat >"$T/read-formulas.py" <<'FORMULAS_PY'
    import re, sys, zipfile
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    src, out = zipfile.ZipFile(sys.argv[1]), zipfile.ZipFile(sys.argv[2])
    sn, on = src.namelist(), out.namelist()
    print("entries in: %d; entries out: %d" % (len(sn), len(on)))
    print("order preserved among the entries that stayed: %s"
          % ("yes" if [n for n in sn if n in on] == on else "no"))
    print("the chain's entry is gone: %s" % ("yes" if "xl/calcChain.xml" not in on else "no"))
    rest = [n for n in on if n not in ("[Content_Types].xml", "xl/_rels/workbook.xml.rels",
                                       "xl/worksheets/sheet1.xml", "xl/styles.xml",
                                       "xl/workbook.xml")]
    same = [n for n in rest if src.read(n) == out.read(n)]
    print("parts outside the chain recipe, the edited sheet, the styles part and the workbook part: %d, of them byte-identical to the input: %d"
          % (len(rest), len(same)))
    TAG = re.compile(rb"<calcPr\b[^>]*>")
    wb_in, wb_out = src.read("xl/workbook.xml"), out.read("xl/workbook.xml")
    tags = TAG.findall(wb_out)
    print("calcPr start tags in the output's workbook part: %d" % len(tags))
    for t in tags:
        print("  %s" % t.decode())
    print("the workbook part is the input's with only that tag set or inserted: %s"
          % ("yes" if TAG.sub(b"", wb_in) == TAG.sub(b"", wb_out) else "no"))
    styles = ET.fromstring(out.read("xl/styles.xml"))
    fmts = styles.find(M + "numFmts")
    kids = [] if fmts is None else fmts.findall(M + "numFmt")
    print("numFmts count=%s children=%d" % (None if fmts is None else fmts.get("count"), len(kids)))
    for f in kids:
        print("  numFmt id=%s code=%s" % (f.get("numFmtId"), f.get("formatCode")))
    xfs = styles.find(M + "cellXfs")
    kids = xfs.findall(M + "xf")
    print("cellXfs count=%s children=%d" % (xfs.get("count"), len(kids)))
    for x in kids:
        print("  xf numFmtId=%s fontId=%s fillId=%s borderId=%s xfId=%s applyNumberFormat=%s" % (
            x.get("numFmtId"), x.get("fontId"), x.get("fillId"), x.get("borderId"),
            x.get("xfId"), x.get("applyNumberFormat")))
    sheet = ET.fromstring(out.read("xl/worksheets/sheet1.xml"))
    for row in sheet.iter(M + "row"):
        print("row r=%s" % row.get("r"))
        for c in row.findall(M + "c"):
            v = c.find(M + "v")
            t = c.find(M + "is/" + M + "t")
            f = c.find(M + "f")
            print("  cell %s t=%s s=%s v=%s is=%s f=%s" % (
                c.get("r"), c.get("t"), c.get("s"),
                None if v is None else v.text, None if t is None else t.text,
                None if f is None else f.text))
    FORMULAS_PY
    for fxname in nocalc calc; do
      if [ "$fxname" = nocalc ]; then
        fx="$T/probe.xlsx"; tag='<calcPr fullCalcOnLoad="1"/>'
      else
        fx="$T/probe-calc.xlsx"; tag='<calcPr calcId="191029" fullCalcOnLoad="1"/>'
      fi
      # shellcheck disable=SC2086
      "$D/$FORM" "$fx" "$T/fw-$fxname.xlsx" $STYLE_ARGS "$T/fw-$fxname-second.xlsx" '0.000' "$FORMULA_AT" "$FORMULA_TEXT" >"$T/o-fw-$fxname" 2>"$T/e-fw-$fxname"
      R_FW=$?
      echo "  run formulas-write on the $fxname fixture, arguments <scratch>/w/$(basename "$fx") <scratch>/w/fw-$fxname.xlsx $STYLE_ARGS <scratch>/w/fw-$fxname-second.xlsx 0.000 $FORMULA_AT $FORMULA_TEXT (exit $R_FW; stderr bytes $(wc -c <"$T/e-fw-$fxname")):"
      sed 's/^/    /' "$T/o-fw-$fxname"
      fw_prints() { [ "$R_FW" -eq 0 ] && [ "$(cat "$T/o-fw-$fxname")" = "$F_EXPECTED" ]; }
      check "$fxname: $FORM exits 0 and prints exactly the expected sixteen lines, full_calc 1, chain 0 and formula_read_back 1 among them" "$(yn fw_prints)"
      if [ "$fxname" = nocalc ]; then
        fw_first_matches_cells() { [ "$R_FW" -eq 0 ] && cmp -s "$T/cells.xlsx" "$T/fw-nocalc.xlsx"; }
        check "nocalc: its first output is the package the cells probe writes, byte for byte" "$(yn fw_first_matches_cells)"
      fi
      python3 "$T/read-formulas.py" "$fx" "$T/fw-$fxname-second.xlsx" >"$T/o-fw-$fxname-check" 2>&1
      sed 's/^/    /' "$T/o-fw-$fxname-check"
      # The expectation, built from the styles probe's: the header lines for the
      # parts, the calcPr tag, then the styles part and the sheet with f= the
      # formula's text (None elsewhere) and the new row 9.
      {
        echo "entries in: 8; entries out: 7"
        echo "order preserved among the entries that stayed: yes"
        echo "the chain's entry is gone: yes"
        echo "parts outside the chain recipe, the edited sheet, the styles part and the workbook part: 2, of them byte-identical to the input: 2"
        echo "calcPr start tags in the output's workbook part: 1"
        echo "  $tag"
        echo "the workbook part is the input's with only that tag set or inserted: yes"
        sed -n '/^numFmts /,$p' "$T/sw-expected" | sed 's/ f=no$/ f=None/'
        echo "row r=9"
        echo "  cell $FORMULA_AT t=None s=None v=None is=None f=$FORMULA_TEXT"
      } >"$T/fw-$fxname-expected"
      echo "  the $fxname second output the edits imply, as the reader above prints it:"
      sed 's/^/    /' "$T/fw-$fxname-expected"
      fw_second() { [ "$R_FW" -eq 0 ] && cmp -s "$T/fw-$fxname-expected" "$T/o-fw-$fxname-check"; }
      check "$fxname: the second output is the styles probe's edits, the flag on the one calcPr, and $FORMULA_AT holding the formula text alone" "$(yn fw_second)"
    done
    # The controls, in the same command forms: the expected output with
    # formula_read_back 0 must not match the probe's, and the expected second
    # output without the new row must not match the reader's.
    F_CONTROL=$(printf '%s\n' "$F_EXPECTED" | sed 's/^formula_read_back 1$/formula_read_back 0/')
    fw_ctl_out() { if [ "$(cat "$T/o-fw-nocalc")" = "$F_CONTROL" ]; then return 1; else return 0; fi; }
    check "control: the output comparison refuses the expectation with formula_read_back 0" "$(yn fw_ctl_out)"
    head -n -2 "$T/fw-nocalc-expected" >"$T/fw-control"
    fw_ctl_second() { if cmp -s "$T/fw-control" "$T/o-fw-nocalc-check"; then return 1; else return 0; fi; }
    check "control: the second-output comparison refuses the expectation without row 9" "$(yn fw_ctl_second)"
    # And the reader over the unedited input: no calcPr, no Z9, the chain there.
    python3 "$T/read-formulas.py" "$T/probe.xlsx" "$T/probe.xlsx" >"$T/o-fw-input-check" 2>&1
    fw_ctl_input() {
      [ "$(count_matches -Fx "calcPr start tags in the output's workbook part: 0" "$T/o-fw-input-check")" = 1 ] &&
        [ "$(count_matches -F "cell $FORMULA_AT " "$T/o-fw-input-check")" = 0 ] &&
        [ "$(count_matches -Fx "the chain's entry is gone: no" "$T/o-fw-input-check")" = 1 ]
    }
    check "control: the reader over the unedited input finds no calcPr, no $FORMULA_AT and the chain still there" "$(yn fw_ctl_input)"
    # The sheets probe (header change 4, P4 ruling 6): the formulas probe's
    # arguments and code on a two-sheet package made from the first fixture, a
    # blank sheet "First" put before Sheet1, so the sheet removed is not the one
    # the edits name; then a sheet added as emend, moved first, renamed Sheets,
    # and First removed; and Package::new() written to a third path.
    python3 - "$T/probe.xlsx" "$T/probe-two.xlsx" <<'TWO_PY'
    import sys, zipfile
    
    src = zipfile.ZipFile(sys.argv[1])
    WS = "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"
    R = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    BLANK = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
             '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData/></worksheet>')
    with zipfile.ZipFile(sys.argv[2], "w", zipfile.ZIP_DEFLATED) as z:
        for name in src.namelist():
            data = src.read(name).decode()
            if name == "[Content_Types].xml":
                data = data.replace("</Types>", '<Override PartName="/xl/worksheets/sheet2.xml" ContentType="%s"/></Types>' % WS)
            elif name == "xl/workbook.xml":
                data = data.replace("<sheets>", '<sheets><sheet name="First" sheetId="2" r:id="rId5"/>')
            elif name == "xl/_rels/workbook.xml.rels":
                data = data.replace("</Relationships>", '<Relationship Id="rId5" Type="%s/worksheet" Target="worksheets/sheet2.xml"/></Relationships>' % R)
            z.writestr(name, data)
        z.writestr("xl/worksheets/sheet2.xml", BLANK)
    print("generated: the first fixture with a blank sheet First before Sheet1, 9 entries")
    TWO_PY
    SHEET_ADDED=emend
    SHEET_RENAMED=Sheets
    NEW_SHEETS=$SHEETS
    # The part add_sheet takes: sheet1 and sheet2 are entries, so sheet3.
    FIRST_PART=xl/worksheets/sheet3.xml
    # shellcheck disable=SC2086
    "$D/$NEW_SHEETS" "$T/probe-two.xlsx" "$T/sh.xlsx" $STYLE_ARGS "$T/sh-second.xlsx" '0.000' "$FORMULA_AT" "$FORMULA_TEXT" \
      "$SHEET_ADDED" "$SHEET_RENAMED" "$T/sh-third.xlsx" >"$T/o-sh" 2>"$T/e-sh"
    R_SH=$?
    echo "  run sheets-write, arguments <scratch>/w/probe-two.xlsx <scratch>/w/sh.xlsx $STYLE_ARGS <scratch>/w/sh-second.xlsx 0.000 $FORMULA_AT $FORMULA_TEXT $SHEET_ADDED $SHEET_RENAMED <scratch>/w/sh-third.xlsx (exit $R_SH; stderr bytes $(wc -c <"$T/e-sh")):"
    sed 's/^/    /' "$T/o-sh"
    THIRD_BYTES=$(stat -c %s "$T/sh-third.xlsx" 2>/dev/null || echo error)
    # The expected lines: the formulas probe's on the first fixture, the input's
    # sheet count 2 in place of 1, then sheets 2 (one added, one removed),
    # first_name the renamed name's length, first_part the added part's entry
    # name's length, and new_bytes the third output's size.
    SH_EXPECTED=$(printf '%s\n' "$F_EXPECTED" | sed '1s/^sheets 1$/sheets 2/'
      printf 'sheets 2\nfirst_name %s\nfirst_part %s\nnew_bytes %s' "${#SHEET_RENAMED}" "${#FIRST_PART}" "$THIRD_BYTES")
    echo "  the sheets probe's expected output, the formulas probe's lines with sheets 2 first, then the four:"
    printf '%s\n' "$SH_EXPECTED" | sed 's/^/    /'
    sh_prints() { [ "$R_SH" -eq 0 ] && [ "$(cat "$T/o-sh")" = "$SH_EXPECTED" ]; }
    check "$NEW_SHEETS exits 0 and prints exactly the expected twenty lines" "$(yn sh_prints)"
    sh_ctl() { if [ "$(cat "$T/o-sh")" = "$(printf '%s\n' "$SH_EXPECTED" | sed 's/^first_part .*/first_part 0/')" ]; then return 1; else return 0; fi; }
    check "control: the output comparison refuses the expectation with first_part 0" "$(yn sh_ctl)"
    # The second output, by a reader that is not emend's: the entries removed and
    # added against the input, the sheet list with each sheet's relationship
    # target, the calcPr start tags, the removed sheet's relationship and the
    # overrides, and whether the added part is the template's blank worksheet.
    git show "$C:crates/emend/template/xl/worksheets/sheet1.xml" >"$T/template-sheet.xml"
    cat >"$T/read-sheets.py" <<'SHEETS_PY'
    import re, sys, zipfile
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    RID = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"
    PR = "{http://schemas.openxmlformats.org/package/2006/relationships}"
    src, out = zipfile.ZipFile(sys.argv[1]), zipfile.ZipFile(sys.argv[2])
    blank = open(sys.argv[3], "rb").read()
    sn, on = src.namelist(), out.namelist()
    print("entries removed: %s" % " ".join(sorted(n for n in sn if n not in on)))
    print("entries added: %s" % " ".join(sorted(n for n in on if n not in sn)))
    rels = {r.get("Id"): r.get("Target") for r in ET.fromstring(out.read("xl/_rels/workbook.xml.rels")).iter(PR + "Relationship")}
    for sh in ET.fromstring(out.read("xl/workbook.xml")).iter(M + "sheet"):
        print("sheet %s sheetId=%s r:id=%s -> %s" % (sh.get("name"), sh.get("sheetId"), sh.get(RID), rels.get(sh.get(RID))))
    for t in re.findall(rb"<calcPr\b[^>]*>", out.read("xl/workbook.xml")):
        print("calcPr %s" % t.decode())
    print("the removed sheet's relationship rId5 is gone: %s" % ("yes" if "rId5" not in rels else "no"))
    types = out.read("[Content_Types].xml").decode()
    for part in ("xl/worksheets/sheet2.xml", "xl/calcChain.xml", "xl/worksheets/sheet3.xml"):
        print("override for /%s: %s" % (part, "yes" if ('PartName="/%s"' % part) in types else "no"))
    added = [n for n in on if n not in sn]
    print("the added part is the template's blank worksheet: %s"
          % ("yes" if added and all(out.read(n) == blank for n in added) else "no"))
    SHEETS_PY
    python3 "$T/read-sheets.py" "$T/probe-two.xlsx" "$T/sh-second.xlsx" "$T/template-sheet.xml" >"$T/o-sh-check" 2>&1
    sed 's/^/    /' "$T/o-sh-check"
    cat >"$T/sh-expected-check" <<SHCHECK
    entries removed: xl/calcChain.xml xl/worksheets/sheet2.xml
    entries added: $FIRST_PART
    sheet $SHEET_RENAMED sheetId=3 r:id=rId6 -> worksheets/sheet3.xml
    sheet Sheet1 sheetId=1 r:id=rId1 -> worksheets/sheet1.xml
    calcPr <calcPr fullCalcOnLoad="1"/>
    the removed sheet's relationship rId5 is gone: yes
    override for /xl/worksheets/sheet2.xml: no
    override for /xl/calcChain.xml: no
    override for /xl/worksheets/sheet3.xml: yes
    the added part is the template's blank worksheet: yes
    SHCHECK
    echo "  the second output the edits imply, as the reader above prints it:"
    sed 's/^/    /' "$T/sh-expected-check"
    sh_second() { [ "$R_SH" -eq 0 ] && cmp -s "$T/sh-expected-check" "$T/o-sh-check"; }
    check "the second output: First and the chain gone, the added sheet first under its new name with the template's blank part, the flag inserted" "$(yn sh_second)"
    python3 "$T/read-sheets.py" "$T/probe-two.xlsx" "$T/probe-two.xlsx" "$T/template-sheet.xml" >"$T/o-sh-input-check" 2>&1
    sh_ctl_input() { if cmp -s "$T/sh-expected-check" "$T/o-sh-input-check"; then return 1; else return 0; fi; }
    check "control: the reader over the unedited input does not give the expected lines" "$(yn sh_ctl_input)"
    # The fullstyles probe (part 2's change D, run as part 2 ran it; $FULL, since
    # $NEW names the format probe from the figures block on): the sheets probe's
    # arguments and a font name, on
    # the same two-sheet package. The fixture's styles part has one font, fill,
    # border and cell format; the sheets probe's work adds two cell formats, so
    # the full style is cell format 3, naming font 1, fill 1 and border 1, and
    # the number cell A1 takes it. Its lines are the sheets probe's with
    # xfs_after 4 and number_style 3, then the seven of this part.
    FONT_NAME=Probe
    # shellcheck disable=SC2086
    "$D/$FULL" "$T/probe-two.xlsx" "$T/fs.xlsx" $STYLE_ARGS "$T/fs-second.xlsx" '0.000' "$FORMULA_AT" "$FORMULA_TEXT" \
      "$SHEET_ADDED" "$SHEET_RENAMED" "$T/fs-third.xlsx" "$FONT_NAME" >"$T/o-fs" 2>"$T/e-fs"
    R_FS=$?
    echo "  run fullstyles-write, the sheets probe's arguments with <scratch>/w/fs*.xlsx in place of sh*.xlsx and the font name $FONT_NAME (exit $R_FS; stderr bytes $(wc -c <"$T/e-fs")):"
    sed 's/^/    /' "$T/o-fs"
    FS_THIRD=$(stat -c %s "$T/fs-third.xlsx" 2>/dev/null || echo error)
    FS_EXPECTED=$(printf '%s\n' "$SH_EXPECTED" | sed -e 's/^xfs_after 3$/xfs_after 4/' -e 's/^number_style 1$/number_style 3/' -e "s/^new_bytes .*/new_bytes $FS_THIRD/"
      printf 'fonts 2\nfills 2\nborders 2\nfull_style 3\nfull_font 1\nfull_fill 1\nfull_border 1')
    echo "  the new probe's expected output:"
    printf '%s\n' "$FS_EXPECTED" | sed 's/^/    /'
    fs_prints() { [ "$R_FS" -eq 0 ] && [ "$(cat "$T/o-fs")" = "$FS_EXPECTED" ]; }
    check "$FULL exits 0 and prints exactly the expected twenty-seven lines" "$(yn fs_prints)"
    fs_ctl() { if [ "$(cat "$T/o-fs")" = "$(printf '%s\n' "$FS_EXPECTED" | sed 's/^full_border 1$/full_border 0/')" ]; then return 1; else return 0; fi; }
    check "control: the output comparison refuses the expectation with full_border 0" "$(yn fs_ctl)"
    # The second output's styles part, read by ElementTree: each collection's
    # count and children, the last cell format's attributes and its children
    # with their attributes, and the number cell's s.
    cat >"$T/read-full.py" <<'FULL_PY'
    import sys, zipfile
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    out = zipfile.ZipFile(sys.argv[1])
    styles = ET.fromstring(out.read("xl/styles.xml"))
    for name, kid in (("fonts", "font"), ("fills", "fill"), ("borders", "border"), ("cellXfs", "xf")):
        c = styles.find(M + name)
        print("%s count=%s children=%d" % (name, c.get("count"), len(c.findall(M + kid))))
    font = styles.find(M + "fonts").findall(M + "font")[-1]
    print("last font: " + " ".join("%s%s" % (k.tag.replace(M, ""), sorted(k.attrib.items())) for k in font))
    xf = styles.find(M + "cellXfs").findall(M + "xf")[-1]
    print("last xf: " + " ".join("%s=%s" % kv for kv in sorted(xf.attrib.items())))
    for k in xf:
        print("  child %s %s" % (k.tag.replace(M, ""), " ".join("%s=%s" % kv for kv in sorted(k.attrib.items()))))
    sheet = ET.fromstring(out.read("xl/worksheets/sheet1.xml"))
    a1 = [c for c in sheet.iter(M + "c") if c.get("r") == "A1"][0]
    print("A1 s=%s" % a1.get("s"))
    FULL_PY
    python3 "$T/read-full.py" "$T/fs-second.xlsx" >"$T/o-fs-check" 2>&1
    sed 's/^/    /' "$T/o-fs-check"
    cat >"$T/fs-expected-check" <<FSCHECK
    fonts count=2 children=2
    fills count=2 children=2
    borders count=2 children=2
    cellXfs count=4 children=4
    last font: b[] sz[('val', '11.5')] color[('rgb', 'FF336699')] name[('val', '$FONT_NAME')]
    last xf: applyAlignment=1 applyBorder=1 applyFill=1 applyFont=1 applyProtection=1 borderId=1 fillId=1 fontId=1 numFmtId=0 xfId=0
      child alignment horizontal=center indent=1 shrinkToFit=1 textRotation=90 vertical=top wrapText=1
      child protection hidden=1 locked=0
    A1 s=3
    FSCHECK
    echo "  the second output's styles part the edit implies, as the reader prints it:"
    sed 's/^/    /' "$T/fs-expected-check"
    fs_second() { [ "$R_FS" -eq 0 ] && cmp -s "$T/fs-expected-check" "$T/o-fs-check"; }
    check "the fullstyles probe's second output: one font, fill and border more, the full cell format with its ids, flags and two children, on A1" "$(yn fs_second)"
    python3 "$T/read-full.py" "$T/sh-second.xlsx" >"$T/o-fs-ctl-check" 2>&1
    fs_second_ctl() { if cmp -s "$T/fs-expected-check" "$T/o-fs-ctl-check"; then return 1; else return 0; fi; }
    check "control: the same reader over the sheets probe's second output does not give those lines" "$(yn fs_second_ctl)"
    # Part 3's two probes (its change O, its P4 ruling 3), on the same two-sheet package:
    # the fullstyles probe's arguments with the number cell at C1 in place of A1
    # (C1 holds a shared string in the fixture, so the number replaces it), then
    # column 2, row 2, the freeze at B2 and the merge G5:H5, which no cell or
    # edit touches; the rowcol probe adds a row inserted at 1 and a column
    # deleted at 1, so the number cell moves from C1 to C2 and then to B2 and is
    # not deleted. The expectation is the fullstyles probe's lines with the
    # third output's size, then merges 1; the rowcol probe's adds the four
    # shift lines: all six cells are kept by the insertion, and the deletion of
    # column 1 takes the two cells there (A2, moved from A1, and A3, moved from
    # A2), leaving four.
    FMT_STYLE_ARGS="xl/worksheets/sheet1.xml $THEME_NAME $THEME_TYPE xl/worksheets/sheet1.xml C1 E1 A2 B1"
    FMT_ARGS="2 2 B2 G5:H5"
    # shellcheck disable=SC2086
    "$D/$NEW" "$T/probe-two.xlsx" "$T/fm.xlsx" $FMT_STYLE_ARGS "$T/fm-second.xlsx" '0.000' "$FORMULA_AT" "$FORMULA_TEXT" \
      "$SHEET_ADDED" "$SHEET_RENAMED" "$T/fm-third.xlsx" "$FONT_NAME" $FMT_ARGS >"$T/o-fm" 2>"$T/e-fm"
    R_FM=$?
    echo "  run format-write, arguments <scratch>/w/probe-two.xlsx <scratch>/w/fm.xlsx $FMT_STYLE_ARGS <scratch>/w/fm-second.xlsx 0.000 $FORMULA_AT $FORMULA_TEXT $SHEET_ADDED $SHEET_RENAMED <scratch>/w/fm-third.xlsx $FONT_NAME $FMT_ARGS (exit $R_FM; stderr bytes $(wc -c <"$T/e-fm")):"
    sed 's/^/    /' "$T/o-fm"
    FM_THIRD=$(stat -c %s "$T/fm-third.xlsx" 2>/dev/null || echo error)
    FM_EXPECTED=$(printf '%s\n' "$FS_EXPECTED" | sed -e "s/^new_bytes .*/new_bytes $FM_THIRD/"
      printf 'merges 1')
    echo "  the format probe's expected output, the fullstyles probe's lines with its own third output's size, then merges 1:"
    printf '%s\n' "$FM_EXPECTED" | sed 's/^/    /'
    fm_prints() { [ "$R_FM" -eq 0 ] && [ "$(cat "$T/o-fm")" = "$FM_EXPECTED" ]; }
    check "$NEW exits 0 and prints exactly the expected twenty-eight lines" "$(yn fm_prints)"
    fm_ctl() { if [ "$(cat "$T/o-fm")" = "$(printf '%s\n' "$FM_EXPECTED" | sed 's/^merges 1$/merges 0/')" ]; then return 1; else return 0; fi; }
    check "control: the output comparison refuses the expectation with merges 0" "$(yn fm_ctl)"
    fm_first_is_fs() { [ "$R_FM" -eq 0 ] && cmp -s "$T/fs.xlsx" "$T/fm.xlsx"; }
    check "its first output is the fullstyles probe's first output, byte for byte (the same first work)" "$(yn fm_first_is_fs)"
    # The second output's worksheet, read by ElementTree: the first sheetView's
    # children, the cols, rows 2 and 3, the merges, and the number cell.
    cat >"$T/read-format.py" <<'FORMAT_PY'
    import sys, zipfile
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    out = zipfile.ZipFile(sys.argv[1])
    sheet = ET.fromstring(out.read("xl/worksheets/sheet1.xml"))
    print("root children: " + " ".join(k.tag.replace(M, "") for k in sheet))
    view = sheet.find(M + "sheetViews/" + M + "sheetView")
    if view is None:
        print("sheetView: none")
    else:
        print("sheetView " + " ".join("%s=%s" % kv for kv in sorted(view.attrib.items())))
        for k in view:
            print("  %s %s" % (k.tag.replace(M, ""), " ".join("%s=%s" % kv for kv in sorted(k.attrib.items()))))
    for col in sheet.iter(M + "col"):
        print("col " + " ".join("%s=%s" % kv for kv in sorted(col.attrib.items())))
    for row in sheet.iter(M + "row"):
        if row.get("r") in ("2", "3"):
            print("row " + " ".join("%s=%s" % kv for kv in sorted(row.attrib.items())))
    mc = sheet.find(M + "mergeCells")
    print("mergeCells count=%s children=%s" % (None if mc is None else mc.get("count"),
                                                0 if mc is None else len(mc.findall(M + "mergeCell"))))
    for m in sheet.iter(M + "mergeCell"):
        print("  mergeCell ref=%s" % m.get("ref"))
    for c in sheet.iter(M + "c"):
        v = c.find(M + "v")
        if v is not None and v.text == "2.5":
            print("the number cell: %s s=%s" % (c.get("r"), c.get("s")))
    FORMAT_PY
    python3 "$T/read-format.py" "$T/fm-second.xlsx" >"$T/o-fm-check" 2>&1
    sed 's/^/    /' "$T/o-fm-check"
    cat >"$T/fm-expected-check" <<'FMCHECK'
    root children: sheetViews cols sheetData mergeCells
    sheetView workbookViewId=0
      pane activePane=bottomRight state=frozen topLeftCell=B2 xSplit=1 ySplit=1
      selection pane=bottomRight
    col customWidth=1 max=2 min=2 width=20.5
    col hidden=1 max=3 min=3
    row customHeight=1 ht=30 r=2
    row hidden=1 r=3
    mergeCells count=1 children=1
      mergeCell ref=G5:H5
    the number cell: C1 s=3
    FMCHECK
    echo "  the second output's worksheet the edits imply, as the reader prints it:"
    sed 's/^/    /' "$T/fm-expected-check"
    fm_second() { [ "$R_FM" -eq 0 ] && cmp -s "$T/fm-expected-check" "$T/o-fm-check"; }
    check "the format probe's second output: the pane at B2, column 2's width and column 3 hidden, row 2's height and row 3 hidden, one merge G5:H5, the number cell at C1" "$(yn fm_second)"
    python3 "$T/read-format.py" "$T/fs-second.xlsx" >"$T/o-fm-ctl-check" 2>&1
    fm_second_ctl() { if cmp -s "$T/fm-expected-check" "$T/o-fm-ctl-check"; then return 1; else return 0; fi; }
    check "control: the same reader over the fullstyles probe's second output does not give those lines" "$(yn fm_second_ctl)"
    
    RC_ARGS_TAIL="1 1"
    # shellcheck disable=SC2086
    "$D/$ROWCOL" "$T/probe-two.xlsx" "$T/rc.xlsx" $FMT_STYLE_ARGS "$T/rc-second.xlsx" '0.000' "$FORMULA_AT" "$FORMULA_TEXT" \
      "$SHEET_ADDED" "$SHEET_RENAMED" "$T/rc-third.xlsx" "$FONT_NAME" $FMT_ARGS "$T/rc-fourth.xlsx" 1 "$T/rc-fifth.xlsx" 1 >"$T/o-rc" 2>"$T/e-rc"
    R_RC=$?
    echo "  run rowcol-write, the format probe's arguments with <scratch>/w/rc*.xlsx in place of fm*.xlsx, then <scratch>/w/rc-fourth.xlsx 1 <scratch>/w/rc-fifth.xlsx 1 (exit $R_RC; stderr bytes $(wc -c <"$T/e-rc")):"
    sed 's/^/    /' "$T/o-rc"
    RC_THIRD=$(stat -c %s "$T/rc-third.xlsx" 2>/dev/null || echo error)
    RC_EXPECTED=$(printf '%s\n' "$FM_EXPECTED" | sed -e "s/^new_bytes .*/new_bytes $RC_THIRD/"
      printf 'cells_inserted 6\nmoved_row 2\ncells_deleted 4\nmoved_col 2')
    echo "  the rowcol probe's expected output, the format probe's lines with its own third output's size, then the four:"
    printf '%s\n' "$RC_EXPECTED" | sed 's/^/    /'
    rc_prints() { [ "$R_RC" -eq 0 ] && [ "$(cat "$T/o-rc")" = "$RC_EXPECTED" ]; }
    check "$ROWCOL exits 0 and prints exactly the expected thirty-two lines" "$(yn rc_prints)"
    rc_ctl() { if [ "$(cat "$T/o-rc")" = "$(printf '%s\n' "$RC_EXPECTED" | sed 's/^moved_col 2$/moved_col 3/')" ]; then return 1; else return 0; fi; }
    check "control: the output comparison refuses the expectation with moved_col 3" "$(yn rc_ctl)"
    rc_second_is_fm() { [ "$R_RC" -eq 0 ] && cmp -s "$T/fm-second.xlsx" "$T/rc-second.xlsx"; }
    check "its second output is the format probe's second output, byte for byte (the same work before the shifts)" "$(yn rc_second_is_fm)"
    python3 "$T/read-format.py" "$T/rc-fourth.xlsx" >"$T/o-rc4-check" 2>&1
    python3 "$T/read-format.py" "$T/rc-fifth.xlsx" >"$T/o-rc5-check" 2>&1
    echo "  the fourth output's worksheet, as the reader prints it:"
    sed 's/^/    /' "$T/o-rc4-check"
    echo "  the fifth output's worksheet, as the reader prints it:"
    sed 's/^/    /' "$T/o-rc5-check"
    rc4_moved() {
      [ "$(count_matches -Fx '  mergeCell ref=G6:H6' "$T/o-rc4-check")" = 1 ] &&
        [ "$(count_matches -E '^the number cell: C2 ' "$T/o-rc4-check")" = 1 ]
    }
    check "the fourth output: the merge and the number cell one row down (G6:H6, C2)" "$(yn rc4_moved)"
    rc5_moved() {
      [ "$(count_matches -Fx '  mergeCell ref=F6:G6' "$T/o-rc5-check")" = 1 ] &&
        [ "$(count_matches -E '^the number cell: B2 ' "$T/o-rc5-check")" = 1 ]
    }
    check "the fifth output: the merge and the number cell one column left (F6:G6, B2)" "$(yn rc5_moved)"
    rc_ctl_read() { if [ "$(count_matches -Fx '  mergeCell ref=G6:H6' "$T/o-fm-check")" = 1 ]; then return 1; else return 0; fi; }
    check "control: the same reader finds no G6:H6 merge in the format probe's second output" "$(yn rc_ctl_read)"
    echo
    # The metadata probe (change AB), on the same two-sheet package: the format
    # probe's arguments, then the name text, the link cell and the password. The
    # name text is a reference to the renamed sheet, and serves as the link's
    # external target and the title too, as the probe's source reads. The
    # fixture has no core part, so the property edit creates one. Its lines are
    # the format probe's with its own third output's size, then names 1 (the
    # one name added) and title 1 (the title read back is the one set).
    NAME_TEXT='Sheets!$A$1'
    LINK_AT=D4
    PASSWORD=emend
    # shellcheck disable=SC2086
    "$D/$META" "$T/probe-two.xlsx" "$T/md.xlsx" $FMT_STYLE_ARGS "$T/md-second.xlsx" '0.000' "$FORMULA_AT" "$FORMULA_TEXT" \
      "$SHEET_ADDED" "$SHEET_RENAMED" "$T/md-third.xlsx" "$FONT_NAME" $FMT_ARGS "$NAME_TEXT" "$LINK_AT" "$PASSWORD" >"$T/o-md" 2>"$T/e-md"
    R_MD=$?
    echo "  run metadata-write, the format probe's arguments with <scratch>/w/md*.xlsx in place of fm*.xlsx, then $NAME_TEXT $LINK_AT $PASSWORD (exit $R_MD; stderr bytes $(wc -c <"$T/e-md")):"
    sed 's/^/    /' "$T/o-md"
    MD_THIRD=$(stat -c %s "$T/md-third.xlsx" 2>/dev/null || echo error)
    MD_EXPECTED=$(printf '%s\n' "$FM_EXPECTED" | sed -e "s/^new_bytes .*/new_bytes $MD_THIRD/"
      printf 'names 1\ntitle 1')
    echo "  the metadata probe's expected output, the format probe's lines with its own third output's size, then the two:"
    printf '%s\n' "$MD_EXPECTED" | sed 's/^/    /'
    md_prints() { [ "$R_MD" -eq 0 ] && [ "$(cat "$T/o-md")" = "$MD_EXPECTED" ]; }
    check "$META exits 0 and prints exactly the expected thirty lines" "$(yn md_prints)"
    md_ctl() { if [ "$(cat "$T/o-md")" = "$(printf '%s\n' "$MD_EXPECTED" | sed 's/^title 1$/title 0/')" ]; then return 1; else return 0; fi; }
    check "control: the output comparison refuses the expectation with title 0" "$(yn md_ctl)"
    md_first_is_fs() { [ "$R_MD" -eq 0 ] && cmp -s "$T/fs.xlsx" "$T/md.xlsx"; }
    check "its first output is the fullstyles probe's first output, byte for byte (the same first work)" "$(yn md_first_is_fs)"
    md_third_is_new() { [ "$R_MD" -eq 0 ] && cmp -s "$T/sh-third.xlsx" "$T/md-third.xlsx"; }
    check "its third output is the sheets probe's third output, byte for byte (Package::new() written with no edits)" "$(yn md_third_is_new)"
    # The second output, read by ElementTree: the workbook's defined names and
    # its protection, the edited sheet's protection and hyperlinks with each
    # link's relationship from the sheet's rels part, and the core part the
    # package's relationship names with its title. The legacy hash is computed
    # here, by the iterative form of the algorithm, and checked on published
    # values before it is used.
    cat >"$T/read-meta.py" <<'META_PY'
    import sys, zipfile
    import posixpath
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    RID = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"
    PR = "{http://schemas.openxmlformats.org/package/2006/relationships}"
    DC = "{http://purl.org/dc/elements/1.1/}"
    out = zipfile.ZipFile(sys.argv[1])
    names = set(out.namelist())
    
    
    def attrs(e):
        return " ".join("%s=%s" % (k.split("}")[-1], v) for k, v in sorted(e.attrib.items()))
    
    
    def rels_of(part):
        head, tail = posixpath.split(part)
        path = posixpath.join(head, "_rels", tail + ".rels")
        if path not in names:
            return {}
        return {r.get("Id"): r for r in ET.fromstring(out.read(path)).iter(PR + "Relationship")}
    
    
    wb = ET.fromstring(out.read("xl/workbook.xml"))
    for n in wb.iter(M + "definedName"):
        print("definedName %s text=%s" % (attrs(n), n.text))
    for p in wb.iter(M + "workbookProtection"):
        print("workbookProtection %s" % attrs(p))
    sheet = ET.fromstring(out.read("xl/worksheets/sheet1.xml"))
    for p in sheet.iter(M + "sheetProtection"):
        print("sheetProtection %s" % attrs(p))
    srels = rels_of("xl/worksheets/sheet1.xml")
    for h in sheet.iter(M + "hyperlink"):
        r = srels.get(h.get(RID))
        print("hyperlink ref=%s -> %s" % (h.get("ref"), "no relationship" if r is None else
              "type=%s target=%s mode=%s" % (r.get("Type").rsplit("/", 1)[-1], r.get("Target"), r.get("TargetMode"))))
    core = [r.get("Target") for r in rels_of("").values() if r.get("Type").endswith("/core-properties")]
    print("core relationships: %d" % len(core))
    for t in core:
        part = t.lstrip("/")
        ct = out.read("[Content_Types].xml").decode()
        print("core part %s: in the archive %s; override %s" % (
            part, "yes" if part in names else "no", "yes" if ('PartName="/%s"' % part) in ct else "no"))
        if part in names:
            titles = [e.text for e in ET.fromstring(out.read(part)).iter(DC + "title")]
            print("  titles: %s" % " ".join(titles))
    META_PY
    python3 - >"$T/hash-ctl" <<'HASH_PY'
    def legacy(p):
        h = 0
        for ch in reversed(p):
            h = ((h >> 14) & 1) | ((h << 1) & 0x7FFF)
            h ^= ord(ch)
        h = ((h >> 14) & 1) | ((h << 1) & 0x7FFF)
        return h ^ len(p) ^ 0xCE4B
    for p in ("password", "test", "secret", "emend"):
        print("%s %04X" % (p, legacy(p)))
    HASH_PY
    echo "command: the legacy hash, computed in python, of password, test, secret and the probe's password"
    sed 's/^/    /' "$T/hash-ctl"
    hash_published() {
      [ "$(count_matches -Fx 'password 83AF' "$T/hash-ctl")" = 1 ] &&
        [ "$(count_matches -Fx 'test CBEB' "$T/hash-ctl")" = 1 ] &&
        [ "$(count_matches -Fx 'secret DAA7' "$T/hash-ctl")" = 1 ]
    }
    check "the python hash gives the three published values" "$(yn hash_published)"
    PW_HASH=$(sed -n "s/^$PASSWORD \([0-9A-F]\{4\}\)\$/\1/p" "$T/hash-ctl")
    echo "  the probe's password's hash: ${PW_HASH:-none}"
    check "the probe's password's hash was computed" "$(yn [ "${#PW_HASH}" -eq 4 ])"
    python3 "$T/read-meta.py" "$T/md-second.xlsx" >"$T/o-md-check" 2>&1
    sed 's/^/    /' "$T/o-md-check"
    cat >"$T/md-expected-check" <<MDCHECK
    definedName name=emend_probe text=$NAME_TEXT
    workbookProtection lockStructure=1 workbookPassword=$PW_HASH
    sheetProtection password=$PW_HASH sheet=1
    hyperlink ref=$LINK_AT -> type=hyperlink target=$NAME_TEXT mode=External
    core relationships: 1
    core part docProps/core.xml: in the archive yes; override yes
      titles: $NAME_TEXT
    MDCHECK
    echo "  the second output the four edits imply, as the reader prints it:"
    sed 's/^/    /' "$T/md-expected-check"
    md_second() { [ "$R_MD" -eq 0 ] && cmp -s "$T/md-expected-check" "$T/o-md-check"; }
    check "the metadata probe's second output: the name, both protections under the hash, the external link with its relationship, the created core part with the title" "$(yn md_second)"
    python3 "$T/read-meta.py" "$T/fm-second.xlsx" >"$T/o-md-ctl-check" 2>&1
    echo "  control: the same reader over the format probe's second output:"
    sed 's/^/    /' "$T/o-md-ctl-check"
    md_second_ctl() { if cmp -s "$T/md-expected-check" "$T/o-md-ctl-check"; then return 1; else return 0; fi; }
    check "control: the same reader over the format probe's second output does not give those lines" "$(yn md_second_ctl)"
    echo
    # The rules probe (change AL), on the same two-sheet package: the format
    # probe's arguments, then the two formulas and the area. The fixture's sheet
    # has no validation and no conditional format, and its styles part no dxfs,
    # so the validation count read back is 1, the rules 2, the style's index 0
    # (the dxfs created at the styles root's end, which has no tableStyles,
    # colors or extLst), and the priorities 1 and 2.
    FORMULA_ONE=1
    FORMULA_TWO=10
    RULE_AREA=J1:J3
    # shellcheck disable=SC2086
    "$D/$RULES" "$T/probe-two.xlsx" "$T/ru.xlsx" $FMT_STYLE_ARGS "$T/ru-second.xlsx" '0.000' "$FORMULA_AT" "$FORMULA_TEXT" \
      "$SHEET_ADDED" "$SHEET_RENAMED" "$T/ru-third.xlsx" "$FONT_NAME" $FMT_ARGS "$FORMULA_ONE" "$FORMULA_TWO" "$RULE_AREA" >"$T/o-ru" 2>"$T/e-ru"
    R_RU=$?
    echo "  run rules-write, the format probe's arguments with <scratch>/w/ru*.xlsx in place of fm*.xlsx, then $FORMULA_ONE $FORMULA_TWO $RULE_AREA (exit $R_RU; stderr bytes $(wc -c <"$T/e-ru")):"
    sed 's/^/    /' "$T/o-ru"
    RU_THIRD=$(stat -c %s "$T/ru-third.xlsx" 2>/dev/null || echo error)
    RU_EXPECTED=$(printf '%s\n' "$FM_EXPECTED" | sed -e "s/^new_bytes .*/new_bytes $RU_THIRD/"
      printf 'validations 1\nrules 2')
    echo "  the rules probe's expected output, the format probe's lines with its own third output's size, then the two:"
    printf '%s\n' "$RU_EXPECTED" | sed 's/^/    /'
    ru_prints() { [ "$R_RU" -eq 0 ] && [ "$(cat "$T/o-ru")" = "$RU_EXPECTED" ]; }
    check "$RULES exits 0 and prints exactly the expected thirty lines" "$(yn ru_prints)"
    ru_ctl() { if [ "$(cat "$T/o-ru")" = "$(printf '%s\n' "$RU_EXPECTED" | sed 's/^rules 2$/rules 1/')" ]; then return 1; else return 0; fi; }
    check "control: the output comparison refuses the expectation with rules 1" "$(yn ru_ctl)"
    ru_first_is_fs() { [ "$R_RU" -eq 0 ] && cmp -s "$T/fs.xlsx" "$T/ru.xlsx"; }
    check "its first output is the fullstyles probe's first output, byte for byte (the same first work)" "$(yn ru_first_is_fs)"
    ru_third_is_new() { [ "$R_RU" -eq 0 ] && cmp -s "$T/sh-third.xlsx" "$T/ru-third.xlsx"; }
    check "its third output is the sheets probe's third output, byte for byte (Package::new() written with no edits)" "$(yn ru_third_is_new)"
    # The second output, read by ElementTree: the edited sheet's root children,
    # its validations with their formulas, its conditional formats with their
    # rules, formulas and colour scale children, and the styles part's dxfs.
    cat >"$T/read-rules.py" <<'RULES_PY'
    import sys, zipfile
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    out = zipfile.ZipFile(sys.argv[1])
    
    
    def local(t):
        return t.split("}")[-1]
    
    
    def attrs(e):
        return " ".join("%s=%s" % (local(k), v) for k, v in sorted(e.attrib.items()))
    
    
    sheet = ET.fromstring(out.read("xl/worksheets/sheet1.xml"))
    print("root children: " + " ".join(local(k.tag) for k in sheet))
    for dvs in sheet.findall(M + "dataValidations"):
        kids = dvs.findall(M + "dataValidation")
        print("dataValidations count=%s children=%d" % (dvs.get("count"), len(kids)))
        for dv in kids:
            forms = " ".join("%s=%s" % (local(f.tag), f.text) for f in dv)
            print("  dataValidation %s %s" % (attrs(dv), forms))
    for cf in sheet.findall(M + "conditionalFormatting"):
        print("conditionalFormatting %s" % attrs(cf))
        for rule in cf.findall(M + "cfRule"):
            forms = ",".join(f.text or "" for f in rule.findall(M + "formula"))
            print("  cfRule %s formulas=%s" % (attrs(rule), forms))
            for child in rule:
                if local(child.tag) == "formula":
                    continue
                print("    %s %s: %s" % (local(child.tag), attrs(child),
                      "; ".join("%s %s" % (local(g.tag), attrs(g)) for g in child)))
    styles = ET.fromstring(out.read("xl/styles.xml"))
    print("styles root children: " + " ".join(local(k.tag) for k in styles))
    for dxfs in styles.findall(M + "dxfs"):
        kids = dxfs.findall(M + "dxf")
        print("dxfs count=%s children=%d" % (dxfs.get("count"), len(kids)))
        for dxf in kids:
            parts = []
            for part in dxf:
                inner = " ".join("%s[%s]" % (local(g.tag), " ".join([attrs(g)] + ["%s %s" % (local(h.tag), attrs(h)) for h in g]).strip()) for g in part)
                parts.append("%s{%s}" % (local(part.tag), inner))
            print("  dxf " + " ".join(parts))
    RULES_PY
    python3 "$T/read-rules.py" "$T/ru-second.xlsx" >"$T/o-ru-check" 2>&1
    sed 's/^/    /' "$T/o-ru-check"
    cat >"$T/ru-expected-check" <<RUCHECK
    root children: sheetViews cols sheetData mergeCells conditionalFormatting conditionalFormatting dataValidations
    dataValidations count=1 children=1
      dataValidation allowBlank=1 operator=between showErrorMessage=0 showInputMessage=0 sqref=$RULE_AREA type=whole formula1=$FORMULA_ONE formula2=$FORMULA_TWO
    conditionalFormatting sqref=$RULE_AREA
      cfRule dxfId=0 operator=greaterThan priority=1 type=cellIs formulas=$FORMULA_ONE
    conditionalFormatting sqref=$RULE_AREA
      cfRule priority=2 type=colorScale formulas=
        colorScale : cfvo type=min; cfvo type=max; color rgb=FFF8696B; color rgb=FF63BE7B
    styles root children: numFmts fonts fills borders cellStyleXfs cellXfs dxfs
    dxfs count=1 children=1
      dxf font{b[]} fill{patternFill[patternType=solid bgColor rgb=FFFFC7CE]}
    RUCHECK
    echo "  the second output the four edits imply, as the reader prints it:"
    sed 's/^/    /' "$T/ru-expected-check"
    ru_second() { [ "$R_RU" -eq 0 ] && cmp -s "$T/ru-expected-check" "$T/o-ru-check"; }
    check "the rules probe's second output: the validation, the two conditional formats with their rules and the colour scale, the created dxfs with its one dxf" "$(yn ru_second)"
    python3 "$T/read-rules.py" "$T/fm-second.xlsx" >"$T/o-ru-ctl-check" 2>&1
    echo "  control: the same reader over the format probe's second output:"
    sed 's/^/    /' "$T/o-ru-ctl-check"
    ru_second_ctl() { if cmp -s "$T/ru-expected-check" "$T/o-ru-ctl-check"; then return 1; else return 0; fi; }
    check "control: the same reader over the format probe's second output does not give those lines" "$(yn ru_second_ctl)"
    echo
    # The tables probe (change BF), on the same two-sheet package: the format
    # probe's arguments, then the two column names. The probe's own constants
    # put the table probe_table on AB10:AC12, past every edit the format probe's
    # arguments name (Z9, G5:H5, columns and rows 2 and 3); the fixture's sheet
    # has no table and no rels part, so the part is xl/tables/table1.xml with id
    # 1, the relationship rId1, the container created at the root's end. The two
    # header cells are read back with the rest, so `written` is the format
    # probe's two higher, then tables 1.
    COL_ONE=probe_a
    COL_TWO=probe_b
    # shellcheck disable=SC2086
    "$D/$TABLES" "$T/probe-two.xlsx" "$T/tb.xlsx" $FMT_STYLE_ARGS "$T/tb-second.xlsx" '0.000' "$FORMULA_AT" "$FORMULA_TEXT" \
      "$SHEET_ADDED" "$SHEET_RENAMED" "$T/tb-third.xlsx" "$FONT_NAME" $FMT_ARGS "$COL_ONE" "$COL_TWO" >"$T/o-tb" 2>"$T/e-tb"
    R_TB=$?
    echo "  run tables-write, the format probe's arguments with <scratch>/w/tb*.xlsx in place of fm*.xlsx, then $COL_ONE $COL_TWO (exit $R_TB; stderr bytes $(wc -c <"$T/e-tb")):"
    sed 's/^/    /' "$T/o-tb"
    TB_THIRD=$(stat -c %s "$T/tb-third.xlsx" 2>/dev/null || echo error)
    FM_WRITTEN=$(printf '%s\n' "$FM_EXPECTED" | sed -n 's/^written \([0-9]*\)$/\1/p')
    echo "  the format probe's expected written line: written ${FM_WRITTEN:-none}"
    check "the format probe's expectation holds exactly one written line" "$(yn [ "$(printf '%s\n' "$FM_EXPECTED" | count_matches -E '^written [0-9]+$' /dev/stdin)" = 1 ])"
    TB_EXPECTED=$(printf '%s\n' "$FM_EXPECTED" | sed -e "s/^new_bytes .*/new_bytes $TB_THIRD/" -e "s/^written ${FM_WRITTEN:-x}\$/written $(( ${FM_WRITTEN:-0} + 2 ))/"
      printf 'tables 1')
    echo "  the tables probe's expected output, the format probe's lines with its own third output's size and written two higher, then the one:"
    printf '%s\n' "$TB_EXPECTED" | sed 's/^/    /'
    tb_prints() { [ "$R_TB" -eq 0 ] && [ "$(cat "$T/o-tb")" = "$TB_EXPECTED" ]; }
    check "$TABLES exits 0 and prints exactly the expected twenty-nine lines" "$(yn tb_prints)"
    tb_ctl() { if [ "$(cat "$T/o-tb")" = "$(printf '%s\n' "$TB_EXPECTED" | sed 's/^tables 1$/tables 0/')" ]; then return 1; else return 0; fi; }
    check "control: the output comparison refuses the expectation with tables 0" "$(yn tb_ctl)"
    tb_written_ctl() { if [ "$(cat "$T/o-tb")" = "$(printf '%s\n' "$TB_EXPECTED" | sed "s/^written .*/written ${FM_WRITTEN:-0}/")" ]; then return 1; else return 0; fi; }
    check "control: the output comparison refuses the expectation with the format probe's written line" "$(yn tb_written_ctl)"
    tb_first_is_fs() { [ "$R_TB" -eq 0 ] && cmp -s "$T/fs.xlsx" "$T/tb.xlsx"; }
    check "its first output is the fullstyles probe's first output, byte for byte (the same first work)" "$(yn tb_first_is_fs)"
    tb_third_is_new() { [ "$R_TB" -eq 0 ] && cmp -s "$T/sh-third.xlsx" "$T/tb-third.xlsx"; }
    check "its third output is the sheets probe's third output, byte for byte (Package::new() written with no edits)" "$(yn tb_third_is_new)"
    # The second output, read by ElementTree and by bytes: the edited sheet's
    # root children, its tableParts with each tablePart's relationship, the part
    # it names with its Override and its lines, and the two header cells.
    cat >"$T/read-tables.py" <<'TABLES_PY'
    import sys, zipfile
    import posixpath
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    RID = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"
    PR = "{http://schemas.openxmlformats.org/package/2006/relationships}"
    TABLE_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.table+xml"
    out = zipfile.ZipFile(sys.argv[1])
    names = set(out.namelist())
    
    
    def local(t):
        return t.split("}")[-1]
    
    
    SHEET = "xl/worksheets/sheet1.xml"
    RELS = "xl/worksheets/_rels/sheet1.xml.rels"
    sheet = ET.fromstring(out.read(SHEET))
    print("root children: " + " ".join(local(k.tag) for k in sheet))
    rels = {}
    if RELS in names:
        rels = {r.get("Id"): r for r in ET.fromstring(out.read(RELS)).iter(PR + "Relationship")}
    ct = out.read("[Content_Types].xml").decode()
    print("table parts in the archive: %d" % len([n for n in names if n.startswith("xl/tables/")]))
    for tp in sheet.findall(M + "tableParts"):
        kids = tp.findall(M + "tablePart")
        print("tableParts count=%s children=%d" % (tp.get("count"), len(kids)))
        for k in kids:
            r = rels.get(k.get(RID))
            if r is None:
                print("  tablePart %s -> no relationship" % k.get(RID))
                continue
            target = r.get("Target")
            part = target[1:] if target.startswith("/") else posixpath.normpath(posixpath.join("xl/worksheets", target))
            over = ('<Override PartName="/%s" ContentType="%s"/>' % (part, TABLE_TYPE)) in ct
            print("  tablePart %s -> type=%s target=%s part=%s; in the archive %s; override %s" % (
                k.get(RID), r.get("Type").rsplit("/", 1)[-1], target, part,
                "yes" if part in names else "no", "yes" if over else "no"))
            if part in names:
                for line in out.read(part).decode().split("\n"):
                    print("  part line: %s" % line)
    for c in sheet.iter(M + "c"):
        if c.get("r") in ("AB10", "AC10"):
            t = c.find(M + "is/" + M + "t")
            print("header cell %s t=%s text=%s" % (c.get("r"), c.get("t"), None if t is None else t.text))
    TABLES_PY
    python3 "$T/read-tables.py" "$T/tb-second.xlsx" >"$T/o-tb-check" 2>&1
    sed 's/^/    /' "$T/o-tb-check"
    # The bytes "The part" gives (specs/0021), the probe's constants and the two
    # names put in.
    TB_MAIN=http://schemas.openxmlformats.org/spreadsheetml/2006/main
    TB_ROOT="<table xmlns=\"$TB_MAIN\" id=\"1\" name=\"probe_table\" displayName=\"probe_table\" ref=\"AB10:AC12\" totalsRowShown=\"0\"><autoFilter ref=\"AB10:AC12\"/><tableColumns count=\"2\"><tableColumn id=\"1\" name=\"$COL_ONE\"/><tableColumn id=\"2\" name=\"$COL_TWO\"/></tableColumns><tableStyleInfo name=\"TableStyleMedium2\" showFirstColumn=\"0\" showLastColumn=\"0\" showRowStripes=\"1\" showColumnStripes=\"0\"/></table>"
    cat >"$T/tb-expected-check" <<TBCHECK
    root children: sheetViews cols sheetData mergeCells tableParts
    table parts in the archive: 1
    tableParts count=1 children=1
      tablePart rId1 -> type=table target=../tables/table1.xml part=xl/tables/table1.xml; in the archive yes; override yes
      part line: <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
      part line: $TB_ROOT
    header cell AB10 t=inlineStr text=$COL_ONE
    header cell AC10 t=inlineStr text=$COL_TWO
    TBCHECK
    echo "  the second output the edit implies, as the reader prints it:"
    sed 's/^/    /' "$T/tb-expected-check"
    tb_second() { [ "$R_TB" -eq 0 ] && cmp -s "$T/tb-expected-check" "$T/o-tb-check"; }
    check "the tables probe's second output: the container created at the root's end, its one tablePart's relationship and Override, the part's exact bytes, the two header cells" "$(yn tb_second)"
    python3 "$T/read-tables.py" "$T/fm-second.xlsx" >"$T/o-tb-ctl-check" 2>&1
    echo "  control: the same reader over the format probe's second output:"
    sed 's/^/    /' "$T/o-tb-ctl-check"
    tb_second_ctl() { if cmp -s "$T/tb-expected-check" "$T/o-tb-ctl-check"; then return 1; else return 0; fi; }
    check "control: the same reader over the format probe's second output does not give those lines" "$(yn tb_second_ctl)"
    sed 's/showRowStripes="1"/showRowStripes="0"/' "$T/tb-expected-check" >"$T/tb-expected-stripes"
    tb_bytes_ctl() { if cmp -s "$T/tb-expected-stripes" "$T/o-tb-check"; then return 1; else return 0; fi; }
    check "control: the same comparison refuses the part's bytes with row stripes off" "$(yn tb_bytes_ctl)"
    echo
    # The comments probe (change BF), on the same two-sheet package: the format
    # probe's arguments, then the author and the text. The probe's constant
    # puts the comment on AB10, past every edit the format probe's arguments
    # name; the fixture has no comments part, no VML part and no rels part for
    # the sheet, so the comments part is xl/comments1.xml (rId1), the VML part
    # xl/drawings/vmlDrawing1.vml (rId2) with idmap 1 and the note _x0000_s1025
    # at Row 9, Column 27, and legacyDrawing is created at the root's end. A
    # comment adds no cell, so the lines are the format probe's with its own
    # third output's size, then comments 1.
    AUTHOR=probe_author
    NOTE_TEXT=probe_note
    # shellcheck disable=SC2086
    "$D/$COMMENTS" "$T/probe-two.xlsx" "$T/cm.xlsx" $FMT_STYLE_ARGS "$T/cm-second.xlsx" '0.000' "$FORMULA_AT" "$FORMULA_TEXT" \
      "$SHEET_ADDED" "$SHEET_RENAMED" "$T/cm-third.xlsx" "$FONT_NAME" $FMT_ARGS "$AUTHOR" "$NOTE_TEXT" >"$T/o-cm" 2>"$T/e-cm"
    R_CM=$?
    echo "  run comments-write, the format probe's arguments with <scratch>/w/cm*.xlsx in place of fm*.xlsx, then $AUTHOR $NOTE_TEXT (exit $R_CM; stderr bytes $(wc -c <"$T/e-cm")):"
    sed 's/^/    /' "$T/o-cm"
    CM_THIRD=$(stat -c %s "$T/cm-third.xlsx" 2>/dev/null || echo error)
    CM_EXPECTED=$(printf '%s\n' "$FM_EXPECTED" | sed -e "s/^new_bytes .*/new_bytes $CM_THIRD/"
      printf 'comments 1')
    echo "  the comments probe's expected output, the format probe's lines with its own third output's size, then the one:"
    printf '%s\n' "$CM_EXPECTED" | sed 's/^/    /'
    cm_prints() { [ "$R_CM" -eq 0 ] && [ "$(cat "$T/o-cm")" = "$CM_EXPECTED" ]; }
    check "$COMMENTS exits 0 and prints exactly the expected twenty-nine lines" "$(yn cm_prints)"
    cm_ctl() { if [ "$(cat "$T/o-cm")" = "$(printf '%s\n' "$CM_EXPECTED" | sed 's/^comments 1$/comments 0/')" ]; then return 1; else return 0; fi; }
    check "control: the output comparison refuses the expectation with comments 0" "$(yn cm_ctl)"
    cm_first_is_fs() { [ "$R_CM" -eq 0 ] && cmp -s "$T/fs.xlsx" "$T/cm.xlsx"; }
    check "its first output is the fullstyles probe's first output, byte for byte (the same first work)" "$(yn cm_first_is_fs)"
    cm_third_is_new() { [ "$R_CM" -eq 0 ] && cmp -s "$T/sh-third.xlsx" "$T/cm-third.xlsx"; }
    check "its third output is the sheets probe's third output, byte for byte (Package::new() written with no edits)" "$(yn cm_third_is_new)"
    # The second output, read by ElementTree: the sheet's root children, the
    # relationships legacyDrawing and the comments relationship name with their
    # Overrides, the comment, its author and text, and the VML note shape.
    cat >"$T/read-comments.py" <<'COMMENTS_PY'
    import sys, zipfile
    import posixpath
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    RID = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"
    PR = "{http://schemas.openxmlformats.org/package/2006/relationships}"
    V = "{urn:schemas-microsoft-com:vml}"
    O = "{urn:schemas-microsoft-com:office:office}"
    X = "{urn:schemas-microsoft-com:office:excel}"
    out = zipfile.ZipFile(sys.argv[1])
    names = set(out.namelist())
    ct = out.read("[Content_Types].xml").decode()
    
    
    def local(t):
        return t.split("}")[-1]
    
    
    SHEET = "xl/worksheets/sheet1.xml"
    RELS = "xl/worksheets/_rels/sheet1.xml.rels"
    sheet = ET.fromstring(out.read(SHEET))
    print("root children: " + " ".join(local(k.tag) for k in sheet))
    rels = []
    if RELS in names:
        rels = list(ET.fromstring(out.read(RELS)).iter(PR + "Relationship"))
    for r in rels:
        target = r.get("Target")
        part = posixpath.normpath(posixpath.join("xl/worksheets", target))
        print("relationship %s type=%s target=%s; in the archive %s; override %s" % (
            r.get("Id"), r.get("Type").rsplit("/", 1)[-1], target, "yes" if part in names else "no",
            "yes" if ('PartName="/%s"' % part) in ct else "no"))
    for ld in sheet.findall(M + "legacyDrawing"):
        print("legacyDrawing r:id=%s" % ld.get(RID))
    if "xl/comments1.xml" in names:
        c = ET.fromstring(out.read("xl/comments1.xml"))
        authors = ["".join(a.itertext()) for a in c.iter(M + "author")]
        for el in c.iter(M + "comment"):
            print("comment ref=%s authorId=%s text=%s authors=%s" % (
                el.get("ref"), el.get("authorId"), "".join(el.itertext()), ",".join(authors)))
    if "xl/drawings/vmlDrawing1.vml" in names:
        v = ET.fromstring(out.read("xl/drawings/vmlDrawing1.vml"))
        for idmap in v.iter(O + "idmap"):
            print("idmap data=%s" % idmap.get("data"))
        for shape in v.iter(V + "shape"):
            cd = shape.find(X + "ClientData")
            print("shape id=%s ObjectType=%s Row=%s Column=%s" % (
                shape.get("id"), None if cd is None else cd.get("ObjectType"),
                None if cd is None else cd.findtext(X + "Row"), None if cd is None else cd.findtext(X + "Column")))
    COMMENTS_PY
    python3 "$T/read-comments.py" "$T/cm-second.xlsx" >"$T/o-cm-check" 2>&1
    sed 's/^/    /' "$T/o-cm-check"
    cat >"$T/cm-expected-check" <<CMCHECK
    root children: sheetViews cols sheetData mergeCells legacyDrawing
    relationship rId1 type=comments target=../comments1.xml; in the archive yes; override yes
    relationship rId2 type=vmlDrawing target=../drawings/vmlDrawing1.vml; in the archive yes; override yes
    legacyDrawing r:id=rId2
    comment ref=AB10 authorId=0 text=$NOTE_TEXT authors=$AUTHOR
    idmap data=1
    shape id=_x0000_s1025 ObjectType=Note Row=9 Column=27
    CMCHECK
    echo "  the second output the edit implies, as the reader prints it:"
    sed 's/^/    /' "$T/cm-expected-check"
    cm_second() { [ "$R_CM" -eq 0 ] && cmp -s "$T/cm-expected-check" "$T/o-cm-check"; }
    check "the comments probe's second output: legacyDrawing created at the root's end, both parts with their relationships and Overrides, the comment with its author and text, the note shape" "$(yn cm_second)"
    python3 "$T/read-comments.py" "$T/fm-second.xlsx" >"$T/o-cm-ctl-check" 2>&1
    echo "  control: the same reader over the format probe's second output:"
    sed 's/^/    /' "$T/o-cm-ctl-check"
    cm_second_ctl() { if cmp -s "$T/cm-expected-check" "$T/o-cm-ctl-check"; then return 1; else return 0; fi; }
    check "control: the same reader over the format probe's second output does not give those lines" "$(yn cm_second_ctl)"
    echo
    # The images probe (change BF), on the same two-sheet package with the format
    # probe's arguments alone. The probe's constants put the 82-byte PNG at its
    # own 2 by 2 pixels on AB10; the fixture has no drawing and no media, so the
    # drawing part is xl/drawings/drawing1.xml (rId1) with its rels part, the
    # media entry xl/media/image1.png, and drawing is created at the root's end.
    # An image adds no cell, so the lines are the format probe's with its own
    # third output's size, then images 1.
    # shellcheck disable=SC2086
    "$D/$IMAGES" "$T/probe-two.xlsx" "$T/im.xlsx" $FMT_STYLE_ARGS "$T/im-second.xlsx" '0.000' "$FORMULA_AT" "$FORMULA_TEXT" \
      "$SHEET_ADDED" "$SHEET_RENAMED" "$T/im-third.xlsx" "$FONT_NAME" $FMT_ARGS >"$T/o-im" 2>"$T/e-im"
    R_IM=$?
    echo "  run images-write, the format probe's arguments with <scratch>/w/im*.xlsx in place of fm*.xlsx (exit $R_IM; stderr bytes $(wc -c <"$T/e-im")):"
    sed 's/^/    /' "$T/o-im"
    IM_THIRD=$(stat -c %s "$T/im-third.xlsx" 2>/dev/null || echo error)
    IM_EXPECTED=$(printf '%s\n' "$FM_EXPECTED" | sed -e "s/^new_bytes .*/new_bytes $IM_THIRD/"
      printf 'images 1')
    echo "  the images probe's expected output, the format probe's lines with its own third output's size, then the one:"
    printf '%s\n' "$IM_EXPECTED" | sed 's/^/    /'
    im_prints() { [ "$R_IM" -eq 0 ] && [ "$(cat "$T/o-im")" = "$IM_EXPECTED" ]; }
    check "$IMAGES exits 0 and prints exactly the expected twenty-nine lines" "$(yn im_prints)"
    im_ctl() { if [ "$(cat "$T/o-im")" = "$(printf '%s\n' "$IM_EXPECTED" | sed 's/^images 1$/images 0/')" ]; then return 1; else return 0; fi; }
    check "control: the output comparison refuses the expectation with images 0" "$(yn im_ctl)"
    im_first_is_fs() { [ "$R_IM" -eq 0 ] && cmp -s "$T/fs.xlsx" "$T/im.xlsx"; }
    check "its first output is the fullstyles probe's first output, byte for byte (the same first work)" "$(yn im_first_is_fs)"
    im_third_is_new() { [ "$R_IM" -eq 0 ] && cmp -s "$T/sh-third.xlsx" "$T/im-third.xlsx"; }
    check "its third output is the sheets probe's third output, byte for byte (Package::new() written with no edits)" "$(yn im_third_is_new)"
    # The second output, read by ElementTree and by bytes: the sheet's root
    # children, the drawing relationship with its Override, the drawing part's
    # lines, its rels part, and the media entry's sha256.
    cat >"$T/read-images.py" <<'IMAGES_PY'
    import hashlib, sys, zipfile
    import posixpath
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    RID = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"
    PR = "{http://schemas.openxmlformats.org/package/2006/relationships}"
    out = zipfile.ZipFile(sys.argv[1])
    names = set(out.namelist())
    ct = out.read("[Content_Types].xml").decode()
    
    
    def local(t):
        return t.split("}")[-1]
    
    
    SHEET = "xl/worksheets/sheet1.xml"
    RELS = "xl/worksheets/_rels/sheet1.xml.rels"
    sheet = ET.fromstring(out.read(SHEET))
    print("root children: " + " ".join(local(k.tag) for k in sheet))
    for d in sheet.findall(M + "drawing"):
        print("drawing r:id=%s" % d.get(RID))
    if RELS in names:
        for r in ET.fromstring(out.read(RELS)).iter(PR + "Relationship"):
            part = posixpath.normpath(posixpath.join("xl/worksheets", r.get("Target")))
            print("relationship %s type=%s target=%s; in the archive %s; override %s" % (
                r.get("Id"), r.get("Type").rsplit("/", 1)[-1], r.get("Target"),
                "yes" if part in names else "no", "yes" if ('PartName="/%s"' % part) in ct else "no"))
    if "xl/drawings/drawing1.xml" in names:
        for line in out.read("xl/drawings/drawing1.xml").decode().split("\n"):
            print("drawing line: %s" % line)
    DR = "xl/drawings/_rels/drawing1.xml.rels"
    if DR in names:
        for r in ET.fromstring(out.read(DR)).iter(PR + "Relationship"):
            part = posixpath.normpath(posixpath.join("xl/drawings", r.get("Target")))
            print("drawing relationship %s type=%s target=%s; in the archive %s" % (
                r.get("Id"), r.get("Type").rsplit("/", 1)[-1], r.get("Target"), "yes" if part in names else "no"))
    media = sorted(n for n in names if n.startswith("xl/media/"))
    for n in media:
        over = ('<Override PartName="/%s" ContentType="image/png"/>' % n) in ct
        print("media %s sha256 %s override %s" % (n, hashlib.sha256(out.read(n)).hexdigest(), "yes" if over else "no"))
    IMAGES_PY
    python3 "$T/read-images.py" "$T/im-second.xlsx" >"$T/o-im-check" 2>&1
    sed 's/^/    /' "$T/o-im-check"
    # The drawing part's bytes "Images: the parts" gives, the anchor at AB10
    # (column 27, row 9), 19050 EMU square, id 1, rId1; the PNG's sha256.
    XDR_URI=http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing
    A_URI=http://schemas.openxmlformats.org/drawingml/2006/main
    R_URI=http://schemas.openxmlformats.org/officeDocument/2006/relationships
    IM_ROOT="<xdr:wsDr xmlns:xdr=\"$XDR_URI\" xmlns:a=\"$A_URI\"><xdr:oneCellAnchor><xdr:from><xdr:col>27</xdr:col><xdr:colOff>0</xdr:colOff><xdr:row>9</xdr:row><xdr:rowOff>0</xdr:rowOff></xdr:from><xdr:ext cx=\"19050\" cy=\"19050\"/><xdr:pic><xdr:nvPicPr><xdr:cNvPr id=\"1\" name=\"Image 1\"/><xdr:cNvPicPr/></xdr:nvPicPr><xdr:blipFill><a:blip xmlns:r=\"$R_URI\" r:embed=\"rId1\"/><a:stretch><a:fillRect/></a:stretch></xdr:blipFill><xdr:spPr><a:prstGeom prst=\"rect\"><a:avLst/></a:prstGeom></xdr:spPr></xdr:pic><xdr:clientData/></xdr:oneCellAnchor></xdr:wsDr>"
    PNG_SHA=d268586051b64827ed456d804e07a48de48145ac2c7f9b7b5b79c12964551b40
    cat >"$T/im-expected-check" <<IMCHECK
    root children: sheetViews cols sheetData mergeCells drawing
    drawing r:id=rId1
    relationship rId1 type=drawing target=../drawings/drawing1.xml; in the archive yes; override yes
    drawing line: <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    drawing line: $IM_ROOT
    drawing relationship rId1 type=image target=../media/image1.png; in the archive yes
    media xl/media/image1.png sha256 $PNG_SHA override yes
    IMCHECK
    echo "  the second output the edit implies, as the reader prints it:"
    sed 's/^/    /' "$T/im-expected-check"
    im_second() { [ "$R_IM" -eq 0 ] && cmp -s "$T/im-expected-check" "$T/o-im-check"; }
    check "the images probe's second output: drawing created at the root's end, its relationship and Override, the drawing part's exact bytes, its rels part, the media entry equal to the 82-byte PNG" "$(yn im_second)"
    python3 "$T/read-images.py" "$T/fm-second.xlsx" >"$T/o-im-ctl-check" 2>&1
    echo "  control: the same reader over the format probe's second output:"
    sed 's/^/    /' "$T/o-im-ctl-check"
    im_second_ctl() { if cmp -s "$T/im-expected-check" "$T/o-im-ctl-check"; then return 1; else return 0; fi; }
    check "control: the same reader over the format probe's second output does not give those lines" "$(yn im_second_ctl)"
    # The altered copy must differ from the expectation, or the control below
    # would refuse nothing (the size dry run found a pattern that matched no
    # byte).
    sed 's/cx="19050"/cx="19051"/' "$T/im-expected-check" >"$T/im-expected-ext"
    im_ext_differs() { if cmp -s "$T/im-expected-check" "$T/im-expected-ext"; then return 1; else return 0; fi; }
    check "the extent control's copy differs from the expectation (its pattern matched)" "$(yn im_ext_differs)"
    im_bytes_ctl() { if cmp -s "$T/im-expected-ext" "$T/o-im-check"; then return 1; else return 0; fi; }
    check "control: the same comparison refuses the drawing's bytes with another extent" "$(yn im_bytes_ctl)"
    echo "## the release binaries the corpus run uses"
    # specs/0023, "P3": the corpus run uses the release binaries the size log
    # hashed (change BP: part 4d's arrangement unchanged). They are built here, in <build>/target, and hashed here. What makes
    # the run log a measurement of the same binaries is that it hashes what it
    # runs and compares it with the hashes below, read out of this log by command
    # from the "hash: <name> <target> <sha256>" lines.
    rrc=0
    for target in host "$I686"; do
      for bin in emend-copy xlsx-diff; do
        if [ "$target" = host ]; then
          echo "command: cargo build --release -p $bin --offline"
          cargo build --release -p "$bin" --offline >"$T/r-$bin-host" 2>&1 </dev/null || rrc=1
        else
          echo "command: cargo build --release -p $bin --target $I686 --offline"
          cargo build --release -p "$bin" --target "$I686" --offline >"$T/r-$bin-$I686" 2>&1 </dev/null || rrc=1
        fi
      done
    done
    check "all four release builds exit 0" "$(yn [ "$rrc" -eq 0 ])"
    R=$CARGO_TARGET_DIR
    for rel in "$R/release/emend-copy" "$R/release/xlsx-diff" \
               "$R/$I686/release/emend-copy" "$R/$I686/release/xlsx-diff"; do
      if [ -f "$rel" ]; then
        echo "  $rel: sha256 $(sha256sum <"$rel" | cut -d' ' -f1), bytes $(stat -c %s "$rel")"
      else
        echo "  $rel: MISSING"
        fail=1
      fi
    done
    rel_all_there() {
      [ -f "$R/release/emend-copy" ] && [ -f "$R/release/xlsx-diff" ] &&
        [ -f "$R/$I686/release/emend-copy" ] && [ -f "$R/$I686/release/xlsx-diff" ]
    }
    check "the four release binaries the run log will cite are all present and hashed above" \
      "$(yn rel_all_there)"
    echo "  the budget probe, $D/$NEW: sha256 ${SHA[$NEW]}, bytes ${FILE[$NEW]} (no log of this phase runs it again)"
    echo "  the features' probes, $D/$COMMENTS: sha256 ${SHA[$COMMENTS]}, bytes ${FILE[$COMMENTS]}; $D/$IMAGES: sha256 ${SHA[$IMAGES]}, bytes ${FILE[$IMAGES]} (no log of this phase runs them again)"
    new_probes_there() { [ -f "$D/$NEW" ] && [ -f "$D/$COMMENTS" ] && [ -f "$D/$IMAGES" ]; }
    check "the budget probe and the features' probes are present and hashed above" "$(yn new_probes_there)"
    echo "command: sha256sum over each binary, printed as hash: <name> <target> <sha256>"
    {
      for bin in emend-copy xlsx-diff; do
        echo "hash: $bin host $(sha256sum <"$R/release/$bin" | cut -d' ' -f1)"
        echo "hash: $bin $I686 $(sha256sum <"$R/$I686/release/$bin" | cut -d' ' -f1)"
      done
      echo "hash: $NEW $I686 $(sha256sum <"$D/$NEW" | cut -d' ' -f1)"
      echo "hash: $COMMENTS $I686 $(sha256sum <"$D/$COMMENTS" | cut -d' ' -f1)"
      echo "hash: $IMAGES $I686 $(sha256sum <"$D/$IMAGES" | cut -d' ' -f1)"
    } >"$T/hash-lines"
    cat "$T/hash-lines"
    hash_lines_ok() {
      [ "$(count_matches -E '^hash: [a-z0-9-]+ [a-z0-9_-]+ [0-9a-f]{64}$' "$T/hash-lines")" = 7 ] &&
        [ "$(count_lines "$T/hash-lines")" = 7 ]
    }
    check "seven hash lines, each a name, a target and a 64-hex sha256" "$(yn hash_lines_ok)"
    probe_hash_is_measured() {
      [ "$(sed -n "s/^hash: $NEW $I686 //p" "$T/hash-lines")" = "${SHA[$NEW]}" ] &&
        [ "$(sed -n "s/^hash: $COMMENTS $I686 //p" "$T/hash-lines")" = "${SHA[$COMMENTS]}" ] &&
        [ "$(sed -n "s/^hash: $IMAGES $I686 //p" "$T/hash-lines")" = "${SHA[$IMAGES]}" ]
    }
    check "the three probes' hash lines are the sha256s measured in the figures above" "$(yn probe_hash_is_measured)"
    # The sheets probe's third output is Package::new() written with no edits;
    # so is the first file of emend-copy's --new-sample (specs/0016 "Harness
    # runs"). The release host emend-copy just hashed writes that file here, and
    # the two are compared byte for byte (part 3 P4 carried it).
    echo "command: <build>/target/release/emend-copy <scratch>/w/ns-a.xlsx <scratch>/w/ns-b.xlsx --new-sample"
    "$R/release/emend-copy" "$T/ns-a.xlsx" "$T/ns-b.xlsx" --new-sample >"$T/o-ns" 2>&1
    R_NS=$?
    echo "  exit $R_NS; the line:"
    sed 's/^/    /' "$T/o-ns"
    echo "  <scratch>/w/ns-a.xlsx: $(stat -c %s "$T/ns-a.xlsx" 2>/dev/null) bytes, sha256 $(sha256sum <"$T/ns-a.xlsx" | cut -d' ' -f1)"
    echo "  <scratch>/w/sh-third.xlsx: $THIRD_BYTES bytes, sha256 $(sha256sum <"$T/sh-third.xlsx" | cut -d' ' -f1)"
    third_is_new() { [ "$R_NS" -eq 0 ] && cmp -s "$T/ns-a.xlsx" "$T/sh-third.xlsx"; }
    check "the sheets probe's third output is byte for byte the new workbook --new-sample writes first" "$(yn third_is_new)"
    third_ctl() { if cmp -s "$T/ns-b.xlsx" "$T/sh-third.xlsx"; then return 1; else return 0; fi; }
    check "control: the same comparison says no against --new-sample's second file, the one with cells" "$(yn third_ctl)"
    
    echo
    echo "## specs/0017 close-out ruling 4: a rerun after the run log (part 3 P4 change Q)"
    # hash_set <file>: the log's hash lines, sorted, from any log that prints
    # them as this one does.
    hash_set() { LC_ALL=C "$G" -E '^hash: [a-z0-9-]+ [a-z0-9_-]+ [0-9a-f]{64}$' "$1" | LC_ALL=C sort; }
    hash_set "$T/hash-lines" >"$T/hs-now"
    same_hashes() { [ -s "$1" ] && cmp -s "$1" "$2"; }
    # The controls run every time: this run's lines equal themselves, and a copy
    # with one hash's last character changed does not.
    sed '1s/.$/x/' "$T/hs-now" >"$T/hs-bad"
    check "control: the hash-line comparison says equal for this run's lines against themselves" "$(yn same_hashes "$T/hs-now" "$T/hs-now")"
    hs_bad_differs() { if same_hashes "$T/hs-now" "$T/hs-bad"; then return 1; else return 0; fi; }
    check "control: the same comparison says they differ with one character changed" "$(yn hs_bad_differs)"
    if [ -n "${CITED_SIZE_LOG:-}" ]; then
      CITED_SHA=$(sha256sum <"$CITED_SIZE_LOG" | cut -d' ' -f1)
      echo "  a rerun: the size log attempt the run log cites: $(basename "$CITED_SIZE_LOG"), sha256 $CITED_SHA; the run log: ${RUN_LOG:-none given}"
      cited_in_run() { [ -n "${RUN_LOG:-}" ] && [ "$(count_matches -F "$CITED_SHA" "$RUN_LOG")" -ge 1 ]; }
      check "the run log names that attempt's sha256" "$(yn cited_in_run)"
      hash_set "$CITED_SIZE_LOG" >"$T/hs-cited"
      echo "command: the hash lines of that attempt against this run's, each sorted"
      diff "$T/hs-cited" "$T/hs-now" | sed 's/^/    /'
      check "this run's hash lines equal those of the attempt the run log cites" "$(yn same_hashes "$T/hs-cited" "$T/hs-now")"
    else
      echo "  not a rerun after the run log: CITED_SIZE_LOG is not set, so the comparison above is exercised by its controls alone"
    fi
    
    
    SHORT=$(git rev-parse --short "$C")
    DATE=$(date -u +%Y-%m-%d)
    RECORD_NAME=size-m3p1-$DATE-$SHORT.md
    RECORD=$REC_DIR/$RECORD_NAME
    RECORD_OUT=$T/record.md
    WHOLE_FILE=$((FILE[$NEW] - P3_FILE))
    WHOLE_TEXT=$((TEXT[$NEW] - P3_TEXT))
    # The comparison table's rows, one per probe of part 4d's record, from the
    # figures above.
    CMP_ROWS=$(for b in $COMPARED; do
      printf '| `%s` | %s | %s | %s | %s | %s | %s |\n' "$b" "${WAS_FILE[$b]}" "${FILE[$b]}" "${WAS_SECT[$b]}" "${SECT[$b]}" "$((SECT[$b] - WAS_SECT[$b]))" "${VERDICT[$b]}"
    done)
    # The probes table: each probe's description read from part 4d's record,
    # so it is that record's words and not retyped (change BK: no probe is new).
    PROBES_TABLE=$(printf '## The probes
    
    | Binary | What it does | File bytes | Section bytes | .text bytes |
    | --- | --- | --- | --- | --- |
    '
      for b in $PROBES; do
        desc=$(awk -F'|' -v p="\`$b\`" '$2 ~ /^ `probe-/ { gsub(/^ | $/, "", $2); if ($2 == p) { d = $3; gsub(/^ | $/, "", d); print d; exit } }' "$PREV_REC")
        printf '| `%s` | %s | %s | %s | %s |
    ' "$b" "${desc:-error}" "${FILE[$b]}" "${SECT[$b]}" "${TEXT[$b]}"
      done)
    VERDICT_SUMMARY="identical ${VCOUNT[identical]:-0}, build id alone ${VCOUNT[build id alone]:-0}, build id and panic-location line numbers ${VCOUNT[build id and panic-location line numbers]:-0}, code ${VCOUNT[code]:-0}"
    echo "  the verdicts, tallied for the record: $VERDICT_SUMMARY"
    if [ "$ABOVE" = yes ]; then
      JUDGMENT="The budget figure is $JUDGED_SECT section bytes, above the ceiling by $OVER_BY, a finding for the maintainer."
    else
      JUDGMENT="The budget figure is $JUDGED_SECT section bytes, $((CEILING - JUDGED_SECT)) under the ceiling."
    fi
    if [ "$CORE_ABOVE" = yes ]; then
      CORE_WORDS="above 2000 section bytes, which the report states"
    else
      CORE_WORDS="not above 2000 section bytes"
    fi
    echo "  the judgment, for the record: $JUDGMENT"
    cat >"$RECORD_OUT" <<EOF
    # Size, Milestone 3 part 1: $DATE-$SHORT
    
    The stripped \`i686-unknown-linux-musl\` sizes of the twenty-one size probes,
    measured by \`records/logs/m3p1-p3/size.log\` after Milestone 3 part 1, the
    proof at scale (\`specs/0023-scale.md\`, "Size"). No probe changed in this
    part. The part's crate changes are P2's correctness fix, the write's refusal
    of a cell edit off the grid ($FIX), and P3's catalogue block, \`//!\` lines
    alone ($C). The budget is the core probe, \`probe-emend-format-write-xml\`,
    over \`probe-zip-xml\`, against the ceiling Milestone 2 set and Milestone 3
    keeps (\`specs/0017-fuller-styles.md\`, decision 1, A). This record follows
    \`$PREV_REC\`, part 4d's, which stands as history.
    
    - Commit: $C
    - Date: $DATE (UTC)
    - Toolchain: $RUSTC; $CARGO
    - Target: $I686
    - Profile: \`size\` in the workspace \`Cargo.toml\` (inherits release,
      opt-level "z", lto "fat", codegen-units 1, panic "abort", strip true,
      debug false)
    - \`zip\` $ZIP_V, \`default-features = false\`, features
      \`deflate-flate2-zlib-rs\`; \`quick-xml\` $QX_V behind the \`size-probe\`
      feature \`xml\`; emend behind the \`size-probe\` feature \`emend\`; emend's
      \`dates\`, \`rowcol\`, \`metadata\`, \`rules\`, \`tables\`, \`comments\` and
      \`images\` behind the \`size-probe\` features of the same names
      (\`["emend", "xml", "emend/<feature>"]\`)
    - Each probe built alone with its own \`--features\` set, the manifest's
      \`required-features\`; the core probes and \`probe-emend-format-write-xml\`
      with \`emend,xml\`, which turns on none of the seven features (the log
      reads it off \`cargo tree -e features\`)
    
    $PROBES_TABLE
    
    ## The twenty-one probes of part 4d's record against it
    
    Each of the twenty-one was rebuilt at $PREV_AT, the commit
    \`$PREV_REC\` was measured at, in a scratch clone, and the rebuild reproduced
    that log's sha256 before any comparison was made. The classification is read
    off the bytes: per-section differing-byte counts, then one of four verdicts.
    
    | Probe | Part 4d file | now | Part 4d sections | now | Difference | Verdict |
    | --- | --- | --- | --- | --- | --- | --- |
    $CMP_ROWS
    
    $FIG_UNCHANGED of the twenty-one keep every figure of part 4d's. The verdicts: $VERDICT_SUMMARY.
    A verdict of "code" is accounted for per probe by the commits that touched
    THAT probe's source causes: its own source, the workspace manifest and lock
    file, and, for a probe that links emend, \`crates/emend/src\` and
    \`crates/emend/Cargo.toml\`. The size-probe manifest, touched by
    $MAN_COMMITS commits between $PREV_AT and this commit, is listed apart and
    accounts for no verdict. \`crates/emend/src\` was touched by $EMEND_COMMITS
    commits in the same range. The log lists them and fails if a code verdict
    has no source cause behind it, with a control showing that failure.
    Among the twenty-one the largest growth is $MAX_GROWTH section bytes,
    \`$MAX_PROBE\`.
    
    ## The figures
    
    Section bytes, with the file and .text deltas beside each:
    
    | Figure | Sections | File | .text |
    | --- | --- | --- | --- |
    | the part's growth, \`probe-emend-format-write-xml\` over the same probe rebuilt at $CORE_BASE | $CORE_SECT | $CORE_FILE | $CORE_TEXT |
    | of it, P2's fix, the same probe rebuilt at $FIX over the rebuild at $CORE_BASE | $FIXSHARE_SECT | $FIXSHARE_FILE | $FIXSHARE_TEXT |
    | of it, P3's catalogue, the probe at this commit over the rebuild at $FIX | $CATSHARE_SECT | $CATSHARE_FILE | $CATSHARE_TEXT |
    | the whole growth since b728fdf, \`probe-emend-format-write-xml\` over part 3's record's figures for it | $WHOLE_SECT | $WHOLE_FILE | $WHOLE_TEXT |
    | the budget, \`probe-emend-format-write-xml\` over \`probe-zip-xml\` | $JUDGED_SECT | $JUDGED_FILE | $JUDGED_TEXT |
    | the \`comments\` feature's cost, \`probe-emend-comments-write-xml\` over \`probe-emend-format-write-xml\`, outside the budget | $CM_SECT | $CM_FILE | $CM_TEXT |
    | the \`images\` feature's cost, \`probe-emend-images-write-xml\` over \`probe-emend-format-write-xml\`, outside the budget | $IM_SECT | $IM_FILE | $IM_TEXT |
    | the \`tables\` feature's cost, \`probe-emend-tables-write-xml\` over \`probe-emend-format-write-xml\`, outside the budget | $TB_SECT | $TB_FILE | $TB_TEXT |
    | the \`rules\` feature's cost, \`probe-emend-rules-write-xml\` over \`probe-emend-format-write-xml\`, outside the budget | $RU_SECT | $RU_FILE | $RU_TEXT |
    | the \`metadata\` feature's cost, \`probe-emend-metadata-write-xml\` over \`probe-emend-format-write-xml\`, outside the budget | $MD_SECT | $MD_FILE | $MD_TEXT |
    | the \`rowcol\` feature's cost, \`probe-emend-rowcol-write-xml\` over \`probe-emend-format-write-xml\`, outside the budget | $RC_SECT | $RC_FILE | $RC_TEXT |
    | the \`dates\` feature's cost, \`probe-emend-dates-write-xml\` over \`probe-emend-styles-write-xml\`, outside the budget | $DT_SECT | $DT_FILE | $DT_TEXT |
    
    The core's growth for the part is $CORE_SECT section bytes: the format probe
    at this commit (${SECT[$NEW]}) over the same probe rebuilt at $CORE_BASE
    ($BASE_SECT), the commit part 4d's record was measured at, after which no
    commit touched the probe's own source, so the difference is the core's
    alone. It is $CORE_WORDS. Of it, P2's fix accounts for $FIXSHARE_SECT
    (classified $FIX_VERDICT) and P3's catalogue for $CATSHARE_SECT (classified
    $CAT_VERDICT): \`//!\` lines are not compiled.
    
    Beside the budget, measured again. The feature \`comments\` costs $CM_SECT section bytes over the core probe, and the feature \`images\` $IM_SECT.
    
    The whole growth since b728fdf is $WHOLE_SECT section bytes, the format probe
    at this commit over the $WHOLE_BASE part 3's record carries for it, the
    probe's own bytes included; of it, $BASE_STEP is the format probe rebuilt at
    $CORE_BASE over that figure.
    
    The ceiling is $CEILING section bytes above \`probe-zip-xml\`, the figure the
    maintainer set on 2026-09-25 (\`specs/0017-fuller-styles.md\`, "The size
    ceiling", decision 1 taken as A), judged on the core probe since Milestone 2
    part 3 (\`specs/0018-rows-and-columns.md\`, decision 7 A) and kept for
    Milestone 3 (\`ROADMAP.md\`, the Milestone 3 outline).
    $JUDGMENT
    Part 4d's record carries $PREV_BUDGET, which left $PREV_HEADROOM under the
    ceiling; this figure less it is $BUDGET_MOVE.
    By file size the same figure is $JUDGED_FILE, given beside it and not
    subtracted from a ceiling stated in another unit.
    
    ## The release binaries the run log uses
    
    \`specs/0023-scale.md\`, "P3", has part 4d's two corpus samples run again
    with the binaries this log hashed. \`emend-copy\` and \`xlsx-diff\` are
    built in the release profile for the host and for $I686 in
    \`records/logs/m3p1-p3/size.log\`, each printed there on a line
    \`hash: <name> <target> <sha256>\`, and the run log compares the sha256 of what
    it runs with the one this log printed, reading it out of this log by command.
    
    ## Reading these figures
    
    File sizes on this target change in whole 4096-byte steps. They are not
    themselves whole pages: all the probes leave the same remainder, $REM
    bytes, modulo 4096, so it is every DIFFERENCE between them that is a whole
    number of pages. A change under a page is therefore invisible in the file
    size, while the section totals, from \`size -A\`, resolve to the byte. Both
    are given for every figure above.
    EOF
    echo
    echo "## the size record, written to <scratch>/w first"
    hide <"$RECORD_OUT" | sed 's/^/    /'
    check "the record is ASCII" "$(yn [ "$(count_bytes "$NONASCII_CLASS" "$RECORD_OUT")" = 0 ])"
    check "the record carries no control byte" "$(yn [ "$(count_bytes "$CTRL_CLASS" "$RECORD_OUT")" = 0 ])"
    # U+2014 is non-ASCII, so the check above already covers it; it is asserted by
    # itself as well because CLAUDE.md names that character.
    check "the record carries no U+2014" \
      "$(yn [ "$(count_matches -F "$(printf '\342\200\224')" "$RECORD_OUT")" = 0 ])"
    check "the record names no home, mount, corpus or scratch path" \
      "$(yn [ "$(count_matches -E '(/home/|/mnt/|/Users/|emend-testing|/tmp/)' "$RECORD_OUT")" = 0 ])"
    check "the record carries no unfilled figure" "$(yn [ "$(count_matches -F 'error' "$RECORD_OUT")" = 0 ])"
    # An empty expansion leaves two pipes with only a space between them in a
    # table row, or a verdict cell empty; the check reads the record for either.
    check "the record carries no empty table cell" "$(yn [ "$(count_matches -E '\| +\|' "$RECORD_OUT")" = 0 ])"
    rec_ceiling_words() {
      if [ "$ABOVE" = yes ]; then
        [ "$(count_matches -F "section bytes, above the ceiling by $OVER_BY," "$RECORD_OUT")" = 1 ]
      else
        [ "$(count_matches -F "section bytes, $((CEILING - JUDGED_SECT)) under the ceiling." "$RECORD_OUT")" = 1 ]
      fi
    }
    check "the record states the judgment of the ceiling on the core probe as a fact" "$(yn rec_ceiling_words)"
    rec_feature_fact() { [ "$(count_matches -F "The feature \`comments\` costs $CM_SECT section bytes" "$RECORD_OUT")" = 1 ] && [ "$(count_matches -F "the feature \`images\` $IM_SECT" "$RECORD_OUT")" = 1 ]; }
    check "the record states the two features' costs as facts" "$(yn rec_feature_fact)"
    rec_split_fact() { [ "$(count_matches -F "Of it, P2's fix accounts for $FIXSHARE_SECT" "$RECORD_OUT")" = 1 ] && [ "$(count_matches -F "P3's catalogue for $CATSHARE_SECT" "$RECORD_OUT")" = 1 ]; }
    check "the record states the split of the part's growth as facts" "$(yn rec_split_fact)"
    rec_core_fact() { [ "$(count_matches -F "The core's growth for the part is $CORE_SECT section bytes" "$RECORD_OUT")" = 1 ]; }
    check "the record states the core's growth as a fact" "$(yn rec_core_fact)"
    rec_no_negative_under() { [ "$(count_matches -E '-[0-9]+ under the ceiling' "$RECORD_OUT")" = 0 ]; }
    check "the record gives no negative number under the ceiling" "$(yn rec_no_negative_under)"
    printf 'which leaves\n-85776 under the ceiling. By file size\n' >"$T/neg-under"
    neg_ctl() { [ "$(count_matches -E '-[0-9]+ under the ceiling' "$T/neg-under")" = 1 ]; }
    check "control: the same form finds a negative figure's wording in a fixture" "$(yn neg_ctl)"
    rec_rows() { [ "$(count_matches -E '^\| `probe-[a-z-]+` \| [0-9]+ \| [0-9]+ \| [0-9]+ \| [0-9]+ \| -?[0-9]+ \| [a-z ,-]+ \|$' "$RECORD_OUT")" = "$N_COMPARED" ]; }
    check "the record's comparison table has a row for each of the $N_COMPARED probes of part 4d's record" "$(yn rec_rows)"
    N_PROBES=$(printf '%s\n' $PROBES | count_lines /dev/stdin)
    rec_probe_rows() { [ "$(count_matches -E '^\| `probe-[a-z-]+` \| .* \| [0-9]+ \| [0-9]+ \| [0-9]+ \|$' "$RECORD_OUT")" = "$N_PROBES" ]; }
    check "the record's probes table has a row with three figures for each of the $N_PROBES probes" "$(yn rec_probe_rows)"
    # Every figure the record carries is one this log printed (0017 close-out
    # ruling 4): each figure-table row's three numbers, read back from the record,
    # appear in the log's own figures lines above.
    # Attempt 2: each row is found by its label's start AND its figures, on one
    # line. Attempt 1 counted the figures alone, and the part's growth and P2's
    # fix share carry the same three figures (the catalogue adds none), so that
    # count was 2 on a correct record.
    row_is() {
      awk -v pre="$1" -v figs="$2" 'index($0, pre) == 1 && substr($0, length($0) - length(figs) + 1) == figs { n++ } END { print n + 0 }' "$3"
    }
    rec_figs_ok() {
      [ "$(row_is '| the `comments` feature' "| $CM_SECT | $CM_FILE | $CM_TEXT |" "$RECORD_OUT")" = 1 ] &&
        [ "$(row_is '| the `images` feature' "| $IM_SECT | $IM_FILE | $IM_TEXT |" "$RECORD_OUT")" = 1 ] &&
        [ "$(row_is "| the part's growth," "| $CORE_SECT | $CORE_FILE | $CORE_TEXT |" "$RECORD_OUT")" = 1 ] &&
        [ "$(row_is '| the whole growth since' "| $WHOLE_SECT | $WHOLE_FILE | $WHOLE_TEXT |" "$RECORD_OUT")" = 1 ] &&
        [ "$(row_is '| the budget,' "| $JUDGED_SECT | $JUDGED_FILE | $JUDGED_TEXT |" "$RECORD_OUT")" = 1 ] &&
        [ "$(row_is "| of it, P2's fix," "| $FIXSHARE_SECT | $FIXSHARE_FILE | $FIXSHARE_TEXT |" "$RECORD_OUT")" = 1 ] &&
        [ "$(row_is "| of it, P3's catalogue," "| $CATSHARE_SECT | $CATSHARE_FILE | $CATSHARE_TEXT |" "$RECORD_OUT")" = 1 ]
    }
    check "the record's figures rows carry the figures this log printed in its figures block, each row by its label" "$(yn rec_figs_ok)"
    printf '%s\n' "| the budget, x | 1 | 2 | 3 |" "| the part's growth, y | 1 | 2 | 3 |" >"$T/c-rows"
    check "control: row_is finds one row by its label and figures" "$(yn [ "$(row_is '| the budget,' '| 1 | 2 | 3 |' "$T/c-rows")" = 1 ])"
    check "control: row_is finds no row when the figures sit under another label" "$(yn [ "$(row_is '| the budget,' '| 1 | 2 | 4 |' "$T/c-rows")" = 0 ])"
    echo "  the whole growth's file and .text, printed for the record: file ${FILE[$NEW]} - $P3_FILE = $WHOLE_FILE; .text ${TEXT[$NEW]} - $P3_TEXT = $WHOLE_TEXT"
    echo
    echo "## the size record, installed (change BQ, specs/0017 close-out ruling 4)"
    echo "  the record's path: $RECORD"
    if [ -e "$RECORD" ]; then
      echo "  a record is already there: sha256 $(sha256sum <"$RECORD" | cut -d' ' -f1), bytes $(stat -c %s "$RECORD")"
      if [ -n "${RERUN_NOTE:-}" ]; then
        echo "  this is a rerun, so it is replaced"
      else
        check "no record is at the record's path before a first attempt" no
      fi
    fi
    echo "command: mkdir -p $REC_DIR; cp <scratch>/w/record.md $RECORD; sha256sum $RECORD"
    mkdir -p "$REC_DIR"
    cp "$RECORD_OUT" "$RECORD"
    REC_SHA=$(sha256sum <"$RECORD" | cut -d' ' -f1)
    echo "  installed: $RECORD, sha256 $REC_SHA, bytes $(stat -c %s "$RECORD")"
    rec_installed() { cmp -s "$RECORD_OUT" "$RECORD" && [ "$REC_SHA" = "$(sha256sum <"$RECORD_OUT" | cut -d' ' -f1)" ]; }
    check "the installed record is the one written above, byte for byte" "$(yn rec_installed)"
    rec_install_ctl() { if cmp -s "$RECORD_OUT" "$T/neg-under"; then return 1; else return 0; fi; }
    check "control: the same comparison says no against another file" "$(yn rec_install_ctl)"
    echo
    echo "## status after the run"
    # This phase's logs, its records and its size record, and planning's
    # uncommitted spec when it stands modified (changes BJ and BQ).
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_untracked_log=$(run_matches -E '^[?][?] records/logs/m3p1-p3' git status --porcelain)
    st_tracked_log=$(run_matches -E '^ ?[MARCD] records/logs/m3p1-p3' git status --porcelain)
    st_record=$(run_matches -E '^(\?\?| ?[MARCD]) records/(m3p1-p3-|m3p1-open-|m3p1-scale-[cd]-(shared-strings|cells)-|scale-m3p1-)' git status --porcelain)
    st_size=$(run_matches -E '^(\?\?| ?[MARCD]) records/size-m3p1-' git status --porcelain)
    st_planning=$(run_matches -E '^ M specs/0023-scale[.]md$' git status --porcelain)
    echo "status lines: $st_all; untracked under the log directory: $st_untracked_log; tracked and modified under it: $st_tracked_log; the phase's record pairs: $st_record; its size record: $st_size; planning's uncommitted spec: $st_planning"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_untracked_log" != error ] &&
        [ "$st_tracked_log" != error ] && [ "$st_record" != error ] && [ "$st_size" != error ] &&
        [ "$st_planning" != error ] &&
        [ "$st_all" = "$((st_untracked_log + st_tracked_log + st_record + st_size + st_planning))" ]
    }
    check "every change in the working tree is one of this phase's logs or its records, or planning's uncommitted spec" "$(yn status_accounted)"
    # The control, in the same form over a listing: a source file modified beside
    # a size record is not accounted for.
    printf '%s\n' "?? records/$RECORD_NAME" " M crates/emend/src/package.rs" >"$T/status-ctl"
    st_ctl_all=$(count_lines "$T/status-ctl")
    st_ctl_size=$(count_matches -E '^(\?\?| ?[MARCD]) records/size-m3p1-' "$T/status-ctl")
    status_ctl() { if [ "$st_ctl_all" = "$st_ctl_size" ]; then return 1; else return 0; fi; }
    check "control: the same count refuses a listing with a source file modified beside the size record" "$(yn status_ctl)"
    spec_end=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "  $SPEC at the phase commit, at the end of the run: sha256 $spec_end; the working tree's copy: $(sha256sum <"$SPEC" | cut -d' ' -f1)"
    check "the spec at the phase commit is still at the pin at the end of the run" "$(yn [ "$spec_end" = "$SPEC_SHA" ])"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$T/c-err"; printf 'x' >>"$T/c-err"
    nerr_ctl=$(wc -c <"$T/c-err")
    echo "  command: wc -c <scripts>/out/size.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # Every check that was not as expected, by name.
    echo "checks not as expected: ${#FAILED[@]}"
    for f in "${FAILED[@]}"; do echo "  $f"; done
    echo "size log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    # Close the scrub's input and wait for it, so the log's last line is written
    # before the script exits.
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

