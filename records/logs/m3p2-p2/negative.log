    #!/usr/bin/env bash
    # Milestone 3 part 2 P2 negative.log (specs/0024-rich-text.md, "P2": "The
    # negative log through the binary: the sample on the two 4d fixtures (a
    # comments part with no legacyDrawing, two legacyDrawing elements), each
    # refused, with a control"). One family, the gate's host debug binary copied
    # into a detached worktree of the phase commit and checked against gate.log's
    # hash, on fictional packages this log builds from the phase commit's
    # template files. The template's worksheet holds an empty sheetData alone,
    # its root binds no relationships prefix, and it has no comments part, VML
    # part or rels part:
    #
    # (N) --richcomment-sample, the template's worksheet children after its
    #     sheetData (or the sheetData itself) set per case, a kept comments part
    #     (one comment, on C3, by the author kept, its text a plain t or one run
    #     with an rPr), a kept VML part holding that comment's note, and their
    #     relationships and Overrides added where the case holds them:
    #       N0 the bare template: both parts and the rels part are created, the
    #          root retagged, exit 0, its line;
    #       N1 a comments part and its relationship and no legacyDrawing: the
    #          comments read message (part 4d's first fixture);
    #       N2 both parts kept and legacyDrawing naming the VML part, the kept
    #          comment a plain t, the control for N1 and N3: exit 0, its line;
    #       N3 N2 with two legacyDrawing elements: the two-element message
    #          (part 4d's second fixture);
    #       N4 one row numbered 1048576, the grid's last, holding one number
    #          cell: the sample's cell is past the grid, the index message;
    #       N4C the same with the row numbered 1048575, the control for N4: the
    #          comment goes on the grid's last row, exit 0, its line;
    #       N5 N2 with the kept comment one run whose rPr holds a b with a val
    #          this layer cannot read: the run properties message, from the
    #          comments read;
    #       N5C the same with a plain b, the control for N5: exit 0, its line,
    #          the kept comment counted rich before and after.
    # Each refusal: exit 2, the error line exactly the message the committed
    # source holds, no stdout, no output file. Then the messages the rich
    # comment meets, read from the source by constant name, compared as SETS
    # with those reached here and those the log states unreachable, with the
    # reason and the covering test for each; and usage shapes.
    #
    # CARRIED TO M3 part 2 P2 from M3 part 2 P1's negative script (printed in
    # records/logs/m3p2-p1/negative.log, byte-identical to its copy kept on the
    # disk under <home>/.cache/emend-build/m3p2-p1/scripts, which this phase
    # keeps as <home>/.cache/emend-build/m3p2-p2/gen/negative-template-m3p2-p1.sh;
    # its change lists EA to EG stand in that log), with the comment fixtures of
    # M2 part 4d P1's negative script (records/logs/m2p4d-p1/negative.log, its
    # gen-c.py C1 to C3), edited by hand and grepped for part 2 P1's tokens in
    # every form (m3p2-p1, the P1 subjects, ae37a294, b0b73334, 7d2f40d,
    # richtext-sample, the R cases, RICH_TEXT_INVALID, richtext.rs). What
    # differs, and why:
    #  FA. The phase, the log directory, the subjects and the build directories
    #      are M3 part 2 P2's. The base is M3 part 2 P1's record commit ("M3
    #      part 2 P1 record:"); the doc commit and the three code commits by
    #      their full P2 subjects. The spec pin is specs/0024's blob at P2's doc
    #      commit, 23c6111c. The working file holds planning's uncommitted
    #      "Planning rulings during P2"; the status pattern allows that one
    #      line, this phase's logs and its records/m3p2-p2- and records/m3p2-open-
    #      stems.
    #  FB. The family is N0 to N5C above, the generator gen-n.py from part 4d's
    #      gen-c.py (its C0 to C3 are N0 to N3) with P1's last-row case (N4,
    #      N4C) and a kept comment of one run (N5, N5C). The spec's two
    #      refusals with their controls are N1 and N3 against N2 (and N1 against
    #      N0, as part 4d's log did); N4 and N5 reach the index message and the
    #      run properties message through the binary, each with its control.
    #  FC. P2 adds no message (specs/0024 "Errors"). The messages this log
    #      accounts for are the ones the rich comment meets of the part's: those
    #      Parts::add_rich_comment returns by constant in the phase commit's
    #      crates/emend/src/package.rs, and those Font::check and check_color
    #      return in crates/emend/src/styles/elements.rs, each body's Err(NAME)
    #      constants read by a reader printed below, less part 3's index message
    #      (recorded apart as in P1); with RUN_PROPERTIES_UNREADABLE from
    #      crates/emend/src/cells.rs, which the comments read now raises. Each
    #      message is read by constant name. The write-time messages N1 and N3
    #      reach are part 4d's and are recorded apart, beside the index message.
    #      The call's messages are stated unreachable through the tool (its
    #      author and its runs are constants), each with its covering test in
    #      crates/emend/src/package/tests/comments/rich.rs.
    #  FD. Nothing of P1's carried rules is dropped: the short-sha, null and
    #      fabricated commit controls (EE), the scratch directory kept on the
    #      disk under <build> (EF; this script removes no directory, the
    #      worktree going by git worktree remove), the usage
    #      shapes (EG) with the rich comment sample.
    #
    # Usage: m3p2-p2-negative.sh <phase commit> [<gate log> [<gate build dir>]]
    # > <file outside the tree>; the caller moves the output to
    # records/logs/m3p2-p2/negative.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/negative.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    GATE_LOG=${2:-records/logs/m3p2-p2/gate.log}
    GATE_BUILD=${3:-$HOME/.cache/emend-build/m3p2-p2/gate}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    BUILD_ROOT=${NEGATIVE_BUILD:-$HOME/.cache/emend-build/m3p2-p2/negative}
    SUPERSEDED_DIR=$HOME/.cache/emend-build/m3p2-p2/superseded
    GATE_BIN=$GATE_BUILD/target/debug/emend-copy
    SPEC=specs/0024-rich-text.md
    SPEC_WANT=23c6111c2608438c0a5fe2d7459742d198ea2b914e5791a5134fb304cf7a831e
    mkdir -p "$BUILD_ROOT" || exit 2
    TREE=$BUILD_ROOT/tree
    if [ -e "$TREE" ]; then echo "$TREE is already there" >&2; exit 2; fi
    # Change FD (P1 change EF): made on the disk under <build> and kept after the run.
    B=$(mktemp -d -p "$BUILD_ROOT") || exit 2
    cleanup() {
      git worktree remove --force "$TREE" >/dev/null 2>&1
    }
    trap cleanup EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    # Change FD (P1 change EE): the real commit with its last hex digit changed, and its short form.
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT_SHA=${C:0:7}
    # This phase's logs and records, and planning's uncommitted spec (change FA).
    OURS='^((\?\?| ?[MARCD]) records/logs/m3p2-p2|(\?\?| ?[MARCD]) records/m3p2-(p2|open)-| M specs/0024-rich-text[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs, records and planning's spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$TREE#<tree>#g" -e "s#$B#<scratch>/w#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$GATE_BUILD#<gatebuild>#g" -e "s#$SUPERSEDED_DIR#<superseded>#g" \
        -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    # The environment and path inputs, each on its labelled line.
    echo "input: RERUN_NOTE: ${RERUN_NOTE:-unset}"
    echo "input: RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: HOME: set, read for the paths under it, printed as <home>"
    echo "input: NEGATIVE_BUILD: ${NEGATIVE_BUILD:-unset} (the build root, <build>)"
    echo "input: the gate log: $GATE_LOG"
    echo "input: the gate build directory: $GATE_BUILD"
    echo "input: python3: $(python3 --version 2>&1)"
    echo "about: M3 part 2 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M3 part 2 P1 record: logs, corpus and open-check records, the independent check')
    DOC1=$(by_subject 'M3 part 2 P2: commit planning docs (the P1 rulings and verification)')
    CODE1=$(by_subject 'M3 part 2 P2: an empty run is dropped at the read')
    CODE2=$(by_subject 'M3 part 2 P2: rich text in a comment behind comments and richtext')
    CODE3=$(by_subject 'M3 part 2 P2: emend-copy --richcomment-sample')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  M3 part 2 P1's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  code commit 1 (P1 verification ruling 4, the empty runs): ${CODE1:-none}"
    echo "  code commit 2 (the crate): ${CODE2:-none}"
    echo "  code commit 3 (the tool): ${CODE3:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CODE3" "$CODE2" "$CODE1" "$DOC1" "$REC"; do
