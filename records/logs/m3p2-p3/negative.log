    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them this phase's logs or records or planning's spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT_SHA")"
    short_names_head() { [ "$(git rev-parse "$SHORT_SHA")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    ours_ctl() { printf ' M crates/emend/src/cells.rs\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified source file" "$(ynnot ours_ctl)"
    ours_spec_ctl() { printf ' M specs/0023-scale.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified spec other than specs/0024" "$(ynnot ours_spec_ctl)"
    ours_rec_ctl() { printf '?? records/m3p2-p3-richtext-2026-01-01-abcdef0.md\n?? records/m3p2-open-2026-01-01-abcdef0.md\n?? records/size-m3p2-2026-01-01-abcdef0.md\n?? records/m3p2-p2-2026-10-03-x.md\n?? records/size-m3p1-2026-10-02-x.md\n?? records/logs/m3p2-p3/gate.log\n?? records/logs/m3p2-p2/gate.log\n' | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern takes this phase's three record stems and log, and no earlier phase's record, size record or log" "$(yn [ "$(ours_rec_ctl)" = 4 ])"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_BLOB=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum: $SPEC_BLOB; sha256sum $SPEC (the working file, printed and not asserted; equal to the blob unless planning holds rulings uncommitted; change GA): $SPEC_HAVE"
    check "the spec's blob at the phase commit is at the hash this log pins" "$(yn [ "$SPEC_BLOB" = "$SPEC_WANT" ])"
    spec_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$SPEC_WANT" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot spec_ctl)"
    echo "every fixture is built by this log from the phase commit's template files; no corpus file is copied or read"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    echo
    echo "## the two families through the gate's binary, copied into a worktree"
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    echo "command: git worktree add --detach <tree> <phase commit>"
    git worktree add --detach "$TREE" "$C" >/dev/null 2>&1
    check "the worktree is at the phase commit" "$(yn [ "$(git -C "$TREE" rev-parse HEAD)" = "$C" ])"
    HASH_FORM='^  <[a-z]+>/target/debug/emend-copy: sha256 [0-9a-f]{64}, bytes [0-9]+$'
    nhash=$(count_matches -E "$HASH_FORM" "$GATE_LOG")
    GATED=$(sed -n -E 's#^  <[a-z]+>/target/debug/emend-copy: sha256 ([0-9a-f]{64}), bytes [0-9]+$#\1#p' "$GATE_LOG" | head -n 1)
    echo "command: count_matches -E and sed for the host emend-copy hash line in $GATE_LOG (sha256 $(sha_of "$GATE_LOG")): lines $nhash; hash $GATED"
    check "gate.log holds exactly one host emend-copy hash line" "$(yn [ "$nhash" = 1 ])"
    printf '  <build>/target/debug/emend-copy: sha256 %s, bytes 1\n  <build>/target/i686-unknown-linux-musl/debug/emend-copy: sha256 %s, bytes 1\n' \
      "$(printf 'a' | sha256sum | cut -d' ' -f1)" "$(printf 'b' | sha256sum | cut -d' ' -f1)" >"$B/c-gate.log"
    check "control: the same form counts one line in a fixture holding a host and an i686 line" "$(yn [ "$(count_matches -E "$HASH_FORM" "$B/c-gate.log")" = 1 ])"
    echo "command: mkdir <tree>/bin; cp <gatebuild>/target/debug/emend-copy <tree>/bin/emend-copy"
    mkdir "$TREE/bin" && cp "$GATE_BIN" "$TREE/bin/emend-copy"
    BIN=$TREE/bin/emend-copy
    echo "  <tree>/bin/emend-copy: sha256 $(sha_of "$BIN")"
    check "the copied binary is the one gate.log hashed, not a rebuild" "$(yn [ "$(sha_of "$BIN")" = "$GATED" ])"
    check "control: the reader found a hash in gate.log" "$(yn [ -n "$GATED" ])"
    echo
    echo "### the messages, read from the phase commit's source by constant name (change GC)"
    git show "$C:crates/emend/src/cells.rs" >"$B/cells.rs"
    git show "$C:crates/emend/src/package.rs" >"$B/package.rs"
    git show "$C:crates/emend/src/styles/elements.rs" >"$B/elements.rs"
    cat >"$B/messages.py" <<'PY'
    """The Error::Package messages of a Rust source file, by constant name, one
    per line as NAME<TAB>message in source order; a constant with or without
    pub(crate). With --name N, only N.
    Usage: messages.py <file.rs> [--name N]."""
    import re
    import sys
    
    text = open(sys.argv[1]).read()
    found = re.findall(r'^(?:pub\(crate\) )?const ([A-Z_0-9]+): Error =\s*Error::Package\(\s*"([^"]*)",?\s*\);',
                       text, re.M)
    args = sys.argv[2:]
    if args[:1] == ["--name"]:
        found = [(n, m) for n, m in found if n == args[1]]
    for n, m in found:
        print("%s\t%s" % (n, m))
    PY
    sed 's/^/    /' "$B/messages.py"
    cat >"$B/returns.py" <<'PY'
    """The constants a Rust fn returns as Err(NAME), in source order, each once:
    the fn whose signature line starts, after its indentation, with the given
    text, the first such line after the line holding --after when given, read
    to the closing brace at the signature's indentation.
    Usage: returns.py <file.rs> <signature start> [--after <text>]."""
    import re
    import sys
    
    lines = open(sys.argv[1]).read().split("\n")
    sig = sys.argv[2]
    start = 0
    if sys.argv[3:4] == ["--after"]:
        start = next(k for k, l in enumerate(lines) if sys.argv[4] in l)
    k = next(k for k in range(start, len(lines)) if lines[k].lstrip().startswith(sig))
    indent = lines[k][: len(lines[k]) - len(lines[k].lstrip())]
    end = next(m for m in range(k + 1, len(lines)) if lines[m] == indent + "}")
    seen = []
    for name in re.findall(r"Err\(([A-Z_0-9]+)\)", "\n".join(lines[k:end + 1])):
        if name not in seen:
            seen.append(name)
    for name in seen:
        print(name)
    PY
    sed 's/^/    /' "$B/returns.py"
    echo "command: python3 <scratch>/w/returns.py <scratch>/w/cells.rs 'pub(crate) fn check(&self)' --after 'impl RichText {' (RichText::check, the rich value's check at the write)"
    python3 "$B/returns.py" "$B/cells.rs" 'pub(crate) fn check(&self)' --after 'impl RichText {' >"$B/value.names"
    echo "  exit: $?"
    sed 's/^/    /' "$B/value.names"
    echo "command: python3 <scratch>/w/returns.py <scratch>/w/package.rs 'fn add_rich_comment(' (the body of Parts::add_rich_comment, the private fn: the public one's line starts with pub)"
    python3 "$B/returns.py" "$B/package.rs" 'fn add_rich_comment(' >"$B/call.names"
    echo "  exit: $?"
    sed 's/^/    /' "$B/call.names"
    echo "command: python3 <scratch>/w/returns.py <scratch>/w/elements.rs 'pub(crate) fn check(&self)' --after 'impl Font {', and 'fn check_color(' (Font::check and the colour check it calls)"
    python3 "$B/returns.py" "$B/elements.rs" 'pub(crate) fn check(&self)' --after 'impl Font {' >"$B/font.names"
    echo "  exit: $?"
    python3 "$B/returns.py" "$B/elements.rs" 'fn check_color(' >>"$B/font.names"
    echo "  exit: $?"
    sed 's/^/    /' "$B/font.names"
    # Each name is read from the file that defines it, the first of cells.rs,
    # package.rs and elements.rs that holds it; the index message apart.
    LC_ALL=C sort -u "$B/value.names" "$B/call.names" "$B/font.names" >"$B/all.names"
    : >"$B/part.tsv"
    : >"$B/index.tsv"
    : >"$B/nofile.names"
    while read -r name; do
      found=
      for f in cells package elements; do
        if [ -n "$(python3 "$B/messages.py" "$B/$f.rs" --name "$name")" ]; then found=$f; break; fi
      done
      if [ -z "$found" ]; then printf '%s\n' "$name" >>"$B/nofile.names"; continue; fi
      if [ "$name" = INDEX_OUT_OF_RANGE ]; then
        python3 "$B/messages.py" "$B/$found.rs" --name "$name" >>"$B/index.tsv"
      else
        python3 "$B/messages.py" "$B/$found.rs" --name "$name" >>"$B/part.tsv"
      fi
    done <"$B/all.names"
    if [ "$(awk -F"$TAB" '$1 == "RUN_PROPERTIES_UNREADABLE"' "$B/part.tsv" | count_lines /dev/stdin)" = 0 ]; then
      python3 "$B/messages.py" "$B/cells.rs" --name RUN_PROPERTIES_UNREADABLE >>"$B/part.tsv"
    fi
    echo "command: python3 <scratch>/w/messages.py <file> --name <NAME>, for each name above (sorted, each once) from the first of cells.rs, package.rs and elements.rs defining it, and RUN_PROPERTIES_UNREADABLE from cells.rs; the index message apart"
    echo "  the messages the two samples' edits meet of the part's:"
    sed 's/^/    /' "$B/part.tsv"
    echo "  part 3's index message, apart:"
    sed 's/^/    /' "$B/index.tsv"
    echo "  names no file defines: $(count_lines "$B/nofile.names")"
    sed 's/^/    /' "$B/nofile.names"
    npart=$(count_lines "$B/part.tsv")
    nempty=$(awk -F"$TAB" '$2 == "" { n++ } END { print n + 0 }' "$B/part.tsv")
    nindex=$(count_lines "$B/index.tsv")
    nall=$(count_lines "$B/all.names")
    nvalue=$(count_lines "$B/value.names")
    ncall=$(count_lines "$B/call.names")
    nfont=$(count_lines "$B/font.names")
    echo "  constants returned by the rich value's check: $nvalue; by the rich comment call: $ncall; by the font checks: $nfont; distinct: $nall; messages accounted for: $npart; with an empty message: $nempty; the index message's lines: $nindex"
    block_ok() { [ "$npart" -ge 1 ] && [ "$nempty" = 0 ]; }
    check "the messages are read and none is empty" "$(yn block_ok)"
    check "every name the readers found is defined by one of the three files" "$(yn [ "$(count_lines "$B/nofile.names")" = 0 ])"
    index_ok() { [ "$nindex" = 1 ] && [ -n "$(cut -f2 "$B/index.tsv")" ]; }
    check "the index message is one the call returns, read once and not empty" "$(yn index_ok)"
    # Every distinct name the readers found has its message read: the names
    # less the index message, plus the read message, equal the lines read.
    names_all() { "$G" -vx INDEX_OUT_OF_RANGE "$B/all.names" | count_lines /dev/stdin; }
    all_read() { [ "$(( $(names_all) + 1 ))" = "$npart" ]; }
    check "every constant the three bodies return, less the index message, and the read message, has its message read" "$(yn all_read)"
    rich_value_ok() { "$G" -qx RICH_TEXT_INVALID "$B/value.names"; }
    check "the rich value's check returns the part's own write message" "$(yn rich_value_ok)"
    printf 'impl X {\n    fn add_rich_comment(\n        x: u8,\n    ) {\n        return Err(A);\n        Err(B)?;\n        if y { return Err(A); }\n    }\n    fn other() { Err(C) }\n}\n' >"$B/c-returns.rs"
    python3 "$B/returns.py" "$B/c-returns.rs" 'fn add_rich_comment(' >"$B/c-returns.out"
    check "control: returns.py takes the fn's constants once each in order and stops at its closing brace" "$(yn [ "$(tr '\n' ' ' <"$B/c-returns.out")" = "A B " ])"
    printf 'struct S;\nimpl Font {\n    pub(crate) fn check(&self) {\n        Err(F)\n    }\n}\nimpl Other {\n    pub(crate) fn check(&self) {\n        Err(G)\n    }\n}\n' >"$B/c-after.rs"
    python3 "$B/returns.py" "$B/c-after.rs" 'pub(crate) fn check(&self)' --after 'impl Other {' >"$B/c-after.out"
    check "control: --after takes the first fn after the named line, not the first in the file" "$(yn [ "$(cat "$B/c-after.out")" = G ])"
    printf 'const A: Error = Error::Package("x");\npub(crate) const B: Error =\n    Error::Package("two");\nconst C: Error = Error::Package(\n    "three",\n);\n' >"$B/c-msgs.rs"
    python3 "$B/messages.py" "$B/c-msgs.rs" --name B >"$B/c-name.tsv"
    python3 "$B/messages.py" "$B/c-msgs.rs" --name C >>"$B/c-name.tsv"
    check "control: --name takes the one constant named, pub(crate) and wrapped or multi-line" "$(yn [ "$(cut -f2 "$B/c-name.tsv" | tr '\n' ' ')" = "two three " ])"
    rich_value_ctl() { "$G" -qx RICH_TEXT_INVALID "$B/call.names"; }
    check "control: the same search finds no part write message among the comment call's" "$(ynnot rich_value_ctl)"
    cat "$B/part.tsv" "$B/index.tsv" >"$B/known.tsv"
    # msg <NAME>: the message the source holds for the constant, as the tool prints it.
    msg() { awk -F"$TAB" -v n="$1" '$1 == n { print "error: " $2 }' "$B/known.tsv"; }
    # Each message looked for in the committed spec and in planning's working
    # file, whitespace folded, since the spec wraps its lines (change GA).
    git show "$C:$SPEC" >"$B/spec-committed.md"
    python3 - "$B/part.tsv" "$B/spec-committed.md" "$SPEC" >"$B/in-spec.tsv" <<'PY'
    import re
    import sys
    committed = re.sub(r"\s+", " ", open(sys.argv[2]).read())
    working = re.sub(r"\s+", " ", open(sys.argv[3]).read())
    for line in open(sys.argv[1]):
        name, message = line.rstrip("\n").split("\t", 1)
        print("%s\tcommitted=%s\tworking=%s" % (name, "yes" if message in committed else "no",
                                                "yes" if message in working else "no"))
    PY
    echo "command: each message accounted for, looked for in the committed $SPEC (git show <phase commit>) and in its working file, whitespace folded"
    sed 's/^/    /' "$B/in-spec.tsv"
    nin=$(count_matches -E "committed=yes${TAB}working=yes\$" "$B/in-spec.tsv")
    all_in_spec() { [ "$nin" = "$npart" ]; }
    check "every message accounted for is one the committed spec and its working file name" "$(yn all_in_spec)"
    printf 'X\tcommitted=yes\tworking=no\n' >"$B/c-in-spec.tsv"
    check "control: the same count finds no line that says working=no" "$(yn [ "$(count_matches -E "committed=yes${TAB}working=yes\$" "$B/c-in-spec.tsv")" = 0 ])"
    echo "  \"Errors\"' other shared messages, every edit's and every read's rather than the samples' constants, printed and not accounted (change GC): part 1's messages for an edit to a removed or replaced part, part 2's unbound-prefix refusal, Error::Xml for bytes that are not UTF-8; earlier parts' negative logs reach them"
    echo
    echo "### this log's generator, from the phase commit's template files"
    mkdir "$B/template" "$B/fx"
    for f in '[Content_Types].xml' _rels/.rels xl/workbook.xml xl/_rels/workbook.xml.rels xl/worksheets/sheet1.xml xl/styles.xml; do
      mkdir -p "$B/template/$(dirname "$f")"
      git show "$C:crates/emend/template/$f" >"$B/template/$f"
    done
    cat >"$B/gen-p3.py" <<'PY'
    """Fictional packages for M3 part 2 P3's negative log: the phase commit's
    template files, zipped in the template's order. The R cases (P1's gen-r.py)
    set the worksheet part's sheetData and add a shared strings part, its
    relationship and its Override where the case holds one; the N cases (P2's
    gen-n.py) set the sheetData or insert children after it and add a kept
    comments part (one comment on C3 by the author kept, its text as the case
    gives it), a kept VML part, the sheet's rels part and their Overrides.
    Usage: gen-p3.py <template dir> <out dir>."""
    import os
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    SST = "xl/sharedStrings.xml"
    SHEET_RELS = "xl/worksheets/_rels/sheet1.xml.rels"
    COMMENTS = "xl/comments1.xml"
    VML = "xl/drawings/vmlDrawing1.vml"
    MAIN = b"http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    REL = b"http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    PKG = b"http://schemas.openxmlformats.org/package/2006/relationships"
    SST_TYPE = b"application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"
    COMMENTS_TYPE = b"application/vnd.openxmlformats-officedocument.spreadsheetml.comments+xml"
    VML_TYPE = b"application/vnd.openxmlformats-officedocument.vmlDrawing"
    DECL = b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    VML_ROOT = (b'<xml xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office"'
                b' xmlns:x="urn:schemas-microsoft-com:office:excel"><o:shapelayout v:ext="edit">'
                b'<o:idmap v:ext="edit" data="1"/></o:shapelayout>')
    src, out = sys.argv[1], sys.argv[2]
    parts = {name: open(os.path.join(src, name), "rb").read() for name in ORDER}
    sheet = parts["xl/worksheets/sheet1.xml"]
    types = parts["[Content_Types].xml"]
    wbrels = parts["xl/_rels/workbook.xml.rels"]
    root = b'<worksheet xmlns="' + MAIN + b'">'
    assert sheet.count(b"<sheetData/>") == 1
    assert sheet.count(b"<c ") == 0
    assert sheet.count(root) == 1
    assert types.count(b"</Types>") == 1
    assert wbrels.count(b"</Relationships>") == 1
    assert wbrels.count(b"sharedStrings") == 0
    
    
    def override(t, name, kind):
        return t.replace(b"</Types>", b'<Override PartName="/' + name.encode() + b'" ContentType="' + kind
                         + b'"/></Types>')
    
    
    def rel(rid, kind, target):
        return b'<Relationship Id="' + rid + b'" Type="' + kind + b'" Target="' + target + b'"/>'
    
    
    def case(data=None, children=b"", sst=None, rels=b"", comment=None, vml=None):
        """The template with its sheetData holding `data` (empty when None) and
        `children` after it, the root binding r when a child names a
        relationship; when `sst` is given a shared strings part holding it, its
        relationship and Override; the sheet's rels part holding `rels`; when
        `comment` is given the kept comments part, its one comment's text
        `comment`; when `vml` is given the kept VML part holding it."""
        p = dict(parts)
        sd = b"<sheetData/>" if data is None else b"<sheetData>" + data + b"</sheetData>"
        s = sheet.replace(b"<sheetData/>", sd + children)
        if b"r:id" in children:
            s = s.replace(root, b'<worksheet xmlns="' + MAIN + b'" xmlns:r="' + REL + b'">')
        p["xl/worksheets/sheet1.xml"] = s
        t = types
        if sst is not None:
            p[SST] = DECL + b'<sst xmlns="' + MAIN + b'" count="1" uniqueCount="1">' + sst + b"</sst>"
            t = override(t, SST, SST_TYPE)
            p["xl/_rels/workbook.xml.rels"] = wbrels.replace(
                b"</Relationships>", rel(b"rId9", REL + b"/sharedStrings", b"sharedStrings.xml")
                + b"</Relationships>")
        if rels:
            p[SHEET_RELS] = DECL + b'<Relationships xmlns="' + PKG + b'">' + rels + b"</Relationships>"
        if comment is not None:
            p[COMMENTS] = (DECL + b'<comments xmlns="' + MAIN + b'"><authors><author>kept</author></authors>'
                           b'<commentList><comment ref="C3" authorId="0"><text>' + comment + b"</text></comment>"
                           b"</commentList></comments>")
            t = override(t, COMMENTS, COMMENTS_TYPE)
        if vml is not None:
            p[VML] = VML_ROOT + vml + b"</xml>"
            t = override(t, VML, VML_TYPE)
        p["[Content_Types].xml"] = t
        return p
    
    
    def last_row(n):
        return b'<row r="' + n + b'"><c r="A' + n + b'"><v>1</v></c></row>'
    
    
    def item(b):
        return b"<si><r><rPr>" + b + b"</rPr><t>a</t></r></si>"
    
    
    def inline(b):
        return b'<row r="1"><c r="A1" t="inlineStr"><is><r><rPr>' + b + b"</rPr><t>a</t></r></is></c></row>"
    
    
    def run(b):
        return b"<r><rPr>" + b + b"</rPr><t>kept</t></r>"
    
    
    NOTE = (b'<v:shape id="_x0000_s1025" type="#_x0000_t202"><x:ClientData ObjectType="Note">'
            b"<x:Row>2</x:Row><x:Column>2</x:Column></x:ClientData></v:shape>")
    BOTH_RELS = (rel(b"rId1", REL + b"/comments", b"../comments1.xml")
                 + rel(b"rId2", REL + b"/vmlDrawing", b"../drawings/vmlDrawing1.vml"))
    LEGACY = b'<legacyDrawing r:id="rId2"/>'
    BAD = b'<b val="yes"/>'
    GOOD = b"<b/>"
    CASES = {
        "r0": case(),
        "r1": case(last_row(b"1048576")),
        "r1c": case(last_row(b"1048575")),
        "r2": case(sst=item(BAD)),
        "r2c": case(sst=item(GOOD)),
        "r3": case(inline(BAD)),
        "r3c": case(inline(GOOD)),
        "n0": case(),
        "n4": case(last_row(b"1048576")),
        "n4c": case(last_row(b"1048575")),
        "n5": case(children=LEGACY, rels=BOTH_RELS, comment=run(BAD), vml=NOTE),
        "n5c": case(children=LEGACY, rels=BOTH_RELS, comment=run(GOOD), vml=NOTE),
    }
    for name, p in CASES.items():
        names = ORDER + [n for n in (SST, SHEET_RELS, COMMENTS, VML) if n in p]
        with zipfile.ZipFile(os.path.join(out, name + ".xlsx"), "w") as z:
            for n in names:
                z.writestr(zipfile.ZipInfo(n, (1980, 1, 1, 0, 0, 0)), p[n], zipfile.ZIP_DEFLATED)
        s = p["xl/worksheets/sheet1.xml"]
        c = p.get(COMMENTS, b"")
        print("%s %d entries:%d rows:%d last_row_1048576:%d last_row_1048575:%d inline:%d sst_part:%d"
              " legacyDrawing:%d rels:%d comments_part:%d vml_part:%d note:%d kept_runs:%d bad_b:%d" % (
                  name + ".xlsx", os.path.getsize(os.path.join(out, name + ".xlsx")), len(names),
                  s.count(b"<row "), s.count(b'<row r="1048576"'), s.count(b'<row r="1048575"'),
                  s.count(b't="inlineStr"'), int(SST in p), s.count(b"<legacyDrawing "), int(SHEET_RELS in p),
                  int(COMMENTS in p), int(VML in p), p.get(VML, b"").count(b'ObjectType="Note"'),
                  c.count(b"<r>"), (s + p.get(SST, b"") + c).count(BAD)))
    PY
    sed 's/^/    /' "$B/gen-p3.py"
    echo "command: python3 <scratch>/w/gen-p3.py <scratch>/w/template <scratch>/w/fx"
    python3 "$B/gen-p3.py" "$B/template" "$B/fx" >"$B/gen-p3.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/gen-p3.out"
    check "the twelve fixtures were written, and nothing else" "$(yn [ "$(find "$B/fx" -type f | wc -l)" = 12 ])"
    # run_bin <case> <args...>: the copied binary, the command printed with the
    # paths it names, stdout, stderr and exit kept.
    run_bin() {
      local case=$1
      shift
      "$BIN" "$@" >"$B/$case.stdout" 2>"$B/$case.stderr" </dev/null
      echo $? >"$B/$case.status"
      echo "command: <tree>/bin/emend-copy $*"
      echo "  exit: $(cat "$B/$case.status")"
      echo "  stdout:"; sed 's/^/    /' "$B/$case.stdout"
      echo "  stderr:"; sed 's/^/    /' "$B/$case.stderr"
    }
    status_is() { [ "$(cat "$B/$1.status")" = "$2" ]; }
    refused_with() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ -n "$2" ] && [ "$(cat "$B/$1.stderr")" = "$2" ]; }
    no_output() { [ ! -e "$B/out/$1.xlsx" ]; }
    has_output() { [ -s "$B/out/$1.xlsx" ]; }
    usage_refused() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ "$(count_matches -F 'error: usage: emend-copy' "$B/$1.stderr")" = 1 ]; }
    line_is() { status_is "$1" 0 && [ ! -s "$B/$1.stderr" ] && [ "$(cat "$B/$1.stdout")" = "$2" ] && has_output "$1"; }
    mkdir "$B/out"
    for case in r0 r1 r1c r2 r2c r3 r3c; do
      echo
      echo "### ${case^^} (--richtext-sample)"
      run_bin "$case" "$B/fx/$case.xlsx" "$B/out/$case.xlsx" --richtext-sample
    done
    for case in n0 n4 n4c n5 n5c; do
      echo
      echo "### ${case^^} (--richcomment-sample)"
      run_bin "$case" "$B/fx/$case.xlsx" "$B/out/$case.xlsx" --richcomment-sample
    done
    echo
    echo "### the checks"
    # R (P1's lines): the template's sheet has no rich cell and no table, so R0
    # and R1C count none before and one rich cell after; R2C's table holds one
    # rich item before and after; R3C's sheet one rich inline cell before and two
    # after. N (P2's lines): the template has no comment, no VML part and no rels
    # part for its worksheet, so N0 and N4C create both parts and the rels part;
    # N5C keeps one rich comment by an author other than the sample's and one
    # note shape, so both parts are appended to, the author added, and the kept
    # comment counted rich before and after.
    richtext_line() { printf 'richtext\tsst_rich_before=%s\tsst_rich_after=%s\tinline_rich_before=%s\tinline_rich_after=%s\truns_after=%s\ttext_after=%s\tbold_first=%s\tr_bound_before=%s' "$@"; }
    R_NONE=$(richtext_line 0 0 0 1 2 1 1 0)
    R_SST=$(richtext_line 1 1 0 1 2 1 1 0)
    R_INLINE=$(richtext_line 0 0 1 2 2 1 1 0)
    richcomment_line() { printf 'richcomment\tcomments_before=%s\tcomments_after=%s\tparts_before=%s\tparts_after=%s\tlegacy_before=%s\tcomments_part_before=%s\tr_bound_before=%s\tshapes_before=%s\tshapes_after=%s\tauthors_before=%s\tauthors_after=%s\trich_comments_before=%s\trich_comments_after=%s\truns_after=%s\ttext_after=%s' "$@"; }
    N_NONE=$(richcomment_line 0 1 0 2 0 0 0 0 1 0 1 0 1 2 1)
    N_RICH=$(richcomment_line 1 2 2 2 1 1 1 1 2 1 2 1 2 2 1)
    check "R0: exit 0, its line, an output (the bare template)" "$(yn line_is r0 "$R_NONE")"
    check "N0: exit 0, its line, an output (the bare template)" "$(yn line_is n0 "$N_NONE")"
    # The refusals: case, constant, the control's case and its line. A refusal
    # that holds records its constant as reached; part 3's index message is
    # recorded apart, since it is not of the messages this log accounts for
    # (change GC).
    : >"$B/reached"
    : >"$B/reached-other"
    refusal() {
      local case=$1 name=$2 ctl=$3 want=$4 expect
      expect=$(msg "$name")
      check "${ctl^^}: exit 0, its line, an output (the control for ${case^^})" "$(yn line_is "$ctl" "$want")"
      check "${case^^}: exit 2, no stdout, the error line exactly $name's message" "$(yn refused_with "$case" "$expect")"
      check "${case^^}: no output file" "$(yn no_output "$case")"
      if refused_with "$case" "$expect"; then
        case $name in
          INDEX_OUT_OF_RANGE) printf '%s %s\n' "$name" "$case" >>"$B/reached-other" ;;
          *) printf '%s %s\n' "$name" "$case" >>"$B/reached" ;;
        esac
      fi
    }
    refusal r1 INDEX_OUT_OF_RANGE r1c "$R_NONE"
    refusal r2 RUN_PROPERTIES_UNREADABLE r2c "$R_SST"
    refusal r3 RUN_PROPERTIES_UNREADABLE r3c "$R_INLINE"
    refusal n4 INDEX_OUT_OF_RANGE n4c "$N_NONE"
    refusal n5 RUN_PROPERTIES_UNREADABLE n5c "$N_RICH"
    echo "  reached, by case:"
    sed 's/^/    /' "$B/reached"
    echo "  reached apart (part 3's index message), by case:"
    sed 's/^/    /' "$B/reached-other"
    check "the index message was reached through both samples (R1, N4)" "$(yn [ "$(count_lines "$B/reached-other")" = 2 ])"
    check "the run properties message was reached three ways, the table, an inline string and a kept comment (R2, R3, N5)" "$(yn [ "$(count_lines "$B/reached")" = 3 ])"
    not_refused() { refused_with r0 "$(msg RUN_PROPERTIES_UNREADABLE)"; }
    check "control: refused_with says no on R0's run" "$(ynnot not_refused)"
    r1_other() { refused_with r1 "$(msg RUN_PROPERTIES_UNREADABLE)"; }
    check "control: refused_with says no on R1's run against the run properties message" "$(ynnot r1_other)"
    r2_other() { refused_with r2 "$(msg INDEX_OUT_OF_RANGE)"; }
    check "control: refused_with says no on R2's run against the index message" "$(ynnot r2_other)"
    n5_other() { refused_with n5 "$(msg INDEX_OUT_OF_RANGE)"; }
    check "control: refused_with says no on N5's run against the index message" "$(ynnot n5_other)"
    empty_message() { refused_with r2 ""; }
    check "control: refused_with says no against an empty message" "$(ynnot empty_message)"
    line_ctl() { line_is r2c "$R_NONE"; }
    check "control: line_is says no on R2C's run against R0's line" "$(ynnot line_ctl)"
    r3c_line_ctl() { line_is r3c "$R_SST"; }
    check "control: line_is says no on R3C's run against R2C's line" "$(ynnot r3c_line_ctl)"
    n5c_line_ctl() { line_is n5c "$N_NONE"; }
    check "control: line_is says no on N5C's run against N0's line" "$(ynnot n5c_line_ctl)"
    out_ctl() { line_is r1 ""; }
    check "control: line_is says no on R1's refused run, which left no output" "$(ynnot out_ctl)"
    nout=$(find "$B/out" -type f | wc -l)
    echo "  output files: $nout, the seven controls' outputs (R0, R1C, R2C, R3C, N0, N4C, N5C)"
    check "no output but the seven controls', and no temporary beside them" "$(yn [ "$nout" = 7 ])"
    echo
    echo "### the messages reached and the messages stated unreachable, as sets (change GC)"
    # The third column names the crate tests that cover the message, each
    # <file stem>:<test fn>, separated by spaces: richtext for
    # crates/emend/src/package/tests/richtext.rs, rich for
    # crates/emend/src/package/tests/comments/rich.rs.
    cat >"$B/unreachable" <<'UNR'
    RICH_TEXT_INVALID	raised at the write for a rich value with no run or a run with no text; the richtext sample's two runs are the tool's constants, each with its text	richtext:the_write_refuses_each_rule
    TEXT_NOT_XML	raised at the write for a run's text, and at the comment call for an author or a run's text, holding a character XML forbids; the samples' authors and runs are the tool's constants	richtext:the_write_refuses_each_rule rich:the_call_refuses_each_rule_and_records_nothing
    COMMENT_AUTHOR_INVALID	raised at the comment call for an author empty or past 255 characters; the richcomment sample's author is the tool's constant, emend	rich:the_call_refuses_each_rule_and_records_nothing
    COMMENT_TEXT_INVALID	raised at the comment call for no run, a run with no text or runs past 32767 characters together; the richcomment sample's two runs are the tool's constants	rich:the_call_refuses_each_rule_and_records_nothing
    FONT_NAME_REFUSED	raised at the write and the comment call for a run's font name empty or holding a forbidden character; the samples' fonts are the tool's constants, with no name	richtext:the_write_refuses_each_rule rich:the_call_refuses_each_rule_and_records_nothing
    FIELD_OUT_OF_RANGE	raised at the write and the comment call for a run's size, or a theme colour's tint, out of range; the samples' fonts are the tool's constants, bold alone or none	richtext:the_write_refuses_each_rule rich:the_call_refuses_each_rule_and_records_nothing
    UNR
    echo "  reached here, from the checks above that held (each constant once):"
    cut -d' ' -f1 "$B/reached" | LC_ALL=C sort -u >"$B/reached.set"
    sed 's/^/    /' "$B/reached.set"
    echo "  stated unreachable, with the reason:"
    sed 's/^/    /' "$B/unreachable"
    cut -f1 "$B/unreachable" | LC_ALL=C sort -u >"$B/unreachable.set"
    cut -f1 "$B/part.tsv" | LC_ALL=C sort -u >"$B/part.set"
    LC_ALL=C sort -u "$B/reached.set" "$B/unreachable.set" >"$B/union.set"
    nboth=$(LC_ALL=C comm -12 "$B/reached.set" "$B/unreachable.set" | count_lines /dev/stdin)
    echo "  the messages accounted for $(count_lines "$B/part.set"); reached $(count_lines "$B/reached.set"); stated unreachable $(count_lines "$B/unreachable.set"); in both $nboth"
    union_is_part() { cmp -s "$B/union.set" "$B/part.set"; }
    check "reached and stated unreachable together are exactly the constants accounted for" "$(yn union_is_part)"
    check "no constant is both reached and stated unreachable" "$(yn [ "$nboth" = 0 ])"
    reasons_ok() { [ "$(awk -F"$TAB" '$2 != "" { n++ } END { print n + 0 }' "$B/unreachable")" = "$(count_lines "$B/unreachable")" ]; }
    check "every unreachable constant carries its reason" "$(yn reasons_ok)"
    # Each named test is a #[test] fn of its file at the phase commit, and its
    # body names the constant's message.
    git show "$C:crates/emend/src/package/tests/richtext.rs" >"$B/richtext-tests.rs"
    git show "$C:crates/emend/src/package/tests/comments/rich.rs" >"$B/rich-tests.rs"
    test_holds() {
      awk -v f="fn $2() {" '$0 == f { on = 1 } on { print } on && /^}$/ { exit }' "$B/$1-tests.rs" >"$B/body"
      [ "$(count_lines "$B/body")" -ge 2 ] && [ -n "$3" ] &&
        python3 -c 'import re, sys; t = re.sub(r"\s+", " ", open(sys.argv[1]).read()); sys.exit(0 if sys.argv[2] in t else 1)' "$B/body" "$3"
    }
    echo "command: for each stated-unreachable constant and each test named for it, the test's fn in the phase commit's crates/emend/src/package/tests/<richtext.rs or comments/rich.rs>, its body looked for the constant's message, whitespace folded"
    ntests=0
    while IFS="$TAB" read -r name _ tests; do
      message=$(awk -F"$TAB" -v n="$name" '$1 == n { print $2 }' "$B/part.tsv")
      for t in $tests; do
        ntests=$((ntests + 1))
        echo "    $name: $t"
        check "  $name: covered by $t, which holds its message" "$(yn test_holds "${t%%:*}" "${t#*:}" "$message")"
      done
    done <"$B/unreachable"
    echo "  test names checked: $ntests"
    check "each unreachable constant names at least one test" "$(yn [ "$ntests" -ge "$(count_lines "$B/unreachable")" ])"
    covers_ctl() { test_holds rich a_comment_s_run_properties_that_cannot_be_read_are_refused "$(awk -F"$TAB" '$1 == "COMMENT_TEXT_INVALID" { print $2 }' "$B/part.tsv")"; }
    check "control: test_holds refuses the comment run properties test against the comment text message" "$(ynnot covers_ctl)"
    file_ctl() { test_holds richtext the_call_refuses_each_rule_and_records_nothing "$(awk -F"$TAB" '$1 == "COMMENT_TEXT_INVALID" { print $2 }' "$B/part.tsv")"; }
    check "control: test_holds refuses a test looked for in the other file" "$(ynnot file_ctl)"
    missing_ctl() { test_holds rich zzz_no_such_test "a"; }
    check "control: test_holds refuses a test the file lacks" "$(ynnot missing_ctl)"
    union_ctl() { LC_ALL=C sort -u "$B/unreachable.set" | cmp -s - "$B/part.set"; }
    check "control: the comparison refuses the stated-unreachable set alone, without the reached constants" "$(ynnot union_ctl)"
    echo
    echo "### two usage shapes (change GD, P1 change EG)"
    run_bin u1 "$B/fx/r0.xlsx" "$B/out/u1.xlsx" --richtext-sample extra
    check "U1: exit 2, the usage line" "$(yn usage_refused u1)"
    run_bin u2 "$B/fx/n0.xlsx" "$B/out/u2.xlsx" --richcomment-sample --richtext-sample
    check "U2: exit 2, the usage line" "$(yn usage_refused u2)"
    usage_ctl() { usage_refused n0; }
    check "control: usage_refused says no on N0's run" "$(ynnot usage_ctl)"
    check "U1 and U2 left no output" "$(yn [ "$(find "$B/out" -type f | wc -l)" = 7 ])"
    git worktree remove --force "$TREE" >/dev/null 2>&1
    check "the worktree is gone from git's list" "$(yn [ "$(git worktree list --porcelain | count_matches -F "$TREE" /dev/stdin)" = 0 ])"
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.stdout "$B"/*.stderr "$B"/gen-p3.out; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or records or planning's spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's logs or records or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/negative.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

