    #!/usr/bin/env bash
    # Milestone 3 part 2 P3 negative.log (specs/0024-rich-text.md, "P3": "the
    # negative log through the binary for every message of the part reachable
    # there, the unreachable ones stated with the test that covers each"). One
    # family per sample, the gate's host debug binary copied into a detached
    # worktree of the phase commit and checked against gate.log's hash, on
    # fictional packages this log builds from the phase commit's template files.
    # The template's worksheet holds an empty sheetData alone, its root binds no
    # relationships prefix, and it has no shared strings part, comments part,
    # VML part or rels part:
    #
    # (R) --richtext-sample (P1's family, its gen-r.py R0 to R3C):
    #       R0 the bare template: exit 0, its line;
    #       R1 one row numbered 1048576, the grid's last, holding one number
    #          cell: the sample's cell is past the grid, the index message;
    #       R1C the same with the row numbered 1048575, the control for R1;
    #       R2 a shared strings part whose one item has a run whose rPr holds a
    #          b with a val this layer cannot read: the run properties message,
    #          from the table's read;
    #       R2C the same with a plain b, the control for R2: the item counted
    #          rich before and after;
    #       R3 an inline string cell on A1 whose run's rPr holds the same b: the
    #          run properties message, from the cell read;
    #       R3C the same with a plain b, the control for R3: the cell counted
    #          rich before, two rich cells after.
    # (N) --richcomment-sample (P2's family, its gen-n.py N0, N4, N4C, N5, N5C;
    #     P2's N1 to N3, part 4d's two fixtures, are part 4d's messages and
    #     P2's log reached them):
    #       N0 the bare template: both comment parts and the rels part created,
    #          exit 0, its line;
    #       N4 one row numbered 1048576 holding one number cell: the index
    #          message;
    #       N4C the same with the row numbered 1048575, the control for N4;
    #       N5 a kept comments part (one comment on C3, by the author kept) whose
    #          one run's rPr holds the same b, a kept VML part with its note and
    #          legacyDrawing naming it: the run properties message, from the
    #          comments read;
    #       N5C the same with a plain b, the control for N5: the kept comment
    #          counted rich before and after.
    # Each refusal: exit 2, the error line exactly the message the committed
    # source holds, no stdout, no output file. Then the messages the two
    # samples' edits meet, read from the source by constant name, compared as
    # SETS with those reached here and those the log states unreachable, each
    # unreachable one with its reason and the tests that cover it; and usage
    # shapes.
    #
    # CARRIED TO M3 part 2 P3 from M3 part 2 P2's negative script (printed in
    # records/logs/m3p2-p2/negative.log, byte-identical to its copy kept on the
    # disk under <home>/.cache/emend-build/m3p2-p2/scripts, which this phase
    # keeps as <home>/.cache/emend-build/m3p2-p3/gen/negative-template-m3p2-p2.sh;
    # its change lists FA to FD stand in that log), with the richtext fixtures
    # of M3 part 2 P1's negative script (records/logs/m3p2-p1/negative.log, its
    # gen-r.py), built by <home>/.cache/emend-build/m3p2-p3/gen/make-negative.py,
    # which replaces each span once, and grepped for part 2 P2's tokens in every
    # form (m3p2-p2, the P2 subjects, 23c6111c, d6137d52, dc33002, the N1 to N3
    # cases). What differs, and why:
    #  GA. The phase, the log directory, the subjects and the build directories
    #      are M3 part 2 P3's. The base is M3 part 2 P2's record commit ("M3
    #      part 2 P2 record:"); the doc commit and the three code commits (the
    #      carry, the catalogue, the probes) by their full P3 subjects. The spec
    #      pin is specs/0024's blob at P3's doc commit, ca2e40a7. The working
    #      file is printed, and the status pattern allows it modified, should
    #      planning add rulings during P3; it allows this phase's logs and its
    #      records/m3p2-p3-, records/m3p2-open- and records/size-m3p2- stems.
    #  GB. Two families, R0 to R3C (P1's) and N0, N4 to N5C (P2's), one
    #      generator, gen-p3.py, P1's gen-r.py and P2's gen-n.py joined. The
    #      run properties message is reached three ways (the table, an inline
    #      string, a kept comment) and the index message through both samples,
    #      each with its control.
    #  GC. P3 adds no message (specs/0024 "Errors"). The messages this log
    #      accounts for are the ones the two samples' edits meet: those
    #      RichText::check returns (crates/emend/src/cells.rs), those
    #      Parts::add_rich_comment returns (crates/emend/src/package.rs), those
    #      Font::check and check_color return (crates/emend/src/styles/
    #      elements.rs), each body's Err(NAME) constants read by a reader printed
    #      below, less part 3's index message (recorded apart, as in P1 and P2);
    #      with RUN_PROPERTIES_UNREADABLE from cells.rs, raised by the three
    #      reads. Each message is read by constant name from the file that
    #      defines it. The others are stated unreachable through the tool (the
    #      samples' authors and runs are its constants), each with every test
    #      named for it in crates/emend/src/package/tests/richtext.rs and
    #      crates/emend/src/package/tests/comments/rich.rs, and each test's
    #      body asserted to hold the message. "Errors"' other shared messages
    #      (part 1's removed or replaced part, part 2's unbound prefix,
    #      Error::Xml) are every edit's and every read's, not the samples'
    #      constants, and earlier parts' negative logs reach them; they are
    #      printed, not accounted.
    #  GD. Nothing of P2's carried rules is dropped: the short-sha, null and
    #      fabricated commit controls, the scratch directory kept on the disk
    #      under <build> (this script removes no directory: the worktree goes by
    #      git worktree remove, and no rm of any form is run), the usage shapes
    #      with both samples.
    #
    # Usage: m3p2-p3-negative.sh <phase commit> [<gate log> [<gate build dir>]]
    # > <file outside the tree>; the caller moves the output to
    # records/logs/m3p2-p3/negative.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/negative.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    GATE_LOG=${2:-records/logs/m3p2-p3/gate.log}
    GATE_BUILD=${3:-$HOME/.cache/emend-build/m3p2-p3/gate}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    BUILD_ROOT=${NEGATIVE_BUILD:-$HOME/.cache/emend-build/m3p2-p3/negative}
    SUPERSEDED_DIR=$HOME/.cache/emend-build/m3p2-p3/superseded
    GATE_BIN=$GATE_BUILD/target/debug/emend-copy
    SPEC=specs/0024-rich-text.md
    SPEC_WANT=ca2e40a7467271df645defb025e76ee15fec7e03da54720b177b25bf5a17df11
    mkdir -p "$BUILD_ROOT" || exit 2
    TREE=$BUILD_ROOT/tree
    if [ -e "$TREE" ]; then echo "$TREE is already there" >&2; exit 2; fi
    # Change GD (P1 change EF): made on the disk under <build> and kept after the run.
    B=$(mktemp -d -p "$BUILD_ROOT") || exit 2
    cleanup() {
      git worktree remove --force "$TREE" >/dev/null 2>&1
    }
    trap cleanup EXIT INT TERM HUP
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    # Change GD (P1 change EE): the real commit with its last hex digit changed, and its short form.
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT_SHA=${C:0:7}
    # This phase's logs and records, and planning's spec should it hold rulings uncommitted (change GA).
    OURS='^((\?\?| ?[MARCD]) records/logs/m3p2-p3|(\?\?| ?[MARCD]) records/(m3p2-(p3|open)|size-m3p2)-| M specs/0024-rich-text[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs, records and planning's spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$TREE#<tree>#g" -e "s#$B#<scratch>/w#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$GATE_BUILD#<gatebuild>#g" -e "s#$SUPERSEDED_DIR#<superseded>#g" \
        -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    # The environment and path inputs, each on its labelled line.
    echo "input: RERUN_NOTE: ${RERUN_NOTE:-unset}"
    echo "input: RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: HOME: set, read for the paths under it, printed as <home>"
    echo "input: NEGATIVE_BUILD: ${NEGATIVE_BUILD:-unset} (the build root, <build>)"
    echo "input: the gate log: $GATE_LOG"
    echo "input: the gate build directory: $GATE_BUILD"
    echo "input: python3: $(python3 --version 2>&1)"
    echo "about: M3 part 2 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M3 part 2 P2 record: logs, corpus and open-check records, the independent check')
    DOC1=$(by_subject 'M3 part 2 P3: commit planning docs (the P2 rulings and verification)')
    CODE1=$(by_subject "M3 part 2 P3: the comments read in the catalogue and the comment call's colour refusal")
    CODE2=$(by_subject "M3 part 2 P3: the catalogue's limits for rich text")
    CODE3=$(by_subject 'M3 part 2 P3: probe-emend-richtext-write-xml and probe-emend-richcomment-write-xml')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  M3 part 2 P2's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  code commit 1 (P2 verification ruling 5, the carry): ${CODE1:-none}"
    echo "  code commit 2 (the catalogue): ${CODE2:-none}"
    echo "  code commit 3 (the probes): ${CODE3:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CODE3" "$CODE2" "$CODE1" "$DOC1" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "code commits 3, 2 and 1, the doc commit and the base, each the next one's parent, code commit 3 the phase commit" "$(yn roles_in_order)"
    roles_ctl() { local CODE3=$CODE2; roles_in_order; }
    check "control: roles_in_order refuses code commit 2 named as code commit 3" "$(ynnot roles_ctl)"
    echo
    echo "phase: Milestone 3 part 2 P3 ($SPEC) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "rerun: the superseded files are kept in <superseded>"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
