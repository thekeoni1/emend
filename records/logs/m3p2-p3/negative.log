    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh is sourced from it by this log, the gate log ($GATE_LOG) is read for the binary's hash, the template files, crates/emend/src/cells.rs, crates/emend/src/package.rs, crates/emend/src/styles/elements.rs, crates/emend/src/package/tests/richtext.rs, crates/emend/src/package/tests/comments/rich.rs and $SPEC are read from it by git show, and $SPEC's working file is hashed and read in it; nothing in it is run: the binary under test is the gate's, copied into <tree>/bin and run from there"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scripts> stands for <home>/.cache/emend-build/m3p2-p3/scripts, this script's own directory on the disk, which holds the script and, in <scripts>/out, its own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <build> stands for the build root on the disk, <home>/.cache/emend-build/m3p2-p3/negative unless NEGATIVE_BUILD names another; <tree> stands for <build>/tree, the detached worktree of the phase commit, which holds the copied binary in <tree>/bin, removed at exit by git worktree remove"
    echo "root: <gatebuild> stands for the gate's build directory, <home>/.cache/emend-build/m3p2-p3/gate unless the third argument names another, from which the gate's host debug binary is copied; read only"
    echo "root: <superseded> stands for <home>/.cache/emend-build/m3p2-p3/superseded, where a rerun's superseded files are kept; read only"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory under <build> (the message reader, the source copies, the generator, its fixtures and the cases' outputs), kept on the disk after the run (change GD)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR" && apart "$TREE" "$B" && apart "$GATE_BUILD" "$BUILD_ROOT" && apart "$GATE_BUILD" "$SELF_DIR" && apart "$GATE_BUILD" "$MAIN" && apart "$SUPERSEDED_DIR" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$BUILD_ROOT" && apart "$SUPERSEDED_DIR" "$MAIN" && apart "$SUPERSEDED_DIR" "$GATE_BUILD"; }
    check "the roots other than <home> are distinct, none inside another (<tree> and <scratch>/w both inside <build>, apart from each other)" "$(yn roots_distinct)"
    roots_ctl() { apart "$TREE" "$BUILD_ROOT"; }
