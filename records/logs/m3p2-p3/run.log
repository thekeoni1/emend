  the copy is the file beside this script, byte for byte: yes
    """The run log's shape survey of the corpus's <rPr> children (specs/0024-
    rich-text.md, P1 ruling 2, and P1 verification ruling 6 for P2: the val
    shapes and the colour attribute forms checked, the corpus directory a
    parameter). Written for M3 part 2 P2 from P1's rpr_survey.py.
    
    Usage: rcsurvey.py <corpus>
    
    Reads every regular file under <corpus>/corpus (a listing of the directory,
    no extension glob), and in each, every part [Content_Types].xml types as a
    shared strings part ("sst") or a comments part ("cmt"), with ElementTree.
    For every main <rPr> it prints shapes and counts only, never a text, a font
    name or a file name, tab-separated:
    
      files <n>                     the regular files read
      parts <kind> <n>              the parts of each kind read
      rpr <kind> <n>                the <rPr> elements of each kind
      seq <kind> <children> <n>     an <rPr>'s children's local names in order,
                                    comma-separated ("-" for none)
      child <kind> <child> <form> <n>
                                    one child's shape: <form> is the class of its
                                    attributes, below
    
    A child's form, by its local name (a child outside the main namespace is
    NONMAIN, a name the crate's reader neither takes nor drops is UNKNOWN):
    
      b i strike outline shadow condense extend
          flag:bare (no val), flag:<val> for val 1, 0, true or false, else
          flag:OTHER
      u   kw:bare, kw:<val> for single, double, singleAccounting,
          doubleAccounting or none, else kw:OTHER
      vertAlign  kw:<val> for baseline, superscript or subscript, kw:MISSING
          with no val, else kw:OTHER
      scheme     kw:<val> for major, minor or none, kw:MISSING, else kw:OTHER
      sz  num:int or num:dec for a positive finite number written as digits,
          optionally with one point and more digits; num:MISSING; else num:OTHER
      family charset  num:int for digits, num:MISSING, else num:OTHER
      rFont      name:nonempty, name:EMPTY, name:MISSING
      color      the attributes present, sorted, each with its class:
          rgb:hex8 (eight hex digits) or rgb:OTHER; theme:int or theme:OTHER;
          indexed:int or indexed:OTHER; tint:num (finite, -1 to 1) or
          tint:OTHER; auto:<val> for 1, 0, true or false, else auto:OTHER;
          any other attribute by its name followed by :ATTR; NONE for no
          attribute
      any other attribute of a non-colour child adds +<name>:ATTR to its form.
    """
    import collections
    import math
    import os
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    CT = "http://schemas.openxmlformats.org/package/2006/content-types"
    KINDS = {"application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml": "sst",
             "application/vnd.openxmlformats-officedocument.spreadsheetml.comments+xml": "cmt"}
    FLAGS = {"b", "i", "strike", "outline", "shadow", "condense", "extend"}
    BOOL = {"1", "0", "true", "false"}
    KW = {"u": {"single", "double", "singleAccounting", "doubleAccounting", "none"},
          "vertAlign": {"baseline", "superscript", "subscript"},
          "scheme": {"major", "minor", "none"}}
    NUMBER = re.compile(r"^[0-9]+(\.[0-9]+)?$")
    DIGITS = re.compile(r"^[0-9]+$")
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def is_num(v, lo=None, hi=None):
        try:
            f = float(v)
        except ValueError:
            return False
        if not math.isfinite(f):
            return False
        return (lo is None or f >= lo) and (hi is None or f <= hi)
    
    
    def form(name, attrib):
        val = attrib.get("val")
        others = sorted(a for a in attrib if a != "val") if name != "color" else []
        extra = "".join(" +%s:ATTR" % a for a in others)
        if name in FLAGS:
            return ("flag:bare" if val is None else "flag:" + val if val in BOOL else "flag:OTHER") + extra
        if name == "u":
            return ("kw:bare" if val is None else "kw:" + val if val in KW["u"] else "kw:OTHER") + extra
        if name in ("vertAlign", "scheme"):
            return ("kw:MISSING" if val is None else "kw:" + val if val in KW[name] else "kw:OTHER") + extra
        if name == "sz":
            if val is None:
                return "num:MISSING" + extra
            if NUMBER.match(val) and is_num(val) and float(val) > 0:
                return ("num:int" if DIGITS.match(val) else "num:dec") + extra
            return "num:OTHER" + extra
        if name in ("family", "charset"):
            return ("num:MISSING" if val is None else "num:int" if DIGITS.match(val) else "num:OTHER") + extra
        if name == "rFont":
            return ("name:MISSING" if val is None else "name:EMPTY" if val == "" else "name:nonempty") + extra
        if name == "color":
            parts = []
            for a in sorted(attrib):
                v = attrib[a]
                if a == "rgb":
                    parts.append("rgb:hex8" if re.match(r"^[0-9A-Fa-f]{8}$", v) else "rgb:OTHER")
                elif a in ("theme", "indexed"):
                    parts.append(a + (":int" if DIGITS.match(v) else ":OTHER"))
                elif a == "tint":
                    parts.append("tint:num" if is_num(v, -1.0, 1.0) else "tint:OTHER")
                elif a == "auto":
                    parts.append("auto:" + v if v in BOOL else "auto:OTHER")
                else:
                    parts.append(a + ":ATTR")
            return " ".join(parts) if parts else "NONE"
        return "UNKNOWN"
    
    
    def main():
        corpus = sys.argv[1]
        d = os.path.join(corpus, "corpus")
        files = sorted(f for f in os.listdir(d) if os.path.isfile(os.path.join(d, f)))
        counts = collections.Counter()
        for f in files:
            z = zipfile.ZipFile(os.path.join(d, f))
            types = ET.fromstring(z.read("[Content_Types].xml"))
            for o in types:
                if o.tag != "{%s}Override" % CT:
                    continue
                kind = KINDS.get(o.get("ContentType", ""))
                name = o.get("PartName", "").lstrip("/")
                if kind is None or name not in z.namelist():
                    continue
                counts[("parts", kind)] += 1
                for rpr in ET.fromstring(z.read(name)).iter():
                    ns, n = local(rpr.tag)
                    if ns not in MAIN or n != "rPr":
                        continue
                    counts[("rpr", kind)] += 1
                    seq = []
                    for ch in rpr:
                        cns, cn = local(ch.tag)
                        if cns not in MAIN:
                            seq.append("NONMAIN")
                            counts[("child", kind, "NONMAIN", "NONMAIN")] += 1
                            continue
                        seq.append(cn)
                        counts[("child", kind, cn, form(cn, ch.attrib))] += 1
                    counts[("seq", kind, ",".join(seq) or "-")] += 1
        print("files\t%d" % len(files))
        for key, n in sorted(counts.items()):
            print("\t".join(key) + "\t%d" % n)
    
    
    main()
