    """The run log's survey of W's sheet settings before the run
    (specs/0025-sheet-and-print-settings.md, "Harness runs", P1; specs/0024 P1
    verification ruling 6's form: names and counts only, the corpus directory a
    parameter).
    
    Usage: svsurvey.py <corpus>
    
    Lists <corpus>/corpus (every regular file, no extension glob) and reads each
    workbook the manifest <corpus>/manifest.tsv names, in manifest order. W is
    the first <sheet> in <sheets> order whose relationship type is a worksheet's
    (zipfile and ElementTree for the package's relationships and the workbook
    part). W itself is read with expat WITHOUT namespace processing, so a
    namespace declaration is seen as the attribute it is written as, and each
    element's namespace is resolved here from the declarations in scope: a
    reader of another lineage than the run log's comparison (byte spans) and the
    tool (the crate's token stream).
    
    Prints, tab-separated, one line per workbook:
      wb <id> <sheetPr> <sheetPr attributes> <sheetPr children> <tabColor>
         <tabColor attribute forms> <sheetView> <first sheetView attributes>
         <kept>
    where <sheetPr> counts W's main root children of that name; <sheetPr
    attributes> and <sheetPr children> are the first one's attribute names and
    main child names in order, comma-separated (- for none); <tabColor> counts
    the main tabColor children of the first <sheetPr>; <tabColor attribute
    forms> their attribute names, comma-separated, joined by +; <sheetView>
    counts the main sheetView children of W's main sheetViews root children;
    <first sheetView attributes> the first one's attribute names in order, as
    written (namespace declarations among them); <kept> the count of those other
    than zoomScale, showGridLines and showRowColHeaders, which the sample sets
    (1 for no view: the created view's workbookViewId). Then one line
      files <regular files in corpus/> <manifest rows> <rows read>
    Names are schema names; no value, no text, no reference, no sheet name and
    no part name is printed.
    """
    import os
    import posixpath
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    from xml.parsers import expat
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    SET = ("zoomScale", "showGridLines", "showRowColHeaders")
    
    
    def rels(z, part):
        d, base = posixpath.split(part)
        name = posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            if el.get("TargetMode") == "External":
                continue
            t = el.get("Target", "")
            out.append((el.get("Id"), el.get("Type", ""),
                        t[1:] if t.startswith("/") else posixpath.normpath(posixpath.join(d, t))))
        return out
    
    
    def w_of(z):
        wb = [t for (_, ty, t) in rels(z, "") if ty.endswith("/officeDocument")][0]
        by_id = {i: (ty, t) for (i, ty, t) in rels(z, wb)}
        for el in ET.fromstring(z.read(wb)).iter():
            if el.tag in ["{%s}sheet" % m for m in MAIN]:
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, t = by_id.get(rid, ("", None))
                if ty in [a + "/worksheet" for a in ATTR]:
                    return t
        return None
    
    
    def survey(data):
        st = {"depth": 0, "scopes": [], "open2": None, "pr": 0, "pr_attrs": None, "pr_kids": [],
              "tab": 0, "tab_forms": [], "views": 0, "view_attrs": None}
    
        def start(name, attrs):
            # attrs is a flat list (ordered_attributes): name, value, name, value...
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(st["scopes"][-1]) if st["scopes"] else {}
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            st["scopes"].append(scope)
            st["depth"] += 1
            prefix, _, loc = name.rpartition(":")
            main = scope.get(prefix) in MAIN
            d = st["depth"]
            if d == 2:
                st["open2"] = loc if main else None
                if main and loc == "sheetPr":
                    st["pr"] += 1
                    if st["pr"] == 1:
                        st["pr_attrs"] = [k for (k, _) in pairs]
            elif d == 3 and main:
                if st["open2"] == "sheetPr" and st["pr"] == 1:
                    st["pr_kids"].append(loc)
                    if loc == "tabColor":
                        st["tab"] += 1
                        st["tab_forms"].append(",".join(k for (k, _) in pairs) or "-")
                elif st["open2"] == "sheetViews" and loc == "sheetView":
                    st["views"] += 1
                    if st["view_attrs"] is None:
                        st["view_attrs"] = [k for (k, _) in pairs]
    
        def end(name):
            st["depth"] -= 1
            st["scopes"].pop()
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.Parse(data, True)
        return st
    
    
    def main():
        corpus = sys.argv[1]
        lines = open(os.path.join(corpus, "manifest.tsv"), encoding="utf-8").read().split("\n")
        head = lines[0].split("\t")
        rows = [l.split("\t") for l in lines[1:] if l]
        files = sorted(f for f in os.listdir(os.path.join(corpus, "corpus"))
                       if os.path.isfile(os.path.join(corpus, "corpus", f)))
        read = 0
        for row in rows:
            cid, ext = row[head.index("id")], row[head.index("ext")]
            name = "%s.%s" % (cid, ext)
            if name not in files:
                print("wb\t%s\tmissing" % cid)
                continue
            z = zipfile.ZipFile(os.path.join(corpus, "corpus", name))
            w = w_of(z)
            st = survey(z.read(w))
            read += 1
            va = st["view_attrs"]
            kept = 1 if va is None else sum(1 for k in va if k not in SET)
            print("\t".join([
                "wb", cid, str(st["pr"]),
                ",".join(st["pr_attrs"]) if st["pr_attrs"] else "-",
                ",".join(st["pr_kids"]) if st["pr_kids"] else "-",
                str(st["tab"]), "+".join(st["tab_forms"]) if st["tab_forms"] else "-",
                str(st["views"]), ",".join(va) if va else "-", str(kept)]))
        print("files\t%d\t%d\t%d" % (len(files), len(rows), read))
    
    
    main()
