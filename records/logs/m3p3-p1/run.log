    """The run log's own sheet view comparison (specs/0025-sheet-and-print-settings.md,
    "Harness runs", --sheetview-sample, P1).
    
    Usage: svcmp.py <input archive> <output archive> [--diff <diff.tsv>] [--plant <flag>]
           svcmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool; its readers are M3 part 2 P1's richcmp.py's. It
    finds the workbook part through the package relationship; W, the first
    <sheet> in <sheets> order whose relationship type is a worksheet's, and its
    part; W's root children by byte spans, each main one placed by its own copy
    of the 39-name table of ECMA-376 Part 1, 18.3.1.99. From the input it builds
    the W the design gives (specs/0025 "The pass", "The calls"): the tab colour
    FF00AA55 replacing every main <tabColor> of W's <sheetPr>, placed before its
    first main <outlinePr> or <pageSetUpPr> (18.3.1.82's order) or at the end of
    its content, every other attribute and byte of <sheetPr> kept, an empty one
    opened; a <sheetPr> the input lacks created with the root's prefix before
    the first main root child the table puts after it; the first <sheetView>'s
    start tag with showGridLines="0" showRowColHeaders="1" zoomScale="85" first,
    in the schema's order, and every other attribute after them as written, in
    its order; a <sheetViews> the input lacks created with the root's prefix,
    holding one <sheetView> with the three and workbookViewId="0", before the
    first main root child the table puts after it. It compares:
    
      rest_same    W with every main <sheetPr> and <sheetViews> cut out is the
                   input's W with its own cut out, byte for byte
      places       the main root children's names are the input's with a created
                   <sheetPr> and <sheetViews> where the design puts them
      schema_order the main root children are in the table's order, one
                   <sheetPr> and one <sheetViews>
      pr_tag       <sheetPr>'s start tag is the input's (opened when the input's
                   was empty), or the created one's with no attribute
      pr_kept      <sheetPr>'s content with its main <tabColor> cut out is the
                   input's with its own cut out, byte for byte
      tab_color    read with ElementTree, <sheetPr> holds exactly one main
                   <tabColor>, empty, whose only attribute is rgb FF00AA55, and
                   its bytes are the design's, with <sheetPr>'s prefix
      pr_order     read with ElementTree, <sheetPr>'s main children are in
                   18.3.1.82's order (tabColor, outlinePr, pageSetUpPr)
      view_set     read with ElementTree, the first <sheetView> carries
                   zoomScale 85, showGridLines 0 and showRowColHeaders 1
      view_first   the three are its first attributes, in the schema's order
                   (showGridLines, showRowColHeaders, zoomScale), byte for byte
      view_kept    its other attributes are the input's first <sheetView>'s, byte
                   for byte and in their order (a created view's exactly
                   workbookViewId="0")
      view_rest    <sheetViews> with the first view's start tag put back as the
                   input's is the input's byte for byte (a created one exactly the
                   design's bytes)
      w_bytes      W is exactly the W the design gives
      others_same  every entry but W is the input's, byte for byte, the names the
                   input's in the input's order
      read_back    read with ElementTree, one main <sheetPr>, one <tabColor> in it,
                   and the <sheetView> elements of W's <sheetViews> the input's,
                   or one when the input had no <sheetViews>
      xml_values   with --diff, the runner's diff.<label>.tsv for the pair: its xml
                   "values" rows are W's alone, and its in_only and out_only are
                   the one-sided counts of the values the design removes and
                   writes (the input's <tabColor> attributes and the three view
                   attributes as they were; the sample's tab colour, the three
                   set values and a created view's workbookViewId), keyed as
                   xlsx-diff keys a value, by the element's and the attribute's
                   resolved names (P1 verification ruling 6 of specs/0024: the
                   expectation is derived); without --diff, no
      flagged      with --diff, the diff's entry row for W carries the flag
                   descriptor exactly when the input's local header sets general
                   purpose bit 3, and no other row is flagged; without --diff, no
    
    It prints ONE line of counts and yes/no flags and no text, reference, sheet
    name or part name. --parts prints W's part name and 1, 0 or - for whether
    the input's entry of that name sets general purpose bit 3, one per line, for
    the log to compare with the runner's rows without printing them. --plant
    <flag> changes the output as read so that the named flag turns to no; the
    line then says planted=yes, or planted=no when the pair gives the plant
    nothing to change.
    """
    import collections
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    # ECMA-376 Part 1, 18.3.1.99, the worksheet root's children in order: this
    # program's own copy (specs/0018, "Creating an element"), not the crate's.
    TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    assert len(TABLE) == 39
    # 18.3.1.82: <sheetPr>'s children in order.
    PR_CHILDREN = ("tabColor", "outlinePr", "pageSetUpPr")
    
    FLAGS = ("rest_same", "places", "schema_order", "pr_tag", "pr_kept", "tab_color", "pr_order",
             "view_set", "view_first", "view_kept", "view_rest", "w_bytes", "others_same",
             "read_back", "xml_values", "flagged")
    
    COMMENT = b"<!-- planted -->"
    # The sample's constants (tools/emend-copy, --sheetview-sample).
    RGB = b"FF00AA55"
    SET = ((b"showGridLines", b"0"), (b"showRowColHeaders", b"1"), (b"zoomScale", b"85"))
    SET_NAMES = tuple(n for (n, _) in SET)
    SET_BYTES = b"".join(b" " + n + b'="' + v + b'"' for (n, v) in SET)
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def pick_w(z, workbook):
        """W's part, or None: the first main <sheet> whose relationship is a
        worksheet's."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty in (ATTR[0] + "/worksheet", ATTR[1] + "/worksheet"):
                    return target
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTRS_RE = re.compile(rb'\s([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')')
    
    
    def attributes(tag):
        """[(name, bytes from the name to the closing quote)] of a start tag, in
        order, namespace declarations among them."""
        return [(m.group(1), tag[m.start(1):m.end()]) for m in ATTRS_RE.finditer(tag)]
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def is_main(raw, parent_prefix, parent_main):
        """Whether an element whose bytes start `raw` is in the main namespace:
        its own declaration of its prefix, else its parent's when the prefix is
        the parent's."""
        p, _ = split_name(qname(raw))
        tag = start_tag(raw)
        decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
        own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
        if own:
            return own.group(1)[1:-1].decode() in MAIN
        return p == parent_prefix and parent_main
    
    
    def children(data, a, b, rp, parent_main):
        """[(start, end, main local name or None)] of the elements in data[a:b]."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            n = split_name(qname(raw))[1]
            out.append((a + x, a + y, n if is_main(raw, rp, parent_main) else None))
        return out
    
    
    def content_span(data, x, y):
        """(start, end) of an element's content, equal for an empty tag."""
        raw = data[x:y]
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return x + len(tag), x + len(tag)
        return x + len(tag), x + raw.rfind(b"</")
    
    
    def rels_prefix_of(tag):
        """The prefix a start tag binds to the relationships namespace, or None."""
        for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            if m.group(2)[1:-1].decode() in ATTR:
                return m.group(1)
        return None
    
    
    def bit3(zin, name):
        """1 or 0 for whether the input's entry sets general purpose bit 3, -
        when there is no such entry."""
        try:
            return "1" if zin.getinfo(name).flag_bits & 0x08 else "0"
        except KeyError:
            return "-"
    
    
    def cut(data, spans):
        """data with the spans cut out."""
        out, at = [], 0
        for (x, y) in sorted(spans):
            out.append(data[at:x])
            at = y
        out.append(data[at:])
        return b"".join(out)
    
    
    def first_insert(kids, after, root_end):
        """The offset before the first main root child the table puts after the
        position `after`, or the root's end."""
        for (x, _, nm) in kids:
            if nm in TABLE and TABLE.index(nm) > after:
                return x
        return root_end
    
    
    def shape_of(w, root_ns):
        """What the comparison reads of a W: its root's spans and prefix, its root
        children, and its <sheetPr> and <sheetViews> spans."""
        ts, te, a, b, rp = root_span(w)
        kids = children(w, a, b, rp, root_ns in MAIN)
        return {"ts": ts, "te": te, "a": a, "b": b, "rp": rp, "kids": kids,
                "pr": [(x, y) for (x, y, nm) in kids if nm == "sheetPr"],
                "sv": [(x, y) for (x, y, nm) in kids if nm == "sheetViews"]}
    
    
    def pr_parts(w, span):
        """(start tag, prefix, content start, content end, the content's main
        <tabColor> spans, the content's main children) of a <sheetPr>."""
        x, y = span
        raw = w[x:y]
        p = split_name(qname(raw))[0]
        ca, cb = content_span(w, x, y)
        kids = children(w, ca, cb, p, True)
        return start_tag(raw), p, ca, cb, [(kx, ky) for (kx, ky, nm) in kids if nm == "tabColor"], kids
    
    
    def first_view(w, span):
        """(start, end of its start tag, its start tag) of the first main
        <sheetView> in a <sheetViews>, or None."""
        x, y = span
        raw = w[x:y]
        p = split_name(qname(raw))[0]
        ca, cb = content_span(w, x, y)
        for (vx, vy, nm) in children(w, ca, cb, p, True):
            if nm == "sheetView":
                tag = start_tag(w[vx:vy])
                return vx, vx + len(tag), tag
        return None
    
    
    def design(win, s):
        """The W the design gives for the input, or None when the input is out
        of what the sample can write (two <sheetPr>, two <sheetViews>, or a
        <sheetViews> without a <sheetView>)."""
        if len(s["pr"]) > 1 or len(s["sv"]) > 1:
            return None
        rp = s["rp"]
        edits = []  # (start, end, order, bytes)
        if s["pr"]:
            x, y = s["pr"][0]
            tag, p, ca, cb, tabs, kids = pr_parts(win, s["pr"][0])
            content = cut(win[ca:cb], [(tx - ca, ty - ca) for (tx, ty) in tabs])
            new_tab = b"<" + p + b'tabColor rgb="' + RGB + b'"/>'
            # Where the tab colour goes, in the content with the old ones cut.
            later = [(kx, ky) for (kx, ky, nm) in kids if nm in PR_CHILDREN[1:]]
            if later:
                kx = later[0][0]
                gone = sum(ty - tx for (tx, ty) in tabs if ty <= kx)
                at = kx - ca - gone
            else:
                at = len(content)
            content = content[:at] + new_tab + content[at:]
            if tag.endswith(b"/>"):
                el = opened(tag) + content + b"</" + qname(tag) + b">"
            else:
                el = tag + content + win[cb:y]
            edits.append((x, y, 0, el))
        else:
            at = first_insert(s["kids"], 0, s["b"])
            el = b"<" + rp + b"sheetPr><" + rp + b'tabColor rgb="' + RGB + b'"/></' + rp + b"sheetPr>"
            edits.append((at, at, 0, el))
        if s["sv"]:
            v = first_view(win, s["sv"][0])
            if v is None:
                return None
            vx, vend, tag = v
            kept = b"".join(b" " + raw for (n, raw) in attributes(tag) if n not in SET_NAMES)
            new = b"<" + qname(tag) + SET_BYTES + kept + (b"/>" if tag.endswith(b"/>") else b">")
            edits.append((vx, vend, 1, new))
        else:
            at = first_insert(s["kids"], 2, s["b"])
            el = (b"<" + rp + b"sheetViews><" + rp + b"sheetView" + SET_BYTES + b' workbookViewId="0"/></'
                  + rp + b"sheetViews>")
            edits.append((at, at, 1, el))
        out, at = [], 0
        for (x, y, _, el) in sorted(edits, key=lambda e: (e[0], e[2])):
            out.append(win[at:x])
            out.append(el)
            at = y
        out.append(win[at:])
        return b"".join(out)
    
    
    def et_first(root, name):
        for el in root:
            ns, nm = local(el.tag)
            if ns in MAIN and nm == name:
                return el
        return None
    
    
    def edit_values(root, tab_side):
        """The values the design removes (tab_side "in") or writes ("out") in an
        ElementTree of W, keyed as xlsx-diff keys a value: the <tabColor>
        attributes of the first main <sheetPr>, and the three set attributes of
        the first main <sheetView> of the first main <sheetViews>."""
        vals = collections.Counter()
        pr = et_first(root, "sheetPr")
        if pr is not None:
            for t in pr:
                if local(t.tag)[0] in MAIN and local(t.tag)[1] == "tabColor":
                    for (k, v) in t.attrib.items():
                        vals[(t.tag, k, v)] += 1
        sv = et_first(root, "sheetViews")
        view = et_first(sv, "sheetView") if sv is not None else None
        if view is not None:
            for n in SET_NAMES:
                if n.decode() in view.attrib:
                    vals[(view.tag, n.decode(), view.attrib[n.decode()])] += 1
            if tab_side == "created":
                for (k, v) in view.attrib.items():
                    if k == "workbookViewId":
                        vals[(view.tag, k, v)] += 1
        return vals
    
    
    def plant(flag, wout, others, st):
        """(wout, others) changed so that `flag` turns to no, or None when the
        pair gives the plant nothing to change."""
        s = shape_of(wout, st["root_ns"])
        o = dict(others)
        if len(s["pr"]) != 1 or len(s["sv"]) != 1:
            return None
        px, py = s["pr"][0]
        tag, p, ca, cb, tabs, kids = pr_parts(wout, s["pr"][0])
        v = first_view(wout, s["sv"][0])
        if flag == "rest_same":
            return wout[:s["te"]] + COMMENT + wout[s["te"]:], o
        if flag == "places":
            # A second copy of the first main root child that is neither
            # <sheetPr> nor <sheetViews>, right after it: the order stays the
            # table's, the names are one more.
            other = [(x, y) for (x, y, nm) in s["kids"] if nm not in (None, "sheetPr", "sheetViews")]
            if not other:
                return None
            x, y = other[0]
            return wout[:y] + wout[x:y] + wout[y:], o
        if flag == "schema_order":
            # The <sheetViews> moved to the root's end.
            sx, sy = s["sv"][0]
            el = wout[sx:sy]
            rest = wout[:sx] + wout[sy:]
            end = rest.rfind(b"</")
            return rest[:end] + el + rest[end:], o
        if flag == "pr_tag":
            return wout[:px] + tag[:-1] + b' planted="1">' + wout[px + len(tag):], o
        if flag == "pr_kept":
            return wout[:cb] + b"<" + p + b"outlinePr/>" + wout[cb:], o
        if flag == "tab_color":
            if not tabs:
                return None
            tx, ty = tabs[0]
            new = wout[tx:ty].replace(RGB, b"FF00AA56", 1)
            return wout[:tx] + new + wout[ty:], o
        if flag == "pr_order":
            if not tabs:
                return None
            tx, ty = tabs[0]
            el = wout[tx:ty]
            rest = wout[:tx] + wout[ty:]
            at = cb - (ty - tx)
            return rest[:at] + b"<" + p + b"pageSetUpPr/>" + el + rest[at:], o
        if flag == "view_set":
            if v is None:
                return None
            vx, vend, vtag = v
            new = vtag.replace(b'zoomScale="85"', b'zoomScale="86"', 1)
            return (wout[:vx] + new + wout[vend:], o) if new != vtag else None
        if flag == "view_first":
            if v is None:
                return None
            vx, vend, vtag = v
            q = qname(vtag)
            if not vtag.startswith(b"<" + q + SET_BYTES):
                return None
            rest = vtag[len(b"<" + q + SET_BYTES):]
            new = b"<" + q + b' showRowColHeaders="1" showGridLines="0" zoomScale="85"' + rest
            return wout[:vx] + new + wout[vend:], o
        if flag == "view_kept":
            if v is None:
                return None
            vx, vend, vtag = v
            end = len(vtag) - (2 if vtag.endswith(b"/>") else 1)
            new = vtag[:end] + b' planted="1"' + vtag[end:]
            return wout[:vx] + new + wout[vend:], o
        if flag == "view_rest":
            sx, sy = s["sv"][0]
            end = sx + wout[sx:sy].rfind(b"</")
            if end < sx:
                return None
            return wout[:end] + COMMENT + wout[end:], o
        if flag == "w_bytes":
            return wout + b"\n", o
        if flag == "others_same":
            name = next(iter(o), None)
            if name is None:
                return None
            o[name] = o[name] + COMMENT
            return wout, o
        if flag == "read_back":
            if not tabs:
                return None
            tx, ty = tabs[0]
            return wout[:ty] + wout[tx:ty] + wout[ty:], o
        if flag in ("xml_values", "flagged"):
            return wout, o
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        part = pick_w(zin, wb)
        if part is None or part not in zin.namelist():
            print("error=no-worksheet")
            return
        names = zin.namelist()
        win = zin.read(part)
        root_ns = local(ET.fromstring(win).tag)[0]
        if args[1:] == ["--parts"]:
            print(part)
            print(bit3(zin, part))
            return
        zout = zipfile.ZipFile(args[1])
        rest = args[2:]
        diff_path = flag_plant = None
        while rest:
            if rest[0] == "--diff" and len(rest) >= 2:
                diff_path, rest = rest[1], rest[2:]
            elif rest[0] == "--plant" and len(rest) >= 2:
                flag_plant, rest = rest[1], rest[2:]
                if flag_plant not in FLAGS:
                    print("error=unknown-plant")
                    return
            else:
                print("error=usage")
                return
        out_names = zout.namelist()
        wout = zout.read(part) if part in out_names else b""
        others = {nm: zout.read(nm) for nm in out_names if nm != part}
    
        s_in = shape_of(win, root_ns)
        want = design(win, s_in)
        if want is None:
            print("error=out-of-design")
            return
        st = {"root_ns": root_ns}
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, wout, others, st)
            if changed is not None:
                wout, others = changed
                planted = True
        extra = flag_plant if planted else None
    
        flags = dict.fromkeys(FLAGS, False)
        s_out = shape_of(wout, root_ns) if wout else None
        created_pr = 0 if s_in["pr"] else 1
        created_sv = 0 if s_in["sv"] else 1
        kept_out = -1
        if s_out is not None:
            cut_in = cut(win, s_in["pr"] + s_in["sv"])
            cut_out = cut(wout, s_out["pr"] + s_out["sv"])
            flags["rest_same"] = cut_in == cut_out
            locals_in = [nm for (_, _, nm) in s_in["kids"] if nm is not None]
            want_places = list(locals_in)
            if created_pr:
                at = next((i for (i, nm) in enumerate(want_places) if nm in TABLE and TABLE.index(nm) > 0),
                          len(want_places))
                want_places.insert(at, "sheetPr")
            if created_sv:
                at = next((i for (i, nm) in enumerate(want_places) if nm in TABLE and TABLE.index(nm) > 2),
                          len(want_places))
                want_places.insert(at, "sheetViews")
            locals_out = [nm for (_, _, nm) in s_out["kids"] if nm is not None]
            flags["places"] = locals_out == want_places
            pos = [TABLE.index(nm) for nm in locals_out if nm in TABLE]
            flags["schema_order"] = (pos == sorted(pos) and locals_out.count("sheetPr") == 1
                                     and locals_out.count("sheetViews") == 1)
            if len(s_out["pr"]) == 1:
                tag_o, p_o, ca_o, cb_o, tabs_o, kids_o = pr_parts(wout, s_out["pr"][0])
                if s_in["pr"]:
                    tag_i, p_i, ca_i, cb_i, tabs_i, kids_i = pr_parts(win, s_in["pr"][0])
                    flags["pr_tag"] = tag_o == (opened(tag_i) if tag_i.endswith(b"/>") else tag_i)
                    flags["pr_kept"] = (cut(wout[ca_o:cb_o], [(x - ca_o, y - ca_o) for (x, y) in tabs_o])
                                        == cut(win[ca_i:cb_i], [(x - ca_i, y - ca_i) for (x, y) in tabs_i]))
                else:
                    flags["pr_tag"] = tag_o == b"<" + s_in["rp"] + b"sheetPr>"
                    flags["pr_kept"] = (cut(wout[ca_o:cb_o], [(x - ca_o, y - ca_o) for (x, y) in tabs_o])
                                        == b"")
                tab_bytes = [wout[x:y] for (x, y) in tabs_o]
                flags["tab_color"] = tab_bytes == [b"<" + p_o + b'tabColor rgb="' + RGB + b'"/>']
            if len(s_out["sv"]) == 1:
                vo = first_view(wout, s_out["sv"][0])
                if vo is not None:
                    vx, vend, vtag = vo
                    q = qname(vtag)
                    after = vtag[len(b"<" + q + SET_BYTES):len(b"<" + q + SET_BYTES) + 1]
                    flags["view_first"] = vtag.startswith(b"<" + q + SET_BYTES) and after in (b" ", b"/", b">")
                    kept_o = [raw for (n, raw) in attributes(vtag) if n not in SET_NAMES]
                    kept_out = len(kept_o)
                    sx, sy = s_out["sv"][0]
                    if s_in["sv"]:
                        vi = first_view(win, s_in["sv"][0])
                        kept_i = [raw for (n, raw) in attributes(vi[2]) if n not in SET_NAMES]
                        flags["view_kept"] = kept_o == kept_i
                        ix, iy = s_in["sv"][0]
                        flags["view_rest"] = (wout[sx:vx] + vi[2] + wout[vend:sy]) == win[ix:iy]
                    else:
                        flags["view_kept"] = kept_o == [b'workbookViewId="0"']
                        rp = s_in["rp"]
                        flags["view_rest"] = wout[sx:sy] == (
                            b"<" + rp + b"sheetViews><" + rp + b"sheetView" + SET_BYTES
                            + b' workbookViewId="0"/></' + rp + b"sheetViews>")
            flags["w_bytes"] = wout == want
        try:
            root_o = ET.fromstring(wout) if wout else None
        except ET.ParseError:
            root_o = None
        root_i = ET.fromstring(win)
        pr_in = sum(1 for el in root_i if local(el.tag)[0] in MAIN and local(el.tag)[1] == "sheetPr")
        pr_i = et_first(root_i, "sheetPr")
        tab_in = 0 if pr_i is None else sum(1 for t in pr_i if local(t.tag)[0] in MAIN and local(t.tag)[1] == "tabColor")
        views = lambda root: sum(1 for sv in root if local(sv.tag)[0] in MAIN and local(sv.tag)[1] == "sheetViews"
                                 for v in sv if local(v.tag)[0] in MAIN and local(v.tag)[1] == "sheetView")
        views_in = views(root_i)
        pr_out = tab_out = views_out = -1
        if root_o is not None:
            pr_out = sum(1 for el in root_o if local(el.tag)[0] in MAIN and local(el.tag)[1] == "sheetPr")
            pr_o = et_first(root_o, "sheetPr")
            tab_out = 0 if pr_o is None else sum(1 for t in pr_o
                                                 if local(t.tag)[0] in MAIN and local(t.tag)[1] == "tabColor")
            views_out = views(root_o)
            if pr_o is not None:
                tabs = [t for t in pr_o if local(t.tag)[0] in MAIN and local(t.tag)[1] == "tabColor"]
                flags["tab_color"] = (flags["tab_color"] and len(tabs) == 1 and dict(tabs[0].attrib) == {"rgb": RGB.decode()}
                                      and len(list(tabs[0])) == 0)
                order = [PR_CHILDREN.index(local(c.tag)[1]) for c in pr_o
                         if local(c.tag)[0] in MAIN and local(c.tag)[1] in PR_CHILDREN]
                flags["pr_order"] = order == sorted(order)
            sv_o = et_first(root_o, "sheetViews")
            view_o = et_first(sv_o, "sheetView") if sv_o is not None else None
            flags["view_set"] = (view_o is not None and view_o.get("zoomScale") == "85"
                                 and view_o.get("showGridLines") == "0" and view_o.get("showRowColHeaders") == "1")
            flags["read_back"] = (pr_out == 1 and tab_out == 1
                                  and views_out == (views_in if created_sv == 0 else 1))
        flags["others_same"] = (list(others) == [nm for nm in names if nm != part]
                                and [nm for nm in out_names] == names
                                and all(others[nm] == zin.read(nm) for nm in others))
    
        # The runner's diff for the pair (specs/0024 P1 verification ruling 6):
        # the xml values row and the descriptor flags against what the rules give.
        in_only = out_only = want_in = want_out = flagged_rows = want_flagged = -1
        if root_o is not None:
            side_in = edit_values(root_i, "in")
            side_out = edit_values(root_o, "created" if created_sv else "out")
            want_in = sum((side_in - side_out).values())
            want_out = sum((side_out - side_in).values())
            if extra == "xml_values":
                want_out += 1
        if diff_path is not None:
            rows = [l.split("\t") for l in open(diff_path, encoding="utf-8").read().split("\n") if l]
            values = {c[1]: c for c in rows if len(c) >= 7 and c[0] == "xml" and c[2] == "values"}
            if part in values:
                in_only, out_only = int(values[part][5]), int(values[part][6])
            flags["xml_values"] = (list(values) == [part] and in_only == want_in and out_only == want_out)
            ents = [{"name": c[1], "status": c[2], "flags": c[16]} for c in rows
                    if len(c) == 17 and c[0] == "entry"]
            flagged_rows = sum(1 for r in ents if r["flags"])
            want = {part: ("descriptor" if bit3(zin, part) == "1" else "")}
            if extra == "flagged":
                want = {nm: ("" if f else "descriptor") for (nm, f) in want.items()}
            want_flagged = sum(1 for f in want.values() if f)
            flags["flagged"] = (len(ents) > 0 and flagged_rows == want_flagged
                                and all(r["flags"] == want.get(r["name"], "") for r in ents))
    
        tag_in = win[s_in["ts"]:s_in["te"]]
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted),
