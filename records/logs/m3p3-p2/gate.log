    //! Names, each once, the six types and the four calls that P2 adds under
    //! the feature `sheetprops` (specs/0025-sheet-and-print-settings.md, P2).
    pub fn page(
        p: &mut emend::package::Package<std::io::Cursor<Vec<u8>>>,
        o: &emend::PrintOptions,
        m: &emend::PageMargins,
        s: &emend::PageSetup,
        h: &emend::HeaderFooter,
        r: emend::Orientation,
        d: emend::PageOrder,
    ) -> bool {
        let a = p.set_print_options(b"xl/worksheets/sheet1.xml", o).is_ok();
        let b = p.set_page_margins(b"xl/worksheets/sheet1.xml", m).is_ok();
        let c = p.set_page_setup(b"xl/worksheets/sheet1.xml", s).is_ok();
        let e = p.set_header_footer(b"xl/worksheets/sheet1.xml", h).is_ok();
        a && b && c && e && s.orientation == Some(r) && s.page_order == Some(d)
    }
