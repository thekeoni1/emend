    """The run log's survey of the corpus's print settings before the run
    (specs/0025-sheet-and-print-settings.md, "Harness runs", P2, and "Planning
    rulings during P2" ruling 3: the order the set attributes are written in is
    the order the corpus's parts carry them, read from a survey of every
    worksheet part that P2's run log prints; specs/0024 P1 verification ruling
    6's form: names and counts only, the corpus directory a parameter).
    
    Usage: pssurvey.py <corpus>
    
    Lists <corpus>/corpus (every regular file, no extension glob) and reads each
    workbook the manifest <corpus>/manifest.tsv names, in manifest order. The
    worksheet parts are the targets of the workbook part's relationships of the
    worksheet type, in <sheets> order, W the first (zipfile and ElementTree for
    the package's relationships and the workbook part). Each part is read with
    expat WITHOUT namespace processing, so a namespace declaration is seen as
    the attribute it is written as and each element's namespace is resolved
    here from the declarations in scope: a reader of another lineage than the
    run log's comparison (byte spans) and the tool (the crate's token stream).
    
    Prints, tab-separated:
      part <id> <k> <printOptions> <pageMargins> <pageSetup> <headerFooter>
           <pageSetUpPr> <headerFooter children>
    for the k-th worksheet part (1 is W): for each of the four root children
    and <sheetPr>'s <pageSetUpPr>, the first one's attribute names in order,
    comma-separated, as written (namespace declarations among them), "." for an
    element with no attribute and "-" for none; then the first <headerFooter>'s
    main child names in order ("-" for none);
      wb <id> <printOptions> <pageMargins> <pageSetup> <headerFooter> <rid>
         <hf other> <r bound> <sheetPr> <pageSetUpPr>
    for W: the count of each of the four among the root's main children, 1 when
    the first <pageSetup> carries an attribute in the relationships namespace
    named id, the count of the first <headerFooter>'s main children other than
    oddHeader and oddFooter, 1 when the root binds a prefix to the relationships
    namespace, the count of main <sheetPr> root children and of main
    <pageSetUpPr> children of the first; then one line
      files <regular files in corpus/> <manifest rows> <rows read> <parts read>
    Names are schema names; no value, no text, no reference, no sheet name and
    no part name is printed.
    """
    import os
    import posixpath
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    from xml.parsers import expat
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    FOUR = ("printOptions", "pageMargins", "pageSetup", "headerFooter")
    
    
    def rels(z, part):
        d, base = posixpath.split(part)
        name = posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            if el.get("TargetMode") == "External":
                continue
            t = el.get("Target", "")
            out.append((el.get("Id"), el.get("Type", ""),
                        t[1:] if t.startswith("/") else posixpath.normpath(posixpath.join(d, t))))
        return out
    
    
    def worksheets_of(z):
        """The worksheet parts in <sheets> order."""
        wb = [t for (_, ty, t) in rels(z, "") if ty.endswith("/officeDocument")][0]
        by_id = {i: (ty, t) for (i, ty, t) in rels(z, wb)}
        out = []
        for el in ET.fromstring(z.read(wb)).iter():
            if el.tag in ["{%s}sheet" % m for m in MAIN]:
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, t = by_id.get(rid, ("", None))
                if ty in [a + "/worksheet" for a in ATTR]:
                    out.append(t)
        return out
    
    
    def survey(data):
        st = {"depth": 0, "scopes": [], "open2": None, "first2": False,
              "counts": dict.fromkeys(FOUR, 0), "attrs": dict.fromkeys(FOUR + ("pageSetUpPr",)),
              "hf_kids": [], "rid": 0, "r_bound": 0, "pr": 0, "setup_pr": 0}
    
        def start(name, attrs):
            # attrs is a flat list (ordered_attributes): name, value, name, value...
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(st["scopes"][-1]) if st["scopes"] else {}
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            st["scopes"].append(scope)
            st["depth"] += 1
            prefix, _, loc = name.rpartition(":")
            main = scope.get(prefix) in MAIN
            d = st["depth"]
            names = [k for (k, _) in pairs]
            if d == 1:
                st["r_bound"] = 1 if any(k.startswith("xmlns:") and v in ATTR for (k, v) in pairs) else 0
            elif d == 2:
                st["open2"] = loc if main else None
                st["first2"] = False
                if main and loc in FOUR:
                    st["counts"][loc] += 1
                    if st["counts"][loc] == 1:
                        st["first2"] = True
                        st["attrs"][loc] = names
                        if loc == "pageSetup":
                            for k in names:
                                p, _, n = k.rpartition(":")
                                if p and p != "xmlns" and n == "id" and scope.get(p) in ATTR:
                                    st["rid"] = 1
                if main and loc == "sheetPr":
                    st["pr"] += 1
                    st["first2"] = st["pr"] == 1
            elif d == 3 and main and st["first2"]:
                if st["open2"] == "headerFooter":
                    st["hf_kids"].append(loc)
                elif st["open2"] == "sheetPr" and loc == "pageSetUpPr":
                    st["setup_pr"] += 1
                    if st["setup_pr"] == 1:
                        st["attrs"]["pageSetUpPr"] = names
    
        def end(name):
            st["depth"] -= 1
            st["scopes"].pop()
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.Parse(data, True)
        return st
    
    
    def seq(names):
        if names is None:
            return "-"
        return ",".join(names) if names else "."
    
    
    def main():
        corpus = sys.argv[1]
        lines = open(os.path.join(corpus, "manifest.tsv"), encoding="utf-8").read().split("\n")
        head = lines[0].split("\t")
        rows = [l.split("\t") for l in lines[1:] if l]
        files = sorted(f for f in os.listdir(os.path.join(corpus, "corpus"))
                       if os.path.isfile(os.path.join(corpus, "corpus", f)))
        read = parts = 0
        for row in rows:
            cid, ext = row[head.index("id")], row[head.index("ext")]
            name = "%s.%s" % (cid, ext)
            if name not in files:
                print("wb\t%s\tmissing" % cid)
                continue
            z = zipfile.ZipFile(os.path.join(corpus, "corpus", name))
            sheets = worksheets_of(z)
            read += 1
            for k, part in enumerate(sheets, 1):
                st = survey(z.read(part))
                parts += 1
                print("\t".join(["part", cid, str(k)]
                                + [seq(st["attrs"][n]) for n in FOUR + ("pageSetUpPr",)]
                                + [",".join(st["hf_kids"]) if st["hf_kids"] else "-"]))
                if k == 1:
                    other = sum(1 for n in st["hf_kids"] if n not in ("oddHeader", "oddFooter"))
                    print("\t".join(["wb", cid] + [str(st["counts"][n]) for n in FOUR]
                                    + [str(st["rid"]), str(other), str(st["r_bound"]),
                                       str(st["pr"]), str(st["setup_pr"])]))
        print("files\t%d\t%d\t%d\t%d" % (len(files), len(rows), read, parts))
    
    
    main()
