    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    PHASE_DIR=$(dirname "$SELF_DIR")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$PHASE_DIR/out" || exit 2
    ERR=$PHASE_DIR/out/test.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    C=${1:?phase commit required}
    T=$(mktemp -d)
    trap 'rm -rf "${T:?}"' EXIT INT TERM HUP
    git show "$C:scripts/counting.sh" >"$T/counting.sh" || exit 2
    . "$T/counting.sh"
    
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    KEEP_WAS_SET=$([ -n "${EMEND_KEEP_DIR+x}" ] && echo yes || echo no)
    unset EMEND_KEEP_DIR
    BUILD_ROOT=$PHASE_DIR/test
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    passed_matches() { [ "$passed" -gt 0 ] && [ "$passed" -eq "$nok" ]; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    
    # The entry guard: every change must be this phase's log directory or its
    # records, run or open-check, or planning's uncommitted spec (change AG;
    # change SB).
    OURS_RE='^((\?\?| ?[MARCD]) records/logs/m3p3-p2|(\?\?| ?[MARCD]) records/m3p3-(p2|open)-| M specs/0025-sheet-and-print-settings[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS_RE" git status --porcelain)
    entry_clean() {
      [ "$entry_all" != error ] && [ "$entry_ours" != error ] &&
        [ "$entry_all" = "$entry_ours" ]
    }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs, its records and planning's uncommitted spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -E -e "s#$MAIN([^-A-Za-z0-9_.]|\$)#<repo>\\1#g" -e "s#$T#<scratch>/w#g" -e "s#$BUILD_ROOT#<build>#g" \
        -e "s#$SELF_DIR#<scripts>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M3 part 3 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # Change AH: every environment input this script reads, on a labelled line.
    echo "input (environment) RERUN_NOTE: $([ -n "${RERUN_NOTE:-}" ] && echo "set; its text is the rerun line below" || echo unset)"
    echo "input (environment) RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input (environment) EMEND_KEEP_DIR, when this script started: $KEEP_WAS_SET (unset for the whole log)"
    echo "input (environment) HOME: $([ -n "${HOME:-}" ] && echo "set; the scrub writes it <home>" || echo unset)"
    echo "input (environment) ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    SHAPE_DIR=$(mktemp -d)
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$SHAPE_DIR/fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$SHAPE_DIR/fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      SHAPE_RESULT_SELF=$n_self
      SHAPE_RESULT_FIX=$n_fix
      check "$shape: this script holds none" "$(yn [ "$SHAPE_RESULT_SELF" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$SHAPE_RESULT_FIX" = 1 ])"
    done
    rm -rf "${SHAPE_DIR:?}"
    
    echo
    echo "## the spec, pinned by the hash of its committed blob (change TB; specs/0018 close-out ruling 4)"
    SPEC=specs/0025-sheet-and-print-settings.md
    # The hash planning's message gave for the doc commit's blob, typed (change TB).
    SPEC_GAVE=6c6e87e3c6ca75ac23f2f52488cd95ae8f294c361e12a5cf9d4a1b9e0f0c026f
    SPEC_SHA=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_HEAD=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum; sha256sum $SPEC (the working tree's copy, printed only)"
    echo "  the phase commit's blob: sha256 $SPEC_HEAD"
    echo "  the hash planning's message gave: $SPEC_GAVE"
    echo "  the working tree's copy, planning's uncommitted rulings during P2, not the pin: sha256 $SPEC_SHA"
    check "the spec at the phase commit is the blob planning's message hashed" "$(yn [ "$SPEC_HEAD" = "$SPEC_GAVE" ])"
    spec_ctl() { if [ "$(git show "$C:specs/0024-rich-text.md" | sha256sum | cut -d' ' -f1)" = "$SPEC_GAVE" ]; then return 1; else return 0; fi; }
    check "control: the same comparison refuses another spec's blob (specs/0024 at the phase commit)" "$(yn spec_ctl)"
    
    echo
    echo "## the phase's commits by role, read from git"
    check_fn() { local label=$1; shift; check "$label" "$(yn "$@")"; }
    by_subject() { git log --format='%H' -n 1 -F --grep="$1" "$C"; }
    REC=$(by_subject 'M3 part 3 P1 record: logs, corpus and open-check records, the independent check')
    DOC1=$(by_subject 'M3 part 3 P2: commit planning docs (the P1 rulings and verification)')
    CODE1=$(by_subject "M3 part 3 P2: the merge routine's comment and a view on a two-sheetPr part")
    CODE2=$(by_subject 'M3 part 3 P2: print options, margins, page setup, headers and footers')
    CODE3=$(by_subject 'M3 part 3 P2: emend-copy --pagesetup-sample')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject> <phase commit>, for each role"
    echo "  P1's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  code commit 1 (specs/0025 P1 verification ruling 2, the carry): ${CODE1:-none}"
    echo "  code commit 2 (the crate): ${CODE2:-none}"
    echo "  code commit 3 (the tool, the phase commit): ${CODE3:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r
      for r in "$REC" "$DOC1" "$CODE1" "$CODE2" "$CODE3"; do
        [ -n "$r" ] || return 1
      done
      [ "$CODE3" = "$C" ] || return 1
      [ "$(git rev-parse "$C~1")" = "$CODE2" ] || return 1
      [ "$(git rev-parse "$C~2")" = "$CODE1" ] || return 1
      [ "$(git rev-parse "$C~3")" = "$DOC1" ] || return 1
      [ "$(git rev-parse "$C~4")" = "$REC" ]
    }
    check_fn "code commits 3, 2 and 1, the doc commit and P1's record commit, each the next one's parent" roles_in_order
    roles_ctl1() { local CODE1=$CODE2; if roles_in_order; then return 1; else return 0; fi; }
    check_fn "control: roles_in_order refuses code commit 2 named as code commit 1" roles_ctl1
    git log --format='%s' "$REC..$C" >"$T/subjects"
    PREFIX_RE='^M3 part 3 P2: '
    nsub=$(count_lines "$T/subjects")
    nprefix=$(count_matches -E "$PREFIX_RE" "$T/subjects")
    echo "command: git log --format=%s <P1's record commit>..<phase commit>"
    sed 's/^/    /' "$T/subjects"
    echo "  subjects in the range: $nsub; beginning \"M3 part 3 P2: \": $nprefix"
    prefix_all() { [ "$nsub" -ge 1 ] && [ "$nsub" = "$nprefix" ]; }
    check_fn "every commit in the range carries the phase's subject prefix" prefix_all
    printf 'M3 part 3 P2: x\nM3 part 3 P1: y\nM3 part 3: z\n' >"$T/c-subjects"
    check "control: the same count finds one prefixed subject of three" "$(yn [ "$(count_matches -E "$PREFIX_RE" "$T/c-subjects")" = 1 ])"
    no_such_subject() { [ -z "$(by_subject 'M3 part 3 P2: no such subject anywhere')" ]; }
    check_fn "control: a subject no commit has resolves to nothing" no_such_subject
    echo "phase: Milestone 3 part 3 P2 (specs/0025-sheet-and-print-settings.md) test.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "  the superseded files are kept in <home>/${PHASE_DIR#"$HOME"/}/superseded (change TA)"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory, <build>/target (CARGO_TARGET_DIR)"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to (it lies inside <home>, so it is scrubbed first)"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/${PHASE_DIR#"$HOME"/}, this phase's directory on the disk (change TA); <phase>/superseded keeps a superseded attempt's files; <phase>/out holds this script's own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <scripts> stands for <phase>/$(basename "$SELF_DIR"), the directory holding this script"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory; scripts/counting.sh is read at the phase commit into <scratch>/w/counting.sh and sourced from there (change X), the plants' archive copy of the phase commit is <scratch>/w/src, and the keep directory of change RD is a mktemp -d directory inside <scratch>/w, written <scratch>/w/keep"
    echo "root: <build> stands for <phase>/$(basename "$BUILD_ROOT"), this log's build directory (change TA); the runs build into <build>/target, the crate's own runs (changes SD, RD, SG and BG) into <build>/crate-target and the plants into <build>/plant-target"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      apart "$T" "$PHASE_DIR" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$T" "$BUILD_ROOT" &&
        apart "$MAIN" "$PHASE_DIR" && apart "$MAIN" "$T"
    }
    check "the directory roots other than <home> and <phase>'s own children are distinct, none inside another" "$(yn roots_distinct)"
    roots_ctl() { if apart "$CARGO_TARGET_DIR" "$BUILD_ROOT"; then return 1; else return 0; fi; }
    check "control: apart refuses <build>/target against <build>, which holds it" "$(yn roots_ctl)"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR; CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS; $(rustc --version)"
    echo "EMEND_KEEP_DIR set when this script started: $KEEP_WAS_SET; unset for the whole log: $([ -n "${EMEND_KEEP_DIR+x}" ] && echo no || echo yes)"
    echo "EMEND_KEEP_DIR is given to one command alone, the crate's keep run (change RD), through env; it is never exported"
    echo "at entry: status lines $entry_all; of them this phase's logs, its records or planning's uncommitted spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    check "control: the same comparison against a short sha of the real commit says no" \
      "$(yn not_head "$(printf '%s' "$C" | cut -c1-7)")"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$T/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    # failed_names <cargo output>: prints the name of every test the run failed,
    # from its FAILED lines, or "none" (change RC; P2 verification ruling 6). It
    # prints, so it is never a check's condition.
    failed_names() {
      local n
      n=$(LC_ALL=C "$G" -a -E '^test .* \.\.\. FAILED$' "$1" | sed -E 's/^test (.*) \.\.\. FAILED$/\1/')
      if [ -n "$n" ]; then printf '%s\n' "$n" | sed 's/^/    failed test: /'; else echo "    failed tests: none"; fi
    }
    printf 'test a::b ... ok\ntest a::c ... FAILED\n' >"$T/c-failed"
    check "control: failed_names prints the name of the one FAILED line of two" "$(yn [ "$(failed_names "$T/c-failed")" = "    failed test: a::c" ])"
    printf 'test a::b ... ok\n' >"$T/c-failed-none"
    check "control: failed_names prints none for a run with no FAILED line" "$(yn [ "$(failed_names "$T/c-failed-none")" = "    failed tests: none" ])"
    
    for target in host i686-unknown-linux-musl; do
      echo
      echo "## cargo test --workspace ($target)"
      if [ "$target" = host ]; then
        echo "command: cargo test --workspace"
        cargo test --workspace >"$T/$target.out" 2>&1 </dev/null
      else
        echo "command: cargo test --workspace --target $target"
        cargo test --workspace --target "$target" >"$T/$target.out" 2>&1 </dev/null
      fi
      rc=$?
      echo "exit: $rc"
      check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
      failed_names "$T/$target.out"
      echo "Running lines, test lines and summary lines:"
      LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test .* \.\.\. |^test result: ' "$T/$target.out" | sed 's/^ */    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/$target.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/$target.names"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      ignored=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^ignored;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      nok=$(count_lines "$T/$target.names")
      echo "$target: passed $passed; failed $failed; ignored $ignored; test lines ending ok: $nok"
      check "$target: failed is 0" "$(yn [ "$failed" -eq 0 ])"
      check "$target: passed is more than 0 and equals the ok test lines" "$(yn passed_matches)"
      n=$(count_bytes "$CTRL_CLASS" "$T/$target.out")
      check "$target: control bytes in the cargo output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
      echo "$passed" >"$T/$target.count"
    done
    
    echo
    echo "## the features on in the workspace run, read from the run (changes FC, IC, KC, PC, QC and SC)"
    # The images module's tests compile only with `images`, the comments
    # module's only with `comments`, the tables
    # module's only with `tables`, the validation, dxf, conditional and visual
    # modules' only with `rules`, and the names, links, properties and protection
    # modules' only with `metadata`; emend-copy turns all four on for the
    # workspace (features unify), so both runs hold them.
    feature_of() { case $1 in sheetprops) echo sheetprops ;; richtext) echo richtext ;; images) echo images ;; comments) echo comments ;; tables) echo tables ;; validation | dxf | conditional | visual) echo rules ;; *) echo metadata ;; esac; }
    for target in host i686-unknown-linux-musl; do
      for module in names links properties protection validation dxf conditional visual tables comments images richtext sheetprops; do
        nmod=$(count_matches -E "^package::tests::$module::" "$T/$target.names")
        echo "  $target: $module module tests passed $nmod"
        check "$target: the run holds the $module module's tests, so the feature $(feature_of "$module") was on" "$(yn [ "$nmod" -ge 1 ])"
      done
    done
    printf 'package::tests::rowcol::a\npackage::tests::validation::b\n' >"$T/c-feat"
    check "control: the same count finds one validation test in a list of two" "$(yn [ "$(count_matches -E '^package::tests::validation::' "$T/c-feat")" = 1 ])"
    
    
    echo
    echo "## the tests per binary"
    per_binary() {
      awk '
        /^ *Running / {
          path = $NF
          gsub(/[()]/, "", path)
          parts = split(path, piece, "/")
          label = piece[parts]
          sub(/-[0-9a-f]+$/, "", label)
          current = (($2 == "unittests") ? "unittests " : "integration ") label
          next
        }
        /^ *Doc-tests / { current = "doc-tests " $2; next }
        /^test result: / {
          if (current == "") next
          for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n = $i
          printf "%s %d\n", current, n
          current = ""
        }
      ' "$1" | sort
    }
    for target in host i686-unknown-linux-musl; do
      per_binary "$T/$target.out" >"$T/$target.per"
    done
    sed 's/^/    /' "$T/host.per"
    sum_per=$(awk '{ n += $NF } END { print n + 0 }' "$T/host.per")
    echo "  the per-binary counts sum to $sum_per; the run's own passed total was $(cat "$T/host.count")"
    check "the per-binary counts sum to the run's passed total" \
      "$(yn [ "$sum_per" = "$(cat "$T/host.count")" ])"
    check "the two targets produce the same per-binary breakdown" \
      "$(yn cmp -s "$T/host.per" "$T/i686-unknown-linux-musl.per")"
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n' >"$T/c-per"
    per_binary "$T/c-per" >"$T/c-per.out"
    nctl_per=$(count_lines "$T/c-per.out")
    echo "  control: a result line with no Running line above it yields $nctl_per rows"
    check "control: the per-binary form attributes nothing to a binary it never saw named" \
      "$(yn [ "$nctl_per" = 0 ])"
    printf '     Running unittests src/lib.rs (target/debug/deps/libctl-0123456789abcdef)\ntest result: ok. 7 passed; 0 failed; 0 ignored\n' >"$T/c-per-hit"
    per_binary "$T/c-per-hit" >"$T/c-per-hit.out"
    sed 's/^/    control row: /' "$T/c-per-hit.out"
    check "control: a Running line and its result yield one row naming the crate and its count" \
      "$(yn [ "$(cat "$T/c-per-hit.out")" = "unittests libctl 7" ])"
    PREV_LOG=records/logs/m3p3-p1/test.log
    PREV_TOTAL=$(sed -n 's/^host executed \([0-9]*\) tests;.*/\1/p' "$PREV_LOG")
    NOW_TOTAL=$(cat "$T/host.count")
    echo "  the workspace total: this phase $NOW_TOTAL, the previous phase $PREV_TOTAL (read from $PREV_LOG)"
    check "the previous phase's total was read from its committed log" "$(yn [ -n "$PREV_TOTAL" ])"
    awk '
      /^## cargo test --workspace \(host\)$/ { inblock = 1; next }
      /^## / { inblock = 0 }
      inblock && /^    test .* \.\.\. ok$/ { sub(/^    test /, ""); sub(/ \.\.\. ok$/, ""); print }
    ' "$PREV_LOG" | sort >"$T/prev.names"
    nprev_names=$(count_lines "$T/prev.names")
    echo "  test names the previous log's host run printed: $nprev_names"
    check "the previous log's names account for its whole host total" "$(yn [ "$nprev_names" = "$PREV_TOTAL" ])"
    comm -13 "$T/prev.names" "$T/host.names" >"$T/added.names"
    comm -23 "$T/prev.names" "$T/host.names" >"$T/removed.names"
    nadded=$(count_lines "$T/added.names")
    nremoved=$(count_lines "$T/removed.names")
    echo "  test names added since the previous phase: $nadded; removed: $nremoved"
    sed 's/^/    added: /' "$T/added.names"
    sed 's/^/    removed: /' "$T/removed.names"
    total_moved_by_names() {
      [ -n "$PREV_TOTAL" ] && [ "$NOW_TOTAL" -eq "$((PREV_TOTAL + nadded - nremoved))" ]
    }
    check "this phase's workspace total is the previous phase's plus the names added less the names removed" \
      "$(yn total_moved_by_names)"
    comm -3 "$T/prev.names" "$T/prev.names" >"$T/c-names"
    check "control: the same comparison of a list with itself finds no difference" \
      "$(yn [ "$(count_lines "$T/c-names")" = 0 ])"
    { cat "$T/prev.names"; echo "zzz::control::name"; } | sort >"$T/c-names-plus"
    check "control: a list with one name more is found to add exactly one" \
      "$(yn [ "$(comm -13 "$T/prev.names" "$T/c-names-plus" | wc -l)" = 1 ])"
    
    echo
    echo "## the tests this phase adds and removes, and the tests the features gate off, derived from the source (P2's change AI and part 4a P4's AR, kept; changes BE, IE, KE, PE, QE, SE and TE)"
    BASE_DOC=$(git log --format='%H' -n 1 --grep='^M3 part 3 P2: commit planning docs [(]the P1 rulings and verification[)]' "$C")
    BASE=$(git rev-parse --verify "$BASE_DOC^" 2>/dev/null)
    echo "command: git log --format=%H -n 1 --grep=<the first doc commit's subject> <phase commit>, and its parent"
    echo "  the first doc commit: $BASE_DOC; the phase base: $BASE"
    check "the phase base resolved from git" "$(yn [ -n "$BASE" ])"
    check "the phase base is P1's record commit" "$(yn [ "$BASE" = "$REC" ])"
    tests_attr() { git show "$1:$2" 2>/dev/null | tests_in; }
    tests_in() {
      awk '
        /^[ \t]*#\[test\][ \t]*$/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]/ {
          sub(/^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next
        }
        t { t = 0 }' | sort
    }
    # gated_off_in [feature]: the tests whose attributes, before the fn line,
    # hold the feature's negation (metadata when none is named) and #[test].
    gated_off_in() {
      awk -v neg="#[cfg(not(feature = \"${1:-metadata}\"))]" '
        index($0, neg) { g = 1; next }
        /^[ \t]*#\[test\][ \t]*$/ { if (g) t = 1; next }
        /^[ \t]*#\[/ { next }
        /^[ \t]*(pub[ \t]+)?fn[ \t]/ {
          if (t) { sub(/^[ \t]*(pub[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print }
          g = 0; t = 0; next
        }
        { g = 0; t = 0 }' | sort
    }
    added_between() {
      # $1 older commit, $2 newer commit: "<file> <name>" per #[test] the newer
      # commit has in a .rs file the pair's diff touches and the older lacks.
      local f
      git diff --name-only "$1" "$2" -- '*.rs' | while IFS= read -r f; do
        tests_attr "$2" "$f" >"$T/ab-new"
        tests_attr "$1" "$f" >"$T/ab-old"
        comm -13 "$T/ab-old" "$T/ab-new" | sed "s#^#$f #"
      done
    }
    removed_between() { added_between "$2" "$1"; }
    git diff --name-only "$BASE" "$C" -- '*.rs' >"$T/changed-rs"
    echo "  the .rs files the phase changed: $(count_lines "$T/changed-rs")"
    sed 's/^/    /' "$T/changed-rs"
    added_between "$BASE" "$C" >"$T/src-added"
    removed_between "$BASE" "$C" >"$T/src-removed"
    # Change AR, kept: the gated-off tests are read from every .rs file under
    # crates and tools at each commit; change BE: for the feature rules as well.
    gated_at() {
      local f
      git ls-tree -r --name-only "$1" -- crates tools | LC_ALL=C "$G" -E '[.]rs$' | while IFS= read -r f; do
        git show "$1:$f" 2>/dev/null | gated_off_in "${2:-metadata}" | sed "s#^#$f #"
      done
    }
    gated_at "$C" >"$T/src-gated"
    gated_at "$BASE" >"$T/src-gated-base"
    gated_at "$C" rules >"$T/src-gated-rules"
    gated_at "$C" tables >"$T/src-gated-tables"
    gated_at "$C" comments >"$T/src-gated-comments"
    gated_at "$C" images >"$T/src-gated-images"
    gated_at "$C" richtext >"$T/src-gated-richtext"
    gated_at "$C" sheetprops >"$T/src-gated-sheetprops"
    echo "  #[test] functions the phase commit gates off under the feature rules, in every .rs file under crates and tools:"
    sed 's/^/    /' "$T/src-gated-rules"
    check "the phase gates off no test under the feature rules ($(count_lines "$T/src-gated-rules"))" "$(yn [ "$(count_lines "$T/src-gated-rules")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature tables, read the same way:"
    sed 's/^/    /' "$T/src-gated-tables"
    check "the phase gates off no test under the feature tables ($(count_lines "$T/src-gated-tables"))" "$(yn [ "$(count_lines "$T/src-gated-tables")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature comments, read the same way:"
    sed 's/^/    /' "$T/src-gated-comments"
    check "the phase gates off no test under the feature comments ($(count_lines "$T/src-gated-comments"))" "$(yn [ "$(count_lines "$T/src-gated-comments")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature images, read the same way:"
    sed 's/^/    /' "$T/src-gated-images"
    check "the phase gates off no test under the feature images ($(count_lines "$T/src-gated-images"))" "$(yn [ "$(count_lines "$T/src-gated-images")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature richtext, read the same way:"
    sed 's/^/    /' "$T/src-gated-richtext"
    check "the phase gates off no test under the feature richtext ($(count_lines "$T/src-gated-richtext"))" "$(yn [ "$(count_lines "$T/src-gated-richtext")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature sheetprops, read the same way:"
    sed 's/^/    /' "$T/src-gated-sheetprops"
    check "the phase gates off no test under the feature sheetprops ($(count_lines "$T/src-gated-sheetprops"); change SE)" "$(yn [ "$(count_lines "$T/src-gated-sheetprops")" = 0 ])"
    echo "  #[test] functions at the phase commit and not at the base, by file:"
    sed 's/^/    /' "$T/src-added"
    echo "  #[test] functions at the base and not at the phase commit, by file:"
    sed 's/^/    /' "$T/src-removed"
    echo "  #[test] functions the phase commit gates off under the feature metadata, in every .rs file under crates and tools, by file:"
    sed 's/^/    /' "$T/src-gated"
    echo "  #[test] functions the base gates off under the feature metadata, read the same way:"
    sed 's/^/    /' "$T/src-gated-base"
    LC_ALL=C comm -13 <(LC_ALL=C sort "$T/src-gated-base") <(LC_ALL=C sort "$T/src-gated") >"$T/src-newly-gated"
    nsrc_added=$(count_lines "$T/src-added")
    nsrc_removed=$(count_lines "$T/src-removed")
    nsrc_gated=$(count_lines "$T/src-gated")
    check "the source adds tests in this phase ($nsrc_added)" "$(yn [ "$nsrc_added" -ge 1 ])"
    check "the source removes no test in this phase ($nsrc_removed)" "$(yn [ "$nsrc_removed" = 0 ])"
    check "the source gates at least one test off under the feature ($nsrc_gated)" "$(yn [ "$nsrc_gated" -ge 1 ])"
    check "the phase gates off no test the base did not ($(count_lines "$T/src-newly-gated"))" "$(yn [ "$(count_lines "$T/src-newly-gated")" = 0 ])"
    awk '{ print $2 }' "$T/src-added" | sort >"$T/src-added.names"
    { awk '{ print $2 }' "$T/src-removed"; awk '{ print $2 }' "$T/src-newly-gated"; } | sort >"$T/src-lost.names"
    sed 's/^.*:://' "$T/added.names" | sort >"$T/run-added.names"
    sed 's/^.*:://' "$T/removed.names" | sort >"$T/run-removed.names"
    check "the names the workspace run added are exactly the tests the source added" \
      "$(yn cmp -s "$T/run-added.names" "$T/src-added.names")"
    check "the names the workspace run lost are exactly the tests the source removed or newly gates off under the feature" \
      "$(yn cmp -s "$T/run-removed.names" "$T/src-lost.names")"
    printf '#[cfg(not(feature = "metadata"))]\n#[test]\nfn ctl_gated() {}\n#[test]\nfn ctl_plain() {}\n#[cfg(feature = "metadata")]\n#[test]\nfn ctl_on() {}\n#[cfg(not(feature = "rules"))]\n#[test]\nfn ctl_rules() {}\n' >"$T/c-gated"
    gated_off_in <"$T/c-gated" >"$T/c-gated.names"
    check "control: gated_off_in reads the one test gated off under metadata and neither the plain, the gated-on nor the rules one" "$(yn [ "$(cat "$T/c-gated.names")" = ctl_gated ])"
    gated_off_in rules <"$T/c-gated" >"$T/c-gated-rules.names"
    check "control: gated_off_in rules reads the one test gated off under rules" "$(yn [ "$(cat "$T/c-gated-rules.names")" = ctl_rules ])"
    # Change TE: the tests the source adds, derived from the diff. No test file
    # is new; package/tests/sheetprops.rs gains tests and keeps every test the
    # base had, the carry's test among them; the tool's added tests are in
    # null_rewrite.rs, each named for the pagesetup sample; no other file gains
    # a test.
    SP_RS=crates/emend/src/package/tests/sheetprops.rs
    TOOL_RS=tools/emend-copy/tests/null_rewrite.rs
    CARRY_NAME=a_view_alone_on_a_part_with_two_sheet_pr_is_written
    git diff --name-only --diff-filter=A "$BASE" "$C" -- '*.rs' | LC_ALL=C "$G" -E '(/tests[.]rs|/tests/)' >"$T/new-test-files" || :
    sed 's/^/    new test file: /' "$T/new-test-files"
    check "the phase adds no test file ($(count_lines "$T/new-test-files"))" "$(yn [ "$(count_lines "$T/new-test-files")" = 0 ])"
    added_in_file() { awk -v f="$1" '$1 == f { print $2 }' "$T/src-added" | sort; }
    added_in_file "$SP_RS" >"$T/added-sp"
    tests_attr "$C" "$SP_RS" >"$T/all-sp"
    tests_attr "$BASE" "$SP_RS" >"$T/base-sp"
    echo "  tests in $SP_RS: at the base $(count_lines "$T/base-sp"), at the phase commit $(count_lines "$T/all-sp"); added $(count_lines "$T/added-sp")"
    sed 's/^/    added to sheetprops.rs: /' "$T/added-sp"
    sp_grows() {
      [ "$(count_lines "$T/added-sp")" -ge 1 ] &&
        [ "$(LC_ALL=C comm -23 "$T/base-sp" "$T/all-sp" | count_lines /dev/stdin)" = 0 ] &&
        LC_ALL=C comm -13 "$T/base-sp" "$T/all-sp" | cmp -s - "$T/added-sp"
    }
    check "sheetprops.rs gains tests and keeps every test the base had (change TE)" "$(yn sp_grows)"
    carry_added() { [ "$(count_matches -Fx "$CARRY_NAME" "$T/added-sp")" = 1 ]; }
    check "the carry's test is among them (specs/0025 P1 verification ruling 2)" "$(yn carry_added)"
    added_in_file "$TOOL_RS" >"$T/added-tool"
    ntool=$(count_lines "$T/added-tool")
    ntool_named=$(count_matches -E '^the_pagesetup_sample_' "$T/added-tool")
    echo "  tests added to $TOOL_RS: $ntool; of them named for the pagesetup sample: $ntool_named"
    tool_named() { [ "$ntool" -ge 1 ] && [ "$ntool" = "$ntool_named" ]; }
    check "the tool's added tests are each named for the pagesetup sample, and some" "$(yn tool_named)"
    # elsewhere <list>: the "<file> <test>" lines of <list> in neither file.
    elsewhere() { awk -v a="$SP_RS" -v d="$TOOL_RS" '$1 != a && $1 != d' "$1"; }
    elsewhere "$T/src-added" >"$T/added-elsewhere"
    check "no other file gains a test ($(count_lines "$T/added-elsewhere"))" "$(yn [ "$(count_lines "$T/added-elsewhere")" = 0 ])"
    printf '%s t1\nx.rs t3\n' "$SP_RS" >"$T/c-src-added"
    check "control: the same filter finds one test outside the two files in a list of two" "$(yn [ "$(elsewhere "$T/c-src-added" | count_lines /dev/stdin)" = 1 ])"
    sed '1d' "$T/all-sp" >"$T/c-all-sp"
    sp_short_ctl() { if LC_ALL=C comm -13 "$T/base-sp" "$T/c-all-sp" | cmp -s - "$T/added-sp" && [ "$(LC_ALL=C comm -23 "$T/base-sp" "$T/c-all-sp" | count_lines /dev/stdin)" = 0 ]; then return 1; else return 0; fi; }
    check "control: sp_grows's comparisons refuse the phase commit's list one test short" "$(yn sp_short_ctl)"
    check "control: the same search finds no test of a name the source lacks" "$(yn [ "$(count_matches -Fx 'x.rs zzz_no_such_test' "$T/src-added")" = 0 ])"
    passed_on() { count_matches -E "(^|::)$1\$" "$T/$2.names"; }
    both_passed() {
      [ "$(passed_on "$1" host)" = 1 ] && [ "$(passed_on "$1" i686-unknown-linux-musl)" = 1 ]
    }
    # Change CK: a name two files share (the call-time test is in validation.rs
    # and conditional.rs) is looked for by its module path: a file under
    # crates/emend/src gives package::tests::<module>::<name>, an integration
    # test file its bare name.
    qualified() {
      case $1 in
        crates/emend/src/*.rs) printf '%s::%s' "$(printf '%s' "${1#crates/emend/src/}" | sed 's/[.]rs$//; s#/#::#g')" "$2" ;;
        *) printf '%s' "$2" ;;
      esac
    }
    echo "  each added test, by its module path, and whether it ran and passed on each target:"
    while read -r f name; do
      q=$(qualified "$f" "$name")
      echo "    $q ($f): host $(passed_on "$q" host), i686-unknown-linux-musl $(passed_on "$q" i686-unknown-linux-musl)"
      check "  $q passed on both targets" "$(yn both_passed "$q")"
    done <"$T/src-added"
    not_passed_ctl() { if both_passed zzz_no_such_test_anywhere; then return 1; else return 0; fi; }
    check "control: both_passed refuses a name no run holds" "$(yn not_passed_ctl)"
    qualified_ok() { [ "$(qualified crates/emend/src/package/tests/tables.rs t)" = package::tests::tables::t ] && [ "$(qualified tools/emend-copy/tests/null_rewrite.rs t)" = t ]; }
    check "control: qualified gives a crate test its module path and an integration test its bare name" "$(yn qualified_ok)"
    printf 'package::tests::validation::t\npackage::tests::conditional::t\n' >"$T/c-dup.names"
    dup_ctl() { [ "$(count_matches -E '(^|::)t$' "$T/c-dup.names")" = 2 ] && [ "$(count_matches -E '(^|::)package::tests::conditional::t$' "$T/c-dup.names")" = 1 ]; }
    check "control: a name two modules share counts twice bare and once by its module path" "$(yn dup_ctl)"
    n_ctl_tests=$(tests_attr "$C" crates/emend/src/archive/tests.rs | count_lines /dev/stdin)
    check "control: the same form finds the #[test] functions of archive/tests.rs at the phase commit ($n_ctl_tests)" "$(yn [ "$n_ctl_tests" -ge 1 ])"
    
    echo
    echo "## the crate's own tests with the feature sheetprops off and on, both targets (changes BD, ID, KD, PD and SD)"
    CRATE_TARGET=$BUILD_ROOT/crate-target
    SP_MOD='^package::tests::sheetprops::'
    crate_ok() { [ "$1" = 0 ] && [ "$2" = 0 ] && [ "$3" -gt 0 ]; }
    fset_args() { case $1 in off) ;; *) echo "--features $1" ;; esac; }
    for target in host i686-unknown-linux-musl; do
      for feat in off sheetprops; do
        args=(test -p emend)
        [ "$target" = host ] || args+=(--target "$target")
        # shellcheck disable=SC2207
        args+=($(fset_args "$feat"))
        echo "command: CARGO_TARGET_DIR=<build>/crate-target cargo ${args[*]}"
        CARGO_TARGET_DIR=$CRATE_TARGET cargo "${args[@]}" >"$T/crate-$target-$feat.out" 2>&1 </dev/null
        rc=$?
        LC_ALL=C "$G" -E '^test result: ' "$T/crate-$target-$feat.out" | sed 's/^/    /'
        failed_names "$T/crate-$target-$feat.out"
        LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/crate-$target-$feat.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/crate-$target-$feat.names"
        cfail=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$T/crate-$target-$feat.out")
        cn=$(count_lines "$T/crate-$target-$feat.names")
        nsp=$(count_matches -E "$SP_MOD" "$T/crate-$target-$feat.names")
        echo "  $target, features $feat: exit $rc; failed $cfail; ok test lines $cn; in the sheetprops module $nsp"
        check "$target, features $feat: the crate's tests exit 0, none failed, some ran" "$(yn crate_ok "$rc" "$cfail" "$cn")"
        printf '%s\n' "$nsp" >"$T/crate-$target-$feat.mods"
        # Part 1's test gated off under metadata runs in both sets, metadata
        # being off in each.
        while read -r f name; do
          ngated=$(count_matches -E "(^|::)$name\$" "$T/crate-$target-$feat.names")
          echo "    the test gated off under metadata, $name, ran and passed $ngated time(s)"
          check "$target, features $feat, metadata off: $name runs and passes" "$(yn [ "$ngated" = 1 ])"
        done <"$T/src-gated"
      done
      check "$target, off: no sheetprops test ran" "$(yn [ "$(cat "$T/crate-$target-off.mods")" = 0 ])"
      check "$target, sheetprops: sheetprops tests ran" "$(yn [ "$(cat "$T/crate-$target-sheetprops.mods")" -ge 1 ])"
      # gained_is <from> <to> <regex>: the names <to> adds to <from> are exactly
      # <to>'s names matching <regex>, and <to> loses none of <from>'s.
      gained_is() {
        LC_ALL=C comm -13 "$T/crate-$target-$1.names" "$T/crate-$target-$2.names" >"$T/gained"
        LC_ALL=C comm -23 "$T/crate-$target-$1.names" "$T/crate-$target-$2.names" >"$T/lost"
        LC_ALL=C "$G" -E "$3" "$T/crate-$target-$2.names" | LC_ALL=C comm -23 - "$T/crate-$target-$1.names" >"$T/gained-want" || :
        [ "$(count_lines "$T/lost")" = 0 ] && [ "$(count_lines "$T/gained")" -ge 1 ] && cmp -s "$T/gained" "$T/gained-want"
      }
      check "$target: sheetprops' names are the off run's plus exactly the sheetprops module's" "$(yn gained_is off sheetprops "$SP_MOD")"
      gained_ctl() { if gained_is off sheetprops '^package::tests::richtext::'; then return 1; else return 0; fi; }
      check "$target: control: gained_is refuses the on run against the off run with another module" "$(yn gained_ctl)"
    done
    for feat in off sheetprops; do
      check "the host and i686 crate runs pass the same names with the features $feat" "$(yn cmp -s "$T/crate-host-$feat.names" "$T/crate-i686-unknown-linux-musl-$feat.names")"
    done
    check "control: the same comparison finds the off and sheetprops runs differ" "$(yn [ "$(comm -3 "$T/crate-host-off.names" "$T/crate-host-sheetprops.names" | count_lines /dev/stdin)" -ge 1 ])"
    
    echo
    echo "## the crate's tests with every feature on, once without and once with EMEND_KEEP_DIR set, host (change RD; P2 verification ruling 6)"
    KEEPD=$(mktemp -d "$T/keep.XXXXXX") || fail=1
    for kv in without with; do
      if [ "$kv" = with ]; then
        echo "command: env EMEND_KEEP_DIR=<scratch>/w/keep CARGO_TARGET_DIR=<build>/crate-target cargo test -p emend --all-features (host)"
        env EMEND_KEEP_DIR="$KEEPD" CARGO_TARGET_DIR="$CRATE_TARGET" cargo test -p emend --all-features >"$T/keep-$kv.out" 2>&1 </dev/null
      else
        echo "command: CARGO_TARGET_DIR=<build>/crate-target cargo test -p emend --all-features (host)"
        CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --all-features >"$T/keep-$kv.out" 2>&1 </dev/null
      fi
      echo "$?" >"$T/keep-$kv.rc"
      echo "  exit: $(cat "$T/keep-$kv.rc")"
      LC_ALL=C "$G" -E '^test result: ' "$T/keep-$kv.out" | sed 's/^/    /'
      failed_names "$T/keep-$kv.out"
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/keep-$kv.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/keep-$kv.names"
    done
    nkeep_files=$(find "$KEEPD" -type f | count_lines /dev/stdin)
    echo "  tests passed without the variable: $(count_lines "$T/keep-without.names"); with it: $(count_lines "$T/keep-with.names"); files the keep holds after the run with it: $nkeep_files"
    keep_same() {
      [ "$(cat "$T/keep-without.rc")" = 0 ] && [ "$(cat "$T/keep-with.rc")" = 0 ] &&
        [ "$(count_lines "$T/keep-with.names")" -ge 1 ] && cmp -s "$T/keep-without.names" "$T/keep-with.names"
    }
    check "with EMEND_KEEP_DIR set the crate's tests exit 0 and pass the same names as without it (change RD)" "$(yn keep_same)"
    check "the run with the variable wrote files into the keep, so the variable was read" "$(yn [ "$nkeep_files" -ge 1 ])"
    check "the variable is still unset in this script's own environment" "$(yn [ -z "${EMEND_KEEP_DIR+x}" ])"
    sed '1d' "$T/keep-with.names" >"$T/c-keep-short"
    keep_ctl() { if cmp -s "$T/keep-without.names" "$T/c-keep-short"; then return 1; else return 0; fi; }
    check "control: the same comparison refuses the names one short" "$(yn keep_ctl)"
    
    echo
    echo "## the sheetprops module in the workspace run beside the crate's run with sheetprops (changes RF and SF; P2 verification ruling 6)"
    # extra_attrs <qualified name>: the attribute lines above the test's fn line,
    # in the file its module path names, at the phase commit, joined by " | ".
    extra_attrs() {
      local q=$1 short file
      short=${q##*::}
      file=crates/emend/src/$(printf '%s' "${q%::*}" | sed 's#::#/#g').rs
      git show "$C:$file" 2>/dev/null | awk -v f="fn $short(" '
        /^[ \t]*#\[/ { a[n++] = $0; next }
        index($0, f) == 1 { for (i = 0; i < n; i++) { s = a[i]; sub(/^[ \t]*/, "", s); printf "%s%s", (i ? " | " : ""), s }; print ""; exit }
        { n = 0 }'
    }
    # outside_feature <attribute lines>: one of them is a cfg naming a feature
    # other than sheetprops. Prints nothing.
    outside_feature() {
      printf '%s\n' "$1" | LC_ALL=C "$G" -o -E 'feature = "[a-z]+"' | sed -E 's/feature = "([a-z]+)"/\1/' |
        LC_ALL=C "$G" -qvxE 'sheetprops'
    }
    for target in host i686-unknown-linux-musl; do
      LC_ALL=C "$G" -E '^package::tests::sheetprops::' "$T/$target.names" | sort >"$T/ws-sp-$target" || :
      LC_ALL=C "$G" -E '^package::tests::sheetprops::' "$T/crate-$target-sheetprops.names" | sort >"$T/on-sp-$target" || :
      comm -23 "$T/ws-sp-$target" "$T/on-sp-$target" >"$T/sp-extra-$target"
      comm -13 "$T/ws-sp-$target" "$T/on-sp-$target" >"$T/sp-missing-$target"
      echo "  $target: the sheetprops module's tests in the workspace run $(count_lines "$T/ws-sp-$target"); in the crate's run with sheetprops $(count_lines "$T/on-sp-$target"); in the first and not the second $(count_lines "$T/sp-extra-$target"); in the second and not the first $(count_lines "$T/sp-missing-$target")"
      while IFS= read -r q; do
        echo "    in the workspace run alone: $q; its attribute lines: $(extra_attrs "$q")"
        check "  $q carries a cfg naming a feature the sheetprops run leaves off" "$(yn outside_feature "$(extra_attrs "$q")")"
      done <"$T/sp-extra-$target"
      check "$target: every sheetprops test of the crate's run is in the workspace run" "$(yn [ "$(count_lines "$T/sp-missing-$target")" = 0 ])"
    done
    check "control: outside_feature finds the rowcol cfg" "$(yn outside_feature '#[cfg(feature = "rowcol")] | #[test]')"
    own_only_ctl() { if outside_feature '#[cfg(feature = "sheetprops")] | #[test]'; then return 1; else return 0; fi; }
    check "control: outside_feature refuses a cfg naming sheetprops alone" "$(yn own_only_ctl)"
    check "control: extra_attrs reads the attribute lines of a test of the sheetprops module" "$(yn [ -n "$(extra_attrs package::tests::sheetprops::a_setting_on_a_part_with_a_pending_shift_is_refused)" ])"
    
    echo
    echo "## the carry's test and the added-sheet test, each run alone with sheetprops (change TG)"
    # alone_run <label> <features> <test>: the test run alone on the host, the
    # command, its exit and its test lines printed and the exit kept (change QJ).
    alone_run() {
      local label=$1 feats=$2 name=$3
      echo "command: CARGO_TARGET_DIR=<build>/crate-target cargo test -p emend --features $feats --lib $name -- --exact (host)"
      CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --features "$feats" --lib "$name" -- --exact >"$T/alone-$label.out" 2>&1 </dev/null
      echo "$?" >"$T/alone-$label.rc"
      echo "exit: $(cat "$T/alone-$label.rc")"
      LC_ALL=C "$G" -E '^test .* \.\.\. |^test result: ' "$T/alone-$label.out" | sed 's/^/    /'
      failed_names "$T/alone-$label.out"
    }
    # alone_ok <label> <test>: that run exited 0, its test ran ok and exactly one
    # test passed. Prints nothing (change QJ).
    alone_ok() {
      local label=$1 name=$2
      [ "$(cat "$T/alone-$label.rc")" = 0 ] && LC_ALL=C "$G" -qxF "test $name ... ok" "$T/alone-$label.out" &&
        [ "$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/alone-$label.out")" = 1 ]
    }
    CARRY_TEST=package::tests::sheetprops::a_view_alone_on_a_part_with_two_sheet_pr_is_written
    ADDED_TEST=package::tests::sheetprops::a_p2_setting_on_a_sheet_added_in_the_same_write_lands_on_its_blank_worksheet
    alone_run carry sheetprops "$CARRY_TEST"
    check "the carry's test ran alone with sheetprops on and passed (specs/0025 P1 verification ruling 2)" "$(yn alone_ok carry "$CARRY_TEST")"
    alone_run added-sheet sheetprops "$ADDED_TEST"
    check "P2's added-sheet test ran alone with sheetprops on and passed" "$(yn alone_ok added-sheet "$ADDED_TEST")"
    for t in "$CARRY_TEST" "$ADDED_TEST"; do
      check "control: $t is absent from the crate's run with the features off" "$(yn [ "$(count_matches -Fx "$t" "$T/crate-host-off.names")" = 0 ])"
    done
    
    echo
    echo "## the workspace's emend unit-test binary beside the crate's own runs (change AB, kept; change BG)"
    # The workspace builds emend with dates, rowcol, metadata, rules, tables,
    # comments, images, richtext and sheetprops, since emend-copy enables all
    # nine (changes PF and SJ). Both crate runs are made here and read per binary.
    for feats in rowcol,metadata,rules,tables,comments,images,richtext,sheetprops dates,rowcol,metadata,rules,tables,comments,images,richtext,sheetprops; do
      echo "command: CARGO_TARGET_DIR=<build>/crate-target cargo test -p emend --features $feats (host)"
      CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --features "$feats" >"$T/crate-$feats.out" 2>&1 </dev/null
      printf '%s' "$?" >"$T/crate-$feats.rc"
      echo "  exit: $(cat "$T/crate-$feats.rc")"
      per_binary "$T/crate-$feats.out" >"$T/crate-$feats.per"
      sed 's/^/    /' "$T/crate-$feats.per"
    done
    unit_row() { awk '$1 == "unittests" && $2 == "emend" { print $3 }' "$1"; }
    UW=$(unit_row "$T/host.per")
    URM=$(unit_row "$T/crate-rowcol,metadata,rules,tables,comments,images,richtext,sheetprops.per")
    UDRM=$(unit_row "$T/crate-dates,rowcol,metadata,rules,tables,comments,images,richtext,sheetprops.per")
    NDATES=$(count_matches -E '^dates::' "$T/host.names")
    echo "  the emend unit-test binary: the workspace run $UW; the crate with rowcol, metadata, rules, tables, comments, images, richtext and sheetprops $URM; the crate with dates, rowcol, metadata, rules, tables, comments, images, richtext and sheetprops $UDRM"
    echo "  test names under dates:: in the workspace's host run: $NDATES; the workspace's binary less the rowcol, metadata, rules, tables, comments, images, richtext and sheetprops run's: $(( ${UW:-0} - ${URM:-0} ))"
    crate_runs_ok() { [ "$(cat "$T/crate-rowcol,metadata,rules,tables,comments,images,richtext,sheetprops.rc")" = 0 ] && [ "$(cat "$T/crate-dates,rowcol,metadata,rules,tables,comments,images,richtext,sheetprops.rc")" = 0 ] && [ -n "$UW" ] && [ -n "$URM" ] && [ -n "$UDRM" ]; }
    check "both crate runs exit 0 and every emend unit-test row was read" "$(yn crate_runs_ok)"
    check "the crate with dates, rowcol, metadata, rules, tables, comments, images, richtext and sheetprops runs the workspace's emend binary, test for test by count" "$(yn [ "$UDRM" = "$UW" ])"
    dates_is_difference() { [ "$NDATES" -ge 1 ] && [ "$((UW - URM))" = "$NDATES" ]; }
    check "the workspace's binary less the rowcol, metadata, rules, tables, comments, images, richtext and sheetprops run's is exactly the dates module's tests" "$(yn dates_is_difference)"
    printf 'unittests emend 5\nunittests emend_copy 0\nintegration p1 3\n' >"$T/c-unit"
    check "control: unit_row reads the emend row and no other" "$(yn [ "$(unit_row "$T/c-unit")" = 5 ])"
    
    echo
    echo "## the legacy hash on three passwords of known hash, printed by its test with the feature rules on (change AO, kept; change BH)"
    HASH_TEST=package::tests::protection::the_legacy_hash_is_pinned_on_passwords_of_known_hash
    echo "command: cargo test -p emend --features metadata,rules --lib $HASH_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features metadata,rules --lib "$HASH_TEST" -- --exact --nocapture >"$T/hash.out" 2>&1 </dev/null
    hashrc=$?
    echo "exit: $hashrc"
    LC_ALL=C "$G" -E '^legacy_password_hash[(]' "$T/hash.out" >"$T/hash.lines"
    sed 's/^/    /' "$T/hash.lines"
    LC_ALL=C "$G" -E '^test result: ' "$T/hash.out" | sed 's/^/    /'
    # The published values of the legacy algorithm for these three passwords.
    printf '%s\n' 'legacy_password_hash("password") = 83AF' 'legacy_password_hash("test") = CBEB' 'legacy_password_hash("secret") = DAA7' >"$T/hash.want"
    passed_in() { awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$1"; }
    hash_ran() { [ "$hashrc" = 0 ] && [ "$(passed_in "$T/hash.out")" = 1 ]; }
    check "the hash test ran alone and passed" "$(yn hash_ran)"
    check "it printed the three hashes, each the published value" "$(yn cmp -s "$T/hash.lines" "$T/hash.want")"
    printf '%s\n' 'legacy_password_hash("password") = 83AF' 'legacy_password_hash("test") = CBEB' 'legacy_password_hash("secret") = DAA8' >"$T/c-hash"
    hash_ctl() { if cmp -s "$T/c-hash" "$T/hash.want"; then return 1; else return 0; fi; }
    check "control: the same comparison refuses one hash off by one" "$(yn hash_ctl)"
    
    echo
    echo "## the sixteen sheetProtection elements, printed by their test with the feature rules on (change AO, kept; change BH)"
    OPT_TEST=package::tests::protection::each_option_flipped_writes_its_one_attribute
    echo "command: cargo test -p emend --features metadata,rules --lib $OPT_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features metadata,rules --lib "$OPT_TEST" -- --exact --nocapture >"$T/opt.out" 2>&1 </dev/null
    optrc=$?
    echo "exit: $optrc"
    LC_ALL=C "$G" -E '^<sheetProtection' "$T/opt.out" >"$T/opt.lines"
    sed 's/^/    /' "$T/opt.lines"
    LC_ALL=C "$G" -E '^test result: ' "$T/opt.out" | sed 's/^/    /'
    # The rule of "Protection": sheet unlocked is its default, so no attribute;
    # every other option flipped writes the protected sheet and its one attribute.
    {
      echo '<sheetProtection/>'
      for a in 'objects="1"' 'scenarios="1"' 'formatCells="0"' 'formatColumns="0"' 'formatRows="0"' \
