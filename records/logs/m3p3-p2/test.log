    sh_passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/sh.out")
    nsh=$(count_lines "$T/sh.lines")
    # The cases the test pins, counted in its source at the phase commit: an
    # index row (shift, i, Some|None), an interval row (shift, a, b, Moved::),
    # and each clip call.
    SH_ROW_RE='^ *[(](ins|del), [0-9]+, (Some[(][0-9]+[)]|None|[0-9]+, Moved::[A-Za-z]+([(][0-9]+, [0-9]+[)])?)[)],$'
    git show "$C:crates/emend/src/package/tests/shift.rs" >"$T/sh-src"
    nsh_rows=$(count_matches -E "$SH_ROW_RE" "$T/sh-src")
    nsh_clips=$(count_matches -F '.area_clipped(Area::parse(' "$T/sh-src")
    echo "  shift lines printed: $nsh; rows the test pins: $nsh_rows; clip calls: $nsh_clips; tests the run passed: $sh_passed"
    sh_ran() { [ "$shrc" -eq 0 ] && [ "$sh_passed" = 1 ]; }
    check "the shift table test ran alone and passed" "$(yn sh_ran)"
    sh_rows() { [ "$nsh" -ge 1 ] && [ "$nsh" = "$((nsh_rows + nsh_clips))" ]; }
    check "one printed line per pinned case, and at least one" "$(yn sh_rows)"
    printf '        (ins, 4, Some(4)),\n        (del, 5, 6, Moved::Gone),\n        (del, 3, 5, Moved::Changed(3, 4)),\n    let x = 1;\n' >"$T/c-sh"
    check "control: the row form counts three pinned rows of four lines" "$(yn [ "$(count_matches -E "$SH_ROW_RE" "$T/c-sh")" = 3 ])"
    
    echo
    echo "## the keyword table, printed by its test with the features metadata and rules on (specs/0017 \"P1\"; change BH)"
    KW_TEST=styles::elements::tests::every_keyword_is_the_schemas_spelling
    echo "command: cargo test -p emend --features metadata,rules --lib $KW_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features metadata,rules --lib "$KW_TEST" -- --exact --nocapture >"$T/kw.out" 2>&1 </dev/null
    kwrc=$?
    echo "exit: $kwrc"
    LC_ALL=C "$G" -E '^keyword ' "$T/kw.out" >"$T/kw.lines"
    sed 's/^/    /' "$T/kw.lines"
    LC_ALL=C "$G" -E '^test result: ' "$T/kw.out" | sed 's/^/    /'
    kw_passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/kw.out")
    nkw=$(count_lines "$T/kw.lines")
    # The rows the test pins, counted in its source at the phase commit as
    # occurrences, not lines (two rows can share a line): a variant and a quoted
    # spelling in parentheses.
    ROW_RE='[(](Underline|VerticalAlign|Scheme|Pattern|BorderStyle|Horizontal|Vertical)::[A-Za-z0-9]+, "[A-Za-z0-9]+"[)]'
    rows_in() { LC_ALL=C "$G" -o -E "$ROW_RE" "$1" | count_lines /dev/stdin; }
    git show "$C:crates/emend/src/styles/elements/tests.rs" >"$T/kw-src"
    nrows=$(rows_in "$T/kw-src")
    echo "  keyword lines printed: $nkw; rows the test pins in its source: $nrows; tests the run passed: $kw_passed"
    kw_ran() { [ "$kwrc" -eq 0 ] && [ "$kw_passed" = 1 ]; }
    check "the keyword test ran alone and passed" "$(yn kw_ran)"
    kw_rows() { [ "$nkw" -ge 1 ] && [ "$nkw" = "$nrows" ]; }
    check "one printed line per pinned row, and at least one" "$(yn kw_rows)"
    # Each printed keyword is its variant's name with the first letter lowered,
    # which is the lower camel case every keyword specs/0017 names takes.
    lowered_mismatch() {
      awk '{ n = split($2, p, "::"); v = p[n]; want = tolower(substr(v, 1, 1)) substr(v, 2); if ($3 != want) bad++ } END { print bad + 0 }' "$1"
    }
    nbad=$(lowered_mismatch "$T/kw.lines")
    echo "  printed keywords that are not the variant's name with its first letter lowered: $nbad"
    check "every printed keyword is its variant's name with the first letter lowered" "$(yn [ "$nbad" = 0 ])"
    printf 'keyword Pattern::DarkGray darkgray\nkeyword Scheme::Major major\n' >"$T/c-kw"
    check "control: the same comparison finds one misspelled keyword of two" "$(yn [ "$(lowered_mismatch "$T/c-kw")" = 1 ])"
    printf '        &[(Scheme::Major, "major"), (Scheme::Minor, "minor")],\n        (BorderStyle::Thin, "thin")\n    pinned(\n' >"$T/c-rows"
    check "control: the row form counts three rows on two lines of three" "$(yn [ "$(rows_in "$T/c-rows")" = 3 ])"
    
    echo
    echo "## no test sets EMEND_KEEP_DIR (specs/0015 P1 ruling 3, unchanged by this phase)"
    # The variable's name appears in the source only as the two KEEP_VARIABLE
    # constants, and nothing under crates/ or tools/ calls set_var or remove_var.
    echo "command: git grep -n -F EMEND_KEEP_DIR <phase commit> -- crates tools"
    git grep -n -F EMEND_KEEP_DIR "$C" -- crates tools | sed "s#^$C:##" >"$T/keep-var"
    sed 's/^/    /' "$T/keep-var"
    only_constants() {
      [ "$(count_lines "$T/keep-var")" = 2 ] &&
        [ "$(count_matches -E 'const KEEP_VARIABLE: &str = "EMEND_KEEP_DIR";$' "$T/keep-var")" = 2 ]
    }
    check "EMEND_KEEP_DIR is named only by the two KEEP_VARIABLE constants" "$(yn only_constants)"
    echo "command: git grep -n -E 'set_var|remove_var' <phase commit> -- crates tools"
    git grep -n -E 'set_var|remove_var' "$C" -- crates tools | sed "s#^$C:##" >"$T/set-var"
    sed 's/^/    /' "$T/set-var"
    check "nothing under crates/ or tools/ calls set_var or remove_var ($(count_lines "$T/set-var"))" "$(yn [ "$(count_lines "$T/set-var")" = 0 ])"
    printf 'x.rs:1:    unsafe { std::env::set_var("EMEND_KEEP_DIR", "d") };\n' >"$T/c-set-var"
    check "control: the same pattern finds a set_var line" "$(yn [ "$(count_matches -E 'set_var|remove_var' "$T/c-set-var")" = 1 ])"
    
    echo
    echo "## the ignored tests, derived from the source"
    ignored_in() {
      awk '
        /^[ \t]*#\[ignore/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?fn[ \t]/ { sub(/^[ \t]*(pub[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next }
        t { t = 0 }'
    }
    ignored_at() {
      git ls-tree -r --name-only "$1" | LC_ALL=C "$G" -E '[.]rs$' | while IFS= read -r f; do
        git show "$1:$f" | ignored_in
      done | sort
    }
    ignored_at "$BASE" >"$T/ign-base"
    ignored_at "$C" >"$T/ign-c"
    sed 's/^/    ignored in the source at the base: /' "$T/ign-base"
    sed 's/^/    ignored in the source at the phase commit: /' "$T/ign-c"
    check "the phase commit ignores exactly the tests the base ignored" "$(yn cmp -s "$T/ign-base" "$T/ign-c")"
    for target in host i686-unknown-linux-musl; do
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" | sed 's/^/    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" |
        sed -E 's/^test ([^ ]*) \.\.\. ignored.*/\1/; s/^.*:://' | sort >"$T/ign-run-$target"
      check "$target: the run's ignored tests are exactly the source's ($(count_lines "$T/ign-run-$target"))" \
        "$(yn cmp -s "$T/ign-run-$target" "$T/ign-c")"
    done
    printf '#[test]\n#[ignore = "why"]\n#[cfg(unix)]\nfn ctl_ignored() {}\n#[test]\nfn ctl_run() {}\n' | ignored_in >"$T/c-ign"
    check "control: ignored_in reads the one ignored fixture test ($(tr '\n' ' ' <"$T/c-ign"))" \
      "$(yn [ "$(cat "$T/c-ign")" = ctl_ignored ])"
    { cat "$T/ign-c"; echo zzz_control; } | sort >"$T/c-ign-plus"
    check "control: the same comparison refuses a set one name longer" \
      "$(yn [ "$(comm -3 "$T/c-ign-plus" "$T/ign-c" | count_lines /dev/stdin)" = 1 ])"
    
    echo
    echo "## six planted changes to this phase's code, each against its named test (change TI)"
    # An archive copy of the phase commit, never <repo>. Each plant replaces one
    # exact text, found once, in a fresh copy of its file; the named test runs
    # alone. The control is the same test in the unplanted copy, which passes.
    SRC=$T/src
    mkdir -p "$SRC" || fail=1
    echo "command: git archive <phase commit> | tar -x -m -C <scratch>/w/src (-m: each file takes the extraction's time, not the commit's, so no build an earlier run left in <build>/plant-target is taken for current)"
    git archive "$C" | tar -x -m -C "$SRC"
    echo "  files extracted: $(find "$SRC" -type f | count_lines /dev/stdin)"
    PLANT_TARGET=$BUILD_ROOT/plant-target
    # plant_apply <id> <file>: replaces the plant's text in <file>, printing the
    # number of times the text was found before the replacement.
    plant_apply() {
      python3 - "$1" "$2" <<'PLANTS'
    import sys
    pid, path = sys.argv[1:3]
    plants = {
        "Z1": ("            scale: later.scale.or(self.scale),",
               "            scale: self.scale.or(later.scale),"),
        "Z2": ("            if self.needs(*setting) && !self.met[at] && place < position && place < below {",
               "            if self.needs(*setting) && !self.met[at] && place < position {"),
        "Z3": ("            insert_ordered(children, &HEADER_FOOTER_CHILDREN, local, bytes);",
               "            children.push(HeldChild::Element { local: local.to_vec(), bytes });"),
        "Z4": ("                    *bytes = merged_tag(bytes, &set, index)?;",
               "                    *bytes = merged_tag(bytes, &[], index)?;"),
        "Z5": ("            (b\"top\", self.top, 0.75),",
               "            (b\"top\", self.top, 0.7),"),
        "Z6": ("            && self.copies.is_none_or(|copies| copies >= 1)",
               "            && self.copies.is_none_or(|_| true)"),
    }
    old, new = plants[pid]
    text = open(path).read()
    print(text.count(old))
    if text.count(old) == 1:
        open(path, "w").write(text.replace(old, new))
    PLANTS
    }
    # id | file | what the plant does | cargo arguments before the name | the test | the file and the text of the assertion it must fail at
    cat >"$T/plants" <<'TABLE'
    Z1|crates/emend/src/package.rs|a page setup field merged first call wins|-p emend --features sheetprops --lib|package::tests::sheetprops::two_calls_on_one_part_each_set_the_p2_fields_they_give|crates/emend/src/package/tests/sheetprops.rs|two_calls_on_one_part_each_set_the_p2_fields_they_give|assert_eq!(
    Z2|crates/emend/src/package.rs|the settings elements created without the bound below the created elements|-p emend --features sheetprops --lib|package::tests::sheetprops::the_four_elements_are_created_in_one_write_in_schema_order|crates/emend/src/package/tests/sheetprops.rs|the_four_elements_are_created_in_one_write_in_schema_order|assert_eq!( >> got,
    Z3|crates/emend/src/package.rs|a header text appended after the other children|-p emend --features sheetprops --lib|package::tests::sheetprops::each_header_and_footer_child_is_written_replaced_dropped_or_kept|crates/emend/src/package/tests/sheetprops.rs|each_header_and_footer_child_is_written_replaced_dropped_or_kept|assert_eq!( >> edited(&body, |p| p >> .set_header_footer(SHEET, &text("new"))
    Z4|crates/emend/src/package.rs|fitToPage not set on an existing pageSetUpPr|-p emend --features sheetprops --lib|package::tests::sheetprops::fit_to_page_sets_or_creates_page_set_up_pr_under_sheet_pr|crates/emend/src/package/tests/sheetprops.rs|fit_to_page_sets_or_creates_page_set_up_pr_under_sheet_pr|assert_eq!( >> edited(&format!("{before}<sheetData/>"), |p| p
    Z5|crates/emend/src/package.rs|a created pageMargins's top default 0.7 for 0.75|-p emend --features sheetprops --lib|package::tests::sheetprops::each_element_is_created_in_schema_position_on_a_part_lacking_it|crates/emend/src/package/tests/sheetprops.rs|each_element_is_created_in_schema_position_on_a_part_lacking_it|assert_eq!( >> edited(body, |p| p >> .set_page_margins(SHEET, &left)
    Z6|crates/emend/src/package.rs|copies of zero accepted|-p emend --features sheetprops --lib|package::tests::sheetprops::the_p2_refusals_at_the_call_record_nothing|crates/emend/src/package/tests/sheetprops.rs|the_p2_refusals_at_the_call_record_nothing|package.set_page_setup(SHEET, &setup).expect_err("refused"),
    TABLE
    sed 's/^/    plant: /' "$T/plants"
    nplants=$(count_lines "$T/plants")
    echo "  plants in the table: $nplants"
    check "the table holds six plants (change TI)" "$(yn [ "$nplants" = 6 ])"
    # run_one <label> <cargo args> <test>: runs one test in the archive copy; the
    # exit status and the output go to <scratch>/w/plant-<label>.
    run_one() {
      local label=$1 args=$2 name=$3
      ( cd "$SRC" && CARGO_TARGET_DIR=$PLANT_TARGET cargo test $args "$name" -- --exact ) \
        >"$T/plant-$label.out" 2>&1 </dev/null
      echo $? >"$T/plant-$label.rc"
    }
    # The lines a failing test prints that say what failed: its FAILED line, the
    # panic line, the message line after it (part 4a P1's change AF), and the
    # assertion's left and right.
    failure_lines() {
      awk '/panicked at/ { print; if ((getline line) > 0) print line; next }
           /^test .* \.\.\. (ok|FAILED)$|^  left:|^ right:|^assertion/ { print }' "$1" | head -n 14
    }
    test_line_is() { LC_ALL=C "$G" -a -qxF "test $1 ... $2" "$3"; }
    plant_ok() {
      local id=$1 name=$2
      [ "$(cat "$T/plant-$id.found")" = 1 ] || return 1
      [ "$(cat "$T/plant-$id-clean.rc")" = 0 ] || return 1
      test_line_is "$name" ok "$T/plant-$id-clean.out" || return 1
      [ "$(cat "$T/plant-$id.rc")" != 0 ] || return 1
      test_line_is "$name" FAILED "$T/plant-$id.out"
    }
    # assert_line <file> <test fn> <text>: the number of the one line, inside the
    # test fn at the phase commit, whose text with the margin dropped is <text>;
    # empty unless exactly one. <text> may be several lines joined by " >> ":
    # then the line is the first of a run of lines each equal to its part, the
    # run found once (change TI).
    assert_line() {
      git show "$C:$1" | awk -v f="fn $2(" -v t="$3" '
        BEGIN { k = split(t, part, / >> /) }
        index($0, f) == 1 { on = 1 }
        on { s = $0; sub(/^[ \t]*/, "", s); line[NR] = s; first = first ? first : NR }
        on && /^}$/ { last = NR; on = 0 }
        END {
          for (i = first; i <= last; i++) {
            ok = 1
            for (j = 1; j <= k; j++) if (line[i + j - 1] != part[j]) { ok = 0; break }
            if (ok) { n++; at = i }
          }
          if (n == 1) print at
        }'
    }
    # panic_at <output>: "<file>:<line>" of the first panic the output prints.
    panic_at() { LC_ALL=C "$G" -a -o -E 'panicked at [^ ]+:[0-9]+:[0-9]+' "$1" | head -n 1 | sed -E 's/^panicked at ([^ ]+):([0-9]+):[0-9]+$/\1:\2/'; }
    : >"$T/plant-lines"
    while IFS='|' read -r id file what args name afile afn atext; do
      echo "  plant $id: $what ($file)"
      echo "    command (control, unplanted): cargo test $args $name -- --exact"
      run_one "$id-clean" "$args" "$name"
      echo "    control exit: $(cat "$T/plant-$id-clean.rc")"
      failure_lines "$T/plant-$id-clean.out" | sed 's/^/      /'
      failed_names "$T/plant-$id-clean.out"
      cp "$SRC/$file" "$T/pristine"
      plant_apply "$id" "$SRC/$file" >"$T/plant-$id.found"
      echo "    the plant's text found in the file: $(cat "$T/plant-$id.found") time(s)"
      echo "    command (planted): cargo test $args $name -- --exact"
      run_one "$id" "$args" "$name"
      echo "    planted exit: $(cat "$T/plant-$id.rc")"
      failure_lines "$T/plant-$id.out" | sed 's/^/      /'
      failed_names "$T/plant-$id.out"
      cp "$T/pristine" "$SRC/$file"
      check "  plant $id: found once, the test passes unplanted and fails planted" "$(yn plant_ok "$id" "$name")"
      want_line=$(assert_line "$afile" "$afn" "$atext")
      got_at=$(panic_at "$T/plant-$id.out")
      echo "    the assertion it must fail at: $afile, line $want_line ($atext); the planted run's first panic: $got_at"
      printf '%s\n' "$got_at" >>"$T/plant-lines"
      at_own_line() { [ -n "$want_line" ] && [ "$got_at" = "$afile:$want_line" ]; }
      check "  plant $id fails at its own assertion line, read from the source (P2 verification ruling 6)" "$(yn at_own_line)"
    done <"$T/plants"
    ndistinct=$(LC_ALL=C sort -u "$T/plant-lines" | count_lines /dev/stdin)
    echo "  plants: $nplants; distinct assertion lines they failed at: $ndistinct"
    check "each plant failed at a line of its own (P2 verification ruling 6)" "$(yn [ "$ndistinct" = "$nplants" ])"
    restored() {
      local f
      for f in crates/emend/src/package.rs tools/emend-copy/src/main.rs; do
        git show "$C:$f" | cmp -s - "$SRC/$f" || return 1
      done
    }
    check "the planted files are restored to the phase commit's bytes" "$(yn restored)"
    printf "thread 'x' panicked at a.rs:1:1:\nthe planted message\n" >"$T/c-panic"
    fl_message() { [ "$(failure_lines "$T/c-panic" | sed -n 2p)" = "the planted message" ]; }
    check "control: failure_lines prints the message line after a panic line" "$(yn fl_message)"
    check "control: panic_at reads the file and line of a panic line" "$(yn [ "$(panic_at "$T/c-panic")" = a.rs:1 ])"
    check "control: assert_line finds no line for a text the test lacks" "$(yn [ -z "$(assert_line crates/emend/src/package/tests/sheetprops.rs none_drops_the_tab_colour_and_a_sheet_pr_left_empty_with_it 'no such line')" ])"
    check "control: assert_line finds no single line for a text the test holds twice" "$(yn [ -z "$(assert_line crates/emend/src/package/tests/sheetprops.rs a_part_with_no_sheet_views_gains_one_in_schema_position 'assert_eq!(')" ])"
    check "control: assert_line finds one line for a run of lines found once (change TI)" "$(yn [ -n "$(assert_line crates/emend/src/package/tests/sheetprops.rs the_four_elements_are_created_in_one_write_in_schema_order 'assert_eq!( >> got,')" ])"
    check "control: assert_line finds no single line for a run of lines the test holds three times" "$(yn [ -z "$(assert_line crates/emend/src/package/tests/sheetprops.rs each_element_is_created_in_schema_position_on_a_part_lacking_it 'assert_eq!( >> edited(body, |p| p')" ])"
    printf 'test x::y ... ok\n' >"$T/c-tl"
    check "control: test_line_is finds an ok line" "$(yn test_line_is x::y ok "$T/c-tl")"
    not_failed_ctl() { if test_line_is x::y FAILED "$T/c-tl"; then return 1; else return 0; fi; }
    check "control: test_line_is refuses FAILED for a test that passed" "$(yn not_failed_ctl)"
    printf 'no such text\n' >"$T/c-plant.rs"
    check "control: plant_apply finds Z1's text 0 times in a file without it" "$(yn [ "$(plant_apply Z1 "$T/c-plant.rs")" = 0 ])"
    
    echo
    echo "## the two runs"
    echo "host executed $(cat "$T/host.count") tests; i686-unknown-linux-musl executed $(cat "$T/i686-unknown-linux-musl.count") tests"
    check "the i686 run executed the same test names as the host run" "$(yn cmp -s "$T/host.names" "$T/i686-unknown-linux-musl.names")"
    echo
    echo "## status after the runs"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS_RE" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs, its records or planning's uncommitted spec: $st_ours"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]
    }
    check "every change in the working tree is one of this phase's logs, its records (run and open-check) or planning's uncommitted spec" "$(yn status_accounted)"
    printf '?? records/m3p3-open-x.md\n M scripts/check.sh\n?? records/m3p3-p2-x.md\n?? records/m3p3-p1-x.md\n M specs/0024-rich-text.md\n M specs/0025-sheet-and-print-settings.md\n?? records/size-m3p3-x.md\n' >"$T/c-status"
    check "control: the same pattern finds three of seven status lines, planning's spec among them (change TK)" "$(yn [ "$(count_matches -E "$OURS_RE" "$T/c-status")" = 3 ])"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$T/c-err"; printf 'x' >>"$T/c-err"
    nerr_ctl=$(wc -c <"$T/c-err")
    echo "  command: wc -c <phase>/out/test.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

