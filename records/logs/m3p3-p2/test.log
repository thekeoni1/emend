    echo "command: cargo test -p emend --features rowcol,metadata,rules --lib $SH_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features rowcol,metadata,rules --lib "$SH_TEST" -- --exact --nocapture >"$T/sh.out" 2>&1 </dev/null
    shrc=$?
