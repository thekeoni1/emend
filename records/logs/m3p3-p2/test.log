        'selectLockedCells="1"' 'sort="0"' 'autoFilter="0"' 'pivotTables="0"' 'selectUnlockedCells="1"'; do
        echo "<sheetProtection sheet=\"1\" $a/>"
      done
    } | LC_ALL=C sort >"$T/opt.want"
    LC_ALL=C sort "$T/opt.lines" >"$T/opt.sorted"
    opt_ran() { [ "$optrc" = 0 ] && [ "$(passed_in "$T/opt.out")" = 1 ]; }
    check "the option test ran alone and passed" "$(yn opt_ran)"
    echo "  elements printed: $(count_lines "$T/opt.lines"); the rule gives: $(count_lines "$T/opt.want")"
    check "it printed the sixteen elements the rule gives, as a set" "$(yn cmp -s "$T/opt.sorted" "$T/opt.want")"
    sed '1d' "$T/opt.want" >"$T/c-opt"
    opt_ctl() { if cmp -s "$T/c-opt" "$T/opt.want"; then return 1; else return 0; fi; }
    check "control: the same comparison refuses fifteen elements" "$(yn opt_ctl)"
    
    echo
    echo "## the template core-part test's three printed parts, with the feature rules on (change AO, kept; change BH)"
    TPL_TEST=package::tests::properties::the_template_gets_the_part_its_relationship_and_its_override
    echo "command: cargo test -p emend --features metadata,rules --lib $TPL_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features metadata,rules --lib "$TPL_TEST" -- --exact --nocapture >"$T/tpl.out" 2>&1 </dev/null
    tplrc=$?
    echo "exit: $tplrc"
    # Each printed part is the declaration, a line feed and the root, so a
    # printed part is the prefixed line and the one after it.
    printed_part() { awk -v p="$1" 'index($0, p) == 1 { print; getline; print; exit }' "$2"; }
    printed_part 'created core part: ' "$T/tpl.out" >"$T/tpl.core"
    printed_part 'package rels part: ' "$T/tpl.out" >"$T/tpl.rels"
    printed_part 'content types part: ' "$T/tpl.out" >"$T/tpl.types"
    sed 's/^/    /' "$T/tpl.core" "$T/tpl.rels" "$T/tpl.types"
    LC_ALL=C "$G" -E '^test result: ' "$T/tpl.out" | sed 's/^/    /'
    CP_URI=http://schemas.openxmlformats.org/package/2006/metadata/core-properties
    CORE_ROOT="<cp:coreProperties xmlns:cp=\"$CP_URI\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:dcmitype=\"http://purl.org/dc/dcmitype/\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"><dc:title>emend</dc:title><dcterms:created xsi:type=\"dcterms:W3CDTF\">2026-01-01T00:00:00Z</dcterms:created></cp:coreProperties>"
    RELS_TAIL="<Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties\" Target=\"docProps/core.xml\"/></Relationships>"
    TYPES_TAIL="<Override PartName=\"/docProps/core.xml\" ContentType=\"application/vnd.openxmlformats-package.core-properties+xml\"/></Types>"
    part_is() { [ "$(count_lines "$1")" = 2 ] && [ "$(sed -n 2p "$1")" = "$2" ]; }
    part_ends() { [ "$(count_lines "$1")" = 2 ] && [ "$(awk -v t="$2" 'NR == 2 { print (substr($0, length($0) - length(t) + 1) == t) }' "$1")" = 1 ]; }
    tpl_ran() { [ "$tplrc" = 0 ] && [ "$(passed_in "$T/tpl.out")" = 1 ]; }
