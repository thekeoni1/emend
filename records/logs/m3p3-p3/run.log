    """The run log's own print area comparison (specs/0025-sheet-and-print-
    settings.md, "Harness runs", --printarea-sample, P3, with "Planning rulings
    during P3" rulings 1 to 6).
    
    Usage: pacmp.py <input archive> <output archive> [--diff <diff.tsv>] [--plant <flag>]
           pacmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool; its readers are M3 part 3 P2's pscmp.py's,
    copied verbatim (local to merged, et_first, et_count, values_of). It finds
    the workbook part through the package relationship; W, the first <sheet> in
    <sheets> order whose relationship type is a worksheet's, its index among the
    <sheet> elements and its name; M, W's largest row number among its main <c>
    elements (a cell's r, else its row's r), 0 for none; the area A1:H(M + 1).
    From the input it builds the W the design gives (specs/0025 "The calls",
    "The pass"): W's first main <autoFilter> with its start tag merged, ref
    first and every other attribute after it as written, in its order, its
    children dropped (the start tag and an end tag for an element that was not
    empty); or, when W has none, <autoFilter ref="A1:H(M + 1)"/> with the root's
    prefix before the first main root child the 39-name table puts after it.
    And the three names the design appends to the workbook's <definedNames>,
    created when there is none, each with the root's prefix, in this order:
    _xlnm.Print_Area and _xlnm._FilterDatabase with the area's text, and
    _xlnm.Print_Titles with row 1's, each behind W's name bare or quoted by
    ruling 6 (bare when it starts with a letter or _, holds only letters,
    digits, _ and ., and names no cell: an A1 reference on the grid ignoring
    case, or the R1C1 form; else quoted, an apostrophe doubled), localSheetId
    W's index, hidden="1" on the filter database alone, the text escaped as
    the crate's name writer escapes one (& < > " ' as entities, a carriage
    return as &#13;); the input's names of those three for W dropped. It
    compares:
    
      rest_same    W with every main <autoFilter> cut out is the input's W with
                   its own cut out, byte for byte
      places       W's main root children's names are the input's with a
                   created <autoFilter> where the design puts it
      schema_order W's main root children are in the table's order, one
                   <autoFilter>
      af_tag       W's <autoFilter>'s start tag is the design's, byte for byte
      af_empty     read with ElementTree, W's <autoFilter> has no child and its
                   ref is A1:H(M + 1)
      w_bytes      W is exactly the W the design gives
      wb_rest      the workbook part with every main <definedNames> cut out is
                   the input's with its own cut out, byte for byte
      names_place  the workbook's main root children are in CT_Workbook's order,
                   one <definedNames>, and are the input's with a created
                   <definedNames> where that order puts it
      names_prefix the output <definedNames>'s main <definedName> elements less
                   its last three are the input's less the three it drops, byte
                   for byte, in order
      names_three  read with ElementTree, the last three are the design's three,
                   in order: name, localSheetId, hidden on the filter database
                   alone, and text
      names_bytes  the last three are the design's bytes exactly
      others_same  every entry but W and the workbook part is the input's, byte
                   for byte, the names the input's in the input's order
      read_back    read with ElementTree, one <autoFilter> in W, and each of the
                   three names once among the workbook's names for W
      xml_values   with --diff, the runner's diff.<label>.tsv for the pair: its
                   xml "values" rows are W's and the workbook part's, and their
                   in_only and out_only sums are the one-sided counts of the
                   inputs' values against the design's (W's design whole; the
                   workbook's as the input's less the dropped names' values and
                   plus the three's), each value keyed as xlsx-diff keys one
                   (specs/0024 P1 verification ruling 6); without --diff, no
      flagged      with --diff, the diff's entry rows for W and the workbook part
                   carry the flag descriptor exactly when the input's local
                   header sets general purpose bit 3, and no other row is
                   flagged; without --diff, no
    
    It prints ONE line of counts and yes/no flags and no text, reference, sheet
    name or part name. --parts prints W's part name and 1, 0 or - for its bit 3,
    then the workbook part's name and its bit 3, one per line, for the log to
    compare with the runner's rows without printing them. --plant <flag>
    changes the output as read so that the named flag turns to no; the line
    then says planted=yes, or planted=no when the pair gives the plant nothing
    to change.
    """
    import collections
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    # ECMA-376 Part 1, 18.3.1.99, the worksheet root's children in order: this
    # program's own copy (specs/0018, "Creating an element"), not the crate's.
    TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    assert len(TABLE) == 39
    # CT_Workbook's children in order (ECMA-376 Part 1, 18.2.27).
    BOOK = (
        "fileVersion fileSharing workbookPr workbookProtection bookViews sheets "
        "functionGroups externalReferences definedNames calcPr oleSize "
        "customWorkbookViews pivotCaches smartTagPr smartTagTypes webPublishing "
        "fileRecoveryPr webPublishObjects extLst").split()
    assert len(BOOK) == 19
    NAMES = ("_xlnm.Print_Area", "_xlnm.Print_Titles", "_xlnm._FilterDatabase")
    
    FLAGS = ("rest_same", "places", "schema_order", "af_tag", "af_empty", "w_bytes", "wb_rest",
             "names_place", "names_prefix", "names_three", "names_bytes", "others_same", "read_back",
             "xml_values", "flagged")
    
    COMMENT = b"<!-- planted -->"
    CELL = re.compile(r"^([A-Z]+)([1-9][0-9]*)$")
    R1C1 = re.compile(r"^[Rr][0-9]*[Cc][0-9]*$")
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def pick_w(z, workbook):
        """W's part, or None: the first main <sheet> whose relationship is a
        worksheet's."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty in (ATTR[0] + "/worksheet", ATTR[1] + "/worksheet"):
                    return target
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTRS_RE = re.compile(rb'\s([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')')
    
    
    def attributes(tag):
        """[(name, bytes from the name to the closing quote)] of a start tag, in
        order, namespace declarations among them."""
        return [(m.group(1), tag[m.start(1):m.end()]) for m in ATTRS_RE.finditer(tag)]
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def is_main(raw, parent_prefix, parent_main):
        """Whether an element whose bytes start `raw` is in the main namespace:
        its own declaration of its prefix, else its parent's when the prefix is
        the parent's."""
        p, _ = split_name(qname(raw))
        tag = start_tag(raw)
        decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
        own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
        if own:
            return own.group(1)[1:-1].decode() in MAIN
        return p == parent_prefix and parent_main
    
    
    def children(data, a, b, rp, parent_main):
        """[(start, end, main local name or None)] of the elements in data[a:b]."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            n = split_name(qname(raw))[1]
            out.append((a + x, a + y, n if is_main(raw, rp, parent_main) else None))
        return out
    
    
    def content_span(data, x, y):
        """(start, end) of an element's content, equal for an empty tag."""
        raw = data[x:y]
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return x + len(tag), x + len(tag)
        return x + len(tag), x + raw.rfind(b"</")
    
    
    def rels_prefix_of(tag):
        """The prefix a start tag binds to the relationships namespace, or None."""
        for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            if m.group(2)[1:-1].decode() in ATTR:
                return m.group(1)
        return None
    
    
    def bit3(zin, name):
        """1 or 0 for whether the input's entry sets general purpose bit 3, -
        when there is no such entry."""
        try:
            return "1" if zin.getinfo(name).flag_bits & 0x08 else "0"
        except KeyError:
            return "-"
    
    
    def cut(data, spans):
        """data with the spans cut out."""
        out, at = [], 0
        for (x, y) in sorted(spans):
            out.append(data[at:x])
            at = y
        out.append(data[at:])
        return b"".join(out)
    
    
    def first_insert(kids, after, root_end):
        """The offset before the first main root child the table puts after the
        position `after`, or the root's end."""
        for (x, _, nm) in kids:
            if nm in TABLE and TABLE.index(nm) > after:
                return x
        return root_end
    
    
    def merged(tag, sets):
        """A start tag with `sets` first, in their order, and every other
        attribute after them as written, in its order; empty when it was."""
        names = [n for (n, _) in sets]
        kept = b"".join(b" " + raw for (n, raw) in attributes(tag) if n not in names)
        head = b"".join(b" " + n + b'="' + v + b'"' for (n, v) in sets)
        return b"<" + qname(tag) + head + kept + (b"/>" if tag.endswith(b"/>") else b">")
    
    
    def rid_of(tag):
        """The bytes of a start tag's attribute whose name ends ':id', or None."""
        for (n, raw) in attributes(tag):
            if n.endswith(b":id") and not n.startswith(b"xmlns"):
                return raw
        return None
    
    
    def et_first(root, name):
        for el in root:
            ns, nm = local(el.tag)
            if ns in MAIN and nm == name:
                return el
        return None
    
    
    def et_count(root, name):
        return sum(1 for el in root if local(el.tag)[0] in MAIN and local(el.tag)[1] == name)
    
    
    def values_of(root):
        """The values of an ElementTree as xlsx-diff keys them: each attribute
        (namespace declarations are not attributes here) by element, attribute
        and value; each text node that is not whitespace alone by its element
        and its text (a node's element is the one it stands in: an element's
        text is its own, its tail its parent's)."""
        vals = collections.Counter()
        ws = " \t\n\r"
    
        def walk(el):
            for (k, v) in el.attrib.items():
                vals[("a", el.tag, k, v)] += 1
            if el.text and el.text.strip(ws):
                vals[("t", el.tag, el.text)] += 1
            for c in el:
                walk(c)
                if c.tail and c.tail.strip(ws):
                    vals[("t", el.tag, c.tail)] += 1
    
        walk(root)
        return vals
    
    
    def ascii_upper(s):
        return "".join(c.upper() if "a" <= c <= "z" else c for c in s)
    
    
    def names_a_cell(name):
        m = CELL.match(ascii_upper(name))
        if m:
            col = 0
            for ch in m.group(1):
                col = col * 26 + ord(ch) - 64
            if 1 <= col <= 16384 and 1 <= int(m.group(2)) <= 1048576:
                return True
        return bool(R1C1.match(name))
    
    
    def in_formula(name):
        """W's name as ruling 6 writes it before !."""
        plain = (bool(name) and (name[0].isalpha() or name[0] == "_")
                 and all(c.isalnum() or c in "_." for c in name) and not names_a_cell(name))
        return name if plain else "'" + name.replace("'", "''") + "'"
    
    
    def escaped(text):
        """A name's text as the crate's writer escapes it."""
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace('"', "&quot;").replace("'", "&apos;").replace("\r", "&#13;")).encode()
    
    
    def w_of(z, workbook):
        """(W's part, its index among the <sheet> elements, its name), or None."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        k = 0
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty in (ATTR[0] + "/worksheet", ATTR[1] + "/worksheet"):
                    return target, k, el.get("name", "")
                k += 1
        return None
    
    
    def max_row(root):
        m = 0
        for row in root.iter():
            ns, nm = local(row.tag)
            if ns in MAIN and nm == "row":
                for c in row:
                    cns, cnm = local(c.tag)
                    if cns in MAIN and cnm == "c":
                        r = c.get("r")
                        mt = CELL.match(r) if r else None
                        m = max(m, int(mt.group(2)) if mt else int(row.get("r") or 0))
        return m
    
    
    def shape(w, root_ns, name):
        """W's (or the workbook's) root spans and prefix, its root children, and
        the spans of the root children named `name`."""
        ts, te, a, b, rp = root_span(w)
        kids = children(w, a, b, rp, root_ns in MAIN)
        return {"ts": ts, "te": te, "a": a, "b": b, "rp": rp, "kids": kids,
                "el": [(x, y) for (x, y, nm) in kids if nm == name]}
    
    
    def w_design(win, s, ref):
        if len(s["el"]) > 1:
            return None
        if s["el"]:
            x, y = s["el"][0]
            tag = start_tag(win[x:y])
            new = merged(tag, ((b"ref", ref),))
            el = new if tag.endswith(b"/>") else new + b"</" + qname(tag) + b">"
            return win[:x] + el + win[y:]
        at = first_insert(s["kids"], TABLE.index("autoFilter"), s["b"])
        return win[:at] + b"<" + s["rp"] + b'autoFilter ref="' + ref + b'"/>' + win[at:]
    
    
    def name_elements_of(wb, s):
        """[(start, end, ElementTree element)] of the main <definedName> children of
        the first main <definedNames>, by byte spans paired in order with the
        elements of the whole part's ElementTree; and the container's content
        span; [] and None when there is none, or when the two readers disagree
        on the count (then nothing is paired and the checks fail)."""
        if not s["el"]:
            return [], None
        x, y = s["el"][0]
        raw = wb[x:y]
        p = split_name(qname(raw))[0]
        ca, cb = content_span(wb, x, y)
        spans = [(kx, ky) for (kx, ky, nm) in children(wb, ca, cb, p, True) if nm == "definedName"]
        dn = et_first(ET.fromstring(wb), "definedNames")
        els = [] if dn is None else [el for el in dn if local(el.tag)[0] in MAIN and local(el.tag)[1] == "definedName"]
        if len(els) != len(spans):
            return [], (ca, cb)
        return [(kx, ky, el) for ((kx, ky), el) in zip(spans, els)], (ca, cb)
    
    
    def dropped(el, index):
        return (el.get("name", "").lower() in [n.lower() for n in NAMES]
                and el.get("localSheetId") == str(index))
    
    
    def three(rp, index, texts):
        out = []
        for (name, text) in zip(NAMES, texts):
            hidden = b' hidden="1"' if name == NAMES[2] else b""
            out.append(b"<" + rp + b'definedName name="' + name.encode() + b'" localSheetId="'
                       + str(index).encode() + b'"' + hidden + b">" + escaped(text) + b"</" + rp + b"definedName>")
        return out
    
    
    def plant(flag, wout, wbout, others, st):
        """(wout, wbout, others) changed so that `flag` turns to no, or None when
        the pair gives the plant nothing to change."""
        s = shape(wout, st["root_ns"], "autoFilter")
        sb = shape(wbout, st["book_ns"], "definedNames")
        o = dict(others)
        if len(s["el"]) != 1 or len(sb["el"]) != 1:
            return None
        ax, ay = s["el"][0]
        atag = start_tag(wout[ax:ay])
        names, content = name_elements_of(wbout, sb)
        if content is None:
            return None
        nca, ncb = content
        if flag == "rest_same":
            return wout[:s["te"]] + COMMENT + wout[s["te"]:], wbout, o
        if flag == "places":
            other = [(x, y) for (x, y, nm) in s["kids"] if nm not in (None, "autoFilter")]
            if not other:
                return None
            x, y = other[0]
            return wout[:y] + wout[x:y] + wout[y:], wbout, o
        if flag == "schema_order":
            el = wout[ax:ay]
            rest = wout[:ax] + wout[ay:]
            end = rest.rfind(b"</")
            return rest[:end] + el + rest[end:], wbout, o
        if flag == "af_tag":
            end = len(atag) - (2 if atag.endswith(b"/>") else 1)
            new = atag[:end] + b' planted="1"' + atag[end:]
            return wout[:ax] + new + wout[ax + len(atag):], wbout, o
        if flag == "af_empty":
            p = split_name(qname(atag))[0]
            kid = b"<" + p + b'filterColumn colId="0"/>'
            if atag.endswith(b"/>"):
                el = opened(atag) + kid + b"</" + qname(atag) + b">"
                return wout[:ax] + el + wout[ay:], wbout, o
            end = wout.rfind(b"</", ax, ay)
            return wout[:end] + kid + wout[end:], wbout, o
        if flag == "w_bytes":
            return wout + b"\n", wbout, o
        if flag == "wb_rest":
            return wout, wbout[:sb["te"]] + COMMENT + wbout[sb["te"]:], o
        if flag == "names_place":
            x, y = sb["el"][0]
            el = wbout[x:y]
            rest = wbout[:x] + wbout[y:]
            sheets = re.search(rb"<(?:[^\s/>:]+:)?sheets[\s/>]", rest)
            if not sheets:
                return None
            return wout, rest[:sheets.start()] + el + rest[sheets.start():], o
        if flag == "names_prefix":
            rp = sb["rp"]
            planted = b"<" + rp + b'definedName name="planted">1</' + rp + b"definedName>"
            return wout, wbout[:nca] + planted + wbout[nca:], o
        if flag == "names_three":
            if len(names) < 3:
                return None
            x, y, _ = names[-2]
            el = wbout[x:y]
            new = el.replace(b"!$1:$1<", b"!$2:$2<", 1)
            return (wout, wbout[:x] + new + wbout[y:], o) if new != el else None
        if flag == "names_bytes":
            if len(names) < 3:
                return None
            x, y, _ = names[-3]
            el = wbout[x:y]
            new = el.replace(b' localSheetId="', b'  localSheetId="', 1)
            return (wout, wbout[:x] + new + wbout[y:], o) if new != el else None
        if flag == "others_same":
            name = next(iter(o), None)
            if name is None:
                return None
            o[name] = o[name] + COMMENT
            return wout, wbout, o
        if flag == "read_back":
            if not names:
                return None
            x, y, _ = names[-1]
            return wout, wbout[:y] + wbout[x:y] + wbout[y:], o
        if flag in ("xml_values", "flagged"):
            return wout, wbout, o
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        found = w_of(zin, wb)
        if found is None or found[0] not in zin.namelist():
            print("error=no-worksheet")
            return
        part, index, wname = found
        if args[1:] == ["--parts"]:
            print(part)
            print(bit3(zin, part))
            print(wb)
            print(bit3(zin, wb))
