## the survey of the corpus before the run (change ND)
command: cp <scripts>/pasurvey.py <work>/pasurvey.py; sed 's/^/    /' <work>/pasurvey.py; sha256 0cefdbe85dd0a731c9b67439700cb7eefb3abe3124982ae10d733a77f9502f9b, 8559 bytes
  the copy is the file beside this script, byte for byte: yes
    """The run log's survey of the corpus before the print area sample's run
    (specs/0025-sheet-and-print-settings.md, "Harness runs", P3, and "Planning
    rulings during P3"; specs/0024 P1 verification ruling 6's form: names, ids
    and counts only, the corpus directory a parameter).
    
    Usage: pasurvey.py <corpus>
    
    Lists <corpus>/corpus (every regular file, no extension glob) and reads each
    workbook the manifest <corpus>/manifest.tsv names, in manifest order: the
    workbook part through the package relationships, W the first <sheet> in
    <sheets> order whose relationship is a worksheet's (zipfile and ElementTree),
    and W's part read with expat WITHOUT namespace processing, each element's
    namespace resolved here from the declarations in scope: a reader of another
    lineage than the run log's comparison (byte spans) and the tool (the crate's
    token stream).
    
    Prints, tab-separated, one line per workbook:
      wb <id> <class> <M> <af> <builtins> <names> <tables> <overlap> <chain> <r bound>
    where <class> is "bare" when W's sheet name is written bare in a formula by
    ruling 6 of "Planning rulings during P3" (it starts with a letter or _,
    holds only letters, digits, _ and ., and names no cell: an A1 reference on
    the grid, ignoring case, or the R1C1 form) and "quoted" otherwise; <M> W's
    largest row number among its main <c> elements (a cell's r, else its row's
    r), 0 for none; <af> W's main <autoFilter> root children; <builtins> the
    workbook's definedName elements named _xlnm.Print_Area, _xlnm.Print_Titles
    or _xlnm._FilterDatabase (ignoring case) whose localSheetId is W's index in
    <sheets>; <names> the workbook's main definedName elements in its first
    <definedNames>; <tables> W's table relationships; <overlap> 1 when a table
    part's root ref overlaps A1:H(M + 1), the print area sample's area, so the
    layer refuses the sample (a finding); <chain> 1 when xl/calcChain.xml is an
    entry; <r bound> 1 when W's root binds a prefix to the relationships
    namespace. Then one line
      files <regular files in corpus/> <manifest rows> <rows read>
    No name, value, text, reference or part name is printed: the class is a
    word, the rest are counts.
    """
    import os
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    from xml.parsers import expat
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    BUILTINS = ("_xlnm.print_area", "_xlnm.print_titles", "_xlnm._filterdatabase")
    CELL = re.compile(r"^([A-Z]+)([1-9][0-9]*)$")
    R1C1 = re.compile(r"^[Rr][0-9]*[Cc][0-9]*$")
    
    
    def rels(z, part):
        d, base = posixpath.split(part)
        name = posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            if el.get("TargetMode") == "External":
                continue
            t = el.get("Target", "")
            out.append((el.get("Id"), el.get("Type", ""),
                        t[1:] if t.startswith("/") else posixpath.normpath(posixpath.join(d, t))))
        return out
    
    
    def ascii_upper(s):
        return "".join(c.upper() if "a" <= c <= "z" else c for c in s)
    
    
    def names_a_cell(name):
        m = CELL.match(ascii_upper(name))
        if m:
            col = 0
            for ch in m.group(1):
                col = col * 26 + ord(ch) - 64
            if 1 <= col <= 16384 and 1 <= int(m.group(2)) <= 1048576:
                return True
        return bool(R1C1.match(name))
    
    
    def bare(name):
        return (bool(name) and (name[0].isalpha() or name[0] == "_")
                and all(c.isalnum() or c in "_." for c in name) and not names_a_cell(name))
    
    
    def w_of(z):
        """(W's part, W's index in <sheets>, W's name, the workbook root), or None."""
        wb = [t for (_, ty, t) in rels(z, "") if ty.endswith("/officeDocument")][0]
        by_id = {i: (ty, t) for (i, ty, t) in rels(z, wb)}
        root = ET.fromstring(z.read(wb))
        k = 0
        for el in root.iter():
            if el.tag in ["{%s}sheet" % m for m in MAIN]:
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, t = by_id.get(rid, ("", None))
                if ty in [a + "/worksheet" for a in ATTR]:
                    return t, k, el.get("name", ""), root
                k += 1
        return None
    
    
    def area(ref):
        """(first row, first col, last row, last col) of an A1 area, or None."""
        parts = ref.split(":")
        cells = []
        for p in parts:
            m = CELL.match(p.replace("$", ""))
            if not m:
                return None
            col = 0
            for ch in m.group(1):
                col = col * 26 + ord(ch) - 64
            cells.append((int(m.group(2)), col))
        if len(cells) == 1:
            cells.append(cells[0])
        if len(cells) != 2:
            return None
        (r1, c1), (r2, c2) = cells
        return min(r1, r2), min(c1, c2), max(r1, r2), max(c1, c2)
    
    
    def survey_w(data):
        st = {"depth": 0, "scopes": [], "rows": [], "max": 0, "af": 0, "r_bound": 0}
    
        def start(name, attrs):
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(st["scopes"][-1]) if st["scopes"] else {}
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            st["scopes"].append(scope)
            st["depth"] += 1
            prefix, _, loc = name.rpartition(":")
            main = scope.get(prefix) in MAIN
            d = dict(pairs)
            if st["depth"] == 1:
                st["r_bound"] = 1 if any(k.startswith("xmlns:") and v in ATTR for (k, v) in pairs) else 0
            elif st["depth"] == 2 and main and loc == "autoFilter":
                st["af"] += 1
            if main and loc == "row":
                st["rows"].append(d.get("r"))
            if main and loc == "c":
                r = d.get("r")
                m = CELL.match(r) if r else None
                row = int(m.group(2)) if m else (int(st["rows"][-1]) if st["rows"] and st["rows"][-1] else 0)
                st["max"] = max(st["max"], row)
    
        def end(name):
            st["depth"] -= 1
            st["scopes"].pop()
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.Parse(data, True)
        return st
    
    
    def main():
        corpus = sys.argv[1]
        lines = open(os.path.join(corpus, "manifest.tsv"), encoding="utf-8").read().split("\n")
        head = lines[0].split("\t")
        rows = [l.split("\t") for l in lines[1:] if l]
        files = sorted(f for f in os.listdir(os.path.join(corpus, "corpus"))
                       if os.path.isfile(os.path.join(corpus, "corpus", f)))
        read = 0
        for row in rows:
            cid, ext = row[head.index("id")], row[head.index("ext")]
            name = "%s.%s" % (cid, ext)
            if name not in files:
                print("wb\t%s\tmissing" % cid)
                continue
            z = zipfile.ZipFile(os.path.join(corpus, "corpus", name))
            found = w_of(z)
            if found is None:
                print("wb\t%s\tno-worksheet" % cid)
                continue
            part, index, wname, root = found
            st = survey_w(z.read(part))
            names = builtins = 0
            containers = [el for el in root if el.tag in ["{%s}definedNames" % m for m in MAIN]]
            if containers:
                for el in containers[0]:
                    if el.tag in ["{%s}definedName" % m for m in MAIN]:
                        names += 1
                        if el.get("name", "").lower() in BUILTINS and el.get("localSheetId") == str(index):
                            builtins += 1
            want = (1, 1, st["max"] + 1, 8)
            tables = overlap = 0
            for (_, ty, t) in rels(z, part):
                if ty in [a + "/table" for a in ATTR]:
                    tables += 1
                    ref = ET.fromstring(z.read(t)).get("ref", "") if t in z.namelist() else ""
                    a = area(ref)
                    if a is None or (a[0] <= want[2] and want[0] <= a[2] and a[1] <= want[3] and want[1] <= a[3]):
                        overlap = 1
            chain = 1 if "xl/calcChain.xml" in z.namelist() else 0
            read += 1
            print("\t".join(["wb", cid, "bare" if bare(wname) else "quoted"]
                            + [str(v) for v in (st["max"], st["af"], builtins, names, tables, overlap, chain,
                                                st["r_bound"])]))
        print("files\t%d\t%d\t%d" % (len(files), len(rows), read))
    
    
    main()
