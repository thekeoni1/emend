        names_in_order = zin.namelist()
        win = zin.read(part)
        wbin = zin.read(wb)
        root_i = ET.fromstring(win)
        book_i = ET.fromstring(wbin)
        root_ns = local(root_i.tag)[0]
        book_ns = local(book_i.tag)[0]
        zout = zipfile.ZipFile(args[1])
        rest = args[2:]
        diff_path = flag_plant = None
        while rest:
            if rest[0] == "--diff" and len(rest) >= 2:
                diff_path, rest = rest[1], rest[2:]
            elif rest[0] == "--plant" and len(rest) >= 2:
                flag_plant, rest = rest[1], rest[2:]
                if flag_plant not in FLAGS:
                    print("error=unknown-plant")
                    return
            else:
                print("error=usage")
                return
        out_names = zout.namelist()
        wout = zout.read(part) if part in out_names else b""
        wbout = zout.read(wb) if wb in out_names else b""
        others = {nm: zout.read(nm) for nm in out_names if nm not in (part, wb)}
    
        m = max_row(root_i)
        ref = ("A1:H%d" % (m + 1)).encode()
        area_text = "%s!$A$1:$H$%d" % (in_formula(wname), m + 1)
        texts = (area_text, "%s!$1:$1" % in_formula(wname), area_text)
        s_in = shape(win, root_ns, "autoFilter")
        want = w_design(win, s_in, ref)
        if want is None:
            print("error=out-of-design")
            return
        sb_in = shape(wbin, book_ns, "definedNames")
        st = {"root_ns": root_ns, "book_ns": book_ns}
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, wout, wbout, others, st)
            if changed is not None:
                wout, wbout, others = changed
                planted = True
        extra = flag_plant if planted else None
    
        flags = dict.fromkeys(FLAGS, False)
        created_af = 0 if s_in["el"] else 1
        created_names = 0 if sb_in["el"] else 1
        names_in, _ = name_elements_of(wbin, sb_in)
        kept_in = [wbin[x:y] for (x, y, el) in names_in if not dropped(el, index)]
        want_three = three(sb_in["rp"], index, texts)
        names_out_n = -1
        if wout:
            s_out = shape(wout, root_ns, "autoFilter")
            flags["rest_same"] = cut(win, s_in["el"]) == cut(wout, s_out["el"])
            want_places = [nm for (_, _, nm) in s_in["kids"] if nm is not None]
            if created_af:
                idx = TABLE.index("autoFilter")
                at = next((i for (i, nm) in enumerate(want_places) if nm in TABLE and TABLE.index(nm) > idx),
                          len(want_places))
                want_places.insert(at, "autoFilter")
            locals_out = [nm for (_, _, nm) in s_out["kids"] if nm is not None]
            flags["places"] = locals_out == want_places
            pos = [TABLE.index(nm) for nm in locals_out if nm in TABLE]
            flags["schema_order"] = pos == sorted(pos) and locals_out.count("autoFilter") == 1
            if len(s_out["el"]) == 1 and len(want) > 0:
                ws = shape(want, root_ns, "autoFilter")
                ox, oy = s_out["el"][0]
                wx, wy = ws["el"][0]
                flags["af_tag"] = start_tag(wout[ox:oy]) == start_tag(want[wx:wy])
            flags["w_bytes"] = wout == want
        if wbout:
            sb_out = shape(wbout, book_ns, "definedNames")
            flags["wb_rest"] = cut(wbin, sb_in["el"]) == cut(wbout, sb_out["el"])
            want_book = [nm for (_, _, nm) in sb_in["kids"] if nm is not None]
            if created_names:
                idx = BOOK.index("definedNames")
                at = next((i for (i, nm) in enumerate(want_book) if nm in BOOK and BOOK.index(nm) > idx),
                          len(want_book))
                want_book.insert(at, "definedNames")
            book_out = [nm for (_, _, nm) in sb_out["kids"] if nm is not None]
            bpos = [BOOK.index(nm) for nm in book_out if nm in BOOK]
            flags["names_place"] = (book_out == want_book and bpos == sorted(bpos)
                                    and book_out.count("definedNames") == 1)
            if len(sb_out["el"]) == 1:
                names_out, _ = name_elements_of(wbout, sb_out)
                names_out_n = len(names_out)
                raw_out = [wbout[x:y] for (x, y, _) in names_out]
                flags["names_prefix"] = len(raw_out) >= 3 and raw_out[:-3] == kept_in
                if len(names_out) >= 3:
                    last = [el for (_, _, el) in names_out[-3:]]
                    flags["names_three"] = all(
                        el.get("name") == n and el.get("localSheetId") == str(index)
                        and el.get("hidden") == ("1" if n == NAMES[2] else None)
                        and (el.text or "") == t and len(list(el)) == 0
                        for (el, n, t) in zip(last, NAMES, texts))
                    flags["names_bytes"] = raw_out[-3:] == want_three
        try:
            root_o = ET.fromstring(wout) if wout else None
            book_o = ET.fromstring(wbout) if wbout else None
        except ET.ParseError:
            root_o = book_o = None
        af_out = -1
        if root_o is not None:
            af_out = et_count(root_o, "autoFilter")
            af = et_first(root_o, "autoFilter")
            flags["af_empty"] = af is not None and len(list(af)) == 0 and af.get("ref") == ref.decode()
        if root_o is not None and book_o is not None:
            dn = et_first(book_o, "definedNames")
            mine = [] if dn is None else [el for el in dn if local(el.tag)[0] in MAIN and local(el.tag)[1] == "definedName"
                                          and el.get("localSheetId") == str(index)]
            flags["read_back"] = af_out == 1 and all(sum(1 for el in mine if el.get("name") == n) == 1 for n in NAMES)
        flags["others_same"] = (list(others) == [nm for nm in names_in_order if nm not in (part, wb)]
                                and out_names == names_in_order
                                and all(others[nm] == zin.read(nm) for nm in others))
    
        in_only = out_only = want_in = want_out = flagged_rows = want_flagged = -1
        side_w_in = values_of(root_i)
        side_w_want = values_of(ET.fromstring(want))
        side_b_in = values_of(book_i)
        side_b_want = collections.Counter(side_b_in)
        for (_, _, el) in names_in:
            if dropped(el, index):
                for key, n in values_of(el).items():
                    side_b_want[key] -= n
        ns = local(book_i.tag)[0]
        for (n, t) in zip(NAMES, texts):
            tag = "{%s}definedName" % ns if ns else "definedName"
            side_b_want[("a", tag, "name", n)] += 1
            side_b_want[("a", tag, "localSheetId", str(index))] += 1
            if n == NAMES[2]:
                side_b_want[("a", tag, "hidden", "1")] += 1
            side_b_want[("t", tag, t)] += 1
        side_b_want = +side_b_want
        want_in = sum((side_w_in - side_w_want).values()) + sum((side_b_in - side_b_want).values())
        want_out = sum((side_w_want - side_w_in).values()) + sum((side_b_want - side_b_in).values())
        if extra == "xml_values":
            want_out += 1
        if diff_path is not None:
            rows = [l.split("\t") for l in open(diff_path, encoding="utf-8").read().split("\n") if l]
            values = {c[1]: c for c in rows if len(c) >= 7 and c[0] == "xml" and c[2] == "values"}
            if set(values) == {part, wb}:
                in_only = sum(int(values[p][5]) for p in (part, wb))
                out_only = sum(int(values[p][6]) for p in (part, wb))
            flags["xml_values"] = (set(values) == {part, wb} and in_only == want_in and out_only == want_out)
            ents = [{"name": c[1], "status": c[2], "flags": c[16]} for c in rows
                    if len(c) == 17 and c[0] == "entry"]
            flagged_rows = sum(1 for r in ents if r["flags"])
            wanted = {p: ("descriptor" if bit3(zin, p) == "1" else "") for p in (part, wb)}
            if extra == "flagged":
                wanted = {nm: ("" if f else "descriptor") for (nm, f) in wanted.items()}
            want_flagged = sum(1 for f in wanted.values() if f)
            flags["flagged"] = (len(ents) > 0 and flagged_rows == want_flagged
                                and all(r["flags"] == wanted.get(r["name"], "") for r in ents))
    
        tag_in = win[s_in["ts"]:s_in["te"]]
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted), "created_af=%d" % created_af,
             "created_names=%d" % created_names, "bare=%d" % (1 if in_formula(wname) == wname else 0),
             "prefixed=%d" % (1 if s_in["rp"] else 0),
             "af_in=%d" % len(s_in["el"]), "af_out=%d" % af_out,
             "names_in=%d" % len(names_in), "names_out=%d" % names_out_n,
             "builtins_in=%d" % sum(1 for (_, _, el) in names_in if dropped(el, index)),
