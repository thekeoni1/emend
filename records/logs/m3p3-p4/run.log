    """This log's entries check (change OE). Modes:
      --w <input>: W's part, the first worksheet in <sheets> order, and the
         workbook part, found through the package's and the workbook's
         relationships; one line each.
      --chain <input>: 1 when the input holds xl/calcChain.xml, else 0.
      --check <input> <entries.tsv> <id> <sample>: the runner's rows for one
         workbook against the rule: W changed, and for printarea the workbook
         part too; a changed row flagged descriptor exactly when the input's
         entry sets bit 3, else unflagged; every other row identical and
         unflagged. Prints "rule=yes|no rows=N changed=N flagged=N
         chain_rows=N chain_identical=N".
    Names only are read; no text is printed."""
    import posixpath
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    
    
    def target(base, t):
        return t.lstrip("/") if t.startswith("/") else posixpath.normpath(posixpath.join(base, t))
    
    
    def parts(path):
        z = zipfile.ZipFile(path)
        wb = None
        for r in ET.fromstring(z.read("_rels/.rels")):
            if r.get("Type", "").endswith("/officeDocument"):
                wb = target("", r.get("Target"))
        base = posixpath.dirname(wb)
        rels = posixpath.join(base, "_rels", posixpath.basename(wb) + ".rels")
        rr = {r.get("Id"): (r.get("Type", ""), r.get("Target")) for r in ET.fromstring(z.read(rels))}
        for el in ET.fromstring(z.read(wb)).iter():
            if el.tag.rsplit("}", 1)[-1] != "sheet":
                continue
            rid = [v for k, v in el.attrib.items() if k.rsplit("}", 1)[-1] == "id" and k.startswith("{")]
            if rid and rr.get(rid[0], ("", ""))[0].endswith("/worksheet"):
                return z, target(base, rr[rid[0]][1]), wb
        return z, None, wb
    
    
    mode = sys.argv[1]
    if mode == "--w":
        _, w, wb = parts(sys.argv[2])
        print(w)
        print(wb)
    elif mode == "--chain":
        print(1 if "xl/calcChain.xml" in zipfile.ZipFile(sys.argv[2]).namelist() else 0)
    elif mode == "--check":
        path, entries, wid, sample = sys.argv[2:6]
        z, w, wb = parts(path)
        bit3 = {i.filename: bool(i.flag_bits & 0x8) for i in z.infolist()}
        want = {w} | ({wb} if sample == "printarea" else set())
        lines = open(entries, encoding="utf-8").read().split("\n")
        head = lines[0].split("\t")
        ok, rows, changed, flagged, chain_rows, chain_same = True, 0, 0, 0, 0, 0
        for line in lines[1:]:
            if not line:
                continue
            r = dict(zip(head, line.split("\t")))
            if r["id"] != wid:
                continue
            rows += 1
            flags = r["flags"]
            if r["name"] == "xl/calcChain.xml":
                chain_rows += 1
                chain_same += 1 if r["status"] == "identical" and flags == "" else 0
            if r["row"] != "entry":
                ok = False
            elif r["name"] in want:
                changed += 1 if r["status"] == "changed" else 0
                flagged += 1 if flags else 0
                if r["status"] != "changed" or flags != ("descriptor" if bit3.get(r["name"]) else ""):
                    ok = False
            elif r["status"] != "identical" or flags != "":
                ok = False
        if rows != len(z.namelist()) or changed != len(want):
            ok = False
        print("rule=%s rows=%d changed=%d flagged=%d chain_rows=%d chain_identical=%d"
              % ("yes" if ok else "no", rows, changed, flagged, chain_rows, chain_same))
