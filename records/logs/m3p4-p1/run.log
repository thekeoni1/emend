    """The run log's own group comparison (specs/0026-grouping-and-line-
    styles.md, "Harness runs", --group-sample, P1, with "Planning rulings during
    P1" rulings 1 to 6).
    
    Usage: gpcmp.py <input archive> <output archive> [--diff <diff.tsv>] [--plant <flag>]
           gpcmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool; its readers are M3 part 3 P3's pacmp.py's,
    copied (local, rels_of, workbook_of, top_level, qname, split_name,
    start_tag, opened, attributes, root_span, is_main, children, content_span,
    rels_prefix_of, bit3, cut, first_insert, et_first, values_of). It finds W,
    the first <sheet> in <sheets> order whose relationship type is a
    worksheet's; M, W's largest row number among its main <c> elements (a
    cell's r, else its row's r), 0 for none. From the input it builds the W the
    design gives (specs/0026 "The calls", rulings 1 to 6; specs/0018's row
    creation and <col> split; specs/0025's settings pass):
    
      rows M + 1 and M + 2 carry hidden="1" then outlineLevel="1", row M + 3
      collapsed="1", each attribute replaced between its quotes when the row's
      start tag has it, else appended after the last attribute; a present row
      keeps every other byte (ruling 6); an absent one is created as
      <row r="N" .../> with the <sheetData>'s prefix, before the first row
      numbered higher, else before </sheetData>;
      columns 2 and 3 in <cols>: each covering <col> split so the column alone
      carries the edit (min and max replaced in place, the other pieces keeping
      every attribute), hidden removed with the whitespace before it,
      outlineLevel="1" replaced or appended, an uncovered column given
      <col min="c" max="c" outlineLevel="1"/> with the <cols>' prefix; then the
      pieces the split produced and the created elements merged with the one
      before them when it ends at the column before and the two are the same
      bytes with min and max set aside, content too; an element the edit did
      not touch kept as it is and never merged (ruling 2); <cols> created
      before the first main root child the 39-name table puts after it when W
      has none;
      <sheetFormatPr>: outlineLevelRow and outlineLevelCol each set to 1 when
      the first main one's value is not a whole number 1 to 255 (a value that is
      not a whole number 0 to 255 counts as 0, ruling 4), the set attributes
      written first in that order and every other attribute after them as
      written, in its order, one space before each; else the element as it is;
      created as <sheetFormatPr defaultRowHeight="15" outlineLevelRow="1"
      outlineLevelCol="1"/> with the root's prefix in its table place when W has
      none (ruling 5);
      <sheetPr>: summaryBelow="0" merged first into its first main <outlinePr>
      child, or <outlinePr summaryBelow="0"/> with <sheetPr>'s prefix created
      before its first main child that 18.3.1.82 puts after it (pageSetUpPr),
      else at the end of its content; an empty <sheetPr/> opened; created as
      <sheetPr><outlinePr summaryBelow="0"/></sheetPr> with the root's prefix
      before the first main root child when W has none.
    
    It compares:
    
      rest_same    W with every main <sheetPr>, <sheetFormatPr>, <cols> and
                   <sheetData> cut out is the input's W with its own cut out,
                   byte for byte
      places       W's main root children's names are the input's with a
                   created <sheetPr>, <sheetFormatPr> or <cols> where the table
                   puts it
      schema_order W's main root children are in the table's order, one each of
                   the four
      rows_kept    <sheetData> with the rows numbered M + 1 to M + 3 cut out is
                   the input's with its own rows of those numbers cut out, byte
                   for byte (every other <row> byte-identical, in place)
      rows_window  the output's rows numbered M + 1 to M + 3 are the design's,
                   byte for byte, in order: present ones edited in place, absent
                   ones created (ruling 6)
      rows_attrs   read with ElementTree, each of those rows carries exactly the
                   input row's attributes (r alone for one the input lacks) with
                   the sample's set, and a created row has no child
      cols_other   the output's <col> elements outside the span the edit covers
                   (columns 2 and 3 and every input <col> covering either) are
                   the input's outside it, byte for byte, in order
      cols_group   read with ElementTree, the output's <col> elements inside
                   that span cover it exactly, in order, without overlap; those
                   carrying outlineLevel="1" cover exactly columns 2 and 3, one
                   element or two as the input's attributes for the two columns
                   agree or not, none hidden; every piece outside 2 and 3 keeps
                   its source's attributes but min and max, every element over 2
                   or 3 its source's but min, max, outlineLevel and hidden
      cols_bytes   the output's <cols> is the design's, byte for byte
      format_rest  <sheetFormatPr>'s attributes other than the two maximums are
                   the input's, byte for byte, in order (defaultRowHeight="15"
                   alone for a created one)
      maximums     read with ElementTree, outlineLevelRow and outlineLevelCol
                   are the input's when 1 or more, else 1
      sheetpr_rest <sheetPr> with its <outlinePr> cut out is the input's with
                   its own cut out (opened when it was empty), byte for byte
      outline_pr   read with ElementTree, one main <outlinePr> under <sheetPr>,
                   summaryBelow="0", its other attributes the input's, and
                   <sheetPr>'s main children in 18.3.1.82's order
      w_bytes      W is exactly the W the design gives
      others_same  every entry but W is the input's, byte for byte, the names
                   the input's in the input's order
      read_back    read with ElementTree, the tool's figures: two rows carry
                   outlineLevel="1", M + 1 and M + 2, both hidden="1"; one row
                   carries collapsed="1", M + 3; the two maximums 1 or more;
                   summaryBelow="0"
      xml_values   with --diff, the runner's diff.<label>.tsv for the pair: its
                   xml "values" row is W's alone, and its in_only and out_only
                   are the one-sided counts of the input's values against the
                   design's, each value keyed as xlsx-diff keys one (specs/0024
                   P1 verification ruling 6); without --diff, no
      flagged      with --diff, the diff's entry row for W carries the flag
                   descriptor exactly when the input's local header sets general
                   purpose bit 3, and no other row is flagged; without --diff, no
    
    It prints ONE line of counts and yes/no flags and no text, reference, sheet
    name or part name: the line's counts beside the tool's (rows, present rows,
    cols, level_cols, kept_cols), the shapes (created_sheetpr, created_format,
    created_cols, created_rows, edited_rows), hidden_cols (input <col> elements
    covering column 2 or 3 that carry hidden="1", which the group removes,
    ruling 3) and hidden_any_cols (those carrying a hidden attribute of any
    value, which the write drops whatever its value). --parts prints W's part name and 1, 0 or - for its bit 3, one per
    line, for the log to compare with the runner's rows without printing them.
    --plant <flag> changes the output as read so that the named flag turns to
    no; the line then says planted=yes, or planted=no when the pair gives the
    plant nothing to change.
    """
    import collections
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    # ECMA-376 Part 1, 18.3.1.99, the worksheet root's children in order: this
    # program's own copy (specs/0018, "Creating an element"), not the crate's.
    TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    assert len(TABLE) == 39
    # <sheetPr>'s children in order (ECMA-376 Part 1, 18.3.1.82).
    PR_KIDS = ("tabColor", "outlinePr", "pageSetUpPr")
    FOUR = ("sheetPr", "sheetFormatPr", "cols", "sheetData")
    WINDOW_SETS = ((b"hidden", b"1"), (b"outlineLevel", b"1"))
    COLLAPSED_SETS = ((b"collapsed", b"1"),)
    
    FLAGS = ("rest_same", "places", "schema_order", "rows_kept", "rows_window", "rows_attrs",
             "cols_other", "cols_group", "cols_bytes", "format_rest", "maximums", "sheetpr_rest",
             "outline_pr", "w_bytes", "others_same", "read_back", "xml_values", "flagged")
    
    COMMENT = b"<!-- planted -->"
    CELL = re.compile(r"^([A-Z]+)([1-9][0-9]*)$")
    # Rust's str::parse::<u8>: an optional plus sign, then decimal digits.
    U8 = re.compile(r"^\+?[0-9]+$")
    
    
    class OutOfDesign(Exception):
        """The input is one the write refuses or this comparison does not model."""
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def w_of(z, workbook):
        """W's part, or None: the first main <sheet> whose relationship is a
        worksheet's."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty in (ATTR[0] + "/worksheet", ATTR[1] + "/worksheet"):
                    return target
        return None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTRS_RE = re.compile(rb'\s([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')')
    
    
    def attributes(tag):
        """[(name, bytes from the name to the closing quote)] of a start tag, in
        order, namespace declarations among them."""
        return [(m.group(1), tag[m.start(1):m.end()]) for m in ATTRS_RE.finditer(tag)]
    
    
    def attr_matches(tag):
        return list(ATTRS_RE.finditer(tag))
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def is_main(raw, parent_prefix, parent_main):
        """Whether an element whose bytes start `raw` is in the main namespace:
        its own declaration of its prefix, else its parent's when the prefix is
        the parent's."""
        p, _ = split_name(qname(raw))
        tag = start_tag(raw)
        decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
        own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
        if own:
            return own.group(1)[1:-1].decode() in MAIN
        return p == parent_prefix and parent_main
    
    
    def children(data, a, b, rp, parent_main):
        """[(start, end, main local name or None)] of the elements in data[a:b]."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            n = split_name(qname(raw))[1]
            out.append((a + x, a + y, n if is_main(raw, rp, parent_main) else None))
        return out
    
    
    def content_span(data, x, y):
        """(start, end) of an element's content, equal for an empty tag."""
        raw = data[x:y]
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return x + len(tag), x + len(tag)
        return x + len(tag), x + raw.rfind(b"</")
    
    
    def rels_prefix_of(tag):
        """The prefix a start tag binds to the relationships namespace, or None."""
        for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            if m.group(2)[1:-1].decode() in ATTR:
                return m.group(1)
        return None
    
    
    def bit3(zin, name):
        """1 or 0 for whether the input's entry sets general purpose bit 3, -
        when there is no such entry."""
        try:
            return "1" if zin.getinfo(name).flag_bits & 0x08 else "0"
        except KeyError:
            return "-"
    
    
    def cut(data, spans):
        """data with the spans cut out."""
        out, at = [], 0
        for (x, y) in sorted(spans):
            out.append(data[at:x])
            at = y
        out.append(data[at:])
        return b"".join(out)
    
    
    def first_insert(kids, after, root_end):
        """The offset before the first main root child the table puts after the
        position `after`, or the root's end."""
        for (x, _, nm) in kids:
            if nm in TABLE and TABLE.index(nm) > after:
                return x
        return root_end
    
    
    def et_first(root, name):
        for el in root:
            ns, nm = local(el.tag)
            if ns in MAIN and nm == name:
                return el
        return None
    
    
    def values_of(root):
        """The values of an ElementTree as xlsx-diff keys them: each attribute
        (namespace declarations are not attributes here) by element, attribute
        and value; each text node that is not whitespace alone by its element
        and its text (a node's element is the one it stands in: an element's
        text is its own, its tail its parent's)."""
        vals = collections.Counter()
        ws = " \t\n\r"
    
        def walk(el):
            for (k, v) in el.attrib.items():
                vals[("a", el.tag, k, v)] += 1
            if el.text and el.text.strip(ws):
                vals[("t", el.tag, el.text)] += 1
            for c in el:
                walk(c)
                if c.tail and c.tail.strip(ws):
                    vals[("t", el.tag, c.tail)] += 1
    
        walk(root)
        return vals
    
    
    # --- the crate's start-tag edits, written here from their specs (specs/0018
    # "Module package: the calls", specs/0025 "The pass") ---
    
    def name_end(tag):
        return 1 + len(qname(tag))
    
    
    def with_attribute(tag, name, value):
        """`name` set to `value` between its own quotes when present, else
        appended after the last attribute (after the element's name when there
        is none), one space before it."""
        ms = attr_matches(tag)
        for m in ms:
            if m.group(1) == name:
                return tag[:m.start(2) + 1] + value + tag[m.end(2) - 1:]
        at = ms[-1].end() if ms else name_end(tag)
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def without_attribute(tag, name):
        """`name` and the whitespace before it removed, the tag as it is when
        `name` is absent."""
        for m in attr_matches(tag):
            if m.group(1) == name:
                frm = m.start(1)
                while frm > 0 and tag[frm - 1:frm] in (b" ", b"\t", b"\n", b"\r"):
                    frm -= 1
                return tag[:frm] + tag[m.end():]
        return tag
    
    
    def merged(tag, sets):
        """A start tag with `sets` first, in their order, and every other
        attribute after them as written, in its order, one space before each;
        empty when it was; the tag as it is with nothing to set."""
        if not sets:
            return tag
        names = [n for (n, _) in sets]
        kept = b"".join(b" " + raw for (n, raw) in attributes(tag) if n not in names)
        head = b"".join(b" " + n + b'="' + v + b'"' for (n, v) in sets)
        return tag[:name_end(tag)] + head + kept + (b"/>" if tag.endswith(b"/>") else b">")
    
    
    def attr_value(tag, name):
        for m in attr_matches(tag):
            if m.group(1) == name:
                return m.group(2)[1:-1]
        return None
    
    
    def col_retagged(tag, mn, mx):
        return with_attribute(with_attribute(tag, b"min", str(mn).encode()), b"max", str(mx).encode())
    
    
    def col_edited(tag):
        """A covering <col> piece with the group's edit: hidden removed,
        outlineLevel="1"."""
        return with_attribute(without_attribute(tag, b"hidden"), b"outlineLevel", b"1")
    
    
    def bare_col(tag):
        return all(n in (b"min", b"max") for (n, _) in attributes(tag))
    
    
    def col_span(tag):
        lo, hi = attr_value(tag, b"min"), attr_value(tag, b"max")
        if lo is None or hi is None or not lo.isdigit() or not hi.isdigit():
            raise OutOfDesign("col")
        lo, hi = int(lo), int(hi)
        if lo == 0 or lo > hi:
            raise OutOfDesign("col")
        return lo, hi
    
    
    class ColsOut:
        """The coalescing of ruling 2: pieces and created elements merged with
        the one before them when it ends at the column before and the two are
        the same bytes with min and max set aside, content too."""
    
        def __init__(self):
            self.out = []
            self.open = None
    
        def flush(self):
            if self.open is not None:
                tag, rest, mn, mx, widened = self.open
                self.out.append(col_retagged(tag, mn, mx) if widened else tag)
                self.out.append(rest)
                self.open = None
    
        def kept(self, raw):
            self.flush()
            self.out.append(raw)
    
        def made(self, tag, rest, mn, mx):
            o = self.open
            if (o is not None and o[3] + 1 == mn and o[1] == rest
                    and col_retagged(o[0], 1, 1) == col_retagged(tag, 1, 1)):
                self.open = (o[0], o[1], o[2], mx, True)
                return
            self.flush()
            self.open = (tag, rest, mn, mx, False)
    
        def finish(self):
            self.flush()
            return b"".join(self.out)
    
    
    def cols_content(data, ca, cb, cp, columns):
        """The children of a <cols> (data[ca:cb], prefix cp) with the group's
        edit on `columns`, coalesced."""
        out = ColsOut()
        nxt = 0
        last_max = 0
    
        def created(c):
            return col_edited(col_retagged(b"<" + cp + b"col/>", c, c))
    
        at = ca
        for (x, y, nm) in children(data, ca, cb, cp, True):
            if x > at:
                out.kept(data[at:x])
            at = y
            raw = data[x:y]
            if nm != "col":
                out.kept(raw)
                continue
            start = start_tag(raw)
            rest = raw[len(start):]
            mn, mx = col_span(start)
            if mn <= last_max:
                raise OutOfDesign("cols order")
            last_max = mx
            while nxt < len(columns) and columns[nxt] < mn:
                out.made(created(columns[nxt]), b"", columns[nxt], columns[nxt])
                nxt += 1
            frm = mn
            while nxt < len(columns) and columns[nxt] <= mx:
                c = columns[nxt]
                if c > frm:
                    out.made(col_retagged(start, frm, c - 1), rest, frm, c - 1)
                edited = col_edited(col_retagged(start, c, c))
                if not bare_col(edited):
                    out.made(edited, rest, c, c)
                frm = c + 1
                nxt += 1
            if frm <= mx:
                if frm == mn:
                    out.kept(start)
                    out.kept(rest)
                else:
                    out.made(col_retagged(start, frm, mx), rest, frm, mx)
        if cb > at:
            out.kept(data[at:cb])
        for c in columns[nxt:]:
            out.made(created(c), b"", c, c)
        return out.finish()
    
    
    def u8_of(v):
        """A maximum's value as the write reads it: a whole number 0 to 255, else
        0 (ruling 4)."""
        if v is None:
            return 0
        s = v.decode("utf-8", "replace")
        if U8.match(s) and int(s) <= 255:
            return int(s)
        return 0
    
    
    def max_row(root):
        m = 0
        for row in root.iter():
            ns, nm = local(row.tag)
            if ns in MAIN and nm == "row":
                for c in row:
                    cns, cnm = local(c.tag)
                    if cns in MAIN and cnm == "c":
                        r = c.get("r")
                        mt = CELL.match(r) if r else None
                        m = max(m, int(mt.group(2)) if mt else int(row.get("r") or 0))
        return m
    
    
    def shape(w, root_ns):
        """W's root spans and prefix, its root children, and the spans of each of
        the four root children the group edits."""
        ts, te, a, b, rp = root_span(w)
        kids = children(w, a, b, rp, root_ns in MAIN)
        return {"ts": ts, "te": te, "a": a, "b": b, "rp": rp, "kids": kids,
                "el": {n: [(x, y) for (x, y, nm) in kids if nm == n] for n in FOUR}}
    
    
    def rows_of(w, s):
        """[(start, end, r as int or None, start tag)] of the main <row> children
        of the first main <sheetData>, and its content span and prefix."""
        x, y = s["el"]["sheetData"][0]
        raw = w[x:y]
        dp = split_name(qname(raw))[0]
        ca, cb = content_span(w, x, y)
        out = []
        for (kx, ky, nm) in children(w, ca, cb, dp, True):
            if nm == "row":
                tag = start_tag(w[kx:ky])
                r = attr_value(tag, b"r")
                out.append((kx, ky, int(r) if r is not None and r.isdigit() else None, tag))
        return out, (ca, cb), dp
    
    
    def window_of(m):
        return {m + 1: WINDOW_SETS, m + 2: WINDOW_SETS, m + 3: COLLAPSED_SETS}
    
    
    def design(win, s, m):
        """The W the design gives, its window rows' bytes in order, and its
        <cols>' bytes; OutOfDesign when the write would refuse the input."""
        for n in FOUR:
            if len(s["el"][n]) > 1:
                raise OutOfDesign(n)
        if not s["el"]["sheetData"]:
            raise OutOfDesign("sheetData")
        rp = s["rp"]
        edits = []  # (start, end, order, bytes)
    
        # <sheetPr> and its <outlinePr> (specs/0025 "The pass"; specs/0026).
        set_pr = ((b"summaryBelow", b"0"),)
        if s["el"]["sheetPr"]:
            x, y = s["el"]["sheetPr"][0]
            raw = win[x:y]
            tag = start_tag(raw)
            p = split_name(qname(raw))[0]
            empty = tag.endswith(b"/>")
            pieces = []  # (bytes, main local or None)
            if not empty:
                ca, cb = content_span(win, x, y)
                at = ca
                for (kx, ky, nm) in children(win, ca, cb, p, True):
                    if kx > at:
                        pieces.append((win[at:kx], None))
                    pieces.append((win[kx:ky], nm))
                    at = ky
                if cb > at:
                    pieces.append((win[at:cb], None))
            hit = next((i for (i, (_, nm)) in enumerate(pieces) if nm == "outlinePr"), None)
            if hit is not None:
                b, nm = pieces[hit]
                st = start_tag(b)
                pieces[hit] = (merged(st, set_pr) + b[len(st):], nm)
            else:
                new = merged(b"<" + p + b"outlinePr/>", set_pr)
                rank = PR_KIDS.index("outlinePr")
                pos = next((i for (i, (_, nm)) in enumerate(pieces)
                            if nm in PR_KIDS and PR_KIDS.index(nm) > rank), len(pieces))
                pieces.insert(pos, (new, "outlinePr"))
            head = opened(tag) if empty else tag
            el = head + b"".join(b for (b, _) in pieces) + b"</" + qname(tag) + b">"
            edits.append((x, y, 0, el))
        else:
            at = first_insert(s["kids"], TABLE.index("sheetPr"), s["b"])
            el = (b"<" + rp + b"sheetPr>" + merged(b"<" + rp + b"outlinePr/>", set_pr)
                  + b"</" + rp + b"sheetPr>")
            edits.append((at, at, 0, el))
    
        # <sheetFormatPr>'s maximums (decision 3, rulings 1, 4 and 5).
        names = (b"outlineLevelRow", b"outlineLevelCol")
        if s["el"]["sheetFormatPr"]:
            x, y = s["el"]["sheetFormatPr"][0]
            raw = win[x:y]
            tag = start_tag(raw)
            sets = [(n, b"1") for n in names if 1 > u8_of(attr_value(tag, n))]
            el = merged(tag, sets)
            if not tag.endswith(b"/>"):
                ca, cb = content_span(win, x, y)
                el += win[ca:cb] + b"</" + qname(tag) + b">"
            edits.append((x, y, 1, el))
        else:
            at = first_insert(s["kids"], TABLE.index("sheetFormatPr"), s["b"])
            edits.append((at, at, 1, b"<" + rp + b'sheetFormatPr defaultRowHeight="15" '
                          b'outlineLevelRow="1" outlineLevelCol="1"/>'))
    
        # <cols> (specs/0018's split, ruling 2's coalescing).
        if s["el"]["cols"]:
            x, y = s["el"]["cols"][0]
            raw = win[x:y]
            tag = start_tag(raw)
            cp = split_name(qname(raw))[0]
            ca, cb = content_span(win, x, y)
            content = cols_content(win, ca, cb, cp, [2, 3])
            cols_el = (opened(tag) if tag.endswith(b"/>") else tag) + content + b"</" + qname(tag) + b">"
            edits.append((x, y, 2, cols_el))
        else:
            at = first_insert(s["kids"], TABLE.index("cols"), s["b"])
            cols_el = b"<" + rp + b"cols>" + cols_content(b"", 0, 0, rp, [2, 3]) + b"</" + rp + b"cols>"
            edits.append((at, at, 2, cols_el))
    
        # The rows (specs/0018's row path; ruling 6).
        rows, (ca, cb), dp = rows_of(win, s)
        window = window_of(m)
        win_rows = []
        row_edits = []
        present = {r: (kx, ky, tag) for (kx, ky, r, tag) in rows if r in window}
        for n in sorted(window):
            sets = window[n]
            if n in present:
                kx, ky, tag = present[n]
                new = tag
                for (k, v) in sets:
                    new = with_attribute(new, k, v)
                body = new + win[kx + len(tag):ky]
                row_edits.append((kx, kx + len(tag), new))
            else:
                body = b"<" + dp + b'row r="' + str(n).encode() + b'"'
                for (k, v) in sets:
                    body += b" " + k + b'="' + v + b'"'
                body += b"/>"
                after = next((kx for (kx, _, r, _) in rows if r is not None and r > n), cb)
                row_edits.append((after, after, body))
            win_rows.append(body)
        x, y = s["el"]["sheetData"][0]
        raw = win[x:y]
        tag = start_tag(raw)
        data = win[x:y]
        if tag.endswith(b"/>"):
            data = opened(tag) + b"</" + qname(tag) + b">"
            cb2 = len(opened(tag))
            row_edits = [(cb2, cb2, b) for (_, _, b) in row_edits]
        else:
            row_edits = [(a - x, b - x, v) for (a, b, v) in row_edits]
        edits.append((x, y, 3, apply(data, row_edits)))
        return apply(win, [(a, b, v) for (a, b, _, v) in sorted(edits, key=lambda e: (e[0], e[2]))]), win_rows, cols_el
    
    
    def apply(data, edits):
        """data with each (start, end, bytes) replacing its span, in order; edits
        at one offset keep their order."""
        out, at = [], 0
        for (a, b, v) in edits:
            out.append(data[at:a])
            out.append(v)
            at = b
        out.append(data[at:])
        return b"".join(out)
    
    
    def col_elements(w, s):
        """[(start, end, min, max, start tag)] of the main <col> children of the
        first main <cols>."""
        if not s["el"]["cols"]:
            return []
        x, y = s["el"]["cols"][0]
        raw = w[x:y]
        cp = split_name(qname(raw))[0]
        ca, cb = content_span(w, x, y)
        out = []
        for (kx, ky, nm) in children(w, ca, cb, cp, True):
            if nm == "col":
                tag = start_tag(w[kx:ky])
                try:
                    mn, mx = col_span(tag)
                except OutOfDesign:
                    mn = mx = -1
                out.append((kx, ky, mn, mx, tag))
        return out
    
    
    def et_cols(root):
        c = et_first(root, "cols")
        if c is None:
            return []
        return [el for el in c if local(el.tag)[0] in MAIN and local(el.tag)[1] == "col"]
    
    
    def et_rows(root):
        d = et_first(root, "sheetData")
        if d is None:
            return []
        return [el for el in d if local(el.tag)[0] in MAIN and local(el.tag)[1] == "row"]
    
    
    def grouped_attrs(tag):
        """The attributes, but min and max, the write leaves on a covering
        <col> (none for None): hidden dropped, outlineLevel="1" in place or
        appended; the tool's prediction of one element or two."""
        out = [(n, b) for (n, b) in attributes(tag or b"<col/>") if n not in (b"min", b"max", b"hidden")]
        for i, (n, _) in enumerate(out):
            if n == b"outlineLevel":
                out[i] = (n, b'outlineLevel="1"')
                return out
        out.append((b"outlineLevel", b'outlineLevel="1"'))
        return out
    
    
    GROUP_SET = (b"min", b"max", b"outlineLevel", b"hidden", b"collapsed")
    
    
    def kept_attrs(tag):
        return [(n, b) for (n, b) in attributes(tag) if n not in GROUP_SET] if tag else []
    
    
    def covering(cols, c):
        return next((e for e in cols if e[2] <= c <= e[3]), None)
    
    
    def plant(flag, wout, others, st):
        """(wout, others) changed so that `flag` turns to no, or None when the
        pair gives the plant nothing to change."""
        s = shape(wout, st["root_ns"])
        o = dict(others)
        if any(len(s["el"][n]) != 1 for n in FOUR):
            return None
        m = st["m"]
        if flag == "rest_same":
            return wout[:s["te"]] + COMMENT + wout[s["te"]:], o
        if flag == "places":
            other = [(x, y) for (x, y, nm) in s["kids"] if nm not in (None,) + FOUR]
            if not other:
                return None
            x, y = other[0]
            return wout[:y] + wout[x:y] + wout[y:], o
        if flag == "schema_order":
            x, y = s["el"]["sheetFormatPr"][0]
            el = wout[x:y]
            rest = wout[:x] + wout[y:]
            end = rest.rfind(b"</")
            return rest[:end] + el + rest[end:], o
        rows, (ca, cb), _ = rows_of(wout, s)
        if flag == "rows_kept":
            return wout[:ca] + COMMENT + wout[ca:], o
        if flag in ("rows_window", "rows_attrs"):
            hit = next(((kx, tag) for (kx, _, r, tag) in rows if r == m + 1), None)
            if hit is None:
                return None
            kx, tag = hit
            new = (tag[:-2] + b' planted="1"/>' if tag.endswith(b"/>") else tag[:-1] + b' planted="1">') \
                if flag == "rows_window" else with_attribute(tag, b"outlineLevel", b"2")
            return wout[:kx] + new + wout[kx + len(tag):], o
        cols = col_elements(wout, s)
        if flag == "cols_other":
            # The first <col> outside the span the edit covers gains an
            # attribute; none outside gives the plant nothing to change.
            lo, hi = st["span"]
            hit = next(((kx, tag) for (kx, _, mn, mx, tag) in cols if mx < lo or mn > hi), None)
            if hit is None:
                return None
            kx, tag = hit
            new = tag[:-2] + b' planted="1"/>' if tag.endswith(b"/>") else tag[:-1] + b' planted="1">'
            return wout[:kx] + new + wout[kx + len(tag):], o
        if flag == "cols_group":
            hit = next(((kx, tag) for (kx, _, _, _, tag) in cols if attr_value(tag, b"outlineLevel") == b"1"), None)
            if hit is None:
                return None
            kx, tag = hit
            return wout[:kx] + with_attribute(tag, b"outlineLevel", b"2") + wout[kx + len(tag):], o
        if flag == "cols_bytes":
            x, y = s["el"]["cols"][0]
            ca2, _ = content_span(wout, x, y)
            return wout[:ca2] + COMMENT + wout[ca2:], o
        if flag in ("format_rest", "maximums"):
            x, y = s["el"]["sheetFormatPr"][0]
            tag = start_tag(wout[x:y])
            if flag == "format_rest":
                new = tag[:-2] + b' planted="1"/>' if tag.endswith(b"/>") else tag[:-1] + b' planted="1">'
            else:
                new = with_attribute(tag, b"outlineLevelRow", b"0")
            return wout[:x] + new + wout[x + len(tag):], o
        if flag == "sheetpr_rest":
            x, y = s["el"]["sheetPr"][0]
            tag = start_tag(wout[x:y])
            new = tag[:-2] + b' planted="1"/>' if tag.endswith(b"/>") else tag[:-1] + b' planted="1">'
            return wout[:x] + new + wout[x + len(tag):], o
        if flag == "outline_pr":
            i = wout.find(b'summaryBelow="0"')
            if i < 0:
                return None
            return wout[:i] + b'summaryBelow="1"' + wout[i + len(b'summaryBelow="0"'):], o
        if flag == "w_bytes":
            return wout + b"\n", o
        if flag == "others_same":
            name = next(iter(o), None)
            if name is None:
                return None
            o[name] = o[name] + COMMENT
            return wout, o
        if flag == "read_back":
            hit = next(((kx, tag) for (kx, _, r, tag) in rows if r is not None and r <= m), None)
            if hit is None:
                return None
            kx, tag = hit
            return wout[:kx] + with_attribute(tag, b"outlineLevel", b"1") + wout[kx + len(tag):], o
        if flag in ("xml_values", "flagged"):
            return wout, o
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        part = w_of(zin, wb)
        if part is None or part not in zin.namelist():
            print("error=no-worksheet")
            return
        if args[1:] == ["--parts"]:
            print(part)
            print(bit3(zin, part))
            return
        names_in_order = zin.namelist()
        win = zin.read(part)
        root_i = ET.fromstring(win)
        root_ns = local(root_i.tag)[0]
        zout = zipfile.ZipFile(args[1])
        rest = args[2:]
        diff_path = flag_plant = None
        while rest:
            if rest[0] == "--diff" and len(rest) >= 2:
                diff_path, rest = rest[1], rest[2:]
            elif rest[0] == "--plant" and len(rest) >= 2:
                flag_plant, rest = rest[1], rest[2:]
                if flag_plant not in FLAGS:
                    print("error=unknown-plant")
                    return
            else:
                print("error=usage")
                return
        out_names = zout.namelist()
        wout = zout.read(part) if part in out_names else b""
        others = {nm: zout.read(nm) for nm in out_names if nm != part}
    
        m = max_row(root_i)
        s_in = shape(win, root_ns)
        try:
            want, want_rows, want_cols = design(win, s_in, m)
        except OutOfDesign:
            print("error=out-of-design")
            return
        cols_pre = col_elements(win, s_in)
        cov_pre = [e for e in cols_pre if e[2] <= 3 and 2 <= e[3]]
        st = {"root_ns": root_ns, "m": m,
              "span": (min([e[2] for e in cov_pre] + [2]), max([e[3] for e in cov_pre] + [3]))}
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, wout, others, st)
            if changed is not None:
                wout, others = changed
                planted = True
        extra = flag_plant if planted else None
    
        flags = dict.fromkeys(FLAGS, False)
        window = window_of(m)
        rows_in, _, _ = rows_of(win, s_in)
        present = [r for (_, _, r, _) in rows_in if r in window]
        cols_in = col_elements(win, s_in)
        cov = [e for e in cols_in if e[2] <= 3 and 2 <= e[3]]
        span_lo = min([e[2] for e in cov] + [2])
        span_hi = max([e[3] for e in cov] + [3])
        hidden_cols = sum(1 for e in cov if attr_value(e[4], b"hidden") == b"1")
        hidden_any = sum(1 for e in cov if attr_value(e[4], b"hidden") is not None)
        created = {n: 0 if s_in["el"][n] else 1 for n in ("sheetPr", "sheetFormatPr", "cols")}
        rows_out_n = cols_out_n = level_cols = kept_cols = -1
        if wout:
            s_out = shape(wout, root_ns)
            flags["rest_same"] = cut(win, [sp for n in FOUR for sp in s_in["el"][n]]) == \
                cut(wout, [sp for n in FOUR for sp in s_out["el"][n]])
            want_places = [nm for (_, _, nm) in s_in["kids"] if nm is not None]
            for n in ("sheetPr", "sheetFormatPr", "cols"):
                if created[n]:
                    idx = TABLE.index(n)
                    at = next((i for (i, nm) in enumerate(want_places) if nm in TABLE and TABLE.index(nm) > idx),
                              len(want_places))
                    want_places.insert(at, n)
            locals_out = [nm for (_, _, nm) in s_out["kids"] if nm is not None]
            flags["places"] = locals_out == want_places
            pos = [TABLE.index(nm) for nm in locals_out if nm in TABLE]
            flags["schema_order"] = pos == sorted(pos) and all(locals_out.count(n) == 1 for n in FOUR)
            if all(len(s_out["el"][n]) == 1 for n in FOUR):
                rows_out, (oca, ocb), _ = rows_of(wout, s_out)
                rows_out_n = len(rows_out)
                ix, iy = s_in["el"]["sheetData"][0]
                ox, oy = s_out["el"]["sheetData"][0]
                flags["rows_kept"] = (
                    cut(win[ix:iy], [(kx - ix, ky - ix) for (kx, ky, r, _) in rows_in if r in window])
                    == cut(wout[ox:oy], [(kx - ox, ky - ox) for (kx, ky, r, _) in rows_out if r in window]))
                got = [wout[kx:ky] for (kx, ky, r, _) in rows_out if r in window]
                flags["rows_window"] = got == want_rows and \
                    [r for (_, _, r, _) in rows_out if r in window] == sorted(window)
                cols_out = col_elements(wout, s_out)
                cols_out_n = len(cols_out)
                outside_in = [win[kx:ky] for (kx, ky, mn, mx, _) in cols_in if mx < span_lo or mn > span_hi]
                outside_out = [wout[kx:ky] for (kx, ky, mn, mx, _) in cols_out if mx < span_lo or mn > span_hi]
                flags["cols_other"] = outside_in == outside_out
                x, y = s_out["el"]["cols"][0]
                flags["cols_bytes"] = wout[x:y] == want_cols
                level_cols = sum(1 for e in cols_out if attr_value(e[4], b"outlineLevel") == b"1")
                kept_cols = sum(len(kept_attrs(covering(cols_out, c)[4] if covering(cols_out, c) else None))
                                for c in (2, 3))
                fi = s_in["el"]["sheetFormatPr"]
                fo = start_tag(wout[s_out["el"]["sheetFormatPr"][0][0]:])
                other_in = ([(n, b) for (n, b) in attributes(start_tag(win[fi[0][0]:]))
                             if n not in (b"outlineLevelRow", b"outlineLevelCol")]
                            if fi else [(b"defaultRowHeight", b'defaultRowHeight="15"')])
                other_out = [(n, b) for (n, b) in attributes(fo) if n not in (b"outlineLevelRow", b"outlineLevelCol")]
                flags["format_rest"] = other_in == other_out
                px, py = s_out["el"]["sheetPr"][0]
                pout = wout[px:py]
                pp = split_name(qname(pout))[0]
                pca, pcb = content_span(wout, px, py)
                op_out = [(kx - px, ky - px) for (kx, ky, nm) in children(wout, pca, pcb, pp, True) if nm == "outlinePr"]
                if s_in["el"]["sheetPr"]:
                    qx, qy = s_in["el"]["sheetPr"][0]
                    pin = win[qx:qy]
                    tag = start_tag(pin)
                    if tag.endswith(b"/>"):
                        pin_n = opened(tag) + b"</" + qname(tag) + b">"
                        op_in = []
                    else:
                        qca, qcb = content_span(win, qx, qy)
                        op_in = [(kx - qx, ky - qx) for (kx, ky, nm) in children(win, qca, qcb, pp, True)
                                 if nm == "outlinePr"]
                        pin_n = pin[:qcb - qx] + b"</" + qname(tag) + b">"
                else:
                    pin_n = b"<" + s_in["rp"] + b"sheetPr></" + s_in["rp"] + b"sheetPr>"
                    op_in = []
                flags["sheetpr_rest"] = cut(pin_n, op_in) == cut(pout, op_out)
            flags["w_bytes"] = wout == want
        try:
            root_o = ET.fromstring(wout) if wout else None
        except ET.ParseError:
            root_o = None
        if root_o is not None:
            e_in = {int(el.get("r")): el for el in et_rows(root_i) if (el.get("r") or "").isdigit()}
            e_out = [el for el in et_rows(root_o)]
            ok = True
            for n, sets in window.items():
                hits = [el for el in e_out if el.get("r") == str(n)]
                if len(hits) != 1:
                    ok = False
                    continue
                base = dict(e_in[n].attrib) if n in e_in else {"r": str(n)}
                for (k, v) in sets:
                    base[k.decode()] = v.decode()
                if dict(hits[0].attrib) != base:
                    ok = False
                if n not in e_in and (len(list(hits[0])) or (hits[0].text or "")):
                    ok = False
            flags["rows_attrs"] = ok
            c_in = et_cols(root_i)
            c_out = et_cols(root_o)
    
            def rng(el):
                try:
                    return int(el.get("min")), int(el.get("max"))
                except (TypeError, ValueError):
                    return (-1, -1)
    
            inside = [el for el in c_out if not (rng(el)[1] < span_lo or rng(el)[0] > span_hi)]
            g = True
            expect = span_lo
            for el in inside:
                lo, hi = rng(el)
                if lo != expect or hi < lo:
                    g = False
                expect = hi + 1
            if expect != span_hi + 1:
                g = False
            leveled = [rng(el) for el in c_out if el.get("outlineLevel") == "1"]
            cov2 = covering(cols_in, 2)
            cov3 = covering(cols_in, 3)
            one = grouped_attrs(cov2[4] if cov2 else None) == grouped_attrs(cov3[4] if cov3 else None)
            if leveled != ([(2, 3)] if one else [(2, 2), (3, 3)]):
                g = False
            for el in inside:
                lo, hi = rng(el)
                for c in range(lo, hi + 1):
                    # Each column's source: the input <col> covering it, none
                    # for a created column.
                    src = next((e for e in c_in if rng(e)[0] <= c <= rng(e)[1]), None)
                    want_a = dict(src.attrib) if src is not None else {}
                    got_a = dict(el.attrib)
                    drop = ("min", "max", "outlineLevel", "hidden") if c in (2, 3) else ("min", "max")
                    for k in drop:
                        want_a.pop(k, None)
                        got_a.pop(k, None)
                    if want_a != got_a:
                        g = False
                        break
                if lo <= 3 and 2 <= hi and ("hidden" in el.attrib or el.get("outlineLevel") != "1"):
                    g = False
            flags["cols_group"] = g
            f_in = et_first(root_i, "sheetFormatPr")
            f_out = et_first(root_o, "sheetFormatPr")
            mx_ok = f_out is not None
            for k in ("outlineLevelRow", "outlineLevelCol"):
                have = u8_of(f_in.get(k).encode()) if f_in is not None and f_in.get(k) is not None else 0
                want_v = have if have >= 1 else 1
                if f_out is None or u8_of((f_out.get(k) or "").encode()) != want_v:
                    mx_ok = False
            flags["maximums"] = mx_ok
            p_in = et_first(root_i, "sheetPr")
            p_out = et_first(root_o, "sheetPr")
            o_ok = False
            if p_out is not None:
                kids = [local(el.tag)[1] for el in p_out if local(el.tag)[0] in MAIN]
                ops = [el for el in p_out if local(el.tag)[0] in MAIN and local(el.tag)[1] == "outlinePr"]
                o_in = et_first(p_in, "outlinePr") if p_in is not None else None
                if len(ops) == 1 and ops[0].get("summaryBelow") == "0":
                    a_out = dict(ops[0].attrib)
                    a_in = dict(o_in.attrib) if o_in is not None else {}
                    a_out.pop("summaryBelow")
                    a_in.pop("summaryBelow", None)
                    ranks = [PR_KIDS.index(k) for k in kids if k in PR_KIDS]
                    o_ok = a_out == a_in and ranks == sorted(ranks)
            flags["outline_pr"] = o_ok
            lv = [el for el in e_out if el.get("outlineLevel") == "1"]
            cl = [el for el in e_out if el.get("collapsed") == "1"]
            rb = (sorted(el.get("r") for el in lv) == sorted([str(m + 1), str(m + 2)])
                  and all(el.get("hidden") == "1" for el in lv)
                  and [el.get("r") for el in cl] == [str(m + 3)]
                  and f_out is not None
                  and all(u8_of((f_out.get(k) or "").encode()) >= 1 for k in ("outlineLevelRow", "outlineLevelCol"))
                  and p_out is not None and et_first(p_out, "outlinePr") is not None
                  and et_first(p_out, "outlinePr").get("summaryBelow") == "0")
            flags["read_back"] = rb
        flags["others_same"] = (list(others) == [nm for nm in names_in_order if nm != part]
                                and out_names == names_in_order
                                and all(others[nm] == zin.read(nm) for nm in others))
    
        in_only = out_only = want_in = want_out = flagged_rows = want_flagged = -1
