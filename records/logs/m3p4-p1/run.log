             "level_cols=%d" % level_cols, "kept_cols=%d" % kept_cols, "hidden_cols=%d" % hidden_cols, "hidden_any_cols=%d" % hidden_any,
             "r_bound_in=%d" % (0 if rels_prefix_of(tag_in) is None else 1),
