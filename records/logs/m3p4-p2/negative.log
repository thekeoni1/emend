### this log's generator, from the phase commit's template files
    """Fictional packages for M3 part 4 P2's negative log, the line style family:
    the phase commit's template files, zipped in the template's order, the
    worksheet part given a row with a cell, or one or two <cols> before its
    sheetData.
    Usage: gen-p2.py <template dir> <out dir>."""
    import os
    import re
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    MAIN = b"http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    src, out = sys.argv[1], sys.argv[2]
    parts = {name: open(os.path.join(src, name), "rb").read() for name in ORDER}
    sheet = parts["xl/worksheets/sheet1.xml"]
    root = b'<worksheet xmlns="' + MAIN + b'">'
    assert sheet.count(b"<sheetData/>") == 1 and sheet.count(root) == 1
    for name in (b"<cols", b"<row"):
        assert sheet.count(name) == 0
    styles = parts["xl/styles.xml"]
    xfs = re.search(rb"<cellXfs[^>]*>(.*?)</cellXfs>", styles, re.S)
    assert xfs is not None
    print("the template's cell formats: %d" % len(re.findall(rb"<xf\b", xfs.group(1))))
    
    EMPTY = b"<sheetData/>"
    COLS = b'<cols><col min="8" max="10" width="5"/></cols>'
    OTHER = b'<cols><col min="12" max="12" width="5"/></cols>'
    
    
    def row(r):
        return b'<sheetData><row r="%d"><c r="A%d"><v>1</v></c></row></sheetData>' % (r, r)
    
    
    # case: what replaces the empty sheetData
    CASES = {
        "l0": EMPTY,
        "n1": row(1048576),
        "n1c": row(1048575),
        "n2": COLS + OTHER + EMPTY,
        "n2c": COLS + EMPTY,
    }
    for name, data in CASES.items():
        p = dict(parts)
        s = sheet.replace(EMPTY, data)
        p["xl/worksheets/sheet1.xml"] = s
        with zipfile.ZipFile(os.path.join(out, name + ".xlsx"), "w") as z:
            for n in ORDER:
                z.writestr(zipfile.ZipInfo(n, (1980, 1, 1, 0, 0, 0)), p[n], zipfile.ZIP_DEFLATED)
        rows = [int(x) for x in re.findall(rb'<row r="(\d+)"', s)]
        print("%s %d entries:%d cols:%d col:%d rows:%d last_row:%d" % (
            name + ".xlsx", os.path.getsize(os.path.join(out, name + ".xlsx")), len(ORDER),
