        flags = dict.fromkeys(FLAGS, False)
        rows_in, _, _ = rows_of(win, s_in)
        present = [r for (_, _, r, _) in rows_in if r == m + 1]
        created_cols = 0 if s_in["el"]["cols"] else 1
        case = 1 if cov is None else (0 if (cov[2], cov[3]) != (COLUMN, COLUMN) else 2)
        rows_out_n = cols_out_n = col_split = kept_cols = xfs_out = -1
        if wout:
            s_out = shape(wout, root_ns)
            flags["rest_same"] = cut(win, [sp for n in FOUR for sp in s_in["el"][n]]) == \
                cut(wout, [sp for n in FOUR for sp in s_out["el"][n]])
            want_places = [nm for (_, _, nm) in s_in["kids"] if nm is not None]
            if created_cols:
                idx = TABLE.index("cols")
                at = next((k for (k, nm) in enumerate(want_places) if nm in TABLE and TABLE.index(nm) > idx),
                          len(want_places))
                want_places.insert(at, "cols")
            locals_out = [nm for (_, _, nm) in s_out["kids"] if nm is not None]
            flags["places"] = locals_out == want_places
            pos = [TABLE.index(nm) for nm in locals_out if nm in TABLE]
            flags["schema_order"] = pos == sorted(pos) and all(locals_out.count(n) == 1 for n in FOUR)
            if all(len(s_out["el"][n]) == 1 for n in FOUR):
                rows_out, _, _ = rows_of(wout, s_out)
                rows_out_n = len(rows_out)
                ix, iy = s_in["el"]["sheetData"][0]
                ox, oy = s_out["el"]["sheetData"][0]
                flags["rows_kept"] = (
                    cut(win[ix:iy], [(kx - ix, ky - ix) for (kx, ky, r, _) in rows_in if r == m + 1])
                    == cut(wout[ox:oy], [(kx - ox, ky - ox) for (kx, ky, r, _) in rows_out if r == m + 1]))
                got = [wout[kx:ky] for (kx, ky, r, _) in rows_out if r == m + 1]
                flags["row_window"] = got == [want_row]
                cols_out = col_elements(wout, s_out)
                cols_out_n = len(cols_out)
                outside_in = [win[kx:ky] for (kx, ky, mn, mx, _) in cols_in if mx < span_lo or mn > span_hi]
                outside_out = [wout[kx:ky] for (kx, ky, mn, mx, _) in cols_out if mx < span_lo or mn > span_hi]
                flags["cols_other"] = outside_in == outside_out
                x, y = s_out["el"]["cols"][0]
                flags["cols_bytes"] = wout[x:y] == want_cols
                col_split = sum(1 for e in cols_out if e[2] >= span_lo and e[3] <= span_hi) if cov else 1
                c_out = covering(cols_out, COLUMN)
                kept_cols = len([a for a in attributes(c_out[4]) if a[0] not in (b"min", b"max", b"style")]) \
                    if c_out else -1
            flags["w_bytes"] = wout == want
        try:
            root_o = ET.fromstring(wout) if wout else None
        except ET.ParseError:
