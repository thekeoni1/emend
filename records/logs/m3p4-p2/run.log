    """The run log's survey of the corpus before the line style sample's run
    (specs/0026-grouping-and-line-styles.md, "Harness runs", P2, with "Planning
    rulings during P2" ruling 1; specs/0024 P1 verification ruling 6's form:
    names, ids and counts only, the corpus directory a parameter).
    
    Usage: lssurvey.py <corpus>
    
    Lists <corpus>/corpus (every regular file, no extension glob) and reads each
    workbook the manifest <corpus>/manifest.tsv names, in manifest order: the
    workbook part through the package relationships, W the first <sheet> in
    <sheets> order whose relationship is a worksheet's and the styles part the
    workbook's styles relationship names (zipfile and ElementTree), and W's
    part and the styles part read with expat WITHOUT namespace processing, each
    element's namespace resolved here from the declarations in scope: a reader
    of another lineage than the run log's comparison (byte spans) and the tool
    (the crate's token stream). Its W reader is M3 part 4 P1's gpsurvey.py's,
    copied; what it counts of <sheetPr> and <sheetFormatPr> is not printed
    here.
    
    Prints, tab-separated, one line per workbook:
      wb <id> <M> <rows> <present> <cols> <cover> <cover class> <xfs> <fonts> <chain> <r bound>
    where <M> is W's largest row number among its main <c> elements (a cell's
    r, else its row's r), 0 for none; <rows> W's main <row> elements; <present>
    those numbered M + 1 (0 or 1, P2 ruling 1); <cols> W's main <col>
    elements; <cover> the number of <col> elements covering column 9 (0 or 1
    when the <col> elements do not overlap); <cover class> "none", "alone" (the
    covering element covers column 9 alone) or "wider"; <xfs> the main <xf>
    children of the styles part's first main <cellXfs>, and <fonts> the main
    <font> children of its first main <fonts>; <chain> 1 when
    xl/calcChain.xml is an entry; <r bound> 1 when W's root binds a prefix to
    the relationships namespace. Then, one line per workbook, the shapes as
    names only:
      names <id> <covering col's attributes>
    a comma-joined list of attribute names in document order ("-" for none),
    and last one line
      files <regular files in corpus/> <manifest rows> <rows read>
    No value, text, reference or part name is printed: the classes are words,
    the rest are counts and attribute names of the schema.
    """
    import os
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    from xml.parsers import expat
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    CELL = re.compile(r"^([A-Z]+)([1-9][0-9]*)$")
    WHOLE = re.compile(r"^[0-9]+$")
    
    
    def rels(z, part):
        d, base = posixpath.split(part)
        name = posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            if el.get("TargetMode") == "External":
                continue
            t = el.get("Target", "")
            out.append((el.get("Id"), el.get("Type", ""),
                        t[1:] if t.startswith("/") else posixpath.normpath(posixpath.join(d, t))))
        return out
    
    
    def w_of(z):
        """W's part, or None."""
        wb = [t for (_, ty, t) in rels(z, "") if ty.endswith("/officeDocument")][0]
        by_id = {i: (ty, t) for (i, ty, t) in rels(z, wb)}
        for el in ET.fromstring(z.read(wb)).iter():
            if el.tag in ["{%s}sheet" % m for m in MAIN]:
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, t = by_id.get(rid, ("", None))
                if ty in [a + "/worksheet" for a in ATTR]:
                    return t
        return None
    
    
    def survey_w(data):
        st = {"depth": 0, "scopes": [], "rows": [], "max": 0, "r_bound": 0, "root_child": None,
              "sheet_pr": 0, "outline_pr": 0, "pr_kids": [], "fmt": 0, "fmt_attrs": None,
              "cols": [], "cell_rows": []}
    
        def start(name, attrs):
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(st["scopes"][-1]) if st["scopes"] else {}
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            st["scopes"].append(scope)
            st["depth"] += 1
            prefix, _, loc = name.rpartition(":")
            main = scope.get(prefix) in MAIN
            d = dict(pairs)
            if st["depth"] == 1:
                st["r_bound"] = 1 if any(k.startswith("xmlns:") and v in ATTR for (k, v) in pairs) else 0
            elif st["depth"] == 2:
                st["root_child"] = loc if main else None
                if main and loc == "sheetPr":
                    st["sheet_pr"] += 1
                if main and loc == "sheetFormatPr":
                    st["fmt"] += 1
                    if st["fmt_attrs"] is None:
                        st["fmt_attrs"] = [(k, v) for (k, v) in pairs if not k.startswith("xmlns")]
            elif st["depth"] == 3 and main:
                if st["root_child"] == "sheetPr" and st["sheet_pr"] == 1:
                    st["pr_kids"].append(loc)
                    if loc == "outlinePr":
                        st["outline_pr"] += 1
                if st["root_child"] == "cols" and loc == "col":
                    st["cols"].append([(k, v) for (k, v) in pairs if not k.startswith("xmlns")])
            if main and loc == "row" and st["depth"] == 3 and st["root_child"] == "sheetData":
                st["rows"].append(d.get("r"))
            if main and loc == "c":
                r = d.get("r")
                m = CELL.match(r) if r else None
                row = int(m.group(2)) if m else (int(st["rows"][-1]) if st["rows"] and st["rows"][-1] else 0)
                st["max"] = max(st["max"], row)
    
        def end(name):
            st["depth"] -= 1
            st["scopes"].pop()
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.Parse(data, True)
        return st
    
    
    def span(attrs):
        d = dict(attrs)
        try:
            return int(d.get("min")), int(d.get("max"))
        except (TypeError, ValueError):
            return None
    
    
    def styles_of(z):
        """The styles part's name, or None."""
        wb = [t for (_, ty, t) in rels(z, "") if ty.endswith("/officeDocument")][0]
        for (_, ty, t) in rels(z, wb):
            if ty in [a + "/styles" for a in ATTR]:
                return t
        return None
    
    
    def survey_styles(data):
        """The main <xf> children of the first main <cellXfs> and the main <font>
        children of the first main <fonts>, root children both."""
        st = {"depth": 0, "scopes": [], "child": None, "seen": {}, "xfs": 0, "fonts": 0}
    
        def start(name, attrs):
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(st["scopes"][-1]) if st["scopes"] else {}
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            st["scopes"].append(scope)
            st["depth"] += 1
            prefix, _, loc = name.rpartition(":")
            main = scope.get(prefix) in MAIN
            if st["depth"] == 2:
                first = main and loc in ("cellXfs", "fonts") and loc not in st["seen"]
                st["child"] = loc if first else None
                if main:
                    st["seen"][loc] = 1
            elif st["depth"] == 3 and main:
                if st["child"] == "cellXfs" and loc == "xf":
                    st["xfs"] += 1
                if st["child"] == "fonts" and loc == "font":
                    st["fonts"] += 1
    
        def end(name):
            st["depth"] -= 1
            st["scopes"].pop()
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.Parse(data, True)
        return st
    
    
    def main():
        corpus = sys.argv[1]
        lines = open(os.path.join(corpus, "manifest.tsv"), encoding="utf-8").read().split("\n")
        head = lines[0].split("\t")
        rows = [l.split("\t") for l in lines[1:] if l]
        files = sorted(f for f in os.listdir(os.path.join(corpus, "corpus"))
                       if os.path.isfile(os.path.join(corpus, "corpus", f)))
        read = 0
        shapes = []
        for row in rows:
            cid, ext = row[head.index("id")], row[head.index("ext")]
            name = "%s.%s" % (cid, ext)
            if name not in files:
                print("wb\t%s\tmissing" % cid)
                continue
            z = zipfile.ZipFile(os.path.join(corpus, "corpus", name))
            part = w_of(z)
            sty = styles_of(z)
            if part is None or sty is None:
                print("wb\t%s\tno-worksheet-or-styles" % cid)
                continue
            st = survey_w(z.read(part))
            ss = survey_styles(z.read(sty))
            m = st["max"]
            nums = [int(r) for r in st["rows"] if r and WHOLE.match(r)]
            present = sum(1 for r in nums if r == m + 1)
            covering = []
            for attrs in st["cols"]:
                sp = span(attrs)
                if sp and sp[0] <= 9 <= sp[1]:
                    covering.append((attrs, sp))
            cls = "none" if not covering else ("alone" if covering[0][1] == (9, 9) else "wider")
            chain = 1 if "xl/calcChain.xml" in z.namelist() else 0
            read += 1
            print("\t".join(["wb", cid] + [str(v) for v in (
                m, len(st["rows"]), present, len(st["cols"]), len(covering))] + [cls]
                + [str(v) for v in (ss["xfs"], ss["fonts"], chain, st["r_bound"])]))
            shapes.append("\t".join([
                "names", cid,
                "|".join(",".join(k for (k, _) in a) for (a, _) in covering) or "-"]))
        for line in shapes:
            print(line)
        print("files\t%d\t%d\t%d" % (len(files), len(rows), read))
    
    
    main()
