    def survey_w(data):
        st = {"depth": 0, "scopes": [], "rows": [], "max": 0, "r_bound": 0, "root_child": None,
              "sheet_pr": 0, "outline_pr": 0, "pr_kids": [], "fmt": 0, "fmt_attrs": None,
              "cols": [], "cell_rows": []}
    
        def start(name, attrs):
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(st["scopes"][-1]) if st["scopes"] else {}
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            st["scopes"].append(scope)
            st["depth"] += 1
            prefix, _, loc = name.rpartition(":")
            main = scope.get(prefix) in MAIN
            d = dict(pairs)
            if st["depth"] == 1:
                st["r_bound"] = 1 if any(k.startswith("xmlns:") and v in ATTR for (k, v) in pairs) else 0
            elif st["depth"] == 2:
                st["root_child"] = loc if main else None
                if main and loc == "sheetPr":
                    st["sheet_pr"] += 1
                if main and loc == "sheetFormatPr":
                    st["fmt"] += 1
                    if st["fmt_attrs"] is None:
                        st["fmt_attrs"] = [(k, v) for (k, v) in pairs if not k.startswith("xmlns")]
            elif st["depth"] == 3 and main:
                if st["root_child"] == "sheetPr" and st["sheet_pr"] == 1:
                    st["pr_kids"].append(loc)
                    if loc == "outlinePr":
                        st["outline_pr"] += 1
                if st["root_child"] == "cols" and loc == "col":
                    st["cols"].append([(k, v) for (k, v) in pairs if not k.startswith("xmlns")])
            if main and loc == "row" and st["depth"] == 3 and st["root_child"] == "sheetData":
                st["rows"].append(d.get("r"))
            if main and loc == "c":
                r = d.get("r")
                m = CELL.match(r) if r else None
                row = int(m.group(2)) if m else (int(st["rows"][-1]) if st["rows"] and st["rows"][-1] else 0)
                st["max"] = max(st["max"], row)
    
        def end(name):
            st["depth"] -= 1
            st["scopes"].pop()
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.Parse(data, True)
        return st
    
    
    def span(attrs):
        d = dict(attrs)
        try:
            return int(d.get("min")), int(d.get("max"))
        except (TypeError, ValueError):
            return None
    
    
    def styles_of(z):
        """The styles part's name, or None."""
        wb = [t for (_, ty, t) in rels(z, "") if ty.endswith("/officeDocument")][0]
        for (_, ty, t) in rels(z, wb):
            if ty in [a + "/styles" for a in ATTR]:
                return t
        return None
    
    
    def survey_styles(data):
        """The main <xf> children of the first main <cellXfs> and the main <font>
        children of the first main <fonts>, root children both."""
        st = {"depth": 0, "scopes": [], "child": None, "seen": {}, "xfs": 0, "fonts": 0}
    
        def start(name, attrs):
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(st["scopes"][-1]) if st["scopes"] else {}
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            st["scopes"].append(scope)
            st["depth"] += 1
            prefix, _, loc = name.rpartition(":")
            main = scope.get(prefix) in MAIN
            if st["depth"] == 2:
                first = main and loc in ("cellXfs", "fonts") and loc not in st["seen"]
                st["child"] = loc if first else None
                if main:
                    st["seen"][loc] = 1
            elif st["depth"] == 3 and main:
                if st["child"] == "cellXfs" and loc == "xf":
                    st["xfs"] += 1
                if st["child"] == "fonts" and loc == "font":
                    st["fonts"] += 1
    
        def end(name):
            st["depth"] -= 1
            st["scopes"].pop()
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.Parse(data, True)
        return st
    
    
    def main():
        corpus = sys.argv[1]
        lines = open(os.path.join(corpus, "manifest.tsv"), encoding="utf-8").read().split("\n")
        head = lines[0].split("\t")
        rows = [l.split("\t") for l in lines[1:] if l]
        files = sorted(f for f in os.listdir(os.path.join(corpus, "corpus"))
                       if os.path.isfile(os.path.join(corpus, "corpus", f)))
        read = 0
        shapes = []
        for row in rows:
            cid, ext = row[head.index("id")], row[head.index("ext")]
            name = "%s.%s" % (cid, ext)
            if name not in files:
                print("wb\t%s\tmissing" % cid)
                continue
            z = zipfile.ZipFile(os.path.join(corpus, "corpus", name))
            part = w_of(z)
            sty = styles_of(z)
            if part is None or sty is None:
                print("wb\t%s\tno-worksheet-or-styles" % cid)
                continue
            st = survey_w(z.read(part))
            ss = survey_styles(z.read(sty))
            m = st["max"]
            nums = [int(r) for r in st["rows"] if r and WHOLE.match(r)]
            present = sum(1 for r in nums if r == m + 1)
            covering = []
            for attrs in st["cols"]:
                sp = span(attrs)
                if sp and sp[0] <= 9 <= sp[1]:
                    covering.append((attrs, sp))
            cls = "none" if not covering else ("alone" if covering[0][1] == (9, 9) else "wider")
            chain = 1 if "xl/calcChain.xml" in z.namelist() else 0
            read += 1
            print("\t".join(["wb", cid] + [str(v) for v in (
                m, len(st["rows"]), present, len(st["cols"]), len(covering))] + [cls]
                + [str(v) for v in (ss["xfs"], ss["fonts"], chain, st["r_bound"])]))
            shapes.append("\t".join([
                "names", cid,
                "|".join(",".join(k for (k, _) in a) for (a, _) in covering) or "-"]))
        for line in shapes:
            print(line)
        print("files\t%d\t%d\t%d" % (len(files), len(rows), read))
    
    
    main()
