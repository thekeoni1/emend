    #      workbook's outcome and exit equal, every output by sha256, line and
    #      diff table equal.
    #  RD. The two surveys, run before the runs as PD and QD: gpsurvey.py is
    #      P1's with one change (P1 verification ruling 1): its <hidden> column
    #      counts the covering <col> elements whose hidden attribute is "1" or
    #      "true", where P1's counted "1" alone; lssurvey.py is P2's, byte for
    #      byte. A planted corpus of three fictional workbooks (hidden="1",
    #      hidden="true", hidden="false" on a <col> over columns 2 and 3) shows
    #      the new count: 1, 1, 0, with <hidden any> 1 each.
    #  RE. Each sample's comparison is its own phase's, byte for byte (gpcmp.py,
    #      P1's; lscmp.py, P2's), with its flags, its line relations and its
    #      survey relations as PC and QC give them; every row ok (PE and QE);
    #      the entries rule (W changed, and the styles part for the line style
    #      sample; descriptor exactly where the input entry sets bit 3; every
    #      other entry identical; nothing added, recompressed or dropped) read
    #      from the comparison's --parts lines, generic over the two samples.
    #  RF. Change PF (the calculation chain, counted against zipfile) stands,
    #      for each sample on each label.
    #  RG. Change PG over the group sample, with RD's count: the input <col>
    #      elements covering column 2 or 3 with a hidden attribute of any value,
    #      which the group drops, counted by the comparison and checked against
    #      the survey's; the survey's count of those carrying "1" or "true"
    #      printed beside it (the comparison's hidden_cols counts "1" alone and
    #      is printed, not compared).
    #  RH. Change PH (the open check's own TMPDIR device) stands, unchanged.
    #  RI. The plants (PI and QI), and ruling 3 of "Planning verification and
    #      rulings on P2": every flag's planted control runs on the created case
    #      and the kept case of each sample as P1 and P2 defined them, and on
    #      the first ok workbook in manifest order whose row M + 1 is present
    #      (the survey's present column), each on its own check line; a case the
    #      corpus does not hold fails its line.
    #  RJ. The record pairs: one per sample, each checked by P2's reccheck.py
    #      (carried byte for byte); the families each record's check derives are
    #      those of the parts the comparison's --parts lines name.
    #  RK. Change QG (no hidden count for the line style sample) stands for it;
    #      the group sample's is RG.
    #  RL. NEW, the controls of the rerun's comparison with the earlier run
    #      (M3 part 3 P4's): the sha256 comparison tells an output with one byte
    #      appended, and same_counts_ok refuses totals with one line differing.
    #  RM. QK stands: this script runs no `rm -rf`; the sourced
    #      scripts/counting.sh, a committed script, runs one on the directory its
    #      counting controls make (allowed: a directory the script created in
    #      that run); the working directory and the keeps stand, kept, and
    #      Python writes no bytecode.
    #  RN. SUPERSEDED_RUN names an earlier attempt's run stem: both of its
    #      sample directories (<runs>/<stem>-group and -linestyle) are moved,
    #      never removed, before this run.
    #
    # Usage: m3p4-p3-run.sh <phase commit> <this phase's test.log> <this phase's size.log> > <file>
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    . scripts/counting.sh
    
    C=${1:?phase commit required}
    TEST_LOG=${2:?this phase test.log required}
    SIZE_LOG=${3:?this phase size.log required}
    # Change AS: every environment input, as it was set, before any is unset.
    INPUT_NAMES="SPEC_SHA RUN_SUFFIX SUPERSEDED_RUN SUPERSEDED_KEEP RERUN_NOTE RERUN_FILES RECORDS_DEST RUN_KEEP RUN_BUILD_ROOT RUN_SIZE_BUILD RUN_OUT_ROOT RUN_SKIP_KEEP EMEND_CORPUS_DIR HOME ANTHROPIC_API_KEY"
    declare -A INPUT_SEEN
    for v in $INPUT_NAMES; do
      if [ -n "${!v+x}" ]; then INPUT_SEEN[$v]=${!v}; else INPUT_SEEN[$v]=unset; fi
      # Change BL (part 4a P3's AW): the key's value is never printed, only whether it is set.
      if [ "$v" = ANTHROPIC_API_KEY ] && [ "${INPUT_SEEN[$v]}" != unset ]; then INPUT_SEEN[$v]="set (value not printed)"; fi
    done
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    # Change JI: Python writes no bytecode, so nothing arises to be removed.
    export PYTHONDONTWRITEBYTECODE=1
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    LO_TIMEOUT_S=600
    SPEC=specs/0026-grouping-and-line-styles.md
    SPEC_SHA=${SPEC_SHA:-}
    if [ -z "$SPEC_SHA" ]; then echo "SPEC_SHA, the spec's sha256, is a required input (change AR)" >&2; exit 2; fi
    # Change RC: the two samples once more, by the name each run takes.
    SAMPLES="group linestyle"
    # The logged run leaves RUN_BUILD_ROOT and RUN_KEEP unset; a dry run points
    # them elsewhere so it leaves no keep where the logged run refuses one.
    BUILD_ROOT=${RUN_BUILD_ROOT:-$HOME/.cache/emend-build/m3p4-p3/run}
    # Change RC: the size log's build directory, whose release binaries run.
    SIZE_BUILD=${RUN_SIZE_BUILD:-$HOME/.cache/emend-build/m3p4-p3/size}
    KEEP=${RUN_KEEP:-$HOME/.cache/emend-build/m3p4-p3/keep-host}
    # Change JE (M3 part 1 P3's ID): the dry-run inputs.
    RUN_OUT_ROOT=${RUN_OUT_ROOT:-$CORPUS/runs}
    RUN_SKIP_KEEP=${RUN_SKIP_KEEP:-no}
    case $RUN_SKIP_KEEP in yes | no) ;; *) echo "RUN_SKIP_KEEP is yes or no" >&2; exit 2 ;; esac
    INSTALLED=()
    I686=i686-unknown-linux-musl
    # Change AK: where the record pairs are installed.
    RECORDS_DEST=${RECORDS_DEST:-records}
    # Change I: a keep in place is another attempt's, moved below once the
    # header can list it; without SUPERSEDED_KEEP naming the attempt it is
    # refused.
    SUPERSEDED_KEEP=${SUPERSEDED_KEEP:-}
    case $SUPERSEDED_KEEP in '' | attempt-[1-9]) ;; *) echo "SUPERSEDED_KEEP is attempt-<n> or nothing" >&2; exit 2 ;; esac
    if [ "$RUN_SKIP_KEEP" = no ] && [ -e "$KEEP" ] && [ -z "$SUPERSEDED_KEEP" ]; then echo "$KEEP is already there; name its attempt in SUPERSEDED_KEEP" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    RECORDS=$SELF_DIR/out/records
    # Change JI: the working directory is on the disk under <scripts>/out and
    # kept; nothing here is removed.
    B=$(mktemp -d "$SELF_DIR/out/work.XXXXXX") || exit 2
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    SHORT=$(git rev-parse --short=7 "$C")
    # Change CE (P3's BZ): planning's uncommitted rulings in specs/0026, if any
    # arrive mid-phase, are the one planning file the status allows, as a
    # modified tracked file (changes MA and RA).
    OURS='^((\?\?| ?[MARCD]) records/logs/m3p4-p3|(\?\?| ?[MARCD]) records/(m3p4-(p3-group|p3-linestyle|open)|size-m3p4)-2[^ ]*-'"$SHORT"'[.](md|txt)$| M specs/0026-grouping-and-line-styles[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's records and planning's spec" >&2
      exit 2
    fi
    DATE=$(date -u +%Y-%m-%d)
    STEM_OPEN=m3p4-open-$DATE-$SHORT
    # Change RC: one record pair per sample.
    declare -A STEM_OF OUT_OF
    for s in $SAMPLES; do STEM_OF[$s]=m3p4-p3-$s-$DATE-$SHORT; done
    # A rerun takes a suffix, so its run directory is never the superseded one.
    RUN_SUFFIX=${RUN_SUFFIX:-}
    case $RUN_SUFFIX in '' | -[b-z]) ;; *) echo "RUN_SUFFIX is -b to -z or nothing" >&2; exit 2 ;; esac
    RUN=$DATE-$SHORT$RUN_SUFFIX
    OUT=$RUN_OUT_ROOT/$RUN
    # Change RC: each sample's run directory, <runs>/<run>-<sample>.
    for s in $SAMPLES; do OUT_OF[$s]=$OUT-$s; done
    mkdir -p "$RECORDS" "$RECORDS_DEST" || exit 2
    # A rerun names the superseded run directory, which is MOVED into
    # <scripts>/out/superseded after the header prints it, never removed; it
    # must be another run of this phase, not this one.
    SUPERSEDED_RUN=${SUPERSEDED_RUN:-}
    case $SUPERSEDED_RUN in
      '' | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f] | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[b-z]) ;;
      *) echo "SUPERSEDED_RUN is not a run directory's name" >&2; exit 2 ;;
    esac
    if [ -n "$SUPERSEDED_RUN" ] && [ "$SUPERSEDED_RUN" = "$RUN" ]; then echo "SUPERSEDED_RUN names this run's own directory" >&2; exit 2; fi
    # Change RN: the superseded attempt's two sample directories.
    for f in "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt"; do
      if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
    done
    for s in $SAMPLES; do
      for f in "${OUT_OF[$s]}" "$RECORDS/${STEM_OF[$s]}.md" "$RECORDS/${STEM_OF[$s]}.txt" "$RECORDS_DEST/${STEM_OF[$s]}.md" "$RECORDS_DEST/${STEM_OF[$s]}.txt"; do
        if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
      done
    done
    # A run directory with a summary for either label before the runner starts
    # is another attempt's (memory: a same-day rerun reads the previous attempt's
    # files); refused here, before the runner, with the exact message.
    for s in $SAMPLES; do
      for sl in host i686; do
        if [ -e "${OUT_OF[$s]}/summary.$sl.tsv" ]; then echo "${OUT_OF[$s]}/summary.$sl.tsv is already there" >&2; exit 2; fi
      done
    done
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$B#<work>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$KEEP#<keep>#g" \
        -e "s#$SIZE_BUILD#<sizebuild>#g" -e "s#$BUILD_ROOT#<build>#g" -e "s#$RUN_OUT_ROOT#<runs>#g" -e "s#$CORPUS#<corpus>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M3 part 4 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # Change AS: the environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M3 part 4 P2 record:')
    CODE=$(by_subject "M3 part 4 P3: probe-emend-rowcol-write-xml grows with the part's calls")
    DOC=$(by_subject 'M3 part 4 P3: commit planning docs')
    # Change RB: the record the keep is compared with, named by its record
    # commit, resolved by its subject (no hash is typed here), and checked below;
    # the base itself.
    PREV_OPEN_REC=$(by_subject 'M3 part 4 P2 record:')
    # Change RC: the record commits whose run records name the runs compared
    # with: P1's for the group sample, P2's (the base) for the line style sample.
    P1_REC=$(by_subject 'M3 part 4 P1 record:')
    P2_REC=$REC
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  M3 part 4 P2's record commit (the base): ${REC:-none}"
    echo "  P3's doc commit: ${DOC:-none}"
    echo "  the probe commit, the phase commit: ${CODE:-none}"
    echo "  M3 part 4 P2's record commit, the last to add an open-check record, named by its commit (changes CC, JB, LB, MB, NB, PB, QB and RB): ${PREV_OPEN_REC:-none}"
    echo "  M3 part 4 P1's record commit, whose run record names the --group-sample run compared with (change RC): ${P1_REC:-none}"
    echo "command: git log -1 --format=%s $PREV_OPEN_REC"
    echo "    $(git log -1 --format=%s "$PREV_OPEN_REC")"
    prev_is_record() { [ -n "$PREV_OPEN_REC" ] && git cat-file -e "$PREV_OPEN_REC^{commit}" && [ "$(git log -1 --format=%s "$PREV_OPEN_REC" | LC_ALL=C "$G" -cE '^M3 part 4 P2 record: ')" = 1 ] && git merge-base --is-ancestor "$PREV_OPEN_REC" "$C"; }
    check "the named record commit is M3 part 4 P2's record commit, an ancestor of the phase commit" "$(yn prev_is_record)"
    prev_is_base() { [ -n "$REC" ] && [ "$PREV_OPEN_REC" = "$REC" ] && [ "$(git rev-parse "$DOC^")" = "$REC" ]; }
    check "the named record commit is the base, and the base is the parent of P3's doc commit (change RB)" "$(yn prev_is_base)"
    prev_ctl() { local PREV_OPEN_REC=$DOC; if prev_is_record; then return 1; else return 0; fi; }
    check "control: the same check refuses P3's doc commit named instead" "$(yn prev_ctl)"
    # rec_of_ok <commit> <subject start>: a record commit of that subject, an
    # ancestor of the phase commit.
    rec_of_ok() { [ -n "$1" ] && [ "$(git log -1 --format=%s "$1" | LC_ALL=C "$G" -cE "^$2")" = 1 ] && git merge-base --is-ancestor "$1" "$C"; }
    check "P1's record commit is resolved, an ancestor of the phase commit (change RC)" "$(yn rec_of_ok "$P1_REC" 'M3 part 4 P1 record: ')"
    rec_ctl1() { if rec_of_ok "$P1_REC" 'M3 part 4 P2 record: '; then return 1; else return 0; fi; }
    check "control: the same check refuses P1's record commit under P2's subject" "$(yn rec_ctl1)"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the probe commit, by its subject" "$(yn [ "$CODE" = "$C" ])"
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    check "control: not_head says no for HEAD itself, so it can fail" "$(yn [ "$(yn not_head "$C")" = no ])"
    echo "phase: Milestone 3 part 4 P3 (specs/0026-grouping-and-line-styles.md) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in (change AT)"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    
    # Change AI: the two move checks as functions, run over planted inputs every
    # time below, and over a real moved keep or run directory when there is one.
    # keep_pairs_ok <listing>: the .in.xlsx lines times two equal the listing's
    # lines (P2 ruling 14 of specs/0018; the pattern in double quotes so the tab
    # is interpolated).
    keep_pairs_ok() {
      local pairs files
      pairs=$(count_matches -E "[.]in[.]xlsx${TAB}" "$1")
      files=$(count_lines "$1")
      [ "$files" -ge 2 ] && [ "$((pairs * 2))" = "$files" ]
    }
    # run_listing <dir> <listing>: the listing of a run directory, one line per
    # file, path and bytes (specs/0018 P2 verification ruling 4's form).
    run_listing() { (cd "$1" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$2"; }
    # run_listing_ok <dir> <listing>: the listing names each file once and at
    # least one.
    run_listing_ok() {
      local files lines uniq
      files=$(find "$1" -type f | wc -l)
      lines=$(count_lines "$2")
      uniq=$(cut -f1 "$2" | LC_ALL=C sort -u | count_lines /dev/stdin)
      [ "$files" -ge 1 ] && [ "$lines" = "$files" ] && [ "$uniq" = "$files" ]
    }
    
    if [ -n "$SUPERSEDED_RUN" ]; then
      for s in $SAMPLES; do
        SUP_OUT=$RUN_OUT_ROOT/$SUPERSEDED_RUN-$s
        SUP_TO=$SELF_DIR/out/superseded/run-$SUPERSEDED_RUN-$s
        echo "the superseded run directory, moved before this run (change RN): <runs>/$SUPERSEDED_RUN-$s to <scripts>/out/superseded/run-$SUPERSEDED_RUN-$s"
        if [ -d "$SUP_OUT" ]; then
          echo "command: sha256sum <runs>/$SUPERSEDED_RUN-$s/summary.host.tsv and summary.i686.tsv; mv <runs>/$SUPERSEDED_RUN-$s <scripts>/out/superseded/run-$SUPERSEDED_RUN-$s"
          for sl in host i686; do
            if [ -f "$SUP_OUT/summary.$sl.tsv" ]; then echo "    summary.$sl.tsv sha256 $(sha_of "$SUP_OUT/summary.$sl.tsv")"; else echo "    summary.$sl.tsv: NO HASH EXISTS, the file is not there"; fi
          done
          run_listing "$SUP_OUT" "$B/superseded-run-$s.listing"
          echo "command: (cd <runs>/$SUPERSEDED_RUN-$s && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum"
          echo "    files $(find "$SUP_OUT" -type f | wc -l); listing lines $(count_lines "$B/superseded-run-$s.listing"); listing sha256 $(sha_of "$B/superseded-run-$s.listing")"
          check "the listing of $SUPERSEDED_RUN-$s names each of its files once" "$(yn run_listing_ok "$SUP_OUT" "$B/superseded-run-$s.listing")"
          mkdir -p "$SELF_DIR/out/superseded" && mv "$SUP_OUT" "$SUP_TO"
        fi
        sup_moved() { [ ! -e "$SUP_OUT" ] && [ -d "$SUP_TO" ]; }
        check "the superseded run directory $SUPERSEDED_RUN-$s is moved, not removed, before the run" "$(yn sup_moved)"
      done
    fi
    if [ -n "$SUPERSEDED_KEEP" ]; then
      KEEP_TO=$SELF_DIR/out/superseded/keep-$SUPERSEDED_KEEP
      echo "the superseded keep (change I), moved before this run: <keep> to <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
      if [ -d "$KEEP" ]; then
        (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/superseded-keep.listing"
        echo "command: (cd <keep> && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum; the .in.xlsx files counted; mv <keep> <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
        echo "    pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/superseded-keep.listing"); files $(count_lines "$B/superseded-keep.listing"); listing sha256 $(sha_of "$B/superseded-keep.listing")"
        check "the moved keep's pairs times two equals its files" "$(yn keep_pairs_ok "$B/superseded-keep.listing")"
        if [ -e "$KEEP_TO" ]; then echo "    $KEEP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$KEEP" "$KEEP_TO"; fi
      else
        echo "    NO LISTING EXISTS: there is no keep in place to move"
      fi
      keep_moved() { [ ! -e "$KEEP" ] && [ -d "$KEEP_TO" ]; }
      check "the superseded keep is moved, not removed, before the run" "$(yn keep_moved)"
    fi
    echo "superseded run directory named: ${SUPERSEDED_RUN:-none}; superseded keep named: ${SUPERSEDED_KEEP:-none}"
    echo
    echo "## the two move checks over planted inputs, run every time (change AI)"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\n' "$TAB" "$TAB" >"$B/c-keep.listing"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\ny.1.out.xlsx%s1\n' "$TAB" "$TAB" "$TAB" >"$B/c-keep-odd.listing"
    echo "  planted keep listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep.listing"), files $(count_lines "$B/c-keep.listing"); with an unpaired output: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep-odd.listing"), files $(count_lines "$B/c-keep-odd.listing")"
    check "keep_pairs_ok passes a planted listing of one whole pair" "$(yn keep_pairs_ok "$B/c-keep.listing")"
    kp_ctl() { if keep_pairs_ok "$B/c-keep-odd.listing"; then return 1; else return 0; fi; }
    check "control: keep_pairs_ok refuses a planted listing with an unpaired output" "$(yn kp_ctl)"
    mkdir -p "$B/c-run/abc123" && printf 'a' >"$B/c-run/summary.host.tsv" && printf 'bb' >"$B/c-run/abc123/out.host.xlsx" && printf 'ccc' >"$B/c-run/abc123/stdout.host.txt"
    run_listing "$B/c-run" "$B/c-run.listing"
    echo "  planted run directory: files $(find "$B/c-run" -type f | wc -l); listing lines $(count_lines "$B/c-run.listing"); listing sha256 $(sha_of "$B/c-run.listing")"
    check "run_listing_ok passes the planted run directory's own listing" "$(yn run_listing_ok "$B/c-run" "$B/c-run.listing")"
    { cat "$B/c-run.listing"; head -n 1 "$B/c-run.listing"; } >"$B/c-run-dup.listing"
    rl_ctl() { if run_listing_ok "$B/c-run" "$B/c-run-dup.listing"; then return 1; else return 0; fi; }
    check "control: run_listing_ok refuses a listing that names one file twice" "$(yn rl_ctl)"
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory, <build>/target (CARGO_TARGET_DIR)"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the copy child and --lo-timeout $LO_TIMEOUT_S per conversion, the figures every corpus run of this milestone used; not tuned during the run."
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh is sourced from it by this log; scripts/passthrough-run.sh, scripts/passthrough-record.py and scripts/edit-open-check.sh are run from it, and the runner and the open check each source scripts/lo-check.sh, which is never run; the three record pairs are installed into its $RECORDS_DEST/; the test.log and the size.log given are read from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <scripts> stands for <home>/.cache/emend-build/m3p4-p3/scripts on the disk, this script's own directory, which holds the script, gpcmp.py, gpsurvey.py, lscmp.py and lssurvey.py beside it; the three record pairs are written into <scripts>/out/records first, a superseded run directory and a superseded keep are moved into <scripts>/out/superseded, and this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under <scripts>/out on the disk (the two comparisons and the two surveys copied from beside this script, their outputs, the planted survey corpus (change RD), derived tables, the planted listings and run directory, the runs' TMPDIR <work>/tmp-run (change LG), the open check's TMPDIR <work>/tmp, the i686 keep's listing), kept after the run and never removed (change JI)"
    echo "root: <build> stands for <home>/.cache/emend-build/m3p4-p3/run on the disk: <build>/target the keep's test builds (no release binary is built here, change RC), <build>/keep-i686.<pid> the i686 keep, kept after the comparison (change JI)"
    echo "root: <sizebuild> stands for <home>/.cache/emend-build/m3p4-p3/size on the disk, or RUN_SIZE_BUILD when set, size.log's build directory, from whose target the release binaries are run where size.log built them; read, never written (change RC)"
    echo "root: <keep> stands for <home>/.cache/emend-build/m3p4-p3/keep-host on the disk, this phase's host keep; kept after the run for planning"
    echo "root: <corpus> stands for the private corpus directory (the manifest and the inputs under <corpus>/corpus, read; the earlier phases' run directories under <corpus>/runs, read, change RC)"
    echo "root: <runs> stands for the corpus run directories' parent, <corpus>/runs unless RUN_OUT_ROOT names another for a dry run (change JE); this log's run directories <runs>/$RUN-group and <runs>/$RUN-linestyle are written there"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$SELF_DIR" "$BUILD_ROOT" "$SIZE_BUILD" "$MAIN" "$KEEP" "$CORPUS")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots other than <home>, <work> and <runs> are distinct, none inside another" "$(yn roots_distinct)"
    work_in_scripts() { case "$B/" in "$SELF_DIR/out/"*) return 0 ;; esac; return 1; }
    check "<work> is under <scripts>/out on the disk (change JI)" "$(yn work_in_scripts)"
    work_ctl() { local B=/tmp/x; if work_in_scripts; then return 1; else return 0; fi; }
    check "control: the same test refuses a working directory under /tmp" "$(yn work_ctl)"
    runs_apart() { apart "$RUN_OUT_ROOT" "$MAIN" && apart "$RUN_OUT_ROOT" "$SELF_DIR"; }
    check "<runs> lies outside <repo> and <scripts>" "$(yn runs_apart)"
    roots_ctl() { if apart "$CARGO_TARGET_DIR" "$BUILD_ROOT"; then return 1; else return 0; fi; }
    check "control: apart refuses <build>/target against <build>, which holds it" "$(yn roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    check "ANTHROPIC_API_KEY is not set" "$(yn [ -z "${ANTHROPIC_API_KEY:-}" ])"
    echo "the run directories: <runs>/$RUN-group and <runs>/$RUN-linestyle; the record stems: ${STEM_OF[group]}, ${STEM_OF[linestyle]} and $STEM_OPEN; the records' destination: $RECORDS_DEST; RUN_SKIP_KEEP: $RUN_SKIP_KEEP"
    echo "at entry: status lines $entry_all; of them this phase's records or planning's spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts, against the phase commit, and planning's uncommitted spec"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh scripts/edit-open-check.sh; do
      check "$s in the main tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { if [ "$(git show "$C:scripts/excel-check-list.py" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/edit-open-check.sh)" ]; then return 1; else return 0; fi; }
    check "control: the same hash comparison tells two different scripts apart" "$(yn tree_ctl)"
    # Change CE (P3's BZ): the pin is the committed spec; the working tree's copy
    # is printed, not pinned (change RA).
    spec_now=$(sha_of "$SPEC")
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    spec_doc=$(git show "$(by_subject 'M3 part 4 P3: commit planning docs'):$SPEC" | sha256sum | cut -d' ' -f1)
    echo "  the spec: $SPEC; at the phase commit sha256 $spec_committed; at the doc commit $spec_doc; the pin, the input SPEC_SHA: $SPEC_SHA"
    echo "  the working tree's copy (change CE; equal to the pin unless planning adds rulings mid-phase): sha256 $spec_now"
    spec_ok() { [ "$spec_committed" = "$SPEC_SHA" ]; }
    check "the spec at the phase commit is at the one pinned hash" "$(yn spec_ok)"
    check "the spec at the phase commit is the doc commit's" "$(yn [ "$spec_committed" = "$spec_doc" ])"
    spec_ctl() { local spec_committed=1111111111111111111111111111111111111111111111111111111111111111; if spec_ok; then return 1; else return 0; fi; }
    check "control: the same check refuses the spec against another hash" "$(yn spec_ctl)"
    echo "command: podman image exists $IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    echo
    echo "## the release binaries size.log hashed, run where it built them (change RC)"
    echo "command: sha256sum $SIZE_LOG, and sed for its hash: lines"
    echo "  $SIZE_LOG: sha256 $(sha_of "$SIZE_LOG"), $(wc -c <"$SIZE_LOG") bytes"
    size_log_phase() { [ "$(count_matches -E "^about: M3 part 4 P3 phase commit $C; HEAD at run: $C\$" "$SIZE_LOG")" = 1 ] && [ "$(count_matches -xF 'size log checks all as expected: yes' "$SIZE_LOG")" = 1 ]; }
    check "size.log is this phase's, at this phase commit, and ends all as expected" "$(yn size_log_phase)"
    size_ctl() { local C=$NULL_SHA; if size_log_phase; then return 1; else return 0; fi; }
    check "control: the same check says no for the null commit" "$(yn size_ctl)"
    size_hash() { sed -n "s/^hash: $1 $2 \([0-9a-f]\{64\}\)\$/\1/p" "$SIZE_LOG"; }
    PT_host=$SIZE_BUILD/target/release/emend-copy
    XD_host=$SIZE_BUILD/target/release/xlsx-diff
    PT_i686=$SIZE_BUILD/target/$I686/release/emend-copy
    XD_i686=$SIZE_BUILD/target/$I686/release/xlsx-diff
    bin_is_hashed() {
      local given
      given=$(size_hash "$1" "$2")
      [ -f "$3" ] && [ -n "$given" ] && [ "$(sha_of "$3")" = "$given" ] && [ "$(size_hash "$1" "$2" | count_lines /dev/stdin)" = 1 ]
    }
    # show_bin <name> <target> <path>: the binary's hash beside size.log's.
    show_bin() {
      if [ -f "$3" ]; then
        echo "  $3: sha256 $(sha_of "$3"), bytes $(stat -c %s "$3"); size.log's hash: line: $(size_hash "$1" "$2")"
      else
        echo "  $3: MISSING; size.log's hash: line: $(size_hash "$1" "$2")"
      fi
      check "$1 $2 is the binary size.log hashed, once" "$(yn bin_is_hashed "$1" "$2" "$3")"
    }
    show_bin emend-copy host "$PT_host"
    show_bin xlsx-diff host "$XD_host"
    show_bin emend-copy "$I686" "$PT_i686"
    show_bin xlsx-diff "$I686" "$XD_i686"
    hash_ctl() { [ -z "$(size_hash emend-copy no-such-target)" ]; }
    check "control: the hash reader finds nothing for a target size.log does not name" "$(yn hash_ctl)"
    hash_bin_ctl() { if bin_is_hashed emend-copy host "$XD_host"; then return 1; else return 0; fi; }
    check "control: bin_is_hashed refuses xlsx-diff offered as emend-copy" "$(yn hash_bin_ctl)"
    echo "  $(rustc --version)"
    
    echo
    echo "## the corpus manifest, and its workbooks holding a calculation chain (change RF; specs/0025 P3 verification ruling 4)"
    manifest_rows=$(awk -F'\t' 'NR > 1 { n++ } END { print n + 0 }' "$CORPUS/manifest.tsv")
    echo "  corpus manifest rows: $manifest_rows"
    check "the corpus holds its 27 workbooks" "$(yn [ "$manifest_rows" = 27 ])"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv" >"$B/order"
    check "the manifest order holds one line per row" "$(yn [ "$(count_lines "$B/order")" = "$manifest_rows" ])"
    # chain_direct: the count by zipfile, one call per manifest row.
    : >"$B/chain-direct"
    while IFS="$TAB" read -r id ext; do
      if [ "$(python3 -c 'import sys, zipfile; print(1 if "xl/calcChain.xml" in zipfile.ZipFile(sys.argv[1]).namelist() else 0)' "$CORPUS/corpus/$id.$ext")" = 1 ]; then
        printf '%s\n' "$id" >>"$B/chain-direct"
      fi
    done <"$B/order"
    N_CHAIN=$(count_lines "$B/chain-direct")
    echo "command: python3 -c <zipfile namelist> <corpus>/corpus/<id>.<ext>, for each manifest row"
    echo "  corpus workbooks holding xl/calcChain.xml: $N_CHAIN of $manifest_rows by zipfile (ids: $(paste -sd' ' "$B/chain-direct"))"
    check "some corpus workbook holds a calculation chain, so the chain rows below are read" "$(yn [ "$N_CHAIN" -ge 1 ])"
    
    echo
    echo "## the two surveys of the corpus before the runs (change RD)"
    for f in gpsurvey.py lssurvey.py; do
      cp "$SELF_DIR/$f" "$B/$f" || exit 2
      echo "command: cp <scripts>/$f <work>/$f; sed 's/^/    /' <work>/$f; sha256 $(sha_of "$B/$f"), $(wc -c <"$B/$f") bytes"
      check "the copy of $f is the file beside this script, byte for byte" "$(yn cmp -s "$SELF_DIR/$f" "$B/$f")"
      sed 's/^/    /' "$B/$f"
    done
    declare -A SV_OUT
    SV_OUT[group]=$B/survey-group.out
    SV_OUT[linestyle]=$B/survey-linestyle.out
    echo "command: python3 <work>/gpsurvey.py <corpus> (wb: id, M, rows, present, cols, sheetPr, outlinePr, fmt, maxrow, maxcol, cover, hidden, chain, r bound, hidden any; names: id and three shapes; then files; tab-separated)"
    python3 "$B/gpsurvey.py" "$CORPUS" >"${SV_OUT[group]}" 2>"$B/survey-group.err"
    src_g=$?
    echo "command: python3 <work>/lssurvey.py <corpus> (wb: id, M, rows, present, cols, cover, cover class, xfs, fonts, chain, r bound; names: id and the covering col's attributes; then files; tab-separated)"
    python3 "$B/lssurvey.py" "$CORPUS" >"${SV_OUT[linestyle]}" 2>"$B/survey-linestyle.err"
    src_l=$?
    echo "  exit: group $src_g, line style $src_l; stderr bytes: $(wc -c <"$B/survey-group.err") and $(wc -c <"$B/survey-linestyle.err"); lines: $(count_lines "${SV_OUT[group]}") and $(count_lines "${SV_OUT[linestyle]}")"
    for s in $SAMPLES; do
      echo "  the $s survey:"
      sed 's/^/    /' "${SV_OUT[$s]}"
    done
    survey_ran() { [ "$src_g" = 0 ] && [ "$src_l" = 0 ] && [ ! -s "$B/survey-group.err" ] && [ ! -s "$B/survey-linestyle.err" ]; }
    check "both surveys exit 0 with an empty stderr" "$(yn survey_ran)"
    # survey_whole <survey> <wb fields> <names fields>: one regular file per
    # manifest row listed, every workbook read with one full wb line and one
    # names line.
    survey_whole() {
      local files rows read wb names
      files=$(awk -F'\t' '$1 == "files" { print $2 }' "$1")
      rows=$(awk -F'\t' '$1 == "files" { print $3 }' "$1")
      read=$(awk -F'\t' '$1 == "files" { print $4 }' "$1")
      wb=$(awk -F'\t' -v n="$2" '$1 == "wb" && NF == n { k++ } END { print k + 0 }' "$1")
      names=$(awk -F'\t' -v n="$3" '$1 == "names" && NF == n { k++ } END { print k + 0 }' "$1")
      [ "$files" = "$manifest_rows" ] && [ "$rows" = "$manifest_rows" ] && [ "$read" = "$manifest_rows" ] && [ "$wb" = "$manifest_rows" ] && [ "$names" = "$manifest_rows" ]
    }
    check "the group survey listed one regular file per manifest row and read every workbook with one full wb line and one names line each" "$(yn survey_whole "${SV_OUT[group]}" 16 5)"
    check "the line style survey likewise" "$(yn survey_whole "${SV_OUT[linestyle]}" 12 3)"
    sw_ctl() { if survey_whole "${SV_OUT[group]}" 12 5; then return 1; else return 0; fi; }
    check "control: survey_whole refuses the group survey read with the line style survey's field count" "$(yn sw_ctl)"
    # gp_forms_ok <survey output>: P1's form (PD), every wb line of sixteen
    # fields, every count a number, the maximums' classes words of the survey's
    # four, present 0 to 3, the hidden covering elements (hidden "1" or "true",
    # and a hidden attribute of any value) no more than the covering ones, the
    # flags 0 or 1; at least one line.
    gp_forms_ok() {
      awk -F'\t' '
        $1 == "wb" {
          nw++
          if (NF != 16) { bad++; next }
          for (col = 3; col <= 9; col++) if ($col !~ /^[0-9]+$/) bad++
          for (col = 12; col <= 16; col++) if ($col !~ /^[0-9]+$/) bad++
          if ($10 !~ /^(absent|zero|one-up|other)$/ || $11 !~ /^(absent|zero|one-up|other)$/) bad++
          if ($5 > 3 || $13 > $12 || $16 > $12 || $13 > $16) bad++
          if ($14 !~ /^[01]$/ || $15 !~ /^[01]$/) bad++
        }
        END { exit (nw > 0 && bad == 0) ? 0 : 1 }' "$1"
    }
    # ls_forms_ok <survey output>: P2's form (QD), every wb line of twelve
    # fields, every count a number, present 0 or 1, cover 0 or 1 with its class
    # word agreeing, some cell format and some font, the flags 0 or 1.
    ls_forms_ok() {
      awk -F'\t' '
        $1 == "wb" {
          nw++
          if (NF != 12) { bad++; next }
          for (col = 3; col <= 7; col++) if ($col !~ /^[0-9]+$/) bad++
          for (col = 9; col <= 12; col++) if ($col !~ /^[0-9]+$/) bad++
          if ($5 > 1 || $7 > 1) bad++
          if (($7 == 0) != ($8 == "none") || $8 !~ /^(none|alone|wider)$/) bad++
          if ($9 < 1 || $10 < 1) bad++
          if ($11 !~ /^[01]$/ || $12 !~ /^[01]$/) bad++
        }
        END { exit (nw > 0 && bad == 0) ? 0 : 1 }' "$1"
    }
    check "every group survey line has P1's form" "$(yn gp_forms_ok "${SV_OUT[group]}")"
    check "every line style survey line has P2's form" "$(yn ls_forms_ok "${SV_OUT[linestyle]}")"
    for planted in "wb${TAB}x${TAB}1${TAB}1${TAB}4${TAB}0${TAB}1${TAB}0${TAB}1${TAB}zero${TAB}zero${TAB}1${TAB}0${TAB}0${TAB}1${TAB}0" \
                   "wb${TAB}x${TAB}1${TAB}1${TAB}0${TAB}0${TAB}1${TAB}0${TAB}1${TAB}zero${TAB}zero${TAB}1${TAB}2${TAB}0${TAB}1${TAB}2" \
                   "wb${TAB}x${TAB}1${TAB}1${TAB}0"; do
      { cat "${SV_OUT[group]}"; printf '%s\n' "$planted"; } >"$B/c-survey-g"
      sv_ctl() { if gp_forms_ok "$B/c-survey-g"; then return 1; else return 0; fi; }
      check "control: gp_forms_ok refuses the group survey with a planted line ($(printf '%s' "$planted" | cut -f3- | tr '\t' ' '))" "$(yn sv_ctl)"
    done
    for planted in "wb${TAB}x${TAB}1${TAB}1${TAB}2${TAB}0${TAB}0${TAB}none${TAB}1${TAB}1${TAB}0${TAB}1" \
                   "wb${TAB}x${TAB}1${TAB}1${TAB}0${TAB}1${TAB}1${TAB}some${TAB}1${TAB}1${TAB}0${TAB}1" \
                   "wb${TAB}x${TAB}1${TAB}1${TAB}0"; do
      { cat "${SV_OUT[linestyle]}"; printf '%s\n' "$planted"; } >"$B/c-survey-l"
      sv_ctl() { if ls_forms_ok "$B/c-survey-l"; then return 1; else return 0; fi; }
      check "control: ls_forms_ok refuses the line style survey with a planted line ($(printf '%s' "$planted" | cut -f3- | tr '\t' ' '))" "$(yn sv_ctl)"
    done
    echo "  the group survey's shapes (rows and M shown as 0 or more than 0):"
    awk -F'\t' '$1 == "wb" { print "present " $5 " cols " ($6 > 0 ? "some" : "none") " sheetPr " $7 " outlinePr " $8 " fmt " $9 " maxrow " $10 " maxcol " $11 " cover " $12 " hidden " $13 " chain " $14 " r_bound " $15 " hidden_any " $16 }' "${SV_OUT[group]}" | LC_ALL=C sort | uniq -c | sed 's/^/    /'
    echo "  the line style survey's shapes (cols shown as none or some):"
    awk -F'\t' '$1 == "wb" { print "present " $5 " cols " ($6 > 0 ? "some" : "none") " cover " $8 " chain " $11 " r_bound " $12 }' "${SV_OUT[linestyle]}" | LC_ALL=C sort | uniq -c | sed 's/^/    /'
    # surveyed <sample> <id> <column>: the sample's survey's wb field for the
    # workbook.
    surveyed() { awk -F'\t' -v id="$2" -v c="$3" '$1 == "wb" && $2 == id { print $c }' "${SV_OUT[$1]}"; }
    declare -A SV_PRESENT
    SV_PRESENT[group]=$(awk -F'\t' '$1 == "wb" { n += $5 } END { print n + 0 }' "${SV_OUT[group]}")
    SV_PRESENT[linestyle]=$(awk -F'\t' '$1 == "wb" { n += $5 } END { print n + 0 }' "${SV_OUT[linestyle]}")
    SV_HIDDEN=$(awk -F'\t' '$1 == "wb" { n += $13 } END { print n + 0 }' "${SV_OUT[group]}")
    SV_HIDDEN_ANY=$(awk -F'\t' '$1 == "wb" { n += $16 } END { print n + 0 }' "${SV_OUT[group]}")
    echo "  rows numbered M + 1 to M + 3 already present, over the corpus (P1 ruling 6): ${SV_PRESENT[group]}, in $(awk -F'\t' '$1 == "wb" && $5 > 0 { n++ } END { print n + 0 }' "${SV_OUT[group]}") workbooks"
    echo "  row M + 1 already present, over the corpus (P2 ruling 1): ${SV_PRESENT[linestyle]} workbooks"
    echo "  <col> elements covering column 2 or 3 with hidden=\"1\" or hidden=\"true\" (P1 ruling 3 and P1 verification ruling 1): $SV_HIDDEN, in $(awk -F'\t' '$1 == "wb" && $13 > 0 { n++ } END { print n + 0 }' "${SV_OUT[group]}") workbooks"
    echo "  <col> elements covering column 2 or 3 with a hidden attribute of any value, which the group drops: $SV_HIDDEN_ANY, in $(awk -F'\t' '$1 == "wb" && $16 > 0 { n++ } END { print n + 0 }' "${SV_OUT[group]}") workbooks"
    echo "  column 9's <col> (the line style sample): created in $(awk -F'\t' '$1 == "wb" && $8 == "none" { n++ } END { print n + 0 }' "${SV_OUT[linestyle]}"), split out of a wider one in $(awk -F'\t' '$1 == "wb" && $8 == "wider" { n++ } END { print n + 0 }' "${SV_OUT[linestyle]}"), already alone in $(awk -F'\t' '$1 == "wb" && $8 == "alone" { n++ } END { print n + 0 }' "${SV_OUT[linestyle]}") workbooks"
    # Change RF: each survey's chain column against zipfile's count.
    awk -F'\t' '$1 == "wb" && $14 == 1 { print $2 }' "${SV_OUT[group]}" >"$B/chain-group"
    awk -F'\t' '$1 == "wb" && $11 == 1 { print $2 }' "${SV_OUT[linestyle]}" >"$B/chain-linestyle"
    check "the group survey's chain column is zipfile's, workbook for workbook" "$(yn cmp -s "$B/chain-group" "$B/chain-direct")"
    check "the line style survey's chain column is zipfile's, workbook for workbook" "$(yn cmp -s "$B/chain-linestyle" "$B/chain-direct")"
    cp "$B/chain-direct" "$B/c-chain"; printf 'zzzzzzzzzzzz\n' >>"$B/c-chain"
    chain_ctl() { if cmp -s "$B/c-chain" "$B/chain-direct"; then return 1; else return 0; fi; }
    check "control: the same comparison tells a planted id list from zipfile's" "$(yn chain_ctl)"
    cp "$B/chain-direct" "$B/chain-ids"
    
    echo
    echo "### the group survey's hidden count over a planted corpus (change RD; P1 verification ruling 1)"
    mkdir -p "$B/c-corpus/corpus" || exit 2
    python3 - "$B/c-corpus" <<'PY'
    """Three fictional workbooks, each one worksheet whose <cols> holds one <col>
    over columns 2 and 3 with a hidden attribute of "1", "true" or "false", and
    a manifest naming them."""
    import os
    import sys
    import zipfile
    
    root = sys.argv[1]
    MAIN = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    R = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    PR = "http://schemas.openxmlformats.org/package/2006/relationships"
    rows = ["id\text"]
    for cid, value in (("h1", "1"), ("htrue", "true"), ("hfalse", "false")):
        with zipfile.ZipFile(os.path.join(root, "corpus", cid + ".xlsx"), "w") as z:
            z.writestr("_rels/.rels", '<Relationships xmlns="%s"><Relationship Id="rId1" Type="%s/officeDocument" Target="xl/workbook.xml"/></Relationships>' % (PR, R))
            z.writestr("xl/workbook.xml", '<workbook xmlns="%s" xmlns:r="%s"><sheets><sheet name="S" sheetId="1" r:id="rId1"/></sheets></workbook>' % (MAIN, R))
            z.writestr("xl/_rels/workbook.xml.rels", '<Relationships xmlns="%s"><Relationship Id="rId1" Type="%s/worksheet" Target="worksheets/sheet1.xml"/></Relationships>' % (PR, R))
            z.writestr("xl/worksheets/sheet1.xml", '<worksheet xmlns="%s"><cols><col min="2" max="3" width="9" hidden="%s"/></cols><sheetData><row r="1"><c r="A1"><v>1</v></c></row></sheetData></worksheet>' % (MAIN, value))
        rows.append("%s\txlsx" % cid)
    open(os.path.join(root, "manifest.tsv"), "w").write("\n".join(rows) + "\n")
    PY
    echo "command: python3 - <work>/c-corpus (three fictional workbooks: one <col> over columns 2 and 3 with hidden=\"1\", hidden=\"true\" and hidden=\"false\"); python3 <work>/gpsurvey.py <work>/c-corpus"
    python3 "$B/gpsurvey.py" "$B/c-corpus" >"$B/c-survey-hidden" 2>&1
    awk -F'\t' '$1 == "wb" { print "    " $2 ": cover " $12 ", hidden " $13 ", hidden any " $16 }' "$B/c-survey-hidden"
    hidden_counts() { [ "$(awk -F'\t' '$1 == "wb" { printf "%s:%s:%s ", $2, $13, $16 }' "$B/c-survey-hidden")" = "h1:1:1 htrue:1:1 hfalse:0:1 " ]; }
    check "the group survey counts hidden=\"1\" and hidden=\"true\" as hidden and hidden=\"false\" not, each a hidden attribute of any value" "$(yn hidden_counts)"
    p1_hidden() { python3 "$P1_SURVEY" "$B/c-corpus" | awk -F'\t' '$1 == "wb" && $2 == "htrue" { print $13 }'; }
    P1_SURVEY=$B/c-p1-gpsurvey.py
    git show "$C:records/logs/m3p4-p1/run.log" >"$B/c-p1-run.log"
    python3 - "$B/c-p1-run.log" "$P1_SURVEY" <<'PY'
    """P1's survey as P1's run.log printed it, the four-space indent removed."""
    import sys
    
    lines = open(sys.argv[1]).read().split("\n")
    i = [k for k, l in enumerate(lines) if l.startswith("command: cp <scripts>/gpsurvey.py")][0]
    out = []
    for l in lines[i + 2:]:
        if l.startswith("    ") or l == "":
            out.append(l[4:] if l.startswith("    ") else l)
        else:
            break
    open(sys.argv[2], "w").write("\n".join(out).rstrip("\n") + "\n")
    PY
    echo "  P1's survey, read from records/logs/m3p4-p1/run.log at the phase commit, over the same planted corpus: hidden for hidden=\"true\": $(p1_hidden)"
    check "control: P1's survey, before ruling 1, counted hidden=\"true\" as not hidden (0)" "$(yn [ "$(p1_hidden)" = 0 ])"
    
    echo
    echo "## the two comparisons (python3, zipfile, byte spans and ElementTree; changes RE and PC, QC)"
    for f in gpcmp.py lscmp.py; do
      cp "$SELF_DIR/$f" "$B/$f" || exit 2
      echo "command: cp <scripts>/$f <work>/$f; sed 's/^/    /' <work>/$f; sha256 $(sha_of "$B/$f"), $(wc -c <"$B/$f") bytes"
      check "the copy of $f is the file beside this script, byte for byte" "$(yn cmp -s "$SELF_DIR/$f" "$B/$f")"
      sed 's/^/    /' "$B/$f"
    done
    declare -A CMP FLAGS_OF
    CMP[group]=$B/gpcmp.py
    CMP[linestyle]=$B/lscmp.py
    FLAGS_OF[group]="rest_same places schema_order rows_kept rows_window rows_attrs cols_other cols_group cols_bytes format_rest maximums sheetpr_rest outline_pr w_bytes others_same read_back xml_values flagged"
    FLAGS_OF[linestyle]="rest_same places schema_order rows_kept row_window row_attrs cols_other cols_split cols_bytes w_bytes styles_xfs styles_fonts styles_rest others_same read_back xml_values flagged"
    # flags_of_cmp <comparison>: its FLAGS tuple, read from its source with ast.
    flags_of_cmp() {
      python3 -c 'import ast, sys
    tree = ast.parse(open(sys.argv[1]).read())
    for node in tree.body:
        if isinstance(node, ast.Assign) and getattr(node.targets[0], "id", "") == "FLAGS":
            print(" ".join(e.value for e in node.value.elts))' "$1"
    }
    for s in $SAMPLES; do
      echo "  the $s comparison's FLAGS, read from its source: $(flags_of_cmp "${CMP[$s]}")"
      check "this log's $s flag list is the comparison's FLAGS" "$(yn [ "$(flags_of_cmp "${CMP[$s]}")" = "${FLAGS_OF[$s]}" ])"
    done
    printf 'FLAGS = ("rest_same",)\n' >"$B/c-flags.py"
    check "control: the same reader gives another list for a planted source" "$(yn [ "$(flags_of_cmp "$B/c-flags.py")" = rest_same ])"
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    # all_yes <sample> <comparison line>: every flag of the sample's yes.
    all_yes() { local f; for f in ${FLAGS_OF[$1]}; do [ "$(kv "$2" "$f")" = yes ] || return 1; done; }
    # tool_and_cmp <sample> <tool line> <comparison line>: the counts the two
    # share (PC, QC).
    tool_and_cmp() {
      local k keys
      case $1 in
        group) keys="rows_before:rows_in rows_present:present rows_after:rows_out cols_before:cols_in cols_after:cols_out level_cols:level_cols kept_cols:kept_cols r_bound_before:r_bound_in" ;;
        *) keys="rows_before:rows_in rows_present:present rows_after:rows_out cols_before:cols_in cols_after:cols_out col_split:col_split kept_cols:kept_cols xfs_before:xfs_in xfs_after:xfs_out r_bound_before:r_bound_in" ;;
      esac
      for k in $keys; do
        [ -n "$(kv "$3" "${k#*:}")" ] || return 1
        [ "$(kv "$2" "${k%%:*}")" = "$(kv "$3" "${k#*:}")" ] || return 1
      done
    }
    # numbers_in <line> <names...>: each named count a whole number.
    numbers_in() {
      local l=$1 n
      shift
      for n in "$@"; do
        case "$(kv "$l" "$n")" in '' | *[!0-9]*) return 1 ;; esac
      done
    }
    # line_as_spec <sample> <tool line>: what "Harness runs" expects of the
    # line (P1 ruling 6, P2 ruling 1; PC, QC).
    line_as_spec() {
      local n
      if [ "$1" = group ]; then
        numbers_in "$2" rows_before rows_present rows_after cols_before cols_after kept_cols || return 1
        [ "$(kv "$2" rows_present)" -le 3 ] || return 1
        [ "$(kv "$2" rows_after)" = "$(( $(kv "$2" rows_before) + 3 - $(kv "$2" rows_present) ))" ] || return 1
        [ "$(kv "$2" level_rows)" = 2 ] && [ "$(kv "$2" hidden_rows)" = 2 ] && [ "$(kv "$2" collapsed_rows)" = 1 ] || return 1
        for n in max_row_ok max_col_ok summary_ok; do
          [ "$(kv "$2" "$n")" = 1 ] || return 1
        done
        case "$(kv "$2" level_cols)" in 1 | 2) ;; *) return 1 ;; esac
      else
        numbers_in "$2" rows_before rows_present rows_after cols_before cols_after kept_cols xfs_before xfs_after || return 1
        [ "$(kv "$2" rows_present)" -le 1 ] || return 1
        [ "$(kv "$2" rows_after)" = "$(( $(kv "$2" rows_before) + 1 - $(kv "$2" rows_present) ))" ] || return 1
        [ "$(kv "$2" row_style_ok)" = 1 ] && [ "$(kv "$2" col_style_ok)" = 1 ] || return 1
        [ "$(kv "$2" xfs_after)" = "$(( $(kv "$2" xfs_before) + 1 ))" ] || return 1
        case "$(kv "$2" col_split)" in 1 | 2 | 3) ;; *) return 1 ;; esac
      fi
      case "$(kv "$2" r_bound_before)" in 0 | 1) return 0 ;; esac
      return 1
    }
    # surveyed_as <sample> <tool line> <id>: the line's before-figures are the
    # sample's survey's for the workbook (PD, QD).
    surveyed_as() {
      [ -n "$(surveyed "$1" "$3" 4)" ] || return 1
      [ "$(kv "$2" rows_before)" = "$(surveyed "$1" "$3" 4)" ] && [ "$(kv "$2" rows_present)" = "$(surveyed "$1" "$3" 5)" ] \
        && [ "$(kv "$2" cols_before)" = "$(surveyed "$1" "$3" 6)" ] || return 1
      if [ "$1" = group ]; then
        [ "$(kv "$2" r_bound_before)" = "$(surveyed "$1" "$3" 15)" ]
      else
        [ "$(kv "$2" xfs_before)" = "$(surveyed "$1" "$3" 9)" ] && [ "$(kv "$2" r_bound_before)" = "$(surveyed "$1" "$3" 12)" ]
      fi
    }
    ay_ctl() { if all_yes group "found=1"; then return 1; else return 0; fi; }
    check "control: all_yes refuses a line with no flags" "$(yn ay_ctl)"
    LINE_G=$(printf 'group\trows_before=20\trows_present=2\trows_after=21\tlevel_rows=2\thidden_rows=2\tcollapsed_rows=1\tcols_before=6\tcols_after=7\tlevel_cols=2\tmax_row_ok=1\tmax_col_ok=1\tsummary_ok=1\tkept_cols=6\tr_bound_before=1')
    LINE_L=$(printf 'linestyle\trows_before=20\trows_present=1\trows_after=20\trow_style_ok=1\tcols_before=6\tcols_after=8\tcol_style_ok=1\tcol_split=3\tkept_cols=2\txfs_before=15\txfs_after=16\tr_bound_before=1')
    CMP_G="rows_in=20 present=2 rows_out=21 cols_in=6 cols_out=7 level_cols=2 kept_cols=6 r_bound_in=1"
    CMP_L="rows_in=20 present=1 rows_out=20 cols_in=6 cols_out=8 col_split=3 kept_cols=2 xfs_in=15 xfs_out=16 r_bound_in=1"
    lin_ok() { line_as_spec group "$LINE_G" && line_as_spec linestyle "$LINE_L"; }
    check "control: line_as_spec accepts a line of each sample as the spec reads" "$(yn lin_ok)"
    lin_ctl() { if line_as_spec group "$(printf '%s' "$LINE_G" | sed 's/rows_after=21/rows_after=23/')"; then return 1; else return 0; fi; }
    check "control: line_as_spec refuses the group line with three rows created when two were present (P1 ruling 6)" "$(yn lin_ctl)"
    lin_ctl2() { if line_as_spec linestyle "$(printf '%s' "$LINE_L" | sed 's/rows_after=20/rows_after=21/')"; then return 1; else return 0; fi; }
    check "control: line_as_spec refuses the line style line with a row created where one was present (P2 ruling 1)" "$(yn lin_ctl2)"
    lin_ctl3() { if line_as_spec linestyle "$LINE_G"; then return 1; else return 0; fi; }
    check "control: line_as_spec refuses the group line read as the line style sample's" "$(yn lin_ctl3)"
    tac_ok() { tool_and_cmp group "$LINE_G" "$CMP_G" && tool_and_cmp linestyle "$LINE_L" "$CMP_L"; }
    check "control: tool_and_cmp accepts a pair of each sample that agrees" "$(yn tac_ok)"
    tac_ctl() { if tool_and_cmp group "$LINE_G" "$(printf '%s' "$CMP_G" | sed 's/cols_out=7/cols_out=8/')"; then return 1; else return 0; fi; }
    check "control: tool_and_cmp refuses a group pair whose col count disagrees" "$(yn tac_ctl)"
    tac_ctl2() { if tool_and_cmp linestyle "$LINE_L" "$(printf '%s' "$CMP_L" | sed 's/ xfs_out=16//')"; then return 1; else return 0; fi; }
    check "control: tool_and_cmp refuses a line style comparison line missing a key" "$(yn tac_ctl2)"
    sa_ctl() { if surveyed_as group "$LINE_G" no-such-id; then return 1; else return 0; fi; }
    check "control: surveyed_as refuses an id the survey has no line for" "$(yn sa_ctl)"
    sa_ok() {
      local -A SV_OUT
      SV_OUT[group]=$B/c-sa-g; SV_OUT[linestyle]=$B/c-sa-l
      printf 'wb\tx0\t9\t20\t2\t6\t1\t0\t1\tzero\tzero\t2\t0\t0\t1\t0\n' >"${SV_OUT[group]}"
      printf 'wb\tx0\t9\t20\t1\t6\t1\twider\t15\t3\t0\t1\n' >"${SV_OUT[linestyle]}"
      surveyed_as group "$LINE_G" x0 && surveyed_as linestyle "$LINE_L" x0
    }
    check "control: surveyed_as accepts planted survey lines equal to each line's figures" "$(yn sa_ok)"
    sa_ctl2() {
      local -A SV_OUT
      SV_OUT[linestyle]=$B/c-sa-l2
      printf 'wb\tx0\t9\t20\t0\t6\t1\twider\t15\t3\t0\t1\n' >"${SV_OUT[linestyle]}"
      if surveyed_as linestyle "$LINE_L" x0; then return 1; else return 0; fi
    }
    check "control: surveyed_as refuses a planted survey line whose present row differs" "$(yn sa_ctl2)"
    
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    # count_ok_where <summary> <column> <value>: among the rows whose outcome is ok.
    count_ok_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) { if ($i == c) k = i; if ($i == "outcome") o = i }; next } k && o && $o == "ok" && $k == v { n++ } END { print n + 0 }' "$1"; }
    sum_col() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { n += $k } END { print n + 0 }' "$1"; }
    # The parts each sample changes, and whether the input's entry for each sets
    # general purpose bit 3, read once per workbook from the input by the
    # sample's comparison (--parts: a part name, then its bit, per part) and
    # never printed (changes LC, LF and RE).
    declare -A NPARTS
    NPARTS[group]=1
    NPARTS[linestyle]=2
    for s in $SAMPLES; do
      while IFS="$TAB" read -r id ext; do
        python3 "${CMP[$s]}" "$CORPUS/corpus/$id.$ext" --parts >"$B/parts-$s-$id"
      done <"$B/order"
      # Read by manifest order, never by a glob over parts-*: the controls below
      # write parts-ctl beside them (change JJ).
      n_parts=$(while IFS="$TAB" read -r id ext; do cat "$B/parts-$s-$id"; done <"$B/order" | count_lines /dev/stdin)
      echo "  $s: the changed parts and their bit 3, read from every input: $n_parts lines"
      check "$s: the comparison found its ${NPARTS[$s]} changed part(s) in every input" "$(yn [ "$n_parts" = "$((2 * NPARTS[$s] * manifest_rows))" ])"
      n_bit3=$(while IFS="$TAB" read -r id ext; do sed -n 'n;p' "$B/parts-$s-$id"; done <"$B/order" | count_matches -Fx 1 /dev/stdin)
      n_bit0=$(while IFS="$TAB" read -r id ext; do sed -n 'n;p' "$B/parts-$s-$id"; done <"$B/order" | count_matches -Fx 0 /dev/stdin)
      echo "  $s: input entries of those parts that set bit 3: $n_bit3; do not: $n_bit0; of $((NPARTS[$s] * manifest_rows))"
      check "$s: every changed part's input entry was read for bit 3 (1 or 0)" "$(yn [ "$((n_bit3 + n_bit0))" = "$((NPARTS[$s] * manifest_rows))" ])"
    done
    # entries_table <entries> <id> <parts file>: the runner's rows for one
    # workbook as changes LC, LF and RE give them: each part the parts file
    # names changed, flagged descriptor exactly when its input entry sets bit 3,
    # else unflagged; every other row identical and unflagged (the calculation
    # chain among them, change RF); nothing added, recompressed or dropped.
    entries_table() {
      local want
      want=$(awk 'NR % 2 == 1 { n[$0] = 1; k++ } NR % 2 == 0 && $0 != "0" && $0 != "1" { bad++ } END { if (bad || k == 0 || length(n) != k) exit 1; print k }' "$3") || return 1
      awk -F'\t' -v id="$2" -v want="$want" -v parts="$3" '
        BEGIN { while ((getline name < parts) > 0) { getline bit < parts; changed[name] = bit } }
        NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next }
        $col["id"] != id { next }
        {
          n++
          nm = $col["name"]
          if (nm in changed) {
            if ($col["status"] != "changed") bad++
            if ($col["flags"] != (changed[nm] == "1" ? "descriptor" : "")) bad++
            nch++
          } else if ($col["status"] != "identical" || $col["flags"] != "") bad++
        }
        END { if (n == 0 || bad > 0 || nch != want) exit 1 }' "$1"
    }
    # want_flagged_of <parts file>: the flagged rows change LF expects, one for
    # each changed entry whose input sets bit 3.
    want_flagged_of() { sed -n 'n;p' "$1" | count_matches -Fx 1 /dev/stdin; }
    # chain_rows_of <entries> <id>: the workbook's calcChain rows, and those
    # identical and unflagged (change RF).
    chain_rows_of() {
      awk -F'\t' -v id="$2" '
        NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next }
        $col["id"] == id && $col["name"] == "xl/calcChain.xml" { n++; if ($col["status"] == "identical" && $col["flags"] == "") s++ }
        END { print n + 0, s + 0 }' "$1"
    }
    printf 'ws.xml\n1\nst.xml\n0\n' >"$B/parts-ctl"
    printf 'ws.xml\n0\nst.xml\n0\n' >"$B/parts-ctl0"
    printf 'ws.xml\n1\n' >"$B/parts-ctl1"
    {
      printf 'id\tname\tstatus\tflags\n'
      printf 'w\t[Content_Types].xml\tidentical\t\nw\tws.xml\tchanged\tdescriptor\nw\txl/calcChain.xml\tidentical\t\nw\tst.xml\tchanged\t\nw\tss.xml\tidentical\t\n'
    } >"$B/e-ctl.tsv"
    check "control: entries_table accepts the expected rows of a two-part workbook whose W entry sets bit 3" "$(yn entries_table "$B/e-ctl.tsv" w "$B/parts-ctl")"
    sed 's/ws.xml\tchanged\tdescriptor$/ws.xml\tchanged\t/' "$B/e-ctl.tsv" >"$B/e-ctl0.tsv"
    check "control: entries_table accepts the expected rows of a two-part workbook without bit 3" "$(yn entries_table "$B/e-ctl0.tsv" w "$B/parts-ctl0")"
    sed 's/st.xml\tchanged\t$/st.xml\tidentical\t/' "$B/e-ctl.tsv" >"$B/e-one.tsv"
    check "control: entries_table accepts the expected rows of a one-part workbook (the group sample's shape)" "$(yn entries_table "$B/e-one.tsv" w "$B/parts-ctl1")"
    en_one_two() { if entries_table "$B/e-ctl.tsv" w "$B/parts-ctl1"; then return 1; else return 0; fi; }
    check "control: entries_table refuses a second changed entry against one part" "$(yn en_one_two)"
    sed 's/ss.xml\tidentical\t$/ss.xml\tchanged\t/' "$B/e-ctl.tsv" >"$B/e-extra.tsv"
    en_extra() { if entries_table "$B/e-extra.tsv" w "$B/parts-ctl"; then return 1; else return 0; fi; }
    check "control: entries_table refuses another entry changed" "$(yn en_extra)"
    en_nost() { if entries_table "$B/e-one.tsv" w "$B/parts-ctl"; then return 1; else return 0; fi; }
    check "control: entries_table refuses rows where the second part is identical" "$(yn en_nost)"
    sed 's/ws.xml\tchanged\tdescriptor$/ws.xml\tchanged\trecompressed/' "$B/e-ctl.tsv" >"$B/e-flag.tsv"
    en_flag() { if entries_table "$B/e-flag.tsv" w "$B/parts-ctl"; then return 1; else return 0; fi; }
    check "control: entries_table refuses a changed row flagged other than descriptor" "$(yn en_flag)"
    en_nodesc() { if entries_table "$B/e-ctl0.tsv" w "$B/parts-ctl"; then return 1; else return 0; fi; }
    check "control: entries_table refuses no flag on a changed row whose input sets bit 3 (change LF)" "$(yn en_nodesc)"
    en_desc() { if entries_table "$B/e-ctl.tsv" w "$B/parts-ctl0"; then return 1; else return 0; fi; }
    check "control: entries_table refuses descriptor on a changed row whose input sets no bit 3 (change LF)" "$(yn en_desc)"
    { cat "$B/e-ctl.tsv"; printf 'w\tx.xml\tadded\t\n'; } >"$B/e-add.tsv"
    en_add() { if entries_table "$B/e-add.tsv" w "$B/parts-ctl"; then return 1; else return 0; fi; }
    check "control: entries_table refuses an added row" "$(yn en_add)"
    check "control: want_flagged_of counts the planted bit-3 workbook's one flagged row" "$(yn [ "$(want_flagged_of "$B/parts-ctl")" = 1 ])"
    check "control: want_flagged_of counts none for the planted workbook without bit 3" "$(yn [ "$(want_flagged_of "$B/parts-ctl0")" = 0 ])"
    check "control: chain_rows_of reads the planted workbook's one calcChain row, identical and unflagged" "$(yn [ "$(chain_rows_of "$B/e-ctl.tsv" w)" = "1 1" ])"
    sed 's/calcChain.xml\tidentical\t$/calcChain.xml\tchanged\t/' "$B/e-ctl.tsv" >"$B/e-chain.tsv"
    check "control: chain_rows_of reads a changed calcChain row as not identical" "$(yn [ "$(chain_rows_of "$B/e-chain.tsv" w)" = "1 0" ])"
    # refusal_of <run dir> <id> <label>: the layer's one "error: " line when the
    # row is a refusal (change BK), else nothing.
    refusal_of() { sed -n '1s/^error: //p' "$1/$2/stderr.$3.txt"; }
    
    echo
    echo "## the earlier phases' run directories, named by their record commits (change RC)"
    declare -A PREV_OUT PREV_REC PREV_STEM
    PREV_REC[group]=$P1_REC; PREV_REC[linestyle]=$P2_REC
    PREV_STEM[group]=m3p4-p1; PREV_STEM[linestyle]=m3p4-p2
    # prev_dir_ok <sample>: the earlier run directory holds both labels'
    # summaries.
    prev_dir_ok() { [ -s "${PREV_OUT[$1]}/summary.host.tsv" ] && [ -s "${PREV_OUT[$1]}/summary.i686.tsv" ]; }
    for s in $SAMPLES; do
      txt=$(git show --name-only --format= "${PREV_REC[$s]}" | LC_ALL=C "$G" -E "^records/${PREV_STEM[$s]}-.*[.]txt\$")
      name=${txt#records/${PREV_STEM[$s]}-}; name=${name%.txt}
      PREV_OUT[$s]=$CORPUS/runs/$name
      echo "command: git show --name-only --format= ${PREV_REC[$s]}, the run record .txt it added"
      echo "  $s: the run record $txt; its run directory <corpus>/runs/$name"
      check "$s: the record commit added exactly one run record .txt" "$(yn [ "$(printf '%s\n' "$txt" | count_lines /dev/stdin)" = 1 ])"
      check "$s: the earlier run directory is there, with both labels' summaries" "$(yn prev_dir_ok "$s")"
    done
    prev_dir_ctl() { local -A PREV_OUT; PREV_OUT[x]=$B/no-such-run; if prev_dir_ok x; then return 1; else return 0; fi; }
    check "control: prev_dir_ok refuses a run directory that is not there" "$(yn prev_dir_ctl)"
    outcomes() { awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["outcome"] "\t" $k["exit"] }' "$1" | LC_ALL=C sort; }
    # same_as_prev <this run dir> <earlier run dir> <label> <which>: every
    # workbook's outcome and exit the earlier run's; every ok workbook's output
    # by sha256, line and diff table the earlier run's; prints per workbook and
    # the totals (M3 part 3 P4's change OC).
    same_as_prev() {
      local now_dir=$1 prev_dir=$2 label=$3 which=$4 id ext now prev nsame=0 nlines=0 ndiff=0 nok=0 nref=0 nrefsame=0 st
      outcomes "$now_dir/summary.$label.tsv" >"$B/o-now-$which-$label"
      outcomes "$prev_dir/summary.$label.tsv" >"$B/o-prev-$which-$label"
      echo "  rows: this run $(count_lines "$B/o-now-$which-$label"); the earlier run's $(count_lines "$B/o-prev-$which-$label"); outcome ok here $(count_matches -E "${TAB}ok${TAB}" "$B/o-now-$which-$label")"
      while IFS="$TAB" read -r id ext; do
        st=$(awk -F'\t' -v id="$id" '$1 == id { print $2 }' "$B/o-now-$which-$label")
        if [ "$st" != ok ]; then
          nref=$((nref + 1))
          if cmp -s "$now_dir/$id/stderr.$label.txt" "$prev_dir/$id/stderr.$label.txt"; then nrefsame=$((nrefsame + 1)); else echo "    $id: the error lines differ"; fi
          continue
        fi
        nok=$((nok + 1))
        now=$(sha_of "$now_dir/$id/out.$label.$ext"); prev=$(sha_of "$prev_dir/$id/out.$label.$ext")
        printf '    %s %s: sha256 here %s, earlier %s\n' "$id" "$label" "$now" "$prev"
        if [ "$now" = "$prev" ]; then nsame=$((nsame + 1)); else echo "    $id: the outputs differ"; fi
        if cmp -s "$now_dir/$id/stdout.$label.txt" "$prev_dir/$id/stdout.$label.txt"; then nlines=$((nlines + 1)); else echo "    $id: the lines differ"; fi
        if cmp -s "$now_dir/$id/diff.$label.tsv" "$prev_dir/$id/diff.$label.tsv"; then ndiff=$((ndiff + 1)); else echo "    $id: the diff tables differ"; fi
      done <"$B/order"
      echo "  $label: ok workbooks $nok; outputs equal to the earlier run's by sha256 $nsame; lines equal byte for byte $nlines; diff tables equal $ndiff; refused workbooks $nref; their error lines equal $nrefsame"
      printf '%s %s %s %s %s %s\n' "$nok" "$nsame" "$nlines" "$ndiff" "$nref" "$nrefsame" >"$B/same-$which-$label"
    }
    # same_counts_ok <which> <label>: the outcomes equal, every workbook ok with
    # the same output, line and diff table.
    same_counts_ok() {
      local nok nsame nlines ndiff nref nrefsame
      read -r nok nsame nlines ndiff nref nrefsame <"$B/same-$1-$2"
      cmp -s "$B/o-now-$1-$2" "$B/o-prev-$1-$2" && [ "$nok" = "$manifest_rows" ] && [ "$nref" = 0 ] && [ "$nsame" = "$nok" ] && [ "$nlines" = "$nok" ] && [ "$ndiff" = "$nok" ]
    }
    
    echo
    echo "## TMPDIR for the corpus runs, on the disk (change LG)"
    RUNTMP=$B/tmp-run
    mkdir "$RUNTMP" || exit 2
    dev_tmp=$(stat -c %d "$RUNTMP")
    dev_corpus=$(stat -c %d "$CORPUS/corpus")
    dev_proc=$(stat -c %d /proc)
    echo "command: mkdir <work>/tmp-run; stat -c %d <work>/tmp-run <corpus>/corpus /proc; df --output=fstype,target <work>/tmp-run <corpus>/corpus"
    echo "  device of TMPDIR (<work>/tmp-run): $dev_tmp; of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    df --output=fstype,target "$RUNTMP" "$CORPUS/corpus" | sed 's/^/    /'
    check "TMPDIR for the corpus runs and the corpus directory are on one device" "$(yn [ "$dev_tmp" = "$dev_corpus" ])"
    dev_ctl() { if [ "$dev_proc" = "$dev_corpus" ]; then return 1; else return 0; fi; }
    check "control: the same comparison tells /proc's device from the corpus directory's" "$(yn dev_ctl)"
    
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, want_changed, want_added, tool_arg = sys.argv[1:8]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        changed_f = sorted(f for f in fam if fam[f].get("changed"))
        dropped_f = sorted(f for f in fam if fam[f].get("dropped"))
        added_f = sorted(f for f in fam if fam[f].get("added"))
        # Change CD: the families the --parts lines imply, changed and added;
        # nothing dropped.
        checks.append(("%s: the xml families are the changed entries' families" % label, sorted(xf) == changed_f))
        checks.append(("%s: the changed entries' families are %s" % (label, want_changed), changed_f == want_changed.split(",")))
        checks.append(("%s: no entry is dropped" % label, dropped_f == []))
        # Change JC: no family added is the empty list, not a list of one empty
        # name.
        checks.append(("%s: the added entries' families are %s" % (label, want_added or "none"), added_f == (want_added.split(",") if want_added else [])))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: " + tool_arg in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    inst_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
    # Change JI: no bytecode was written, so there is nothing to remove.
    no_pycache() { [ ! -e scripts/__pycache__ ]; }
    declare -A CASES_OF
    CASES_OF[group]="created_sheetpr"
    CASES_OF[linestyle]="case"
    for s in $SAMPLES; do
      O=${OUT_OF[$s]}
      EDIT=--$s-sample
      for label in host i686; do
        var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
        echo
        echo "## $label run, --tool-arg $EDIT (change RC)"
        echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <sizebuild>/target/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <sizebuild>/target/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --out <runs>/$RUN-$s --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
        started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$O" \
          --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
          >"$B/run-$s-$label.stdout" 2>"$B/run-$s-$label.stderr" </dev/null
        rc=$?
        echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$s-$label.stderr")"
        sed 's/^/    /' "$B/run-$s-$label.stdout"
        check "$s $label: the run exits 0" "$(yn [ "$rc" = 0 ])"
        check "$s $label: its stderr is empty" "$(yn [ ! -s "$B/run-$s-$label.stderr" ])"
        n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
        echo "  entries left in <work>/tmp-run after the run: $n_left"
        check "$s $label: the runs' TMPDIR is empty after the run (change LG)" "$(yn [ "$n_left" = 0 ])"
        SUM=$O/summary.$label.tsv
        ENT=$O/entries.$label.tsv
        rows=$(awk 'NR > 1' "$SUM" | wc -l)
        n_ok=$(count_where "$SUM" outcome ok)
        # Change BK: the refusals, by id and message.
        : >"$B/refused-$s-$label"
        while IFS="$TAB" read -r id ext; do
          if [ "$(awk -F'\t' -v id="$id" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id { print $k["outcome"] " " $k["exit"] }' "$SUM")" = "error 2" ] \
             && [ "$(count_lines "$O/$id/stderr.$label.txt")" = 1 ] && [ -n "$(refusal_of "$O" "$id" "$label")" ]; then
            printf '%s\t%s\n' "$id" "$(refusal_of "$O" "$id" "$label")" >>"$B/refused-$s-$label"
          fi
        done <"$B/order"
        n_ref=$(count_lines "$B/refused-$s-$label")
        echo "  summary rows: $rows; outcome ok: $n_ok; refused by the layer (a finding, change BK; fails the summary, change RE): $n_ref"
        sed 's/^/    refused: /' "$B/refused-$s-$label"
        echo "  among the ok rows: lo ok $(count_ok_where "$SUM" lo ok); lo_in ok $(count_ok_where "$SUM" lo_in ok); leftover no $(count_ok_where "$SUM" leftover no); order_preserved yes $(count_ok_where "$SUM" order_preserved yes); comment_equal yes $(count_ok_where "$SUM" comment_equal yes); files_identical no $(count_ok_where "$SUM" files_identical no)"
        echo "  every row: lo_in ok $(count_where "$SUM" lo_in ok); leftover no $(count_where "$SUM" leftover no)"
        echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
        # The totals the inputs imply over the ok rows: the sample's parts
        # changed in each, nothing added (change RE), each flagged descriptor
        # where its input entry sets bit 3 (change LF).
        want_changed=$((NPARTS[$s] * n_ok)); want_added=0; want_flagged=0
        while IFS="$TAB" read -r id ext; do
          if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$s-$label")" ]; then continue; fi
          want_flagged=$((want_flagged + $(want_flagged_of "$B/parts-$s-$id")))
        done <"$B/order"
        echo "  the entry totals the inputs imply: changed $want_changed, added $want_added, flagged $want_flagged"
        summary_ok() {
          local col
          [ "$rows" = "$manifest_rows" ] || return 1
          [ "$n_ok" = "$rows" ] && [ "$n_ref" = 0 ] || return 1
          for col in "lo ok" "lo_in ok" "leftover no" "order_preserved yes" "comment_equal yes" "files_identical no"; do
            [ "$(count_ok_where "$SUM" ${col% *} ${col#* })" = "$n_ok" ] || return 1
          done
          [ "$(count_where "$SUM" lo_in ok)" = "$rows" ] || return 1
          [ "$(count_where "$SUM" leftover no)" = "$rows" ] || return 1
          [ "$(sum_col "$SUM" changed)" = "$want_changed" ] || return 1
          [ "$(sum_col "$SUM" added)" = "$want_added" ] || return 1
          [ "$(sum_col "$SUM" flagged)" = "$want_flagged" ] || return 1
          [ "$(sum_col "$SUM" recompressed)$(sum_col "$SUM" dropped)" = 00 ]
        }
        check "$s $label: every row ok (change RE); every row's input opens (lo_in ok) with no leftover; every output opens (lo ok), order and comment kept, files not identical; the changed, added and flagged totals as the inputs imply ($want_changed, $want_added, $want_flagged), none recompressed or dropped" "$(yn summary_ok)"
        echo "  per ok workbook: id, the tool's line, the comparison's line (counts and yes/no only)"
        : >"$B/lines-$s-$label"
        : >"$B/cases-$s-$label"
        : >"$B/shapes-$s-$label"
        nwb=0; nflags=0; nagree=0; nline=0; nentries=0; nsurvey=0; io=0; io_want=0; oo=0; oo_want=0; fl=0; fl_want=0
        nchain=0; nchain_same=0; npresent=0; nhidden=0; nhidden_any=0
        while IFS="$TAB" read -r id ext; do
          if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$s-$label")" ]; then continue; fi
          nwb=$((nwb + 1))
          e=$(cat "$O/$id/stdout.$label.txt")
          c=$(python3 "${CMP[$s]}" "$CORPUS/corpus/$id.$ext" "$O/$id/out.$label.$ext" --diff "$O/$id/diff.$label.tsv")
          printf '%s\t%s\n' "$id" "$e" >>"$B/lines-$s-$label"
          printf '    %s %s\n' "$id" "$(printf '%s' "$e" | tr '\t' ' ')"
          printf '    %s cmp %s\n' "$id" "$(printf '%s' "$c" | tr '\t' ' ')"
          # Change RI: the created and kept cases as P1 (PI: <sheetPr>) and P2
          # (QI: column 9's <col>) defined them, and the present row.
          printf '%s\t%s\t%s\n' "$id" "$(kv "$c" "${CASES_OF[$s]}")" "$(kv "$c" edited_rows)" >>"$B/cases-$s-$label"
          printf 'case=%s created_cols=%s created_rows=%s edited_rows=%s\n' \
            "$(kv "$c" "${CASES_OF[$s]}")" "$(kv "$c" created_cols)" "$(kv "$c" created_rows)" "$(kv "$c" edited_rows)" >>"$B/shapes-$s-$label"
          npresent=$((npresent + $(kv "$c" edited_rows)))
          if [ "$s" = group ]; then
            nhidden=$((nhidden + $(kv "$c" hidden_cols))); nhidden_any=$((nhidden_any + $(kv "$c" hidden_any_cols)))
          fi
          if LC_ALL=C "$G" -qxF "$id" "$B/chain-ids"; then
            cr=$(chain_rows_of "$ENT" "$id")
            nchain=$((nchain + ${cr% *})); nchain_same=$((nchain_same + ${cr#* }))
          fi
          io=$((io + $(kv "$c" in_only))); io_want=$((io_want + $(kv "$c" in_only_want)))
          oo=$((oo + $(kv "$c" out_only))); oo_want=$((oo_want + $(kv "$c" out_only_want)))
          fl=$((fl + $(kv "$c" flagged_rows))); fl_want=$((fl_want + $(kv "$c" flagged_want)))
          if all_yes "$s" "$c"; then nflags=$((nflags + 1)); else echo "    $id: a flag of the comparison does not hold"; fi
          if tool_and_cmp "$s" "$e" "$c"; then nagree=$((nagree + 1)); else echo "    $id: the tool and the comparison disagree"; fi
          if line_as_spec "$s" "$e"; then nline=$((nline + 1)); else echo "    $id: the tool's line is not what the edit implies"; fi
          if surveyed_as "$s" "$e" "$id"; then nsurvey=$((nsurvey + 1)); else echo "    $id: the tool's before-figures are not the survey's"; fi
          if entries_table "$ENT" "$id" "$B/parts-$s-$id"; then nentries=$((nentries + 1)); else echo "    $id: the entry rows are not what the sample implies"; fi
        done <"$B/order"
        echo "  ok workbooks read: $nwb; every flag holds: $nflags; the tool and the comparison agree: $nagree; the line as the spec reads: $nline; the before-figures the survey's: $nsurvey; entry rows as the sample implies: $nentries"
        echo "  the shapes of the edit over the ok workbooks:"
        LC_ALL=C sort "$B/shapes-$s-$label" | uniq -c | sed 's/^/    /'
        echo "  the xml values rows over the ok workbooks: in_only $io, out_only $oo; the one-sided values the design removes and writes, counted by the comparison: $io_want and $oo_want (change LF)"
        echo "  the flagged entry rows over the ok workbooks: $fl; changed entries whose input sets bit 3: $fl_want (change LF)"
        check "$s $label: the comparison read every ok workbook" "$(yn [ "$nwb" = "$n_ok" ])"
        check "$s $label: every flag of the comparison holds in every ok workbook" "$(yn [ "$nflags" = "$n_ok" ])"
        check "$s $label: the tool and the comparison agree in every ok workbook" "$(yn [ "$nagree" = "$n_ok" ])"
        check "$s $label: every line is what the edits imply" "$(yn [ "$nline" = "$n_ok" ])"
        check "$s $label: every line's before-figures and relationships prefix are the survey's (change RD)" "$(yn [ "$nsurvey" = "$n_ok" ])"
        check "$s $label: every ok workbook's entry rows are as the sample implies (change RE)" "$(yn [ "$nentries" = "$n_ok" ])"
        n_shapes=$(count_lines "$B/shapes-$s-$label")
        check "$s $label: one shape counted per ok workbook ($n_shapes)" "$(yn [ "$n_shapes" = "$n_ok" ])"
        vals_ok() { [ "$io" = "$io_want" ] && [ "$oo" = "$oo_want" ] && [ "$oo" -ge 1 ]; }
        check "$s $label: the in_only and out_only totals are the derived totals, and some value was written (change LF)" "$(yn vals_ok)"
        fl_ok() { [ "$fl" = "$fl_want" ] && [ "$fl" = "$(sum_col "$SUM" flagged)" ]; }
        check "$s $label: the flagged total is the derived total and the summary's (change LF)" "$(yn fl_ok)"
        echo "  rows edited in place over the ok workbooks (P1 ruling 6, P2 ruling 1): $npresent; the survey's: ${SV_PRESENT[$s]}"
        check "$s $label: the rows edited in place are the survey's present rows" "$(yn [ "$npresent" = "${SV_PRESENT[$s]}" ])"
        if [ "$s" = group ]; then
          echo "  <col> elements covering column 2 or 3 with a hidden attribute of any value, which the group dropped: $nhidden_any; the survey's: $SV_HIDDEN_ANY (change RG)"
          echo "  of them with hidden=\"1\", by the comparison: $nhidden; with hidden=\"1\" or hidden=\"true\", by the survey: $SV_HIDDEN (P1 verification ruling 1)"
          check "$s $label: the covering columns with any hidden attribute the comparison counted are the survey's (change RG)" "$(yn [ "$nhidden_any" = "$SV_HIDDEN_ANY" ])"
        fi
        echo "  calcChain rows in the ok rows of the chain workbooks: $nchain; identical and unflagged: $nchain_same (change RF)"
        chain_kept() { [ "$nchain" = "$N_CHAIN" ] && [ "$nchain_same" = "$nchain" ]; }
        check "$s $label: every chain workbook has one calcChain row, identical and unflagged (change RF)" "$(yn chain_kept)"
        same_as_prev "$O" "${PREV_OUT[$s]}" "$label" "$s"
        check "$s $label: every workbook's outcome, output (sha256), line and diff table are the earlier run's (change RC)" "$(yn same_counts_ok "$s" "$label")"
        R=$O/run.$label.tsv
        args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$R")
        bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
        check "$s $label: the run row records size.log's two binaries by sha256 and the phase commit" "$(yn bins_in_row)"
        check "$s $label: the run row's tool_args is $EDIT" "$(yn [ "$args" = "$EDIT" ])"
      done
      check "$s: the same workbooks are refused on both targets, with the same messages (none, change RE)" "$(yn cmp -s "$B/refused-$s-host" "$B/refused-$s-i686")"
    
      echo
      echo "### $s: the planted-flag controls, host, on the created case, the kept case and the first workbook whose row M + 1 is present (change RI)"
      # first_case <value>: the first ok workbook in manifest order whose case
      # field is the value; first_present: the first whose rows edited in
      # place are more than 0.
      first_case() { awk -F'\t' -v v="$1" '$2 == v { print $1; exit }' "$B/cases-$s-host"; }
      first_present() { awk -F'\t' '$3 > 0 { print $1; exit }' "$B/cases-$s-host"; }
      CASE_CREATED=$(first_case 1)
      CASE_KEPT=$(first_case 0)
      CASE_PRESENT=$(first_present)
      echo "  the created case: ${CASE_CREATED:-none}; the kept case: ${CASE_KEPT:-none}; the present-row case: ${CASE_PRESENT:-none}"
      three_cases() { [ -n "$CASE_CREATED" ] && [ -n "$CASE_KEPT" ] && [ -n "$CASE_PRESENT" ]; }
      check "$s: the corpus gives a created case, a kept case and a present-row case" "$(yn three_cases)"
      present_is_survey() { [ -n "$CASE_PRESENT" ] && [ "$(surveyed "$s" "$CASE_PRESENT" 5)" -ge 1 ]; }
      check "$s: the present-row case's row M + 1 is present by the survey too" "$(yn present_is_survey)"
      nplants=0; nbit_c=0; nbit_k=0; nbit_p=0
      for f in ${FLAGS_OF[$s]}; do
        nplants=$((nplants + 1))
        for case in created kept present; do
          case $case in created) id=$CASE_CREATED ;; kept) id=$CASE_KEPT ;; *) id=$CASE_PRESENT ;; esac
          planted=""
          if [ -n "$id" ]; then
            ext=$(awk -F'\t' -v id="$id" '$1 == id { print $2 }' "$B/order")
            planted=$(python3 "${CMP[$s]}" "$CORPUS/corpus/$id.$ext" "$O/$id/out.host.$ext" --diff "$O/$id/diff.host.tsv" --plant "$f")
          fi
          flag=$f
          turned() { [ -n "$planted" ] && [ "$(kv "$planted" "$flag")" = no ] && [ "$(kv "$planted" planted)" = yes ]; }
          echo "  plant $f on the $case case ${id:-none}: planted=$(kv "$planted" planted); $flag=$(kv "$planted" "$flag")"
          if turned; then
            case $case in created) nbit_c=$((nbit_c + 1)) ;; kept) nbit_k=$((nbit_k + 1)) ;; *) nbit_p=$((nbit_p + 1)) ;; esac
          fi
          check "$s: control: the plant $f on the $case case turns $flag to no" "$(yn turned)"
        done
      done
      echo "  $s: plants per case: $nplants; that turned their own flag: created $nbit_c, kept $nbit_k, present $nbit_p"
      check "$s: every flag has a plant that turned it on the created case ($nbit_c of $nplants)" "$(yn [ "$nbit_c" = "$nplants" ])"
      check "$s: every flag has a plant that turned it on the kept case ($nbit_k of $nplants)" "$(yn [ "$nbit_k" = "$nplants" ])"
      check "$s: every flag has a plant that turned it on the present-row case ($nbit_p of $nplants; ruling 3 of the P2 verification)" "$(yn [ "$nbit_p" = "$nplants" ])"
      first_ok=$(head -n 1 "$B/lines-$s-host" | cut -f1)
      first_ext=$(awk -F'\t' -v id="$first_ok" '$1 == id { print $2 }' "$B/order")
      unknown_plant() { [ "$(python3 "${CMP[$s]}" "$CORPUS/corpus/$first_ok.$first_ext" "$O/$first_ok/out.host.$first_ext" --plant no_such_flag)" = error=unknown-plant ]; }
      check "$s: control: the comparison refuses a plant it does not know" "$(yn unknown_plant)"
    
      echo
      echo "### $s: the two labels' outputs"
      same_out=0
      nboth=0
      while IFS="$TAB" read -r id ext; do
        if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$s-host")" ]; then continue; fi
        nboth=$((nboth + 1))
        if cmp -s "$O/$id/out.host.$ext" "$O/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
      done <"$B/order"
      echo "  ok workbooks: $nboth; whose host and i686 outputs are byte for byte the same: $same_out"
      check "$s: every output is the same on both targets" "$(yn [ "$same_out" = "$nboth" ])"
      check "$s: both targets printed the same line for every ok workbook" "$(yn cmp -s "$B/lines-$s-host" "$B/lines-$s-i686")"
    
      # The record pair (change RJ).
      STEM=${STEM_OF[$s]}
      echo
      echo "## the $s run's record pair (change RJ)"
      echo "command: scripts/passthrough-record.py --run <runs>/$RUN-$s --out <scripts>/out/records --stem $STEM"
      scripts/passthrough-record.py --run "$O" --out "$RECORDS" --stem "$STEM" >"$B/record-$s.out" 2>&1
      rrc=$?
      sed 's/^/    /' "$B/record-$s.out"
      check "$s: the record script exits 0" "$(yn [ "$rrc" = 0 ])"
      RTXT=$RECORDS/$STEM.txt
      RMD=$RECORDS/$STEM.md
      # The families the --parts lines imply (changes JC, QJ and RJ), over every
      # input, by the record script's own family rule, changed; nothing added.
      while IFS="$TAB" read -r id ext; do sed -n 'p;n' "$B/parts-$s-$id"; done <"$B/order" >"$B/names-$s.parts"
      check "$s: the changed parts read for every manifest row, by manifest order ($(count_lines "$B/names-$s.parts"))" "$(yn [ "$(count_lines "$B/names-$s.parts")" = "$((NPARTS[$s] * manifest_rows))" ])"
      FAM_CHANGED=$(python3 -c 'import importlib.util, sys
    spec = importlib.util.spec_from_file_location("record", sys.argv[1])
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    print(",".join(sorted({record.family(l) for l in open(sys.argv[2]).read().split() if l})))' scripts/passthrough-record.py "$B/names-$s.parts")
      FAM_ADDED=
      echo "  the families the inputs imply: changed $FAM_CHANGED; added ${FAM_ADDED:-none}"
      check "$s: the changed families were derived (some family)" "$(yn [ -n "$FAM_CHANGED" ])"
      python3 "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$EDIT" >"$B/reccheck-$s.out" 2>&1
      echo "  exit: $?"
      sed 's/^/    /' "$B/reccheck-$s.out"
      rec_all() { [ "$(count_matches -E ': yes$' "$B/reccheck-$s.out")" = 18 ] && [ "$(count_matches -E ': no$' "$B/reccheck-$s.out")" = 0 ]; }
      check "$s: the record's three tables are the run directory's, and its family tables are counted from them (eighteen checks: four, six per label, two)" "$(yn rec_all)"
      awk '!done && /^[|] total [|]/ { done = 1; next } { print }' "$RMD" >"$B/c-rec-$s.md"
      python3 "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$B/c-rec-$s.md" "$FAM_CHANGED" "$FAM_ADDED" "$EDIT" >"$B/c-reccheck-$s.out" 2>&1
      sed '2d' "$RTXT" >"$B/c-rec-$s.txt"
      python3 "$B/reccheck.py" scripts/passthrough-record.py "$O" "$B/c-rec-$s.txt" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$EDIT" >"$B/c-reccheck2-$s.out" 2>&1
      rec_ctl() { [ "$(count_matches -E ': no$' "$B/c-reccheck-$s.out")" -ge 1 ] && [ "$(count_matches -F "the summary table is every label's summary: no" "$B/c-reccheck2-$s.out")" = 1 ]; }
      check "$s: control: the same check finds an .md with a family table's total row dropped and a .txt one summary row short" "$(yn rec_ctl)"
      check "$s: the record script and the record check left no scripts/__pycache__ (PYTHONDONTWRITEBYTECODE)" "$(yn no_pycache)"
      echo "command: install -m 644 <scripts>/out/records/$STEM.md <scripts>/out/records/$STEM.txt <repo>/$RECORDS_DEST/"
      install -m 644 "$RMD" "$RTXT" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM.md" "$RECORDS_DEST/$STEM.txt")
      echo "  exit: $?"
      for f in "$STEM.md" "$STEM.txt"; do
        echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
        check "$s: the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
      done
    done
    
    echo
    echo "## the controls of the rerun's checks (change RL)"
    mkdir -p "$B/c-refrun/r1"
    printf 'error: a planted message\n' >"$B/c-refrun/r1/stderr.host.txt"
    ref_read() { [ "$(refusal_of "$B/c-refrun" r1 host)" = "a planted message" ]; }
    check "control: refusal_of reads a planted refusal's message" "$(yn ref_read)"
    : >"$B/c-refrun/r1/stderr.host.txt"
    ref_none() { [ -z "$(refusal_of "$B/c-refrun" r1 host)" ]; }
    check "control: refusal_of reads nothing from an empty standard error" "$(yn ref_none)"
    first_id=$(head -n 1 "$B/order" | cut -f1); first_ext=$(head -n 1 "$B/order" | cut -f2)
    cp "${OUT_OF[group]}/$first_id/out.host.$first_ext" "$B/c-out"; printf 'x' >>"$B/c-out"
    outc_ctl() { [ "$(sha_of "$B/c-out")" != "$(sha_of "${PREV_OUT[group]}/$first_id/out.host.$first_ext")" ]; }
    check "control: the same sha256 comparison tells the first output with one byte appended" "$(yn outc_ctl)"
    read -r a b c d e f <"$B/same-linestyle-host"
    printf '%s %s %s %s %s %s\n' "$a" "$b" "$((c - 1))" "$d" "$e" "$f" >"$B/same-ctl-host"
    cp "$B/o-now-linestyle-host" "$B/o-now-ctl-host"; cp "$B/o-prev-linestyle-host" "$B/o-prev-ctl-host"
    same_ctl() { if same_counts_ok ctl host; then return 1; else return 0; fi; }
    check "control: same_counts_ok refuses totals with one line differing" "$(yn same_ctl)"
    entries_ctl() {
      printf 'no/such/part.xml\n0\n' >"$B/c-parts"
      if entries_table "${OUT_OF[group]}/entries.host.tsv" "$first_id" "$B/c-parts"; then return 1; else return 0; fi
    }
    check "control: entries_table refuses the first workbook's rows against a part it does not change" "$(yn entries_ctl)"
    echo "the calc chain: $N_CHAIN of the corpus's $manifest_rows workbooks hold xl/calcChain.xml; for each sample on each label each of their calcChain entries is identical and unflagged, by the entries rule (every entry but W, and for the line style sample xl/styles.xml, identical and unflagged; no formula changes, so the formula-change rule does not fire), which keeps the chain"
    echo
    if [ "$RUN_SKIP_KEEP" = yes ]; then
    echo "## the keep and the open check: SKIPPED (RUN_SKIP_KEEP=yes, a dry run; change JE)"
    else
    echo "## the keep regenerated: the tests with the variable set, one keep directory per target"
    echo "command: read the test.log given (sha256 $(sha_of "$TEST_LOG"), $(wc -c <"$TEST_LOG") bytes)"
    tl_is_phase() { [ "$(count_matches -E "^about: M3 part 4 P3 phase commit $C; HEAD at run: $C\$" "$TEST_LOG")" = 1 ]; }
    check "the test.log read is this phase's, at this phase commit" "$(yn tl_is_phase)"
    tl_ctl() { local C=$NULL_SHA; if tl_is_phase; then return 1; else return 0; fi; }
    check "control: the same check says no for the null commit" "$(yn tl_ctl)"
    tl_unset() { [ "$(count_matches -xF 'EMEND_KEEP_DIR set when this script started: no; unset for the whole log: yes' "$TEST_LOG")" = 1 ]; }
    check "the test.log ran with the variable unset" "$(yn tl_unset)"
    tl_all_yes() { [ "$(count_matches -xF 'test log checks all as expected: yes' "$TEST_LOG")" = 1 ]; }
    check "the test.log ends all as expected" "$(yn tl_all_yes)"
    for target in host i686-unknown-linux-musl; do
      awk -v h="## cargo test --workspace ($target)" '
        $0 == h { on = 1; next }
        /^## / { on = 0 }
        on && /^    test .* \.\.\. ok$/ { sub(/^    test /, ""); sub(/ \.\.\. ok$/, ""); print }
      ' "$TEST_LOG" | sort >"$B/unset-$target.names"
      sed -n "s/^$target: passed \\([0-9]*\\); failed 0; ignored \\([0-9]*\\); test lines ending ok: [0-9]*\$/\\1 \\2/p" "$TEST_LOG" >"$B/unset-$target.count"
      echo "  $target without the variable: passed and ignored $(cat "$B/unset-$target.count"); names read $(count_lines "$B/unset-$target.names")"
      names_match_count() { [ -s "$B/unset-$target.count" ] && [ "$(count_lines "$B/unset-$target.names")" = "$(cut -d' ' -f1 "$B/unset-$target.count")" ]; }
      check "$target: the names read account for the passed count read" "$(yn names_match_count)"
    done
    mkdir "$KEEP" "$BUILD_ROOT/keep-i686.$$" || exit 2
    KI=$BUILD_ROOT/keep-i686.$$
    for target in host i686-unknown-linux-musl; do
      case $target in host) K=$KEEP; targs=() ;; *) K=$KI; targs=(--target "$target") ;; esac
      echo
      echo "### cargo test --workspace ($target), EMEND_KEEP_DIR=$K"
      echo "command: EMEND_KEEP_DIR=$K cargo test --workspace ${targs[*]}"
      EMEND_KEEP_DIR=$K cargo test --workspace "${targs[@]}" >"$B/$target.out" 2>&1 </dev/null
      rc=$?
      echo "  exit: $rc"
      check "$target: exit 0" "$(yn [ "$rc" -eq 0 ])"
      echo "  summary lines:"
      LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$B/$target.out" | sed 's/^ */    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$B/$target.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$B/set-$target.names"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      ignored=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^ignored;$/) n += $i } END { print n + 0 }' "$B/$target.out")
      echo "  $target with the variable: passed $passed; failed $failed; ignored $ignored; test lines ending ok $(count_lines "$B/set-$target.names")"
      check "$target: failed is 0" "$(yn [ "$failed" = 0 ])"
      check "$target: passed and ignored are the run's without the variable ($(cat "$B/unset-$target.count"))" "$(yn [ "$passed $ignored" = "$(cat "$B/unset-$target.count")" ])"
      check "$target: the test names that passed are the run's without the variable" "$(yn cmp -s "$B/set-$target.names" "$B/unset-$target.names")"
      echo "  files in the keep: $(find "$K" -type f | wc -l); entries that are not regular files: $(find "$K" -mindepth 1 ! -type f | wc -l)"
    done
    { head -n 1 "$B/unset-host.names"; cat "$B/unset-host.names"; } | sort >"$B/c-names"
    cmp_ctl() { if cmp -s "$B/c-names" "$B/unset-host.names"; then return 1; else return 0; fi; }
    check "control: the same comparison tells a name list with one name doubled from the real one" "$(yn cmp_ctl)"
    
    echo
    echo "## the two keep directories compared"
    (cd "$KEEP" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/host.files"
    (cd "$KI" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/i686.files"
    nfiles=$(count_lines "$B/host.files")
    same=0
    while IFS= read -r f; do
      if cmp -s "$KEEP/$f" "$KI/$f"; then same=$((same + 1)); else echo "    differs: $f"; fi
    done <"$B/host.files"
    echo "  files: host $nfiles, i686 $(count_lines "$B/i686.files"); the same bytes on both: $same"
    check "the two keeps hold the same names" "$(yn cmp -s "$B/host.files" "$B/i686.files")"
    keeps_same() { [ "$nfiles" -ge 2 ] && [ "$same" = "$nfiles" ]; }
    check "every file in the host keep is byte for byte the i686 keep's" "$(yn keeps_same)"
    first_kept=$(head -n 1 "$B/host.files")
    cp "$KEEP/$first_kept" "$B/c-copy"
    printf 'x' >>"$B/c-copy"
    cmp_bytes_ctl() { if cmp -s "$B/c-copy" "$KI/$first_kept"; then return 1; else return 0; fi; }
    check "control: cmp tells a kept file with one byte added from its original" "$(yn cmp_bytes_ctl)"
    n_in=$(count_matches -E '\.in\.xlsx$' "$B/host.files")
    n_out=$(count_matches -E '\.out\.xlsx$' "$B/host.files")
    n_other=$(count_matches -vE '^[A-Za-z0-9_.-]+\.[0-9]+\.(in|out)\.xlsx$' "$B/host.files")
    LC_ALL=C sed -nE 's/^(.*)\.in\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.names"
    LC_ALL=C sed -nE 's/^(.*)\.out\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.out.names"
    echo "  .in.xlsx $n_in; .out.xlsx $n_out; names not of the form <test>.<n>.in|out.xlsx: $n_other"
    all_pairs() { [ "$n_in" = "$n_out" ] && [ "$((n_in * 2))" = "$nfiles" ] && [ "$n_other" = 0 ] && cmp -s "$B/pair.names" "$B/pair.out.names"; }
    check "the keep holds only whole pairs named <test>.<n>" "$(yn all_pairs)"
    NPAIRS=$n_in
    (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/keep.listing"
    echo "  the host keep's listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/keep.listing"); files $(count_lines "$B/keep.listing"); listing sha256 $(sha_of "$B/keep.listing")"
    check "the host keep's pairs times two equals its files (keep_pairs_ok)" "$(yn keep_pairs_ok "$B/keep.listing")"
    # Change JI: the i686 keep is kept, not removed.
    check "the i686 keep stays beside the host keep under <build>, not removed (change JI)" "$(yn [ -d "$KI" ])"
    
    echo
    echo "## the host keep against M3 part 4 P2's committed open-check record, named by its record commit (changes AU, BP, BR, BW, CC, JB, LB, MB, NB, PB, QB and RB)"
    PREV_TXT=$(git show --name-only --format= "$PREV_OPEN_REC" | LC_ALL=C "$G" -E '^records/m3p4-open-.*[.]txt$')
    echo "command: git show --name-only --format= $PREV_OPEN_REC, the open-check .txt it added; git show <phase commit>:<it>"
    echo "  M3 part 4 P2's record: $PREV_TXT (sha256 $(git show "$C:$PREV_TXT" | sha256sum | cut -d' ' -f1))"
    check "M3 part 4 P2's record commit added exactly one open-check .txt" "$(yn [ "$(printf '%s\n' "$PREV_TXT" | count_lines /dev/stdin)" = 1 ])"
    no_later_open() { [ -z "$(git log --format=%H "$PREV_OPEN_REC..$C" -- 'records/*-open-*.txt')" ]; }
    check "no commit after it adds an open-check record, so it is the last committed" "$(yn no_later_open)"
    git show "$C:$PREV_TXT" >"$B/prev.txt"
    while IFS= read -r t; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$t" "$(stat -c %s "$KEEP/$t.in.xlsx")" "$(sha_of "$KEEP/$t.in.xlsx")" \
        "$(stat -c %s "$KEEP/$t.out.xlsx")" "$(sha_of "$KEEP/$t.out.xlsx")"
    done <"$B/pair.names" >"$B/keep.rows"
    tail -n +2 "$B/prev.txt" | cut -f1-5 | LC_ALL=C sort >"$B/prev.rows"
    LC_ALL=C sort "$B/keep.rows" >"$B/keep.sorted"
    n_prev=$(count_lines "$B/prev.rows")
    n_kept_prev=$(LC_ALL=C comm -12 "$B/prev.rows" "$B/keep.sorted" | count_lines /dev/stdin)
    cut -f1 "$B/prev.rows" >"$B/prev.names"
    LC_ALL=C comm -13 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/gone.pairs"
    echo "  rows: the regenerated keep $(count_lines "$B/keep.rows"), M3 part 4 P2's record $n_prev; its rows found in the keep with the same name, bytes and both sha256s: $n_kept_prev"
    echo "  pairs in the keep and not in M3 part 4 P2's record: $(count_lines "$B/new.pairs"); in its record and not in the keep: $(count_lines "$B/gone.pairs")"
    sed 's/^/    new: /' "$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.rows" "$B/keep.sorted" | cut -f1 >"$B/changed.pairs"
    echo "  pairs of M3 part 4 P2's record whose bytes differ in the keep: $(count_lines "$B/changed.pairs")"
    sed 's/^/    changed: /' "$B/changed.pairs"
    check "no pair of M3 part 4 P2's record is gone" "$(yn [ "$(count_lines "$B/gone.pairs")" = 0 ])"
    check "every pair of M3 part 4 P2's record is in the keep, unchanged or changed ($n_kept_prev + $(count_lines "$B/changed.pairs") = $n_prev)" "$(yn [ "$((n_kept_prev + $(count_lines "$B/changed.pairs")))" = "$n_prev" ])"
    echo "command: the #[test] functions added or whose body is edited since the named record commit, from the two commits' sources of every .rs file git diff --name-only <named record commit> <phase commit> names: <work>/edited.py, below"
    cat >"$B/edited.py" <<'PY'
    """The #[test] functions whose body differs between two commits, or that
    the second adds: each file's text at both commits (git show), every
    function after a #[test] attribute (other attributes allowed between), its
    body from the fn line to the first line that is a lone closing brace in
    column one. Prints one test name per line."""
    import re
    import subprocess
    import sys
    
    base, head = sys.argv[1:3]
    TEST = re.compile(r"#\[test\]\s*(?:#\[[^\]]*\]\s*)*fn\s+([A-Za-z0-9_]+)")
    
    
    def show(rev, path):
        run = subprocess.run(["git", "show", "%s:%s" % (rev, path)], capture_output=True)
        return run.stdout.decode() if run.returncode == 0 else ""
    
    
    def tests(text):
        out = {}
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            out[m.group(1)] = text[m.start():end if end >= 0 else len(text)]
        return out
    
    
    names = subprocess.run(["git", "diff", "--name-only", base, head, "--", "*.rs"],
                           capture_output=True, check=True).stdout.decode().split()
    edited = set()
    for path in names:
        before, after = tests(show(base, path)), tests(show(head, path))
        for name, body in after.items():
            if before.get(name) != body:
                edited.add(name)
    for name in sorted(edited):
        print(name)
    PY
    sed 's/^/    /' "$B/edited.py"
    # Change JF (M3 part 1 P3's IC): from the named record commit, since the
    # record compared with is its.
    python3 "$B/edited.py" "$PREV_OPEN_REC" "$C" | LC_ALL=C sort >"$B/edited.tests"
    sed 's/^/    added or edited test: /' "$B/edited.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/new.pairs" | LC_ALL=C sort -u >"$B/new.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/changed.pairs" | LC_ALL=C sort -u >"$B/changed.tests"
    echo "  tests with a new pair: $(count_lines "$B/new.tests"); tests with a changed pair: $(count_lines "$B/changed.tests"); tests added or edited: $(count_lines "$B/edited.tests")"
    check "some test is added or edited, so the list was read" "$(yn [ "$(count_lines "$B/edited.tests")" -ge 1 ])"
    new_from_edited() { [ "$(LC_ALL=C comm -23 "$B/new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every new pair is kept by a test this phase adds or edits" "$(yn new_from_edited)"
    changed_from_edited() { [ "$(LC_ALL=C comm -23 "$B/changed.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every changed pair of M3 part 4 P2's record is kept by a test this phase edits (the code under the other tests did not change what they write)" "$(yn changed_from_edited)"
    printf 'zzz_not_an_edited_test\n' | LC_ALL=C sort -m - "$B/new.tests" >"$B/c-new.tests"
    new_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a pair of a test the phase did not add or edit" "$(yn new_ctl)"
    
    echo
    echo "## scripts/edit-open-check.sh on the host keep (specs/0018 \"Harness runs\": every phase's run log runs it over its keep)"
    mkdir "$B/tmp"
    # Change MF (specs/0025 P1 verification ruling 3, L2): the open check's own
    # TMPDIR, its device beside the runs' and the corpus directory's.
    dev_open=$(stat -c %d "$B/tmp")
    echo "command: stat -c %d <work>/tmp <work>/tmp-run <corpus>/corpus /proc"
    echo "  device of the open check's TMPDIR (<work>/tmp): $dev_open; of the runs' TMPDIR (<work>/tmp-run): $(stat -c %d "$RUNTMP"); of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    check "the open check's TMPDIR and the corpus directory are on one device (change MF)" "$(yn [ "$dev_open" = "$dev_corpus" ])"
    dev_open_ctl() { if [ "$dev_proc" = "$dev_open" ]; then return 1; else return 0; fi; }
    check "control: the same comparison tells /proc's device from the open check's TMPDIR's" "$(yn dev_open_ctl)"
    echo "command: TMPDIR=<work>/tmp scripts/edit-open-check.sh --keep <keep> --libreoffice $IMAGE --out <scripts>/out/records --stem $STEM_OPEN"
    TMPDIR=$B/tmp scripts/edit-open-check.sh --keep "$KEEP" --libreoffice "$IMAGE" --out "$RECORDS" --stem "$STEM_OPEN" \
      >"$B/oc.stdout" 2>"$B/oc.stderr" </dev/null
    oc_rc=$?
    echo "  exit: $oc_rc"
    echo "  stdout:"; sed 's/^/    /' "$B/oc.stdout"
    echo "  stderr bytes: $(wc -c <"$B/oc.stderr")"
    check "the script exits 0 (no finding, no check errored)" "$(yn [ "$oc_rc" = 0 ])"
    check "its stderr is empty" "$(yn [ ! -s "$B/oc.stderr" ])"
    echo "  the reasons the script kept (its reasons directory under <work>/tmp), one line per refused side:"
    find "$B/tmp" -name '*-reason.txt' | LC_ALL=C sort | while IFS= read -r f; do echo "    ${f#"$B/tmp/"}: $(cat "$f")"; done
    TXT=$RECORDS/$STEM_OPEN.txt
    MD=$RECORDS/$STEM_OPEN.md
    TXT_HEADER=$(git show "$C:scripts/edit-open-check.sh" | sed -n "s/^readonly TXT_HEADER=\\$'\\(.*\\)'\$/\\1/p" | sed 's/\\t/\t/g')
    check "the .txt's header is the script's TXT_HEADER, read from the phase commit (nine columns)" "$(yn [ "$(head -n 1 "$TXT")" = "$TXT_HEADER" ])"
    tail -n +2 "$TXT" | cut -f1-5 >"$B/txt.rows"
    nrow_same=$(paste -d'\n' "$B/keep.rows" "$B/txt.rows" | awk 'NR % 2 == 1 { a = $0; next } a == $0 { n++ } END { print n + 0 }')
    echo "  rows: the keep $(count_lines "$B/keep.rows"), the .txt $(count_lines "$B/txt.rows"); rows whose name, bytes and hashes are the keep's, compared row by row: $nrow_same"
    rows_same() { [ "$(count_lines "$B/keep.rows")" = "$(count_lines "$B/txt.rows")" ] && [ "$nrow_same" = "$(count_lines "$B/keep.rows")" ] && [ "$nrow_same" = "$NPAIRS" ]; }
    check "every .txt row is one kept pair's name, byte counts and sha256s, in name order, one row per pair" "$(yn rows_same)"
    bad_rows=$(tail -n +2 "$TXT" | awk -F'\t' 'NF != 9 || $6 !~ /^(ok|fail|error)$/ || $7 !~ /^(ok|fail|error)$/ || $8 !~ /^(none|refused|count|error)$/ || $9 !~ /^(none|refused|count|error)$/' | wc -l)
    check "every row has nine columns, lo_in and lo each ok, fail or error, and each class none, refused, count or error ($bad_rows rows otherwise)" "$(yn [ "$bad_rows" = 0 ])"
    bad_fit=$(tail -n +2 "$TXT" | awk -F'\t' '{ print $6 ":" $8; print $7 ":" $9 }' | LC_ALL=C "$G" -cvxE 'ok:none|fail:refused|fail:count|error:error')
    check "every side's class fits its verdict ($bad_fit sides otherwise)" "$(yn [ "$bad_fit" = 0 ])"
    stdout_rows() { [ "$(awk -F'\t' 'NF == 3' "$B/oc.stdout")" = "$(tail -n +2 "$TXT" | cut -f1,6,7)" ]; }
    check "the script's per-pair stdout lines are the .txt's test, lo_in and lo columns" "$(yn stdout_rows)"
    echo "command: python3 <work>/wb.py over each kept input: its xl/workbook.xml entry, its sheet elements by local name (expat, no pattern) and of them those with a prefix"
    cat >"$B/wb.py" <<'PY'
    import sys, zipfile
    from xml.parsers import expat
    for path in sys.argv[1:]:
        name = path.rsplit("/", 1)[1][: -len(".in.xlsx")]
        try:
            z = zipfile.ZipFile(path)
        except zipfile.BadZipFile:
            print("%s\tunreadable\t-\t-" % name)
            continue
        if "xl/workbook.xml" not in z.namelist():
            print("%s\tno\t-\t-" % name)
            continue
        found = {"all": 0, "prefixed": 0}
    
        def start(tag, attrs):
            prefix, _, local = tag.rpartition(":")
            if local == "sheet":
                found["all"] += 1
                found["prefixed"] += 1 if prefix else 0
        p = expat.ParserCreate()
        p.StartElementHandler = start
        try:
            p.Parse(z.read("xl/workbook.xml"), True)
        except expat.ExpatError:
            print("%s\tyes\tunparsed\t-" % name)
            continue
        print("%s\tyes\t%d\t%d" % (name, found["all"], found["prefixed"]))
    PY
    sed 's/^/    /' "$B/wb.py"
    python3 "$B/wb.py" $(sed "s#^#$KEEP/#; s#\$#.in.xlsx#" "$B/pair.names") | LC_ALL=C sort >"$B/wb.all"
    echo "  kept inputs by workbook entry and sheet elements (entry, all, prefixed: pairs):"
    cut -f2- "$B/wb.all" | sort | uniq -c | sed 's/^/    /'
    echo "  the .md checked against the .txt and the kept inputs, with the heading specs/0015 P2 verification ruling 1 gives: <work>/mdcheck.py, below"
    cat >"$B/mdcheck.py" <<'PY'
    import sys
    txt, md, wb = sys.argv[1:4]
    rows = [l.split("\t") for l in open(txt).read().split("\n")[1:] if l]
    sheets = {l.split("\t")[0]: l.split("\t")[2] for l in open(wb).read().split("\n") if l}
    text = open(md).read().split("\n")
    REFUSED = ("Inputs refused by LibreOffice (allowed: a fixture LibreOffice cannot load: zip-level,"
               " or a package with no relationships part or an empty content-types root)")
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line:
                out.append(line)
        return out
    
    
    def listed(names):
        return ["- `%s`" % n for n in names] if names else ["None."]
    
    
    def count(col, v):
        return sum(1 for r in rows if r[col] == v)
    
    
    totals = [len(rows)] + [count(5, v) for v in ("ok", "fail", "error")] + [count(6, v) for v in ("ok", "fail", "error")]
    classes = ["| %s | " % side + " | ".join(str(count(col, c)) for c in ("none", "refused", "count", "error")) + " |"
               for side, col in (("reason_in", 7), ("reason_out", 8))]
    tot = section("Totals")
    checks = [
        ("Totals", tot[2:3] == ["| " + " | ".join(str(t) for t in totals) + " |"] and tot[5:] == classes),
        ("the refused-inputs heading reads as ruled, once", text.count("## " + REFUSED) == 1),
        ("Inputs refused by LibreOffice", section(REFUSED) == listed([r[0] for r in rows if r[7] == "refused"])),
        ("the sheet count did not apply", section("Inputs the sheet count did not apply to (allowed: a workbook fixture with no sheet element)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) == "0"])),
        ("counts differ", section("Inputs whose sheet and table counts differ (a finding)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) != "0"])),
        ("Outputs refused on an accepted input", section("Outputs refused on an input LibreOffice accepted (a finding)") == listed([r[0] for r in rows if r[6] == "fail" and r[5] == "ok"])),
        ("Checks that did not run", section("Checks that did not run (error)") == listed([r[0] for r in rows if "error" in (r[5], r[6])])),
        ("Pairs", section("Pairs")[2:] == ["| `%s` | %s | %s | %s | %s | %s | %s | %s | %s |" % tuple(r) for r in rows]),
        ("the Pairs line", ("- Pairs: %d" % len(rows)) in text),
    ]
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("totals: pairs %d; lo_in ok %d fail %d error %d; lo ok %d fail %d error %d" % tuple(totals))
    PY
    sed 's/^/    /' "$B/mdcheck.py"
    python3 "$B/mdcheck.py" "$TXT" "$MD" "$B/wb.all" >"$B/mdcheck.out"
    sed 's/^/    /' "$B/mdcheck.out"
    md_all() { [ "$(count_matches -E ': yes$' "$B/mdcheck.out")" = 9 ] && [ "$(count_matches -E ': no$' "$B/mdcheck.out")" = 0 ]; }
    check "the .md's nine parts are derived from the .txt and the kept inputs' sheet elements, the heading as ruled" "$(yn md_all)"
    head -n 2 "$TXT" >"$B/c-short.txt"
    python3 "$B/mdcheck.py" "$B/c-short.txt" "$MD" "$B/wb.all" >"$B/c-mdcheck.out"
    md_ctl() { [ "$(count_matches -E ': no$' "$B/c-mdcheck.out")" -ge 1 ]; }
    check "control: the same check on a .txt cut to one row finds the .md does not match it" "$(yn md_ctl)"
    OLD8=records/m1p8-open-2026-09-24-da080f1
    python3 "$B/mdcheck.py" "$OLD8.txt" "$OLD8.md" "$B/wb.all" >"$B/c-prevmd.out"
    old_heading() { [ "$(count_matches -F 'the refused-inputs heading reads as ruled, once: no' "$B/c-prevmd.out")" = 1 ]; }
    check "control: the same check on part 8 P2's committed .md finds the old heading, not the ruled one" "$(yn old_heading)"
    totals_line() { [ "$(sed -n 's/^wrote .*\.txt: \(pairs [^;]*; lo_in [^;]*; lo [^;]*\); inputs refused .*/\1/p' "$B/oc.stdout")" = "$(sed -n 's/^totals: //p' "$B/mdcheck.out")" ]; }
    check "the script's totals line is the totals derived from the .txt" "$(yn totals_line)"
    echo
    echo "### the verdicts against M3 part 4 P2's record"
    join -t "$TAB" <(tail -n +2 "$B/prev.txt" | cut -f1,6,7,8,9 | LC_ALL=C sort) <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) >"$B/both"
    check "every pair of M3 part 4 P2's record has a row in this record" "$(yn [ "$(count_lines "$B/both")" = "$n_prev" ])"
    awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9 { print $1 "\t" $2 "/" $3 "/" $4 "/" $5 " -> " $6 "/" $7 "/" $8 "/" $9 }' "$B/both" >"$B/moved"
    echo "  M3 part 4 P2's pairs whose lo_in, lo or either class changed: $(count_lines "$B/moved")"
    sed 's/^/    /' "$B/moved"
    check "no verdict and no class of M3 part 4 P2's pairs moved" "$(yn [ "$(count_lines "$B/moved")" = 0 ])"
    printf 'x\tok\tok\tnone\tnone\tok\tfail\tnone\trefused\n' >"$B/c-both"
    moved_ctl() { [ "$(awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9' "$B/c-both" | wc -l)" = 1 ]; }
    check "control: the same form finds a planted row whose lo moved" "$(yn moved_ctl)"
    echo "  the new pairs' verdicts (test, lo_in, lo, reason_in, reason_out):"
    join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) | sed 's/^/    /'
    no_new_finding() { [ "$(join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7 | LC_ALL=C sort) | awk -F'\t' '$2 == "ok" && $3 != "ok"' | wc -l)" = 0 ]; }
    check "no new pair's output is refused on an accepted input" "$(yn no_new_finding)"
    echo
    echo "### acceptance, and the inputs LibreOffice did not accept"
    tail -n +2 "$TXT" | awk -F'\t' -v OFS='\t' '{ print ($1 ~ /^emend-copy\./ ? "tool" : "crate"), $1, $6, $7, $8, $9 }' >"$B/verdicts"
    for side in crate tool; do
      n=$(awk -F'\t' -v s="$side" '$1 == s' "$B/verdicts" | wc -l)
      nfind=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "ok" && $4 == "fail"' "$B/verdicts" | wc -l)
      nerr=$(awk -F'\t' -v s="$side" '$1 == s && ($3 == "error" || $4 == "error")' "$B/verdicts" | wc -l)
      nin=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "fail"' "$B/verdicts" | wc -l)
      echo "  $side: pairs $n; inputs refused $nin; outputs refused on an accepted input $nfind; checks that did not run $nerr"
      check "$side: no output refused on an accepted input" "$(yn [ "$nfind" = 0 ])"
      check "$side: no check errored" "$(yn [ "$nerr" = 0 ])"
    done
    awk -F'\t' '$5 == "count" { print $2 }' "$B/verdicts" >"$B/count.pairs"
    awk -F'\t' '$2 == "yes" && $3 == "0" { print $1 }' "$B/wb.all" >"$B/zero.pairs"
    echo "  count-class inputs $(count_lines "$B/count.pairs"); kept inputs with a workbook entry and no sheet element $(count_lines "$B/zero.pairs")"
    check "the count-class inputs are exactly the kept inputs with a workbook entry and no sheet element, so no count differs" "$(yn cmp -s "$B/count.pairs" "$B/zero.pairs")"
    echo "  the pairs whose input LibreOffice did not accept, with the class of the input's reason:"
    awk -F'\t' '$3 != "ok" { print $2 "\t" $5 }' "$B/verdicts" | sed 's/^/    /'
    echo
    echo "### the open-check record installed into records/"
    echo "command: install -m 644 <scripts>/out/records/$STEM_OPEN.md <scripts>/out/records/$STEM_OPEN.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt")
    echo "  exit: $?"
    installed_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
    for f in "$STEM_OPEN.md" "$STEM_OPEN.txt"; do
      echo "    written <scripts>/out/records/$f: sha256 $(sha_of "$RECORDS/$f"), $(wc -c <"$RECORDS/$f") bytes"
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, byte for byte, mode 644" "$(yn installed_same "$f")"
    done
    TXT=$RECORDS_DEST/$STEM_OPEN.txt
    fi
    
    echo
    echo "## the record files this run installed hold no path (change JE: the list of the files installed)"
    echo "  record files installed by this run: ${#INSTALLED[@]}"
    no_path() {
      local f
      [ "${#INSTALLED[@]}" -ge 1 ] || return 1
      for f in "${INSTALLED[@]}"; do
        [ "$(count_matches -F "$HOME" "$f")" = 0 ] || return 1
        [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$f")" = 0 ] || return 1
      done
    }
    check "no record file this run installed names <home>, a home, mount, temporary or corpus path" "$(yn no_path)"
    n_inst_want=6
    if [ "$RUN_SKIP_KEEP" = yes ]; then n_inst_want=4; fi
    check "this run installed the record files it writes ($n_inst_want: the two run pairs, and the open pair unless the keep was skipped)" "$(yn [ "${#INSTALLED[@]}" = "$n_inst_want" ])"
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x' >"$B/c-path"
    path_ctl() { [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$B/c-path")" = 1 ]; }
    check "control: the same form finds a planted path" "$(yn path_ctl)"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  planning's uncommitted spec: $SPEC, sha256 $(sha_of "$SPEC")"
    echo "status lines: $st_all; of them this phase's logs, its record pairs or planning's uncommitted spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

