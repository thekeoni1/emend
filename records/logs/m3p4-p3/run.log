        if c is None:
            return []
        return [el for el in c if local(el.tag)[0] in MAIN and local(el.tag)[1] == "col"]
    
    
    def et_rows(root):
        d = et_first(root, "sheetData")
        if d is None:
            return []
        return [el for el in d if local(el.tag)[0] in MAIN and local(el.tag)[1] == "row"]
    
    
    def covering(cols, c):
        return next((e for e in cols if e[2] <= c <= e[3]), None)
    
    
    
    
    # --- this phase's design (specs/0026 "The calls", P2 rulings 1 and 2) ---
    
    COLUMN = 9
    FOUR = ("cols", "sheetData")
    FLAGS = ("rest_same", "places", "schema_order", "rows_kept", "row_window", "row_attrs",
             "cols_other", "cols_split", "cols_bytes", "w_bytes", "styles_xfs", "styles_fonts",
             "styles_rest", "others_same", "read_back", "xml_values", "flagged")
    STYLES_TYPES = (ATTR[0] + "/styles", ATTR[1] + "/styles")
    
    
    def styles_of(z, workbook):
        """The styles part's name, or None."""
        for (_, ty, t) in rels_of(z, workbook):
            if ty in STYLES_TYPES:
                return t
        return None
    
    
    def col_styled(tag, i):
        """A covering <col> piece with the style edit: style="i" in place or
        appended."""
        return with_attribute(tag, b"style", str(i).encode())
    
    
    class ColsOut:
        """The coalescing of P1 ruling 2 with P1 verification ruling 2: pieces
        and created elements merged with the one before them when it ends at the
        column before and the two are the same bytes with min and max set aside,
        content too; whitespace alone after a piece waiting is held, dropped when
        the next piece merges into it and written after it otherwise; anything
        else ends a merge."""
    
        def __init__(self):
            self.out = []
            self.open = None
            self.gap = b""
    
        def flush(self):
            if self.open is not None:
                tag, rest, mn, mx, widened = self.open
                self.out.append(col_retagged(tag, mn, mx) if widened else tag)
                self.out.append(rest)
                self.open = None
            self.out.append(self.gap)
            self.gap = b""
    
        def between(self, raw):
            if self.open is not None and raw.strip(b" \t\r\n") == b"":
                self.gap += raw
                return
            self.kept(raw)
    
        def kept(self, raw):
            self.flush()
            self.out.append(raw)
    
        def made(self, tag, rest, mn, mx):
            o = self.open
            if (o is not None and o[3] + 1 == mn and o[1] == rest
                    and col_retagged(o[0], 1, 1) == col_retagged(tag, 1, 1)):
                self.open = (o[0], o[1], o[2], mx, True)
                self.gap = b""
                return
            self.flush()
            self.open = (tag, rest, mn, mx, False)
    
        def finish(self):
            self.flush()
            return b"".join(self.out)
    
    
    def cols_content(data, ca, cb, cp, i):
        """The children of a <cols> (data[ca:cb], prefix cp) with the style edit
        on column 9, coalesced."""
        out = ColsOut()
        done = False
        last_max = 0
        at = ca
        for (x, y, nm) in children(data, ca, cb, cp, True):
            if x > at:
                out.between(data[at:x])
            at = y
            raw = data[x:y]
            if nm != "col":
                out.kept(raw)
                continue
            start = start_tag(raw)
            rest = raw[len(start):]
            mn, mx = col_span(start)
            if mn <= last_max:
                raise OutOfDesign("cols order")
            last_max = mx
            if not done and COLUMN < mn:
                out.made(col_styled(col_retagged(b"<" + cp + b"col/>", COLUMN, COLUMN), i), b"", COLUMN, COLUMN)
                done = True
            if not done and mn <= COLUMN <= mx:
                if COLUMN > mn:
                    out.made(col_retagged(start, mn, COLUMN - 1), rest, mn, COLUMN - 1)
                out.made(col_styled(col_retagged(start, COLUMN, COLUMN), i), rest, COLUMN, COLUMN)
                if COLUMN < mx:
                    out.made(col_retagged(start, COLUMN + 1, mx), rest, COLUMN + 1, mx)
                done = True
                continue
            out.kept(start)
            out.kept(rest)
        if cb > at:
            out.between(data[at:cb])
        if not done:
            out.made(col_styled(col_retagged(b"<" + cp + b"col/>", COLUMN, COLUMN), i), b"", COLUMN, COLUMN)
        return out.finish()
    
    
    def shape(w, root_ns):
        """W's root spans and prefix, its root children, and the spans of <cols>
        and <sheetData>."""
        ts, te, a, b, rp = root_span(w)
        kids = children(w, a, b, rp, root_ns in MAIN)
        return {"ts": ts, "te": te, "a": a, "b": b, "rp": rp, "kids": kids,
                "el": {n: [(x, y) for (x, y, nm) in kids if nm == n] for n in FOUR}}
    
    
    def row_sets(i):
        return ((b"s", str(i).encode()), (b"customFormat", b"1"))
    
    
    def design(win, s, m, i):
        """The W the design gives, its row M + 1's bytes and its <cols>' bytes;
        OutOfDesign when the write would refuse the input."""
        for n in FOUR:
            if len(s["el"][n]) > 1:
                raise OutOfDesign(n)
        if not s["el"]["sheetData"]:
            raise OutOfDesign("sheetData")
        rp = s["rp"]
        edits = []
        if s["el"]["cols"]:
            x, y = s["el"]["cols"][0]
            raw = win[x:y]
            tag = start_tag(raw)
            cp = split_name(qname(raw))[0]
            ca, cb = content_span(win, x, y)
            content = cols_content(win, ca, cb, cp, i)
            cols_el = (opened(tag) if tag.endswith(b"/>") else tag) + content + b"</" + qname(tag) + b">"
            edits.append((x, y, 0, cols_el))
        else:
            at = first_insert(s["kids"], TABLE.index("cols"), s["b"])
            cols_el = b"<" + rp + b"cols>" + cols_content(b"", 0, 0, rp, i) + b"</" + rp + b"cols>"
            edits.append((at, at, 0, cols_el))
        rows, (ca, cb), dp = rows_of(win, s)
        n = m + 1
        present = [(kx, ky, tag) for (kx, ky, r, tag) in rows if r == n]
        if present:
            kx, ky, tag = present[0]
            new = tag
            for (k, v) in row_sets(i):
                new = with_attribute(new, k, v)
            body = new + win[kx + len(tag):ky]
            row_edits = [(kx, kx + len(tag), new)]
        else:
            body = b"<" + dp + b'row r="' + str(n).encode() + b'"'
            for (k, v) in row_sets(i):
                body += b" " + k + b'="' + v + b'"'
            body += b"/>"
            after = next((kx for (kx, _, r, _) in rows if r is not None and r > n), cb)
            row_edits = [(after, after, body)]
        x, y = s["el"]["sheetData"][0]
        tag = start_tag(win[x:y])
        data = win[x:y]
        if tag.endswith(b"/>"):
            data = opened(tag) + b"</" + qname(tag) + b">"
            cb2 = len(opened(tag))
            row_edits = [(cb2, cb2, b) for (_, _, b) in row_edits]
        else:
            row_edits = [(a - x, b - x, v) for (a, b, v) in row_edits]
        edits.append((x, y, 1, apply(data, row_edits)))
        return apply(win, [(a, b, v) for (a, b, _, v) in sorted(edits, key=lambda e: (e[0], e[2]))]), body, cols_el
    
    
    def root_child(data, name):
        """(start, end, content start, content end) of the first main root child
        `name` of a part, or None."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        ts, te, a, b, rp = root_span(data)
        root_main = is_main(data[m.start():te], b"", False)
        for (x, y, nm) in children(data, a, b, rp, root_main):
            if nm == name:
                ca, cb = content_span(data, x, y)
                return x, y, ca, cb
        return None
    
    
    def main_kids(el, name):
        return [c for c in el if local(c.tag)[0] in MAIN and local(c.tag)[1] == name]
    
    
    VALUE_NS = MAIN
    
    
    def plant(flag, wout, sout, others, st):
        """(wout, sout, others) changed so that `flag` turns to no, or None when
        the pair gives the plant nothing to change."""
        s = shape(wout, st["root_ns"])
        o = dict(others)
        if any(len(s["el"][n]) != 1 for n in FOUR):
            return None
        m = st["m"]
    
        def tagged(data, at, tag, new):
            return data[:at] + new + data[at + len(tag):]
    
        def extra(tag):
            return tag[:-2] + b' planted="1"/>' if tag.endswith(b"/>") else tag[:-1] + b' planted="1">'
    
        if flag == "rest_same":
            return wout[:s["te"]] + COMMENT + wout[s["te"]:], sout, o
        if flag == "places":
            other = [(x, y) for (x, y, nm) in s["kids"] if nm not in (None,) + FOUR]
            if not other:
                return None
            x, y = other[0]
            return wout[:y] + wout[x:y] + wout[y:], sout, o
        if flag == "schema_order":
            x, y = s["el"]["cols"][0]
            el = wout[x:y]
            rest = wout[:x] + wout[y:]
            end = rest.rfind(b"</")
            return rest[:end] + el + rest[end:], sout, o
        rows, (ca, cb), _ = rows_of(wout, s)
        if flag == "rows_kept":
            return wout[:ca] + COMMENT + wout[ca:], sout, o
        if flag in ("row_window", "row_attrs"):
            hit = next(((kx, tag) for (kx, _, r, tag) in rows if r == m + 1), None)
            if hit is None:
                return None
            kx, tag = hit
            new = extra(tag) if flag == "row_window" else with_attribute(tag, b"customFormat", b"0")
            return tagged(wout, kx, tag, new), sout, o
        cols = col_elements(wout, s)
        if flag == "cols_other":
            lo, hi = st["span"]
            hit = next(((kx, tag) for (kx, _, mn, mx, tag) in cols if mx < lo or mn > hi), None)
            if hit is None:
                return None
            kx, tag = hit
            return tagged(wout, kx, tag, extra(tag)), sout, o
        if flag == "cols_split":
            hit = next(((kx, tag) for (kx, _, mn, mx, tag) in cols if mn <= COLUMN <= mx), None)
            if hit is None:
                return None
            kx, tag = hit
            return tagged(wout, kx, tag, with_attribute(tag, b"style", b"0")), sout, o
        if flag == "cols_bytes":
            x, y = s["el"]["cols"][0]
            ca2, _ = content_span(wout, x, y)
            return wout[:ca2] + COMMENT + wout[ca2:], sout, o
        if flag == "w_bytes":
            return wout + b"\n", sout, o
        if flag in ("styles_xfs", "styles_fonts"):
            el = root_child(sout, "cellXfs" if flag == "styles_xfs" else "fonts")
            if el is None:
                return None
            x, y, ca2, cb2 = el
            # The last child goes: one fewer than the design gives.
            kids = top_level(sout[ca2:cb2])
            if not kids:
                return None
            kx, ky = kids[-1]
            return wout, sout[:ca2 + kx] + sout[ca2 + ky:], o
        if flag == "styles_rest":
            ts, te, _, _, _ = root_span(sout)
            return wout, sout[:te] + COMMENT + sout[te:], o
        if flag == "others_same":
            name = next(iter(o), None)
            if name is None:
                return None
            o[name] = o[name] + COMMENT
            return wout, sout, o
        if flag == "read_back":
            hit = next(((kx, tag) for (kx, _, r, tag) in rows if r == m + 1), None)
            if hit is None:
                return None
            kx, tag = hit
            return tagged(wout, kx, tag, with_attribute(tag, b"s", b"0")), sout, o
        if flag in ("xml_values", "flagged"):
            return wout, sout, o
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        part = w_of(zin, wb)
        if part is None or part not in zin.namelist():
            print("error=no-worksheet")
            return
        sty = styles_of(zin, wb)
        if sty is None or sty not in zin.namelist():
            print("error=no-styles")
            return
        if args[1:] == ["--parts"]:
            print(part)
            print(bit3(zin, part))
            print(sty)
            print(bit3(zin, sty))
            return
        names_in_order = zin.namelist()
        win = zin.read(part)
        sin = zin.read(sty)
        root_i = ET.fromstring(win)
        sroot_i = ET.fromstring(sin)
        root_ns = local(root_i.tag)[0]
        zout = zipfile.ZipFile(args[1])
        rest = args[2:]
        diff_path = flag_plant = None
        while rest:
            if rest[0] == "--diff" and len(rest) >= 2:
                diff_path, rest = rest[1], rest[2:]
            elif rest[0] == "--plant" and len(rest) >= 2:
                flag_plant, rest = rest[1], rest[2:]
                if flag_plant not in FLAGS:
                    print("error=unknown-plant")
                    return
            else:
                print("error=usage")
                return
        out_names = zout.namelist()
        wout = zout.read(part) if part in out_names else b""
        sout = zout.read(sty) if sty in out_names else b""
        others = {nm: zout.read(nm) for nm in out_names if nm not in (part, sty)}
    
        xfs_in_el = et_first(sroot_i, "cellXfs")
        fonts_in_el = et_first(sroot_i, "fonts")
        if xfs_in_el is None or fonts_in_el is None:
            print("error=out-of-design")
            return
        xfs_in = len(main_kids(xfs_in_el, "xf"))
        fonts_in = len(main_kids(fonts_in_el, "font"))
        i = xfs_in
        m = max_row(root_i)
        s_in = shape(win, root_ns)
        try:
            want, want_row, want_cols = design(win, s_in, m, i)
        except OutOfDesign:
            print("error=out-of-design")
            return
        cols_in = col_elements(win, s_in)
        cov = covering(cols_in, COLUMN)
        span_lo, span_hi = (cov[2], cov[3]) if cov else (COLUMN, COLUMN)
        st = {"root_ns": root_ns, "m": m, "span": (span_lo, span_hi)}
        planted = False
        if flag_plant is not None:
            changed = plant(flag_plant, wout, sout, others, st)
            if changed is not None:
                wout, sout, others = changed
                planted = True
        extra = flag_plant if planted else None
    
        flags = dict.fromkeys(FLAGS, False)
        rows_in, _, _ = rows_of(win, s_in)
        present = [r for (_, _, r, _) in rows_in if r == m + 1]
        created_cols = 0 if s_in["el"]["cols"] else 1
        case = 1 if cov is None else (0 if (cov[2], cov[3]) != (COLUMN, COLUMN) else 2)
        rows_out_n = cols_out_n = col_split = kept_cols = xfs_out = -1
        if wout:
            s_out = shape(wout, root_ns)
            flags["rest_same"] = cut(win, [sp for n in FOUR for sp in s_in["el"][n]]) == \
                cut(wout, [sp for n in FOUR for sp in s_out["el"][n]])
            want_places = [nm for (_, _, nm) in s_in["kids"] if nm is not None]
            if created_cols:
                idx = TABLE.index("cols")
                at = next((k for (k, nm) in enumerate(want_places) if nm in TABLE and TABLE.index(nm) > idx),
                          len(want_places))
                want_places.insert(at, "cols")
            locals_out = [nm for (_, _, nm) in s_out["kids"] if nm is not None]
            flags["places"] = locals_out == want_places
            pos = [TABLE.index(nm) for nm in locals_out if nm in TABLE]
            flags["schema_order"] = pos == sorted(pos) and all(locals_out.count(n) == 1 for n in FOUR)
            if all(len(s_out["el"][n]) == 1 for n in FOUR):
                rows_out, _, _ = rows_of(wout, s_out)
                rows_out_n = len(rows_out)
                ix, iy = s_in["el"]["sheetData"][0]
                ox, oy = s_out["el"]["sheetData"][0]
                flags["rows_kept"] = (
                    cut(win[ix:iy], [(kx - ix, ky - ix) for (kx, ky, r, _) in rows_in if r == m + 1])
                    == cut(wout[ox:oy], [(kx - ox, ky - ox) for (kx, ky, r, _) in rows_out if r == m + 1]))
                got = [wout[kx:ky] for (kx, ky, r, _) in rows_out if r == m + 1]
                flags["row_window"] = got == [want_row]
                cols_out = col_elements(wout, s_out)
                cols_out_n = len(cols_out)
                outside_in = [win[kx:ky] for (kx, ky, mn, mx, _) in cols_in if mx < span_lo or mn > span_hi]
                outside_out = [wout[kx:ky] for (kx, ky, mn, mx, _) in cols_out if mx < span_lo or mn > span_hi]
                flags["cols_other"] = outside_in == outside_out
                x, y = s_out["el"]["cols"][0]
                flags["cols_bytes"] = wout[x:y] == want_cols
                col_split = sum(1 for e in cols_out if e[2] >= span_lo and e[3] <= span_hi) if cov else 1
                c_out = covering(cols_out, COLUMN)
                kept_cols = len([a for a in attributes(c_out[4]) if a[0] not in (b"min", b"max", b"style")]) \
                    if c_out else -1
            flags["w_bytes"] = wout == want
        try:
            root_o = ET.fromstring(wout) if wout else None
        except ET.ParseError:
            root_o = None
        try:
            sroot_o = ET.fromstring(sout) if sout else None
        except ET.ParseError:
            sroot_o = None
        if root_o is not None:
            e_in = {int(el.get("r")): el for el in et_rows(root_i) if (el.get("r") or "").isdigit()}
            hits = [el for el in et_rows(root_o) if el.get("r") == str(m + 1)]
            ok = len(hits) == 1
            if ok:
                base = dict(e_in[m + 1].attrib) if (m + 1) in e_in else {"r": str(m + 1)}
                base["s"] = str(i)
                base["customFormat"] = "1"
                ok = dict(hits[0].attrib) == base
                if (m + 1) not in e_in and (len(list(hits[0])) or (hits[0].text or "")):
                    ok = False
            flags["row_attrs"] = ok
            c_in = et_cols(root_i)
            c_out = et_cols(root_o)
    
            def rng(el):
                try:
                    return int(el.get("min")), int(el.get("max"))
                except (TypeError, ValueError):
                    return (-1, -1)
    
            inside = [el for el in c_out if not (rng(el)[1] < span_lo or rng(el)[0] > span_hi)]
            g = True
            expect = span_lo
            for el in inside:
                lo, hi = rng(el)
                if lo != expect or hi < lo:
                    g = False
                expect = hi + 1
            if expect != span_hi + 1:
                g = False
            for el in inside:
                lo, hi = rng(el)
                src = next((e for e in c_in if rng(e)[0] <= lo <= rng(e)[1]), None)
                want_a = dict(src.attrib) if src is not None else {}
                got_a = dict(el.attrib)
                for k in ("min", "max"):
                    want_a.pop(k, None)
                    got_a.pop(k, None)
                if lo <= COLUMN <= hi:
                    if (lo, hi) != (COLUMN, COLUMN) or got_a.get("style") != str(i):
                        g = False
                    want_a["style"] = str(i)
                if want_a != got_a:
                    g = False
            flags["cols_split"] = g
            styled = [el for el in c_out if rng(el)[0] <= COLUMN <= rng(el)[1]]
            row_ok = len(hits) == 1 and hits[0].get("s") == str(i) and hits[0].get("customFormat") == "1"
            col_ok = len(styled) == 1 and rng(styled[0]) == (COLUMN, COLUMN) and styled[0].get("style") == str(i)
            xf_ok = False
            if sroot_o is not None:
                xo = et_first(sroot_o, "cellXfs")
                xf_ok = xo is not None and len(main_kids(xo, "xf")) == xfs_in + 1
            flags["read_back"] = row_ok and col_ok and xf_ok
        if sroot_o is not None:
            xo = et_first(sroot_o, "cellXfs")
            fo = et_first(sroot_o, "fonts")
            xfs_out = len(main_kids(xo, "xf")) if xo is not None else -1
            fonts_out = len(main_kids(fo, "font")) if fo is not None else -1
            xi_b = root_child(sin, "cellXfs")
            xo_b = root_child(sout, "cellXfs")
            fi_b = root_child(sin, "fonts")
            fo_b = root_child(sout, "fonts")
            new_xf = main_kids(xo, "xf")[-1] if xfs_out > 0 else None
            flags["styles_xfs"] = (
                xfs_out == xfs_in + 1 and xi_b is not None and xo_b is not None
                and sout[xo_b[2]:xo_b[3]].startswith(sin[xi_b[2]:xi_b[3]])
                and (xo.get("count") is None or xo.get("count") == str(xfs_out))
                and new_xf is not None and new_xf.get("fontId") == str(fonts_in))
            new_font = main_kids(fo, "font")[-1] if fonts_out > 0 else None
            flags["styles_fonts"] = (
                fonts_out == fonts_in + 1 and fi_b is not None and fo_b is not None
                and sout[fo_b[2]:fo_b[3]].startswith(sin[fi_b[2]:fi_b[3]])
                and (fo.get("count") is None or fo.get("count") == str(fonts_out))
                and new_font is not None and len(main_kids(new_font, "b")) == 1)
            if xi_b is not None and xo_b is not None and fi_b is not None and fo_b is not None:
                flags["styles_rest"] = (cut(sin, [xi_b[:2], fi_b[:2]]) == cut(sout, [xo_b[:2], fo_b[:2]]))
        flags["others_same"] = (list(others) == [nm for nm in names_in_order if nm not in (part, sty)]
                                and out_names == names_in_order
                                and all(others[nm] == zin.read(nm) for nm in others))
    
        in_only = out_only = want_in = want_out = flagged_rows = want_flagged = -1
        s_in_only = s_out_only = s_want_in = s_want_out = -1
        side_in = values_of(root_i)
        side_want = values_of(ET.fromstring(want))
        want_in = sum((side_in - side_want).values())
        want_out = sum((side_want - side_in).values())
        # The styles part has no design here: its one-sided counts are the
        # input's against the output's, read by this program's own walk.
        if sroot_o is not None:
            sv_in = values_of(sroot_i)
            sv_out = values_of(sroot_o)
            s_want_in = sum((sv_in - sv_out).values())
            s_want_out = sum((sv_out - sv_in).values())
        if extra == "xml_values":
            want_out += 1
        if diff_path is not None:
            rows = [l.split("\t") for l in open(diff_path, encoding="utf-8").read().split("\n") if l]
            values = {c[1]: c for c in rows if len(c) >= 7 and c[0] == "xml" and c[2] == "values"}
            if set(values) == {part, sty}:
                in_only = int(values[part][5])
                out_only = int(values[part][6])
                s_in_only = int(values[sty][5])
                s_out_only = int(values[sty][6])
            flags["xml_values"] = (set(values) == {part, sty} and in_only == want_in and out_only == want_out
                                   and s_in_only == s_want_in and s_out_only == s_want_out)
            ents = [{"name": c[1], "status": c[2], "flags": c[16]} for c in rows
                    if len(c) == 17 and c[0] == "entry"]
            flagged_rows = sum(1 for r in ents if r["flags"])
            wanted = {nm: ("descriptor" if bit3(zin, nm) == "1" else "") for nm in (part, sty)}
            if extra == "flagged":
                wanted = {nm: ("" if f else "descriptor") for (nm, f) in wanted.items()}
            want_flagged = sum(1 for f in wanted.values() if f)
            flags["flagged"] = (len(ents) > 0 and flagged_rows == want_flagged
                                and all(r["flags"] == wanted.get(r["name"], "") for r in ents))
    
        tag_in = win[s_in["ts"]:s_in["te"]]
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted),
             "case=%d" % case, "created_cols=%d" % created_cols,
             "created_rows=%d" % (1 - len(present)), "edited_rows=%d" % len(present),
             "rows_in=%d" % len(rows_in), "present=%d" % len(present), "rows_out=%d" % rows_out_n,
             "cols_in=%d" % len(cols_in), "cols_out=%d" % cols_out_n,
             "col_split=%d" % col_split, "kept_cols=%d" % kept_cols,
             "xfs_in=%d" % xfs_in, "xfs_out=%d" % xfs_out,
             "r_bound_in=%d" % (0 if rels_prefix_of(tag_in) is None else 1),
             "in_only=%d" % in_only, "in_only_want=%d" % want_in,
             "out_only=%d" % out_only, "out_only_want=%d" % want_out,
             "flagged_rows=%d" % flagged_rows, "flagged_want=%d" % want_flagged]
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS]))
    
    
    main()
