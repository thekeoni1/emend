## the survey of the corpus before the run (change TD)
command: cp <scripts>/rdsurvey.py <work>/rdsurvey.py; sed 's/^/    /' <work>/rdsurvey.py; sha256 07ec2f11f04498fa491ec9bf926cd28592f5f950452bf654ce3f99c6ffd0a3f7, 14408 bytes
  the copy is the file beside this script, byte for byte: yes
    """The run log's survey of the corpus before the read sample's run
    (specs/0027-read-back.md, "Harness runs", P2, with "Planning rulings during
    P2" ruling 3; specs/0024 P1 verification ruling 6's form: ids and counts
    only, the corpus directory a parameter).
    
    Usage: rdsurvey.py <corpus>
    
    Lists <corpus>/corpus (every regular file, no extension glob) and reads each
    workbook the manifest <corpus>/manifest.tsv names, in manifest order: the
    workbook part through the package relationships, its worksheets in <sheets>
    order (each <sheet> whose relationship is a worksheet's), W the first of
    them, the styles part and the shared strings part the workbook's
    relationships name (zipfile and ElementTree for the relationships, readers
    copied by name from M3 part 5 P1's rtsurvey.py), every worksheet streamed
    with expat WITHOUT namespace processing, each element's namespace resolved
    here from the declarations in scope, and the styles part read as a tree the
    same way: a reader of another lineage than the tool (the crate's token
    stream).
    
    Prints, tab-separated, one line per workbook:
      wb <id> <cells> <styled> <used> <fonts> <fills> <borders> <gradients>
         <codes> <columns> <rows> <merges> <links> <frozen> <protected> <items>
         <chain>
    where <cells> and <styled> are the main <c> elements in a main <row> of a
    worksheet's first main <sheetData>, over every worksheet, and those with an
    s; <used> the distinct s among them; over the used cell formats, <fonts>,
    <fills> and <borders> the distinct values among their fonts, fills holding a
    patternFill and borders, each in the typed view of specs/0027 "Cell
    formats" (decision 3's drop rule), equal values once; <gradients> the used
    formats whose fill holds no patternFill; <codes> the used formats whose
    numFmtId names a numFmt of the part; then for W: <columns> the main <col>
    children of its first main <cols> root child, <rows> the main <row> children
    of its first main <sheetData>, <merges> the main <mergeCell> children of its
    <mergeCells>, <links> the main <hyperlink> children of its <hyperlinks>,
    <frozen> 1 when its first main <sheetView> (in its first main <sheetViews>)
    has a first main <pane> child with state frozen and a topLeftCell,
    <protected> 1 when it has a main <sheetProtection> root child; <items> the
    main <si> children of the shared strings part's root (0 without the part);
    <chain> 1 when xl/calcChain.xml is an entry. Last one line
      files <regular files in corpus/> <manifest rows> <rows read>
    No value, text, reference or part name is printed.
    """
    import os
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    from xml.parsers import expat
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    
    def rels(z, part):
        d, base = posixpath.split(part)
        name = posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            if el.get("TargetMode") == "External":
                continue
            t = el.get("Target", "")
            out.append((el.get("Id"), el.get("Type", ""),
                        t[1:] if t.startswith("/") else posixpath.normpath(posixpath.join(d, t))))
        return out
    
    
    def styles_of(z):
        """The styles part's name, or None."""
        wb = [t for (_, ty, t) in rels(z, "") if ty.endswith("/officeDocument")][0]
        for (_, ty, t) in rels(z, wb):
            if ty in [a + "/styles" for a in ATTR]:
                return t
        return None
    
    
    def tree(data):
        """The part as nested [local name, main, attributes, children], namespaces
        resolved from the declarations in scope."""
        root = ["", False, {}, []]
        stack = [root]
        scopes = [{}]
    
        def start(name, attrs):
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(scopes[-1])
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            scopes.append(scope)
            prefix, _, loc = name.rpartition(":")
            node = [loc, scope.get(prefix) in MAIN,
                    {k: v for (k, v) in pairs if k != "xmlns" and not k.startswith("xmlns:")}, []]
            stack[-1][3].append(node)
            stack.append(node)
    
        def end(name):
            stack.pop()
            scopes.pop()
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.Parse(data, True)
        return root[3][0]
    
    
    def kids(node, name):
        return [k for k in node[3] if k[1] and k[0] == name]
    
    
    def container(root, name, child):
        c = kids(root, name)
        return kids(c[0], child) if c else []
    
    
    def boolean(v):
        return {"1": True, "true": True, "0": False, "false": False}[v]
    
    
    def colour(node):
        a = node[2]
        if "auto" in a and boolean(a["auto"]):
            return "auto"
        if "rgb" in a:
            return "rgb:%d" % int(a["rgb"], 16)
        if "theme" in a:
            return "theme:%d:%r" % (int(a["theme"]), float(a["tint"]) if "tint" in a else None)
        if "indexed" in a:
            return "indexed:%d" % int(a["indexed"])
        raise ValueError("no form")
    
    
    def fill_key(node):
        p = kids(node, "patternFill")
        if not p:
            return None
        fg, bg = kids(p[0], "fgColor"), kids(p[0], "bgColor")
        return repr((p[0][2].get("patternType") or "none", colour(fg[0]) if fg else None,
                     colour(bg[0]) if bg else None))
    
    
    def border_key(node):
        out = [boolean(node[2].get("diagonalUp", "0")), boolean(node[2].get("diagonalDown", "0"))]
        for side in ("left", "right", "top", "bottom", "diagonal"):
            k = kids(node, side)
            st = k[0][2].get("style") if k else None
            if st in (None, "none"):
                out.append(None)
            else:
                c = kids(k[0], "color")
                out.append((st, colour(c[0]) if c else None))
        return repr(out)
    
    
    def parts_of(z):
        """The worksheets in <sheets> order, the styles part and the shared
        strings part (None without one)."""
        wb = [t for (_, ty, t) in rels(z, "") if ty.endswith("/officeDocument")][0]
        by_id = {i: (ty, t) for (i, ty, t) in rels(z, wb)}
        sheets = []
        for el in ET.fromstring(z.read(wb)).iter():
            if el.tag in ["{%s}sheet" % m for m in MAIN]:
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, t = by_id.get(rid, ("", None))
                if ty in [a + "/worksheet" for a in ATTR]:
                    sheets.append(t)
        sst = None
        for (_, ty, t) in rels(z, wb):
            if ty in [a + "/sharedStrings" for a in ATTR]:
                sst = t
        return sheets, styles_of(z), sst
    
    
    def counts(data):
        """The streaming counts over one worksheet part: cells, styled cells,
        the s values, and W's counts (columns, rows, merges, links, frozen,
        protected), by the depth and the path of main elements."""
        out = {"cells": 0, "styled": 0, "s": set(), "columns": 0, "rows": 0, "merges": 0,
               "links": 0, "frozen": 0, "protected": 0}
        stack = []          # (local name, main) of the open elements
        scopes = [{}]
        seen = {"cols": 0, "sheetData": 0, "sheetViews": 0, "mergeCells": 0, "hyperlinks": 0}
        state = {"in": None, "first_view": False, "view_done": False, "pane_seen": False}
    
        def start(name, attrs):
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(scopes[-1])
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            scopes.append(scope)
            prefix, _, loc = name.rpartition(":")
            main = scope.get(prefix) in MAIN
            a = {k: v for (k, v) in pairs}
            depth = len(stack)
            path = [n for (n, m) in stack]
            if depth == 1 and main:
                if loc in seen:
                    seen[loc] += 1
                if loc == "sheetProtection":
                    out["protected"] = 1
            if depth == 2 and main and stack[1][1]:
                parent = stack[1][0]
                if parent == "cols" and seen["cols"] == 1 and loc == "col":
                    out["columns"] += 1
                if parent == "sheetData" and seen["sheetData"] == 1 and loc == "row":
                    out["rows"] += 1
                if parent == "mergeCells" and seen["mergeCells"] == 1 and loc == "mergeCell":
                    out["merges"] += 1
                if parent == "hyperlinks" and seen["hyperlinks"] == 1 and loc == "hyperlink":
                    out["links"] += 1
                if parent == "sheetViews" and seen["sheetViews"] == 1 and loc == "sheetView" \
                        and not state["first_view"]:
                    state["first_view"] = True
                    state["in"] = "view"
            if depth == 3 and main and state["in"] == "view" and path[2] == "sheetView" \
                    and loc == "pane" and not state["pane_seen"]:
                state["pane_seen"] = True
                if a.get("state") == "frozen" and "topLeftCell" in a:
                    out["frozen"] = 1
            if depth == 3 and main and loc == "c" and path[1] == "sheetData" and path[2] == "row" \
                    and seen["sheetData"] == 1 and stack[1][1] and stack[2][1]:
                out["cells"] += 1
                if "s" in a:
                    out["styled"] += 1
                    out["s"].add(int(a["s"]))
            stack.append((loc, main))
    
        def end(name):
            loc, main = stack.pop()
            scopes.pop()
            if len(stack) == 2 and loc == "sheetView" and state["in"] == "view":
                state["in"] = "done"
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.Parse(data, True)
        return out
    
    
    def font_key(node):
        """A font in the typed view: every field defaulted, so a child naming
        the default (u or scheme none, a flag 0) and no child are one value."""
        d = {"b": False, "i": False, "strike": False, "u": None, "scheme": None,
             "vertAlign": None, "name": None, "sz": None, "family": None, "color": None}
        for k in node[3]:
            if not k[1]:
                raise ValueError("outside")
            n, v = k[0], k[2].get("val")
            if n in ("b", "i", "strike"):
                d[n] = True if v is None else boolean(v)
            elif n == "u":
                d[n] = None if v == "none" else (v or "single")
            elif n == "scheme":
                d[n] = None if v == "none" else v
            elif n in ("vertAlign", "name"):
                d[n] = v
            elif n == "sz":
                d[n] = float(v)
            elif n == "family":
                d[n] = int(v)
            elif n == "color":
                d[n] = colour(k)
            elif n not in ("charset", "outline", "shadow", "condense", "extend"):
                raise ValueError("unknown")
        return repr(sorted(d.items()))
    
    
    def items_of(data):
        """The main <si> children of the root."""
        n = [0]
        depth = [0]
        scopes = [{}]
    
        def start(name, attrs):
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(scopes[-1])
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            scopes.append(scope)
            prefix, _, loc = name.rpartition(":")
            if depth[0] == 1 and scope.get(prefix) in MAIN and loc == "si":
                n[0] += 1
            depth[0] += 1
    
        def end(name):
            depth[0] -= 1
            scopes.pop()
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.Parse(data, True)
        return n[0]
    
    
    def main():
        corpus = sys.argv[1]
        lines = open(os.path.join(corpus, "manifest.tsv"), encoding="utf-8").read().split("\n")
        head = lines[0].split("\t")
        rows = [l.split("\t") for l in lines[1:] if l]
        files = sorted(f for f in os.listdir(os.path.join(corpus, "corpus"))
                       if os.path.isfile(os.path.join(corpus, "corpus", f)))
        read = 0
        for row in rows:
            cid, ext = row[head.index("id")], row[head.index("ext")]
            name = "%s.%s" % (cid, ext)
            if name not in files:
                print("wb\t%s\tmissing" % cid)
                continue
            z = zipfile.ZipFile(os.path.join(corpus, "corpus", name))
            sheets, sty, sst = parts_of(z)
            if not sheets or sty is None:
                print("wb\t%s\tno-worksheet-or-styles" % cid)
                continue
            cells = styled = 0
            used = set()
            w = None
            for part in sheets:
                c = counts(z.read(part))
                cells += c["cells"]
                styled += c["styled"]
                used |= c["s"]
                if w is None:
                    w = c
            st = tree(z.read(sty))
            xfs = container(st, "cellXfs", "xf")
            fonts = container(st, "fonts", "font")
            fills = container(st, "fills", "fill")
            borders = container(st, "borders", "border")
            nfs = container(st, "numFmts", "numFmt")
            ids = {int(n[2].get("numFmtId")) for n in nfs}
            df, dl, db = [], [], []
            grad = codes = 0
            for s in sorted(used):
                xf = xfs[s]
                fl = fills[int(xf[2].get("fillId", "0"))]
                if not kids(fl, "patternFill"):
                    grad += 1
                for (lst, key) in ((df, font_key(fonts[int(xf[2].get("fontId", "0"))])),
                                   (dl, fill_key(fl)),
                                   (db, border_key(borders[int(xf[2].get("borderId", "0"))]))):
                    if key is not None and key not in lst:
                        lst.append(key)
                if int(xf[2].get("numFmtId", "0")) in ids:
                    codes += 1
            items = items_of(z.read(sst)) if sst is not None else 0
            chain = 1 if "xl/calcChain.xml" in z.namelist() else 0
            read += 1
            print("\t".join(["wb", cid] + [str(v) for v in (
                cells, styled, len(used), len(df), len(dl), len(db), grad, codes,
                w["columns"], w["rows"], w["merges"], w["links"], w["frozen"], w["protected"],
                items, chain)]))
        print("files\t%d\t%d\t%d" % (len(files), len(rows), read))
    
    
    main()
