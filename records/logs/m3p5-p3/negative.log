### this log's generator, from the phase commit's template files
    """Fictional packages for M3 part 5 P3's negative log: the phase commit's
    template files, zipped in the template's order. Two families (change QB):
    P1's, for --roundtrip-sample, the worksheet given one cell naming cell
    format 1 and the styles part given that cell format, its font or fill id
    past its list, or the template's font given a colour with no form; and
    P2's, for --read-sample, the worksheet's empty sheetData given the
    settings elements each case names.
    Usage: gen-p3.py <template dir> <out dir>."""
    import os
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    src, out = sys.argv[1], sys.argv[2]
    parts = {name: open(os.path.join(src, name), "rb").read() for name in ORDER}
    sheet = parts["xl/worksheets/sheet1.xml"]
    styles = parts["xl/styles.xml"]
    EMPTY = b"<sheetData/>"
    XFS = b'<cellXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/></cellXfs>'
    FONT = b'<font><sz val="11"/><name val="Calibri"/></font>'
    assert sheet.count(EMPTY) == 1 and sheet.count(b"<c ") == 0 and sheet.count(b"sheetView") == 0
    assert parts["xl/_rels/workbook.xml.rels"].count(b"sharedStrings") == 0
    assert styles.count(XFS) == 1 and styles.count(FONT) == 1
    for count in (b'<fonts count="1">', b'<fills count="2">', b'<borders count="1">'):
        assert styles.count(count) == 1
    print("the template's worksheet: an empty sheetData alone; no shared strings part")
    print("the template's fonts 1, fills 2, borders 1, cell formats 1")
    
    CELL = b'<sheetData><row r="1"><c r="A1" s="1"><v>1</v></c></row></sheetData>'
    
    
    def xfs(font, fill):
        return XFS.replace(b'count="1"', b'count="2"').replace(
            b"</cellXfs>",
            b'<xf numFmtId="0" fontId="%d" fillId="%d" borderId="0" xfId="0"/></cellXfs>' % (font, fill))
    
    
    def colour(attributes):
        return FONT.replace(b'<name', b"<color" + attributes + b"/><name")
    
    
    VIEWS = b'<sheetViews><sheetView workbookViewId="0"/></sheetViews>'
    LINK = b'<hyperlink ref="A1" location="A2"/>'
    NO_REL = (b'<hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" '
              b'ref="A1" r:id="rId9"/>')
    # case: (what replaces the empty sheetData, cellXfs, font)
    CASES = {
        "rr": (EMPTY, XFS, FONT),
        "nf": (CELL, xfs(1, 0), FONT),
        "nfc": (CELL, xfs(0, 0), FONT),
        "ni": (CELL, xfs(0, 2), FONT),
        "nic": (CELL, xfs(0, 1), FONT),
        "nc": (CELL, xfs(0, 0), colour(b"")),
        "ncc": (CELL, xfs(0, 0), colour(b' theme="1"')),
        "r0": (EMPTY, XFS, FONT),
        "nv": (VIEWS + VIEWS + EMPTY, XFS, FONT),
        "nvc": (VIEWS + EMPTY, XFS, FONT),
        "nz": (b'<sheetViews><sheetView zoomScale="9" workbookViewId="0"/></sheetViews>' + EMPTY, XFS, FONT),
        "nzc": (b'<sheetViews><sheetView zoomScale="10" workbookViewId="0"/></sheetViews>' + EMPTY, XFS, FONT),
        "nr": (EMPTY + b"<hyperlinks>" + NO_REL + b"</hyperlinks>", XFS, FONT),
        "nrc": (EMPTY + b"<hyperlinks>" + LINK + b"</hyperlinks>", XFS, FONT),
        "nh": (EMPTY + b"<hyperlinks>" + LINK + b"</hyperlinks><hyperlinks>" + LINK + b"</hyperlinks>", XFS, FONT),
        "nhc": (EMPTY + b"<hyperlinks>" + LINK + b"</hyperlinks>", XFS, FONT),
        "np": (EMPTY + b"<pageSetup/><pageSetup/>", XFS, FONT),
        "npc": (EMPTY + b"<pageSetup/>", XFS, FONT),
    }
    for name, (body, cell_xfs, font) in CASES.items():
        p = dict(parts)
        p["xl/worksheets/sheet1.xml"] = sheet.replace(EMPTY, body)
        p["xl/styles.xml"] = styles.replace(XFS, cell_xfs).replace(FONT, font)
        with zipfile.ZipFile(os.path.join(out, name + ".xlsx"), "w") as z:
            for n in ORDER:
                z.writestr(zipfile.ZipInfo(n, (1980, 1, 1, 0, 0, 0)), p[n], zipfile.ZIP_DEFLATED)
        w = p["xl/worksheets/sheet1.xml"]
        s = p["xl/styles.xml"]
        print("%s %d entries:%d cells:%d xf:%d color:%d sheetViews:%d zoom:%d hyperlinks:%d rid:%d pageSetup:%d" % (
            name + ".xlsx", os.path.getsize(os.path.join(out, name + ".xlsx")), len(ORDER),
            w.count(b"<c "), s.count(b"<xf "), s.count(b"<color"), w.count(b"<sheetViews>"),
            w.count(b"zoomScale="), w.count(b"<hyperlinks>"), w.count(b"r:id="), w.count(b"<pageSetup")))
