## the round-trip sample's changed part and its bit 3, read from every input (change WD)
command: cp <scripts>/rtcmp.py <work>/rtcmp.py; sed 's/^/    /' <work>/rtcmp.py; sha256 fb3f5a3abb5d9a6bea29e86b69686eb663efe00d0d35312f137ad30bf774d7ed, 34643 bytes
  the copy of rtcmp.py is the file beside this script, byte for byte: yes
    """The run log's own round-trip comparison (specs/0027-read-back.md,
    "Harness runs", --roundtrip-sample and the run log's own check, P1).
    
    Usage: rtcmp.py <input archive> <output archive> [--diff <diff.tsv>] [--plant <flag>]
           rtcmp.py <input archive> --parts
    
    Reads both archives with zipfile, byte spans and ElementTree, sharing no code
    with the library or the tool; its readers are M3 part 4 P2's lscmp.py's,
    copied by name (MAIN, RELS, ATTR, COMMENT, local, rels_name, rels_of,
    workbook_of, w_of, TOKEN, top_level, qname, split_name, start_tag, opened,
    ATTRS_RE, attributes, attr_matches, root_span, is_main, children,
    content_span, bit3, cut, et_first, values_of, name_end, with_attribute,
    attr_value). It finds W, the first <sheet> in <sheets> order whose
    relationship type is a worksheet's, and the styles part, the workbook's
    styles relationship's target; the used styles, the distinct s of W's main
    <c> elements in increasing order, the k-th of them paired with the k-th
    cell format the sample appends (index xfs_in + k).
    
    For each used s it reads the input's cell format s (ids absent read 0) in
    the typed view the layer reads (specs/0027 "Cell formats", decision 3): the
    font's ten modelled children (a later child of a name winning; b, i and
    strike false at val 0 or false; u and scheme none absent; sz a number;
    charset, outline, shadow, condense and extend dropped), the fill's
    patternFill (patternType absent read none; a fill with no patternFill, a
    gradient among them, None), the border's two diagonal flags and five sides
    (a side with no style or style none None, its colour dropped), the first
    alignment's six modelled attributes (justifyLastLine, readingOrder and
    relativeIndent dropped; wrapText and shrinkToFit false at 0 or false), the
    first protection's two, the number format resolved (the first numFmt of the
    numFmtId's id, else built in), each colour by its form (auto when true,
    else rgb, else theme with its tint, else indexed). From these it gives what
    the writer appends (specs/0017 "Module styles: what can be added"): one
    font, fill and border per distinct value, in addition order, after the
    input's (a None fill none, fillId 0), a code's numFmt reused when the part
    defines it, else appended from max(163, ids) + 1, and each new xf's
    attributes in the writer's order: numFmtId fontId fillId borderId xfId="0"
    applyNumberFormat applyFont [applyFill] applyBorder [applyAlignment]
    [applyProtection], its children alignment then protection when given.
    
      prefixes      each of numFmts, fonts, fills, borders, cellXfs: the input's
                    element children a byte-identical prefix of the output's;
                    each output count attribute its children's count
      styles_rest   the styles part with those five containers cut out is the
                    input's with its own cut out, byte for byte
      xf_attrs      the output's cellXfs holds one appended xf per used s, each
                    with exactly the attributes above, in that order and with
                    those values, and exactly those children
      fonts_equal   each appended xf's font, read typed, is the input font's
      fills_equal   each appended xf's fill (when the value read is a pattern)
      borders_equal each appended xf's border
      numfmts_equal each appended xf's number format resolved is the input's
      align_prot    each appended xf's alignment and protection, read typed,
                    are the input xf's (None when absent)
      growth        cellXfs grown by the used styles, fonts, fills and borders by
                    the distinct values, numFmts by the new codes
      others_same   every entry but the styles part is the input's, byte for
                    byte, the names the input's in the input's order
      xml_values    with --diff, the runner's diff.<label>.tsv for the pair: its
                    xml "values" rows are the styles part's alone, its in_only
                    and out_only the one-sided counts of the input's values
                    against the output's, each value keyed as xlsx-diff keys
                    one; without --diff, no
      flagged       with --diff, the diff's entry row for the styles part
                    carries the flag descriptor exactly when the input's local
                    header for it sets general purpose bit 3, and no other row
                    is flagged; without --diff, no
    
    It prints ONE line of counts and yes/no flags and no text, reference, sheet
    name, part name, font name or code: the counts beside the tool's
    (styles_in, equal, the four collections in and out), numFmts in and out,
    the distinct values and new codes, and case: 0 (kept) when the first
    addition's font element is byte for byte the input's font it was read
    from, 1 (created) when the writer spelt it otherwise, -1 when it cannot
    tell. --parts prints the styles part's name and 1, 0 or - for its bit 3,
    one per line, for the log to compare with the runner's rows without
    printing them. --plant <flag> changes the output as read so that the named
    flag turns to no; the line then says planted=yes, or planted=no when the
    pair gives the plant nothing to change.
    """
    import collections
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    COMMENT = b"<!-- planted -->"
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    def w_of(z, workbook):
        """W's part, or None: the first main <sheet> whose relationship is a
        worksheet's."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                if ty in (ATTR[0] + "/worksheet", ATTR[1] + "/worksheet"):
                    return target
        return None
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    ATTRS_RE = re.compile(rb'\s([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')')
    
    def attributes(tag):
        """[(name, bytes from the name to the closing quote)] of a start tag, in
        order, namespace declarations among them."""
        return [(m.group(1), tag[m.start(1):m.end()]) for m in ATTRS_RE.finditer(tag)]
    
    def attr_matches(tag):
        return list(ATTRS_RE.finditer(tag))
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    def is_main(raw, parent_prefix, parent_main):
        """Whether an element whose bytes start `raw` is in the main namespace:
        its own declaration of its prefix, else its parent's when the prefix is
        the parent's."""
        p, _ = split_name(qname(raw))
        tag = start_tag(raw)
        decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
        own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
        if own:
            return own.group(1)[1:-1].decode() in MAIN
        return p == parent_prefix and parent_main
    
    def children(data, a, b, rp, parent_main):
        """[(start, end, main local name or None)] of the elements in data[a:b]."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            n = split_name(qname(raw))[1]
            out.append((a + x, a + y, n if is_main(raw, rp, parent_main) else None))
        return out
    
    def content_span(data, x, y):
        """(start, end) of an element's content, equal for an empty tag."""
        raw = data[x:y]
        tag = start_tag(raw)
        if tag.endswith(b"/>"):
            return x + len(tag), x + len(tag)
        return x + len(tag), x + raw.rfind(b"</")
    
    def bit3(zin, name):
        """1 or 0 for whether the input's entry sets general purpose bit 3, -
        when there is no such entry."""
        try:
            return "1" if zin.getinfo(name).flag_bits & 0x08 else "0"
        except KeyError:
            return "-"
    
    def cut(data, spans):
        """data with the spans cut out."""
        out, at = [], 0
        for (x, y) in sorted(spans):
            out.append(data[at:x])
            at = y
        out.append(data[at:])
        return b"".join(out)
    
    def et_first(root, name):
        for el in root:
            ns, nm = local(el.tag)
            if ns in MAIN and nm == name:
                return el
        return None
    
    def values_of(root):
        """The values of an ElementTree as xlsx-diff keys them: each attribute
        (namespace declarations are not attributes here) by element, attribute
        and value; each text node that is not whitespace alone by its element
        and its text (a node's element is the one it stands in: an element's
        text is its own, its tail its parent's)."""
        vals = collections.Counter()
        ws = " \t\n\r"
    
        def walk(el):
            for (k, v) in el.attrib.items():
                vals[("a", el.tag, k, v)] += 1
            if el.text and el.text.strip(ws):
                vals[("t", el.tag, el.text)] += 1
            for c in el:
                walk(c)
                if c.tail and c.tail.strip(ws):
                    vals[("t", el.tag, c.tail)] += 1
    
        walk(root)
        return vals
    
    def name_end(tag):
        return 1 + len(qname(tag))
    
    def with_attribute(tag, name, value):
        """`name` set to `value` between its own quotes when present, else
        appended after the last attribute (after the element's name when there
        is none), one space before it."""
        ms = attr_matches(tag)
        for m in ms:
            if m.group(1) == name:
                return tag[:m.start(2) + 1] + value + tag[m.end(2) - 1:]
        at = ms[-1].end() if ms else name_end(tag)
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    def attr_value(tag, name):
        for m in attr_matches(tag):
            if m.group(1) == name:
                return m.group(2)[1:-1]
        return None
    
    
    FLAGS = ("prefixes", "styles_rest", "xf_attrs", "fonts_equal", "fills_equal", "borders_equal",
             "numfmts_equal", "align_prot", "growth", "others_same", "xml_values", "flagged")
    STYLES_TYPES = (ATTR[0] + "/styles", ATTR[1] + "/styles")
    CONTAINERS = ("numFmts", "fonts", "fills", "borders", "cellXfs")
    CHILD = {"numFmts": "numFmt", "fonts": "font", "fills": "fill", "borders": "border", "cellXfs": "xf"}
    DROPPED_FONT = ("charset", "outline", "shadow", "condense", "extend")
    SIDES = ("left", "right", "top", "bottom", "diagonal")
    APPLY = ("applyNumberFormat", "applyFont", "applyFill", "applyBorder", "applyAlignment",
             "applyProtection")
    
    
    class OutOfDesign(Exception):
        """A styles part this comparison does not model (the layer refuses it)."""
    
    
    def styles_of(z, workbook):
        """The styles part's name, or None."""
        for (_, ty, t) in rels_of(z, workbook):
            if ty in STYLES_TYPES:
                return t
        return None
    
    
    def root_child(data, name):
        """(start, end, content start, content end) of the first main root child
        `name` of a part, or None."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        ts, te, a, b, rp = root_span(data)
        root_main = is_main(data[m.start():te], b"", False)
        for (x, y, nm) in children(data, a, b, rp, root_main):
            if nm == name:
                ca, cb = content_span(data, x, y)
                return x, y, ca, cb
        return None
    
    
    def child_spans(data, name):
        """[(start, end)] of the element children of the first main root child
        `name`, absolute; [] when there is none."""
        el = root_child(data, name)
        if el is None:
            return []
        x, y, ca, cb = el
        return [(ca + p, ca + q) for (p, q) in top_level(data[ca:cb])]
    
    
    def main_kids(el, name):
        return [c for c in el if local(c.tag)[0] in MAIN and local(c.tag)[1] == name]
    
    
    def kids_of(root, name):
        el = et_first(root, name) if root is not None else None
        return main_kids(el, CHILD[name]) if el is not None else []
    
    
    def flag_of(v):
        """An xsd:boolean as the layer reads one."""
        if v in ("1", "true"):
            return True
        if v in ("0", "false"):
            return False
        raise OutOfDesign
    
    
    # --- the typed view, as specs/0027 "Cell formats" and decision 3 give it:
    # what the layer reads, so what the writer writes back ---
    
    def color_canon(el):
        """The colour's form: auto when true, else rgb, else theme with its tint,
        else indexed; the attributes below the chosen form dropped."""
        a = el.attrib
        if "auto" in a and flag_of(a["auto"]):
            return ("auto",)
        if "rgb" in a:
            return ("rgb", int(a["rgb"], 16))
        if "theme" in a:
            return ("theme", int(a["theme"]), float(a["tint"]) if "tint" in a else None)
        if "indexed" in a:
            return ("indexed", int(a["indexed"]))
        raise OutOfDesign
    
    
    def font_canon(el):
        """(b, i, strike, u, vertAlign, sz, color, name, family, scheme), a later
        child of a name winning, the five unmodelled children dropped."""
        d = {"b": False, "i": False, "strike": False}
        for k in el:
            ns, n = local(k.tag)
            if ns not in MAIN:
                raise OutOfDesign
            v = k.get("val")
            if n in ("b", "i", "strike"):
                d[n] = True if v is None else flag_of(v)
            elif n == "u":
                d[n] = None if v == "none" else (v or "single")
            elif n == "vertAlign":
                d[n] = v
            elif n == "sz":
                d[n] = float(v)
            elif n == "color":
                d[n] = color_canon(k)
            elif n == "name":
                d[n] = v
            elif n == "family":
                d[n] = int(v)
            elif n == "scheme":
                d[n] = None if v == "none" else v
            elif n in DROPPED_FONT:
                pass
            else:
                raise OutOfDesign
        return tuple(d.get(n) for n in
                     ("b", "i", "strike", "u", "vertAlign", "sz", "color", "name", "family", "scheme"))
    
    
    def fill_canon(el):
        """(pattern, fg, bg) of the fill's patternFill, None for a fill holding
        none (a gradient, or no child)."""
        pf = main_kids(el, "patternFill")
        if not pf:
            return None
        p = pf[0]
        fg = main_kids(p, "fgColor")
        bg = main_kids(p, "bgColor")
        return (p.get("patternType") or "none",
                color_canon(fg[0]) if fg else None, color_canon(bg[0]) if bg else None)
    
    
    def border_canon(el):
        """(diagonalUp, diagonalDown, five sides), a side None without a style
        or with none, its colour then dropped."""
        out = [flag_of(el.get("diagonalUp", "0")), flag_of(el.get("diagonalDown", "0"))]
        for side in SIDES:
            k = main_kids(el, side)
            st = k[0].get("style") if k else None
            if st is None or st == "none":
                out.append(None)
                continue
            c = main_kids(k[0], "color")
            out.append((st, color_canon(c[0]) if c else None))
        return tuple(out)
    
    
    def align_canon(xf):
        """The first alignment's six modelled fields, None without one; the
        three unmodelled attributes dropped."""
        k = main_kids(xf, "alignment")
        if not k:
            return None
        a = k[0]
    
        def num(n):
            return int(a.get(n)) if a.get(n) is not None else None
    
        return (a.get("horizontal"), a.get("vertical"), flag_of(a.get("wrapText", "0")),
                flag_of(a.get("shrinkToFit", "0")), num("indent"), num("textRotation"))
    
    
    def prot_canon(xf):
        k = main_kids(xf, "protection")
        if not k:
            return None
        p = k[0]
        return tuple(flag_of(p.get(n)) if p.get(n) is not None else None for n in ("locked", "hidden"))
    
    
    def numfmt_of(root, xf):
        """("code", code) when the xf's numFmtId (0 when absent) names a numFmt of
        the part, the first so numbered, else ("builtin", id)."""
        i = int(xf.get("numFmtId", "0"))
        for nf in kids_of(root, "numFmts"):
            if nf.get("numFmtId") is not None and int(nf.get("numFmtId")) == i:
                return ("code", nf.get("formatCode"))
        return ("builtin", i)
    
    
    def at(lst, i):
        return lst[i] if 0 <= i < len(lst) else None
    
    
    def used_styles(root):
        """The distinct s of W's main <c> elements, in increasing order."""
        out = set()
        for el in root.iter():
            ns, n = local(el.tag)
            if ns in MAIN and n == "c" and el.get("s") is not None:
                out.add(int(el.get("s")))
        return sorted(out)
    
    
    def design_of(sroot_i, used):
        """What the writer gives for the additions, in addition order: per added
        xf its expected attributes in order, its expected children, and the
        typed values read; the distinct counts and the new codes."""
        xfs = kids_of(sroot_i, "cellXfs")
        fonts = kids_of(sroot_i, "fonts")
        fills = kids_of(sroot_i, "fills")
        borders = kids_of(sroot_i, "borders")
        nfs = kids_of(sroot_i, "numFmts")
        codes = [(int(n.get("numFmtId")), n.get("formatCode")) for n in nfs]
        seen = {"font": [], "fill": [], "border": []}
        new_codes = []
        out = []
        for s in used:
            xf = at(xfs, s)
            if xf is None:
                raise OutOfDesign
            f = at(fonts, int(xf.get("fontId", "0")))
            fl = at(fills, int(xf.get("fillId", "0")))
            b = at(borders, int(xf.get("borderId", "0")))
            if f is None or fl is None or b is None:
                raise OutOfDesign
            v = {"font": font_canon(f), "fill": fill_canon(fl), "border": border_canon(b),
                 "numfmt": numfmt_of(sroot_i, xf), "align": align_canon(xf), "prot": prot_canon(xf)}
            ids = {}
            for (kind, base) in (("font", len(fonts)), ("fill", len(fills)), ("border", len(borders))):
                if v[kind] is None:
                    ids[kind] = 0
                    continue
                if v[kind] not in seen[kind]:
                    seen[kind].append(v[kind])
                ids[kind] = base + seen[kind].index(v[kind])
            kind, val = v["numfmt"]
            if kind == "builtin":
                nid = val
            else:
                hit = next((i for (i, c) in codes + new_codes if c == val), None)
                if hit is None:
                    hit = max([163] + [i for (i, _) in codes + new_codes]) + 1
                    new_codes.append((hit, val))
                nid = hit
            attrs = [("numFmtId", str(nid)), ("fontId", str(ids["font"])), ("fillId", str(ids["fill"])),
                     ("borderId", str(ids["border"])), ("xfId", "0"), ("applyNumberFormat", "1"),
                     ("applyFont", "1")]
            if v["fill"] is not None:
                attrs.append(("applyFill", "1"))
            attrs.append(("applyBorder", "1"))
            if v["align"] is not None:
                attrs.append(("applyAlignment", "1"))
            if v["prot"] is not None:
                attrs.append(("applyProtection", "1"))
            kids = [n for n in ("alignment", "protection")
                    if (v["align"] if n == "alignment" else v["prot"]) is not None]
            out.append((s, attrs, kids, v))
        distinct = {k: len(seen[k]) for k in seen}
        return out, distinct, new_codes
    
    
    VALUE_NS = MAIN
    
    
    def element_at(data, name, i):
        """(start, end) of child i of the first main root child `name`."""
        spans = child_spans(data, name)
        return spans[i] if 0 <= i < len(spans) else None
    
    
    def plant(flag, sout, others, st):
        """(sout, others) changed so that `flag` turns to no, or None when the
        pair gives the plant nothing to change."""
        o = dict(others)
        xi = st["xfs_in"]
        so = ET.fromstring(sout)
        xfs_out = kids_of(so, "cellXfs")
        added = xfs_out[xi:]
        xspans = child_spans(sout, "cellXfs")
    
        def retag(data, x, new_tag):
            tag = start_tag(data[x:])
            return data[:x] + new_tag + data[x + len(tag):]
    
        if flag == "prefixes":
            sp = element_at(sout, "fonts", 0)
            if sp is None:
                return None
            tag = start_tag(sout[sp[0]:])
            return retag(sout, sp[0], with_attribute(tag, b"planted", b"1")), o
        if flag == "styles_rest":
            ts, te, _, _, _ = root_span(sout)
            return sout[:te] + COMMENT + sout[te:], o
        if flag == "xf_attrs":
            if not added:
                return None
            x, _ = xspans[-1]
            return retag(sout, x, with_attribute(start_tag(sout[x:]), b"xfId", b"1")), o
        if not added:
            return None
        first = added[0]
        if flag == "fonts_equal":
            fid = int(first.get("fontId", "-1"))
            sp = element_at(sout, "fonts", fid)
            fel = at(kids_of(so, "fonts"), fid)
            if sp is None or fel is None:
                return None
            x, y = sp
            raw = sout[x:y]
            p = split_name(qname(raw))[0]
            on = font_canon(fel)[0]
            child = b"<" + p + (b'b val="0"/>' if on else b"b/>")
            tag = start_tag(raw)
            if tag.endswith(b"/>"):
                new = opened(tag) + child + b"</" + p + b"font>"
            else:
                end = raw.rfind(b"</")
                new = raw[:end] + child + raw[end:]
            return sout[:x] + new + sout[y:], o
        if flag == "fills_equal":
            for xf in added:
                if xf.get("applyFill") != "1":
                    continue
                sp = element_at(sout, "fills", int(xf.get("fillId", "-1")))
                if sp is None:
                    return None
                x, y = sp
                m = re.search(rb"<([^\s/>]*:)?patternFill[\s/>]", sout[x:y])
                if m is None:
                    return None
                px = x + m.start()
                tag = start_tag(sout[px:])
                cur = attr_value(tag, b"patternType")
                new = b"darkGray" if cur == b"solid" else b"solid"
                return retag(sout, px, with_attribute(tag, b"patternType", new)), o
            return None
        if flag == "borders_equal":
            sp = element_at(sout, "borders", int(first.get("borderId", "-1")))
            if sp is None:
                return None
            tag = start_tag(sout[sp[0]:])
            on = attr_value(tag, b"diagonalUp") in (b"1", b"true")
            return retag(sout, sp[0], with_attribute(tag, b"diagonalUp", b"0" if on else b"1")), o
        if flag == "numfmts_equal":
            x, _ = xspans[xi]
            tag = start_tag(sout[x:])
            return retag(sout, x, with_attribute(tag, b"numFmtId", b"999")), o
        if flag == "align_prot":
            x, y = xspans[xi]
            raw = sout[x:y]
            p = split_name(qname(raw))[0]
            m = re.search(rb"<" + re.escape(p) + rb"alignment[\s/>]", raw)
            if m is not None:
                atag = start_tag(raw[m.start():])
                on = attr_value(atag, b"wrapText") in (b"1", b"true")
                return retag(sout, x + m.start(), with_attribute(atag, b"wrapText", b"0" if on else b"1")), o
            child = b"<" + p + b'alignment wrapText="1"/>'
            tag = start_tag(raw)
            if tag.endswith(b"/>"):
                new = opened(tag) + child + b"</" + p + b"xf>"
            else:
                new = tag + child + raw[len(tag):]
            return sout[:x] + new + sout[y:], o
        if flag == "growth":
            spans = child_spans(sout, "fonts")
            if not spans:
                return None
            x, y = spans[-1]
            return sout[:y] + sout[x:y] + sout[y:], o
        if flag == "others_same":
            name = next(iter(o), None)
            if name is None:
                return None
            o[name] = o[name] + COMMENT
            return sout, o
        if flag in ("xml_values", "flagged"):
            return sout, o
        raise KeyError(flag)
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def main():
        args = sys.argv[1:]
        zin = zipfile.ZipFile(args[0])
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            print("error=no-workbook")
            return
        part = w_of(zin, wb)
        if part is None or part not in zin.namelist():
            print("error=no-worksheet")
            return
        sty = styles_of(zin, wb)
        if sty is None or sty not in zin.namelist():
            print("error=no-styles")
            return
        if args[1:] == ["--parts"]:
            print(sty)
            print(bit3(zin, sty))
            return
        names_in_order = zin.namelist()
        sin = zin.read(sty)
        sroot_i = ET.fromstring(sin)
        used = used_styles(ET.fromstring(zin.read(part)))
        zout = zipfile.ZipFile(args[1])
        rest = args[2:]
        diff_path = flag_plant = None
        while rest:
            if rest[0] == "--diff" and len(rest) >= 2:
                diff_path, rest = rest[1], rest[2:]
            elif rest[0] == "--plant" and len(rest) >= 2:
                flag_plant, rest = rest[1], rest[2:]
                if flag_plant not in FLAGS:
                    print("error=unknown-plant")
                    return
            else:
                print("error=usage")
                return
        try:
            design, distinct, new_codes = design_of(sroot_i, used)
        except (OutOfDesign, ValueError, TypeError):
            print("error=out-of-design")
            return
        out_names = zout.namelist()
        sout = zout.read(sty) if sty in out_names else b""
        others = {nm: zout.read(nm) for nm in out_names if nm != sty}
        counts_in = {c: len(kids_of(sroot_i, c)) for c in CONTAINERS}
        xi = counts_in["cellXfs"]
        # The case the plants run on: kept (0) when the first addition's font is
        # byte for byte the input's font it was read from, created (1) when the
        # writer spelt it otherwise.
        case = -1
        try:
            so0 = ET.fromstring(sout)
            a0 = at(kids_of(so0, "cellXfs"), xi)
            fin = element_at(sin, "fonts", int(at(kids_of(sroot_i, "cellXfs"), used[0]).get("fontId", "0"))) if used else None
            fout = element_at(sout, "fonts", int(a0.get("fontId", "-1"))) if a0 is not None else None
            if fin is not None and fout is not None:
                case = 0 if sin[fin[0]:fin[1]] == sout[fout[0]:fout[1]] else 1
        except (ET.ParseError, ValueError, TypeError, AttributeError):
            case = -1
        st = {"xfs_in": xi}
        planted = False
        if flag_plant is not None and sout:
            changed = plant(flag_plant, sout, others, st)
            if changed is not None:
                sout, others = changed
                planted = True
        extra = flag_plant if planted else None
    
        flags = dict.fromkeys(FLAGS, False)
        try:
            sroot_o = ET.fromstring(sout) if sout else None
        except ET.ParseError:
            sroot_o = None
        counts_out = {c: len(kids_of(sroot_o, c)) for c in CONTAINERS} if sroot_o is not None else \
            dict.fromkeys(CONTAINERS, -1)
        equal = 0
        if sroot_o is not None:
            # prefixes: each container's input children a byte-identical prefix
            # of the output's, and each output count attribute its children's.
            ok = True
            for c in CONTAINERS:
                ci = [sin[x:y] for (x, y) in child_spans(sin, c)]
                co = [sout[x:y] for (x, y) in child_spans(sout, c)]
                if co[:len(ci)] != ci:
                    ok = False
                el = et_first(sroot_o, c)
                if el is not None and el.get("count") is not None and el.get("count") != str(len(main_kids(el, CHILD[c]))):
                    ok = False
            flags["prefixes"] = ok
            cut_in = [root_child(sin, c)[:2] for c in CONTAINERS if root_child(sin, c) is not None]
            cut_out = [root_child(sout, c)[:2] for c in CONTAINERS if root_child(sout, c) is not None]
            flags["styles_rest"] = cut(sin, cut_in) == cut(sout, cut_out)
            xfs_o = kids_of(sroot_o, "cellXfs")
            fonts_o = kids_of(sroot_o, "fonts")
            fills_o = kids_of(sroot_o, "fills")
            borders_o = kids_of(sroot_o, "borders")
            xspans = child_spans(sout, "cellXfs")
            added = xfs_o[xi:]
            attrs_ok = len(added) == len(design) and len(xspans) == len(xfs_o)
            eq = dict.fromkeys(("font", "fill", "border", "numfmt", "ap"), True)
            for k, (s, want_attrs, want_kids, v) in enumerate(design):
                if k >= len(added):
                    attrs_ok = False
                    for key in eq:
                        eq[key] = False
                    break
                xf = added[k]
                x, y = xspans[xi + k]
                names = [n.decode() for (n, _) in attributes(start_tag(sout[x:y])) if not n.startswith(b"xmlns")]
                got = [(n, xf.attrib.get(n)) for n in names]
                kid_names = [local(c.tag)[1] if local(c.tag)[0] in MAIN else None for c in xf]
                if got != want_attrs or kid_names != want_kids:
                    attrs_ok = False
                one = True
                try:
                    f = at(fonts_o, int(xf.get("fontId", "0")))
                    if f is None or font_canon(f) != v["font"]:
                        eq["font"] = one = False
                    if v["fill"] is not None:
                        fl = at(fills_o, int(xf.get("fillId", "0")))
                        if fl is None or fill_canon(fl) != v["fill"]:
                            eq["fill"] = one = False
                    b = at(borders_o, int(xf.get("borderId", "0")))
                    if b is None or border_canon(b) != v["border"]:
                        eq["border"] = one = False
                    if numfmt_of(sroot_o, xf) != v["numfmt"]:
                        eq["numfmt"] = one = False
                    if align_canon(xf) != v["align"] or prot_canon(xf) != v["prot"]:
                        eq["ap"] = one = False
                except (OutOfDesign, ValueError, TypeError):
                    for key in eq:
                        eq[key] = False
                    one = False
                equal += 1 if one else 0
            flags["xf_attrs"] = attrs_ok
            flags["fonts_equal"] = eq["font"] and len(added) == len(design)
            flags["fills_equal"] = eq["fill"] and len(added) == len(design)
            flags["borders_equal"] = eq["border"] and len(added) == len(design)
            flags["numfmts_equal"] = eq["numfmt"] and len(added) == len(design)
            flags["align_prot"] = eq["ap"] and len(added) == len(design)
            flags["growth"] = (counts_out["cellXfs"] == xi + len(used)
                               and counts_out["fonts"] == counts_in["fonts"] + distinct["font"]
                               and counts_out["fills"] == counts_in["fills"] + distinct["fill"]
                               and counts_out["borders"] == counts_in["borders"] + distinct["border"]
                               and counts_out["numFmts"] == counts_in["numFmts"] + len(new_codes))
        flags["others_same"] = (list(others) == [nm for nm in names_in_order if nm != sty]
                                and out_names == names_in_order
                                and all(others[nm] == zin.read(nm) for nm in others))
    
        in_only = out_only = want_in = want_out = flagged_rows = want_flagged = -1
        if sroot_o is not None:
            sv_in = values_of(sroot_i)
            sv_out = values_of(sroot_o)
            want_in = sum((sv_in - sv_out).values())
            want_out = sum((sv_out - sv_in).values())
        if extra == "xml_values":
            want_out += 1
        if diff_path is not None:
            rows = [l.split("\t") for l in open(diff_path, encoding="utf-8").read().split("\n") if l]
            values = {c[1]: c for c in rows if len(c) >= 7 and c[0] == "xml" and c[2] == "values"}
            if set(values) == {sty}:
                in_only = int(values[sty][5])
                out_only = int(values[sty][6])
            flags["xml_values"] = set(values) == {sty} and in_only == want_in and out_only == want_out
            ents = [{"name": c[1], "status": c[2], "flags": c[16]} for c in rows
                    if len(c) == 17 and c[0] == "entry"]
            flagged_rows = sum(1 for r in ents if r["flags"])
            wanted = {sty: ("descriptor" if bit3(zin, sty) == "1" else "")}
            if extra == "flagged":
                wanted = {nm: ("" if f else "descriptor") for (nm, f) in wanted.items()}
            want_flagged = sum(1 for f in wanted.values() if f)
            flags["flagged"] = (len(ents) > 0 and flagged_rows == want_flagged
                                and all(r["flags"] == wanted.get(r["name"], "") for r in ents))
    
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted), "case=%d" % case,
             "styles_in=%d" % len(used), "equal=%d" % equal,
             "xfs_in=%d" % xi, "xfs_out=%d" % counts_out["cellXfs"],
             "fonts_in=%d" % counts_in["fonts"], "fonts_out=%d" % counts_out["fonts"],
             "fills_in=%d" % counts_in["fills"], "fills_out=%d" % counts_out["fills"],
             "borders_in=%d" % counts_in["borders"], "borders_out=%d" % counts_out["borders"],
             "numfmts_in=%d" % counts_in["numFmts"], "numfmts_out=%d" % counts_out["numFmts"],
             "d_fonts=%d" % distinct["font"], "d_fills=%d" % distinct["fill"],
             "d_borders=%d" % distinct["border"], "new_codes=%d" % len(new_codes),
             "in_only=%d" % in_only, "in_only_want=%d" % want_in,
             "out_only=%d" % out_only, "out_only_want=%d" % want_out,
             "flagged_rows=%d" % flagged_rows, "flagged_want=%d" % want_flagged]
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS]))
    
    
    main()
