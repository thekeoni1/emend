    # Enables emend's own `rules` feature, for probe-emend-rules-write-xml alone
    # (specs/0020-validation-and-conditional-formatting.md, "Size", under
    # decision 1 A), built with its own feature set as the metadata probe is.
    rules = ["emend", "xml", "emend/rules"]
    # Enables emend's own `tables` feature, for probe-emend-tables-write-xml
    # alone (specs/0021-tables.md, "Size", under decision 2 A), built with its
    # own feature set as the rules probe is.
    tables = ["emend", "xml", "emend/tables"]
    # Enables emend's own `comments` feature, for
    # probe-emend-comments-write-xml alone (specs/0022-comments-and-images.md,
    # "Size", under decision 1 A), built with its own feature set as the tables
    # probe is.
    comments = ["emend", "xml", "emend/comments"]
    # Enables emend's own `images` feature, for probe-emend-images-write-xml
    # alone (specs/0022-comments-and-images.md, "Size", under decision 1 A),
    # built with its own feature set as the comments probe is.
    images = ["emend", "xml", "emend/images"]
    # Enables emend's own `richtext` feature, for probe-emend-richtext-write-xml
    # alone, and with `comments` for probe-emend-richcomment-write-xml
    # (specs/0024-rich-text.md, "Size", under decision 1 A), each built with its
    # own feature set as the comments probe is.
    richtext = ["emend", "xml", "emend/richtext"]
    # Enables emend's own `sheetprops` feature, for
    # probe-emend-sheetprops-write-xml alone, and with `metadata` for
    # probe-emend-printnames-write-xml (specs/0025-sheet-and-print-settings.md,
    # "Size", under decision 1 A), each built with its own feature set as the
    # richtext probes are.
    sheetprops = ["emend", "xml", "emend/sheetprops"]
    # Enables emend's own `read` feature, for probe-emend-read-write-xml alone
    # (specs/0027-read-back.md, "Size", under decision 1 A), built with its own
    # feature set as the sheetprops probe is.
    read = ["emend", "xml", "emend/read"]
    
