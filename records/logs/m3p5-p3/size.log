crates/emend/Cargo.toml (sha256 07267c8eac345c7687727fb0a096863e493882632424e0cf409f85d32b84448d):
    [package]
    name = "emend"
    version = "0.1.0"
    edition.workspace = true
    license.workspace = true
    publish = false
    
    # The core's two dependencies and nothing else (CLAUDE.md, "Dependencies and
    # licences"; specs/0008-zip-layer.md and specs/0009-package-layer.md, "Crate"),
    # pinned and featured exactly as the tools pin them. quick-xml joins the core in
    # Milestone 1 part 2 P1, which is why part 1's size measurement is the zip layer
    # alone. With default-features off it brings memchr and nothing more.
    [dependencies]
    zip = { version = "=8.6.0", default-features = false, features = ["deflate-flate2-zlib-rs"] }
    quick-xml = { version = "=0.42.0", default-features = false }
    
    # No dev-dependencies: the tests build archives byte by byte rather than
    # through a library, so a bug in a builder cannot hide the same bug in the
    # layer.
    
    # The date arithmetic of specs/0012-styles.md, "Module `dates`": off by
    # default, with no dependency of its own, so the core's size is the core's
    # and the feature's cost is measured beside it (CLAUDE.md, "Dependencies and
    # licences").
    [features]
    dates = []
    # The row and column insertions and deletions of
    # specs/0018-rows-and-columns.md (decision 7 A): off by default, with no
    # dependency of its own, measured beside the core as `dates` is. The column
    # formats, panes and merges of the same part stay in the core.
    rowcol = []
    # The defined names, hyperlinks, document properties and protection of
    # specs/0019-names-links-properties-protection.md (decision 1 A): off by
    # default, with no dependency of its own, measured beside the core as `dates`
    # and `rowcol` are.
    metadata = []
    # The data validations of specs/0020-validation-and-conditional-formatting.md,
    # and its conditional formats in later phases (decision 1 A): off by default,
    # with no dependency of its own, measured beside the core as `metadata` is.
    rules = []
    # The tables of specs/0021-tables.md (decision 2 A): off by default, with no
    # dependency of its own, measured beside the core as `rules` is.
    tables = []
    # The cell comments of specs/0022-comments-and-images.md (decision 1 A): off
    # by default, with no dependency of its own, measured beside the core as
    # `tables` is.
    comments = []
    # The rich text of specs/0024-rich-text.md (decision 1 A): runs with their own
    # font in a cell, and with `comments` in a comment. Off by default, with no
    # dependency of its own, measured beside the core as `comments` is.
    richtext = []
    # The sheet and print settings of specs/0025-sheet-and-print-settings.md
    # (decision 1 A): the tab colour, the sheet view and, in later phases, the
    # print options, margins, page setup, headers and footers. Off by default,
    # with no dependency of its own, measured beside the core as `richtext` is;
    # the calls that write defined names need `metadata` too.
    sheetprops = []
    # The images of specs/0022-comments-and-images.md (decision 1 A): off by
    # default, with no dependency of its own, measured beside the core as
    # `comments` is.
    images = []
    # The typed reads of specs/0027-read-back.md (decision 1 A): a cell's
    # format resolved into the types the writers take and, in later phases, the
    # column and row formats, the sheet's settings and the shared strings
    # iterator. Off by default, with no dependency of its own, measured beside
    # the core as `sheetprops` is.
    read = []
