### this log's generator, from the phase commit's template files
    """Fictional packages for M3 part 6 P1's negative log: the phase commit's
    template files, zipped in the template's order, and for the comment cases a
    worksheet rels part, a comments part holding one comment on B2 and a VML
    part holding its note shape, sized, appended (change RB). B0 is the bare
    template; NUC the comment case with the VML part's root end tag; NU the same
    without it.
    Usage: gen-p6.py <template dir> <out dir>."""
    import os
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    src, out = sys.argv[1], sys.argv[2]
    parts = {name: open(os.path.join(src, name), "rb").read() for name in ORDER}
    sheet = parts["xl/worksheets/sheet1.xml"]
    types = parts["[Content_Types].xml"]
    MAIN = b'<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
    R = b"http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    EMPTY = b"<sheetData/>"
    assert sheet.count(MAIN) == 1 and sheet.count(EMPTY) == 1 and sheet.count(b"<c ") == 0
    assert types.count(b"</Types>") == 1
    print("the template's worksheet: an empty sheetData alone, its root binding no prefix")
    
    COMMENTS = (b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                b'<comments xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
                b"<authors><author>emend</author></authors><commentList>"
                b'<comment ref="B2" authorId="0"><text><t>kept</t></text></comment>'
                b"</commentList></comments>")
    VML = (b'<xml xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" '
           b'xmlns:x="urn:schemas-microsoft-com:office:excel"><o:shapelayout v:ext="edit">'
           b'<o:idmap v:ext="edit" data="1"/></o:shapelayout><v:shape id="_x0000_s1025" '
           b'type="#_x0000_t202" style="position:absolute;width:108pt;height:59.25pt;visibility:hidden">'
           b'<x:ClientData ObjectType="Note"><x:Row>1</x:Row><x:Column>1</x:Column></x:ClientData>'
           b"</v:shape></xml>")
    RELS = (b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
            b'<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
            b'<Relationship Id="rId1" Type="' + R + b'/comments" Target="../comments1.xml"/>'
            b'<Relationship Id="rId2" Type="' + R + b'/vmlDrawing" Target="../drawings/vmlDrawing1.vml"/>'
            b"</Relationships>")
    OVERRIDES = (b'<Override PartName="/xl/comments1.xml" '
                 b'ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.comments+xml"/>'
                 b'<Override PartName="/xl/drawings/vmlDrawing1.vml" '
                 b'ContentType="application/vnd.openxmlformats-officedocument.vmlDrawing"/></Types>')
    CASES = {"b0": None, "nuc": VML, "nu": VML.replace(b"</xml>", b"")}
    assert VML.count(b"</xml>") == 1
    for name, vml in CASES.items():
        p = dict(parts)
        order = list(ORDER)
        if vml is not None:
            p["xl/worksheets/sheet1.xml"] = sheet.replace(
                MAIN, MAIN[:-1] + b' xmlns:r="' + R + b'">').replace(EMPTY, EMPTY + b'<legacyDrawing r:id="rId2"/>')
            p["[Content_Types].xml"] = types.replace(b"</Types>", OVERRIDES)
            p["xl/worksheets/_rels/sheet1.xml.rels"] = RELS
            p["xl/comments1.xml"] = COMMENTS
            p["xl/drawings/vmlDrawing1.vml"] = vml
            order += ["xl/worksheets/_rels/sheet1.xml.rels", "xl/comments1.xml", "xl/drawings/vmlDrawing1.vml"]
        with zipfile.ZipFile(os.path.join(out, name + ".xlsx"), "w") as z:
            for n in order:
                z.writestr(zipfile.ZipInfo(n, (1980, 1, 1, 0, 0, 0)), p[n], zipfile.ZIP_DEFLATED)
        w = p["xl/worksheets/sheet1.xml"]
        v = p.get("xl/drawings/vmlDrawing1.vml", b"")
        print("%s %d entries:%d legacyDrawing:%d comments:%d shapes:%d sized:%d root_end:%d" % (
            name + ".xlsx", os.path.getsize(os.path.join(out, name + ".xlsx")), len(order),
            w.count(b"<legacyDrawing"), p.get("xl/comments1.xml", b"").count(b"<comment "),
            v.count(b"<v:shape "), v.count(b"width:108pt;height:59.25pt"), v.count(b"</xml>")))
