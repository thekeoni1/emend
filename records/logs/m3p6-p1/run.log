## the survey of the corpus before the run (change UD)
command: cp <scripts>/cbsurvey.py <work>/cbsurvey.py; sed 's/^/    /' <work>/cbsurvey.py; sha256 2f99dd8496b55a58e8dccca546908efeac42b21763c3563102a7886e13d8d3ee, 8943 bytes
  the copy is the file beside this script, byte for byte: yes
    """The run log's survey of the corpus before the comment box sample's run
    (specs/0028-images-and-comments-second-half.md, "Harness runs", P1;
    specs/0024 P1 verification ruling 6's form: names, ids and counts only, the
    corpus directory a parameter).
    
    Usage: cbsurvey.py <corpus>
    
    Lists <corpus>/corpus (every regular file, no extension glob) and reads each
    workbook the manifest <corpus>/manifest.tsv names, in manifest order: the
    workbook part through the package relationships and W the first <sheet> in
    <sheets> order whose relationship is a worksheet's (zipfile and
    ElementTree, readers copied from M3 part 5 P1's rtsurvey.py), and W's part,
    its comments part (the first comments relationship's target) and its VML
    part (the target of the relationship W's main legacyDrawing names) read
    with expat WITHOUT namespace processing, each element's namespace resolved
    here from the declarations in scope: a reader of another lineage than the
    run log's comparison (byte spans and ElementTree) and the tool (the crate's
    token stream).
    
    Prints, tab-separated, one line per workbook:
      wb <id> <comments> <notes> <sized notes> <sized comments> <legacy>
         <comments part> <chain>
    where <comments> is the number of main comment elements in the comments
    part's main commentList (0 without the part); <notes> the VML root's shape
    children (urn:schemas-microsoft-com:vml) holding a ClientData
    (urn:schemas-microsoft-com:office:excel) of ObjectType Note; <sized notes>
    those whose style attribute, split at ";" and the first ":", the names
    trimmed and ASCII case folded, gives width and height each a decimal number
    of pt (times four thirds) or px, trimmed, rounded half up to a whole pixel
    from 1 to 65535; <sized comments> the comments whose cell's note (the first
    whose ClientData's Row and Column, trimmed, are the cell's zero-based row
    and column) is sized; <legacy> 1 when W has a main legacyDrawing child;
    <comments part> 1 when W has a comments relationship; <chain> 1 when
    xl/calcChain.xml is an entry. Last one line
      files <regular files in corpus/> <manifest rows> <rows read>
    No value, text, reference or part name is printed.
    """
    import fractions
    import os
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    from xml.parsers import expat
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    
    
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    
    
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    
    def rels(z, part):
        d, base = posixpath.split(part)
        name = posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            if el.get("TargetMode") == "External":
                continue
            t = el.get("Target", "")
            out.append((el.get("Id"), el.get("Type", ""),
                        t[1:] if t.startswith("/") else posixpath.normpath(posixpath.join(d, t))))
        return out
    
    
    def w_of(z):
        """W's part, or None."""
        wb = [t for (_, ty, t) in rels(z, "") if ty.endswith("/officeDocument")][0]
        by_id = {i: (ty, t) for (i, ty, t) in rels(z, wb)}
        for el in ET.fromstring(z.read(wb)).iter():
            if el.tag in ["{%s}sheet" % m for m in MAIN]:
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, t = by_id.get(rid, ("", None))
                if ty in [a + "/worksheet" for a in ATTR]:
                    return t
        return None
    
    V = "urn:schemas-microsoft-com:vml"
    X = "urn:schemas-microsoft-com:office:excel"
    
    
    def tree(data):
        """The part as nested [namespace, local name, attributes, children,
        text], namespaces resolved from the declarations in scope; an attribute
        keeps its name as written."""
        root = [None, "", {}, [], ""]
        stack = [root]
        scopes = [{}]
    
        def start(name, attrs):
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(scopes[-1])
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            scopes.append(scope)
            prefix, _, loc = name.rpartition(":")
            node = [scope.get(prefix), loc, dict(pairs), [], ""]
            node.append(scope)
            stack[-1][3].append(node)
            stack.append(node)
    
        def end(name):
            stack.pop()
            scopes.pop()
    
        def chars(data):
            stack[-1][4] += data
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.CharacterDataHandler = chars
        p.Parse(data, True)
        return root[3][0]
    
    
    def walk(node):
        yield node
        for k in node[3]:
            yield from walk(k)
    
    
    def px(value):
        m = re.fullmatch(r"([0-9]*)(\.[0-9]*)?(pt|px)", value)
        if m is None or not (m.group(1) or (m.group(2) or ".")[1:]):
            return None
        number = fractions.Fraction((m.group(1) or "0") + ((m.group(2) or ".") + "0"))
        if m.group(3) == "pt":
            number *= fractions.Fraction(4, 3)
        whole = int(number + fractions.Fraction(1, 2))
        return whole if 1 <= whole <= 65535 else None
    
    
    def is_sized(shape):
        d = {}
        for decl in shape[2].get("style", "").split(";"):
            if ":" in decl:
                k, v = decl.split(":", 1)
                d[k.strip(" \t\r\n").lower()] = v.strip(" \t\r\n")
        return px(d.get("width", "")) is not None and px(d.get("height", "")) is not None
    
    
    def notes_of(vml):
        """(row, column, sized) of each note shape of a VML part."""
        out = []
        for shape in vml[3]:
            if shape[0] != V or shape[1] != "shape":
                continue
            cds = [n for n in walk(shape) if n[0] == X and n[1] == "ClientData"
                   and n[2].get("ObjectType") == "Note"]
            if not cds:
                continue
            rows = [k[4].strip() for k in cds[0][3] if k[0] == X and k[1] == "Row"]
            cols = [k[4].strip() for k in cds[0][3] if k[0] == X and k[1] == "Column"]
            out.append((rows[0] if rows else None, cols[0] if cols else None, is_sized(shape)))
        return out
    
    
    def cell_of(ref):
        m = re.fullmatch(r"\$?([A-Z]+)\$?([0-9]+)", ref or "")
        if m is None:
            return None
        col = 0
        for ch in m.group(1):
            col = col * 26 + ord(ch) - 64
        return (str(int(m.group(2)) - 1), str(col - 1))
    
    
    def main():
        corpus = sys.argv[1]
        lines = open(os.path.join(corpus, "manifest.tsv"), encoding="utf-8").read().split("\n")
        head = lines[0].split("\t")
        rows = [l.split("\t") for l in lines[1:] if l]
        files = sorted(f for f in os.listdir(os.path.join(corpus, "corpus"))
                       if os.path.isfile(os.path.join(corpus, "corpus", f)))
        read = 0
        for row in rows:
            cid, ext = row[head.index("id")], row[head.index("ext")]
            name = "%s.%s" % (cid, ext)
            if name not in files:
                print("wb\t%s\tmissing" % cid)
                continue
            z = zipfile.ZipFile(os.path.join(corpus, "corpus", name))
            part = w_of(z)
            if part is None:
                print("wb\t%s\tno-worksheet" % cid)
                continue
            w_rels = rels(z, part)
            w = tree(z.read(part))
            legacy_id = None
            legacy = 0
            for k in w[3]:
                if k[0] in MAIN and k[1] == "legacyDrawing":
                    legacy = 1
                    for (an, av) in k[2].items():
                        prefix, _, loc = an.rpartition(":")
                        if loc == "id" and k[5].get(prefix) in ATTR:
                            legacy_id = av
            cpart = next((t for (i, ty, t) in w_rels if ty in [a + "/comments" for a in ATTR]), None)
            vpart = next((t for (i, ty, t) in w_rels if i == legacy_id), None) if legacy_id else None
            notes = notes_of(tree(z.read(vpart))) if vpart and vpart in z.namelist() else []
            comments = 0
            sized_comments = 0
            if cpart and cpart in z.namelist():
                c = tree(z.read(cpart))
                for lst in c[3]:
                    if lst[0] in MAIN and lst[1] == "commentList":
                        for cm in lst[3]:
                            if cm[0] in MAIN and cm[1] == "comment":
                                comments += 1
