## the survey of the corpus before the run (change VD)
command: cp <scripts>/imgsurvey.py <work>/imgsurvey.py; sed 's/^/    /' <work>/imgsurvey.py; sha256 04cfe303e0e9beebe0178ccea3e68c05138b593d5ce3f2c7c8a1d1c80824a8c0, 11421 bytes
  the copy is the file beside this script, byte for byte: yes
    """The run log's survey of the corpus before M3 part 6 P2's runs
    (specs/0028-images-and-comments-second-half.md, "Harness runs", P2, and
    decision 8; specs/0024 P1 verification ruling 6's form: names, ids and
    counts only, the corpus directory a parameter).
    
    Usage: imgsurvey.py <corpus>
    
    Lists <corpus>/corpus (every regular file, no extension glob) and reads each
    workbook the manifest <corpus>/manifest.tsv names, in manifest order: the
    workbook part through the package relationships and W the first <sheet> in
    <sheets> order whose relationship is a worksheet's (zipfile and
    ElementTree, readers copied from M3 part 6 P1's cbsurvey.py), and W's part
    and its drawing part D (the target of the relationship W's main drawing
    child names) read with expat WITHOUT namespace processing, each element's
    namespace resolved here from the declarations in scope: a reader of another
    lineage than the run log's comparison (byte spans and ElementTree) and the
    tool (the crate's token stream).
    
    Prints, tab-separated, one line per workbook:
      wb <id> <images> <two> <absolute> <anchors> <media> <drawing> <empty>
         <wrels> <drels> <dropped> <chain>
    where <images> is the pictures by the read's rules (each root anchor of D,
    oneCellAnchor, twoCellAnchor or absoluteAnchor of the spreadsheet-drawing
    namespace, or the first anchor in a root AlternateContent's first Choice,
    holding a pic directly, in a grpSp or in an AlternateContent's first
    Choice, the first found); <two> and <absolute> those of each anchor kind;
    <anchors> D's root children; <media> the archive's entries under xl/media/;
    <drawing> 1 when W has a main drawing child; <empty> 1 when D has no root
    child; <wrels> and <drels> 1 when W's and D's rels parts are entries;
    <dropped> when an image is listed, the media entries the removal of the
    first drops by the spec's count rule (the values of the relationships-
    namespace attributes named embed or link in the first picture's root child
    that no relationships-namespace attribute of another root child carries;
    their internal targets through D's rels part; each one whose relationships
    in every rels part of the archive are only those), else 0; <chain> 1 when
    xl/calcChain.xml is an entry. Then one line
      drawings <drawing parts> <workbooks holding one> <largest anchor count>
    over every entry xl/drawings/<name>.xml whose root is wsDr, an anchor
    counted as a root child that is one or an AlternateContent holding one
    (decision 8: the drawing hold's figure), and last one line
      files <regular files in corpus/> <manifest rows> <rows read>
    No value, text, reference or part name is printed.
    """
    import os
    import posixpath
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    from xml.parsers import expat
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    
    
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    
    
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    
    def rels(z, part):
        d, base = posixpath.split(part)
        name = posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            if el.get("TargetMode") == "External":
                continue
            t = el.get("Target", "")
            out.append((el.get("Id"), el.get("Type", ""),
                        t[1:] if t.startswith("/") else posixpath.normpath(posixpath.join(d, t))))
        return out
    
    
    def w_of(z):
        """W's part, or None."""
        wb = [t for (_, ty, t) in rels(z, "") if ty.endswith("/officeDocument")][0]
        by_id = {i: (ty, t) for (i, ty, t) in rels(z, wb)}
        for el in ET.fromstring(z.read(wb)).iter():
            if el.tag in ["{%s}sheet" % m for m in MAIN]:
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, t = by_id.get(rid, ("", None))
                if ty in [a + "/worksheet" for a in ATTR]:
                    return t
        return None
    
    
    def tree(data):
        """The part as nested [namespace, local name, attributes, children,
        text], namespaces resolved from the declarations in scope; an attribute
        keeps its name as written."""
        root = [None, "", {}, [], ""]
        stack = [root]
        scopes = [{}]
    
        def start(name, attrs):
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(scopes[-1])
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            scopes.append(scope)
            prefix, _, loc = name.rpartition(":")
            node = [scope.get(prefix), loc, dict(pairs), [], ""]
            node.append(scope)
            stack[-1][3].append(node)
            stack.append(node)
    
        def end(name):
            stack.pop()
            scopes.pop()
    
        def chars(data):
            stack[-1][4] += data
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.CharacterDataHandler = chars
        p.Parse(data, True)
        return root[3][0]
    
    
    def walk(node):
        yield node
        for k in node[3]:
            yield from walk(k)
    
    
    XDR = ("http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing",
           "http://purl.oclc.org/ooxml/drawingml/spreadsheetDrawing")
    MC = "http://schemas.openxmlformats.org/markup-compatibility/2006"
    ANCHORS = ("oneCellAnchor", "twoCellAnchor", "absoluteAnchor")
    
    
    def is_(node, spaces, name):
        return node[0] in spaces and node[1] == name
    
    
    def first_choice(node):
        choices = [k for k in node[3] if is_(k, (MC,), "Choice")]
        return choices[0] if choices else None
    
    
    def holds_pic(anchor):
        for k in anchor[3]:
            if is_(k, XDR, "pic"):
                return True
            if is_(k, XDR, "grpSp"):
                return any(is_(n, XDR, "pic") for n in walk(k))
            if is_(k, (MC,), "AlternateContent"):
                ch = first_choice(k)
                if ch is not None:
                    return any(is_(n, XDR, "pic") for n in walk(ch))
        return False
    
    
    def pictures(droot):
        """(root child index, anchor kind) of each picture by the read's
        rules."""
        out = []
        for (i, k) in enumerate(droot[3]):
            if k[0] in XDR and k[1] in ANCHORS:
                if holds_pic(k):
                    out.append((i, k[1]))
            elif is_(k, (MC,), "AlternateContent"):
                ch = first_choice(k)
                if ch is not None:
                    inner = [a for a in ch[3] if a[0] in XDR and a[1] in ANCHORS]
                    if inner and holds_pic(inner[0]):
                        out.append((i, inner[0][1]))
        return out
    
    
    def rel_values(node):
        """(local name, value) of every attribute in the node and below whose
        prefix the scope binds to the relationships namespace."""
        out = []
        for n in walk(node):
            for (an, av) in n[2].items():
                prefix, _, loc = an.rpartition(":")
                if prefix and n[5].get(prefix) in ATTR:
                    out.append((loc, av))
        return out
    
    
    def anchors_of(droot):
        """D's root children that are an anchor or hold one at any depth."""
        return sum(1 for k in droot[3] if any(n[0] in XDR and n[1] in ANCHORS for n in walk(k)))
    
    
    def every_target(z):
        """The internal targets of every relationship of every rels part."""
        out = []
        for nm in z.namelist():
            if not nm.endswith(".rels"):
                continue
            d, base = posixpath.split(nm)
            src = "" if base == ".rels" else posixpath.join(posixpath.dirname(d), base[:-len(".rels")])
            out += [t for (_, _, t) in rels(z, src)]
        return out
    
    
    def dropped_of(z, dpart, droot, pics):
        if not pics:
            return 0
        first = pics[0][0]
        kids = droot[3]
        named = [v for (loc, v) in rel_values(kids[first]) if loc in ("embed", "link")]
        others = {v for (i, k) in enumerate(kids) if i != first for (_, v) in rel_values(k)}
        removed = []
        for v in named:
            if v not in others and v not in removed:
                removed.append(v)
        drel = rels(z, dpart)
        targets = []
        for (i, ty, t) in drel:
            if i in removed and t.startswith("xl/media/") and t not in targets:
                targets.append(t)
        every = every_target(z)
        n = 0
        for t in targets:
            r = sum(1 for (i, ty, tt) in drel if tt == t and i in removed)
            if r > 0 and every.count(t) == r and t in z.namelist():
                n += 1
        return n
    
    
    def main():
        corpus = sys.argv[1]
        lines = open(os.path.join(corpus, "manifest.tsv"), encoding="utf-8").read().split("\n")
        head = lines[0].split("\t")
        rows = [l.split("\t") for l in lines[1:] if l]
        files = sorted(f for f in os.listdir(os.path.join(corpus, "corpus"))
                       if os.path.isfile(os.path.join(corpus, "corpus", f)))
        read = 0
        nparts = nbooks = largest = 0
        for row in rows:
            cid, ext = row[head.index("id")], row[head.index("ext")]
            name = "%s.%s" % (cid, ext)
            if name not in files:
                print("wb\t%s\tmissing" % cid)
                continue
            z = zipfile.ZipFile(os.path.join(corpus, "corpus", name))
            here = 0
            for nm in z.namelist():
                if re.fullmatch(r"xl/drawings/[^/]+\.xml", nm):
                    root = tree(z.read(nm))
                    if root[0] in XDR and root[1] == "wsDr":
                        nparts += 1
                        here = 1
                        largest = max(largest, anchors_of(root))
            nbooks += here
            part = w_of(z)
            if part is None:
                print("wb\t%s\tno-worksheet" % cid)
                continue
            w_rels = rels(z, part)
            w = tree(z.read(part))
            drawing = 0
            dr_id = None
            for k in w[3]:
                if k[0] in MAIN and k[1] == "drawing":
                    drawing = 1
                    for (an, av) in k[2].items():
                        prefix, _, loc = an.rpartition(":")
                        if loc == "id" and k[5].get(prefix) in ATTR:
                            dr_id = av
            dpart = next((t for (i, ty, t) in w_rels if i == dr_id), None) if dr_id else None
            images = two = absolute = anchors = empty = drels = dropped = 0
            if dpart and dpart in z.namelist():
                droot = tree(z.read(dpart))
                pics = pictures(droot)
                images = len(pics)
                two = sum(1 for (_, kind) in pics if kind == "twoCellAnchor")
                absolute = sum(1 for (_, kind) in pics if kind == "absoluteAnchor")
                anchors = len(droot[3])
                empty = 1 if not droot[3] else 0
                d, base = posixpath.split(dpart)
                drels = 1 if posixpath.join(d, "_rels", base + ".rels") in z.namelist() else 0
                dropped = dropped_of(z, dpart, droot, pics)
            d, base = posixpath.split(part)
            wrels = 1 if posixpath.join(d, "_rels", base + ".rels") in z.namelist() else 0
            media = sum(1 for nm in z.namelist() if nm.startswith("xl/media/"))
            chain = 1 if "xl/calcChain.xml" in z.namelist() else 0
            read += 1
            print("\t".join(["wb", cid] + [str(v) for v in (
                images, two, absolute, anchors, media, drawing, empty, wrels, drels, dropped, chain)]))
        print("drawings\t%d\t%d\t%d" % (nparts, nbooks, largest))
        print("files\t%d\t%d\t%d" % (len(files), len(rows), read))
    
    
    main()
