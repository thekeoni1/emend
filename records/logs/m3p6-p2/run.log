    """The run log's own image comparison for M3 part 6 P2
    (specs/0028-images-and-comments-second-half.md, "Harness runs",
    --anchor-sample and --remove-image-sample and the run log's own check, the
    anchor and removeimage bullets; "Anchors" and "Image removal"; the planning
    rulings during P2, 1 to 3).
    
    Usage: imgcmp.py anchor <input archive> <output archive> [--diff <diff.tsv>] [--plant <flag>]
           imgcmp.py removeimage <input archive> <output archive> [--diff <diff.tsv>] [--plant <flag>]
           imgcmp.py anchor|removeimage <input archive> --parts
    
    Its readers are M2 part 4d P3's imgcmp.py's (the image sample's comparison)
    and M3 part 6 P1's cbcmp.py's values, bit 3 and xml-name readers, copied by
    name by <home>/.cache/emend-build/m3p6-p2/gen/imgcmp_build.py; it shares no
    code with the library or the tool. It reads both archives with zipfile, byte
    spans and ElementTree, finds the workbook part through the package
    relationship, W (the first <sheet> in <sheets> order whose relationship type
    is a worksheet's), whether W's relationship is strict, M (the largest row
    number of a <c> in W's sheetData, 0 when none), W's rels part, W's drawing
    part D (the one W's main drawing element's r:id names) and D's rels part.
    
    anchor: the sample puts the tool's PNG on a two-cell anchor from (M + 1, 1)
    to (M + 3, 3), editAs oneCell, zero offsets, then on an absolute anchor at
    96 by 96 pixels sized 4 by 4. From the input it builds, by the design's
    rules, what the output must hold: the two media entries
    xl/media/image<n>.png, n the smallest positive integer with neither
    image<n>.png nor image<n>.jpeg taken (ASCII case folded), the second after
    the first is taken; a created D as part 4d's; the relationship ids, rId one
    past the largest numbered id of the part's rels part, then the next; I, one
    above the largest cNvPr id anywhere in a kept D (1 in a created one), then
    I + 1. Flags:
    
      root_tag .. images_read  part 4d's ten checks (root tag, rest of W, the
                        drawing element's place, root order, W's rels, content
                        types, D, D's rels, the media, the images read), now for
                        two anchors, two relationships, two media entries and two
                        Overrides, in that order
      two_form          read with ElementTree, the second-to-last root child of D
                        is a twoCellAnchor with editAs oneCell, from col 0 colOff
                        0 row M rowOff 0, to col 2 colOff 0 row M + 2 rowOff 0,
                        no ext child, and cNvPr id I (the spec's anchor check)
      absolute_form     the last root child of D is an absoluteAnchor with pos x
                        914400 y 914400, ext cx 38100 cy 38100, and cNvPr id
                        I + 1 (the spec's anchor check)
      kept_children     by byte spans, every root child of the input D is in the
                        output's, in order, byte for byte, and the output's root
                        holds exactly two children more, the last two (the
                        spec's "the kept children byte-identical"; a created D
                        keeps none)
    
    removeimage: the sample adds the tool's PNG on (M + 1, 1), writes into
    memory, reopens, removes that image and, when the input's images are not
    none, the first of them. The picture removed is the input's first by the
    read's rules; its root child of D (an anchor, or the root AlternateContent
    whose first Choice holds it) goes; the removed relationship ids are the
    values of the relationships-namespace attributes named embed or link inside
    it that no relationships-namespace attribute of another root child carries;
    D is dropped when no root child left holds an anchor (D, its rels part, its
    Override, W's relationship and W's drawing element). Flags:
    
      sheet_same        W is the input's, byte for byte (uncompressed); where D
                        is dropped, the input's with its drawing element cut
      drawing_children  D is the input's, byte for byte, with the removed root
                        child's span cut out (none cut when no input image); no
                        D where it is dropped or the input has none (the spec's
                        removeimage check)
      drawing_rels_set  D's rels part's relationships (Id, Type, Target,
                        TargetMode) are the input's less the removed ids, in
                        order; where the input has no D rels part, none or one
                        whose root has no child (ruling 2); none where D is
                        dropped (the spec's removeimage check)
      media_dropped     for each media entry D's rels part targets, c the
                        relationships of every rels part of the input that
                        target it and r the removed ones that do: the entry is
                        gone exactly when r > 0 and c = r; no other entry of the
                        input is gone, none added (the spec's removeimage check)
      types_set         the content types' children are the input's less the
                        Override of each dropped part
      wrels_set         W's rels part's relationships are the input's, less W's
                        drawing relationship where D is dropped; where the input
                        has none, none or one whose root has no child (ruling 2)
      added_empty       the output's entries the input lacks are at most one, W's
                        rels part or D's rels part, whose root has no child
                        (ruling 2)
      images_read       the output's pictures by the read's rules are the
                        input's less the first when one was removed
    
    Both: xml_values and flagged as cbcmp.py's (specs/0024 P1 verification
    ruling 6, rtcmp.py's form) with --diff; flagged now over every entry the
    write rewrote: the diff table's changed and recompressed rows are exactly
    the entries both archives hold whose uncompressed bytes, compression method
    or compressed bytes differ (changed exactly when the uncompressed bytes
    differ), each flagged descriptor exactly when general purpose bit 3 differs
    or the bytes after its data up to the next local header (its data
    descriptor) differ, read here through the local headers (xlsx-diff's rule,
    computed independently; for a changed entry whose bit 3 both sides keep,
    that is when the input sets it, as cbcmp.py's rule reads), and no other row
    flagged (ruling 1: a recompressed entry is one the write rewrote, its
    descriptor carrying the new compressed size).
    
    It prints ONE line of counts and yes/no flags and no text, reference, sheet
    name or part name. --parts prints, one per line, for the log to compare
    with the runner's rows without printing them: anchor: W's part, its rels
    part, D's entry, D's rels entry, the two media entries, and 1 or 0 for the
    input's W rels part, drawing element and D rels part; removeimage: W's part,
    its rels part, D's entry and D's rels entry (- without D), 1 or 0 for the
    input's W rels part, drawing element and D rels part, D empty (no root
    child), an image removed (kept), D dropped, an Override of a dropped part,
    then the count of media entries dropped and their names. --plant <flag>
    changes the output as read (or, for xml_values and flagged, the rule) so
    that the named flag turns to no; the line then says planted=yes, or
    planted=no when the pair gives the plant nothing to change.
    """
    import collections
    import posixpath
    import re
    import struct
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    
    
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    
    
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    
    XDR = ("http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing",
           "http://purl.oclc.org/ooxml/drawingml/spreadsheetDrawing")
    
    
    A = ("http://schemas.openxmlformats.org/drawingml/2006/main",
         "http://purl.oclc.org/ooxml/drawingml/main")
    
    
    MC = "http://schemas.openxmlformats.org/markup-compatibility/2006"
    
    
    DRAWING_TYPE = b"application/vnd.openxmlformats-officedocument.drawing+xml"
    
    
    TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    
    
    COMMENT = b"<!-- planted -->"
    
    
    DR = "drawing"
    
    
    DECL = b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    
    
    PNG = bytes([
        0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d, 0x49, 0x48, 0x44, 0x52,
        0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x02, 0x08, 0x02, 0x00, 0x00, 0x00, 0xfd, 0xd4, 0x9a,
        0x73, 0x00, 0x00, 0x00, 0x19, 0x49, 0x44, 0x41, 0x54, 0x78, 0x01, 0x01, 0x0e, 0x00, 0xf1, 0xff,
        0x00, 0xff, 0x00, 0x00, 0x00, 0xff, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0x1f, 0xee,
        0x05, 0xfb, 0xde, 0xdd, 0xec, 0x2b, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4e, 0x44, 0xae, 0x42,
        0x60, 0x82])
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    def sheets_of(z, workbook):
        """(part, relationship type) of every <sheet>, in <sheets> order."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        out = []
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                ty, target = by_id.get(rid, ("", None))
                out.append((target, ty))
        return out
    
    
    def pick_w(z, workbook):
        """(W's part, whether its relationship is strict), or (None, False)."""
        for (target, ty) in sheets_of(z, workbook):
            if ty in (ATTR[0] + "/worksheet", ATTR[1] + "/worksheet"):
                return target, ty.startswith(ATTR[1])
        return None, False
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def attr_value(tag, name):
        m = re.search(ATTR_RE % re.escape(name), tag)
        return m.group(1)[1:-1] if m else None
    
    
    def with_attr(tag, name, value):
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def children(data, a, b, rp, root_ns):
        """[(start, end, main local name or None)] of the root's children."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            p, n = split_name(qname(raw))
            tag = start_tag(raw)
            decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
            own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
            if own:
                main = own.group(1)[1:-1].decode() in MAIN
            else:
                main = p == rp and root_ns in MAIN
            out.append((a + x, a + y, n if main else None))
        return out
    
    
    def cut(data, spans):
        parts, at = [], 0
        for (x, y) in sorted(spans):
            parts.append(data[at:x])
            at = y
        parts.append(data[at:])
        return b"".join(parts)
    
    
    def rels_prefix_of(tag):
        """The prefix a start tag binds to the relationships namespace, either
        form, or None."""
        for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            if m.group(2)[1:-1].decode() in ATTR:
                return m.group(1)
        return None
    
    
    def prefix_for(tag, uri):
        """The prefix a start tag binds to `uri`, or None."""
        for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            if m.group(2)[1:-1].decode() == uri:
                return m.group(1)
        return None
    
    
    def m_of(data):
        """The largest row number of a <c> in every main sheetData root child."""
        m = 0
        for sd in ET.fromstring(data):
            ns, name = local(sd.tag)
            if ns not in MAIN or name != "sheetData":
                continue
            for row in sd:
                for c in row:
                    cns, cname = local(c.tag)
                    if cns in MAIN and cname == "c":
                        got = re.match(r"^\$?[A-Z]+\$?([0-9]+)$", c.get("r", ""))
                        if got:
                            m = max(m, int(got.group(1)))
        return m
    
    
    def relative(src, dst):
        s = src.split("/")[:-1]
        d = dst.split("/")
        common = 0
        while common < len(s) and common < len(d) - 1 and s[common] == d[common]:
            common += 1
        return "../" * (len(s) - common) + "/".join(d[common:])
    
    
    def before_end(data, element):
        """The bytes with element inserted before the root's end tag, the root
        opened up first when it is empty."""
        ts, te, a, b, _ = root_span(data)
        tag = data[ts:te]
        if tag.endswith(b"/>"):
            return data[:ts] + opened(tag) + element + b"</" + qname(tag) + b">" + data[te:]
        return data[:b] + element + data[b:]
    
    
    def package_prefix(z):
        """The bytes a created rels part begins with: the package's own
        _rels/.rels up to its root start tag."""
        data = z.read("_rels/.rels")
        return data[:root_span(data)[0]]
    
    
    ANCHORS = ("oneCellAnchor", "twoCellAnchor", "absoluteAnchor")
    
    
    def pictures(data):
        """The (kind, from column, from row, r:embed) of each picture by the
        read's rules: each root anchor, or the first anchor in a root
        AlternateContent's first Choice, holding a pic directly, in a grpSp or
        in an AlternateContent's first Choice, the first found."""
        root = ET.fromstring(data)
        out = []
    
        def first_pic(anchor):
            for child in anchor:
                ns, name = local(child.tag)
                if ns in XDR and name == "pic":
                    return child
                if ns in XDR and name == "grpSp":
                    for el in child.iter():
                        if local(el.tag)[1] == "pic" and local(el.tag)[0] in XDR:
                            return el
                if ns == MC and name == "AlternateContent":
                    choices = [c for c in child if local(c.tag) == (MC, "Choice")]
                    if choices:
                        for el in choices[0].iter():
                            if local(el.tag)[1] == "pic" and local(el.tag)[0] in XDR:
                                return el
            return None
    
        def read(anchor):
            pic = first_pic(anchor)
            if pic is None:
                return
            kind = local(anchor.tag)[1]
            blips = [el for el in pic.iter() if local(el.tag)[1] == "blip" and local(el.tag)[0] in A]
            embed = None
            if blips:
                embed = next((blips[0].get("{%s}embed" % a) for a in ATTR if blips[0].get("{%s}embed" % a)), None)
            col = row = None
            for child in anchor:
                if local(child.tag) in ((x, "from") for x in XDR):
                    for f in child:
                        if local(f.tag)[1] == "col":
                            col = f.text
                        if local(f.tag)[1] == "row":
                            row = f.text
            out.append((kind, col, row, embed))
    
        for child in root:
            ns, name = local(child.tag)
            if ns in XDR and name in ANCHORS:
                read(child)
            elif ns == MC and name == "AlternateContent":
                choices = [c for c in child if local(c.tag) == (MC, "Choice")]
                if choices:
                    inner = [a for a in choices[0] if local(a.tag)[0] in XDR and local(a.tag)[1] in ANCHORS]
                    if inner:
                        read(inner[0])
        return out
    
    
    def largest_id(data):
        """The largest cNvPr id anywhere in a drawing part (P3 ruling 1)."""
        ids = [int(el.get("id")) for el in ET.fromstring(data).iter()
               if local(el.tag)[1] == "cNvPr" and (el.get("id") or "").isdigit()]
        return max(ids) if ids else 0
    
    
    def bound_prefix(tag, uris):
        """The prefix a start tag binds to one of `uris`, b"" for the default
        namespace, or None."""
        for m in re.finditer(rb'\sxmlns(?::([^\s=/>]+))?\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            if m.group(2)[1:-1].decode() in uris:
                return m.group(1) or b""
        return None
    
    
    def next_id(rels):
        numbers = [int(i[3:]) for (i, _, _) in rels if re.match(r"^rId[0-9]+$", i or "")]
        return max(numbers) + 1 if numbers else 1
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def values_of(root):
        """The values of an ElementTree as xlsx-diff keys them (M3 part 5 P1's
        rtcmp.py, copied by name): each attribute (namespace declarations are
        not attributes here) by element, attribute and value; each text node
        that is not whitespace alone by its element and its text."""
        vals = collections.Counter()
        ws = " \t\n\r"
    
        def walk(el):
            for (k, v) in el.attrib.items():
                vals[("a", el.tag, k, v)] += 1
            if el.text and el.text.strip(ws):
                vals[("t", el.tag, el.text)] += 1
            for c in el:
                walk(c)
                if c.tail and c.tail.strip(ws):
                    vals[("t", el.tag, c.tail)] += 1
    
        walk(root)
        return vals
    
    
    def bit3(zin, name):
        """1 or 0 for whether the input's entry sets general purpose bit 3, -
        when there is no such entry (rtcmp.py's, copied by name)."""
        try:
            return "1" if zin.getinfo(name).flag_bits & 0x08 else "0"
        except KeyError:
            return "-"
    
    
    def is_xml_name(name):
        return name.lower().endswith((".xml", ".rels", ".vml"))
    
    
    assert len(TABLE) == 39
    assert len(PNG) == 82
    
    FLAGS_OF = {
        "anchor": ("root_tag", "rest_same", "drawing_place", "root_order", "rels_bytes", "types_bytes",
                   "drawing_bytes", "drawing_rels_bytes", "media_bytes", "images_read", "two_form",
                   "absolute_form", "kept_children", "xml_values", "flagged"),
        "removeimage": ("sheet_same", "drawing_children", "drawing_rels_set", "media_dropped", "types_set",
                        "wrels_set", "added_empty", "images_read", "xml_values", "flagged"),
    }
    # The sample's constants (tools/emend-copy, --anchor-sample): the absolute
    # anchor at 96 by 96 pixels and 4 by 4 pixels, at 9525 EMU each.
    POS = b"914400"
    EXT4 = b"38100"
    MEDIA_PREFIX = "xl/media/"
    
    
    def first_pic(anchor):
        """The picture an anchor holds by the read's rules (part 4d's
        pictures()'s, as a function of its own), or None."""
        for child in anchor:
            ns, name = local(child.tag)
            if ns in XDR and name == "pic":
                return child
            if ns in XDR and name == "grpSp":
                for el in child.iter():
                    if local(el.tag)[1] == "pic" and local(el.tag)[0] in XDR:
                        return el
            if ns == MC and name == "AlternateContent":
                choices = [c for c in child if local(c.tag) == (MC, "Choice")]
                if choices:
                    for el in choices[0].iter():
                        if local(el.tag)[1] == "pic" and local(el.tag)[0] in XDR:
                            return el
        return None
    
    
    def picture_roots(data):
        """The index of the root child each picture of pictures() sits in, in
        the same order."""
        out = []
        for (i, child) in enumerate(ET.fromstring(data)):
            ns, name = local(child.tag)
            if ns in XDR and name in ANCHORS:
                if first_pic(child) is not None:
                    out.append(i)
            elif ns == MC and name == "AlternateContent":
                choices = [c for c in child if local(c.tag) == (MC, "Choice")]
                if choices:
                    inner = [a for a in choices[0] if local(a.tag)[0] in XDR and local(a.tag)[1] in ANCHORS]
                    if inner and first_pic(inner[0]) is not None:
                        out.append(i)
        return out
    
    
    def holds_anchor(el):
        return any(local(e.tag)[0] in XDR and local(e.tag)[1] in ANCHORS for e in el.iter())
    
    
    def rel_attrs(el):
        """(local name, value) of every relationships-namespace attribute in an
        element and its descendants."""
        out = []
        for e in el.iter():
            for (k, v) in e.attrib.items():
                ns, name = local(k)
                if ns in ATTR:
                    out.append((name, v))
        return out
    
    
    def rel_tuples(z, name):
        """(Id, Type, Target, TargetMode) of a rels part's relationships, in
        order, or None when the archive has no such entry."""
        if name not in z.namelist():
            return None
        return [(el.get("Id"), el.get("Type"), el.get("Target"), el.get("TargetMode"))
                for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS)]
    
    
    def root_childless(data):
        return len(list(ET.fromstring(data))) == 0
    
    
    def type_tuples(data):
        return [(local(el.tag)[1], el.get("PartName"), el.get("Extension"), el.get("ContentType"))
                for el in ET.fromstring(data)]
    
    
    def raw_of(z, name):
        """(compression method, the entry's stored bytes) read through its local
        header."""
        zi = z.getinfo(name)
        fp = z.fp
        fp.seek(zi.header_offset)
        head = fp.read(30)
        n, m = struct.unpack("<HH", head[26:30])
        fp.seek(zi.header_offset + 30 + n + m)
        return zi.compress_type, fp.read(zi.compress_size)
    
    
    def gap_of(z, name):
        """The bytes after an entry's stored data up to the next local header,
        or the central directory: its data descriptor, when it has one
        (xlsx-diff's gap, read here through the local headers)."""
        zi = z.getinfo(name)
        fp = z.fp
        fp.seek(zi.header_offset)
        head = fp.read(30)
        n, m = struct.unpack("<HH", head[26:30])
        end = zi.header_offset + 30 + n + m + zi.compress_size
        later = [i.header_offset for i in z.infolist() if i.header_offset >= end]
        nxt = min(later + [z.start_dir])
        fp.seek(end)
        return fp.read(max(0, nxt - end))
    
    
    def descriptor_differs(zin, zout, name):
        """xlsx-diff's descriptor flag for an entry both archives hold: general
        purpose bit 3 differs, or the bytes after the data differ."""
        b_in = zin.getinfo(name).flag_bits & 0x08
        b_out = zout.getinfo(name).flag_bits & 0x08
        return b_in != b_out or gap_of(zin, name) != gap_of(zout, name)
    
    
    def free_media(folded):
        n = 1
        while ("xl/media/image%d.png" % n) in folded or ("xl/media/image%d.jpeg" % n) in folded:
            n += 1
        name = "xl/media/image%d.png" % n
        folded.add(name)
        return name
    
    
    def pic_el(x, ap, bind_r, rp, ident, rid):
        i = str(ident).encode()
        return (b"<" + x + b"pic><" + x + b"nvPicPr><" + x + b'cNvPr id="' + i + b'" name="Image ' + i
                + b'"/><' + x + b"cNvPicPr/></" + x + b"nvPicPr><" + x + b"blipFill><" + ap + b"blip" + bind_r
                + b" " + rp + b':embed="' + rid + b'"/><' + ap + b"stretch><" + ap + b"fillRect/></" + ap
                + b"stretch></" + x + b"blipFill><" + x + b"spPr><" + ap + b'prstGeom prst="rect"><' + ap
                + b"avLst/></" + ap + b"prstGeom></" + x + b"spPr></" + x + b"pic><" + x + b"clientData/>")
    
    
    def forms(a, r, strict):
        s = 1 if strict else 0
        ap = (a + b":" if a else b"") if a is not None else b"a:"
        rp = r if r is not None else b"r"
        bind_a = b' xmlns:a="' + A[s].encode() + b'"' if a is None else b""
        bind_r = b' xmlns:r="' + ATTR[s].encode() + b'"' if r is None else b""
        return ap, rp, bind_a, bind_r
    
    
    def marker(x, name, col, row):
        return (b"<" + x + name + b"><" + x + b"col>" + str(col).encode() + b"</" + x + b"col><" + x
                + b"colOff>0</" + x + b"colOff><" + x + b"row>" + str(row).encode() + b"</" + x + b"row><"
                + x + b"rowOff>0</" + x + b"rowOff></" + x + name + b">")
    
    
    def two_el(x, a, r, strict, row, ident, rid):
        """The added twoCellAnchor: editAs oneCell, from (0, row) to (2, row +
        2), zero offsets."""
        ap, rp, bind_a, bind_r = forms(a, r, strict)
        return (b"<" + x + b'twoCellAnchor editAs="oneCell"' + bind_a + b">" + marker(x, b"from", 0, row)
                + marker(x, b"to", 2, row + 2) + pic_el(x, ap, bind_r, rp, ident, rid) + b"</" + x
                + b"twoCellAnchor>")
    
    
    def abs_el(x, a, r, strict, ident, rid):
        """The added absoluteAnchor at 914400 by 914400 EMU, 38100 by 38100."""
        ap, rp, bind_a, bind_r = forms(a, r, strict)
        return (b"<" + x + b"absoluteAnchor" + bind_a + b"><" + x + b'pos x="' + POS + b'" y="' + POS
                + b'"/><' + x + b'ext cx="' + EXT4 + b'" cy="' + EXT4 + b'"/>'
                + pic_el(x, ap, bind_r, rp, ident, rid) + b"</" + x + b"absoluteAnchor>")
    
    
    def info(zin):
        """What the input gives: a dict, or an error string."""
        wb = workbook_of(zin)
        if wb is None or wb not in zin.namelist():
            return "error=no-workbook"
        part, strict = pick_w(zin, wb)
        if part is None or part not in zin.namelist():
            return "error=no-worksheet"
        names = zin.namelist()
        folded = {nm.lower() for nm in names}
        win = zin.read(part)
        root_ns = local(ET.fromstring(win).tag)[0]
        w_rels = rels_of(zin, part)
        dr_id = None
        for el in ET.fromstring(win):
            ns, name = local(el.tag)
            if ns in MAIN and name == DR:
                dr_id = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
        kinds = (ATTR[0] + "/drawing", ATTR[1] + "/drawing")
        din = next((t for (i, ty, t) in w_rels if i == dr_id and ty in kinds), None) if dr_id else None
        m1 = free_media(folded)
        m2 = free_media(folded)
        m = 1
        while ("xl/drawings/drawing%d.xml" % m) in folded:
            m += 1
        dentry = din if din else "xl/drawings/drawing%d.xml" % m
        return {"part": part, "strict": strict, "names": names, "win": win, "root_ns": root_ns,
                "w_rels": w_rels, "din": din, "dentry": dentry, "drels": rels_name(dentry),
                "m1": m1, "m2": m2, "wrels": rels_name(part), "dr_id": dr_id}
    
    
    def overrides(data):
        return [el.get("PartName") for el in ET.fromstring(data) if local(el.tag)[1] == "Override"]
    
    
    def removal(zin, got):
        """What the removal rules give for the input (removeimage)."""
        names = got["names"]
        din = got["din"]
        out = {"kept": 0, "dropped_d": 0, "empty": 0, "removed": [], "gone_span": None, "drop_media": [],
               "pics_in": [], "anchors_in": 0}
        if din is None or din not in names:
            return out
        ddata = zin.read(din)
        droot = list(ET.fromstring(ddata))
        da, db = root_span(ddata)[2], root_span(ddata)[3]
        spans = [(da + x, da + y) for (x, y) in top_level(ddata[da:db])]
        pics = pictures(ddata)
        proots = picture_roots(ddata)
        out["pics_in"] = pics
        out["anchors_in"] = len(droot)
        out["empty"] = 1 if not droot else 0
        gone = proots[0] if pics else None
        out["kept"] = 1 if pics else 0
        left = [c for (i, c) in enumerate(droot) if i != gone]
        out["dropped_d"] = 0 if any(holds_anchor(c) for c in left) else 1
        if gone is not None:
            out["gone_span"] = spans[gone]
            named = [v for (n, v) in rel_attrs(droot[gone]) if n in ("embed", "link")]
            refs = {v for (i, c) in enumerate(droot) if i != gone for (_, v) in rel_attrs(c)}
            for v in named:
                if v not in refs and v not in out["removed"]:
                    out["removed"].append(v)
        # The media entries D's rels part targets, and which go (the spec's
        # count rule).
        drel = rels_of(zin, din)
        every = []
        for nm in names:
            if nm.endswith(".rels"):
                d, base = posixpath.split(nm)
                src = posixpath.join(posixpath.dirname(d), base[:-len(".rels")]) if base != ".rels" else ""
                every += [t for (_, _, t) in rels_of(zin, src) if t is not None]
        targets = []
        for (i, ty, t) in drel:
            if t is not None and t.startswith(MEDIA_PREFIX) and t not in targets:
                targets.append(t)
        for t in targets:
            c = sum(1 for e in every if e == t)
            r = sum(1 for (i, ty, tt) in drel if tt == t and i in out["removed"])
            if r > 0 and c == r and t in names:
                out["drop_media"].append(t)
        return out
    
    
    def plant_anchor(flag, wout, extra, st):
        """(wout, extra) changed so that `flag` turns to no, or None when the
        pair gives the plant nothing to change."""
        ts, te, a, b, rp = root_span(wout)
        kids = children(wout, a, b, rp, st["root_ns"])
        drs = [(x, y) for (x, y, n) in kids if n == DR]
        sds = [(x, y) for (x, y, n) in kids if n == "sheetData"]
        e = dict(extra)
        if flag == "root_tag":
            return wout[:te - 1] + b' planted="1"' + wout[te - 1:], e
        if flag == "rest_same":
            others = [(x, y) for (x, y, n) in kids if n != DR]
            if not others:
                return None
            return wout[:others[0][0]] + COMMENT + wout[others[0][0]:], e
        if flag == "drawing_place":
            if not drs:
                return None
            x, y = drs[0]
            raw = wout[x:y]
            m = re.search(rb':id\s*=\s*"[^"]*"', raw)
            if not m:
                return None
            return wout[:x] + raw[:m.start()] + b':id="rId0"' + raw[m.end():] + wout[y:], e
        if flag == "root_order":
            if not drs or not sds:
                return None
            (x1, y1), (x2, y2) = sorted([drs[0], sds[0]])
            return wout[:x1] + wout[x2:y2] + wout[y1:x2] + wout[x1:y1] + wout[y2:], e
        if flag in ("rels_bytes", "types_bytes", "drawing_bytes", "drawing_rels_bytes", "media_bytes"):
            key = flag[:-len("_bytes")]
            if key == "media":
                key = "media1"
            if e.get(key) is None:
                return None
            e[key] = e[key] + COMMENT
            return wout, e
        data = e.get("drawing")
        if flag in ("images_read", "two_form", "absolute_form", "kept_children"):
            if data is None:
                return None
            da, db = root_span(data)[2], root_span(data)[3]
            spans = [(da + x, da + y) for (x, y) in top_level(data[da:db])]
        if flag == "images_read":
            if not spans:
                return None
            x, y = spans[-1]
            e["drawing"] = data[:x] + data[y:]
            return wout, e
        if flag == "two_form":
            if len(spans) < 2:
                return None
            x, y = spans[-2]
            piece = data[x:y]
            if b'editAs="oneCell"' not in piece:
                return None
            e["drawing"] = data[:x] + piece.replace(b'editAs="oneCell"', b'editAs="twoCell"', 1) + data[y:]
            return wout, e
        if flag == "absolute_form":
            if not spans:
                return None
            x, y = spans[-1]
            piece = data[x:y]
            if (b'x="' + POS + b'"') not in piece:
                return None
            e["drawing"] = data[:x] + piece.replace(b'x="' + POS + b'"', b'x="914401"', 1) + data[y:]
            return wout, e
        if flag == "kept_children":
            if st["kept_spans"] == 0 or len(spans) < 1:
                return None
            x, y = spans[0]
            tag_end = x + len(start_tag(data[x:y]))
            e["drawing"] = data[:tag_end] + COMMENT + data[tag_end:]
            return wout, e
        if flag in ("xml_values", "flagged"):
            return wout, e
        raise KeyError(flag)
    
    
    def plant_remove(flag, got_out):
        """The output as read, changed so that `flag` turns to no; every plant
        of this mode has something to change."""
        g = dict(got_out)
        if flag == "sheet_same":
            g["wout"] = g["wout"] + COMMENT
        elif flag == "drawing_children":
            g["dout"] = (g["dout"] + COMMENT) if g["dout"] is not None else b"<planted/>"
        elif flag == "drawing_rels_set":
            g["drels_out"] = (g["drels_out"] or []) + [("rIdPlanted", "planted", "planted", None)]
            g["drels_empty"] = False
        elif flag == "media_dropped":
            g["media_out"] = set(g["media_out"]) | {MEDIA_PREFIX + "planted.png"}
        elif flag == "types_set":
            g["types_out"] = g["types_out"] + [("Override", "/planted", None, "planted")]
        elif flag == "wrels_set":
            g["wrels_out"] = (g["wrels_out"] or []) + [("rIdPlanted", "planted", "planted", None)]
            g["wrels_empty"] = False
        elif flag == "added_empty":
            g["added"] = list(g["added"]) + ["xl/planted.xml"]
        elif flag == "images_read":
            g["pics_out"] = list(g["pics_out"]) + [("planted", None, None, None)]
        elif flag in ("xml_values", "flagged"):
            pass
        else:
            raise KeyError(flag)
        return g
    
    
    def values_and_flags(zin, zout, names, out_names, diff_path, flag_plant, flags):
        """The xml_values and flagged checks (cbcmp.py's, flagged over every
        rewritten entry), and their counts."""
        both = [nm for nm in names if nm in out_names]
        changed = [nm for nm in both if zin.read(nm) != zout.read(nm)]
        rewritten = [nm for nm in both if nm in changed or raw_of(zin, nm) != raw_of(zout, nm)]
        want_values = {}
        for nm in changed:
            if is_xml_name(nm):
                try:
                    vi, vo = values_of(ET.fromstring(zin.read(nm))), values_of(ET.fromstring(zout.read(nm)))
                    want_values[nm] = (sum((vi - vo).values()), sum((vo - vi).values()))
                except ET.ParseError:
                    want_values[nm] = None
        want_in = sum(v[0] for v in want_values.values() if v)
        want_out = sum(v[1] for v in want_values.values() if v)
        in_only = out_only = flagged_rows = want_flagged = -1
        if flag_plant == "xml_values":
            want_out += 1
        if diff_path is not None:
            rows = [l.split("\t") for l in open(diff_path, encoding="utf-8").read().split("\n") if l]
            values = {c[1]: c for c in rows if len(c) >= 7 and c[0] == "xml" and c[2] == "values"}
            in_only = sum(int(c[5]) for c in values.values())
            out_only = sum(int(c[6]) for c in values.values())
            per_ok = all(want_values.get(nm) is not None and (int(c[5]), int(c[6])) == want_values[nm]
                         for (nm, c) in values.items())
            flags["xml_values"] = (set(values) == set(want_values) and per_ok
                                   and in_only == want_in and out_only == want_out)
            ents = [{"name": c[1], "status": c[2], "flags": c[16]} for c in rows
                    if len(c) == 17 and c[0] == "entry"]
            flagged_rows = sum(1 for r in ents if r["flags"])
            wanted = {nm: ("descriptor" if descriptor_differs(zin, zout, nm) else "") for nm in rewritten}
            if flag_plant == "flagged":
                wanted = {nm: ("" if f else "descriptor") for (nm, f) in wanted.items()}
            want_flagged = sum(1 for f in wanted.values() if f)
            statuses = {r["name"]: r["status"] for r in ents}
            rewritten_rows = {nm for (nm, st) in statuses.items() if st in ("changed", "recompressed")}
            recompressed_ok = all(statuses.get(nm) == ("changed" if nm in changed else "recompressed")
                                  for nm in rewritten)
            flags["flagged"] = (len(ents) > 0 and flagged_rows == want_flagged and rewritten_rows == set(rewritten)
                                and recompressed_ok
                                and all(r["flags"] == wanted.get(r["name"], "") for r in ents))
        return (len(want_values), in_only, want_in, out_only, want_out, flagged_rows, want_flagged,
                len(rewritten) - len(changed))
    
    
    def main_anchor(zin, got, args):
        part, strict, names, win = got["part"], got["strict"], got["names"], got["win"]
        wrels, dentry, drels, m1, m2 = got["wrels"], got["dentry"], got["drels"], got["m1"], got["m2"]
        if args == ["--parts"]:
            for line in (part, wrels, dentry, drels, m1, m2, 1 if wrels in names else 0,
                         1 if got["din"] else 0, 1 if (got["din"] and drels in names) else 0):
                print(line)
            return
        zout = zipfile.ZipFile(args[0])
        diff_path, flag_plant, err = options(args[1:], FLAGS_OF["anchor"])
        if err:
            print(err)
            return
        wout = zout.read(part)
        out_names = zout.namelist()
        root_ns = got["root_ns"]
        extra = {
            "rels": zout.read(wrels) if wrels in out_names else None,
            "types": zout.read("[Content_Types].xml"),
            "drawing": zout.read(dentry) if dentry in out_names else None,
            "drawing_rels": zout.read(drels) if drels in out_names else None,
            "media1": zout.read(m1) if m1 in out_names else None,
            "media2": zout.read(m2) if m2 in out_names else None,
        }
    
        # What the rules give, from the input.
        row = m_of(win)
        made = got["din"] is None
        form = ATTR[1 if strict else 0].encode()
        over_add = (b'<Override PartName="/' + m1.encode() + b'" ContentType="image/png"/>'
                    + b'<Override PartName="/' + m2.encode() + b'" ContentType="image/png"/>')
        rels_add = b""
        rid_d = None
        if made:
            rid_d = b"rId%d" % next_id(got["w_rels"])
            rels_add = (b'<Relationship Id="' + rid_d + b'" Type="' + form + b'/drawing" Target="'
                        + relative(part, dentry).encode() + b'"/>')
            over_add += b'<Override PartName="/' + dentry.encode() + b'" ContentType="' + DRAWING_TYPE + b'"/>'
        its, ite, ia, ib, rootp = root_span(win)
        tag_in = win[its:ite]
        bound = rels_prefix_of(tag_in)
        if made and bound is None:
            k = 0
            while True:
                cand = b"r" if k == 0 else b"r%d" % k
                if attr_value(tag_in, b"xmlns:" + cand) is None:
                    break
                k += 1
            rp_attr = cand
            want_tag = with_attr(tag_in, b"xmlns:" + cand, form)
        else:
            rp_attr = bound
            want_tag = tag_in
        kin = children(win, ia, ib, rootp, root_ns)
        dr_el = None
        if made:
            dr_el = b"<" + rootp + b"drawing " + rp_attr + b':id="' + rid_d + b'"/>'
        t1, t2 = relative(dentry, m1).encode(), relative(dentry, m2).encode()
        kept_spans = []
        ddata = b""
        if made:
            ident, r1, r2 = 1, b"rId1", b"rId2"
            want_d = (DECL + b'<xdr:wsDr xmlns:xdr="' + XDR[0].encode() + b'" xmlns:a="' + A[0].encode() + b'">'
                      + two_el(b"xdr:", b"a", None, False, row, 1, r1) + abs_el(b"xdr:", b"a", None, False, 2, r2)
                      + b"</xdr:wsDr>")
            rel_els = (b'<Relationship Id="rId1" Type="' + form + b'/image" Target="' + t1 + b'"/>'
                       + b'<Relationship Id="rId2" Type="' + form + b'/image" Target="' + t2 + b'"/>')
            want_dr = (package_prefix(zin) + b'<Relationships xmlns="' + RELS.encode() + b'">' + rel_els
                       + b"</Relationships>")
            images_in, anchors_in = 0, 0
            two_in = abs_in = 0
        else:
            ddata = zin.read(got["din"])
            dtag = start_tag(ddata[root_span(ddata)[0]:])
            droot_ns = local(ET.fromstring(ddata).tag)[0]
            dstrict = droot_ns == XDR[1]
            x = split_name(qname(dtag))[0]
            a_p, r_p = bound_prefix(dtag, A), bound_prefix(dtag, ATTR)
            if r_p == b"":
                r_p = None
            ident = largest_id(ddata) + 1
            n1 = next_id(rels_of(zin, got["din"]))
            r1, r2 = b"rId%d" % n1, b"rId%d" % (n1 + 1)
            end = ddata.rfind(b"</")
            want_d = (ddata[:end] + two_el(x, a_p, r_p, dstrict, row, ident, r1)
                      + abs_el(x, a_p, r_p, dstrict, ident + 1, r2) + ddata[end:])
            rel_els = (b'<Relationship Id="' + r1 + b'" Type="' + form + b'/image" Target="' + t1 + b'"/>'
                       + b'<Relationship Id="' + r2 + b'" Type="' + form + b'/image" Target="' + t2 + b'"/>')
            if drels in names:
                want_dr = before_end(zin.read(drels), rel_els)
            else:
                want_dr = (package_prefix(zin) + b'<Relationships xmlns="' + RELS.encode() + b'">' + rel_els
                           + b"</Relationships>")
            pics = pictures(ddata)
            images_in = len(pics)
            two_in = sum(1 for p in pics if p[0] == "twoCellAnchor")
            abs_in = sum(1 for p in pics if p[0] == "absoluteAnchor")
            anchors_in = len(list(ET.fromstring(ddata)))
            da, db = root_span(ddata)[2], root_span(ddata)[3]
            kept_spans = [(da + x0, da + y0) for (x0, y0) in top_level(ddata[da:db])]
        st = {"root_ns": root_ns, "kept_spans": len(kept_spans)}
    
        planted = False
        if flag_plant is not None:
            changed_ = plant_anchor(flag_plant, wout, extra, st)
            if changed_ is not None:
                wout, extra = changed_
                planted = True
    
        flags = dict.fromkeys(FLAGS_OF["anchor"], False)
        ots, ote, oa, ob, orp = root_span(wout)
        kout = children(wout, oa, ob, orp, root_ns)
        dr_out = [(x0, y0) for (x0, y0, nm) in kout if nm == DR]
        flags["root_tag"] = wout[ots:ote] == want_tag and wout[:ots] == win[:its]
        cut_in = cut(win, [(its, ite)])
        cut_out = cut(wout, [(ots, ote)] + (dr_out if made else []))
        flags["rest_same"] = cut_in == cut_out
        if made:
            later = [x0 for (x0, _, nm) in kout if nm in TABLE and TABLE.index(nm) > TABLE.index(DR)]
            end_at = later[0] if later else ob
            flags["drawing_place"] = (len(dr_out) == 1 and wout[dr_out[0][0]:dr_out[0][1]] == dr_el
                                      and dr_out[0][1] == end_at)
        else:
            dr_in = [(x0, y0) for (x0, y0, nm) in kin if nm == DR]
            flags["drawing_place"] = (len(dr_out) == 1 and len(dr_in) == 1
                                      and wout[dr_out[0][0]:dr_out[0][1]] == win[dr_in[0][0]:dr_in[0][1]])
        order_in = [nm for (_, _, nm) in kin if nm is not None]
        order_out = [nm for (_, _, nm) in kout if nm is not None]
        if made:
            later = [i for (i, nm) in enumerate(order_in) if nm in TABLE and TABLE.index(nm) > TABLE.index(DR)]
            at_name = later[0] if later else len(order_in)
            want_order = order_in[:at_name] + [DR] + order_in[at_name:]
        else:
            want_order = order_in
        flags["root_order"] = order_out == want_order
        if not rels_add:
            want_rels = zin.read(wrels) if wrels in names else None
        elif wrels in names:
            want_rels = before_end(zin.read(wrels), rels_add)
        else:
            want_rels = package_prefix(zin) + b'<Relationships xmlns="' + RELS.encode() + b'">' + rels_add + b"</Relationships>"
        flags["rels_bytes"] = extra["rels"] == want_rels
        types_in = zin.read("[Content_Types].xml")
        flags["types_bytes"] = extra["types"] == before_end(types_in, over_add)
        flags["drawing_bytes"] = extra["drawing"] == want_d
        flags["drawing_rels_bytes"] = extra["drawing_rels"] == want_dr
        flags["media_bytes"] = extra["media1"] == PNG and extra["media2"] == PNG
        images_out = anchors_out = two_out = abs_out = -1
        try:
            if extra["drawing"] is not None:
                droot = list(ET.fromstring(extra["drawing"]))
                got_pics = pictures(extra["drawing"])
                images_out, anchors_out = len(got_pics), len(droot)
                two_out = sum(1 for p in got_pics if p[0] == "twoCellAnchor")
                abs_out = sum(1 for p in got_pics if p[0] == "absoluteAnchor")
                resolved = {}
                if extra["drawing_rels"] is not None:
                    for el in ET.fromstring(extra["drawing_rels"]).iter("{%s}Relationship" % RELS):
                        if el.get("TargetMode") != "External":
                            t = el.get("Target", "")
                            resolved[el.get("Id")] = t[1:] if t.startswith("/") else posixpath.normpath(
                                posixpath.join(posixpath.dirname(dentry), t))
                last_two = got_pics[-2:]
                flags["images_read"] = (images_out == images_in + 2 and len(last_two) == 2
                                        and last_two[0][:3] == ("twoCellAnchor", "0", str(row))
                                        and last_two[1][0] == "absoluteAnchor"
                                        and resolved.get(last_two[0][3]) == m1
                                        and resolved.get(last_two[1][3]) == m2)
                if len(droot) >= 2:
                    two, ab = droot[-2], droot[-1]
    
                    def mark(el, name):
                        got_m = [c for c in el if local(c.tag) in ((xx, name) for xx in XDR)]
                        if len(got_m) != 1:
                            return None
                        return [(local(c.tag)[1], c.text) for c in got_m[0]]
    
                    ids = lambda el: [e.get("id") for e in el.iter() if local(e.tag)[1] == "cNvPr"]
                    flags["two_form"] = (local(two.tag)[0] in XDR and local(two.tag)[1] == "twoCellAnchor"
                                         and two.get("editAs") == "oneCell"
                                         and mark(two, "from") == [("col", "0"), ("colOff", "0"), ("row", str(row)), ("rowOff", "0")]
                                         and mark(two, "to") == [("col", "2"), ("colOff", "0"), ("row", str(row + 2)), ("rowOff", "0")]
                                         and not [c for c in two if local(c.tag)[1] == "ext"]
                                         and ids(two) == [str(ident)])
                    pos = [c for c in ab if local(c.tag)[1] == "pos"]
                    ext = [c for c in ab if local(c.tag)[1] == "ext"]
                    flags["absolute_form"] = (local(ab.tag)[0] in XDR and local(ab.tag)[1] == "absoluteAnchor"
                                              and len(pos) == 1 and pos[0].get("x") == POS.decode()
                                              and pos[0].get("y") == POS.decode()
                                              and len(ext) == 1 and ext[0].get("cx") == EXT4.decode()
                                              and ext[0].get("cy") == EXT4.decode()
                                              and ids(ab) == [str(ident + 1)])
                dout = extra["drawing"]
                oa_, ob_ = root_span(dout)[2], root_span(dout)[3]
                spans_out = [(oa_ + x0, oa_ + y0) for (x0, y0) in top_level(dout[oa_:ob_])]
                flags["kept_children"] = (len(spans_out) == len(kept_spans) + 2
                                          and all(dout[xo:yo] == ddata[xi:yi]
                                                  for ((xi, yi), (xo, yo)) in zip(kept_spans, spans_out)))
        except ET.ParseError:
            pass
        out_names_ = zout.namelist()
        vals = values_and_flags(zin, zout, names, out_names_, diff_path, flag_plant, flags)
        if flag_plant in ("xml_values", "flagged"):
            planted = True
        media = lambda ns: sum(1 for nm in ns if nm.startswith(MEDIA_PREFIX))
    
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted),
             "images_in=%d" % images_in, "images_out=%d" % images_out,
             "two_in=%d" % two_in, "two_out=%d" % two_out, "absolute_in=%d" % abs_in, "absolute_out=%d" % abs_out,
             "drawing_in=%d" % (0 if made else 1),
             "anchors_in=%d" % anchors_in, "anchors_out=%d" % anchors_out,
             "media_in=%d" % media(names), "media_out=%d" % media(out_names),
             "r_bound_in=%d" % (0 if bound is None else 1),
             "i=%d" % ident, "created=%d" % (1 if made else 0),
             "strict=%d" % (1 if strict else 0), "rels_part_in=%d" % (1 if wrels in names else 0)]
            + counts_of(vals)
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS_OF["anchor"]]))
    
    
    def counts_of(vals):
        changed_xml, in_only, want_in, out_only, want_out, flagged_rows, want_flagged, recompressed = vals
        return ["changed_xml=%d" % changed_xml, "in_only=%d" % in_only, "in_only_want=%d" % want_in,
                "out_only=%d" % out_only, "out_only_want=%d" % want_out,
                "flagged_rows=%d" % flagged_rows, "flagged_want=%d" % want_flagged,
                "recompressed=%d" % recompressed]
    
    
    def main_remove(zin, got, args):
        part, names, win = got["part"], got["names"], got["win"]
        wrels = got["wrels"]
        din = got["din"]
        drels = rels_name(din) if din else None
        rem = removal(zin, got)
        over = set(overrides(zin.read("[Content_Types].xml")))
        dropped_parts = list(rem["drop_media"]) + ([din] if (din and rem["dropped_d"]) else [])
        ov = 1 if any("/" + p in over for p in dropped_parts) else 0
        if args == ["--parts"]:
            lines = [part, wrels, din or "-", drels or "-", 1 if wrels in names else 0, 1 if din else 0,
                     1 if (drels and drels in names) else 0, rem["empty"] if din else 0, rem["kept"],
                     rem["dropped_d"] if din else 0, ov, len(rem["drop_media"])] + list(rem["drop_media"])
            for line in lines:
                print(line)
            return
        zout = zipfile.ZipFile(args[0])
        diff_path, flag_plant, err = options(args[1:], FLAGS_OF["removeimage"])
        if err:
            print(err)
            return
        out_names = zout.namelist()
        dropped_d = bool(din) and rem["dropped_d"] == 1
        # The output as read.
        got_out = {
            "wout": zout.read(part),
            "dout": zout.read(din) if (din and din in out_names) else None,
            "drels_out": rel_tuples(zout, drels) if drels else None,
            "drels_empty": bool(drels) and drels in out_names and root_childless(zout.read(drels)),
            "wrels_out": rel_tuples(zout, wrels),
            "wrels_empty": wrels in out_names and root_childless(zout.read(wrels)),
            "media_out": {nm for nm in out_names if nm.startswith(MEDIA_PREFIX)},
            "types_out": type_tuples(zout.read("[Content_Types].xml")),
            "added": [nm for nm in out_names if nm not in names],
            "pics_out": pictures(zout.read(din)) if (din and din in out_names) else [],
        }
        planted = False
        if flag_plant is not None:
            got_out = plant_remove(flag_plant, got_out)
            planted = True
        flags = dict.fromkeys(FLAGS_OF["removeimage"], False)
        # sheet_same: W is the input's, less its drawing element where D goes.
        if dropped_d:
            its, ite, ia, ib, rootp = root_span(win)
            drs = [(x0, y0) for (x0, y0, nm) in children(win, ia, ib, rootp, got["root_ns"]) if nm == DR]
            want_w = cut(win, drs)
        else:
            want_w = win
        flags["sheet_same"] = got_out["wout"] == want_w
        # drawing_children.
        if din and not dropped_d:
            ddata = zin.read(din)
            want_d = cut(ddata, [rem["gone_span"]]) if rem["gone_span"] else ddata
            flags["drawing_children"] = got_out["dout"] == want_d
        else:
            flags["drawing_children"] = got_out["dout"] is None
        # drawing_rels_set.
        if din and not dropped_d:
            rin = rel_tuples(zin, drels)
            if rin is None:
                flags["drawing_rels_set"] = got_out["drels_out"] is None or (
                    got_out["drels_out"] == [] and got_out["drels_empty"])
            else:
                flags["drawing_rels_set"] = got_out["drels_out"] == [t for t in rin if t[0] not in rem["removed"]]
        else:
            flags["drawing_rels_set"] = got_out["drels_out"] is None
        # media_dropped: the entries gone are exactly the ones the count rule
        # drops, none added.
        media_in = {nm for nm in names if nm.startswith(MEDIA_PREFIX)}
        flags["media_dropped"] = got_out["media_out"] == media_in - set(rem["drop_media"])
        # types_set.
        tin = type_tuples(zin.read("[Content_Types].xml"))
        gone_over = {"/" + p for p in dropped_parts}
        flags["types_set"] = got_out["types_out"] == [t for t in tin if not (t[0] == "Override" and t[1] in gone_over)]
        # wrels_set.
        win_rels = rel_tuples(zin, wrels)
        if win_rels is None:
            flags["wrels_set"] = got_out["wrels_out"] is None or (got_out["wrels_out"] == [] and got_out["wrels_empty"])
        else:
            want_wr = [t for t in win_rels if not (dropped_d and t[0] == got["dr_id"])]
            flags["wrels_set"] = got_out["wrels_out"] == want_wr
        # added_empty (ruling 2).
        allowed = set()
        if wrels not in names:
            allowed.add(wrels)
        if din and not dropped_d and drels not in names:
            allowed.add(drels)
        added = got_out["added"]
        empties = {wrels: got_out["wrels_empty"]}
        if drels:
            empties[drels] = got_out["drels_empty"]
        flags["added_empty"] = len(added) <= 1 and all(nm in allowed and empties.get(nm) for nm in added)
        # images_read.
        want_pics = rem["pics_in"][1:] if rem["kept"] else rem["pics_in"]
        if dropped_d or not din:
            want_pics = []
        flags["images_read"] = got_out["pics_out"] == want_pics
        vals = values_and_flags(zin, zout, names, out_names, diff_path, flag_plant, flags)
        drawing_out = 0
        for el in ET.fromstring(zout.read(part)):
            ns, name = local(el.tag)
            if ns in MAIN and name == DR:
                drawing_out = 1
        anchors_out = len(list(ET.fromstring(zout.read(din)))) if (din and din in out_names) else 0
        media_out_real = {nm for nm in out_names if nm.startswith(MEDIA_PREFIX)}
        print(" ".join(
            ["found=1", "planted=%s" % yn(planted),
             "images_in=%d" % len(rem["pics_in"]), "images_out=%d" % len(pictures(zout.read(din)) if (din and din in out_names) else []),
             "kept=%d" % rem["kept"], "drawing_in=%d" % (1 if din else 0), "drawing_out=%d" % drawing_out,
             "empty=%d" % (rem["empty"] if din else 0), "dropped_d=%d" % (1 if dropped_d else 0),
             "anchors_in=%d" % rem["anchors_in"], "anchors_out=%d" % anchors_out,
             "media_in=%d" % len(media_in), "media_out=%d" % len(media_out_real),
             "dropped=%d" % len(media_in - media_out_real), "dropped_want=%d" % len(rem["drop_media"]),
             "removed_rels=%d" % len(rem["removed"]), "added=%d" % len([nm for nm in out_names if nm not in names]),
             "rels_part_in=%d" % (1 if wrels in names else 0),
             "drels_in=%d" % (1 if (drels and drels in names) else 0)]
            + counts_of(vals)
            + ["%s=%s" % (f, yn(flags[f])) for f in FLAGS_OF["removeimage"]]))
    
    
    def options(rest, flags):
        diff_path = flag_plant = None
        while rest:
            if rest[0] == "--diff" and len(rest) >= 2:
                diff_path, rest = rest[1], rest[2:]
            elif rest[0] == "--plant" and len(rest) >= 2:
                flag_plant, rest = rest[1], rest[2:]
                if flag_plant not in flags:
                    return None, None, "error=unknown-plant"
            else:
                return None, None, "error=usage"
        return diff_path, flag_plant, None
    
    
    def main():
        args = sys.argv[1:]
        if len(args) < 3 or args[0] not in FLAGS_OF:
            print("error=usage")
            return
        zin = zipfile.ZipFile(args[1])
        got = info(zin)
        if isinstance(got, str):
            print(got)
            return
        if args[0] == "anchor":
            main_anchor(zin, got, args[2:])
        else:
            main_remove(zin, got, args[2:])
    
    
    main()
