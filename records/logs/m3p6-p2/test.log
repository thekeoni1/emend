    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    PHASE_DIR=$(dirname "$SELF_DIR")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$PHASE_DIR/out" || exit 2
    ERR=$PHASE_DIR/out/test.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    C=${1:?phase commit required}
    T=$(mktemp -d)
    trap 'rm -rf "${T:?}"' EXIT INT TERM HUP
    git show "$C:scripts/counting.sh" >"$T/counting.sh" || exit 2
    . "$T/counting.sh"
    
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    KEEP_WAS_SET=$([ -n "${EMEND_KEEP_DIR+x}" ] && echo yes || echo no)
    unset EMEND_KEEP_DIR
    BUILD_ROOT=$PHASE_DIR/test
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/target
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    passed_matches() { [ "$passed" -gt 0 ] && [ "$passed" -eq "$nok" ]; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    
    # The entry guard: every change must be this phase's log directory or its
    # records, run or open-check, or planning's uncommitted spec (change AG;
    # change SB).
    OURS_RE='^((\?\?| ?[MARCD]) records/logs/m3p6-p2|(\?\?| ?[MARCD]) records/m3p6-(p2|open)-| M specs/0028-images-and-comments-second-half[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS_RE" git status --porcelain)
    entry_clean() {
      [ "$entry_all" != error ] && [ "$entry_ours" != error ] &&
        [ "$entry_all" = "$entry_ours" ]
    }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs, its records and planning's uncommitted spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -E -e "s#$MAIN([^-A-Za-z0-9_.]|\$)#<repo>\\1#g" -e "s#$T#<scratch>/w#g" -e "s#$BUILD_ROOT#<build>#g" \
        -e "s#$SELF_DIR#<scripts>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M3 part 6 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # Change AH: every environment input this script reads, on a labelled line.
    echo "input (environment) RERUN_NOTE: $([ -n "${RERUN_NOTE:-}" ] && echo "set; its text is the rerun line below" || echo unset)"
    echo "input (environment) RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input (environment) EMEND_KEEP_DIR, when this script started: $KEEP_WAS_SET (unset for the whole log)"
    echo "input (environment) HOME: $([ -n "${HOME:-}" ] && echo "set; the scrub writes it <home>" || echo unset)"
    echo "input (environment) ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    SHAPE_DIR=$(mktemp -d)
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$SHAPE_DIR/fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$SHAPE_DIR/fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      SHAPE_RESULT_SELF=$n_self
      SHAPE_RESULT_FIX=$n_fix
      check "$shape: this script holds none" "$(yn [ "$SHAPE_RESULT_SELF" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$SHAPE_RESULT_FIX" = 1 ])"
    done
    rm -rf "${SHAPE_DIR:?}"
    
    echo
    echo "## the spec, pinned by the hash of its committed blob (change NB; specs/0018 close-out ruling 4)"
    SPEC=specs/0028-images-and-comments-second-half.md
    # The hash planning's message gave for the doc commit's blob, typed (change NB).
    SPEC_GAVE=5c3d3d1aa4d5bad2dac42cf7c0836a1d80d93a2dfc7e76cf94a48aacd444e6b0
    SPEC_SHA=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_HEAD=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum; sha256sum $SPEC (the working tree's copy, printed only)"
    echo "  the phase commit's blob: sha256 $SPEC_HEAD"
    echo "  the hash planning's message gave: $SPEC_GAVE"
    echo "  the working tree's copy, planning's uncommitted rulings during P2 (change MB), not the pin: sha256 $SPEC_SHA"
    check "the spec at the phase commit is the blob planning's message hashed" "$(yn [ "$SPEC_HEAD" = "$SPEC_GAVE" ])"
    spec_ctl() { if [ "$(git show "$C:specs/0027-read-back.md" | sha256sum | cut -d' ' -f1)" = "$SPEC_GAVE" ]; then return 1; else return 0; fi; }
    check "control: the same comparison refuses another spec's blob (specs/0027 at the phase commit)" "$(yn spec_ctl)"
    
    echo
    echo "## the phase's commits by role, read from git"
    check_fn() { local label=$1; shift; check "$label" "$(yn "$@")"; }
    by_subject() { git log --format='%H' -n 1 -F --grep="$1" "$C"; }
    REC=$(by_subject 'M3 part 6 P1 record: logs, the run and open-check records, the independent check')
    DOC1=$(by_subject "M3 part 6 P2: commit planning docs (the P1 verification and rulings, ROADMAP)")
    CODE1=$(by_subject "M3 part 6 P2: image anchors and image removal")
    CODE2=$(by_subject 'M3 part 6 P2: emend-copy --anchor-sample and --remove-image-sample')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject> <phase commit>, for each role"
    echo "  P1's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  code commit 1 (the crate): ${CODE1:-none}"
    echo "  code commit 2 (the tool, the phase commit): ${CODE2:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~3"
    for k in 0 1 2 3; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r
      for r in "$REC" "$DOC1" "$CODE1" "$CODE2"; do
        [ -n "$r" ] || return 1
      done
      [ "$CODE2" = "$C" ] || return 1
      [ "$(git rev-parse "$C~1")" = "$CODE1" ] || return 1
      [ "$(git rev-parse "$C~2")" = "$DOC1" ] || return 1
      [ "$(git rev-parse "$C~3")" = "$REC" ]
    }
    check_fn "code commits 2 and 1, the doc commit and P1's record commit, each the next one's parent" roles_in_order
    roles_ctl1() { local CODE1=$CODE2; if roles_in_order; then return 1; else return 0; fi; }
    check_fn "control: roles_in_order refuses code commit 2 named as code commit 1" roles_ctl1
    git log --format='%s' "$REC..$C" >"$T/subjects"
    PREFIX_RE='^M3 part 6 P2: '
    nsub=$(count_lines "$T/subjects")
    nprefix=$(count_matches -E "$PREFIX_RE" "$T/subjects")
    echo "command: git log --format=%s <P1's record commit>..<phase commit>"
    sed 's/^/    /' "$T/subjects"
    echo "  subjects in the range: $nsub; beginning \"M3 part 6 P2: \": $nprefix"
    prefix_all() { [ "$nsub" -ge 1 ] && [ "$nsub" = "$nprefix" ]; }
    check_fn "every commit in the range carries the phase's subject prefix" prefix_all
    printf 'M3 part 6 P2: x\nM3 part 6 P3: y\nM3 part 6: z\n' >"$T/c-subjects"
    check "control: the same count finds one prefixed subject of three" "$(yn [ "$(count_matches -E "$PREFIX_RE" "$T/c-subjects")" = 1 ])"
    no_such_subject() { [ -z "$(by_subject 'M3 part 6 P2: no such subject anywhere')" ]; }
    check_fn "control: a subject no commit has resolves to nothing" no_such_subject
    echo "phase: Milestone 3 part 6 P2 (specs/0028-images-and-comments-second-half.md) test.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "  the superseded files are kept in <home>/${PHASE_DIR#"$HOME"/}/superseded (change NA)"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run used its own target directory, <build>/target (CARGO_TARGET_DIR)"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to (it lies inside <home>, so it is scrubbed first)"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/${PHASE_DIR#"$HOME"/}, this phase's directory on the disk (change NA); <phase>/superseded keeps a superseded attempt's files; <phase>/out holds this script's own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <scripts> stands for <phase>/$(basename "$SELF_DIR"), the directory holding this script"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory; scripts/counting.sh is read at the phase commit into <scratch>/w/counting.sh and sourced from there (change X), the plants' archive copy of the phase commit is <scratch>/w/src, and the keep directory of change RD is a mktemp -d directory inside <scratch>/w, written <scratch>/w/keep"
    echo "root: <build> stands for <phase>/$(basename "$BUILD_ROOT"), this log's build directory (change NA); the runs build into <build>/target, the crate's own runs (changes SD, RD, SG and BG) into <build>/crate-target and the plants into <build>/plant-target"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      apart "$T" "$PHASE_DIR" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$T" "$BUILD_ROOT" &&
        apart "$MAIN" "$PHASE_DIR" && apart "$MAIN" "$T"
    }
    check "the directory roots other than <home> and <phase>'s own children are distinct, none inside another" "$(yn roots_distinct)"
    roots_ctl() { if apart "$CARGO_TARGET_DIR" "$BUILD_ROOT"; then return 1; else return 0; fi; }
    check "control: apart refuses <build>/target against <build>, which holds it" "$(yn roots_ctl)"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR; CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS; $(rustc --version)"
    echo "EMEND_KEEP_DIR set when this script started: $KEEP_WAS_SET; unset for the whole log: $([ -n "${EMEND_KEEP_DIR+x}" ] && echo no || echo yes)"
    echo "EMEND_KEEP_DIR is given to one command alone, the crate's keep run (change RD), through env; it is never exported"
    echo "at entry: status lines $entry_all; of them this phase's logs, its records or planning's uncommitted spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    check "control: the same comparison against a short sha of the real commit says no" \
      "$(yn not_head "$(printf '%s' "$C" | cut -c1-7)")"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$T/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    # failed_names <cargo output>: prints the name of every test the run failed,
    # from its FAILED lines, or "none" (change RC; P2 verification ruling 6). It
    # prints, so it is never a check's condition.
    failed_names() {
      local n
      n=$(LC_ALL=C "$G" -a -E '^test .* \.\.\. FAILED$' "$1" | sed -E 's/^test (.*) \.\.\. FAILED$/\1/')
      if [ -n "$n" ]; then printf '%s\n' "$n" | sed 's/^/    failed test: /'; else echo "    failed tests: none"; fi
    }
    printf 'test a::b ... ok\ntest a::c ... FAILED\n' >"$T/c-failed"
    check "control: failed_names prints the name of the one FAILED line of two" "$(yn [ "$(failed_names "$T/c-failed")" = "    failed test: a::c" ])"
    printf 'test a::b ... ok\n' >"$T/c-failed-none"
    check "control: failed_names prints none for a run with no FAILED line" "$(yn [ "$(failed_names "$T/c-failed-none")" = "    failed tests: none" ])"
    
    for target in host i686-unknown-linux-musl; do
      echo
      echo "## cargo test --workspace ($target)"
      if [ "$target" = host ]; then
        echo "command: cargo test --workspace"
        cargo test --workspace >"$T/$target.out" 2>&1 </dev/null
      else
        echo "command: cargo test --workspace --target $target"
        cargo test --workspace --target "$target" >"$T/$target.out" 2>&1 </dev/null
      fi
      rc=$?
      echo "exit: $rc"
      check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
      failed_names "$T/$target.out"
      echo "Running lines, test lines and summary lines:"
      LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test .* \.\.\. |^test result: ' "$T/$target.out" | sed 's/^ */    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/$target.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/$target.names"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      ignored=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^ignored;$/) n += $i } END { print n + 0 }' "$T/$target.out")
      nok=$(count_lines "$T/$target.names")
      echo "$target: passed $passed; failed $failed; ignored $ignored; test lines ending ok: $nok"
      check "$target: failed is 0" "$(yn [ "$failed" -eq 0 ])"
      check "$target: passed is more than 0 and equals the ok test lines" "$(yn passed_matches)"
      n=$(count_bytes "$CTRL_CLASS" "$T/$target.out")
      check "$target: control bytes in the cargo output: $n (expect 0)" "$(yn [ "$n" = 0 ])"
      echo "$passed" >"$T/$target.count"
    done
    
    echo
    echo "## the features on in the workspace run, read from the run (changes FC, IC, KC, PC, QC, SC, WC, YC, ZC and VC)"
    # The images module's tests compile only with `images`, the comments
    # module's only with `comments`, the tables
    # module's only with `tables`, the validation, dxf, conditional and visual
    # modules' only with `rules`, and the names, links, properties and protection
    # modules' only with `metadata`; emend-copy turns all four on for the
    # workspace (features unify), so both runs hold them.
    feature_of() { case $1 in readback | sheetread) echo read ;; linestyle) echo rowcol ;; grouping) echo rowcol ;; sheetprops) echo sheetprops ;; richtext) echo richtext ;; images) echo images ;; comments) echo comments ;; tables) echo tables ;; validation | dxf | conditional | visual) echo rules ;; *) echo metadata ;; esac; }
    for target in host i686-unknown-linux-musl; do
      for module in names links properties protection validation dxf conditional visual tables comments images richtext sheetprops grouping linestyle readback sheetread; do
        nmod=$(count_matches -E "^package::tests::$module::" "$T/$target.names")
        echo "  $target: $module module tests passed $nmod"
        check "$target: the run holds the $module module's tests, so the feature $(feature_of "$module") was on" "$(yn [ "$nmod" -ge 1 ])"
      done
    done
    printf 'package::tests::rowcol::a\npackage::tests::validation::b\n' >"$T/c-feat"
    check "control: the same count finds one validation test in a list of two" "$(yn [ "$(count_matches -E '^package::tests::validation::' "$T/c-feat")" = 1 ])"
    
    
    echo
    echo "## the tests per binary"
    per_binary() {
      awk '
        /^ *Running / {
          path = $NF
          gsub(/[()]/, "", path)
          parts = split(path, piece, "/")
          label = piece[parts]
          sub(/-[0-9a-f]+$/, "", label)
          current = (($2 == "unittests") ? "unittests " : "integration ") label
          next
        }
        /^ *Doc-tests / { current = "doc-tests " $2; next }
        /^test result: / {
          if (current == "") next
          for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n = $i
          printf "%s %d\n", current, n
          current = ""
        }
      ' "$1" | sort
    }
    for target in host i686-unknown-linux-musl; do
      per_binary "$T/$target.out" >"$T/$target.per"
    done
    sed 's/^/    /' "$T/host.per"
    sum_per=$(awk '{ n += $NF } END { print n + 0 }' "$T/host.per")
    echo "  the per-binary counts sum to $sum_per; the run's own passed total was $(cat "$T/host.count")"
    check "the per-binary counts sum to the run's passed total" \
      "$(yn [ "$sum_per" = "$(cat "$T/host.count")" ])"
    check "the two targets produce the same per-binary breakdown" \
      "$(yn cmp -s "$T/host.per" "$T/i686-unknown-linux-musl.per")"
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n' >"$T/c-per"
    per_binary "$T/c-per" >"$T/c-per.out"
    nctl_per=$(count_lines "$T/c-per.out")
    echo "  control: a result line with no Running line above it yields $nctl_per rows"
    check "control: the per-binary form attributes nothing to a binary it never saw named" \
      "$(yn [ "$nctl_per" = 0 ])"
    printf '     Running unittests src/lib.rs (target/debug/deps/libctl-0123456789abcdef)\ntest result: ok. 7 passed; 0 failed; 0 ignored\n' >"$T/c-per-hit"
    per_binary "$T/c-per-hit" >"$T/c-per-hit.out"
    sed 's/^/    control row: /' "$T/c-per-hit.out"
    check "control: a Running line and its result yield one row naming the crate and its count" \
      "$(yn [ "$(cat "$T/c-per-hit.out")" = "unittests libctl 7" ])"
    PREV_LOG=records/logs/m3p6-p1/test.log
    PREV_TOTAL=$(sed -n 's/^host executed \([0-9]*\) tests;.*/\1/p' "$PREV_LOG")
    NOW_TOTAL=$(cat "$T/host.count")
    echo "  the workspace total: this phase $NOW_TOTAL, the previous phase $PREV_TOTAL (read from $PREV_LOG)"
    check "the previous phase's total was read from its committed log" "$(yn [ -n "$PREV_TOTAL" ])"
    awk '
      /^## cargo test --workspace \(host\)$/ { inblock = 1; next }
      /^## / { inblock = 0 }
      inblock && /^    test .* \.\.\. ok$/ { sub(/^    test /, ""); sub(/ \.\.\. ok$/, ""); print }
    ' "$PREV_LOG" | sort >"$T/prev.names"
    nprev_names=$(count_lines "$T/prev.names")
    echo "  test names the previous log's host run printed: $nprev_names"
    check "the previous log's names account for its whole host total" "$(yn [ "$nprev_names" = "$PREV_TOTAL" ])"
    comm -13 "$T/prev.names" "$T/host.names" >"$T/added.names"
    comm -23 "$T/prev.names" "$T/host.names" >"$T/removed.names"
    nadded=$(count_lines "$T/added.names")
    nremoved=$(count_lines "$T/removed.names")
    echo "  test names added since the previous phase: $nadded; removed: $nremoved"
    sed 's/^/    added: /' "$T/added.names"
    sed 's/^/    removed: /' "$T/removed.names"
    total_moved_by_names() {
      [ -n "$PREV_TOTAL" ] && [ "$NOW_TOTAL" -eq "$((PREV_TOTAL + nadded - nremoved))" ]
    }
    check "this phase's workspace total is the previous phase's plus the names added less the names removed" \
      "$(yn total_moved_by_names)"
    comm -3 "$T/prev.names" "$T/prev.names" >"$T/c-names"
    check "control: the same comparison of a list with itself finds no difference" \
      "$(yn [ "$(count_lines "$T/c-names")" = 0 ])"
    { cat "$T/prev.names"; echo "zzz::control::name"; } | sort >"$T/c-names-plus"
    check "control: a list with one name more is found to add exactly one" \
      "$(yn [ "$(comm -13 "$T/prev.names" "$T/c-names-plus" | wc -l)" = 1 ])"
    
    echo
    echo "## the tests this phase adds and removes, and the tests the features gate off, derived from the source (P2's change AI and part 4a P4's AR, kept; changes BE, IE, KE, PE, QE, SE, TE, UE, WE, YE, ZE, VE, NE and ME)"
    BASE_DOC=$(git log --format='%H' -n 1 --grep='^M3 part 6 P2: commit planning docs [(]the P1 verification and rulings, ROADMAP[)]' "$C")
    BASE=$(git rev-parse --verify "$BASE_DOC^" 2>/dev/null)
    echo "command: git log --format=%H -n 1 --grep=<the first doc commit's subject> <phase commit>, and its parent"
    echo "  the first doc commit: $BASE_DOC; the phase base: $BASE"
    check "the phase base resolved from git" "$(yn [ -n "$BASE" ])"
    check "the phase base is P1's record commit" "$(yn [ "$BASE" = "$REC" ])"
    tests_attr() { git show "$1:$2" 2>/dev/null | tests_in; }
    tests_in() {
      awk '
        /^[ \t]*#\[test\][ \t]*$/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]/ {
          sub(/^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next
        }
        t { t = 0 }' | sort
    }
    # gated_off_in [feature]: the tests whose attributes, before the fn line,
    # hold the feature's negation (metadata when none is named) and #[test].
    gated_off_in() {
      awk -v neg="#[cfg(not(feature = \"${1:-metadata}\"))]" '
        index($0, neg) { g = 1; next }
        /^[ \t]*#\[test\][ \t]*$/ { if (g) t = 1; next }
        /^[ \t]*#\[/ { next }
        /^[ \t]*(pub[ \t]+)?fn[ \t]/ {
          if (t) { sub(/^[ \t]*(pub[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print }
          g = 0; t = 0; next
        }
        { g = 0; t = 0 }' | sort
    }
    added_between() {
      # $1 older commit, $2 newer commit: "<file> <name>" per #[test] the newer
      # commit has in a .rs file the pair's diff touches and the older lacks.
      local f
      git diff --name-only "$1" "$2" -- '*.rs' | while IFS= read -r f; do
        tests_attr "$2" "$f" >"$T/ab-new"
        tests_attr "$1" "$f" >"$T/ab-old"
        comm -13 "$T/ab-old" "$T/ab-new" | sed "s#^#$f #"
      done
    }
    removed_between() { added_between "$2" "$1"; }
    git diff --name-only "$BASE" "$C" -- '*.rs' >"$T/changed-rs"
    echo "  the .rs files the phase changed: $(count_lines "$T/changed-rs")"
    sed 's/^/    /' "$T/changed-rs"
    added_between "$BASE" "$C" >"$T/src-added"
    removed_between "$BASE" "$C" >"$T/src-removed"
    # Change AR, kept: the gated-off tests are read from every .rs file under
    # crates and tools at each commit; change BE: for the feature rules as well.
    gated_at() {
      local f
      git ls-tree -r --name-only "$1" -- crates tools | LC_ALL=C "$G" -E '[.]rs$' | while IFS= read -r f; do
        git show "$1:$f" 2>/dev/null | gated_off_in "${2:-metadata}" | sed "s#^#$f #"
      done
    }
    gated_at "$C" >"$T/src-gated"
    gated_at "$BASE" >"$T/src-gated-base"
    gated_at "$C" rules >"$T/src-gated-rules"
    gated_at "$C" tables >"$T/src-gated-tables"
    gated_at "$C" comments >"$T/src-gated-comments"
    gated_at "$C" images >"$T/src-gated-images"
    gated_at "$C" richtext >"$T/src-gated-richtext"
    gated_at "$C" sheetprops >"$T/src-gated-sheetprops"
    gated_at "$C" rowcol >"$T/src-gated-rowcol"
    gated_at "$C" read >"$T/src-gated-read"
    gated_at "$BASE" read >"$T/src-gated-read-base"
    echo "  #[test] functions the phase commit gates off under the feature rules, in every .rs file under crates and tools:"
    sed 's/^/    /' "$T/src-gated-rules"
    check "the phase gates off no test under the feature rules ($(count_lines "$T/src-gated-rules"))" "$(yn [ "$(count_lines "$T/src-gated-rules")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature tables, read the same way:"
    sed 's/^/    /' "$T/src-gated-tables"
    check "the phase gates off no test under the feature tables ($(count_lines "$T/src-gated-tables"))" "$(yn [ "$(count_lines "$T/src-gated-tables")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature comments, read the same way:"
    sed 's/^/    /' "$T/src-gated-comments"
    check "the phase gates off no test under the feature comments ($(count_lines "$T/src-gated-comments"))" "$(yn [ "$(count_lines "$T/src-gated-comments")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature images, read the same way:"
    sed 's/^/    /' "$T/src-gated-images"
    check "the phase gates off no test under the feature images ($(count_lines "$T/src-gated-images"))" "$(yn [ "$(count_lines "$T/src-gated-images")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature richtext, read the same way:"
    sed 's/^/    /' "$T/src-gated-richtext"
    check "the phase gates off no test under the feature richtext ($(count_lines "$T/src-gated-richtext"))" "$(yn [ "$(count_lines "$T/src-gated-richtext")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature sheetprops, read the same way:"
    sed 's/^/    /' "$T/src-gated-sheetprops"
    check "the phase gates off no test under the feature sheetprops ($(count_lines "$T/src-gated-sheetprops"); change SE)" "$(yn [ "$(count_lines "$T/src-gated-sheetprops")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature rowcol, read the same way:"
    sed 's/^/    /' "$T/src-gated-rowcol"
    check "the phase gates off no test under the feature rowcol ($(count_lines "$T/src-gated-rowcol"); changes WE and YE)" "$(yn [ "$(count_lines "$T/src-gated-rowcol")" = 0 ])"
    echo "  #[test] functions the phase commit gates off under the feature read, read the same way:"
    sed 's/^/    /' "$T/src-gated-read"
    echo "  #[test] functions the base gates off under the feature read, read the same way: $(count_lines "$T/src-gated-read-base")"
    COUNTS_GATED='crates/emend/src/styles/tests.rs the_counts_are_the_children_not_the_count_attribute'
    check "the phase gates off under the feature read exactly the core count test (M3 part 5 P1's ZE)" "$(yn [ "$(cat "$T/src-gated-read")" = "$COUNTS_GATED" ])"
    check "the base gated off the same one test under the feature read, so the phase gates off nothing new under it (change ME)" "$(yn [ "$(cat "$T/src-gated-read-base")" = "$COUNTS_GATED" ])"
    echo "  #[test] functions at the phase commit and not at the base, by file:"
    sed 's/^/    /' "$T/src-added"
    echo "  #[test] functions at the base and not at the phase commit, by file:"
    sed 's/^/    /' "$T/src-removed"
    echo "  #[test] functions the phase commit gates off under the feature metadata, in every .rs file under crates and tools, by file:"
    sed 's/^/    /' "$T/src-gated"
    echo "  #[test] functions the base gates off under the feature metadata, read the same way:"
    sed 's/^/    /' "$T/src-gated-base"
    LC_ALL=C comm -13 <(LC_ALL=C sort "$T/src-gated-base") <(LC_ALL=C sort "$T/src-gated") >"$T/src-newly-gated"
    LC_ALL=C comm -13 <(LC_ALL=C sort "$T/src-gated-read-base") <(LC_ALL=C sort "$T/src-gated-read") >"$T/src-newly-gated-read"
    nsrc_added=$(count_lines "$T/src-added")
    nsrc_removed=$(count_lines "$T/src-removed")
    nsrc_gated=$(count_lines "$T/src-gated")
    check "the source adds tests in this phase ($nsrc_added)" "$(yn [ "$nsrc_added" -ge 1 ])"
    check "the source removes no test in this phase ($nsrc_removed)" "$(yn [ "$nsrc_removed" = 0 ])"
    check "the source gates at least one test off under the feature ($nsrc_gated)" "$(yn [ "$nsrc_gated" -ge 1 ])"
    check "the phase gates off no test the base did not ($(count_lines "$T/src-newly-gated"))" "$(yn [ "$(count_lines "$T/src-newly-gated")" = 0 ])"
    awk '{ print $2 }' "$T/src-added" | sort >"$T/src-added.names"
    { awk '{ print $2 }' "$T/src-removed"; awk '{ print $2 }' "$T/src-newly-gated"; awk '{ print $2 }' "$T/src-newly-gated-read"; } | sort >"$T/src-lost.names"
    sed 's/^.*:://' "$T/added.names" | sort >"$T/run-added.names"
    sed 's/^.*:://' "$T/removed.names" | sort >"$T/run-removed.names"
    check "the names the workspace run added are exactly the tests the source added" \
      "$(yn cmp -s "$T/run-added.names" "$T/src-added.names")"
    check "the names the workspace run lost are exactly the tests the source removed or newly gates off under metadata or read (change ME)" \
      "$(yn cmp -s "$T/run-removed.names" "$T/src-lost.names")"
    printf '#[cfg(not(feature = "metadata"))]\n#[test]\nfn ctl_gated() {}\n#[test]\nfn ctl_plain() {}\n#[cfg(feature = "metadata")]\n#[test]\nfn ctl_on() {}\n#[cfg(not(feature = "rules"))]\n#[test]\nfn ctl_rules() {}\n' >"$T/c-gated"
    gated_off_in <"$T/c-gated" >"$T/c-gated.names"
    check "control: gated_off_in reads the one test gated off under metadata and neither the plain, the gated-on nor the rules one" "$(yn [ "$(cat "$T/c-gated.names")" = ctl_gated ])"
    gated_off_in rules <"$T/c-gated" >"$T/c-gated-rules.names"
    check "control: gated_off_in rules reads the one test gated off under rules" "$(yn [ "$(cat "$T/c-gated-rules.names")" = ctl_rules ])"
    # Change ME: the tests the source adds, derived from the diff. Two test files
    # are new, package/tests/images/anchors.rs and package/tests/images/
    # removal.rs, every test of each added; the tool's added tests are in
    # null_rewrite.rs, each named for the anchor or the image removal sample; no
    # other file gains a test.
    ANCHORS_RS=crates/emend/src/package/tests/images/anchors.rs
    REMOVAL_RS=crates/emend/src/package/tests/images/removal.rs
    TOOL_RS=tools/emend-copy/tests/null_rewrite.rs
    git diff --name-only --diff-filter=A "$BASE" "$C" -- '*.rs' | LC_ALL=C "$G" -E '(/tests[.]rs|/tests/)' >"$T/new-test-files" || :
    sed 's/^/    new test file: /' "$T/new-test-files"
    printf '%s\n' "$ANCHORS_RS" "$REMOVAL_RS" >"$T/new-test-files-want"
    check "the phase adds exactly two test files, the anchors and removal modules (change ME)" "$(yn cmp -s "$T/new-test-files" "$T/new-test-files-want")"
    added_in_file() { awk -v f="$1" '$1 == f { print $2 }' "$T/src-added" | sort; }
    : >"$T/img-extra"
    NIMG=0
    for f in "$ANCHORS_RS" "$REMOVAL_RS"; do
      added_in_file "$f" >"$T/added-img"
      tests_attr "$C" "$f" >"$T/all-img"
      n=$(count_lines "$T/all-img")
      NIMG=$((NIMG + n))
      echo "  tests in $f at the phase commit: $n; added: $(count_lines "$T/added-img")"
      sed 's/^/    added: /' "$T/added-img"
      img_all_added() { [ "$n" -ge 1 ] && cmp -s "$T/all-img" "$T/added-img"; }
      check "every test of $f is added (change ME)" "$(yn img_all_added)"
      # The tests whose attribute lines carry a cfg besides the module's.
      git show "$C:$f" | awk '
        /^#\[cfg\(/ { c = 1; next }
        /^#\[test\]/ { if (c) { getline t; sub(/^fn /, "", t); sub(/[(<].*/, "", t); print t }; c = 0; next }
        { c = 0 }' >>"$T/img-extra"
    done
    NIMG_EXTRA=$(count_lines "$T/img-extra")
    echo "  anchors and removal tests: $NIMG; carrying a cfg besides the module's: $NIMG_EXTRA"
    sed 's/^/    gated besides: /' "$T/img-extra"
    check "no anchors or removal test carries a cfg besides the module's (change MD)" "$(yn [ "$NIMG_EXTRA" = 0 ])"
    NIMG_ALONE=$((NIMG - NIMG_EXTRA))
    added_in_file "$TOOL_RS" >"$T/added-tool"
    ntool=$(count_lines "$T/added-tool")
    ntool_named=$(count_matches -E '^the_(anchor|remove_image)_sample_' "$T/added-tool")
    echo "  tests added to $TOOL_RS: $ntool; of them named for the anchor or the image removal sample: $ntool_named"
    sed 's/^/    added to null_rewrite.rs: /' "$T/added-tool"
    tool_named() { [ "$ntool" -ge 1 ] && [ "$ntool" = "$ntool_named" ]; }
    check "the tool's added tests are each named for the anchor or the image removal sample, and some" "$(yn tool_named)"
    # elsewhere <list>: the "<file> <test>" lines of <list> in none of the files.
    elsewhere() { awk -v a="$ANCHORS_RS" -v r="$REMOVAL_RS" -v d="$TOOL_RS" '$1 != a && $1 != r && $1 != d' "$1"; }
    elsewhere "$T/src-added" >"$T/added-elsewhere"
    check "no other file gains a test ($(count_lines "$T/added-elsewhere"))" "$(yn [ "$(count_lines "$T/added-elsewhere")" = 0 ])"
    printf '%s t1\nx.rs t3\n' "$ANCHORS_RS" >"$T/c-src-added"
    check "control: the same filter finds one test outside the three files in a list of two" "$(yn [ "$(elsewhere "$T/c-src-added" | count_lines /dev/stdin)" = 1 ])"
    sed '1d' "$T/all-img" >"$T/c-all-img"
    img_short_ctl() { if cmp -s "$T/c-all-img" "$T/added-img"; then return 1; else return 0; fi; }
    check "control: the added comparison refuses the list one test short" "$(yn img_short_ctl)"
    printf '#[cfg(feature = "rowcol")]\n#[test]\nfn ctl_extra() {}\n#[test]\nfn ctl_plain() {}\n' | awk '
        /^#\[cfg\(/ { c = 1; next }
        /^#\[test\]/ { if (c) { getline t; sub(/^fn /, "", t); sub(/[(<].*/, "", t); print t }; c = 0; next }
        { c = 0 }' >"$T/c-img-extra"
    check "control: the same reader finds the one test carrying a cfg besides in a fixture of two" "$(yn [ "$(cat "$T/c-img-extra")" = ctl_extra ])"
    check "control: the same search finds no test of a name the source lacks" "$(yn [ "$(count_matches -Fx 'x.rs zzz_no_such_test' "$T/src-added")" = 0 ])"
    passed_on() { count_matches -E "(^|::)$1\$" "$T/$2.names"; }
    both_passed() {
      [ "$(passed_on "$1" host)" = 1 ] && [ "$(passed_on "$1" i686-unknown-linux-musl)" = 1 ]
    }
    # Change CK: a name two files share (the call-time test is in validation.rs
    # and conditional.rs) is looked for by its module path: a file under
    # crates/emend/src gives package::tests::<module>::<name>, an integration
    # test file its bare name.
    qualified() {
      case $1 in
        crates/emend/src/*.rs) printf '%s::%s' "$(printf '%s' "${1#crates/emend/src/}" | sed 's/[.]rs$//; s#/#::#g')" "$2" ;;
        *) printf '%s' "$2" ;;
      esac
    }
    echo "  each added test, by its module path, and whether it ran and passed on each target:"
    while read -r f name; do
      q=$(qualified "$f" "$name")
      echo "    $q ($f): host $(passed_on "$q" host), i686-unknown-linux-musl $(passed_on "$q" i686-unknown-linux-musl)"
      check "  $q passed on both targets" "$(yn both_passed "$q")"
    done <"$T/src-added"
    not_passed_ctl() { if both_passed zzz_no_such_test_anywhere; then return 1; else return 0; fi; }
    check "control: both_passed refuses a name no run holds" "$(yn not_passed_ctl)"
    qualified_ok() { [ "$(qualified crates/emend/src/package/tests/tables.rs t)" = package::tests::tables::t ] && [ "$(qualified tools/emend-copy/tests/null_rewrite.rs t)" = t ]; }
    check "control: qualified gives a crate test its module path and an integration test its bare name" "$(yn qualified_ok)"
    printf 'package::tests::validation::t\npackage::tests::conditional::t\n' >"$T/c-dup.names"
    dup_ctl() { [ "$(count_matches -E '(^|::)t$' "$T/c-dup.names")" = 2 ] && [ "$(count_matches -E '(^|::)package::tests::conditional::t$' "$T/c-dup.names")" = 1 ]; }
    check "control: a name two modules share counts twice bare and once by its module path" "$(yn dup_ctl)"
    n_ctl_tests=$(tests_attr "$C" crates/emend/src/archive/tests.rs | count_lines /dev/stdin)
    check "control: the same form finds the #[test] functions of archive/tests.rs at the phase commit ($n_ctl_tests)" "$(yn [ "$n_ctl_tests" -ge 1 ])"
    
    echo
    echo "## the crate's own tests with the features off, images alone, rowcol alone and images with rowcol, both targets (changes BD, ID, KD, PD, SD, UD, WD, YD, ZD, VD, ND and MD)"
    CRATE_TARGET=$BUILD_ROOT/crate-target
    IMG_MOD='^package::tests::images::(anchors|removal)::'
    # The core count test the feature read gates off, by its module path.
    COUNTS_TEST=$(qualified ${COUNTS_GATED% *} ${COUNTS_GATED#* })
    crate_ok() { [ "$1" = 0 ] && [ "$2" = 0 ] && [ "$3" -gt 0 ]; }
    fset_args() { case $1 in off) ;; *) echo "--features $1" ;; esac; }
    for target in host i686-unknown-linux-musl; do
      for feat in off images rowcol images,rowcol; do
        args=(test -p emend)
        [ "$target" = host ] || args+=(--target "$target")
        # shellcheck disable=SC2207
        args+=($(fset_args "$feat"))
        echo "command: CARGO_TARGET_DIR=<build>/crate-target cargo ${args[*]}"
        CARGO_TARGET_DIR=$CRATE_TARGET cargo "${args[@]}" >"$T/crate-$target-$feat.out" 2>&1 </dev/null
        rc=$?
        LC_ALL=C "$G" -E '^test result: ' "$T/crate-$target-$feat.out" | sed 's/^/    /'
        failed_names "$T/crate-$target-$feat.out"
        LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/crate-$target-$feat.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/crate-$target-$feat.names"
        cfail=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$T/crate-$target-$feat.out")
        cn=$(count_lines "$T/crate-$target-$feat.names")
        ncounts=$(count_matches -Fx "$COUNTS_TEST" "$T/crate-$target-$feat.names")
        nimg=$(count_matches -E "$IMG_MOD" "$T/crate-$target-$feat.names")
        printf '%s\n' "$nimg" >"$T/crate-$target-$feat.img"
        echo "  $target, features $feat: exit $rc; failed $cfail; ok test lines $cn; in the anchors and removal modules $nimg; the core count test $ncounts"
        printf '%s\n' "$ncounts" >"$T/crate-$target-$feat.counts"
        check "$target, features $feat: the crate's tests exit 0, none failed, some ran" "$(yn crate_ok "$rc" "$cfail" "$cn")"
        # Part 1's test gated off under metadata runs in all four sets, each
        # leaving metadata off (change ZD).
        while read -r f name; do
          ngated=$(count_matches -E "(^|::)$name\$" "$T/crate-$target-$feat.names")
          echo "    the test gated off under metadata, $name, ran and passed $ngated time(s)"
          check "$target, features $feat, metadata off: $name runs and passes" "$(yn [ "$ngated" = 1 ])"
        done <"$T/src-gated"
      done
      echo "  $target: the anchors and removal modules' tests passed: off $(cat "$T/crate-$target-off.img"), images $(cat "$T/crate-$target-images.img"), rowcol $(cat "$T/crate-$target-rowcol.img"), images and rowcol $(cat "$T/crate-$target-images,rowcol.img") (the files hold $NIMG, of them $NIMG_EXTRA gated besides)"
      check "$target, off: no anchors or removal test ran" "$(yn [ "$(cat "$T/crate-$target-off.img")" = 0 ])"
      check "$target, rowcol: no anchors or removal test ran" "$(yn [ "$(cat "$T/crate-$target-rowcol.img")" = 0 ])"
      check "$target, images: every anchors and removal test ran and passed (change MD)" "$(yn [ "$(cat "$T/crate-$target-images.img")" = "$NIMG_ALONE" ])"
      check "$target, images and rowcol: every anchors and removal test ran and passed (change MD)" "$(yn [ "$(cat "$T/crate-$target-images,rowcol.img")" = "$NIMG" ])"
      echo "  $target: the core count test ($COUNTS_TEST) passed: off $(cat "$T/crate-$target-off.counts"), images $(cat "$T/crate-$target-images.counts"), rowcol $(cat "$T/crate-$target-rowcol.counts"), images and rowcol $(cat "$T/crate-$target-images,rowcol.counts")"
      counts_where() { [ "$(cat "$T/crate-$target-off.counts")" = 1 ] && [ "$(cat "$T/crate-$target-rowcol.counts")" = 1 ] && [ "$(cat "$T/crate-$target-images.counts")" = 1 ] && [ "$(cat "$T/crate-$target-images,rowcol.counts")" = 1 ]; }
      check "$target: the core count test runs and passes in all four sets, none turning read on (change MD)" "$(yn counts_where)"
      # lost_only <from> <to> <allowed>: <to> passes every name <from> passed but
      # those listed in the file <allowed>, which it does not pass, and more.
      # Prints nothing.
      lost_only() {
        LC_ALL=C comm -23 "$T/crate-$target-$1.names" "$T/crate-$target-$2.names" >"$T/lost"
        LC_ALL=C comm -13 "$T/crate-$target-$1.names" "$T/crate-$target-$2.names" >"$T/gained"
        cmp -s "$T/lost" "$3" && [ "$(count_lines "$T/gained")" -ge 1 ]
      }
      : >"$T/none-lost"
      printf '%s\n' "$COUNTS_TEST" >"$T/counts-lost"
      check "$target: the rowcol run passes every name of the off run, and more" "$(yn lost_only off rowcol "$T/none-lost")"
      check "$target: the images run passes every name of the off run, and more (change MD)" "$(yn lost_only off images "$T/none-lost")"
      check "$target: the run with images and rowcol passes every name of the images run, and more" "$(yn lost_only images images,rowcol "$T/none-lost")"
      check "$target: the run with images and rowcol passes every name of the rowcol run, and more" "$(yn lost_only rowcol images,rowcol "$T/none-lost")"
      LC_ALL=C comm -13 "$T/crate-$target-off.names" "$T/crate-$target-images.names" | count_matches -E "$IMG_MOD" /dev/stdin >"$T/gained-img-$target"
      echo "  $target: anchors and removal tests among the names the images run adds to the off run: $(cat "$T/gained-img-$target")"
      check "$target: the names the images run adds to the off run hold every anchors and removal test it runs" "$(yn [ "$(cat "$T/gained-img-$target")" = "$NIMG_ALONE" ])"
      lost_ctl() { if lost_only off images "$T/counts-lost"; then return 1; else return 0; fi; }
      check "$target: control: lost_only refuses the images run against the off run with the core count test named lost" "$(yn lost_ctl)"
    done
    check "control: the modules' pattern finds an anchors and a removal test's qualified names and not another images test" "$(yn [ "$(printf 'package::tests::images::anchors::t\npackage::tests::images::removal::t\npackage::tests::images::t\n' | count_matches -E "$IMG_MOD" /dev/stdin)" = 2 ])"
    check "the core count test's module path was read from the source" "$(yn [ "$COUNTS_TEST" = styles::tests::the_counts_are_the_children_not_the_count_attribute ])"
    for feat in off images rowcol images,rowcol; do
      check "the host and i686 crate runs pass the same names with the features $feat" "$(yn cmp -s "$T/crate-host-$feat.names" "$T/crate-i686-unknown-linux-musl-$feat.names")"
    done
    check "control: the same comparison finds the off and images runs differ" "$(yn [ "$(comm -3 "$T/crate-host-off.names" "$T/crate-host-images.names" | count_lines /dev/stdin)" -ge 1 ])"
    
    echo
    echo "## the crate's tests with every feature on, once without and once with EMEND_KEEP_DIR set, host, and once on i686 (change RD; P2 verification ruling 6; changes ZD, VD, ND and MD)"
    KEEPD=$(mktemp -d "$T/keep.XXXXXX") || fail=1
    for kv in without with; do
      if [ "$kv" = with ]; then
        echo "command: env EMEND_KEEP_DIR=<scratch>/w/keep CARGO_TARGET_DIR=<build>/crate-target cargo test -p emend --all-features (host)"
        env EMEND_KEEP_DIR="$KEEPD" CARGO_TARGET_DIR="$CRATE_TARGET" cargo test -p emend --all-features >"$T/keep-$kv.out" 2>&1 </dev/null
      else
        echo "command: CARGO_TARGET_DIR=<build>/crate-target cargo test -p emend --all-features (host)"
        CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --all-features >"$T/keep-$kv.out" 2>&1 </dev/null
      fi
      echo "$?" >"$T/keep-$kv.rc"
      echo "  exit: $(cat "$T/keep-$kv.rc")"
      LC_ALL=C "$G" -E '^test result: ' "$T/keep-$kv.out" | sed 's/^/    /'
      failed_names "$T/keep-$kv.out"
      LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/keep-$kv.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/keep-$kv.names"
    done
    nkeep_files=$(find "$KEEPD" -type f | count_lines /dev/stdin)
    echo "  tests passed without the variable: $(count_lines "$T/keep-without.names"); with it: $(count_lines "$T/keep-with.names"); files the keep holds after the run with it: $nkeep_files"
    keep_same() {
      [ "$(cat "$T/keep-without.rc")" = 0 ] && [ "$(cat "$T/keep-with.rc")" = 0 ] &&
        [ "$(count_lines "$T/keep-with.names")" -ge 1 ] && cmp -s "$T/keep-without.names" "$T/keep-with.names"
    }
    check "with EMEND_KEEP_DIR set the crate's tests exit 0 and pass the same names as without it (change RD)" "$(yn keep_same)"
    check "the run with the variable wrote files into the keep, so the variable was read" "$(yn [ "$nkeep_files" -ge 1 ])"
    check "the variable is still unset in this script's own environment" "$(yn [ -z "${EMEND_KEEP_DIR+x}" ])"
    sed '1d' "$T/keep-with.names" >"$T/c-keep-short"
    keep_ctl() { if cmp -s "$T/keep-without.names" "$T/c-keep-short"; then return 1; else return 0; fi; }
    check "control: the same comparison refuses the names one short" "$(yn keep_ctl)"
    echo "command: CARGO_TARGET_DIR=<build>/crate-target cargo test -p emend --all-features --target i686-unknown-linux-musl"
    CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --all-features --target i686-unknown-linux-musl >"$T/all-i686.out" 2>&1 </dev/null
    echo "$?" >"$T/all-i686.rc"
    echo "  exit: $(cat "$T/all-i686.rc")"
    LC_ALL=C "$G" -E '^test result: ' "$T/all-i686.out" | sed 's/^/    /'
    failed_names "$T/all-i686.out"
    LC_ALL=C "$G" -E '^test .* \.\.\. ok$' "$T/all-i686.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | sort >"$T/all-i686.names"
    echo "  tests passed with every feature on, i686: $(count_lines "$T/all-i686.names")"
    all_i686_same() { [ "$(cat "$T/all-i686.rc")" = 0 ] && [ "$(count_lines "$T/all-i686.names")" -ge 1 ] && cmp -s "$T/keep-without.names" "$T/all-i686.names"; }
    check "with every feature on, i686 exits 0 and passes the host's names (change ZD)" "$(yn all_i686_same)"
    all_counts_off() { [ "$(count_matches -Fx "$COUNTS_TEST" "$T/all-i686.names")" = 0 ] && [ "$(count_matches -Fx "$COUNTS_TEST" "$T/keep-without.names")" = 0 ]; }
    check "with every feature on, the host and i686 do not run the core count test, read being on" "$(yn all_counts_off)"
    echo "  anchors and removal tests passed with every feature on: host $(count_matches -E "$IMG_MOD" "$T/keep-without.names"), i686 $(count_matches -E "$IMG_MOD" "$T/all-i686.names") (the files hold $NIMG)"
    all_img() { [ "$(count_matches -E "$IMG_MOD" "$T/keep-without.names")" = "$NIMG" ] && [ "$(count_matches -E "$IMG_MOD" "$T/all-i686.names")" = "$NIMG" ]; }
    check "with every feature on, the host and i686 run every anchors and removal test (change MD)" "$(yn all_img)"
    
    echo
    echo "## the anchors and removal modules in the workspace run beside the crate's run with images (changes RF and SF, kept; changes WF, YF, ZF, VF, NF and MF)"
    # extra_attrs <qualified name>: the attribute lines above the test's fn line,
    # in the file its module path names, at the phase commit, joined by " | ".
    extra_attrs() {
      local q=$1 short file
      short=${q##*::}
      file=crates/emend/src/$(printf '%s' "${q%::*}" | sed 's#::#/#g').rs
      git show "$C:$file" 2>/dev/null | awk -v f="fn $short(" '
        /^[ \t]*#\[/ { a[n++] = $0; next }
        index($0, f) == 1 { for (i = 0; i < n; i++) { s = a[i]; sub(/^[ \t]*/, "", s); printf "%s%s", (i ? " | " : ""), s }; print ""; exit }
        { n = 0 }'
    }
    # outside_feature <attribute lines>: one of them is a cfg naming a feature
    # other than images. Prints nothing.
    outside_feature() {
      printf '%s\n' "$1" | LC_ALL=C "$G" -o -E 'feature = "[a-z]+"' | sed -E 's/feature = "([a-z]+)"/\1/' |
        LC_ALL=C "$G" -qvxE 'images'
    }
    for target in host i686-unknown-linux-musl; do
      LC_ALL=C "$G" -E "$IMG_MOD" "$T/$target.names" | sort >"$T/ws-gr-$target" || :
      LC_ALL=C "$G" -E "$IMG_MOD" "$T/crate-$target-images.names" | sort >"$T/on-gr-$target" || :
      comm -23 "$T/ws-gr-$target" "$T/on-gr-$target" >"$T/gr-extra-$target"
      comm -13 "$T/ws-gr-$target" "$T/on-gr-$target" >"$T/gr-missing-$target"
      echo "  $target: the anchors and removal modules' tests in the workspace run $(count_lines "$T/ws-gr-$target"); in the crate's run with images $(count_lines "$T/on-gr-$target"); in the first and not the second $(count_lines "$T/gr-extra-$target"); in the second and not the first $(count_lines "$T/gr-missing-$target")"
      while IFS= read -r q; do
        echo "    in the workspace run alone: $q; its attribute lines: $(extra_attrs "$q")"
        check "  $q carries a cfg naming a feature the images run leaves off" "$(yn outside_feature "$(extra_attrs "$q")")"
      done <"$T/gr-extra-$target"
      check "$target: every anchors and removal test of the crate's run is in the workspace run" "$(yn [ "$(count_lines "$T/gr-missing-$target")" = 0 ])"
    done
    check "control: outside_feature finds the sheetprops cfg" "$(yn outside_feature '#[cfg(feature = "sheetprops")] | #[test]')"
    own_only_ctl() { if outside_feature '#[cfg(feature = "images")] | #[test]'; then return 1; else return 0; fi; }
    check "control: outside_feature refuses a cfg naming images alone" "$(yn own_only_ctl)"
    check "control: extra_attrs reads the attribute lines of a test of the gated core module" "$(yn [ -n "$(extra_attrs styles::tests::the_counts_are_the_children_not_the_count_attribute)" ])"
    check "control: outside_feature finds the rich comment box test's cfg naming a feature the images run leaves off (change MF)" "$(yn outside_feature "$(extra_attrs package::tests::comments::boxes::a_box_applies_to_a_rich_comment_addition)")"
    
    echo
    echo "## two anchors and removal tests, each run alone with images alone (change MG)"
    # alone_run <label> <features> <test>: the test run alone on the host, the
    # command, its exit and its test lines printed and the exit kept (change QJ).
    alone_run() {
      local label=$1 feats=$2 name=$3
      echo "command: CARGO_TARGET_DIR=<build>/crate-target cargo test -p emend --features $feats --lib $name -- --exact (host)"
      CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --features "$feats" --lib "$name" -- --exact >"$T/alone-$label.out" 2>&1 </dev/null
      echo "$?" >"$T/alone-$label.rc"
      echo "exit: $(cat "$T/alone-$label.rc")"
      LC_ALL=C "$G" -E '^test .* \.\.\. |^test result: ' "$T/alone-$label.out" | sed 's/^/    /'
      failed_names "$T/alone-$label.out"
    }
    # alone_ok <label> <test>: that run exited 0, its test ran ok and exactly one
    # test passed. Prints nothing (change QJ).
    alone_ok() {
      local label=$1 name=$2
      [ "$(cat "$T/alone-$label.rc")" = 0 ] && LC_ALL=C "$G" -qxF "test $name ... ok" "$T/alone-$label.out" &&
        [ "$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/alone-$label.out")" = 1 ]
    }
    TWO_TEST=package::tests::images::anchors::a_two_cell_anchor_writes_edit_as_from_and_to_for_each_value
    MIDDLE_TEST=package::tests::images::removal::a_removal_of_the_middle_of_three_leaves_the_rest_byte_identical
    alone_run twocell images "$TWO_TEST"
    check "the two-cell anchor test ran alone with images alone on and passed: editAs for each value, from and to with offsets in EMU (change MG)" "$(yn alone_ok twocell "$TWO_TEST")"
    alone_run middle images "$MIDDLE_TEST"
    check "the middle-removal test ran alone with images alone on and passed: the rest byte-identical, the relationship, media and Override gone" "$(yn alone_ok middle "$MIDDLE_TEST")"
    for t in "$TWO_TEST" "$MIDDLE_TEST"; do
      check "control: $t is absent from the crate's run with the features off" "$(yn [ "$(count_matches -Fx "$t" "$T/crate-host-off.names")" = 0 ])"
    done
    
    echo
    echo "## the workspace's emend unit-test binary beside the crate's own runs (change AB, kept; changes BG, ZJ and VJ)"
    # The workspace builds emend with dates, rowcol, metadata, rules, tables,
    # comments, images, richtext, sheetprops and read, since emend-copy enables
    # all ten (changes PF, SJ and ZJ). Both crate runs are made here and read per
    # binary.
    for feats in rowcol,metadata,rules,tables,comments,images,richtext,sheetprops,read dates,rowcol,metadata,rules,tables,comments,images,richtext,sheetprops,read; do
      echo "command: CARGO_TARGET_DIR=<build>/crate-target cargo test -p emend --features $feats (host)"
      CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --features "$feats" >"$T/crate-$feats.out" 2>&1 </dev/null
      printf '%s' "$?" >"$T/crate-$feats.rc"
      echo "  exit: $(cat "$T/crate-$feats.rc")"
      per_binary "$T/crate-$feats.out" >"$T/crate-$feats.per"
      sed 's/^/    /' "$T/crate-$feats.per"
    done
    unit_row() { awk '$1 == "unittests" && $2 == "emend" { print $3 }' "$1"; }
    UW=$(unit_row "$T/host.per")
    URM=$(unit_row "$T/crate-rowcol,metadata,rules,tables,comments,images,richtext,sheetprops,read.per")
    UDRM=$(unit_row "$T/crate-dates,rowcol,metadata,rules,tables,comments,images,richtext,sheetprops,read.per")
    NDATES=$(count_matches -E '^dates::' "$T/host.names")
    echo "  the emend unit-test binary: the workspace run $UW; the crate with rowcol, metadata, rules, tables, comments, images, richtext, sheetprops and read $URM; the crate with dates, rowcol, metadata, rules, tables, comments, images, richtext, sheetprops and read $UDRM"
    echo "  test names under dates:: in the workspace's host run: $NDATES; the workspace's binary less the rowcol, metadata, rules, tables, comments, images, richtext, sheetprops and read run's: $(( ${UW:-0} - ${URM:-0} ))"
    crate_runs_ok() { [ "$(cat "$T/crate-rowcol,metadata,rules,tables,comments,images,richtext,sheetprops,read.rc")" = 0 ] && [ "$(cat "$T/crate-dates,rowcol,metadata,rules,tables,comments,images,richtext,sheetprops,read.rc")" = 0 ] && [ -n "$UW" ] && [ -n "$URM" ] && [ -n "$UDRM" ]; }
    check "both crate runs exit 0 and every emend unit-test row was read" "$(yn crate_runs_ok)"
    check "the crate with dates, rowcol, metadata, rules, tables, comments, images, richtext, sheetprops and read runs the workspace's emend binary, test for test by count" "$(yn [ "$UDRM" = "$UW" ])"
    dates_is_difference() { [ "$NDATES" -ge 1 ] && [ "$((UW - URM))" = "$NDATES" ]; }
    check "the workspace's binary less the rowcol, metadata, rules, tables, comments, images, richtext, sheetprops and read run's is exactly the dates module's tests" "$(yn dates_is_difference)"
    printf 'unittests emend 5\nunittests emend_copy 0\nintegration p1 3\n' >"$T/c-unit"
    check "control: unit_row reads the emend row and no other" "$(yn [ "$(unit_row "$T/c-unit")" = 5 ])"
    
    echo
    echo "## the legacy hash on three passwords of known hash, printed by its test with the feature rules on (change AO, kept; change BH)"
    HASH_TEST=package::tests::protection::the_legacy_hash_is_pinned_on_passwords_of_known_hash
    echo "command: cargo test -p emend --features metadata,rules --lib $HASH_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features metadata,rules --lib "$HASH_TEST" -- --exact --nocapture >"$T/hash.out" 2>&1 </dev/null
    hashrc=$?
    echo "exit: $hashrc"
    LC_ALL=C "$G" -E '^legacy_password_hash[(]' "$T/hash.out" >"$T/hash.lines"
    sed 's/^/    /' "$T/hash.lines"
    LC_ALL=C "$G" -E '^test result: ' "$T/hash.out" | sed 's/^/    /'
    # The published values of the legacy algorithm for these three passwords.
    printf '%s\n' 'legacy_password_hash("password") = 83AF' 'legacy_password_hash("test") = CBEB' 'legacy_password_hash("secret") = DAA7' >"$T/hash.want"
    passed_in() { awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$1"; }
    hash_ran() { [ "$hashrc" = 0 ] && [ "$(passed_in "$T/hash.out")" = 1 ]; }
    check "the hash test ran alone and passed" "$(yn hash_ran)"
    check "it printed the three hashes, each the published value" "$(yn cmp -s "$T/hash.lines" "$T/hash.want")"
    printf '%s\n' 'legacy_password_hash("password") = 83AF' 'legacy_password_hash("test") = CBEB' 'legacy_password_hash("secret") = DAA8' >"$T/c-hash"
    hash_ctl() { if cmp -s "$T/c-hash" "$T/hash.want"; then return 1; else return 0; fi; }
    check "control: the same comparison refuses one hash off by one" "$(yn hash_ctl)"
    
    echo
    echo "## the sixteen sheetProtection elements, printed by their test with the feature rules on (change AO, kept; change BH)"
    OPT_TEST=package::tests::protection::each_option_flipped_writes_its_one_attribute
    echo "command: cargo test -p emend --features metadata,rules --lib $OPT_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features metadata,rules --lib "$OPT_TEST" -- --exact --nocapture >"$T/opt.out" 2>&1 </dev/null
    optrc=$?
    echo "exit: $optrc"
    LC_ALL=C "$G" -E '^<sheetProtection' "$T/opt.out" >"$T/opt.lines"
    sed 's/^/    /' "$T/opt.lines"
    LC_ALL=C "$G" -E '^test result: ' "$T/opt.out" | sed 's/^/    /'
    # The rule of "Protection": sheet unlocked is its default, so no attribute;
    # every other option flipped writes the protected sheet and its one attribute.
    {
      echo '<sheetProtection/>'
      for a in 'objects="1"' 'scenarios="1"' 'formatCells="0"' 'formatColumns="0"' 'formatRows="0"' \
        'insertColumns="0"' 'insertRows="0"' 'insertHyperlinks="0"' 'deleteColumns="0"' 'deleteRows="0"' \
        'selectLockedCells="1"' 'sort="0"' 'autoFilter="0"' 'pivotTables="0"' 'selectUnlockedCells="1"'; do
        echo "<sheetProtection sheet=\"1\" $a/>"
      done
    } | LC_ALL=C sort >"$T/opt.want"
    LC_ALL=C sort "$T/opt.lines" >"$T/opt.sorted"
    opt_ran() { [ "$optrc" = 0 ] && [ "$(passed_in "$T/opt.out")" = 1 ]; }
    check "the option test ran alone and passed" "$(yn opt_ran)"
    echo "  elements printed: $(count_lines "$T/opt.lines"); the rule gives: $(count_lines "$T/opt.want")"
    check "it printed the sixteen elements the rule gives, as a set" "$(yn cmp -s "$T/opt.sorted" "$T/opt.want")"
    sed '1d' "$T/opt.want" >"$T/c-opt"
    opt_ctl() { if cmp -s "$T/c-opt" "$T/opt.want"; then return 1; else return 0; fi; }
    check "control: the same comparison refuses fifteen elements" "$(yn opt_ctl)"
    
    echo
    echo "## the template core-part test's three printed parts, with the feature rules on (change AO, kept; change BH)"
    TPL_TEST=package::tests::properties::the_template_gets_the_part_its_relationship_and_its_override
    echo "command: cargo test -p emend --features metadata,rules --lib $TPL_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features metadata,rules --lib "$TPL_TEST" -- --exact --nocapture >"$T/tpl.out" 2>&1 </dev/null
    tplrc=$?
    echo "exit: $tplrc"
    # Each printed part is the declaration, a line feed and the root, so a
    # printed part is the prefixed line and the one after it.
    printed_part() { awk -v p="$1" 'index($0, p) == 1 { print; getline; print; exit }' "$2"; }
    printed_part 'created core part: ' "$T/tpl.out" >"$T/tpl.core"
    printed_part 'package rels part: ' "$T/tpl.out" >"$T/tpl.rels"
    printed_part 'content types part: ' "$T/tpl.out" >"$T/tpl.types"
    sed 's/^/    /' "$T/tpl.core" "$T/tpl.rels" "$T/tpl.types"
    LC_ALL=C "$G" -E '^test result: ' "$T/tpl.out" | sed 's/^/    /'
    CP_URI=http://schemas.openxmlformats.org/package/2006/metadata/core-properties
    CORE_ROOT="<cp:coreProperties xmlns:cp=\"$CP_URI\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:dcmitype=\"http://purl.org/dc/dcmitype/\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"><dc:title>emend</dc:title><dcterms:created xsi:type=\"dcterms:W3CDTF\">2026-01-01T00:00:00Z</dcterms:created></cp:coreProperties>"
    RELS_TAIL="<Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties\" Target=\"docProps/core.xml\"/></Relationships>"
    TYPES_TAIL="<Override PartName=\"/docProps/core.xml\" ContentType=\"application/vnd.openxmlformats-package.core-properties+xml\"/></Types>"
    part_is() { [ "$(count_lines "$1")" = 2 ] && [ "$(sed -n 2p "$1")" = "$2" ]; }
    part_ends() { [ "$(count_lines "$1")" = 2 ] && [ "$(awk -v t="$2" 'NR == 2 { print (substr($0, length($0) - length(t) + 1) == t) }' "$1")" = 1 ]; }
    tpl_ran() { [ "$tplrc" = 0 ] && [ "$(passed_in "$T/tpl.out")" = 1 ]; }
    check "the template core-part test ran alone and passed" "$(yn tpl_ran)"
    check "it printed the created core part, its root line the five prefixes and the two properties" "$(yn part_is "$T/tpl.core" "$CORE_ROOT")"
    check "it printed the package rels part, its root line ending with the core-properties relationship" "$(yn part_ends "$T/tpl.rels" "$RELS_TAIL")"
    check "it printed the content types part, its root line ending with the core part's Override" "$(yn part_ends "$T/tpl.types" "$TYPES_TAIL")"
    printf 'created core part: <?xml version="1.0"?>\n<cp:coreProperties xmlns:cp="%s"></cp:coreProperties>\n' "$CP_URI" >"$T/c-core"
    core_ctl() { if part_is "$T/c-core" "$CORE_ROOT"; then return 1; else return 0; fi; }
    check "control: the same check refuses a core part without the properties" "$(yn core_ctl)"
    printf 'package rels part: <?xml version="1.0"?>\n<Relationships></Relationships>\n' >"$T/c-rels"
    rels_ctl() { if part_ends "$T/c-rels" "$RELS_TAIL"; then return 1; else return 0; fi; }
    check "control: the same check refuses a rels part without the relationship" "$(yn rels_ctl)"
    
    echo
    echo "## the validation creation test's printed worksheets (part 4b P1's change BH, kept)"
    CR_TEST=package::tests::validation::a_container_is_created_before_hyperlinks_page_margins_ext_lst_or_the_root_end
    echo "command: cargo test -p emend --features rules --lib $CR_TEST -- --exact --nocapture (host)"
    CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --features rules --lib "$CR_TEST" -- --exact --nocapture >"$T/cr.out" 2>&1 </dev/null
    crrc=$?
    echo "exit: $crrc"
    # Each printed worksheet is the declaration, a line feed and the root, so a
    # printed part is the prefixed line and the one after it.
    printed_part 'created before <hyperlinks>: ' "$T/cr.out" >"$T/cr.links"
    printed_part 'created before <pageMargins: ' "$T/cr.out" >"$T/cr.margins"
    printed_part 'created before <extLst>: ' "$T/cr.out" >"$T/cr.ext"
    printed_part 'template worksheet after the validation: ' "$T/cr.out" >"$T/cr.tpl"
    sed 's/^/    /' "$T/cr.links" "$T/cr.margins" "$T/cr.ext" "$T/cr.tpl"
    LC_ALL=C "$G" -E '^test result: ' "$T/cr.out" | sed 's/^/    /'
    MAIN_URI=http://schemas.openxmlformats.org/spreadsheetml/2006/main
    DV_CREATED='<dataValidations count="1"><dataValidation type="whole" operator="between" allowBlank="0" showInputMessage="0" showErrorMessage="0" sqref="A1"><formula1>1</formula1><formula2>10</formula2></dataValidation></dataValidations>'
    DV_ROOT="<worksheet xmlns=\"$MAIN_URI\">"
    cr_ran() { [ "$crrc" = 0 ] && [ "$(passed_in "$T/cr.out")" = 1 ]; }
    check "the creation test ran alone and passed" "$(yn cr_ran)"
    check "it printed the worksheet with the container created before hyperlinks" \
      "$(yn part_is "$T/cr.links" "$DV_ROOT<sheetData/>$DV_CREATED<hyperlinks><hyperlink ref=\"B2\" location=\"S!A1\"/></hyperlinks><pageMargins left=\"0.7\"/></worksheet>")"
    check "it printed the worksheet with the container created before pageMargins, after conditionalFormatting" \
      "$(yn part_is "$T/cr.margins" "$DV_ROOT<sheetData/><conditionalFormatting sqref=\"A1\"/>$DV_CREATED<pageMargins left=\"0.7\"/></worksheet>")"
    check "it printed the worksheet with the container created before extLst" \
      "$(yn part_is "$T/cr.ext" "$DV_ROOT<sheetData/>$DV_CREATED<extLst><ext uri=\"x\"/></extLst></worksheet>")"
    check "it printed the template's worksheet with the container created at the root's end" \
      "$(yn part_is "$T/cr.tpl" "$DV_ROOT<sheetData/>$DV_CREATED</worksheet>")"
    cr_ctl() { if part_is "$T/cr.links" "$DV_ROOT<sheetData/><hyperlinks><hyperlink ref=\"B2\" location=\"S!A1\"/></hyperlinks>$DV_CREATED<pageMargins left=\"0.7\"/></worksheet>"; then return 1; else return 0; fi; }
    check "control: the same check refuses the container placed after hyperlinks" "$(yn cr_ctl)"
    
    echo
    echo "## the dxf creation test's printed styles parts (part 4b P2's change CG, kept; change EG)"
    DC_TEST=package::tests::dxf::a_dxfs_is_created_before_table_styles_colors_ext_lst_or_the_root_end
    echo "command: cargo test -p emend --features rules --lib $DC_TEST -- --exact --nocapture (host)"
    CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --features rules --lib "$DC_TEST" -- --exact --nocapture >"$T/dc.out" 2>&1 </dev/null
    dcrc=$?
    echo "exit: $dcrc"
    printed_part 'dxfs created before <tableStyles: ' "$T/dc.out" >"$T/dc.table"
    printed_part 'dxfs created before <colors: ' "$T/dc.out" >"$T/dc.colors"
    printed_part 'dxfs created before <extLst: ' "$T/dc.out" >"$T/dc.ext"
    printed_part 'dxfs created before </styleSheet>: ' "$T/dc.out" >"$T/dc.end"
    sed 's/^/    /' "$T/dc.table" "$T/dc.colors" "$T/dc.ext" "$T/dc.end"
    LC_ALL=C "$G" -E '^test result: ' "$T/dc.out" | sed 's/^/    /'
    DX_BASE='<fonts count="1"><font/></fonts><fills count="2"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill></fills><borders count="1"><border/></borders><cellXfs count="1"><xf/></cellXfs>'
    DX_CREATED='<dxfs count="1"><dxf><font><b/><color rgb="FF9C0006"/></font><fill><patternFill patternType="solid"><bgColor rgb="FFFFC7CE"/></patternFill></fill></dxf></dxfs>'
    DX_ROOT="<styleSheet xmlns=\"$MAIN_URI\">"
    dc_ran() { [ "$dcrc" = 0 ] && [ "$(passed_in "$T/dc.out")" = 1 ]; }
    check "the dxf creation test ran alone and passed" "$(yn dc_ran)"
    check "it printed the styles part with dxfs created before tableStyles" \
      "$(yn part_is "$T/dc.table" "$DX_ROOT$DX_BASE$DX_CREATED<tableStyles count=\"0\"/><colors/></styleSheet>")"
    check "it printed the styles part with dxfs created before colors" \
      "$(yn part_is "$T/dc.colors" "$DX_ROOT$DX_BASE$DX_CREATED<colors/><extLst/></styleSheet>")"
    check "it printed the styles part with dxfs created before extLst" \
      "$(yn part_is "$T/dc.ext" "$DX_ROOT$DX_BASE$DX_CREATED<extLst><ext uri=\"x\"/></extLst></styleSheet>")"
    check "it printed the styles part with dxfs created at the root's end" \
      "$(yn part_is "$T/dc.end" "$DX_ROOT$DX_BASE$DX_CREATED</styleSheet>")"
    dc_ctl() { if part_is "$T/dc.table" "$DX_ROOT$DX_BASE<tableStyles count=\"0\"/>$DX_CREATED<colors/></styleSheet>"; then return 1; else return 0; fi; }
    check "control: the same check refuses dxfs placed after tableStyles" "$(yn dc_ctl)"
    
    echo
    echo "## the conditional creation test's printed worksheets (part 4b P2's change CG, kept; change EG)"
    CC_TEST=package::tests::conditional::the_additions_are_created_before_the_next_child_in_schema_order_or_the_root_end
    echo "command: cargo test -p emend --features rules --lib $CC_TEST -- --exact --nocapture (host)"
    CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --features rules --lib "$CC_TEST" -- --exact --nocapture >"$T/cc.out" 2>&1 </dev/null
    ccrc=$?
    echo "exit: $ccrc"
    printed_part 'created before <dataValidations: ' "$T/cc.out" >"$T/cc.dv"
    printed_part 'created before <hyperlinks: ' "$T/cc.out" >"$T/cc.links"
    printed_part 'created before </worksheet>: ' "$T/cc.out" >"$T/cc.end"
    sed 's/^/    /' "$T/cc.dv" "$T/cc.links" "$T/cc.end"
    LC_ALL=C "$G" -E '^test result: ' "$T/cc.out" | sed 's/^/    /'
    CF_CREATED='<conditionalFormatting sqref="A1"><cfRule type="duplicateValues" dxfId="0" priority="1"/></conditionalFormatting>'
    cc_ran() { [ "$ccrc" = 0 ] && [ "$(passed_in "$T/cc.out")" = 1 ]; }
    check "the conditional creation test ran alone and passed" "$(yn cc_ran)"
    check "it printed the worksheet with the rule created before dataValidations, after mergeCells" \
      "$(yn part_is "$T/cc.dv" "$DV_ROOT<sheetData/><mergeCells count=\"1\"><mergeCell ref=\"A1:B1\"/></mergeCells>$CF_CREATED<dataValidations count=\"1\"><dataValidation sqref=\"Z1\"/></dataValidations></worksheet>")"
    check "it printed the worksheet with the rule created before hyperlinks" \
      "$(yn part_is "$T/cc.links" "$DV_ROOT<sheetData/>$CF_CREATED<hyperlinks><hyperlink ref=\"B2\" location=\"S!A1\"/></hyperlinks></worksheet>")"
    check "it printed the worksheet with the rule created at the root's end, after phoneticPr" \
      "$(yn part_is "$T/cc.end" "$DV_ROOT<sheetData/><phoneticPr fontId=\"1\"/>$CF_CREATED</worksheet>")"
    cc_ctl() { if part_is "$T/cc.dv" "$DV_ROOT<sheetData/>$CF_CREATED<mergeCells count=\"1\"><mergeCell ref=\"A1:B1\"/></mergeCells><dataValidations count=\"1\"><dataValidation sqref=\"Z1\"/></dataValidations></worksheet>"; then return 1; else return 0; fi; }
    check "control: the same check refuses the rule placed before mergeCells" "$(yn cc_ctl)"
    
    echo
    echo "## the tables template test's printed parts (change FG; specs/0021 "P1": the log prints the output)"
    TT_TEST=package::tests::tables::the_template_part_is_retagged_and_its_container_and_rels_part_created_at_the_end
    echo "command: cargo test -p emend --features tables --lib $TT_TEST -- --exact --nocapture (host)"
    CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --features tables --lib "$TT_TEST" -- --exact --nocapture >"$T/tt.out" 2>&1 </dev/null
    ttrc=$?
    echo "exit: $ttrc"
    printed_part 'template worksheet after the table: ' "$T/tt.out" >"$T/tt.sheet"
    printed_part "template worksheet's created rels part: " "$T/tt.out" >"$T/tt.rels"
    sed 's/^/    /' "$T/tt.sheet" "$T/tt.rels"
    LC_ALL=C "$G" -E '^test result: ' "$T/tt.out" | sed 's/^/    /'
    REL_URI=http://schemas.openxmlformats.org/officeDocument/2006/relationships
    TT_HEADER='<row r="1"><c r="A1" t="inlineStr"><is><t xml:space="preserve">x</t></is></c><c r="B1" t="inlineStr"><is><t xml:space="preserve">y</t></is></c></row>'
    TT_SHEET="<worksheet xmlns=\"$MAIN_URI\" xmlns:r=\"$REL_URI\"><sheetData>$TT_HEADER</sheetData><tableParts count=\"1\"><tablePart r:id=\"rId1\"/></tableParts></worksheet>"
    TT_RELS="<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"$REL_URI/table\" Target=\"../tables/table1.xml\"/></Relationships>"
    tt_ran() { [ "$ttrc" = 0 ] && [ "$(passed_in "$T/tt.out")" = 1 ]; }
    check "the tables template test ran alone and passed" "$(yn tt_ran)"
    check "it printed the template's worksheet retagged, its header row written and its container created at the root's end" "$(yn part_is "$T/tt.sheet" "$TT_SHEET")"
    check "it printed the created rels part, the table relationship with the relative target" "$(yn part_is "$T/tt.rels" "$TT_RELS")"
    tt_ctl() { if part_is "$T/tt.sheet" "<worksheet xmlns=\"$MAIN_URI\"><sheetData>$TT_HEADER</sheetData><tableParts count=\"1\"><tablePart r:id=\"rId1\"/></tableParts></worksheet>"; then return 1; else return 0; fi; }
    check "control: the same check refuses the worksheet without the retag" "$(yn tt_ctl)"
    
    echo
    echo "## the comments template test's printed parts (change IG; specs/0022 "P1": the log prints the output)"
    CT_TEST=package::tests::comments::the_template_part_is_retagged_and_its_parts_and_rels_part_created
    echo "command: cargo test -p emend --features comments --lib $CT_TEST -- --exact --nocapture (host)"
    CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --features comments --lib "$CT_TEST" -- --exact --nocapture >"$T/ct.out" 2>&1 </dev/null
    ctrc=$?
    echo "exit: $ctrc"
    printed_part 'template worksheet after the comment: ' "$T/ct.out" >"$T/ct.sheet"
    printed_part "template worksheet's created rels part: " "$T/ct.out" >"$T/ct.rels"
    sed 's/^/    /' "$T/ct.sheet" "$T/ct.rels"
    LC_ALL=C "$G" -E '^test result: ' "$T/ct.out" | sed 's/^/    /'
    CT_SHEET="<worksheet xmlns=\"$MAIN_URI\" xmlns:r=\"$REL_URI\"><sheetData/><legacyDrawing r:id=\"rId2\"/></worksheet>"
    CT_RELS="<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"$REL_URI/comments\" Target=\"../comments1.xml\"/><Relationship Id=\"rId2\" Type=\"$REL_URI/vmlDrawing\" Target=\"../drawings/vmlDrawing1.vml\"/></Relationships>"
    ct_ran() { [ "$ctrc" = 0 ] && [ "$(passed_in "$T/ct.out")" = 1 ]; }
    check "the comments template test ran alone and passed" "$(yn ct_ran)"
    check "it printed the template's worksheet retagged and its legacyDrawing created at the root's end" "$(yn part_is "$T/ct.sheet" "$CT_SHEET")"
    check "it printed the created rels part, the comments and VML relationships with the relative targets" "$(yn part_is "$T/ct.rels" "$CT_RELS")"
    ct_ctl() { if part_is "$T/ct.sheet" "<worksheet xmlns=\"$MAIN_URI\"><sheetData/><legacyDrawing r:id=\"rId2\"/></worksheet>"; then return 1; else return 0; fi; }
    check "control: the same check refuses the worksheet without the retag" "$(yn ct_ctl)"
    
    echo
    echo "## the images template test's printed parts (change KG; specs/0022 "P3": the template part)"
    IT_TEST=package::tests::images::the_template_part_is_retagged_and_its_drawing_and_rels_parts_created
    echo "command: cargo test -p emend --features images --lib $IT_TEST -- --exact --nocapture (host)"
    CARGO_TARGET_DIR=$CRATE_TARGET cargo test -p emend --features images --lib "$IT_TEST" -- --exact --nocapture >"$T/it.out" 2>&1 </dev/null
    itrc=$?
    echo "exit: $itrc"
    printed_part 'template worksheet after the image: ' "$T/it.out" >"$T/it.sheet"
    printed_part "template worksheet's created rels part: " "$T/it.out" >"$T/it.rels"
    printed_part "template drawing's created rels part: " "$T/it.out" >"$T/it.drels"
    sed 's/^/    /' "$T/it.sheet" "$T/it.rels" "$T/it.drels"
    LC_ALL=C "$G" -E '^test result: ' "$T/it.out" | sed 's/^/    /'
    IT_SHEET="<worksheet xmlns=\"$MAIN_URI\" xmlns:r=\"$REL_URI\"><sheetData/><drawing r:id=\"rId1\"/></worksheet>"
    IT_RELS="<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"$REL_URI/drawing\" Target=\"../drawings/drawing1.xml\"/></Relationships>"
    IT_DRELS="<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"$REL_URI/image\" Target=\"../media/image1.png\"/></Relationships>"
    it_ran() { [ "$itrc" = 0 ] && [ "$(passed_in "$T/it.out")" = 1 ]; }
    check "the images template test ran alone and passed" "$(yn it_ran)"
    check "it printed the template's worksheet retagged and its drawing created at the root's end" "$(yn part_is "$T/it.sheet" "$IT_SHEET")"
    check "it printed the worksheet's created rels part, the drawing relationship with the relative target" "$(yn part_is "$T/it.rels" "$IT_RELS")"
    check "it printed the drawing's created rels part, the image relationship with the relative target" "$(yn part_is "$T/it.drels" "$IT_DRELS")"
    it_ctl() { if part_is "$T/it.sheet" "<worksheet xmlns=\"$MAIN_URI\"><sheetData/><drawing r:id=\"rId1\"/></worksheet>"; then return 1; else return 0; fi; }
    check "control: the same check refuses the worksheet without the retag" "$(yn it_ctl)"
    
    echo
    echo "## the calcPr tests, unedited since the base and passing (P1's change AD, kept)"
    # test_body <commit> <file> <name>: the #[test] fn's lines, from the fn line
    # to the first line that is a closing brace at the left margin.
    test_body() {
      git show "$1:$2" 2>/dev/null | awk -v n="$3" '
        $0 ~ "^fn " n "[(]" { on = 1 }
        on { print }
        on && /^}$/ { exit }'
    }
    PKG_TESTS=crates/emend/src/package/tests.rs
    tests_attr "$C" "$PKG_TESTS" | LC_ALL=C "$G" -E 'calc_pr|full_calc|recalculate' >"$T/calc-tests" || :
    echo "  the calcPr tests in $PKG_TESTS at the phase commit, by name:"
    sed 's/^/    /' "$T/calc-tests"
    check "some calcPr tests were found" "$(yn [ "$(count_lines "$T/calc-tests")" -ge 1 ])"
    body_same() {
      test_body "$BASE" "$2" "$1" >"$T/body-base"
      test_body "$C" "$2" "$1" >"$T/body-head"
      [ "$(count_lines "$T/body-base")" -ge 2 ] && cmp -s "$T/body-base" "$T/body-head"
    }
    while IFS= read -r name; do
      echo "    $name: body lines at the base $(test_body "$BASE" "$PKG_TESTS" "$name" | count_lines /dev/stdin), at the phase commit $(test_body "$C" "$PKG_TESTS" "$name" | count_lines /dev/stdin); passed host $(passed_on "$name" host), i686 $(passed_on "$name" i686-unknown-linux-musl)"
      check "  $name: its body is the base's, byte for byte" "$(yn body_same "$name" "$PKG_TESTS")"
      check "  $name: passed on both targets" "$(yn both_passed "$name")"
    done <"$T/calc-tests"
    body_ctl() { if body_same a_one_cell_anchor_writes_its_offsets_in_emu crates/emend/src/package/tests/images/anchors.rs; then return 1; else return 0; fi; }
    check "control: the same comparison refuses a test the base lacks, this phase's one-cell offsets test (change MH)" "$(yn body_ctl)"
    
    echo
    echo "## the shift rule's table, printed by its test with the features metadata and rules on (specs/0018 \"P2\", P2's change L, kept; change BH)"
    SH_TEST=package::tests::shift::the_rule_moves_indices_and_intervals_as_the_table_gives
    echo "command: cargo test -p emend --features rowcol,metadata,rules --lib $SH_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features rowcol,metadata,rules --lib "$SH_TEST" -- --exact --nocapture >"$T/sh.out" 2>&1 </dev/null
    shrc=$?
    echo "exit: $shrc"
    LC_ALL=C "$G" -E '^shift ' "$T/sh.out" >"$T/sh.lines"
    sed 's/^/    /' "$T/sh.lines"
    LC_ALL=C "$G" -E '^test result: ' "$T/sh.out" | sed 's/^/    /'
    sh_passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/sh.out")
    nsh=$(count_lines "$T/sh.lines")
    # The cases the test pins, counted in its source at the phase commit: an
    # index row (shift, i, Some|None), an interval row (shift, a, b, Moved::),
    # and each clip call.
    SH_ROW_RE='^ *[(](ins|del), [0-9]+, (Some[(][0-9]+[)]|None|[0-9]+, Moved::[A-Za-z]+([(][0-9]+, [0-9]+[)])?)[)],$'
    git show "$C:crates/emend/src/package/tests/shift.rs" >"$T/sh-src"
    nsh_rows=$(count_matches -E "$SH_ROW_RE" "$T/sh-src")
    nsh_clips=$(count_matches -F '.area_clipped(Area::parse(' "$T/sh-src")
    echo "  shift lines printed: $nsh; rows the test pins: $nsh_rows; clip calls: $nsh_clips; tests the run passed: $sh_passed"
    sh_ran() { [ "$shrc" -eq 0 ] && [ "$sh_passed" = 1 ]; }
    check "the shift table test ran alone and passed" "$(yn sh_ran)"
    sh_rows() { [ "$nsh" -ge 1 ] && [ "$nsh" = "$((nsh_rows + nsh_clips))" ]; }
    check "one printed line per pinned case, and at least one" "$(yn sh_rows)"
    printf '        (ins, 4, Some(4)),\n        (del, 5, 6, Moved::Gone),\n        (del, 3, 5, Moved::Changed(3, 4)),\n    let x = 1;\n' >"$T/c-sh"
    check "control: the row form counts three pinned rows of four lines" "$(yn [ "$(count_matches -E "$SH_ROW_RE" "$T/c-sh")" = 3 ])"
    
    echo
    echo "## the keyword table, printed by its test with the features metadata and rules on (specs/0017 \"P1\"; change BH)"
    KW_TEST=styles::elements::tests::every_keyword_is_the_schemas_spelling
    echo "command: cargo test -p emend --features metadata,rules --lib $KW_TEST -- --exact --nocapture (host)"
    cargo test -p emend --features metadata,rules --lib "$KW_TEST" -- --exact --nocapture >"$T/kw.out" 2>&1 </dev/null
    kwrc=$?
    echo "exit: $kwrc"
    LC_ALL=C "$G" -E '^keyword ' "$T/kw.out" >"$T/kw.lines"
    sed 's/^/    /' "$T/kw.lines"
    LC_ALL=C "$G" -E '^test result: ' "$T/kw.out" | sed 's/^/    /'
    kw_passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$T/kw.out")
    nkw=$(count_lines "$T/kw.lines")
    # The rows the test pins, counted in its source at the phase commit as
    # occurrences, not lines (two rows can share a line): a variant and a quoted
    # spelling in parentheses.
    ROW_RE='[(](Underline|VerticalAlign|Scheme|Pattern|BorderStyle|Horizontal|Vertical)::[A-Za-z0-9]+, "[A-Za-z0-9]+"[)]'
    rows_in() { LC_ALL=C "$G" -o -E "$ROW_RE" "$1" | count_lines /dev/stdin; }
    git show "$C:crates/emend/src/styles/elements/tests.rs" >"$T/kw-src"
    nrows=$(rows_in "$T/kw-src")
    echo "  keyword lines printed: $nkw; rows the test pins in its source: $nrows; tests the run passed: $kw_passed"
    kw_ran() { [ "$kwrc" -eq 0 ] && [ "$kw_passed" = 1 ]; }
    check "the keyword test ran alone and passed" "$(yn kw_ran)"
    kw_rows() { [ "$nkw" -ge 1 ] && [ "$nkw" = "$nrows" ]; }
    check "one printed line per pinned row, and at least one" "$(yn kw_rows)"
    # Each printed keyword is its variant's name with the first letter lowered,
    # which is the lower camel case every keyword specs/0017 names takes.
    lowered_mismatch() {
      awk '{ n = split($2, p, "::"); v = p[n]; want = tolower(substr(v, 1, 1)) substr(v, 2); if ($3 != want) bad++ } END { print bad + 0 }' "$1"
    }
    nbad=$(lowered_mismatch "$T/kw.lines")
    echo "  printed keywords that are not the variant's name with its first letter lowered: $nbad"
    check "every printed keyword is its variant's name with the first letter lowered" "$(yn [ "$nbad" = 0 ])"
    printf 'keyword Pattern::DarkGray darkgray\nkeyword Scheme::Major major\n' >"$T/c-kw"
    check "control: the same comparison finds one misspelled keyword of two" "$(yn [ "$(lowered_mismatch "$T/c-kw")" = 1 ])"
    printf '        &[(Scheme::Major, "major"), (Scheme::Minor, "minor")],\n        (BorderStyle::Thin, "thin")\n    pinned(\n' >"$T/c-rows"
    check "control: the row form counts three rows on two lines of three" "$(yn [ "$(rows_in "$T/c-rows")" = 3 ])"
    
    echo
    echo "## no test sets EMEND_KEEP_DIR (specs/0015 P1 ruling 3, unchanged by this phase)"
    # The variable's name appears in the source only as the two KEEP_VARIABLE
    # constants, and nothing under crates/ or tools/ calls set_var or remove_var.
    echo "command: git grep -n -F EMEND_KEEP_DIR <phase commit> -- crates tools"
    git grep -n -F EMEND_KEEP_DIR "$C" -- crates tools | sed "s#^$C:##" >"$T/keep-var"
    sed 's/^/    /' "$T/keep-var"
    only_constants() {
      [ "$(count_lines "$T/keep-var")" = 2 ] &&
        [ "$(count_matches -E 'const KEEP_VARIABLE: &str = "EMEND_KEEP_DIR";$' "$T/keep-var")" = 2 ]
    }
    check "EMEND_KEEP_DIR is named only by the two KEEP_VARIABLE constants" "$(yn only_constants)"
    echo "command: git grep -n -E 'set_var|remove_var' <phase commit> -- crates tools"
    git grep -n -E 'set_var|remove_var' "$C" -- crates tools | sed "s#^$C:##" >"$T/set-var"
    sed 's/^/    /' "$T/set-var"
    check "nothing under crates/ or tools/ calls set_var or remove_var ($(count_lines "$T/set-var"))" "$(yn [ "$(count_lines "$T/set-var")" = 0 ])"
    printf 'x.rs:1:    unsafe { std::env::set_var("EMEND_KEEP_DIR", "d") };\n' >"$T/c-set-var"
    check "control: the same pattern finds a set_var line" "$(yn [ "$(count_matches -E 'set_var|remove_var' "$T/c-set-var")" = 1 ])"
    
    echo
    echo "## the ignored tests, derived from the source"
    ignored_in() {
      awk '
        /^[ \t]*#\[ignore/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?fn[ \t]/ { sub(/^[ \t]*(pub[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next }
        t { t = 0 }'
    }
    ignored_at() {
      git ls-tree -r --name-only "$1" | LC_ALL=C "$G" -E '[.]rs$' | while IFS= read -r f; do
        git show "$1:$f" | ignored_in
      done | sort
    }
    ignored_at "$BASE" >"$T/ign-base"
    ignored_at "$C" >"$T/ign-c"
    sed 's/^/    ignored in the source at the base: /' "$T/ign-base"
    sed 's/^/    ignored in the source at the phase commit: /' "$T/ign-c"
    check "the phase commit ignores exactly the tests the base ignored" "$(yn cmp -s "$T/ign-base" "$T/ign-c")"
    for target in host i686-unknown-linux-musl; do
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" | sed 's/^/    /'
      LC_ALL=C "$G" -E '^test .* \.\.\. ignored' "$T/$target.out" |
        sed -E 's/^test ([^ ]*) \.\.\. ignored.*/\1/; s/^.*:://' | sort >"$T/ign-run-$target"
      check "$target: the run's ignored tests are exactly the source's ($(count_lines "$T/ign-run-$target"))" \
        "$(yn cmp -s "$T/ign-run-$target" "$T/ign-c")"
    done
    printf '#[test]\n#[ignore = "why"]\n#[cfg(unix)]\nfn ctl_ignored() {}\n#[test]\nfn ctl_run() {}\n' | ignored_in >"$T/c-ign"
    check "control: ignored_in reads the one ignored fixture test ($(tr '\n' ' ' <"$T/c-ign"))" \
      "$(yn [ "$(cat "$T/c-ign")" = ctl_ignored ])"
    { cat "$T/ign-c"; echo zzz_control; } | sort >"$T/c-ign-plus"
    check "control: the same comparison refuses a set one name longer" \
      "$(yn [ "$(comm -3 "$T/c-ign-plus" "$T/ign-c" | count_lines /dev/stdin)" = 1 ])"
    
    echo
    echo "## six planted changes to this phase's code, each against its named test (change MI)"
    # An archive copy of the phase commit, never <repo>. Each plant replaces one
    # exact text, found once, in a fresh copy of its file; the named test runs
    # alone. The control is the same test in the unplanted copy, which passes.
    SRC=$T/src
    mkdir -p "$SRC" || fail=1
    echo "command: git archive <phase commit> | tar -x -m -C <scratch>/w/src (-m: each file takes the extraction's time, not the commit's, so no build an earlier run left in <build>/plant-target is taken for current)"
    git archive "$C" | tar -x -m -C "$SRC"
    echo "  files extracted: $(find "$SRC" -type f | count_lines /dev/stdin)"
    PLANT_TARGET=$BUILD_ROOT/plant-target
    # plant_apply <id> <file>: replaces the plant's text in <file>, printing the
    # number of times the text was found before the replacement.
    plant_apply() {
      python3 - "$1" "$2" <<'PLANTS'
    import sys
    pid, path = sys.argv[1:3]
    plants = {
        "M1": ("    let emu = |pixels: u32| (u64::from(pixels) * EMU_PER_PIXEL).to_string();",
               "    let emu = |pixels: u32| (u64::from(pixels) * EMU_PER_PIXEL + 1).to_string();"),
        "M2": ("                EditAs::OneCell => b\"oneCell\",",
               "                EditAs::OneCell => b\"twoCell\","),
        "M3": ("                if !kept_refs.contains(&id) && !removed.contains(&id) {",
               "                if kept_refs.contains(&id) && !removed.contains(&id) {"),
        "M4": ("            if reached.contains(&entry) || self.edits.part_removals.contains(&entry) {",
               "            if self.edits.part_removals.contains(&entry) {"),
        "M5": ("            if anchors_left {",
               "            if anchors_left || !anchors_left {"),
        "M6": ("        dropped += u64::from(others == 0);",
               "        dropped += u64::from(others != 0);"),
    }
    old, new = plants[pid]
    text = open(path).read()
    print(text.count(old))
    if text.count(old) == 1:
        open(path, "w").write(text.replace(old, new))
    PLANTS
    }
    # id | file | what the plant does | cargo arguments before the name | the test | the file and the text of the assertion it must fail at
    cat >"$T/plants" <<'TABLE'
    M1|crates/emend/src/package.rs|an offset's EMU one more (created)|-p emend --features images --lib|package::tests::images::anchors::a_one_cell_anchor_writes_its_offsets_in_emu|crates/emend/src/package/tests/images/anchors.rs|a_one_cell_anchor_writes_its_offsets_in_emu|assert_eq!( >> drawing_of(
    M2|crates/emend/src/package.rs|editAs oneCell written as twoCell (created)|-p emend --features images --lib|package::tests::images::anchors::a_two_cell_anchor_writes_edit_as_from_and_to_for_each_value|crates/emend/src/package/tests/images/anchors.rs|a_two_cell_anchor_writes_edit_as_from_and_to_for_each_value|assert_eq!( >> drawing_of(
    M3|crates/emend/src/package.rs|a relationship only the removed anchor named kept (kept)|-p emend --features images --lib|package::tests::images::removal::a_removal_of_the_middle_of_three_leaves_the_rest_byte_identical|crates/emend/src/package/tests/images/removal.rs|a_removal_of_the_middle_of_three_leaves_the_rest_byte_identical|assert_eq!( >> text_of(&output, DRAWING_RELS),
    M4|crates/emend/src/package.rs|a media entry another drawing reaches dropped, the reach not consulted (kept)|-p emend --features images --lib|package::tests::images::removal::a_removal_whose_media_another_drawing_targets_keeps_the_media|crates/emend/src/package/tests/images/removal.rs|a_removal_whose_media_another_drawing_targets_keeps_the_media|assert_untouched(&output, &parts, &[DRAWING, DRAWING_RELS]);
    M5|crates/emend/src/package.rs|a drawing left with no anchor kept (kept)|-p emend --features images --lib|package::tests::images::removal::a_removal_emptying_the_drawing_drops_it_with_its_rels_relationship_and_element|crates/emend/src/package/tests/images/removal.rs|a_removal_emptying_the_drawing_drops_it_with_its_rels_relationship_and_element|assert!(!has(&output, gone), "{}", String::from_utf8_lossy(gone));
    M6|tools/emend-copy/src/main.rs|the removal sample's own media count inverted (the tool test)|-p emend-copy --test null_rewrite|the_remove_image_sample_removes_its_addition_and_the_first_kept_image|tools/emend-copy/tests/null_rewrite.rs|the_remove_image_sample_removes_its_addition_and_the_first_kept_image|assert_eq!(ran.status, 0, "stderr: {}", ran.stderr);
    TABLE
    sed 's/^/    plant: /' "$T/plants"
    nplants=$(count_lines "$T/plants")
    echo "  plants in the table: $nplants"
    check "the table holds six plants (change MI)" "$(yn [ "$nplants" = 6 ])"
    # run_one <label> <cargo args> <test>: runs one test in the archive copy; the
    # exit status and the output go to <scratch>/w/plant-<label>.
    run_one() {
      local label=$1 args=$2 name=$3
      ( cd "$SRC" && CARGO_TARGET_DIR=$PLANT_TARGET cargo test $args "$name" -- --exact ) \
        >"$T/plant-$label.out" 2>&1 </dev/null
      echo $? >"$T/plant-$label.rc"
    }
    # The lines a failing test prints that say what failed: its FAILED line, the
    # panic line, the message line after it (part 4a P1's change AF), and the
    # assertion's left and right.
    failure_lines() {
      awk '/panicked at/ { print; if ((getline line) > 0) print line; next }
           /^test .* \.\.\. (ok|FAILED)$|^  left:|^ right:|^assertion/ { print }' "$1" | head -n 14
    }
    test_line_is() { LC_ALL=C "$G" -a -qxF "test $1 ... $2" "$3"; }
    plant_ok() {
      local id=$1 name=$2
      [ "$(cat "$T/plant-$id.found")" = 1 ] || return 1
      [ "$(cat "$T/plant-$id-clean.rc")" = 0 ] || return 1
      test_line_is "$name" ok "$T/plant-$id-clean.out" || return 1
      [ "$(cat "$T/plant-$id.rc")" != 0 ] || return 1
      test_line_is "$name" FAILED "$T/plant-$id.out"
    }
    # assert_line <file> <test fn> <text>: the number of the one line, inside the
    # test fn at the phase commit, whose text with the margin dropped is <text>;
    # empty unless exactly one. <text> may be several lines joined by " >> ":
    # then the line is the first of a run of lines each equal to its part, the
    # run found once (change TI). The text reaches awk through the environment,
    # so a backslash in it is compared as written (change UI).
    assert_line() {
      git show "$C:$1" | ASSERT_TEXT=$3 awk -v f="fn $2(" '
        BEGIN { k = split(ENVIRON["ASSERT_TEXT"], part, / >> /) }
        index($0, f) == 1 { on = 1 }
        on { s = $0; sub(/^[ \t]*/, "", s); line[NR] = s; first = first ? first : NR }
        on && /^}$/ { last = NR; on = 0 }
        END {
          for (i = first; i <= last; i++) {
            ok = 1
            for (j = 1; j <= k; j++) if (line[i + j - 1] != part[j]) { ok = 0; break }
            if (ok) { n++; at = i }
          }
          if (n == 1) print at
        }'
    }
    # panic_at <output>: "<file>:<line>" of the first panic the output prints.
    panic_at() { LC_ALL=C "$G" -a -o -E 'panicked at [^ ]+:[0-9]+:[0-9]+' "$1" | head -n 1 | sed -E 's/^panicked at ([^ ]+):([0-9]+):[0-9]+$/\1:\2/'; }
    : >"$T/plant-lines"
    while IFS='|' read -r id file what args name afile afn atext; do
      echo "  plant $id: $what ($file)"
      echo "    command (control, unplanted): cargo test $args $name -- --exact"
      run_one "$id-clean" "$args" "$name"
      echo "    control exit: $(cat "$T/plant-$id-clean.rc")"
      failure_lines "$T/plant-$id-clean.out" | sed 's/^/      /'
      failed_names "$T/plant-$id-clean.out"
      cp "$SRC/$file" "$T/pristine"
      plant_apply "$id" "$SRC/$file" >"$T/plant-$id.found"
      echo "    the plant's text found in the file: $(cat "$T/plant-$id.found") time(s)"
      echo "    command (planted): cargo test $args $name -- --exact"
      run_one "$id" "$args" "$name"
      echo "    planted exit: $(cat "$T/plant-$id.rc")"
      failure_lines "$T/plant-$id.out" | sed 's/^/      /'
      failed_names "$T/plant-$id.out"
      cp "$T/pristine" "$SRC/$file"
      check "  plant $id: found once, the test passes unplanted and fails planted" "$(yn plant_ok "$id" "$name")"
      want_line=$(assert_line "$afile" "$afn" "$atext")
      got_at=$(panic_at "$T/plant-$id.out")
      echo "    the assertion it must fail at: $afile, line $want_line ($atext); the planted run's first panic: $got_at"
      printf '%s\n' "$got_at" >>"$T/plant-lines"
      at_own_line() { [ -n "$want_line" ] && [ "$got_at" = "$afile:$want_line" ]; }
      check "  plant $id fails at its own assertion line, read from the source (P2 verification ruling 6)" "$(yn at_own_line)"
    done <"$T/plants"
    ndistinct=$(LC_ALL=C sort -u "$T/plant-lines" | count_lines /dev/stdin)
    echo "  plants: $nplants; distinct assertion lines they failed at: $ndistinct"
    check "each plant failed at a line of its own (P2 verification ruling 6)" "$(yn [ "$ndistinct" = "$nplants" ])"
    restored() {
      local f
      for f in crates/emend/src/package.rs tools/emend-copy/src/main.rs; do
        git show "$C:$f" | cmp -s - "$SRC/$f" || return 1
      done
    }
    check "the planted files are restored to the phase commit's bytes" "$(yn restored)"
    printf "thread 'x' panicked at a.rs:1:1:\nthe planted message\n" >"$T/c-panic"
    fl_message() { [ "$(failure_lines "$T/c-panic" | sed -n 2p)" = "the planted message" ]; }
    check "control: failure_lines prints the message line after a panic line" "$(yn fl_message)"
    check "control: panic_at reads the file and line of a panic line" "$(yn [ "$(panic_at "$T/c-panic")" = a.rs:1 ])"
    check "control: assert_line finds no line for a text the test lacks" "$(yn [ -z "$(assert_line crates/emend/src/package/tests/sheetprops.rs none_drops_the_tab_colour_and_a_sheet_pr_left_empty_with_it 'no such line')" ])"
    check "control: assert_line finds no single line for a text the test holds twice" "$(yn [ -z "$(assert_line crates/emend/src/package/tests/sheetprops.rs a_part_with_no_sheet_views_gains_one_in_schema_position 'assert_eq!(')" ])"
    check "control: assert_line finds one line for a run of lines found once (change TI)" "$(yn [ -n "$(assert_line crates/emend/src/package/tests/sheetprops.rs the_four_elements_are_created_in_one_write_in_schema_order 'assert_eq!( >> got,')" ])"
    check "control: assert_line finds no single line for a run of lines the test holds twice" "$(yn [ -z "$(assert_line crates/emend/src/package/tests/names/print.rs an_autofilter_replaces_the_part_s_its_children_dropped_and_none_drops_both 'assert_eq!( >> String::from_utf8(stored_data(&output, &sheet_part(1))).expect("UTF-8"),')" ])"
    backslash_ctl() { [ -n "$(assert_line crates/emend/src/package/tests/names/print.rs an_autofilter_replaces_the_part_s_its_children_dropped_and_none_drops_both 'worksheet("<sheetData/><autoFilter ref=\"A1:D4\" x=\"1\"></autoFilter>")')" ]; }
    check "control: assert_line finds a source line holding backslashes, compared as written (change UI)" "$(yn backslash_ctl)"
    printf 'test x::y ... ok\n' >"$T/c-tl"
    check "control: test_line_is finds an ok line" "$(yn test_line_is x::y ok "$T/c-tl")"
    not_failed_ctl() { if test_line_is x::y FAILED "$T/c-tl"; then return 1; else return 0; fi; }
    check "control: test_line_is refuses FAILED for a test that passed" "$(yn not_failed_ctl)"
    printf 'no such text\n' >"$T/c-plant.rs"
    check "control: plant_apply finds M1's text 0 times in a file without it" "$(yn [ "$(plant_apply M1 "$T/c-plant.rs")" = 0 ])"
    
    echo
    echo "## the two runs"
    echo "host executed $(cat "$T/host.count") tests; i686-unknown-linux-musl executed $(cat "$T/i686-unknown-linux-musl.count") tests"
    check "the i686 run executed the same test names as the host run" "$(yn cmp -s "$T/host.names" "$T/i686-unknown-linux-musl.names")"
    echo
    echo "## status after the runs"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS_RE" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs, its records or planning's uncommitted spec: $st_ours"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]
    }
    check "every change in the working tree is one of this phase's logs, its records (run and open-check) or planning's uncommitted spec" "$(yn status_accounted)"
    printf '?? records/m3p6-open-x.md\n M scripts/check.sh\n?? records/m3p6-p2-x.md\n?? records/m3p5-p3-x.md\n M specs/0027-read-back.md\n M specs/0028-images-and-comments-second-half.md\n?? records/m3p6-p3-x.md\n' >"$T/c-status"
    check "control: the same pattern finds three of seven status lines, planning's spec among them (change MK)" "$(yn [ "$(count_matches -E "$OURS_RE" "$T/c-status")" = 3 ])"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$T/c-err"; printf 'x' >>"$T/c-err"
    nerr_ctl=$(wc -c <"$T/c-err")
    echo "  command: wc -c <phase>/out/test.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

