    echo "  stated unreachable through the tool: COPY_RELATIONSHIP, since the tool's input is a file and no fixture here keeps a relationship other than a hyperlink's (the corpus run reaches none); covered by package::tests::copy::$COVER3 (count at the phase commit: $(cover copy "$COVER3"))"
    echo "  stated unreachable through the tool: COPY_NEEDS_COMMENTS, since the tool turns the Cargo feature comments on; covered by package::tests::copy::$COVER4, which runs only without comments, shown passing below (count at the phase commit: $(cover copy "$COVER4"))"
    ncover="$(cover anchors "$COVER_ANCHOR"):$(cover removal "$COVER_AT"):$(cover boxes "$COVER_BOX"):$(cover boxes "$COVER_ADD"):$(cover copy "$COVER1"):$(cover copy "$COVER2"):$(cover copy "$COVER3"):$(cover copy "$COVER4"):"
    echo "  the eight covering tests' fn lines at the phase commit, counted in the order above (one test covers the two anchor messages): $ncover"
    check "each covering test is at the phase commit, once" "$(yn [ "$ncover" = 1:1:1:1:1:1:1:1: ])"
    check "control: the same count finds no test of a planted name" "$(yn [ "$(cover copy a_planted_test_name)" = 0 ])"
    echo "  \"Errors\"' shared messages, printed and not accounted: \"no sheet of that name\", the name rules, \"no such part\", part 3's index message, \"a worksheet has threaded comments\", the comments read's and the drawing read's other messages; the part's tests reach them"
    echo
    echo "### the comments-feature message's covering test, run without comments in the worktree (change UD; P3's change TD, ruling 10)"
    echo "command: (cd <tree> && CARGO_TARGET_DIR=<target>/negative cargo test -p emend --features copy --lib package::tests::copy::$COVER4 -- --exact)"
    (cd "$TREE" && CARGO_TARGET_DIR="$NEG_TARGET" cargo test -p emend --features copy --lib "package::tests::copy::$COVER4" -- --exact) >"$B/cover4.out" 2>&1 </dev/null
    rc4=$?
    echo "  exit: $rc4"
    LC_ALL=C "$G" -E '^test |^test result:' "$B/cover4.out" | sed 's/^/    /'
    cover4_ran() { [ "$rc4" = 0 ] && [ "$(count_matches -Fx "test package::tests::copy::$COVER4 ... ok" "$B/cover4.out")" = 1 ] && [ "$(count_matches -E '^test result: ok\. 1 passed; 0 failed' "$B/cover4.out")" = 1 ]; }
    check "the covering test ran alone without comments and passed, by name" "$(yn cover4_ran)"
    printf 'test result: ok. 0 passed; 0 failed; 0 ignored\n' >"$B/c-cover4.out"
    cover4_ctl() { [ "$(count_matches -E '^test result: ok\. 1 passed; 0 failed' "$B/c-cover4.out")" = 1 ]; }
    check "control: the same form refuses a run that ran no test (a filtered run, gotchas 2026-09-26)" "$(ynnot cover4_ctl)"
    neg_target_used() { [ -d "$NEG_TARGET/debug" ] && apart "$NEG_TARGET" "$TARGET_ROOT/main"; }
    check "the worktree's build went into <target>/negative, apart from <target>/main (ruling 10)" "$(yn neg_target_used)"
    echo
    echo "### this log's generator, from the phase commit's template files"
    mkdir "$B/template" "$B/fx"
    for f in '[Content_Types].xml' _rels/.rels xl/workbook.xml xl/_rels/workbook.xml.rels xl/worksheets/sheet1.xml xl/styles.xml; do
      mkdir -p "$B/template/$(dirname "$f")"
      git show "$C:crates/emend/template/$f" >"$B/template/$f"
    done
    cat >"$B/gen-p6p4.py" <<'PY'
    """Fictional packages for M3 part 6 P4's negative log: the phase commit's
    template files, zipped in the template's order, the three families of the
    part's earlier phases on one generator (change UB). B0 is the bare
    template, whose one sheet is a worksheet. P1's: NUC the sheet given a
    comments part holding one comment on B2 and a VML part holding its note
    shape, sized, with their rels part and overrides; NU the same with the VML
    part's root end tag left out. P2's: NMC the sheet given a drawing part of
    one picture anchor, the drawing's rels part naming its media entry, and the
    entry; NM the same without the entry. P3's: NC B0 with the workbook's
    relationship to its sheet of the chartsheet type.
    Usage: gen-p6p4.py <template dir> <out dir>."""
    import os
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    src, out = sys.argv[1], sys.argv[2]
    parts = {name: open(os.path.join(src, name), "rb").read() for name in ORDER}
    sheet = parts["xl/worksheets/sheet1.xml"]
    types = parts["[Content_Types].xml"]
    wbrels = parts["xl/_rels/workbook.xml.rels"]
    MAIN = b'<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
    R = b"http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    EMPTY = b"<sheetData/>"
    WS = b'Type="' + R + b'/worksheet"'
    CS = b'Type="' + R + b'/chartsheet"'
    assert sheet.count(MAIN) == 1 and sheet.count(EMPTY) == 1 and sheet.count(b"<c ") == 0
    assert types.count(b"</Types>") == 1
    assert wbrels.count(WS) == 1 and wbrels.count(CS) == 0
    print("the template: one worksheet relationship, its worksheet an empty sheetData alone, its root binding no prefix")
    ROOT_R = MAIN[:-1] + b' xmlns:r="' + R + b'">'
    
    # P1's family (records/logs/m3p6-p1/negative.log), unchanged.
    COMMENTS = (b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                b'<comments xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
                b"<authors><author>emend</author></authors><commentList>"
                b'<comment ref="B2" authorId="0"><text><t>kept</t></text></comment>'
                b"</commentList></comments>")
    VML = (b'<xml xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" '
           b'xmlns:x="urn:schemas-microsoft-com:office:excel"><o:shapelayout v:ext="edit">'
           b'<o:idmap v:ext="edit" data="1"/></o:shapelayout><v:shape id="_x0000_s1025" '
           b'type="#_x0000_t202" style="position:absolute;width:108pt;height:59.25pt;visibility:hidden">'
           b'<x:ClientData ObjectType="Note"><x:Row>1</x:Row><x:Column>1</x:Column></x:ClientData>'
           b"</v:shape></xml>")
    assert VML.count(b"</xml>") == 1
    COMMENT_RELS = (b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                    b'<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
                    b'<Relationship Id="rId1" Type="' + R + b'/comments" Target="../comments1.xml"/>'
                    b'<Relationship Id="rId2" Type="' + R + b'/vmlDrawing" Target="../drawings/vmlDrawing1.vml"/>'
                    b"</Relationships>")
    COMMENT_OVERRIDES = (b'<Override PartName="/xl/comments1.xml" '
                         b'ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.comments+xml"/>'
                         b'<Override PartName="/xl/drawings/vmlDrawing1.vml" '
                         b'ContentType="application/vnd.openxmlformats-officedocument.vmlDrawing"/></Types>')
    
    # P2's family (records/logs/m3p6-p2/negative.log), unchanged.
    DRAWING = (b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
               b'<xdr:wsDr xmlns:xdr="http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing" '
               b'xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><xdr:twoCellAnchor>'
               b"<xdr:from><xdr:col>3</xdr:col><xdr:colOff>0</xdr:colOff><xdr:row>3</xdr:row>"
               b"<xdr:rowOff>0</xdr:rowOff></xdr:from><xdr:to><xdr:col>5</xdr:col><xdr:colOff>0"
               b"</xdr:colOff><xdr:row>5</xdr:row><xdr:rowOff>0</xdr:rowOff></xdr:to><xdr:pic>"
               b'<xdr:nvPicPr><xdr:cNvPr id="2" name="Picture 2"/><xdr:cNvPicPr/></xdr:nvPicPr>'
               b'<xdr:blipFill><a:blip xmlns:r="' + R + b'" r:embed="rId1"/></xdr:blipFill><xdr:spPr/>'
               b"</xdr:pic><xdr:clientData/></xdr:twoCellAnchor></xdr:wsDr>")
    DRAWING_SHEET_RELS = (b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                          b'<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
                          b'<Relationship Id="rId1" Type="' + R + b'/drawing" Target="../drawings/drawing1.xml"/>'
                          b"</Relationships>")
    DRAWING_RELS = (b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                    b'<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
                    b'<Relationship Id="rId1" Type="' + R + b'/image" Target="../media/image1.png"/>'
                    b"</Relationships>")
    MEDIA = b"fictional media bytes"
    DRAWING_OVERRIDES = (b'<Override PartName="/xl/drawings/drawing1.xml" '
                         b'ContentType="application/vnd.openxmlformats-officedocument.drawing+xml"/>'
                         b'<Override PartName="/xl/media/image1.png" ContentType="image/png"/></Types>')
    
    
    def comment_case(vml):
        p, order = dict(parts), list(ORDER)
        p["xl/worksheets/sheet1.xml"] = sheet.replace(MAIN, ROOT_R).replace(EMPTY, EMPTY + b'<legacyDrawing r:id="rId2"/>')
        p["[Content_Types].xml"] = types.replace(b"</Types>", COMMENT_OVERRIDES)
        p["xl/worksheets/_rels/sheet1.xml.rels"] = COMMENT_RELS
        p["xl/comments1.xml"] = COMMENTS
        p["xl/drawings/vmlDrawing1.vml"] = vml
        order += ["xl/worksheets/_rels/sheet1.xml.rels", "xl/comments1.xml", "xl/drawings/vmlDrawing1.vml"]
        return p, order
    
    
    def drawing_case(media):
        p, order = dict(parts), list(ORDER)
        p["xl/worksheets/sheet1.xml"] = sheet.replace(MAIN, ROOT_R).replace(EMPTY, EMPTY + b'<drawing r:id="rId1"/>')
        p["[Content_Types].xml"] = types.replace(b"</Types>", DRAWING_OVERRIDES)
        p["xl/worksheets/_rels/sheet1.xml.rels"] = DRAWING_SHEET_RELS
        p["xl/drawings/drawing1.xml"] = DRAWING
        p["xl/drawings/_rels/drawing1.xml.rels"] = DRAWING_RELS
        order += ["xl/worksheets/_rels/sheet1.xml.rels", "xl/drawings/drawing1.xml",
                  "xl/drawings/_rels/drawing1.xml.rels"]
        if media:
            p["xl/media/image1.png"] = MEDIA
            order.append("xl/media/image1.png")
        return p, order
    
    
    def chart_case():
        p, order = dict(parts), list(ORDER)
        p["xl/_rels/workbook.xml.rels"] = wbrels.replace(WS, CS)
        return p, order
    
    
    CASES = {
        "b0": (dict(parts), list(ORDER)),
        "nuc": comment_case(VML),
        "nu": comment_case(VML.replace(b"</xml>", b"")),
        "nmc": drawing_case(True),
        "nm": drawing_case(False),
        "nc": chart_case(),
    }
    for name, (p, order) in CASES.items():
        path = os.path.join(out, name + ".xlsx")
        with zipfile.ZipFile(path, "w") as z:
            for n in order:
                z.writestr(zipfile.ZipInfo(n, (1980, 1, 1, 0, 0, 0)), p[n], zipfile.ZIP_DEFLATED)
        w = p["xl/worksheets/sheet1.xml"]
        v = p.get("xl/drawings/vmlDrawing1.vml", b"")
        d = p.get("xl/drawings/drawing1.xml", b"")
        r = p["xl/_rels/workbook.xml.rels"]
        print("%s %d entries:%d legacyDrawing:%d comments:%d shapes:%d sized:%d root_end:%d "
              "drawing:%d anchors:%d pics:%d embeds:%d media:%d worksheet_rels:%d chartsheet_rels:%d" % (
                  name + ".xlsx", os.path.getsize(path), len(order),
                  w.count(b"<legacyDrawing"), p.get("xl/comments1.xml", b"").count(b"<comment "),
                  v.count(b"<v:shape "), v.count(b"width:108pt;height:59.25pt"), v.count(b"</xml>"),
                  w.count(b"<drawing "), d.count(b"<xdr:twoCellAnchor>"), d.count(b"<xdr:pic>"),
                  d.count(b'r:embed="rId1"'), int("xl/media/image1.png" in p), r.count(WS), r.count(CS)))
    PY
    sed 's/^/    /' "$B/gen-p6p4.py"
    echo "command: python3 <scratch>/w/gen-p6p4.py <scratch>/w/template <scratch>/w/fx"
    python3 "$B/gen-p6p4.py" "$B/template" "$B/fx" >"$B/gen-p6p4.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/gen-p6p4.out"
    check "the six fixtures were written, and nothing else" "$(yn [ "$(find "$B/fx" -type f | wc -l)" = 6 ])"
    template_shape() { [ "$(count_matches -Fx "the template: one worksheet relationship, its worksheet an empty sheetData alone, its root binding no prefix" "$B/gen-p6p4.out")" = 1 ]; }
    check "the template holds one worksheet relationship and an empty sheetData alone, the shape the controls' lines are built on (change UB)" "$(yn template_shape)"
    fixture_is() { [ "$(count_matches -E "^$1[.]xlsx [0-9]+ $2\$" "$B/gen-p6p4.out")" = 1 ]; }
    F_B0='entries:6 legacyDrawing:0 comments:0 shapes:0 sized:0 root_end:0 drawing:0 anchors:0 pics:0 embeds:0 media:0 worksheet_rels:1 chartsheet_rels:0'
    F_NUC='entries:9 legacyDrawing:1 comments:1 shapes:1 sized:1 root_end:1 drawing:0 anchors:0 pics:0 embeds:0 media:0 worksheet_rels:1 chartsheet_rels:0'
    F_NU='entries:9 legacyDrawing:1 comments:1 shapes:1 sized:1 root_end:0 drawing:0 anchors:0 pics:0 embeds:0 media:0 worksheet_rels:1 chartsheet_rels:0'
    F_NMC='entries:10 legacyDrawing:0 comments:0 shapes:0 sized:0 root_end:0 drawing:1 anchors:1 pics:1 embeds:1 media:1 worksheet_rels:1 chartsheet_rels:0'
    F_NM='entries:9 legacyDrawing:0 comments:0 shapes:0 sized:0 root_end:0 drawing:1 anchors:1 pics:1 embeds:1 media:0 worksheet_rels:1 chartsheet_rels:0'
    F_NC='entries:6 legacyDrawing:0 comments:0 shapes:0 sized:0 root_end:0 drawing:0 anchors:0 pics:0 embeds:0 media:0 worksheet_rels:0 chartsheet_rels:1'
    check "B0 is the bare template: six entries, its sheet's relationship a worksheet's" "$(yn fixture_is b0 "$F_B0")"
    check "NUC holds the comment parts: nine entries, one legacyDrawing, one comment, one shape, sized, the root's end tag (P1's)" "$(yn fixture_is nuc "$F_NUC")"
    check "NU is NUC with the VML part's root end tag left out, and nothing else counted differs (P1's)" "$(yn fixture_is nu "$F_NU")"
    check "NMC holds the drawing parts: ten entries, one drawing element, one anchor, one picture naming rId1, the media entry (P2's)" "$(yn fixture_is nmc "$F_NMC")"
    check "NM is NMC with the media entry left out, and nothing else counted differs (P2's)" "$(yn fixture_is nm "$F_NM")"
    check "NC is B0 with that relationship's type chartsheet, and nothing else counted differs (P3's)" "$(yn fixture_is nc "$F_NC")"
    check "control: the same form refuses NU's line against NUC's counts" "$(ynnot fixture_is nu "$F_NUC")"
    check "control: the same form refuses NM's line against NMC's counts" "$(ynnot fixture_is nm "$F_NMC")"
    check "control: the same form refuses NC's line against B0's counts" "$(ynnot fixture_is nc "$F_B0")"
    # run_bin <case> <args...>: the copied binary, the command printed with the
    # paths it names, stdout, stderr and exit kept.
    run_bin() {
      local case=$1
      shift
      "$BIN" "$@" >"$B/$case.stdout" 2>"$B/$case.stderr" </dev/null
      echo $? >"$B/$case.status"
      echo "command: <tree>/bin/emend-copy $*"
      echo "  exit: $(cat "$B/$case.status")"
      echo "  stdout:"; sed 's/^/    /' "$B/$case.stdout"
      echo "  stderr:"; sed 's/^/    /' "$B/$case.stderr"
    }
    status_is() { [ "$(cat "$B/$1.status")" = "$2" ]; }
    refused_with() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ -n "$2" ] && [ "$(cat "$B/$1.stderr")" = "$2" ]; }
    no_output() { [ ! -e "$B/out/$1.xlsx" ]; }
    has_output() { [ -s "$B/out/$1.xlsx" ]; }
    usage_refused() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ "$(count_matches -F 'error: usage: emend-copy' "$B/$1.stderr")" = 1 ]; }
    # line_is <case> <line>: exit 0, no stderr, the line, and an output (each
    # sample writes parts, so no byte comparison; P1's box_is, P2's gone_is and
    # P3's copy_is as one helper, change UB).
    line_is() { status_is "$1" 0 && [ ! -s "$B/$1.stderr" ] && [ "$(cat "$B/$1.stdout")" = "$2" ] && has_output "$1"; }
    mkdir "$B/out"
    # The cases: case name, fixture, sample.
    CASE_LIST="b0cb:b0:--commentbox-sample nuc:nuc:--commentbox-sample nu:nu:--commentbox-sample b0ri:b0:--remove-image-sample nmc:nmc:--remove-image-sample nm:nm:--remove-image-sample b0cp:b0:--copy-sample nc:nc:--copy-sample"
    for spec in $CASE_LIST; do
      IFS=: read -r case fx sample <<<"$spec"
      echo
      echo "### ${case^^} ($sample)"
      run_bin "$case" "$B/fx/$fx.xlsx" "$B/out/$case.xlsx" "$sample"
    done
    echo
    echo "### the checks"
    # The lines are the tool's doc applied to the fixtures, each family's as its
    # phase built it (change UB). P1's: no cell, so M is 0 and the comment goes
    # on A1; B0 has no comment part, so one comment and one shape are created;
    # NUC keeps its comment on B2, whose shape is sized, and gains one of each.
    box_line() { printf 'commentbox\tcomments_before=%s\tcomments_after=%s\tshapes_before=%s\tshapes_after=%s\tsized_before=%s\tbox_equal=1\tvisible_after=1' "$@"; }
    L_CB_NONE=$(box_line 0 1 0 1 0)
    L_CB_KEPT=$(box_line 1 2 1 2 1)
    # P2's: the image goes on A1; B0 has no drawing, so the addition and its
    # removal leave none; NMC's one picture is removed with the addition, its
    # media entry dropped and the drawing with it.
    gone_line() { printf 'removeimage\timages_before=%s\timages_after=0\tkept_removed=%s\tmedia_before=%s\tmedia_after=0\tmedia_dropped=%s\tdrawing_dropped=%s\tanchors_before=%s\tanchors_after=0' "$@"; }
    L_RI_NONE=$(gone_line 0 0 0 0 1 0)
    L_RI_KEPT=$(gone_line 1 1 1 1 0 1)
    # P3's: S is the one worksheet, no comments relationship, so W; its empty
    # sheetData holds no cell, merge, hyperlink, comment or formula, and the
    # template has no calculation chain; the copy is one more sheet.
    L_COPY=$(printf 'copy\tsheets_before=1\tsheets_after=2\tcells_source=0\tcells_copy=0\tcomments_source=0\tcomments_copy=0\tmerges_source=0\tmerges_copy=0\tlinks_source=0\tlinks_copy=0\tformulas=0\tchain_before=0\tchain_after=0')
    check "B0CB: exit 0, its line, an output (the bare template, --commentbox-sample)" "$(yn line_is b0cb "$L_CB_NONE")"
    check "B0RI: exit 0, its line, an output (the bare template, --remove-image-sample)" "$(yn line_is b0ri "$L_RI_NONE")"
    # The refusals: case, the message's name, the control's case, its line and
    # what the control is. A refusal that holds records its name as reached.
    : >"$B/reached"
    refusal() {
      local case=$1 name=$2 ctl=$3 want=$4 what=$5 expect
      expect=$(msg "$name")
      check "${ctl^^}: exit 0, its line, an output (the control for ${case^^}, $what)" "$(yn line_is "$ctl" "$want")"
      check "${case^^}: exit 2, no stdout, the error line exactly $name's message" "$(yn refused_with "$case" "$expect")"
      check "${case^^}: no output file" "$(yn no_output "$case")"
      if refused_with "$case" "$expect"; then
        printf '%s %s\n' "$name" "$case" >>"$B/reached"
      fi
    }
    refusal nu COMMENTS_UNREADABLE nuc "$L_CB_KEPT" "the same package with the VML part's root end tag"
    refusal nm DRAWING_UNREADABLE nmc "$L_RI_KEPT" "the same package with the media entry"
    refusal nc NoWorksheet b0cp "$L_COPY" "the same package with the worksheet relationship"
    echo "  reached, by case:"
    sed 's/^/    /' "$B/reached"
    check "the three refusals were reached: a VML part with no root end tag (NU), a drawing's rels part naming a missing media entry (NM), a workbook whose only sheet is a chartsheet (NC)" "$(yn [ "$(count_lines "$B/reached")" = 3 ])"
    b0_refused() { refused_with b0cb "$(msg COMMENTS_UNREADABLE)" || refused_with b0ri "$(msg DRAWING_UNREADABLE)" || refused_with b0cp "$(msg NoWorksheet)"; }
    check "control: refused_with says no on each B0 run against its family's message" "$(ynnot b0_refused)"
    nu_other() { refused_with nu "$(msg NO_COMMENT_ADDITION)"; }
    check "control: refused_with says no on NU's run against the part's NO_COMMENT_ADDITION" "$(ynnot nu_other)"
    nm_other() { refused_with nm "$(msg NO_IMAGE_AT)"; }
    check "control: refused_with says no on NM's run against the part's NO_IMAGE_AT" "$(ynnot nm_other)"
    nc_other() { refused_with nc "$(msg COPY_NEEDS_WORKSHEET)"; }
    check "control: refused_with says no on NC's run against the layer's own chartsheet message" "$(ynnot nc_other)"
    empty_message() { refused_with nc ""; }
    check "control: refused_with says no against an empty message" "$(ynnot empty_message)"
    cb_ctl() { line_is nuc "$L_CB_NONE"; }
    check "control: line_is says no on NUC's run against B0CB's line" "$(ynnot cb_ctl)"
    ri_ctl() { line_is nmc "$L_RI_NONE"; }
    check "control: line_is says no on NMC's run against B0RI's line" "$(ynnot ri_ctl)"
    copy_line_ctl() { line_is b0cp "$(printf '%s' "$L_COPY" | sed 's/sheets_after=2/sheets_after=1/')"; }
    check "control: line_is says no on B0CP's run against a line with one sheet fewer" "$(ynnot copy_line_ctl)"
    out_ctl() { line_is nu "" || line_is nm "" || line_is nc ""; }
    check "control: line_is says no on each refused run, which left no output" "$(ynnot out_ctl)"
    nout=$(find "$B/out" -type f | wc -l)
    echo "  output files: $nout, the five runs' that were accepted (B0CB, NUC, B0RI, NMC, B0CP)"
    check "no output but the accepted runs', and no temporary beside them" "$(yn [ "$nout" = 5 ])"
    echo
    echo "### the messages reached, as sets (change UC)"
    echo "  reached here, from the checks above that held (each name once):"
    cut -d' ' -f1 "$B/reached" | LC_ALL=C sort -u >"$B/reached-all.set"
    sed 's/^/    /' "$B/reached-all.set"
    cut -f1 "$B/shared.tsv" | LC_ALL=C sort -u >"$B/shared.set"
    echo "  stated unreachable: the part's nine messages, with their covering tests above"
    echo "  the messages accounted for $(count_lines "$B/known.tsv"); reached $(count_lines "$B/reached-all.set"); stated unreachable $(count_lines "$B/part.tsv")"
    reached_is_shared() { cmp -s "$B/reached-all.set" "$B/shared.set"; }
    check "the messages reached are exactly the three shared messages, the part's nine being stated unreachable" "$(yn reached_is_shared)"
    union_ctl() { printf 'COMMENTS_UNREADABLE\nDRAWING_UNREADABLE\nNoWorksheet\nPLANTED\n' | LC_ALL=C sort | cmp -s - "$B/reached-all.set"; }
    check "control: the comparison refuses the reached set with a planted message" "$(ynnot union_ctl)"
    echo
    echo "### two usage shapes (change LD, P4 change KD)"
    run_bin u1 "$B/fx/b0.xlsx" "$B/out/u1.xlsx" --copy-sample extra
    check "U1: exit 2, the usage line" "$(yn usage_refused u1)"
    run_bin u2 "$B/fx/b0.xlsx" "$B/out/u2.xlsx" --copy-sample --items
    check "U2: exit 2, the usage line" "$(yn usage_refused u2)"
    usage_ctl() { usage_refused b0cp; }
    check "control: usage_refused says no on B0CP's run" "$(ynnot usage_ctl)"
    check "U1 and U2 left no output (change UB: the five accepted runs' are the outputs)" "$(yn [ "$(find "$B/out" -type f | wc -l)" = 5 ])"
    git worktree remove --force "$TREE" >/dev/null 2>&1
    check "the worktree is gone from git's list" "$(yn [ "$(git worktree list --porcelain | count_matches -F "$TREE" /dev/stdin)" = 0 ])"
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.stdout "$B"/*.stderr "$B"/gen-p6p4.out; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or records or planning's spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's logs or records or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/negative.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

