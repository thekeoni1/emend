    """The run log's survey of the corpus before M3 part 6 P3's runs
    (specs/0028-images-and-comments-second-half.md, "Harness runs", P3;
    specs/0024 P1 verification ruling 6's form: names, ids and counts only, the
    corpus directory a parameter).
    
    Usage: copysurvey.py <corpus>
    
    Lists <corpus>/corpus (every regular file, no extension glob) and reads each
    workbook the manifest <corpus>/manifest.tsv names, in manifest order: the
    workbook part through the package relationships, its sheets in <sheets>
    order and S as the sample chooses it (the first worksheet whose rels part
    holds an internal comments relationship, else the first worksheet, W),
    with ElementTree for the relationships parts and the workbook; S's part and
    its comments part read with expat WITHOUT namespace processing, each
    element's namespace resolved here from the declarations in scope (the tree
    reader copied by name from M3 part 6 P2's imgsurvey.py): a reader of
    another lineage than the run log's comparison (byte spans and ElementTree)
    and the tool (the crate's token stream).
    
    Prints, tab-separated, one line per workbook:
      wb <id> <sheets> <worksheets> <s_is_w> <comments> <threaded> <hyperlinks>
         <dropped> <codename> <tabselected> <setup_r> <alternate>
         <alternate_dropped> <f> <chain> <cells> <comment_elements> <merges>
         <links>
    where <sheets> is the workbook's <sheet> elements and <worksheets> those
    whose relationship is a worksheet's; <s_is_w> 1 when S is W; <comments> and
    <threaded> 1 when S's rels part holds a comments and a threadedComment
    relationship; <hyperlinks> S's hyperlink relationships (external ones
    too); <dropped> S's main root children the copy drops (drawing,
    legacyDrawing, legacyDrawingHF, picture, oleObjects, controls,
    webPublishItems, tableParts, extLst); <codename> 1 when S's sheetPr carries
    codeName; <tabselected> the sheetView elements carrying tabSelected;
    <setup_r> 1 when S's pageSetup carries an attribute in the relationships
    namespace; <alternate> S's root mc:AlternateContent children and
    <alternate_dropped> those whose branches hold elements, every one a main
    element the copy drops; <f> 1 when S holds a main f; <chain> 1 when the
    workbook's rels part holds a calcChain relationship; <cells> S's main c
    elements; <comment_elements> the comment elements of S's comments part (0
    without one); <merges> and <links> S's main mergeCell and hyperlink
    elements. Last one line
      files <regular files in corpus/> <manifest rows> <rows read>
    No value, text, reference or part name is printed.
    """
    import os
    import posixpath
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    from xml.parsers import expat
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    
    
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    
    
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    
    def tree(data):
        """The part as nested [namespace, local name, attributes, children,
        text], namespaces resolved from the declarations in scope; an attribute
        keeps its name as written."""
        root = [None, "", {}, [], ""]
        stack = [root]
        scopes = [{}]
    
        def start(name, attrs):
            pairs = list(zip(attrs[0::2], attrs[1::2]))
            scope = dict(scopes[-1])
            for (k, v) in pairs:
                if k == "xmlns":
                    scope[""] = v
                elif k.startswith("xmlns:"):
                    scope[k[6:]] = v
            scopes.append(scope)
            prefix, _, loc = name.rpartition(":")
            node = [scope.get(prefix), loc, dict(pairs), [], ""]
            node.append(scope)
            stack[-1][3].append(node)
            stack.append(node)
    
        def end(name):
            stack.pop()
            scopes.pop()
    
        def chars(data):
            stack[-1][4] += data
    
        p = expat.ParserCreate()
        p.ordered_attributes = True
        p.StartElementHandler = start
        p.EndElementHandler = end
        p.CharacterDataHandler = chars
        p.Parse(data, True)
        return root[3][0]
    
    
    def walk(node):
        yield node
        for k in node[3]:
            yield from walk(k)
    
    
    MC = "http://schemas.openxmlformats.org/markup-compatibility/2006"
    DROPPED = ("drawing", "legacyDrawing", "legacyDrawingHF", "picture", "oleObjects", "controls",
               "webPublishItems", "tableParts", "extLst")
    THREADED = "http://schemas.microsoft.com/office/2017/10/relationships/threadedComment"
    
    
    def rels_all(z, part):
        """(Id, Type, internal target or None) of every relationship of a part,
        external ones too."""
        d, base = posixpath.split(part)
        name = posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            t = el.get("Target", "")
            if el.get("TargetMode") == "External":
                out.append((el.get("Id"), el.get("Type", ""), None))
            else:
                out.append((el.get("Id"), el.get("Type", ""),
                            t[1:] if t.startswith("/") else posixpath.normpath(posixpath.join(d, t))))
        return out
    
    
    def typed(kind, suffix):
        return kind in [a + suffix for a in ATTR]
    
    
    def survey(z):
        wb = [t for (_, ty, t) in rels_all(z, "") if ty.endswith("/officeDocument")][0]
        by_id = {i: (ty, t) for (i, ty, t) in rels_all(z, wb)}
        sheets = []
        for el in ET.fromstring(z.read(wb)).iter():
            if el.tag in ["{%s}sheet" % m for m in MAIN]:
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a)), None)
                sheets.append(by_id.get(rid, ("", None)))
        works = [t for (ty, t) in sheets if typed(ty, "/worksheet")]
        if not works:
            return None
        s = next((t for t in works if any(typed(ty, "/comments") and tt is not None
                                           for (_, ty, tt) in rels_all(z, t))), works[0])
        srels = rels_all(z, s)
        comments = next((t for (_, ty, t) in srels if typed(ty, "/comments") and t is not None), None)
        threaded = 1 if any(ty == THREADED for (_, ty, _) in srels) else 0
        hl = sum(1 for (_, ty, _) in srels if typed(ty, "/hyperlink"))
        root = tree(z.read(s))
        kids = root[3]
        dropped = sum(1 for k in kids if k[0] in MAIN and k[1] in DROPPED)
        codename = 1 if any(k[0] in MAIN and k[1] == "sheetPr" and "codeName" in k[2] for k in kids) else 0
        tabsel = 0
        for k in kids:
            if k[0] in MAIN and k[1] == "sheetViews":
                tabsel += sum(1 for v in k[3] if v[0] in MAIN and v[1] == "sheetView" and "tabSelected" in v[2])
        setup_r = 0
        for k in kids:
            if k[0] in MAIN and k[1] == "pageSetup":
                for an in k[2]:
                    prefix, _, _ = an.rpartition(":")
                    if prefix and prefix != "xmlns" and k[5].get(prefix) in ATTR:
                        setup_r = 1
        alts = [k for k in kids if k[0] == MC and k[1] == "AlternateContent"]
        alt_dropped = 0
        for a in alts:
            grand = [g for b in a[3] for g in b[3]]
            if grand and all(g[0] in MAIN and g[1] in DROPPED for g in grand):
                alt_dropped += 1
        every = list(walk(root))
        f = 1 if any(n[0] in MAIN and n[1] == "f" for n in every) else 0
        cells = sum(1 for n in every if n[0] in MAIN and n[1] == "c")
        merges = sum(1 for n in every if n[0] in MAIN and n[1] == "mergeCell")
        links = sum(1 for n in every if n[0] in MAIN and n[1] == "hyperlink")
        ncomm = 0
        if comments is not None and comments in z.namelist():
            ncomm = sum(1 for n in walk(tree(z.read(comments))) if n[0] in MAIN and n[1] == "comment")
        chain = 1 if any(typed(ty, "/calcChain") for (_, ty, _) in rels_all(z, wb)) else 0
        return (len(sheets), len(works), 1 if s == works[0] else 0, 1 if comments is not None else 0, threaded,
                hl, dropped, codename, tabsel, setup_r, len(alts), alt_dropped, f, chain, cells, ncomm, merges,
                links)
    
    
    def main():
        corpus = sys.argv[1]
        lines = open(os.path.join(corpus, "manifest.tsv"), encoding="utf-8").read().split("\n")
        head = lines[0].split("\t")
        rows = [l.split("\t") for l in lines[1:] if l]
        files = sorted(f for f in os.listdir(os.path.join(corpus, "corpus"))
                       if os.path.isfile(os.path.join(corpus, "corpus", f)))
        read = 0
        for row in rows:
            cid, ext = row[head.index("id")], row[head.index("ext")]
            name = "%s.%s" % (cid, ext)
            if name not in files:
                print("wb\t%s\tmissing" % cid)
                continue
            got = survey(zipfile.ZipFile(os.path.join(corpus, "corpus", name)))
            if got is None:
                print("wb\t%s\tno-worksheet" % cid)
                continue
            read += 1
            print("\t".join(["wb", cid] + [str(v) for v in got]))
        print("files\t%d\t%d\t%d" % (len(files), len(rows), read))
    
    
    main()
