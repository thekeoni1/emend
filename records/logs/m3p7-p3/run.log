    """The run log's own sheet copy comparison for M3 part 6 P3
    (specs/0028-images-and-comments-second-half.md, "Harness runs",
    --copy-sample and the run log's own check, the copy bullet; "The copy";
    the planning rulings during P3, 1 to 6).
    
    Usage: copycmp.py copy <input archive> <output archive> [--diff <diff.tsv>] [--plant <flag>]
           copycmp.py copy <input archive> --parts
    
    Its readers are M3 part 6 P2's imgcmp.py's (zipfile, byte spans and
    ElementTree; the values, bit 3, local-header and descriptor readers of the
    xml_values and flagged checks), copied by name by <home>/.cache/emend-build/
    m3p6-p3/gen/copycmp_build.py; it shares no code with the library or the
    tool. From the input it finds the workbook part through the package
    relationship, the sheets in <sheets> order, and S as the sample chooses it:
    the first <sheet> whose relationship type is a worksheet's and whose part's
    rels part holds an internal comments relationship, else the first worksheet
    (W). From the input alone it builds what the output must hold, by the
    design's rules (specs/0028 "The copy" and the rulings during P3):
    
      the copy's entry, <workbook dir>/worksheets/sheet<n>.xml for the smallest
      positive n no entry takes; its bytes: S's, every byte kept but sheetPr's
      codeName, each sheetView's tabSelected in sheetViews, every relationships-
      namespace attribute of pageSetup, the main root children drawing,
      legacyDrawing, legacyDrawingHF, picture, oleObjects, controls,
      webPublishItems, tableParts and extLst, and a root mc:AlternateContent
      whose branches hold elements and only those (ruling 2); when S's comments
      are carried, a legacyDrawing with the root's prefix naming the copy's VML
      relationship, created before the first main root child that comes after
      legacyDrawing in schema order, else before the root's end tag, the root
      binding r (or r<n>) to the relationships namespace of the copy's form when
      it binds none;
      the copy's rels part: S's hyperlink relationships (Id, Type, Target,
      TargetMode) in order, then, when carried, a comments and a vmlDrawing
      relationship of the copy's form, ids rId one past the largest numbered id
      of those, then the next, targets relative to the copy; none at all when
      S has neither (ruling 1);
      when carried, the comments part xl/comments<n>.xml (the smallest n whose
      name, ASCII case folded, no entry and not the copy's takes) holding S's
      comments part byte for byte, and the VML part
      xl/drawings/vmlDrawing<n>.vml (likewise, after the comments part) with
      one Note shape per comment of S's comments part, at its row and column,
      in document order;
      the workbook's sheets the input's and one more, named "emend copy",
      sheetId one above the largest, no state, its relationship a worksheet
      relationship of the form of the input's first one targeting the copy;
      the content types the input's, less the calculation chain's Override when
      the chain goes, with an Override for the copy (unless a Default for xml
      carries the worksheet type) and, when carried, the comments part's and
      the VML part's, in that order;
      the chain: where S holds a main f and the workbook has a calcChain
      relationship, the relationship, its Override and its entry gone; the
      output's calcPr fullCalcOnLoad="1" exactly when S holds an f or the
      input's has it.
    
    Flags:
    
      whole_bytes     the copy's entry is the bytes built above, byte for byte
      data_same       the copy's sheetData is S's, byte for byte (the spec's copy
                      check)
      kept_same       the copy's cols, mergeCells, hyperlinks, dataValidations,
                      conditionalFormatting and pageMargins root children are
                      S's, in order, byte for byte (the spec's copy check)
      views_same      the copy's sheetViews are S's less tabSelected (the spec's)
      setup_same      the copy's pageSetup is S's less its relationships
                      attributes (the spec's)
      dropped_gone    no codeName on sheetPr, no tabSelected, no relationships
                      attribute on pageSetup, no drawing, legacyDrawingHF,
                      picture, oleObjects, controls, webPublishItems, tableParts
                      or extLst root child and no AlternateContent of dropped
                      elements in the copy; a legacyDrawing only when carried,
                      one, naming the copy's VML relationship (the spec's)
      rels_set        the copy's rels part's relationships are the ones built
                      above, or there is no rels part when none is built
      comments_same   carried: the comments part is S's byte for byte (the
                      spec's); not carried: no comments part is added
      notes_placed    carried: the VML part's Note shapes are one per comment of
                      S, at its row and column, in order (the spec's); not
                      carried: no VML part is added
      workbook_sheet  the workbook's sheets as built above
      types_set       the content types as built above
      chain_rule      the chain and fullCalcOnLoad as built above
      rest_same       the output's entries are the input's, less the chain's
                      entry where it goes, with the copy's entry, its rels part
                      and the carried parts added; every entry both hold but the
                      workbook, its rels part and the content types byte for
                      byte (uncompressed)
    
    and xml_values and flagged as imgcmp.py's (specs/0024 P1 verification
    ruling 6, rtcmp.py's form) with --diff.
    
    It prints ONE line of counts and yes/no flags and no text, reference, sheet
    name or part name: sheets_in, sheets_out, cells_in and cells_out (the main c
    elements in S's and the copy's sheetData), comments_in and comments_out (the
    comment elements of S's and the copy's comments parts), merges_in,
    merges_out, links_in and links_out (mergeCell and hyperlink elements),
    formulas (1 when S holds a main f), chain_in and chain_out (1 when the
    workbook has a calcChain relationship), carried, links_rel (1 when S has a
    hyperlink relationship), then the value and flag counts, then the flags.
    --parts prints, one per line, for the log to compare with the runner's rows
    without printing them: the copy's entry, its rels part, the comments part
    and the VML part (- when not carried), links_rel, carried, formulas,
    chain_in, the chain's entry (- without one), the workbook part, its rels
    part, and 1 or 0 for the chain's entry dropped. --plant <flag> changes the
    output as read (or, for chain_rule, xml_values and flagged, the rule) so
    that the named flag turns to no; the line then says planted=yes, or
    planted=no when the pair gives the plant nothing to change.
    """
    import collections
    import posixpath
    import re
    import struct
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    
    
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    
    
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    
    MC = "http://schemas.openxmlformats.org/markup-compatibility/2006"
    
    
    TABLE = (
        "sheetPr dimension sheetViews sheetFormatPr cols sheetData sheetCalcPr "
        "sheetProtection protectedRanges scenarios autoFilter sortState "
        "dataConsolidate customSheetViews mergeCells phoneticPr "
        "conditionalFormatting dataValidations hyperlinks printOptions pageMargins "
        "pageSetup headerFooter rowBreaks colBreaks customProperties cellWatches "
        "ignoredErrors smartTags drawing legacyDrawing legacyDrawingHF drawingHF "
        "picture oleObjects controls webPublishItems tableParts extLst").split()
    
    
    COMMENT = b"<!-- planted -->"
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def attr_value(tag, name):
        m = re.search(ATTR_RE % re.escape(name), tag)
        return m.group(1)[1:-1] if m else None
    
    
    def with_attr(tag, name, value):
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def children(data, a, b, rp, root_ns):
        """[(start, end, main local name or None)] of the root's children."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            p, n = split_name(qname(raw))
            tag = start_tag(raw)
            decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
            own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
            if own:
                main = own.group(1)[1:-1].decode() in MAIN
            else:
                main = p == rp and root_ns in MAIN
            out.append((a + x, a + y, n if main else None))
        return out
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def values_of(root):
        """The values of an ElementTree as xlsx-diff keys them (M3 part 5 P1's
        rtcmp.py, copied by name): each attribute (namespace declarations are
        not attributes here) by element, attribute and value; each text node
        that is not whitespace alone by its element and its text."""
        vals = collections.Counter()
        ws = " \t\n\r"
    
        def walk(el):
            for (k, v) in el.attrib.items():
                vals[("a", el.tag, k, v)] += 1
            if el.text and el.text.strip(ws):
                vals[("t", el.tag, el.text)] += 1
            for c in el:
                walk(c)
                if c.tail and c.tail.strip(ws):
                    vals[("t", el.tag, c.tail)] += 1
    
        walk(root)
        return vals
    
    
    def is_xml_name(name):
        return name.lower().endswith((".xml", ".rels", ".vml"))
    
    
    def rel_tuples(z, name):
        """(Id, Type, Target, TargetMode) of a rels part's relationships, in
        order, or None when the archive has no such entry."""
        if name not in z.namelist():
            return None
        return [(el.get("Id"), el.get("Type"), el.get("Target"), el.get("TargetMode"))
                for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS)]
    
    
    def type_tuples(data):
        return [(local(el.tag)[1], el.get("PartName"), el.get("Extension"), el.get("ContentType"))
                for el in ET.fromstring(data)]
    
    
    def raw_of(z, name):
        """(compression method, the entry's stored bytes) read through its local
        header."""
        zi = z.getinfo(name)
        fp = z.fp
        fp.seek(zi.header_offset)
        head = fp.read(30)
        n, m = struct.unpack("<HH", head[26:30])
        fp.seek(zi.header_offset + 30 + n + m)
        return zi.compress_type, fp.read(zi.compress_size)
    
    
    def gap_of(z, name):
        """The bytes after an entry's stored data up to the next local header,
        or the central directory: its data descriptor, when it has one
        (xlsx-diff's gap, read here through the local headers)."""
        zi = z.getinfo(name)
        fp = z.fp
        fp.seek(zi.header_offset)
        head = fp.read(30)
        n, m = struct.unpack("<HH", head[26:30])
        end = zi.header_offset + 30 + n + m + zi.compress_size
        later = [i.header_offset for i in z.infolist() if i.header_offset >= end]
        nxt = min(later + [z.start_dir])
        fp.seek(end)
        return fp.read(max(0, nxt - end))
    
    
    def descriptor_differs(zin, zout, name):
        """xlsx-diff's descriptor flag for an entry both archives hold: general
        purpose bit 3 differs, or the bytes after the data differ."""
        b_in = zin.getinfo(name).flag_bits & 0x08
        b_out = zout.getinfo(name).flag_bits & 0x08
        return b_in != b_out or gap_of(zin, name) != gap_of(zout, name)
    
    
    def values_and_flags(zin, zout, names, out_names, diff_path, flag_plant, flags):
        """The xml_values and flagged checks (cbcmp.py's, flagged over every
        rewritten entry), and their counts."""
        both = [nm for nm in names if nm in out_names]
        changed = [nm for nm in both if zin.read(nm) != zout.read(nm)]
        rewritten = [nm for nm in both if nm in changed or raw_of(zin, nm) != raw_of(zout, nm)]
        want_values = {}
        for nm in changed:
            if is_xml_name(nm):
                try:
                    vi, vo = values_of(ET.fromstring(zin.read(nm))), values_of(ET.fromstring(zout.read(nm)))
                    want_values[nm] = (sum((vi - vo).values()), sum((vo - vi).values()))
                except ET.ParseError:
                    want_values[nm] = None
        want_in = sum(v[0] for v in want_values.values() if v)
        want_out = sum(v[1] for v in want_values.values() if v)
        in_only = out_only = flagged_rows = want_flagged = -1
        if flag_plant == "xml_values":
            want_out += 1
        if diff_path is not None:
            rows = [l.split("\t") for l in open(diff_path, encoding="utf-8").read().split("\n") if l]
            values = {c[1]: c for c in rows if len(c) >= 7 and c[0] == "xml" and c[2] == "values"}
            in_only = sum(int(c[5]) for c in values.values())
            out_only = sum(int(c[6]) for c in values.values())
            per_ok = all(want_values.get(nm) is not None and (int(c[5]), int(c[6])) == want_values[nm]
                         for (nm, c) in values.items())
            flags["xml_values"] = (set(values) == set(want_values) and per_ok
                                   and in_only == want_in and out_only == want_out)
            ents = [{"name": c[1], "status": c[2], "flags": c[16]} for c in rows
                    if len(c) == 17 and c[0] == "entry"]
            flagged_rows = sum(1 for r in ents if r["flags"])
            wanted = {nm: ("descriptor" if descriptor_differs(zin, zout, nm) else "") for nm in rewritten}
            if flag_plant == "flagged":
                wanted = {nm: ("" if f else "descriptor") for (nm, f) in wanted.items()}
            want_flagged = sum(1 for f in wanted.values() if f)
            statuses = {r["name"]: r["status"] for r in ents}
            rewritten_rows = {nm for (nm, st) in statuses.items() if st in ("changed", "recompressed")}
            recompressed_ok = all(statuses.get(nm) == ("changed" if nm in changed else "recompressed")
                                  for nm in rewritten)
            flags["flagged"] = (len(ents) > 0 and flagged_rows == want_flagged and rewritten_rows == set(rewritten)
                                and recompressed_ok
                                and all(r["flags"] == wanted.get(r["name"], "") for r in ents))
        return (len(want_values), in_only, want_in, out_only, want_out, flagged_rows, want_flagged,
                len(rewritten) - len(changed))
    
    
    def counts_of(vals):
        changed_xml, in_only, want_in, out_only, want_out, flagged_rows, want_flagged, recompressed = vals
        return ["changed_xml=%d" % changed_xml, "in_only=%d" % in_only, "in_only_want=%d" % want_in,
                "out_only=%d" % out_only, "out_only_want=%d" % want_out,
                "flagged_rows=%d" % flagged_rows, "flagged_want=%d" % want_flagged,
                "recompressed=%d" % recompressed]
    
    
    def options(rest, flags):
        diff_path = flag_plant = None
        while rest:
            if rest[0] == "--diff" and len(rest) >= 2:
                diff_path, rest = rest[1], rest[2:]
            elif rest[0] == "--plant" and len(rest) >= 2:
                flag_plant, rest = rest[1], rest[2:]
                if flag_plant not in flags:
                    return None, None, "error=unknown-plant"
            else:
                return None, None, "error=usage"
        return diff_path, flag_plant, None
    
    
    assert len(TABLE) == 39
    
    FLAGS_OF = {
        "copy": ("whole_bytes", "data_same", "kept_same", "views_same", "setup_same", "dropped_gone",
                 "rels_set", "comments_same", "notes_placed", "workbook_sheet", "types_set", "chain_rule",
                 "rest_same", "xml_values", "flagged"),
    }
    # The sample's constant (tools/emend-copy, --copy-sample).
    COPY_NAME = "emend copy"
    DROPPED = ("drawing", "legacyDrawing", "legacyDrawingHF", "picture", "oleObjects", "controls",
               "webPublishItems", "tableParts", "extLst")
    KEPT = ("cols", "mergeCells", "hyperlinks", "dataValidations", "conditionalFormatting", "pageMargins")
    WS_TYPES = tuple(a + "/worksheet" for a in ATTR)
    COMMENTS_TYPES = tuple(a + "/comments" for a in ATTR)
    VML_TYPES = tuple(a + "/vmlDrawing" for a in ATTR)
    LINK_TYPES = tuple(a + "/hyperlink" for a in ATTR)
    CHAIN_TYPES = tuple(a + "/calcChain" for a in ATTR)
    WORKSHEET_CT = "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"
    COMMENTS_CT = "application/vnd.openxmlformats-officedocument.spreadsheetml.comments+xml"
    VML_CT = "application/vnd.openxmlformats-officedocument.vmlDrawing"
    X_NS = "urn:schemas-microsoft-com:office:excel"
    LD_AT = TABLE.index("legacyDrawing")
    
    
    class Entries:
        """A read-only archive over entry name to uncompressed bytes."""
    
        def __init__(self, d):
            self.d = d
    
        def namelist(self):
            return list(self.d)
    
        def read(self, name):
            return self.d[name]
    
    
    def entries_of(z):
        return {i.filename: z.read(i.filename) for i in z.infolist()}
    
    
    def sheet_list(z, workbook):
        """(name, sheetId, state, target, type) of every <sheet>, in order, and
        the r:id of each beside."""
        by_id = {i: (ty, t) for (i, ty, t) in rels_of(z, workbook)}
        out, ids = [], []
        for el in ET.fromstring(z.read(workbook)).iter():
            ns, name = local(el.tag)
            if ns in MAIN and name == "sheet":
                rid = next((el.get("{%s}id" % a) for a in ATTR if el.get("{%s}id" % a) is not None), None)
                ty, target = by_id.get(rid, ("", None))
                out.append((el.get("name"), el.get("sheetId"), el.get("state"), target, ty))
                ids.append(rid)
        return out, ids
    
    
    def numbered(rid):
        m = re.fullmatch(r"rId([0-9]+)", rid or "")
        return int(m.group(1)) if m else 0
    
    
    def free(folded, form):
        n = 1
        while (form % n).lower() in folded:
            n += 1
        return form % n
    
    
    COUNTS = {}
    
    
    def main_count(data, name):
        """The main elements of a part by local name, each part read once."""
        if data is None:
            return 0
        if data not in COUNTS:
            COUNTS[data] = collections.Counter(local(el.tag)[1] for el in ET.fromstring(data).iter()
                                               if local(el.tag)[0] in MAIN)
        return COUNTS[data][name]
    
    
    def has_f(data):
        return main_count(data, "f") > 0
    
    
    def full_calc(data):
        for el in ET.fromstring(data).iter():
            if local(el.tag)[0] in MAIN and local(el.tag)[1] == "calcPr":
                return el.get("fullCalcOnLoad") in ("1", "true")
        return False
    
    
    def remove_attr(tag, name):
        """A start tag without the attribute written `name` and the whitespace
        before it (the crate's without_attribute, independently)."""
        m = re.search(rb'[ \t\r\n]+' + re.escape(name) + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
        return tag if m is None else tag[:m.start()] + tag[m.end():]
    
    
    def rel_attr_names(tag, prefixes):
        """The written names of a start tag's attributes with one of `prefixes`."""
        out = []
        for m in re.finditer(rb'\s([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            q = m.group(1)
            p, _, _ = q.rpartition(b":")
            if p and p in prefixes and not q.startswith(b"xmlns:"):
                out.append(q)
        return out
    
    
    def rels_prefixes(tag):
        """Every prefix a start tag binds to either relationships namespace."""
        return {m.group(1) for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag)
                if m.group(2)[1:-1].decode() in ATTR}
    
    
    def without_tab_selected(raw):
        """A sheetViews element with tabSelected off each sheetView start tag one
        level in."""
        out, at, depth = [], 0, 0
        for m in TOKEN.finditer(raw):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                continue
            if depth == 1 and split_name(qname(tok))[1] == "sheetView":
                out.append(raw[at:m.start()])
                out.append(remove_attr(tok, b"tabSelected"))
                at = m.end()
            if not m.group(2):
                depth += 1
        out.append(raw[at:])
        return b"".join(out)
    
    
    def without_rels_attrs(raw, prefixes):
        tag = start_tag(raw)
        new = tag
        for q in rel_attr_names(tag, prefixes | rels_prefixes(tag)):
            new = remove_attr(new, q)
        return new + raw[len(tag):]
    
    
    def droppable(el):
        grand = [g for b in el for g in b]
        return len(grand) > 0 and all(local(g.tag)[0] in MAIN and local(g.tag)[1] in DROPPED for g in grand)
    
    
    def is_alternate(el):
        return local(el.tag) == (MC, "AlternateContent")
    
    
    KIDS = {}
    
    
    def kids_of(data):
        """The root's children: [(start, end, main local name or None, the
        ElementTree element)], with the root's span and prefix; each part read
        once."""
        if data not in KIDS:
            KIDS[data] = kids_read(data)
        return KIDS[data]
    
    
    def kids_read(data):
        a0, a1, ca, cb, rp = root_span(data)
        root = ET.fromstring(data)
        ns = local(root.tag)[0]
        spans = children(data, ca, cb, rp, ns)
        els = list(root)
        if len(spans) != len(els):
            return None
        return [(x, y, n, e) for ((x, y, n), e) in zip(spans, els)], (a0, a1, ca, cb, rp)
    
    
    def named(data, name):
        got = kids_of(data)
        if got is None:
            return None
        return [data[x:y] for (x, y, n, _) in got[0] if n == name]
    
    
    def built_copy(sdata, vml_id, strict):
        """The copy's bytes by the design's rules, `vml_id` the VML relationship
        when the comments are carried, else None."""
        got = kids_of(sdata)
        if got is None:
            return None
        kids, (a0, a1, ca, cb, rp) = got
        tag = sdata[a0:a1]
        rpx = rels_prefixes(tag)
        ld = None
        if vml_id is not None:
            have = re.search(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag)
            bound = [m.group(1) for m in re.finditer(rb'\sxmlns:([^\s=/>]+)\s*=\s*("[^"]*"|\'[^\']*\')', tag)
                     if m.group(2)[1:-1].decode() in ATTR]
            if bound:
                p = bound[0]
            else:
                n = 0
                while True:
                    p = b"r" if n == 0 else b"r%d" % n
                    if attr_value(tag, b"xmlns:" + p) is None:
                        break
                    n += 1
                tag = with_attr(tag, b"xmlns:" + p, ATTR[1 if strict else 0].encode())
            ld = b"<" + rp + b"legacyDrawing " + p + b':id="' + vml_id.encode() + b'"/>'
            del have
        if ca == cb and sdata[a1 - 2:a1] == b"/>" and ld is not None:
            return sdata[:a0] + opened(tag) + ld + b"</" + qname(tag) + b">" + sdata[a1:]
        out = [sdata[:a0], tag]
        at = ca
        for (x, y, n, el) in kids:
            out.append(sdata[at:x])
            at = y
            if ld is not None and n is not None and n in TABLE and TABLE.index(n) > LD_AT:
                out.append(ld)
                ld = None
            if n in DROPPED or (n is None and is_alternate(el) and droppable(el)):
                continue
            raw = sdata[x:y]
            if n == "sheetPr":
                t = start_tag(raw)
                raw = remove_attr(t, b"codeName") + raw[len(t):]
            elif n == "sheetViews":
                raw = without_tab_selected(raw)
            elif n == "pageSetup":
                raw = without_rels_attrs(raw, rpx)
            out.append(raw)
        out.append(sdata[at:cb])
        if ld is not None:
            out.append(ld)
        out.append(sdata[cb:])
        return b"".join(out)
    
    
    def info(zin):
        names = zin.namelist()
        z = Entries(entries_of(zin))
        wb = workbook_of(z)
        if wb is None:
            return "error=no-workbook"
        sheets, ids = sheet_list(z, wb)
        worksheets = [s for s in sheets if s[4] in WS_TYPES]
        if not worksheets:
            return "error=no-worksheet"
        s = None
        for sh in worksheets:
            if any(ty in COMMENTS_TYPES and t is not None for (_, ty, t) in rels_of(z, sh[3])):
                s = sh
                break
        if s is None:
            s = worksheets[0]
        spart = s[3]
        srels = rel_tuples(z, rels_name(spart)) or []
        links = [r for r in srels if r[1] in LINK_TYPES]
        comments = next((t for (_, ty, t) in rels_of(z, spart) if ty in COMMENTS_TYPES and t is not None), None)
        carried = comments is not None
        wrels = rels_of(z, wb)
        chain = next((t for (_, ty, t) in wrels if ty in CHAIN_TYPES), None)
        chain_in = any(ty in CHAIN_TYPES for (_, ty, _) in wrels)
        formulas = has_f(z.read(spart))
        wdir = posixpath.dirname(wb)
        n = 1
        while posixpath.join(wdir, "worksheets/sheet%d.xml" % n) in names:
            n += 1
        copy = posixpath.join(wdir, "worksheets/sheet%d.xml" % n)
        form = next((ty for (_, ty, _) in wrels if ty in WS_TYPES), WS_TYPES[0])
        strict = form == WS_TYPES[1]
        folded = {nm.lower() for nm in names} | {copy.lower()}
        cname = free(folded, "xl/comments%d.xml")
        folded.add(cname.lower())
        vname = free(folded, "xl/drawings/vmlDrawing%d.vml")
        top = max([numbered(r[0]) for r in links] + [0])
        want_rels = list(links)
        vml_id = None
        if carried:
            cdir = posixpath.dirname(copy)
            want_rels.append(("rId%d" % (top + 1), COMMENTS_TYPES[strict], posixpath.relpath(cname, cdir), None))
            vml_id = "rId%d" % (top + 2)
            want_rels.append((vml_id, VML_TYPES[strict], posixpath.relpath(vname, cdir), None))
        drop = formulas and chain_in
        return {"z": z, "names": names, "wb": wb, "sheets": sheets, "ids": ids, "s": s, "spart": spart,
                "links": links, "comments": comments, "carried": carried, "chain": chain, "chain_in": chain_in,
                "formulas": formulas, "copy": copy, "form": form, "strict": strict, "cname": cname,
                "vname": vname, "want_rels": want_rels, "vml_id": vml_id, "drop": drop}
    
    
    def notes_of(data):
        """(row, column) of each Note shape of a VML part, in order."""
        out = []
        root = ET.fromstring(data)
        for el in root.iter("{%s}ClientData" % X_NS):
            if el.get("ObjectType") != "Note":
                continue
            row = el.find("{%s}Row" % X_NS)
            col = el.find("{%s}Column" % X_NS)
            out.append((int(row.text) if row is not None else -1, int(col.text) if col is not None else -1))
        return out
    
    
    def refs_of(data):
        """(row, column), zero-based, of each comment of a comments part, in
        order."""
        out = []
        for el in ET.fromstring(data).iter():
            if local(el.tag)[0] in MAIN and local(el.tag)[1] == "comment":
                m = re.fullmatch(r"([A-Z]+)([0-9]+)", el.get("ref", ""))
                if not m:
                    out.append((-1, -1))
                    continue
                col = 0
                for ch in m.group(1):
                    col = col * 26 + ord(ch) - 64
                out.append((int(m.group(2)) - 1, col - 1))
        return out
    
    
    def before_root_end(data, piece):
        at = data.rfind(b"</")
        return data[:at] + piece + data[at:]
    
    
    def plant_out(flag, got, od):
        """Changes the output as read so that `flag` turns to no; whether there
        was something to change."""
        copy = got["copy"]
        if flag in ("chain_rule", "xml_values", "flagged"):
            return True
        if copy not in od:
            return False
        rp = root_span(od[copy])[4]
        if flag == "whole_bytes":
            od[copy] = before_root_end(od[copy], COMMENT)
        elif flag == "data_same":
            got_k = kids_of(od[copy])
            spans = [(x, y) for (x, y, n, _) in got_k[0] if n == "sheetData"] if got_k else []
            if not spans:
                return False
            x, y = spans[0]
            raw = od[copy][x:y]
            if raw.endswith(b"/>"):
                new = opened(raw) + b"</" + qname(raw) + b">"
            else:
                t = start_tag(raw)
                new = t + COMMENT + raw[len(t):]
            od[copy] = od[copy][:x] + new + od[copy][y:]
        elif flag == "kept_same":
            od[copy] = before_root_end(od[copy], b"<" + rp + b'mergeCells count="0"/>')
        elif flag == "views_same":
            od[copy] = before_root_end(od[copy], b"<" + rp + b"sheetViews/>")
        elif flag == "setup_same":
            od[copy] = before_root_end(od[copy], b"<" + rp + b"pageSetup/>")
        elif flag == "dropped_gone":
            od[copy] = before_root_end(od[copy], b"<" + rp + b'tableParts count="0"/>')
        elif flag == "rels_set":
            rel = ('<Relationship Id="rIdPlanted" Type="%s" Target="planted.xml"/>' % LINK_TYPES[0]).encode()
            name = rels_name(copy)
            if name in od:
                od[name] = before_root_end(od[name], rel)
            else:
                od[name] = ('<Relationships xmlns="%s">' % RELS).encode() + rel + b"</Relationships>"
        elif flag == "comments_same":
            if got["carried"] and got["cname"] in od:
                od[got["cname"]] = od[got["cname"]] + COMMENT
            else:
                od[got["cname"]] = b"<x/>"
        elif flag == "notes_placed":
            if got["carried"] and got["vname"] in od:
                m = re.search(rb"(Row>)([0-9]+)(<)", od[got["vname"]])
                if not m:
                    return False
                d = od[got["vname"]]
                od[got["vname"]] = d[:m.start(2)] + str(int(m.group(2)) + 1000).encode() + d[m.end(2):]
            else:
                od[got["vname"]] = b"<xml/>"
        elif flag == "workbook_sheet":
            wb = got["wb"]
            if wb not in od or b'name="emend copy"' not in od[wb]:
                return False
            od[wb] = od[wb].replace(b'name="emend copy"', b'name="emend copz"', 1)
        elif flag == "types_set":
            t = "[Content_Types].xml"
            od[t] = before_root_end(od[t], b'<Override PartName="/planted.xml" ContentType="application/xml"/>')
        elif flag == "rest_same":
            skip = {got["wb"], rels_name(got["wb"]), "[Content_Types].xml", copy, rels_name(copy),
                    got["cname"], got["vname"]}
            for nm in sorted(od):
                if nm not in skip and nm in got["names"]:
                    od[nm] = od[nm] + b" "
                    return True
            return False
        else:
            raise KeyError(flag)
        return True
    
    
    def flags_of(got, zin, od, plant):
        z = got["z"]
        names = got["names"]
        copy, spart = got["copy"], got["spart"]
        sdata = z.read(spart)
        cdata = od.get(copy)
        out = Entries(od)
        f = {}
        built = built_copy(sdata, got["vml_id"], got["strict"])
        f["whole_bytes"] = cdata is not None and built is not None and cdata == built
        f["data_same"] = cdata is not None and named(cdata, "sheetData") == named(sdata, "sheetData") \
            and named(sdata, "sheetData") not in (None, [])
        f["kept_same"] = cdata is not None and all(named(cdata, k) == named(sdata, k) for k in KEPT) \
            and named(cdata, "cols") is not None
        rpx = rels_prefixes(sdata[root_span(sdata)[0]:root_span(sdata)[1]])
        if cdata is not None and named(cdata, "sheetViews") is not None:
            f["views_same"] = named(cdata, "sheetViews") == [without_tab_selected(v) for v in named(sdata, "sheetViews")]
            f["setup_same"] = named(cdata, "pageSetup") == [without_rels_attrs(v, rpx) for v in named(sdata, "pageSetup")]
        else:
            f["views_same"] = f["setup_same"] = False
        gone = False
        if cdata is not None and kids_of(cdata) is not None:
            kids = kids_of(cdata)[0]
            crx = rels_prefixes(cdata[root_span(cdata)[0]:root_span(cdata)[1]])
            lds = [cdata[x:y] for (x, y, n, _) in kids if n == "legacyDrawing"]
            others = [n for (_, _, n, _) in kids if n in DROPPED and n != "legacyDrawing"]
            alts = [e for (_, _, n, e) in kids if n is None and is_alternate(e) and droppable(e)]
            pr = [cdata[x:y] for (x, y, n, _) in kids if n == "sheetPr"]
            ps = [cdata[x:y] for (x, y, n, _) in kids if n == "pageSetup"]
            sv = [cdata[x:y] for (x, y, n, _) in kids if n == "sheetViews"]
            if got["carried"]:
                ld_ok = len(lds) == 1 and any(attr_value(start_tag(lds[0]), p + b":id") == got["vml_id"].encode()
                                              for p in rels_prefixes(cdata[:root_span(cdata)[1]]))
            else:
                ld_ok = not lds
            gone = (ld_ok and not others and not alts
                    and all(attr_value(start_tag(r), b"codeName") is None for r in pr)
                    and all(v == without_tab_selected(v) for v in sv)
                    and all(not rel_attr_names(start_tag(r), crx | rels_prefixes(start_tag(r))) for r in ps))
        f["dropped_gone"] = gone
        want_rels = got["want_rels"]
        have_rels = rel_tuples(out, rels_name(copy))
        f["rels_set"] = have_rels == want_rels if want_rels else have_rels is None
        if got["carried"]:
            src = z.read(got["comments"])
            f["comments_same"] = od.get(got["cname"]) == src
            f["notes_placed"] = got["vname"] in od and notes_of(od[got["vname"]]) == refs_of(src) \
                and len(refs_of(src)) == len(notes_of(od[got["vname"]]))
        else:
            f["comments_same"] = got["cname"] not in od
            f["notes_placed"] = got["vname"] not in od
        sheets_in = got["sheets"]
        wb = got["wb"]
        if wb in od:
            sheets_out, ids_out = sheet_list(out, wb)
            top = max([int(s[1]) for s in sheets_in if s[1] and s[1].isdigit()] + [0])
            want = sheets_in + [(COPY_NAME, str(top + 1), None, copy, got["form"])]
            f["workbook_sheet"] = sheets_out == want and ids_out[:-1] == got["ids"] and ids_out[-1] not in got["ids"]
        else:
            sheets_out = []
            f["workbook_sheet"] = False
        tin = type_tuples(z.read("[Content_Types].xml"))
        tout = type_tuples(od["[Content_Types].xml"]) if "[Content_Types].xml" in od else None
        want_t = [t for t in tin if not (got["drop"] and got["chain"] and t[0] == "Override" and t[1] == "/" + got["chain"])]
        covered = any(t[0] == "Default" and (t[2] or "").lower() == "xml" and t[3] == WORKSHEET_CT for t in tin)
        if not covered:
            want_t.append(("Override", "/" + copy, None, WORKSHEET_CT))
        if got["carried"]:
            want_t.append(("Override", "/" + got["cname"], None, COMMENTS_CT))
            want_t.append(("Override", "/" + got["vname"], None, VML_CT))
        f["types_set"] = tout == want_t
        formulas = got["formulas"] != (plant == "chain_rule")
        drop = formulas and got["chain_in"]
        wrels_out = rels_of(out, wb) if wb in od else []
        chain_out = any(ty in CHAIN_TYPES for (_, ty, _) in wrels_out)
        entry_out = got["chain"] is not None and got["chain"] in od
        entry_in = got["chain"] is not None and got["chain"] in names
        calc_want = formulas or full_calc(z.read(wb))
        f["chain_rule"] = (chain_out == (got["chain_in"] and not drop) and entry_out == (entry_in and not drop)
                           and wb in od and full_calc(od[wb]) == calc_want)
        added = {copy}
        if got["links"] or got["carried"]:
            added.add(rels_name(copy))
        if got["carried"]:
            added |= {got["cname"], got["vname"]}
        gone_names = {got["chain"]} if (got["drop"] and entry_in) else set()
        exempt = {wb, rels_name(wb), "[Content_Types].xml"}
        f["rest_same"] = (set(od) == (set(names) - gone_names) | added
                          and all(od[nm] == z.read(nm) for nm in names if nm in od and nm not in exempt))
        counts = {
            "sheets_in": len(sheets_in), "sheets_out": len(sheets_out),
            "cells_in": main_count(sdata, "c"), "cells_out": main_count(cdata, "c"),
            "comments_in": main_count(z.read(got["comments"]), "comment") if got["carried"] else 0,
            "merges_in": main_count(sdata, "mergeCell"), "merges_out": main_count(cdata, "mergeCell"),
            "links_in": main_count(sdata, "hyperlink"), "links_out": main_count(cdata, "hyperlink"),
            "formulas": 1 if got["formulas"] else 0, "chain_in": 1 if got["chain_in"] else 0,
            "chain_out": 1 if chain_out else 0, "carried": 1 if got["carried"] else 0,
            "links_rel": 1 if got["links"] else 0,
        }
        ctarget = next((t for (_, ty, t) in (rels_of(out, copy) if copy in od else []) if ty in COMMENTS_TYPES and t is not None), None)
        counts["comments_out"] = main_count(od[ctarget], "comment") if ctarget in od else 0
        return f, counts
    
    
    def main():
        args = sys.argv[1:]
        if len(args) < 3 or args[0] not in FLAGS_OF:
            print("error=usage")
            return
        zin = zipfile.ZipFile(args[1])
        got = info(zin)
        if isinstance(got, str):
            print(got)
            return
        if args[2:] == ["--parts"]:
            lines = [got["copy"], rels_name(got["copy"]),
                     got["cname"] if got["carried"] else "-", got["vname"] if got["carried"] else "-",
                     1 if got["links"] else 0, 1 if got["carried"] else 0, 1 if got["formulas"] else 0,
                     1 if got["chain_in"] else 0, got["chain"] or "-", got["wb"], rels_name(got["wb"]),
                     1 if (got["drop"] and got["chain"] in got["names"]) else 0]
            print("\n".join(str(x) for x in lines))
            return
        zout = zipfile.ZipFile(args[2])
        flags = {}
        diff_path, plant, err = options(args[3:], FLAGS_OF["copy"])
        if err:
            print(err)
            return
        od = entries_of(zout)
        planted = None
        if plant is not None:
            planted = plant_out(plant, got, od)
        f, counts = flags_of(got, zin, od, plant)
        flags.update(f)
        vals = values_and_flags(zin, zout, got["names"], zout.namelist(), diff_path, plant, flags)
        keys = ("sheets_in", "sheets_out", "cells_in", "cells_out", "comments_in", "comments_out", "merges_in",
                "merges_out", "links_in", "links_out", "formulas", "chain_in", "chain_out", "carried", "links_rel")
        fields = ["%s=%d" % (k, counts[k]) for k in keys] + counts_of(vals)
        if plant is not None:
            fields.append("planted=%s" % yn(planted))
        if diff_path is None:
            flags.setdefault("xml_values", False)
            flags.setdefault("flagged", False)
        print("\t".join(fields + ["%s=%s" % (k, yn(flags[k])) for k in FLAGS_OF["copy"]]))
    
    
    main()
