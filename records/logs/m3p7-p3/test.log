    #      kind, name, container, cfg, reachable, at_line_start, added,
    #      added_subject) go to <phase>/api/listing.tsv and are printed, one
    #      line per walked file to <phase>/api/files.tsv. Its control: a
    #      fixture crate this log writes (a pub module, a private module with a
    #      re-export and a renamed one, a cfg(test) module, a pub(crate) item, a
    #      doc comment and a string holding pub fn, a method on a type the
    #      crate does not export), its rows equal to the expected rows.
    #  GD. The per-file agreement: each walked file's lines matching
    #      ^[[:space:]]*pub (grep, through count_matches) equal the listing's
    #      rows whose pub token starts its line; a row whose pub follows other
    #      text on its line (none expected) is printed as such. Every .rs file
    #      under the archive is walked or lies under a cfg(test) module, with a
    #      control; every added commit is an ancestor of the phase commit.
    #  GE. T2, the doc build: RUSTDOCFLAGS=-D warnings, every feature, the
    #      crate alone, no dependencies; no warning or error line, with a
    #      control; the documented items counted from <target>/main's
    #      doc/emend/all.html as its item links (href's last path segment's
    #      kind printed beside the total), with a control on a fixture page.
    #  GF. T3, the hygiene step (specs/0029 "MSRV (decision 1)", A): two clones
    #      of <repo> at the phase commit in <scratch>/w, the git environment
    #      unset for every git and the clone's own scripts/check.sh run from
    #      the clone (the gate runs against its own repository). The first
    #      prints PASS hygiene alone, the three pins read beside it by other
    #      forms (the channel line, the workflow's install and --toolchain
    #      words, the workspace's rust-version line), each 1.98.1. The second
    #      has the workspace's rust-version moved to 1.98.0 and staged: exit 1,
    #      the line "FAIL hygiene: " + the step's message (read from the phase
    #      commit's check.sh) + ": 1.98.1 1.98.1 1.98.0", nothing on stderr.
    #  GG. The status patterns name this phase's log directory and planning's
    #      specs/0029, each with a control.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    PHASE_DIR=$(dirname "$SELF_DIR")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$PHASE_DIR/out" || exit 2
    ERR=$PHASE_DIR/out/test.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    C=${1:?phase commit required}
    T=$(mktemp -d)
    trap 'rm -rf "${T:?}"' EXIT INT TERM HUP
    git show "$C:scripts/counting.sh" >"$T/counting.sh" || exit 2
    . "$T/counting.sh"
    
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    KEEP_WAS_SET=$([ -n "${EMEND_KEEP_DIR+x}" ] && echo yes || echo no)
    unset EMEND_KEEP_DIR
    # Changes LL and LM (rulings 8 and 10): the phase's one target root, a
    # subdirectory per source tree; <repo> builds into main.
    BUILD_ROOT=$PHASE_DIR/target
    mkdir -p "$BUILD_ROOT/main" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT/main
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    passed_matches() { [ "$passed" -gt 0 ] && [ "$passed" -eq "$nok" ]; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    not_head() { if head_is "$1"; then return 1; else return 0; fi; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    if full_sha "$C"; then :; else echo "the phase commit must be a full 40-hex sha, not $C" >&2; exit 2; fi
    if head_is "$C"; then :; else echo "HEAD is not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    
    # The entry guard: every change must be this phase's log directory or
    # planning's uncommitted spec (change AG; change GG).
    OURS_RE='^((\?\?| ?[MARCD]) records/logs/m3p7-p3/| M specs/0029-engineering-close[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS_RE" git status --porcelain)
    entry_clean() {
      [ "$entry_all" != error ] && [ "$entry_ours" != error ] &&
        [ "$entry_all" = "$entry_ours" ]
    }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs and planning's uncommitted spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -E -e "s#$MAIN([^-A-Za-z0-9_.]|\$)#<repo>\\1#g" -e "s#$T#<scratch>/w#g" -e "s#$BUILD_ROOT#<target>#g" \
        -e "s#$SELF_DIR#<scripts>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M3 part 7 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # Change AH: every environment input this script reads, on a labelled line.
    echo "input (environment) RERUN_NOTE: $([ -n "${RERUN_NOTE:-}" ] && echo "set; its text is the rerun line below" || echo unset)"
    echo "input (environment) RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input (environment) EMEND_KEEP_DIR, when this script started: $KEEP_WAS_SET (unset for the whole log)"
    echo "input (environment) HOME: $([ -n "${HOME:-}" ] && echo "set; the scrub writes it <home>" || echo unset)"
    echo "input (environment) ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    SHAPE_DIR=$(mktemp -d)
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$SHAPE_DIR/fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$SHAPE_DIR/fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      SHAPE_RESULT_SELF=$n_self
      SHAPE_RESULT_FIX=$n_fix
      check "$shape: this script holds none" "$(yn [ "$SHAPE_RESULT_SELF" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$SHAPE_RESULT_FIX" = 1 ])"
    done
    rm -rf "${SHAPE_DIR:?}"
    
    echo
    echo "## the spec, pinned by the hash of its committed blob (change GB; specs/0018 close-out ruling 4)"
    SPEC=specs/0029-engineering-close.md
    # The hash planning's brief gave for the doc commit's blob, typed (change GB).
    SPEC_GAVE=7005aa500002197c97e9504ed480e58b090d1a9d6e32618fcd144a8b8a7d31cb
    SPEC_SHA=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_HEAD=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum; sha256sum $SPEC (the working tree's copy, printed only)"
    echo "  the phase commit's blob: sha256 $SPEC_HEAD"
    echo "  the hash planning's message gave: $SPEC_GAVE"
    echo "  the working tree's copy, planning's uncommitted rulings if any (change GB), not the pin: sha256 $SPEC_SHA"
    check "the spec at the phase commit is the blob planning's message hashed" "$(yn [ "$SPEC_HEAD" = "$SPEC_GAVE" ])"
    spec_ctl() { if [ "$(git show "$C:specs/0028-images-and-comments-second-half.md" | sha256sum | cut -d' ' -f1)" = "$SPEC_GAVE" ]; then return 1; else return 0; fi; }
    check "control: the same comparison refuses another spec's blob (specs/0028 at the phase commit)" "$(yn spec_ctl)"
    
    echo
    echo "## the phase's commits by role, read from git"
    check_fn() { local label=$1; shift; check "$label" "$(yn "$@")"; }
    by_subject() { git log --format='%H' -n 1 -F --grep="$1" "$C"; }
    REC=$(by_subject 'M3 part 7 P2 record: logs, the independent check')
    DOC1=$(by_subject "M3 part 7 P3: commit planning docs (the P2 verification and rulings, the specs/0028 amendment)")
    RULES=$(by_subject "M3 part 7 P3: specs/0001 rule for the toolchain pin's policy")
    CODE1=$(by_subject "M3 part 7 P3: rust-version equal to the pin, and the gate checks the pins agree")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject> <phase commit>, for each role"
    echo "  P2's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  the rules commit (specs/0001's toolchain-pin bullet): ${RULES:-none}"
    echo "  the code commit (rust-version and the pins check, the phase commit): ${CODE1:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~3"
    for k in 0 1 2 3; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r
      for r in "$REC" "$DOC1" "$RULES" "$CODE1"; do
        [ -n "$r" ] || return 1
      done
      [ "$CODE1" = "$C" ] || return 1
      [ "$(git rev-parse "$C~1")" = "$RULES" ] || return 1
      [ "$(git rev-parse "$C~2")" = "$DOC1" ] || return 1
      [ "$(git rev-parse "$C~3")" = "$REC" ]
    }
    check_fn "the code commit, the rules commit, the doc commit and P2's record commit, each the next one's parent, the code commit the phase commit (change GA)" roles_in_order
    roles_ctl1() { local DOC1=$RULES; if roles_in_order; then return 1; else return 0; fi; }
    check_fn "control: roles_in_order refuses the rules commit named as the doc commit" roles_ctl1
    git log --format='%s' "$REC..$C" >"$T/subjects"
    PREFIX_RE='^M3 part 7 P3: '
    nsub=$(count_lines "$T/subjects")
    nprefix=$(count_matches -E "$PREFIX_RE" "$T/subjects")
    echo "command: git log --format=%s <P2's record commit>..<phase commit>"
    sed 's/^/    /' "$T/subjects"
    echo "  subjects in the range: $nsub; beginning \"M3 part 7 P3: \": $nprefix"
    prefix_all() { [ "$nsub" -ge 1 ] && [ "$nsub" = "$nprefix" ]; }
    check_fn "every commit in the range carries the phase's subject prefix" prefix_all
    printf 'M3 part 7 P3: x\nM3 part 7 P4: y\nM3 part 7: z\n' >"$T/c-subjects"
    check "control: the same count finds one prefixed subject of three" "$(yn [ "$(count_matches -E "$PREFIX_RE" "$T/c-subjects")" = 1 ])"
    no_such_subject() { [ -z "$(by_subject 'M3 part 7 P3: no such subject anywhere')" ]; }
    check_fn "control: a subject no commit has resolves to nothing" no_such_subject
    echo "phase: Milestone 3 part 7 P3 (specs/0029-engineering-close.md) test.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "  the superseded files are kept in <home>/${PHASE_DIR#"$HOME"/}/superseded (change FA)"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this log's one build, the doc build, goes into <target>/main (CARGO_TARGET_DIR; specs/0001, one target root per phase; change GA)"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to (it lies inside <home>, so it is scrubbed first); the listing program reads it by git log -S (read only) and the clones of change GF are made from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/${PHASE_DIR#"$HOME"/}, this phase's directory on the disk; <phase>/api holds the listing's two tables (change GC), <phase>/superseded keeps a superseded attempt's files, <phase>/out holds this script's own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <scripts> stands for <phase>/$(basename "$SELF_DIR"), the directory holding this script"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory, removed at exit: scripts/counting.sh is read at the phase commit into <scratch>/w/counting.sh and sourced from there; <scratch>/w/src the git archive of the phase commit's crates/emend/src; <scratch>/w/py the listing program; <scratch>/w/fx the fixture crate of its control; <scratch>/w/clone-pass and <scratch>/w/clone-moved the two clones of change GF"
    echo "root: <target> stands for <phase>/$(basename "$BUILD_ROOT"), the phase's one target root (specs/0001): <target>/main holds the doc build of <repo>; nothing here cleans it"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      apart "$T" "$PHASE_DIR" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$T" "$BUILD_ROOT" &&
        apart "$MAIN" "$PHASE_DIR" && apart "$MAIN" "$T"
    }
    check "the directory roots other than <home> and <phase>'s own children are distinct, none inside another" "$(yn roots_distinct)"
    roots_ctl() { if apart "$CARGO_TARGET_DIR" "$BUILD_ROOT"; then return 1; else return 0; fi; }
    check "control: apart refuses <target>/main against <target>, which holds it" "$(yn roots_ctl)"
    check "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR; CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS; $(rustc --version)"
    echo "EMEND_KEEP_DIR set when this script started: $KEEP_WAS_SET; unset for the whole log: $([ -n "${EMEND_KEEP_DIR+x}" ] && echo no || echo yes)"
    echo "EMEND_KEEP_DIR: no command of this log sets it (change GA: this log runs no crate test)"
    echo "at entry: status lines $entry_all; of them this phase's logs or planning's uncommitted spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison against the null commit says no" "$(yn not_head "$NULL_SHA")"
    check "control: the same comparison against a short sha of the real commit says no" \
      "$(yn not_head "$(printf '%s' "$C" | cut -c1-7)")"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$T/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    # ynnot: for a condition that must NOT hold (specs/0001: a leading bang
    # inside yn runs a command named by the bang).
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    TAB=$(printf '\t')
    
    echo
    echo "## T1: the pub listing, every pub item of crates/emend reachable from the crate root, by module (specs/0029 \"The API review (decision 3)\" and \"P3\"; changes GC and GD)"
    API_DIR=$PHASE_DIR/api
    mkdir -p "$API_DIR" "$T/src" "$T/py" "$T/fx/src" || fail=1
    cat >"$T/py/api-listing.py" <<'PYEOF'
    """Lists every `pub` item of the crate at <src> (the directory holding
    lib.rs), walking the module tree from lib.rs (specs/0029-engineering-close.md,
    "The API review (decision 3)"). Usage:
    
        python3 -I api-listing.py <src> <rel> <repo> <commit> <rows.tsv> <files.tsv> [--no-added]
    
    <rel> is <src>'s path inside the repository (crates/emend/src); <repo> and
    <commit> are used for one read-only `git log -S` per row (the commit that
    added it). Writes the rows to <rows.tsv> and one line per walked file to
    <files.tsv>; prints nothing on success. --no-added skips the git lookups (the
    added columns read "-"); the test log passes it for its control fixture
    alone.
    
    How it reads the source:
    - Comments, string, raw-string and char literals are blanked to spaces
      (same length, newlines kept), so braces and keywords inside them are not
      read; attribute text is then read back from the original at the same
      offsets, so a cfg's feature names survive.
    - A statement header is the text since the last `{`, `}` or `;` at the same
      level (and, inside a struct or enum, the last top-level `,`): its leading
      attributes are split off, and a header whose declaration starts with
      `pub ` (not `pub(`) is a row. A `{` pushes the header's kind (impl,
      struct, enum, trait, mod, fn, or block for anything else).
    - Modules: `mod x;` and `pub mod x;` at a file's top level, resolved to
      DIR/x.rs or DIR/x/mod.rs (DIR the declaring file's directory for lib.rs,
      else that directory plus the file's stem). A module whose
      attributes hold cfg(test) is not walked (nor anything under it).
    - cfg: every `#[cfg(...)]` on the module chain, the enclosing container and
      the item, `feature = "x"` printed as x, joined with " & "; "-" for none.
    - reachable: a module-level item is reachable when every module on its path
      is `pub mod`, or when a `pub use` in a reachable module re-exports it by
      name (a re-export of a private module's item); a method, associated
      constant or field when its container type is reachable; anything inside a
      function or other block is not.
    - at_line_start: whether the `pub` token is the first non-space text on its
      line, which is what `grep -E '^[[:space:]]*pub '` counts.
    - added: the oldest commit (git log --reverse -S, first line) that changed
      the number of occurrences of the row's declaration text (from `pub`
      through its name) in the row's file, with its subject; a heuristic: a
      name declared twice in one file takes its first declaration's commit, and
      a line moved from another file takes the move's commit."""
    import os
    import re
    import subprocess
    import sys
    
    
    def clean(text):
        out = list(text)
        n = len(text)
        i = 0
    
        def blank(a, b):
            for k in range(a, b):
                if out[k] != "\n":
                    out[k] = " "
    
        def ident(c):
            return c.isalnum() or c == "_"
    
        while i < n:
            c = text[i]
            if text.startswith("//", i):
                j = text.find("\n", i)
                j = n if j < 0 else j
                blank(i, j)
                i = j
            elif text.startswith("/*", i):
                depth, j = 1, i + 2
                while j < n and depth:
                    if text.startswith("/*", j):
                        depth, j = depth + 1, j + 2
                    elif text.startswith("*/", j):
                        depth, j = depth - 1, j + 2
                    else:
                        j += 1
                blank(i, j)
                i = j
            elif c in "rb" and (i == 0 or not ident(text[i - 1])):
                m = re.match(r'(b?r)(#*)"', text[i:])
                if m:
                    close = '"' + m.group(2)
                    j = text.find(close, i + m.end())
                    j = n if j < 0 else j + len(close)
                    blank(i + m.end(), j - len(close))
                    i = j
                else:
                    i += 1
            elif c == '"':
                j = i + 1
                while j < n and text[j] != '"':
                    j += 2 if text[j] == "\\" else 1
                blank(i + 1, j)
                i = j + 1
            elif c == "'":
                m = re.match(r"'(\\(x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]+\}|.)|[^\\'])'", text[i:])
                if m:
                    blank(i + 1, i + m.end() - 1)
                    i += m.end()
                else:
                    i += 1
            else:
                i += 1
        return "".join(out)
    
    
    def split_attrs(cl, orig, a, b):
        """The attributes at the head of cl[a:b] (read from orig) and the offset
        where the declaration starts."""
        attrs = []
        k = a
        while True:
            while k < b and cl[k].isspace():
                k += 1
            if not cl.startswith("#[", k) and not cl.startswith("#![", k):
                return attrs, k
            depth, j = 0, k + 1
            while j < b:
                if cl[j] == "[":
                    depth += 1
                elif cl[j] == "]":
                    depth -= 1
                    if depth == 0:
                        break
                j += 1
            attrs.append(re.sub(r"\s+", " ", orig[k:j + 1]))
            k = j + 1
    
    
    def cfgs_of(attrs):
        out = []
        for a in attrs:
            m = re.match(r"#\[cfg\((.*)\)\]$", a)
            if m:
                out.append(re.sub(r'feature\s*=\s*"([^"]+)"', r"\1", m.group(1)))
        return out
    
    
    def skip_generics(s, k):
        if k < len(s) and s[k] == "<":
            depth = 0
            while k < len(s):
                if s[k] == "<":
                    depth += 1
                elif s[k] == ">" and s[k - 1] != "-":
                    depth -= 1
                    if depth == 0:
                        return k + 1
                k += 1
        return k
    
    
    def impl_type(decl):
        m = re.match(r"(?:unsafe\s+)?impl\b\s*", decl)
        rest = decl[m.end():]
        rest = rest[skip_generics(rest, 0):].strip()
        # the type after a top-level ` for `, else the first path
        depth, k, cut = 0, 0, None
        while k < len(rest):
            if rest[k] == "<":
                depth += 1
            elif rest[k] == ">" and rest[k - 1] != "-":
                depth -= 1
            elif depth == 0 and rest.startswith(" for ", k):
                cut = k + 5
                break
            k += 1
        if cut is not None:
            rest = rest[cut:].strip()
        m = re.match(r"&?\s*(?:dyn\s+)?([A-Za-z_][\w:]*)", rest)
        return m.group(1).split("::")[-1] if m else "?"
    
    
    def classify(decl):
        d = re.sub(r"^(pub(\([^)]*\))?\s+)", "", decl.strip())
        d = re.sub(r"^((const|async|unsafe|default|extern\s*\"[^\"]*\"|extern)\s+)*", "", d)
        if re.match(r"impl\b", d) or re.match(r"unsafe\s+impl\b", decl.strip()):
            return "impl", impl_type(re.sub(r"^pub(\([^)]*\))?\s+", "", decl.strip()))
        for kw in ("struct", "enum", "trait", "mod", "union"):
            m = re.match(kw + r"\s+(\w+)", d)
            if m:
                return kw, m.group(1)
        if re.match(r"fn\s+\w+", d):
            return "fn", re.match(r"fn\s+(\w+)", d).group(1)
        return "block", None
    
    
    def item_of(decl, context):
        """(kind, name) for a declaration starting with `pub `."""
        d = decl[4:].lstrip()
        q = re.match(r"((const|async|unsafe|extern\s*\"[^\"]*\"|extern)\s+)*", d)
        d2 = d[q.end():]
        m = re.match(r"fn\s+(\w+)", d2)
        if m:
            return ("method" if context == "impl" else "fn"), m.group(1)
        m = re.match(r"(struct|enum|trait|type|union|mod)\s+(\w+)", d)
        if m:
            return m.group(1), m.group(2)
        m = re.match(r"const\s+(\w+)", d)
        if m:
            return ("assoc const" if context == "impl" else "const"), m.group(1)
        m = re.match(r"static\s+(?:mut\s+)?(\w+)", d)
        if m:
            return "static", m.group(1)
        m = re.match(r"use\s+(.*)$", d, re.S)
        if m:
            return "use", re.sub(r"\s+", " ", m.group(1)).strip()
        m = re.match(r"(\w+)\s*:", d)
        if m and context in ("struct", "enum"):
            return "field", m.group(1)
        return "other", re.sub(r"\s+", " ", d)[:40]
    
    
    def parse(orig):
        """Rows (offset, kind, name, container kind, container name, cfgs of the
        item, cfgs of the containers) and module declarations (name, pub, attrs)
        and inline modules."""
        cl = clean(orig)
        rows, mods = [], []
        stack = [("root", None, [])]
        start = 0
        nest = 0  # (, [ and < depth inside a header, for commas in a struct/enum
        i, n = 0, len(cl)
        in_use = 0  # brace depth inside a `use` statement's {...} list
    
        def header(i):
            attrs, k = split_attrs(cl, orig, start, i)
            decl = cl[k:i].strip()
            return attrs, k, decl
    
        while i < n:
            c = cl[i]
            kind = stack[-1][0]
            if c in "([":
                nest += 1
            elif c in ")]":
                nest -= 1
            elif c == "<" and kind in ("struct", "enum"):
                nest += 1
            elif c == ">" and kind in ("struct", "enum") and cl[i - 1] != "-":
                nest -= 1
            if in_use:
                if c == "{":
                    in_use += 1
                elif c == "}":
                    in_use -= 1
                i += 1
                continue
            if c == "{" and re.match(r"(pub(\([^)]*\))?\s+)?use\b", header(i)[2]):
                in_use = 1  # a use list's braces are part of its statement, which ends at `;`
                i += 1
                continue
            boundary = c in "{};" or (c == "," and kind in ("struct", "enum") and nest == 0)
            if c == "{":
                boundary = True  # a brace inside parentheses (a closure body) still opens a frame
            if boundary:
                attrs, k, decl = header(i)
                outer = [x for fr in stack for x in fr[2]]
                if decl.startswith("pub "):
                    ik, iname = item_of(decl, kind)
                    rows.append((k, ik, iname, kind, stack[-1][1], cfgs_of(attrs), outer))
                if c == ";" and kind == "root":
                    m = re.match(r"(pub\s+)?mod\s+(\w+)$", decl)
                    if m:
                        mods.append((m.group(2), bool(m.group(1)), attrs))
                if c == "{":
                    ck, cname = classify(decl)
                    if ck == "mod" and kind == "root":
                        mods.append((cname, decl.startswith("pub "), attrs, "inline"))
                    # the frame keeps the header depth it opened at, restored at its end
                    stack.append((ck, cname, cfgs_of(attrs), attrs, nest))
                    nest = 0
                elif c == "}":
                    if len(stack) > 1:
                        nest = stack.pop()[4]
                start = i + 1
            i += 1
        return cl, rows, mods
    
    
    def line_of(text, off):
        return text.count("\n", 0, off) + 1
    
    
    def main():
        src, rel, repo, commit, rows_path, files_path = sys.argv[1:7]
        modules = {}  # path -> (file, public chain, cfgs)
        queue = [("crate", "lib.rs", True, [])]
        walked, skipped = [], []
        rows = []
        while queue:
            mpath, frel, public, cfgs = queue.pop(0)
            path = os.path.join(src, frel)
            orig = open(path, encoding="utf-8").read()
            cl, frows, mods = parse(orig)
            modules[mpath] = (frel, public, cfgs)
            walked.append(frel)
            base = os.path.dirname(frel)
            if os.path.basename(frel) not in ("lib.rs", "mod.rs"):
                base = os.path.join(base, os.path.splitext(os.path.basename(frel))[0])
            for m in mods:
                name, pub, attrs = m[0], m[1], m[2]
                mcfgs = cfgs_of(attrs)
                if any(x.strip() == "test" for x in mcfgs):
                    skipped.append(os.path.join(base, name))
                    continue
                if len(m) > 3:
                    continue  # an inline module: its rows are in this file's rows
                cand = [os.path.join(base, name + ".rs"), os.path.join(base, name, "mod.rs")]
                found = [c for c in cand if os.path.exists(os.path.join(src, c))]
                if len(found) != 1:
                    sys.exit("module %s::%s: %d files" % (mpath, name, len(found)))
                queue.append((mpath + "::" + name, found[0], public and pub, cfgs + mcfgs))
            for (off, kind, name, ck, cname, own, outer) in frows:
                ln = line_of(orig, off)
                linetext = orig.split("\n")[ln - 1]
                at_start = linetext.lstrip().startswith("pub ") and linetext.index("pub ") == len(linetext) - len(linetext.lstrip())
                rows.append(dict(module=mpath, file=frel, line=ln, kind=kind, name=name, ck=ck,
                                 container=cname or "-", cfg=cfgs + outer + own, at_start=at_start,
                                 text=orig[off:off + 300]))
        # re-exports from pub use rows in public modules
        reexp = {}
        for r in rows:
            if r["kind"] != "use" or not modules[r["module"]][1] or r["ck"] != "root":
                continue
            spec = r["name"].rstrip(";").strip()
            m = re.match(r"([\w:]*?)::\{(.*)\}$", spec, re.S)
            items = [(m.group(1), x.strip()) for x in m.group(2).split(",") if x.strip()] if m else \
                [(spec.rsplit("::", 1)[0], spec.rsplit("::", 1)[1])] if "::" in spec else []
            for prefix, item in items:
                parts = [p for p in prefix.split("::") if p and p != "self"]
                if parts and parts[0] == "crate":
                    target_mod = "crate::" + "::".join(parts[1:]) if parts[1:] else "crate"
                else:
                    target_mod = r["module"] + ("::" + "::".join(parts) if parts else "")
                nm = item.split(" as ")[0].strip()
                alias = item.split(" as ")[-1].strip()
                reexp[(target_mod.rstrip(":"), nm)] = "%s::%s" % (r["module"], alias)
        types = {}
        for r in rows:
            if r["kind"] in ("struct", "enum", "trait", "type", "union") and r["ck"] == "root":
                public = modules[r["module"]][1]
                ok = public or (r["module"], r["name"]) in reexp
                types.setdefault(r["name"], []).append(ok)
        for r in rows:
            public = modules[r["module"]][1]
            if r["ck"] in ("fn", "block"):
                r["reach"] = "no (inside a function or block)"
            elif r["ck"] in ("root", "mod"):
                if public:
                    r["reach"] = "yes"
                elif (r["module"], r["name"]) in reexp:
                    r["reach"] = "yes (re-exported as %s)" % reexp[(r["module"], r["name"])]
                else:
                    r["reach"] = "no (private module, not re-exported)"
            else:
                t = types.get(r["container"])
                if t and any(t):
                    r["reach"] = "yes"
                elif t:
                    r["reach"] = "no (its type is not reachable)"
                else:
                    r["reach"] = "no (its type is not a pub type of the crate)"
        for r in rows:
            if r["kind"] == "use":
                decl = r["text"].split("\n")[0].strip()
            else:
                m = re.match(r"pub\s+(?:(?:const|async|unsafe|static|mut|struct|enum|trait|type|union|mod|fn|use)\s+)*" + re.escape(r["name"]) if r["kind"] != "other" else r"pub\s+\S+", r["text"])
                decl = m.group(0) if m else r["text"].split("\n")[0].strip()
            if "--no-added" in sys.argv[7:]:
                r["added"], r["subject"] = "-", "-"
                continue
            p = subprocess.run(["git", "-C", repo, "log", "--reverse", "--format=%h%x09%s", "-S" + decl, commit,
                                "--", rel + "/" + r["file"]], capture_output=True, text=True)
            first = p.stdout.split("\n")[0] if p.returncode == 0 and p.stdout else "-\t-"
            r["added"], r["subject"] = (first.split("\t", 1) + ["-"])[:2]
        with open(rows_path, "w") as f:
            f.write("module\tfile\tline\tkind\tname\tcontainer\tcfg\treachable\tat_line_start\tadded\tadded_subject\n")
            for r in rows:
                f.write("\t".join([r["module"], rel + "/" + r["file"], str(r["line"]), r["kind"], r["name"],
                                   r["container"], " & ".join(r["cfg"]) or "-", r["reach"],
                                   "yes" if r["at_start"] else "no", r["added"], r["subject"]]) + "\n")
        with open(files_path, "w") as f:
            f.write("file\tmodule\trows\trows_at_line_start\trows_reachable\n")
            for frel in walked:
                rs = [r for r in rows if r["file"] == frel]
                mp = [m for m, v in modules.items() if v[0] == frel][0]
                f.write("%s\t%s\t%d\t%d\t%d\n" % (rel + "/" + frel, mp, len(rs), sum(r["at_start"] for r in rs),
                                                  sum(r["reach"].startswith("yes") for r in rs)))
            for s in skipped:
                f.write("%s\tcfg(test), not walked\t-\t-\t-\n" % (rel + "/" + s))
    
    
    main()
    PYEOF
    echo "command: the listing program, written by this script to <scratch>/w/py/api-listing.py (change GC); sha256sum, then its text:"
    echo "    $(sha256sum <"$T/py/api-listing.py" | cut -d' ' -f1)"
    sed 's/^/      /' "$T/py/api-listing.py"
    echo "command: python3 -I -m py_compile is not run: python3 -I runs it below, and a syntax error stops it with an exit the checks read"
    echo "command: git archive <phase commit> crates/emend/src | tar -x -C <scratch>/w/src"
    git archive "$C" crates/emend/src | tar -x -C "$T/src"
    arch_rc=$?
    n_arch=$(find "$T/src/crates/emend/src" -type f -name '*.rs' | count_lines /dev/stdin)
    n_tree=$(git ls-tree -r --name-only "$C" crates/emend/src | count_matches -E '[.]rs$' /dev/stdin)
    echo "  archive exit: $arch_rc; .rs files extracted: $n_arch; .rs files under crates/emend/src in the phase commit's tree: $n_tree"
    arch_ok() { [ "$arch_rc" = 0 ] && [ "$n_arch" -ge 1 ] && [ "$n_arch" = "$n_tree" ]; }
    check "the archive holds every .rs file of the phase commit's crates/emend/src" "$(yn arch_ok)"
    arch_ctl() { local n_tree=$((n_tree + 1)); arch_ok; }
    check "control: the same comparison refuses a tree count one more than the archive's" "$(ynnot arch_ctl)"
    
    echo "### the program's control: a fixture crate this log writes (change GC)"
    printf '%s\n' 'pub mod a;' 'mod b;' '#[cfg(test)]' 'mod tests;' 'pub use b::{X, Y as Z};' '/// pub fn not_this()' 'pub(crate) fn hidden() {}' >"$T/fx/src/lib.rs"
    printf '%s\n' 'pub struct P {' '    pub f: u8,' '    g: u8,' '}' 'impl P { pub fn m(&self) { let _s = "{ pub fn fake"; } }' '#[cfg(feature = "q")]' 'pub const C: u8 = 1;' >"$T/fx/src/a.rs"
    printf '%s\n' 'pub struct X;' 'pub struct W;' 'pub enum Y {' '    V,' '}' 'impl W {' '    pub fn n() {}' '}' >"$T/fx/src/b.rs"
    printf '%s\n' 'pub fn t() {}' >"$T/fx/src/tests.rs"
    for f in lib.rs a.rs b.rs tests.rs; do
      echo "  <scratch>/w/fx/src/$f:"
      sed 's/^/      /' "$T/fx/src/$f"
    done
    echo "command: python3 -I <scratch>/w/py/api-listing.py <scratch>/w/fx/src fx <repo> <phase commit> <scratch>/w/fx/rows.tsv <scratch>/w/fx/files.tsv --no-added"
    python3 -I "$T/py/api-listing.py" "$T/fx/src" fx "$MAIN" "$C" "$T/fx/rows.tsv" "$T/fx/files.tsv" --no-added >"$T/fx/out" 2>"$T/fx/err"
    fx_rc=$?
    echo "  exit: $fx_rc; standard output $(wc -c <"$T/fx/out") bytes; standard error $(wc -c <"$T/fx/err") bytes; its rows, columns 2 to 8, tabs shown as |:"
    cut -f2-8 "$T/fx/rows.tsv" | tr '\t' '|' | sed 's/^/    /'
    echo "  its files table, tabs shown as |:"
    tr '\t' '|' <"$T/fx/files.tsv" | sed 's/^/    /'
    exp_line() { local IFS=$TAB; printf '%s\n' "$*"; }
    {
      exp_line file line kind name container cfg reachable
      exp_line fx/lib.rs 1 mod a - - yes
      exp_line fx/lib.rs 5 use 'b::{X, Y as Z}' - - yes
      exp_line fx/a.rs 1 struct P - - yes
      exp_line fx/a.rs 2 field f P - yes
      exp_line fx/a.rs 5 method m P - yes
      exp_line fx/a.rs 7 const C - q yes
      exp_line fx/b.rs 1 struct X - - 'yes (re-exported as crate::X)'
      exp_line fx/b.rs 2 struct W - - 'no (private module, not re-exported)'
      exp_line fx/b.rs 3 enum Y - - 'yes (re-exported as crate::Z)'
      exp_line fx/b.rs 7 method n W - 'no (its type is not reachable)'
    } >"$T/fx/expected-rows"
    {
      exp_line file module rows rows_at_line_start rows_reachable
      exp_line fx/lib.rs crate 2 2 2
      exp_line fx/a.rs crate::a 4 3 4
      exp_line fx/b.rs crate::b 4 4 2
      exp_line fx/tests 'cfg(test), not walked' - - -
    } >"$T/fx/expected-files"
    cut -f2-8 "$T/fx/rows.tsv" >"$T/fx/got-rows"
    fx_ran() { [ "$fx_rc" = 0 ] && [ ! -s "$T/fx/out" ] && [ ! -s "$T/fx/err" ]; }
    check "control: the program exits 0 on the fixture crate and prints nothing" "$(yn fx_ran)"
    check "control: the fixture's rows are the expected ones: the private module's items by their re-exports, the renamed one by its new name, the unexported type and its method not reachable, the pub(crate) item, the doc comment, the string and the cfg(test) module left out, the cfg's feature read" "$(yn cmp -s "$T/fx/got-rows" "$T/fx/expected-rows")"
    check "control: the fixture's files table is the expected one, a.rs's method after other text on its line counted as a row not at line start" "$(yn cmp -s "$T/fx/files.tsv" "$T/fx/expected-files")"
    cp "$T/fx/expected-rows" "$T/fx/c-rows"; printf 'x\n' >>"$T/fx/c-rows"
    check "control: the same comparison refuses the expected rows with one line more" "$(ynnot cmp -s "$T/fx/got-rows" "$T/fx/c-rows")"
    PUB_RE='^[[:space:]]*pub '
    n_fx_a=$(count_matches -E "$PUB_RE" "$T/fx/src/a.rs")
    n_fx_lib=$(count_matches -E "$PUB_RE" "$T/fx/src/lib.rs")
    echo "  command: count_matches -E '$PUB_RE' over the fixture's a.rs and lib.rs: $n_fx_a and $n_fx_lib"
    check "control: the grep form counts a.rs's three line-start pub lines, not the method after other text, nor pub(crate), the doc comment or the string" "$(yn [ "$n_fx_a" = 3 ])"
    check "control: the grep form counts lib.rs's two pub lines, not its pub(crate) line or its doc comment" "$(yn [ "$n_fx_lib" = 2 ])"
    
    echo "### the listing of the phase commit's crate (change GC)"
    echo "command: python3 -I <scratch>/w/py/api-listing.py <scratch>/w/src/crates/emend/src crates/emend/src <repo> <phase commit> <phase>/api/listing.tsv <phase>/api/files.tsv"
    python3 -I "$T/py/api-listing.py" "$T/src/crates/emend/src" crates/emend/src "$MAIN" "$C" "$API_DIR/listing.tsv" "$API_DIR/files.tsv" >"$T/listing.out" 2>"$T/listing.err"
    lst_rc=$?
    echo "  exit: $lst_rc; standard output $(wc -c <"$T/listing.out") bytes; standard error $(wc -c <"$T/listing.err") bytes"
    listing_ran() { [ "$lst_rc" = 0 ] && [ ! -s "$T/listing.out" ] && [ ! -s "$T/listing.err" ]; }
    check "the listing program exits 0 and prints nothing" "$(yn listing_ran)"
    echo "  command: sha256sum <phase>/api/listing.tsv <phase>/api/files.tsv"
    echo "    $(sha256sum <"$API_DIR/listing.tsv" | cut -d' ' -f1)  listing.tsv"
    echo "    $(sha256sum <"$API_DIR/files.tsv" | cut -d' ' -f1)  files.tsv"
    echo "  the files table, tabs shown as |:"
    tr '\t' '|' <"$API_DIR/files.tsv" | sed 's/^/    /'
    echo "  the listing, tabs shown as |:"
    tr '\t' '|' <"$API_DIR/listing.tsv" | sed 's/^/    /'
    
    echo "### each walked file's pub lines by grep beside the listing's rows (change GD)"
    echo "command: count_matches -E '$PUB_RE' <scratch>/w/src/<file>, for every walked file"
    pub_bad=0 nfiles=0 rows_sum=0
    while IFS=$TAB read -r f mod rows atstart reach; do
      [ "$f" = file ] && continue
      case "$rows" in -) continue ;; esac
      nfiles=$((nfiles + 1))
      rows_sum=$((rows_sum + rows))
      ng=$(count_matches -E "$PUB_RE" "$T/src/$f")
      echo "    $f ($mod): grep $ng; rows $rows; rows at line start $atstart; reachable $reach"
      if [ "$ng" != "$atstart" ]; then pub_bad=$((pub_bad + 1)); fi
      if [ "$rows" != "$atstart" ]; then
        echo "      rows whose pub follows other text on its line, which the grep form does not count: $((rows - atstart))"
      fi
    done <"$API_DIR/files.tsv"
    n_rows=$(($(count_lines "$API_DIR/listing.tsv") - 1))
    echo "  walked files: $nfiles; rows by the files table: $rows_sum; rows in the listing: $n_rows; files whose grep count differs from their rows at line start: $pub_bad"
    pub_agree() { [ "$nfiles" -ge 1 ] && [ "$pub_bad" = 0 ]; }
    check "every walked file's pub lines by grep equal the listing's rows at line start" "$(yn pub_agree)"
    rows_agree() { [ "$n_rows" -ge 1 ] && [ "$n_rows" = "$rows_sum" ]; }
    check "the listing's rows are the files table's rows, summed" "$(yn rows_agree)"
    pub_ctl() { local pub_bad=1; pub_agree; }
    check "control: the same check refuses one file differing" "$(ynnot pub_ctl)"
    find "$T/src/crates/emend/src" -type f -name '*.rs' | sed "s#^$T/src/##" | sort >"$T/all-rs"
    awk -F"$TAB" 'NR > 1 && $3 != "-" { print $1 }' "$API_DIR/files.tsv" | sort >"$T/walked"
    awk -F"$TAB" 'NR > 1 && $2 ~ /^cfg\(test\)/ { print $1 }' "$API_DIR/files.tsv" | sort >"$T/skipped"
    # unaccounted <file list>: the .rs files neither walked nor under a skipped
    # cfg(test) module (its file, or a path under its directory).
    unaccounted() {
      awk -v W="$T/walked" -v S="$T/skipped" 'BEGIN { while ((getline l < W) > 0) w[l] = 1; ns = 0; while ((getline l < S) > 0) s[++ns] = l }
        { if ($0 in w) next; ok = 0; for (i = 1; i <= ns; i++) if ($0 == s[i] ".rs" || index($0, s[i] "/") == 1) ok = 1; if (!ok) print }' "$1"
    }
    unaccounted "$T/all-rs" >"$T/unaccounted"
    n_all=$(count_lines "$T/all-rs")
    n_walked=$(count_lines "$T/walked")
    n_skipped=$(count_lines "$T/skipped")
    n_un=$(count_lines "$T/unaccounted")
    echo "  .rs files in the archive: $n_all; walked: $n_walked; cfg(test) modules not walked: $n_skipped; files neither walked nor under one: $n_un"
    sed 's/^/    unaccounted: /' "$T/unaccounted"
    check "every .rs file is walked or lies under a cfg(test) module" "$(yn [ "$n_un" = 0 ])"
    cp "$T/all-rs" "$T/c-all-rs"; printf 'crates/emend/src/extra.rs\n' >>"$T/c-all-rs"
    check "control: the same form finds one planted file neither walked nor under a test module" "$(yn [ "$(unaccounted "$T/c-all-rs" | count_lines /dev/stdin)" = 1 ])"
    echo "  rows by kind:"
    awk -F"$TAB" 'NR > 1 { print $4 }' "$API_DIR/listing.tsv" | sort | uniq -c | sed 's/^/    /'
    echo "  rows by reachable:"
    awk -F"$TAB" 'NR > 1 { r = $8; sub(/ \(.*/, "", r); print r }' "$API_DIR/listing.tsv" | sort | uniq -c | sed 's/^/    /'
    awk -F"$TAB" 'NR > 1 { print $10 }' "$API_DIR/listing.tsv" | sort -u >"$T/added"
    n_added=$(count_lines "$T/added")
    n_dash=$(awk -F"$TAB" 'NR > 1 && $10 == "-"' "$API_DIR/listing.tsv" | count_lines /dev/stdin)
    not_anc=0
    while read -r h; do
      [ "$h" = - ] && continue
      git merge-base --is-ancestor "$h" "$C" 2>/dev/null || not_anc=$((not_anc + 1))
    done <"$T/added"
    echo "  distinct added commits: $n_added; rows with no added commit (-): $n_dash; added commits not ancestors of the phase commit: $not_anc"
    check "every added commit is an ancestor of the phase commit" "$(yn [ "$not_anc" = 0 ])"
    anc_ctl() { git merge-base --is-ancestor 0000000000000000000000000000000000000000 "$C" 2>/dev/null; }
    check "control: the same test refuses the null commit" "$(ynnot anc_ctl)"
    
    echo
    echo "## T2: the doc build with every feature and no warning, and the documented items it indexes (specs/0029 \"The API review (decision 3)\"; change GE)"
    echo "command: RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR=<target>/main cargo doc --offline -p emend --no-deps --all-features"
    RUSTDOCFLAGS='-D warnings' cargo doc --offline -p emend --no-deps --all-features >"$T/doc.out" 2>&1 </dev/null
    doc_rc=$?
    echo "  exit: $doc_rc; its output:"
    sed 's/^/    /' "$T/doc.out"
    check "the doc build exits 0" "$(yn [ "$doc_rc" = 0 ])"
    WARN_RE='^(warning|error)'
    nwarn=$(count_matches -E "$WARN_RE" "$T/doc.out")
    check "no warning or error line in its output: $nwarn" "$(yn [ "$nwarn" = 0 ])"
    printf 'warning: x\n   Finished\nerror: y\n' >"$T/c-doc"
    check "control: the same form counts two such lines in a fixture" "$(yn [ "$(count_matches -E "$WARN_RE" "$T/c-doc")" = 2 ])"
    ALL_HTML=$CARGO_TARGET_DIR/doc/emend/all.html
    ITEM_RE='<li><a href="[^"]+"'
    # item_links <html>: one line per item link of a rustdoc all-items page.
    item_links() { LC_ALL=C "$G" -o -E "$ITEM_RE" "$1"; }
    item_links "$ALL_HTML" >"$T/all-items" 2>/dev/null
    n_items=$(count_lines "$T/all-items")
    echo "command: grep -o -E '$ITEM_RE' <target>/main/doc/emend/all.html | count_lines"
    echo "  documented items in the index: $n_items; by kind (the link's last path segment up to its first dot):"
    sed -E 's#^<li><a href="([^"]*/)?([A-Za-z_]+)[.].*#\2#' "$T/all-items" | sort | uniq -c | sed 's/^/    /'
    check "the index lists at least one documented item" "$(yn [ "$n_items" -ge 1 ])"
    printf '<h3>Structs</h3><ul class="all-items"><li><a href="a/struct.A.html">a::A</a></li><li><a href="struct.B.html">B</a></li></ul><h3>Functions</h3><ul class="all-items"><li><a href="fn.f.html">f</a></li></ul>\n' >"$T/c-all.html"
    check "control: the same form finds three item links on one line of a fixture page" "$(yn [ "$(item_links "$T/c-all.html" | count_lines /dev/stdin)" = 3 ])"
    n_top=$(awk -F"$TAB" 'NR > 1 && $8 ~ /^yes/ && ($4 == "struct" || $4 == "enum" || $4 == "fn" || $4 == "const" || $4 == "type" || $4 == "trait" || $4 == "static")' "$API_DIR/listing.tsv" | count_lines /dev/stdin)
    echo "  for comparison, not asserted: the listing's reachable module-level types, functions, constants, statics and aliases: $n_top (the index lists each item once, at its documented path; methods and fields are on their type's page)"
    
    echo
    echo "## T3: the hygiene step in clones of the phase commit, passing, and refusing a moved rust-version (specs/0029 \"MSRV (decision 1)\"; change GF)"
    G0=(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_COMMON_DIR)
    # make_clone <dir>: a clone of <repo> at the phase commit, detached.
    make_clone() { "${G0[@]}" git clone -q "$MAIN" "$1" >/dev/null 2>&1 && "${G0[@]}" git -C "$1" checkout -q "$C" >/dev/null 2>&1; }
    # clone_at <dir>: whether the clone's HEAD is the phase commit and its check.sh the phase commit's blob.
    clone_at() {
      [ "$("${G0[@]}" git -C "$1" rev-parse HEAD 2>/dev/null)" = "$C" ] &&
        git show "$C:scripts/check.sh" | cmp -s - "$1/scripts/check.sh"
    }
    PIN_MSG=$(git show "$C:scripts/check.sh" | LC_ALL=C "$G" -o -E 'the toolchain pins disagree [(][^)]*[)]')
    n_pin_msg=$(printf '%s\n' "$PIN_MSG" | count_matches -F 'the toolchain pins disagree' /dev/stdin)
    echo "command: git show <phase commit>:scripts/check.sh | grep -o -E 'the toolchain pins disagree [(][^)]*[)]'"
    echo "  the step's message: $PIN_MSG"
    check "the step's message is read once from the phase commit's check.sh" "$(yn [ "$n_pin_msg" = 1 ])"
    CP=$T/clone-pass
    echo "command: env -u GIT_DIR ... git clone -q <repo> <scratch>/w/clone-pass; git -C <scratch>/w/clone-pass checkout -q <phase commit>"
    make_clone "$CP"
    check "the clone is at the phase commit and holds its check.sh" "$(yn clone_at "$CP")"
    clone_ctl() { clone_at "$T/fx"; }
    check "control: the same check refuses a directory that is no clone (<scratch>/w/fx)" "$(ynnot clone_ctl)"
    echo "command: (cd <scratch>/w/clone-pass && env -u GIT_DIR ... bash scripts/check.sh --only hygiene)"
    (cd "$CP" && "${G0[@]}" bash scripts/check.sh --only hygiene) >"$T/hyg-pass.out" 2>"$T/hyg-pass.err"
    hp_rc=$?
    echo "  exit: $hp_rc; standard error $(wc -c <"$T/hyg-pass.err") bytes; standard output:"
    sed 's/^/    /' "$T/hyg-pass.out"
    hyg_pass() { [ "$hp_rc" = 0 ] && [ "$(cat "$T/hyg-pass.out")" = "PASS hygiene" ] && [ ! -s "$T/hyg-pass.err" ]; }
    check "the hygiene step passes in the clone, printing PASS hygiene alone" "$(yn hyg_pass)"
    chan=$(awk -F'"' '/^channel = /{ print $2 }' "$CP/rust-toolchain.toml")
    ci=$(LC_ALL=C "$G" -o -E '(toolchain install|--toolchain) [^ ]+' "$CP/.github/workflows/ci.yml" | awk '{ print $NF }' | sort -u | paste -sd' ')
    ws=$(awk -F'"' '/^rust-version = /{ print $2 }' "$CP/Cargo.toml")
    echo "command: the pins read by other forms in the clone: awk the channel line of rust-toolchain.toml; grep -o the install and --toolchain words of .github/workflows/ci.yml, sorted unique; awk the rust-version line of Cargo.toml"
    echo "  rust-toolchain.toml channel: $chan; the CI workflow's: $ci; the workspace's rust-version: $ws"
    pins_read() { [ "$chan" = 1.98.1 ] && [ "$ci" = 1.98.1 ] && [ "$ws" = 1.98.1 ]; }
    check "the three pins read by other forms are each 1.98.1" "$(yn pins_read)"
    pins_ctl() { local ws=1.98.0; pins_read; }
    check "control: the same check refuses a workspace reading of 1.98.0" "$(ynnot pins_ctl)"
    CM=$T/clone-moved
    echo "command: a second clone, <scratch>/w/clone-moved, at the phase commit; its Cargo.toml's rust-version line moved to 1.98.0 by sed and staged"
    make_clone "$CM"
    check "the second clone is at the phase commit and holds its check.sh" "$(yn clone_at "$CM")"
    sed -i 's/^rust-version = "1[.]98[.]1"$/rust-version = "1.98.0"/' "$CM/Cargo.toml"
    "${G0[@]}" git -C "$CM" add Cargo.toml
    moved_stat=$("${G0[@]}" git -C "$CM" diff --cached --numstat | tr '\t' ' ')
    echo "  git diff --cached --numstat in the second clone: $moved_stat"
    check "the plant changed one line of Cargo.toml and nothing else" "$(yn [ "$moved_stat" = "1 1 Cargo.toml" ])"
    echo "command: (cd <scratch>/w/clone-moved && env -u GIT_DIR ... bash scripts/check.sh --only hygiene)"
    (cd "$CM" && "${G0[@]}" bash scripts/check.sh --only hygiene) >"$T/hyg-moved.out" 2>"$T/hyg-moved.err"
    hm_rc=$?
    echo "  exit: $hm_rc; standard error $(wc -c <"$T/hyg-moved.err") bytes; standard output:"
    sed 's/^/    /' "$T/hyg-moved.out"
    WANT_MOVED="FAIL hygiene: $PIN_MSG: 1.98.1 1.98.1 1.98.0"
    echo "  the line expected: $WANT_MOVED"
    hyg_moved() { [ "$hm_rc" = 1 ] && [ "$(cat "$T/hyg-moved.out")" = "$WANT_MOVED" ] && [ ! -s "$T/hyg-moved.err" ]; }
    check "the hygiene step refuses the moved rust-version: exit 1, the step's message and the three readings, nothing on stderr" "$(yn hyg_moved)"
    moved_ctl() { local WANT_MOVED="FAIL hygiene: $PIN_MSG: 1.98.1 1.98.1 1.98.1"; hyg_moved; }
    check "control: the same check refuses the line with the readings unmoved" "$(ynnot moved_ctl)"
    echo
    echo "## status after the runs"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS_RE" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or planning's uncommitted spec: $st_ours"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]
    }
    check "every change in the working tree is one of this phase's logs or planning's uncommitted spec" "$(yn status_accounted)"
    printf '?? records/logs/m3p7-p3/test.log\n M scripts/check.sh\n?? records/logs/m3p7-p2/test.log\n?? records/m3p7-p3-x.md\n M specs/0028-images-and-comments-second-half.md\n M specs/0029-engineering-close.md\n' >"$T/c-status"
    check "control: the same pattern finds two of six status lines, this phase's log and planning's spec (change GG)" "$(yn [ "$(count_matches -E "$OURS_RE" "$T/c-status")" = 2 ])"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$T/c-err"; printf 'x' >>"$T/c-err"
    nerr_ctl=$(wc -c <"$T/c-err")
    echo "  command: wc -c <phase>/out/test.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
