## T1: the pub listing, every pub item of crates/emend reachable from the crate root, by module (specs/0029 "The API review (decision 3)" and "P3"; changes GC and GD)
command: the listing program, written by this script to <scratch>/w/py/api-listing.py (change GC); sha256sum, then its text:
    59f4043c3014a64e671054fcfd4dce565e210426d4d4847ae448cb29b48b987c
      """Lists every `pub` item of the crate at <src> (the directory holding
      lib.rs), walking the module tree from lib.rs (specs/0029-engineering-close.md,
      "The API review (decision 3)"). Usage:
      
          python3 -I api-listing.py <src> <rel> <repo> <commit> <rows.tsv> <files.tsv> [--no-added]
      
      <rel> is <src>'s path inside the repository (crates/emend/src); <repo> and
      <commit> are used for one read-only `git log -S` per row (the commit that
      added it). Writes the rows to <rows.tsv> and one line per walked file to
      <files.tsv>; prints nothing on success. --no-added skips the git lookups (the
      added columns read "-"); the test log passes it for its control fixture
      alone.
      
      How it reads the source:
      - Comments, string, raw-string and char literals are blanked to spaces
        (same length, newlines kept), so braces and keywords inside them are not
        read; attribute text is then read back from the original at the same
        offsets, so a cfg's feature names survive.
      - A statement header is the text since the last `{`, `}` or `;` at the same
        level (and, inside a struct or enum, the last top-level `,`): its leading
        attributes are split off, and a header whose declaration starts with
        `pub ` (not `pub(`) is a row. A `{` pushes the header's kind (impl,
        struct, enum, trait, mod, fn, or block for anything else).
      - Modules: `mod x;` and `pub mod x;` at a file's top level, resolved to
        DIR/x.rs or DIR/x/mod.rs (DIR the declaring file's directory for lib.rs,
        else that directory plus the file's stem). A module whose
        attributes hold cfg(test) is not walked (nor anything under it).
      - cfg: every `#[cfg(...)]` on the module chain, the enclosing container and
        the item, `feature = "x"` printed as x, joined with " & "; "-" for none.
      - reachable: a module-level item is reachable when every module on its path
        is `pub mod`, or when a `pub use` in a reachable module re-exports it by
        name (a re-export of a private module's item); a method, associated
        constant or field when its container type is reachable; anything inside a
        function or other block is not.
      - at_line_start: whether the `pub` token is the first non-space text on its
        line, which is what `grep -E '^[[:space:]]*pub '` counts.
      - added: the oldest commit (git log --reverse -S, first line) that changed
        the number of occurrences of the row's declaration text (from `pub`
        through its name) in the row's file, with its subject; a heuristic: a
        name declared twice in one file takes its first declaration's commit, and
        a line moved from another file takes the move's commit."""
      import os
      import re
      import subprocess
      import sys
      
      
      def clean(text):
          out = list(text)
          n = len(text)
          i = 0
      
          def blank(a, b):
              for k in range(a, b):
                  if out[k] != "\n":
                      out[k] = " "
      
          def ident(c):
              return c.isalnum() or c == "_"
      
          while i < n:
              c = text[i]
              if text.startswith("//", i):
                  j = text.find("\n", i)
                  j = n if j < 0 else j
                  blank(i, j)
                  i = j
              elif text.startswith("/*", i):
                  depth, j = 1, i + 2
                  while j < n and depth:
                      if text.startswith("/*", j):
                          depth, j = depth + 1, j + 2
                      elif text.startswith("*/", j):
                          depth, j = depth - 1, j + 2
                      else:
                          j += 1
                  blank(i, j)
                  i = j
              elif c in "rb" and (i == 0 or not ident(text[i - 1])):
                  m = re.match(r'(b?r)(#*)"', text[i:])
                  if m:
                      close = '"' + m.group(2)
                      j = text.find(close, i + m.end())
                      j = n if j < 0 else j + len(close)
                      blank(i + m.end(), j - len(close))
                      i = j
                  else:
                      i += 1
              elif c == '"':
                  j = i + 1
                  while j < n and text[j] != '"':
                      j += 2 if text[j] == "\\" else 1
                  blank(i + 1, j)
                  i = j + 1
              elif c == "'":
                  m = re.match(r"'(\\(x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]+\}|.)|[^\\'])'", text[i:])
                  if m:
                      blank(i + 1, i + m.end() - 1)
                      i += m.end()
                  else:
                      i += 1
              else:
                  i += 1
          return "".join(out)
      
      
      def split_attrs(cl, orig, a, b):
          """The attributes at the head of cl[a:b] (read from orig) and the offset
          where the declaration starts."""
          attrs = []
          k = a
          while True:
              while k < b and cl[k].isspace():
                  k += 1
              if not cl.startswith("#[", k) and not cl.startswith("#![", k):
                  return attrs, k
              depth, j = 0, k + 1
              while j < b:
                  if cl[j] == "[":
                      depth += 1
                  elif cl[j] == "]":
                      depth -= 1
                      if depth == 0:
                          break
                  j += 1
              attrs.append(re.sub(r"\s+", " ", orig[k:j + 1]))
              k = j + 1
      
      
      def cfgs_of(attrs):
          out = []
          for a in attrs:
              m = re.match(r"#\[cfg\((.*)\)\]$", a)
              if m:
                  out.append(re.sub(r'feature\s*=\s*"([^"]+)"', r"\1", m.group(1)))
          return out
      
      
      def skip_generics(s, k):
          if k < len(s) and s[k] == "<":
              depth = 0
              while k < len(s):
                  if s[k] == "<":
                      depth += 1
                  elif s[k] == ">" and s[k - 1] != "-":
                      depth -= 1
                      if depth == 0:
                          return k + 1
                  k += 1
          return k
      
      
      def impl_type(decl):
          m = re.match(r"(?:unsafe\s+)?impl\b\s*", decl)
          rest = decl[m.end():]
          rest = rest[skip_generics(rest, 0):].strip()
          # the type after a top-level ` for `, else the first path
          depth, k, cut = 0, 0, None
          while k < len(rest):
              if rest[k] == "<":
                  depth += 1
              elif rest[k] == ">" and rest[k - 1] != "-":
                  depth -= 1
              elif depth == 0 and rest.startswith(" for ", k):
                  cut = k + 5
                  break
              k += 1
          if cut is not None:
              rest = rest[cut:].strip()
          m = re.match(r"&?\s*(?:dyn\s+)?([A-Za-z_][\w:]*)", rest)
          return m.group(1).split("::")[-1] if m else "?"
      
      
      def classify(decl):
          d = re.sub(r"^(pub(\([^)]*\))?\s+)", "", decl.strip())
          d = re.sub(r"^((const|async|unsafe|default|extern\s*\"[^\"]*\"|extern)\s+)*", "", d)
          if re.match(r"impl\b", d) or re.match(r"unsafe\s+impl\b", decl.strip()):
              return "impl", impl_type(re.sub(r"^pub(\([^)]*\))?\s+", "", decl.strip()))
          for kw in ("struct", "enum", "trait", "mod", "union"):
              m = re.match(kw + r"\s+(\w+)", d)
              if m:
                  return kw, m.group(1)
          if re.match(r"fn\s+\w+", d):
              return "fn", re.match(r"fn\s+(\w+)", d).group(1)
          return "block", None
      
      
      def item_of(decl, context):
          """(kind, name) for a declaration starting with `pub `."""
          d = decl[4:].lstrip()
          q = re.match(r"((const|async|unsafe|extern\s*\"[^\"]*\"|extern)\s+)*", d)
          d2 = d[q.end():]
          m = re.match(r"fn\s+(\w+)", d2)
          if m:
              return ("method" if context == "impl" else "fn"), m.group(1)
          m = re.match(r"(struct|enum|trait|type|union|mod)\s+(\w+)", d)
          if m:
              return m.group(1), m.group(2)
          m = re.match(r"const\s+(\w+)", d)
          if m:
              return ("assoc const" if context == "impl" else "const"), m.group(1)
          m = re.match(r"static\s+(?:mut\s+)?(\w+)", d)
          if m:
              return "static", m.group(1)
          m = re.match(r"use\s+(.*)$", d, re.S)
          if m:
              return "use", re.sub(r"\s+", " ", m.group(1)).strip()
          m = re.match(r"(\w+)\s*:", d)
          if m and context in ("struct", "enum"):
              return "field", m.group(1)
          return "other", re.sub(r"\s+", " ", d)[:40]
      
      
      def parse(orig):
          """Rows (offset, kind, name, container kind, container name, cfgs of the
          item, cfgs of the containers) and module declarations (name, pub, attrs)
          and inline modules."""
          cl = clean(orig)
          rows, mods = [], []
          stack = [("root", None, [])]
          start = 0
          nest = 0  # (, [ and < depth inside a header, for commas in a struct/enum
          i, n = 0, len(cl)
          in_use = 0  # brace depth inside a `use` statement's {...} list
      
          def header(i):
              attrs, k = split_attrs(cl, orig, start, i)
              decl = cl[k:i].strip()
              return attrs, k, decl
      
          while i < n:
              c = cl[i]
              kind = stack[-1][0]
              if c in "([":
                  nest += 1
              elif c in ")]":
                  nest -= 1
              elif c == "<" and kind in ("struct", "enum"):
                  nest += 1
              elif c == ">" and kind in ("struct", "enum") and cl[i - 1] != "-":
                  nest -= 1
              if in_use:
                  if c == "{":
                      in_use += 1
                  elif c == "}":
                      in_use -= 1
                  i += 1
                  continue
              if c == "{" and re.match(r"(pub(\([^)]*\))?\s+)?use\b", header(i)[2]):
                  in_use = 1  # a use list's braces are part of its statement, which ends at `;`
                  i += 1
                  continue
              boundary = c in "{};" or (c == "," and kind in ("struct", "enum") and nest == 0)
              if c == "{":
                  boundary = True  # a brace inside parentheses (a closure body) still opens a frame
              if boundary:
                  attrs, k, decl = header(i)
                  outer = [x for fr in stack for x in fr[2]]
                  if decl.startswith("pub "):
                      ik, iname = item_of(decl, kind)
                      rows.append((k, ik, iname, kind, stack[-1][1], cfgs_of(attrs), outer))
                  if c == ";" and kind == "root":
                      m = re.match(r"(pub\s+)?mod\s+(\w+)$", decl)
                      if m:
                          mods.append((m.group(2), bool(m.group(1)), attrs))
                  if c == "{":
                      ck, cname = classify(decl)
                      if ck == "mod" and kind == "root":
                          mods.append((cname, decl.startswith("pub "), attrs, "inline"))
                      # the frame keeps the header depth it opened at, restored at its end
                      stack.append((ck, cname, cfgs_of(attrs), attrs, nest))
                      nest = 0
                  elif c == "}":
                      if len(stack) > 1:
                          nest = stack.pop()[4]
                  start = i + 1
              i += 1
          return cl, rows, mods
      
      
      def line_of(text, off):
          return text.count("\n", 0, off) + 1
      
      
      def main():
          src, rel, repo, commit, rows_path, files_path = sys.argv[1:7]
          modules = {}  # path -> (file, public chain, cfgs)
          queue = [("crate", "lib.rs", True, [])]
          walked, skipped = [], []
          rows = []
          while queue:
              mpath, frel, public, cfgs = queue.pop(0)
              path = os.path.join(src, frel)
              orig = open(path, encoding="utf-8").read()
              cl, frows, mods = parse(orig)
              modules[mpath] = (frel, public, cfgs)
              walked.append(frel)
              base = os.path.dirname(frel)
              if os.path.basename(frel) not in ("lib.rs", "mod.rs"):
                  base = os.path.join(base, os.path.splitext(os.path.basename(frel))[0])
              for m in mods:
                  name, pub, attrs = m[0], m[1], m[2]
                  mcfgs = cfgs_of(attrs)
                  if any(x.strip() == "test" for x in mcfgs):
                      skipped.append(os.path.join(base, name))
                      continue
                  if len(m) > 3:
                      continue  # an inline module: its rows are in this file's rows
                  cand = [os.path.join(base, name + ".rs"), os.path.join(base, name, "mod.rs")]
                  found = [c for c in cand if os.path.exists(os.path.join(src, c))]
                  if len(found) != 1:
                      sys.exit("module %s::%s: %d files" % (mpath, name, len(found)))
                  queue.append((mpath + "::" + name, found[0], public and pub, cfgs + mcfgs))
              for (off, kind, name, ck, cname, own, outer) in frows:
                  ln = line_of(orig, off)
                  linetext = orig.split("\n")[ln - 1]
                  at_start = linetext.lstrip().startswith("pub ") and linetext.index("pub ") == len(linetext) - len(linetext.lstrip())
                  rows.append(dict(module=mpath, file=frel, line=ln, kind=kind, name=name, ck=ck,
                                   container=cname or "-", cfg=cfgs + outer + own, at_start=at_start,
                                   text=orig[off:off + 300]))
          # re-exports from pub use rows in public modules
          reexp = {}
          for r in rows:
              if r["kind"] != "use" or not modules[r["module"]][1] or r["ck"] != "root":
                  continue
              spec = r["name"].rstrip(";").strip()
              m = re.match(r"([\w:]*?)::\{(.*)\}$", spec, re.S)
              items = [(m.group(1), x.strip()) for x in m.group(2).split(",") if x.strip()] if m else \
                  [(spec.rsplit("::", 1)[0], spec.rsplit("::", 1)[1])] if "::" in spec else []
              for prefix, item in items:
                  parts = [p for p in prefix.split("::") if p and p != "self"]
                  if parts and parts[0] == "crate":
                      target_mod = "crate::" + "::".join(parts[1:]) if parts[1:] else "crate"
                  else:
                      target_mod = r["module"] + ("::" + "::".join(parts) if parts else "")
                  nm = item.split(" as ")[0].strip()
                  alias = item.split(" as ")[-1].strip()
                  reexp[(target_mod.rstrip(":"), nm)] = "%s::%s" % (r["module"], alias)
          types = {}
          for r in rows:
              if r["kind"] in ("struct", "enum", "trait", "type", "union") and r["ck"] == "root":
                  public = modules[r["module"]][1]
                  ok = public or (r["module"], r["name"]) in reexp
                  types.setdefault(r["name"], []).append(ok)
          for r in rows:
              public = modules[r["module"]][1]
              if r["ck"] in ("fn", "block"):
                  r["reach"] = "no (inside a function or block)"
              elif r["ck"] in ("root", "mod"):
                  if public:
                      r["reach"] = "yes"
                  elif (r["module"], r["name"]) in reexp:
                      r["reach"] = "yes (re-exported as %s)" % reexp[(r["module"], r["name"])]
                  else:
                      r["reach"] = "no (private module, not re-exported)"
              else:
                  t = types.get(r["container"])
                  if t and any(t):
                      r["reach"] = "yes"
                  elif t:
                      r["reach"] = "no (its type is not reachable)"
                  else:
                      r["reach"] = "no (its type is not a pub type of the crate)"
          for r in rows:
              if r["kind"] == "use":
                  decl = r["text"].split("\n")[0].strip()
              else:
                  m = re.match(r"pub\s+(?:(?:const|async|unsafe|static|mut|struct|enum|trait|type|union|mod|fn|use)\s+)*" + re.escape(r["name"]) if r["kind"] != "other" else r"pub\s+\S+", r["text"])
                  decl = m.group(0) if m else r["text"].split("\n")[0].strip()
              if "--no-added" in sys.argv[7:]:
                  r["added"], r["subject"] = "-", "-"
                  continue
              p = subprocess.run(["git", "-C", repo, "log", "--reverse", "--format=%h%x09%s", "-S" + decl, commit,
                                  "--", rel + "/" + r["file"]], capture_output=True, text=True)
              first = p.stdout.split("\n")[0] if p.returncode == 0 and p.stdout else "-\t-"
              r["added"], r["subject"] = (first.split("\t", 1) + ["-"])[:2]
          with open(rows_path, "w") as f:
              f.write("module\tfile\tline\tkind\tname\tcontainer\tcfg\treachable\tat_line_start\tadded\tadded_subject\n")
              for r in rows:
                  f.write("\t".join([r["module"], rel + "/" + r["file"], str(r["line"]), r["kind"], r["name"],
                                     r["container"], " & ".join(r["cfg"]) or "-", r["reach"],
                                     "yes" if r["at_start"] else "no", r["added"], r["subject"]]) + "\n")
          with open(files_path, "w") as f:
              f.write("file\tmodule\trows\trows_at_line_start\trows_reachable\n")
              for frel in walked:
                  rs = [r for r in rows if r["file"] == frel]
                  mp = [m for m, v in modules.items() if v[0] == frel][0]
                  f.write("%s\t%s\t%d\t%d\t%d\n" % (rel + "/" + frel, mp, len(rs), sum(r["at_start"] for r in rs),
                                                    sum(r["reach"].startswith("yes") for r in rs)))
              for s in skipped:
                  f.write("%s\tcfg(test), not walked\t-\t-\t-\n" % (rel + "/" + s))
      
      
      main()
