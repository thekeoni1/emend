    #      sample's as P3's, and the three earlier samples' through the same
    #      record script and record check, their families derived from their
    #      entries tables; ten record files installed, eight when the keep is
    #      skipped.
    #  YK. Ruling 8 of the planning rulings during P2 and ruling 10 of those
    #      during P3: the phase's target root is <target>, <home>/.cache/
    #      emend-build/m3p6-p4/target; the keep's tests build into <target>/main
    #      (CARGO_TARGET_DIR), where size.log built the release binaries this
    #      log runs; nothing here cleans it. VK stands: this script runs no
    #      `rm -rf`.
    #
    #
    #
    # CARRIED TO M3 part 7 P3 from M3 part 6 P4's run script (at the phase
    # commit 9cfd92e, printed in records/logs/m3p6-p4/run.log; its change lists
    # up to YK are above), generated by <home>/.cache/emend-build/m3p7-p3/gen/
    # run.py, every replacement asserted to occur as often as it says, the top
    # summary replaced, the keep and open-check sections removed, and the body
    # grepped afterwards for part 6 P4's names, subjects and tokens.
    # copycmp.py and copysurvey.py are part 6 P4's, copied beside this script
    # byte for byte. What differs, and why:
    #  RNA. The phase, the log directory, the subjects and the script directory
    #       (<scripts>, <home>/.cache/emend-build/m3p7-p3/scripts, on the disk)
    #       are this phase's; the base is part 7 P2's record commit ("M3 part 7
    #       P2 record:"); the phase commit is P3's code commit by its subject
    #       ("M3 part 7 P3: rust-version equal to the pin, and the gate checks
    #       the pins agree"); the four samples each have a run directory
    #       <runs>/<date>-<sha>-<sample> and a record stem
    #       m3p7-p3-<sample>-<date>-<sha> (specs/0029 "Harness runs"); the spec
    #       is specs/0029, pinned through SPEC_SHA at this phase's doc commit. The usage
    #       takes the size.log as its second argument, and no test.log.
    #  RNB. The run directories the four samples are compared with are part 6
    #       P4's, named by its record commit, resolved by its subject ("M3 part 6
    #       P4 record:"; no hash is typed here), an ancestor of the phase commit,
    #       read from the "the run directories:" line of part 6 P4's run log at
    #       that commit and checked against the run directory its committed copy
    #       record names.
    #  RNC. The keep and the open check go, with their inputs (RUN_KEEP,
    #       RUN_SKIP_KEEP, SUPERSEDED_KEEP), the test.log argument, the <keep>
    #       root and the open record's stem: specs/0029 "Harness runs" names the
    #       four samples alone. The record files installed are the four pairs,
    #       eight.
    #  RND. Each sample's record header names its binaries (specs/0029 item 5):
    #       the .md holds one "- Binaries (host)" and one "- Binaries (i686)"
    #       line whose two hashes are the binaries this log ran, with a control.
    #  RNE. The size.log is this phase's (its "about:" line names P3's phase
    #       commit).
    #  RNF. The phase's target root is <target>, <home>/.cache/emend-build/
    #       m3p7-p3/target (specs/0001 "Rules for every phase", one target root
    #       per phase); this log builds nothing and runs the release binaries
    #       size.log built in <target>/main.
    #  RNG. The runner gives each child its own TMPDIR under its own work
    #       directory, under <work>/tmp-run here (specs/0029 P1 ruling 2); the
    #       check that <work>/tmp-run is empty after each run stands.
    #
    # Usage: m3p7-p4-run.sh <phase commit> > <file outside the tree>; the caller
    # moves the output to records/logs/m3p7-p4/run.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    BUILD_ROOT=${RUN_BUILD:-$HOME/.cache/emend-build/m3p7-p4/run}
    SUPERSEDED_DIR=$HOME/.cache/emend-build/m3p7-p4/superseded
    CHECKER=$SELF_DIR/readme_check.py
    DENY_FILE=$HOME/.config/emend/private-denylist.txt
    SPEC=specs/0029-engineering-close.md
    SPEC_WANT=2ddd2b06105267673097508662375f7053e4b63016e1b340b6d4589385c8256a
    SIZE_REC=records/size-m3p7-2026-10-09-09d2e0f.md
    SAMPLE_RECS="records/m3p6-p4-copy-2026-10-08-9cfd92e.md records/m3p6-p4-anchor-2026-10-08-9cfd92e.md records/m3p6-p4-removeimage-2026-10-08-9cfd92e.md records/m3p6-p4-commentbox-2026-10-08-9cfd92e.md"
    COPY_REC=records/m3p6-p4-copy-2026-10-08-9cfd92e.md
    OPEN_REC=records/m3p6-open-2026-10-08-9cfd92e.md
    SCALE_REC=records/scale-m3p1-2026-10-02-6578925.md
    # Planning rulings during P4 (2026-10-09), ruling 1: the values the records
    # are compared with (change FD).
    WANT_FILES=27
    WANT_OK=27
    WANT_LO_OK=27
    WANT_LO_IN_OK=27
    WANT_ENTRIES=917
    WANT_IDENTICAL=784
    WANT_PAIRS=1093
    WANT_OPEN_LO_OK=1082
    FEATURES_ORDER="dates rowcol metadata rules tables comments images richtext sheetprops read copy"
    mkdir -p "$BUILD_ROOT" || exit 2
    B=$(mktemp -d -p "$BUILD_ROOT") || exit 2
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT_SHA=${C:0:7}
    # This phase's logs and planning's two uncommitted files (change FA).
    OURS='^((\?\?| ?[MARCD]) records/logs/m3p7-p4/| M specs/0029-engineering-close[.]md$| M ROADMAP[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs and planning's two files" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$B#<scratch>/w#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$SUPERSEDED_DIR#<superseded>#g" \
        -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    # The environment and path inputs, each on its labelled line.
    echo "input: RERUN_NOTE: ${RERUN_NOTE:-unset}"
    echo "input: RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: HOME: set, read for the paths under it, printed as <home>"
    echo "input: RUN_BUILD: ${RUN_BUILD:-unset} (the build root, <build>)"
    echo "about: M3 part 7 P4 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M3 part 7 P3 record: logs, the size record, the sample records, the API review record, the independent check')
    DOC1=$(by_subject "M3 part 7 P4: commit planning docs (the P3 verification and rulings, ROADMAP, the API review record's corrections)")
    CODE1=$(by_subject 'M3 part 7 P4: the README (decision 4 A)')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  M3 part 7 P3's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  the code commit (the README, the phase commit): ${CODE1:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~2"
    for k in 0 1 2; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CODE1" "$DOC1" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the code commit, the doc commit and the base, each the next one's parent, the code commit the phase commit (change FA)" "$(yn roles_in_order)"
    roles_ctl() { local CODE1=$DOC1; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the code commit" "$(ynnot roles_ctl)"
    echo
    echo "phase: Milestone 3 part 7 P4 ($SPEC) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "rerun: the superseded files are kept in <superseded>"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this log builds nothing, runs no binary and reads no corpus: it reads the phase commit's README.md and the records it cites (change FB)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh, README.md, crates/emend/Cargo.toml, the cited records and $SPEC are read from it by git show at the phase commit, and the working spec is hashed in it; nothing in it is run or built"
    echo "root: <home> stands for the home directory of the account that ran this script; <home>/.config/emend/private-denylist.txt, the private denylist, is read for counts and never printed (change FE)"
    echo "root: <scripts> stands for <home>/.cache/emend-build/m3p7-p4/scripts, this script's own directory on the disk, which holds the script, the README check program readme_check.py and, in <scripts>/out, its own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <build> stands for the build root on the disk, <home>/.cache/emend-build/m3p7-p4/run unless RUN_BUILD names another; nothing is built there"
    echo "root: <superseded> stands for <home>/.cache/emend-build/m3p7-p4/superseded, where a rerun's superseded files are kept; read only"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory under <build>, kept on the disk after the run: <scratch>/w/counting.sh the phase commit's library, sourced; the README, the records, the manifest and the controls' copies beside it"
    echo "root: <corpus> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change FF)"
    echo "root: <runs> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change FF)"
    echo "root: <target> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change FF)"
    echo "root: <work> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change FF)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$BUILD_ROOT" && apart "$SUPERSEDED_DIR" "$MAIN"; }
    check "the roots other than <home> are distinct, none inside another (<scratch>/w inside <build>)" "$(yn roots_distinct)"
    roots_ctl() { apart "$B" "$BUILD_ROOT"; }
    check "control: apart refuses <scratch>/w against <build>, which holds it" "$(ynnot roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them this phase's logs or planning's two files $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT_SHA")"
    short_names_head() { [ "$(git rev-parse "$SHORT_SHA")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_readme_ctl() { printf ' M README.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified README.md" "$(ynnot ours_readme_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m3p7-p4/run.log\n?? records/logs/m3p7-p3/run.log\n?? records/m3p7-p4-copy-2026-01-01-abcdef0.md\n?? records/logs/m3p7-p4x/run.log\n M ROADMAP.md\n M specs/0029-engineering-close.md\n' | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern takes this phase's log and planning's two files alone, no other phase's log, no record and no sibling directory (change FA)" "$(yn [ "$(ours_rec_ctl)" = 3 ])"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_BLOB=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum: $SPEC_BLOB; sha256sum $SPEC (the working file, printed and not asserted: planning holds its rulings during P4 uncommitted; change FA): $SPEC_HAVE"
    check "the spec's blob at the phase commit is at the hash this log pins" "$(yn [ "$SPEC_BLOB" = "$SPEC_WANT" ])"
    spec_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$SPEC_WANT" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot spec_ctl)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## the README check program (change FC)"
    echo "command: sha256sum <scripts>/readme_check.py: $(sha256sum <"$CHECKER" | cut -d' ' -f1)"
    sed 's/^/    /' "$CHECKER"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the files read at the phase commit (change FB)"
    echo "command: git show <phase commit>:<path> > <scratch>/w/<name>, for README.md, crates/emend/Cargo.toml and each cited record; git ls-tree -r --name-only <phase commit> > <scratch>/w/tree.txt"
    git show "$C:README.md" >"$B/README.md"
    git show "$C:crates/emend/Cargo.toml" >"$B/Cargo.toml"
    git ls-tree -r --name-only "$C" >"$B/tree.txt"
    n_read=0
    for r in $SIZE_REC $SAMPLE_RECS $OPEN_REC $SCALE_REC; do
      git show "$C:$r" >"$B/$(basename "$r")" && n_read=$((n_read + 1))
      echo "  $r: $(wc -c <"$B/$(basename "$r")") bytes, sha256 $(sha256sum <"$B/$(basename "$r")" | cut -d' ' -f1)"
    done
    echo "  README.md: $(wc -l <"$B/README.md") lines, sha256 $(sha256sum <"$B/README.md" | cut -d' ' -f1); crates/emend/Cargo.toml: sha256 $(sha256sum <"$B/Cargo.toml" | cut -d' ' -f1); the tree listing: $(count_lines "$B/tree.txt") paths"
    check "the seven cited records were read at the phase commit" "$(yn [ "$n_read" = 7 ])"
    readme_read() { test -s "$B/README.md" && test -s "$B/Cargo.toml"; }
    check "README.md and the manifest were read and are not empty" "$(yn readme_read)"
    R=$B/README.md
    
    echo
    echo "## 1. the README check: every sentence holding a digit cites a records/ path the tree holds (change FC)"
    echo "command: python3 -I <scripts>/readme_check.py <scratch>/w/README.md <scratch>/w/tree.txt"
    python3 -I "$CHECKER" "$R" "$B/tree.txt" >"$B/rc.out" 2>"$B/rc.err" </dev/null
    rc=$?
    echo "  exit: $rc; standard error $(wc -c <"$B/rc.err") bytes; standard output:"
    sed 's/^/    /' "$B/rc.out"
    summary_is() { tail -n 1 "$1" | LC_ALL=C "$G" -qE "^sentences [0-9]+ with-digit [0-9]+ cited [0-9]+ $2\$"; }
    rc_ok() { [ "$rc" = 0 ] && summary_is "$B/rc.out" 'uncited 0 missing 0' && [ ! -s "$B/rc.err" ]; }
    check "every sentence of the README holding a digit cites a records/ path, and every path it cites is in the phase commit's tree: exit 0, uncited 0 missing 0" "$(yn rc_ok)"
    with_digit=$(tail -n 1 "$B/rc.out" | awk '{print $4}')
    cited=$(tail -n 1 "$B/rc.out" | awk '{print $6}')
    echo "  sentences holding a digit: $with_digit; cited: $cited"
    all_cited() { [ -n "$with_digit" ] && [ "$with_digit" -gt 0 ] && [ "$with_digit" = "$cited" ]; }
    check "the sentences holding a digit are more than none and all cited" "$(yn all_cited)"
    cp "$R" "$B/planted.md"
    printf '\nPlanted: the sample ran 99 times over the corpus.\n' >>"$B/planted.md"
    echo "command (control): the same over a copy with the paragraph \"Planted: the sample ran 99 times over the corpus.\" appended after a blank line"
    python3 -I "$CHECKER" "$B/planted.md" "$B/tree.txt" >"$B/rcp.out" 2>"$B/rcp.err" </dev/null
    rcp=$?
    echo "  exit: $rcp; the summary: $(tail -n 1 "$B/rcp.out")"
    rcp_ok() { [ "$rcp" = 1 ] && summary_is "$B/rcp.out" 'uncited 1 missing 0'; }
    check "control: the same check refuses the planted uncited sentence" "$(yn rcp_ok)"
    
    echo
    echo "## 2. every figure, read from the record it cites by a printed command (change FD)"
    # md_cell <file> <heading prefix> <exact|prefix|first|all> <row label> <column name>:
    # in the section opened by the first line starting with the heading (up to
    # the next "## " heading), the table whose header row holds a cell named
    # <column name>; prints that column's cell of each data row whose first cell
    # equals the label (exact), starts with it (prefix), of the first data row
    # (first) or of every data row (all). A line outside a table ends it.
    md_cell() {
      awk -F'|' -v h="$2" -v mode="$3" -v lab="$4" -v col="$5" '
        index($0, h) == 1 { s = 1; ci = 0; next }
        s && /^## / { s = 0 }
        s && !/^[|]/ { ci = 0; next }
        s && /^[|]/ {
          if (!ci) { for (i = 2; i < NF; i++) { c = $i; gsub(/^ +| +$/, "", c); if (c == col) ci = i }; next }
          c1 = $2; gsub(/^ +| +$/, "", c1)
          if (c1 ~ /^-+$/) next
          v = $ci; gsub(/^ +| +$/, "", v)
          if (mode == "exact" && c1 == lab) print v
          else if (mode == "prefix" && index(c1, lab) == 1) print v
          else if (mode == "first" && !done) { print v; done = 1 }
          else if (mode == "all") print v
        }' "$1"
    }
    printf '## T\n\n| name | a | b |\n| --- | --- | --- |\n| x | 1 | 2 |\n| xy | 3 | 4 |\n\n| side | c |\n| --- | --- |\n| x | 9 |\n' >"$B/md-fixture"
    echo "command (control): md_cell over a fixture of two tables: exact x b, prefix x a, first - b, all - a"
    md_ctl() { [ "$(md_cell "$B/md-fixture" '## T' exact x b)" = 2 ] && [ "$(md_cell "$B/md-fixture" '## T' prefix x a | tr '\n' ' ')" = "1 3 " ] && [ "$(md_cell "$B/md-fixture" '## T' first '' b)" = 2 ] && [ "$(md_cell "$B/md-fixture" '## T' all '' a | tr '\n' ' ')" = "1 3 " ]; }
    check "control: md_cell reads the fixture's cells by row and column, and the second table, whose header names neither column, is not read" "$(yn md_ctl)"
    num() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9]+([.][0-9]+)?$'; }
    # joined <file>: the file's text with its line ends as spaces, for a
    # sentence the record wraps.
    joined() { tr '\n' ' ' <"$1"; }
    # in_readme_once <text>: the README holds the text exactly once.
    in_readme_once() { [ "$(LC_ALL=C "$G" -o -F -e "$1" "$R" | wc -l)" = 1 ]; }
    # readme_holds <label> <fragment> <fragment with a value changed>.
    readme_holds() {
      echo "    README fragment: $2"
      check "$1: the README holds the fragment once" "$(yn in_readme_once "$2")"
      check "control: $1: the same check refuses the fragment with a value changed" "$(ynnot in_readme_once "$3")"
    }
    FIGS=()
    echo "### the size record, $SIZE_REC"
    SZ=$B/$(basename "$SIZE_REC")
    for f in $FEATURES_ORDER; do
      v=$(md_cell "$SZ" '## The figures' prefix "the \`$f\` feature's cost," Sections)
      echo "  command: md_cell <record> '## The figures' prefix 'the \`$f\` feature's cost,' Sections -> $v"
      check "the \`$f\` feature's cost is one number" "$(yn num "$v")"
      FIGS+=("$v")
      LC_ALL=C "$G" -E "^- \`$f\`, " "$R" >"$B/feat-$f"
      n_line=$(count_lines "$B/feat-$f")
      n_val=$(count_matches -F ": $v " "$B/feat-$f")
      n_rec=$(count_matches -F "(\`$SIZE_REC\`)" "$B/feat-$f")
      n_bad=$(count_matches -F ": $((v + 1)) " "$B/feat-$f")
      echo "    README lines starting \"- \`$f\`, \": $n_line; of them holding \": $v \": $n_val, citing the size record: $n_rec; holding the value plus one: $n_bad"
      feat_ok() { [ "$n_line" = 1 ] && [ "$n_val" = 1 ] && [ "$n_rec" = 1 ]; }
      check "the README's \`$f\` line gives the record's cost, $v, and cites the size record" "$(yn feat_ok)"
      check "control: the same count finds no \`$f\` line with the value plus one" "$(yn [ "$n_bad" = 0 ])"
    done
    BUDGET=$(md_cell "$SZ" '## The figures' prefix 'the budget,' Sections)
    echo "  command: md_cell <record> '## The figures' prefix 'the budget,' Sections -> $BUDGET"
    SENT=$(joined "$SZ" | LC_ALL=C "$G" -o -E 'The budget figure is [0-9]+ section bytes, [0-9]+ under the ceiling[.]')
    echo "  command: tr '\\n' ' ' <record> | grep -o -E 'The budget figure is [0-9]+ section bytes, [0-9]+ under the ceiling[.]' -> $SENT"
    BUDGET2=$(printf '%s' "$SENT" | awk '{print $5}')
    HEADROOM=$(printf '%s' "$SENT" | awk '{print $8}')
    CSENT=$(joined "$SZ" | LC_ALL=C "$G" -o -E 'The ceiling is [0-9]+ section bytes')
    CEIL=$(printf '%s' "$CSENT" | awk '{print $4}')
    echo "  command: tr '\\n' ' ' <record> | grep -o -E 'The ceiling is [0-9]+ section bytes' -> $CSENT"
    echo "  the budget $BUDGET (table) and $BUDGET2 (sentence); the headroom $HEADROOM; the ceiling $CEIL"
    size_nums() { num "$BUDGET" && num "$HEADROOM" && num "$CEIL" && [ "$BUDGET" = "$BUDGET2" ]; }
    check "the budget, the headroom and the ceiling are numbers, the budget the same in the table and the sentence" "$(yn size_nums)"
    check "the headroom is the ceiling less the budget" "$(yn [ "$HEADROOM" = "$((CEIL - BUDGET))" ])"
    FIGS+=("$BUDGET" "$HEADROOM" "$CEIL")
    readme_holds "the size sentence" "is $BUDGET section bytes, $HEADROOM under the ceiling of $CEIL (\`$SIZE_REC\`)" "is $((BUDGET + 1)) section bytes, $HEADROOM under the ceiling of $CEIL (\`$SIZE_REC\`)"
    
    echo "### part 6 P4's four sample records, \"Files by outcome\", the host row (ruling 1)"
    for r in $SAMPLE_RECS; do
      RF=$B/$(basename "$r")
      vf=$(md_cell "$RF" '## Files by outcome' exact host files)
      vo=$(md_cell "$RF" '## Files by outcome' exact host ok)
      vl=$(md_cell "$RF" '## Files by outcome' exact host 'lo ok')
      vi=$(md_cell "$RF" '## Files by outcome' exact host 'lo_in ok')
      echo "  command: md_cell <record> '## Files by outcome' exact host <files|ok|lo ok|lo_in ok>, over $r -> files $vf, ok $vo, lo ok $vl, lo_in ok $vi"
      host_row_ok() { [ "$vf" = "$WANT_FILES" ] && [ "$vo" = "$WANT_OK" ] && [ "$vl" = "$WANT_LO_OK" ] && [ "$vi" = "$WANT_LO_IN_OK" ]; }
      check "$(basename "$r"): the host row reads files $WANT_FILES, ok $WANT_OK, lo ok $WANT_LO_OK, lo_in ok $WANT_LO_IN_OK (ruling 1)" "$(yn host_row_ok)"
      host_row_ctl() { local WANT_OK=$((WANT_OK - 1)); host_row_ok; }
      check "control: the same check refuses an expected ok one less" "$(ynnot host_row_ctl)"
      case "$r" in "$COPY_REC") CF=$vf; CO=$vo; CL=$vl; CI=$vi ;; esac
    done
    FIGS+=("$CF")
    FID="ran over the $CF workbooks of the private test corpus, and on the host all $CO outputs were written and opened in LibreOffice, as were all $CI inputs ("
    check "the copy record's ok and lo ok are one figure, as the README's one word for both says" "$(yn [ "$CO" = "$CL" ])"
    readme_holds "the fidelity sentence" "$FID" "ran over the $CF workbooks of the private test corpus, and on the host all $((CO + 1)) outputs were written and opened in LibreOffice, as were all $CI inputs ("
    n_cite4=0
    for r in $SAMPLE_RECS; do n_cite4=$((n_cite4 + $(LC_ALL=C "$G" -F -e "$FID" "$R" | LC_ALL=C "$G" -c -F -e "\`$r\`"))); done
    echo "  the four sample records cited on the fidelity sentence's line: $n_cite4"
    check "the fidelity sentence cites the four sample records" "$(yn [ "$n_cite4" = 4 ])"
    
    echo "### the copy record's host family table, the total row (ruling 1)"
    CR=$B/$(basename "$COPY_REC")
    ENT=$(md_cell "$CR" '## Entries by part family: host' exact total entries)
    IDN=$(md_cell "$CR" '## Entries by part family: host' exact total identical)
    echo "  command: md_cell <record> '## Entries by part family: host' exact total <entries|identical> -> entries $ENT, identical $IDN"
    copy_tot_ok() { [ "$ENT" = "$WANT_ENTRIES" ] && [ "$IDN" = "$WANT_IDENTICAL" ]; }
    check "the copy record's host total row reads entries $WANT_ENTRIES, identical $WANT_IDENTICAL (ruling 1)" "$(yn copy_tot_ok)"
    copy_tot_ctl() { local WANT_IDENTICAL=$((WANT_IDENTICAL + 1)); copy_tot_ok; }
    check "control: the same check refuses an expected identical one more" "$(ynnot copy_tot_ctl)"
    FIGS+=("$ENT" "$IDN")
    readme_holds "the copy sentence" "In the copy sample, $IDN of the $ENT zip entries on the host came back byte for byte: the entries the copy did not touch (\`$COPY_REC\`)" "In the copy sample, $((IDN + 1)) of the $ENT zip entries on the host came back byte for byte: the entries the copy did not touch (\`$COPY_REC\`)"
    
    echo "### the open record's totals (ruling 1)"
    OR=$B/$(basename "$OPEN_REC")
    PAIRS=$(md_cell "$OR" '## Totals' first '' pairs)
    OLO=$(md_cell "$OR" '## Totals' first '' 'lo ok')
    echo "  command: md_cell <record> '## Totals' first - <pairs|lo ok> -> pairs $PAIRS, lo ok $OLO"
    open_ok() { [ "$PAIRS" = "$WANT_PAIRS" ] && [ "$OLO" = "$WANT_OPEN_LO_OK" ]; }
    check "the open record's totals read pairs $WANT_PAIRS, lo ok $WANT_OPEN_LO_OK (ruling 1)" "$(yn open_ok)"
    open_ctl() { local WANT_PAIRS=$((WANT_PAIRS + 1)); open_ok; }
    check "control: the same check refuses expected pairs one more" "$(ynnot open_ctl)"
    FIGS+=("$PAIRS" "$OLO")
    readme_holds "the open sentence" "Of the $PAIRS files the crate's own tests write, LibreOffice opened $OLO; the record's own sections explain the rest (\`$OPEN_REC\`)" "Of the $PAIRS files the crate's own tests write, LibreOffice opened $((OLO + 1)); the record's own sections explain the rest (\`$OPEN_REC\`)"
    
    echo "### the scale record, $SCALE_REC"
    SC=$B/$(basename "$SCALE_REC")
    SSENT=$(joined "$SC" | LC_ALL=C "$G" -o -E "Every streaming sample peaks between [0-9]+ and [0-9]+ kB on every tier it completes, tier c's [0-9]+-byte sheet entry included[.]")
    echo "  command: tr '\\n' ' ' <record> | grep -o -E \"Every streaming sample peaks between [0-9]+ and [0-9]+ kB on every tier it completes, tier c's [0-9]+-byte sheet entry included[.]\" -> $SSENT"
    PLO=$(printf '%s' "$SSENT" | awk '{print $6}')
    PHI=$(printf '%s' "$SSENT" | awk '{print $8}')
    BIG=$(printf '%s' "$SSENT" | LC_ALL=C "$G" -o -E '[0-9]+-byte' | cut -d- -f1)
    md_cell "$SC" '## Throughput' all '' 'host MB/s' >"$B/tp-host"
    md_cell "$SC" '## Throughput' all '' 'i686 MB/s' >"$B/tp-i686"
    echo "  command: md_cell <record> '## Throughput' all - 'host MB/s' -> $(tr '\n' ' ' <"$B/tp-host")"
    echo "  command: md_cell <record> '## Throughput' all - 'i686 MB/s' -> $(tr '\n' ' ' <"$B/tp-i686")"
    HMIN=$(sort -g "$B/tp-host" | head -n 1); HMAX=$(sort -g "$B/tp-host" | tail -n 1)
    IMIN=$(sort -g "$B/tp-i686" | head -n 1); IMAX=$(sort -g "$B/tp-i686" | tail -n 1)
    echo "  the peaks $PLO to $PHI kB; the largest sheet entry $BIG bytes; host $HMIN to $HMAX MB/s; i686 $IMIN to $IMAX MB/s (sort -g, the first and the last)"
    scale_nums() { num "$PLO" && num "$PHI" && num "$BIG" && num "$HMIN" && num "$HMAX" && num "$IMIN" && num "$IMAX" && [ "$(count_lines "$B/tp-host")" = 4 ] && [ "$(count_lines "$B/tp-i686")" = 4 ]; }
    check "every scale figure is a number, the throughput table's four tiers read for each target" "$(yn scale_nums)"
    FIGS+=("$BIG" "$PLO" "$PHI" "$HMIN" "$HMAX" "$IMIN" "$IMAX")
    readme_holds "the speed sentence" "up to a $BIG-byte sheet entry, the streaming samples peaked between $PLO and $PHI kB on every tier they completed, and throughput ran from $HMIN to $HMAX MB/s on the host and from $IMIN to $IMAX MB/s on the static target (\`$SCALE_REC\`)" "up to a $BIG-byte sheet entry, the streaming samples peaked between $PLO and $((PHI + 1)) kB on every tier they completed, and throughput ran from $HMIN to $HMAX MB/s on the host and from $IMIN to $IMAX MB/s on the static target (\`$SCALE_REC\`)"
    
    echo
    echo "## 3. the README's number tokens, as a set, equal the figures checked (change FE)"
    # tokens <file>: the number tokens outside records/ and specs/ paths, the
    # licence files' names and the target's name, one per line, unique.
    tokens() {
      sed -E -e 's#(records|specs)/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]##g' -e 's#LICENSE-[A-Z]+##g' -e 's#i686-unknown-linux-musl##g' "$1" |
        LC_ALL=C "$G" -o -E '[0-9]+([.][0-9]+)?' | sort -u
    }
    echo "command: sed -E -e 's#(records|specs)/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]##g' -e 's#LICENSE-[A-Z]+##g' -e 's#i686-unknown-linux-musl##g' <README> | grep -o -E '[0-9]+([.][0-9]+)?' | sort -u"
    tokens "$R" >"$B/tokens"
    printf '%s\n' "${FIGS[@]}" | sort -u >"$B/figs"
    echo "  the README's tokens ($(count_lines "$B/tokens")): $(tr '\n' ' ' <"$B/tokens")"
    echo "  the figures checked ($(count_lines "$B/figs")): $(tr '\n' ' ' <"$B/figs")"
    check "the README holds no number outside its paths and the target name but the figures checked, and every figure checked" "$(yn cmp -s "$B/tokens" "$B/figs")"
    cp "$R" "$B/planted-num.md"
    printf '\nPlanted: 12345 (`%s`).\n' "$SIZE_REC" >>"$B/planted-num.md"
    tokens "$B/planted-num.md" >"$B/tokens-planted"
    check "control: the same comparison refuses a copy with one more number planted" "$(ynnot cmp -s "$B/tokens-planted" "$B/figs")"
    
    echo
    echo "## 4. the README's features equal the manifest's, each named with a specs/ path the tree holds (change FE)"
    echo "command: awk over <phase commit>:crates/emend/Cargo.toml, the names of the [features] table; grep -o -E '^- \`[a-z][a-z0-9_-]*\`, ' over the README"
    awk '/^\[features\]$/ { f = 1; next } /^\[/ { f = 0 } f && /^[a-z][a-z0-9_-]* = / { print $1 }' "$B/Cargo.toml" | sort >"$B/feat-cargo"
    LC_ALL=C "$G" -o -E '^- `[a-z][a-z0-9_-]*`, ' "$R" | sed -E 's/^- `([^`]*)`, $/\1/' | sort >"$B/feat-readme"
    echo "  the manifest's features ($(count_lines "$B/feat-cargo")): $(tr '\n' ' ' <"$B/feat-cargo")"
    echo "  the README's features ($(count_lines "$B/feat-readme")): $(tr '\n' ' ' <"$B/feat-readme")"
    check "the README names every feature of the manifest and no other" "$(yn cmp -s "$B/feat-cargo" "$B/feat-readme")"
    { cat "$B/feat-cargo"; echo planted; } | sort >"$B/feat-ctl"
    check "control: the same comparison refuses the manifest's list with one feature more" "$(ynnot cmp -s "$B/feat-ctl" "$B/feat-readme")"
    order_ok() { [ "$(printf '%s\n' $FEATURES_ORDER | sort | tr '\n' ' ')" = "$(tr '\n' ' ' <"$B/feat-cargo")" ]; }
    check "this script's feature list is the manifest's, so every feature's cost was checked above" "$(yn order_ok)"
    n_spec_bad=0
    for f in $(cat "$B/feat-readme"); do
      sp=$(LC_ALL=C "$G" -E "^- \`$f\`, " "$R" | LC_ALL=C "$G" -o -E 'specs/[0-9]{4}-[a-z0-9-]+[.]md')
      n_sp=$(printf '%s\n' "$sp" | LC_ALL=C "$G" -c -E '^specs/')
      in_tree=$(count_matches -xF "$sp" "$B/tree.txt")
      echo "  $f: $sp (paths on the line: $n_sp; in the phase commit's tree: $in_tree)"
      [ "$n_sp" = 1 ] && [ "$in_tree" = 1 ] || n_spec_bad=$((n_spec_bad + 1))
    done
    check "every feature line names one specs/ path, and the tree holds it" "$(yn [ "$n_spec_bad" = 0 ])"
    spec_absent_ctl() { [ "$(count_matches -xF 'specs/0000-no-such-spec.md' "$B/tree.txt")" = 1 ]; }
    check "control: the same count does not find a spec the tree lacks" "$(ynnot spec_absent_ctl)"
    
    echo
    echo "## 5. no U+2014, no non-ASCII byte, no absolute path, no corpus directory name and no private-denylist word in the README (change FE)"
    DASH=$(printf '\342\200\224')
    n_dash=$(count_matches -F "$DASH" "$R")
    printf 'a %s b\n' "$DASH" >"$B/c-dash"
    n_dash_c=$(count_matches -F "$DASH" "$B/c-dash")
    echo "  command: count_matches -F <the bytes E2 80 94> <README> -> $n_dash; over a control line holding them -> $n_dash_c"
    check "the README holds no U+2014" "$(yn [ "$n_dash" = 0 ])"
    check "control: the same count finds the control's one line" "$(yn [ "$n_dash_c" = 1 ])"
    n_na=$(count_matches -P '[^\x00-\x7F]' "$R")
    printf 'caf\303\251\n' >"$B/c-na"
    n_na_c=$(count_matches -P '[^\x00-\x7F]' "$B/c-na")
    echo "  command: count_matches -P '[^\\x00-\\x7F]' <README> -> $n_na; over a control line with one two-byte character -> $n_na_c"
    check "the README is ASCII" "$(yn [ "$n_na" = 0 ])"
    check "control: the same count finds the control's one line" "$(yn [ "$n_na_c" = 1 ])"
    n_ctl=$(LC_ALL=C tr -cd '\000-\010\013-\037\177' <"$R" | wc -c)
    echo "  command: tr -cd <control bytes other than tab and line feed> <README> | wc -c -> $n_ctl"
    check "the README holds no control byte other than tab and line feed" "$(yn [ "$n_ctl" = 0 ])"
    # Built by concatenation so this script holds no such shape (change FE).
    ABS_RE="(/ho""me/|/t""mp/|/m""nt/|/ro""ot/|/Us""ers/|[A-Za-z]:[\\\\/])"
    CORP="emend-""testing"
    n_abs=$(count_matches -E "$ABS_RE" "$R")
    printf 'x %s%s%s y\nz %s%s w\n' "/ho" "me/" "someone" "C:" "/x" >"$B/c-abs"
    n_abs_c=$(count_matches -E "$ABS_RE" "$B/c-abs")
    echo "  command: count_matches -E <the absolute-path pattern> <README> -> $n_abs; over two control lines, a home path and a drive path -> $n_abs_c"
    check "the README names no absolute path" "$(yn [ "$n_abs" = 0 ])"
    check "control: the same count finds both control lines" "$(yn [ "$n_abs_c" = 2 ])"
    n_corp=$(count_matches_i -F "$CORP" "$R")
    printf 'x %s y\n' "$CORP" >"$B/c-corp"
    n_corp_c=$(count_matches_i -F "$CORP" "$B/c-corp")
    echo "  command: count_matches_i -F <the corpus directory's name> <README> -> $n_corp; over a control line holding it -> $n_corp_c"
    check "the README names no corpus directory" "$(yn [ "$n_corp" = 0 ])"
    check "control: the same count finds the control's one line" "$(yn [ "$n_corp_c" = 1 ])"
    echo "command: the private denylist at <home>/.config/emend/private-denylist.txt, comment and blank lines dropped; LC_ALL=C grep -c -i -w -F -f <entries> <README>; entries counted and never printed"
    deny_ok=no
    if [ -r "$DENY_FILE" ]; then
      LC_ALL=C "$G" -v -E '^[[:space:]]*(#|$)' "$DENY_FILE" >"$B/deny" 2>/dev/null
      n_deny=$(count_lines "$B/deny")
      LC_ALL=C "$G" -c -i -w -F -f "$B/deny" "$R" >"$B/deny-hits"
      rcd=$?
      head -n 1 "$B/deny" >"$B/c-deny"
      LC_ALL=C "$G" -c -i -w -F -f "$B/deny" "$B/c-deny" >"$B/deny-ctl"
      rcd_c=$?
      echo "  entries: $n_deny; lines of the README holding an entry: $(cat "$B/deny-hits") (grep exit $rcd); lines of a control file holding the first entry: $(cat "$B/deny-ctl") (grep exit $rcd_c)"
      deny_ok=yes
    fi
    check "the denylist is present and readable" "$(yn [ "$deny_ok" = yes ])"
    deny_none() { [ "$deny_ok" = yes ] && [ "$rcd" = 1 ] && [ "$(cat "$B/deny-hits")" = 0 ] && [ "$n_deny" -gt 0 ]; }
    check "the README holds no denylist word (grep exit 1, 0 lines), over a denylist with entries" "$(yn deny_none)"
    deny_ctl() { [ "$deny_ok" = yes ] && [ "$rcd_c" = 0 ] && [ "$(cat "$B/deny-ctl")" = 1 ]; }
    check "control: the same form finds the control's one line" "$(yn deny_ctl)"
    rm -f "$B/deny" "$B/c-deny"
    check "the denylist's copies are removed from <scratch>/w (rm -f by name)" "$(ynnot test -e "$B/deny")"
    
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.out "$B"/*.err; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or planning's two files: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's logs or planning's uncommitted spec and ROADMAP.md" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## the README check program (change FC)
command: sha256sum <scripts>/readme_check.py: f87526a34e00242c582db02da8eaee92b6c6dd944253e0679fa82d0e67f25dbc
    #!/usr/bin/env python3
    """README check (specs/0029 "The README (decision 4)", P4): every sentence of
    the README that holds a digit cites at least one path under records/, and
    every records/ path it cites exists in the given tree listing.
    
    Usage: python3 -I readme_check.py <README> <paths-at-HEAD.txt>
      <paths-at-HEAD.txt>: `git ls-tree -r --name-only HEAD`, one path per line.
    
    Units: a fenced code block is one unit; outside fences, a heading line, a
    list item (a line starting "- " with its continuation lines) and a paragraph
    (lines up to a blank line) are units, and a prose unit is split into
    sentences after ".", "!" or "?" followed by white space. Prints one line per
    sentence holding a digit: "cited <n> <unit-index>" or "UNCITED <unit-index>"
    or "MISSING <path>", never the sentence's text, then a summary line
    "sentences <s> with-digit <d> cited <c> uncited <u> missing <m>". Exit 0 when
    uncited and missing are both 0, 1 otherwise, 2 on a usage or read error."""
    import re, sys
    
    def units(lines):
        out, cur, fence = [], [], False
        def flush():
            if cur:
                out.append((" ".join(x.strip() for x in cur), False))
                cur.clear()
        for ln in lines:
            if ln.startswith("```"):
                if fence:
                    cur.append(ln); out.append(("\n".join(cur), True)); cur.clear(); fence = False
                else:
                    flush(); cur.append(ln); fence = True
                continue
            if fence:
                cur.append(ln); continue
            if not ln.strip():
                flush(); continue
            if ln.startswith("#") or ln.startswith("- "):
                flush(); cur.append(ln)
                if ln.startswith("#"):
                    flush()
                continue
            cur.append(ln)
        if fence:
            sys.exit("error: an unclosed code fence")
        flush()
        return out
    
    def main():
        if len(sys.argv) != 3:
            print("usage: readme_check.py <README> <paths-at-HEAD.txt>", file=sys.stderr); sys.exit(2)
        try:
            lines = open(sys.argv[1], encoding="utf-8").read().split("\n")
            tree = set(open(sys.argv[2], encoding="utf-8").read().split("\n"))
        except (OSError, UnicodeDecodeError) as e:
            print("error: %s" % type(e).__name__, file=sys.stderr); sys.exit(2)
        s = d = c = u = m = 0
        for i, (text, code) in enumerate(units(lines), 1):
            sents = [text] if code else [x for x in re.split(r"(?<=[.!?])\s+", text) if x]
            for sent in sents:
                s += 1
                if not re.search(r"[0-9]", sent):
                    continue
                d += 1
                paths = re.findall(r"records/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]", sent)
                if not paths:
                    u += 1; print("UNCITED unit %d" % i); continue
                bad = [p for p in paths if p not in tree]
                for p in bad:
                    m += 1; print("MISSING %s" % p)
                if not bad:
                    c += 1; print("cited %d unit %d" % (len(paths), i))
        print("sentences %d with-digit %d cited %d uncited %d missing %d" % (s, d, c, u, m))
        sys.exit(0 if u == 0 and m == 0 else 1)
    
    main()

