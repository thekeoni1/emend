      #!/usr/bin/env python3
      """Generates Milestone 3 part 7's close-out push, ci-run and scan scripts from
      part 6's (copied unchanged to carried/ here, each equal to the text printed in
      records/logs/m3p6-close/*.log). Every replacement is asserted to occur the
      stated number of times, applied in the order listed (specs/0029
      "Planning rulings during P4 (2026-10-09)" rulings 3 and 4)."""
      import os, sys
      HOME = os.path.expanduser("~")
      SRC = HOME + "/.cache/emend-build/m3p7-close/carried/"
      # The output directory: this one, or the one argument given (the test log
      # regenerates into a scratch directory and compares).
      DST = (sys.argv[1].rstrip("/") + "/") if len(sys.argv) > 1 else HOME + "/.cache/emend-build/m3p7-close/"
      BASE_OLD = "BASE_PATTERN='^M3 part 5 close-out: commit planning docs [(]the P3 verification and rulings, decision 7 deferred again[)]$'"
      BASE_NEW = "BASE_PATTERN='^M3 part 6 close-out: commit planning docs [(]the P4 verification and rulings, decision 9 deferred again[)]$'"
      TIP_OLD = "TIP_PATTERN='^M3 part 6 close-out: commit planning docs [(]the P4 verification and rulings, decision 9 deferred again[)]$'"
      TIP_NEW = "TIP_PATTERN='^M3 part 7 close-out: commit planning docs [(]the P5 verification and rulings, the Excel check record[)]$'"
      PHASE_OLD = 'Milestone 3 part 6 close-out (specs/0028-images-and-comments-second-half.md, \\"Close-out push (after P4)\\"'
      PHASE_NEW = 'Milestone 3 part 7 close-out (specs/0029-engineering-close.md, \\"Close-out push (after P4)\\"'
      
      
      def gen(name_old, name_new, header, reps):
          s = open(SRC + name_old).read()
          for old, new, n in reps:
              c = s.count(old)
              if c != n:
                  sys.exit("%s: expected %d, found %d: %r" % (name_old, n, c, old[:80]))
              s = s.replace(old, new)
          assert s.startswith("#!/usr/bin/env bash\n")
          s = "#!/usr/bin/env bash\n" + header + s[len("#!/usr/bin/env bash\n"):]
          open(DST + name_new, "w").write(s)
          os.chmod(DST + name_new, 0o755)
          print("wrote", name_new)
      
      
      PUSH_HEADER = """# Milestone 3 part 7 close-out push.log
      # (specs/0029-engineering-close.md, "Close-out push (after P4)", as amended
      # 2026-10-09, "The Excel check", and "Planning rulings during P4
      # (2026-10-09)" rulings 3 and 4).
      #
      # CARRIED TO M3 part 7 from part 6's close-out push script (printed in
      # records/logs/m3p6-close/push.log, whose own change list follows). Every
      # check, control and helper is that text's, unchanged, except:
      # 19. The names are M3 part 7's, the spec cited is specs/0029, the base is
      #     part 6's close-out doc commit (046cfb8 when this was written),
      #     resolved from git by its subject, and the record commit made after
      #     part 6's push (bafd780, subject "M3 part 6 close-out record";
      #     specs/0029 "Close-out push (after P4)") is checked to be in the
      #     range exactly once. The usage names m3p7close-push.sh. The script,
      #     its library copy and each attempt's output are kept under
      #     <home>/.cache/emend-build/m3p7-close/. The library is
      #     scripts/counting.sh as the repository holds it since part 7 P1
      #     (its removal written with the guarded form); part 6's copy differed
      #     from it on that one line. Change 8 and change 14 (the guarded exit
      #     trap) stand unchanged.
      # 20. The Excel-record check (specs/0029 "The Excel check"; P4 ruling 3):
      #     pre mode checks, at the tip, that exactly one file matches
      #     records/excel-check-m2-*.md, that it holds a "## Results" heading
      #     and at least one table row whose result cell reads pass, repair or
      #     fail, and that the tip commit's message names the file's path exactly
      #     once, by the named function excel_record_ok; its control is a clone
      #     of the repository whose tip has the record removed, refused. The
      #     check says only that the record is there and in that form;
      #     acceptance of what it shows is planning's verification.
      #
      # Part 6's text:
      """
      EXCEL_FUNCS = r'''# Change 20 (specs/0029 "The Excel check"; "Planning rulings during P4
      # (2026-10-09)" ruling 3): the Excel-record check of pre mode, run in the git
      # repository of the current directory at HEAD. Exactly one file matches
      # records/excel-check-m2-*.md; it holds a line "## Results" and, after it,
      # at least one table row whose cell under the "result" column reads pass,
      # repair or fail (a by-hand row's "(by hand)" mark allowed after the word);
      # HEAD's message names the file's path exactly once. A table's header row is
      # the row with a cell reading "result", and each table under "## Results"
      # takes its own (the template's corpus and fixture tables). It prints nothing (it
      # is called inside yn) and returns 0 when all three hold, 1 otherwise. Its
      # argument is a directory it writes its three scratch files into.
      excel_record_ok() {
        local d=${1:?a scratch directory} f n
        git ls-tree -r --name-only HEAD -- records/ >"$d/xr-tree" || return 1
        LC_ALL=C /usr/bin/grep -E '^records/excel-check-m2-[^/]*[.]md$' "$d/xr-tree" >"$d/xr-files"
        [ "$(wc -l <"$d/xr-files")" -eq 1 ] || return 1
        f=$(cat "$d/xr-files")
        git show "HEAD:$f" >"$d/xr-blob" || return 1
        n=$(awk -F'|' '
          $0 == "## Results" { r = 1; next }
          r && /^## / { r = 0 }
          r && /^[|]/ {
            h = 0
            for (i = 2; i < NF; i++) { c = $i; gsub(/^ +| +$/, "", c); if (c == "result") { col = i; h = 1 } }
            if (h || !col) next
            c = $col; gsub(/^ +| +$/, "", c)
            if (c ~ /^(pass|repair|fail)( [(]by hand[)])?$/) k++
          }
          END { print k + 0 }' "$d/xr-blob")
        [ "$n" -ge 1 ] || return 1
        git log -1 --format=%B HEAD >"$d/xr-msg" || return 1
        [ "$(LC_ALL=C /usr/bin/grep -o -F -e "$f" "$d/xr-msg" | wc -l)" -eq 1 ]
      }
      # The same check's negation, for its control.
      excel_record_refused() { if excel_record_ok "$1"; then return 1; else return 0; fi; }
      # What the check reads, printed beside it: the matching paths, the result rows
      # and the times HEAD's message names the path.
      excel_record_show() {
        local d=${1:?a scratch directory} f
