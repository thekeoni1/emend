    echo "  the spec at the phase commit: sha256 $spec_committed; the pin: $SPEC_WANT"
    echo "  the working tree's copy (planning's uncommitted rulings): sha256 $spec_now"
    spec_ok() { [ "$spec_committed" = "$SPEC_WANT" ]; }
    check "the spec at the phase commit is at the pinned hash" "$(yn spec_ok)"
    spec_ctl() { local spec_committed=1111111111111111111111111111111111111111111111111111111111111111; spec_ok; }
    check "control: the same check refuses the spec against another hash" "$(ynnot spec_ctl)"
    echo "command: podman image exists $IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    
    echo
    echo "## the release binaries size.log hashed, run where it built them"
    echo "command: sha256sum <the size.log>, and sed for its hash: lines (\"hash: <name> <target> <sha256>\")"
    if [ -f "$SIZE_LOG" ]; then echo "  the size.log: sha256 $(sha_of "$SIZE_LOG"), $(wc -c <"$SIZE_LOG") bytes"; else echo "  the size.log: MISSING"; fi
    size_log_phase() { [ -f "$SIZE_LOG" ] && [ "$(count_matches -E "^about: M4 part 1 P3 phase commit $C; HEAD at run: $C\$" "$SIZE_LOG")" = 1 ] && [ "$(count_matches -xF 'size log checks all as expected: yes' "$SIZE_LOG")" = 1 ]; }
    check "size.log is this phase's, at this phase commit, and ends all as expected" "$(yn size_log_phase)"
    size_ctl() { local C=$NULL_SHA; size_log_phase; }
    check "control: the same check says no for the null commit" "$(ynnot size_ctl)"
    size_hash() { [ -f "$SIZE_LOG" ] && sed -n "s/^hash: $1 $2 \([0-9a-f]\{64\}\)\$/\1/p" "$SIZE_LOG"; }
    PT_host=$BUILD_ROOT/release/emend-copy
    XD_host=$BUILD_ROOT/release/xlsx-diff
    PT_i686=$BUILD_ROOT/$I686/release/emend-copy
    XD_i686=$BUILD_ROOT/$I686/release/xlsx-diff
    bin_is_hashed() {
      local given
      given=$(size_hash "$1" "$2")
      [ -f "$3" ] && [ -n "$given" ] && [ "$(sha_of "$3")" = "$given" ] && [ "$(size_hash "$1" "$2" | count_lines /dev/stdin)" = 1 ]
    }
    show_bin() {
      if [ -f "$3" ]; then
        echo "  $3: sha256 $(sha_of "$3"), bytes $(stat -c %s "$3"); size.log's hash: line: $(size_hash "$1" "$2")"
      else
        echo "  $3: MISSING; size.log's hash: line: $(size_hash "$1" "$2")"
      fi
      check "$1 $2 is the binary size.log hashed, once" "$(yn bin_is_hashed "$1" "$2" "$3")"
    }
    show_bin emend-copy host "$PT_host"
    show_bin xlsx-diff host "$XD_host"
    if [ -n "$BOTH" ]; then
      show_bin emend-copy "$I686" "$PT_i686"
      show_bin xlsx-diff "$I686" "$XD_i686"
    fi
    hash_ctl() { [ -z "$(size_hash emend-copy no-such-target)" ]; }
    check "control: the hash reader finds nothing for a target size.log does not name" "$(yn hash_ctl)"
    check "control: bin_is_hashed refuses xlsx-diff offered as emend-copy" "$(ynnot bin_is_hashed emend-copy host "$XD_host")"
    echo "  $(rustc --version)"
    
    echo
    echo "## the corpus manifest"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv" >"$B/order"
    manifest_rows=$(count_lines "$B/order")
    echo "command: awk over <corpus>/manifest.tsv's id and ext columns by header name"
    echo "  manifest rows: $manifest_rows"
    check "the manifest names some workbook" "$(yn [ "$manifest_rows" -ge 1 ])"
    
    echo
    echo "## the earlier run directories, each named by a committed record or log"
    # The four part-6 samples: part 7 P3's run log at its record commit, its
    # "the run directories:" line.
    P3_LINE=$(git show "$P3_REC:records/logs/m3p7-p3/run.log" | LC_ALL=C "$G" -E '^the run directories: ')
    echo "command: git show <part 7 P3's record commit>:records/logs/m3p7-p3/run.log, its \"the run directories:\" line"
    echo "  $P3_LINE"
    check "part 7 P3's record commit holds its run log with one \"the run directories:\" line" "$(yn [ "$(printf '%s\n' "$P3_LINE" | count_lines /dev/stdin)" = 1 ])"
    declare -A PREV_OF
    for s in $BOTH; do
      PREV_NAME=$(printf '%s\n' "$P3_LINE" | tr ' ,;' '\n\n\n' | sed -n "s#^<runs>/\\(.*-$s\\)\$#\\1#p")
      PREV_OF[$s]=$CORPUS/runs/$PREV_NAME
      echo "  $s: part 7 P3's run directory <corpus>/runs/$PREV_NAME"
      check "$s: part 7 P3's run log names one run directory for the sample, 2026-10-09-09d2e0f-$s" "$(yn [ "$PREV_NAME" = "2026-10-09-09d2e0f-$s" ])"
    done
    # The twenty-three host samples: part 7 P5's committed record of each, its
    # "Written by ... from the run directory `...`" line.
    for s in $HOSTONLY; do
      P5_MD=$(git show --name-only --format= "$P5_REC" | LC_ALL=C "$G" -E "^records/m3p7-p5-$s-2[^/]*[.]md\$")
      PREV_NAME=$(git show "$P5_REC:$P5_MD" 2>/dev/null | sed -n 's/^Written by `scripts\/passthrough-record.py` from the run directory `\([^`]*\)`.*/\1/p')
      PREV_OF[$s]=$CORPUS/runs/$PREV_NAME
      echo "  $s: part 7 P5's record ${P5_MD:-none} names <corpus>/runs/$PREV_NAME"
      check "$s: part 7 P5's record commit adds one record for the sample, naming 2026-10-09-f39bc7b-$s" "$(yn [ "$PREV_NAME" = "2026-10-09-f39bc7b-$s" ])"
    done
    prev_dir_ok() { local l; for l in $2; do [ -s "$1/summary.$l.tsv" ] && [ -s "$1/run.$l.tsv" ] || return 1; done; }
    prev_args() { awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$1/run.$2.tsv"; }
    for s in $BOTH $HOSTONLY; do
      check "$s: the earlier run directory is there, with the summary and run row of each label this log runs (${LABELS_OF[$s]})" "$(yn prev_dir_ok "${PREV_OF[$s]}" "${LABELS_OF[$s]}")"
      check "$s: the earlier run's tool_args is ${TOOLARG_OF[$s]}" "$(yn [ "$(prev_args "${PREV_OF[$s]}" host)" = "${TOOLARG_OF[$s]}" ])"
    done
    check "control: prev_dir_ok refuses a run directory that is not there" "$(ynnot prev_dir_ok "$B/no-such-run" host)"
    
    # outcomes <summary>: per workbook, every summary column but the two
    # measured ones (wall_s, peak_rss_kb), sorted by id: the outcome, exit, the
    # entry totals, the flags and the open checks (lo, lo_in).
    outcomes() { awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i != "wall_s" && $i != "peak_rss_kb") keep[i] = 1; n = NF; next } { line = ""; for (i = 1; i <= n; i++) if (keep[i]) line = line (line == "" ? "" : "\t") $i; print line }' "$1" | LC_ALL=C sort; }
    outcome_of() { awk -F'\t' -v id="$2" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id { print $k["outcome"] }' "$1"; }
    refusal_of() { sed -n '1s/^error: //p' "$1/$2/stderr.$3.txt"; }
    # same_as_prev <this run dir> <earlier run dir> <label> <tag>: every
    # workbook's summary row (but its two measured columns) the earlier run's;
    # every ok workbook's output by sha256, line and diff table the earlier run's;
    # every refused workbook's error line the earlier run's. Prints per workbook
    # and the totals (part 7 P3's form, extended to the whole summary row).
    same_as_prev() {
      local now_dir=$1 prev_dir=$2 label=$3 tag=$4 id ext now prev nsame=0 nlines=0 ndiff=0 nok=0 nref=0 nrefsame=0 st
      outcomes "$now_dir/summary.$label.tsv" >"$B/o-now-$tag-$label"
      outcomes "$prev_dir/summary.$label.tsv" >"$B/o-prev-$tag-$label"
      echo "  rows: this run $(count_lines "$B/o-now-$tag-$label"); the earlier run $(count_lines "$B/o-prev-$tag-$label")"
      while IFS="$TAB" read -r id ext; do
        st=$(outcome_of "$now_dir/summary.$label.tsv" "$id")
        if [ "$st" != ok ]; then
          nref=$((nref + 1))
          if cmp -s "$now_dir/$id/stderr.$label.txt" "$prev_dir/$id/stderr.$label.txt"; then nrefsame=$((nrefsame + 1)); else echo "    $id: the error lines differ"; fi
          continue
        fi
        nok=$((nok + 1))
        now=$(sha_of "$now_dir/$id/out.$label.$ext"); prev=$(sha_of "$prev_dir/$id/out.$label.$ext")
        printf '    %s %s: sha256 here %s, earlier %s\n' "$id" "$label" "$now" "$prev"
        if [ "$now" = "$prev" ]; then nsame=$((nsame + 1)); else echo "    $id: the outputs differ"; fi
        if cmp -s "$now_dir/$id/stdout.$label.txt" "$prev_dir/$id/stdout.$label.txt"; then nlines=$((nlines + 1)); else echo "    $id: the lines differ"; fi
        if cmp -s "$now_dir/$id/diff.$label.tsv" "$prev_dir/$id/diff.$label.tsv"; then ndiff=$((ndiff + 1)); else echo "    $id: the diff tables differ"; fi
      done <"$B/order"
      echo "  $tag $label: ok workbooks $nok; outputs equal to the earlier run's by sha256 $nsame; lines equal byte for byte $nlines; diff tables equal $ndiff; refused workbooks $nref; their error lines equal $nrefsame"
      printf '%s %s %s %s %s %s\n' "$nok" "$nsame" "$nlines" "$ndiff" "$nref" "$nrefsame" >"$B/same-$tag-$label"
    }
    # same_counts_ok <tag> <label>: the summary rows equal, every workbook read,
    # every ok output, line and diff table and every refusal's error line equal.
    same_counts_ok() {
      local nok nsame nlines ndiff nref nrefsame
      read -r nok nsame nlines ndiff nref nrefsame <"$B/same-$1-$2"
      cmp -s "$B/o-now-$1-$2" "$B/o-prev-$1-$2" && [ "$((nok + nref))" = "$manifest_rows" ] && [ "$nsame" = "$nok" ] && [ "$nlines" = "$nok" ] && [ "$ndiff" = "$nok" ] && [ "$nrefsame" = "$nref" ]
    }
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    
    # The six refusals the printarea sample makes (specs/0030 item 1, read from
    # the committed spec, never typed): the ids between the parentheses that
    # begin with the first.
    SIX=$(git show "$C:$SPEC" | tr '\n' ' ' | LC_ALL=C "$G" -o -E '\(054df34b1472[^)]*\)' | tr -d '(),' | tr -s ' ' '\n' | LC_ALL=C "$G" -E '^[0-9a-f]{12}$' | LC_ALL=C sort | paste -sd' ')
    echo "command: git show <phase commit>:$SPEC, item 1's parenthesis of six ids"
    echo "  the six ids: $SIX"
    check "item 1 names six ids" "$(yn [ "$(printf '%s\n' $SIX | count_lines /dev/stdin)" = 6 ])"
    error_ids() { awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["outcome"] == "error" { print $k["id"] }' "$1" | LC_ALL=C sort | paste -sd' '; }
    
    echo
    echo "## TMPDIR for the corpus runs, on the disk"
    RUNTMP=$B/tmp-run
    mkdir "$RUNTMP" || exit 2
    dev_tmp=$(stat -c %d "$RUNTMP")
    dev_corpus=$(stat -c %d "$CORPUS/corpus")
    dev_proc=$(stat -c %d /proc)
    echo "command: mkdir <work>/tmp-run; stat -c %d <work>/tmp-run <corpus>/corpus /proc"
    echo "  device of TMPDIR (<work>/tmp-run): $dev_tmp; of the corpus directory: $dev_corpus; of /proc (the control): $dev_proc"
    check "TMPDIR for the corpus runs and the corpus directory are on one device" "$(yn [ "$dev_tmp" = "$dev_corpus" ])"
    check "control: the same comparison tells /proc's device from the corpus directory's" "$(yn [ "$dev_proc" != "$dev_corpus" ])"
    
    cp "$SELF_DIR/run_reccheck.py" "$B/reccheck.py" || exit 2
    echo "command: cp <scripts>/run_reccheck.py <work>/reccheck.py (part 7 P3's record check, carried byte for byte): sha256 $(sha_of "$B/reccheck.py")"
    fams_of() {
      python3 -c 'import importlib.util, sys
    spec = importlib.util.spec_from_file_location("record", sys.argv[1])
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    rows = [l.split("\t", 1) for l in open(sys.argv[2]).read().split("\n") if l]
    print(",".join(sorted({record.family(n) for (k, n) in rows if k == sys.argv[3]})))' scripts/passthrough-record.py "$1" "$2"
    }
    inst_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
    no_pycache() { [ ! -e scripts/__pycache__ ]; }
    bin_line() { printf -- '- Binaries (%s): passthrough sha256 %s; xlsx-diff sha256 %s' "$1" "$(sha_of "$2")" "$(sha_of "$3")"; }
    
    for s in $BOTH $HOSTONLY; do
      O=${OUT_OF[$s]}
      EDIT=${TOOLARG_OF[$s]}
      for label in ${LABELS_OF[$s]}; do
        var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
        echo
        echo "## $s: $label run, --tool-arg $EDIT, against <corpus>/runs/${PREV_OF[$s]#"$CORPUS/runs/"}"
        echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --out <runs>/$RUN-$s --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
        started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$O" \
          --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
          >"$B/run-$s-$label.stdout" 2>"$B/run-$s-$label.stderr" </dev/null
        rc=$?
        echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$s-$label.stderr")"
        sed 's/^/    /' "$B/run-$s-$label.stdout"
        check "$s $label: the run exits 0" "$(yn [ "$rc" = 0 ])"
        check "$s $label: its stderr is empty" "$(yn [ ! -s "$B/run-$s-$label.stderr" ])"
        n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
        echo "  entries left in <work>/tmp-run after the run: $n_left"
        check "$s $label: the runs' TMPDIR is empty after the run" "$(yn [ "$n_left" = 0 ])"
        SUM=$O/summary.$label.tsv
        rows=$(awk 'NR > 1' "$SUM" | wc -l)
        echo "  summary rows: $rows; outcome ok: $(count_where "$SUM" outcome ok); error: $(count_where "$SUM" outcome error); lo ok $(count_where "$SUM" lo ok); lo_in ok $(count_where "$SUM" lo_in ok); leftover no $(count_where "$SUM" leftover no)"
        check "$s $label: the summary has one row per manifest row" "$(yn [ "$rows" = "$manifest_rows" ])"
        same_as_prev "$O" "${PREV_OF[$s]}" "$label" "$s"
        check "$s $label: every workbook's summary row (but wall_s and peak_rss_kb), output (sha256), line, diff table and error line are the earlier run's" "$(yn same_counts_ok "$s" "$label")"
        if [ "$s" = printarea ]; then
          got=$(error_ids "$SUM")
          echo "  the printarea run's error ids: ${got:-none}; ok rows $(count_where "$SUM" outcome ok)"
          check "printarea $label: the refused workbooks are the six of specs/0030 item 1" "$(yn [ "$got" = "$SIX" ])"
          check "printarea $label: the other $((manifest_rows - 6)) workbooks are ok" "$(yn [ "$(count_where "$SUM" outcome ok)" = "$((manifest_rows - 6))" ])"
        fi
        R=$O/run.$label.tsv
        args=$(prev_args "$O" "$label")
        bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
        check "$s $label: the run row records the two release binaries by sha256 and the phase commit" "$(yn bins_in_row)"
        check "$s $label: the run row's tool_args is $EDIT" "$(yn [ "$args" = "$EDIT" ])"
      done
      if [ "${LABELS_OF[$s]}" = "host i686" ]; then
        echo
        echo "### $s: the two labels' outputs"
        same_out=0; nboth=0
        while IFS="$TAB" read -r id ext; do
          [ "$(outcome_of "$O/summary.host.tsv" "$id")" = ok ] || continue
          nboth=$((nboth + 1))
          if cmp -s "$O/$id/out.host.$ext" "$O/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
        done <"$B/order"
        echo "  ok workbooks: $nboth; whose host and i686 outputs are byte for byte the same: $same_out"
        check "$s: every output is the same on both targets" "$(yn [ "$same_out" = "$nboth" ])"
      fi
    
      echo
      echo "## the $s run's record pair"
      STEM=${STEM_OF[$s]}
      if [ "${LABELS_OF[$s]}" = host ]; then SINGLE=--allow-single; NLAB=1; else SINGLE=""; NLAB=2; fi
      echo "command: scripts/passthrough-record.py --run <runs>/$RUN-$s --out <scripts>/out/records --stem $STEM${SINGLE:+ $SINGLE}"
      scripts/passthrough-record.py --run "$O" --out "$RECORDS" --stem "$STEM" $SINGLE >"$B/record-$s.out" 2>&1
      rrc=$?
      sed 's/^/    /' "$B/record-$s.out"
      check "$s: the record script exits 0" "$(yn [ "$rrc" = 0 ])"
      RTXT=$RECORDS/$STEM.txt
      RMD=$RECORDS/$STEM.md
      echo "  the record's binaries lines:"
      LC_ALL=C "$G" -E '^- Binaries ' "$RMD" | sed 's/^/    /'
      bin_lines_ok() {
        [ "$(count_matches -Fx "$(bin_line host "$PT_host" "$XD_host")" "$RMD")" = 1 ] || return 1
        if [ "$NLAB" = 2 ]; then [ "$(count_matches -Fx "$(bin_line i686 "$PT_i686" "$XD_i686")" "$RMD")" = 1 ] || return 1; fi
        [ "$(count_matches -E '^- Binaries ' "$RMD")" = "$NLAB" ]
      }
      check "$s: the record's header names the binaries this log ran, one line per label ($NLAB)" "$(yn bin_lines_ok)"
      bin_ctl() { [ "$(count_matches -Fx "$(bin_line host "$XD_host" "$PT_host")" "$RMD")" = 1 ]; }
      check "control: $s: the same form finds no line with the two binaries swapped" "$(ynnot bin_ctl)"
      : >"$B/w-$s.parts"
      awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] ~ /^(changed|added|dropped)$/ { print $k["status"] "\t" $k["name"] }' "$O/entries.host.tsv" >>"$B/w-$s.parts"
      FAM_CHANGED=$(fams_of "$B/w-$s.parts" changed)
      FAM_ADDED=$(fams_of "$B/w-$s.parts" added)
      FAM_DROPPED=$(fams_of "$B/w-$s.parts" dropped)
      echo "  the families from the host entries table: changed ${FAM_CHANGED:-none}; added ${FAM_ADDED:-none}; dropped ${FAM_DROPPED:-none}"
      python3 "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/reccheck-$s.out" 2>&1
      echo "  exit: $?"
      sed 's/^/    /' "$B/reccheck-$s.out"
      n_rec_want=$((4 + 6 * NLAB + 2))
      rec_all() { [ "$(count_matches -E ': yes$' "$B/reccheck-$s.out")" = "$n_rec_want" ] && [ "$(count_matches -E ': no$' "$B/reccheck-$s.out")" = 0 ]; }
      check "$s: the record's three tables are the run directory's, and its family tables are counted from them ($n_rec_want checks: four, six per label, two)" "$(yn rec_all)"
      sed '2d' "$RTXT" >"$B/c-rec.txt"
      python3 "$B/reccheck.py" scripts/passthrough-record.py "$O" "$B/c-rec.txt" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/c-reccheck2.out" 2>&1
      python3 "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "planted" "$EDIT" >"$B/c-reccheck3.out" 2>&1
      rec_ctl() { [ "$(count_matches -F "the summary table is every label's summary: no" "$B/c-reccheck2.out")" = 1 ]; }
      check "control: $s: the same check finds a .txt one summary row short" "$(yn rec_ctl)"
      rec_drop() { [ "$(count_matches -E "the dropped entries' families are planted: no\$" "$B/c-reccheck3.out")" = "$NLAB" ]; }
      check "control: $s: the same check finds the dropped families differ from a planted family, on each label" "$(yn rec_drop)"
      check "$s: the record script and the record check left no scripts/__pycache__" "$(yn no_pycache)"
      echo "command: install -m 644 <scripts>/out/records/$STEM.md <scripts>/out/records/$STEM.txt $RECORDS_DEST/"
      install -m 644 "$RMD" "$RTXT" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM.md" "$RECORDS_DEST/$STEM.txt")
      echo "  exit: $?"
      for f in "$STEM.md" "$STEM.txt"; do
        echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
        check "the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
      done
    done
    
    echo
    echo "## the comparison's controls"
    first_s=$(printf '%s\n' $BOTH $HOSTONLY | head -n 1)
    cp "$B/same-$first_s-host" "$B/c-same-host"
    read -r a1 a2 a3 a4 a5 a6 <"$B/c-same-host"
    printf '%s %s %s %s %s %s\n' "$a1" "$((a2 - 1))" "$a3" "$a4" "$a5" "$a6" >"$B/same-$first_s-host"
    check "control: same_counts_ok refuses planted totals with one output unequal" "$(ynnot same_counts_ok "$first_s" host)"
    cp "$B/c-same-host" "$B/same-$first_s-host"
    cp "$B/o-now-$first_s-host" "$B/c-o-now"
    sed "1s/${TAB}ok${TAB}/${TAB}error${TAB}/" "$B/c-o-now" >"$B/o-now-$first_s-host"
    check "control: same_counts_ok refuses a planted summary row whose outcome differs" "$(ynnot same_counts_ok "$first_s" host)"
    cp "$B/c-o-now" "$B/o-now-$first_s-host"
    check "control: same_counts_ok passes the restored tables" "$(yn same_counts_ok "$first_s" host)"
    printf 'id\toutcome\nx1\terror\nx2\tok\nx0\terror\n' >"$B/c-sum.tsv"
    check "control: error_ids reads a planted summary's error ids by the header, sorted" "$(yn [ "$(error_ids "$B/c-sum.tsv")" = "x0 x1" ])"
    printf 'id\tlabel\twall_s\tpeak_rss_kb\toutcome\nx1\thost\t1.0\t5\tok\n' >"$B/c-o1.tsv"
    printf 'id\tlabel\twall_s\tpeak_rss_kb\toutcome\nx1\thost\t9.9\t7\tok\n' >"$B/c-o2.tsv"
    check "control: outcomes reads two rows differing only in wall_s and peak_rss_kb as equal" "$(yn [ "$(outcomes "$B/c-o1.tsv")" = "$(outcomes "$B/c-o2.tsv")" ])"
    printf 'id\tlabel\twall_s\tpeak_rss_kb\toutcome\nx1\thost\t1.0\t5\terror\n' >"$B/c-o3.tsv"
    check "control: outcomes tells a row whose outcome differs" "$(yn [ "$(outcomes "$B/c-o1.tsv")" != "$(outcomes "$B/c-o3.tsv")" ])"
    
    echo
    echo "## the record files this run installed hold no path"
    n_inst_want=0
    for s in $BOTH $HOSTONLY; do n_inst_want=$((n_inst_want + 2)); done
    echo "  record files installed by this run: ${#INSTALLED[@]} (two per sample: $n_inst_want)"
    no_path() {
      local f
      [ "${#INSTALLED[@]}" -ge 1 ] || return 1
      for f in "${INSTALLED[@]}"; do
        [ "$(count_matches -F "$HOME" "$f")" = 0 ] || return 1
        [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$f")" = 0 ] || return 1
      done
    }
    check "no record file this run installed names <home>, a home, mount, temporary or corpus path" "$(yn no_path)"
    check "this run installed two record files per sample" "$(yn [ "${#INSTALLED[@]}" = "$n_inst_want" ])"
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x' >"$B/c-path"
    path_ctl() { [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$B/c-path")" = 1 ]; }
    check "control: the same form finds a planted path" "$(yn path_ctl)"
    
    if [ "$DRY" = yes ]; then
      echo
      echo "## a dry run: its run directory and records removed (directories this run created)"
      for s in $HOSTONLY; do
        DRY_OUT=${OUT_OF[$s]}
        echo "command: rm -rf <runs>/$RUN-$s"
        rm -rf "${DRY_OUT:?}"
      done
      DRY_REC=$RECORDS_DEST
      echo "command: rm -rf <scripts>/out/dry-records"
      case "$DRY_REC" in "$SELF_DIR/out/dry-records") rm -rf "${DRY_REC:?}" ;; *) echo "  RECORDS_DEST is not <scripts>/out/dry-records; kept" ;; esac
    fi
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  planning's uncommitted spec: $SPEC, sha256 $(sha_of "$SPEC")"
    echo "status lines: $st_all; of them this phase's logs, its records or planning's uncommitted spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## the record check this log runs (<scripts>/run_reccheck.py, part 7 P3's, carried byte for byte)
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names. Change VJ: the dropped families are an
    input, as the changed and added ones are."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, want_changed, want_added, want_dropped, tool_arg = sys.argv[1:9]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    def listed(value):
        return value.split(",") if value else []
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        changed_f = sorted(f for f in fam if fam[f].get("changed"))
        dropped_f = sorted(f for f in fam if fam[f].get("dropped"))
        added_f = sorted(f for f in fam if fam[f].get("added"))
        checks.append(("%s: the xml families are the changed entries' families" % label, sorted(xf) == changed_f))
        checks.append(("%s: the changed entries' families are %s" % (label, want_changed or "none"), changed_f == listed(want_changed)))
        checks.append(("%s: the dropped entries' families are %s" % (label, want_dropped or "none"), dropped_f == listed(want_dropped)))
        checks.append(("%s: the added entries' families are %s" % (label, want_added or "none"), added_f == listed(want_added)))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: " + tool_arg in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))

