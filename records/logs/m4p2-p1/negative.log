    #
    # Usage: m4p2-p1-negative.sh <phase commit> > <file outside the tree>; the
    # caller moves the output to records/logs/m4p2-p1/negative.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/negative.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR
    PHASE_DIR=$HOME/.cache/emend-build/m4p2-p1
    BUILD_ROOT=${NEGATIVE_BUILD:-$PHASE_DIR/negative}
    SUPERSEDED_DIR=$PHASE_DIR/superseded
    SPEC=specs/0031-release-metadata.md
    SPEC_WANT=18cab49d4c6906a7a2b37ecddcc88da03b372410832cdf0484f7e1247bb4c44a
    mkdir -p "$BUILD_ROOT" || exit 2
    # Change HC: this run's own directory under <build>, removed at the end.
    B=$(mktemp -d -p "$BUILD_ROOT") || exit 2
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT_SHA=${C:0:7}
    # This phase's logs and planning's uncommitted spec (change HA).
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m4p2-p1/| M specs/0031-release-metadata[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs and planning's spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$B#<scratch>/w#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$SUPERSEDED_DIR#<superseded>#g" \
        -e "s#$PHASE_DIR#<phase>#g" \
        -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "input: RERUN_NOTE: ${RERUN_NOTE:-unset}"
    echo "input: RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: HOME: set, read for the paths under it, printed as <home>"
    echo "input: NEGATIVE_BUILD: ${NEGATIVE_BUILD:-unset} (the build root, <build>)"
    echo "about: M4 part 2 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M4 part 1 close-out record: the push, the CI run and the scan')
    DOC1=$(by_subject "M4 part 2 P1: commit planning docs (the part 1 close-out verification and rulings, specs/0031)")
    CL1=$(by_subject "M4 part 2 P1: CHANGELOG.md, the unreleased section written from the specs and records")
    DC1=$(by_subject "M4 part 2 P1: the crate-level doc comment rewritten from the README")
    PK1=$(by_subject "M4 part 2 P1: the README and the licence texts in the package")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's full subject>, for each role"
    echo "  the previous phase's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  the code commit of the CHANGELOG: ${CL1:-none}"
    echo "  the code commit of the doc comment (decision 3): ${DC1:-none}"
    echo "  the code commit of the README and the licence texts (decision 4), the phase commit: ${PK1:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$PK1" "$DC1" "$CL1" "$DOC1" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the three code commits, the doc commit and the base, each the next one's parent, the decision-4 commit the phase commit (change HA)" "$(yn roles_in_order)"
    roles_ctl() { local PK1=$DC1; roles_in_order; }
    check "control: roles_in_order refuses the doc-comment commit named as the phase commit" "$(ynnot roles_ctl)"
    roles_ctl2() { local CL1=$DOC1; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the CHANGELOG commit" "$(ynnot roles_ctl2)"
    echo
    echo "phase: Milestone 4 part 2 P1 ($SPEC) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "rerun: the superseded files are kept in <superseded>"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this log builds nothing and runs no binary: it runs the run log's check programs over planted copies in <scratch>/w (change HB)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh, the spec, README.md, CHANGELOG.md and the doc-comment commit's diff are read from it by git show and git diff at the phase commit, the working spec is hashed in it, and its tree is listed; nothing in it is run, built or written"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m4p2-p1, the phase's directory on the disk"
    echo "root: <scripts> stands for <phase>/scripts, this script's own directory on the disk, which holds the script, the programs under test (readme_check.py, changelog_check.py, p1_checks.sh; read, hashed and copied, never run in place) and, in <scripts>/out, its own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <build> stands for the build root on the disk, <phase>/negative unless NEGATIVE_BUILD names another"
    echo "root: <superseded> stands for <phase>/superseded, where a rerun's superseded files are kept; read only"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory under <build>, removed by this script at its end (change HC): <scratch>/w/counting.sh the phase commit's library, sourced; <scratch>/w/prog the copies of the programs under test, run from there; the files read at the phase commit, the planted copies and the captured outputs (*.out)"
    echo "root: <close> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change HD)"
    echo "root: <gatebuild> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change HD)"
    echo "root: <target> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change HD)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$BUILD_ROOT" && apart "$SUPERSEDED_DIR" "$MAIN"; }
    check "the roots other than <home> and <phase> are distinct, none inside another (<scratch>/w inside <build>)" "$(yn roots_distinct)"
    roots_ctl() { apart "$B" "$BUILD_ROOT"; }
    check "control: apart refuses <scratch>/w against <build>, which holds it" "$(ynnot roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them this phase's logs or planning's spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT_SHA")"
    short_names_head() { [ "$(git rev-parse "$SHORT_SHA")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_src_ctl() { printf ' M crates/emend/src/lib.rs\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified crate source" "$(ynnot ours_src_ctl)"
    ours_cl_ctl() { printf ' M CHANGELOG.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified CHANGELOG.md" "$(ynnot ours_cl_ctl)"
    ours_roadmap_ctl() { printf ' M ROADMAP.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified ROADMAP.md (committed and clean in this phase)" "$(ynnot ours_roadmap_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m4p2-p1/gate.log\n?? records/logs/m4p1-p2/gate.log\n?? records/logs/m4p2-p1x/gate.log\n M ROADMAP.md\n M specs/0031-release-metadata.md\n?? specs/0031-release-metadata.md\n M specs/0030-carries-and-api-changes.md\n' | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern takes this phase's log and planning's modified spec alone, no other phase's log, no sibling directory, no untracked spec and no other spec (change HA)" "$(yn [ "$(ours_rec_ctl)" = 2 ])"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_BLOB=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum: $SPEC_BLOB; sha256sum $SPEC (the working file, printed and not asserted: planning holds its rulings during P1 uncommitted; change HA): $SPEC_HAVE"
    check "the spec's blob at the phase commit is at the hash this log pins" "$(yn [ "$SPEC_BLOB" = "$SPEC_WANT" ])"
    spec_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$SPEC_WANT" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot spec_ctl)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the programs under test, copied into <scratch>/w/prog and run from there (change HB)"
    mkdir "$B/prog" || exit 2
    for p in readme_check.py changelog_check.py p1_checks.sh; do
      cp "$SELF_DIR/$p" "$B/prog/$p"
      echo "command: sha256sum <scripts>/$p: $(sha256sum <"$SELF_DIR/$p" | cut -d' ' -f1); its copy <scratch>/w/prog/$p: $(sha256sum <"$B/prog/$p" | cut -d' ' -f1)"
      sed 's/^/    /' "$B/prog/$p"
    done
    copies_equal() {
      local p
      for p in readme_check.py changelog_check.py p1_checks.sh; do
        [ -s "$SELF_DIR/$p" ] || return 1
        cmp -s "$SELF_DIR/$p" "$B/prog/$p" || return 1
      done
    }
    check "each program's copy is byte-equal to <scripts>' file, none empty" "$(yn copies_equal)"
    copies_ctl() { printf 'x' >>"$B/prog-ctl"; cmp -s "$SELF_DIR/readme_check.py" "$B/prog-ctl"; }
    check "control: the same cmp refuses a file that differs" "$(ynnot copies_ctl)"
    RCHK=$B/prog/readme_check.py
    CCHK=$B/prog/changelog_check.py
    
    echo
    echo "## the files read at the phase commit"
    echo "command: git show <phase commit>:<path> > <scratch>/w/<name>, for README.md and CHANGELOG.md; git ls-tree -r --name-only <phase commit> > <scratch>/w/tree.txt; git diff <the doc-comment commit>^ <the doc-comment commit> -- crates/emend/src/lib.rs > <scratch>/w/libdiff.txt"
    git show "$C:README.md" >"$B/README.md"
    git show "$C:CHANGELOG.md" >"$B/CHANGELOG.md"
    git ls-tree -r --name-only "$C" >"$B/tree.txt"
    git diff "$DC1^" "$DC1" -- crates/emend/src/lib.rs >"$B/libdiff.txt"
    echo "  README.md: $(count_lines "$B/README.md") lines, sha256 $(sha256sum <"$B/README.md" | cut -d' ' -f1)"
    echo "  CHANGELOG.md: $(count_lines "$B/CHANGELOG.md") lines, sha256 $(sha256sum <"$B/CHANGELOG.md" | cut -d' ' -f1)"
    echo "  the tree listing: $(count_lines "$B/tree.txt") paths; the lib.rs diff: $(count_lines "$B/libdiff.txt") lines, sha256 $(sha256sum <"$B/libdiff.txt" | cut -d' ' -f1)"
    inputs_read() { [ -s "$B/README.md" ] && [ -s "$B/CHANGELOG.md" ] && [ -s "$B/tree.txt" ] && [ -s "$B/libdiff.txt" ]; }
    check "the four inputs were read at the phase commit and none is empty" "$(yn inputs_read)"
    inputs_ctl() { local B=$B/prog-none; inputs_read; }
    check "control: the same check refuses a directory without them" "$(ynnot inputs_ctl)"
    # The plants' paths (fictional): neither absent path is in the tree; the
    # existing specs/ path is.
    NO_SPEC=specs/0099-no-such-spec.md
    NO_REC=records/no-such-record-2026-01-01.md
    YES_SPEC=specs/0008-zip-layer.md
    in_tree() { LC_ALL=C "$G" -qx -F "$1" "$B/tree.txt"; }
    check "the planted specs/ path $NO_SPEC is not in the phase commit's tree" "$(ynnot in_tree "$NO_SPEC")"
    check "the planted records/ path $NO_REC is not in the phase commit's tree" "$(ynnot in_tree "$NO_REC")"
    check "the cited specs/ path $YES_SPEC is in the phase commit's tree (N4's sentence cites a path that exists)" "$(yn in_tree "$YES_SPEC")"
    
    # run_check <name> <program> <file>: runs the program from <scratch>/w/prog
    # over <scratch>/w/<file> and the tree listing; keeps <name>.out, .err, .rc;
    # prints the command, the exit, the stderr bytes and the output. It prints,
    # so it is never a check's condition.
    run_check() {
      local name=$1 prog=$2 file=$3 rc
      echo "command: python3 -I <scratch>/w/prog/$(basename "$prog") <scratch>/w/$file <scratch>/w/tree.txt"
      python3 -I "$prog" "$B/$file" "$B/tree.txt" >"$B/$name.out" 2>"$B/$name.err" </dev/null
      rc=$?
      echo "$rc" >"$B/$name.rc"
      echo "  $name: exit $rc; standard error $(wc -c <"$B/$name.err") bytes; standard output:"
      sed 's/^/    /' "$B/$name.out"
    }
    last_line() { tail -n 1 "$B/$1.out"; }
    rc_of() { cat "$B/$1.rc"; }
    summary_has() { printf '%s\n' "$(last_line "$1")" | LC_ALL=C "$G" -qE "^sentences [0-9]+ with-digit [0-9]+ cited [0-9]+ $2\$"; }
    n_uncited() { count_matches -E '^UNCITED unit [0-9]+$' "$B/$1.out"; }
    n_missing_of() { count_matches -xF "MISSING $2" "$B/$1.out"; }
    n_with_digit() { last_line "$1" | awk '{print $4}'; }
    passes() { [ "$(rc_of "$1")" = 0 ] && summary_has "$1" 'uncited 0 missing 0' && [ "$(n_uncited "$1")" = 0 ] && [ ! -s "$B/$1.err" ]; }
    refused_uncited() { [ "$(rc_of "$1")" = 1 ] && summary_has "$1" 'uncited 1 missing 0' && [ "$(n_uncited "$1")" = 1 ] && [ ! -s "$B/$1.err" ]; }
    refused_missing() { [ "$(rc_of "$1")" = 1 ] && summary_has "$1" 'uncited 0 missing 1' && [ "$(n_missing_of "$1" "$2")" = 1 ] && [ ! -s "$B/$1.err" ]; }
    one_more_digit() { [ "$(n_with_digit "$1")" = "$(( $(n_with_digit "$2") + 1 ))" ]; }
    # Controls of the reading helpers, over fixtures in the programs' output form.
    printf 'cited 1 unit 3\nsentences 9 with-digit 1 cited 1 uncited 0 missing 0\n' >"$B/cpass.out"; echo 0 >"$B/cpass.rc"; : >"$B/cpass.err"
    printf 'UNCITED unit 4\nsentences 9 with-digit 1 cited 0 uncited 1 missing 0\n' >"$B/cunc.out"; echo 1 >"$B/cunc.rc"; : >"$B/cunc.err"
    printf 'MISSING %s\nsentences 9 with-digit 1 cited 0 uncited 0 missing 1\n' "$NO_SPEC" >"$B/cmis.out"; echo 1 >"$B/cmis.rc"; : >"$B/cmis.err"
    check "control: passes takes a passing fixture" "$(yn passes cpass)"
    check "control: passes refuses an uncited fixture" "$(ynnot passes cunc)"
    check "control: refused_uncited takes the uncited fixture" "$(yn refused_uncited cunc)"
    check "control: refused_uncited refuses the passing fixture" "$(ynnot refused_uncited cpass)"
    check "control: refused_missing takes the missing fixture for its path" "$(yn refused_missing cmis "$NO_SPEC")"
    check "control: refused_missing refuses the same fixture for another path" "$(ynnot refused_missing cmis "$NO_REC")"
    check "control: refused_missing refuses the uncited fixture" "$(ynnot refused_missing cunc "$NO_SPEC")"
    
    echo
    echo "## N0r and N0c: the files as committed (the controls)"
    run_check N0r "$RCHK" README.md
    check "N0r: the README as committed passes the README check: exit 0, uncited 0 missing 0, nothing on stderr" "$(yn passes N0r)"
    run_check N0c "$CCHK" CHANGELOG.md
    check "N0c: the CHANGELOG as committed passes the CHANGELOG check: exit 0, uncited 0 missing 0, nothing on stderr" "$(yn passes N0c)"
    
    # The plants, each appended after a blank line to a copy (fictional text).
    P_UNC='- Planted: the sample ran 99 times over the corpus.'
    P_SPEC="- Planted: the sample ran 99 times (\`$NO_SPEC\`)."
    P_REC="- Planted: the sample ran 99 times (\`$NO_REC\`)."
    P_EXT="Planted: the sample ran 99 times (\`$YES_SPEC\`)."
    P_HEAD='## 1.0 (planted)'
    plant() { cp "$B/$1" "$B/$2"; printf '\n%s\n' "$3" >>"$B/$2"; }
    
    echo
    echo "## N1: a planted uncited sentence in a CHANGELOG copy"
    echo "  the plant (appended after a blank line): $P_UNC"
    plant CHANGELOG.md N1.md "$P_UNC"
    run_check N1 "$CCHK" N1.md
    check "N1: refused: exit 1, one UNCITED line, uncited 1 missing 0" "$(yn refused_uncited N1)"
    check "N1: the plant adds one sentence holding a digit to N0c's count" "$(yn one_more_digit N1 N0c)"
    check "control: the same N1 check refuses N0c's output" "$(ynnot refused_uncited N0c)"
    
    echo
    echo "## N2: a planted citation of a specs/ path the tree does not hold, in a CHANGELOG copy"
    echo "  the plant (appended after a blank line): $P_SPEC"
    plant CHANGELOG.md N2.md "$P_SPEC"
    run_check N2 "$CCHK" N2.md
    check "N2: refused: exit 1, its MISSING line, uncited 0 missing 1" "$(yn refused_missing N2 "$NO_SPEC")"
    check "control: the same N2 check refuses N0c's output" "$(ynnot refused_missing N0c "$NO_SPEC")"
    
    echo
    echo "## N3: a planted citation of a records/ path the tree does not hold, in a CHANGELOG copy"
    echo "  the plant (appended after a blank line): $P_REC"
    plant CHANGELOG.md N3.md "$P_REC"
    run_check N3 "$CCHK" N3.md
    check "N3: refused: exit 1, its MISSING line, uncited 0 missing 1" "$(yn refused_missing N3 "$NO_REC")"
    check "control: the same N3 check refuses N2's output (another path)" "$(ynnot refused_missing N2 "$NO_REC")"
    
    echo
    echo "## N4: the specs/ extension is the CHANGELOG's alone"
    echo "  the plant (appended after a blank line): $P_EXT"
    plant README.md N4r.md "$P_EXT"
    run_check N4r "$RCHK" N4r.md
    check "N4r: the README check refuses a sentence citing only an existing specs/ path: exit 1, uncited 1 missing 0" "$(yn refused_uncited N4r)"
    check "N4r: the plant adds one sentence holding a digit to N0r's count" "$(yn one_more_digit N4r N0r)"
    plant CHANGELOG.md N4c.md "$P_EXT"
    run_check N4c "$CCHK" N4c.md
    check "N4c (control): the CHANGELOG check accepts the same sentence: exit 0, uncited 0 missing 0" "$(yn passes N4c)"
    check "N4c: the plant adds one sentence holding a digit to N0c's count (it was read, and cited)" "$(yn one_more_digit N4c N0c)"
    
    echo
    echo "## N5: the heading exemption is the CHANGELOG's alone"
    echo "  the plant (appended after a blank line): $P_HEAD"
    plant README.md N5r.md "$P_HEAD"
    run_check N5r "$RCHK" N5r.md
    check "N5r: the README check refuses the planted release heading: exit 1, uncited 1 missing 0" "$(yn refused_uncited N5r)"
    plant CHANGELOG.md N5c.md "$P_HEAD"
    run_check N5c "$CCHK" N5c.md
    check "N5c (control): the CHANGELOG check accepts the same heading: exit 0, uncited 0 missing 0" "$(yn passes N5c)"
    
    echo
    echo "## the run log's shared checks, sourced from <scratch>/w/prog/p1_checks.sh (N6 to N8)"
    echo "command: . <scratch>/w/prog/p1_checks.sh"
    . "$B/prog/p1_checks.sh"
    shared_defined() { declare -F p1_measured_equal >/dev/null && declare -F p1_width_ok >/dev/null && declare -F p1_doc_lines_only >/dev/null; }
    check "the shared file defines p1_measured_equal, p1_width_ok and p1_doc_lines_only" "$(yn shared_defined)"
    shared_ctl() { declare -F p1_no_such_check >/dev/null; }
    check "control: the same declare -F refuses a name the file does not define" "$(ynnot shared_ctl)"
    
    echo
    echo "## N6: one byte changed in a Measured bullet of a CHANGELOG copy (ruling 1)"
    mkdir "$B/n6c" "$B/n6" || exit 2
    echo "command: p1_measured_equal <scratch>/w/CHANGELOG.md <scratch>/w/README.md <scratch>/w/n6c"
    check "N6c (control): the CHANGELOG as committed: its Measured bullets, joined, equal the README's five paragraphs" "$(yn p1_measured_equal "$B/CHANGELOG.md" "$B/README.md" "$B/n6c")"
    echo "  the control's joined bullets: $(count_lines "$B/n6c/m-cl") lines, sha256 $(sha256sum <"$B/n6c/m-cl" | cut -d' ' -f1); the README's paragraphs: $(count_lines "$B/n6c/m-rd") lines, sha256 $(sha256sum <"$B/n6c/m-rd" | cut -d' ' -f1)"
    echo "command: sed '0,/784 of the 917/s//785 of the 917/' <scratch>/w/CHANGELOG.md > <scratch>/w/N6.md (the plant: one digit of the copy-sample bullet)"
    sed '0,/784 of the 917/s//785 of the 917/' "$B/CHANGELOG.md" >"$B/N6.md"
    n6_bytes=$(cmp -l "$B/CHANGELOG.md" "$B/N6.md" | wc -l)
    n6_ab=$(count_matches -F '785 of the 917' "$B/N6.md")
    echo "  bytes differing between the copy and the CHANGELOG (cmp -l | wc -l): $n6_bytes; lines of the copy holding the planted text: $n6_ab"
    n6_one() { [ "$n6_bytes" = 1 ] && [ "$n6_ab" = 1 ] && [ "$(wc -c <"$B/N6.md")" = "$(wc -c <"$B/CHANGELOG.md")" ]; }
    check "N6: the plant changed exactly one byte, in the Measured section's copy-sample bullet" "$(yn n6_one)"
    echo "command: p1_measured_equal <scratch>/w/N6.md <scratch>/w/README.md <scratch>/w/n6"
    check "N6: refused: the planted copy's Measured bullets do not equal the README's paragraphs" "$(ynnot p1_measured_equal "$B/N6.md" "$B/README.md" "$B/n6")"
    
    echo
    echo "## N7: a line of 81 columns in a CHANGELOG copy"
    L80=$(printf '%080d' 0)
    L81=$(printf '%081d' 0)
    cp "$B/CHANGELOG.md" "$B/N7.md"; printf '%s\n' "$L81" >>"$B/N7.md"
    cp "$B/CHANGELOG.md" "$B/N7b.md"; printf '%s\n' "$L80" >>"$B/N7b.md"
    echo "  the plants: a line of ${#L81} zeros appended to <scratch>/w/N7.md; a line of ${#L80} zeros appended to <scratch>/w/N7b.md (the boundary)"
    echo "command: p1_width_ok <file> 80, over the CHANGELOG, N7.md and N7b.md"
    check "N7c (control): the CHANGELOG as committed: no line over 80 columns" "$(yn p1_width_ok "$B/CHANGELOG.md" 80)"
    check "N7: refused: the copy with a line of 81 columns" "$(ynnot p1_width_ok "$B/N7.md" 80)"
    check "N7b (control): the copy with a line of exactly 80 columns passes" "$(yn p1_width_ok "$B/N7b.md" 80)"
    
    echo
    echo "## N8: a code line planted in a copy of the doc-comment commit's lib.rs diff"
    echo "command: awk over <scratch>/w/libdiff.txt, the line \"+pub const PLANTED: u32 = 1;\" inserted after the first hunk header, > <scratch>/w/N8.diff"
    awk '{ print } /^@@ / && !done { print "+pub const PLANTED: u32 = 1;"; done = 1 }' "$B/libdiff.txt" >"$B/N8.diff"
    n8_more=$(( $(count_lines "$B/N8.diff") - $(count_lines "$B/libdiff.txt") ))
    n8_plant=$(count_matches -xF '+pub const PLANTED: u32 = 1;' "$B/N8.diff")
    echo "  lines added to the copy: $n8_more; the planted line in it: $n8_plant"
    n8_one() { [ "$n8_more" = 1 ] && [ "$n8_plant" = 1 ]; }
    check "N8: the plant added exactly the one code line" "$(yn n8_one)"
    echo "command: p1_doc_lines_only <file>, over the diff as committed and N8.diff"
    check "N8c (control): the doc-comment commit's diff of lib.rs as committed: doc lines only" "$(yn p1_doc_lines_only "$B/libdiff.txt")"
    check "N8: refused: the copy with the planted code line" "$(ynnot p1_doc_lines_only "$B/N8.diff")"
    
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.out; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or planning's spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's logs or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this run's directory removed (change HC)"
    echo "command: rm -rf <scratch>/w (this run's own mktemp -d directory, written \"\${B:?}\")"
    rm -rf "${B:?}"
    b_present() { [ -e "$B" ]; }
    check "<scratch>/w is gone" "$(ynnot b_present)"
    check "control: the same test finds <build>, which stays" "$(yn test -e "$BUILD_ROOT")"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    CE=$(mktemp -p "$BUILD_ROOT")
    cp "$ERR" "$CE"; printf 'x' >>"$CE"
    nerr_ctl=$(wc -c <"$CE")
    rm -f "$CE"
    echo "  command: wc -c <scripts>/out/negative.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

