                flush(); cur.append(ln)
                if ln.startswith("#"):
                    flush()
                continue
            cur.append(ln)
        if fence:
            sys.exit("error: an unclosed code fence")
        flush()
        return out
    
    def main():
        if len(sys.argv) != 3:
            print("usage: changelog_check.py <CHANGELOG> <paths-at-HEAD.txt>", file=sys.stderr); sys.exit(2)
        try:
            lines = open(sys.argv[1], encoding="utf-8").read().split("\n")
            tree = set(open(sys.argv[2], encoding="utf-8").read().split("\n"))
