                for p in bad:
                    m += 1; print("MISSING %s" % p)
                if not bad:
                    c += 1; print("cited %d unit %d" % (len(paths), i))
        print("sentences %d with-digit %d cited %d uncited %d missing %d" % (s, d, c, u, m))
        sys.exit(0 if u == 0 and m == 0 else 1)
    
    main()
