    #!/usr/bin/env python3
    """M4 part 2 P2: a listing compared row for row with an API review record's
    item table (specs/0031 "Planning rulings during P2", ruling 3). The record's
    rows are those of part 1's formatter (make_review.py): modules ordered by
    their depth then their name, each module's rows in the listing's order,
    numbered from 1. Each record row's columns map to the listing's fields:
      #        -> the row's number in that order
      item     -> name, or container.name when container is not "-", or
                  "use name" for kind use; a "|" written "\\|" in the record
      kind     -> kind
      feature  -> cfg, or "core" when cfg is "-"
      added by -> added
      spec     -> the spec of the part that added_subject names (the
                  formatter's map), "-" when none
      verdict  -> "keep" for every row (no listing field)
    The line column has no record column. Prints the mapping, one line per
    differing row number ("DIFF <n>") and a summary line "record rows <r>
    listing rows <l> equal <e> differing <d>"; never a row's text. Exit 0 when
    the two hold the same number of rows and none differs, 1 otherwise, 2 on a
    usage or read error.
    Usage: python3 -I listing_vs_record.py <listing.tsv> <record.md>"""
    import re, sys
    
    SPEC = {
        "M1 part 1": "0008", "M1 part 2": "0009", "M1 part 3": "0010", "M1 part 4": "0011",
        "M1 part 5": "0012", "M1 part 6": "0013", "M2 part 1": "0016", "M2 part 2": "0017",
        "M2 part 3": "0018", "M2 part 4a": "0019", "M2 part 4b": "0020", "M2 part 4c": "0021",
        "M2 part 4d": "0022", "M3 part 2": "0024", "M3 part 3": "0025", "M3 part 4": "0026",
        "M3 part 5": "0027", "M3 part 6": "0028", "M4 part 1": "0030",
    }
    
    def spec_of(subject):
        m = re.match(r"^(M\d+ part \d+[a-z]?)", subject)
        return ("specs/" + SPEC[m.group(1)]) if m and m.group(1) in SPEC else "-"
    
    def main():
        if len(sys.argv) != 3:
            print("usage: listing_vs_record.py <listing.tsv> <record.md>", file=sys.stderr)
            sys.exit(2)
        try:
            with open(sys.argv[1], encoding="utf-8") as f:
                header = f.readline().rstrip("\n").split("\t")
                rows = [dict(zip(header, l.rstrip("\n").split("\t"))) for l in f]
            rec_lines = open(sys.argv[2], encoding="utf-8").read().split("\n")
        except (OSError, UnicodeDecodeError) as e:
            print("error: %s" % type(e).__name__, file=sys.stderr)
            sys.exit(2)
        by_module = {}
        for r in rows:
            by_module.setdefault(r["module"], []).append(r)
        want = []
        for module in sorted(by_module, key=lambda m: (m.count("::"), m)):
            for r in by_module[module]:
                name = r["name"] if r["container"] == "-" else "%s.%s" % (r["container"], r["name"])
                if r["kind"] == "use":
                    name = "use %s" % r["name"]
                feature = r["cfg"] if r["cfg"] != "-" else "core"
                want.append([str(len(want) + 1), "`%s`" % name.replace("|", "\\|"), r["kind"],
                             feature.replace("|", "\\|"), r["added"], spec_of(r["added_subject"]), "keep"])
        got = []
        on = False
        for l in rec_lines:
            if l.startswith("## "):
                on = (l == "## The items, by module")
                continue
            if on and re.match(r"^\| [0-9]+ \| ", l):
                cells = [c.strip() for c in re.split(r"(?<!\\)\|", l)[1:-1]]
                got.append(cells)
        print("mapping: # = the row's number (modules by depth then name, rows in the listing's order); item = name, container.name, or use name; kind = kind; feature = cfg, core for -; added by = added; spec = the spec of added_subject's part; verdict = keep; the listing's line has no record column")
        diff = 0
        for i in range(max(len(want), len(got))):
            if i >= len(want) or i >= len(got) or want[i] != got[i]:
                diff += 1
                print("DIFF %d" % (i + 1))
        equal = min(len(want), len(got)) - sum(1 for i in range(min(len(want), len(got))) if want[i] != got[i])
        print("record rows %d listing rows %d equal %d differing %d" % (len(got), len(want), equal, diff))
        sys.exit(0 if diff == 0 and len(got) == len(want) and got else 1)
    
    main()
