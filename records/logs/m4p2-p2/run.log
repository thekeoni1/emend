    sed 's/^/    /' "$P2CHECKS"
    . "$P2CHECKS"
    p2_fns() { declare -F p2_set_equal >/dev/null && declare -F p2_only_in >/dev/null && declare -F p2_strip_prefix >/dev/null && declare -F p2_code_line_count >/dev/null && declare -F p2_hunk_line_count >/dev/null && declare -F p2_comment_only >/dev/null && declare -F p2_plant_code >/dev/null; }
    check "the shared checks' seven functions are defined after sourcing" "$(yn p2_fns)"
