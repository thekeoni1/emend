    RELS_ERR="^error: couldn.t read \`src/[.][.]/template/_rels/[.]rels\`"
    n_rels_err=$(count_matches -E "$RELS_ERR" "$B/apkg.out" "$B/apkg.err")
    echo "  command: count_matches -E '$RELS_ERR' over its output -> $n_rels_err"
    apkg_failed() { [ "$rc_apkg" != 0 ] && [ "$n_rels_err" -ge 1 ]; }
    check "the archive copy's verify build fails, exit non-zero, its error naming template/_rels/.rels (the measured failure, ruling 7)" "$(yn apkg_failed)"
    printf '%s\n' 'error: something else' >"$B/c-rels"
    check "control: the same count finds no such line in a planted error of another text" "$(yn [ "$(count_matches -E "$RELS_ERR" "$B/c-rels")" = 0 ])"
    echo "  FINDING (rulings 1 and 7): a package built from a tree that is not a git checkout is incomplete. Measured here: the git archive copy's package lists $n_alist entries against the checkout's $n_list; the two names missing are template/_rels/.rels, the finding (a dotfile cargo's file walk skips outside a git checkout), and .cargo_vcs_info.json, which cargo writes only from a git checkout (expected); and the archive copy's verify build exits $rc_apkg on the first, which include_bytes! needs. The include list that would make packaging independent of git is a manifest change carried to the publish step's spec (decision 1), which tests it by the same git archive dry run; the same command in the git worktree below, its control, packages the file."
    echo "### the dry run, from a detached git worktree (change KG as ruled)"
    WT=$PUB/wt
    echo "command: git worktree add --detach <scratch>/pub/wt <phase commit>"
    git worktree add --detach "$WT" "$C" >"$B/wt-add.out" 2>&1
    rc_wtadd=$?
    sed 's/^/    /' "$B/wt-add.out"
    echo "  exit: $rc_wtadd; the worktree's HEAD: $(git -C "$WT" rev-parse HEAD)"
    wt_at_c() { [ "$rc_wtadd" = 0 ] && [ "$(git -C "$WT" rev-parse HEAD)" = "$C" ]; }
    check "the worktree was added at the phase commit" "$(yn wt_at_c)"
    wt_ctl() { local C=$REC; wt_at_c; }
    check "control: the same check refuses the base commit" "$(ynnot wt_ctl)"
    echo "command: sed -i '/^publish = false\$/d' <scratch>/pub/wt/crates/emend/Cargo.toml; git -C <scratch>/pub/wt diff"
    sed -i '/^publish = false$/d' "$WT/crates/emend/Cargo.toml"
    git -C "$WT" diff >"$B/pub.diff"
    sed 's/^/    /' "$B/pub.diff"
    n_pfiles=$(count_matches -E '^diff --git ' "$B/pub.diff")
    n_plines=$(p2_hunk_line_count "$B/pub.diff")
    n_pline=$(count_matches -xF '-publish = false' "$B/pub.diff")
    echo "  files changed: $n_pfiles; added and removed lines: $n_plines; of them '-publish = false': $n_pline"
    check "the worktree differs from the phase commit by the one line publish = false removed, nothing else" "$(yn [ "$n_pfiles:$n_plines:$n_pline" = 1:1:1 ])"
    echo "command: (cd <scratch>/pub/wt && CARGO_TARGET_DIR=<target>/publish cargo package -p emend --offline --allow-dirty) (ruling 7's control: the verify build in the git worktree, offline)"
    (cd "$WT" && CARGO_TARGET_DIR="$TARGET_DIR/publish" cargo package -p emend --offline --allow-dirty) >"$B/wpkg.out" 2>"$B/wpkg.err"
    rc_wpkg=$?
    echo "  exit: $rc_wpkg; standard output $(count_lines "$B/wpkg.out") lines; standard error $(count_lines "$B/wpkg.err") lines"
    echo "  standard error:"
    sed 's/^/    /' "$B/wpkg.err"
    n_wrels=$(count_matches -E "$RELS_ERR" "$B/wpkg.out" "$B/wpkg.err")
    wpkg_ok() { [ "$rc_wpkg" = 0 ] && [ "$n_wrels" = 0 ]; }
    check "control: the same verify build in the git worktree exits 0, no line naming the missing file (ruling 7)" "$(yn wpkg_ok)"
    echo "  the worktree's keywords and categories, as cargo reads them:"
    LC_ALL=C "$G" -E '^(keywords|categories) = ' "$WT/crates/emend/Cargo.toml" | sed 's/^/    /'
    echo "  network: this command runs with CARGO_NET_OFFLINE unset (env -u), since the dry run reads the registry's index; no other logged command of this phase reached the network: every other cargo command of this log runs with CARGO_NET_OFFLINE=true and --offline (above), and each other log of this phase prints its own setting (ruling 8)"
    echo "command: (cd <scratch>/pub/wt && env -u CARGO_NET_OFFLINE CARGO_TARGET_DIR=<target>/publish cargo publish -p emend --dry-run --allow-dirty)"
    (cd "$WT" && env -u CARGO_NET_OFFLINE CARGO_TARGET_DIR="$TARGET_DIR/publish" cargo publish -p emend --dry-run --allow-dirty) >"$B/pub.out" 2>"$B/pub.err"
    rc_pub=$?
    echo "  exit: $rc_pub; standard output $(count_lines "$B/pub.out") lines; standard error $(count_lines "$B/pub.err") lines"
    echo "  standard output:"
    sed 's/^/    /' "$B/pub.out"
    echo "  standard error:"
    sed 's/^/    /' "$B/pub.err"
    ABORT_LINE='warning: aborting upload due to dry run'
    n_abort=$(count_matches -xF "$ABORT_LINE" "$B/pub.out" "$B/pub.err")
    n_warn_all=$(count_matches -E '^warning:' "$B/pub.out" "$B/pub.err")
    n_warn_pub=$((n_warn_all - n_abort))
    n_upload=$(count_matches -E "^ *Uploading emend v0[.]1[.]0" "$B/pub.out" "$B/pub.err")
    n_index=$(count_matches -E '^ *Updating crates[.]io index' "$B/pub.out" "$B/pub.err")
    n_kwcat=$(count_matches_i -E 'keyword|categor' "$B/pub.out" "$B/pub.err")
    echo "  lines \"$ABORT_LINE\": $n_abort; warning lines in all: $n_warn_all; warning lines other than that one: $n_warn_pub; Uploading lines: $n_upload; \"Updating crates.io index\" lines: $n_index; lines naming a keyword or a category: $n_kwcat"
    check "the publish dry run exits 0" "$(yn [ "$rc_pub" = 0 ])"
    check "cargo's abort line, counted on its own, once (ruling 2)" "$(yn [ "$n_abort" = 1 ])"
    check "the dry run reached the upload step once" "$(yn [ "$n_upload" = 1 ])"
    check "no warning line other than the abort line, 0 expected (ruling 2; a warning is a finding, raised before the record commit)" "$(yn [ "$n_warn_pub" = 0 ])"
    check "the dry run reached the registry's index (cargo's \"Updating crates.io index\" line)" "$(yn [ "$n_index" -ge 1 ])"
    check "no line of the dry run names a keyword or a category" "$(yn [ "$n_kwcat" = 0 ])"
    echo "  ruling 4: the dry run exits $rc_pub and no line of its output names a keyword or a category; a dry run validates no keyword or category against the registry, so this is not the registry's validation of either list, which the publish step records"
    printf '%s\n' 'warning: planted' "$ABORT_LINE" >"$B/c-pub-warn"
    c_warn=$(( $(count_matches -E '^warning:' "$B/c-pub-warn") - $(count_matches -xF "$ABORT_LINE" "$B/c-pub-warn") ))
    check "control: the same count finds one warning other than the abort line in a planted file" "$(yn [ "$c_warn" = 1 ])"
    echo "### the worktree removed, then this run's directory"
    echo "command: git worktree list --porcelain (before the removal)"
    git worktree list --porcelain | sed 's/^/    /'
    wt_is_ours() { [ "$WT" = "$PUB/wt" ] && [ -d "$WT" ] && git worktree list --porcelain | LC_ALL=C "$G" -qxF "worktree $WT"; }
    check "the worktree to remove is the path this run made under its own directory, listed by git" "$(yn wt_is_ours)"
    wt_ours_ctl() { local WT=$MAIN; wt_is_ours; }
    check "control: the same check refuses the main tree" "$(ynnot wt_ours_ctl)"
    if wt_is_ours; then
      echo "command: git worktree remove --force <scratch>/pub/wt"
      git worktree remove --force "$WT" 2>&1 | sed 's/^/    /'
    fi
    git worktree list --porcelain >"$B/wt-after"
    echo "command: git worktree list --porcelain (after)"
    sed 's/^/    /' "$B/wt-after"
    n_wt_left=$(count_matches -xF "worktree $WT" "$B/wt-after")
    n_prunable=$(count_matches -F 'prunable' "$B/wt-after")
    if [ "$n_wt_left" != 0 ]; then
      echo "command: git worktree prune (the removal left a record)"
      git worktree prune 2>&1 | sed 's/^/    /'
      git worktree list --porcelain >"$B/wt-after"
      sed 's/^/    /' "$B/wt-after"
      n_wt_left=$(count_matches -xF "worktree $WT" "$B/wt-after")
    else
      echo "  no record left; git worktree prune not run"
    fi
    wt_gone() { [ "$n_wt_left" = 0 ] && [ ! -e "$WT" ]; }
    check "the worktree is gone from git's list and from the disk" "$(yn wt_gone)"
    echo "  prunable records in the list: $n_prunable"
    check "control: the same list names the main tree" "$(yn [ "$(count_matches -xF "worktree $MAIN" "$B/wt-after")" = 1 ])"
    echo "command: rm -rf <scratch>/pub (this run's own mktemp -d directory, written \"\${PUB:?}\")"
    rm -rf "${PUB:?}"
    pub_present() { [ -e "$PUB" ]; }
    check "<scratch>/pub is gone" "$(ynnot pub_present)"
    check "control: the same test finds <build>, which stays" "$(yn test -e "$BUILD_ROOT")"
    
    echo "## 4. the crate's source since part 1's close-out doc commit, comment lines only (specs/0031 \"Harness runs\"; change KH)"
    E4=$(by_subject 'M4 part 1 close-out: commit planning docs (the P3 verification and rulings)')
    echo "command: git log --format=%H -n 1 -F --grep='M4 part 1 close-out: commit planning docs (the P3 verification and rulings)': ${E4:-none}"
    e4_ok() { [ -n "$E4" ] && [ "${E4:0:7}" = e4ab25b ] && git merge-base --is-ancestor "$E4" "$C"; }
    check "the subject names e4ab25b, an ancestor of the phase commit (the spec's base for this diff)" "$(yn e4_ok)"
    e4_ctl() { local E4=$REC; e4_ok; }
    check "control: the same check refuses the base record commit" "$(ynnot e4_ctl)"
    echo "command: git diff <e4ab25b> <phase commit> -- crates/emend/src > <scratch>/w/src.diff"
    git diff "$E4" "$C" -- crates/emend/src >"$B/src.diff"
    sed 's/^/    /' "$B/src.diff"
    n_src_files=$(count_matches -E '^diff --git ' "$B/src.diff")
    n_src_lines=$(p2_hunk_line_count "$B/src.diff")
    n_src_code=$(p2_code_line_count "$B/src.diff")
    echo "  files in the diff: $n_src_files; added and removed lines: $n_src_lines; of them not comment lines: $n_src_code"
    check "every added and removed line of crates/emend/src since e4ab25b is a comment line" "$(yn p2_comment_only "$B/src.diff")"
    p2_plant_code "$B/src.diff" "$B/c-src.diff"
    rc_plant=$?
    n_c_code=$(p2_code_line_count "$B/c-src.diff")
    check "control: the planted copy differs from the diff (cmp)" "$(ynnot cmp -s "$B/src.diff" "$B/c-src.diff")"
    check "control: the same count finds the one planted code line" "$(yn [ "$rc_plant:$n_c_code" = 0:1 ])"
    check "control: p2_comment_only refuses the planted copy" "$(ynnot p2_comment_only "$B/c-src.diff")"
    : >"$B/c-empty.diff"
    check "control: p2_comment_only refuses an empty diff" "$(ynnot p2_comment_only "$B/c-empty.diff")"
    
    echo
    echo "## 5. the API listing rerun with part 1's program, against part 1's listing (specs/0031 \"Harness runs\"; change KI)"
    T=$B
    TAB=$(printf '\t')
    mkdir -p "$API_DIR" "$T/src" "$T/py" "$T/fx/src" || fail=1
    echo "### the listing program"
    cp "$PROG_SRC" "$T/py/api-listing.py" || fail=1
    PROG_SHA=$(sha256sum <"$T/py/api-listing.py" | cut -d' ' -f1)
    PROG_WANT=59f4043c3014a64e671054fcfd4dce565e210426d4d4847ae448cb29b48b987c
    P1_PROG_SHA=$(git show "$C:records/logs/m4p1-p3/test.log" | LC_ALL=C "$G" -o -E '^command: cp <phase>/templates/m3p7p3-full/gen/api-listing[.]py <scratch>/w/py/api-listing[.]py; sha256sum: [0-9a-f]{64}$' | sed 's/.*: //')
    n_p1_prog=$(printf '%s\n' "$P1_PROG_SHA" | count_matches -E '^[0-9a-f]{64}$' /dev/stdin)
    echo "command: cp <home>/.cache/emend-build/m3p7-p3/gen/api-listing.py <scratch>/w/py/api-listing.py; sha256sum: $PROG_SHA"
    echo "command: git show <phase commit>:records/logs/m4p1-p3/test.log | grep -o -E '^command: cp <phase>/templates/m3p7p3-full/gen/api-listing[.]py <scratch>/w/py/api-listing[.]py; sha256sum: <64 hex>\$' -> lines $n_p1_prog; the hash: ${P1_PROG_SHA:-none}"
    check "part 1 P3's test log prints the listing program's hash once" "$(yn [ "$n_p1_prog" = 1 ])"
    prog_is_p1() { [ -n "$P1_PROG_SHA" ] && [ "$PROG_SHA" = "$P1_PROG_SHA" ] && [ "$PROG_SHA" = "$PROG_WANT" ]; }
    check "the program is part 1's, by the hash its test log prints and the spec's 59f4043c" "$(yn prog_is_p1)"
    prog_ctl() { local PROG_SHA; PROG_SHA=$(printf 'x' | sha256sum | cut -d' ' -f1); prog_is_p1; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot prog_ctl)"
    echo "command: git archive <phase commit> crates/emend/src | tar -x -C <scratch>/w/src"
    git archive "$C" crates/emend/src | tar -x -C "$T/src"
    arch_rc=$?
    n_arch=$(find "$T/src/crates/emend/src" -type f -name '*.rs' | count_lines /dev/stdin)
    n_tree=$(git ls-tree -r --name-only "$C" crates/emend/src | count_matches -E '[.]rs$' /dev/stdin)
    echo "  archive exit: $arch_rc; .rs files extracted: $n_arch; .rs files under crates/emend/src in the phase commit's tree: $n_tree"
    arch_ok() { [ "$arch_rc" = 0 ] && [ "$n_arch" -ge 1 ] && [ "$n_arch" = "$n_tree" ]; }
    check "the archive holds every .rs file of the phase commit's crates/emend/src" "$(yn arch_ok)"
    arch_ctl() { local n_tree=$((n_tree + 1)); arch_ok; }
    check "control: the same comparison refuses a tree count one more than the archive's" "$(ynnot arch_ctl)"
    
    echo "### the program's control: part 7's fixture crate, as part 1 P3's test log wrote it"
    printf '%s\n' 'pub mod a;' 'mod b;' '#[cfg(test)]' 'mod tests;' 'pub use b::{X, Y as Z};' '/// pub fn not_this()' 'pub(crate) fn hidden() {}' >"$T/fx/src/lib.rs"
    printf '%s\n' 'pub struct P {' '    pub f: u8,' '    g: u8,' '}' 'impl P { pub fn m(&self) { let _s = "{ pub fn fake"; } }' '#[cfg(feature = "q")]' 'pub const C: u8 = 1;' >"$T/fx/src/a.rs"
    printf '%s\n' 'pub struct X;' 'pub struct W;' 'pub enum Y {' '    V,' '}' 'impl W {' '    pub fn n() {}' '}' >"$T/fx/src/b.rs"
    printf '%s\n' 'pub fn t() {}' >"$T/fx/src/tests.rs"
    for f in lib.rs a.rs b.rs tests.rs; do
      echo "  <scratch>/w/fx/src/$f:"
      sed 's/^/      /' "$T/fx/src/$f"
    done
    echo "command: python3 -I <scratch>/w/py/api-listing.py <scratch>/w/fx/src fx <repo> <phase commit> <scratch>/w/fx/rows.tsv <scratch>/w/fx/files.tsv --no-added"
    python3 -I "$T/py/api-listing.py" "$T/fx/src" fx "$MAIN" "$C" "$T/fx/rows.tsv" "$T/fx/files.tsv" --no-added >"$T/fx/out" 2>"$T/fx/err"
    fx_rc=$?
    echo "  exit: $fx_rc; standard output $(wc -c <"$T/fx/out") bytes; standard error $(wc -c <"$T/fx/err") bytes; its rows, columns 2 to 8, tabs shown as |:"
    cut -f2-8 "$T/fx/rows.tsv" | tr '\t' '|' | sed 's/^/    /'
    exp_line() { local IFS=$TAB; printf '%s\n' "$*"; }
    {
      exp_line file line kind name container cfg reachable
      exp_line fx/lib.rs 1 mod a - - yes
      exp_line fx/lib.rs 5 use 'b::{X, Y as Z}' - - yes
      exp_line fx/a.rs 1 struct P - - yes
      exp_line fx/a.rs 2 field f P - yes
      exp_line fx/a.rs 5 method m P - yes
      exp_line fx/a.rs 7 const C - q yes
      exp_line fx/b.rs 1 struct X - - 'yes (re-exported as crate::X)'
      exp_line fx/b.rs 2 struct W - - 'no (private module, not re-exported)'
      exp_line fx/b.rs 3 enum Y - - 'yes (re-exported as crate::Z)'
      exp_line fx/b.rs 7 method n W - 'no (its type is not reachable)'
    } >"$T/fx/expected-rows"
    cut -f2-8 "$T/fx/rows.tsv" >"$T/fx/got-rows"
    fx_ran() { [ "$fx_rc" = 0 ] && [ ! -s "$T/fx/out" ] && [ ! -s "$T/fx/err" ]; }
    check "control: the program exits 0 on the fixture crate and prints nothing" "$(yn fx_ran)"
    check "control: the fixture's rows are the expected ones (part 7's fixture and expectation)" "$(yn cmp -s "$T/fx/got-rows" "$T/fx/expected-rows")"
    cp "$T/fx/expected-rows" "$T/fx/c-rows"; printf 'x\n' >>"$T/fx/c-rows"
    check "control: the same comparison refuses the expected rows with one line more" "$(ynnot cmp -s "$T/fx/got-rows" "$T/fx/c-rows")"
    
    echo "### the listing of the phase commit's crate"
    echo "command: python3 -I <scratch>/w/py/api-listing.py <scratch>/w/src/crates/emend/src crates/emend/src <repo> <phase commit> <scratch>/w/api/listing.tsv <scratch>/w/api/files.tsv"
    python3 -I "$T/py/api-listing.py" "$T/src/crates/emend/src" crates/emend/src "$MAIN" "$C" "$API_DIR/listing.tsv" "$API_DIR/files.tsv" >"$T/listing.out" 2>"$T/listing.err"
    lst_rc=$?
    echo "  exit: $lst_rc; standard output $(wc -c <"$T/listing.out") bytes; standard error $(wc -c <"$T/listing.err") bytes"
    listing_ran() { [ "$lst_rc" = 0 ] && [ ! -s "$T/listing.out" ] && [ ! -s "$T/listing.err" ]; }
    check "the listing program exits 0 and prints nothing" "$(yn listing_ran)"
    LISTING_SHA=$(sha256sum <"$API_DIR/listing.tsv" | cut -d' ' -f1)
    echo "  command: sha256sum <scratch>/w/api/listing.tsv <scratch>/w/api/files.tsv"
    echo "    $LISTING_SHA  listing.tsv"
    echo "    $(sha256sum <"$API_DIR/files.tsv" | cut -d' ' -f1)  files.tsv"
    echo "  the files table, tabs shown as |:"
    tr '\t' '|' <"$API_DIR/files.tsv" | sed 's/^/    /'
    echo "  the listing, tabs shown as |:"
    tr '\t' '|' <"$API_DIR/listing.tsv" | sed 's/^/    /'
    n_rows=$(($(count_lines "$API_DIR/listing.tsv") - 1))
    echo "  rows in the listing: $n_rows"
    check "the listing holds 544 rows" "$(yn [ "$n_rows" = 544 ])"
    rows_ctl() { local n_rows=545; [ "$n_rows" = 544 ]; }
    check "control: the same comparison refuses 545" "$(ynnot rows_ctl)"
    
    echo "### part 1's listing, the one its record names"
    OLD_SHA=$(sha256sum <"$OLD_LISTING" | cut -d' ' -f1)
    REC_OLD_SHA=$(git show "$C:records/api-review-m4p1-2026-10-10-669fa91.md" | LC_ALL=C "$G" -o -E 'listing[.]tsv` sha256 [0-9a-f]{64}' | awk '{ print $3 }')
    REC_ITEMS=$(git show "$C:records/api-review-m4p1-2026-10-10-669fa91.md" | LC_ALL=C "$G" -o -E '^- Items: [0-9]+' | awk '{ print $3 }')
    n_old=$(($(count_lines "$OLD_LISTING") - 1))
    echo "command: sha256sum <home>/.cache/emend-build/m4p1-p3/api/listing.tsv: $OLD_SHA; its rows: $n_old"
    echo "command: git show <phase commit>:records/api-review-m4p1-2026-10-10-669fa91.md | grep -o -E 'listing[.]tsv\` sha256 <64 hex>': ${REC_OLD_SHA:-none}; | grep -o -E '^- Items: <n>': ${REC_ITEMS:-none}"
    old_is_p1() { [ -n "$REC_OLD_SHA" ] && [ "$OLD_SHA" = "$REC_OLD_SHA" ]; }
    check "part 1's listing file is the one part 1's record names, by hash" "$(yn old_is_p1)"
    old_ctl() { local OLD_SHA; OLD_SHA=$(printf 'x' | sha256sum | cut -d' ' -f1); old_is_p1; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot old_ctl)"
    check "part 1's listing holds 544 rows, the count its record states" "$(yn [ "$n_old:$REC_ITEMS" = 544:544 ])"
    
    echo "### row for row against part 1's record's 544 table rows (ruling 3; change KL)"
    echo "command: sha256sum <scripts>/listing_vs_record.py: $(sha256sum <"$LVR" | cut -d' ' -f1)"
    sed 's/^/    /' "$LVR"
    git show "$C:records/api-review-m4p1-2026-10-10-669fa91.md" >"$T/record.md"
    echo "command: git show <phase commit>:records/api-review-m4p1-2026-10-10-669fa91.md > <scratch>/w/record.md: $(wc -c <"$T/record.md") bytes, sha256 $(sha256sum <"$T/record.md" | cut -d' ' -f1)"
    echo "command: python3 -I <scripts>/listing_vs_record.py <scratch>/w/api/listing.tsv <scratch>/w/record.md"
    python3 -I "$LVR" "$API_DIR/listing.tsv" "$T/record.md" >"$T/lvr.out" 2>"$T/lvr.err"
    rc_lvr=$?
    echo "  exit: $rc_lvr; standard error $(wc -c <"$T/lvr.err") bytes; standard output:"
    sed 's/^/    /' "$T/lvr.out"
    lvr_ok() { [ "$rc_lvr" = 0 ] && [ ! -s "$T/lvr.err" ] && [ "$(tail -n 1 "$T/lvr.out")" = "record rows 544 listing rows 544 equal 544 differing 0" ]; }
    check "every one of the record's 544 rows equals this listing's row of the same number, column by mapped column" "$(yn lvr_ok)"
    awk '!done && /^\| [0-9]+ \| `/ { sub(/` \|/, "X` |"); done = 1 } { print }' "$T/record.md" >"$T/c-record.md"
    python3 -I "$LVR" "$API_DIR/listing.tsv" "$T/c-record.md" >"$T/c-lvr.out" 2>"$T/c-lvr.err"
    rc_clvr=$?
    echo "  control: the same program over a record copy with its first row's item changed: exit $rc_clvr; $(tail -n 1 "$T/c-lvr.out")"
    check "control: the planted record copy differs from the record (cmp)" "$(ynnot cmp -s "$T/record.md" "$T/c-record.md")"
    check "control: the program refuses it, one row differing" "$(yn [ "$rc_clvr:$(tail -n 1 "$T/c-lvr.out")" = "1:record rows 544 listing rows 544 equal 543 differing 1" ])"
    echo "### against part 1's listing.tsv by key on every column but the line (ruling 3; change KL)"
    keys_of() { cut -f1,2,4- "$1" | awk 'NR > 1' | LC_ALL=C sort; }
    keys_of "$OLD_LISTING" >"$T/keys-old"
    keys_of "$API_DIR/listing.tsv" >"$T/keys-new"
    LC_ALL=C comm -23 "$T/keys-old" "$T/keys-new" >"$T/gone.got"
    LC_ALL=C comm -13 "$T/keys-old" "$T/keys-new" >"$T/new.got"
    n_gone=$(count_lines "$T/gone.got"); n_new=$(count_lines "$T/new.got")
    echo "command: every column but the line (cut -f1,2,4-) of part 1's listing and of this one, the header dropped, sorted, compared with comm"
    echo "  part 1's rows not here: $n_gone; this listing's rows not in part 1's: $n_new"
    sed 's/^/    - /' "$T/gone.got"
    sed 's/^/    + /' "$T/new.got"
    check "no row differs from part 1's listing on any column but the line" "$(yn [ "$n_gone:$n_new" = 0:0 ])"
    cut -f1,2,4- "$OLD_LISTING" >"$T/rows-old"
    cut -f1,2,4- "$API_DIR/listing.tsv" >"$T/rows-new"
    echo "command: the same columns compared line by line with cmp, so the order is part 1's too"
    check "row for row, every column but the line equals part 1's" "$(yn cmp -s "$T/rows-old" "$T/rows-new")"
    awk -F"$TAB" -v OFS="$TAB" 'NR == 2 { $5 = $5 "Planted" } { print }' "$API_DIR/listing.tsv" >"$T/c-listing.tsv"
    keys_of "$T/c-listing.tsv" >"$T/c-keys-new"
    c_gone=$(LC_ALL=C comm -23 "$T/keys-old" "$T/c-keys-new" | count_lines /dev/stdin)
    check "control: the planted listing copy differs (cmp) from this listing" "$(ynnot cmp -s "$API_DIR/listing.tsv" "$T/c-listing.tsv")"
    check "control: the same key comparison finds the one changed row" "$(yn [ "$c_gone" = 1 ])"
    echo "### the line column: rows whose line moved, against lib.rs's growth since part 1's listing"
    P3C=$(by_subject 'M4 part 1 P3: commit planning docs (the P2 rulings and verification)')
    LIB_OLD=$(git show "$P3C:crates/emend/src/lib.rs" | count_lines /dev/stdin)
    LIB_NEW=$(git show "$C:crates/emend/src/lib.rs" | count_lines /dev/stdin)
    DELTA=$((LIB_NEW - LIB_OLD))
    echo "command: git show <part 1 P3's phase commit ${P3C:-none}>:crates/emend/src/lib.rs | wc -l -> $LIB_OLD; git show <phase commit>:crates/emend/src/lib.rs | wc -l -> $LIB_NEW; the growth: $DELTA (P1's doc comment, decision 3)"
    p3c_ok() { [ "${P3C:0:7}" = 669fa91 ]; }
    check "the subject names 669fa91, the commit part 1's listing was made at" "$(yn p3c_ok)"
    # line_counts <old listing> <new listing>: "moved bad badlib lib" over the two
    # listings pasted row by row: rows whose line differs; of them outside lib.rs
    # or by another amount than the growth; lib.rs rows not moved by the growth;
    # lib.rs rows. Prints the four numbers.
    line_counts() { paste "$1" "$2" | awk -F"$TAB" -v d="$DELTA" 'NR > 1 && $3 != $14 { m++; if ($2 != "crates/emend/src/lib.rs" || $14 - $3 != d) bad++ } NR > 1 && $2 == "crates/emend/src/lib.rs" && $14 - $3 != d { badlib++ } NR > 1 && $2 == "crates/emend/src/lib.rs" { lib++ } END { print m + 0, bad + 0, badlib + 0, lib + 0 }'; }
    line_counts "$OLD_LISTING" "$API_DIR/listing.tsv" >"$T/linecmp"
    read -r n_moved n_bad n_badlib n_lib <"$T/linecmp"
    echo "  rows whose line moved: $n_moved; of them outside lib.rs or by another amount: $n_bad; lib.rs rows: $n_lib; lib.rs rows not moved by the growth: $n_badlib"
    paste "$OLD_LISTING" "$API_DIR/listing.tsv" | awk -F"$TAB" 'NR > 1 && $3 != $14 { print "    " $1 "|" $4 "|" $5 ": line " $3 " -> " $14 }'
    lines_ok() { [ "$n_bad" = 0 ] && [ "$n_badlib" = 0 ] && [ "$n_moved" = "$n_lib" ]; }
    check "every row whose line moved is a lib.rs row moved by lib.rs's growth, and every lib.rs row moved by it" "$(yn lines_ok)"
    awk -F"$TAB" -v OFS="$TAB" 'NR > 1 && !done && $2 != "crates/emend/src/lib.rs" { $3 = $3 + 1; done = 1 } { print }' "$API_DIR/listing.tsv" >"$T/c-lines.tsv"
    line_counts "$OLD_LISTING" "$T/c-lines.tsv" >"$T/c-linecmp"
    read -r c_moved c_bad c_badlib c_lib <"$T/c-linecmp"
    echo "  control: a listing copy with the first row outside lib.rs moved one line: moved $c_moved; outside lib.rs or by another amount $c_bad"
    check "control: the planted copy differs from this listing (cmp)" "$(ynnot cmp -s "$API_DIR/listing.tsv" "$T/c-lines.tsv")"
    check "control: the same count finds the one row moved outside lib.rs" "$(yn [ "$c_bad" = 1 ])"
    awk -F"$TAB" -v OFS="$TAB" 'NR > 1 && !done && $2 == "crates/emend/src/lib.rs" { $3 = $3 + 1; done = 1 } { print }' "$API_DIR/listing.tsv" >"$T/c-lib.tsv"
    line_counts "$OLD_LISTING" "$T/c-lib.tsv" >"$T/c-libcmp"
    read -r l_moved l_bad l_badlib l_lib <"$T/c-libcmp"
    echo "  control: a listing copy with the first lib.rs row moved one line more: lib.rs rows not moved by the growth $l_badlib"
    check "control: the planted copy differs from this listing (cmp)" "$(ynnot cmp -s "$API_DIR/listing.tsv" "$T/c-lib.tsv")"
    check "control: the same count finds the one lib.rs row moved by another amount" "$(yn [ "$l_badlib" = 1 ])"
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.out "$B"/*.err; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them admitted by the phase's pattern (this phase's logs, its size record, planning's modified specs/0031): $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is admitted by the phase's pattern: this phase's logs, its size record or planning's modified specs/0031" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## the shared checks (change KC)
command: sha256sum <scripts>/p2_checks.sh (sourced; the negative log sources the same file): 598018e2acc94d771277b4528717ccd0b5811e7cadbb2867ed45f671bf100ba1
    # M4 part 2 P2's shared checks (specs/0031-release-metadata.md "The packaging
    # runs (P2)" and "Harness runs"), sourced by the phase's run log and negative
    # log, each of which prints this file and its sha256. A predicate prints
    # nothing and returns its status (specs/0001: a helper used as a check
    # condition prints nothing); an extractor writes the file it is given; a
    # counter prints one number and is used in an assignment, never as a
    # condition. Every comparison runs under LC_ALL=C.
    
    # p2_set_equal <a> <b>: the two lists, one name per line, hold the same
    # names: neither is empty, neither holds a name twice, and their sorted
    # forms are byte-equal.
    p2_set_equal() {
      [ -s "$1" ] && [ -s "$2" ] || return 1
      [ "$(LC_ALL=C sort "$1" | wc -l)" = "$(LC_ALL=C sort -u "$1" | wc -l)" ] || return 1
      [ "$(LC_ALL=C sort "$2" | wc -l)" = "$(LC_ALL=C sort -u "$2" | wc -l)" ] || return 1
      cmp -s <(LC_ALL=C sort "$1") <(LC_ALL=C sort "$2")
    }
    
    # p2_only_in <a> <b> <out>: the names of <a> not in <b>, sorted, into <out>.
    p2_only_in() {
      LC_ALL=C comm -23 <(LC_ALL=C sort -u "$1") <(LC_ALL=C sort -u "$2") >"$3"
    }
    
    # p2_strip_prefix <prefix> <in> <out>: a tar listing's names with the
    # leading <prefix> dropped and the directory entries (a name ending in a
    # slash) left out, into <out>. Returns 1 when a name does not start with
    # <prefix> or nothing is left.
    p2_strip_prefix() {
      LC_ALL=C awk -v p="$1" '
        index($0, p) != 1 { bad = 1; next }
        { n = substr($0, length(p) + 1) }
        n == "" || n ~ /\/$/ { next }
        { print n; kept++ }
        END { exit (bad || kept == 0) ? 1 : 0 }' "$2" >"$3"
    }
    
    # p2_code_line_count <diff>: the number of the diff's added and removed
    # lines that are not comment lines: a line of a hunk starting with + or -,
    # whose text after that sign and any leading white space does not start
    # with two slashes. A blank added or removed line counts as code (the
    # strictest reading). A file's header lines (from "diff --git" to its first
    # "@@") are not counted. Prints the number.
    p2_code_line_count() {
      LC_ALL=C awk '
        /^diff --git / { hdr = 1; next }
        /^@@/ { hdr = 0; next }
        hdr { next }
        /^[+-]/ { t = substr($0, 2); sub(/^[ \t]+/, "", t); if (substr(t, 1, 2) != "//") n++ }
        END { print n + 0 }' "$1"
    }
    
    # p2_hunk_line_count <diff>: the number of the diff's added and removed
    # lines of every kind, counted as p2_code_line_count counts. Prints it.
    p2_hunk_line_count() {
      LC_ALL=C awk '
        /^diff --git / { hdr = 1; next }
        /^@@/ { hdr = 0; next }
        hdr { next }
        /^[+-]/ { n++ }
        END { print n + 0 }' "$1"
    }
    
    # p2_comment_only <diff>: the diff adds or removes at least one line, and
    # every one of them is a comment line.
    p2_comment_only() {
      [ "$(p2_hunk_line_count "$1")" -gt 0 ] && [ "$(p2_code_line_count "$1")" = 0 ]
    }
    
    # p2_plant_code <diff> <out>: a copy of the diff with the line
    # "+    let planted = 1;" inserted after its first hunk header, into <out>.
    # Returns 1 when the diff has no hunk header.
    p2_plant_code() {
      LC_ALL=C awk '{ print } /^@@/ && !done { print "+    let planted = 1;"; done = 1 } END { exit done ? 0 : 1 }' "$1" >"$2"
    }
  the shared checks' seven functions are defined after sourcing: yes
  control: the same test refuses a function the file does not define: yes

