    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh, crates/emend/Cargo.toml, the tree listing, part 1 P3's test log and part 1's API review record are read from it by git show at the phase commit; cargo package --list and cargo package run in it (item 1 and 2, offline, into <target>/main); the phase commit is archived from it (items 3 and 5); a detached worktree of the phase commit is added from it under <scratch>/pub and removed again (item 3, ruling 1), the one write to its git directory; the source diff is read from it (item 4); the working spec is hashed in it"
    echo "root: <home> stands for the home directory of the account that ran this script; under it this log reads <home>/.cache/emend-build/m3p7-p3/gen/api-listing.py (the listing program, copied) and <home>/.cache/emend-build/m4p1-p3/api/listing.tsv (part 1's listing), and the roots below"
    echo "root: <phase> stands for <home>/.cache/emend-build/m4p2-p2, the phase's directory on the disk"
    echo "root: <scripts> stands for <phase>/scripts, this script's own directory on the disk, which holds the script, the shared checks p2_checks.sh (sourced), the record comparison listing_vs_record.py (run) and, in <scripts>/out, its own standard error (specs/0017 P1 verification ruling 7)"
