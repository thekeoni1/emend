    echo "root: <scratch>/w stands for this run's mktemp -d working directory under <build>, kept on the disk after the run: <scratch>/w/counting.sh the phase commit's library, sourced; the captured cargo outputs; <scratch>/w/src the archive of the phase commit's crates/emend/src; <scratch>/w/py the listing program's copy; <scratch>/w/fx part 7's fixture crate; <scratch>/w/api this run's listing; the controls' copies"
    echo "root: <scratch>/pub stands for this run's second mktemp -d directory under <build>, item 3's: <scratch>/pub/arch the git archive copy of ruling 1's finding, <scratch>/pub/wt the detached git worktree the publish dry run runs in; the worktree removed by git worktree remove, then the directory by this script (changes KG and KJ)"
    echo "root: <target> stands for <phase>/target, the phase's one target root (specs/0001): <target>/main for cargo package in <repo>, its .crate under <target>/main/package; <target>/publish for the publish dry run's worktree and <target>/archive for the finding's archive copy, each its own tree's subdirectory"
    echo "root: <corpus> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change KB)"
    echo "root: <runs> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change KB)"
    echo "root: <work> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change KB)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$BUILD_ROOT" && apart "$SUPERSEDED_DIR" "$MAIN" && apart "$TARGET_DIR" "$BUILD_ROOT" && apart "$TARGET_DIR" "$MAIN" && apart "$TARGET_DIR" "$SELF_DIR" && apart "$B" "$PUB"; }
    check "the roots other than <home> and <phase> are distinct, none inside another (<scratch>/w and <scratch>/pub inside <build>)" "$(yn roots_distinct)"
    roots_ctl() { apart "$B" "$BUILD_ROOT"; }
    check "control: apart refuses <scratch>/w against <build>, which holds it" "$(ynnot roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs, its size record, planning's modified specs/0031) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo "  the phase commit given to this script: $C"
