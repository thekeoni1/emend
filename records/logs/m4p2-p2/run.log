    } | LC_ALL=C sort >"$B/expected.txt"
    echo "  the expected package list (specs/0031 \"The packaging runs (P2)\" item 1): the manifest, the lock file, Cargo.toml.orig, .cargo_vcs_info.json, every src/ and template/ file of the phase commit, README.md and the two licence texts: $(count_lines "$B/expected.txt") names"
    
    echo
    echo "## 1. cargo package --list, offline (specs/0031 \"The packaging runs (P2)\" item 1; change KE)"
    echo "  the package is listed from <repo>'s working tree; the status check above admits no change to any file the package holds, so the tree's files are the phase commit's"
    echo "command: (cd <repo> && CARGO_TARGET_DIR=<target>/main cargo package -p emend --list --offline)"
    (cd "$MAIN" && CARGO_TARGET_DIR=$TARGET_DIR/main cargo package -p emend --list --offline) >"$B/list.out" 2>"$B/list.err"
    rc_list=$?
