    echo "input (environment) CARGO_NET_OFFLINE: ${CARGO_NET_OFFLINE:-unset}; exported by this script for every cargo command of this log but item 3's publish dry run, which runs under env -u CARGO_NET_OFFLINE"
    offline_set() { [ "${CARGO_NET_OFFLINE:-}" = true ]; }
    check "CARGO_NET_OFFLINE is true for this log's cargo commands" "$(yn offline_set)"
    offline_ctl() { local CARGO_NET_OFFLINE=false; offline_set; }
    check "control: the same check refuses false" "$(ynnot offline_ctl)"
    
    echo
    echo "## the files read at the phase commit (change KB)"
    echo "command: git show <phase commit>:crates/emend/Cargo.toml > <scratch>/w/Cargo.toml; git ls-tree -r --name-only <phase commit> crates/emend/src crates/emend/template > <scratch>/w/pkg-tree.txt"
    git show "$C:crates/emend/Cargo.toml" >"$B/Cargo.toml"
    git ls-tree -r --name-only "$C" crates/emend/src crates/emend/template >"$B/pkg-tree.txt"
    echo "  crates/emend/Cargo.toml: $(wc -c <"$B/Cargo.toml") bytes, sha256 $(sha256sum <"$B/Cargo.toml" | cut -d' ' -f1)"
    echo "  files under crates/emend/src and crates/emend/template at the phase commit: $(count_lines "$B/pkg-tree.txt")"
    VERSION_LINE=$(LC_ALL=C "$G" -x -E 'version = "[0-9]+[.][0-9]+[.][0-9]+"' "$B/Cargo.toml")
    n_version=$(count_matches -E '^version = "[0-9]+[.][0-9]+[.][0-9]+"$' "$B/Cargo.toml")
    echo "  command: grep -x -E 'version = \"<x.y.z>\"' <scratch>/w/Cargo.toml -> $VERSION_LINE (lines: $n_version)"
    check "the manifest names version 0.1.0 once (specs/0031: the version stays 0.1.0)" "$(yn [ "$n_version:$VERSION_LINE" = '1:version = "0.1.0"' ])"
    CRATE_STEM=emend-0.1.0
    inputs_read() { [ -s "$B/Cargo.toml" ] && [ -s "$B/pkg-tree.txt" ]; }
