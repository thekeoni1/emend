    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_readme_ctl() { printf ' M CHANGELOG.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified CHANGELOG.md" "$(ynnot ours_readme_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m4p2-p2/run.log\n?? records/logs/m4p2-p1/run.log\n?? records/size-m4p2-2026-10-10-%s.md\n?? records/size-m4p2-2026-10-10-abcdef0.md\n?? records/logs/m4p2-p2x/run.log\n M ROADMAP.md\n M specs/0031-release-metadata.md\n M crates/emend/Cargo.toml\n M records/size-m4p2-2026-10-10-%s.md\n' "$SHORT_SHA" "$SHORT_SHA" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern admits this phase's log, its untracked size record and planning's modified specs/0031 alone; it refuses another phase's log, a size record of another commit, a sibling directory, ROADMAP.md, the manifest and a modified size record (change KA)" "$(yn [ "$(ours_rec_ctl)" = 3 ])"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_BLOB=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum: $SPEC_BLOB; sha256sum $SPEC (the working file, printed and not asserted: planning may hold rulings during P2 uncommitted; change KA): $SPEC_HAVE"
    check "the spec's blob at the phase commit is at the hash this log pins" "$(yn [ "$SPEC_BLOB" = "$SPEC_WANT" ])"
    spec_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$SPEC_WANT" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot spec_ctl)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## the shared checks (change KC)"
