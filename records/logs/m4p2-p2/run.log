    check "control: the same comparison refuses the two names with one dropped" "$(ynnot p2_set_equal "$B/alist-missing" "$B/c-alist-want")"
    echo "command: (cd <scratch>/pub/arch && CARGO_TARGET_DIR=<target>/archive cargo package -p emend --offline) (ruling 7: the archive copy's verify build, offline, its dependencies from the cache)"
    (cd "$PUB/arch" && CARGO_TARGET_DIR="$TARGET_DIR/archive" cargo package -p emend --offline) >"$B/apkg.out" 2>"$B/apkg.err"
    rc_apkg=$?
