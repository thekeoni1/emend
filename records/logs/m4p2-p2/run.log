    p2_only_in "$B/tar-names" "$B/list.out" "$B/tar-extra"
    p2_only_in "$B/list.out" "$B/tar-names" "$B/tar-missing"
    echo "  in the .crate and not in item 1's list: $(count_lines "$B/tar-extra"); in item 1's list and not in the .crate: $(count_lines "$B/tar-missing")"
    sed 's/^/    + /' "$B/tar-extra"
    sed 's/^/    - /' "$B/tar-missing"
    check "the .crate's listing is item 1's list, none more, none fewer" "$(yn p2_set_equal "$B/tar-names" "$B/list.out")"
    printf '%s\n' "$CRATE_STEM/src/lib.rs" "other-0.1.0/src/lib.rs" >"$B/c-tar"
    check "control: p2_strip_prefix refuses a listing holding a name without the prefix" "$(ynnot p2_strip_prefix "$CRATE_STEM/" "$B/c-tar" "$B/c-tar-names")"
    { cat "$B/tar-names"; printf '%s\n' planted.txt; } >"$B/c-tar-extra"
    check "control: the planted copy differs from the .crate's listing (cmp)" "$(ynnot cmp -s "$B/c-tar-extra" "$B/tar-names")"
    check "control: the same comparison refuses the .crate's listing with one name more" "$(ynnot p2_set_equal "$B/c-tar-extra" "$B/list.out")"
    
    echo
    echo "## 3. cargo publish --dry-run on a detached git worktree of the phase commit without publish = false (specs/0031 \"The packaging runs (P2)\" item 3; \"Planning rulings during P2\", rulings 1, 2 and 4; changes KG, KJ, KK and KM)"
    echo "### the finding of ruling 1: a package built from a git archive copy, not a git checkout, offline (change KJ)"
