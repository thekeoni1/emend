    check "control: the same comparison refuses a list with one name fewer" "$(ynnot p2_set_equal "$B/c-list-short" "$B/expected.txt")"
    { cat "$B/expected.txt"; sed -n 1p "$B/expected.txt"; } >"$B/c-list-dup"
