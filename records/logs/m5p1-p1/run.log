    """The run log's own named styles comparison for M5 part 1 P1
    (specs/0032-read-breadth-styles.md, "Harness runs", --namedstyles-sample
    and the run log's own check, the namedstyles bullet; "Named styles",
    "Differential styles", "The default font"; decision 2 A; the working
    spec's "Planning rulings during P1 (2026-10-11)", rulings 1 and 2).
    
    Usage: namedcmp.py namedstyles <input archive> <output archive> [--diff <diff.tsv>] [--plant <flag>]
           namedcmp.py namedstyles <input archive> --parts
    
    Its readers are M3 part 6 P3's copycmp.py's (zipfile, byte spans and
    ElementTree; the values, local-header and descriptor readers of the
    xml_values and flagged checks), copied by name by <home>/.cache/emend-build/
    m5p1-p1/gen/namedcmp_build.py; it shares no code with the library or the
    tool. From the input it finds the workbook part through the package
    relationship and the styles part through the workbook's first styles
    relationship, and reads the part with ElementTree, the main namespace's
    elements only (an x14:dxfs inside extLst is not one):
    
      the counts the tool's line carries, each counted here independently:
      named (cellStyle children of the first cellStyles), named_xfs (xf
      children of the first cellStyleXfs), builtin (cellStyle with a builtinId),
      custom (customBuiltin 1 or true), resolved (cellStyleXfs xf whose fontId,
      fillId and borderId, 0 when absent, lie within fonts, fills and borders),
      default_font_size (the sz of the font the first cellStyleXfs xf names,
      font 0 without a fontId or an xf; 0 for none), dxfs (dxf children of the
      first main dxfs), dxf_fonts, dxf_fills, dxf_borders, dxf_numfmts,
      dxf_alignments, dxf_protections (dxfs with each child; a fill counts when
      it holds a patternFill), dxf_gradients (a fill child holding no
      patternFill), dxf_implied_solid (a dxf fill's patternFill with no
      patternType), dxf_inside_sides (vertical and horizontal children of dxf
      borders), dxf_written (the dxfs whose children are font, fill and border
      alone, at least one of them read: a font, a border, or a fill holding a
      patternFill), dxf_equal (the appended dxfs that match their source, below);
      what the output's styles part must hold: the input's bytes before and
      after its dxfs element; the dxfs element's start tag, its count aside;
      the input's dxfs content as a byte-identical prefix of the output's; one
      dxf appended per written dxf, in order, each compared child by child with
      its source as the types model them: a font's b, i, strike, u, vertAlign,
      sz, color, name, family and scheme by value, its charset, outline,
      shadow, condense and extend absent on the written side; a fill's
      patternType equal, or absent on the read side and "solid" on the written
      side (decision 2 A, the one named difference), its fgColor and bgColor by
      value, the written side always naming a patternType; a gradient fill
      absent on the written side; a border's left, right, top, bottom and
      diagonal by style (absent and "none" alike) and colour, diagonalUp and
      diagonalDown as flags, vertical and horizontal absent on the written side
      (ruling 1) and no outline written; the dxf's children font, fill and
      border alone, in that order.
    
    Flags:
    
      rest_same       the output's styles part holds the input's bytes before
                      and after the dxfs element, byte for byte; the whole part
                      the input's when nothing is written
      dxfs_prefix     the input's dxfs content a byte-identical prefix of the
                      output's, its start tag the input's but for count, the
                      output's count its children; no dxfs out without one in
      appended_match  the dxfs appended are one per written dxf, each matching
                      its source as above
      entries_same    the output's entries are the input's, every one but the
                      styles part byte for byte (uncompressed)
    
    and xml_values and flagged as copycmp.py's with --diff, the flagged plant
    given a phantom row when no entry is rewritten (change NSC).
    
    It prints ONE line of counts and yes/no flags and no text, reference, style
    name or part name: the counts above in the tool's order, then the value and
    flag counts, then the flags. --parts prints, one per line, for the log to
    compare with the runner's rows without printing them: the styles part's
    name and dxf_written. --plant <flag> changes the output as read (or, for
    xml_values and flagged, the rule) so that the named flag turns to no; the
    line then says planted=yes, or planted=no when the pair gives the plant
    nothing to change.
    """
    import posixpath
    import collections
    import re
    import struct
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    
    
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    
    
    ATTR = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    
    
    COMMENT = b"<!-- planted -->"
    
    
    def local(tag):
        if tag.startswith("{"):
            ns, _, name = tag[1:].partition("}")
            return ns, name
        return "", tag
    
    
    def rels_name(part):
        d, base = posixpath.split(part)
        return posixpath.join(d, "_rels", base + ".rels") if base else "_rels/.rels"
    
    
    def rels_of(z, part):
        """(Id, Type, resolved target or None) of a part's rels."""
        name = rels_name(part)
        if name not in z.namelist():
            return []
        out = []
        for el in ET.fromstring(z.read(name)).iter("{%s}Relationship" % RELS):
            external = el.get("TargetMode") == "External"
            target = el.get("Target", "")
            resolved = None if external else (
                target[1:] if target.startswith("/")
                else posixpath.normpath(posixpath.join(posixpath.dirname(part), target)))
            out.append((el.get("Id"), el.get("Type", ""), resolved))
        return out
    
    
    def workbook_of(z):
        office = [t for (_, ty, t) in rels_of(z, "") if ty.endswith("/officeDocument")]
        return office[0] if len(office) == 1 else None
    
    
    TOKEN = re.compile(rb"<!--.*?-->|<!\[CDATA\[.*?\]\]>|<[!?][^>]*>|<(/?)[^>]*?(/?)>", re.S)
    
    
    def top_level(data):
        """One (start, end) span per top-level element of some bytes."""
        spans = []
        depth = 0
        at = 0
        for m in TOKEN.finditer(data):
            tok = m.group(0)
            if tok.startswith(b"<!") or tok.startswith(b"<?"):
                continue
            if m.group(1):
                depth -= 1
                if depth == 0:
                    spans.append((at, m.end()))
            elif m.group(2):
                if depth == 0:
                    spans.append((m.start(), m.end()))
            else:
                if depth == 0:
                    at = m.start()
                depth += 1
        return spans
    
    
    def qname(raw):
        return re.match(rb"<([^\s/>]+)", raw).group(1)
    
    
    def split_name(q):
        p, _, n = q.rpartition(b":")
        return (p + b":" if p else b""), n.decode()
    
    
    def start_tag(raw):
        return raw[:raw.find(b">") + 1]
    
    
    def opened(tag):
        slash = tag.rfind(b"/")
        return tag[:slash] + tag[slash + 1:]
    
    
    ATTR_RE = rb'(?<=[\s])%s\s*=\s*("[^"]*"|\'[^\']*\')'
    
    
    def attr_value(tag, name):
        m = re.search(ATTR_RE % re.escape(name), tag)
        return m.group(1)[1:-1] if m else None
    
    
    def with_attr(tag, name, value):
        m = re.search(ATTR_RE % re.escape(name), tag)
        if m:
            q = m.start(1)
            return tag[:q + 1] + value + tag[m.end(1) - 1:]
        last = None
        for last in re.finditer(rb'\s[^\s=/>]+\s*=\s*("[^"]*"|\'[^\']*\')', tag):
            pass
        at = last.end() if last else len(re.match(rb"<[^\s/>]+", tag).group(0))
        return tag[:at] + b" " + name + b'="' + value + b'"' + tag[at:]
    
    
    def root_span(data):
        """(start of the root's start tag, end of it, start of the root's
        content, end of it, the root's prefix)."""
        m = re.search(rb"<([^\s/>?!]+)", data)
        close = data.find(b">", m.start())
        q = m.group(1)
        if data[close - 1:close] == b"/":
            return m.start(), close + 1, close + 1, close + 1, split_name(q)[0]
        return m.start(), close + 1, close + 1, data.rfind(b"</"), split_name(q)[0]
    
    
    def children(data, a, b, rp, root_ns):
        """[(start, end, main local name or None)] of the root's children."""
        out = []
        for (x, y) in top_level(data[a:b]):
            raw = data[a + x:a + y]
            p, n = split_name(qname(raw))
            tag = start_tag(raw)
            decl = rb'\sxmlns:' + re.escape(p[:-1]) if p else rb"\sxmlns"
            own = re.search(decl + rb'\s*=\s*("[^"]*"|\'[^\']*\')', tag)
            if own:
                main = own.group(1)[1:-1].decode() in MAIN
            else:
                main = p == rp and root_ns in MAIN
            out.append((a + x, a + y, n if main else None))
        return out
    
    
    def yn(v):
        return "yes" if v else "no"
    
    
    def values_of(root):
        """The values of an ElementTree as xlsx-diff keys them (M3 part 5 P1's
        rtcmp.py, copied by name): each attribute (namespace declarations are
        not attributes here) by element, attribute and value; each text node
        that is not whitespace alone by its element and its text."""
        vals = collections.Counter()
        ws = " \t\n\r"
    
        def walk(el):
            for (k, v) in el.attrib.items():
                vals[("a", el.tag, k, v)] += 1
            if el.text and el.text.strip(ws):
                vals[("t", el.tag, el.text)] += 1
            for c in el:
                walk(c)
                if c.tail and c.tail.strip(ws):
                    vals[("t", el.tag, c.tail)] += 1
    
        walk(root)
        return vals
    
    
    def is_xml_name(name):
        return name.lower().endswith((".xml", ".rels", ".vml"))
    
    
    def raw_of(z, name):
        """(compression method, the entry's stored bytes) read through its local
        header."""
        zi = z.getinfo(name)
        fp = z.fp
        fp.seek(zi.header_offset)
        head = fp.read(30)
        n, m = struct.unpack("<HH", head[26:30])
        fp.seek(zi.header_offset + 30 + n + m)
        return zi.compress_type, fp.read(zi.compress_size)
    
    
    def gap_of(z, name):
        """The bytes after an entry's stored data up to the next local header,
        or the central directory: its data descriptor, when it has one
        (xlsx-diff's gap, read here through the local headers)."""
        zi = z.getinfo(name)
        fp = z.fp
        fp.seek(zi.header_offset)
        head = fp.read(30)
        n, m = struct.unpack("<HH", head[26:30])
        end = zi.header_offset + 30 + n + m + zi.compress_size
        later = [i.header_offset for i in z.infolist() if i.header_offset >= end]
        nxt = min(later + [z.start_dir])
        fp.seek(end)
        return fp.read(max(0, nxt - end))
    
    
    def descriptor_differs(zin, zout, name):
        """xlsx-diff's descriptor flag for an entry both archives hold: general
        purpose bit 3 differs, or the bytes after the data differ."""
        b_in = zin.getinfo(name).flag_bits & 0x08
        b_out = zout.getinfo(name).flag_bits & 0x08
        return b_in != b_out or gap_of(zin, name) != gap_of(zout, name)
    
    
    def counts_of(vals):
        changed_xml, in_only, want_in, out_only, want_out, flagged_rows, want_flagged, recompressed = vals
        return ["changed_xml=%d" % changed_xml, "in_only=%d" % in_only, "in_only_want=%d" % want_in,
                "out_only=%d" % out_only, "out_only_want=%d" % want_out,
                "flagged_rows=%d" % flagged_rows, "flagged_want=%d" % want_flagged,
                "recompressed=%d" % recompressed]
    
    
    def options(rest, flags):
        diff_path = flag_plant = None
        while rest:
            if rest[0] == "--diff" and len(rest) >= 2:
                diff_path, rest = rest[1], rest[2:]
            elif rest[0] == "--plant" and len(rest) >= 2:
                flag_plant, rest = rest[1], rest[2:]
                if flag_plant not in flags:
                    return None, None, "error=unknown-plant"
            else:
                return None, None, "error=usage"
        return diff_path, flag_plant, None
    
    
    class Entries:
        """A read-only archive over entry name to uncompressed bytes."""
    
        def __init__(self, d):
            self.d = d
    
        def namelist(self):
            return list(self.d)
    
        def read(self, name):
            return self.d[name]
    
    
    def entries_of(z):
        return {i.filename: z.read(i.filename) for i in z.infolist()}
    
    
    def before_root_end(data, piece):
        at = data.rfind(b"</")
        return data[:at] + piece + data[at:]
    
    
    def values_and_flags(zin, zout, names, out_names, diff_path, flag_plant, flags):
        """copycmp.py's xml_values and flagged checks, carried but for one
        change (NSC): the flagged plant, which flips each rewritten entry's
        wanted flag, adds a phantom wanted row when no entry is rewritten, so
        the plant can turn the flag on a workbook whose output is written
        unchanged."""
        both = [nm for nm in names if nm in out_names]
        changed = [nm for nm in both if zin.read(nm) != zout.read(nm)]
        rewritten = [nm for nm in both if nm in changed or raw_of(zin, nm) != raw_of(zout, nm)]
        want_values = {}
        for nm in changed:
            if is_xml_name(nm):
                try:
                    vi, vo = values_of(ET.fromstring(zin.read(nm))), values_of(ET.fromstring(zout.read(nm)))
                    want_values[nm] = (sum((vi - vo).values()), sum((vo - vi).values()))
                except ET.ParseError:
                    want_values[nm] = None
        want_in = sum(v[0] for v in want_values.values() if v)
        want_out = sum(v[1] for v in want_values.values() if v)
        in_only = out_only = flagged_rows = want_flagged = -1
        if flag_plant == "xml_values":
            want_out += 1
        if diff_path is not None:
            rows = [l.split("\t") for l in open(diff_path, encoding="utf-8").read().split("\n") if l]
            values = {c[1]: c for c in rows if len(c) >= 7 and c[0] == "xml" and c[2] == "values"}
            in_only = sum(int(c[5]) for c in values.values())
            out_only = sum(int(c[6]) for c in values.values())
            per_ok = all(want_values.get(nm) is not None and (int(c[5]), int(c[6])) == want_values[nm]
                         for (nm, c) in values.items())
            flags["xml_values"] = (set(values) == set(want_values) and per_ok
                                   and in_only == want_in and out_only == want_out)
            ents = [{"name": c[1], "status": c[2], "flags": c[16]} for c in rows
                    if len(c) == 17 and c[0] == "entry"]
            flagged_rows = sum(1 for r in ents if r["flags"])
            wanted = {nm: ("descriptor" if descriptor_differs(zin, zout, nm) else "") for nm in rewritten}
            if flag_plant == "flagged":
                wanted = {nm: ("" if f else "descriptor") for (nm, f) in wanted.items()}
                if not wanted:
                    wanted = {"(planted)": "descriptor"}
            want_flagged = sum(1 for f in wanted.values() if f)
            statuses = {r["name"]: r["status"] for r in ents}
            rewritten_rows = {nm for (nm, st) in statuses.items() if st in ("changed", "recompressed")}
            recompressed_ok = all(statuses.get(nm) == ("changed" if nm in changed else "recompressed")
                                  for nm in rewritten)
            flags["flagged"] = (len(ents) > 0 and flagged_rows == want_flagged and rewritten_rows == set(rewritten)
                                and recompressed_ok
                                and all(r["flags"] == wanted.get(r["name"], "") for r in ents))
        return (len(want_values), in_only, want_in, out_only, want_out, flagged_rows, want_flagged,
                len(rewritten) - len(changed))
    
    
    FLAGS_OF = {
        "namedstyles": ("rest_same", "dxfs_prefix", "appended_match", "entries_same", "xml_values", "flagged"),
    }
    # The tool's line, its keys in its order (tools/emend-copy, --namedstyles-sample).
    KEYS = ("named", "named_xfs", "builtin", "custom", "resolved", "default_font_size", "dxfs", "dxf_fonts",
            "dxf_fills", "dxf_borders", "dxf_numfmts", "dxf_alignments", "dxf_protections", "dxf_gradients",
            "dxf_implied_solid", "dxf_inside_sides", "dxf_written", "dxf_equal")
    STYLES_TYPES = tuple(a + "/styles" for a in ATTR)
    SIDES = ("left", "right", "top", "bottom", "diagonal")
    INSIDE = ("vertical", "horizontal")
    WRITABLE = ("font", "fill", "border")
    # A dxf the comparison's own plant appends: no corpus dxf is compared with it.
    PLANTED_DXF = b'%sdxf><%sfont><%ssz val="77.25"/></%sfont></%sdxf>'
    
    
    def is_main(el, name):
        ns, n = local(el.tag)
        return ns in MAIN and n == name
    
    
    def main_kids(el, name):
        return [] if el is None else [c for c in el if is_main(c, name)]
    
    
    def first_kid(el, name):
        kids = main_kids(el, name)
        return kids[0] if kids else None
    
    
    def last_kid(el, name):
        kids = main_kids(el, name)
        return kids[-1] if kids else None
    
    
    def flag(value):
        """A schema boolean as the crate reads an attribute: 1 or true."""
        return value in ("1", "true")
    
    
    def number_text(value):
        """A size as the tool prints an f64: no fraction for a whole number."""
        return str(int(value)) if value == int(value) else repr(value)
    
    
    def color_model(el):
        """A colour element as the crate's one colour reader takes it: auto
        first, then rgb, theme (with its tint), indexed."""
        if el is None:
            return None
        a = el.attrib
        if flag(a.get("auto")):
            return ("auto",)
        if "rgb" in a:
            return ("rgb", int(a["rgb"], 16))
        if "theme" in a:
            return ("theme", int(a["theme"]), float(a["tint"]) if "tint" in a else None)
        if "indexed" in a:
            return ("indexed", int(a["indexed"]))
        return ("none",)
    
    
    def font_model(el):
        """A font's modelled children by value, the last of a kind winning as
        the crate reads them, and the names of its other children."""
        f = {"b": False, "i": False, "strike": False, "u": None, "vertAlign": None, "sz": None,
             "color": None, "name": None, "family": None, "scheme": None}
        other = []
        for c in el:
            n = local(c.tag)[1]
            v = c.get("val")
            if n in ("b", "i", "strike"):
                f[n] = v is None or flag(v)
            elif n == "u":
                f["u"] = None if v == "none" else (v or "single")
            elif n == "vertAlign":
                f["vertAlign"] = v
            elif n == "sz":
                f["sz"] = float(v)
            elif n == "color":
                f["color"] = color_model(c)
            elif n == "name":
                f["name"] = v
            elif n == "family":
                f["family"] = int(v)
            elif n == "scheme":
                f["scheme"] = None if v == "none" else v
            else:
                other.append(n)
        return f, other
    
    
    def fill_model(el):
        """A dxf fill by value: None when it holds no patternFill (a gradient,
        or nothing); an absent patternType read as solid (decision 2 A)."""
        pf = first_kid(el, "patternFill")
        if pf is None:
            return None
        pt = pf.get("patternType")
        return {"pattern": "solid" if pt is None else pt, "fg": color_model(first_kid(pf, "fgColor")),
                "bg": color_model(first_kid(pf, "bgColor"))}
    
    
    def border_model(el):
        """A border by value, and its inside sides' count."""
        out = {"up": flag(el.get("diagonalUp")), "down": flag(el.get("diagonalDown"))}
        for s in SIDES:
            side = last_kid(el, s)
            if side is None or side.get("style") in (None, "none"):
                out[s] = None
            else:
                out[s] = (side.get("style"), color_model(first_kid(side, "color")))
        inside = sum(len(main_kids(el, s)) for s in INSIDE)
        return out, inside
    
    
    def kid_names(dxf):
        return [local(c.tag)[1] for c in dxf if local(c.tag)[0] in MAIN]
    
    
    def writable(dxf):
        """Whether the tool writes the dxf back: its children font, fill and
        border alone, and at least one read (a fill holding a patternFill)."""
        names = kid_names(dxf)
        if not names or any(n not in WRITABLE for n in names) or len(names) != len(list(dxf)):
            return False
        fill = first_kid(dxf, "fill")
        return first_kid(dxf, "font") is not None or first_kid(dxf, "border") is not None \
            or (fill is not None and fill_model(fill) is not None)
    
    
    def matches(src, out):
        """Whether the written dxf `out` is its source `src` as the types model
        them (see the docstring)."""
        want = [n for n in WRITABLE if first_kid(src, n) is not None
                and not (n == "fill" and fill_model(first_kid(src, n)) is None)]
        if kid_names(out) != want or len(list(out)) != len(want):
            return False
        if "font" in want:
            fs, _ = font_model(first_kid(src, "font"))
            fo, other = font_model(first_kid(out, "font"))
            # The written font holds the modelled children alone: the five the
            # type has no field for, and anything else, absent.
            if fs != fo or other:
                return False
        if "fill" in want:
            po = first_kid(first_kid(out, "fill"), "patternFill")
            if po is None or po.get("patternType") is None:
                return False
            if fill_model(first_kid(src, "fill")) != fill_model(first_kid(out, "fill")):
                return False
        if "border" in want:
            bs, _ = border_model(first_kid(src, "border"))
            bo_el = first_kid(out, "border")
            bo, inside = border_model(bo_el)
            if bs != bo or inside != 0 or bo_el.get("outline") is not None:
                return False
        return True
    
    
    def styles_of(z):
        """The styles part's name, the workbook's first styles relationship's."""
        wb = workbook_of(z)
        if wb is None:
            return None
        for (_, ty, t) in rels_of(z, wb):
            if ty in STYLES_TYPES and t is not None:
                return t
        return None
    
    
    def counts_from(root):
        """The tool's counts but dxf_equal, counted from the input's part."""
        xfs = main_kids(first_kid(root, "cellStyleXfs"), "xf")
        named = main_kids(first_kid(root, "cellStyles"), "cellStyle")
        fonts = main_kids(first_kid(root, "fonts"), "font")
        fills = main_kids(first_kid(root, "fills"), "fill")
        borders = main_kids(first_kid(root, "borders"), "border")
        resolved = sum(1 for x in xfs if int(x.get("fontId", "0")) < len(fonts)
                       and int(x.get("fillId", "0")) < len(fills) and int(x.get("borderId", "0")) < len(borders))
        fid = int(xfs[0].get("fontId", "0")) if xfs else 0
        sz = last_kid(fonts[fid], "sz") if fid < len(fonts) else None
        size = float(sz.get("val")) if sz is not None else 0.0
        dxfs = main_kids(first_kid(root, "dxfs"), "dxf")
    
        def having(name):
            return sum(1 for d in dxfs if first_kid(d, name) is not None)
    
        fills_read = sum(1 for d in dxfs if first_kid(d, "fill") is not None and fill_model(first_kid(d, "fill")) is not None)
        return {
            "named": len(named), "named_xfs": len(xfs),
            "builtin": sum(1 for s in named if "builtinId" in s.attrib),
            "custom": sum(1 for s in named if flag(s.get("customBuiltin"))),
            "resolved": resolved, "default_font_size": number_text(size), "dxfs": len(dxfs),
            "dxf_fonts": having("font"), "dxf_fills": fills_read, "dxf_borders": having("border"),
            "dxf_numfmts": having("numFmt"), "dxf_alignments": having("alignment"),
            "dxf_protections": having("protection"),
            "dxf_gradients": having("fill") - fills_read,
            "dxf_implied_solid": sum(1 for d in dxfs for f in main_kids(d, "fill") for p in main_kids(f, "patternFill")
                                     if p.get("patternType") is None),
            "dxf_inside_sides": sum(border_model(b)[1] for d in dxfs for b in main_kids(d, "border")),
            "dxf_written": sum(1 for d in dxfs if writable(d)),
        }
    
    
    def dxfs_span(data):
        """(start, end) of the root's first main dxfs child, or None."""
        rs = root_span(data)
        ns = local(ET.fromstring(data).tag)[0]
        for (x, y, n) in children(data, rs[2], rs[3], rs[4], ns):
            if n == "dxfs":
                return (x, y)
        return None
    
    
    def content_of(raw):
        """The bytes between an element's start tag and its end tag, empty for
        an empty-element tag."""
        t = start_tag(raw)
        if t.endswith(b"/>"):
            return b""
        return raw[len(t):raw.rfind(b"</")]
    
    
    def without_count(tag):
        """A start tag with its count attribute gone and its closing made plain,
        for comparing two dxfs start tags but for count."""
        m = re.search(ATTR_RE % b"count", tag)
        if m:
            tag = tag[:m.start()].rstrip() + tag[m.end():]
            tag = re.sub(rb"\s*(/?>)$", rb"\1", tag)
        return opened(tag) if tag.endswith(b"/>") else tag
    
    
    def plant_out(flag_name, sp, od):
        """Changes the output as read so that `flag_name` turns to no; whether
        there was something to change."""
        if flag_name in ("xml_values", "flagged"):
            return True
        if flag_name == "entries_same":
            for nm in sorted(od):
                if nm != sp:
                    od[nm] = od[nm] + b" "
                    return True
            return False
        if sp not in od:
            return False
        data = od[sp]
        rs = root_span(data)
        if flag_name == "rest_same":
            od[sp] = data[:rs[1]] + COMMENT + data[rs[1]:]
            return True
        span = dxfs_span(data)
        if flag_name == "dxfs_prefix":
            if span is None:
                od[sp] = before_root_end(data, b"<" + rs[4] + b'dxfs count="1"><' + rs[4] + b"dxf/></" + rs[4] + b"dxfs>")
                return True
            x, y = span
            raw = data[x:y]
            t = start_tag(raw)
            have = attr_value(t, b"count")
            new = with_attr(t, b"count", str(int(have) + 1000 if have and have.isdigit() else 1000).encode())
            od[sp] = data[:x] + new + data[x + len(t):]
            return True
        if flag_name == "appended_match":
            if span is None:
                p = rs[4]
                od[sp] = before_root_end(data, b"<" + p + b'dxfs count="1"><' + (PLANTED_DXF % (p, p, p, p, p)) + b"</" + p + b"dxfs>")
                return True
            x, y = span
            raw = data[x:y]
            p = split_name(qname(raw))[0]
            piece = b"<" + PLANTED_DXF % (p, p, p, p, p)
            if raw.endswith(b"/>"):
                new = opened(raw) + piece + b"</" + qname(raw) + b">"
            else:
                at = raw.rfind(b"</")
                new = raw[:at] + piece + raw[at:]
            od[sp] = data[:x] + new + data[y:]
            return True
        raise KeyError(flag_name)
    
    
    def flags_of(zin, sp, od):
        f = {}
        din = zin.read(sp)
        dout = od.get(sp)
        names = zin.namelist()
        f["entries_same"] = set(od) == set(names) and all(od[nm] == zin.read(nm) for nm in names if nm != sp)
        rin = ET.fromstring(din)
        counts = counts_from(rin)
        if dout is None:
            f["rest_same"] = f["dxfs_prefix"] = f["appended_match"] = False
            counts["dxf_equal"] = 0
            return f, counts
        sin, sout = dxfs_span(din), dxfs_span(dout)
        if sin is None:
            f["rest_same"] = dout == din
            f["dxfs_prefix"] = sout is None
        elif sout is None:
            f["rest_same"] = f["dxfs_prefix"] = False
        else:
            f["rest_same"] = din[:sin[0]] == dout[:sout[0]] and din[sin[1]:] == dout[sout[1]:]
            rin_raw, rout_raw = din[sin[0]:sin[1]], dout[sout[0]:sout[1]]
            cin, cout = content_of(rin_raw), content_of(rout_raw)
            kids_out = len(top_level(cout))
            count_out = attr_value(start_tag(rout_raw), b"count")
            f["dxfs_prefix"] = (cout.startswith(cin)
                                and without_count(start_tag(rin_raw)) == without_count(start_tag(rout_raw))
                                and (count_out is None or count_out == str(kids_out).encode()))
        if counts["dxf_written"] == 0 and sin is not None:
            f["rest_same"] = f["rest_same"] and dout == din
        try:
            rout = ET.fromstring(dout)
        except ET.ParseError:
            f["appended_match"] = False
            counts["dxf_equal"] = 0
            return f, counts
        din_list = main_kids(first_kid(rin, "dxfs"), "dxf")
        dout_list = main_kids(first_kid(rout, "dxfs"), "dxf")
        sources = [d for d in din_list if writable(d)]
        appended = dout_list[len(din_list):]
        equal = sum(1 for (s, o) in zip(sources, appended) if matches(s, o))
        f["appended_match"] = len(appended) == len(sources) and equal == len(sources)
        counts["dxf_equal"] = equal
        return f, counts
    
    
    def main():
        args = sys.argv[1:]
        if len(args) < 3 or args[0] not in FLAGS_OF:
            print("error=usage")
            return
        zin = zipfile.ZipFile(args[1])
        sp = styles_of(zin)
        if sp is None or sp not in zin.namelist():
            print("error=no-styles-part")
            return
        if args[2:] == ["--parts"]:
            print(sp)
            print(counts_from(ET.fromstring(zin.read(sp)))["dxf_written"])
            return
        zout = zipfile.ZipFile(args[2])
        flags = {}
        diff_path, plant, err = options(args[3:], FLAGS_OF["namedstyles"])
        if err:
            print(err)
            return
        od = entries_of(zout)
        planted = None
        if plant is not None:
            planted = plant_out(plant, sp, od)
        f, counts = flags_of(zin, sp, od)
        flags.update(f)
        vals = values_and_flags(zin, zout, zin.namelist(), zout.namelist(), diff_path, plant, flags)
        fields = ["%s=%s" % (k, counts[k]) for k in KEYS] + counts_of(vals)
        if plant is not None:
            fields.append("planted=%s" % yn(planted))
        if diff_path is None:
            flags.setdefault("xml_values", False)
            flags.setdefault("flagged", False)
        print("\t".join(fields + ["%s=%s" % (k, yn(flags[k])) for k in FLAGS_OF["namedstyles"]]))
    
    
    main()
