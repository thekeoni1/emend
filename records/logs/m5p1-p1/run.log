command: cp <scripts>/namedcmp.py <work>/namedcmp.py; sed 's/^/    /' <work>/namedcmp.py; sha256 f5bdbcbeaa6bc83624f6df7e5178d5c2d73c653d80bce8d73c843183a8656ba3, 29077 bytes
