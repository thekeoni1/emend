command: cp <scripts>/colorcmp.py <work>/colorcmp.py; sed 's/^/    /' <work>/colorcmp.py; sha256 db3cc89b8e2013741c6dca66b0ed0e501d77ffa6d51a6e67d8e2be494add2bc4, 18734 bytes
  the copy is the file beside this script, byte for byte: yes
    """M5 part 1 P2's run log comparison for the colours sample
    (specs/0032-read-breadth-styles.md, "Harness runs", the colors bullet, and
    "Planning rulings during P2", rulings 5, 6, 8, 9 and 10). Written for this
    phase (<home>/.cache/emend-build/m5p1-p2/gen/colorcmp_src.py, copied by
    gen/run.py to <scripts>/colorcmp.py); independent of the crate: Python's
    zipfile, ElementTree and colorsys, the palette typed here from the standard's
    table.
    
    Usage:
      colorcmp.py colors <input.xlsx> <output.xlsx> [--plant <flag>]
          One line of key=value pairs, space separated: the tool line's keys,
          counted and resolved from the input by this check, then its own keys
          (tints_other, font_theme1, fill_theme0, theme_error) and its flags
          (entries_same). With --plant, the named flag's check is run on a
          planted difference in memory and the line gains planted=yes; an
          unknown flag prints error=unknown-plant.
      colorcmp.py --selftest
          The checks over a fictional workbook built in memory (the tool test's
          COLORS_STYLES and COLORS_THEME, tools/emend-copy/tests/null_rewrite.rs),
          against the values that test asserts, and each check against a planted
          difference; one "name: yes|no" line per check.
    Never prints a name, a reference, a text or a colour value from a workbook:
    counts, flags and digests only."""
    import colorsys
    import io
    import math
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    
    MAIN = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
            "http://purl.oclc.org/ooxml/spreadsheetml/main")
    DRAWING = ("http://schemas.openxmlformats.org/drawingml/2006/main",
               "http://purl.oclc.org/ooxml/drawingml/main")
    RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
    THEME_TYPES = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships/theme",
                   "http://purl.oclc.org/ooxml/officeDocument/relationships/theme")
    
    # ECMA-376 Part 1, 18.8.27, the default indexedColors, indexes 0 to 63, typed
    # here from the standard's table (written there 00RRGGBB); the top byte FF
    # (ruling 8).
    PALETTE = [0xFF000000 | v for v in (
        0x000000, 0xFFFFFF, 0xFF0000, 0x00FF00, 0x0000FF, 0xFFFF00, 0xFF00FF, 0x00FFFF,
        0x000000, 0xFFFFFF, 0xFF0000, 0x00FF00, 0x0000FF, 0xFFFF00, 0xFF00FF, 0x00FFFF,
        0x800000, 0x008000, 0x000080, 0x808000, 0x800080, 0x008080, 0xC0C0C0, 0x808080,
        0x9999FF, 0x993366, 0xFFFFCC, 0xCCFFFF, 0x660066, 0xFF8080, 0x0066CC, 0xCCCCFF,
        0x000080, 0xFF00FF, 0xFFFF00, 0x00FFFF, 0x800080, 0x800000, 0x008080, 0x0000FF,
        0x00CCFF, 0xCCFFFF, 0xCCFFCC, 0xFFFF99, 0x99CCFF, 0xFF99CC, 0xCC99FF, 0xFFCC99,
        0x3366FF, 0x33CCCC, 0x99CC00, 0xFFCC00, 0xFF9900, 0xFF6600, 0x666699, 0x969696,
        0x003366, 0x339966, 0x003300, 0x333300, 0x993300, 0x993366, 0x333399, 0x333333,
    )]
    SCHEME = ("dk1", "lt1", "dk2", "lt2", "accent1", "accent2", "accent3", "accent4",
              "accent5", "accent6", "hlink", "folHlink")
    # A colour's theme index names the scheme with the first two pairs swapped.
    SWAP = (1, 0, 3, 2, 4, 5, 6, 7, 8, 9, 10, 11)
    SIDES = ("left", "right", "top", "bottom", "diagonal")
    KEYS = ("colors", "rgb", "theme", "indexed", "auto", "resolved", "unresolved", "tinted",
            "theme_part", "scheme_dark_text", "scheme_light_fill", "palette_override",
            "digest_fonts", "digest_fills", "digest_borders", "digest_dxfs")
    OWN = ("tints_other", "font_theme1", "fill_theme0", "theme_error")
    FLAGS_OF = {"colors": ("entries_same",)}
    
    
    def ns(tag):
        return tag[1:].split("}")[0] if tag.startswith("{") else ""
    
    
    def local(tag):
        return tag.split("}")[-1]
    
    
    def kids(element, name, spaces=MAIN):
        return [c for c in element if ns(c.tag) in spaces and local(c.tag) == name]
    
    
    def kid(element, name):
        found = kids(element, name)
        return found[0] if found else None
    
    
    def form(attrib):
        """The colour's form by color_from's precedence: auto, rgb, theme,
        indexed (ruling 6); its value; its tint (theme only)."""
        if attrib.get("auto") in ("1", "true"):
            return ("auto", None, None)
        if "rgb" in attrib:
            return ("rgb", int(attrib["rgb"], 16), None)
        if "theme" in attrib:
            tint = float(attrib["tint"]) if "tint" in attrib else None
            return ("theme", int(attrib["theme"]), tint)
        if "indexed" in attrib:
            return ("indexed", int(attrib["indexed"]), None)
        return ("none", None, None)
    
    
    def half_up(value):
        return int(math.floor(value + 0.5))
    
    
    def tinted(rgb, tint):
        """ECMA-376 Part 1, 18.8.19 with HLSMAX 255, through colorsys; each
        channel rounded half away from zero, the alpha byte kept."""
        if tint is None:
            return rgb
        hls_max = 255.0
        r, g, b = (((rgb >> s) & 0xFF) / 255.0 for s in (16, 8, 0))
        h, l, s = colorsys.rgb_to_hls(r, g, b)
        lum = l * hls_max
        lum = lum * (1.0 + tint) if tint < 0 else lum * (1.0 - tint) + hls_max * tint
        r, g, b = colorsys.hls_to_rgb(h, lum / hls_max, s)
        ch = [max(0, min(255, half_up(v * 255.0))) for v in (r, g, b)]
        return (rgb & 0xFF000000) | (ch[0] << 16) | (ch[1] << 8) | ch[2]
    
    
    def fnv(entries):
        h = 0xCBF29CE484222325
        for entry in entries:
            for byte in (entry + "\n").encode():
                h ^= byte
                h = (h * 0x100000001B3) & 0xFFFFFFFFFFFFFFFF
        return "%016x" % h
    
    
    def theme_of(z):
        """The twelve scheme colours of the theme the workbook's first theme
        relationship names, in element order, or None without one."""
        try:
            rels = ET.fromstring(z.read("xl/_rels/workbook.xml.rels"))
        except KeyError:
            return None
        target = None
        for rel in rels:
            if local(rel.tag) == "Relationship" and rel.get("Type") in THEME_TYPES:
                target = rel.get("Target")
                break
        if target is None:
            return None
        path = target.lstrip("/") if target.startswith("/") else "xl/" + target
        root = ET.fromstring(z.read(path))
        schemes = [c for e in kids(root, "themeElements", DRAWING) for c in kids(e, "clrScheme", DRAWING)]
        if len(schemes) != 1:
            raise ValueError("scheme")
        out = []
        for name in SCHEME:
            child = kids(schemes[0], name, DRAWING)
            if len(child) != 1 or len(list(child[0])) != 1:
                raise ValueError("scheme child")
            c = list(child[0])[0]
            attr = {"srgbClr": "val", "sysClr": "lastClr"}.get(local(c.tag))
            if attr is None or len(c.get(attr, "")) != 6:
                raise ValueError("scheme colour")
            out.append(0xFF000000 | int(c.get(attr), 16))
        return out
    
    
    def groups_of(styles):
        """The four groups of ruling 10, each a list of (role, attrib)."""
        fonts, fills, borders, dxfs = [], [], [], []
    
        def font_colors(font, into):
            for c in kids(font, "color"):
                into.append(("font", c.attrib))
    
        def fill_colors(fill, into):
            pattern = kid(fill, "patternFill")
            if pattern is None:
                return
            for name in ("fgColor", "bgColor"):
                for c in kids(pattern, name):
                    into.append(("fill", c.attrib))
    
        def border_colors(border, into):
            for side in SIDES:
                for s in kids(border, side):
                    for c in kids(s, "color"):
                        into.append(("border", c.attrib))
    
        for container, child, into, each in (("fonts", "font", fonts, font_colors),
                                             ("fills", "fill", fills, fill_colors),
                                             ("borders", "border", borders, border_colors)):
            for box in kids(styles, container):
                for element in kids(box, child):
                    each(element, into)
        for box in kids(styles, "dxfs"):
            for dxf in kids(box, "dxf"):
                for font in kids(dxf, "font"):
                    font_colors(font, dxfs)
                for fill in kids(dxf, "fill"):
                    fill_colors(fill, dxfs)
                for border in kids(dxf, "border"):
                    border_colors(border, dxfs)
        return [fonts, fills, borders, dxfs]
    
    
    def override_of(styles):
        for colors in kids(styles, "colors"):
            for indexed in kids(colors, "indexedColors"):
                return [int(c.get("rgb"), 16) for c in kids(indexed, "rgbColor")]
        return None
    
    
    def counts(z, plant=None):
        styles = ET.fromstring(z.read("xl/styles.xml"))
        try:
            scheme = theme_of(z)
            theme_error = 0
        except (ValueError, KeyError, ET.ParseError):
            scheme, theme_error = None, 1
        if plant == "swap" and scheme is not None:
            scheme[0], scheme[1] = scheme[1], scheme[0]
        override = override_of(styles)
        out = dict.fromkeys(KEYS[:12] + OWN, 0)
        out["theme_part"] = 1 if scheme is not None else 0
        out["palette_override"] = 1 if override is not None else 0
        out["theme_error"] = theme_error
        digests = []
        for group in groups_of(styles):
            entries = []
            for role, attrib in group:
                kind, value, tint = form(attrib)
                out["colors"] += 1
                out[kind] = out.get(kind, 0) + 1
                if "tint" in attrib and kind != "theme":
                    out["tints_other"] += 1
                rgb = None
                if kind == "rgb":
                    rgb = value
                elif kind == "indexed":
                    if override is not None and value < len(override):
                        rgb = override[value]
                    elif value < len(PALETTE):
                        rgb = PALETTE[value]
                elif kind == "theme":
                    if value > 11 or (tint is not None and (math.isnan(tint) or not -1.0 <= tint <= 1.0)):
                        out["theme_error"] = 1
                    elif scheme is not None:
                        rgb = scheme[SWAP[value]]
                if kind == "theme" and value == 1 and role == "font":
                    out["font_theme1"] += 1
                if kind == "theme" and value == 0 and role == "fill":
                    out["fill_theme0"] += 1
                if rgb is None:
                    out["unresolved"] += 1
                    entries.append("none")
                    continue
                out["resolved"] += 1
                if tint is not None:
                    out["tinted"] += 1
                entries.append("%08x:%08x" % (rgb, tinted(rgb, tint)))
                channels = [(rgb >> s) & 0xFF for s in (16, 8, 0)]
                if kind == "theme" and value == 1 and role == "font" and all(c < 128 for c in channels):
                    out["scheme_dark_text"] += 1
                if kind == "theme" and value == 0 and role == "fill" and all(c >= 128 for c in channels):
                    out["scheme_light_fill"] += 1
            digests.append(fnv(entries))
        for key, digest in zip(KEYS[12:], digests):
            out[key] = digest
        return out
    
    
    def entries_same(zin, zout, plant=False):
        a = [(i.filename, zin.read(i.filename)) for i in zin.infolist()]
        b = [(i.filename, zout.read(i.filename)) for i in zout.infolist()]
        if plant and b:
            b[-1] = (b[-1][0], b[-1][1] + b"x")
        return a == b
    
    
    def line(zin, zout, plant=None):
        if plant is not None and plant not in FLAGS_OF["colors"] + ("swap",):
            return "error=unknown-plant"
        out = counts(zin, plant)
        out["entries_same"] = "yes" if entries_same(zin, zout, plant == "entries_same") else "no"
        text = " ".join("%s=%s" % (k, out[k]) for k in KEYS + OWN + ("entries_same",))
        return text + (" planted=yes" if plant is not None else "")
    
    
    # The fictional workbook of the tool's test, and the values that test asserts.
    SELF_STYLES = (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        '<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
        '<fonts count="3"><font><color theme="1"/></font><font><color rgb="FF112233"/></font>'
        '<font><b/></font></fonts>'
        '<fills count="3"><fill><patternFill patternType="none"/></fill>'
        '<fill><patternFill patternType="gray125"/></fill>'
        '<fill><patternFill patternType="solid"><fgColor theme="0" tint="-0.5"/>'
        '<bgColor indexed="64"/></patternFill></fill></fills>'
        '<borders count="2"><border/><border><left style="thin"><color indexed="0"/></left>'
        '<bottom style="thin"><color auto="1"/></bottom></border></borders>'
        '<cellXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellXfs>'
        '<dxfs count="1"><dxf><font><color theme="4"/></font><fill><patternFill>'
        '<bgColor theme="0"/></patternFill></fill></dxf></dxfs>'
        '<colors><indexedColors><rgbColor rgb="00ABCDEF"/></indexedColors></colors>'
        '</styleSheet>')
    SELF_THEME = (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        '<a:theme xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" name="T">'
        '<a:themeElements><a:clrScheme name="S">'
        '<a:dk1><a:sysClr val="windowText" lastClr="000000"/></a:dk1>'
        '<a:lt1><a:sysClr val="window" lastClr="FFFFFF"/></a:lt1>'
        '<a:dk2><a:srgbClr val="102030"/></a:dk2><a:lt2><a:srgbClr val="E0E0D0"/></a:lt2>'
        '<a:accent1><a:srgbClr val="4080C0"/></a:accent1>'
        '<a:accent2><a:srgbClr val="C04040"/></a:accent2>'
        '<a:accent3><a:srgbClr val="80C040"/></a:accent3>'
        '<a:accent4><a:srgbClr val="8060A0"/></a:accent4>'
        '<a:accent5><a:srgbClr val="40B0C0"/></a:accent5>'
        '<a:accent6><a:srgbClr val="F09040"/></a:accent6>'
        '<a:hlink><a:srgbClr val="0000FE"/></a:hlink>'
        '<a:folHlink><a:srgbClr val="800081"/></a:folHlink>'
        '</a:clrScheme></a:themeElements></a:theme>')
    SELF_RELS = (
        '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
        '<Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/'
        'relationships/styles" Target="styles.xml"/>'
        '<Relationship Id="rId4" Type="http://schemas.openxmlformats.org/officeDocument/2006/'
        'relationships/theme" Target="theme/theme1.xml"/></Relationships>')
    SELF_WANT = ("colors=8 rgb=1 theme=4 indexed=2 auto=1 resolved=6 unresolved=2 tinted=1 "
                 "theme_part=1 scheme_dark_text=1 scheme_light_fill=2 palette_override=1 "
                 "digest_fonts=b2d4a31cd1a1d745 digest_fills=3383724a16d5828b "
                 "digest_borders=2c54dd97b9773d11 digest_dxfs=84895f0714726f1b")
    
    
    def book(styles=SELF_STYLES, theme=SELF_THEME, rels=SELF_RELS):
        buf = io.BytesIO()
        with zipfile.ZipFile(buf, "w") as z:
            z.writestr("xl/_rels/workbook.xml.rels", rels)
            z.writestr("xl/styles.xml", styles)
            if theme is not None:
                z.writestr("xl/theme/theme1.xml", theme)
        return zipfile.ZipFile(io.BytesIO(buf.getvalue()))
    
    
    def kv(text, key):
        for pair in text.split(" "):
            if pair.startswith(key + "="):
                return pair[len(key) + 1:]
        return None
    
    
    def selftest():
        checks = []
        base = line(book(), book())
        want = dict(p.split("=") for p in SELF_WANT.split(" "))
        checks.append(("the fictional workbook gives the tool test's sixteen values",
                       all(kv(base, k) == v for k, v in want.items())))
        checks.append(("the fictional workbook's swap proof holds (dark text the theme-1 fonts, light fill the theme-0 fills)",
                       kv(base, "scheme_dark_text") == kv(base, "font_theme1") == "1"
                       and kv(base, "scheme_light_fill") == kv(base, "fill_theme0") == "2"))
        checks.append(("the fictional pair's entries are the same", kv(base, "entries_same") == "yes"))
        checks.append(("palette entries 0 to 15: black, white, red, green, blue, yellow, magenta, cyan, twice, FF top byte",
                       PALETTE[:8] == PALETTE[8:16] == [0xFF000000, 0xFFFFFFFF, 0xFFFF0000, 0xFF00FF00,
                                                        0xFF0000FF, 0xFFFFFF00, 0xFFFF00FF, 0xFF00FFFF]
                       and len(PALETTE) == 64))
        checks.append(("the tint's known cases: 0.5 on black and -0.5 on white give FF808080",
                       tinted(0xFF000000, 0.5) == 0xFF808080 == tinted(0xFFFFFFFF, -0.5)))
        checks.append(("the empty list's digest is FNV-1a's offset basis", fnv([]) == "cbf29ce484222325"))
        # Planted differences, each turning its own check.
        planted = line(book(), book(), "entries_same")
        checks.append(("control: a planted output byte turns entries_same to no", kv(planted, "entries_same") == "no"))
        swapped = line(book(), book(), "swap")
        checks.append(("control: the scheme's dk1 and lt1 swapped turns the swap proof (dark text 0 of 1 theme-1 font)",
                       kv(swapped, "scheme_dark_text") == "0" and kv(swapped, "font_theme1") == "1"))
        checks.append(("control: the same swap changes the fonts digest", kv(swapped, "digest_fonts") != want["digest_fonts"]))
        other = line(book(SELF_STYLES.replace('<color indexed="0"/>', '<color indexed="0" tint="0.5"/>')), book())
        checks.append(("control: a tint on an indexed colour is counted apart and changes no digest",
                       kv(other, "tints_other") == "1" and kv(other, "tinted") == "1"
                       and kv(other, "digest_borders") == want["digest_borders"]))
        nooverride = line(book(SELF_STYLES.replace('<colors><indexedColors><rgbColor rgb="00ABCDEF"/>'
                                                   '</indexedColors></colors>', '')), book())
        checks.append(("control: without the override the borders digest and palette_override change",
                       kv(nooverride, "palette_override") == "0" and kv(nooverride, "digest_borders") != want["digest_borders"]))
        notheme = line(book(theme=None), book(theme=None))
        checks.append(("control: without a theme part every theme colour is unresolved",
                       kv(notheme, "theme_part") == "0" and kv(notheme, "unresolved") == "6"))
        autozero = line(book(SELF_STYLES.replace('<color auto="1"/>', '<color auto="0" rgb="FF000001"/>')), book())
        checks.append(("control: auto=0 with an rgb counts as rgb (color_from's precedence)",
                       kv(autozero, "auto") == "0" and kv(autozero, "rgb") == "2"))
        sides = line(book(SELF_STYLES.replace('<dxf><font>', '<dxf><border><vertical style="thin"><color rgb="FF000002"/>'
                                                             '</vertical></border><font>')), book())
        checks.append(("control: a dxf border's vertical side gives nothing", kv(sides, "colors") == "8"))
        for name, ok in checks:
            print("%s: %s" % (name, "yes" if ok else "no"))
    
    
    def main(argv):
        if argv[1:] == ["--selftest"]:
            selftest()
            return 0
        if len(argv) not in (4, 6) or argv[1] != "colors" or (len(argv) == 6 and argv[4] != "--plant"):
            print("error=usage")
            return 2
        plant = argv[5] if len(argv) == 6 else None
        print(line(zipfile.ZipFile(argv[2]), zipfile.ZipFile(argv[3]), plant))
        return 0
    
    
    if __name__ == "__main__":
        sys.exit(main(sys.argv))
