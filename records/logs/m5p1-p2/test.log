    DOC=$(by_subject "M5 part 1 P2: commit planning docs (the P1 verification and rulings)")
    CRATE=$(by_subject "M5 part 1 P2: colours resolved through the palette, indexedColors and the theme")
    TOOL=$(by_subject "M5 part 1 P2: emend-copy --colors-sample")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's full subject>, for each role"
    echo "  M5 part 1 P1's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the crate commit (colours, the carry): ${CRATE:-none}"
    echo "  the tool commit (--colors-sample), the phase commit: ${TOOL:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~3"
    for k in 0 1 2 3; do git rev-parse "$C~$k"; done | sed 's/^/    /'
