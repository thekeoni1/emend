## the fixtures: P1's namedstyles base and P2's colors base, each with its cases (change MM)
    """Fictional packages for M5 part 1 P3's negative log, the namedstyles half
    (P1's generator, carried; change MM): the phase commit's template files,
    zipped in the template's order, the styles part replaced by a fictional one
    holding two fonts, two cellStyleXfs formats, three named styles and five
    differential styles. B0 is that package; each other case is B0 with one
    exact replacement in its styles part, the count of the replaced text
    asserted 1 and printed. The cases are named by their P3 numbers: N1 to N6
    are P1's N1 to N6, N14 is P3's (no <fonts>, <cellStyleXfs> or <cellStyles>).
    Usage: gen-ns.py <template dir> <out dir>."""
    import os
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    MAIN_NS = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    FONTS = '<fonts count="2"><font><sz val="10.5"/></font><font><b/><sz val="9"/></font></fonts>'
    FILLS_BORDERS = ('<fills count="1"><fill><patternFill patternType="none"/></fill></fills>'
                     '<borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders>')
    CELL_STYLE_XFS = ('<cellStyleXfs count="2"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/>'
                      '<xf numFmtId="0" fontId="1" fillId="0" borderId="0"/></cellStyleXfs>')
    CELL_XFS = '<cellXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/></cellXfs>'
    CELL_STYLES = ('<cellStyles count="3"><cellStyle name="Normal" xfId="0" builtinId="0"/>'
                   '<cellStyle name="Fict" xfId="1" customBuiltin="1"/><cellStyle name="Fict 2" xfId="1"/>'
                   '</cellStyles>')
    STYLES = (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        '<styleSheet xmlns="' + MAIN_NS + '">' + FONTS + FILLS_BORDERS + CELL_STYLE_XFS + CELL_XFS
        + CELL_STYLES + '<dxfs count="5">'
        '<dxf><font><b/></font><fill><patternFill><bgColor rgb="FFFFC7CE"/></patternFill></fill></dxf>'
        '<dxf><border><left style="thin"/><right/><top/><bottom/><diagonal/>'
        '<horizontal style="thin"/></border></dxf>'
        '<dxf><numFmt numFmtId="170" formatCode="0.0"/></dxf>'
        '<dxf><fill><gradientFill degree="90"><stop position="0"><color theme="0"/></stop>'
        '<stop position="1"><color theme="4"/></stop></gradientFill></fill></dxf>'
        '<dxf><fill><patternFill patternType="solid"><fgColor theme="4"/></patternFill></fill></dxf>'
        '</dxfs></styleSheet>'
    )
    # N14 (P3; change MN): default_font must be the one call that can refuse.
    # At the phase commit, Styles::resolve looks a format's font up at
    # fontId, 0 when absent, so with no <fonts> every named_style refuses
    # whether or not its xf carries a fontId; the sample calls named_style for
    # each cellStyleXfs index before default_font, and the styles read refuses a
    # cellStyle whose xfId is past <cellStyleXfs>. So N14 drops <fonts>,
    # <cellStyleXfs> and <cellStyles> together, in one contiguous replacement
    # that keeps the fills, borders and cellXfs between them: named_xfs is 0 and
    # named_style is never called, the read takes the part (it checks no
    # cellXfs fontId, and the sample resolves no cell format), and
    # default_font's first test, a part with no <fonts>, refuses.
    N14_SPAN = FONTS + FILLS_BORDERS + CELL_STYLE_XFS + CELL_XFS + CELL_STYLES
    # case: (text replaced in B0's styles part, its replacement)
    CASES = {
        "n1": ('<cellStyle name="Fict 2" xfId="1"/>', '<cellStyle name="Fict 2" xfId="2"/>'),
        "n2": ('<borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders>',
               '<borders count="1"><border><left/><right/><top/><bottom/><diagonal/><horizontal/></border></borders>'),
        "n3": ('</dxfs>', '</dxfs><dxfs count="0"/>'),
        "n4": ('<dxf><numFmt numFmtId="170" formatCode="0.0"/></dxf>',
               '<dxf><numFmt numFmtId="170" formatCode="0.0"/><extLst/></dxf>'),
        "n5": ('<cellStyle name="Fict" xfId="1" customBuiltin="1"/>', '<cellStyle xfId="1" customBuiltin="1"/>'),
        "n6": ('<numFmt numFmtId="170" formatCode="0.0"/>', '<numFmt numFmtId="170"/>'),
        "n14": (N14_SPAN, FILLS_BORDERS + CELL_XFS),
    }
    src, out = sys.argv[1], sys.argv[2]
    parts = {name: open(os.path.join(src, name), "rb").read() for name in ORDER}
    assert parts["[Content_Types].xml"].count(b'PartName="/xl/styles.xml"') == 1
    assert parts["xl/_rels/workbook.xml.rels"].count(b'Target="styles.xml"') == 1
    print("the template: one styles part, its override and its relationship")
    
    
    def write(name, styles):
        p = dict(parts)
        p["xl/styles.xml"] = styles.encode("ascii")
        path = os.path.join(out, name + ".xlsx")
        with zipfile.ZipFile(path, "w") as z:
            for n in ORDER:
                z.writestr(zipfile.ZipInfo(n, (1980, 1, 1, 0, 0, 0)), p[n], zipfile.ZIP_DEFLATED)
        with zipfile.ZipFile(path) as z:
            back = z.read("xl/styles.xml").decode("ascii")
        print("%s entries:%d styles_bytes:%d styles_read_back:%s" % (
            name + ".xlsx", len(ORDER), len(styles), "yes" if back == styles else "no"))
    
    
    write("b0", STYLES)
    open(os.path.join(out, "b0.styles.xml"), "w").write(STYLES)
    for name, (old, new) in CASES.items():
        print("%s replaced_text_count:%d" % (name, STYLES.count(old)))
        assert STYLES.count(old) == 1, name
        planted = STYLES.replace(old, new)
        open(os.path.join(out, name + ".styles.xml"), "w").write(planted)
        write(name, planted)
    """Fictional packages for M5 part 1 P3's negative log, the colors half (P2's
    generator, carried; change MM): the phase commit's template files, zipped
    in the template's order, the styles part replaced by the tool test's
    COLORS_STYLES and a theme part xl/theme/theme1.xml added from its
    COLORS_THEME, with the theme's Override and a relationship rId3. Both
    strings and the line the tool test asserts for them are read from
    null_rewrite.rs as Rust string literals and decoded. B0 is that package;
    each other case is B0 with one exact replacement in its styles part, its
    theme part or its workbook relationships, the count of the replaced text
    asserted 1 and printed. The cases are named by their P3 numbers: N7 to N12
    are P2's N1 to N6, N13 is P3's (the theme relationship naming a part the
    archive lacks).
    Usage: gen-co.py <template dir> <null_rewrite.rs> <out dir>."""
    import os
    import re
    import sys
    import zipfile
    
    ORDER = ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
             "xl/worksheets/sheet1.xml", "xl/styles.xml"]
    THEME = "xl/theme/theme1.xml"
    RELS = "xl/_rels/workbook.xml.rels"
    ESC = {'"': '"', "\\": "\\", "n": "\n", "t": "\t", "'": "'"}
    
    
    def rust_str(text, at):
        """The Rust string literal whose opening quote is text[at], decoded: the
        escapes above, and a backslash before a newline dropping the newline and
        the whitespace after it."""
        assert text[at] == '"', at
        at += 1
        out = []
        while True:
            c = text[at]
            if c == '"':
                return "".join(out)
            if c == "\\":
                n = text[at + 1]
                if n == "\n":
                    at += 2
                    while text[at] in " \t\n":
                        at += 1
                    continue
                out.append(ESC[n])
                at += 2
                continue
            out.append(c)
            at += 1
    
    
    def const(text, name):
        head = "const %s: &str = " % name
        assert text.count(head) == 1, name
        return rust_str(text, text.index(head) + len(head))
    
    
    src, rs_path, out = sys.argv[1], sys.argv[2], sys.argv[3]
    rs = open(rs_path).read()
    styles = const(rs, "COLORS_STYLES")
    theme = const(rs, "COLORS_THEME")
    fn = "fn the_colors_sample_resolves_every_colour_and_writes_the_input_back_unedited()"
    assert rs.count(fn) == 1
    m = re.compile(r"assert_eq!\(\s*line,\s*").search(rs, rs.index(fn))
    line = rust_str(rs, m.end())
    assert line.endswith("\n") and line.count("\n") == 1 and line.startswith("colors\t")
    line = line[:-1]
    styles.encode("ascii"), theme.encode("ascii"), line.encode("ascii")
    print("read from null_rewrite.rs: COLORS_STYLES bytes:%d COLORS_THEME bytes:%d line fields:%d"
          % (len(styles), len(theme), len(line.split("\t"))))
    open(os.path.join(out, "b0.line"), "w").write(line)
    
    parts = {name: open(os.path.join(src, name), "rb").read() for name in ORDER}
    types = parts["[Content_Types].xml"].decode("ascii")
    rels = parts[RELS].decode("ascii")
    assert types.count('PartName="/xl/styles.xml"') == 1 and types.count("</Types>") == 1
    assert rels.count('Target="styles.xml"') == 1 and rels.count("</Relationships>") == 1
    assert rels.count('Id="rId3"') == 0 and rels.count("/theme\"") == 0
    parts["[Content_Types].xml"] = types.replace(
        "</Types>",
        '<Override PartName="/xl/theme/theme1.xml" '
        'ContentType="application/vnd.openxmlformats-officedocument.theme+xml"/></Types>').encode("ascii")
    rels = rels.replace(
        "</Relationships>",
        '<Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/theme" '
        'Target="theme/theme1.xml"/></Relationships>')
    print("the template: one styles part, its override and its relationship; a theme override and relationship added")
    
    scheme = re.search(r"<a:clrScheme .*?</a:clrScheme>", theme).group(0)
    # case: (the part, the text replaced in B0's part, its replacement)
    CASES = {
        "n7": ("theme", ' lastClr="FFFFFF"', ""),
        "n8": ("theme", 'val="102030"', 'val="10203"'),
        "n9": ("theme", scheme, scheme + scheme),
        "n10": ("styles", '<font><color theme="1"/></font>', '<font><color theme="12"/></font>'),
        "n11": ("styles", "</colors>", "</colors><colors/>"),
        "n12": ("styles", 'rgb="00ABCDEF"', 'rgb="0ABCDEF"'),
        "n13": ("rels", 'Target="theme/theme1.xml"', 'Target="theme/theme9.xml"'),
    }
    
    
    def write(name, st, th, rl):
        p = dict(parts)
        p["xl/styles.xml"] = st.encode("ascii")
        p[THEME] = th.encode("ascii")
        p[RELS] = rl.encode("ascii")
        path = os.path.join(out, name + ".xlsx")
        with zipfile.ZipFile(path, "w") as z:
            for n in ORDER + [THEME]:
                z.writestr(zipfile.ZipInfo(n, (1980, 1, 1, 0, 0, 0)), p[n], zipfile.ZIP_DEFLATED)
        with zipfile.ZipFile(path) as z:
            back = (z.read("xl/styles.xml").decode("ascii") == st and z.read(THEME).decode("ascii") == th
                    and z.read(RELS).decode("ascii") == rl)
        print("%s entries:%d styles_bytes:%d theme_bytes:%d rels_bytes:%d read_back:%s" % (
            name + ".xlsx", len(ORDER) + 1, len(st), len(th), len(rl), "yes" if back else "no"))
    
    
    write("b0", styles, theme, rels)
    open(os.path.join(out, "b0.styles.xml"), "w").write(styles)
    open(os.path.join(out, "b0.theme.xml"), "w").write(theme)
    open(os.path.join(out, "b0.rels.xml"), "w").write(rels)
    base_of = {"styles": styles, "theme": theme, "rels": rels}
    for name, (part, old, new) in CASES.items():
        base = base_of[part]
        print("%s part:%s replaced_text_count:%d" % (name, part, base.count(old)))
        assert base.count(old) == 1, name
        planted = base.replace(old, new)
        open(os.path.join(out, "%s.%s.xml" % (name, part)), "w").write(planted)
        now = dict(base_of)
        now[part] = planted
        write(name, now["styles"], now["theme"], now["rels"])
