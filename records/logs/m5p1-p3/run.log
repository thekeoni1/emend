command: python3 <work>/stylespart.py <corpus>/corpus/<id>.<ext> > <work>/sp-<id>, for each manifest row; the program:
    """The styles part's name of one package: _rels/.rels's officeDocument
    relationship names the workbook part, whose relationships part's styles
    relationship names the styles part, resolved against the workbook part's
    directory. Prints the name, or nothing when either relationship is missing.
    Usage: stylespart.py <package>."""
    import posixpath
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    sys.dont_write_bytecode = True
    REL = "{http://schemas.openxmlformats.org/package/2006/relationships}Relationship"
    
    
    def target(z, rels, kind, base):
        if rels not in z.namelist():
            return None
        for r in ET.fromstring(z.read(rels)).iter(REL):
            if r.get("TargetMode") == "External":
                continue
            if r.get("Type", "").endswith("/" + kind):
                t = r.get("Target", "")
                return t.lstrip("/") if t.startswith("/") else posixpath.normpath(posixpath.join(base, t))
        return None
    
    
    z = zipfile.ZipFile(sys.argv[1])
    wb = target(z, "_rels/.rels", "officeDocument", "")
    if wb:
        d, n = posixpath.split(wb)
        sp = target(z, posixpath.join(d, "_rels", n + ".rels"), "styles", d)
        if sp and sp in z.namelist():
            print(sp)
