        return buf.getvalue()
    
    
    def as_tool(line):
        return "pivots\t" + "\t".join(line.split(" ")[:len(TOOL_KEYS)])
    
    
    def selftest():
        base = build(fixture_parts())
        line = compare(base, base)
        checks = []
        checks.append(("the fixture's line is the tool test's", as_tool(line) == TOOL_LINE))
        checks.append(("entries_same and source_rule hold on the fixture against itself",
                       kv(line, "entries_same") == "yes" and kv(line, "source_rule") == "yes"))
        checks.append(("the fixture's per-cache keys: one cache, a worksheet source, three fields, one table with data, no short cache",
                       [kv(line, k) for k in CACHE_KEYS] == ["1", "1", "0", "0", "3", "1", "0"]))
