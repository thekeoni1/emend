        infos = z.infolist()
        names = set(i.filename for i in infos)
        overrides, defaults = content_types(z)
        counts = dict.fromkeys(KEYS, 0)
        for info in infos:
            if info.filename == CONTENT_TYPES and plant != "sum_rule":
                continue
            counts[kind_of(type_of(info.filename, overrides, defaults))] += 1
        if plant == "count":
            counts["worksheets"] += 1
        counts["entries"] = len(infos)
        counts["kinds_sum"] = sum(counts[k] for k in KIND_KEYS)
        sheets = sheets_of(z, names)
        counts["sheets"] = len(sheets)
        for part in sheets:
            sheet_counts(z, names, part, counts)
        return counts
    
    
    def entries_of(data):
        z = zipfile.ZipFile(io.BytesIO(data))
        return [(i.filename, z.read(i.filename)) for i in z.infolist()]
    
    
