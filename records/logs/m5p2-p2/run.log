    DOC = "application/vnd.openxmlformats-officedocument."
    TYPES = {
        SML + "worksheet+xml": "worksheets",
        SML + "chartsheet+xml": "chartsheets",
        SML + "dialogsheet+xml": "dialogsheets",
        "application/vnd.ms-excel.macrosheet+xml": "macrosheets",
        "application/vnd.ms-excel.intlmacrosheet+xml": "macrosheets",
        DOC + "drawingml.chart+xml": "charts",
        "application/vnd.ms-office.chartex+xml": "chartex",
        DOC + "drawing+xml": "drawings",
        SML + "table+xml": "tables",
        SML + "pivotTable+xml": "pivot_tables",
        SML + "pivotCacheDefinition+xml": "pivot_caches",
        SML + "pivotCacheRecords+xml": "pivot_cache_records",
        SML + "externalLink+xml": "external_links",
        "application/vnd.ms-office.vbaProject": "vba_projects",
        "application/vnd.ms-excel.slicer+xml": "slicers",
        "application/vnd.ms-excel.slicerCache+xml": "slicer_caches",
        "application/vnd.ms-excel.timeline+xml": "timelines",
        "application/vnd.ms-excel.timelineCache+xml": "timeline_caches",
        SML + "comments+xml": "comments",
        "application/vnd.ms-excel.threadedcomments+xml": "threaded_comments",
        "application/vnd.ms-excel.person+xml": "persons",
        DOC + "customXmlProperties+xml": "custom_xml",
        SML + "connections+xml": "connections",
        SML + "queryTable+xml": "query_tables",
        DOC + "custom-properties+xml": "custom_properties",
        SML + "printerSettings": "printer_settings",
        SML + "calcChain+xml": "calc_chains",
    }
