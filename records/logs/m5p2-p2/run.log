  the copy of pivotcmp.py is the file beside this script, byte for byte: yes
    """The run log's own check of the pivot sample (specs/0033-read-breadth-
    survey.md, "Harness runs", the run log's own check, its pivots bullet), M5
    part 2 P2. Written for this phase by <phase>/gen/pivotcmp_src.py, copied by
    gen/run.py to <scripts>/pivotcmp.py; run with python3 -I -B and nothing else.
    
    Usage:
      pivotcmp.py pivots <input> <output> [--plant <name>]
      pivotcmp.py --selftest
    
    pivots: reads the input and the output with zipfile and ElementTree and
    prints one line of key=value pairs, space-separated: the tool line's keys
    in the tool's order (TOOL_KEYS), as this check counts them from the input
    on its own, the two digests among them; then the per-cache keys
    (CACHE_KEYS: the distinct cache definition parts the tables reach, their
    sources by type, their cache fields, the tables holding a dataField, the
    tables whose cache holds fewer fields than the table); then its two flags,
    entries_same (every zip entry of the output the input's, names and bytes,
    in order) and source_rule (the three source counts summing to
    with_cache). It prints counts, flags and digests only: no name,
    reference, path or text from the workbook.
    
    The count, typed here from the spec and not from the crate:
    - the pivot table parts: every entry, in the archive's order, whose
      content type is the pivot table's (the Override whose PartName is "/"
      and the name, else the Default of its extension compared ASCII
      case-insensitively).
    - the sheet join: the sheets of xl/workbook.xml in order whose workbook
      relationship is a worksheet or a chartsheet (transitional or strict);
      each one's pivotTable relationships (either form, not External) resolved
      to parts; a table's sheet is the first sheet naming it.
    - the cache: the table part's first pivotCacheDefinition relationship of
      the transitional form, else of the strict form, resolved.
    - the table part: the root pivotTableDefinition (main namespace,
      transitional or strict); its name; location's ref (cells counted from
      the area); the pivotField children of each pivotFields child (axis,
      dataField "1" or "true"), each named by the cache field at its position;
      the field children of rowFields and colFields, the pageField children of
      pageFields (x or fld "-2" the values field), the dataField children of
      dataFields (name; subtotal, sum when absent).
    - the cache part: cacheSource's type (worksheetSource's name and ref when
      worksheet), the cacheField names of cacheFields, recordCount.
    - the digests: 64-bit FNV-1a over the table names in order, and over the
      cache field names of every table's cache in table order, each value
      followed by a newline, as 16 lower-case hex digits.
    
    Plants (the run log's controls): entries_same, the output's first entry
    taken as one byte different; source_rule, one more worksheet source
    counted; count, pivot_tables counted one more; digest, the first table name
    digested with one character more. Each prints planted=yes; an unknown
    plant prints error=unknown-plant.
    
    --selftest: builds in memory the tool test's fictional workbook
    (tools/emend-copy/tests/null_rewrite.rs, pivot_specs("2")) and checks the
    line against the one that test asserts, then each check against a planted
    difference; prints one "name: yes|no" line per check, SELFTEST_LINES of
    them.
    """
    import io
    import posixpath
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    
    FLAGS_OF = {"pivots": ("entries_same", "source_rule")}
    SELFTEST_LINES = 14
    
    CT_NS = "http://schemas.openxmlformats.org/package/2006/content-types"
    RELS_NS = "http://schemas.openxmlformats.org/package/2006/relationships"
    MAIN_NS = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
               "http://purl.oclc.org/ooxml/spreadsheetml/main")
    R_NS = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    CONTENT_TYPES = "[Content_Types].xml"
    PIVOT_TABLE_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.pivotTable+xml"
    
    OD_T = "http://schemas.openxmlformats.org/officeDocument/2006/relationships/"
    OD_S = "http://purl.oclc.org/ooxml/officeDocument/relationships/"
    
    
    def both(name):
        return (OD_T + name, OD_S + name)
    
    
    OFFICE_DOCUMENT = both("officeDocument")
    SHEET_KINDS = both("worksheet") + both("chartsheet")
    PIVOT_TABLE = both("pivotTable")
    PIVOT_CACHE = both("pivotCacheDefinition")
    
    TOOL_KEYS = ("pivot_tables with_sheet with_cache source_worksheet source_external source_other "
                 "source_named source_ref cache_fields records_known fields named_fields axis_row "
                 "axis_column axis_page axis_values data_field_flags row_fields column_fields "
                 "page_fields values_refs data_fields named_data_fields subtotal_sum subtotal_other "
                 "location_cells digest_names digest_fields").split()
    COUNT_KEYS = TOOL_KEYS[:-2]
    CACHE_KEYS = ("caches cache_worksheet cache_external cache_other cache_field_names "
                  "tables_with_data short_caches").split()
    AXES = {"axisRow": "axis_row", "axisCol": "axis_column", "axisPage": "axis_page",
            "axisValues": "axis_values"}
    
    
    def content_types(z):
        root = ET.fromstring(z.read(CONTENT_TYPES))
        overrides, defaults = {}, []
        for el in root:
            if el.tag == "{%s}Override" % CT_NS:
                overrides.setdefault(el.get("PartName"), el.get("ContentType"))
            elif el.tag == "{%s}Default" % CT_NS:
                defaults.append((el.get("Extension"), el.get("ContentType")))
        return overrides, defaults
    
    
    def ascii_lower(s):
        return "".join(c.lower() if c.isascii() else c for c in s)
    
    
    def type_of(name, overrides, defaults):
        if "/" + name in overrides:
            return overrides["/" + name]
        if "." not in name:
            return None
        ext = ascii_lower(name.rsplit(".", 1)[1])
        for e, t in defaults:
            if e is not None and ascii_lower(e) == ext:
                return t
        return None
    
    
    def rels_part(source):
        d, f = posixpath.split(source)
        return (d + "/" if d else "") + "_rels/" + f + ".rels"
    
    
    def resolve(source, target):
        """The entry an internal target names, or None above the root."""
        if target.startswith("/"):
            segs = []
            path = target[1:]
        else:
            d = posixpath.dirname(source)
            segs = [s for s in d.split("/") if s]
            path = target
        for s in path.split("/"):
            if s in ("", "."):
                continue
            if s == "..":
                if not segs:
                    return None
                segs.pop()
            else:
                segs.append(s)
        return "/".join(segs) if segs else None
    
    
    def relationships(z, names, source):
        part = rels_part(source)
        if part not in names:
            return []
        root = ET.fromstring(z.read(part))
        return [(r.get("Id"), r.get("Type"), r.get("Target"), r.get("TargetMode") == "External")
                for r in root if r.tag == "{%s}Relationship" % RELS_NS]
    
    
    def sheet_parts(z, names):
        """The worksheet and chartsheet parts of xl/workbook.xml's sheets, in
        order."""
        wb = None
        for (_, t, target, ext) in relationships(z, names, ""):
            if t in OFFICE_DOCUMENT and not ext:
                wb = resolve("", target)
                break
        root = ET.fromstring(z.read(wb))
        rels = {i: (t, target, ext) for (i, t, target, ext) in relationships(z, names, wb)}
        out = []
        for sheets in root:
            if sheets.tag not in ["{%s}sheets" % ns for ns in MAIN_NS]:
                continue
            for sheet in sheets:
                if sheet.tag not in ["{%s}sheet" % ns for ns in MAIN_NS]:
                    continue
                rid = None
                for rns in R_NS:
                    rid = rid or sheet.get("{%s}id" % rns)
                t, target, _ext = rels[rid]
                if t in SHEET_KINDS:
                    out.append(resolve(wb, target))
        return out
    
    
    def main_child(el, local):
        return [c for c in el if c.tag in ["{%s}%s" % (ns, local) for ns in MAIN_NS]]
    
    
    def cells_of(ref):
        """The cells an A1 or A1:B2 area holds."""
        def corner(text):
            col, row = 0, ""
            for ch in text:
                if ch.isalpha():
                    col = col * 26 + (ord(ch.upper()) - 64)
                else:
                    row += ch
            return int(row), col
        halves = ref.split(":")
        (r1, c1) = corner(halves[0])
        (r2, c2) = corner(halves[-1])
        return (r2 - r1 + 1) * (c2 - c1 + 1)
    
    
    def read_cache(z, part):
        root = ET.fromstring(z.read(part))
        source, fields, records = None, [], root.get("recordCount")
        for cs in main_child(root, "cacheSource"):
            kind = cs.get("type")
            ws = main_child(cs, "worksheetSource")
            source = (kind, bool(ws and ws[0].get("name") is not None),
                      bool(ws and ws[0].get("ref") is not None))
        for cf in main_child(root, "cacheFields"):
            fields += [f.get("name") for f in main_child(cf, "cacheField")]
        return source, fields, records is not None
    
    
    def fnv(values):
        h = 0xcbf29ce484222325
        for v in values:
            for b in v.encode("utf-8") + b"\n":
                h ^= b
                h = (h * 0x100000001b3) & 0xFFFFFFFFFFFFFFFF
        return "%016x" % h
    
    
    def count(input_bytes, plant=None):
        z = zipfile.ZipFile(io.BytesIO(input_bytes))
        infos = z.infolist()
        names = set(i.filename for i in infos)
        overrides, defaults = content_types(z)
        tables = [i.filename for i in infos
                  if i.filename != CONTENT_TYPES and type_of(i.filename, overrides, defaults) == PIVOT_TABLE_TYPE]
        joined = {}
        if tables:
            for sheet in sheet_parts(z, names):
                for (_, t, target, ext) in relationships(z, names, sheet):
                    if t in PIVOT_TABLE and not ext:
                        joined.setdefault(resolve(sheet, target), sheet)
        c = dict.fromkeys(COUNT_KEYS + CACHE_KEYS, 0)
        table_names, cache_names, caches = [], [], {}
        for part in tables:
            rels = relationships(z, names, part)
            cache_part = None
            for form in PIVOT_CACHE:
                hit = [target for (_, t, target, _ext) in rels if t == form]
                if hit:
                    cache_part = resolve(part, hit[0])
                    break
            root = ET.fromstring(z.read(part))
            c["pivot_tables"] += 1
            c["with_sheet"] += 1 if part in joined else 0
            table_names.append(root.get("name"))
            cache_fields = []
            if cache_part is not None:
                source, cache_fields, known = read_cache(z, cache_part)
                c["with_cache"] += 1
                kind = source[0]
                if kind == "worksheet":
                    c["source_worksheet"] += 1
                    c["source_named"] += 1 if source[1] else 0
                    c["source_ref"] += 1 if source[2] else 0
                elif kind == "external":
                    c["source_external"] += 1
                else:
                    c["source_other"] += 1
                c["cache_fields"] += len(cache_fields)
                c["records_known"] += 1 if known else 0
                cache_names += cache_fields
                caches[cache_part] = (kind, len(cache_fields))
            fields = [f for pf in main_child(root, "pivotFields") for f in main_child(pf, "pivotField")]
            c["fields"] += len(fields)
            c["named_fields"] += min(len(fields), len(cache_fields))
            if cache_part is not None and len(cache_fields) < len(fields):
                c["short_caches"] += 1
            for f in fields:
                if f.get("axis") in AXES:
                    c[AXES[f.get("axis")]] += 1
                c["data_field_flags"] += 1 if f.get("dataField") in ("1", "true") else 0
            lists = (("row_fields", "rowFields", "field", "x"), ("column_fields", "colFields", "field", "x"),
                     ("page_fields", "pageFields", "pageField", "fld"))
            for key, outer, inner, attr in lists:
                for el in main_child(root, outer):
                    for item in main_child(el, inner):
                        c[key] += 1
                        c["values_refs"] += 1 if item.get(attr) == "-2" else 0
            data = [d for el in main_child(root, "dataFields") for d in main_child(el, "dataField")]
            c["data_fields"] += len(data)
            c["tables_with_data"] += 1 if data else 0
            for d in data:
                c["named_data_fields"] += 1 if d.get("name") is not None else 0
                if d.get("subtotal") in (None, "sum"):
                    c["subtotal_sum"] += 1
                else:
                    c["subtotal_other"] += 1
            for loc in main_child(root, "location")[:1]:
                c["location_cells"] += cells_of(loc.get("ref"))
        for kind, n in caches.values():
            c["caches"] += 1
            key = {"worksheet": "cache_worksheet", "external": "cache_external"}.get(kind, "cache_other")
            c[key] += 1
            c["cache_field_names"] += n
        if plant == "count":
            c["pivot_tables"] += 1
        if plant == "source_rule":
            c["source_worksheet"] += 1
        if plant == "digest" and table_names:
            table_names = [table_names[0] + "x"] + table_names[1:]
        c["digest_names"] = fnv(table_names)
        c["digest_fields"] = fnv(cache_names)
        return c
    
    
    def entries_of(data):
        z = zipfile.ZipFile(io.BytesIO(data))
        return [(i.filename, z.read(i.filename)) for i in z.infolist()]
    
    
    def compare(input_bytes, output_bytes, plant=None):
        c = count(input_bytes, plant)
        a, b = entries_of(input_bytes), entries_of(output_bytes)
        if plant == "entries_same" and b:
            first = sorted(range(len(b)), key=lambda k: b[k][0])[0]
            data = b[first][1]
            b[first] = (b[first][0], bytes([(data[0] ^ 1) if data else 1]) + data[1:])
        flags = {
            "entries_same": a == b,
            "source_rule": c["source_worksheet"] + c["source_external"] + c["source_other"] == c["with_cache"],
        }
        out = ["%s=%s" % (k, c[k]) for k in TOOL_KEYS + CACHE_KEYS]
        out += ["%s=%s" % (f, "yes" if flags[f] else "no") for f in FLAGS_OF["pivots"]]
        if plant is not None:
            out.append("planted=yes")
        return " ".join(out)
    
    
    def kv(line, key):
        for item in line.split(" "):
            if item.startswith(key + "="):
                return item[len(key) + 1:]
        return None
    
    
    # The tool test's workbook (null_rewrite.rs, package_specs_with and
    # pivot_specs), fictional, and the line that test asserts.
    RELS_TYPE = "application/vnd.openxmlformats-package.relationships+xml"
    WORKBOOK_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"
    SHEET_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"
    ATTR = R_NS[0]
    TOOL_LINE = ("pivots\tpivot_tables=2\twith_sheet=1\twith_cache=1\tsource_worksheet=1"
                 "\tsource_external=0\tsource_other=0\tsource_named=0\tsource_ref=1"
                 "\tcache_fields=3\trecords_known=1\tfields=4\tnamed_fields=3\taxis_row=1"
                 "\taxis_column=1\taxis_page=1\taxis_values=0\tdata_field_flags=1\trow_fields=1"
                 "\tcolumn_fields=2\tpage_fields=1\tvalues_refs=1\tdata_fields=2"
                 "\tnamed_data_fields=1\tsubtotal_sum=1\tsubtotal_other=1\tlocation_cells=19"
                 "\tdigest_names=%s\tdigest_fields=%s"
                 % (fnv(["Pivot One", "Pivot Two"]), fnv(["Region", "Year", "Amount"])))
    
    
    def fixture_parts(dfld="2", source='<worksheetSource ref="A1:C6" sheet="Sheet1"/>',
                      source_type="worksheet", second_from_sheet=False):
        vnd = "application/vnd.openxmlformats-officedocument.spreadsheetml"
        types = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                 '<Types xmlns="%s">'
                 '<Default Extension="rels" ContentType="%s"/>'
                 '<Default Extension="xml" ContentType="application/xml"/>'
                 '<Override PartName="/xl/workbook.xml" ContentType="%s"/>'
                 '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="%s"/>'
                 '<Override PartName="/xl/pivotTables/pivotTable1.xml" ContentType="%s.pivotTable+xml"/>'
                 '<Override PartName="/xl/pivotTables/pivotTable2.xml" ContentType="%s.pivotTable+xml"/>'
                 '<Override PartName="/xl/pivotCache/pivotCacheDefinition1.xml" '
                 'ContentType="%s.pivotCacheDefinition+xml"/></Types>'
                 % (CT_NS, RELS_TYPE, WORKBOOK_TYPE, SHEET_TYPE, vnd, vnd, vnd))
        package_rels = ('<Relationships xmlns="%s"><Relationship Id="rId1" Type="%s/officeDocument" '
                        'Target="xl/workbook.xml"/></Relationships>' % (RELS_NS, ATTR))
        workbook = ('<workbook xmlns="%s" xmlns:r="%s"><sheets><sheet name="Sheet1" sheetId="1" '
                    'r:id="rId1"/></sheets></workbook>' % (MAIN_NS[0], ATTR))
        second_rel = ('<Relationship Id="rId4" Type="%s/pivotTable" Target="pivotTables/pivotTable2.xml"/>'
                      % ATTR)
        workbook_rels = ('<Relationships xmlns="%s">'
                         '<Relationship Id="rId1" Type="%s/worksheet" Target="worksheets/sheet1.xml"/>'
                         '<Relationship Id="rId2" Type="%s/styles" Target="styles.xml"/>'
                         '<Relationship Id="rId3" Type="%s/hyperlink" Target="https://example.invalid/x" '
                         'TargetMode="External"/>%s</Relationships>'
                         % (RELS_NS, ATTR, ATTR, ATTR, "" if second_from_sheet else second_rel))
        sheet_rels = ('<Relationships xmlns="%s"><Relationship Id="rId1" Type="%s/pivotTable" '
                      'Target="../pivotTables/pivotTable1.xml"/>%s</Relationships>'
                      % (RELS_NS, ATTR, ('<Relationship Id="rId2" Type="%s/pivotTable" '
                                         'Target="../pivotTables/pivotTable2.xml"/>' % ATTR)
                         if second_from_sheet else ""))
        table_rels = ('<Relationships xmlns="%s"><Relationship Id="rId1" Type="%s/pivotCacheDefinition" '
                      'Target="../pivotCache/pivotCacheDefinition1.xml"/></Relationships>' % (RELS_NS, ATTR))
        first = ('<pivotTableDefinition xmlns="%s" name="Pivot One" cacheId="3">'
                 '<location ref="A3:C8" firstHeaderRow="1" firstDataRow="1" firstDataCol="1"/>'
                 '<pivotFields count="3"><pivotField axis="axisRow"/><pivotField axis="axisCol"/>'
                 '<pivotField dataField="1"/></pivotFields>'
                 '<rowFields count="1"><field x="0"/></rowFields>'
                 '<colFields count="2"><field x="1"/><field x="-2"/></colFields>'
                 '<rowItems count="1"><i/></rowItems>'
                 '<dataFields count="2"><dataField name="Total" fld="%s"/>'
                 '<dataField fld="2" subtotal="count"/></dataFields></pivotTableDefinition>' % (MAIN_NS[0], dfld))
        second = ('<pivotTableDefinition xmlns="%s" name="Pivot Two" cacheId="4">'
                  '<location ref="E1" firstHeaderRow="0" firstDataRow="1" firstDataCol="0"/>'
                  '<pivotFields count="1"><pivotField axis="axisPage"/></pivotFields>'
                  '<pageFields count="1"><pageField fld="0"/></pageFields></pivotTableDefinition>' % MAIN_NS[0])
        cache = ('<pivotCacheDefinition xmlns="%s" recordCount="5">'
                 '<cacheSource type="%s">%s</cacheSource>'
                 '<cacheFields count="3"><cacheField name="Region" numFmtId="0"><sharedItems/></cacheField>'
                 '<cacheField name="Year" numFmtId="0"/><cacheField name="Amount" numFmtId="0"/>'
                 '</cacheFields></pivotCacheDefinition>' % (MAIN_NS[0], source_type, source))
        return [
            (CONTENT_TYPES, types.encode()),
            ("_rels/.rels", package_rels.encode()),
            ("xl/workbook.xml", workbook.encode()),
            ("xl/_rels/workbook.xml.rels", workbook_rels.encode()),
            ("xl/worksheets/sheet1.xml", b"<sheetData/>"),
            ("xl/styles.xml", b"<styleSheet/>"),
            ("xl/media/image1.bin", bytes(range(256))),
            ("xl/worksheets/_rels/sheet1.xml.rels", sheet_rels.encode()),
            ("xl/pivotTables/pivotTable1.xml", first.encode()),
            ("xl/pivotTables/_rels/pivotTable1.xml.rels", table_rels.encode()),
            ("xl/pivotTables/pivotTable2.xml", second.encode()),
