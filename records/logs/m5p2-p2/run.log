        parts[5] = ("xl/styles.xml", b"<styleSheet/> ")
        checks.append(("control: entries_same is no for an output with one entry's bytes changed",
                       kv(compare(base, build(parts)), "entries_same") == "no"))
        checks.append(("control: entries_same is no for an output with one entry dropped",
                       kv(compare(base, build(fixture_parts()[:-1])), "entries_same") == "no"))
        joined = build(fixture_parts(second_from_sheet=True))
        checks.append(("control: a second table the sheet relates is joined (with_sheet 2)",
                       kv(compare(joined, joined), "with_sheet") == "2"))
        named = build(fixture_parts(source='<worksheetSource name="Table1"/>'))
        ln = compare(named, named)
        checks.append(("control: a worksheet source with a name alone counts named and not ref",
                       kv(ln, "source_named") == "1" and kv(ln, "source_ref") == "0"))
        ext = build(fixture_parts(source="", source_type="external"))
        le = compare(ext, ext)
        checks.append(("control: an external source counts external and not worksheet, per table and per cache",
                       kv(le, "source_external") == "1" and kv(le, "source_worksheet") == "0"
                       and kv(le, "cache_external") == "1" and kv(le, "source_rule") == "yes"))
        checks.append(("control: the digest of the names is the tool test's, and another order gives another",
                       kv(line, "digest_names") == fnv(["Pivot One", "Pivot Two"])
                       and fnv(["Pivot Two", "Pivot One"]) != fnv(["Pivot One", "Pivot Two"])))
        pc = compare(base, base, "count")
        checks.append(("control: the count plant turns pivot_tables to 3 and is marked planted",
                       kv(pc, "pivot_tables") == "3" and kv(pc, "planted") == "yes"))
        ps = compare(base, base, "source_rule")
        checks.append(("control: the source_rule plant turns source_rule to no", kv(ps, "source_rule") == "no"))
        pe = compare(base, base, "entries_same")
        checks.append(("control: the entries_same plant turns entries_same to no", kv(pe, "entries_same") == "no"))
        pd = compare(base, base, "digest")
        checks.append(("control: the digest plant changes digest_names and nothing else of the tool's keys",
                       kv(pd, "digest_names") != kv(line, "digest_names")
                       and [kv(pd, k) for k in COUNT_KEYS] == [kv(line, k) for k in COUNT_KEYS]))
        checks.append(("control: the tool test's line is refused by the same comparison against a line one count off",
                       as_tool(compare(base, base, "count")) != TOOL_LINE))
        assert len(checks) == SELFTEST_LINES
        for name, ok in checks:
            print("%s: %s" % (name, "yes" if ok else "no"))
    
    
    def main(argv):
        if argv == ["--selftest"]:
            selftest()
            return 0
        if len(argv) not in (3, 5) or argv[0] != "pivots":
            sys.stderr.write(__doc__)
            return 2
        plant = None
        if len(argv) == 5:
            if argv[3] != "--plant":
                sys.stderr.write(__doc__)
                return 2
            plant = argv[4]
            if plant not in FLAGS_OF["pivots"] + ("count", "digest"):
                print("error=unknown-plant")
                return 0
        with open(argv[1], "rb") as f:
            a = f.read()
        with open(argv[2], "rb") as f:
            b = f.read()
        try:
            print(compare(a, b, plant))
        except Exception as e:  # a part this check cannot read: named by kind, never by content
            print("error=%s" % type(e).__name__)
            return 1
        return 0
    
    
    if __name__ == "__main__":
        sys.exit(main(sys.argv[1:]))
