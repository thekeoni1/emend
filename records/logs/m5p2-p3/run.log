                 '</ext></extLst>%s</worksheet>' % (MAIN_NS[0], X14_NS, sheet_extra))
        sheet_rels = ('<Relationships xmlns="%s">'
                      '<Relationship Id="rId1" Type="%s/table" Target="../tables/table1.xml"/>'
                      '<Relationship Id="rId2" Type="%s/drawing" Target="../drawings/drawing1.xml"/>'
                      '<Relationship Id="rId3" Type="%s/hyperlink" Target="https://example.invalid/y" '
                      'TargetMode="External"/>%s</Relationships>' % (RELS_NS, ATTR, ATTR, ATTR, sheet_rels_extra))
        drawing_rels = ('<Relationships xmlns="%s">'
                        '<Relationship Id="rId1" Type="%s/chart" Target="../charts/chart1.xml"/>'
                        '<Relationship Id="rId2" Type="%s/image" Target="../media/image2.png"/>%s'
                        '</Relationships>' % (RELS_NS, ATTR, ATTR, drawing_rels_extra))
        return [
            (CONTENT_TYPES, types.encode()),
            ("_rels/.rels", package_rels.encode()),
            ("xl/workbook.xml", workbook.encode()),
            ("xl/_rels/workbook.xml.rels", workbook_rels.encode()),
            ("xl/worksheets/sheet1.xml", sheet.encode()),
            ("xl/styles.xml", b"<styleSheet/>"),
            ("xl/media/image1.bin", bytes(range(256))),
            ("xl/worksheets/_rels/sheet1.xml.rels", sheet_rels.encode()),
            ("xl/tables/table1.xml", b"<table/>"),
            ("xl/drawings/drawing1.xml", b"<wsDr/>"),
            ("xl/drawings/_rels/drawing1.xml.rels", drawing_rels.encode()),
            ("xl/charts/chart1.xml", b"<chartSpace/>"),
            ("xl/media/image2.png", bytes(range(256))),
        ]
    
    
    def build(parts):
        buf = io.BytesIO()
        with zipfile.ZipFile(buf, "w") as z:
            for name, data in parts:
                z.writestr(name, data)
        return buf.getvalue()
    
    
    def as_tool(line):
        return "kinds\t" + "\t".join(line.split(" ")[:len(KEYS)])
    
    
    def selftest():
        base = build(fixture_parts())
        line = compare(base, base)
        checks = []
        checks.append(("the fixture's line is the tool test's", as_tool(line) == TOOL_LINE))
        checks.append(("entries_same and sum_rule hold on the fixture against itself",
                       kv(line, "entries_same") == "yes" and kv(line, "sum_rule") == "yes"))
        parts = fixture_parts()
        parts[5] = ("xl/styles.xml", b"<styleSheet/> ")
        checks.append(("control: entries_same is no for an output with one entry's bytes changed",
                       kv(compare(base, build(parts)), "entries_same") == "no"))
        checks.append(("control: entries_same is no for an output with one entry dropped",
                       kv(compare(base, build(fixture_parts()[:-1])), "entries_same") == "no"))
        over = build(fixture_parts(types_extra='<Override PartName="/xl/styles.xml" ContentType="%s"/>' % SHEET_TYPE))
        checks.append(("control: an override beats the extension's default (worksheets 2, other_typed 5)",
                       kv(compare(over, over), "worksheets") == "2" and kv(compare(over, over), "other_typed") == "5"))
        parts = fixture_parts() + [("xl/media/image3.PNG", b"x"), ("xl/noextension", b"x")]
        two = build(parts)
        l2 = compare(two, two)
        checks.append(("control: a default's extension matches case-insensitively (images 2) and a name with no extension is untyped (untyped 2)",
                       kv(l2, "images") == "2" and kv(l2, "untyped") == "2" and kv(l2, "sum_rule") == "yes"))
        hl = build(fixture_parts(sheet_rels_extra=(
            '<Relationship Id="rId9" Type="%shyperlink" Target="https://example.invalid/z" TargetMode="External"/>'
            '<Relationship Id="rId10" Type="%shyperlink" Target="../other.xml"/>' % (OD_S, OD_T))))
        checks.append(("control: a strict external hyperlink counts and an internal one does not (sheet_external_hyperlinks 2)",
                       kv(compare(hl, hl), "sheet_external_hyperlinks") == "2"))
        sp = build(fixture_parts(sheet_extra='<y:sparklineGroup xmlns:y="urn:example:other"/>'
                                             '<z:sparklineGroup xmlns:z="%s"/>' % X14_NS))
        checks.append(("control: a sparklineGroup in another namespace is not counted and one under another prefix is (sheet_sparkline_groups 2)",
                       kv(compare(sp, sp), "sheet_sparkline_groups") == "2"))
        ext = build(fixture_parts(sheet_rels_extra=(
            '<Relationship Id="rId11" Type="%sdrawing" Target="https://example.invalid/d.xml" TargetMode="External"/>'
            % OD_T)))
        le = compare(ext, ext)
        checks.append(("control: an external drawing is counted and not followed (sheet_drawings 2, sheet_charts 1)",
                       kv(le, "sheet_drawings") == "2" and kv(le, "sheet_charts") == "1"))
        sl = build(fixture_parts(sheet_rels_extra=(
            '<Relationship Id="rId12" Type="http://schemas.microsoft.com/office/2007/relationships/slicer" Target="../slicers/slicer1.xml"/>'
            '<Relationship Id="rId13" Type="%stable" Target="../tables/table2.xml"/>' % OD_S)))
        ls = compare(sl, sl)
        checks.append(("control: Microsoft's slicer type and a strict table type are counted (sheet_slicers 1, sheet_tables 2)",
                       kv(ls, "sheet_slicers") == "1" and kv(ls, "sheet_tables") == "2"))
        pc = compare(base, base, "count")
        checks.append(("control: the count plant turns worksheets to 2 and is marked planted",
                       kv(pc, "worksheets") == "2" and kv(pc, "planted") == "yes"))
        ps = compare(base, base, "sum_rule")
        checks.append(("control: the sum_rule plant turns sum_rule to no", kv(ps, "sum_rule") == "no"))
        pe = compare(base, base, "entries_same")
        checks.append(("control: the entries_same plant turns entries_same to no", kv(pe, "entries_same") == "no"))
        checks.append(("control: the tool test's line is refused by the same comparison against a line one count off",
                       as_tool(compare(base, base, "count")) != TOOL_LINE))
        assert len(checks) == SELFTEST_LINES
