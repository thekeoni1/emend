command: cp <scripts>/extlinkcmp.py <work>/extlinkcmp.py; sed 's/^/    /' <work>/extlinkcmp.py; sha256 4c1950b45fd2225155424ce0cb38b54d56cbcd811f0d14320afbb862c4f87b2a, 17356 bytes
  the copy of extlinkcmp.py is the file beside this script, byte for byte: yes
    """The run log's own check of the external link sample (specs/0033-read-
    breadth-survey.md, "Harness runs", the run log's own check, its extlinks
    bullet), M5 part 2 P3. Written for this phase by
    <phase>/gen/extlinkcmp_src.py, copied by gen/run.py to
    <scripts>/extlinkcmp.py; run with python3 -I -B and nothing else.
    
    Usage:
      extlinkcmp.py extlinks <input> <output> [--plant <name>]
      extlinkcmp.py --selftest
    
    extlinks: reads the input and the output with zipfile and ElementTree and
    prints one line of key=value pairs, space-separated: the tool line's keys
    in the tool's order (TOOL_KEYS), as this check counts them from the input
    on its own, the two digests among them; then reference_lists (the
    externalReferences children of the workbook root), references (the
    externalReference children of the first of them) and typed (the entries
    whose content type is the external link part's); then its two flags, entries_same (every zip entry
    of the output the input's, names and bytes, in order) and ref_rule
    (references, typed and links all equal). It prints counts, flags and
    digests only: no target, sheet name, service, topic, program id, path or
    text from the workbook.
    
    The count, typed here from the spec and not from the crate:
    - the workbook part: the package relationship of type officeDocument
      (transitional or strict, not External), resolved.
    - the references: the externalReference children of the workbook root's
      first externalReferences child (main namespace, transitional or
      strict), each r:id (either relationships namespace) resolved through the
      workbook part's relationships to a part.
    - each link part: the root externalLink; its one child externalBook
      (the target the r:id names in the part's own relationships, the
      sheetName vals of sheetNames, the definedName children of definedNames
      counted), ddeLink, or oleLink (the target its r:id names).
    - the content type: the Override whose PartName is "/" and the name, else
      the Default of its extension compared ASCII case-insensitively.
    - the digests: 64-bit FNV-1a over the book and OLE targets in link order,
      and over the books' sheet names in order, each value followed by a
      newline, as 16 lower-case hex digits.
    
    Plants (the run log's controls): entries_same, the output's first entry
    taken as one byte different; ref_rule, one more typed entry counted;
    count, links counted one more; digest, a planted target "x" digested
    after the others. Each prints planted=yes; an unknown plant prints
    error=unknown-plant.
    
    --selftest: builds in memory the tool test's fictional workbook
    (tools/emend-copy/tests/null_rewrite.rs, extlink_specs) and checks the
    line against the one that test asserts, then each check against a planted
    difference; prints one "name: yes|no" line per check, SELFTEST_LINES of
    them.
    """
    import io
    import posixpath
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    
    FLAGS_OF = {"extlinks": ("entries_same", "ref_rule")}
    SELFTEST_LINES = 12
    
    CT_NS = "http://schemas.openxmlformats.org/package/2006/content-types"
    RELS_NS = "http://schemas.openxmlformats.org/package/2006/relationships"
    MAIN_NS = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
               "http://purl.oclc.org/ooxml/spreadsheetml/main")
    R_NS = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    CONTENT_TYPES = "[Content_Types].xml"
    EXTERNAL_LINK_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.externalLink+xml"
    
    OD_T = "http://schemas.openxmlformats.org/officeDocument/2006/relationships/"
    OD_S = "http://purl.oclc.org/ooxml/officeDocument/relationships/"
    
    
    def both(name):
        return (OD_T + name, OD_S + name)
    
    
    OFFICE_DOCUMENT = both("officeDocument")
    EXTERNAL_LINK = both("externalLink")
    
    TOOL_KEYS = "links books dde ole sheet_names defined_names digest_targets digest_sheets".split()
    COUNT_KEYS = TOOL_KEYS[:-2]
    CHECK_KEYS = ["reference_lists", "references", "typed"]
    
    
    def content_types(z):
        root = ET.fromstring(z.read(CONTENT_TYPES))
        overrides, defaults = {}, []
        for el in root:
            if el.tag == "{%s}Override" % CT_NS:
                overrides.setdefault(el.get("PartName"), el.get("ContentType"))
            elif el.tag == "{%s}Default" % CT_NS:
                defaults.append((el.get("Extension"), el.get("ContentType")))
        return overrides, defaults
    
    
    def ascii_lower(s):
        return "".join(c.lower() if c.isascii() else c for c in s)
    
    
    def type_of(name, overrides, defaults):
        if "/" + name in overrides:
            return overrides["/" + name]
        if "." not in name:
            return None
        ext = ascii_lower(name.rsplit(".", 1)[1])
        for e, t in defaults:
            if e is not None and ascii_lower(e) == ext:
                return t
        return None
    
    
    def rels_part(source):
        d, f = posixpath.split(source)
        return (d + "/" if d else "") + "_rels/" + f + ".rels"
    
    
    def resolve(source, target):
        """The entry an internal target names, or None above the root."""
        if target.startswith("/"):
            segs = []
            path = target[1:]
        else:
            d = posixpath.dirname(source)
            segs = [s for s in d.split("/") if s]
            path = target
        for s in path.split("/"):
            if s in ("", "."):
                continue
            if s == "..":
                if not segs:
                    return None
                segs.pop()
            else:
                segs.append(s)
        return "/".join(segs) if segs else None
    
    
    def relationships(z, names, source):
        part = rels_part(source)
        if part not in names:
            return {}
        root = ET.fromstring(z.read(part))
        return {r.get("Id"): (r.get("Type"), r.get("Target"), r.get("TargetMode") == "External")
                for r in root if r.tag == "{%s}Relationship" % RELS_NS}
    
    
    def main_child(el, local):
        return [c for c in el if c.tag in ["{%s}%s" % (ns, local) for ns in MAIN_NS]]
    
    
    def rid_of(el):
        for rns in R_NS:
            v = el.get("{%s}id" % rns)
            if v is not None:
                return v
        return None
    
    
    def fnv(values):
        h = 0xcbf29ce484222325
        for v in values:
            for b in v.encode("utf-8") + b"\n":
                h ^= b
                h = (h * 0x100000001b3) & 0xFFFFFFFFFFFFFFFF
        return "%016x" % h
    
    
    def workbook_part(z, names):
        for (t, target, ext) in relationships(z, names, "").values():
            if t in OFFICE_DOCUMENT and not ext:
                return resolve("", target)
        return None
    
    
    def count(data, plant=None):
        z = zipfile.ZipFile(io.BytesIO(data))
        names = z.namelist()
        overrides, defaults = content_types(z)
        c = dict.fromkeys(COUNT_KEYS + CHECK_KEYS, 0)
        c["typed"] = sum(1 for n in names if type_of(n, overrides, defaults) == EXTERNAL_LINK_TYPE)
        wb = workbook_part(z, names)
        root = ET.fromstring(z.read(wb))
        wb_rels = relationships(z, names, wb)
        targets, sheets = [], []
        c["reference_lists"] = len(main_child(root, "externalReferences"))
        for refs in main_child(root, "externalReferences")[:1]:
            for ref in main_child(refs, "externalReference"):
                c["references"] += 1
                t, target, ext = wb_rels[rid_of(ref)]
                if t not in EXTERNAL_LINK or ext:
                    raise ValueError("reference")
                part = resolve(wb, target)
                link = ET.fromstring(z.read(part))
                link_rels = relationships(z, names, part)
                c["links"] += 1
                for book in main_child(link, "externalBook"):
                    c["books"] += 1
                    targets.append(link_rels[rid_of(book)][1])
                    for sn in main_child(book, "sheetNames"):
                        for s in main_child(sn, "sheetName"):
                            sheets.append(s.get("val"))
                            c["sheet_names"] += 1
                    for dn in main_child(book, "definedNames"):
                        c["defined_names"] += len(main_child(dn, "definedName"))
                c["dde"] += len(main_child(link, "ddeLink"))
                for ole in main_child(link, "oleLink"):
                    c["ole"] += 1
                    targets.append(link_rels[rid_of(ole)][1])
        if plant == "count":
            c["links"] += 1
        if plant == "ref_rule":
            c["typed"] += 1
        if plant == "digest":
            targets = targets + ["x"]
        c["digest_targets"] = fnv(targets)
        c["digest_sheets"] = fnv(sheets)
        return c
    
    
    def entries_of(data):
        z = zipfile.ZipFile(io.BytesIO(data))
        return [(i.filename, z.read(i.filename)) for i in z.infolist()]
    
    
    def compare(input_bytes, output_bytes, plant=None):
        c = count(input_bytes, plant)
        a, b = entries_of(input_bytes), entries_of(output_bytes)
        if plant == "entries_same" and b:
            first = sorted(range(len(b)), key=lambda k: b[k][0])[0]
            data = b[first][1]
            b[first] = (b[first][0], bytes([(data[0] ^ 1) if data else 1]) + data[1:])
        flags = {
            "entries_same": a == b,
            "ref_rule": c["references"] == c["typed"] == c["links"],
        }
        out = ["%s=%s" % (k, c[k]) for k in TOOL_KEYS + CHECK_KEYS]
        out += ["%s=%s" % (f, "yes" if flags[f] else "no") for f in FLAGS_OF["extlinks"]]
        if plant is not None:
            out.append("planted=yes")
        return " ".join(out)
    
    
    def kv(line, key):
        for item in line.split(" "):
            if item.startswith(key + "="):
                return item[len(key) + 1:]
        return None
    
    
    # The tool test's workbook (null_rewrite.rs, package_specs_with and
    # extlink_specs), fictional, and the line that test asserts.
    RELS_TYPE = "application/vnd.openxmlformats-package.relationships+xml"
    WORKBOOK_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"
    SHEET_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"
    ATTR = R_NS[0]
    TOOL_LINE = ("extlinks\tlinks=3\tbooks=1\tdde=1\tole=1\tsheet_names=2\tdefined_names=1"
                 "\tdigest_targets=%s\tdigest_sheets=%s"
                 % (fnv(["other.xlsx", "file:///objects/thing.bin"]), fnv(["North", "South"])))
    
    
    def fixture_parts(references=3, typed=3):
