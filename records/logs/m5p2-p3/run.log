    TARGET_ROOT=$PHASE_DIR/target
    BUILD_ROOT=$TARGET_ROOT/main
    # Change NTT (M5 part 1 P3's NSW): the size log and its build directory,
    # whose release binaries the three samples run again with.
    SIZE_LOG=${2:-$PHASE_DIR/logs/size.log}
    SIZE_BUILD=${SIZE_BUILD_ROOT:-$TARGET_ROOT/main}
    KEEP=${RUN_KEEP:-$PHASE_DIR/keep-host}
    RUN_OUT_ROOT=${RUN_OUT_ROOT:-$CORPUS/runs}
    RUN_SKIP_KEEP=${RUN_SKIP_KEEP:-no}
    case $RUN_SKIP_KEEP in yes | no) ;; *) echo "RUN_SKIP_KEEP is yes or no" >&2; exit 2 ;; esac
    INSTALLED=()
    I686=i686-unknown-linux-musl
    RECORDS_DEST=${RECORDS_DEST:-records}
    # A keep in place is another attempt's, moved below once the header can list
    # it; without SUPERSEDED_KEEP naming the attempt it is refused.
    SUPERSEDED_KEEP=${SUPERSEDED_KEEP:-}
    case $SUPERSEDED_KEEP in '' | attempt-[1-9]) ;; *) echo "SUPERSEDED_KEEP is attempt-<n> or nothing" >&2; exit 2 ;; esac
    if [ "$RUN_SKIP_KEEP" = no ] && [ -e "$KEEP" ] && [ -z "$SUPERSEDED_KEEP" ]; then echo "$KEEP is already there; name its attempt in SUPERSEDED_KEEP" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT
    RECORDS=$SELF_DIR/out/records
    # Change NTI: TMPDIR is <scratch>/tmp, the phase's directory's, made and
    # exported before any mktemp (close-out ruling 1); the working directory
    # is the one mktemp -d makes under it, on the disk, kept; nothing here is
    # removed.
    TMPDIR=$PHASE_DIR/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    B=$(mktemp -d) || exit 2
    # Change NSB: the counting library is the phase commit's, by git show.
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT=$(git rev-parse --short=7 "$C")
    DATE=$(date -u +%Y-%m-%d)
    # What the status pattern admits (changes NSB and NTT): this phase's log
    # directory, this phase's four record pairs (named by the run's date and the
    # phase commit's short sha, untracked), the size record and the API record
    # the size and test logs install at the phase commit's short sha (any
    # date), and planning's modified specs/0033; nothing else.
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m5p2-p3/|\\?\\? records/m5p2-(p3-kinds|p3-pivots|p3-extlinks|open)-$DATE-$SHORT[.](md|txt)\$|\\?\\? records/(size|api-review)-m5p2-20[0-9][0-9]-[01][0-9]-[0-3][0-9]-$SHORT[.]md\$| M specs/0033-read-breadth-survey[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs, records and planning's spec" >&2
      exit 2
    fi
    STEM_OPEN=m5p2-open-$DATE-$SHORT
    # A rerun takes a suffix, so its run directory is never the superseded one.
    RUN_SUFFIX=${RUN_SUFFIX:-}
    case $RUN_SUFFIX in '' | -[b-z]) ;; *) echo "RUN_SUFFIX is -b to -z or nothing" >&2; exit 2 ;; esac
    RUN=$DATE-$SHORT$RUN_SUFFIX
    O=$RUN_OUT_ROOT/$RUN-$SAMPLE
    mkdir -p "$RECORDS" "$RECORDS_DEST" || exit 2
    # A rerun names the superseded run directory, which is MOVED into
    # <scripts>/out/superseded after the header prints it, never removed; it
    # must be another run of this phase, not this one.
    SUPERSEDED_RUN=${SUPERSEDED_RUN:-}
    case $SUPERSEDED_RUN in
      '' | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f] | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[b-z]) ;;
      *) echo "SUPERSEDED_RUN is not a run directory's name" >&2; exit 2 ;;
    esac
    if [ -n "$SUPERSEDED_RUN" ] && [ "$SUPERSEDED_RUN" = "$RUN" ]; then echo "SUPERSEDED_RUN names this run's own directory" >&2; exit 2; fi
    for f in "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt"; do
      if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
    done
    for s in $SAMPLES; do
      for f in "$RECORDS/m5p2-p3-$s-$DATE-$SHORT.md" "$RECORDS/m5p2-p3-$s-$DATE-$SHORT.txt" "$RECORDS_DEST/m5p2-p3-$s-$DATE-$SHORT.md" "$RECORDS_DEST/m5p2-p3-$s-$DATE-$SHORT.txt"; do
        if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
      done
    done
    # A run directory that exists before the run is another attempt's; refused
    # (the runner itself refuses one holding an earlier run's conversion
    # directories, specs/0030 decision 1 A).
    for s in $SAMPLE $SIZE_RUNS; do
      if [ -e "$RUN_OUT_ROOT/$RUN-$s" ]; then echo "$RUN_OUT_ROOT/$RUN-$s is already there; name a fresh run" >&2; exit 2; fi
    done
    
    # The corpus's path begins with <repo>'s, so <runs> and <corpus> are
    # replaced before <repo> (M4 part 1 P3's order); the phase's directories
    # before <phase>, and <home> last.
    scrub() {
      sed -e "s#$B#<work>#g" -e "s#$TMPDIR#<scratch>/tmp#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$KEEP#<keep>#g" \
        -e "s#$TARGET_ROOT#<target>#g" -e "s#$RUN_OUT_ROOT#<runs>#g" -e "s#$CORPUS#<corpus>#g" \
        -e "s#$MAIN#<repo>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M5 part 2 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # The environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo "input (as exported by this script, change NTK): PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE CARGO_NET_OFFLINE=$CARGO_NET_OFFLINE"
    echo "input: TMPDIR=$TMPDIR"
    echo "  (TMPDIR set, made and exported by this script before any mktemp; <work> is made under it: close-out ruling 1; change NTI)"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change NTJ: the fourth shape, PYB: a Python call without -I -B (the word
    # followed by whitespace and an option or a .py path, outside a comment,
    # and not by " -I -B"). The word is built from two halves, so that this
    # form's own text is no call.
    PYW=pyth
    PYW=${PYW}on3
    pyb_count() {
      awk -v w="$PYW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { r = substr(s, i + length(w)); if (r ~ /^[ \t]+(-|[^ \t]*[.]py([ \t"]|$))/ && r !~ /^ -I -B( |$)/) { n++; break }; s = r }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "$PYW -c x" "$PYW -I -B -c x" "# $PYW -c x" "command -v $PYW" "$PYW tool.py" >"$B/pyb-fixture"
    n_self=$(pyb_count "$SELF")
    n_fix=$(pyb_count "$B/pyb-fixture")
    echo "command: pyb_count <this script>, and the same over a fixture of five lines: a call with -c, one with -I -B -c, a comment, a command -v, a call of a .py path"
    echo "  shape PYB: in this script $n_self; in the fixture $n_fix"
    check "PYB: this script holds none (change NTJ)" "$(yn [ "$n_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's two calls without -I -B and not its other three lines" "$(yn [ "$n_fix" = 2 ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M5 part 2 P2 record: logs, the pivot sample and open records, the independent check')
    DOC=$(by_subject 'M5 part 2 P3: commit planning docs (the P2 rulings)')
    CRATE=$(by_subject 'M5 part 2 P3: external links read as written')
    TOOL=$(by_subject 'M5 part 2 P3: emend-copy --extlink-sample')
    CATALOGUE=$(by_subject 'M5 part 2 P3: the catalogue and limits for the survey, pivot tables and external links')
    PROBE=$(by_subject 'M5 part 2 P3: the read probe reads the survey, pivot tables and external links')
    CODE=$(by_subject 'M5 part 2 P3: the CHANGELOG names what read gained')
    # Change NUA: the tests commit, the phase commit.
    TESTS=$(by_subject 'M5 part 2 P3: the external link tests that can fail')
    # Change NTZ: the record the keep is compared with, named by its record
    # commit, resolved by its subject (no hash is typed here), and checked
    # below; P2's record commit, the base, the last to add an open-check record.
    PREV_OPEN_REC=$REC
    # Change NTX: the earlier runs the release runs are compared with, their
    # phase commits and record commits by subject; the extlinks sample's is
    # this log's own first run, at the phase commit, with no record commit.
    declare -A PREV_RUN PREV_CODE PREV_RECORD
    PREV_RUN[kinds]=$CORPUS/runs/2026-10-12-3865f30-kinds
    PREV_RUN[pivots]=$CORPUS/runs/2026-10-12-61d23fc-pivots
    PREV_RUN[extlinks]=$RUN_OUT_ROOT/$RUN-$SAMPLE
    PREV_CODE[kinds]=$(by_subject 'M5 part 2 P1: committed scripts call python3 with -I -B')
    PREV_CODE[pivots]=$(by_subject 'M5 part 2 P2: emend-copy --pivot-sample')
    PREV_CODE[extlinks]=$C
    PREV_RECORD[kinds]=$(by_subject 'M5 part 2 P1 record: logs, the kinds sample and open records, the independent check')
    PREV_RECORD[pivots]=$REC
    PREV_RECORD[extlinks]=
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  M5 part 2 P2's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the crate commit: ${CRATE:-none}"
    echo "  the tool commit: ${TOOL:-none}"
    echo "  the catalogue commit: ${CATALOGUE:-none}"
    echo "  the probe commit: ${PROBE:-none}"
    echo "  the CHANGELOG commit: ${CODE:-none}"
    echo "  the tests commit, the phase commit (change NUA): ${TESTS:-none}"
    echo "  M5 part 2 P2's record commit, the last to add an open-check record, named by its commit (change NTZ): ${PREV_OPEN_REC:-none}"
    echo "  the earlier runs' phase commits (change NTX): kinds, M5 part 2 P1's phase commit ${PREV_CODE[kinds]:-none}; pivots, M5 part 2 P2's tool commit ${PREV_CODE[pivots]:-none}; extlinks, this phase's commit (this log's first run)"
    echo "  the earlier runs' record commits (change NTX): kinds, M5 part 2 P1's ${PREV_RECORD[kinds]:-none}; pivots, M5 part 2 P2's ${PREV_RECORD[pivots]:-none}; extlinks, none (this log's first run is recorded by none)"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~7"
    for k in 0 1 2 3 4 5 6 7; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$TESTS" "$CODE" "$PROBE" "$CATALOGUE" "$TOOL" "$CRATE" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the tests commit, the CHANGELOG commit, the probe commit, the catalogue commit, the tool commit, the crate commit, the doc commit and the base, each the next one's parent, the tests commit the phase commit (changes NTT and NUA)" "$(yn roles_in_order)"
    roles_ctl() { local TESTS=$CODE; roles_in_order; }
    check "control: roles_in_order refuses the CHANGELOG commit named as the phase commit (change NUA)" "$(ynnot roles_ctl)"
    roles_ctl2() { local REC=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the base" "$(ynnot roles_ctl2)"
    echo "command: git log -1 --format=%s <M5 part 2 P2's record commit>"
    echo "    $(git log -1 --format=%s "$PREV_OPEN_REC")"
    prev_is_record() { [ -n "$PREV_OPEN_REC" ] && git cat-file -e "$PREV_OPEN_REC^{commit}" && [ "$(git log -1 --format=%s "$PREV_OPEN_REC" | LC_ALL=C "$G" -cE '^M5 part 2 P2 record: ')" = 1 ] && git merge-base --is-ancestor "$PREV_OPEN_REC" "$C"; }
    check "the named record commit is M5 part 2 P2's record commit, an ancestor of the phase commit" "$(yn prev_is_record)"
    prev_ctl() { local PREV_OPEN_REC=$DOC; prev_is_record; }
    check "control: the same check refuses the doc commit named instead" "$(ynnot prev_ctl)"
    earlier_ok() {
      local s
      for s in kinds pivots; do
        [ -n "${PREV_CODE[$s]}" ] && [ -n "${PREV_RECORD[$s]}" ] || return 1
        git merge-base --is-ancestor "${PREV_CODE[$s]}" "${PREV_RECORD[$s]}" || return 1
        git merge-base --is-ancestor "${PREV_RECORD[$s]}" "$C" || return 1
        [ -d "${PREV_RUN[$s]}" ] || return 1
      done
    }
    check "each earlier run's phase commit is an ancestor of its record commit, which is an ancestor of the phase commit, and its run directory is there, kinds and pivots (change NTX)" "$(yn earlier_ok)"
    earlier_ctl() { local -A PREV_RUN; PREV_RUN[kinds]=$CORPUS/runs/no-such-run; PREV_RUN[pivots]=$CORPUS/runs/no-such-run; earlier_ok; }
    check "control: the same check refuses run directories that are not there" "$(ynnot earlier_ctl)"
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the tests commit, by its subject (change NUA)" "$(yn [ "$TESTS" = "$C" ])"
    check "control: the same comparison refuses the CHANGELOG commit (change NUA)" "$(ynnot [ "$CODE" = "$C" ])"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT")"
    short_names_head() { [ "$(git rev-parse "$SHORT")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    echo "phase: Milestone 5 part 2 P3 ($SPEC) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    
    # The two move checks as functions, run over planted inputs every time
    # below, and over a real moved keep or run directory when there is one.
    # keep_pairs_ok <listing>: the .in.xlsx lines times two equal the listing's
    # lines (the pattern in double quotes so the tab is interpolated).
    keep_pairs_ok() {
      local pairs files
      pairs=$(count_matches -E "[.]in[.]xlsx${TAB}" "$1")
      files=$(count_lines "$1")
      [ "$files" -ge 2 ] && [ "$((pairs * 2))" = "$files" ]
    }
    # run_listing <dir> <listing>: the listing of a run directory, one line per
    # file, path and bytes.
    run_listing() { (cd "$1" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$2"; }
    # run_listing_ok <dir> <listing>: the listing names each file once and at
    # least one.
    run_listing_ok() {
      local files lines uniq
      files=$(find "$1" -type f | wc -l)
      lines=$(count_lines "$2")
      uniq=$(cut -f1 "$2" | LC_ALL=C sort -u | count_lines /dev/stdin)
      [ "$files" -ge 1 ] && [ "$lines" = "$files" ] && [ "$uniq" = "$files" ]
    }
    
    if [ -n "$SUPERSEDED_RUN" ]; then
    for SUP_S in $SAMPLE $SIZE_RUNS; do
      SUP_OUT=$RUN_OUT_ROOT/$SUPERSEDED_RUN-$SUP_S
      SUP_TO=$SELF_DIR/out/superseded/run-$SUPERSEDED_RUN-$SUP_S
      echo "the superseded run directory, moved before this run: <runs>/$SUPERSEDED_RUN-$SUP_S to <scripts>/out/superseded/run-$SUPERSEDED_RUN-$SUP_S"
      sup_there=no
      if [ -d "$SUP_OUT" ]; then
        sup_there=yes
        echo "command: sha256sum <runs>/$SUPERSEDED_RUN-$SUP_S/summary.host.tsv and summary.i686.tsv; mv <runs>/$SUPERSEDED_RUN-$SUP_S <scripts>/out/superseded/run-$SUPERSEDED_RUN-$SUP_S"
        for sl in host i686; do
          if [ -f "$SUP_OUT/summary.$sl.tsv" ]; then echo "    summary.$sl.tsv sha256 $(sha_of "$SUP_OUT/summary.$sl.tsv")"; else echo "    summary.$sl.tsv: NO HASH EXISTS, the file is not there"; fi
        done
        run_listing "$SUP_OUT" "$B/superseded-run.listing"
        echo "command: (cd <runs>/$SUPERSEDED_RUN-$SUP_S && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum"
        echo "    files $(find "$SUP_OUT" -type f | wc -l); listing lines $(count_lines "$B/superseded-run.listing"); listing sha256 $(sha_of "$B/superseded-run.listing")"
        check "the listing of $SUPERSEDED_RUN-$SUP_S names each of its files once" "$(yn run_listing_ok "$SUP_OUT" "$B/superseded-run.listing")"
        if [ -e "$SUP_TO" ]; then echo "    $SUP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$SUP_OUT" "$SUP_TO"; fi
      fi
      sup_moved() { [ ! -e "$SUP_OUT" ] && [ -d "$SUP_TO" ]; }
      if [ "$sup_there" = yes ]; then
        check "the superseded run directory $SUPERSEDED_RUN-$SUP_S is moved, not removed, before the run" "$(yn sup_moved)"
      else
        echo "    <runs>/$SUPERSEDED_RUN-$SUP_S was not there; nothing to move (change NTT)"
      fi
    done
    fi
    if [ -n "$SUPERSEDED_KEEP" ]; then
      KEEP_TO=$SELF_DIR/out/superseded/keep-$SUPERSEDED_KEEP
      echo "the superseded keep, moved before this run: <keep> to <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
      if [ -d "$KEEP" ]; then
        (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/superseded-keep.listing"
        echo "command: (cd <keep> && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum; the .in.xlsx files counted; mv <keep> <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
        echo "    pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/superseded-keep.listing"); files $(count_lines "$B/superseded-keep.listing"); listing sha256 $(sha_of "$B/superseded-keep.listing")"
        check "the moved keep's pairs times two equals its files" "$(yn keep_pairs_ok "$B/superseded-keep.listing")"
        if [ -e "$KEEP_TO" ]; then echo "    $KEEP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$KEEP" "$KEEP_TO"; fi
      else
        echo "    NO LISTING EXISTS: there is no keep in place to move"
      fi
      keep_moved() { [ ! -e "$KEEP" ] && [ -d "$KEEP_TO" ]; }
      check "the superseded keep is moved, not removed, before the run" "$(yn keep_moved)"
    fi
    echo "superseded run directory named: ${SUPERSEDED_RUN:-none}; superseded keep named: ${SUPERSEDED_KEEP:-none}"
    echo
    echo "## the two move checks over planted inputs, run every time"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\n' "$TAB" "$TAB" >"$B/c-keep.listing"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\ny.1.out.xlsx%s1\n' "$TAB" "$TAB" "$TAB" >"$B/c-keep-odd.listing"
    echo "  planted keep listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep.listing"), files $(count_lines "$B/c-keep.listing"); with an unpaired output: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep-odd.listing"), files $(count_lines "$B/c-keep-odd.listing")"
    check "keep_pairs_ok passes a planted listing of one whole pair" "$(yn keep_pairs_ok "$B/c-keep.listing")"
    check "control: keep_pairs_ok refuses a planted listing with an unpaired output" "$(ynnot keep_pairs_ok "$B/c-keep-odd.listing")"
    mkdir -p "$B/c-run/abc123" && printf 'a' >"$B/c-run/summary.host.tsv" && printf 'bb' >"$B/c-run/abc123/out.host.xlsx" && printf 'ccc' >"$B/c-run/abc123/stdout.host.txt"
    run_listing "$B/c-run" "$B/c-run.listing"
    echo "  planted run directory: files $(find "$B/c-run" -type f | wc -l); listing lines $(count_lines "$B/c-run.listing"); listing sha256 $(sha_of "$B/c-run.listing")"
    check "run_listing_ok passes the planted run directory's own listing" "$(yn run_listing_ok "$B/c-run" "$B/c-run.listing")"
    { cat "$B/c-run.listing"; head -n 1 "$B/c-run.listing"; } >"$B/c-run-dup.listing"
    check "control: run_listing_ok refuses a listing that names one file twice" "$(ynnot run_listing_ok "$B/c-run" "$B/c-run-dup.listing")"
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run builds into <target>/main, the main tree's subdirectory of the phase's target root (CARGO_TARGET_DIR; change NSU)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the sample's child and --lo-timeout $LO_TIMEOUT_S per conversion, the figures every corpus run since Milestone 3 used; not tuned during the run."
    echo "root: <repo> stands for the repository's top level (inside <home>, scrubbed after <runs> and <corpus>, whose paths begin with it); scripts/counting.sh is read from it at the phase commit by git show; scripts/passthrough-run.sh, scripts/passthrough-record.py and scripts/edit-open-check.sh are run from it, each checked equal to the phase commit's, and the runner and the open check each source scripts/lo-check.sh, which is never run; the keep's tests run in it; the four record pairs are installed into its $RECORDS_DEST/"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m5p2-p3 on the disk, the phase's directory"
    echo "root: <scratch> stands for <phase>, the phase's directory, named <scratch> where TMPDIR is concerned as the close-out's scripts name it: TMPDIR is <scratch>/tmp, made and exported by this script before any mktemp, and <work> is made under it (close-out ruling 1; change NTI)"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory, which holds the script and the three checks beside it, extlinkcmp.py, pivotcmp.py and kindscmp.py, and the CHANGELOG check's two programs, changelog_check.py and p1_checks.sh (changes NTU, NTX and NTY); the four record pairs are written into <scripts>/out/records first, a superseded run directory and a superseded keep are moved into <scripts>/out/superseded, and this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (change NTI; the counting library, the check copied from beside this script, their outputs, derived tables, the planted listings and run directory, the runs' TMPDIR <work>/tmp-run, the open check's TMPDIR <work>/tmp, the generated fixture and its outputs <work>/fixture, change NTW, the size log's release binaries copied into <work>/bin, change NTX), kept after the run and never removed"
    echo "root: <target> stands for <phase>/target on the disk, the phase's one target root: this log builds <repo> into <target>/main, the main tree's subdirectory, release binaries and the keep's tests, and into no other (change NSK)"
    echo "root: <keep> stands for <phase>/keep-host on the disk unless RUN_KEEP names another for a dry run, this phase's host keep; kept after the run for planning"
    echo "root: <corpus> stands for the private corpus directory (the manifest and the inputs under <corpus>/corpus, read)"
    echo "root: <runs> stands for the corpus run directories' parent, <corpus>/runs unless RUN_OUT_ROOT names another for a dry run; this log's run directories <runs>/$RUN-$SAMPLE and <runs>/$RUN-size-<sample> for each of $SAMPLES are written there"
    echo "root: <sizebuild> stands for the size log's build directory, <target>/main unless SIZE_BUILD_ROOT names another for a dry run (change NTT)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$SELF_DIR" "$BUILD_ROOT" "$MAIN" "$KEEP" "$CORPUS" "$TMPDIR")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots other than <home>, <phase>, <work> and <runs> are distinct, none inside another (TMPDIR, <scratch>/tmp, among them; change NTI)" "$(yn roots_distinct)"
    work_in_tmpdir() { case "$B/" in "$TMPDIR/"*) return 0 ;; esac; return 1; }
    check "<work>, the directory mktemp -d made, is under TMPDIR, <scratch>/tmp (close-out ruling 1; change NTI)" "$(yn work_in_tmpdir)"
    work_ctl() { local B=/tmp/x; work_in_tmpdir; }
    check "control: the same test refuses a working directory under /tmp" "$(ynnot work_ctl)"
    work_ctl2() { local B=$SELF_DIR/out/work.x; work_in_tmpdir; }
    check "control: the same test refuses one under <scripts>/out, where the carried form made it" "$(ynnot work_ctl2)"
    tmpdir_ctl() { local TMPDIR=$SELF_DIR/out; work_in_tmpdir; }
    check "control: the same test refuses <work> against a TMPDIR it is not under" "$(ynnot tmpdir_ctl)"
    # Change NTS (specs/0033 "Planning rulings on P1", ruling 12): every
    # mktemp call of this script is checked under TMPDIR, so the source is
    # read for its calls outside comments; the call's text is built from
    # pieces, so this form's own text is no call.
    MKW='$('
    MKW=${MKW}mkt
    MKW=${MKW}emp
    count_tempcalls() {
      awk -v w="$MKW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { n++; s = substr(s, i + length(w)) }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "A=$MKW -d)" "F=$MKW)" "# $MKW -d)" >"$B/mktemp-fixture"
    n_mk=$(count_tempcalls "$SELF")
    n_mk_fix=$(count_tempcalls "$B/mktemp-fixture")
    echo "command: count_tempcalls <this script>, and the same over a fixture of three lines: a directory call, a file call, a comment"
    echo "  mktemp calls in this script outside comments: $n_mk (the one that makes <work>, checked under TMPDIR above); in the fixture: $n_mk_fix"
    check "this script makes one mktemp call, <work>'s, and no plain temporary file (ruling 12; change NTS)" "$(yn [ "$n_mk" = 1 ])"
    check "control: the same count finds the fixture's two calls and not its comment" "$(yn [ "$n_mk_fix" = 2 ])"
    runs_apart() { apart "$RUN_OUT_ROOT" "$MAIN" && apart "$RUN_OUT_ROOT" "$SELF_DIR"; }
    check "<runs> lies outside <repo> and <scripts>" "$(yn runs_apart)"
    check "control: apart refuses <target>/main/release against <target>/main, which holds it" "$(ynnot apart "$BUILD_ROOT/release" "$BUILD_ROOT")"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "the run directories: <runs>/$RUN-$SAMPLE; <runs>/$RUN-size-kinds, <runs>/$RUN-size-pivots and <runs>/$RUN-size-extlinks"
    echo "the record stems: m5p2-p3-kinds-$DATE-$SHORT, m5p2-p3-pivots-$DATE-$SHORT, m5p2-p3-extlinks-$DATE-$SHORT and $STEM_OPEN; the records' destination: $RECORDS_DEST; RUN_SKIP_KEEP: $RUN_SKIP_KEEP"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs, its record pairs, the size and API records, planning's modified specs/0033) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m5p2-p3/run.log\n?? records/logs/m5p2-p2/run.log\n?? records/m5p2-p3-pivots-%s-%s.md\n?? records/m5p2-open-%s-%s.txt\n?? records/size-m5p2-2026-10-13-%s.md\n?? records/api-review-m5p2-2026-10-12-%s.md\n?? records/m5p2-p3-kinds-%s-abcdef0.md\n?? records/size-m5p2-2026-10-12-abcdef0.md\n?? records/m5p2-p2-%s-%s.md\n?? records/logs/m5p2-p3x/run.log\n M ROADMAP.md\n M specs/0033-read-breadth-survey.md\n M specs/0032-read-breadth-styles.md\n M records/m5p2-p3-kinds-%s-%s.md\n M crates/emend/src/package/extlink.rs\n' "$DATE" "$SHORT" "$DATE" "$SHORT" "$SHORT" "$SHORT" "$DATE" "$DATE" "$SHORT" "$DATE" "$SHORT" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern admits this phase's log, its untracked record pairs, the size and API records at the phase commit's short sha and planning's modified specs/0033 alone; it refuses another phase's log, a record of another commit, a sibling directory, ROADMAP.md, specs/0032, a modified record and a source file (changes NSB and NTT)" "$(yn [ "$(ours_rec_ctl)" = 6 ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources (the phase commit's, by git show; change NSB)"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts, against the phase commit, and planning's uncommitted spec"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh scripts/edit-open-check.sh; do
      check "$s in the main tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { [ "$(git show "$C:scripts/excel-check-list.py" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/edit-open-check.sh)" ]; }
    check "control: the same hash comparison tells two different scripts apart" "$(ynnot tree_ctl)"
    spec_now=$(sha_of "$SPEC")
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    spec_doc=$(git show "$DOC:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum; git show <doc commit>:$SPEC | sha256sum; sha256sum $SPEC (the working file, printed and not asserted: planning holds any rulings during P3 uncommitted; change NTT)"
    echo "  at the phase commit: $spec_committed; at the doc commit: $spec_doc; the pin: $SPEC_WANT"
    echo "  the working tree's copy (planning's uncommitted rulings): sha256 $spec_now"
    spec_ok() { [ "$spec_committed" = "$SPEC_WANT" ]; }
    check "the spec at the phase commit is at the pinned hash" "$(yn spec_ok)"
    check "the spec at the phase commit is the doc commit's" "$(yn [ "$spec_committed" = "$spec_doc" ])"
    spec_ctl() { local spec_committed=1111111111111111111111111111111111111111111111111111111111111111; spec_ok; }
    check "control: the same check refuses the spec against another hash" "$(ynnot spec_ctl)"
    echo "command: podman image exists $IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    
    echo
    echo "## the release binaries, built here at the phase commit, both targets, for the first extlinks run and the fixture (change NTU)"
    echo "command: cargo build --release -p emend-copy -p xlsx-diff; the same with --target $I686 (CARGO_TARGET_DIR=<target>/main)"
    cargo build --release -p emend-copy -p xlsx-diff >"$B/build-host.out" 2>&1 </dev/null
    rc_h=$?
    cargo build --release -p emend-copy -p xlsx-diff --target "$I686" >"$B/build-i686.out" 2>&1 </dev/null
    rc_i=$?
    echo "  exit: host $rc_h, $I686 $rc_i"
    check "both release builds exit 0" "$(yn [ "$((rc_h + rc_i))" = 0 ])"
    PT_host=$CARGO_TARGET_DIR/release/emend-copy
    XD_host=$CARGO_TARGET_DIR/release/xlsx-diff
    PT_i686=$CARGO_TARGET_DIR/$I686/release/emend-copy
    XD_i686=$CARGO_TARGET_DIR/$I686/release/xlsx-diff
    for b in "$PT_host" "$XD_host" "$PT_i686" "$XD_i686"; do echo "  $b: sha256 $(sha_of "$b"), bytes $(stat -c %s "$b")"; done
    echo "  $(rustc --version)"
    
    echo
    echo "## the corpus manifest, and its workbooks holding a calculation chain (specs/0025 P3 verification ruling 4; change NSI)"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv" >"$B/order"
    manifest_rows=$(count_lines "$B/order")
    n_regular=$(find "$CORPUS/corpus" -maxdepth 1 -type f | wc -l)
    echo "command: awk over <corpus>/manifest.tsv's id and ext columns by header name; find <corpus>/corpus -maxdepth 1 -type f"
    echo "  manifest rows: $manifest_rows; regular files under <corpus>/corpus: $n_regular"
    check "the manifest names one workbook per regular file of the corpus directory" "$(yn [ "$manifest_rows" = "$n_regular" ])"
    check "the manifest names some workbook" "$(yn [ "$manifest_rows" -ge 1 ])"
    : >"$B/chain-ids"
    while IFS="$TAB" read -r id ext; do
      if [ "$(python3 -I -B -c 'import sys, zipfile; print(1 if "xl/calcChain.xml" in zipfile.ZipFile(sys.argv[1]).namelist() else 0)' "$CORPUS/corpus/$id.$ext")" = 1 ]; then
        printf '%s\n' "$id" >>"$B/chain-ids"
      fi
    done <"$B/order"
    N_CHAIN=$(count_lines "$B/chain-ids")
    echo "command: python3 -I -B -c <zipfile namelist> <corpus>/corpus/<id>.<ext>, for each manifest row"
    echo "  corpus workbooks holding xl/calcChain.xml: $N_CHAIN of $manifest_rows (ids: $(paste -sd' ' "$B/chain-ids"))"
    echo "  the rule covering them (change NSI): the sample writes no cell, so each calcChain entry is identical and unflagged on both labels, and none is dropped"
    check "some corpus workbook holds a calculation chain, so the chain rows below are read" "$(yn [ "$N_CHAIN" -ge 1 ])"
    
    echo
    echo "## the run log's own checks (python3 -I -B with zipfile and ElementTree; changes NTU and NTX)"
    for chk in extlinkcmp pivotcmp kindscmp; do
      cp "$SELF_DIR/$chk.py" "$B/$chk.py" || exit 2
      echo "command: cp <scripts>/$chk.py <work>/$chk.py; sed 's/^/    /' <work>/$chk.py; sha256 $(sha_of "$B/$chk.py"), $(wc -c <"$B/$chk.py") bytes"
      check "the copy of $chk.py is the file beside this script, byte for byte" "$(yn cmp -s "$SELF_DIR/$chk.py" "$B/$chk.py")"
      sed 's/^/    /' "$B/$chk.py"
    done
    check "pivotcmp.py is M5 part 2 P2's check, carried byte for byte (the sha256 printed in records/logs/m5p2-p2/run.log; change NTX)" "$(yn [ "$(sha_of "$B/pivotcmp.py")" = c10589caa0c959046f3c3495712de7e2075f214a1028cd550e83eda0c2d5cb71 ])"
    check "kindscmp.py is M5 part 2 P1's check, carried byte for byte (the sha256 printed in records/logs/m5p2-p1/run.log and records/logs/m5p2-p2/run.log; change NTX)" "$(yn [ "$(sha_of "$B/kindscmp.py")" = 4c81e9779910994d8b62af0a4c880a11359cc93eae783152270b3ccc29e2b3e7 ])"
    FLAGS="entries_same ref_rule"
    P_FLAGS="entries_same source_rule"
    K_FLAGS="entries_same sum_rule"
    # flags_of_cmp <check> <mode>: its FLAGS_OF entry, read from its source
    # with ast.
    flags_of_cmp() {
      python3 -I -B -c 'import ast, sys
    tree = ast.parse(open(sys.argv[1]).read())
    for node in tree.body:
        if isinstance(node, ast.Assign) and getattr(node.targets[0], "id", "") == "FLAGS_OF":
            print(" ".join(ast.literal_eval(node.value)[sys.argv[2]]))' "$1" "$2"
    }
    echo "  extlinks: extlinkcmp.py's FLAGS_OF, read from its source: $(flags_of_cmp "$B/extlinkcmp.py" extlinks)"
    echo "  pivots: pivotcmp.py's FLAGS_OF, read from its source: $(flags_of_cmp "$B/pivotcmp.py" pivots)"
    echo "  kinds: kindscmp.py's FLAGS_OF, read from its source: $(flags_of_cmp "$B/kindscmp.py" kinds)"
    check "this log's flag lists are the checks'" "$(yn [ "$(flags_of_cmp "$B/extlinkcmp.py" extlinks)|$(flags_of_cmp "$B/pivotcmp.py" pivots)|$(flags_of_cmp "$B/kindscmp.py" kinds)" = "$FLAGS|$P_FLAGS|$K_FLAGS" ])"
    printf 'FLAGS_OF = {"extlinks": ("rest_same",)}\n' >"$B/c-flags.py"
    check "control: the same reader gives another list for a planted source" "$(yn [ "$(flags_of_cmp "$B/c-flags.py" extlinks)" = rest_same ])"
    for chk in extlinkcmp pivotcmp kindscmp; do
      case $chk in extlinkcmp) n_st=12 ;; *) n_st=14 ;; esac
      echo "command: python3 -I -B <work>/$chk.py --selftest (the tool test's fictional workbook built in memory, against the line that test asserts; each check against a planted difference)"
      python3 -I -B "$B/$chk.py" --selftest >"$B/selftest-$chk.out" 2>&1
      echo "  exit: $?"
      sed 's/^/    /' "$B/selftest-$chk.out"
      selftest_all() { [ "$(count_matches -E ': yes$' "$B/selftest-$chk.out")" = "$n_st" ] && [ "$(count_lines "$B/selftest-$chk.out")" = "$n_st" ]; }
      check "every one of $chk.py's $n_st self-test lines reads yes (changes NTU and NTX)" "$(yn selftest_all)"
    done
    printf 'a: yes\nb: no\n' >"$B/c-selftest.out"
    selftest_ctl() { [ "$(count_matches -E ': yes$' "$B/c-selftest.out")" = 1 ]; }
    check "control: the same count reads one yes of two in a planted output" "$(yn selftest_ctl)"
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    # all_yes <check line>: every extlinks flag yes; p_all_yes the pivot flags,
    # k_all_yes the kinds flags.
    all_yes() { local f; for f in $FLAGS; do [ "$(kv "$1" "$f")" = yes ] || return 1; done; }
    p_all_yes() { local f; for f in $P_FLAGS; do [ "$(kv "$1" "$f")" = yes ] || return 1; done; }
    k_all_yes() { local f; for f in $K_FLAGS; do [ "$(kv "$1" "$f")" = yes ] || return 1; done; }
    # The external link tool's keys, in its order (tools/emend-copy,
    # --extlink-sample); the check prints the same keys first, then its own
    # three (change NTU).
    COUNT_KEYS="links books dde ole sheet_names defined_names"
    KEYS="$COUNT_KEYS digest_targets digest_sheets"
    CHECK_KEYS="reference_lists references typed"
    # The pivot tool's keys (M5 part 2 P2's, carried).
    P_COUNT_KEYS="pivot_tables with_sheet with_cache source_worksheet source_external source_other source_named source_ref cache_fields records_known fields named_fields axis_row axis_column axis_page axis_values data_field_flags row_fields column_fields page_fields values_refs data_fields named_data_fields subtotal_sum subtotal_other location_cells"
    P_KEYS="$P_COUNT_KEYS digest_names digest_fields"
    CACHE_KEYS="caches cache_worksheet cache_external cache_other cache_field_names tables_with_data short_caches"
    # The kinds tool's keys (M5 part 2 P1's, carried).
    KIND_KEYS="worksheets chartsheets dialogsheets macrosheets charts chartex drawings images tables pivot_tables pivot_caches pivot_cache_records external_links vba_projects slicers slicer_caches timelines timeline_caches comments threaded_comments persons custom_xml connections query_tables custom_properties printer_settings calc_chains other_typed untyped"
    SHEET_KEYS="sheet_drawings sheet_charts sheet_images sheet_comments sheet_vml_drawings sheet_tables sheet_pivot_tables sheet_slicers sheet_timelines sheet_printer_settings sheet_external_hyperlinks sheet_sparkline_groups"
    K_KEYS="$KIND_KEYS entries kinds_sum sheets $SHEET_KEYS"
    # keys_agree <keys> <tool line> <check line>: every key the same.
    keys_agree() {
      local k
      for k in $1; do
        [ -n "$(kv "$3" "$k")" ] || return 1
        [ "$(kv "$2" "$k")" = "$(kv "$3" "$k")" ] || return 1
      done
    }
    tool_and_cmp() { keys_agree "$KEYS" "$1" "$2"; }
    p_tool_and_cmp() { keys_agree "$P_KEYS" "$1" "$2"; }
    k_tool_and_cmp() { keys_agree "$K_KEYS" "$1" "$2"; }
    # line_as_spec <tool line>: what "Harness runs" asks of the extlinks line:
    # the word extlinks and the keys in the tool's order, each count a number,
    # each digest sixteen lower-case hex digits; books, dde and ole summing to
    # links, as the tool asserts (change NTU).
    line_as_spec() {
      local n got
      [ "$(printf '%s' "$1" | cut -f1)" = extlinks ] || return 1
      got=$(printf '%s' "$1" | cut -f2- | tr '\t' '\n' | sed 's/=.*//' | tr '\n' ' ')
      [ "$got" = "$KEYS " ] || return 1
      for n in $COUNT_KEYS; do
        case "$(kv "$1" "$n")" in '' | *[!0-9]*) return 1 ;; esac
      done
      for n in digest_targets digest_sheets; do
        printf '%s' "$(kv "$1" "$n")" | LC_ALL=C "$G" -qxE '[0-9a-f]{16}' || return 1
      done
      [ "$(( $(kv "$1" books) + $(kv "$1" dde) + $(kv "$1" ole) ))" = "$(kv "$1" links)" ]
    }
    # p_line_as_spec <tool line>: the pivot line as M5 part 2 P2's run log read it.
    p_line_as_spec() {
      local n got
      [ "$(printf '%s' "$1" | cut -f1)" = pivots ] || return 1
      got=$(printf '%s' "$1" | cut -f2- | tr '\t' '\n' | sed 's/=.*//' | tr '\n' ' ')
      [ "$got" = "$P_KEYS " ] || return 1
      for n in $P_COUNT_KEYS; do
        case "$(kv "$1" "$n")" in '' | *[!0-9]*) return 1 ;; esac
      done
      for n in digest_names digest_fields; do
        printf '%s' "$(kv "$1" "$n")" | LC_ALL=C "$G" -qxE '[0-9a-f]{16}' || return 1
      done
      [ "$(( $(kv "$1" source_worksheet) + $(kv "$1" source_external) + $(kv "$1" source_other) ))" = "$(kv "$1" with_cache)" ]
    }
    # k_line_as_spec <tool line>: the kinds line as M5 part 2 P1's run log read it.
    k_line_as_spec() {
      local n got sum=0
      [ "$(printf '%s' "$1" | cut -f1)" = kinds ] || return 1
      got=$(printf '%s' "$1" | cut -f2- | tr '\t' '\n' | sed 's/=.*//' | tr '\n' ' ')
      [ "$got" = "$K_KEYS " ] || return 1
      for n in $K_KEYS; do
        case "$(kv "$1" "$n")" in '' | *[!0-9]*) return 1 ;; esac
      done
      for n in $KIND_KEYS; do sum=$((sum + $(kv "$1" "$n"))); done
      [ "$sum" = "$(kv "$1" kinds_sum)" ] || return 1
      [ "$(( $(kv "$1" kinds_sum) + 1 ))" = "$(kv "$1" entries)" ]
    }
    # spec_holds <tool line> <check line>: the spec's expected results per
    # corpus workbook for the extlinks line (change NTU): links 0, against the
    # check's own reading of the input, no <externalReferences> in the workbook
    # part (reference_lists 0) and no entry of the external link content type
    # (typed 0).
    spec_holds() {
      [ "$(kv "$1" links)" = 0 ] && [ "$(kv "$2" reference_lists)" = 0 ] && [ "$(kv "$2" typed)" = 0 ]
    }
    # p_spec_holds <tool line> <check line>: the pivot sample's expected
    # results (M5 part 2 P2's spec_holds, carried).
    p_spec_holds() {
      [ "$(kv "$1" with_cache)" = "$(kv "$1" pivot_tables)" ] || return 1
      if [ "$(kv "$2" short_caches)" = 0 ]; then [ "$(kv "$1" named_fields)" = "$(kv "$1" fields)" ] || return 1; fi
    }
    # k_spec_holds <tool line>: the kinds sample's expected results (P1's NTF).
    k_spec_holds() { [ "$(kv "$1" sheet_charts)" -le "$(kv "$1" charts)" ] && [ "$(kv "$1" sheet_tables)" = "$(kv "$1" tables)" ]; }
    check "control: all_yes refuses a line with no flags" "$(ynnot all_yes "found=1")"
    check "control: p_all_yes refuses a line with no flags" "$(ynnot p_all_yes "found=1")"
    check "control: k_all_yes refuses a line with no flags" "$(ynnot k_all_yes "found=1")"
    # tool_line_of <check>: the TOOL_LINE the check's source holds, the tool
    # test's line with its digests computed there.
    tool_line_of() {
      python3 -I -B -c 'import importlib.util, sys
    spec = importlib.util.spec_from_file_location("chk", sys.argv[1])
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    print(m.TOOL_LINE)' "$1"
    }
    LINE_C=$(tool_line_of "$B/extlinkcmp.py")
    echo "  the extlinks tool test's line, as extlinkcmp.py's TOOL_LINE holds it (its digests computed there): $(printf '%s' "$LINE_C" | tr '\t' ' ')"
    check "control: line_as_spec accepts the extlinks tool test's line" "$(yn line_as_spec "$LINE_C")"
    for bad in "s/links=3/links=x/" "s/books=1/books=2/" "s/digest_targets=[0-9a-f]*/digest_targets=0/" \
               "s/\tdefined_names=1//" "s/^extlinks/pivots/"; do
      lin_ctl() { line_as_spec "$(printf '%s' "$LINE_C" | sed "$bad")"; }
      check "control: line_as_spec refuses the line changed by $bad" "$(ynnot lin_ctl)"
    done
    CMP_C="$(printf '%s' "$LINE_C" | cut -f2- | tr '\t' ' ') reference_lists=1 references=3 typed=3 entries_same=yes ref_rule=yes"
    spec_c() { spec_holds "$LINE_C" "$CMP_C"; }
    check "control: spec_holds refuses the extlinks tool test's line, which has three links" "$(ynnot spec_c)"
    LINE_0="extlinks${TAB}links=0${TAB}books=0${TAB}dde=0${TAB}ole=0${TAB}sheet_names=0${TAB}defined_names=0${TAB}digest_targets=cbf29ce484222325${TAB}digest_sheets=cbf29ce484222325"
    CMP_0="links=0 books=0 dde=0 ole=0 sheet_names=0 defined_names=0 digest_targets=cbf29ce484222325 digest_sheets=cbf29ce484222325 reference_lists=0 references=0 typed=0 entries_same=yes ref_rule=yes"
    check "control: line_as_spec accepts a line of no link, its digests over no value" "$(yn line_as_spec "$LINE_0")"
    spec_c0() { spec_holds "$LINE_0" "$CMP_0"; }
    check "control: spec_holds accepts a line of no link where the check reads no reference list and no typed entry" "$(yn spec_c0)"
    spec_c1() { spec_holds "$LINE_0" "$(printf '%s' "$CMP_0" | sed 's/reference_lists=0/reference_lists=1/')"; }
    check "control: spec_holds refuses a line of no link where the check reads an empty reference list" "$(ynnot spec_c1)"
    spec_c2() { spec_holds "$LINE_0" "$(printf '%s' "$CMP_0" | sed 's/typed=0/typed=1/')"; }
    check "control: spec_holds refuses a line of no link where the check reads one typed entry" "$(ynnot spec_c2)"
    check "control: tool_and_cmp accepts a pair that agrees" "$(yn tool_and_cmp "$LINE_C" "$CMP_C")"
    tac_ctl() { tool_and_cmp "$LINE_C" "$(printf '%s' "$CMP_C" | sed 's/sheet_names=2/sheet_names=3/')"; }
    check "control: tool_and_cmp refuses a pair whose sheet names disagree" "$(ynnot tac_ctl)"
    tac_ctl2() { tool_and_cmp "$LINE_C" "$(printf '%s' "$CMP_C" | sed 's/digest_sheets=[0-9a-f]*/digest_sheets=0000000000000000/')"; }
    check "control: tool_and_cmp refuses a pair whose sheet digests disagree" "$(ynnot tac_ctl2)"
    tac_ctl3() { tool_and_cmp "$LINE_C" "$(printf '%s' "$CMP_C" | sed 's/ ole=1//')"; }
    check "control: tool_and_cmp refuses a check line missing a key" "$(ynnot tac_ctl3)"
    P_LINE_C=$(tool_line_of "$B/pivotcmp.py")
    echo "  the pivot tool test's line, as pivotcmp.py's TOOL_LINE holds it: $(printf '%s' "$P_LINE_C" | tr '\t' ' ')"
    check "control: p_line_as_spec accepts the pivot tool test's line" "$(yn p_line_as_spec "$P_LINE_C")"
    for bad in "s/pivot_tables=2/pivot_tables=x/" "s/with_cache=1/with_cache=2/" "s/^pivots/extlinks/"; do
      plin_ctl() { p_line_as_spec "$(printf '%s' "$P_LINE_C" | sed "$bad")"; }
      check "control: p_line_as_spec refuses the line changed by $bad" "$(ynnot plin_ctl)"
    done
    P_CMP_C="$(printf '%s' "$P_LINE_C" | cut -f2- | tr '\t' ' ') caches=1 cache_worksheet=1 cache_external=0 cache_other=0 cache_field_names=3 tables_with_data=1 short_caches=0 entries_same=yes source_rule=yes"
    check "control: p_tool_and_cmp accepts a pair that agrees" "$(yn p_tool_and_cmp "$P_LINE_C" "$P_CMP_C")"
    ptac_ctl() { p_tool_and_cmp "$P_LINE_C" "$(printf '%s' "$P_CMP_C" | sed 's/axis_row=1/axis_row=2/')"; }
    check "control: p_tool_and_cmp refuses a pair whose row axes disagree" "$(ynnot ptac_ctl)"
    psh_ctl() { p_spec_holds "$P_LINE_C" "$P_CMP_C"; }
    check "control: p_spec_holds refuses the pivot tool test's line, whose second table has no cache" "$(ynnot psh_ctl)"
    K_LINE_C=$(printf 'kinds\tworksheets=1\tchartsheets=0\tdialogsheets=0\tmacrosheets=0\tcharts=1\tchartex=0\tdrawings=1\timages=1\ttables=1\tpivot_tables=0\tpivot_caches=0\tpivot_cache_records=0\texternal_links=0\tvba_projects=0\tslicers=0\tslicer_caches=0\ttimelines=0\ttimeline_caches=0\tcomments=0\tthreaded_comments=0\tpersons=0\tcustom_xml=0\tconnections=0\tquery_tables=0\tcustom_properties=0\tprinter_settings=0\tcalc_chains=0\tother_typed=6\tuntyped=1\tentries=13\tkinds_sum=12\tsheets=1\tsheet_drawings=1\tsheet_charts=1\tsheet_images=1\tsheet_comments=0\tsheet_vml_drawings=0\tsheet_tables=1\tsheet_pivot_tables=0\tsheet_slicers=0\tsheet_timelines=0\tsheet_printer_settings=0\tsheet_external_hyperlinks=1\tsheet_sparkline_groups=1')
    check "control: k_line_as_spec accepts the kinds tool test's line" "$(yn k_line_as_spec "$K_LINE_C")"
    for bad in "s/worksheets=1/worksheets=2/" "s/kinds_sum=12/kinds_sum=13/" "s/^kinds/pivots/"; do
      klin_ctl() { k_line_as_spec "$(printf '%s' "$K_LINE_C" | sed "$bad")"; }
      check "control: k_line_as_spec refuses the line changed by $bad" "$(ynnot klin_ctl)"
    done
    check "control: k_spec_holds accepts the kinds tool test's line" "$(yn k_spec_holds "$K_LINE_C")"
    ksh_ctl() { k_spec_holds "$(printf '%s' "$K_LINE_C" | sed 's/sheet_tables=1/sheet_tables=0/')"; }
    check "control: k_spec_holds refuses a line whose sheet tables are not its tables" "$(ynnot ksh_ctl)"
    K_CMP_C="$(printf '%s' "$K_LINE_C" | cut -f2- | tr '\t' ' ') entries_same=yes sum_rule=yes"
    check "control: k_tool_and_cmp accepts a pair that agrees" "$(yn k_tool_and_cmp "$K_LINE_C" "$K_CMP_C")"
    ktac_ctl() { k_tool_and_cmp "$K_LINE_C" "$(printf '%s' "$K_CMP_C" | sed 's/other_typed=6/other_typed=7/')"; }
    check "control: k_tool_and_cmp refuses a pair whose other_typed counts disagree" "$(ynnot ktac_ctl)"
    
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    # count_ok_where <summary> <column> <value>: among the rows whose outcome is ok.
    count_ok_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) { if ($i == c) k = i; if ($i == "outcome") o = i }; next } k && o && $o == "ok" && $k == v { n++ } END { print n + 0 }' "$1"; }
    sum_col() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { n += $k } END { print n + 0 }' "$1"; }
    # status_rows <entries> <status>: the entry rows of that status, every
    # workbook.
    status_rows() { awk -F'\t' -v s="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "status") k = i; next } k && $k == s { n++ } END { print n + 0 }' "$1"; }
    # entries_named <entries> <id>: the runner's rows for one workbook as
    # "Harness runs" gives them for the kinds sample (change NSO, carried): every
    # row identical and unflagged, some row there; nothing changed, added,
    # dropped or recompressed.
    entries_named() {
      awk -F'\t' -v id="$2" '
        NR == 1 { for (c = 1; c <= NF; c++) k[$c] = c; next }
        $k["id"] != id { next }
        { n++; if ($k["status"] != "identical" || $k["flags"] != "") bad++ }
        END { if (n == 0 || bad > 0) exit 1 }' "$1"
    }
    # chain_rows_of <entries> <id>: the workbook's calcChain rows, those
    # identical and unflagged, and those dropped (change NSI).
    chain_rows_of() {
      awk -F'\t' -v id="$2" '
        NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next }
        $col["id"] == id && $col["name"] == "xl/calcChain.xml" { n++; if ($col["status"] == "identical" && $col["flags"] == "") s++; if ($col["status"] == "dropped") d++ }
        END { print n + 0, s + 0, d + 0 }' "$1"
    }
    # The rule's controls: accepted where it holds, refused on each planted row
    # where it does not (change NSO).
    etsv() { { printf 'id\tname\tstatus\tflags\n'; printf "$@"; } >"$B/ce.tsv"; }
    en_yes() { entries_named "$B/ce.tsv" w; }
    etsv 'w\txl/styles.xml\tidentical\t\nw\t[Content_Types].xml\tidentical\t\nw\txl/workbook.xml\tidentical\t\n'
    check "control: entries_named accepts every row identical and unflagged" "$(yn en_yes)"
    etsv 'w\txl/styles.xml\tchanged\t\nw\txl/workbook.xml\tidentical\t\n'
    check "control: entries_named refuses a changed row" "$(ynnot en_yes)"
    etsv 'w\txl/styles.xml\tidentical\tdescriptor\nw\txl/workbook.xml\tidentical\t\n'
    check "control: entries_named refuses an identical row flagged" "$(ynnot en_yes)"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\trecompressed\t\n'
    check "control: entries_named refuses a recompressed row" "$(ynnot en_yes)"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/planted.xml\tadded\t\n'
    check "control: entries_named refuses an added row" "$(ynnot en_yes)"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\tdropped\t\n'
    check "control: entries_named refuses a dropped row" "$(ynnot en_yes)"
    etsv 'v\txl/styles.xml\tidentical\t\n'
    check "control: entries_named refuses a workbook with no rows" "$(ynnot en_yes)"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\tidentical\t\n'
    check "control: chain_rows_of reads the planted workbook's one calcChain row, identical and unflagged" "$(yn [ "$(chain_rows_of "$B/ce.tsv" w)" = "1 1 0" ])"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\tdropped\t\n'
    check "control: chain_rows_of reads a dropped calcChain row as dropped" "$(yn [ "$(chain_rows_of "$B/ce.tsv" w)" = "1 0 1" ])"
    # refusal_of <run dir> <id> <label>: the layer's one "error: " line when the
    # row is a refusal, else nothing.
    refusal_of() { sed -n '1s/^error: //p' "$1/$2/stderr.$3.txt"; }
    
    # same_row <run dir> <earlier run dir> <id> <ext> <label>: the row's output
    # and its tool line in the two run directories, both there, the same by
    # sha256 (changes NSY and NTX).
    same_row() {
      local f
      for f in "out.$5.$4" "stdout.$5.txt"; do
        [ -f "$1/$3/$f" ] && [ -f "$2/$3/$f" ] || return 1
        [ "$(sha_of "$1/$3/$f")" = "$(sha_of "$2/$3/$f")" ] || return 1
      done
    }
    mkdir -p "$B/c-ident/a/w" "$B/c-ident/b/w" "$B/c-ident/c/w" "$B/c-ident/d/w"
    printf 'pk' >"$B/c-ident/a/w/out.host.xlsx"; printf 'line\n' >"$B/c-ident/a/w/stdout.host.txt"
    cp "$B/c-ident/a/w/out.host.xlsx" "$B/c-ident/a/w/stdout.host.txt" "$B/c-ident/b/w/"
    cp "$B/c-ident/a/w/out.host.xlsx" "$B/c-ident/c/w/"; printf 'line2\n' >"$B/c-ident/c/w/stdout.host.txt"
    cp "$B/c-ident/a/w/stdout.host.txt" "$B/c-ident/d/w/"
    check "control: the planted differing line differs from the original (cmp)" "$(ynnot cmp -s "$B/c-ident/a/w/stdout.host.txt" "$B/c-ident/c/w/stdout.host.txt")"
    check "control: same_row accepts two planted rows the same byte for byte" "$(yn same_row "$B/c-ident/a" "$B/c-ident/b" w xlsx host)"
    check "control: same_row refuses a planted row whose line differs" "$(ynnot same_row "$B/c-ident/a" "$B/c-ident/c" w xlsx host)"
    check "control: same_row refuses a planted row with no output" "$(ynnot same_row "$B/c-ident/a" "$B/c-ident/d" w xlsx host)"
    # prevrec.py <run dir> <record .txt>: the earlier run directory's summaries,
    # every label's in order, against the summary table, the first of three, of
    # that run's committed record (changes NSY and NTX).
    cat >"$B/prevrec.py" <<'PY'
    import os
    import sys
    
    sys.dont_write_bytecode = True
    run_dir, txt = sys.argv[1:3]
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    summary = []
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        summary += s[1:]
    tables = "\n".join(lines(txt)).split("\n\n")
    ok = len(labels) == 2 and len(tables) == 3 and tables[0].split("\n") == summary
    print("labels %s; summary rows %d; the record's summary table is the run directory's: %s" % (",".join(labels), len(summary) - 1, "yes" if ok else "no"))
    PY
    echo "command: <work>/prevrec.py <earlier run directory> <its committed record's .txt>; the program:"
    sed 's/^/    /' "$B/prevrec.py"
    
    echo
    echo "## TMPDIR for the corpus runs, on the disk"
    RUNTMP=$B/tmp-run
    mkdir "$RUNTMP" || exit 2
    dev_tmp=$(stat -c %d "$RUNTMP")
    dev_corpus=$(stat -c %d "$CORPUS/corpus")
    dev_proc=$(stat -c %d /proc)
    echo "command: mkdir <work>/tmp-run; stat -c %d <work>/tmp-run <corpus>/corpus /proc; df --output=fstype,target <work>/tmp-run <corpus>/corpus"
    echo "  device of TMPDIR (<work>/tmp-run): $dev_tmp; of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    df --output=fstype,target "$RUNTMP" "$CORPUS/corpus" | sed 's/^/    /'
    check "TMPDIR for the corpus runs and the corpus directory are on one device" "$(yn [ "$dev_tmp" = "$dev_corpus" ])"
    check "control: the same comparison tells /proc's device from the corpus directory's" "$(yn [ "$dev_proc" != "$dev_corpus" ])"
    
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names. Change VJ: the dropped families are an
    input, as the changed and added ones are."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, want_changed, want_added, want_dropped, tool_arg = sys.argv[1:9]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    def listed(value):
        return value.split(",") if value else []
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        changed_f = sorted(f for f in fam if fam[f].get("changed"))
        dropped_f = sorted(f for f in fam if fam[f].get("dropped"))
        added_f = sorted(f for f in fam if fam[f].get("added"))
        checks.append(("%s: the xml families are the changed entries' families" % label, sorted(xf) == changed_f))
        checks.append(("%s: the changed entries' families are %s" % (label, want_changed or "none"), changed_f == listed(want_changed)))
        checks.append(("%s: the dropped entries' families are %s" % (label, want_dropped or "none"), dropped_f == listed(want_dropped)))
        checks.append(("%s: the added entries' families are %s" % (label, want_added or "none"), added_f == listed(want_added)))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: " + tool_arg in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    fams_of() {
      python3 -I -B -c 'import importlib.util, sys
    spec = importlib.util.spec_from_file_location("record", sys.argv[1])
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    rows = [l.split("\t", 1) for l in open(sys.argv[2]).read().split("\n") if l]
    print(",".join(sorted({record.family(n) for (k, n) in rows if k == sys.argv[3]})))' scripts/passthrough-record.py "$1" "$2"
    }
    inst_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
    # Change JI: no bytecode was written, so there is nothing to remove.
    no_pycache() { [ ! -e scripts/__pycache__ ]; }
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      echo
      echo "## $SAMPLE: $label run, --tool-arg $EDIT"
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --out <runs>/$RUN-$SAMPLE --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$O" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
        >"$B/run-$label.stdout" 2>"$B/run-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$label.stderr")"
      sed 's/^/    /' "$B/run-$label.stdout"
      check "$label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$label: its stderr is empty" "$(yn [ ! -s "$B/run-$label.stderr" ])"
      n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
      echo "  entries left in <work>/tmp-run after the run: $n_left"
      check "$label: the runs' TMPDIR is empty after the run" "$(yn [ "$n_left" = 0 ])"
      SUM=$O/summary.$label.tsv
      ENT=$O/entries.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      n_ok=$(count_where "$SUM" outcome ok)
      # The refusals, by id and message.
      : >"$B/refused-$label"
      while IFS="$TAB" read -r id ext; do
        if [ "$(awk -F'\t' -v id="$id" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id { print $k["outcome"] " " $k["exit"] }' "$SUM")" = "error 2" ] \
           && [ "$(count_lines "$O/$id/stderr.$label.txt")" = 1 ] && [ -n "$(refusal_of "$O" "$id" "$label")" ]; then
          printf '%s\t%s\n' "$id" "$(refusal_of "$O" "$id" "$label")" >>"$B/refused-$label"
        fi
      done <"$B/order"
      n_ref=$(count_lines "$B/refused-$label")
      echo "  summary rows: $rows; outcome ok: $n_ok; refused by the layer (a finding; fails the summary): $n_ref"
      sed 's/^/    refused: /' "$B/refused-$label"
      echo "  among the ok rows: lo ok $(count_ok_where "$SUM" lo ok); lo_in ok $(count_ok_where "$SUM" lo_in ok); leftover no $(count_ok_where "$SUM" leftover no); order_preserved yes $(count_ok_where "$SUM" order_preserved yes); comment_equal yes $(count_ok_where "$SUM" comment_equal yes); files_identical yes $(count_ok_where "$SUM" files_identical yes), no $(count_ok_where "$SUM" files_identical no) (asserted below; change NSO)"
      echo "  every row: lo_in ok $(count_where "$SUM" lo_in ok); leftover no $(count_where "$SUM" leftover no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      echo "  the entries table's rows by status: identical $(status_rows "$ENT" identical), recompressed $(status_rows "$ENT" recompressed), changed $(status_rows "$ENT" changed), dropped $(status_rows "$ENT" dropped), added $(status_rows "$ENT" added)"
      # The totals the ok rows imply by the rule (change NSO): nothing changed.
      echo "  the entry totals the ok rows imply: changed 0, added 0, dropped 0, none recompressed, files_identical yes in every ok row"
      summary_ok() {
        local col st
        [ "$rows" = "$manifest_rows" ] || return 1
        [ "$n_ok" = "$rows" ] && [ "$n_ref" = 0 ] || return 1
        for col in "lo ok" "lo_in ok" "leftover no" "order_preserved yes" "comment_equal yes" "files_identical yes"; do
          [ "$(count_ok_where "$SUM" ${col% *} ${col#* })" = "$n_ok" ] || return 1
        done
        [ "$(count_where "$SUM" lo_in ok)" = "$rows" ] || return 1
        [ "$(count_where "$SUM" leftover no)" = "$rows" ] || return 1
        for st in changed added dropped recompressed flagged; do
          [ "$(sum_col "$SUM" "$st")" = 0 ] || return 1
        done
        for st in identical recompressed changed dropped added; do
          [ "$(sum_col "$SUM" "$st")" = "$(status_rows "$ENT" "$st")" ] || return 1
        done
      }
      check "$label: every row ok; every row's input opens (lo_in ok) with no leftover; every output opens (lo ok), order and comment kept, files_identical yes; nothing changed, added, dropped, recompressed or flagged; the summary's status totals the entries table's" "$(yn summary_ok)"
      echo "  per ok workbook: id, the tool's line, the check's line (counts and flags only)"
      : >"$B/lines-$label"
      : >"$B/cmp-$label"
      nwb=0; nflags=0; nagree=0; nline=0; nentries=0; nspec=0; ncmperr=0
      nchain=0; nchain_same=0; nchain_drop=0
      while IFS="$TAB" read -r id ext; do
        if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$label")" ]; then continue; fi
        nwb=$((nwb + 1))
        e=$(cat "$O/$id/stdout.$label.txt")
        c=$(python3 -I -B "$B/extlinkcmp.py" extlinks "$CORPUS/corpus/$id.$ext" "$O/$id/out.$label.$ext")
        printf '%s\t%s\n' "$id" "$e" >>"$B/lines-$label"
        printf '%s\t%s\n' "$id" "$c" >>"$B/cmp-$label"
        printf '    %s %s\n' "$id" "$(printf '%s' "$e" | tr '\t' ' ')"
        printf '    %s cmp %s\n' "$id" "$c"
        if LC_ALL=C "$G" -qxF "$id" "$B/chain-ids"; then
          cr=$(chain_rows_of "$ENT" "$id")
          set -- $cr
          nchain=$((nchain + $1)); nchain_same=$((nchain_same + $2)); nchain_drop=$((nchain_drop + $3))
        fi
        if [ -z "$(kv "$c" error)" ]; then :; else ncmperr=$((ncmperr + 1)); echo "    $id: the check could not read the workbook ($(kv "$c" error))"; fi
        if all_yes "$c"; then nflags=$((nflags + 1)); else echo "    $id: a flag of the check does not hold"; fi
        if tool_and_cmp "$e" "$c"; then nagree=$((nagree + 1)); else echo "    $id: the tool and the check disagree"; fi
        if line_as_spec "$e"; then nline=$((nline + 1)); else echo "    $id: the tool's line is not what the spec reads"; fi
        if entries_named "$ENT" "$id"; then nentries=$((nentries + 1)); else echo "    $id: the entry rows are not what the rule gives"; fi
        if spec_holds "$e" "$c"; then nspec=$((nspec + 1)); else echo "    FINDING (the spec's expected results; change NTU): $id: links $(kv "$e" links); reference lists $(kv "$c" reference_lists); typed entries $(kv "$c" typed)"; fi
      done <"$B/order"
      echo "  ok workbooks read: $nwb; every flag holds: $nflags; the tool and the check agree (every key): $nagree; the line as the spec reads: $nline; entry rows as the rule gives: $nentries; the spec's expected results hold: $nspec; workbooks the check could not read: $ncmperr"
      check "$label: the check read every ok workbook" "$(yn [ "$nwb" = "$n_ok" ])"
      check "$label: the check could read every ok workbook" "$(yn [ "$ncmperr" = 0 ])"
      check "$label: every flag of the check holds in every ok workbook (every entry the input's; the reference rule)" "$(yn [ "$nflags" = "$n_ok" ])"
      check "$label: the tool's every key is the check's own in every ok workbook, the two digests among them (change NTU)" "$(yn [ "$nagree" = "$n_ok" ])"
      check "$label: every line is what the spec reads" "$(yn [ "$nline" = "$n_ok" ])"
      check "$label: every ok workbook's entry rows are as the rule gives (change NSO)" "$(yn [ "$nentries" = "$n_ok" ])"
      check "$label: links 0 in every ok workbook, the check reading no <externalReferences> and no external link part, no finding (change NTU)" "$(yn [ "$nspec" = "$n_ok" ])"
      echo "  calcChain rows in the ok rows of the chain workbooks: $nchain; identical and unflagged: $nchain_same; dropped: $nchain_drop (change NSI)"
      chain_kept() { [ "$nchain" = "$N_CHAIN" ] && [ "$nchain_same" = "$nchain" ] && [ "$nchain_drop" = 0 ]; }
      check "$label: every chain workbook has one calcChain row, identical and unflagged, none dropped (change NSI)" "$(yn chain_kept)"
      R=$O/run.$label.tsv
      args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$R")
      bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
      check "$label: the run row records the two release binaries by sha256 and the phase commit" "$(yn bins_in_row)"
      check "$label: the run row's tool_args is $EDIT" "$(yn [ "$args" = "$EDIT" ])"
    done
    check "the same workbooks are refused on both targets, with the same messages (none)" "$(yn cmp -s "$B/refused-host" "$B/refused-i686")"
    cp "$B/refused-host" "$B/c-refused"; printf 'x\tsome message\n' >>"$B/c-refused"
    check "control: the same comparison tells a planted refusal list from the host's" "$(ynnot cmp -s "$B/c-refused" "$B/refused-i686")"
    mkdir -p "$B/c-refrun/r1"
    printf 'error: a planted message\n' >"$B/c-refrun/r1/stderr.host.txt"
    ref_read() { [ "$(refusal_of "$B/c-refrun" r1 host)" = "a planted message" ]; }
    check "control: refusal_of reads a planted refusal's message" "$(yn ref_read)"
    : >"$B/c-refrun/r1/stderr.host.txt"
    ref_none() { [ -z "$(refusal_of "$B/c-refrun" r1 host)" ]; }
    check "control: refusal_of reads nothing from an empty standard error" "$(yn ref_none)"
    entries_ctl() {
      local id
      id=$(head -n 1 "$B/order" | cut -f1)
      entries_named "$O/entries.host.tsv" "${id}x"
    }
    check "control: entries_named refuses the first workbook's id with a letter appended, which has no rows" "$(ynnot entries_ctl)"
    
    echo
    echo "### the corpus totals over the host's ok workbooks (specs/0033 \"Facts\": no corpus workbook holds an external link part, and no xl/workbook.xml holds <externalReferences>; change NTV)"
    # total_of <lines> <key>: the key summed over the lines (tab- or
    # space-separated pairs); wbs_of: the lines where it is above 0.
    total_of() { cut -f2- "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | awk '{ n += $1 } END { print n + 0 }'; }
    wbs_of() { cut -f2- "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | awk '$1 > 0 { n++ } END { print n + 0 }'; }
    # departures <lines> <expectations>: the keys whose total, or whose count of
    # workbooks where one is given (not "-"), is not the expected, in the
    # expectations' order, space-separated.
    departures() {
      local k t w out=""
      while read -r k t w; do
        if [ "$(total_of "$1" "$k")" != "$t" ]; then out="$out $k"; continue; fi
        if [ "$w" != - ] && [ "$(wbs_of "$1" "$k")" != "$w" ]; then out="$out $k"; fi
      done <"$2"
      printf '%s' "${out# }"
    }
    # expected <lines> <expectations> <label>: each figure beside the total,
    # a departure printed as a FINDING; n_exp and n_same counted.
    expected() {
      local k t w got gotw
      while read -r k t w; do
        n_exp=$((n_exp + 1))
        got=$(total_of "$1" "$k"); gotw=$(wbs_of "$1" "$k")
        if [ "$got" = "$t" ] && { [ "$w" = - ] || [ "$gotw" = "$w" ]; }; then
          n_same=$((n_same + 1))
          echo "  $3 $k: $got in $gotw workbooks; planning's $t$([ "$w" = - ] || echo " in $w"); the same: yes"
        else
          echo "  FINDING (planning's figure; change NTV): $3 $k: $got in $gotw workbooks; planning's $t$([ "$w" = - ] || echo " in $w")"
        fi
      done <"$2"
    }
    printf '%s\n' "links 0 0" "books 0 0" "dde 0 0" "ole 0 0" "sheet_names 0 0" "defined_names 0 0" >"$B/planning-extlinks.tsv"
    printf '%s\n' "reference_lists 0 0" "references 0 0" "typed 0 0" >"$B/planning-extlinks-cmp.tsv"
    n_exp=0; n_same=0
    expected "$B/lines-host" "$B/planning-extlinks.tsv" "extlinks:"
    expected "$B/cmp-host" "$B/planning-extlinks-cmp.tsv" "the check:"
    E_DEPARTED=$(departures "$B/lines-host" "$B/planning-extlinks.tsv")
    E_DEPARTED_C=$(departures "$B/cmp-host" "$B/planning-extlinks-cmp.tsv")
    echo "  the figures met: $n_same of $n_exp; the departed fields: the tool's ${E_DEPARTED:-none}; the check's ${E_DEPARTED_C:-none}"
    e_met() { [ "$n_same" = 9 ] && [ -z "$E_DEPARTED$E_DEPARTED_C" ]; }
    check "links 0 in every workbook, and no reference list, reference or typed entry, so every figure is met (9 of 9; change NTV)" "$(yn e_met)"
    e_met_ctl() { local E_DEPARTED=links; e_met; }
    check "control: the same check refuses a planted departure" "$(ynnot e_met_ctl)"
    printf 'w1\textlinks\tlinks=0\tbooks=0\nw2\textlinks\tlinks=2\tbooks=1\n' >"$B/c-lines.tsv"
    printf '%s\n' "links 2 1" "books 1 1" >"$B/c-exp1"
    printf '%s\n' "links 0 0" "books 1 1" >"$B/c-exp2"
    printf '%s\n' "links 2 2" "books 1 -" >"$B/c-exp3"
    check "control: departures reads none where planted totals and workbook counts are met" "$(yn [ -z "$(departures "$B/c-lines.tsv" "$B/c-exp1")" ])"
    check "control: departures names links for a planted total of none" "$(yn [ "$(departures "$B/c-lines.tsv" "$B/c-exp2")" = links ])"
    check "control: departures names links for a planted workbook count one off" "$(yn [ "$(departures "$B/c-lines.tsv" "$B/c-exp3")" = links ])"
    echo "  digests over the host's ok workbooks: digest_targets $(cut -f2- "$B/lines-host" | tr '\t' '\n' | sed -n 's/^digest_targets=//p' | LC_ALL=C sort | uniq -c | sed 's/^ *//' | paste -sd' '); digest_sheets $(cut -f2- "$B/lines-host" | tr '\t' '\n' | sed -n 's/^digest_sheets=//p' | LC_ALL=C sort | uniq -c | sed 's/^ *//' | paste -sd' ')"
    no_value_digests() { [ "$(cut -f2- "$B/lines-host" | tr '\t' '\n' | LC_ALL=C "$G" -E '^digest_(targets|sheets)=' | LC_ALL=C "$G" -cvE '=cbf29ce484222325$')" = 0 ]; }
    check "every digest is FNV-1a's offset basis, the digest over no value (change NTV)" "$(yn no_value_digests)"
    
    echo
    echo "### the planted-flag controls, host, on the first ok workbook in manifest order (change NTV)"
    first_ok=$(awk -F'\t' 'NR == 1 { print $1; exit }' "$B/lines-host")
    first_ext=$(awk -F'\t' -v id="$first_ok" '$1 == id { print $2 }' "$B/order")
    echo "  the workbook: ${first_ok:-none}"
    check "some ok workbook is there, so the plants act on one" "$(yn [ -n "$first_ok" ])"
    nplants=0; nbit=0
    for f in $FLAGS; do
      nplants=$((nplants + 1))
      planted=""
      if [ -n "$first_ok" ]; then
        planted=$(python3 -I -B "$B/extlinkcmp.py" extlinks "$CORPUS/corpus/$first_ok.$first_ext" "$O/$first_ok/out.host.$first_ext" --plant "$f")
      fi
      flag=$f
      turned() { [ -n "$planted" ] && [ "$(kv "$planted" "$flag")" = no ] && [ "$(kv "$planted" planted)" = yes ]; }
      echo "  plant $f on ${first_ok:-none}: planted=$(kv "$planted" planted); $flag=$(kv "$planted" "$flag")"
      if turned; then nbit=$((nbit + 1)); fi
      check "control: the plant $f turns $flag to no" "$(yn turned)"
    done
    check "every flag has a plant that turned it ($nbit of $nplants)" "$(yn [ "$nbit" = "$nplants" ])"
    unknown_plant() { [ "$(python3 -I -B "$B/extlinkcmp.py" extlinks "$CORPUS/corpus/$first_ok.$first_ext" "$O/$first_ok/out.host.$first_ext" --plant no_such_flag)" = error=unknown-plant ]; }
    check "control: the check refuses a plant it does not know" "$(yn unknown_plant)"
    # The count and digest plants: links counted one more, and a planted target
    # digested after the others, so the tool's line and the check's no longer
    # agree (change NTV).
    first_line=$(awk -F'\t' -v id="$first_ok" '$1 == id { sub(/^[^\t]*\t/, ""); print }' "$B/lines-host")
    for p in count digest; do
      counted=""
      if [ -n "$first_ok" ]; then
        counted=$(python3 -I -B "$B/extlinkcmp.py" extlinks "$CORPUS/corpus/$first_ok.$first_ext" "$O/$first_ok/out.host.$first_ext" --plant "$p")
      fi
      echo "  plant $p on ${first_ok:-none}: planted=$(kv "$counted" planted); links $(kv "$counted" links) against the tool's $(kv "$first_line" links); digest_targets the tool's: $([ "$(kv "$counted" digest_targets)" = "$(kv "$first_line" digest_targets)" ] && echo yes || echo no)"
      plant_ran() { [ -n "$counted" ] && [ "$(kv "$counted" planted)" = yes ] && [ -n "$first_line" ]; }
      check "control: the $p plant ran on the workbook" "$(yn plant_ran)"
      check "control: tool_and_cmp refuses the tool's line against the $p plant's (change NTV)" "$(ynnot tool_and_cmp "$first_line" "$counted")"
    done
    echo
    echo "### the two labels' outputs"
    same_out=0
    nboth=0
    while IFS="$TAB" read -r id ext; do
      if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-host")" ]; then continue; fi
      nboth=$((nboth + 1))
      if cmp -s "$O/$id/out.host.$ext" "$O/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
    done <"$B/order"
    echo "  ok workbooks: $nboth; whose host and i686 outputs are byte for byte the same: $same_out"
    check "every output is the same on both targets" "$(yn [ "$same_out" = "$nboth" ])"
    check "both targets printed the same line for every ok workbook" "$(yn cmp -s "$B/lines-host" "$B/lines-i686")"
    cp "$B/lines-host" "$B/c-lines"; printf 'x\n' >>"$B/c-lines"
    check "control: the same comparison tells a line list with one line added" "$(ynnot cmp -s "$B/c-lines" "$B/lines-i686")"
    
    echo
    echo "## the generated fixture: --extlink-sample through the binary on both targets (specs/0033 \"Harness runs\", the extlinks bullet's fixture; change NTW)"
    # extfix.py <fixture path>: writes the fictional fixture with zipfile and
    # prints the line the sample must print for it, its two digests computed
    # here from the constants with FNV-1a. Nothing in it comes from the corpus,
    # so its values may be printed.
    cat >"$B/extfix.py" <<'PY'
    """The run log's fictional external link fixture (specs/0033-read-breadth-
    survey.md, "Harness runs", the extlinks bullet): one sheet of three cells;
    three external link parts in <externalReferences> order: an externalBook
    to a relative target of this program's naming, with two sheet names, one
    defined name and a sheetDataSet; a ddeLink with a service and a topic; an
    oleLink with a progId and an external target. Writes the workbook with
    zipfile to the path given and prints the line --extlink-sample must print
    for it, tab-separated, its digests computed here from the constants."""
    import sys
    import zipfile
    
    sys.dont_write_bytecode = True
    BOOK_TARGET = "linked/fictional-book.xlsx"
    SHEET_NAMES = ["Alpha", "Beta"]
    DEFINED_NAMES = ["Rate"]
    DDE_SERVICE = "FictionalService"
    DDE_TOPIC = "FictionalTopic"
    OLE_PROG_ID = "Package"
    OLE_TARGET = "file:///fictional/object.bin"
    MAIN = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    REL = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    PKG = "http://schemas.openxmlformats.org/package/2006/relationships"
    CT = "http://schemas.openxmlformats.org/package/2006/content-types"
    VND = "application/vnd.openxmlformats-officedocument.spreadsheetml"
    DECL = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    
    
    def fnv(values):
        h = 0xcbf29ce484222325
        for v in values:
            for b in v.encode("utf-8") + b"\n":
                h ^= b
                h = (h * 0x100000001b3) & 0xFFFFFFFFFFFFFFFF
        return "%016x" % h
    
    
    def link(body):
        return DECL + '<externalLink xmlns="%s" xmlns:r="%s">%s</externalLink>' % (MAIN, REL, body)
    
    
    def rels(body):
        return DECL + '<Relationships xmlns="%s">%s</Relationships>' % (PKG, body)
    
    
    sheets = "".join('<sheetName val="%s"/>' % n for n in SHEET_NAMES)
    defined = "".join('<definedName name="%s" refersTo="=%s!$A$1"/>' % (n, SHEET_NAMES[0]) for n in DEFINED_NAMES)
    parts = [
        ("[Content_Types].xml", DECL + '<Types xmlns="%s">'
         '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
         '<Default Extension="xml" ContentType="application/xml"/>'
         '<Override PartName="/xl/workbook.xml" ContentType="%s.sheet.main+xml"/>'
         '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="%s.worksheet+xml"/>'
         '<Override PartName="/xl/externalLinks/externalLink1.xml" ContentType="%s.externalLink+xml"/>'
         '<Override PartName="/xl/externalLinks/externalLink2.xml" ContentType="%s.externalLink+xml"/>'
         '<Override PartName="/xl/externalLinks/externalLink3.xml" ContentType="%s.externalLink+xml"/>'
         '</Types>' % (CT, VND, VND, VND, VND, VND)),
        ("_rels/.rels", rels('<Relationship Id="rId1" Type="%s/officeDocument" Target="xl/workbook.xml"/>' % REL)),
        ("xl/workbook.xml", DECL + '<workbook xmlns="%s" xmlns:r="%s"><sheets>'
         '<sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets><externalReferences>'
         '<externalReference r:id="rId2"/><externalReference r:id="rId3"/><externalReference r:id="rId4"/>'
         '</externalReferences></workbook>' % (MAIN, REL)),
        ("xl/_rels/workbook.xml.rels", rels(
            '<Relationship Id="rId1" Type="%s/worksheet" Target="worksheets/sheet1.xml"/>'
            '<Relationship Id="rId2" Type="%s/externalLink" Target="externalLinks/externalLink1.xml"/>'
            '<Relationship Id="rId3" Type="%s/externalLink" Target="externalLinks/externalLink2.xml"/>'
            '<Relationship Id="rId4" Type="%s/externalLink" Target="externalLinks/externalLink3.xml"/>'
            % (REL, REL, REL, REL))),
        ("xl/worksheets/sheet1.xml", DECL + '<worksheet xmlns="%s"><sheetData><row r="1">'
         '<c r="A1"><v>1</v></c><c r="B1"><v>2</v></c><c r="C1"><v>3</v></c></row></sheetData></worksheet>' % MAIN),
        ("xl/externalLinks/externalLink1.xml", link(
            '<externalBook r:id="rId1"><sheetNames>%s</sheetNames><definedNames>%s</definedNames>'
            '<sheetDataSet><sheetData sheetId="0"><row r="1"><cell r="A1"><v>7</v></cell></row></sheetData>'
            '</sheetDataSet></externalBook>' % (sheets, defined))),
        ("xl/externalLinks/_rels/externalLink1.xml.rels", rels(
            '<Relationship Id="rId1" Type="%s/externalLinkPath" Target="%s" TargetMode="External"/>'
            % (REL, BOOK_TARGET))),
        ("xl/externalLinks/externalLink2.xml", link(
            '<ddeLink ddeService="%s" ddeTopic="%s"><ddeItems><ddeItem name="Item"/></ddeItems></ddeLink>'
            % (DDE_SERVICE, DDE_TOPIC))),
        ("xl/externalLinks/externalLink3.xml", link(
            '<oleLink r:id="rId1" progId="%s"><oleItems><oleItem name="Object"/></oleItems></oleLink>'
            % OLE_PROG_ID)),
        ("xl/externalLinks/_rels/externalLink3.xml.rels", rels(
            '<Relationship Id="rId1" Type="%s/oleObject" Target="%s" TargetMode="External"/>'
            % (REL, OLE_TARGET))),
    ]
    with zipfile.ZipFile(sys.argv[1], "w", zipfile.ZIP_DEFLATED) as z:
        for name, text in parts:
            info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            info.compress_type = zipfile.ZIP_DEFLATED
            z.writestr(info, text.encode("utf-8"))
    print("\t".join(["extlinks", "links=3", "books=1", "dde=1", "ole=1",
                     "sheet_names=%d" % len(SHEET_NAMES), "defined_names=%d" % len(DEFINED_NAMES),
                     "digest_targets=%s" % fnv([BOOK_TARGET, OLE_TARGET]),
                     "digest_sheets=%s" % fnv(SHEET_NAMES)]))
    PY
    echo "command: python3 -I -B <work>/extfix.py <work>/fixture/linked.xlsx; the program:"
    sed 's/^/    /' "$B/extfix.py"
    mkdir "$B/fixture" || exit 2
    FIX=$B/fixture/linked.xlsx
    FIX_WANT=$(python3 -I -B "$B/extfix.py" "$FIX")
    fx=$?
    echo "  exit: $fx; the fixture: $(wc -c <"$FIX") bytes, sha256 $(sha_of "$FIX")"
    echo "  the line the program computes from its constants: $(printf '%s' "$FIX_WANT" | tr '\t' ' ')"
    check "the generator exits 0 and wrote the fixture" "$(yn [ "$fx" = 0 ])"
    fix_want_ok() { [ "$(printf '%s' "$FIX_WANT" | cut -f2-7 | tr '\t' ' ')" = "links=3 books=1 dde=1 ole=1 sheet_names=2 defined_names=1" ] && line_as_spec "$FIX_WANT"; }
    check "the expected line holds links 3, books 1, dde 1, ole 1, sheet_names 2, defined_names 1, and is a line as the spec reads" "$(yn fix_want_ok)"
    FIX_CMP=$(python3 -I -B "$B/extlinkcmp.py" extlinks "$FIX" "$FIX")
    echo "  extlinkcmp.py over the fixture against itself: $FIX_CMP"
    check "the check's own reading of the fixture is the program's line,, every key (its digests among them)" "$(yn tool_and_cmp "$FIX_WANT" "$FIX_CMP")"
    check "the check's flags hold on the fixture (entries_same, ref_rule)" "$(yn all_yes "$FIX_CMP")"
    for label in host i686; do
      var=PT_$label; PT=${!var}
      out=$B/fixture/out.$label.xlsx
      echo "command: TMPDIR=<work>/tmp-run timeout 300 <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy <work>/fixture/linked.xlsx <work>/fixture/out.$label.xlsx --extlink-sample"
      TMPDIR=$RUNTMP timeout 300 "$PT" "$FIX" "$out" --extlink-sample >"$B/fixture/line.$label" 2>"$B/fixture/err.$label" </dev/null
      frc=$?
      echo "  exit: $frc; standard error $(wc -c <"$B/fixture/err.$label") bytes; the line: $(tr '\t' ' ' <"$B/fixture/line.$label")"
      check "fixture $label: the sample exits 0 with nothing on standard error" "$(yn [ "$frc|$(wc -c <"$B/fixture/err.$label")" = "0|0" ])"
      fix_line_ok() { [ "$(cat "$B/fixture/line.$label")" = "$FIX_WANT" ]; }
      check "fixture $label: the line is the program's, value by value (links 3, books 1, dde 1, ole 1, sheet_names 2, defined_names 1, the two digests)" "$(yn fix_line_ok)"
      check "fixture $label: the output is the fixture, byte for byte" "$(yn cmp -s "$FIX" "$out")"
    done
    check "fixture: both targets printed the same line" "$(yn cmp -s "$B/fixture/line.host" "$B/fixture/line.i686")"
    fix_ctl() { [ "$(cat "$B/fixture/line.host")" = "$(printf '%s' "$FIX_WANT" | sed 's/sheet_names=2/sheet_names=3/')" ]; }
    check "control: the same comparison refuses the expected line with sheet_names 3" "$(ynnot fix_ctl)"
    cp "$FIX" "$B/fixture/c-out.xlsx"; printf 'x' >>"$B/fixture/c-out.xlsx"
    check "control: the same byte comparison refuses a copy one byte longer" "$(ynnot cmp -s "$FIX" "$B/fixture/c-out.xlsx")"
    n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
    check "fixture: the runs' TMPDIR is empty after the runs" "$(yn [ "$n_left" = 0 ])"
    
    echo
    echo "## the release binaries: the size log's, copied into <work>/bin and checked against size.log's lines, both targets, for the three samples again (specs/0033 \"P3\"; changes NSW and NTX)"
    echo "input: the size log: $SIZE_LOG (the second argument, or <phase>/logs/size.log; change NSW)"
    echo "input (environment) SIZE_BUILD_ROOT: ${INPUT_SEEN[SIZE_BUILD_ROOT]} (unset: the size log's build directory is <target>/main; a dry run may name another; change NSW)"
    size_log_there() { [ -s "$SIZE_LOG" ]; }
    check "the size log is there and not empty" "$(yn size_log_there)"
    echo "command: sha256sum <the size log>: $(sha_of "$SIZE_LOG" 2>/dev/null)"
    # The size log prints each release binary it builds as two spaces, its path
    # under <target>/main (the host's release directory, or the i686 triple's),
    # ": sha256 ", 64 hex, ", bytes " and a count: M4 part 2 P2's form for its
    # host emend-copy (records/logs/m4p2-p2/size.log).
    HASH_FORM='^  <target>/main/(i686-unknown-linux-musl/)?release/(emend-copy|xlsx-diff): sha256 [0-9a-f]{64}, bytes [0-9]+$'
    n_hash=$(count_matches -E "$HASH_FORM" "$SIZE_LOG")
    echo "command: count_matches -E <the release hash line form> <the size log>: $n_hash"
    check "size.log holds exactly four release hash lines: emend-copy and xlsx-diff, host and $I686" "$(yn [ "$n_hash" = 4 ])"
    # sized_of <log> <triple path or nothing> <binary>: the hash the log prints
    # for that binary, or nothing.
    sized_of() { sed -n -E "s#^  <target>/main/$2release/$3: sha256 ([0-9a-f]{64}), bytes [0-9]+\$#\1#p" "$1" | head -n 1; }
    printf '  <target>/main/release/emend-copy: sha256 %s, bytes 1\n  <target>/main/%s/release/emend-copy: sha256 %s, bytes 1\n' \
      "$(printf 'a' | sha256sum | cut -d' ' -f1)" "$I686" "$(printf 'b' | sha256sum | cut -d' ' -f1)" >"$B/c-size.log"
    sized_ctl() { [ "$(sized_of "$B/c-size.log" "" emend-copy)" = "$(printf 'a' | sha256sum | cut -d' ' -f1)" ] && [ "$(sized_of "$B/c-size.log" "$I686/" emend-copy)" = "$(printf 'b' | sha256sum | cut -d' ' -f1)" ]; }
    check "control: sized_of tells the host line from the $I686 line in a planted log holding both" "$(yn sized_ctl)"
    check "control: the same form counts two lines in that planted log" "$(yn [ "$(count_matches -E "$HASH_FORM" "$B/c-size.log")" = 2 ])"
    mkdir -p "$B/bin/host" "$B/bin/i686" || exit 2
    n_bin_ok=0
    for label in host i686; do
      if [ "$label" = i686 ]; then tp="$I686/"; else tp=""; fi
      for bin in emend-copy xlsx-diff; do
        src=$SIZE_BUILD/${tp}release/$bin
        cp "$src" "$B/bin/$label/$bin"
        want=$(sized_of "$SIZE_LOG" "$tp" "$bin")
        have=$(sha_of "$B/bin/$label/$bin")
        echo "command: cp <sizebuild>/${tp}release/$bin <work>/bin/$label/$bin"
        echo "  <work>/bin/$label/$bin: sha256 $have, bytes $(stat -c %s "$B/bin/$label/$bin"); size.log's line: ${want:-none}"
        bin_is_sized() { [ -n "$want" ] && [ "$have" = "$want" ]; }
        if bin_is_sized; then n_bin_ok=$((n_bin_ok + 1)); fi
        check "$label $bin: the copy is the binary size.log hashed, not a rebuild" "$(yn bin_is_sized)"
      done
    done
    check "the four copies are the four binaries size.log hashed ($n_bin_ok of 4)" "$(yn [ "$n_bin_ok" = 4 ])"
    bin_ctl() { local have; have=$(printf 'x' | sha256sum | cut -d' ' -f1); bin_is_sized; }
    check "control: the same comparison refuses another hash" "$(ynnot bin_ctl)"
    PT_host=$B/bin/host/emend-copy
    XD_host=$B/bin/host/xlsx-diff
    PT_i686=$B/bin/i686/emend-copy
    XD_i686=$B/bin/i686/xlsx-diff
    echo "  this log builds no release binary for the runs below; the first extlinks run's and the fixture's were built above at the phase commit (changes NSW and NTX); $(rustc --version)"
    echo
    echo "## the three samples again with the size log's release binaries: kinds, pivots, extlinks, both targets (specs/0033 \"P3\", ruling 11 of \"Planning rulings on P1\"; change NTX)"
    echo "  each run's rows checked as its own phase's run log checked them (kindscmp.py, pivotcmp.py, extlinkcmp.py), then every row's output and line compared by sha256 with the earlier run's: kinds with M5 part 2 P1's run, pivots with M5 part 2 P2's, extlinks with this log's first run above"
    # The check, its mode and its line functions, per sample (change NTX).
    cmp_of() { case $1 in kinds) echo kindscmp ;; pivots) echo pivotcmp ;; extlinks) echo extlinkcmp ;; esac; }
    edit_of() { case $1 in kinds) echo --kinds-sample ;; pivots) echo --pivot-sample ;; extlinks) echo --extlink-sample ;; esac; }
    s_all_yes() { case $1 in kinds) k_all_yes "$2" ;; pivots) p_all_yes "$2" ;; extlinks) all_yes "$2" ;; esac; }
    s_tool_and_cmp() { case $1 in kinds) k_tool_and_cmp "$2" "$3" ;; pivots) p_tool_and_cmp "$2" "$3" ;; extlinks) tool_and_cmp "$2" "$3" ;; esac; }
    s_line_as_spec() { case $1 in kinds) k_line_as_spec "$2" ;; pivots) p_line_as_spec "$2" ;; extlinks) line_as_spec "$2" ;; esac; }
    s_spec_holds() { case $1 in kinds) k_spec_holds "$2" ;; pivots) p_spec_holds "$2" "$3" ;; extlinks) spec_holds "$2" "$3" ;; esac; }
    check "control: cmp_of names each sample's check" "$(yn [ "$(cmp_of kinds) $(cmp_of pivots) $(cmp_of extlinks)" = "kindscmp pivotcmp extlinkcmp" ])"
    check "control: s_line_as_spec refuses the pivot tool test's line as an extlinks line" "$(ynnot s_line_as_spec extlinks "$P_LINE_C")"
    check "control: s_line_as_spec accepts each tool test's line as its own sample's" "$(yn s_line_as_spec kinds "$K_LINE_C")"
    for SAMPLE in $SAMPLES; do
    EDIT=$(edit_of "$SAMPLE")
    CHK=$(cmp_of "$SAMPLE")
    O=$RUN_OUT_ROOT/$RUN-size-$SAMPLE
    STEM=m5p2-p3-$SAMPLE-$DATE-$SHORT
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      echo
      echo "## $SAMPLE (release): $label run, --tool-arg $EDIT"
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <work>/bin/$label/emend-copy --xlsx-diff <work>/bin/$label/xlsx-diff --out <runs>/$RUN-size-$SAMPLE --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$O" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
        >"$B/run-$SAMPLE-$label.stdout" 2>"$B/run-$SAMPLE-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$SAMPLE-$label.stderr")"
      sed 's/^/    /' "$B/run-$SAMPLE-$label.stdout"
      check "$SAMPLE $label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$SAMPLE $label: its stderr is empty" "$(yn [ ! -s "$B/run-$SAMPLE-$label.stderr" ])"
      n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
      echo "  entries left in <work>/tmp-run after the run: $n_left"
      check "$SAMPLE $label: the runs' TMPDIR is empty after the run" "$(yn [ "$n_left" = 0 ])"
      SUM=$O/summary.$label.tsv
      ENT=$O/entries.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      n_ok=$(count_where "$SUM" outcome ok)
      # The refusals, by id and message.
      : >"$B/refused-$SAMPLE-$label"
      while IFS="$TAB" read -r id ext; do
        if [ "$(awk -F'\t' -v id="$id" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id { print $k["outcome"] " " $k["exit"] }' "$SUM")" = "error 2" ] \
           && [ "$(count_lines "$O/$id/stderr.$label.txt")" = 1 ] && [ -n "$(refusal_of "$O" "$id" "$label")" ]; then
          printf '%s\t%s\n' "$id" "$(refusal_of "$O" "$id" "$label")" >>"$B/refused-$SAMPLE-$label"
        fi
      done <"$B/order"
      n_ref=$(count_lines "$B/refused-$SAMPLE-$label")
      echo "  summary rows: $rows; outcome ok: $n_ok; refused by the layer (a finding; fails the summary): $n_ref"
      sed 's/^/    refused: /' "$B/refused-$SAMPLE-$label"
      echo "  among the ok rows: lo ok $(count_ok_where "$SUM" lo ok); lo_in ok $(count_ok_where "$SUM" lo_in ok); leftover no $(count_ok_where "$SUM" leftover no); order_preserved yes $(count_ok_where "$SUM" order_preserved yes); comment_equal yes $(count_ok_where "$SUM" comment_equal yes); files_identical yes $(count_ok_where "$SUM" files_identical yes), no $(count_ok_where "$SUM" files_identical no)"
      echo "  every row: lo_in ok $(count_where "$SUM" lo_in ok); leftover no $(count_where "$SUM" leftover no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      echo "  the entries table's rows by status: identical $(status_rows "$ENT" identical), recompressed $(status_rows "$ENT" recompressed), changed $(status_rows "$ENT" changed), dropped $(status_rows "$ENT" dropped), added $(status_rows "$ENT" added)"
      echo "  the entry totals the ok rows imply (each sample writes its input back unedited): changed 0, added 0, dropped 0, none recompressed, none flagged, files_identical yes in every ok row"
      summary_ok() {
        local col st
        [ "$rows" = "$manifest_rows" ] || return 1
        [ "$n_ok" = "$rows" ] && [ "$n_ref" = 0 ] || return 1
        for col in "lo ok" "lo_in ok" "leftover no" "order_preserved yes" "comment_equal yes" "files_identical yes"; do
          [ "$(count_ok_where "$SUM" ${col% *} ${col#* })" = "$n_ok" ] || return 1
        done
        [ "$(count_where "$SUM" lo_in ok)" = "$rows" ] || return 1
        [ "$(count_where "$SUM" leftover no)" = "$rows" ] || return 1
        for st in changed added dropped recompressed flagged; do
          [ "$(sum_col "$SUM" "$st")" = 0 ] || return 1
        done
        for st in identical recompressed changed dropped added; do
          [ "$(sum_col "$SUM" "$st")" = "$(status_rows "$ENT" "$st")" ] || return 1
        done
      }
      check "$SAMPLE $label: every row ok; every row's input opens (lo_in ok) with no leftover; every output opens (lo ok), order and comment kept, files_identical yes; nothing changed, added, dropped, recompressed or flagged; the summary's status totals the entries table's" "$(yn summary_ok)"
      echo "  per ok workbook: id, the tool's line, the check's line (counts, flags and digests only)"
      : >"$B/lines-$SAMPLE-$label"
      : >"$B/cmp-$SAMPLE-$label"
      nwb=0; nflags=0; nagree=0; nline=0; nentries=0; nspec=0; ncmperr=0
      nchain=0; nchain_same=0; nchain_drop=0
      while IFS="$TAB" read -r id ext; do
        if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$SAMPLE-$label")" ]; then continue; fi
        nwb=$((nwb + 1))
        e=$(cat "$O/$id/stdout.$label.txt")
        c=$(python3 -I -B "$B/$CHK.py" "$SAMPLE" "$CORPUS/corpus/$id.$ext" "$O/$id/out.$label.$ext")
        printf '%s\t%s\n' "$id" "$e" >>"$B/lines-$SAMPLE-$label"
        printf '%s\t%s\n' "$id" "$c" >>"$B/cmp-$SAMPLE-$label"
        printf '    %s %s\n' "$id" "$(printf '%s' "$e" | tr '\t' ' ')"
        printf '    %s cmp %s\n' "$id" "$c"
        if LC_ALL=C "$G" -qxF "$id" "$B/chain-ids"; then
          cr=$(chain_rows_of "$ENT" "$id")
          set -- $cr
          nchain=$((nchain + $1)); nchain_same=$((nchain_same + $2)); nchain_drop=$((nchain_drop + $3))
        fi
        if [ -z "$(kv "$c" error)" ]; then :; else ncmperr=$((ncmperr + 1)); echo "    $id: the check could not read the workbook ($(kv "$c" error))"; fi
        if s_all_yes "$SAMPLE" "$c"; then nflags=$((nflags + 1)); else echo "    $id: a flag of the check does not hold"; fi
        if s_tool_and_cmp "$SAMPLE" "$e" "$c"; then nagree=$((nagree + 1)); else echo "    $id: the tool and the check disagree"; fi
        if s_line_as_spec "$SAMPLE" "$e"; then nline=$((nline + 1)); else echo "    $id: the tool's line is not what the spec reads"; fi
        if entries_named "$ENT" "$id"; then nentries=$((nentries + 1)); else echo "    $id: the entry rows are not what the rule gives"; fi
        if s_spec_holds "$SAMPLE" "$e" "$c"; then nspec=$((nspec + 1)); else echo "    FINDING (the spec's expected results; change NTX): $id: $SAMPLE"; fi
      done <"$B/order"
      echo "  ok workbooks read: $nwb; every flag holds: $nflags; the tool and the check agree (every key): $nagree; the line as the spec reads: $nline; entry rows as the rule gives: $nentries; the spec's expected results hold: $nspec; workbooks the check could not read: $ncmperr"
      check "$SAMPLE $label: the check read every ok workbook, and could read each" "$(yn [ "$nwb|$ncmperr" = "$n_ok|0" ])"
      check "$SAMPLE $label: every flag of $CHK.py holds in every ok workbook" "$(yn [ "$nflags" = "$n_ok" ])"
      check "$SAMPLE $label: the tool's every key is the check's own in every ok workbook" "$(yn [ "$nagree" = "$n_ok" ])"
      check "$SAMPLE $label: every line is what the spec reads" "$(yn [ "$nline" = "$n_ok" ])"
      check "$SAMPLE $label: every ok workbook's entry rows are as the rule gives, every row identical and unflagged (change NSO)" "$(yn [ "$nentries" = "$n_ok" ])"
      check "$SAMPLE $label: the spec's expected results hold in every ok workbook, no finding" "$(yn [ "$nspec" = "$n_ok" ])"
      echo "  calcChain rows in the ok rows of the chain workbooks: $nchain; identical and unflagged: $nchain_same; dropped: $nchain_drop (change NSI)"
      chain_kept() { [ "$nchain" = "$N_CHAIN" ] && [ "$nchain_same" = "$nchain" ] && [ "$nchain_drop" = 0 ]; }
      check "$SAMPLE $label: every chain workbook has one calcChain row, identical and unflagged, none dropped (change NSI)" "$(yn chain_kept)"
      R=$O/run.$label.tsv
      args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$R")
      bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
      check "$SAMPLE $label: the run row records the size log's two release binaries by sha256 and the phase commit" "$(yn bins_in_row)"
      check "$SAMPLE $label: the run row's tool_args is $EDIT" "$(yn [ "$args" = "$EDIT" ])"
    done
    check "$SAMPLE: the same workbooks are refused on both targets, with the same messages (none)" "$(yn cmp -s "$B/refused-$SAMPLE-host" "$B/refused-$SAMPLE-i686")"
    
    echo
    echo "### $SAMPLE (release): the two labels' outputs"
    same_out=0
    nboth=0
    while IFS="$TAB" read -r id ext; do
      if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$SAMPLE-host")" ]; then continue; fi
      nboth=$((nboth + 1))
      if cmp -s "$O/$id/out.host.$ext" "$O/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
    done <"$B/order"
    echo "  ok workbooks: $nboth; whose host and i686 outputs are byte for byte the same: $same_out"
    check "$SAMPLE: every output is the same on both targets" "$(yn [ "$same_out" = "$nboth" ])"
    check "$SAMPLE: both targets printed the same line for every ok workbook" "$(yn cmp -s "$B/lines-$SAMPLE-host" "$B/lines-$SAMPLE-i686")"
    
    echo
    PREV=${PREV_RUN[$SAMPLE]}
    PREV_PHASE=${PREV_CODE[$SAMPLE]}
    PREV_REC=${PREV_RECORD[$SAMPLE]}
    echo "### $SAMPLE (release): every row against the earlier run, <runs>/$(basename "$PREV"), named by its phase commit and its record commit (change NTX)"
    echo "  the earlier run's phase commit, by its subject: ${PREV_PHASE:-none}; its record commit, by its subject: ${PREV_REC:-none, the run above recorded by none}"
    if [ -n "$PREV_REC" ]; then
      PREV_TXT=$(git show --name-only --format= "$PREV_REC" | LC_ALL=C "$G" -E "^records/m5p2-p[12]-[0-9-]+-[0-9a-f]{7}[.]txt\$")
      echo "command: git show --name-only --format= <its record commit>, the sample record's .txt it added: ${PREV_TXT:-none}"
      check "$SAMPLE: the earlier run's record commit added exactly one sample record .txt" "$(yn [ "$(printf '%s\n' "$PREV_TXT" | count_lines /dev/stdin)" = 1 ])"
      git show "$C:$PREV_TXT" >"$B/prev-$SAMPLE.txt"
      python3 -I -B "$B/prevrec.py" "$PREV" "$B/prev-$SAMPLE.txt" >"$B/prevrec-$SAMPLE.out" 2>&1
      echo "  $(cat "$B/prevrec-$SAMPLE.out")"
      check "$SAMPLE: the earlier run directory's summaries, both labels, are its committed record's summary table" "$(yn [ "$(count_matches -E "is the run directory's: yes\$" "$B/prevrec-$SAMPLE.out")" = 1 ])"
      sed '2d' "$B/prev-$SAMPLE.txt" >"$B/c-prev.txt"
      python3 -I -B "$B/prevrec.py" "$PREV" "$B/c-prev.txt" >"$B/c-prevrec.out" 2>&1
      check "control: the same program refuses that record with one summary row dropped" "$(yn [ "$(count_matches -E "is the run directory's: no\$" "$B/c-prevrec.out")" = 1 ])"
    fi
    for label in host i686; do
      prev_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["commit"] " " $k["tool_args"] }' "$PREV/run.$label.tsv")" = "$PREV_PHASE $EDIT" ]; }
      check "$SAMPLE $label: the earlier run's run row names its phase commit and $EDIT" "$(yn prev_row)"
      nrow=0; nsame=0
      : >"$B/ident-$SAMPLE-$label"
      while IFS="$TAB" read -r id ext; do
        nrow=$((nrow + 1))
        printf '    %s %s out %s %s line %s %s\n' "$id" "$label" \
          "$(sha_of "$O/$id/out.$label.$ext" 2>/dev/null)" "$(sha_of "$PREV/$id/out.$label.$ext" 2>/dev/null)" \
          "$(sha_of "$O/$id/stdout.$label.txt" 2>/dev/null)" "$(sha_of "$PREV/$id/stdout.$label.txt" 2>/dev/null)" >>"$B/ident-$SAMPLE-$label"
        if same_row "$O" "$PREV" "$id" "$ext" "$label"; then nsame=$((nsame + 1)); else echo "    $id: $label: the output or the line differs from the earlier run's"; fi
      done <"$B/order"
      echo "  $label: per row, id, label, the output's sha256 now and then, the line's now and then:"
      cat "$B/ident-$SAMPLE-$label"
      echo "  $SAMPLE $label: rows compared $nrow; identical, output and line, by sha256: $nsame"
      all_same() { [ "$nrow" = "$manifest_rows" ] && [ "$nsame" = 27 ] && [ "$nsame" = "$nrow" ]; }
      check "$SAMPLE $label: every row's output and line are the earlier run's, by sha256, 27 of 27 (ruling 11 of P1)" "$(yn all_same)"
    done
    
    echo
    echo "## the $SAMPLE (release) run's record pair"
    echo "command: python3 -I -B scripts/passthrough-record.py --run <runs>/$RUN-size-$SAMPLE --out <scripts>/out/records --stem $STEM"
    python3 -I -B scripts/passthrough-record.py --run "$O" --out "$RECORDS" --stem "$STEM" >"$B/record-$SAMPLE.out" 2>&1
    rrc=$?
    sed 's/^/    /' "$B/record-$SAMPLE.out"
    check "$SAMPLE: the record script exits 0" "$(yn [ "$rrc" = 0 ])"
    RTXT=$RECORDS/$STEM.txt
    RMD=$RECORDS/$STEM.md
    # The families: the names of the host entries table's changed, added and
    # dropped rows, none for any of the three samples (change NSR).
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] ~ /^(changed|added|dropped)$/ { print $k["status"] "\t" $k["name"] }' "$O/entries.host.tsv" >"$B/w.parts"
    FAM_CHANGED=$(fams_of "$B/w.parts" changed)
    FAM_ADDED=$(fams_of "$B/w.parts" added)
    FAM_DROPPED=$(fams_of "$B/w.parts" dropped)
    echo "  changed, added and dropped names in the host entries table: $(count_lines "$B/w.parts"); the families: changed ${FAM_CHANGED:-none}; added ${FAM_ADDED:-none}; dropped ${FAM_DROPPED:-none}"
    fams_ok() { [ "$(count_lines "$B/w.parts")" = 0 ] && [ -z "$FAM_CHANGED$FAM_ADDED$FAM_DROPPED" ]; }
    check "$SAMPLE: no family is changed, added or dropped (change NSR)" "$(yn fams_ok)"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/reccheck-$SAMPLE.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/reccheck-$SAMPLE.out"
    rec_all() { [ "$(count_matches -E ': yes$' "$B/reccheck-$SAMPLE.out")" = 18 ] && [ "$(count_matches -E ': no$' "$B/reccheck-$SAMPLE.out")" = 0 ]; }
    check "$SAMPLE: the record's three tables are the run directory's, and its family tables are counted from them (eighteen checks: four, six per label, two)" "$(yn rec_all)"
    awk '!done && /^[|] total [|]/ { done = 1; next } { print }' "$RMD" >"$B/c-rec.md"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$B/c-rec.md" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/c-reccheck.out" 2>&1
    sed '2d' "$RTXT" >"$B/c-rec.txt"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$B/c-rec.txt" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/c-reccheck2.out" 2>&1
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "planted" "$EDIT" >"$B/c-reccheck3.out" 2>&1
    rec_ctl() { [ "$(count_matches -E ': no$' "$B/c-reccheck.out")" -ge 1 ] && [ "$(count_matches -F "the summary table is every label's summary: no" "$B/c-reccheck2.out")" = 1 ]; }
    check "control: the same check finds an .md with a family table's total row dropped and a .txt one summary row short" "$(yn rec_ctl)"
    rec_drop() { [ "$(count_matches -E "the dropped entries' families are planted: no\$" "$B/c-reccheck3.out")" = 2 ]; }
    check "control: the same check finds the dropped families differ from a planted family, on each label" "$(yn rec_drop)"
    check "the record script and the record check left no scripts/__pycache__ (PYTHONDONTWRITEBYTECODE)" "$(yn no_pycache)"
    echo "command: install -m 644 <scripts>/out/records/$STEM.md <scripts>/out/records/$STEM.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RMD" "$RTXT" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM.md" "$RECORDS_DEST/$STEM.txt")
    echo "  exit: $?"
    for f in "$STEM.md" "$STEM.txt"; do
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
    done
    done
    
    echo
    echo "### the three release runs beside each other, per workbook, host (the pivot sample's expected result and the external link count; change NTX)"
    n_kp=0; n_ke=0
    while IFS="$TAB" read -r id ext; do
      k=$(awk -F'\t' -v id="$id" '$1 == id { sub(/^[^\t]*\t/, ""); print }' "$B/lines-kinds-host")
      p=$(awk -F'\t' -v id="$id" '$1 == id { sub(/^[^\t]*\t/, ""); print }' "$B/lines-pivots-host")
      x=$(awk -F'\t' -v id="$id" '$1 == id { sub(/^[^\t]*\t/, ""); print }' "$B/lines-extlinks-host")
      if [ -n "$k" ] && [ -n "$p" ] && [ "$(kv "$k" pivot_tables)" = "$(kv "$p" pivot_tables)" ]; then n_kp=$((n_kp + 1)); else echo "    FINDING: $id: the kinds line's pivot_tables $(kv "$k" pivot_tables) against the pivot line's $(kv "$p" pivot_tables)"; fi
      if [ -n "$k" ] && [ -n "$x" ] && [ "$(kv "$k" external_links)" = "$(kv "$x" links)" ]; then n_ke=$((n_ke + 1)); else echo "    FINDING: $id: the kinds line's external_links $(kv "$k" external_links) against the extlinks line's links $(kv "$x" links)"; fi
    done <"$B/order"
    echo "  workbooks whose kinds pivot_tables is the pivot line's: $n_kp; whose kinds external_links is the extlinks line's links: $n_ke; of $manifest_rows"
    check "the kinds sample's pivot_tables is the pivot sample's in every workbook (the pivot sample's expected result)" "$(yn [ "$n_kp" = "$manifest_rows" ])"
    check "the kinds sample's external_links is the extlinks sample's links in every workbook" "$(yn [ "$n_ke" = "$manifest_rows" ])"
    kp_ctl() { local p="pivot_tables=2" e="pivot_tables=3"; [ "$(kv "$p" pivot_tables)" = "$(kv "$e" pivot_tables)" ]; }
    check "control: the pivot_tables comparison refuses a planted pair one apart" "$(ynnot kp_ctl)"
    
    echo
    echo "### planning's figures over the host's release runs (specs/0033 \"Planning rulings on P2\", ruling 1: kinds 24 of 24 with custom_xml 30 in 10, pivots 18 of 18 with data_field_flags 10 in 3; change NTX)"
    printf '%s\n' "worksheets 95 -" "charts 26 11" "drawings 37 -" "tables 51 -" "pivot_tables 9 4" "pivot_caches 8 -" \
      "pivot_cache_records 2 -" "external_links 0 -" "slicers 2 -" "slicer_caches 3 -" "timelines 1 -" "timeline_caches 1 -" \
      "comments 9 -" "custom_xml 30 10" "connections 2 -" "custom_properties 18 -" "calc_chains 9 -" "vba_projects 0 -" \
      "threaded_comments 0 -" "persons 0 -" "chartex 0 -" "chartsheets 0 -" "sheet_sparkline_groups 6 4" \
      "sheet_external_hyperlinks 198 7" >"$B/planning-kinds.tsv"
    n_exp=0; n_same=0
    expected "$B/lines-kinds-host" "$B/planning-kinds.tsv" "kinds:"
    K_DEPARTED=$(departures "$B/lines-kinds-host" "$B/planning-kinds.tsv")
    echo "  planning's kinds figures met: $n_same of $n_exp; the departed fields: ${K_DEPARTED:-none}"
    k_met() { [ -z "$K_DEPARTED" ] && [ "$n_same" = 24 ]; }
    check "every kinds figure of planning's is met, the twenty-four, custom_xml 30 in 10 among them" "$(yn k_met)"
    k_met_ctl() { local K_DEPARTED=custom_xml; k_met; }
    check "control: the same check refuses a planted departure" "$(ynnot k_met_ctl)"
    # Per table, from the tool's lines; per distinct cache definition part, from
    # the check's own keys (M5 part 2 P2's two lists, data_field_flags 10 in 3
    # by ruling 1).
    printf '%s\n' "pivot_tables 9 4" "with_sheet 8 -" "with_cache 9 -" "fields 32 -" "axis_row 12 -" "axis_column 0 -" \
      "axis_page 0 -" "axis_values 0 -" "data_field_flags 10 3" "row_fields 12 -" "column_fields 1 -" "page_fields 0 -" \
      "data_fields 10 -" >"$B/planning-tables.tsv"
    printf '%s\n' "caches 8 4" "cache_worksheet 2 -" "cache_external 6 -" "cache_field_names 28 -" "tables_with_data 8 -" >"$B/planning-caches.tsv"
    n_exp=0; n_same=0
    expected "$B/lines-pivots-host" "$B/planning-tables.tsv" "pivots per table:"
    expected "$B/cmp-pivots-host" "$B/planning-caches.tsv" "pivots per cache:"
    P_DEPARTED=$(departures "$B/lines-pivots-host" "$B/planning-tables.tsv")
    P_DEPARTED_C=$(departures "$B/cmp-pivots-host" "$B/planning-caches.tsv")
    echo "  planning's pivot figures met: $n_same of $n_exp; the departed fields: per table ${P_DEPARTED:-none}; per cache ${P_DEPARTED_C:-none}"
    p_met() { [ -z "$P_DEPARTED$P_DEPARTED_C" ] && [ "$n_same" = 18 ]; }
    check "every pivot figure of planning's is met, the eighteen, data_field_flags 10 in 3 among them (ruling 1 of P2)" "$(yn p_met)"
    p_met_ctl() { local P_DEPARTED=data_field_flags; p_met; }
    check "control: the same check refuses a planted departure" "$(ynnot p_met_ctl)"
    without_sheet=$(( $(total_of "$B/lines-pivots-host" pivot_tables) - $(total_of "$B/lines-pivots-host" with_sheet) ))
    echo "  tables with sheet None (pivot_tables less with_sheet): $without_sheet; planning's 1"
    check "one table has no sheet, the workbook-related one" "$(yn [ "$without_sheet" = 1 ])"
    
    echo
    echo "## the CHANGELOG's citation check and form (specs/0033 \"P3\"; specs/0031 \"The CHANGELOG (P1)\", M4 part 2 P1's run log's checks carried; changes NTB and NTY)"
    CLCHECK=$SELF_DIR/changelog_check.py
    P1CHECKS=$SELF_DIR/p1_checks.sh
    git show "$C:records/logs/m4p2-p1/run.log" >"$B/m4p2p1-run.log"
    # want_hash_of <file name as a pattern>: the hash M4 part 2 P1's committed
    # run log printed for the program beside its script, one line expected.
    want_hash_of() { LC_ALL=C "$G" -E "^command: sha256sum <scripts>/$1[^:]*: [0-9a-f]{64}\$" "$B/m4p2p1-run.log" | sed 's/.*: //'; }
    for prog in changelog_check p1_checks; do
      case $prog in changelog_check) f=$CLCHECK; pat='changelog_check[.]py' ;; *) f=$P1CHECKS; pat='p1_checks[.]sh' ;; esac
      want=$(want_hash_of "$pat")
      echo "command: sha256sum <scripts>/$(basename "$f"): $(sha_of "$f"); git show <phase commit>:records/logs/m4p2-p1/run.log, its line for the same file: ${want:-none} ($(printf '%s\n' "$want" | count_lines /dev/stdin) lines)"
      prog_is_p1s() { [ "$(printf '%s\n' "$want" | count_lines /dev/stdin)" = 1 ] && [ "$(sha_of "$f")" = "$want" ]; }
      check "<scripts>/$(basename "$f") is M4 part 2 P1's, byte for byte by the sha256 its committed run log printed" "$(yn prog_is_p1s)"
    done
    prog_ctl() { [ "$(sha_of "$P1CHECKS")" = "$(want_hash_of 'changelog_check[.]py')" ]; }
    check "control: the same comparison refuses the shared checks' hash against the CHANGELOG check's line" "$(ynnot prog_ctl)"
    sed 's/^/    /' "$CLCHECK"
    echo "command: . <scripts>/p1_checks.sh (its p1_bullets and p1_width_ok used below)"
    sed 's/^/    /' "$P1CHECKS"
    . "$P1CHECKS"
    p1_fns() { declare -F p1_bullets >/dev/null && declare -F p1_width_ok >/dev/null; }
    check "the shared checks' p1_bullets and p1_width_ok are defined after sourcing" "$(yn p1_fns)"
    p1_fns_ctl() { declare -F p1_no_such_function >/dev/null; }
    check "control: the same test refuses a function the file does not define" "$(ynnot p1_fns_ctl)"
    git show "$C:CHANGELOG.md" >"$B/CHANGELOG.md"
    git show "$REC:CHANGELOG.md" >"$B/CHANGELOG-base.md"
    git ls-tree -r --name-only "$C" >"$B/tree.txt"
    CL=$B/CHANGELOG.md
    echo "command: git show <phase commit>:CHANGELOG.md, <base>:CHANGELOG.md; git ls-tree -r --name-only <phase commit>"
    echo "  at the phase commit: $(wc -c <"$CL") bytes, $(count_lines "$CL") lines, sha256 $(sha_of "$CL"); at the base: $(wc -c <"$B/CHANGELOG-base.md") bytes, sha256 $(sha_of "$B/CHANGELOG-base.md"); the tree: $(count_lines "$B/tree.txt") paths"
    echo "command: git diff --numstat <base> <phase commit> -- CHANGELOG.md"
    cl_numstat=$(git diff --numstat "$REC" "$C" -- CHANGELOG.md | cut -f1,2)
    echo "  $cl_numstat"
    check "the CHANGELOG gains four lines from the base and loses none" "$(yn [ "$cl_numstat" = "4${TAB}0" ])"
    echo "command: git diff --quiet <the CHANGELOG commit> <phase commit> -- CHANGELOG.md (change NUA)"
    check "the phase commit's CHANGELOG is the CHANGELOG commit's, the tests commit leaving it as written (change NUA)" "$(yn git diff --quiet "$CODE" "$C" -- CHANGELOG.md)"
    check "control: the same comparison finds the base's CHANGELOG different (change NUA)" "$(ynnot git diff --quiet "$REC" "$C" -- CHANGELOG.md)"
    echo "command: python3 -I -B <scripts>/changelog_check.py <work>/CHANGELOG.md <work>/tree.txt"
    python3 -I -B "$CLCHECK" "$CL" "$B/tree.txt" >"$B/cc.out" 2>"$B/cc.err" </dev/null
    cc=$?
    echo "  exit: $cc; standard error $(wc -c <"$B/cc.err") bytes; standard output:"
    sed 's/^/    /' "$B/cc.out"
    summary_is() { tail -n 1 "$1" | LC_ALL=C "$G" -qE "^sentences [0-9]+ with-digit [0-9]+ cited [0-9]+ $2\$"; }
    cc_ok() { [ "$cc" = 0 ] && summary_is "$B/cc.out" 'uncited 0 missing 0' && [ ! -s "$B/cc.err" ]; }
    check "CHANGELOG.md: every sentence holding a digit cites a records/ or specs/ path the phase commit's tree holds, the release heading exempt: exit 0, uncited 0 missing 0, standard error empty" "$(yn cc_ok)"
    cl_digit=$(tail -n 1 "$B/cc.out" | awk '{print $4}')
    cl_cited=$(tail -n 1 "$B/cc.out" | awk '{print $6}')
    cl_all_cited() { [ -n "$cl_digit" ] && [ "$cl_digit" -gt 0 ] && [ "$cl_digit" = "$cl_cited" ]; }
    check "CHANGELOG.md: the sentences holding a digit ($cl_digit) are more than none and all cited ($cl_cited)" "$(yn cl_all_cited)"
    n_exempt=$(count_matches -E '^exempt unit [0-9]+$' "$B/cc.out")
    check "CHANGELOG.md: exactly one unit exempt, the release heading ($n_exempt)" "$(yn [ "$n_exempt" = 1 ])"
    cp "$CL" "$B/planted-changelog.md"
    printf -- '- Planted: the sample ran 99 times over the corpus.\n' >>"$B/planted-changelog.md"
    python3 -I -B "$CLCHECK" "$B/planted-changelog.md" "$B/tree.txt" >"$B/ccp.out" 2>"$B/ccp.err" </dev/null
    ccp=$?
    echo "command (control): the same over a copy with the bullet \"- Planted: the sample ran 99 times over the corpus.\" appended: exit $ccp; $(tail -n 1 "$B/ccp.out")"
    ccp_ok() { [ "$ccp" = 1 ] && summary_is "$B/ccp.out" 'uncited 1 missing 0'; }
    check "control: the CHANGELOG check refuses the planted uncited sentence" "$(yn ccp_ok)"
    sed 's#specs/0033-read-breadth-survey[.]md#specs/0033-no-such-spec.md#' "$CL" >"$B/c-missing.md"
    python3 -I -B "$CLCHECK" "$B/c-missing.md" "$B/tree.txt" >"$B/ccm.out" 2>"$B/ccm.err" </dev/null
    ccm=$?
    echo "command (control): the same over a copy whose new citation names specs/0033-no-such-spec.md: exit $ccm; $(tail -n 1 "$B/ccm.out")"
    check "control: that copy differs from the CHANGELOG (cmp)" "$(ynnot cmp -s "$CL" "$B/c-missing.md")"
    ccm_ok() { [ "$ccm" = 1 ] && summary_is "$B/ccm.out" 'uncited 0 missing 1'; }
    check "control: the CHANGELOG check finds the copy's citation missing from the tree" "$(yn ccm_ok)"
    DASH=$(printf '\342\200\224')
    n_dash=$(count_matches -F "$DASH" "$CL")
    n_na=$(count_matches -P '[^\x00-\x7F]' "$CL")
    n_ctl=$(LC_ALL=C tr -cd '\000-\011\013-\037\177' <"$CL" | wc -c)
    max_w=$(LC_ALL=C awk 'length($0) > m { m = length($0) } END { print m + 0 }' "$CL")
    echo "command: count_matches -F <the bytes E2 80 94>, count_matches -P '[^\\x00-\\x7F]', tr -cd <every control byte but line feed> | wc -c, the longest line: $n_dash, $n_na, $n_ctl, $max_w columns"
    check "the CHANGELOG holds no U+2014" "$(yn [ "$n_dash" = 0 ])"
    check "the CHANGELOG is ASCII, so UTF-8" "$(yn [ "$n_na" = 0 ])"
    check "the CHANGELOG holds no control byte other than line feed" "$(yn [ "$n_ctl" = 0 ])"
    check "every line of the CHANGELOG is at most 80 columns" "$(yn p1_width_ok "$CL" 80)"
    printf 'a %s b\ncaf\303\251\na\tb\033c\n' "$DASH" >"$B/c-form"
    form_ctl() { [ "$(count_matches -F "$DASH" "$B/c-form")" = 1 ] && [ "$(count_matches -P '[^\x00-\x7F]' "$B/c-form")" = 2 ] && [ "$(LC_ALL=C tr -cd '\000-\011\013-\037\177' <"$B/c-form" | wc -c)" = 2 ]; }
    check "control: the same three counts find a planted U+2014, two lines with non-ASCII bytes and a tab and an ESC" "$(yn form_ctl)"
    cp "$CL" "$B/c-wide"
    printf '%081d\n' 0 >>"$B/c-wide"
    check "control: p1_width_ok refuses a copy with one line of 81 columns appended" "$(ynnot p1_width_ok "$B/c-wide" 80)"
    n_h12=$(count_matches -E '^#{1,2} ' "$CL")
    n_top=$(count_matches -xF '# Changelog' "$CL")
    n_rel=$(count_matches -xF '## 0.1.0 (unreleased)' "$CL")
    subs=$(LC_ALL=C "$G" -E '^### ' "$CL" | sed 's/^### //' | paste -s -d '|')
    echo "command: count_matches -E '^#{1,2} ' -> $n_h12; -xF '# Changelog' -> $n_top; -xF '## 0.1.0 (unreleased)' -> $n_rel; the '### ' headings joined by | -> $subs"
    heads_ok() { [ "$n_h12" = 2 ] && [ "$n_top" = 1 ] && [ "$n_rel" = 1 ] && [ "$subs" = 'Added|Changed|Measured|Not supported by design' ]; }
    check "one top heading, one release heading, and the four subsections in order, as M4 part 2 P1 left them" "$(yn heads_ok)"
    echo "command: p1_bullets <CHANGELOG> <section> for each section, at the phase commit and at the base"
    n_sec_same=0
    for sec in Changed Measured 'Not supported by design'; do
      p1_bullets "$CL" "$sec" "$B/now-sec"
      p1_bullets "$B/CHANGELOG-base.md" "$sec" "$B/base-sec"
      echo "  $sec: bullets $(count_lines "$B/now-sec") now, $(count_lines "$B/base-sec") at the base"
      if [ "$(count_lines "$B/now-sec")" -ge 1 ] && cmp -s "$B/now-sec" "$B/base-sec"; then n_sec_same=$((n_sec_same + 1)); fi
    done
    check "the Changed, Measured and Not supported by design bullets are the base's, unchanged (3 of 3: $n_sec_same)" "$(yn [ "$n_sec_same" = 3 ])"
    p1_bullets "$CL" Added "$B/added"
    rc_added=$?
    p1_bullets "$B/CHANGELOG-base.md" Added "$B/added-base"
    n_added=$(count_lines "$B/added")
    n_added_base=$(count_lines "$B/added-base")
    echo "  Added: exit $rc_added; bullets $n_added now, $n_added_base at the base"
    head -n "$n_added_base" "$B/added" >"$B/added-head"
    tail -n 1 "$B/added" >"$B/added-new"
    NEW_SPECS=$(LC_ALL=C "$G" -o -E 'specs/[0-9]{4}-[a-z0-9-]+[.]md' "$B/added-new" | paste -s -d ' ')
    echo "  the new bullet's spec paths: ${NEW_SPECS:-none}; it names the feature \`read\`: $(count_matches -F '`read`' "$B/added-new") times"
    added_ok() { [ "$rc_added" = 0 ] && [ "$n_added" = "$((n_added_base + 1))" ] && cmp -s "$B/added-head" "$B/added-base"; }
    check "the Added section is the base's bullets, unchanged and in order, with one bullet after them" "$(yn added_ok)"
    new_bullet_ok() { [ "$NEW_SPECS" = specs/0033-read-breadth-survey.md ] && [ "$(count_matches -F '`read`' "$B/added-new")" = 1 ]; }
    check "the new bullet cites specs/0033-read-breadth-survey.md alone and names the feature read (specs/0033 \"P3\"; change NTY)" "$(yn new_bullet_ok)"
    head -n -1 "$B/added" >"$B/c-added"
    added_ctl() { local n_added; n_added=$(count_lines "$B/c-added"); [ "$n_added" = "$((n_added_base + 1))" ]; }
    check "control: the same count refuses the Added bullets with the new one dropped" "$(ynnot added_ctl)"
    echo
    if [ "$RUN_SKIP_KEEP" = yes ]; then
    echo "## the keep and the open check: SKIPPED (RUN_SKIP_KEEP=yes, a dry run)"
    else
    echo "## the host keep regenerated (change NSF: M3 part 7 P5's form, one cargo test; carried)"
    mkdir "$KEEP" || exit 2
    echo "command: EMEND_KEEP_DIR=<keep> cargo test --workspace (host; CARGO_TARGET_DIR=<target>/main)"
    EMEND_KEEP_DIR=$KEEP cargo test --workspace >"$B/keep.out" 2>&1 </dev/null
    rc=$?
    echo "  exit: $rc"
    LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$B/keep.out" | sed 's/^ */    /'
    failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    echo "  passed $passed; failed $failed"
    check "the tests with the keep set exit 0" "$(yn [ "$rc" = 0 ])"
    check "no test failed" "$(yn [ "$failed" = 0 ])"
    echo "  files in the keep: $(find "$KEEP" -type f | wc -l); entries that are not regular files: $(find "$KEEP" -mindepth 1 ! -type f | wc -l)"
    (cd "$KEEP" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/host.files"
    nfiles=$(count_lines "$B/host.files")
    n_in=$(count_matches -E '\.in\.xlsx$' "$B/host.files")
    n_out=$(count_matches -E '\.out\.xlsx$' "$B/host.files")
    n_other=$(count_matches -vE '^[A-Za-z0-9_.-]+\.[0-9]+\.(in|out)\.xlsx$' "$B/host.files")
    LC_ALL=C sed -nE 's/^(.*)\.in\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.names"
    LC_ALL=C sed -nE 's/^(.*)\.out\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.out.names"
    echo "  .in.xlsx $n_in; .out.xlsx $n_out; names not of the form <test>.<n>.in|out.xlsx: $n_other"
    all_pairs() { [ "$n_in" = "$n_out" ] && [ "$((n_in * 2))" = "$nfiles" ] && [ "$n_other" = 0 ] && cmp -s "$B/pair.names" "$B/pair.out.names"; }
    check "the keep holds only whole pairs named <test>.<n>" "$(yn all_pairs)"
    NPAIRS=$n_in
    (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/keep.listing"
    echo "  the host keep's listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/keep.listing"); files $(count_lines "$B/keep.listing"); listing sha256 $(sha_of "$B/keep.listing")"
    check "the host keep's pairs times two equals its files (keep_pairs_ok)" "$(yn keep_pairs_ok "$B/keep.listing")"
    
    echo
    echo "## the host keep against M5 part 2 P2's committed open-check record, named by its record commit (change NTZ)"
    PREV_TXT=$(git show --name-only --format= "$PREV_OPEN_REC" | LC_ALL=C "$G" -E '^records/[a-z0-9]+-open-.*[.]txt$')
    echo "command: git show --name-only --format= <M5 part 2 P2's record commit>, the open-check .txt it added; git show <phase commit>:<it>"
    echo "  the record: $PREV_TXT (sha256 $(git show "$C:$PREV_TXT" | sha256sum | cut -d' ' -f1))"
    check "the named record commit added exactly one open-check .txt" "$(yn [ "$(printf '%s\n' "$PREV_TXT" | count_lines /dev/stdin)" = 1 ])"
    no_later_open() { [ -z "$(git log --format=%H "$PREV_OPEN_REC..$C" -- 'records/*-open-*.txt')" ]; }
    check "no commit after it adds an open-check record, so it is the last committed" "$(yn no_later_open)"
    git show "$C:$PREV_TXT" >"$B/prev.txt"
    while IFS= read -r t; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$t" "$(stat -c %s "$KEEP/$t.in.xlsx")" "$(sha_of "$KEEP/$t.in.xlsx")" \
        "$(stat -c %s "$KEEP/$t.out.xlsx")" "$(sha_of "$KEEP/$t.out.xlsx")"
    done <"$B/pair.names" >"$B/keep.rows"
    tail -n +2 "$B/prev.txt" | cut -f1-5 | LC_ALL=C sort >"$B/prev.rows"
    LC_ALL=C sort "$B/keep.rows" >"$B/keep.sorted"
    n_prev=$(count_lines "$B/prev.rows")
    n_kept_prev=$(LC_ALL=C comm -12 "$B/prev.rows" "$B/keep.sorted" | count_lines /dev/stdin)
    cut -f1 "$B/prev.rows" >"$B/prev.names"
    LC_ALL=C comm -13 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/gone.pairs"
    echo "  rows: the regenerated keep $(count_lines "$B/keep.rows"), the record $n_prev; its rows found in the keep with the same name, bytes and both sha256s: $n_kept_prev"
    echo "  pairs in the keep and not in the record: $(count_lines "$B/new.pairs"); in the record and not in the keep: $(count_lines "$B/gone.pairs")"
    sed 's/^/    new: /' "$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.rows" "$B/keep.sorted" | cut -f1 >"$B/changed.pairs"
    echo "  pairs of the record whose bytes differ in the keep: $(count_lines "$B/changed.pairs")"
    sed 's/^/    changed: /' "$B/changed.pairs"
    check "no pair of the record is gone" "$(yn [ "$(count_lines "$B/gone.pairs")" = 0 ])"
    check "every pair of the record is in the keep, unchanged or changed ($n_kept_prev + $(count_lines "$B/changed.pairs") = $n_prev)" "$(yn [ "$((n_kept_prev + $(count_lines "$B/changed.pairs")))" = "$n_prev" ])"
    check "exactly one pair is new, the extlink-sample tool test's: emend-copy.the_extlink_sample_counts_and_digests_every_link_and_writes_the_input_back_unedited.1 (change NTZ)" "$(yn [ "$(cat "$B/new.pairs")" = emend-copy.the_extlink_sample_counts_and_digests_every_link_and_writes_the_input_back_unedited.1 ])"
    new_ctl() { printf '%s\n%s\n' emend-copy.the_extlink_sample_counts_and_digests_every_link_and_writes_the_input_back_unedited.1 other.1 >"$B/c-new.pairs"; [ "$(cat "$B/c-new.pairs")" = emend-copy.the_extlink_sample_counts_and_digests_every_link_and_writes_the_input_back_unedited.1 ]; }
    check "control: the same comparison refuses a second new pair" "$(ynnot new_ctl)"
    check "no pair of the record changed its bytes (FACTS.md; change NTZ)" "$(yn [ "$(count_lines "$B/changed.pairs")" = 0 ])"
    echo "command: the #[test] functions added or whose body is edited since the named record commit, and those of a .rs file whose text outside its tests differs, from the two commits' sources of every .rs file git diff --name-only <named record commit> <phase commit> names: <work>/edited.py, below (change NSG)"
    cat >"$B/edited.py" <<'PY'
    """The #[test] functions whose body differs between two commits, or that
    the second adds: each file's text at both commits (git show), every
    function after a #[test] attribute (other attributes allowed between), its
    body from the fn line to the first line that is a lone closing brace in
    column one. Prints one test name per line; with a third argument
    --fixtures, instead every test whose body names an item (const,
    static, fn, struct, enum, type or mod at column one) whose lines
    outside the test bodies differ between the two commits (change
    NSG)."""
    import collections
    import re
    import subprocess
    import sys
    
    base, head = sys.argv[1:3]
    TEST = re.compile(r"#\[test\]\s*(?:#\[[^\]]*\]\s*)*fn\s+([A-Za-z0-9_]+)")
    
    
    def show(rev, path):
        run = subprocess.run(["git", "show", "%s:%s" % (rev, path)], capture_output=True)
        return run.stdout.decode() if run.returncode == 0 else ""
    
    
    def tests(text):
        out = {}
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            out[m.group(1)] = text[m.start():end if end >= 0 else len(text)]
        return out
    
    
    names = subprocess.run(["git", "diff", "--name-only", base, head, "--", "*.rs"],
                           capture_output=True, check=True).stdout.decode().split()
    ITEM = re.compile(r"^(?:pub(?:\([^)]*\))?\s+)?(?:const|static|fn|struct|enum|type|mod)\s+([A-Za-z_][A-Za-z0-9_]*)")
    
    
    def outside(text):
        out, at = [], 0
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            end = len(text) if end < 0 else end + 3
            if m.start() >= at:
                out.append(text[at:m.start()])
                at = end
        out.append(text[at:])
        return "".join(out)
    
    
    def changed_items(before_text, after_text):
        found = set()
        for text, other in ((after_text, before_text), (before_text, after_text)):
            others = collections.Counter(outside(other).split("\n"))
            current = None
            for line in outside(text).split("\n"):
                m = ITEM.match(line)
                if m:
                    current = m.group(1)
                if others[line] > 0:
                    others[line] -= 1
                elif current is not None:
                    found.add(current)
        return found
    
    
    edited = set()
    fixture = set()
    for path in names:
        before_text, after_text = show(base, path), show(head, path)
        before, after = tests(before_text), tests(after_text)
        for name, body in after.items():
            if before.get(name) != body:
                edited.add(name)
        items = changed_items(before_text, after_text)
        for name, body in after.items():
            if any(re.search(r"\b%s\b" % re.escape(i), body) for i in items):
                fixture.add(name)
    for name in sorted(fixture if sys.argv[3:] == ["--fixtures"] else edited):
        print(name)
    PY
    sed 's/^/    /' "$B/edited.py"
    python3 -I -B "$B/edited.py" "$PREV_OPEN_REC" "$C" | LC_ALL=C sort >"$B/edited.tests"
    python3 -I -B "$B/edited.py" "$PREV_OPEN_REC" "$C" --fixtures | LC_ALL=C sort >"$B/fixture.tests"
    LC_ALL=C sort -u "$B/edited.tests" "$B/fixture.tests" >"$B/touched.tests"
    sed 's/^/    added or edited test: /' "$B/edited.tests"
    sed 's/^/    test of a file whose text outside its tests differs: /' "$B/fixture.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/new.pairs" | LC_ALL=C sort -u >"$B/new.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/changed.pairs" | LC_ALL=C sort -u >"$B/changed.tests"
    echo "  tests with a new pair: $(count_lines "$B/new.tests"); tests with a changed pair: $(count_lines "$B/changed.tests"); tests added or edited: $(count_lines "$B/edited.tests"); tests of a file whose text outside its tests differs: $(count_lines "$B/fixture.tests")"
    check "some test is added or edited, so the list was read" "$(yn [ "$(count_lines "$B/edited.tests")" -ge 1 ])"
    echo "command: git diff --name-only <the CHANGELOG commit> <phase commit> (change NUA)"
    git diff --name-only "$CODE" "$C" | sed 's/^/    /'
    tests_commit_only() { [ "$(git diff --name-only "$1" "$C")" = crates/emend/src/package/tests/extlink.rs ]; }
    echo "  the tests commit edits crate unit tests alone, which write no keep pair; the keep's pairs are the tool tests', so the new pair is still the tool's one (change NUA)"
    check "the tests commit changes crates/emend/src/package/tests/extlink.rs alone (change NUA)" "$(yn tests_commit_only "$CODE")"
    check "control: the same check refuses the probe commit's range, which holds more (change NUA)" "$(ynnot tests_commit_only "$PROBE")"
    new_from_edited() { [ "$(LC_ALL=C comm -23 "$B/new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every new pair is kept by a test added or edited since the record" "$(yn new_from_edited)"
    changed_from_touched() { [ "$(LC_ALL=C comm -23 "$B/changed.tests" "$B/touched.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every changed pair of the record is kept by a test edited since it, or of a file whose fixtures or helpers changed (change NSG)" "$(yn changed_from_touched)"
    printf 'zzz_not_an_edited_test\n' | LC_ALL=C sort -m - "$B/new.tests" >"$B/c-new.tests"
    new_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a pair of a test not added or edited" "$(yn new_ctl)"
    printf 'zzz_not_a_touched_test\n' | LC_ALL=C sort -m - "$B/changed.tests" >"$B/c-changed.tests"
    touched_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-changed.tests" "$B/touched.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a changed pair of a test neither edited nor of a changed file" "$(yn touched_ctl)"
    
    echo
    echo "## scripts/edit-open-check.sh on the host keep (specs/0018 \"Harness runs\": every phase's run log runs it over its keep)"
    mkdir "$B/tmp"
    # The open check's own TMPDIR, its device beside the runs' and the corpus
    # directory's.
    dev_open=$(stat -c %d "$B/tmp")
    echo "command: stat -c %d <work>/tmp <work>/tmp-run <corpus>/corpus /proc"
    echo "  device of the open check's TMPDIR (<work>/tmp): $dev_open; of the runs' TMPDIR (<work>/tmp-run): $(stat -c %d "$RUNTMP"); of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    check "the open check's TMPDIR and the corpus directory are on one device" "$(yn [ "$dev_open" = "$dev_corpus" ])"
    check "control: the same comparison tells /proc's device from the open check's TMPDIR's" "$(yn [ "$dev_proc" != "$dev_open" ])"
    echo "command: TMPDIR=<work>/tmp scripts/edit-open-check.sh --keep <keep> --libreoffice $IMAGE --out <scripts>/out/records --stem $STEM_OPEN"
    TMPDIR=$B/tmp scripts/edit-open-check.sh --keep "$KEEP" --libreoffice "$IMAGE" --out "$RECORDS" --stem "$STEM_OPEN" \
      >"$B/oc.stdout" 2>"$B/oc.stderr" </dev/null
    oc_rc=$?
    echo "  exit: $oc_rc"
    echo "  stdout:"; sed 's/^/    /' "$B/oc.stdout"
    echo "  stderr bytes: $(wc -c <"$B/oc.stderr")"
    check "the script exits 0 (no finding, no check errored)" "$(yn [ "$oc_rc" = 0 ])"
    check "its stderr is empty" "$(yn [ ! -s "$B/oc.stderr" ])"
    echo "  the reasons the script kept (its reasons directory under <work>/tmp), one line per refused side:"
    find "$B/tmp" -name '*-reason.txt' | LC_ALL=C sort | while IFS= read -r f; do echo "    ${f#"$B/tmp/"}: $(cat "$f")"; done
    TXT=$RECORDS/$STEM_OPEN.txt
    MD=$RECORDS/$STEM_OPEN.md
    TXT_HEADER=$(git show "$C:scripts/edit-open-check.sh" | sed -n "s/^readonly TXT_HEADER=\\$'\\(.*\\)'\$/\\1/p" | sed 's/\\t/\t/g')
    check "the .txt's header is the script's TXT_HEADER, read from the phase commit (nine columns)" "$(yn [ "$(head -n 1 "$TXT")" = "$TXT_HEADER" ])"
    tail -n +2 "$TXT" | cut -f1-5 >"$B/txt.rows"
    nrow_same=$(paste -d'\n' "$B/keep.rows" "$B/txt.rows" | awk 'NR % 2 == 1 { a = $0; next } a == $0 { n++ } END { print n + 0 }')
    echo "  rows: the keep $(count_lines "$B/keep.rows"), the .txt $(count_lines "$B/txt.rows"); rows whose name, bytes and hashes are the keep's, compared row by row: $nrow_same"
    rows_same() { [ "$(count_lines "$B/keep.rows")" = "$(count_lines "$B/txt.rows")" ] && [ "$nrow_same" = "$(count_lines "$B/keep.rows")" ] && [ "$nrow_same" = "$NPAIRS" ]; }
    check "every .txt row is one kept pair's name, byte counts and sha256s, in name order, one row per pair" "$(yn rows_same)"
    bad_rows=$(tail -n +2 "$TXT" | awk -F'\t' 'NF != 9 || $6 !~ /^(ok|fail|error)$/ || $7 !~ /^(ok|fail|error)$/ || $8 !~ /^(none|refused|count|error)$/ || $9 !~ /^(none|refused|count|error)$/' | wc -l)
    check "every row has nine columns, lo_in and lo each ok, fail or error, and each class none, refused, count or error ($bad_rows rows otherwise)" "$(yn [ "$bad_rows" = 0 ])"
    bad_fit=$(tail -n +2 "$TXT" | awk -F'\t' '{ print $6 ":" $8; print $7 ":" $9 }' | LC_ALL=C "$G" -cvxE 'ok:none|fail:refused|fail:count|error:error')
    check "every side's class fits its verdict ($bad_fit sides otherwise)" "$(yn [ "$bad_fit" = 0 ])"
    stdout_rows() { [ "$(awk -F'\t' 'NF == 3' "$B/oc.stdout")" = "$(tail -n +2 "$TXT" | cut -f1,6,7)" ]; }
    check "the script's per-pair stdout lines are the .txt's test, lo_in and lo columns" "$(yn stdout_rows)"
    echo "command: python3 -I -B <work>/wb.py over each kept input: its xl/workbook.xml entry, its sheet elements by local name (expat, no pattern) and of them those with a prefix"
    cat >"$B/wb.py" <<'PY'
    import sys, zipfile
    from xml.parsers import expat
    for path in sys.argv[1:]:
        name = path.rsplit("/", 1)[1][: -len(".in.xlsx")]
        try:
            z = zipfile.ZipFile(path)
        except zipfile.BadZipFile:
            print("%s\tunreadable\t-\t-" % name)
            continue
        if "xl/workbook.xml" not in z.namelist():
            print("%s\tno\t-\t-" % name)
            continue
        found = {"all": 0, "prefixed": 0}
    
        def start(tag, attrs):
            prefix, _, local = tag.rpartition(":")
            if local == "sheet":
                found["all"] += 1
                found["prefixed"] += 1 if prefix else 0
        p = expat.ParserCreate()
        p.StartElementHandler = start
        try:
            p.Parse(z.read("xl/workbook.xml"), True)
        except expat.ExpatError:
            print("%s\tyes\tunparsed\t-" % name)
            continue
        print("%s\tyes\t%d\t%d" % (name, found["all"], found["prefixed"]))
    PY
    sed 's/^/    /' "$B/wb.py"
    python3 -I -B "$B/wb.py" $(sed "s#^#$KEEP/#; s#\$#.in.xlsx#" "$B/pair.names") | LC_ALL=C sort >"$B/wb.all"
    echo "  kept inputs by workbook entry and sheet elements (entry, all, prefixed: pairs):"
    cut -f2- "$B/wb.all" | sort | uniq -c | sed 's/^/    /'
    echo "  the .md checked against the .txt and the kept inputs, with the heading specs/0015 P2 verification ruling 1 gives: <work>/mdcheck.py, below"
    cat >"$B/mdcheck.py" <<'PY'
    import sys
    txt, md, wb = sys.argv[1:4]
    rows = [l.split("\t") for l in open(txt).read().split("\n")[1:] if l]
    sheets = {l.split("\t")[0]: l.split("\t")[2] for l in open(wb).read().split("\n") if l}
    text = open(md).read().split("\n")
    REFUSED = ("Inputs refused by LibreOffice (allowed: a fixture LibreOffice cannot load: zip-level,"
               " or a package with no relationships part or an empty content-types root)")
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line:
                out.append(line)
        return out
    
    
    def listed(names):
        return ["- `%s`" % n for n in names] if names else ["None."]
    
    
    def count(col, v):
        return sum(1 for r in rows if r[col] == v)
    
    
    totals = [len(rows)] + [count(5, v) for v in ("ok", "fail", "error")] + [count(6, v) for v in ("ok", "fail", "error")]
    classes = ["| %s | " % side + " | ".join(str(count(col, c)) for c in ("none", "refused", "count", "error")) + " |"
               for side, col in (("reason_in", 7), ("reason_out", 8))]
    tot = section("Totals")
    checks = [
        ("Totals", tot[2:3] == ["| " + " | ".join(str(t) for t in totals) + " |"] and tot[5:] == classes),
        ("the refused-inputs heading reads as ruled, once", text.count("## " + REFUSED) == 1),
        ("Inputs refused by LibreOffice", section(REFUSED) == listed([r[0] for r in rows if r[7] == "refused"])),
        ("the sheet count did not apply", section("Inputs the sheet count did not apply to (allowed: a workbook fixture with no sheet element)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) == "0"])),
        ("counts differ", section("Inputs whose sheet and table counts differ (a finding)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) != "0"])),
        ("Outputs refused on an accepted input", section("Outputs refused on an input LibreOffice accepted (a finding)") == listed([r[0] for r in rows if r[6] == "fail" and r[5] == "ok"])),
        ("Checks that did not run", section("Checks that did not run (error)") == listed([r[0] for r in rows if "error" in (r[5], r[6])])),
        ("Pairs", section("Pairs")[2:] == ["| `%s` | %s | %s | %s | %s | %s | %s | %s | %s |" % tuple(r) for r in rows]),
        ("the Pairs line", ("- Pairs: %d" % len(rows)) in text),
    ]
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("totals: pairs %d; lo_in ok %d fail %d error %d; lo ok %d fail %d error %d" % tuple(totals))
    PY
    sed 's/^/    /' "$B/mdcheck.py"
    python3 -I -B "$B/mdcheck.py" "$TXT" "$MD" "$B/wb.all" >"$B/mdcheck.out"
    sed 's/^/    /' "$B/mdcheck.out"
    md_all() { [ "$(count_matches -E ': yes$' "$B/mdcheck.out")" = 9 ] && [ "$(count_matches -E ': no$' "$B/mdcheck.out")" = 0 ]; }
    check "the .md's nine parts are derived from the .txt and the kept inputs' sheet elements, the heading as ruled" "$(yn md_all)"
    head -n 2 "$TXT" >"$B/c-short.txt"
    python3 -I -B "$B/mdcheck.py" "$B/c-short.txt" "$MD" "$B/wb.all" >"$B/c-mdcheck.out"
    md_ctl() { [ "$(count_matches -E ': no$' "$B/c-mdcheck.out")" -ge 1 ]; }
    check "control: the same check on a .txt cut to one row finds the .md does not match it" "$(yn md_ctl)"
    OLD8=records/m1p8-open-2026-09-24-da080f1
    python3 -I -B "$B/mdcheck.py" "$OLD8.txt" "$OLD8.md" "$B/wb.all" >"$B/c-prevmd.out"
    old_heading() { [ "$(count_matches -F 'the refused-inputs heading reads as ruled, once: no' "$B/c-prevmd.out")" = 1 ]; }
    check "control: the same check on part 8 P2's committed .md finds the old heading, not the ruled one" "$(yn old_heading)"
    totals_line() { [ "$(sed -n 's/^wrote .*\.txt: \(pairs [^;]*; lo_in [^;]*; lo [^;]*\); inputs refused .*/\1/p' "$B/oc.stdout")" = "$(sed -n 's/^totals: //p' "$B/mdcheck.out")" ]; }
    check "the script's totals line is the totals derived from the .txt" "$(yn totals_line)"
    echo
    echo "### the verdicts against the named record"
    join -t "$TAB" <(tail -n +2 "$B/prev.txt" | cut -f1,6,7,8,9 | LC_ALL=C sort) <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) >"$B/both"
    check "every pair of the named record has a row in this record" "$(yn [ "$(count_lines "$B/both")" = "$n_prev" ])"
    awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9 { print $1 "\t" $2 "/" $3 "/" $4 "/" $5 " -> " $6 "/" $7 "/" $8 "/" $9 }' "$B/both" >"$B/moved"
    echo "  the named record's pairs whose lo_in, lo or either class changed: $(count_lines "$B/moved")"
    sed 's/^/    /' "$B/moved"
    check "no verdict and no class of the named record's pairs moved" "$(yn [ "$(count_lines "$B/moved")" = 0 ])"
    printf 'x\tok\tok\tnone\tnone\tok\tfail\tnone\trefused\n' >"$B/c-both"
    moved_ctl() { [ "$(awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9' "$B/c-both" | wc -l)" = 1 ]; }
    check "control: the same form finds a planted row whose lo moved" "$(yn moved_ctl)"
    echo "  the new pairs' verdicts (test, lo_in, lo, reason_in, reason_out):"
    join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) | sed 's/^/    /'
    no_new_finding() { [ "$(join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7 | LC_ALL=C sort) | awk -F'\t' '$2 == "ok" && $3 != "ok"' | wc -l)" = 0 ]; }
    check "no new pair's output is refused on an accepted input" "$(yn no_new_finding)"
    echo
    echo "### acceptance, and the inputs LibreOffice did not accept"
    tail -n +2 "$TXT" | awk -F'\t' -v OFS='\t' '{ print ($1 ~ /^emend-copy\./ ? "tool" : "crate"), $1, $6, $7, $8, $9 }' >"$B/verdicts"
    for side in crate tool; do
      n=$(awk -F'\t' -v s="$side" '$1 == s' "$B/verdicts" | wc -l)
      nfind=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "ok" && $4 == "fail"' "$B/verdicts" | wc -l)
      nerr=$(awk -F'\t' -v s="$side" '$1 == s && ($3 == "error" || $4 == "error")' "$B/verdicts" | wc -l)
      nin=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "fail"' "$B/verdicts" | wc -l)
      echo "  $side: pairs $n; inputs refused $nin; outputs refused on an accepted input $nfind; checks that did not run $nerr"
      check "$side: no output refused on an accepted input" "$(yn [ "$nfind" = 0 ])"
      check "$side: no check errored" "$(yn [ "$nerr" = 0 ])"
    done
    awk -F'\t' '$5 == "count" { print $2 }' "$B/verdicts" >"$B/count.pairs"
    awk -F'\t' '$2 == "yes" && $3 == "0" { print $1 }' "$B/wb.all" >"$B/zero.pairs"
    echo "  count-class inputs $(count_lines "$B/count.pairs"); kept inputs with a workbook entry and no sheet element $(count_lines "$B/zero.pairs")"
    check "the count-class inputs are exactly the kept inputs with a workbook entry and no sheet element, so no count differs" "$(yn cmp -s "$B/count.pairs" "$B/zero.pairs")"
    echo "  the pairs whose input LibreOffice did not accept, with the class of the input's reason:"
    awk -F'\t' '$3 != "ok" { print $2 "\t" $5 }' "$B/verdicts" | sed 's/^/    /'
    echo
    echo "### the open-check record installed into records/"
    echo "command: install -m 644 <scripts>/out/records/$STEM_OPEN.md <scripts>/out/records/$STEM_OPEN.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt")
    echo "  exit: $?"
    for f in "$STEM_OPEN.md" "$STEM_OPEN.txt"; do
      echo "    written <scripts>/out/records/$f: sha256 $(sha_of "$RECORDS/$f"), $(wc -c <"$RECORDS/$f") bytes"
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, byte for byte, mode 644" "$(yn inst_same "$f")"
    done
    fi
    
    echo
    echo "## the record files this run installed hold no path"
    echo "  record files installed by this run: ${#INSTALLED[@]}"
    no_path() {
      local f
      [ "${#INSTALLED[@]}" -ge 1 ] || return 1
      for f in "${INSTALLED[@]}"; do
        [ "$(count_matches -F "$HOME" "$f")" = 0 ] || return 1
        [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$f")" = 0 ] || return 1
      done
    }
    check "no record file this run installed names <home>, a home, mount, temporary or corpus path" "$(yn no_path)"
    n_inst_want=8
    if [ "$RUN_SKIP_KEEP" = yes ]; then n_inst_want=6; fi
    check "this run installed the record files it writes ($n_inst_want: the three release runs' pairs, and the open pair unless the keep was skipped)" "$(yn [ "${#INSTALLED[@]}" = "$n_inst_want" ])"
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x' >"$B/c-path"
    path_ctl() { [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$B/c-path")" = 1 ]; }
    check "control: the same form finds a planted path" "$(yn path_ctl)"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  planning's uncommitted spec: $SPEC, sha256 $(sha_of "$SPEC")"
    echo "status lines: $st_all; of them this phase's logs, its record pairs or planning's uncommitted spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources (the phase commit's, by git show; change NSB)
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

