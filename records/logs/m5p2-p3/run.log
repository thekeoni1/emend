    SPEC_WANT=843740182d319879800f0f08dc46cab1f505eb715ea11ca13c90539de94fc765
    SAMPLE=extlinks
    EDIT=--extlink-sample
    # Change NTX: the three samples run again with the size log's binaries.
    SAMPLES="kinds pivots extlinks"
