    #!/usr/bin/env python3
    """CHANGELOG check (specs/0031-release-metadata.md "The CHANGELOG (P1)"): the
    README check of M3 part 7 P4 (readme_check.py, f87526a3..., unchanged beside
    this file), with the two additions the spec makes for the CHANGELOG alone:
    a path under specs/ that exists in the tree listing counts as a citation,
    as a path under records/ does; and a release heading, a heading unit
    matching "## " then a digit, is exempt (printed "exempt unit <i>", not
    counted as a sentence holding a digit). Everything else is readme_check.py's.
    
    Usage: python3 -I changelog_check.py <CHANGELOG> <paths-at-HEAD.txt>
      <paths-at-HEAD.txt>: `git ls-tree -r --name-only HEAD`, one path per line.
    
    Units: a fenced code block is one unit; outside fences, a heading line, a
    list item (a line starting "- " with its continuation lines) and a paragraph
    (lines up to a blank line) are units, and a prose unit is split into
    sentences after ".", "!" or "?" followed by white space. Prints one line per
    sentence holding a digit: "cited <n> <unit-index>" or "UNCITED <unit-index>"
    or, for an exempt heading, "exempt <unit-index>"
    or "MISSING <path>", never the sentence's text, then a summary line
    "sentences <s> with-digit <d> cited <c> uncited <u> missing <m>". Exit 0 when
    uncited and missing are both 0, 1 otherwise, 2 on a usage or read error."""
    import re, sys
    
    def units(lines):
        out, cur, fence = [], [], False
        def flush():
            if cur:
                out.append((" ".join(x.strip() for x in cur), False))
                cur.clear()
        for ln in lines:
            if ln.startswith("```"):
                if fence:
                    cur.append(ln); out.append(("\n".join(cur), True)); cur.clear(); fence = False
                else:
                    flush(); cur.append(ln); fence = True
                continue
            if fence:
                cur.append(ln); continue
            if not ln.strip():
                flush(); continue
            if ln.startswith("#") or ln.startswith("- "):
                flush(); cur.append(ln)
                if ln.startswith("#"):
                    flush()
                continue
            cur.append(ln)
        if fence:
            sys.exit("error: an unclosed code fence")
        flush()
        return out
    
    def main():
        if len(sys.argv) != 3:
            print("usage: changelog_check.py <CHANGELOG> <paths-at-HEAD.txt>", file=sys.stderr); sys.exit(2)
        try:
            lines = open(sys.argv[1], encoding="utf-8").read().split("\n")
            tree = set(open(sys.argv[2], encoding="utf-8").read().split("\n"))
        except (OSError, UnicodeDecodeError) as e:
            print("error: %s" % type(e).__name__, file=sys.stderr); sys.exit(2)
        s = d = c = u = m = 0
        for i, (text, code) in enumerate(units(lines), 1):
            if not code and re.match(r"## [0-9]", text):
                s += 1; print("exempt unit %d" % i); continue
            sents = [text] if code else [x for x in re.split(r"(?<=[.!?])\s+", text) if x]
            for sent in sents:
                s += 1
                if not re.search(r"[0-9]", sent):
                    continue
                d += 1
                paths = re.findall(r"(?:records|specs)/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]", sent)
                if not paths:
                    u += 1; print("UNCITED unit %d" % i); continue
                bad = [p for p in paths if p not in tree]
                for p in bad:
                    m += 1; print("MISSING %s" % p)
                if not bad:
                    c += 1; print("cited %d unit %d" % (len(paths), i))
        print("sentences %d with-digit %d cited %d uncited %d missing %d" % (s, d, c, u, m))
        sys.exit(0 if u == 0 and m == 0 else 1)
    
    main()
command: . <scripts>/p1_checks.sh (its p1_bullets and p1_width_ok used below)
    # M4 part 2 P1's shared checks (specs/0031-release-metadata.md "The CHANGELOG
    # (P1)", "The crate-level doc comment (decision 3)" and "Planning rulings
    # during P1", rulings 1 and 2), sourced by the phase's run log and negative
    # log, each of which prints this file and its sha256. Every function prints
    # nothing on standard output: an extractor writes the file it is given, a
    # predicate returns its status (specs/0001: a helper used as a check
    # condition prints nothing). Joins follow readme_check.py's units(): each
    # line stripped of leading and trailing white space, the lines joined by one
    # space. Byte comparisons run under LC_ALL=C.
    
    # p1_bullets <file> <heading> <out>: the bullets of the section opened by
    # the line "### <heading>", up to the next line starting with "#", one per
    # line in <out>: the "- " dropped and the continuation lines joined. Returns
    # 1 when the section holds a non-blank line that neither starts a bullet nor
    # continues one (a continuation line starts with white space).
    p1_bullets() {
      LC_ALL=C awk -v h="### $2" '
        function strip(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
        function flush() { if (have) print cur; have = 0; cur = "" }
        $0 == h { on = 1; next }
        on && /^#/ { flush(); on = 0; next }
        !on { next }
        /^- / { flush(); cur = strip(substr($0, 3)); have = 1; next }
        /^[ \t]*$/ { flush(); next }
        have && /^[ \t]/ { cur = cur " " strip($0); next }
        { bad = 1 }
        END { flush(); exit bad ? 1 : 0 }' "$1" >"$3"
    }
    
    # p1_readme_measured <README> <out>: the paragraphs of the README's section
    # "## What has been measured", up to the next line starting with "#", each
    # joined onto one line, the section's opening sentence ("Each sentence here
    # cites the record that holds its figures.") left out (ruling 2).
    p1_readme_measured() {
      LC_ALL=C awk '
        function strip(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
        function flush() {
          if (have && cur != "Each sentence here cites the record that holds its figures.") print cur
          have = 0; cur = ""
        }
        $0 == "## What has been measured" { on = 1; next }
        on && /^#/ { flush(); on = 0; next }
        !on { next }
        /^[ \t]*$/ { flush(); next }
        { cur = have ? cur " " strip($0) : strip($0); have = 1 }
        END { flush() }' "$1" >"$2"
    }
    
    # p1_measured_equal <CHANGELOG> <README> <dir>: true when the CHANGELOG's
    # "Measured" bullets, joined, are byte for byte the README's five measured
    # paragraphs, joined, in order (ruling 1); writes the files m-cl and m-rd under
    # the directory it is given.
    p1_measured_equal() {
      p1_bullets "$1" Measured "$3/m-cl" || return 1
      p1_readme_measured "$2" "$3/m-rd" || return 1
      [ "$(wc -l <"$3/m-rd")" = 5 ] || return 1
      LC_ALL=C cmp -s "$3/m-cl" "$3/m-rd"
    }
    
    # p1_width_ok <file> <max>: true when no line of <file> is longer than <max>
    # bytes (columns, for an ASCII file; the run log checks the file is ASCII).
    p1_width_ok() {
      LC_ALL=C awk -v m="$2" 'length($0) > m + 0 { bad = 1 } END { exit bad ? 1 : 0 }' "$1"
    }
    
    # p1_doc_lines_only <diff>: true when every line a unified diff adds or
    # removes (a line starting "+" or "-" inside a hunk, after its "@@" line)
    # starts "+//!" or "-//!", and there is at least one such line (decision 3:
    # doc lines only).
    p1_doc_lines_only() {
      LC_ALL=C awk '
        /^diff --git / { hunk = 0; next }
        /^@@ / { hunk = 1; next }
        !hunk { next }
        /^[+-]/ { n++; if ($0 !~ /^[+-]\/\/!/) bad = 1 }
        END { exit (bad || n == 0) ? 1 : 0 }' "$1"
    }
    
    # p1_docblock <lib.rs> <out>: the crate's leading "//!" block, each line with
    # "//!" and one following space removed.
    p1_docblock() {
      LC_ALL=C awk '/^\/\/!/ { s = substr($0, 4); sub(/^ /, "", s); print s; next } { exit }' "$1" >"$2"
    }
    
    # p1_paragraphs <file> <out>: the file's paragraphs, a paragraph being a run
    # of non-blank lines none of which starts with "#", one per line in <out>,
    # joined (a heading line ends a paragraph and belongs to none).
    p1_paragraphs() {
      LC_ALL=C awk '
        function strip(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
        function flush() { if (have) print cur; have = 0; cur = "" }
        /^[ \t]*$/ { flush(); next }
        /^#/ { flush(); next }
        { cur = have ? cur " " strip($0) : strip($0); have = 1 }
        END { flush() }' "$1" >"$2"
    }
