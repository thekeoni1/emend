                            'ContentType="%s.externalLink+xml"/>' % (n, vnd) for n in range(1, typed + 1))
        types = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                 '<Types xmlns="%s">'
                 '<Default Extension="rels" ContentType="%s"/>'
                 '<Default Extension="xml" ContentType="application/xml"/>'
                 '<Override PartName="/xl/workbook.xml" ContentType="%s"/>'
                 '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="%s"/>%s</Types>'
                 % (CT_NS, RELS_TYPE, WORKBOOK_TYPE, SHEET_TYPE, overrides))
        package_rels = ('<Relationships xmlns="%s"><Relationship Id="rId1" Type="%s/officeDocument" '
                        'Target="xl/workbook.xml"/></Relationships>' % (RELS_NS, ATTR))
        refs = "".join('<externalReference r:id="rIdE%d"/>' % n for n in range(1, references + 1))
        workbook = ('<workbook xmlns="%s" xmlns:r="%s"><sheets><sheet name="Sheet1" sheetId="1" '
                    'r:id="rId1"/></sheets><externalReferences>%s</externalReferences></workbook>'
                    % (MAIN_NS[0], ATTR, refs))
        links = "".join('<Relationship Id="rIdE%d" Type="%s/externalLink" '
                        'Target="externalLinks/externalLink%d.xml"/>' % (n, ATTR, n) for n in range(1, 4))
        workbook_rels = ('<Relationships xmlns="%s">'
                         '<Relationship Id="rId1" Type="%s/worksheet" Target="worksheets/sheet1.xml"/>'
                         '<Relationship Id="rId2" Type="%s/styles" Target="styles.xml"/>'
                         '<Relationship Id="rId3" Type="%s/hyperlink" Target="https://example.invalid/x" '
                         'TargetMode="External"/>%s</Relationships>' % (RELS_NS, ATTR, ATTR, ATTR, links))
    
        def link(body):
            return '<externalLink xmlns="%s" xmlns:r="%s">%s</externalLink>' % (MAIN_NS[0], ATTR, body)
    
        def path_rels(kind, target):
            return ('<Relationships xmlns="%s"><Relationship Id="rId1" Type="%s/%s" Target="%s" '
                    'TargetMode="External"/></Relationships>' % (RELS_NS, ATTR, kind, target))
        book = link('<externalBook r:id="rId1"><sheetNames><sheetName val="North"/>'
                    '<sheetName val="South"/></sheetNames><definedNames>'
                    '<definedName name="Rate" refersTo="=North!$A$1"/></definedNames>'
                    '<sheetDataSet><sheetData sheetId="0"><row r="1"><cell r="A1"><v>2</v></cell>'
                    '</row></sheetData></sheetDataSet></externalBook>')
        dde = link('<ddeLink ddeService="Service" ddeTopic="Topic"><ddeItems/></ddeLink>')
        ole = link('<oleLink r:id="rId1" progId="Package"><oleItems/></oleLink>')
        return [
            (CONTENT_TYPES, types.encode()),
            ("_rels/.rels", package_rels.encode()),
            ("xl/workbook.xml", workbook.encode()),
            ("xl/_rels/workbook.xml.rels", workbook_rels.encode()),
            ("xl/worksheets/sheet1.xml", b"<sheetData/>"),
            ("xl/styles.xml", b"<styleSheet/>"),
            ("xl/media/image1.bin", bytes(range(256))),
            ("xl/externalLinks/externalLink1.xml", book.encode()),
            ("xl/externalLinks/_rels/externalLink1.xml.rels",
             path_rels("externalLinkPath", "other.xlsx").encode()),
            ("xl/externalLinks/externalLink2.xml", dde.encode()),
            ("xl/externalLinks/externalLink3.xml", ole.encode()),
            ("xl/externalLinks/_rels/externalLink3.xml.rels",
             path_rels("oleObject", "file:///objects/thing.bin").encode()),
        ]
    
    
    def build(parts):
        buf = io.BytesIO()
        with zipfile.ZipFile(buf, "w") as z:
            for name, data in parts:
                z.writestr(name, data)
        return buf.getvalue()
    
    
    def as_tool(line):
        return "extlinks\t" + "\t".join(line.split(" ")[:len(TOOL_KEYS)])
    
    
    def selftest():
        base = build(fixture_parts())
        line = compare(base, base)
        checks = []
        checks.append(("the fixture's line is the tool test's", as_tool(line) == TOOL_LINE))
        checks.append(("entries_same and ref_rule hold on the fixture against itself",
                       kv(line, "entries_same") == "yes" and kv(line, "ref_rule") == "yes"))
        checks.append(("the fixture's own keys: one reference list, three references and three typed entries",
                       [kv(line, k) for k in CHECK_KEYS] == ["1", "3", "3"]))
        parts = fixture_parts()
        parts[5] = ("xl/styles.xml", b"<styleSheet/> ")
        checks.append(("control: entries_same is no for an output with one entry's bytes changed",
                       kv(compare(base, build(parts)), "entries_same") == "no"))
        checks.append(("control: entries_same is no for an output with one entry dropped",
                       kv(compare(base, build(fixture_parts()[:-1])), "entries_same") == "no"))
        fewer = build(fixture_parts(references=2))
        lf = compare(fewer, fewer)
        checks.append(("control: a workbook referencing two of three typed parts reads two links and breaks ref_rule",
                       kv(lf, "links") == "2" and kv(lf, "ref_rule") == "no"))
        checks.append(("control: the digest of the sheet names is the tool test's, and another order gives another",
                       kv(line, "digest_sheets") == fnv(["North", "South"])
                       and fnv(["South", "North"]) != fnv(["North", "South"])))
        pc = compare(base, base, "count")
        checks.append(("control: the count plant turns links to 4 and is marked planted",
                       kv(pc, "links") == "4" and kv(pc, "planted") == "yes"))
        pr = compare(base, base, "ref_rule")
        checks.append(("control: the ref_rule plant turns ref_rule to no", kv(pr, "ref_rule") == "no"))
        pe = compare(base, base, "entries_same")
        checks.append(("control: the entries_same plant turns entries_same to no", kv(pe, "entries_same") == "no"))
        pd = compare(base, base, "digest")
        checks.append(("control: the digest plant changes digest_targets and nothing else of the tool's keys",
                       kv(pd, "digest_targets") != kv(line, "digest_targets")
                       and [kv(pd, k) for k in COUNT_KEYS] == [kv(line, k) for k in COUNT_KEYS]))
        checks.append(("control: the tool test's line is refused by the same comparison against a line one count off",
                       as_tool(compare(base, base, "count")) != TOOL_LINE))
        assert len(checks) == SELFTEST_LINES
        for name, ok in checks:
            print("%s: %s" % (name, "yes" if ok else "no"))
    
    
    def main(argv):
        if argv == ["--selftest"]:
            selftest()
            return 0
        if len(argv) not in (3, 5) or argv[0] != "extlinks":
            sys.stderr.write(__doc__)
            return 2
        plant = None
        if len(argv) == 5:
            if argv[3] != "--plant":
                sys.stderr.write(__doc__)
                return 2
            plant = argv[4]
            if plant not in FLAGS_OF["extlinks"] + ("count", "digest"):
                print("error=unknown-plant")
                return 0
        with open(argv[1], "rb") as f:
            a = f.read()
        with open(argv[2], "rb") as f:
            b = f.read()
        try:
            print(compare(a, b, plant))
        except Exception as e:  # a part this check cannot read: named by kind, never by content
            print("error=%s" % type(e).__name__)
            return 1
        return 0
    
    
    if __name__ == "__main__":
        sys.exit(main(sys.argv[1:]))
