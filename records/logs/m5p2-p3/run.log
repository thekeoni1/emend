    """The run log's own check of the kinds sample (specs/0033-read-breadth-
    survey.md, "Harness runs", the run log's own check, its kinds bullet), M5
    part 2 P1. Written for this phase by <phase>/gen/kindscmp_src.py, copied by
    gen/run.py to <scripts>/kindscmp.py; run as python3 -I -B.
    
    Usage:
      kindscmp.py kinds <input> <output> [--plant <name>]
      kindscmp.py --selftest
    
    kinds: reads the input and the output with zipfile and ElementTree and
    prints one line of key=value pairs, space-separated: the tool line's keys
    in the tool's order, as this check counts them from the input on its own,
    then its two flags, entries_same (every zip entry of the output the input's,
    names and bytes, in order) and sum_rule (the fields summed equal to the
    entries less one). It prints counts and flags only: no name, reference,
    path or text from the workbook.
    
    The count, typed here from the spec and not from the crate:
    - an entry's type is the Override whose PartName is "/" followed by the
      entry name, byte for byte (the first such); else the Default whose
      Extension equals the text after the name's last "." compared ASCII
      case-insensitively (the first such); else none. [Content_Types].xml is
      not counted. Each type is compared whole against TYPES below; a type
      beginning "image/" is an image; any other type is other_typed; no type is
      untyped.
    - the sheets: xl/workbook.xml's <sheet> elements in order (main namespace,
      transitional or strict), each r:id resolved through the workbook part's
      rels part to its target part (OPC: an absolute target without its slash,
      else joined to the source's directory, "." and ".." resolved).
    - per sheet, its rels part's relationships by Type, each kind in its
      transitional and its strict form (the Microsoft slicer and timeline types
      have one form); hyperlinks counted when TargetMode is "External"; each
      drawing relationship whose target resolves (not External, not above the
      root) followed to the drawing's rels part, its chart and image
      relationships counted; sparklineGroup elements in the 2009/9 namespace
      anywhere in the sheet part, by ElementTree's namespace-qualified tags.
    
    Plants (the run log's controls): entries_same, the output's first entry
    taken as one byte different; sum_rule, the content types part counted too
    (as other_typed); count, worksheets counted one more. Each prints
    planted=yes; an unknown plant prints error=unknown-plant.
    
    --selftest: builds in memory the tool test's fictional workbook
    (tools/emend-copy/tests/null_rewrite.rs, kinds_specs) and checks the line
    against the one that test asserts, then each check against a planted
    difference; prints one "name: yes|no" line per check, SELFTEST_LINES of
    them.
    """
    import io
    import posixpath
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    
    FLAGS_OF = {"kinds": ("entries_same", "sum_rule")}
    SELFTEST_LINES = 14
    
    CT_NS = "http://schemas.openxmlformats.org/package/2006/content-types"
    RELS_NS = "http://schemas.openxmlformats.org/package/2006/relationships"
    MAIN_NS = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
               "http://purl.oclc.org/ooxml/spreadsheetml/main")
    R_NS = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    X14_NS = "http://schemas.microsoft.com/office/spreadsheetml/2009/9/main"
    CONTENT_TYPES = "[Content_Types].xml"
    
    # The kinds of specs/0033's table, by the whole type string.
    SML = "application/vnd.openxmlformats-officedocument.spreadsheetml."
    DOC = "application/vnd.openxmlformats-officedocument."
    TYPES = {
        SML + "worksheet+xml": "worksheets",
        SML + "chartsheet+xml": "chartsheets",
        SML + "dialogsheet+xml": "dialogsheets",
        "application/vnd.ms-excel.macrosheet+xml": "macrosheets",
        "application/vnd.ms-excel.intlmacrosheet+xml": "macrosheets",
        DOC + "drawingml.chart+xml": "charts",
        "application/vnd.ms-office.chartex+xml": "chartex",
        DOC + "drawing+xml": "drawings",
        SML + "table+xml": "tables",
        SML + "pivotTable+xml": "pivot_tables",
        SML + "pivotCacheDefinition+xml": "pivot_caches",
        SML + "pivotCacheRecords+xml": "pivot_cache_records",
        SML + "externalLink+xml": "external_links",
        "application/vnd.ms-office.vbaProject": "vba_projects",
        "application/vnd.ms-excel.slicer+xml": "slicers",
        "application/vnd.ms-excel.slicerCache+xml": "slicer_caches",
        "application/vnd.ms-excel.timeline+xml": "timelines",
        "application/vnd.ms-excel.timelineCache+xml": "timeline_caches",
        SML + "comments+xml": "comments",
        "application/vnd.ms-excel.threadedcomments+xml": "threaded_comments",
        "application/vnd.ms-excel.person+xml": "persons",
        DOC + "customXmlProperties+xml": "custom_xml",
        SML + "connections+xml": "connections",
        SML + "queryTable+xml": "query_tables",
        DOC + "custom-properties+xml": "custom_properties",
        SML + "printerSettings": "printer_settings",
        SML + "calcChain+xml": "calc_chains",
    }
    KIND_KEYS = ("worksheets chartsheets dialogsheets macrosheets charts chartex drawings images "
                 "tables pivot_tables pivot_caches pivot_cache_records external_links vba_projects "
                 "slicers slicer_caches timelines timeline_caches comments threaded_comments persons "
                 "custom_xml connections query_tables custom_properties printer_settings calc_chains "
                 "other_typed untyped").split()
    SHEET_KEYS = ("drawings charts images comments vml_drawings tables pivot_tables slicers "
                  "timelines printer_settings external_hyperlinks sparkline_groups").split()
    KEYS = KIND_KEYS + ["entries", "kinds_sum", "sheets"] + ["sheet_" + k for k in SHEET_KEYS]
    
    OD_T = "http://schemas.openxmlformats.org/officeDocument/2006/relationships/"
    OD_S = "http://purl.oclc.org/ooxml/officeDocument/relationships/"
    
    
    def both(name):
        return (OD_T + name, OD_S + name)
    
    
    REL_KIND = {}
    for kind, key in (("drawing", "drawings"), ("comments", "comments"),
                      ("vmlDrawing", "vml_drawings"), ("table", "tables"),
                      ("pivotTable", "pivot_tables"), ("printerSettings", "printer_settings")):
        for t in both(kind):
            REL_KIND[t] = key
    REL_KIND["http://schemas.microsoft.com/office/2007/relationships/slicer"] = "slicers"
    REL_KIND["http://schemas.microsoft.com/office/2011/relationships/timeline"] = "timelines"
    HYPERLINK = both("hyperlink")
    DRAWING = both("drawing")
    CHART = both("chart")
    IMAGE = both("image")
    OFFICE_DOCUMENT = both("officeDocument")
    
    
    def content_types(z):
        root = ET.fromstring(z.read(CONTENT_TYPES))
        overrides, defaults = {}, []
        for el in root:
            if el.tag == "{%s}Override" % CT_NS:
                overrides.setdefault(el.get("PartName"), el.get("ContentType"))
            elif el.tag == "{%s}Default" % CT_NS:
                defaults.append((el.get("Extension"), el.get("ContentType")))
        return overrides, defaults
    
    
    def ascii_lower(s):
        return "".join(c.lower() if c.isascii() else c for c in s)
    
    
    def type_of(name, overrides, defaults):
        if "/" + name in overrides:
            return overrides["/" + name]
        if "." not in name:
            return None
        ext = ascii_lower(name.rsplit(".", 1)[1])
        for e, t in defaults:
            if e is not None and ascii_lower(e) == ext:
                return t
        return None
    
    
    def kind_of(t):
        if t is None:
            return "untyped"
        if t.startswith("image/"):
            return "images"
        return TYPES.get(t, "other_typed")
    
    
    def rels_part(source):
        d, f = posixpath.split(source)
        return (d + "/" if d else "") + "_rels/" + f + ".rels"
    
    
    def resolve(source, target):
        """The entry an internal target names, or None above the root."""
        if target.startswith("/"):
            segs = []
            path = target[1:]
        else:
            d = posixpath.dirname(source)
            segs = [s for s in d.split("/") if s]
            path = target
        for s in path.split("/"):
            if s in ("", "."):
                continue
            if s == "..":
                if not segs:
                    return None
                segs.pop()
            else:
                segs.append(s)
        return "/".join(segs) if segs else None
    
    
    def relationships(z, names, source):
        part = rels_part(source)
        if part not in names:
            return []
        root = ET.fromstring(z.read(part))
        return [(r.get("Id"), r.get("Type"), r.get("Target"), r.get("TargetMode") == "External")
                for r in root if r.tag == "{%s}Relationship" % RELS_NS]
    
    
    def sheets_of(z, names):
        pkg = relationships(z, names, "")
        wb = None
        for (_, t, target, ext) in pkg:
            if t in OFFICE_DOCUMENT and not ext:
                wb = resolve("", target)
                break
        root = ET.fromstring(z.read(wb))
        rels = {i: (t, target, ext) for (i, t, target, ext) in relationships(z, names, wb)}
        out = []
        for ns in MAIN_NS:
            for sheets in root.findall("{%s}sheets" % ns):
                for sheet in sheets.findall("{%s}sheet" % ns):
                    rid = None
                    for rns in R_NS:
                        rid = rid or sheet.get("{%s}id" % rns)
                    out.append(resolve(wb, rels[rid][1]))
        return out
    
    
    def sheet_counts(z, names, part, counts):
        drawings = []
        for (_, t, target, ext) in relationships(z, names, part):
            if t in REL_KIND:
                counts["sheet_" + REL_KIND[t]] += 1
            elif t in HYPERLINK and ext:
                counts["sheet_external_hyperlinks"] += 1
            if t in DRAWING and not ext:
                d = resolve(part, target)
                if d is not None:
                    drawings.append(d)
        for d in drawings:
            for (_, t, _target, _ext) in relationships(z, names, d):
                if t in CHART:
                    counts["sheet_charts"] += 1
                elif t in IMAGE:
                    counts["sheet_images"] += 1
        # Streamed: each element counted at its start and cleared at its end, so
        # the tree is never held whole.
        for event, el in ET.iterparse(io.BytesIO(z.read(part)), events=("start", "end")):
            if event == "start" and el.tag == "{%s}sparklineGroup" % X14_NS:
                counts["sheet_sparkline_groups"] += 1
            elif event == "end":
                el.clear()
    
    
    def count(input_bytes, plant=None):
        z = zipfile.ZipFile(io.BytesIO(input_bytes))
        infos = z.infolist()
        names = set(i.filename for i in infos)
        overrides, defaults = content_types(z)
        counts = dict.fromkeys(KEYS, 0)
        for info in infos:
            if info.filename == CONTENT_TYPES and plant != "sum_rule":
                continue
            counts[kind_of(type_of(info.filename, overrides, defaults))] += 1
        if plant == "count":
            counts["worksheets"] += 1
        counts["entries"] = len(infos)
        counts["kinds_sum"] = sum(counts[k] for k in KIND_KEYS)
        sheets = sheets_of(z, names)
        counts["sheets"] = len(sheets)
        for part in sheets:
            sheet_counts(z, names, part, counts)
        return counts
    
    
    def entries_of(data):
        z = zipfile.ZipFile(io.BytesIO(data))
        return [(i.filename, z.read(i.filename)) for i in z.infolist()]
    
    
    def compare(input_bytes, output_bytes, plant=None):
        counts = count(input_bytes, plant)
        a, b = entries_of(input_bytes), entries_of(output_bytes)
        if plant == "entries_same" and b:
            first = sorted(range(len(b)), key=lambda k: b[k][0])[0]
            data = b[first][1]
            b[first] = (b[first][0], bytes([(data[0] ^ 1) if data else 1]) + data[1:])
        flags = {
            "entries_same": a == b,
            "sum_rule": counts["kinds_sum"] == counts["entries"] - 1,
        }
        out = ["%s=%d" % (k, counts[k]) for k in KEYS]
        out += ["%s=%s" % (f, "yes" if flags[f] else "no") for f in FLAGS_OF["kinds"]]
        if plant is not None:
            out.append("planted=yes")
        return " ".join(out)
    
    
    def kv(line, key):
        for item in line.split(" "):
            if item.startswith(key + "="):
                return item[len(key) + 1:]
        return None
    
    
    # The tool test's workbook (null_rewrite.rs, package_specs_with and
    # kinds_specs), fictional, and the line that test asserts.
    TYPES_NS = CT_NS
    RELS_TYPE = "application/vnd.openxmlformats-package.relationships+xml"
    WORKBOOK_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"
    SHEET_TYPE = SML + "worksheet+xml"
    ATTR = R_NS[0]
    TOOL_LINE = ("kinds\tworksheets=1\tchartsheets=0\tdialogsheets=0\tmacrosheets=0\tcharts=1"
                 "\tchartex=0\tdrawings=1\timages=1\ttables=1\tpivot_tables=0\tpivot_caches=0"
                 "\tpivot_cache_records=0\texternal_links=0\tvba_projects=0\tslicers=0"
                 "\tslicer_caches=0\ttimelines=0\ttimeline_caches=0\tcomments=0\tthreaded_comments=0"
                 "\tpersons=0\tcustom_xml=0\tconnections=0\tquery_tables=0\tcustom_properties=0"
                 "\tprinter_settings=0\tcalc_chains=0\tother_typed=6\tuntyped=1\tentries=13"
                 "\tkinds_sum=12\tsheets=1\tsheet_drawings=1\tsheet_charts=1\tsheet_images=1"
                 "\tsheet_comments=0\tsheet_vml_drawings=0\tsheet_tables=1\tsheet_pivot_tables=0"
                 "\tsheet_slicers=0\tsheet_timelines=0\tsheet_printer_settings=0"
                 "\tsheet_external_hyperlinks=1\tsheet_sparkline_groups=1")
    
    
    def fixture_parts(types_extra="", sheet_rels_extra="", sheet_extra="", drawing_rels_extra=""):
        vnd = "application/vnd.openxmlformats-officedocument"
        types = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                 '<Types xmlns="%s">'
                 '<Default Extension="rels" ContentType="%s"/>'
                 '<Default Extension="xml" ContentType="application/xml"/>'
                 '<Override PartName="/xl/workbook.xml" ContentType="%s"/>'
                 '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="%s"/>'
                 '<Override PartName="/xl/tables/table1.xml" ContentType="%s.spreadsheetml.table+xml"/>'
                 '<Override PartName="/xl/drawings/drawing1.xml" ContentType="%s.drawing+xml"/>'
                 '<Override PartName="/xl/charts/chart1.xml" ContentType="%s.drawingml.chart+xml"/>'
                 '<Default Extension="png" ContentType="image/png"/>%s</Types>'
                 % (TYPES_NS, RELS_TYPE, WORKBOOK_TYPE, SHEET_TYPE, vnd, vnd, vnd, types_extra))
        package_rels = ('<Relationships xmlns="%s"><Relationship Id="rId1" Type="%s/officeDocument" '
                        'Target="xl/workbook.xml"/></Relationships>' % (RELS_NS, ATTR))
        workbook = ('<workbook xmlns="%s" xmlns:r="%s"><sheets><sheet name="Sheet1" sheetId="1" '
                    'r:id="rId1"/></sheets></workbook>' % (MAIN_NS[0], ATTR))
        workbook_rels = ('<Relationships xmlns="%s">'
                         '<Relationship Id="rId1" Type="%s/worksheet" Target="worksheets/sheet1.xml"/>'
                         '<Relationship Id="rId2" Type="%s/styles" Target="styles.xml"/>'
                         '<Relationship Id="rId3" Type="%s/hyperlink" Target="https://example.invalid/x" '
