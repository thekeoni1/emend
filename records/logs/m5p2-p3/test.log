    check "M5 part 1 P3's rows not in this listing are exactly the typed seven" "$(yn cmp -s "$T/gone.got" "$T/gone.exp")"
    check "this listing's rows not in M5 part 1 P3's are exactly the typed hundred" "$(yn cmp -s "$T/new.got" "$T/new.exp")"
    { cat "$T/gone.exp"; printf '%s\n' 'crate::cells|struct|Planted|-|-|0000000'; } | LC_ALL=C sort >"$T/c-gone.exp"
    check "control: the same comparison refuses the gone set with one key planted" "$(ynnot cmp -s "$T/gone.got" "$T/c-gone.exp")"
    { cat "$T/new.exp"; printf '%s\n' 'crate::cells|struct|Planted|-|-|0000000'; } | LC_ALL=C sort >"$T/c-new.exp"
    check "control: the same comparison refuses the new set with one key planted" "$(ynnot cmp -s "$T/new.got" "$T/c-new.exp")"
    echo "  rows in the listing: $n_rows; M5 part 1 P3's $n_old, less $n_gone gone, plus $n_new new: $((n_old - n_gone + n_new))"
    rows_sum_ok() { [ "$n_rows" = "$((n_old - n_gone + n_new))" ] && [ "$n_rows" = 660 ]; }
    check "the listing holds 660 rows, M5 part 1 P3's 567 less seven plus one hundred" "$(yn rows_sum_ok)"
