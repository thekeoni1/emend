    {
      printf '%s\n' 'crate::package|const|COMMENTS|-|any(comments, copy)|96dde75'
      printf '%s\n' 'crate::package|const|DRAWING|-|images|b65ea6d'
      printf '%s\n' 'crate::package|const|HYPERLINK|-|any(metadata, copy)|a791e2c'
