    while IFS= read -r c; do
      echo "  doc commit $c touches: $(git diff-tree --no-commit-id --name-only -r "$c" | tr '\n' ' ')"
      structural "  doc commit $c touches specs/*.md and ROADMAP.md alone (changes DK and EZ)" "$(yn role_paths_ok "$c" "$DOC_PATHS")"
    done <"$T/phase-docs"
    while IFS= read -r c; do
      echo "  code commit $c touches: $(git diff-tree --no-commit-id --name-only -r "$c" | tr '\n' ' ')"
      structural "  code commit $c touches .rs files under crates/emend/src/ and tools/emend-copy/src/ or tests/, the two Cargo.toml files of crates/emend and tools/emend-copy and .sh files under scripts/ alone (changes DK, FL and GF)" "$(yn role_paths_ok "$c" "$CODE_PATHS")"
    done <"$T/phase-code"
    P1PH=$(git log --format='%H' -n 1 -F --grep="M4 part 2 P1: the README and the licence texts in the package" "$C")
    echo "  M4 part 2 P1's phase commit, a code commit outside the range, by its subject: ${P1PH:-none found}"
    structural "control: the same form refuses the phase commit against the doc commits' paths (change DK)" \
