    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR RUSTDOCFLAGS RUSTFLAGS CARGO_TARGET_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    # Change SD: every cargo command of this log runs offline.
    export CARGO_NET_OFFLINE=true
    # Change WG: no python run by this log writes byte code (part 1's
    # "Planning verification and rulings on P2", ruling 6; P3's change VI).
    export PYTHONDONTWRITEBYTECODE=1
    PHASE_DIR=$HOME/.cache/emend-build/m5p3-p2
    BUILD_ROOT=${TEST_BUILD:-$PHASE_DIR/test}
    SUPERSEDED_DIR=$PHASE_DIR/superseded
    TARGET_DIR=$PHASE_DIR/target
    SPEC=specs/0034-charts-read.md
    SPEC_WANT=0248539876d833e772596aecdde0d1b8d609635c19a62b4f3e04e8ca527c1d05
    mkdir -p "$BUILD_ROOT" || exit 2
    # Change WH: every temporary file of this run, cargo's, rustc's and
    # python's among them, goes under <build>/tmp, inside the phase directory,
    # never the system temporary directory (specs/0032 close-out ruling 1).
    TMPDIR=$BUILD_ROOT/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    # Change QC: made on the disk under <build> and kept after the run; it is
    # made in TMPDIR (change WH).
    B=$(mktemp -d) || exit 2
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT_SHA=${C:0:7}
    # This phase's log directory, the run log's record pairs (untracked, the
    # phase commit's short sha) and planning's modified specs/0034, nothing
    # else (changes TB, UB, WB, XB, XR and YA).
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m5p3-p2/|[?][?] records/m5p3-(p2|open)-[0-9]{4}-[0-9]{2}-[0-9]{2}-${SHORT_SHA}[.](md|txt)\$| M specs/0034-charts-read[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's log directory, its record pairs and specs/0034 modified" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$B#<scratch>/w#g" \
        -e "s#$TMPDIR#<scratch>/tmp#g" -e "s#$BUILD_ROOT#<build>#g" -e "s#$SUPERSEDED_DIR#<superseded>#g" \
        -e "s#$TARGET_DIR#<target>#g" -e "s#$PHASE_DIR#<phase>#g" \
        -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "input: RERUN_NOTE: ${RERUN_NOTE:-unset}"
    echo "input: RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: HOME: set, read for the paths under it, printed as <home>"
    echo "input: TEST_BUILD: ${TEST_BUILD:-unset} (the build root, <build>)"
    echo "input: CARGO_NET_OFFLINE: $CARGO_NET_OFFLINE (exported by this script at entry, so every cargo command of this log runs offline; change SD)"
    echo "input: PYTHONDONTWRITEBYTECODE: $PYTHONDONTWRITEBYTECODE (exported by this script at entry, so no python it runs writes byte code; change WG)"
    echo "input: TMPDIR=$TMPDIR"
    echo "  (set and exported by this script before its mktemp -d: <build>/tmp, under the phase directory; specs/0032 close-out ruling 1; change WH)"
    echo "input: RUSTDOCFLAGS, RUSTFLAGS and CARGO_TARGET_DIR: unset by this script at entry; each cargo command below names its target directory"
    echo "about: M5 part 3 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the shape greps, the three and PYB, over this script, before its log (specs/0001; change WI)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    # Change WI: the fourth shape, PYB: a line that is not a comment and calls
    # python3 (followed by whitespace, then a dash or a .py path) without -I -B.
    # The interpreter's name is held in a variable, so no line here spells a call.
    PY=python3
    PYB_CALL="^[^#]*$PY[[:space:]]+(-|[^[:space:]]*[.]py)"
    PYB_OK="$PY -I -B( |\$)"
    # pyb_calls <file> and pyb_without <file>: the calls, and the calls without
    # -I -B. They print, so their values are compared.
    pyb_calls() { count_matches -E "$PYB_CALL" "$1"; }
    pyb_without() { LC_ALL=C "$G" -E "$PYB_CALL" "$1" | LC_ALL=C "$G" -vE "$PYB_OK" | count_lines /dev/stdin; }
    printf '%s\n' "$PY -c x" "$PY -I -B -c x" "# $PY -c x" "command -v $PY" >"$B/shape-pyb-fixture"
    n_pyb_self=$(pyb_without "$SELF")
    n_pyb_fix=$(pyb_without "$B/shape-pyb-fixture")
    n_calls_self=$(pyb_calls "$SELF")
    n_calls_fix=$(pyb_calls "$B/shape-pyb-fixture")
    echo "  shape PYB: in this script $n_pyb_self (of its $n_calls_self Python calls); in the fixture $n_pyb_fix (of its $n_calls_fix)"
    check "PYB: this script holds none (change WI)" "$(yn [ "$n_pyb_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's one call without -I -B, of its two calls, the comment and the command -v line not calls" "$(yn [ "$n_pyb_fix:$n_calls_fix" = 1:2 ])"
    check "control: the call form finds this script's one Python call, plant_apply's (change XV)" "$(yn [ "$n_calls_self" = 1 ])"
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M5 part 3 P1 record: logs, the charts sample and open records, the check')
    DOC=$(by_subject "M5 part 3 P2: commit planning docs (the P1 verification and rulings)")
    CRATE=$(by_subject "M5 part 3 P2: charts read, the axes, legend, pivot source and style")
    TOOL=$(by_subject "M5 part 3 P2: emend-copy --charts-sample with every field")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's full subject>, for each role"
    echo "  M5 part 3 P1's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the crate commit (the axes, legend, pivot source and style): ${CRATE:-none}"
    echo "  the tool commit (--charts-sample with every field), the phase commit: ${TOOL:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~3"
    for k in 0 1 2 3; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$TOOL" "$CRATE" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the tool commit, the crate commit, the doc commit and the base, each the next one's parent, the tool commit the phase commit (changes XQ and XZ)" "$(yn roles_in_order)"
    roles_ctl() { local TOOL=$CRATE; roles_in_order; }
    check "control: roles_in_order refuses the crate commit named as the phase commit (change XQ)" "$(ynnot roles_ctl)"
    roles_ctl2() { local DOC=$REC; roles_in_order; }
    check "control: roles_in_order refuses the base named as the doc commit" "$(ynnot roles_ctl2)"
    echo
    echo "phase: Milestone 5 part 3 P2 ($SPEC) test.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "rerun: the superseded files are kept in <superseded>"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this log builds in <repo> into <target>/main, one cargo command at a time (change QB)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh, the spec, M5 part 3 P1's test.log and the phase's sources are read from it by git show at the phase commit, the working spec is hashed in it, the plants' copy is made from it by git archive, and cargo test, clippy and doc run in it with their output in <target>/main"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m5p3-p2, the phase's directory on the disk"
    echo "root: <api> stands for the API record directory of the earlier phase whose change notes this script carries; named only in those notes, it is neither read nor written here (change XY)"
    echo "root: <scripts> stands for <phase>/scripts, this script's own directory on the disk, which holds the script and, in <scripts>/out, its own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <target> stands for <phase>/target, the phase's one target root (specs/0001); <target>/main holds this log's builds of <repo> (cargo test on both targets, clippy, doc, the keep run and the runs after the plants), <target>/plant the plants' builds from <scratch>/w/src (change TH)"
    echo "root: <build> stands for the build root on the disk, <phase>/test unless TEST_BUILD names another"
    echo "root: <superseded> stands for <phase>/superseded, where a rerun's superseded files are kept; read only"
    echo "root: <scratch>/tmp stands for <build>/tmp, the TMPDIR this script exports before its mktemp -d, under the phase directory, so every temporary file of the run is there and none in the system temporary directory (change WH)"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory, made in <scratch>/tmp (under <build>), kept on the disk after the run (changes QC and WH): <scratch>/w/counting.sh the phase commit's library, sourced; the captured cargo outputs (*.out) and the names each run passed (*.names); <scratch>/w/prev-test.log, M5 part 3 P1's test.log read at the phase commit; the keep directory <scratch>/w/keep.<random> of block K; the plants' archive copy <scratch>/w/src and their tables; the controls' fixtures (changes TD to TH, UC to UF, WC to WI, XA to XG, XH to XP, XQ to XX, XZ to YG)"
    
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$BUILD_ROOT" && apart "$SUPERSEDED_DIR" "$MAIN" && apart "$TARGET_DIR" "$BUILD_ROOT" && apart "$TARGET_DIR" "$MAIN"; }
    check "the roots other than <home> and <phase> are distinct, none inside another (<scratch>/w inside <build>)" "$(yn roots_distinct)"
    roots_ctl() { apart "$B" "$BUILD_ROOT"; }
    check "control: apart refuses <scratch>/w against <build>, which holds it" "$(ynnot roots_ctl)"
    # Change WH: the working directory mktemp -d made is directly in TMPDIR,
    # which is <build>/tmp.
    in_tmpdir() { [ "$(dirname "$1")" = "$TMPDIR" ] && [ "$TMPDIR" = "$BUILD_ROOT/tmp" ]; }
    echo "command: dirname <scratch>/w -> $(dirname "$B")"
    check "the directory mktemp -d made, <scratch>/w, is directly in TMPDIR, <scratch>/tmp, which is <build>/tmp (change WH)" "$(yn in_tmpdir "$B")"
    check "control: the same check refuses <build>/tmp.x, a directory beside TMPDIR, not in it" "$(ynnot in_tmpdir "$BUILD_ROOT/tmp.x")"
    check "control: the same check refuses <phase>/tmp.x, a directory outside TMPDIR" "$(ynnot in_tmpdir "$PHASE_DIR/tmp.x")"
    tmpdir_ctl() { local TMPDIR=$PHASE_DIR; in_tmpdir "$PHASE_DIR/tmp.x"; }
    check "control: the same check refuses a TMPDIR that is not <build>/tmp (<phase> itself), even holding the directory" "$(ynnot tmpdir_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them this phase's log directory, its record pairs or specs/0034 modified $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT_SHA")"
    short_names_head() { [ "$(git rev-parse "$SHORT_SHA")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_src_ctl() { printf ' M crates/emend/src/cells.rs\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified crate source" "$(ynnot ours_src_ctl)"
    ours_roadmap_ctl() { printf ' M ROADMAP.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified ROADMAP.md (committed and clean in this phase)" "$(ynnot ours_roadmap_ctl)"
    ours_rec_ctl() { printf "?? records/logs/m5p3-p2/gate.log\n?? records/logs/m5p3-p1/gate.log\n?? records/logs/m5p3-p2x/gate.log\n M ROADMAP.md\n M specs/0034-charts-read.md\n?? specs/0034-charts-read.md\n M specs/0033-read-breadth-survey.md\n?? records/m5p3-p2-2026-10-13-${SHORT_SHA}.md\n?? records/m5p3-p2-2026-10-13-${SHORT_SHA}.txt\n?? records/m5p3-open-2026-10-13-${SHORT_SHA}.md\n?? records/m5p3-open-2026-10-13-${SHORT_SHA}.txt\n?? records/size-m5p3-2026-10-13-${SHORT_SHA}.md\n?? records/m5p3-p2-2026-10-13-0000000.md\n M records/m5p3-p2-2026-10-13-${SHORT_SHA}.md\n?? records/m5p3-p1-2026-10-13-${SHORT_SHA}.txt\n" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern takes this phase's log, specs/0034 modified and this phase's two record pairs untracked with the phase commit's short sha, six of fifteen lines: no other phase's log (P1's among them), no sibling directory, no untracked spec, no modified specs/0033 (committed and clean in this phase), no size record (part 3 P3's stem, not this phase's), no other short sha, no modified record, no other phase's record (P1's stem) (changes WB, XB, XR and YA)" "$(yn [ "$(ours_rec_ctl)" = 6 ])"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_BLOB=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum: $SPEC_BLOB; sha256sum $SPEC (the working file, printed and not asserted: planning holds its mid-phase rulings uncommitted; changes WA, XA, XH, XQ and XZ): $SPEC_HAVE"
    check "the spec's blob at the phase commit is at the hash this log pins" "$(yn [ "$SPEC_BLOB" = "$SPEC_WANT" ])"
    spec_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$SPEC_WANT" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot spec_ctl)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    # Change XG (ruling 12): the library's counting_controls makes its one
    # mktemp -d, and removes it, itself; it inherits TMPDIR from this script's
    # environment, checked here to be <build>/tmp before it runs.
    lib_mktemps=$(count_matches -F 'mktemp' "$B/counting.sh")
    tmpdir_exported() { [ "$(printenv TMPDIR)" = "$BUILD_ROOT/tmp" ]; }
    echo "  command: count_matches -F mktemp <scratch>/w/counting.sh: $lib_mktemps; printenv TMPDIR: $(printenv TMPDIR)"
    check "the sourced library holds one mktemp call, counting_controls' mktemp -d (change XG)" "$(yn [ "$lib_mktemps" = 1 ])"
    check "the library's mktemp -d runs with TMPDIR exported as <build>/tmp, so its directory lies under TMPDIR (ruling 12; change XG)" "$(yn tmpdir_exported)"
    tmpdir_exported_ctl() { local TMPDIR=$PHASE_DIR; export TMPDIR; tmpdir_exported; }
    check "control: the same check refuses an environment whose TMPDIR is <phase>" "$(ynnot tmpdir_exported_ctl)"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    # failed_names <cargo output>: prints the name of every test the run failed,
    # from its FAILED lines, or "none" (part 6 P3's form). It prints, so it is
    # never a check's condition.
    failed_names() {
      local n
      n=$(LC_ALL=C "$G" -a -E '^test .* \.\.\. FAILED$' "$1" | sed -E 's/^test (.*) \.\.\. FAILED$/\1/')
      if [ -n "$n" ]; then printf '%s\n' "$n" | sed 's/^/    failed test: /'; else echo "    failed tests: none"; fi
    }
    printf 'test a::b ... ok\ntest a::c ... FAILED\n' >"$B/c-failed"
    check "control: failed_names prints the name of the one FAILED line of two" "$(yn [ "$(failed_names "$B/c-failed")" = "    failed test: a::c" ])"
    printf 'test a::b ... ok\n' >"$B/c-failed-none"
    check "control: failed_names prints none for a run with no FAILED line" "$(yn [ "$(failed_names "$B/c-failed-none")" = "    failed tests: none" ])"
    # diag_lines <cargo output>: the lines a warning or an error begins with
    # (rustc's and clippy's "warning:" / "warning[...]" / "error:" / "error[...]"),
    # counted by the counting library's form.
    DIAG='^(warning|error)(\[[A-Za-z0-9_:]+\])?: '
    diag_lines() { count_matches -E "$DIAG" "$1"; }
    printf 'warning: unused import\nerror[E0433]: failed to resolve\n    Finished x\nnote: this is not one\n' >"$B/c-diag"
    check "control: diag_lines counts the two diagnostic lines of a four-line fixture" "$(yn [ "$(diag_lines "$B/c-diag")" = 2 ])"
    
    CT=$TARGET_DIR/main
    SETS="off charts charts,images charts,read all"
    # set_args <set>: the cargo arguments of a feature set.
    set_args() { case $1 in off) ;; all) echo "--all-features" ;; *) echo "--features $1" ;; esac; }
    # test_run <name> <cargo args...>: runs cargo with the args into <target>/main,
    # keeps the output as <name>.out, prints the exit, the summary lines and the
    # failed names, and writes <name>.rc, .passed, .failed, .nok and .names. It prints,
    # so it is never a check's condition; run_passed reads its files.
    test_run() {
      local name=$1 rc passed failed nok
      shift
      echo "command: CARGO_TARGET_DIR=<target>/main cargo $*"
      CARGO_TARGET_DIR=$CT cargo "$@" >"$B/$name.out" 2>&1 </dev/null
      rc=$?
      LC_ALL=C "$G" -a -E '^test result: ' "$B/$name.out" | sed 's/^/    /'
      failed_names "$B/$name.out"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/$name.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/$name.out")
      nok=$(count_matches -E '^test .* \.\.\. ok$' "$B/$name.out")
      echo "$rc" >"$B/$name.rc"; echo "$passed" >"$B/$name.passed"; echo "$failed" >"$B/$name.failed"; echo "$nok" >"$B/$name.nok"
      # Change TD: the names the run passed, sorted in the C locale.
      LC_ALL=C "$G" -a -E '^test .* \.\.\. ok$' "$B/$name.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | LC_ALL=C sort >"$B/$name.names"
      echo "  $name: exit $rc; passed $passed; failed $failed; executed (passed plus failed) $((passed + failed)); test lines ending ok $nok"
    }
    # run_passed <name>: exit 0, failed 0, passed more than 0 and equal to the ok lines.
    run_passed() {
      local rc passed failed nok
      rc=$(cat "$B/$1.rc"); passed=$(cat "$B/$1.passed"); failed=$(cat "$B/$1.failed"); nok=$(cat "$B/$1.nok")
      [ "$rc" = 0 ] && [ "$failed" = 0 ] && [ "$passed" -gt 0 ] && [ "$passed" = "$nok" ]
    }
    echo 0 >"$B/c-run.rc"; echo 3 >"$B/c-run.passed"; echo 1 >"$B/c-run.failed"; echo 3 >"$B/c-run.nok"
    check "control: run_passed refuses a run with one failed test" "$(ynnot run_passed c-run)"
    echo 0 >"$B/c-run2.rc"; echo 3 >"$B/c-run2.passed"; echo 0 >"$B/c-run2.failed"; echo 2 >"$B/c-run2.nok"
    check "control: run_passed refuses a run whose passed count is not its ok lines" "$(ynnot run_passed c-run2)"
    echo 0 >"$B/c-run3.rc"; echo 3 >"$B/c-run3.passed"; echo 0 >"$B/c-run3.failed"; echo 3 >"$B/c-run3.nok"
    check "control: run_passed takes a clean run of three" "$(yn run_passed c-run3)"
    
    echo
    echo "## W: cargo test --workspace on both targets (the gate's own test steps)"
    test_run ws-host test --workspace
    check "W host: exit 0, none failed, some ran, passed equals the ok lines" "$(yn run_passed ws-host)"
    test_run ws-i686 test --workspace --target i686-unknown-linux-musl
    check "W i686: exit 0, none failed, some ran, passed equals the ok lines" "$(yn run_passed ws-i686)"
    
    echo
    echo "## F: cargo test -p emend with the features off, charts, charts,images, charts,read and every feature, on both targets (changes TC and XS)"
    for target in host i686; do
      for set in $SETS; do
        args=(test -p emend)
        [ "$target" = host ] || args+=(--target i686-unknown-linux-musl)
        # shellcheck disable=SC2207
        args+=($(set_args "$set"))
        test_run "f-$target-$set" "${args[@]}"
        check "F $target, features $set: exit 0, none failed, some ran, passed equals the ok lines" "$(yn run_passed "f-$target-$set")"
      done
    done
    more_with_all() { [ "$(cat "$B/f-$1-all.passed")" -gt "$(cat "$B/f-$1-off.passed")" ]; }
    check "F host: the all-features run passes more tests than the run with none (the sets differ)" "$(yn more_with_all host)"
    check "F i686: the all-features run passes more tests than the run with none" "$(yn more_with_all i686)"
    more_ctl() { [ "$(cat "$B/f-host-off.passed")" -gt "$(cat "$B/f-host-all.passed")" ]; }
    check "control: the same comparison refuses the reverse order" "$(ynnot more_ctl)"
    
    echo
    echo "## E: each F run's count by property, against M5 part 3 P1's committed test.log and the source (changes WC, XC, XJ, XT and YB)"
    PREVLOG=records/logs/m5p3-p1/test.log
    PREVFORM='^  E (host|i686), features [a-z,]+: this run passed [0-9]+;'
    echo "command: git show <phase commit>:$PREVLOG > <scratch>/w/prev-test.log; grep -E '$PREVFORM' <scratch>/w/prev-test.log"
    git show "$C:$PREVLOG" >"$B/prev-test.log"
    rc_prev=$?
    n_prevlines=$(count_matches -E "$PREVFORM" "$B/prev-test.log")
    echo "  exit $rc_prev; matching lines $n_prevlines:"
    LC_ALL=C "$G" -E "$PREVFORM" "$B/prev-test.log" | sed 's/^/    /'
    prev_read() { [ "$rc_prev" = 0 ] && [ "$n_prevlines" = 10 ]; }
    check "M5 part 3 P1's test.log was read at the phase commit and holds one E line per target and set, ten (change YB)" "$(yn prev_read)"
    # prev_count <file> <target> <set>: the "this run passed <n>" figure of the
    # one E line of that log for that target and set, or "none" when the log
    # holds not exactly one. The line must START with the E prefix: the
    # committed log also prints its own script, whose lines hold the same text
    # indented. It prints, so its value is compared, never run as a condition
    # (changes UC, VD and WC).
    prev_count() {
      local hits
      hits=$(LC_ALL=C awk -v p="  E $2, features $3: this run passed " 'index($0, p) == 1 { s = substr($0, length(p) + 1); sub(/;.*$/, "", s); print s }' "$1" | LC_ALL=C "$G" -E '^[0-9]+$')
      if [ -n "$hits" ] && [ "$(printf '%s\n' "$hits" | wc -l)" = 1 ]; then echo "$hits"; else echo none; fi
    }
    printf "  E host, features off: this run passed 31; x\n  E host, features all: this run passed 32; y\n  E i686, features off: this run passed 33; z\n  E i686, features off: this run passed 34; z\n    printf \"  E host, features all: this run passed 39; q\\\\n\"\n  E host, features read: this run passed 35; w\n" >"$B/c-prev"
    check "control: prev_count reads the host off figure of a planted file, not the host all one after it" "$(yn [ "$(prev_count "$B/c-prev" host off)" = 31 ])"
    check "control: prev_count reads the host all figure, not an indented copy of its line (a printed script's)" "$(yn [ "$(prev_count "$B/c-prev" host all)" = 32 ])"
    check "control: prev_count reads none for a target and set the file gives twice (i686 off)" "$(yn [ "$(prev_count "$B/c-prev" i686 off)" = none ])"
    check "control: prev_count reads none for a set the file does not give (host read,rules), not the read line's figure" "$(yn [ "$(prev_count "$B/c-prev" host read,rules)" = none ])"
    check "control: prev_count reads the host read figure" "$(yn [ "$(prev_count "$B/c-prev" host read)" = 35 ])"
    # same_count <a> <b>: both are the same decimal number.
    same_count() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9]+$' && [ "$1" = "$2" ]; }
    check "control: same_count refuses 594 against 595" "$(ynnot same_count 594 595)"
    check "control: same_count refuses none against none" "$(ynnot same_count none none)"
    check "control: same_count takes 594 against 594" "$(yn same_count 594 594)"
    # The chart tests, all of them and the ones this phase adds, derived from
    # the source (M3 part 6 P3's tests_in and cfg_tests forms, each sort in the
    # C locale so comm and cmp compare one collation). Change YC: the file is
    # P1's, grown; the added tests are the ones the base lacks.
    CH_RS=crates/emend/src/package/tests/chart.rs
    CH_MOD=package::tests::chart::
    TOOL_RS=tools/emend-copy/tests/null_rewrite.rs
    tests_attr() { git show "$1:$2" 2>/dev/null | tests_in; }
    tests_in() {
      awk '
        /^[ \t]*#\[test\][ \t]*$/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]/ {
          sub(/^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next
        }
        t { t = 0 }' | LC_ALL=C sort
    }
    # cfg_tests <cfg line> <file text on stdin>: the tests whose attribute
    # lines, before the fn line, hold exactly that cfg line.
    cfg_tests() {
      awk -v want="$1" '
        $0 == want { c = 1; next }
        /^#\[test\]/ { t = 1; next }
        /^#\[/ { next }
        /^fn / { if (c && t) { s = $0; sub(/^fn /, "", s); sub(/[(<].*/, "", s); print s }; c = 0; t = 0; next }
        { c = 0; t = 0 }' | LC_ALL=C sort
    }
    tests_attr "$C" "$CH_RS" >"$B/ch-all"
    tests_attr "$REC" "$CH_RS" >"$B/ch-base"
    LC_ALL=C comm -13 "$B/ch-base" "$B/ch-all" >"$B/ch-new"
    git show "$C:$CH_RS" | cfg_tests '#[cfg(feature = "rules")]' >"$B/ch-rules"
    # Change XT: no cfg line at all in the chart test file, so every test in it
    # is compiled wherever the module is, with charts.
    git show "$C:$CH_RS" >"$B/ch-src"
    CH_CFG=$(count_matches -F '#[cfg(' "$B/ch-src")
    : >"$B/none"
    CH_ALL=$(count_lines "$B/ch-all")
    CH_BASE=$(count_lines "$B/ch-base")
    CH_NEW=$(count_lines "$B/ch-new")
    CH_RULES=$(count_lines "$B/ch-rules")
    echo "  #[test] functions in $CH_RS at the phase commit: $CH_ALL; at the base: $CH_BASE; added by this phase: $CH_NEW; at the phase commit gated on rules: $CH_RULES; cfg lines in the file: $CH_CFG"
    sed 's/^/    the added chart test: /' "$B/ch-new"
    ch_shape() { [ "$CH_ALL" -ge 1 ] && [ "$CH_RULES" = 0 ] && [ "$CH_CFG" = 0 ]; }
    check "the chart test file holds tests and no cfg line, so every one is compiled with charts (FACTS.md; change XT)" "$(yn ch_shape)"
    printf '#[cfg(feature = "images")]\n#[test]\nfn ctl_gated() {}\n#[test]\nfn ctl_plain() {}\n' >"$B/c-ch-cfg"
    check "control: the same cfg count finds the one cfg line of a two-test fixture" "$(yn [ "$(count_matches -F '#[cfg(' "$B/c-ch-cfg")" = 1 ])"
    LC_ALL=C comm -23 "$B/ch-base" "$B/ch-all" >"$B/ch-gone"
    CH_GONE=$(count_lines "$B/ch-gone")
    echo "  tests of the base's chart test file not at the phase commit: $CH_GONE"
    ch_grows() { [ "$CH_BASE" -ge 1 ] && [ "$CH_NEW" -ge 1 ] && [ "$CH_GONE" = 0 ] && [ "$CH_ALL" = "$((CH_BASE + CH_NEW))" ]; }
    check "the chart test file keeps every test the base held and adds some: the phase commit's tests are the base's plus the added ones (change YC)" "$(yn ch_grows)"
    ch_grows_ctl() { local CH_GONE=1; ch_grows; }
    check "control: the same check refuses a base test the phase commit lacks" "$(ynnot ch_grows_ctl)"
    tests_attr "$C" "$TOOL_RS" >"$B/tool-all"
    tests_attr "$REC" "$TOOL_RS" >"$B/tool-base"
    LC_ALL=C comm -13 "$B/tool-base" "$B/tool-all" >"$B/tool-new"
    TOOL_NEW=$(count_lines "$B/tool-new")
    echo "  #[test] functions added to $TOOL_RS by this phase: $TOOL_NEW"
    sed 's/^/    the added tool test: /' "$B/tool-new"
    printf '#[cfg(feature = "rules")]\n#[test]\nfn ctl_on() {}\n#[test]\nfn ctl_plain() {}\n#[test]\n#[should_panic]\nfn ctl_attr() {}\n#[cfg(not(feature = "read"))]\n#[test]\nfn ctl_off() {}\n' >"$B/c-cfg"
    check "control: tests_in reads all four tests of a fixture, one with a second attribute" "$(yn [ "$(tests_in <"$B/c-cfg" | count_lines /dev/stdin)" = 4 ])"
    check "control: cfg_tests reads the one test gated on rules, not the plain ones" "$(yn [ "$(cfg_tests '#[cfg(feature = "rules")]' <"$B/c-cfg")" = ctl_on ])"
    # ch_want <set>: the file of the chart names the set compiles (none off,
    # all of them in every set with charts; change XT). ch_added <set>: the
    # file of the added chart names the set compiles (change YB).
    ch_want() { case $1 in off) echo "$B/none" ;; *) echo "$B/ch-all" ;; esac; }
    ch_added() { case $1 in off) echo "$B/none" ;; *) echo "$B/ch-new" ;; esac; }
    # ch_got <run>: the chart names the run passed, the module path dropped,
    # sorted. It prints, so it writes files, never conditions.
    ch_got() { LC_ALL=C "$G" -F "$CH_MOD" "$B/$1.names" | sed 's/^.*:://' | LC_ALL=C sort; }
    printf 'package::tests::chart::b\npackage::tests::dxf::c\npackage::tests::chart::a\n' >"$B/c-sv.names"
    check "control: ch_got reads the two chart names of three, sorted, the module path dropped" "$(yn [ "$(ch_got c-sv | tr '\n' ' ')" = "a b " ])"
    for target in host i686; do
      for set in $SETS; do
        ch_got "f-$target-$set" >"$B/ch-got-$target-$set"
        prev=$(prev_count "$B/prev-test.log" "$target" "$set")
        case $prev in '' | *[!0-9]*) want=none ;; *) want=$((prev + $(count_lines "$(ch_added "$set")"))) ;; esac
        echo "  E $target, features $set: this run passed $(cat "$B/f-$target-$set.passed"); P1's figure $prev, plus the tests this phase adds that the set compiles $(count_lines "$(ch_added "$set")"), $want; chart tests passed $(count_lines "$B/ch-got-$target-$set") of the $(count_lines "$(ch_want "$set")") the set compiles"
        check "E $target, features $set: the run passes P1's figure for the set plus the tests this phase adds that the set compiles (change YB)" "$(yn same_count "$(cat "$B/f-$target-$set.passed")" "$want")"
        check "E $target, features $set: the chart tests the run passed are exactly the ones the set compiles, by name" "$(yn cmp -s "$B/ch-got-$target-$set" "$(ch_want "$set")")"
      done
    done
    plus_one=$(( $(cat "$B/f-i686-all.passed") + 1 ))
    check "control: the same comparison refuses the i686 all run's count plus one" "$(ynnot same_count "$plus_one" "$(( $(prev_count "$B/prev-test.log" i686 all) + CH_NEW ))")"
    sed '1d' "$B/ch-all" >"$B/c-ch-short"
    check "control: the name comparison refuses the chart names one short" "$(ynnot cmp -s "$B/c-ch-short" "$B/ch-all")"
    check "control: the name comparison refuses the off set's want (none) for a set that compiles the chart tests" "$(ynnot cmp -s "$B/none" "$B/ch-all")"
    check "control: the added names alone are not the names a set compiles, the base's being there too" "$(ynnot cmp -s "$B/ch-new" "$B/ch-all")"
    for set in $SETS; do
      check "E features $set: host and i686 pass the same names" "$(yn cmp -s "$B/f-host-$set.names" "$B/f-i686-$set.names")"
    done
    sed '1d' "$B/f-host-all.names" >"$B/c-names-short"
    check "control: the same comparison refuses the host all run's names one short" "$(ynnot cmp -s "$B/c-names-short" "$B/f-i686-all.names")"
    echo "### W's figure, against M5 part 3 P1's committed W line, plus the tests this phase adds (changes VC, WC, XC, XJ, XT and YD)"
    # ws_prev <file> <target>: the passed figure of the one W line of that log
    # for that target ("  ws-<target>: exit 0; passed <n>;", anchored at its
    # start), or "none". It prints, so its value is compared.
    ws_prev() {
      local hits
      hits=$(LC_ALL=C awk -v p="  ws-$2: exit 0; passed " 'index($0, p) == 1 { s = substr($0, length(p) + 1); sub(/;.*$/, "", s); print s }' "$1" | LC_ALL=C "$G" -E '^[0-9]+$')
      if [ -n "$hits" ] && [ "$(printf '%s\n' "$hits" | wc -l)" = 1 ]; then echo "$hits"; else echo none; fi
    }
    printf "  ws-host: exit 0; passed 41; x\n    echo \"  ws-host: exit 0; passed 49; q\"\n  ws-i686: exit 0; passed 42; y\n  ws-i686: exit 0; passed 43; y\n" >"$B/c-ws"
    check "control: ws_prev reads the host figure, not an indented copy of its line" "$(yn [ "$(ws_prev "$B/c-ws" host)" = 41 ])"
    check "control: ws_prev reads none for a target the file gives twice" "$(yn [ "$(ws_prev "$B/c-ws" i686)" = none ])"
    WS_NEW=$((CH_NEW + TOOL_NEW))
    for target in host i686; do
      wprev=$(ws_prev "$B/prev-test.log" "$target")
      case $wprev in '' | *[!0-9]*) wwant=none ;; *) wwant=$((wprev + WS_NEW)) ;; esac
      echo "  W $target: this run passed $(cat "$B/ws-$target.passed"); P1's W figure $wprev, plus the tests this phase adds, each compiled in the workspace (the chart tests, its crate built with the tool's features, charts among them, $CH_NEW; the tool's added tests $TOOL_NEW) $WS_NEW, $wwant"
      check "W $target: the run passes P1's W figure plus the tests this phase adds" "$(yn same_count "$(cat "$B/ws-$target.passed")" "$wwant")"
    done
    ws_ctl() { same_count "$(( $(cat "$B/ws-host.passed") + 1 ))" "$(( $(ws_prev "$B/prev-test.log" host) + WS_NEW ))"; }
    check "control: the same comparison refuses the host W count plus one" "$(ynnot ws_ctl)"
    echo
    echo "## N: the tests the phase adds and removes, derived from the source (changes WD, XD, XK, XU and YE)"
    added_between() {
      # $1 older commit, $2 newer commit: "<file> <name>" per #[test] the newer
      # commit has in a .rs file the pair's diff touches and the older lacks.
      local f
      git diff --name-only "$1" "$2" -- '*.rs' | while IFS= read -r f; do
        tests_attr "$2" "$f" >"$B/ab-new"
        tests_attr "$1" "$f" >"$B/ab-old"
        LC_ALL=C comm -13 "$B/ab-old" "$B/ab-new" | sed "s#^#$f #"
      done
    }
    removed_between() { added_between "$2" "$1"; }
    echo "command: git diff --name-only <base> <phase commit> -- '*.rs'"
    git diff --name-only "$REC" "$C" -- '*.rs' >"$B/changed-rs"
    echo "  the .rs files the phase changed: $(count_lines "$B/changed-rs")"
    sed 's/^/    /' "$B/changed-rs"
    added_between "$REC" "$C" >"$B/src-added"
    removed_between "$REC" "$C" >"$B/src-removed"
    echo "  #[test] functions at the phase commit and not at the base, by file:"
    sed 's/^/    /' "$B/src-added"
    echo "  #[test] functions at the base and not at the phase commit, by file: $(count_lines "$B/src-removed")"
    sed 's/^/    /' "$B/src-removed"
    check "the source removes no test in this phase" "$(yn [ "$(count_lines "$B/src-removed")" = 0 ])"
    git diff --name-only --diff-filter=A "$REC" "$C" -- '*.rs' >"$B/new-rs"
    echo "  new .rs files: $(count_lines "$B/new-rs")"
    sed 's/^/    new .rs file: /' "$B/new-rs"
    : >"$B/new-rs-want"
    check "the phase adds no .rs file (change YE)" "$(yn cmp -s "$B/new-rs" "$B/new-rs-want")"
    printf '%s\n' crates/emend/src/package/chart.rs >"$B/c-new-rs"
    check "control: the same comparison refuses one new .rs file" "$(ynnot cmp -s "$B/c-new-rs" "$B/new-rs-want")"
    added_in_file() { awk -v f="$1" '$1 == f { print $2 }' "$B/src-added" | LC_ALL=C sort; }
    added_in_file "$CH_RS" >"$B/added-sv"
    check "the tests added to the chart test module are exactly the ones block E derived ($(count_lines "$B/added-sv") of $CH_NEW)" "$(yn cmp -s "$B/added-sv" "$B/ch-new")"
    added_in_file crates/emend/src/package/chart.rs >"$B/added-chart-module"
    check "the chart module itself adds no test" "$(yn [ "$(count_lines "$B/added-chart-module")" = 0 ])"
    added_in_file "$TOOL_RS" >"$B/added-tool"
    ntool=$(count_lines "$B/added-tool")
    ntool_named=$(count_matches -E '^the_charts_sample_' "$B/added-tool")
    echo "  tests added to $TOOL_RS: $ntool; of them named for the charts sample: $ntool_named"
    tool_named() { [ "$ntool" -ge 1 ] && [ "$ntool" = "$ntool_named" ] && cmp -s "$B/added-tool" "$B/tool-new"; }
    check "the tool's added tests are each named for the charts sample, and some, the ones block E counted for W" "$(yn tool_named)"
    # elsewhere <list>: the "<file> <test>" lines of <list> in neither the
    # chart test module nor the tool's test file.
    elsewhere() { awk -v a="$CH_RS" -v d="$TOOL_RS" '$1 != a && $1 != d' "$1"; }
    elsewhere "$B/src-added" >"$B/added-elsewhere"
    check "no other file gains a test ($(count_lines "$B/added-elsewhere"))" "$(yn [ "$(count_lines "$B/added-elsewhere")" = 0 ])"
    printf '%s t1\n%s t2\nx.rs t3\n' "$CH_RS" "$TOOL_RS" >"$B/c-src-added"
    check "control: the same filter finds one test outside the two files in a list of three" "$(yn [ "$(elsewhere "$B/c-src-added" | count_lines /dev/stdin)" = 1 ])"
    # Each added test passed on both targets, by its module path: a file under
    # crates/emend/src gives <module path>::<name>, an integration test file its
    # bare name (M3 part 6 P3's change CK).
    qualified() {
      case $1 in
        crates/emend/src/*.rs) printf '%s::%s' "$(printf '%s' "${1#crates/emend/src/}" | sed 's/[.]rs$//; s#/#::#g')" "$2" ;;
        *) printf '%s' "$2" ;;
      esac
    }
    passed_on() { count_matches -E "(^|::)$1\$" "$B/$2.names"; }
    both_passed() { [ "$(passed_on "$1" "$2")" = 1 ] && [ "$(passed_on "$1" "$3")" = 1 ]; }
    echo "  each added test, by its module path, and whether it ran and passed on each target in W:"
    while read -r f name; do
      q=$(qualified "$f" "$name")
      echo "    $q (ws-host, ws-i686): host $(passed_on "$q" ws-host), i686 $(passed_on "$q" ws-i686)"
      check "  $q passed on both targets" "$(yn both_passed "$q" ws-host ws-i686)"
    done <"$B/src-added"
    check "control: both_passed refuses a name no run holds" "$(ynnot both_passed zzz_no_such_test_anywhere ws-host ws-i686)"
    while read -r name; do
      q=$(qualified "$CH_RS" "$name")
      echo "    $q in F's host off run (not compiled there): $(passed_on "$q" f-host-off)"
      check "control: both_passed refuses the added chart test in F's off runs, which do not compile it" "$(ynnot both_passed "$q" f-host-off f-i686-off)"
    done <"$B/ch-new"
    qualified_ok() { [ "$(qualified crates/emend/src/package/tests/chart.rs t)" = package::tests::chart::t ] && [ "$(qualified crates/emend/src/styles/tests.rs t)" = styles::tests::t ] && [ "$(qualified tools/emend-copy/tests/null_rewrite.rs t)" = t ]; }
    check "control: qualified gives a crate test its module path and an integration test its bare name" "$(yn qualified_ok)"
    echo
    echo "## K: the crate's tests with every feature on and EMEND_KEEP_DIR set, host (change TF)"
    KEEPD=$(mktemp -d "$B/keep.XXXXXX") || fail=1
    # Change XG (ruling 12): the keep directory, the script's second mktemp
    # call, lies under TMPDIR.
    under_tmpdir() { case "$1" in "$TMPDIR"/*) return 0 ;; *) return 1 ;; esac; }
    echo "command: the keep directory mktemp -d made, against TMPDIR: $KEEPD under $TMPDIR"
    check "the keep directory mktemp -d made lies under TMPDIR, <scratch>/tmp (ruling 12; change XG)" "$(yn under_tmpdir "$KEEPD")"
    check "control: the same check refuses <build>/keep.x, beside TMPDIR, not under it" "$(ynnot under_tmpdir "$BUILD_ROOT/keep.x")"
    echo "command: env EMEND_KEEP_DIR=<scratch>/w/keep.<random> CARGO_TARGET_DIR=<target>/main cargo test -p emend --all-features (host)"
    env EMEND_KEEP_DIR="$KEEPD" CARGO_TARGET_DIR="$CT" cargo test -p emend --all-features >"$B/keep-with.out" 2>&1 </dev/null
    echo "$?" >"$B/keep-with.rc"
    echo "  exit: $(cat "$B/keep-with.rc")"
    LC_ALL=C "$G" -a -E '^test result: ' "$B/keep-with.out" | sed 's/^/    /'
    failed_names "$B/keep-with.out"
    LC_ALL=C "$G" -a -E '^test .* \.\.\. ok$' "$B/keep-with.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | LC_ALL=C sort >"$B/keep-with.names"
    nkeep_files=$(find "$KEEPD" -type f | count_lines /dev/stdin)
    echo "  tests passed with the variable: $(count_lines "$B/keep-with.names"); F's host all run without it: $(count_lines "$B/f-host-all.names"); files the keep holds after the run: $nkeep_files"
    keep_same() {
      [ "$(cat "$B/keep-with.rc")" = 0 ] && [ "$(count_lines "$B/keep-with.names")" -ge 1 ] && cmp -s "$B/keep-with.names" "$B/f-host-all.names"
    }
    check "with EMEND_KEEP_DIR set the crate's tests exit 0 and pass the names F's host all run passed without it" "$(yn keep_same)"
    check "the run with the variable wrote files into the keep, so the variable was read" "$(yn [ "$nkeep_files" -ge 1 ])"
    check "the variable is still unset in this script's own environment" "$(yn [ -z "${EMEND_KEEP_DIR+x}" ])"
    sed '1d' "$B/keep-with.names" >"$B/c-keep-short"
    check "control: the same comparison refuses the names one short" "$(ynnot cmp -s "$B/c-keep-short" "$B/f-host-all.names")"
    echo
    echo "## R: each F run's doc-tests result, 0 passed and 0 failed (change RC, kept: the phase's doc comments hold no doctest)"
    # doc_result <cargo output>: "<passed> <failed>" of the first "test result:"
    # line after cargo's "Doc-tests emend" line, or "none". It prints, so its
    # value is compared.
    doc_result() {
      local r
      r=$(awk '/^[[:space:]]*Doc-tests emend[[:space:]]*$/ { d = 1; next }
        d && /^test result: / { p = 0; f = 0; for (i = 1; i < NF; i++) { if ($(i + 1) ~ /^passed;$/) p = $i; if ($(i + 1) ~ /^failed;$/) f = $i }; print p, f; exit }' "$1")
      if [ -n "$r" ]; then echo "$r"; else echo none; fi
    }
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n   Doc-tests emend\n\nrunning 1 test\ntest result: ok. 1 passed; 0 failed; 0 ignored\n' >"$B/c-doc1"
    check "control: doc_result reads 1 0 for a fixture with one doctest, not the lib line before it" "$(yn [ "$(doc_result "$B/c-doc1")" = "1 0" ])"
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n' >"$B/c-doc2"
    check "control: doc_result reads none for an output with no Doc-tests line" "$(yn [ "$(doc_result "$B/c-doc2")" = none ])"
    for target in host i686; do
      for set in $SETS; do
        dl=$(count_matches -E '^[[:space:]]*Doc-tests emend[[:space:]]*$' "$B/f-$target-$set.out")
        dr=$(doc_result "$B/f-$target-$set.out")
        echo "  R $target, features $set: Doc-tests emend lines $dl; its result (passed failed) $dr"
        check "R $target, features $set: one Doc-tests emend line, its result 0 passed 0 failed" "$(yn [ "$dl:$dr" = "1:0 0" ])"
      done
    done
    
    # clean_run <name>: exit 0 and no diagnostic line in the output.
    clean_run() { [ "$(cat "$B/$1.rc")" = 0 ] && [ "$(diag_lines "$B/$1.out")" = 0 ]; }
    # lint_run <name> <env...> -- <cargo args...>: runs cargo into <target>/main,
    # prints the exit and the diagnostic line count, writes <name>.rc.
    lint_run() {
      local name=$1 rc
      shift
      echo "command: CARGO_TARGET_DIR=<target>/main $*"
      env CARGO_TARGET_DIR="$CT" "$@" >"$B/$name.out" 2>&1 </dev/null
      rc=$?
      echo "$rc" >"$B/$name.rc"
      echo "  $name: exit $rc; diagnostic lines $(diag_lines "$B/$name.out")"
      LC_ALL=C "$G" -a -E "$DIAG" "$B/$name.out" | sed 's/^/    /'
    }
    echo 0 >"$B/c-lint.rc"; printf 'warning: unused variable\n    Finished x\n' >"$B/c-lint.out"
    check "control: clean_run refuses an exit-0 run with one warning line" "$(ynnot clean_run c-lint)"
    echo 0 >"$B/c-lint2.rc"; printf '    Checking x\n    Finished x\n' >"$B/c-lint2.out"
    check "control: clean_run takes an exit-0 run with none" "$(yn clean_run c-lint2)"
    
    echo
    echo "## C: clippy with -D warnings, the crate's five sets and the workspace (changes TC and XS)"
    for set in $SETS; do
      # shellcheck disable=SC2207
      sa=($(set_args "$set"))
      lint_run "c-$set" cargo clippy -p emend --all-targets "${sa[@]}" -- -D warnings
      check "C features $set: exit 0, 0 diagnostic lines" "$(yn clean_run "c-$set")"
    done
    lint_run c-workspace cargo clippy --workspace --all-targets -- -D warnings
    check "C workspace: exit 0, 0 diagnostic lines" "$(yn clean_run c-workspace)"
    
    echo
    echo "## D: rustdoc with -D warnings, the crate's five sets (changes TC and XS)"
    for set in $SETS; do
      # shellcheck disable=SC2207
      sa=($(set_args "$set"))
      lint_run "d-$set" RUSTDOCFLAGS='-D warnings' cargo doc -p emend --no-deps "${sa[@]}"
      check "D features $set: exit 0, 0 diagnostic lines" "$(yn clean_run "d-$set")"
    done
    
    echo
    echo "## P: fourteen planted changes to this phase's P2 code, each against the set of tests it must fail (gen/test_plants.py P1 to P14; changes TG, UE, WE, XE, XL, XW and YF)"
    # An archive copy of the phase commit, never <repo>. Each plant replaces one
    # exact text, found once, in its file of the copy; the crate's library tests
    # with charts and the tool's charts sample tests run; the file is
    # restored. The control is the same two runs in the unplanted copy.
    SRC=$B/src
    mkdir -p "$SRC" || fail=1
    echo "command: git archive <phase commit> | tar -x -m -C <scratch>/w/src (-m: each file takes the extraction's time, not the commit's, so no build an earlier run left in <target>/plant is taken for current)"
    git archive "$C" | tar -x -m -C "$SRC"
    echo "  files extracted: $(find "$SRC" -type f | count_lines /dev/stdin)"
    # The tool's charts sample tests, read from the source at the phase commit
    # (P3's change VF, changes WE, XE, XL, XW and YF): the tests of null_rewrite.rs named
    # the_charts_sample_.
    tests_attr "$C" "$TOOL_RS" | LC_ALL=C "$G" -E '^the_charts_sample_' >"$B/tool-sample"
    ntool=$(count_lines "$B/tool-sample")
    echo "  the tool's charts sample tests at the phase commit: $ntool"
    sed 's/^/    /' "$B/tool-sample"
    check "the tool holds charts sample tests" "$(yn [ "$ntool" -ge 1 ])"
    PLANT_TARGET=$TARGET_DIR/plant
    # plant_apply <id> <file>: replaces the plant's text in <file>, printing the
    # number of times the text was found before the replacement.
    plant_apply() {
      python3 -I -B - "$1" "$2" <<'PLANTS'
    import sys
    pid, path = sys.argv[1:3]
    plants = {
        'P1': ('let mut position = LegendPosition::Right;',
               'let mut position = LegendPosition::Left;'),
        'P2': ('if !joined {',
               'if !joined && false {'),
        'P3': ('                    _ => return Err(CHART_UNREADABLE),',
               '                    _ => AxisPosition::Bottom,'),
        'P4': ('axis.crosses = crosses.ok_or(CHART_UNREADABLE)?;',
               'axis.crosses = crosses.unwrap_or(0);'),
        'P5': ('if !enter(stream, scope, index, &branch, choice && choices == 1)? {',
               'if !enter(stream, scope, index, &branch, true)? {'),
        'P6': ('chart.pivot_source = pivot_source;',
               'chart.pivot_source = pivot_source.filter(|_| false);'),
        'P7': ('min = Some(inner.val()?);',
               'min = inner.val().ok();'),
        'P8': ('axis.major_gridlines = true;',
               'axis.major_gridlines = false;'),
        'P9': ('axis.deleted = inner.flag()?;',
               'axis.deleted = !inner.flag()?;'),
        'P10': ('const CHART_2007_NAMESPACE: &[u8] = b"http://schemas.microsoft.com/office/drawing/2007/8/2/chart";',
               'const CHART_2007_NAMESPACE: &[u8] = b"http://schemas.microsoft.com/office/drawing/2007/8/2/chart-planted";'),
        'P11': ('if !matches!(inner.value(b"val"), Some("autoZero" | "max" | "min")) {',
               'if false && !matches!(inner.value(b"val"), Some("autoZero" | "max" | "min")) {'),
        'P12': ('(axis.min, axis.max) = read_scaling(stream, scope, index, &inner)?;',
               '(axis.max, axis.min) = read_scaling(stream, scope, index, &inner)?;'),
        'P13': ('let format = inner.value(b"formatCode").ok_or(CHART_UNREADABLE)?;',
               'let format = inner.value(b"formatCode").unwrap_or("");'),
        'P14': ('    name.ok_or(CHART_UNREADABLE)\n',
               '    Ok(name.unwrap_or_default())\n'),
    }
    old, new = plants[pid]
    text = open(path).read()
    print(text.count(old))
    if text.count(old) == 1:
        open(path, "w").write(text.replace(old, new))
    PLANTS
    }
    # The plants: id | file | what the plant does.
    cat >"$B/plants" <<'TABLE'
    P1|crates/emend/src/package/chart.rs|a legend without legendPos read as Left, not the schema's Right
    P2|crates/emend/src/package/chart.rs|a plot's axId naming no axis of the chart accepted
    P3|crates/emend/src/package/chart.rs|an axPos outside b, l, r and t read as Bottom, not refused
    P4|crates/emend/src/package/chart.rs|an axis without crossAx accepted, crosses 0
    P5|crates/emend/src/package/chart.rs|every branch of a root AlternateContent searched for the style, the Fallback too
    P6|crates/emend/src/package/chart.rs|the pivot source dropped
    P7|crates/emend/src/package/chart.rs|a scaling min that is not a number read as none, not refused
    P8|crates/emend/src/package/chart.rs|majorGridlines not read
    P9|crates/emend/src/package/chart.rs|an axis's delete read inverted
    P10|crates/emend/src/package/chart.rs|the 2007 chart extension namespace not recognised, so c14:style is not read
    P11|crates/emend/src/package/chart.rs|a crosses value outside autoZero, max and min, or none, accepted
    P12|crates/emend/src/package/chart.rs|scaling's min and max read into each other
    P13|crates/emend/src/package/chart.rs|a numFmt without formatCode accepted as an empty format (P2 ruling N)
    P14|crates/emend/src/package/chart.rs|a pivotSource without name accepted as an empty source (P2 ruling N)
    TABLE
    # Each plant's expected failing tests, gen/test_plants.py's EXPECTED:
    # id | crate or tool | the test (the crate's by its path, the tool's by
    # its bare name), as the dry run confirmed them.
    cat >"$B/plant-expect" <<'TABLE'
    P1|crate|package::tests::chart::each_legend_position_reads_and_one_without_a_position_is_right
    P2|crate|package::tests::chart::the_axis_and_legend_refusals_are_refused_with_the_message
    P3|crate|package::tests::chart::the_axis_and_legend_refusals_are_refused_with_the_message
    P4|crate|package::tests::chart::the_axis_and_legend_refusals_are_refused_with_the_message
    P5|crate|package::tests::chart::a_style_reads_plain_and_from_the_first_choice_not_the_fallback
    P6|crate|package::tests::chart::a_pivot_source_reads_its_name
    P6|tool|the_charts_sample_counts_and_digests_every_chart_and_writes_the_input_back_unedited
    P7|crate|package::tests::chart::the_axis_and_legend_refusals_are_refused_with_the_message
    P8|crate|package::tests::chart::an_axis_s_title_number_format_bounds_deletion_and_gridlines_read
    P8|tool|the_charts_sample_counts_and_digests_every_chart_and_writes_the_input_back_unedited
    P9|crate|package::tests::chart::an_axis_s_title_number_format_bounds_deletion_and_gridlines_read
    P9|tool|the_charts_sample_counts_and_digests_every_chart_and_writes_the_input_back_unedited
    P10|crate|package::tests::chart::a_style_reads_plain_and_from_the_first_choice_not_the_fallback
    P10|tool|the_charts_sample_counts_and_digests_every_chart_and_writes_the_input_back_unedited
    P11|crate|package::tests::chart::a_crosses_without_a_val_is_refused
    P11|crate|package::tests::chart::the_axis_and_legend_refusals_are_refused_with_the_message
    P12|crate|package::tests::chart::an_axis_s_title_number_format_bounds_deletion_and_gridlines_read
    P13|crate|package::tests::chart::a_number_format_without_a_format_code_is_refused
    P14|crate|package::tests::chart::a_pivot_source_without_a_name_is_refused
    TABLE
    # run_both <label>: the crate's library tests with charts, then the
    # tool's charts sample tests, in the archive copy into <target>/plant;
    # each output and exit status to <scratch>/w/plant-<label>-crate and -tool.
    run_both() {
      local label=$1
      ( cd "$SRC" && CARGO_TARGET_DIR=$PLANT_TARGET cargo test -p emend --features charts --lib ) \
        >"$B/plant-$label-crate.out" 2>&1 </dev/null
      echo $? >"$B/plant-$label-crate.rc"
      ( cd "$SRC" && CARGO_TARGET_DIR=$PLANT_TARGET cargo test -p emend-copy --test null_rewrite the_charts_sample_ ) \
        >"$B/plant-$label-tool.out" 2>&1 </dev/null
      echo $? >"$B/plant-$label-tool.rc"
    }
    # got_failed <label>: the tests the two runs failed, "crate|<name>" and
    # "tool|<name>", sorted. It prints, so it writes a file, never a condition.
    got_failed() {
      {
        LC_ALL=C "$G" -a -E '^test .* \.\.\. FAILED$' "$B/plant-$1-crate.out" | sed -E 's/^test (.*) \.\.\. FAILED$/crate|\1/'
        LC_ALL=C "$G" -a -E '^test .* \.\.\. FAILED$' "$B/plant-$1-tool.out" | sed -E 's/^test (.*) \.\.\. FAILED$/tool|\1/'
      } | LC_ALL=C sort
    }
    # want_failed <id>: the plant table's expectation, the same form, sorted.
    want_failed() { awk -F'|' -v id="$1" '$1 == id { print $2 "|" $3 }' "$B/plant-expect" | LC_ALL=C sort; }
    # ran_ok <label> <crate|tool>: the run compiled and ran: a test result line,
    # no could-not-compile line.
    ran_ok() {
      [ "$(count_matches -E '^test result: ' "$B/plant-$1-$2.out")" -ge 1 ] && [ "$(count_matches -F 'could not compile' "$B/plant-$1-$2.out")" = 0 ]
    }
    # rc_agrees <label> <crate|tool>: the run's exit status is 0 exactly when it
    # failed no test.
    rc_agrees() {
      local n
      n=$(count_matches -E '^test .* \.\.\. FAILED$' "$B/plant-$1-$2.out")
      if [ "$n" = 0 ]; then [ "$(cat "$B/plant-$1-$2.rc")" = 0 ]; else [ "$(cat "$B/plant-$1-$2.rc")" != 0 ]; fi
    }
    # show_runs <label>: each run's exit, its result lines and its failed names.
    show_runs() {
      local kind
      for kind in crate tool; do
        echo "    $kind run: exit $(cat "$B/plant-$1-$kind.rc")"
        LC_ALL=C "$G" -a -E '^test result: ' "$B/plant-$1-$kind.out" | sed 's/^/      /'
        failed_names "$B/plant-$1-$kind.out" | sed 's/^/  /'
      done
    }
    sed 's/^/    plant: /' "$B/plants"
    sed 's/^/    expected to fail: /' "$B/plant-expect"
    nplants=$(count_lines "$B/plants")
    echo "  plants in the table: $nplants"
    check "the table holds fourteen plants (gen/test_plants.py P1 to P14)" "$(yn [ "$nplants" = 14 ])"
    # every_plant_expects: each plant of the table names at least one test it
    # must fail, so no plant can pass by failing nothing.
    every_plant_expects() {
      local id
      for id in $(cut -d'|' -f1 "$B/plants"); do
        [ -n "$(want_failed "$id")" ] || return 1
      done
    }
    check "every plant of the table names some test it must fail" "$(yn every_plant_expects)"
    echo "command (control, unplanted, in <scratch>/w/src): CARGO_TARGET_DIR=<target>/plant cargo test -p emend --features charts --lib; then CARGO_TARGET_DIR=<target>/plant cargo test -p emend-copy --test null_rewrite the_charts_sample_"
    run_both clean
    show_runs clean
    got_failed clean >"$B/plant-clean.got"
    ch_clean=$(count_matches -E "^test ${CH_MOD}[a-z0-9_]+ \.\.\. ok\$" "$B/plant-clean-crate.out")
    tool_clean=$(count_matches -E '^test the_charts_sample_[a-z0-9_]+ \.\.\. ok$' "$B/plant-clean-tool.out")
    echo "  unplanted: failed $(count_lines "$B/plant-clean.got"); chart tests passed $ch_clean of $CH_ALL; tool sample tests passed $tool_clean of $ntool"
    clean_ok() {
      ran_ok clean crate && ran_ok clean tool && [ "$(cat "$B/plant-clean-crate.rc")" = 0 ] &&
        [ "$(cat "$B/plant-clean-tool.rc")" = 0 ] && [ "$(count_lines "$B/plant-clean.got")" = 0 ] &&
        [ "$ch_clean" = "$CH_ALL" ] && [ "$tool_clean" = "$ntool" ]
    }
    check "control: the unplanted copy builds and passes both runs, every chart test and every tool sample test among them" "$(yn clean_ok)"
    # plant_ok <id>: the text found once, both runs compiled and ran, each exit
    # status agreeing with its failures, and the failed names exactly the
    # table's.
    plant_ok() {
      [ "$(cat "$B/plant-$1.found")" = 1 ] && ran_ok "$1" crate && ran_ok "$1" tool &&
        rc_agrees "$1" crate && rc_agrees "$1" tool && cmp -s "$B/plant-$1.got" "$B/plant-$1.want"
    }
    while IFS='|' read -r id file what; do
      echo "  plant $id: $what ($file)"
      cp "$SRC/$file" "$B/pristine"
      plant_apply "$id" "$SRC/$file" >"$B/plant-$id.found"
      echo "    the plant's text found in the file: $(cat "$B/plant-$id.found") time(s)"
      echo "    command (planted, in <scratch>/w/src): the two runs of the control"
      run_both "$id"
      show_runs "$id"
      got_failed "$id" >"$B/plant-$id.got"
      want_failed "$id" >"$B/plant-$id.want"
      sed 's/^/    failed: /' "$B/plant-$id.got"
      sed 's/^/    the table expects: /' "$B/plant-$id.want"
      cp "$B/pristine" "$SRC/$file"
      check "  plant $id: found once, both runs built and ran, and the failed tests are exactly the table's, as a set" "$(yn plant_ok "$id")"
    done <"$B/plants"
    restored() {
      local f
      for f in $(cut -d'|' -f2 "$B/plants" | LC_ALL=C sort -u); do
        git show "$C:$f" | cmp -s - "$SRC/$f" || return 1
      done
    }
    check "the planted files are restored to the phase commit's bytes" "$(yn restored)"
    nplant_files=$(find "$PLANT_TARGET" -type f 2>/dev/null | count_lines /dev/stdin)
    nmain_files=$(find "$CT" -type f 2>/dev/null | count_lines /dev/stdin)
    echo "  files under <target>/plant after the plants: $nplant_files; under <target>/main: $nmain_files"
    check "the plants' builds went into their own subdirectory, <target>/plant" "$(yn [ "$nplant_files" -ge 1 ])"
    check "the main tree's builds went into <target>/main" "$(yn [ "$nmain_files" -ge 1 ])"
    check "<target>/main and <target>/plant are apart, neither inside the other" "$(yn apart "$CT" "$PLANT_TARGET")"
    echo "command: CARGO_TARGET_DIR=<target>/main cargo test -p emend --features charts --lib $CH_MOD (host, the main tree, after the plants)"
    CARGO_TARGET_DIR=$CT cargo test -p emend --features charts --lib "$CH_MOD" >"$B/after-plants-crate.out" 2>&1 </dev/null
    echo "$?" >"$B/after-plants-crate.rc"
    echo "  exit: $(cat "$B/after-plants-crate.rc")"
    LC_ALL=C "$G" -a -E '^test result: ' "$B/after-plants-crate.out" | sed 's/^/    /'
    failed_names "$B/after-plants-crate.out"
    LC_ALL=C "$G" -a -E '^test .* \.\.\. ok$' "$B/after-plants-crate.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | LC_ALL=C sort >"$B/after-plants-crate.names"
    LC_ALL=C "$G" -F "$CH_MOD" "$B/f-host-charts.names" | LC_ALL=C sort >"$B/before-plants-crate.names"
    echo "command: CARGO_TARGET_DIR=<target>/main cargo test -p emend-copy --test null_rewrite the_charts_sample_ (host, the main tree, after the plants)"
    CARGO_TARGET_DIR=$CT cargo test -p emend-copy --test null_rewrite the_charts_sample_ >"$B/after-plants-tool.out" 2>&1 </dev/null
    echo "$?" >"$B/after-plants-tool.rc"
    echo "  exit: $(cat "$B/after-plants-tool.rc")"
    LC_ALL=C "$G" -a -E '^test .* \.\.\. |^test result: ' "$B/after-plants-tool.out" | sed 's/^/    /'
    failed_names "$B/after-plants-tool.out"
    ntool_after=$(count_matches -E '^test the_charts_sample_[a-z0-9_]+ \.\.\. ok$' "$B/after-plants-tool.out")
    echo "  chart tests passed after the plants: $(count_lines "$B/after-plants-crate.names") (before them, in F's host charts run: $(count_lines "$B/before-plants-crate.names")); tool sample tests passed: $ntool_after (the_charts_sample_ tests in null_rewrite.rs at the phase commit: $ntool)"
    after_plants_ok() {
      [ "$(cat "$B/after-plants-crate.rc")" = 0 ] && [ "$(cat "$B/after-plants-tool.rc")" = 0 ] &&
        [ "$(count_lines "$B/after-plants-crate.names")" -ge 1 ] &&
        cmp -s "$B/after-plants-crate.names" "$B/before-plants-crate.names" && [ "$ntool_after" = "$ntool" ]
    }
    check "control: after the plants the main tree's chart tests and tool sample tests pass, the same names as before them, so no mutant leaked into the main tree's artifacts" "$(yn after_plants_ok)"
    printf 'no such text\n' >"$B/c-plant.rs"
    check "control: plant_apply finds P1's text 0 times in a file without it" "$(yn [ "$(plant_apply P1 "$B/c-plant.rs")" = 0 ])"
    check "control: the file without the text is left as it was" "$(yn [ "$(cat "$B/c-plant.rs")" = 'no such text' ])"
    printf 'test a::x ... ok\ntest a::y ... FAILED\n' >"$B/plant-ctl-crate.out"
    printf 'test t_z ... FAILED\n' >"$B/plant-ctl-tool.out"
    check "control: got_failed reads one crate and one tool failure, sorted" "$(yn [ "$(got_failed ctl | tr '\n' ' ')" = "crate|a::y tool|t_z " ])"
    echo 101 >"$B/plant-ctl-crate.rc"; echo 0 >"$B/plant-ctl-tool.rc"
    check "control: rc_agrees refuses a run that failed a test and exited 0" "$(ynnot rc_agrees ctl tool)"
    check "control: rc_agrees takes a run that failed a test and exited non-zero" "$(yn rc_agrees ctl crate)"
    printf 'error: could not compile `emend` (lib test) due to 1 previous error\n' >"$B/plant-ctl2-crate.out"
    check "control: ran_ok refuses an output that did not compile" "$(ynnot ran_ok ctl2 crate)"
    printf 'test result: FAILED. 1 passed; 1 failed\n' >>"$B/plant-ctl-crate.out"
    check "control: ran_ok takes an output with a test result line" "$(yn ran_ok ctl crate)"
    printf 'crate|a::y\n' >"$B/c-want"; printf 'crate|a::y\ntool|t_z\n' >"$B/c-got"
    check "control: the set comparison refuses a failure the table does not expect" "$(ynnot cmp -s "$B/c-got" "$B/c-want")"
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.out; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's log directory, its record pairs or specs/0034 modified: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's log directory, its untracked record pairs or specs/0034 modified (changes TB, WB and XR)" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/test.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

