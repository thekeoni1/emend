    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv" >"$B/order"
    manifest_rows=$(count_lines "$B/order")
    n_regular=$(find "$CORPUS/corpus" -maxdepth 1 -type f | wc -l)
    echo "command: awk over <corpus>/manifest.tsv's id and ext columns by header name; find <corpus>/corpus -maxdepth 1 -type f"
    echo "  manifest rows: $manifest_rows; regular files under <corpus>/corpus: $n_regular"
    check "the manifest names one workbook per regular file of the corpus directory" "$(yn [ "$manifest_rows" = "$n_regular" ])"
    check "the manifest names some workbook" "$(yn [ "$manifest_rows" -ge 1 ])"
    : >"$B/chain-ids"
    while IFS="$TAB" read -r id ext; do
      if [ "$(python3 -I -B -c 'import sys, zipfile; print(1 if "xl/calcChain.xml" in zipfile.ZipFile(sys.argv[1]).namelist() else 0)' "$CORPUS/corpus/$id.$ext")" = 1 ]; then
        printf '%s\n' "$id" >>"$B/chain-ids"
      fi
    done <"$B/order"
    N_CHAIN=$(count_lines "$B/chain-ids")
    echo "command: python3 -I -B -c <zipfile namelist> <corpus>/corpus/<id>.<ext>, for each manifest row"
    echo "  corpus workbooks holding xl/calcChain.xml: $N_CHAIN of $manifest_rows (ids: $(paste -sd' ' "$B/chain-ids"))"
    echo "  the rule covering them (change NSI): the sample writes no cell, so each calcChain entry is identical and unflagged on both labels, and none is dropped"
    check "some corpus workbook holds a calculation chain, so the chain rows below are read" "$(yn [ "$N_CHAIN" -ge 1 ])"
    
    echo
    echo "## the run log's own check (python3 -I -B with zipfile and ElementTree; change NUC)"
    cp "$SELF_DIR/chartscmp.py" "$B/chartscmp.py" || exit 2
    echo "command: cp <scripts>/chartscmp.py <work>/chartscmp.py; sed 's/^/    /' <work>/chartscmp.py; sha256 $(sha_of "$B/chartscmp.py"), $(wc -c <"$B/chartscmp.py") bytes"
    check "the copy of chartscmp.py is the file beside this script, byte for byte" "$(yn cmp -s "$SELF_DIR/chartscmp.py" "$B/chartscmp.py")"
    sed 's/^/    /' "$B/chartscmp.py"
    FLAGS="entries_same chart_rule"
    # flags_of_cmp <check> <mode>: its FLAGS_OF entry, read from its source
    # with ast.
    flags_of_cmp() {
      python3 -I -B -c 'import ast, sys
    tree = ast.parse(open(sys.argv[1]).read())
    for node in tree.body:
        if isinstance(node, ast.Assign) and getattr(node.targets[0], "id", "") == "FLAGS_OF":
            print(" ".join(ast.literal_eval(node.value)[sys.argv[2]]))' "$1" "$2"
    }
    echo "  charts: chartscmp.py's FLAGS_OF, read from its source: $(flags_of_cmp "$B/chartscmp.py" charts)"
    check "this log's flag list is the check's" "$(yn [ "$(flags_of_cmp "$B/chartscmp.py" charts)" = "$FLAGS" ])"
    printf 'FLAGS_OF = {"charts": ("rest_same",)}\n' >"$B/c-flags.py"
    check "control: the same reader gives another list for a planted source" "$(yn [ "$(flags_of_cmp "$B/c-flags.py" charts)" = rest_same ])"
    echo "command: python3 -I -B <work>/chartscmp.py --selftest (the tool test's fictional workbook built in memory, against the line that test asserts; each check against a planted difference)"
    python3 -I -B "$B/chartscmp.py" --selftest >"$B/selftest-chartscmp.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/selftest-chartscmp.out"
    selftest_all() { [ "$(count_matches -E ': yes$' "$B/selftest-chartscmp.out")" = 19 ] && [ "$(count_lines "$B/selftest-chartscmp.out")" = 19 ]; }
    check "every one of chartscmp.py's 19 self-test lines reads yes (changes NUC and NUL)" "$(yn selftest_all)"
    printf 'a: yes\nb: no\n' >"$B/c-selftest.out"
    selftest_ctl() { [ "$(count_matches -E ': yes$' "$B/c-selftest.out")" = 1 ]; }
    check "control: the same count reads one yes of two in a planted output" "$(yn selftest_ctl)"
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    # all_yes <check line>: every flag of the check yes.
    all_yes() { local f; for f in $FLAGS; do [ "$(kv "$1" "$f")" = yes ] || return 1; done; }
    # The charts tool's keys, in its order (tools/emend-copy, --charts-sample,
    # every field); the check prints the same keys first, then its own four
    # (changes NUC and NUL). P1_KEYS: the keys of P1's line, in its order
    # (change NUJ).
    COUNT_KEYS="sheets charts plots kind_bar kind_line kind_pie kind_doughnut kind_scatter kind_other combined bar_dir_bar bar_dir_col grouping_clustered grouping_stacked grouping_standard grouping_percent series name_ref name_text unnamed cat_ref cat_lit val_ref val_lit sizes cached fills smooth markers labels titles auto_title_deleted axes axis_cat axis_val axis_other axis_titles axis_numfmt axis_bounds axis_deleted gridlines legends pivot_charts styles anchor_two anchor_one anchor_abs edit_as_onecell edit_as_twocell edit_as_abs"
    DIGEST_KEYS="digest_titles digest_names digest_formulas digest_numfmts digest_sources"
    KEYS="$COUNT_KEYS $DIGEST_KEYS"
    P1_KEYS="sheets charts plots kind_bar kind_line kind_pie kind_doughnut kind_scatter kind_other combined bar_dir_bar bar_dir_col grouping_clustered grouping_stacked grouping_standard grouping_percent series name_ref name_text unnamed cat_ref cat_lit val_ref val_lit sizes cached fills smooth markers labels titles auto_title_deleted anchor_two anchor_one anchor_abs edit_as_onecell edit_as_twocell edit_as_abs digest_titles digest_names digest_formulas"
    CHECK_KEYS="drawings chart_rels typed largest_chart"
    KIND_KEYS="kind_bar kind_line kind_pie kind_doughnut kind_scatter kind_other"
    # keys_agree <keys> <tool line> <check line>: every key the same.
    keys_agree() {
      local k
      for k in $1; do
        [ -n "$(kv "$3" "$k")" ] || return 1
        [ "$(kv "$2" "$k")" = "$(kv "$3" "$k")" ] || return 1
      done
    }
    tool_and_cmp() { keys_agree "$KEYS" "$1" "$2"; }
    # line_as_spec <tool line>: what "Harness runs" asks of the charts line
    # for every field: the word charts and the keys in the tool's order, each
    # count a number, each of the five digests sixteen lower-case hex digits;
    # the six kind counts summing to plots, name_ref, name_text and unnamed to
    # series, and axis_cat, axis_val and axis_other to axes, as the tool
    # asserts (changes NUC and NUL).
    line_as_spec() {
      local n got sum=0
      [ "$(printf '%s' "$1" | cut -f1)" = charts ] || return 1
      got=$(printf '%s' "$1" | cut -f2- | tr '\t' '\n' | sed 's/=.*//' | tr '\n' ' ')
      [ "$got" = "$KEYS " ] || return 1
      for n in $COUNT_KEYS; do
        case "$(kv "$1" "$n")" in '' | *[!0-9]*) return 1 ;; esac
      done
      for n in $DIGEST_KEYS; do
        printf '%s' "$(kv "$1" "$n")" | LC_ALL=C "$G" -qxE '[0-9a-f]{16}' || return 1
      done
      for n in $KIND_KEYS; do sum=$((sum + $(kv "$1" "$n"))); done
      [ "$sum" = "$(kv "$1" plots)" ] || return 1
      [ "$(( $(kv "$1" name_ref) + $(kv "$1" name_text) + $(kv "$1" unnamed) ))" = "$(kv "$1" series)" ] || return 1
      [ "$(( $(kv "$1" axis_cat) + $(kv "$1" axis_val) + $(kv "$1" axis_other) ))" = "$(kv "$1" axes)" ]
    }
    # kinds_of <id> <label>: sheet_charts of M5 part 2 P3's kinds run's line
    # for the workbook on that label (change NUD).
    kinds_of() { [ -f "$KINDS_RUN/$1/stdout.$2.txt" ] && kv "$(cat "$KINDS_RUN/$1/stdout.$2.txt")" sheet_charts; }
    # kinds_holds <tool line> <id> <label>: the spec's expected result per
    # workbook, the charts line's charts equal to the kinds line's
    # sheet_charts on the same label (change NUD).
    kinds_holds() {
      local k
      k=$(kinds_of "$2" "$3") || return 1
      [ -n "$k" ] && [ -n "$(kv "$1" charts)" ] && [ "$(kv "$1" charts)" = "$k" ]
    }
    # p1_of <id> <label>: P1's run line for the workbook on that label
    # (change NUJ).
    p1_of() { [ -f "$P1_RUN/$1/stdout.$2.txt" ] && cat "$P1_RUN/$1/stdout.$2.txt"; }
    # p1_holds <tool line> <id> <label>: P1's line holds exactly P1's keys, in
    # its order, and each has the same value in the tool's line (change NUJ).
    p1_holds() {
      local p k got
      p=$(p1_of "$2" "$3") || return 1
      [ "$(printf '%s' "$p" | cut -f1)" = charts ] || return 1
      got=$(printf '%s' "$p" | cut -f2- | tr '\t' '\n' | sed 's/=.*//' | tr '\n' ' ')
      [ "$got" = "$P1_KEYS " ] || return 1
      for k in $P1_KEYS; do
        [ -n "$(kv "$1" "$k")" ] || return 1
        [ "$(kv "$p" "$k")" = "$(kv "$1" "$k")" ] || return 1
      done
    }
    check "control: all_yes refuses a line with no flags" "$(ynnot all_yes "found=1")"
    # tool_line_of <check>: the TOOL_LINE the check's source holds, the tool
    # test's line with its digests computed there.
    tool_line_of() {
      python3 -I -B -c 'import importlib.util, sys
    spec = importlib.util.spec_from_file_location("chk", sys.argv[1])
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    print(m.TOOL_LINE)' "$1"
    }
    LINE_C=$(tool_line_of "$B/chartscmp.py")
    echo "  the charts tool test's line, as chartscmp.py's TOOL_LINE holds it (its digests computed there): $(printf '%s' "$LINE_C" | tr '\t' ' ')"
    check "control: line_as_spec accepts the charts tool test's line" "$(yn line_as_spec "$LINE_C")"
    for bad in "s/charts=2/charts=x/" "s/kind_bar=1/kind_bar=2/" "s/name_ref=1/name_ref=2/" \
               "s/digest_titles=[0-9a-f]*/digest_titles=0/" "s/\tlabels=1//" "s/^charts/pivots/" \
               "s/axis_cat=1/axis_cat=2/" "s/digest_sources=[0-9a-f]*/digest_sources=0/" "s/\tstyles=2//"; do
      lin_ctl() { line_as_spec "$(printf '%s' "$LINE_C" | sed "$bad")"; }
      check "control: line_as_spec refuses the line changed by $bad" "$(ynnot lin_ctl)"
    done
    CMP_C="$(printf '%s' "$LINE_C" | cut -f2- | tr '\t' ' ') drawings=1 chart_rels=2 typed=2 largest_chart=1 entries_same=yes chart_rule=yes"
    check "control: tool_and_cmp accepts a pair that agrees" "$(yn tool_and_cmp "$LINE_C" "$CMP_C")"
    tac_ctl() { tool_and_cmp "$LINE_C" "$(printf '%s' "$CMP_C" | sed 's/series=3/series=4/')"; }
    check "control: tool_and_cmp refuses a pair whose series disagree" "$(ynnot tac_ctl)"
    tac_ctl2() { tool_and_cmp "$LINE_C" "$(printf '%s' "$CMP_C" | sed 's/digest_formulas=[0-9a-f]*/digest_formulas=0000000000000000/')"; }
    check "control: tool_and_cmp refuses a pair whose formula digests disagree" "$(ynnot tac_ctl2)"
    tac_ctl3() { tool_and_cmp "$LINE_C" "$(printf '%s' "$CMP_C" | sed 's/ markers=1//')"; }
    check "control: tool_and_cmp refuses a check line missing a key" "$(ynnot tac_ctl3)"
    tac_ctl4() { tool_and_cmp "$LINE_C" "$(printf '%s' "$CMP_C" | sed 's/digest_numfmts=[0-9a-f]*/digest_numfmts=0000000000000000/')"; }
    check "control: tool_and_cmp refuses a pair whose number format digests disagree (change NUL)" "$(ynnot tac_ctl4)"
    tac_ctl5() { tool_and_cmp "$LINE_C" "$(printf '%s' "$CMP_C" | sed 's/legends=1/legends=0/')"; }
    check "control: tool_and_cmp refuses a pair whose legends disagree (change NUL)" "$(ynnot tac_ctl5)"
    mkdir -p "$B/c-kinds/w" "$B/c-kinds/v"
    printf 'kinds\tcharts=2\tsheets=1\tsheet_charts=2\tsheet_tables=0\n' >"$B/c-kinds/w/stdout.host.txt"
    printf 'kinds\tcharts=2\tsheets=1\tsheet_charts=1\tsheet_tables=0\n' >"$B/c-kinds/v/stdout.host.txt"
    kh_yes() { local KINDS_RUN=$B/c-kinds; kinds_holds "$LINE_C" w host; }
    check "control: kinds_holds accepts the tool test's line against a planted kinds line of two sheet charts" "$(yn kh_yes)"
    kh_one() { local KINDS_RUN=$B/c-kinds; kinds_holds "$LINE_C" v host; }
    check "control: kinds_holds refuses it against a planted kinds line of one sheet chart" "$(ynnot kh_one)"
    kh_none() { local KINDS_RUN=$B/c-kinds; kinds_holds "$LINE_C" w i686; }
    check "control: kinds_holds refuses it where the kinds run holds no line for the label" "$(ynnot kh_none)"
    # The P1 controls: a planted P1 run whose line is the tool test's line's
    # P1 keys, then the same with one value changed (change NUJ).
    mkdir -p "$B/c-p1/w" "$B/c-p1/v"
    p1_line_of() { local k out=charts; for k in $P1_KEYS; do out="$out$TAB$k=$(kv "$1" "$k")"; done; printf '%s\n' "$out"; }
    p1_line_of "$LINE_C" >"$B/c-p1/w/stdout.host.txt"
    p1_line_of "$LINE_C" | sed 's/series=3/series=4/' >"$B/c-p1/v/stdout.host.txt"
    p1_yes() { local P1_RUN=$B/c-p1; p1_holds "$LINE_C" w host; }
    check "control: p1_holds accepts the tool test's line against a planted P1 line of its own P1 keys" "$(yn p1_yes)"
    p1_one() { local P1_RUN=$B/c-p1; p1_holds "$LINE_C" v host; }
    check "control: p1_holds refuses it against a planted P1 line whose series differ" "$(ynnot p1_one)"
    p1_none() { local P1_RUN=$B/c-p1; p1_holds "$LINE_C" w i686; }
    check "control: p1_holds refuses it where P1's run holds no line for the label" "$(ynnot p1_none)"
    p1_short() { local P1_RUN=$B/c-p1 P1_KEYS="$P1_KEYS styles"; p1_holds "$LINE_C" w host; }
    check "control: p1_holds refuses a P1 line whose keys are not P1's list" "$(ynnot p1_short)"
    
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    # count_ok_where <summary> <column> <value>: among the rows whose outcome is ok.
    count_ok_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) { if ($i == c) k = i; if ($i == "outcome") o = i }; next } k && o && $o == "ok" && $k == v { n++ } END { print n + 0 }' "$1"; }
    sum_col() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { n += $k } END { print n + 0 }' "$1"; }
    # status_rows <entries> <status>: the entry rows of that status, every
    # workbook.
    status_rows() { awk -F'\t' -v s="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "status") k = i; next } k && $k == s { n++ } END { print n + 0 }' "$1"; }
    # entries_named <entries> <id>: the runner's rows for one workbook as
    # "Harness runs" gives them for the kinds sample (change NSO, carried): every
    # row identical and unflagged, some row there; nothing changed, added,
    # dropped or recompressed.
    entries_named() {
      awk -F'\t' -v id="$2" '
        NR == 1 { for (c = 1; c <= NF; c++) k[$c] = c; next }
        $k["id"] != id { next }
        { n++; if ($k["status"] != "identical" || $k["flags"] != "") bad++ }
        END { if (n == 0 || bad > 0) exit 1 }' "$1"
    }
    # chain_rows_of <entries> <id>: the workbook's calcChain rows, those
    # identical and unflagged, and those dropped (change NSI).
    chain_rows_of() {
      awk -F'\t' -v id="$2" '
        NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next }
        $col["id"] == id && $col["name"] == "xl/calcChain.xml" { n++; if ($col["status"] == "identical" && $col["flags"] == "") s++; if ($col["status"] == "dropped") d++ }
        END { print n + 0, s + 0, d + 0 }' "$1"
    }
    # The rule's controls: accepted where it holds, refused on each planted row
    # where it does not (change NSO).
    etsv() { { printf 'id\tname\tstatus\tflags\n'; printf "$@"; } >"$B/ce.tsv"; }
    en_yes() { entries_named "$B/ce.tsv" w; }
    etsv 'w\txl/styles.xml\tidentical\t\nw\t[Content_Types].xml\tidentical\t\nw\txl/workbook.xml\tidentical\t\n'
    check "control: entries_named accepts every row identical and unflagged" "$(yn en_yes)"
    etsv 'w\txl/styles.xml\tchanged\t\nw\txl/workbook.xml\tidentical\t\n'
    check "control: entries_named refuses a changed row" "$(ynnot en_yes)"
    etsv 'w\txl/styles.xml\tidentical\tdescriptor\nw\txl/workbook.xml\tidentical\t\n'
    check "control: entries_named refuses an identical row flagged" "$(ynnot en_yes)"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\trecompressed\t\n'
    check "control: entries_named refuses a recompressed row" "$(ynnot en_yes)"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/planted.xml\tadded\t\n'
    check "control: entries_named refuses an added row" "$(ynnot en_yes)"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\tdropped\t\n'
    check "control: entries_named refuses a dropped row" "$(ynnot en_yes)"
    etsv 'v\txl/styles.xml\tidentical\t\n'
    check "control: entries_named refuses a workbook with no rows" "$(ynnot en_yes)"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\tidentical\t\n'
    check "control: chain_rows_of reads the planted workbook's one calcChain row, identical and unflagged" "$(yn [ "$(chain_rows_of "$B/ce.tsv" w)" = "1 1 0" ])"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\tdropped\t\n'
    check "control: chain_rows_of reads a dropped calcChain row as dropped" "$(yn [ "$(chain_rows_of "$B/ce.tsv" w)" = "1 0 1" ])"
    # refusal_of <run dir> <id> <label>: the layer's one "error: " line when the
    # row is a refusal, else nothing.
    refusal_of() { sed -n '1s/^error: //p' "$1/$2/stderr.$3.txt"; }
    
    
    echo
    # same_row <run dir> <earlier run dir> <id> <ext> <label>: the row's output
    # and its tool line in the two run directories, both there, the same by
    # sha256 (changes NSY and NTX; carried by change NUP).
    same_row() {
      local f
      for f in "out.$5.$4" "stdout.$5.txt"; do
        [ -f "$1/$3/$f" ] && [ -f "$2/$3/$f" ] || return 1
        [ "$(sha_of "$1/$3/$f")" = "$(sha_of "$2/$3/$f")" ] || return 1
      done
    }
    mkdir -p "$B/c-ident/a/w" "$B/c-ident/b/w" "$B/c-ident/c/w" "$B/c-ident/d/w"
    printf 'pk' >"$B/c-ident/a/w/out.host.xlsx"; printf 'line\n' >"$B/c-ident/a/w/stdout.host.txt"
    cp "$B/c-ident/a/w/out.host.xlsx" "$B/c-ident/a/w/stdout.host.txt" "$B/c-ident/b/w/"
    cp "$B/c-ident/a/w/out.host.xlsx" "$B/c-ident/c/w/"; printf 'line2\n' >"$B/c-ident/c/w/stdout.host.txt"
    cp "$B/c-ident/a/w/stdout.host.txt" "$B/c-ident/d/w/"
    check "control: the planted differing line differs from the original (cmp)" "$(ynnot cmp -s "$B/c-ident/a/w/stdout.host.txt" "$B/c-ident/c/w/stdout.host.txt")"
    check "control: same_row accepts two planted rows the same byte for byte" "$(yn same_row "$B/c-ident/a" "$B/c-ident/b" w xlsx host)"
    check "control: same_row refuses a planted row whose line differs" "$(ynnot same_row "$B/c-ident/a" "$B/c-ident/c" w xlsx host)"
    check "control: same_row refuses a planted row with no output" "$(ynnot same_row "$B/c-ident/a" "$B/c-ident/d" w xlsx host)"
    # prevrec.py <run dir> <record .txt>: the earlier run directory's summaries,
    # every label's in order, against the summary table, the first of three, of
    # that run's committed record (changes NSY and NTX; carried by change NUP).
    cat >"$B/prevrec.py" <<'PY'
    import os
    import sys
    
    sys.dont_write_bytecode = True
    run_dir, txt = sys.argv[1:3]
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    summary = []
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        summary += s[1:]
    tables = "\n".join(lines(txt)).split("\n\n")
    ok = len(labels) == 2 and len(tables) == 3 and tables[0].split("\n") == summary
    print("labels %s; summary rows %d; the record's summary table is the run directory's: %s" % (",".join(labels), len(summary) - 1, "yes" if ok else "no"))
    PY
    echo "command: <work>/prevrec.py <earlier run directory> <its committed record's .txt>; the program:"
    sed 's/^/    /' "$B/prevrec.py"
    
    echo
    echo "## TMPDIR for the corpus runs, on the disk"
    RUNTMP=$B/tmp-run
    mkdir "$RUNTMP" || exit 2
    dev_tmp=$(stat -c %d "$RUNTMP")
    dev_corpus=$(stat -c %d "$CORPUS/corpus")
    dev_proc=$(stat -c %d /proc)
    echo "command: mkdir <work>/tmp-run; stat -c %d <work>/tmp-run <corpus>/corpus /proc; df --output=fstype,target <work>/tmp-run <corpus>/corpus"
    echo "  device of TMPDIR (<work>/tmp-run): $dev_tmp; of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    df --output=fstype,target "$RUNTMP" "$CORPUS/corpus" | sed 's/^/    /'
    check "TMPDIR for the corpus runs and the corpus directory are on one device" "$(yn [ "$dev_tmp" = "$dev_corpus" ])"
    check "control: the same comparison tells /proc's device from the corpus directory's" "$(yn [ "$dev_proc" != "$dev_corpus" ])"
    
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names. Change VJ: the dropped families are an
    input, as the changed and added ones are."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, want_changed, want_added, want_dropped, tool_arg = sys.argv[1:9]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    def listed(value):
        return value.split(",") if value else []
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        changed_f = sorted(f for f in fam if fam[f].get("changed"))
        dropped_f = sorted(f for f in fam if fam[f].get("dropped"))
        added_f = sorted(f for f in fam if fam[f].get("added"))
        checks.append(("%s: the xml families are the changed entries' families" % label, sorted(xf) == changed_f))
        checks.append(("%s: the changed entries' families are %s" % (label, want_changed or "none"), changed_f == listed(want_changed)))
        checks.append(("%s: the dropped entries' families are %s" % (label, want_dropped or "none"), dropped_f == listed(want_dropped)))
        checks.append(("%s: the added entries' families are %s" % (label, want_added or "none"), added_f == listed(want_added)))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: " + tool_arg in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    fams_of() {
      python3 -I -B -c 'import importlib.util, sys
    spec = importlib.util.spec_from_file_location("record", sys.argv[1])
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    rows = [l.split("\t", 1) for l in open(sys.argv[2]).read().split("\n") if l]
    print(",".join(sorted({record.family(n) for (k, n) in rows if k == sys.argv[3]})))' scripts/passthrough-record.py "$1" "$2"
    }
    inst_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
    # Change JI: no bytecode was written, so there is nothing to remove.
    no_pycache() { [ ! -e scripts/__pycache__ ]; }
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      echo
      echo "## $SAMPLE: $label run, --tool-arg $EDIT"
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <work>/bin/$label/emend-copy --xlsx-diff <work>/bin/$label/xlsx-diff --out <runs>/$RUN-$SAMPLE --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$O" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
        >"$B/run-$label.stdout" 2>"$B/run-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$label.stderr")"
      sed 's/^/    /' "$B/run-$label.stdout"
      check "$label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$label: its stderr is empty" "$(yn [ ! -s "$B/run-$label.stderr" ])"
      n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
      echo "  entries left in <work>/tmp-run after the run: $n_left"
      check "$label: the runs' TMPDIR is empty after the run" "$(yn [ "$n_left" = 0 ])"
      SUM=$O/summary.$label.tsv
      ENT=$O/entries.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      n_ok=$(count_where "$SUM" outcome ok)
      # The refusals, by id and message.
      : >"$B/refused-$label"
      while IFS="$TAB" read -r id ext; do
        if [ "$(awk -F'\t' -v id="$id" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id { print $k["outcome"] " " $k["exit"] }' "$SUM")" = "error 2" ] \
           && [ "$(count_lines "$O/$id/stderr.$label.txt")" = 1 ] && [ -n "$(refusal_of "$O" "$id" "$label")" ]; then
          printf '%s\t%s\n' "$id" "$(refusal_of "$O" "$id" "$label")" >>"$B/refused-$label"
        fi
      done <"$B/order"
      n_ref=$(count_lines "$B/refused-$label")
      echo "  summary rows: $rows; outcome ok: $n_ok; refused by the layer (a finding; fails the summary): $n_ref"
      sed 's/^/    refused: /' "$B/refused-$label"
      echo "  among the ok rows: lo ok $(count_ok_where "$SUM" lo ok); lo_in ok $(count_ok_where "$SUM" lo_in ok); leftover no $(count_ok_where "$SUM" leftover no); order_preserved yes $(count_ok_where "$SUM" order_preserved yes); comment_equal yes $(count_ok_where "$SUM" comment_equal yes); files_identical yes $(count_ok_where "$SUM" files_identical yes), no $(count_ok_where "$SUM" files_identical no) (asserted below; change NSO)"
      echo "  every row: lo_in ok $(count_where "$SUM" lo_in ok); leftover no $(count_where "$SUM" leftover no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      echo "  the entries table's rows by status: identical $(status_rows "$ENT" identical), recompressed $(status_rows "$ENT" recompressed), changed $(status_rows "$ENT" changed), dropped $(status_rows "$ENT" dropped), added $(status_rows "$ENT" added)"
      # The totals the ok rows imply by the rule (change NSO): nothing changed.
      echo "  the entry totals the ok rows imply: changed 0, added 0, dropped 0, none recompressed, files_identical yes in every ok row"
      summary_ok() {
        local col st
        [ "$rows" = "$manifest_rows" ] || return 1
        [ "$n_ok" = "$rows" ] && [ "$n_ref" = 0 ] || return 1
        for col in "lo ok" "lo_in ok" "leftover no" "order_preserved yes" "comment_equal yes" "files_identical yes"; do
          [ "$(count_ok_where "$SUM" ${col% *} ${col#* })" = "$n_ok" ] || return 1
        done
        [ "$(count_where "$SUM" lo_in ok)" = "$rows" ] || return 1
        [ "$(count_where "$SUM" leftover no)" = "$rows" ] || return 1
        for st in changed added dropped recompressed flagged; do
          [ "$(sum_col "$SUM" "$st")" = 0 ] || return 1
        done
        for st in identical recompressed changed dropped added; do
          [ "$(sum_col "$SUM" "$st")" = "$(status_rows "$ENT" "$st")" ] || return 1
        done
      }
      check "$label: every row ok; every row's input opens (lo_in ok) with no leftover; every output opens (lo ok), order and comment kept, files_identical yes; nothing changed, added, dropped, recompressed or flagged; the summary's status totals the entries table's" "$(yn summary_ok)"
      echo "  per ok workbook: id, the tool's line, the check's line (counts and flags only)"
      : >"$B/lines-$label"
      : >"$B/cmp-$label"
      nwb=0; nflags=0; nagree=0; nline=0; nentries=0; nspec=0; ncmperr=0; np1=0
      nchain=0; nchain_same=0; nchain_drop=0
      while IFS="$TAB" read -r id ext; do
        if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$label")" ]; then continue; fi
        nwb=$((nwb + 1))
        e=$(cat "$O/$id/stdout.$label.txt")
        c=$(python3 -I -B "$B/chartscmp.py" charts "$CORPUS/corpus/$id.$ext" "$O/$id/out.$label.$ext")
        printf '%s\t%s\n' "$id" "$e" >>"$B/lines-$label"
        printf '%s\t%s\n' "$id" "$c" >>"$B/cmp-$label"
        printf '    %s %s\n' "$id" "$(printf '%s' "$e" | tr '\t' ' ')"
        printf '    %s cmp %s\n' "$id" "$c"
        if LC_ALL=C "$G" -qxF "$id" "$B/chain-ids"; then
          cr=$(chain_rows_of "$ENT" "$id")
          set -- $cr
          nchain=$((nchain + $1)); nchain_same=$((nchain_same + $2)); nchain_drop=$((nchain_drop + $3))
        fi
        if [ -z "$(kv "$c" error)" ]; then :; else ncmperr=$((ncmperr + 1)); echo "    $id: the check could not read the workbook ($(kv "$c" error))"; fi
        if all_yes "$c"; then nflags=$((nflags + 1)); else echo "    $id: a flag of the check does not hold"; fi
        if tool_and_cmp "$e" "$c"; then nagree=$((nagree + 1)); else echo "    $id: the tool and the check disagree"; fi
        if line_as_spec "$e"; then nline=$((nline + 1)); else echo "    $id: the tool's line is not what the spec reads"; fi
        if entries_named "$ENT" "$id"; then nentries=$((nentries + 1)); else echo "    $id: the entry rows are not what the rule gives"; fi
        if kinds_holds "$e" "$id" "$label"; then nspec=$((nspec + 1)); else echo "    FINDING (the spec's expected result; change NUD): $id: charts $(kv "$e" charts) against the kinds sample's sheet_charts $(kinds_of "$id" "$label")"; fi
        if p1_holds "$e" "$id" "$label"; then np1=$((np1 + 1)); else echo "    FINDING (the P1 fields unchanged from P1's record; change NUJ): $id: a P1 field of the line is not P1's run line's"; fi
      done <"$B/order"
      echo "  ok workbooks read: $nwb; every flag holds: $nflags; the tool and the check agree (every key): $nagree; the line as the spec reads: $nline; entry rows as the rule gives: $nentries; the spec's expected results hold: $nspec; the P1 fields as P1's run: $np1; workbooks the check could not read: $ncmperr"
      check "$label: the check read every ok workbook" "$(yn [ "$nwb" = "$n_ok" ])"
      check "$label: the check could read every ok workbook" "$(yn [ "$ncmperr" = 0 ])"
      check "$label: every flag of the check holds in every ok workbook (every entry the input's; the chart rule)" "$(yn [ "$nflags" = "$n_ok" ])"
      check "$label: the tool's every key is the check's own in every ok workbook, the five digests among them (changes NUC and NUL)" "$(yn [ "$nagree" = "$n_ok" ])"
      check "$label: every line is what the spec reads" "$(yn [ "$nline" = "$n_ok" ])"
      check "$label: every ok workbook's entry rows are as the rule gives (change NSO)" "$(yn [ "$nentries" = "$n_ok" ])"
      kinds_all() { [ "$nspec" = "$n_ok" ] && [ "$nspec" = "$manifest_rows" ]; }
      check "$label: the charts line's charts is the kinds sample's sheet_charts in every workbook, $nspec of $manifest_rows, no finding (the spec's expected result; change NUD)" "$(yn kinds_all)"
      p1_all() { [ "$np1" = "$n_ok" ] && [ "$np1" = "$manifest_rows" ]; }
      check "$label: every line's P1 fields are P1's run line's, $np1 of $manifest_rows, no finding (the P1 fields unchanged from P1's record; change NUJ)" "$(yn p1_all)"
      echo "  calcChain rows in the ok rows of the chain workbooks: $nchain; identical and unflagged: $nchain_same; dropped: $nchain_drop (change NSI)"
      chain_kept() { [ "$nchain" = "$N_CHAIN" ] && [ "$nchain_same" = "$nchain" ] && [ "$nchain_drop" = 0 ]; }
      check "$label: every chain workbook has one calcChain row, identical and unflagged, none dropped (change NSI)" "$(yn chain_kept)"
      R=$O/run.$label.tsv
      args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$R")
      bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
      check "$label: the run row records the size log's two release binaries by sha256 and the phase commit (change NUO)" "$(yn bins_in_row)"
      check "$label: the run row's tool_args is $EDIT" "$(yn [ "$args" = "$EDIT" ])"
    done
    check "the same workbooks are refused on both targets, with the same messages (none)" "$(yn cmp -s "$B/refused-host" "$B/refused-i686")"
    cp "$B/refused-host" "$B/c-refused"; printf 'x\tsome message\n' >>"$B/c-refused"
    check "control: the same comparison tells a planted refusal list from the host's" "$(ynnot cmp -s "$B/c-refused" "$B/refused-i686")"
    mkdir -p "$B/c-refrun/r1"
    printf 'error: a planted message\n' >"$B/c-refrun/r1/stderr.host.txt"
    ref_read() { [ "$(refusal_of "$B/c-refrun" r1 host)" = "a planted message" ]; }
    check "control: refusal_of reads a planted refusal's message" "$(yn ref_read)"
    : >"$B/c-refrun/r1/stderr.host.txt"
    ref_none() { [ -z "$(refusal_of "$B/c-refrun" r1 host)" ]; }
    check "control: refusal_of reads nothing from an empty standard error" "$(yn ref_none)"
    entries_ctl() {
      local id
      id=$(head -n 1 "$B/order" | cut -f1)
      entries_named "$O/entries.host.tsv" "${id}x"
    }
    check "control: entries_named refuses the first workbook's id with a letter appended, which has no rows" "$(ynnot entries_ctl)"
    
    echo
    echo "### the corpus totals over the host's ok workbooks, beside planning's figures (specs/0034 \"Harness runs\", every field; \"Planning rulings during P1\", ruling D: series 38; changes NUE and NUM)"
    # total_of <lines> <key>: the key summed over the lines (tab- or
    # space-separated pairs); wbs_of: the lines where it is above 0.
    total_of() { cut -f2- "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | awk '{ n += $1 } END { print n + 0 }'; }
    wbs_of() { cut -f2- "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | awk '$1 > 0 { n++ } END { print n + 0 }'; }
    # departures <lines> <expectations>: the keys whose total, or whose count of
    # workbooks where one is given (not "-"), is not the expected, in the
    # expectations' order, space-separated.
    departures() {
      local k t w out=""
      while read -r k t w; do
        if [ "$(total_of "$1" "$k")" != "$t" ]; then out="$out $k"; continue; fi
        if [ "$w" != - ] && [ "$(wbs_of "$1" "$k")" != "$w" ]; then out="$out $k"; fi
      done <"$2"
      printf '%s' "${out# }"
    }
    # expected <lines> <expectations> <label>: each figure beside the total,
    # a departure printed as a FINDING; n_exp and n_same counted.
    expected() {
      local k t w got gotw
      while read -r k t w; do
        n_exp=$((n_exp + 1))
        got=$(total_of "$1" "$k"); gotw=$(wbs_of "$1" "$k")
        if [ "$got" = "$t" ] && { [ "$w" = - ] || [ "$gotw" = "$w" ]; }; then
          n_same=$((n_same + 1))
          echo "  $3 $k: $got in $gotw workbooks; planning's $t$([ "$w" = - ] || echo " in $w"); the same: yes"
        else
          echo "  FINDING (planning's figure; change NUE): $3 $k: $got in $gotw workbooks; planning's $t$([ "$w" = - ] || echo " in $w")"
        fi
      done <"$2"
    }
    printf '%s\n' "charts 26 11" "plots 28 -" "combined 2 -" "series 38 -" "kind_bar 17 -" "kind_line 4 -" "kind_pie 3 -" \
      "kind_scatter 3 -" "kind_doughnut 1 -" "kind_other 0 -" "name_ref 26 -" "name_text 9 -" "unnamed 3 -" "titles 11 -" \
      "anchor_two 26 -" "edit_as_onecell 21 -" "axes 44 -" "axis_cat 20 -" "axis_val 24 -" "axis_other 0 -" \
      "legends 15 -" "pivot_charts 5 -" >"$B/planning-charts.tsv"
    n_exp=0; n_same=0
    expected "$B/lines-host" "$B/planning-charts.tsv" "charts:"
    C_DEPARTED=$(departures "$B/lines-host" "$B/planning-charts.tsv")
    echo "  the figures met: $n_same of $n_exp; the departed fields: ${C_DEPARTED:-none}"
    c_met() { [ "$n_same" = 22 ] && [ -z "$C_DEPARTED" ]; }
    check "every figure of planning's is met, the twenty-two, series 38 and axes 44 among them (ruling D; changes NUE and NUM)" "$(yn c_met)"
    c_met_ctl() { local C_DEPARTED=series; c_met; }
    check "control: the same check refuses a planted departure" "$(ynnot c_met_ctl)"
    printf 'w1\tcharts\tcharts=0\tplots=0\nw2\tcharts\tcharts=2\tplots=3\n' >"$B/c-lines.tsv"
    printf '%s\n' "charts 2 1" "plots 3 1" >"$B/c-exp1"
    printf '%s\n' "charts 0 0" "plots 3 1" >"$B/c-exp2"
    printf '%s\n' "charts 2 2" "plots 3 -" >"$B/c-exp3"
    check "control: departures reads none where planted totals and workbook counts are met" "$(yn [ -z "$(departures "$B/c-lines.tsv" "$B/c-exp1")" ])"
    check "control: departures names charts for a planted total of none" "$(yn [ "$(departures "$B/c-lines.tsv" "$B/c-exp2")" = charts ])"
    check "control: departures names charts for a planted workbook count one off" "$(yn [ "$(departures "$B/c-lines.tsv" "$B/c-exp3")" = charts ])"
    echo "  the line's other fields over the host's ok workbooks (no figure of planning's; printed, not asserted; change NUM):"
    for k in sheets bar_dir_bar bar_dir_col grouping_clustered grouping_stacked grouping_standard grouping_percent cat_ref cat_lit val_ref val_lit sizes cached fills smooth markers labels auto_title_deleted axis_titles axis_numfmt axis_bounds axis_deleted gridlines styles anchor_one anchor_abs edit_as_twocell edit_as_abs; do
      echo "    $k: $(total_of "$B/lines-host" "$k") in $(wbs_of "$B/lines-host" "$k") workbooks"
    done
    echo "  the check's own keys over the host's ok workbooks: drawings $(total_of "$B/cmp-host" drawings) in $(wbs_of "$B/cmp-host" drawings); chart_rels $(total_of "$B/cmp-host" chart_rels) in $(wbs_of "$B/cmp-host" chart_rels); typed $(total_of "$B/cmp-host" typed) in $(wbs_of "$B/cmp-host" typed)"
    rels_all_read() { [ "$(total_of "$B/cmp-host" chart_rels)" = "$(total_of "$B/lines-host" charts)" ] && [ "$(total_of "$B/cmp-host" typed)" = "$(total_of "$B/lines-host" charts)" ]; }
    check "every chart relationship of a reached drawing, and every chart part of the package, is a chart the sample read (chart_rels and typed equal to charts; change NUE)" "$(yn rels_all_read)"
    LARGEST=$(cut -f2- "$B/cmp-host" | tr '\t ' '\n\n' | sed -n 's/^largest_chart=//p' | sort -n | tail -n 1)
    echo "  the largest chart part the sample read, by bytes (the check's largest_chart over the host's ok workbooks; specs/0034 \"32-bit and streaming\"; change NUE): ${LARGEST:-none}"
    check "some chart part was read, so the largest is one's" "$(yn [ "${LARGEST:-0}" -gt 0 ])"
    
    echo
    echo "### the planted-flag controls, host, on the first ok workbook in manifest order holding a chart (change NUE)"
    first_ok=$(awk -F'\t' '{ for (i = 2; i <= NF; i++) if ($i ~ /^charts=[1-9]/) { print $1; exit } }' "$B/lines-host")
    first_ext=$(awk -F'\t' -v id="$first_ok" '$1 == id { print $2 }' "$B/order")
    echo "  the workbook: ${first_ok:-none}"
    check "some ok workbook holds a chart, so the plants act on one" "$(yn [ -n "$first_ok" ])"
    nplants=0; nbit=0
    for f in $FLAGS; do
      nplants=$((nplants + 1))
      planted=""
      if [ -n "$first_ok" ]; then
        planted=$(python3 -I -B "$B/chartscmp.py" charts "$CORPUS/corpus/$first_ok.$first_ext" "$O/$first_ok/out.host.$first_ext" --plant "$f")
      fi
      flag=$f
      turned() { [ -n "$planted" ] && [ "$(kv "$planted" "$flag")" = no ] && [ "$(kv "$planted" planted)" = yes ]; }
      echo "  plant $f on ${first_ok:-none}: planted=$(kv "$planted" planted); $flag=$(kv "$planted" "$flag")"
      if turned; then nbit=$((nbit + 1)); fi
      check "control: the plant $f turns $flag to no" "$(yn turned)"
    done
    check "every flag has a plant that turned it ($nbit of $nplants)" "$(yn [ "$nbit" = "$nplants" ])"
    unknown_plant() { [ "$(python3 -I -B "$B/chartscmp.py" charts "$CORPUS/corpus/$first_ok.$first_ext" "$O/$first_ok/out.host.$first_ext" --plant no_such_flag)" = error=unknown-plant ]; }
    check "control: the check refuses a plant it does not know" "$(yn unknown_plant)"
    # The count and digest plants: charts counted one more, and a planted title
    # digested after the others; the axes and sources plants: axes counted one
    # more, and a planted pivot source digested after the others; so the tool's
    # line and the check's no longer agree (changes NUE and NUL).
    first_line=$(awk -F'\t' -v id="$first_ok" '$1 == id { sub(/^[^\t]*\t/, ""); print }' "$B/lines-host")
    for p in count digest axes sources; do
      counted=""
      if [ -n "$first_ok" ]; then
        counted=$(python3 -I -B "$B/chartscmp.py" charts "$CORPUS/corpus/$first_ok.$first_ext" "$O/$first_ok/out.host.$first_ext" --plant "$p")
      fi
      echo "  plant $p on ${first_ok:-none}: planted=$(kv "$counted" planted); charts $(kv "$counted" charts) against the tool's $(kv "$first_line" charts); axes $(kv "$counted" axes) against the tool's $(kv "$first_line" axes); digest_titles the tool's: $([ "$(kv "$counted" digest_titles)" = "$(kv "$first_line" digest_titles)" ] && echo yes || echo no); digest_sources the tool's: $([ "$(kv "$counted" digest_sources)" = "$(kv "$first_line" digest_sources)" ] && echo yes || echo no)"
      plant_ran() { [ -n "$counted" ] && [ "$(kv "$counted" planted)" = yes ] && [ -n "$first_line" ]; }
      check "control: the $p plant ran on the workbook" "$(yn plant_ran)"
      check "control: tool_and_cmp refuses the tool's line against the $p plant's (change NUE)" "$(ynnot tool_and_cmp "$first_line" "$counted")"
    done
    echo
    echo "### the two labels' outputs"
    same_out=0
    nboth=0
    while IFS="$TAB" read -r id ext; do
      if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-host")" ]; then continue; fi
      nboth=$((nboth + 1))
      if cmp -s "$O/$id/out.host.$ext" "$O/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
    done <"$B/order"
    echo "  ok workbooks: $nboth; whose host and i686 outputs are byte for byte the same: $same_out"
    check "every output is the same on both targets" "$(yn [ "$same_out" = "$nboth" ])"
    check "both targets printed the same line for every ok workbook" "$(yn cmp -s "$B/lines-host" "$B/lines-i686")"
    cp "$B/lines-host" "$B/c-lines"; printf 'x\n' >>"$B/c-lines"
    check "control: the same comparison tells a line list with one line added" "$(ynnot cmp -s "$B/c-lines" "$B/lines-i686")"
    
    echo
    echo "### every charts row against P2's run, <corpus>/runs/${P2_RUN_NAME:-none}, named by P2's run record the base added (specs/0034 \"P3\": byte-identical to P2's run by sha256; ruling K; change NUP)"
    git show "$C:$P2_TXT" >"$B/prev-p2.txt"
    echo "command: git show <phase commit>:$P2_TXT; <work>/prevrec.py <P2's run directory> <it>"
    python3 -I -B "$B/prevrec.py" "$P2_RUN" "$B/prev-p2.txt" >"$B/prevrec-p2.out" 2>&1
    echo "  $(cat "$B/prevrec-p2.out")"
    check "P2's run directory's summaries, both labels, are its committed record's summary table (change NUP)" "$(yn [ "$(count_matches -E "is the run directory's: yes\$" "$B/prevrec-p2.out")" = 1 ])"
    sed '2d' "$B/prev-p2.txt" >"$B/c-prev-p2.txt"
    python3 -I -B "$B/prevrec.py" "$P2_RUN" "$B/c-prev-p2.txt" >"$B/c-prevrec-p2.out" 2>&1
    check "control: the same program refuses that record with one summary row dropped" "$(yn [ "$(count_matches -E "is the run directory's: no\$" "$B/c-prevrec-p2.out")" = 1 ])"
    for label in host i686; do
      nrow=0; nsame=0
      : >"$B/ident-charts-$label"
      while IFS="$TAB" read -r id ext; do
        nrow=$((nrow + 1))
        printf '    %s %s out %s %s line %s %s\n' "$id" "$label" \
          "$(sha_of "$O/$id/out.$label.$ext" 2>/dev/null)" "$(sha_of "$P2_RUN/$id/out.$label.$ext" 2>/dev/null)" \
          "$(sha_of "$O/$id/stdout.$label.txt" 2>/dev/null)" "$(sha_of "$P2_RUN/$id/stdout.$label.txt" 2>/dev/null)" >>"$B/ident-charts-$label"
        if same_row "$O" "$P2_RUN" "$id" "$ext" "$label"; then nsame=$((nsame + 1)); else echo "    $id: $label: the output or the line differs from P2's run's"; fi
      done <"$B/order"
      echo "  $label: per row, id, label, the output's sha256 now and in P2's run, the line's now and in P2's run:"
      cat "$B/ident-charts-$label"
      echo "  charts $label: rows compared $nrow; identical, output and line, by sha256: $nsame"
      p2_same() { [ "$nrow" = "$manifest_rows" ] && [ "$nsame" = 27 ] && [ "$nsame" = "$nrow" ]; }
      check "charts $label: every row's output and line are P2's run's, by sha256, 27 of 27 (specs/0034 \"P3\"; change NUP)" "$(yn p2_same)"
    done
    p2_first_id=$(head -n 1 "$B/order" | cut -f1)
    p2_first_ext=$(head -n 1 "$B/order" | cut -f2)
    p2_ctl() { same_row "$O" "$P2_RUN" "${p2_first_id}x" "$p2_first_ext" host; }
    check "control: same_row refuses the first workbook's id with a letter appended, which neither run holds" "$(ynnot p2_ctl)"
    
    echo
    echo "## the $SAMPLE run's record pair"
    echo "command: python3 -I -B scripts/passthrough-record.py --run <runs>/$RUN-$SAMPLE --out <scripts>/out/records --stem $STEM (change NTJ)"
    python3 -I -B scripts/passthrough-record.py --run "$O" --out "$RECORDS" --stem "$STEM" >"$B/record.out" 2>&1
    rrc=$?
    sed 's/^/    /' "$B/record.out"
    check "the record script exits 0" "$(yn [ "$rrc" = 0 ])"
    RTXT=$RECORDS/$STEM.txt
    RMD=$RECORDS/$STEM.md
    # The families: the names of the host entries table's changed, added and
    # dropped rows, none here (change NSR).
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] ~ /^(changed|added|dropped)$/ { print $k["status"] "\t" $k["name"] }' "$O/entries.host.tsv" >"$B/w.parts"
    check "no changed, added or dropped name in the host entries table ($(count_lines "$B/w.parts") names; change NSR)" "$(yn [ "$(count_lines "$B/w.parts")" = 0 ])"
    FAM_CHANGED=$(fams_of "$B/w.parts" changed)
    FAM_ADDED=$(fams_of "$B/w.parts" added)
    FAM_DROPPED=$(fams_of "$B/w.parts" dropped)
    echo "  the families: changed ${FAM_CHANGED:-none}; added ${FAM_ADDED:-none}; dropped ${FAM_DROPPED:-none}"
    fams_ok() { [ -z "$FAM_CHANGED$FAM_ADDED$FAM_DROPPED" ]; }
    check "no family is changed, added or dropped (change NSR)" "$(yn fams_ok)"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/reccheck.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/reccheck.out"
    rec_all() { [ "$(count_matches -E ': yes$' "$B/reccheck.out")" = 18 ] && [ "$(count_matches -E ': no$' "$B/reccheck.out")" = 0 ]; }
    check "the record's three tables are the run directory's, and its family tables are counted from them (eighteen checks: four, six per label, two)" "$(yn rec_all)"
    awk '!done && /^[|] total [|]/ { done = 1; next } { print }' "$RMD" >"$B/c-rec.md"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$B/c-rec.md" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/c-reccheck.out" 2>&1
    sed '2d' "$RTXT" >"$B/c-rec.txt"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$B/c-rec.txt" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/c-reccheck2.out" 2>&1
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "planted" "$EDIT" >"$B/c-reccheck3.out" 2>&1
    rec_ctl() { [ "$(count_matches -E ': no$' "$B/c-reccheck.out")" -ge 1 ] && [ "$(count_matches -F "the summary table is every label's summary: no" "$B/c-reccheck2.out")" = 1 ]; }
    check "control: the same check finds an .md with a family table's total row dropped and a .txt one summary row short" "$(yn rec_ctl)"
    rec_drop() { [ "$(count_matches -E "the dropped entries' families are planted: no\$" "$B/c-reccheck3.out")" = 2 ]; }
    check "control: the same check finds the dropped families differ from a planted family, on each label" "$(yn rec_drop)"
    check "the record script and the record check left no scripts/__pycache__ (PYTHONDONTWRITEBYTECODE)" "$(yn no_pycache)"
    echo "command: install -m 644 <scripts>/out/records/$STEM.md <scripts>/out/records/$STEM.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RMD" "$RTXT" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM.md" "$RECORDS_DEST/$STEM.txt")
    echo "  exit: $?"
    for f in "$STEM.md" "$STEM.txt"; do
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
    done
    echo
    echo "## the kinds sample once more with the size log's release binaries, both targets (specs/0034 \"P3\": byte-identical to part 2's record by sha256; change NUQ)"
    echo "  each row checked as a passthrough row (every row ok, every input and output opens, nothing changed), then every row's output and line compared by sha256 with M5 part 2 P3's kinds run, <corpus>/runs/${KINDS_RUN_NAME:-none}, the run its committed record names"
    K_SAMPLE=kinds
    K_EDIT=--kinds-sample
    KO=$RUN_OUT_ROOT/$RUN-$K_SAMPLE
    K_STEM=m5p3-p3-$K_SAMPLE-$DATE-$SHORT
    if [ -e "$KO" ]; then echo "  $KO is already there"; fail=1; fi
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      echo
      echo "## $K_SAMPLE: $label run, --tool-arg $K_EDIT"
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <work>/bin/$label/emend-copy --xlsx-diff <work>/bin/$label/xlsx-diff --out <runs>/$RUN-$K_SAMPLE --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $K_EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$KO" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$K_EDIT" \
        >"$B/run-$K_SAMPLE-$label.stdout" 2>"$B/run-$K_SAMPLE-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$K_SAMPLE-$label.stderr")"
      sed 's/^/    /' "$B/run-$K_SAMPLE-$label.stdout"
      check "$K_SAMPLE $label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$K_SAMPLE $label: its stderr is empty" "$(yn [ ! -s "$B/run-$K_SAMPLE-$label.stderr" ])"
      n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
      echo "  entries left in <work>/tmp-run after the run: $n_left"
      check "$K_SAMPLE $label: the runs' TMPDIR is empty after the run" "$(yn [ "$n_left" = 0 ])"
      SUM=$KO/summary.$label.tsv
      ENT=$KO/entries.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      n_ok=$(count_where "$SUM" outcome ok)
      : >"$B/refused-$K_SAMPLE-$label"
      while IFS="$TAB" read -r id ext; do
        if [ "$(awk -F'\t' -v id="$id" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id { print $k["outcome"] " " $k["exit"] }' "$SUM")" = "error 2" ] \
           && [ "$(count_lines "$KO/$id/stderr.$label.txt")" = 1 ] && [ -n "$(refusal_of "$KO" "$id" "$label")" ]; then
          printf '%s\t%s\n' "$id" "$(refusal_of "$KO" "$id" "$label")" >>"$B/refused-$K_SAMPLE-$label"
        fi
      done <"$B/order"
      n_ref=$(count_lines "$B/refused-$K_SAMPLE-$label")
      echo "  summary rows: $rows; outcome ok: $n_ok; refused by the layer (a finding; fails the summary): $n_ref"
      sed 's/^/    refused: /' "$B/refused-$K_SAMPLE-$label"
      echo "  among the ok rows: lo ok $(count_ok_where "$SUM" lo ok); lo_in ok $(count_ok_where "$SUM" lo_in ok); leftover no $(count_ok_where "$SUM" leftover no); order_preserved yes $(count_ok_where "$SUM" order_preserved yes); comment_equal yes $(count_ok_where "$SUM" comment_equal yes); files_identical yes $(count_ok_where "$SUM" files_identical yes), no $(count_ok_where "$SUM" files_identical no)"
      echo "  every row: lo_in ok $(count_where "$SUM" lo_in ok); leftover no $(count_where "$SUM" leftover no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      echo "  the entries table's rows by status: identical $(status_rows "$ENT" identical), recompressed $(status_rows "$ENT" recompressed), changed $(status_rows "$ENT" changed), dropped $(status_rows "$ENT" dropped), added $(status_rows "$ENT" added)"
      echo "  the entry totals the ok rows imply (the sample writes its input back unedited): changed 0, added 0, dropped 0, none recompressed, none flagged, files_identical yes in every ok row"
      k_summary_ok() {
        local col st
        [ "$rows" = "$manifest_rows" ] || return 1
        [ "$n_ok" = "$rows" ] && [ "$n_ref" = 0 ] || return 1
        for col in "lo ok" "lo_in ok" "leftover no" "order_preserved yes" "comment_equal yes" "files_identical yes"; do
          [ "$(count_ok_where "$SUM" ${col% *} ${col#* })" = "$n_ok" ] || return 1
        done
        [ "$(count_where "$SUM" lo_in ok)" = "$rows" ] || return 1
        [ "$(count_where "$SUM" leftover no)" = "$rows" ] || return 1
        for st in changed added dropped recompressed flagged; do
          [ "$(sum_col "$SUM" "$st")" = 0 ] || return 1
        done
        for st in identical recompressed changed dropped added; do
          [ "$(sum_col "$SUM" "$st")" = "$(status_rows "$ENT" "$st")" ] || return 1
        done
      }
      check "$K_SAMPLE $label: every row ok; every row's input opens (lo_in ok) with no leftover; every output opens (lo ok), order and comment kept, files_identical yes; nothing changed, added, dropped, recompressed or flagged; the summary's status totals the entries table's" "$(yn k_summary_ok)"
      : >"$B/lines-$K_SAMPLE-$label"
      while IFS="$TAB" read -r id ext; do
        if [ -f "$KO/$id/stdout.$label.txt" ]; then printf '%s\t%s\n' "$id" "$(cat "$KO/$id/stdout.$label.txt")" >>"$B/lines-$K_SAMPLE-$label"; fi
      done <"$B/order"
      R=$KO/run.$label.tsv
      args=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$R")
      k_bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
      check "$K_SAMPLE $label: the run row records the size log's two release binaries by sha256 and the phase commit (change NUO)" "$(yn k_bins_in_row)"
      check "$K_SAMPLE $label: the run row's tool_args is $K_EDIT" "$(yn [ "$args" = "$K_EDIT" ])"
    done
    check "$K_SAMPLE: the same workbooks are refused on both targets, with the same messages (none)" "$(yn cmp -s "$B/refused-$K_SAMPLE-host" "$B/refused-$K_SAMPLE-i686")"
    
    echo
    echo "### $K_SAMPLE: the two labels' outputs"
    same_out=0
    nboth=0
    while IFS="$TAB" read -r id ext; do
      if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$K_SAMPLE-host")" ]; then continue; fi
      nboth=$((nboth + 1))
      if cmp -s "$KO/$id/out.host.$ext" "$KO/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
    done <"$B/order"
    echo "  ok workbooks: $nboth; whose host and i686 outputs are byte for byte the same: $same_out"
    check "$K_SAMPLE: every output is the same on both targets" "$(yn [ "$same_out" = "$nboth" ])"
    check "$K_SAMPLE: both targets printed the same line for every ok workbook" "$(yn cmp -s "$B/lines-$K_SAMPLE-host" "$B/lines-$K_SAMPLE-i686")"
    
    echo
    echo "### $K_SAMPLE: every row against M5 part 2 P3's kinds run, <corpus>/runs/${KINDS_RUN_NAME:-none}, named by its committed record (change NUQ)"
    KINDS_TXT=$(git show --name-only --format= "$KINDS_REC" | LC_ALL=C "$G" -E '^records/m5p2-p3-kinds-[0-9-]+-[0-9a-f]{7}[.]txt$')
    echo "command: git show --name-only --format= <M5 part 2 P3's record commit>, the kinds record's .txt it added: ${KINDS_TXT:-none}"
    check "$K_SAMPLE: that record commit added exactly one kinds record .txt" "$(yn [ "$(printf '%s\n' "$KINDS_TXT" | count_lines /dev/stdin)" = 1 ])"
    git show "$C:$KINDS_TXT" >"$B/prev-kinds.txt"
    python3 -I -B "$B/prevrec.py" "$KINDS_RUN" "$B/prev-kinds.txt" >"$B/prevrec-kinds.out" 2>&1
    echo "  $(cat "$B/prevrec-kinds.out")"
    check "$K_SAMPLE: part 2's kinds run directory's summaries, both labels, are its committed record's summary table" "$(yn [ "$(count_matches -E "is the run directory's: yes\$" "$B/prevrec-kinds.out")" = 1 ])"
    sed '2d' "$B/prev-kinds.txt" >"$B/c-prev-kinds.txt"
    python3 -I -B "$B/prevrec.py" "$KINDS_RUN" "$B/c-prev-kinds.txt" >"$B/c-prevrec-kinds.out" 2>&1
    check "control: the same program refuses that record with one summary row dropped" "$(yn [ "$(count_matches -E "is the run directory's: no\$" "$B/c-prevrec-kinds.out")" = 1 ])"
    for label in host i686; do
      nrow=0; nsame=0
      : >"$B/ident-$K_SAMPLE-$label"
      while IFS="$TAB" read -r id ext; do
        nrow=$((nrow + 1))
        printf '    %s %s out %s %s line %s %s\n' "$id" "$label" \
          "$(sha_of "$KO/$id/out.$label.$ext" 2>/dev/null)" "$(sha_of "$KINDS_RUN/$id/out.$label.$ext" 2>/dev/null)" \
          "$(sha_of "$KO/$id/stdout.$label.txt" 2>/dev/null)" "$(sha_of "$KINDS_RUN/$id/stdout.$label.txt" 2>/dev/null)" >>"$B/ident-$K_SAMPLE-$label"
        if same_row "$KO" "$KINDS_RUN" "$id" "$ext" "$label"; then nsame=$((nsame + 1)); else echo "    $id: $label: the output or the line differs from part 2's kinds run's"; fi
      done <"$B/order"
      echo "  $label: per row, id, label, the output's sha256 now and in part 2's run, the line's now and in part 2's run:"
      cat "$B/ident-$K_SAMPLE-$label"
      echo "  $K_SAMPLE $label: rows compared $nrow; identical, output and line, by sha256: $nsame"
      k_same() { [ "$nrow" = "$manifest_rows" ] && [ "$nsame" = 27 ] && [ "$nsame" = "$nrow" ]; }
      check "$K_SAMPLE $label: every row's output and line are part 2's kinds run's, by sha256, 27 of 27 (specs/0034 \"P3\"; change NUQ)" "$(yn k_same)"
    done
    
    echo
    echo "## the $K_SAMPLE run's record pair"
    echo "command: python3 -I -B scripts/passthrough-record.py --run <runs>/$RUN-$K_SAMPLE --out <scripts>/out/records --stem $K_STEM (change NUQ)"
    python3 -I -B scripts/passthrough-record.py --run "$KO" --out "$RECORDS" --stem "$K_STEM" >"$B/record-$K_SAMPLE.out" 2>&1
    rrc=$?
    sed 's/^/    /' "$B/record-$K_SAMPLE.out"
    check "$K_SAMPLE: the record script exits 0" "$(yn [ "$rrc" = 0 ])"
    KTXT=$RECORDS/$K_STEM.txt
    KMD=$RECORDS/$K_STEM.md
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] ~ /^(changed|added|dropped)$/ { print $k["status"] "\t" $k["name"] }' "$KO/entries.host.tsv" >"$B/w-$K_SAMPLE.parts"
    check "$K_SAMPLE: no changed, added or dropped name in the host entries table ($(count_lines "$B/w-$K_SAMPLE.parts") names)" "$(yn [ "$(count_lines "$B/w-$K_SAMPLE.parts")" = 0 ])"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$KO" "$KTXT" "$KMD" "" "" "" "$K_EDIT" >"$B/reccheck-$K_SAMPLE.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/reccheck-$K_SAMPLE.out"
    k_rec_all() { [ "$(count_matches -E ': yes$' "$B/reccheck-$K_SAMPLE.out")" = 18 ] && [ "$(count_matches -E ': no$' "$B/reccheck-$K_SAMPLE.out")" = 0 ]; }
    check "$K_SAMPLE: the record's three tables are the run directory's, and its family tables are counted from them (eighteen checks: four, six per label, two)" "$(yn k_rec_all)"
    check "the record script and the record check left no scripts/__pycache__ (PYTHONDONTWRITEBYTECODE)" "$(yn no_pycache)"
    echo "command: install -m 644 <scripts>/out/records/$K_STEM.md <scripts>/out/records/$K_STEM.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$KMD" "$KTXT" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$K_STEM.md" "$RECORDS_DEST/$K_STEM.txt")
    echo "  exit: $?"
    for f in "$K_STEM.md" "$K_STEM.txt"; do
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
    done
    
    echo
    echo "## the CHANGELOG's citation check and form (specs/0034 \"P3\"; specs/0031 \"The CHANGELOG (P1)\", M4 part 2 P1's run log's checks carried; M5 part 2 P3's changes NTB and NTY, carried; change NUS)"
    CLCHECK=$SELF_DIR/changelog_check.py
    P1CHECKS=$SELF_DIR/p1_checks.sh
    git show "$C:records/logs/m4p2-p1/run.log" >"$B/m4p2p1-run.log"
    # want_hash_of <file name as a pattern>: the hash M4 part 2 P1's committed
    # run log printed for the program beside its script, one line expected.
    want_hash_of() { LC_ALL=C "$G" -E "^command: sha256sum <scripts>/$1[^:]*: [0-9a-f]{64}\$" "$B/m4p2p1-run.log" | sed 's/.*: //'; }
    for prog in changelog_check p1_checks; do
      case $prog in changelog_check) f=$CLCHECK; pat='changelog_check[.]py' ;; *) f=$P1CHECKS; pat='p1_checks[.]sh' ;; esac
      want=$(want_hash_of "$pat")
      echo "command: sha256sum <scripts>/$(basename "$f"): $(sha_of "$f"); git show <phase commit>:records/logs/m4p2-p1/run.log, its line for the same file: ${want:-none} ($(printf '%s\n' "$want" | count_lines /dev/stdin) lines)"
      prog_is_p1s() { [ "$(printf '%s\n' "$want" | count_lines /dev/stdin)" = 1 ] && [ "$(sha_of "$f")" = "$want" ]; }
      check "<scripts>/$(basename "$f") is M4 part 2 P1's, byte for byte by the sha256 its committed run log printed" "$(yn prog_is_p1s)"
    done
    prog_ctl() { [ "$(sha_of "$P1CHECKS")" = "$(want_hash_of 'changelog_check[.]py')" ]; }
    check "control: the same comparison refuses the shared checks' hash against the CHANGELOG check's line" "$(ynnot prog_ctl)"
    sed 's/^/    /' "$CLCHECK"
    echo "command: . <scripts>/p1_checks.sh (its p1_bullets and p1_width_ok used below)"
    sed 's/^/    /' "$P1CHECKS"
    . "$P1CHECKS"
    p1_fns() { declare -F p1_bullets >/dev/null && declare -F p1_width_ok >/dev/null; }
    check "the shared checks' p1_bullets and p1_width_ok are defined after sourcing" "$(yn p1_fns)"
    p1_fns_ctl() { declare -F p1_no_such_function >/dev/null; }
    check "control: the same test refuses a function the file does not define" "$(ynnot p1_fns_ctl)"
    git show "$C:CHANGELOG.md" >"$B/CHANGELOG.md"
    git show "$REC:CHANGELOG.md" >"$B/CHANGELOG-base.md"
    git ls-tree -r --name-only "$C" >"$B/tree.txt"
    CL=$B/CHANGELOG.md
    echo "command: git show <phase commit>:CHANGELOG.md, <base>:CHANGELOG.md; git ls-tree -r --name-only <phase commit>"
    echo "  at the phase commit: $(wc -c <"$CL") bytes, $(count_lines "$CL") lines, sha256 $(sha_of "$CL"); at the base: $(wc -c <"$B/CHANGELOG-base.md") bytes, sha256 $(sha_of "$B/CHANGELOG-base.md"); the tree: $(count_lines "$B/tree.txt") paths"
    echo "command: git diff --numstat <base> <phase commit> -- CHANGELOG.md"
    cl_numstat=$(git diff --numstat "$REC" "$C" -- CHANGELOG.md | cut -f1,2)
    echo "  $cl_numstat"
    check "the CHANGELOG gains three lines from the base and loses none (change NUS)" "$(yn [ "$cl_numstat" = "3${TAB}0" ])"
    echo "command: git diff --quiet <base> <the probe commit> -- CHANGELOG.md (change NUS)"
    check "the probe commit's CHANGELOG is the base's, so the phase commit, the CHANGELOG commit, alone changes it (change NUS)" "$(yn git diff --quiet "$REC" "$PROBE" -- CHANGELOG.md)"
    check "control: the same comparison finds the phase commit's CHANGELOG different from the base's (change NUS)" "$(ynnot git diff --quiet "$REC" "$C" -- CHANGELOG.md)"
    echo "command: python3 -I -B <scripts>/changelog_check.py <work>/CHANGELOG.md <work>/tree.txt"
    python3 -I -B "$CLCHECK" "$CL" "$B/tree.txt" >"$B/cc.out" 2>"$B/cc.err" </dev/null
    cc=$?
    echo "  exit: $cc; standard error $(wc -c <"$B/cc.err") bytes; standard output:"
    sed 's/^/    /' "$B/cc.out"
    summary_is() { tail -n 1 "$1" | LC_ALL=C "$G" -qE "^sentences [0-9]+ with-digit [0-9]+ cited [0-9]+ $2\$"; }
    cc_ok() { [ "$cc" = 0 ] && summary_is "$B/cc.out" 'uncited 0 missing 0' && [ ! -s "$B/cc.err" ]; }
    check "CHANGELOG.md: every sentence holding a digit cites a records/ or specs/ path the phase commit's tree holds, the release heading exempt: exit 0, uncited 0 missing 0, standard error empty" "$(yn cc_ok)"
    cl_digit=$(tail -n 1 "$B/cc.out" | awk '{print $4}')
    cl_cited=$(tail -n 1 "$B/cc.out" | awk '{print $6}')
    cl_all_cited() { [ -n "$cl_digit" ] && [ "$cl_digit" -gt 0 ] && [ "$cl_digit" = "$cl_cited" ]; }
    check "CHANGELOG.md: the sentences holding a digit ($cl_digit) are more than none and all cited ($cl_cited)" "$(yn cl_all_cited)"
    n_exempt=$(count_matches -E '^exempt unit [0-9]+$' "$B/cc.out")
    check "CHANGELOG.md: exactly one unit exempt, the release heading ($n_exempt)" "$(yn [ "$n_exempt" = 1 ])"
    cp "$CL" "$B/planted-changelog.md"
    printf -- '- Planted: the sample ran 99 times over the corpus.\n' >>"$B/planted-changelog.md"
    python3 -I -B "$CLCHECK" "$B/planted-changelog.md" "$B/tree.txt" >"$B/ccp.out" 2>"$B/ccp.err" </dev/null
    ccp=$?
    echo "command (control): the same over a copy with the bullet \"- Planted: the sample ran 99 times over the corpus.\" appended: exit $ccp; $(tail -n 1 "$B/ccp.out")"
    ccp_ok() { [ "$ccp" = 1 ] && summary_is "$B/ccp.out" 'uncited 1 missing 0'; }
    check "control: the CHANGELOG check refuses the planted uncited sentence" "$(yn ccp_ok)"
    sed 's#specs/0034-charts-read[.]md#specs/0034-no-such-spec.md#' "$CL" >"$B/c-missing.md"
    python3 -I -B "$CLCHECK" "$B/c-missing.md" "$B/tree.txt" >"$B/ccm.out" 2>"$B/ccm.err" </dev/null
    ccm=$?
    echo "command (control): the same over a copy whose new citation names specs/0034-no-such-spec.md: exit $ccm; $(tail -n 1 "$B/ccm.out")"
    check "control: that copy differs from the CHANGELOG (cmp)" "$(ynnot cmp -s "$CL" "$B/c-missing.md")"
    ccm_ok() { [ "$ccm" = 1 ] && summary_is "$B/ccm.out" 'uncited 0 missing 1'; }
    check "control: the CHANGELOG check finds the copy's citation missing from the tree" "$(yn ccm_ok)"
    DASH=$(printf '\342\200\224')
    n_dash=$(count_matches -F "$DASH" "$CL")
    n_na=$(count_matches -P '[^\x00-\x7F]' "$CL")
    n_ctl=$(LC_ALL=C tr -cd '\000-\011\013-\037\177' <"$CL" | wc -c)
    max_w=$(LC_ALL=C awk 'length($0) > m { m = length($0) } END { print m + 0 }' "$CL")
    echo "command: count_matches -F <the bytes E2 80 94>, count_matches -P '[^\\x00-\\x7F]', tr -cd <every control byte but line feed> | wc -c, the longest line: $n_dash, $n_na, $n_ctl, $max_w columns"
    check "the CHANGELOG holds no U+2014" "$(yn [ "$n_dash" = 0 ])"
    check "the CHANGELOG is ASCII, so UTF-8" "$(yn [ "$n_na" = 0 ])"
    check "the CHANGELOG holds no control byte other than line feed" "$(yn [ "$n_ctl" = 0 ])"
    check "every line of the CHANGELOG is at most 80 columns" "$(yn p1_width_ok "$CL" 80)"
    printf 'a %s b\ncaf\303\251\na\tb\033c\n' "$DASH" >"$B/c-form"
    form_ctl() { [ "$(count_matches -F "$DASH" "$B/c-form")" = 1 ] && [ "$(count_matches -P '[^\x00-\x7F]' "$B/c-form")" = 2 ] && [ "$(LC_ALL=C tr -cd '\000-\011\013-\037\177' <"$B/c-form" | wc -c)" = 2 ]; }
    check "control: the same three counts find a planted U+2014, two lines with non-ASCII bytes and a tab and an ESC" "$(yn form_ctl)"
    cp "$CL" "$B/c-wide"
    printf '%081d\n' 0 >>"$B/c-wide"
    check "control: p1_width_ok refuses a copy with one line of 81 columns appended" "$(ynnot p1_width_ok "$B/c-wide" 80)"
    n_h12=$(count_matches -E '^#{1,2} ' "$CL")
    n_top=$(count_matches -xF '# Changelog' "$CL")
    n_rel=$(count_matches -xF '## 0.1.0 (unreleased)' "$CL")
    subs=$(LC_ALL=C "$G" -E '^### ' "$CL" | sed 's/^### //' | paste -s -d '|')
    echo "command: count_matches -E '^#{1,2} ' -> $n_h12; -xF '# Changelog' -> $n_top; -xF '## 0.1.0 (unreleased)' -> $n_rel; the '### ' headings joined by | -> $subs"
    heads_ok() { [ "$n_h12" = 2 ] && [ "$n_top" = 1 ] && [ "$n_rel" = 1 ] && [ "$subs" = 'Added|Changed|Measured|Not supported by design' ]; }
    check "one top heading, one release heading, and the four subsections in order, as M4 part 2 P1 left them" "$(yn heads_ok)"
    echo "command: p1_bullets <CHANGELOG> <section> for each section, at the phase commit and at the base"
    n_sec_same=0
    for sec in Changed Measured 'Not supported by design'; do
      p1_bullets "$CL" "$sec" "$B/now-sec"
      p1_bullets "$B/CHANGELOG-base.md" "$sec" "$B/base-sec"
      echo "  $sec: bullets $(count_lines "$B/now-sec") now, $(count_lines "$B/base-sec") at the base"
      if [ "$(count_lines "$B/now-sec")" -ge 1 ] && cmp -s "$B/now-sec" "$B/base-sec"; then n_sec_same=$((n_sec_same + 1)); fi
    done
    check "the Changed, Measured and Not supported by design bullets are the base's, unchanged (3 of 3: $n_sec_same)" "$(yn [ "$n_sec_same" = 3 ])"
    p1_bullets "$CL" Added "$B/added"
    rc_added=$?
    p1_bullets "$B/CHANGELOG-base.md" Added "$B/added-base"
    n_added=$(count_lines "$B/added")
    n_added_base=$(count_lines "$B/added-base")
    echo "  Added: exit $rc_added; bullets $n_added now, $n_added_base at the base"
    head -n "$n_added_base" "$B/added" >"$B/added-head"
    tail -n 1 "$B/added" >"$B/added-new"
    NEW_SPECS=$(LC_ALL=C "$G" -o -E 'specs/[0-9]{4}-[a-z0-9-]+[.]md' "$B/added-new" | paste -s -d ' ')
    echo "  the new bullet's spec paths: ${NEW_SPECS:-none}; it names the feature \`charts\`: $(count_matches -F '`charts`' "$B/added-new") times"
    added_ok() { [ "$rc_added" = 0 ] && [ "$n_added" = "$((n_added_base + 1))" ] && cmp -s "$B/added-head" "$B/added-base"; }
    check "the Added section is the base's bullets, unchanged and in order, with one bullet after them" "$(yn added_ok)"
    new_bullet_ok() { [ "$NEW_SPECS" = specs/0034-charts-read.md ] && [ "$(count_matches -F '`charts`' "$B/added-new")" = 1 ]; }
    check "the new bullet cites specs/0034-charts-read.md alone and names the feature charts (specs/0034 \"P3\"; change NUS)" "$(yn new_bullet_ok)"
    nb_ctl() { local NEW_SPECS=specs/0033-read-breadth-survey.md; new_bullet_ok; }
    check "control: the same check refuses the bullet were it to cite specs/0033 instead" "$(ynnot nb_ctl)"
    head -n -1 "$B/added" >"$B/c-added"
    added_ctl() { local n_added; n_added=$(count_lines "$B/c-added"); [ "$n_added" = "$((n_added_base + 1))" ]; }
    check "control: the same count refuses the Added bullets with the new one dropped" "$(ynnot added_ctl)"
    echo
    if [ "$RUN_SKIP_KEEP" = yes ]; then
    echo "## the keep and the open check: SKIPPED (RUN_SKIP_KEEP=yes, a dry run)"
    else
    echo "## the host keep regenerated (change NSF: M3 part 7 P5's form, one cargo test; carried)"
    mkdir "$KEEP" || exit 2
    echo "command: EMEND_KEEP_DIR=<keep> cargo test --workspace (host; CARGO_TARGET_DIR=<target>/main)"
    EMEND_KEEP_DIR=$KEEP cargo test --workspace >"$B/keep.out" 2>&1 </dev/null
    rc=$?
    echo "  exit: $rc"
    LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$B/keep.out" | sed 's/^ */    /'
    failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    echo "  passed $passed; failed $failed"
    check "the tests with the keep set exit 0" "$(yn [ "$rc" = 0 ])"
    check "no test failed" "$(yn [ "$failed" = 0 ])"
    echo "  files in the keep: $(find "$KEEP" -type f | wc -l); entries that are not regular files: $(find "$KEEP" -mindepth 1 ! -type f | wc -l)"
    (cd "$KEEP" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/host.files"
    nfiles=$(count_lines "$B/host.files")
    n_in=$(count_matches -E '\.in\.xlsx$' "$B/host.files")
    n_out=$(count_matches -E '\.out\.xlsx$' "$B/host.files")
    n_other=$(count_matches -vE '^[A-Za-z0-9_.-]+\.[0-9]+\.(in|out)\.xlsx$' "$B/host.files")
    LC_ALL=C sed -nE 's/^(.*)\.in\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.names"
    LC_ALL=C sed -nE 's/^(.*)\.out\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.out.names"
    echo "  .in.xlsx $n_in; .out.xlsx $n_out; names not of the form <test>.<n>.in|out.xlsx: $n_other"
    all_pairs() { [ "$n_in" = "$n_out" ] && [ "$((n_in * 2))" = "$nfiles" ] && [ "$n_other" = 0 ] && cmp -s "$B/pair.names" "$B/pair.out.names"; }
    check "the keep holds only whole pairs named <test>.<n>" "$(yn all_pairs)"
    NPAIRS=$n_in
    (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/keep.listing"
    echo "  the host keep's listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/keep.listing"); files $(count_lines "$B/keep.listing"); listing sha256 $(sha_of "$B/keep.listing")"
    check "the host keep's pairs times two equals its files (keep_pairs_ok)" "$(yn keep_pairs_ok "$B/keep.listing")"
    
    echo
    echo "## the host keep against M5 part 3 P2's committed open-check record, named by its record commit, the base (change NUR)"
    PREV_TXT=$(git show --name-only --format= "$PREV_OPEN_REC" | LC_ALL=C "$G" -E '^records/[a-z0-9]+-open-.*[.]txt$')
    echo "command: git show --name-only --format= <M5 part 3 P2's record commit>, the open-check .txt it added; git show <phase commit>:<it>"
    echo "  the record: $PREV_TXT (sha256 $(git show "$C:$PREV_TXT" | sha256sum | cut -d' ' -f1))"
    check "the named record commit added exactly one open-check .txt" "$(yn [ "$(printf '%s\n' "$PREV_TXT" | count_lines /dev/stdin)" = 1 ])"
    no_later_open() { [ -z "$(git log --format=%H "$PREV_OPEN_REC..$C" -- 'records/*-open-*.txt')" ]; }
    check "no commit after it adds an open-check record, so it is the last committed" "$(yn no_later_open)"
    git show "$C:$PREV_TXT" >"$B/prev.txt"
    while IFS= read -r t; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$t" "$(stat -c %s "$KEEP/$t.in.xlsx")" "$(sha_of "$KEEP/$t.in.xlsx")" \
        "$(stat -c %s "$KEEP/$t.out.xlsx")" "$(sha_of "$KEEP/$t.out.xlsx")"
    done <"$B/pair.names" >"$B/keep.rows"
    tail -n +2 "$B/prev.txt" | cut -f1-5 | LC_ALL=C sort >"$B/prev.rows"
    LC_ALL=C sort "$B/keep.rows" >"$B/keep.sorted"
    n_prev=$(count_lines "$B/prev.rows")
    n_kept_prev=$(LC_ALL=C comm -12 "$B/prev.rows" "$B/keep.sorted" | count_lines /dev/stdin)
    cut -f1 "$B/prev.rows" >"$B/prev.names"
    LC_ALL=C comm -13 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/gone.pairs"
    echo "  rows: the regenerated keep $(count_lines "$B/keep.rows"), the record $n_prev; its rows found in the keep with the same name, bytes and both sha256s: $n_kept_prev"
    echo "  pairs in the keep and not in the record: $(count_lines "$B/new.pairs"); in the record and not in the keep: $(count_lines "$B/gone.pairs")"
    sed 's/^/    new: /' "$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.rows" "$B/keep.sorted" | cut -f1 >"$B/changed.pairs"
    echo "  pairs of the record whose bytes differ in the keep: $(count_lines "$B/changed.pairs")"
    sed 's/^/    changed: /' "$B/changed.pairs"
    check "no pair of the record is gone" "$(yn [ "$(count_lines "$B/gone.pairs")" = 0 ])"
    check "every pair of the record is in the keep, unchanged or changed ($n_kept_prev + $(count_lines "$B/changed.pairs") = $n_prev)" "$(yn [ "$((n_kept_prev + $(count_lines "$B/changed.pairs")))" = "$n_prev" ])"
    check "no pair is new (change NUR)" "$(yn [ "$(count_lines "$B/new.pairs")" = 0 ])"
    new_ctl() { printf '%s\n' other.1 >"$B/c-new.pairs"; [ "$(count_lines "$B/c-new.pairs")" = 0 ]; }
    check "control: the same count refuses one planted new pair" "$(ynnot new_ctl)"
    check "no pair of the record changed its bytes (change NUR)" "$(yn [ "$(count_lines "$B/changed.pairs")" = 0 ])"
    changed_ctl() { printf '%s\n' other.1 >"$B/c-changed.pairs"; [ "$(count_lines "$B/c-changed.pairs")" = 0 ]; }
    check "control: the same count refuses one planted changed pair" "$(ynnot changed_ctl)"
    echo "command: the #[test] functions added or whose body is edited since the named record commit, and those of a .rs file whose text outside its tests differs, from the two commits' sources of every .rs file git diff --name-only <named record commit> <phase commit> names: <work>/edited.py, below (change NSG)"
    cat >"$B/edited.py" <<'PY'
    """The #[test] functions whose body differs between two commits, or that
    the second adds: each file's text at both commits (git show), every
    function after a #[test] attribute (other attributes allowed between), its
    body from the fn line to the first line that is a lone closing brace in
    column one. Prints one test name per line; with a third argument
    --fixtures, instead every test whose body names an item (const,
    static, fn, struct, enum, type or mod at column one) whose lines
    outside the test bodies differ between the two commits (change
    NSG)."""
    import collections
    import re
    import subprocess
    import sys
    
    base, head = sys.argv[1:3]
    TEST = re.compile(r"#\[test\]\s*(?:#\[[^\]]*\]\s*)*fn\s+([A-Za-z0-9_]+)")
    
    
    def show(rev, path):
        run = subprocess.run(["git", "show", "%s:%s" % (rev, path)], capture_output=True)
        return run.stdout.decode() if run.returncode == 0 else ""
    
    
    def tests(text):
        out = {}
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            out[m.group(1)] = text[m.start():end if end >= 0 else len(text)]
        return out
    
    
    names = subprocess.run(["git", "diff", "--name-only", base, head, "--", "*.rs"],
                           capture_output=True, check=True).stdout.decode().split()
    ITEM = re.compile(r"^(?:pub(?:\([^)]*\))?\s+)?(?:const|static|fn|struct|enum|type|mod)\s+([A-Za-z_][A-Za-z0-9_]*)")
    
    
    def outside(text):
        out, at = [], 0
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            end = len(text) if end < 0 else end + 3
            if m.start() >= at:
                out.append(text[at:m.start()])
                at = end
        out.append(text[at:])
        return "".join(out)
    
    
    def changed_items(before_text, after_text):
        found = set()
        for text, other in ((after_text, before_text), (before_text, after_text)):
            others = collections.Counter(outside(other).split("\n"))
            current = None
            for line in outside(text).split("\n"):
                m = ITEM.match(line)
                if m:
                    current = m.group(1)
                if others[line] > 0:
                    others[line] -= 1
                elif current is not None:
                    found.add(current)
        return found
    
    
    edited = set()
    fixture = set()
    for path in names:
        before_text, after_text = show(base, path), show(head, path)
        before, after = tests(before_text), tests(after_text)
        for name, body in after.items():
            if before.get(name) != body:
                edited.add(name)
        items = changed_items(before_text, after_text)
        for name, body in after.items():
            if any(re.search(r"\b%s\b" % re.escape(i), body) for i in items):
                fixture.add(name)
    for name in sorted(fixture if sys.argv[3:] == ["--fixtures"] else edited):
        print(name)
    PY
    sed 's/^/    /' "$B/edited.py"
    python3 -I -B "$B/edited.py" "$PREV_OPEN_REC" "$C" | LC_ALL=C sort >"$B/edited.tests"
    python3 -I -B "$B/edited.py" "$PREV_OPEN_REC" "$C" --fixtures | LC_ALL=C sort >"$B/fixture.tests"
    LC_ALL=C sort -u "$B/edited.tests" "$B/fixture.tests" >"$B/touched.tests"
    sed 's/^/    added or edited test: /' "$B/edited.tests"
    sed 's/^/    test of a file whose text outside its tests differs: /' "$B/fixture.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/new.pairs" | LC_ALL=C sort -u >"$B/new.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/changed.pairs" | LC_ALL=C sort -u >"$B/changed.tests"
    echo "  tests with a new pair: $(count_lines "$B/new.tests"); tests with a changed pair: $(count_lines "$B/changed.tests"); tests added or edited: $(count_lines "$B/edited.tests"); tests of a file whose text outside its tests differs: $(count_lines "$B/fixture.tests")"
    check "some test is added or edited, so the list was read" "$(yn [ "$(count_lines "$B/edited.tests")" -ge 1 ])"
    new_from_edited() { [ "$(LC_ALL=C comm -23 "$B/new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every new pair is kept by a test added or edited since the record" "$(yn new_from_edited)"
    changed_from_touched() { [ "$(LC_ALL=C comm -23 "$B/changed.tests" "$B/touched.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every changed pair of the record is kept by a test edited since it, or of a file whose fixtures or helpers changed (change NSG)" "$(yn changed_from_touched)"
    printf 'zzz_not_an_edited_test\n' | LC_ALL=C sort -m - "$B/new.tests" >"$B/c-new.tests"
    new_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a pair of a test not added or edited" "$(yn new_ctl)"
    printf 'zzz_not_a_touched_test\n' | LC_ALL=C sort -m - "$B/changed.tests" >"$B/c-changed.tests"
    touched_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-changed.tests" "$B/touched.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a changed pair of a test neither edited nor of a changed file" "$(yn touched_ctl)"
    
    echo
    echo "## scripts/edit-open-check.sh on the host keep (specs/0018 \"Harness runs\": every phase's run log runs it over its keep)"
    mkdir "$B/tmp"
    # The open check's own TMPDIR, its device beside the runs' and the corpus
    # directory's.
    dev_open=$(stat -c %d "$B/tmp")
    echo "command: stat -c %d <work>/tmp <work>/tmp-run <corpus>/corpus /proc"
    echo "  device of the open check's TMPDIR (<work>/tmp): $dev_open; of the runs' TMPDIR (<work>/tmp-run): $(stat -c %d "$RUNTMP"); of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    check "the open check's TMPDIR and the corpus directory are on one device" "$(yn [ "$dev_open" = "$dev_corpus" ])"
    check "control: the same comparison tells /proc's device from the open check's TMPDIR's" "$(yn [ "$dev_proc" != "$dev_open" ])"
    echo "command: TMPDIR=<work>/tmp scripts/edit-open-check.sh --keep <keep> --libreoffice $IMAGE --out <scripts>/out/records --stem $STEM_OPEN"
    TMPDIR=$B/tmp scripts/edit-open-check.sh --keep "$KEEP" --libreoffice "$IMAGE" --out "$RECORDS" --stem "$STEM_OPEN" \
      >"$B/oc.stdout" 2>"$B/oc.stderr" </dev/null
    oc_rc=$?
    echo "  exit: $oc_rc"
    echo "  stdout:"; sed 's/^/    /' "$B/oc.stdout"
    echo "  stderr bytes: $(wc -c <"$B/oc.stderr")"
    check "the script exits 0 (no finding, no check errored)" "$(yn [ "$oc_rc" = 0 ])"
    check "its stderr is empty" "$(yn [ ! -s "$B/oc.stderr" ])"
    echo "  the reasons the script kept (its reasons directory under <work>/tmp), one line per refused side:"
    find "$B/tmp" -name '*-reason.txt' | LC_ALL=C sort | while IFS= read -r f; do echo "    ${f#"$B/tmp/"}: $(cat "$f")"; done
    TXT=$RECORDS/$STEM_OPEN.txt
    MD=$RECORDS/$STEM_OPEN.md
    TXT_HEADER=$(git show "$C:scripts/edit-open-check.sh" | sed -n "s/^readonly TXT_HEADER=\\$'\\(.*\\)'\$/\\1/p" | sed 's/\\t/\t/g')
    check "the .txt's header is the script's TXT_HEADER, read from the phase commit (nine columns)" "$(yn [ "$(head -n 1 "$TXT")" = "$TXT_HEADER" ])"
    tail -n +2 "$TXT" | cut -f1-5 >"$B/txt.rows"
    nrow_same=$(paste -d'\n' "$B/keep.rows" "$B/txt.rows" | awk 'NR % 2 == 1 { a = $0; next } a == $0 { n++ } END { print n + 0 }')
    echo "  rows: the keep $(count_lines "$B/keep.rows"), the .txt $(count_lines "$B/txt.rows"); rows whose name, bytes and hashes are the keep's, compared row by row: $nrow_same"
    rows_same() { [ "$(count_lines "$B/keep.rows")" = "$(count_lines "$B/txt.rows")" ] && [ "$nrow_same" = "$(count_lines "$B/keep.rows")" ] && [ "$nrow_same" = "$NPAIRS" ]; }
    check "every .txt row is one kept pair's name, byte counts and sha256s, in name order, one row per pair" "$(yn rows_same)"
    bad_rows=$(tail -n +2 "$TXT" | awk -F'\t' 'NF != 9 || $6 !~ /^(ok|fail|error)$/ || $7 !~ /^(ok|fail|error)$/ || $8 !~ /^(none|refused|count|error)$/ || $9 !~ /^(none|refused|count|error)$/' | wc -l)
    check "every row has nine columns, lo_in and lo each ok, fail or error, and each class none, refused, count or error ($bad_rows rows otherwise)" "$(yn [ "$bad_rows" = 0 ])"
    bad_fit=$(tail -n +2 "$TXT" | awk -F'\t' '{ print $6 ":" $8; print $7 ":" $9 }' | LC_ALL=C "$G" -cvxE 'ok:none|fail:refused|fail:count|error:error')
    check "every side's class fits its verdict ($bad_fit sides otherwise)" "$(yn [ "$bad_fit" = 0 ])"
    stdout_rows() { [ "$(awk -F'\t' 'NF == 3' "$B/oc.stdout")" = "$(tail -n +2 "$TXT" | cut -f1,6,7)" ]; }
    check "the script's per-pair stdout lines are the .txt's test, lo_in and lo columns" "$(yn stdout_rows)"
    echo "command: python3 -I -B <work>/wb.py over each kept input: its xl/workbook.xml entry, its sheet elements by local name (expat, no pattern) and of them those with a prefix"
    cat >"$B/wb.py" <<'PY'
    import sys, zipfile
    from xml.parsers import expat
    for path in sys.argv[1:]:
        name = path.rsplit("/", 1)[1][: -len(".in.xlsx")]
        try:
            z = zipfile.ZipFile(path)
        except zipfile.BadZipFile:
            print("%s\tunreadable\t-\t-" % name)
            continue
        if "xl/workbook.xml" not in z.namelist():
            print("%s\tno\t-\t-" % name)
            continue
        found = {"all": 0, "prefixed": 0}
    
        def start(tag, attrs):
            prefix, _, local = tag.rpartition(":")
            if local == "sheet":
                found["all"] += 1
                found["prefixed"] += 1 if prefix else 0
        p = expat.ParserCreate()
        p.StartElementHandler = start
        try:
            p.Parse(z.read("xl/workbook.xml"), True)
        except expat.ExpatError:
            print("%s\tyes\tunparsed\t-" % name)
            continue
        print("%s\tyes\t%d\t%d" % (name, found["all"], found["prefixed"]))
    PY
    sed 's/^/    /' "$B/wb.py"
    python3 -I -B "$B/wb.py" $(sed "s#^#$KEEP/#; s#\$#.in.xlsx#" "$B/pair.names") | LC_ALL=C sort >"$B/wb.all"
    echo "  kept inputs by workbook entry and sheet elements (entry, all, prefixed: pairs):"
    cut -f2- "$B/wb.all" | sort | uniq -c | sed 's/^/    /'
    echo "  the .md checked against the .txt and the kept inputs, with the heading specs/0015 P2 verification ruling 1 gives: <work>/mdcheck.py, below"
    cat >"$B/mdcheck.py" <<'PY'
    import sys
    txt, md, wb = sys.argv[1:4]
    rows = [l.split("\t") for l in open(txt).read().split("\n")[1:] if l]
    sheets = {l.split("\t")[0]: l.split("\t")[2] for l in open(wb).read().split("\n") if l}
    text = open(md).read().split("\n")
    REFUSED = ("Inputs refused by LibreOffice (allowed: a fixture LibreOffice cannot load: zip-level,"
               " or a package with no relationships part or an empty content-types root)")
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line:
                out.append(line)
        return out
    
    
    def listed(names):
        return ["- `%s`" % n for n in names] if names else ["None."]
    
    
    def count(col, v):
        return sum(1 for r in rows if r[col] == v)
    
    
    totals = [len(rows)] + [count(5, v) for v in ("ok", "fail", "error")] + [count(6, v) for v in ("ok", "fail", "error")]
    classes = ["| %s | " % side + " | ".join(str(count(col, c)) for c in ("none", "refused", "count", "error")) + " |"
               for side, col in (("reason_in", 7), ("reason_out", 8))]
    tot = section("Totals")
    checks = [
        ("Totals", tot[2:3] == ["| " + " | ".join(str(t) for t in totals) + " |"] and tot[5:] == classes),
        ("the refused-inputs heading reads as ruled, once", text.count("## " + REFUSED) == 1),
        ("Inputs refused by LibreOffice", section(REFUSED) == listed([r[0] for r in rows if r[7] == "refused"])),
        ("the sheet count did not apply", section("Inputs the sheet count did not apply to (allowed: a workbook fixture with no sheet element)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) == "0"])),
        ("counts differ", section("Inputs whose sheet and table counts differ (a finding)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) != "0"])),
        ("Outputs refused on an accepted input", section("Outputs refused on an input LibreOffice accepted (a finding)") == listed([r[0] for r in rows if r[6] == "fail" and r[5] == "ok"])),
        ("Checks that did not run", section("Checks that did not run (error)") == listed([r[0] for r in rows if "error" in (r[5], r[6])])),
        ("Pairs", section("Pairs")[2:] == ["| `%s` | %s | %s | %s | %s | %s | %s | %s | %s |" % tuple(r) for r in rows]),
        ("the Pairs line", ("- Pairs: %d" % len(rows)) in text),
    ]
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("totals: pairs %d; lo_in ok %d fail %d error %d; lo ok %d fail %d error %d" % tuple(totals))
    PY
    sed 's/^/    /' "$B/mdcheck.py"
    python3 -I -B "$B/mdcheck.py" "$TXT" "$MD" "$B/wb.all" >"$B/mdcheck.out"
    sed 's/^/    /' "$B/mdcheck.out"
    md_all() { [ "$(count_matches -E ': yes$' "$B/mdcheck.out")" = 9 ] && [ "$(count_matches -E ': no$' "$B/mdcheck.out")" = 0 ]; }
    check "the .md's nine parts are derived from the .txt and the kept inputs' sheet elements, the heading as ruled" "$(yn md_all)"
    head -n 2 "$TXT" >"$B/c-short.txt"
    python3 -I -B "$B/mdcheck.py" "$B/c-short.txt" "$MD" "$B/wb.all" >"$B/c-mdcheck.out"
    md_ctl() { [ "$(count_matches -E ': no$' "$B/c-mdcheck.out")" -ge 1 ]; }
    check "control: the same check on a .txt cut to one row finds the .md does not match it" "$(yn md_ctl)"
    OLD8=records/m1p8-open-2026-09-24-da080f1
    python3 -I -B "$B/mdcheck.py" "$OLD8.txt" "$OLD8.md" "$B/wb.all" >"$B/c-prevmd.out"
    old_heading() { [ "$(count_matches -F 'the refused-inputs heading reads as ruled, once: no' "$B/c-prevmd.out")" = 1 ]; }
    check "control: the same check on part 8 P2's committed .md finds the old heading, not the ruled one" "$(yn old_heading)"
    totals_line() { [ "$(sed -n 's/^wrote .*\.txt: \(pairs [^;]*; lo_in [^;]*; lo [^;]*\); inputs refused .*/\1/p' "$B/oc.stdout")" = "$(sed -n 's/^totals: //p' "$B/mdcheck.out")" ]; }
    check "the script's totals line is the totals derived from the .txt" "$(yn totals_line)"
    echo
    echo "### the verdicts against the named record"
    join -t "$TAB" <(tail -n +2 "$B/prev.txt" | cut -f1,6,7,8,9 | LC_ALL=C sort) <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) >"$B/both"
    check "every pair of the named record has a row in this record" "$(yn [ "$(count_lines "$B/both")" = "$n_prev" ])"
    awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9 { print $1 "\t" $2 "/" $3 "/" $4 "/" $5 " -> " $6 "/" $7 "/" $8 "/" $9 }' "$B/both" >"$B/moved"
    echo "  the named record's pairs whose lo_in, lo or either class changed: $(count_lines "$B/moved")"
    sed 's/^/    /' "$B/moved"
    check "no verdict and no class of the named record's pairs moved" "$(yn [ "$(count_lines "$B/moved")" = 0 ])"
    printf 'x\tok\tok\tnone\tnone\tok\tfail\tnone\trefused\n' >"$B/c-both"
    moved_ctl() { [ "$(awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9' "$B/c-both" | wc -l)" = 1 ]; }
    check "control: the same form finds a planted row whose lo moved" "$(yn moved_ctl)"
    echo "  the changed pairs' verdicts (test, lo_in, lo, reason_in, reason_out; none expected, change NUR):"
    join -t "$TAB" "$B/changed.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) | sed 's/^/    /'
    echo "  the new pairs' verdicts (test, lo_in, lo, reason_in, reason_out):"
    join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) | sed 's/^/    /'
    no_new_finding() { [ "$(join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7 | LC_ALL=C sort) | awk -F'\t' '$2 == "ok" && $3 != "ok"' | wc -l)" = 0 ]; }
    check "no new pair's output is refused on an accepted input" "$(yn no_new_finding)"
    echo
    echo "### acceptance, and the inputs LibreOffice did not accept"
    tail -n +2 "$TXT" | awk -F'\t' -v OFS='\t' '{ print ($1 ~ /^emend-copy\./ ? "tool" : "crate"), $1, $6, $7, $8, $9 }' >"$B/verdicts"
    for side in crate tool; do
      n=$(awk -F'\t' -v s="$side" '$1 == s' "$B/verdicts" | wc -l)
      nfind=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "ok" && $4 == "fail"' "$B/verdicts" | wc -l)
      nerr=$(awk -F'\t' -v s="$side" '$1 == s && ($3 == "error" || $4 == "error")' "$B/verdicts" | wc -l)
      nin=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "fail"' "$B/verdicts" | wc -l)
      echo "  $side: pairs $n; inputs refused $nin; outputs refused on an accepted input $nfind; checks that did not run $nerr"
      check "$side: no output refused on an accepted input" "$(yn [ "$nfind" = 0 ])"
      check "$side: no check errored" "$(yn [ "$nerr" = 0 ])"
    done
    awk -F'\t' '$5 == "count" { print $2 }' "$B/verdicts" >"$B/count.pairs"
    awk -F'\t' '$2 == "yes" && $3 == "0" { print $1 }' "$B/wb.all" >"$B/zero.pairs"
    echo "  count-class inputs $(count_lines "$B/count.pairs"); kept inputs with a workbook entry and no sheet element $(count_lines "$B/zero.pairs")"
    check "the count-class inputs are exactly the kept inputs with a workbook entry and no sheet element, so no count differs" "$(yn cmp -s "$B/count.pairs" "$B/zero.pairs")"
    echo "  the pairs whose input LibreOffice did not accept, with the class of the input's reason:"
    awk -F'\t' '$3 != "ok" { print $2 "\t" $5 }' "$B/verdicts" | sed 's/^/    /'
    echo
    echo "### the open-check record installed into records/"
    echo "command: install -m 644 <scripts>/out/records/$STEM_OPEN.md <scripts>/out/records/$STEM_OPEN.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt")
    echo "  exit: $?"
    for f in "$STEM_OPEN.md" "$STEM_OPEN.txt"; do
      echo "    written <scripts>/out/records/$f: sha256 $(sha_of "$RECORDS/$f"), $(wc -c <"$RECORDS/$f") bytes"
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, byte for byte, mode 644" "$(yn inst_same "$f")"
    done
    fi
    
    echo
    echo "## the record files this run installed hold no path"
    echo "  record files installed by this run: ${#INSTALLED[@]}"
    no_path() {
      local f
      [ "${#INSTALLED[@]}" -ge 1 ] || return 1
      for f in "${INSTALLED[@]}"; do
        [ "$(count_matches -F "$HOME" "$f")" = 0 ] || return 1
        [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$f")" = 0 ] || return 1
      done
    }
    check "no record file this run installed names <home>, a home, mount, temporary or corpus path" "$(yn no_path)"
    n_inst_want=6
    if [ "$RUN_SKIP_KEEP" = yes ]; then n_inst_want=4; fi
    check "this run installed the record files it writes ($n_inst_want: the charts pair, the kinds pair, and the open pair unless the keep was skipped; changes NUF and NUQ)" "$(yn [ "${#INSTALLED[@]}" = "$n_inst_want" ])"
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x' >"$B/c-path"
    path_ctl() { [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$B/c-path")" = 1 ]; }
    check "control: the same form finds a planted path" "$(yn path_ctl)"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  planning's uncommitted spec: $SPEC, sha256 $(sha_of "$SPEC")"
    echo "status lines: $st_all; of them this phase's logs, its record pairs or planning's uncommitted spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources (the phase commit's, by git show; change NSB)
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
  control count_matches with a regular expression: 2 (expect 2)
  control count_matches on an unreadable file: error (expect error)
  control count_matches on readable plus unreadable: error (expect error)
