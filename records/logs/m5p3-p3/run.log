    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the sample's child and --lo-timeout $LO_TIMEOUT_S per conversion, the figures every corpus run since Milestone 3 used; not tuned during the run."
    echo "root: <repo> stands for the repository's top level (inside <home>, scrubbed after <runs> and <corpus>, whose paths begin with it); scripts/counting.sh is read from it at the phase commit by git show; scripts/passthrough-run.sh, scripts/passthrough-record.py and scripts/edit-open-check.sh are run from it, each checked equal to the phase commit's, and the runner and the open check each source scripts/lo-check.sh, which is never run; the keep's tests run in it; the three record pairs are installed into its $RECORDS_DEST/"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m5p3-p3 on the disk, the phase's directory"
    echo "root: <scratch> stands for <phase>, the phase's directory, named <scratch> where TMPDIR is concerned as the close-out's scripts name it: TMPDIR is <scratch>/tmp, made and exported by this script before any mktemp, and <work> is made under it (close-out ruling 1; change NTI)"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory, which holds the script and the check beside it, chartscmp.py (change NUC), and the CHANGELOG check's two programs, changelog_check.py and p1_checks.sh (change NUS); the three record pairs are written into <scripts>/out/records first, a superseded run directory and a superseded keep are moved into <scripts>/out/superseded, and this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (change NTI; the counting library, the check copied from beside this script, their outputs, derived tables, the planted listings and run directory, the runs' TMPDIR <work>/tmp-run, the open check's TMPDIR <work>/tmp, the planted kinds run <work>/c-kinds, change NUD, the planted P1 run <work>/c-p1, change NUJ, the size log's release binaries copied into <work>/bin, change NUO), kept after the run and never removed"
    echo "root: <target> stands for <phase>/target on the disk, the phase's one target root: this log builds <repo> into <target>/main, the main tree's subdirectory, the keep's tests, and into no other; it builds no release binary (changes NSK and NUO)"
    echo "root: <sizebuild> stands for the size log's build directory, <target>/main unless SIZE_BUILD_ROOT names another for a dry run (change NUO)"
    echo "root: <keep> stands for <phase>/keep-host on the disk unless RUN_KEEP names another for a dry run, this phase's host keep; kept after the run for planning"
    echo "root: <corpus> stands for the private corpus directory (the manifest and the inputs under <corpus>/corpus, read)"
    echo "root: <runs> stands for the corpus run directories' parent, <corpus>/runs unless RUN_OUT_ROOT names another for a dry run; this log's run directories <runs>/$RUN-$SAMPLE and <runs>/$RUN-kinds are written there; M5 part 2 P3's kinds run, P1's charts run and P2's charts run, each <corpus>/runs/<name>, are read (changes NUD, NUJ, NUP and NUQ)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
