    def build(parts):
        buf = io.BytesIO()
        with zipfile.ZipFile(buf, "w") as z:
            for name, data in parts:
                z.writestr(name, data)
        return buf.getvalue()
    
    
    def as_tool(line):
        return "charts\t" + "\t".join(line.split(" ")[:len(TOOL_KEYS)])
    
    
    def selftest():
        base = build(fixture_parts())
        line = compare(base, base)
        checks = []
        checks.append(("the fixture's line is the tool test's", as_tool(line) == TOOL_LINE))
        checks.append(("entries_same and chart_rule hold on the fixture against itself",
                       kv(line, "entries_same") == "yes" and kv(line, "chart_rule") == "yes"))
        checks.append(("the fixture's own keys: one drawing, two chart relationships, two typed chart parts",
                       [kv(line, k) for k in CHECK_KEYS[:3]] == ["1", "2", "2"]))
        checks.append(("the fixture's largest chart part is its first, by bytes",
                       kv(line, "largest_chart") == str(len(fixture_parts()[10][1]))))
        parts = fixture_parts()
        parts[5] = ("xl/styles.xml", b"<styleSheet/> ")
        checks.append(("control: entries_same is no for an output with one entry's bytes changed",
                       kv(compare(base, build(parts)), "entries_same") == "no"))
        checks.append(("control: entries_same is no for an output with one entry dropped",
                       kv(compare(base, build(fixture_parts()[:-1])), "entries_same") == "no"))
        untyped = build(fixture_parts(chart_type=False))
        checks.append(("control: chart parts not typed as charts break chart_rule",
                       kv(compare(untyped, untyped), "chart_rule") == "no"))
        try:
            compare(build(fixture_parts("rId9")), build(fixture_parts("rId9")))
            refused = False
        except ValueError:
            refused = True
        checks.append(("control: a c:chart naming no relationship is refused, as the tool refuses it", refused))
        checks.append(("control: the digest of the series names is the tool test's, and another order gives another",
                       kv(line, "digest_names") == fnv(["Data!$B$1", "Plan"])
                       and fnv(["Plan", "Data!$B$1"]) != fnv(["Data!$B$1", "Plan"])))
        pc = compare(base, base, "count")
        checks.append(("control: the count plant turns charts to 3 and is marked planted",
                       kv(pc, "charts") == "3" and kv(pc, "planted") == "yes"))
        pr = compare(base, base, "chart_rule")
        checks.append(("control: the chart_rule plant turns chart_rule to no", kv(pr, "chart_rule") == "no"))
        pe = compare(base, base, "entries_same")
        checks.append(("control: the entries_same plant turns entries_same to no", kv(pe, "entries_same") == "no"))
        pd = compare(base, base, "digest")
        checks.append(("control: the digest plant changes digest_titles and nothing else of the tool's keys",
                       kv(pd, "digest_titles") != kv(line, "digest_titles")
                       and [kv(pd, k) for k in COUNT_KEYS] == [kv(line, k) for k in COUNT_KEYS]))
        checks.append(("control: the tool test's line is refused by the same comparison against a line one count off",
                       as_tool(compare(base, base, "count")) != TOOL_LINE))
        nochoice = build(fixture_parts(choice=""))
        checks.append(("control: a root AlternateContent whose first Choice holds no style gives no style, its Fallback not read",
                       kv(compare(nochoice, nochoice), "styles") == "1"))
        pa = compare(base, base, "axes")
        checks.append(("control: the axes plant turns axes to 3 and is marked planted",
                       kv(pa, "axes") == "3" and kv(pa, "planted") == "yes"))
        ps = compare(base, base, "sources")
        checks.append(("control: the sources plant changes digest_sources and nothing else of the tool's keys",
                       kv(ps, "digest_sources") != kv(line, "digest_sources")
                       and [kv(ps, k) for k in COUNT_KEYS] == [kv(line, k) for k in COUNT_KEYS]))
        checks.append(("control: the digest of the number formats is the tool test's, and another order gives another",
                       kv(line, "digest_numfmts") == fnv(["General", "0%"])
                       and fnv(["0%", "General"]) != fnv(["General", "0%"])))
        checks.append(("control: the tool test's line is refused against the axes plant's",
                       as_tool(pa) != TOOL_LINE))
        assert len(checks) == SELFTEST_LINES
        for name, ok in checks:
            print("%s: %s" % (name, "yes" if ok else "no"))
    
    
    def main(argv):
        if argv == ["--selftest"]:
            selftest()
            return 0
        if len(argv) not in (3, 5) or argv[0] != "charts":
            sys.stderr.write(__doc__)
            return 2
        plant = None
        if len(argv) == 5:
            if argv[3] != "--plant":
                sys.stderr.write(__doc__)
                return 2
            plant = argv[4]
            if plant not in FLAGS_OF["charts"] + ("count", "digest", "axes", "sources"):
                print("error=unknown-plant")
                return 0
        with open(argv[1], "rb") as f:
            a = f.read()
        with open(argv[2], "rb") as f:
            b = f.read()
        try:
            print(compare(a, b, plant))
        except Exception as e:  # a part this check cannot read: named by kind, never by content
            print("error=%s" % type(e).__name__)
            return 1
        return 0
    
    
    if __name__ == "__main__":
        sys.exit(main(sys.argv[1:]))
