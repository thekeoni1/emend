    # and the body grepped afterwards for part 5 P1's names, subjects, stems and
    # the tokens rtcmp, rtsurvey, roundtrip and m3p5-p1. Part 5 P1's run script
    # is the template, not P2's: P2's carried P1's whole and changed only what
    # its read sample (no comparison, every entry identical) and tier d's
    # --items needed, none of which arises here; a sample that writes parts,
    # with a comparison and a survey, is P1's shape. What differs, and why:
    #  UA. The phase, the log directory, the subjects, the script directory
    #      (<scripts>, <home>/.cache/emend-build/m3p6-p1/scripts, on the disk),
    #      the build directory (m3p6-p1/run) and the keep (m3p6-p1/keep-host) are
    #      this phase's; the base is M3 part 5's close-out record commit ("M3
    #      part 5 close-out record:"); the phase commit is P1's tool commit by
    #      its subject ("M3 part 6 P1: emend-copy --commentbox-sample"); the
    #      record stems are m3p6-p1- and m3p6-open-; the spec is
    #      specs/0028-images-and-comments-second-half.md, its committed blob at
    #      P1's doc commit pinned through SPEC_SHA, a ruling of planning's
    #      standing uncommitted in the working tree's copy should one come.
    #  UB. Change SB's form (after a close-out): the committed open-check record
    #      the keep is compared with is M3 part 5 P3's, the last committed, named
    #      by its record commit, resolved by its subject ("M3 part 5 P3
    #      record:"; no hash is typed into this script), checked to be a record
    #      commit that added exactly one open-check .txt with no later commit
    #      adding another; it is an ancestor of the base, not the base, and the
    #      base is the parent of P1's doc commit; the control names the base
    #      instead.
    #  UC. The comparison is cbcmp.py, built for this phase from M2 part 4d P1's
    #      cmtcmp.py (<home>/.cache/emend-build/m3p6-p1/gen/cbcmp_build.py,
    #      each replacement asserted): its ten flags stand with the sample's
    #      text emend box and the note the shown box's, and five are added:
    #      box_style, visible_child and kept_shapes (the spec's commentbox
    #      checks), xml_values and flagged (specs/0024 P1 verification ruling 6,
    #      rtcmp.py's form over every changed .xml, .rels and .vml entry);
    #      --parts prints part 4d's seven lines. The line's relations are the
    #      spec's: comments_after and shapes_after one more than before,
    #      sized_before no more than comments_before, box_equal and
    #      visible_after 1; the tool's counts equal the comparison's (comments
    #      and note shapes in and out, the sized comments in, box_ok and
    #      visible_out). The entries are part 4d P1's rule (its change EC), by
    #      W's legacyDrawing and comments relationship: where W has neither, W
    #      and the content types changed, W's rels part changed or added where
    #      the input has none, the comments and VML parts added; where W has
    #      both, the comments and VML parts changed; where W has the VML part
    #      alone, the VML part, the rels part and the content types changed and
    #      the comments part added; every other row identical and unflagged,
    #      nothing recompressed or dropped; a changed row flagged descriptor at
    #      most, and exactly when its input entry sets bit 3 by the
    #      comparison's flagged. The created parts (2, 1 or 0) are printed per
    #      workbook and totalled.
    #  UD. NEW, the survey (cbsurvey.py, <scripts>, copied into <work> and
    #      printed) replaces SD's, in SD's form: <corpus> its parameter, every
    #      regular file of <corpus>/corpus listed, one wb line of nine fields
    #      per workbook; the log checks its forms, prints the distributions and
    #      checks every line's comments_before, shapes_before and sized_before
    #      against it.
    #  UE. Changes PE, QE and SE (every row ok) stand; LF (the descriptor flags
    #      and the derived values, now over every changed .xml, .rels and .vml
    #      entry) and LG (TMPDIR on the disk) stand.
    #  UF. Change SF (the calculation chain) stands, the entries rule (UC)
    #      leaving the chain identical: no cell or formula is written.
    #  UG. Change SG (no row written) stands: the comment goes on (M + 1, 1)
    #      in the comments and VML parts; W gains at most a legacyDrawing.
    #  UH. Change PH (the open check's own TMPDIR device) stands, unchanged.
    #  UI. The plants: every flag's planted control runs on the first ok
    #      workbook in manifest order whose comments and VML parts the sample
    #      creates (created 2) and on the first whose it keeps (created 0), each
    #      on its own check line, the plant turning its own flag; kept_shapes on
    #      the created case has no kept shape to change, and its line checks the
    #      plant reports planted=no there and the flag stays yes; a case the
    #      corpus does not hold fails its line.
    #  UJ. The run loop, the record pair, the keep and the open check are SJ's
    #      with this phase's names; the families the record's check derives are
    #      the ones UC's rule changes and adds, by the record script's own
    #      family rule.
    #  UK. SK stands: this script runs no `rm -rf`; the sourced
    #      scripts/counting.sh, a committed script, runs one on the directory its
    #      counting controls make (allowed: a directory the script created in
    #      that run); the working directory and the keeps stand, kept, and
    #      Python writes no bytecode.
    #
    #
    #
    # CARRIED TO M3 part 6 P2 from M3 part 6 P1's run script (at the phase
    # commit 2adf953, printed in records/logs/m3p6-p1/run.log; its change lists
    # up to UK are above), generated by <home>/.cache/emend-build/m3p6-p2/gen/
    # run.py, every replacement asserted to occur as often as it says, the top
    # summary and the body from the survey to the corpus record pair's
    # installation replaced whole (gen/run_block.sh, by its anchor lines), and
    # the body grepped afterwards for P1's names, subjects, stems and the tokens
    # cbcmp, cbsurvey, m3p6-p1 and STEM_RUN. What differs, and why:
    #  VA. The phase, the log directory, the subjects, the script directory
    #      (<scripts>, <home>/.cache/emend-build/m3p6-p2/scripts, on the disk),
    #      the build directory (m3p6-p2/run) and the keep (m3p6-p2/keep-host) are
    #      this phase's; the base is P1's record commit ("M3 part 6 P1
    #      record:"); the phase commit is P2's tool commit by its subject ("M3
    #      part 6 P2: emend-copy --anchor-sample and --remove-image-sample"); two
    #      samples, anchor and removeimage, each with its run directory
    #      <runs>/<date>-<sha>-<sample> and its record stem
    #      m3p6-p2-<sample>-<date>-<sha> (M3 part 5 P3's form), and a third run
    #      directory <runs>/<date>-<sha>-commentbox for the comment box sample's
    #      rerun; SUPERSEDED_RUN names the three by their common stem; the spec
    #      pinned through SPEC_SHA at P2's doc commit, planning's rulings during
    #      P2 standing uncommitted in the working tree's copy, printed.
    #  VB. Change UB's form: the committed open-check record the keep is
    #      compared with is P1's, the last committed, named by its record
    #      commit, resolved by its subject ("M3 part 6 P1 record:"; no hash is
    #      typed here); it is the base itself, the parent of P2's doc commit; the
    #      control names the doc commit instead.
    #  VC. The comparison is imgcmp.py, built for this phase (<home>/.cache/
    #      emend-build/m3p6-p2/gen/imgcmp_build.py) from M2 part 4d P3's
    #      imgcmp.py and P1's cbcmp.py readers, one program with a mode per
    #      sample: anchor carries part 4d's ten flags for two anchors and adds
    #      two_form, absolute_form and kept_children (the spec's anchor check),
    #      xml_values and flagged; removeimage has sheet_same, drawing_children,
    #      drawing_rels_set, media_dropped (the spec's removeimage checks),
    #      types_set, wrels_set, added_empty (ruling 2), images_read, xml_values
    #      and flagged. flagged reads every rewritten entry (changed or
    #      recompressed, ruling 1) and wants descriptor exactly when bit 3 or
    #      the bytes after the data differ, xlsx-diff's rule computed through
    #      the local headers: for a changed entry whose bit 3 both sides keep,
    #      that is P1's "when the input sets bit 3", and a recompressed one's
    #      descriptor carries its new compressed size. The lines' relations are
    #      the spec's: anchor two images, anchors and media entries more, one
    #      image of each anchor kind more; removeimage images_after the images
    #      less kept_removed, media_dropped the entries gone, 0 with nothing kept
    #      removed. The tool's counts equal the comparison's.
    #  VD. NEW, the survey (imgsurvey.py, <scripts>, copied into <work> and
    #      printed) replaces UD's, in its form: <corpus> its parameter, every
    #      regular file of <corpus>/corpus listed, one wb line of thirteen
    #      fields per workbook, one drawings line (decision 8: the drawing parts
    #      and the largest drawing's anchor count, printed); the log checks its
    #      forms, prints the distributions and checks every line's figures
    #      against it, and the comparison's parts against it.
    #  VE. Changes PE, QE and SE (every row ok) stand. The entries rules: anchor
    #      is M2 part 4d P3's image rule with two media entries; removeimage is
    #      the planning rulings during P2: with nothing kept removed, W, W's rels
    #      part, the content types and a drawing that stays identical or
    #      recompressed, its rels part changed with the same relationships
    #      allowed (ruling 1); at most one added row, W's rels part or the
    #      drawing's where the input has none, its root childless (ruling 2);
    #      an empty input drawing dropped with W, W's rels part and the content
    #      types changed or recompressed (ruling 3); with the first image
    #      removed, the spec's: the drawing and its rels part changed, the media
    #      entries the count rule drops dropped, the content types changed where
    #      an Override went. Each allowance has a control that accepts it where
    #      it applies and one that refuses it where it does not. The removal's
    #      summary totals are checked against its entries table, every row by
    #      the rule.
    #  VF. NEW, the comment box sample once more on both targets, its outputs
    #      by sha256, its lines and its diff tables P1's run's byte for byte, the
    #      run directory named by P1's record commit through the run record it
    #      added (M3 part 5 P3's change WC form); no record pair is written for
    #      the rerun.
    #  VG. Change UG's no-row rule stands: neither sample writes a cell, so the
    #      calculation chain's entry stays identical (change UF).
    #  VH. Change PH (the open check's own TMPDIR device) stands, unchanged.
    #  VI. The plants: every flag's planted control runs, for each sample, on
    #      the first ok workbook in manifest order of its created case (anchor:
    #      W has no drawing; removeimage: no image is kept and W has no drawing)
    #      and of its kept case (anchor: W has a drawing; removeimage: the first
    #      image is removed), each on its own check line, the plant turning its
    #      own flag; kept_children on the anchor's created case has no kept
    #      child to change, and its line checks the plant reports planted=no
    #      there and the flag stays yes; the anchor's kept case is a drawing
    #      with a root child (an empty drawing gives the case other). The xml
    #      values check wants some value written by the anchor sample and some
    #      removed by the removal, which writes none (change LF's form).
    #  VJ. The run loop, the record pairs, the keep and the open check are SJ's
    #      and WJ's with this phase's names; reccheck.py takes the dropped
    #      families as an input beside the changed and added ones; the anchor
    #      record's families are derived from the --parts lines, the removal
    #      record's from its entries table, which the rule checked row by row
    #      (the rulings allow a row recompressed or changed); six record files
    #      installed, four when the keep is skipped.
    #  VK. UK stands: this script runs no `rm -rf`; the sourced
    #      scripts/counting.sh, a committed script, runs one on the directory its
    #      counting controls make (allowed: a directory the script created in
    #      that run); the working directory and the keeps stand, kept, and
    #      Python writes no bytecode.
    #
    #
    #
    # CARRIED TO M3 part 6 P3 from M3 part 6 P2's run script (at the phase
    # commit d3c4a9c, printed in records/logs/m3p6-p2/run.log; its change lists
    # up to VK are above), generated by <home>/.cache/emend-build/m3p6-p3/gen/
    # run.py, every replacement asserted to occur as often as it says, the top
    # summary and the body from the survey to the corpus record pairs'
    # installation replaced whole (gen/run_block.sh, by its anchor lines, P2's
    # record check carried into it unchanged), and the body grepped afterwards
    # for P2's names, subjects, stems and the tokens imgcmp, imgsurvey,
    # m3p6-p2-, P1_REC and PREV_CB. What differs, and why:
    #  XA. The phase, the log directory, the subjects, the script directory
    #      (<scripts>, <home>/.cache/emend-build/m3p6-p3/scripts, on the disk)
    #      and the keep (m3p6-p3/keep-host) are this phase's; the base is P2's
    #      record commit ("M3 part 6 P2 record:"); the phase commit is P3's tool
    #      commit by its subject ("M3 part 6 P3: emend-copy --copy-sample"); one
    #      sample, copy, with its run directory <runs>/<date>-<sha>-copy and its
    #      record stem m3p6-p3-<date>-<sha> (the spec's name), and three rerun
    #      directories <runs>/<date>-<sha>-anchor, -removeimage and -commentbox
    #      (RERUNS); SUPERSEDED_RUN names the four by their common stem; the
    #      spec pinned through SPEC_SHA at P3's doc commit, planning's rulings
    #      during P3 standing uncommitted in the working tree's copy, printed.
    #  XB. Change VB's form: the committed open-check record the keep is
    #      compared with is P2's, the last committed, named by its record
    #      commit, resolved by its subject ("M3 part 6 P2 record:"; no hash is
    #      typed here); it is the base itself, the parent of P3's doc commit; the
    #      control names the doc commit instead. P2_REC names the same commit, the
    #      one whose run directories the reruns are compared with (change XF).
    #  XC. The comparison is copycmp.py, built for this phase (<home>/.cache/
    #      emend-build/m3p6-p3/gen/copycmp_build.py) with P2's imgcmp.py
    #      readers copied by name, one mode, copy, fifteen flags: whole_bytes,
    #      data_same, kept_same, views_same, setup_same, dropped_gone (the
    #      spec's copy check, and the copy built from S byte for byte),
    #      rels_set (ruling 1), comments_same and notes_placed (the spec's
    #      carried checks), workbook_sheet, types_set, chain_rule, rest_same,
    #      xml_values and flagged (P2's). The lines' relations are the spec's:
    #      one sheet more, the copy's counts its source's, no chain after a
    #      formula. The tool's counts equal the comparison's.
    #  XD. NEW, the survey (copysurvey.py, <scripts>, copied into <work> and
    #      printed) replaces VD's, in its form: <corpus> its parameter, every
    #      regular file of <corpus>/corpus listed, one wb line of twenty fields
    #      per workbook; the log checks its forms, prints the distributions and
    #      checks every line's figures against it, and the comparison's parts
    #      against it. No drawings line (no decision rests on one here).
    #  XE. Changes PE, QE, SE and VE (every row ok) stand. The entries rule is
    #      the rulings during P3's: the copy's entry added; its rels part added
    #      exactly when S has a hyperlink or a comments relationship (ruling 1);
    #      the comments and VML parts added when carried; the workbook part, its
    #      rels part and the content types changed, flagged descriptor at most;
    #      the chain's entry dropped exactly when S holds a formula and the
    #      workbook a chain; every other row identical and unflagged; nothing
    #      recompressed. Each allowance has a control that accepts it where it
    #      applies and one that refuses it where it does not. The summary's
    #      totals are checked against what the rows imply and against the
    #      entries table.
    #  XF. NEW, the three earlier samples once more on both targets, their
    #      outputs by sha256, their lines and their diff tables P2's runs' byte
    #      for byte (change VF's form for three samples), the run directories
    #      read from the "the run directories:" line of P2's run log at P2's
    #      record commit and checked against the run directory P2's committed
    #      anchor record names; no record pair is written for the reruns.
    #  XG. Change UG's no-row rule gives way: the copy makes the write a formula
    #      change when S holds a formula (specs/0013's rule, "The copy"), so
    #      each chain workbook's calcChain row is dropped exactly there, and is
    #      identical and unflagged elsewhere; some row is dropped.
    #  XH. Change PH (the open check's own TMPDIR device) stands, unchanged.
    #  XI. The plants: every flag's planted control runs on the first ok
    #      workbook in manifest order of the plain case (S's comments not
    #      carried) and of the carried case, each on its own check line, the
    #      plant turning its own flag; every flag has a plant on both cases.
    #      The xml values check wants some value written (the workbook's new
    #      sheet; change LF's form).
    #  XJ. The run loop, the record pair, the keep and the open check are VJ's
    #      with this phase's names; the record's families are derived from its
    #      entries table, which the rule checked row by row; four record files
    #      installed, two when the keep is skipped.
    #  XK. Ruling 8 of the planning rulings during P2 (build pruning) and
    #      ruling 10 of the planning rulings during P3 (one target root per
    #      phase, one subdirectory per source tree): the phase's target root is
    #      <target>, <home>/.cache/emend-build/m3p6-p3/target, and every build
    #      of <repo> by this script, dry or logged, goes into <target>/main
    #      (CARGO_TARGET_DIR), the subdirectory ruling 10 gives the main tree;
    #      this script builds from no other tree. P2's <build> placeholder (a
    #      run directory holding its own target) is gone with the input
    #      RUN_BUILD_ROOT, so no run moves the builds, and nothing here cleans
    #      them; the i686 keep is <work>/keep-i686, kept, not under the target.
    #      VK stands: this script runs no `rm -rf`.
    #
    # Usage: m5p3-p3-run.sh <phase commit> [<size log>] > <file outside the tree>;
    # the caller moves the output to records/logs/m5p3-p3/run.log (changes NUN
    # and NUO; the size log defaults to <phase>/logs/size.log).
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    # Every environment input, as it was set, before any is unset.
    INPUT_NAMES="RUN_SUFFIX SUPERSEDED_RUN SUPERSEDED_KEEP RERUN_NOTE RERUN_FILES RECORDS_DEST RUN_KEEP RUN_OUT_ROOT RUN_SKIP_KEEP SIZE_BUILD_ROOT EMEND_CORPUS_DIR EMEND_KEEP_DIR HOME"
    declare -A INPUT_SEEN
    for v in $INPUT_NAMES; do
      if [ -n "${!v+x}" ]; then INPUT_SEEN[$v]=${!v}; else INPUT_SEEN[$v]=unset; fi
    done
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    # Python writes no bytecode, so nothing arises to be removed.
    export PYTHONDONTWRITEBYTECODE=1
    # Change NTK (M5 part 1 P3's NTC, carried): every cargo command of this log
    # runs offline; the two settings are printed below.
    export CARGO_NET_OFFLINE=true
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR RUSTDOCFLAGS RUSTFLAGS
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    LO_TIMEOUT_S=600
    SPEC=specs/0034-charts-read.md
    # Change NUN: the committed blob the doc commit 91c1cee holds (planning's
    # P3 brief, pasted from sha256sum).
    SPEC_WANT=e27803e8ef9746796665a395a19ba303a7f01b94d3a21df6ddb49795dcc4ef4a
    SAMPLE=charts
    EDIT=--charts-sample
    PHASE_DIR=$HOME/.cache/emend-build/m5p3-p3
    # Change NSK: every build of <repo>, dry or logged, goes into the main tree's
    # subdirectory of the phase's one target root, <target>/main; no input moves
    # it and nothing here cleans it. The logged run leaves RUN_KEEP unset; a dry
    # run points it elsewhere so it leaves no keep where the logged run refuses
    # one.
    TARGET_ROOT=$PHASE_DIR/target
    BUILD_ROOT=$TARGET_ROOT/main
    # Change NUO (M5 part 2 P3's NTT, carried): the size log and its build
    # directory, whose release binaries the charts and kinds runs use.
    SIZE_LOG=${2:-$PHASE_DIR/logs/size.log}
    SIZE_BUILD=${SIZE_BUILD_ROOT:-$TARGET_ROOT/main}
    KEEP=${RUN_KEEP:-$PHASE_DIR/keep-host}
    RUN_OUT_ROOT=${RUN_OUT_ROOT:-$CORPUS/runs}
    RUN_SKIP_KEEP=${RUN_SKIP_KEEP:-no}
    case $RUN_SKIP_KEEP in yes | no) ;; *) echo "RUN_SKIP_KEEP is yes or no" >&2; exit 2 ;; esac
    INSTALLED=()
    I686=i686-unknown-linux-musl
    RECORDS_DEST=${RECORDS_DEST:-records}
    # A keep in place is another attempt's, moved below once the header can list
    # it; without SUPERSEDED_KEEP naming the attempt it is refused.
    SUPERSEDED_KEEP=${SUPERSEDED_KEEP:-}
    case $SUPERSEDED_KEEP in '' | attempt-[1-9]) ;; *) echo "SUPERSEDED_KEEP is attempt-<n> or nothing" >&2; exit 2 ;; esac
    if [ "$RUN_SKIP_KEEP" = no ] && [ -e "$KEEP" ] && [ -z "$SUPERSEDED_KEEP" ]; then echo "$KEEP is already there; name its attempt in SUPERSEDED_KEEP" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT
    RECORDS=$SELF_DIR/out/records
    # Change NTI: TMPDIR is <scratch>/tmp, the phase's directory's, made and
    # exported before any mktemp (close-out ruling 1); the working directory
    # is the one mktemp -d makes under it, on the disk, kept; nothing here is
    # removed.
    TMPDIR=$PHASE_DIR/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    B=$(mktemp -d) || exit 2
    # Change NSB: the counting library is the phase commit's, by git show.
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT=$(git rev-parse --short=7 "$C")
    DATE=$(date -u +%Y-%m-%d)
    # What the status pattern admits (changes NSB, NUB, NUI and NUN): this
    # phase's log directory, this phase's three record pairs (named by the run's
    # date and the phase commit's short sha, untracked), the size and API
    # records the size and test logs install (any date, the phase commit's short
    # sha) and planning's modified specs/0034; nothing else.
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m5p3-p3/|\\?\\? records/m5p3-(p3-charts|p3-kinds|open)-$DATE-$SHORT[.](md|txt)\$|\\?\\? records/(size|api-review)-m5p3-20[0-9][0-9]-[01][0-9]-[0-3][0-9]-$SHORT[.]md\$| M specs/0034-charts-read[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs, records and planning's spec" >&2
      exit 2
    fi
    STEM=m5p3-p3-charts-$DATE-$SHORT
    K_STEM=m5p3-p3-kinds-$DATE-$SHORT
    STEM_OPEN=m5p3-open-$DATE-$SHORT
    # A rerun takes a suffix, so its run directory is never the superseded one.
    RUN_SUFFIX=${RUN_SUFFIX:-}
    case $RUN_SUFFIX in '' | -[b-z]) ;; *) echo "RUN_SUFFIX is -b to -z or nothing" >&2; exit 2 ;; esac
    RUN=$DATE-$SHORT$RUN_SUFFIX
    O=$RUN_OUT_ROOT/$RUN-$SAMPLE
    mkdir -p "$RECORDS" "$RECORDS_DEST" || exit 2
    # A rerun names the superseded run directory, which is MOVED into
    # <scripts>/out/superseded after the header prints it, never removed; it
    # must be another run of this phase, not this one.
    SUPERSEDED_RUN=${SUPERSEDED_RUN:-}
    case $SUPERSEDED_RUN in
      '' | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f] | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[b-z]) ;;
      *) echo "SUPERSEDED_RUN is not a run directory's name" >&2; exit 2 ;;
    esac
    if [ -n "$SUPERSEDED_RUN" ] && [ "$SUPERSEDED_RUN" = "$RUN" ]; then echo "SUPERSEDED_RUN names this run's own directory" >&2; exit 2; fi
    for f in "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt" \
             "$RECORDS/$STEM.md" "$RECORDS/$STEM.txt" "$RECORDS_DEST/$STEM.md" "$RECORDS_DEST/$STEM.txt" \
             "$RECORDS/$K_STEM.md" "$RECORDS/$K_STEM.txt" "$RECORDS_DEST/$K_STEM.md" "$RECORDS_DEST/$K_STEM.txt"; do
      if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
    done
    # A run directory that exists before the run is another attempt's; refused
    # (the runner itself refuses one holding an earlier run's conversion
    # directories, specs/0030 decision 1 A).
    if [ -e "$O" ]; then echo "$O is already there; name a fresh run" >&2; exit 2; fi
    if [ -e "$RUN_OUT_ROOT/$RUN-kinds" ]; then echo "$RUN_OUT_ROOT/$RUN-kinds is already there; name a fresh run" >&2; exit 2; fi
    
    # The corpus's path begins with <repo>'s, so <runs> and <corpus> are
    # replaced before <repo> (M4 part 1 P3's order); the phase's directories
    # before <phase>, and <home> last.
    scrub() {
      sed -e "s#$B#<work>#g" -e "s#$TMPDIR#<scratch>/tmp#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$KEEP#<keep>#g" \
        -e "s#$TARGET_ROOT#<target>#g" -e "s#$RUN_OUT_ROOT#<runs>#g" -e "s#$CORPUS#<corpus>#g" \
        -e "s#$MAIN#<repo>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M5 part 3 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # The environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo "input (as exported by this script, change NTK): PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE CARGO_NET_OFFLINE=$CARGO_NET_OFFLINE"
    echo "input: TMPDIR=$TMPDIR"
    echo "  (TMPDIR set, made and exported by this script before any mktemp; <work> is made under it: close-out ruling 1; change NTI)"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change NTJ: the fourth shape, PYB: a Python call without -I -B (the word
    # followed by whitespace and an option or a .py path, outside a comment,
    # and not by " -I -B"). The word is built from two halves, so that this
    # form's own text is no call.
    PYW=pyth
    PYW=${PYW}on3
    pyb_count() {
      awk -v w="$PYW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { r = substr(s, i + length(w)); if (r ~ /^[ \t]+(-|[^ \t]*[.]py([ \t"]|$))/ && r !~ /^ -I -B( |$)/) { n++; break }; s = r }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "$PYW -c x" "$PYW -I -B -c x" "# $PYW -c x" "command -v $PYW" "$PYW tool.py" >"$B/pyb-fixture"
    n_self=$(pyb_count "$SELF")
    n_fix=$(pyb_count "$B/pyb-fixture")
    echo "command: pyb_count <this script>, and the same over a fixture of five lines: a call with -c, one with -I -B -c, a comment, a command -v, a call of a .py path"
    echo "  shape PYB: in this script $n_self; in the fixture $n_fix"
    check "PYB: this script holds none (change NTJ)" "$(yn [ "$n_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's two calls without -I -B and not its other three lines" "$(yn [ "$n_fix" = 2 ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M5 part 3 P2 record: logs, the charts sample and open records, the check')
    DOC=$(by_subject 'M5 part 3 P3: commit planning docs (the P2 verification and rulings)')
    CARRY=$(by_subject "M5 part 3 P3: the carry, a style in the Choice, the bounds' spellings, the test names")
    PROBE=$(by_subject 'M5 part 3 P3: probe-emend-charts-write-xml')
    CLOG=$(by_subject 'M5 part 3 P3: the CHANGELOG names charts read')
    # Change NUR: the record the keep is compared with is P2's open-check
    # record, which the base, P2's record commit, added (no hash is typed
    # here); checked below.
    PREV_OPEN_REC=$REC
    # Change NUP: P2's run, whose outputs and lines this run's charts rows are
    # compared with by sha256, named by P2's run record, which the same base
    # added; its run directory is read from the record's own text.
    P2_REC=$REC
    # Change NUN: P1's run, whose lines the P1 fields are compared with (NUJ,
    # carried), named by P1's run record, which P1's record commit added; that
    # commit is found by its own subject now that the base is not it.
    P1_REC=$(by_subject 'M5 part 3 P1 record: logs, the charts sample and open records, the check')
    # Change NUD, carried: the kinds run the charts line is compared with,
    # workbook for workbook, named by M5 part 2 P3's kinds record, which that
    # phase's record commit added; its run directory is read from the record's
    # own text. Change NUQ: the same run is the one this log's kinds run is
    # compared with, row for row, by sha256.
    KINDS_REC=$(by_subject 'M5 part 2 P3 record: logs, the sample, size, API and open records, the checks')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  M5 part 3 P2's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the carry commit: ${CARRY:-none}"
    echo "  the probe commit: ${PROBE:-none}"
    echo "  the CHANGELOG commit, the phase commit: ${CLOG:-none}"
    echo "  M5 part 3 P2's record commit, the last to add an open-check record and the one that added P2's run record, the base (changes NUP and NUR): ${PREV_OPEN_REC:-none}"
    echo "  M5 part 3 P1's record commit, the one that added P1's run record (changes NUJ, carried, and NUN): ${P1_REC:-none}"
    echo "  M5 part 2 P3's record commit, the one that added the kinds record (changes NUD, carried, and NUQ): ${KINDS_REC:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CLOG" "$PROBE" "$CARRY" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the CHANGELOG commit, the probe commit, the carry commit, the doc commit and the base, each the next one's parent, the CHANGELOG commit the phase commit (change NUN)" "$(yn roles_in_order)"
    roles_ctl() { local CLOG=$PROBE; roles_in_order; }
    check "control: roles_in_order refuses the probe commit named as the phase commit (change NUN)" "$(ynnot roles_ctl)"
    roles_ctl2() { local REC=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the base" "$(ynnot roles_ctl2)"
    echo "command: git log -1 --format=%s <M5 part 3 P2's record commit>"
    echo "    $(git log -1 --format=%s "$PREV_OPEN_REC")"
    prev_is_record() { [ -n "$PREV_OPEN_REC" ] && git cat-file -e "$PREV_OPEN_REC^{commit}" && [ "$(git log -1 --format=%s "$PREV_OPEN_REC" | LC_ALL=C "$G" -cE '^M5 part 3 P2 record: ')" = 1 ] && git merge-base --is-ancestor "$PREV_OPEN_REC" "$C"; }
    check "the named record commit is M5 part 3 P2's record commit, an ancestor of the phase commit (change NUR)" "$(yn prev_is_record)"
    prev_ctl() { local PREV_OPEN_REC=$DOC; prev_is_record; }
    check "control: the same check refuses the doc commit named instead" "$(ynnot prev_ctl)"
    p1_is_record() { [ -n "$P1_REC" ] && [ "$(git log -1 --format=%s "$P1_REC" | LC_ALL=C "$G" -cE '^M5 part 3 P1 record: ')" = 1 ] && git merge-base --is-ancestor "$P1_REC" "$REC"; }
    check "P1's run record's commit is M5 part 3 P1's record commit, an ancestor of the base (change NUN)" "$(yn p1_is_record)"
    p1_rec_ctl() { local P1_REC=$DOC; p1_is_record; }
    check "control: the same check refuses the doc commit named instead" "$(ynnot p1_rec_ctl)"
    kinds_is_record() { [ -n "$KINDS_REC" ] && [ "$(git log -1 --format=%s "$KINDS_REC" | LC_ALL=C "$G" -cE '^M5 part 2 P3 record: ')" = 1 ] && git merge-base --is-ancestor "$KINDS_REC" "$C"; }
    check "the kinds record's commit is M5 part 2 P3's record commit, an ancestor of the phase commit (change NUD, carried)" "$(yn kinds_is_record)"
    kinds_rec_ctl() { local KINDS_REC=$DOC; kinds_is_record; }
    check "control: the same check refuses the doc commit named instead" "$(ynnot kinds_rec_ctl)"
    # Change NUD: the kinds record M5 part 2 P3's record commit added, and the
    # run directory its .md names ("Written by ... from the run directory
    # `<name>`"), read from the phase commit's copy.
    KINDS_MD=$(git show --name-only --format= "$KINDS_REC" | LC_ALL=C "$G" -E '^records/m5p2-p3-kinds-[0-9-]+-[0-9a-f]{7}[.]md$')
    echo "command: git show --name-only --format= <M5 part 2 P3's record commit>, the kinds record's .md it added: ${KINDS_MD:-none}"
    check "the record commit added exactly one kinds record .md (change NUD)" "$(yn [ "$(printf '%s\n' "$KINDS_MD" | count_lines /dev/stdin)" = 1 ])"
    kinds_run_of() { git show "$C:$1" 2>/dev/null | sed -n 's/^Written by .* from the run directory `\([^`]*\)`.*$/\1/p' | head -n 1; }
    KINDS_RUN_NAME=$(kinds_run_of "$KINDS_MD")
    KINDS_RUN=$CORPUS/runs/$KINDS_RUN_NAME
    echo "  the run directory the kinds record names: <corpus>/runs/${KINDS_RUN_NAME:-none}"
    kinds_run_ok() { [ -n "$KINDS_RUN_NAME" ] && [ -d "$KINDS_RUN" ] && [ -f "$KINDS_RUN/summary.host.tsv" ] && [ -f "$KINDS_RUN/summary.i686.tsv" ]; }
    check "the kinds run directory is there with both labels' summaries (change NUD)" "$(yn kinds_run_ok)"
    kinds_run_ctl() { local KINDS_RUN_NAME=no-such-run KINDS_RUN=$CORPUS/runs/no-such-run; kinds_run_ok; }
    check "control: the same check refuses a run directory that is not there" "$(ynnot kinds_run_ctl)"
    kinds_args_ok() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$KINDS_RUN/run.host.tsv")" = --kinds-sample ]; }
    check "the kinds run's run row names --kinds-sample (change NUD)" "$(yn kinds_args_ok)"
    kinds_commit_ok() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "commit") k = i; next } k && NR == 2 { print $k }' "$KINDS_RUN/run.host.tsv")" = "$(git rev-parse "$KINDS_REC~1")" ]; }
    check "the kinds run's run row names M5 part 2 P3's phase commit, its record commit's parent (change NUQ)" "$(yn kinds_commit_ok)"
    # Change NUJ: P1's run record P1's record commit added, and the run
    # directory its .md names, read from the phase commit's copy as the kinds
    # run's is.
    P1_MD=$(git show --name-only --format= "$P1_REC" | LC_ALL=C "$G" -E '^records/m5p3-p1-[0-9-]+-[0-9a-f]{7}[.]md$')
    echo "command: git show --name-only --format= <M5 part 3 P1's record commit>, P1's run record's .md it added: ${P1_MD:-none}"
    check "P1's record commit added exactly one P1 run record .md (change NUJ)" "$(yn [ "$(printf '%s\n' "$P1_MD" | count_lines /dev/stdin)" = 1 ])"
    P1_RUN_NAME=$(kinds_run_of "$P1_MD")
    P1_RUN=$CORPUS/runs/$P1_RUN_NAME
    echo "  the run directory P1's record names: <corpus>/runs/${P1_RUN_NAME:-none}"
    p1_run_ok() { [ -n "$P1_RUN_NAME" ] && [ -d "$P1_RUN" ] && [ -f "$P1_RUN/summary.host.tsv" ] && [ -f "$P1_RUN/summary.i686.tsv" ]; }
    check "P1's run directory is there with both labels' summaries (change NUJ)" "$(yn p1_run_ok)"
    p1_run_ctl() { local P1_RUN_NAME=no-such-run P1_RUN=$CORPUS/runs/no-such-run; p1_run_ok; }
    check "control: the same check refuses a run directory that is not there" "$(ynnot p1_run_ctl)"
    p1_args_ok() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$P1_RUN/run.host.tsv")" = --charts-sample ]; }
    check "P1's run's run row names --charts-sample (change NUJ)" "$(yn p1_args_ok)"
    p1_commit_ok() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "commit") k = i; next } k && NR == 2 { print $k }' "$P1_RUN/run.host.tsv")" = "$(git rev-parse "$P1_REC~1")" ]; }
    check "P1's run's run row names P1's phase commit, P1's record commit's parent (changes NUJ and NUN)" "$(yn p1_commit_ok)"
    # Change NUP: P2's run record the base added, and the run directory its .md
    # names, read as the others are; its run row names P2's phase commit, the
    # base's parent, and --charts-sample.
    P2_MD=$(git show --name-only --format= "$P2_REC" | LC_ALL=C "$G" -E '^records/m5p3-p2-[0-9-]+-[0-9a-f]{7}[.]md$')
    P2_TXT=$(git show --name-only --format= "$P2_REC" | LC_ALL=C "$G" -E '^records/m5p3-p2-[0-9-]+-[0-9a-f]{7}[.]txt$')
    echo "command: git show --name-only --format= <M5 part 3 P2's record commit>, P2's run record's .md and .txt it added: ${P2_MD:-none} ${P2_TXT:-none}"
    check "the base added exactly one P2 run record .md and one .txt (change NUP)" "$(yn [ "$(printf '%s\n%s\n' "$P2_MD" "$P2_TXT" | count_matches -E '^records/' /dev/stdin)" = 2 ])"
    P2_RUN_NAME=$(kinds_run_of "$P2_MD")
    P2_RUN=$CORPUS/runs/$P2_RUN_NAME
    echo "  the run directory P2's record names: <corpus>/runs/${P2_RUN_NAME:-none}"
    p2_run_ok() { [ -n "$P2_RUN_NAME" ] && [ -d "$P2_RUN" ] && [ -f "$P2_RUN/summary.host.tsv" ] && [ -f "$P2_RUN/summary.i686.tsv" ]; }
    check "P2's run directory is there with both labels' summaries (change NUP)" "$(yn p2_run_ok)"
    p2_run_ctl() { local P2_RUN_NAME=no-such-run P2_RUN=$CORPUS/runs/no-such-run; p2_run_ok; }
    check "control: the same check refuses a run directory that is not there" "$(ynnot p2_run_ctl)"
    p2_args_ok() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "tool_args") k = i; next } k && NR == 2 { print $k }' "$P2_RUN/run.host.tsv")" = --charts-sample ]; }
    check "P2's run's run row names --charts-sample (change NUP)" "$(yn p2_args_ok)"
    p2_commit_ok() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "commit") k = i; next } k && NR == 2 { print $k }' "$P2_RUN/run.host.tsv")" = "$(git rev-parse "$REC~1")" ]; }
    check "P2's run's run row names P2's phase commit, the base's parent (change NUP)" "$(yn p2_commit_ok)"
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the CHANGELOG commit, by its subject (change NUN)" "$(yn [ "$CLOG" = "$C" ])"
    check "control: the same comparison refuses the probe commit (change NUN)" "$(ynnot [ "$PROBE" = "$C" ])"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT")"
    short_names_head() { [ "$(git rev-parse "$SHORT")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    echo "phase: Milestone 5 part 3 P3 ($SPEC) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    
    # The two move checks as functions, run over planted inputs every time
    # below, and over a real moved keep or run directory when there is one.
    # keep_pairs_ok <listing>: the .in.xlsx lines times two equal the listing's
    # lines (the pattern in double quotes so the tab is interpolated).
    keep_pairs_ok() {
      local pairs files
      pairs=$(count_matches -E "[.]in[.]xlsx${TAB}" "$1")
      files=$(count_lines "$1")
      [ "$files" -ge 2 ] && [ "$((pairs * 2))" = "$files" ]
    }
    # run_listing <dir> <listing>: the listing of a run directory, one line per
    # file, path and bytes.
    run_listing() { (cd "$1" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$2"; }
    # run_listing_ok <dir> <listing>: the listing names each file once and at
    # least one.
    run_listing_ok() {
      local files lines uniq
      files=$(find "$1" -type f | wc -l)
      lines=$(count_lines "$2")
      uniq=$(cut -f1 "$2" | LC_ALL=C sort -u | count_lines /dev/stdin)
      [ "$files" -ge 1 ] && [ "$lines" = "$files" ] && [ "$uniq" = "$files" ]
    }
    
    if [ -n "$SUPERSEDED_RUN" ]; then
    for SUP_S in $SAMPLE kinds; do
      SUP_OUT=$RUN_OUT_ROOT/$SUPERSEDED_RUN-$SUP_S
      SUP_TO=$SELF_DIR/out/superseded/run-$SUPERSEDED_RUN-$SUP_S
      echo "the superseded run directory, moved before this run: <runs>/$SUPERSEDED_RUN-$SUP_S to <scripts>/out/superseded/run-$SUPERSEDED_RUN-$SUP_S"
      sup_there=no
      if [ -d "$SUP_OUT" ]; then
        sup_there=yes
        echo "command: sha256sum <runs>/$SUPERSEDED_RUN-$SUP_S/summary.host.tsv and summary.i686.tsv; mv <runs>/$SUPERSEDED_RUN-$SUP_S <scripts>/out/superseded/run-$SUPERSEDED_RUN-$SUP_S"
        for sl in host i686; do
          if [ -f "$SUP_OUT/summary.$sl.tsv" ]; then echo "    summary.$sl.tsv sha256 $(sha_of "$SUP_OUT/summary.$sl.tsv")"; else echo "    summary.$sl.tsv: NO HASH EXISTS, the file is not there"; fi
        done
        run_listing "$SUP_OUT" "$B/superseded-run.listing"
        echo "command: (cd <runs>/$SUPERSEDED_RUN-$SUP_S && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum"
        echo "    files $(find "$SUP_OUT" -type f | wc -l); listing lines $(count_lines "$B/superseded-run.listing"); listing sha256 $(sha_of "$B/superseded-run.listing")"
        check "the listing of $SUPERSEDED_RUN-$SUP_S names each of its files once" "$(yn run_listing_ok "$SUP_OUT" "$B/superseded-run.listing")"
        if [ -e "$SUP_TO" ]; then echo "    $SUP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$SUP_OUT" "$SUP_TO"; fi
      fi
      sup_moved() { [ ! -e "$SUP_OUT" ] && [ -d "$SUP_TO" ]; }
      if [ "$sup_there" = yes ]; then
        check "the superseded run directory $SUPERSEDED_RUN-$SUP_S is moved, not removed, before the run" "$(yn sup_moved)"
      else
        echo "    <runs>/$SUPERSEDED_RUN-$SUP_S was not there; nothing to move (P3's NTT, carried; change NUB)"
      fi
    done
    fi
    if [ -n "$SUPERSEDED_KEEP" ]; then
