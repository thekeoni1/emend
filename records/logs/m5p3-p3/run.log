## the run log's own check (python3 -I -B with zipfile and ElementTree; change NUC)
command: cp <scripts>/chartscmp.py <work>/chartscmp.py; sed 's/^/    /' <work>/chartscmp.py; sha256 7925871596368fbf8928af67d5b83cd7f0c7c343a95f46803086f425fe325b46, 37000 bytes
  the copy of chartscmp.py is the file beside this script, byte for byte: yes
    """The run log's own check of the charts sample (specs/0034-charts-read.md,
    "Harness runs", `--charts-sample` with every field: P1's and P2's axes,
    legend, pivot source and style), M5 part 3 P2, grown from P1's.
    Written for this phase by <phase>/gen/chartscmp_src.py, copied by
    gen/run.py to <scripts>/chartscmp.py; run with python3 -I -B and nothing
    else.
    
    Usage:
      chartscmp.py charts <input> <output> [--plant <name>]
      chartscmp.py --selftest
    
    charts: reads the input and the output with zipfile and ElementTree and
    prints one line of key=value pairs, space-separated: the tool line's keys
    in the tool's order (TOOL_KEYS), as this check counts them from the input
    on its own, the five digests among them; then its own four (CHECK_KEYS):
    drawings (worksheets whose <drawing> names a drawing part), chart_rels
    (the chart relationships of those drawings' rels parts, internal, either
    form), typed (the entries whose content type is the chart part's) and
    largest_chart (the byte count of the largest chart part a chart read here
    names, 0 for none); then its two flags, entries_same (every zip entry of
    the output the input's, names and bytes, in order) and chart_rule (charts
    equal to chart_rels, and every chart part read typed as a chart). It
    prints counts, flags and digests only: no title, series name, formula,
    part name, path or text from the workbook.
    
    The count, typed here from the spec (specs/0034 "The call", "Titles",
    "Series data", P1 rulings A and C, and P2) and not from the crate:
    - the worksheets: the sheet children of the workbook part's sheets, in order,
      each r:id resolved through the workbook part's relationships, kept when
      the relationship's type is worksheet (either form); sheets counts them.
    - a sheet's drawing: the sheet root's <drawing> child (main namespace),
      its r:id naming an internal drawing relationship, resolved.
    - the anchors: each root child of wsDr that is a oneCellAnchor,
      twoCellAnchor or absoluteAnchor (spreadsheet-drawing namespace), and of
      each root mc:AlternateContent the first anchor of its first Choice; an
      anchor gives a chart when its first graphicFrame child holds
      a:graphic/a:graphicData/c:chart (chart namespace, either form), its
      r:id resolved through the drawing's relationships (internal, type chart).
    - the chart part: chartSpace's first c:chart; its last title (rich: the
      a:t of each a:r of each a:p, paragraphs joined by a newline; strRef: the
      first pt's v of its strCache, or none); autoTitleDeleted (an element's
      val, true when absent); the first plotArea's plot children of the
      sixteen kinds; per plot barDir (bar plots), grouping (bar, line, area),
      scatterStyle (scatter), the ser children; per ser the last tx (strRef:
      its f; v: its text), cat or xVal (categories), val or yVal (values),
      bubbleSize (sizes), each one of numRef, strRef, multiLvlStrRef (its f,
      and whether a cache is there) or numLit, strLit; the last spPr's
      solidFill's srgbClr; smooth's val; marker and dLbls present.
    - P2's fields: the first plotArea's axis children, catAx, valAx (axis_cat,
      axis_val), dateAx and serAx (axis_other), in order; per axis its last
      title read as a chart's (axis_titles when it gives a text), its last
      numFmt's formatCode (axis_numfmt when there is one), its last scaling's
      last min and max (axis_bounds when either is there), its last delete's
      val (axis_deleted), majorGridlines present (gridlines); a legend child
      of the chart (legends); the chartSpace's last pivotSource's last name
      (pivot_charts when there is one); the style (styles): the first, in
      order, of a root c:style and a root mc:AlternateContent whose first
      Choice holds a style (chart namespace or c14's), the Fallback never read.
    - the kinds: kind_bar bar and 3D bar, kind_line line and 3D line,
      kind_pie pie and 3D pie, kind_doughnut, kind_scatter, kind_other every
      other kind (the tool's own grouping, tools/emend-copy --charts-sample).
    - the digests: 64-bit FNV-1a over the titles, over the series names (a
      reference's formula or the text), over every reference's formula
      (categories, values, sizes, series in order), over the axes' number
      formats (charts and axes in order) and over the pivot sources, each value
      followed by a newline, as 16 lower-case hex digits.
    
    Plants (the run log's controls): entries_same, the output's first entry
    taken as one byte different; chart_rule, one more chart relationship
    counted; count, charts counted one more; digest, a planted title "x"
    digested after the others; axes, axes counted one more; sources, a planted
    pivot source "x" digested after the others. Each prints planted=yes; an
    unknown plant prints error=unknown-plant.
    
    --selftest: builds in memory the tool test's fictional workbook
    (tools/emend-copy/tests/null_rewrite.rs, charts_specs("rId2", axPos l)) and checks
    the line against the one that test asserts, then each check against a
    planted difference; prints one "name: yes|no" line per check,
    SELFTEST_LINES of them.
    """
    import io
    import posixpath
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    
    FLAGS_OF = {"charts": ("entries_same", "chart_rule")}
    SELFTEST_LINES = 19
    
    CT_NS = "http://schemas.openxmlformats.org/package/2006/content-types"
    RELS_NS = "http://schemas.openxmlformats.org/package/2006/relationships"
    MAIN_NS = ("http://schemas.openxmlformats.org/spreadsheetml/2006/main",
               "http://purl.oclc.org/ooxml/spreadsheetml/main")
    R_NS = ("http://schemas.openxmlformats.org/officeDocument/2006/relationships",
            "http://purl.oclc.org/ooxml/officeDocument/relationships")
    XDR_NS = ("http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing",
              "http://purl.oclc.org/ooxml/drawingml/spreadsheetDrawing")
    A_NS = ("http://schemas.openxmlformats.org/drawingml/2006/main",
            "http://purl.oclc.org/ooxml/drawingml/main")
    C_NS = ("http://schemas.openxmlformats.org/drawingml/2006/chart",
            "http://purl.oclc.org/ooxml/drawingml/chart")
    MC_NS = ("http://schemas.openxmlformats.org/markup-compatibility/2006",)
    C14_NS = ("http://schemas.microsoft.com/office/drawing/2007/8/2/chart",)
    CONTENT_TYPES = "[Content_Types].xml"
    CHART_TYPE = "application/vnd.openxmlformats-officedocument.drawingml.chart+xml"
    
    OD_T = "http://schemas.openxmlformats.org/officeDocument/2006/relationships/"
    OD_S = "http://purl.oclc.org/ooxml/officeDocument/relationships/"
    
    
    def both(name):
        return (OD_T + name, OD_S + name)
    
    
    OFFICE_DOCUMENT = both("officeDocument")
    WORKSHEET = both("worksheet")
    DRAWING = both("drawing")
    CHART = both("chart")
    
    TOOL_KEYS = ("sheets charts plots kind_bar kind_line kind_pie kind_doughnut kind_scatter kind_other "
                 "combined bar_dir_bar bar_dir_col grouping_clustered grouping_stacked grouping_standard "
                 "grouping_percent series name_ref name_text unnamed cat_ref cat_lit val_ref val_lit sizes "
                 "cached fills smooth markers labels titles auto_title_deleted axes axis_cat axis_val "
                 "axis_other axis_titles axis_numfmt axis_bounds axis_deleted gridlines legends "
                 "pivot_charts styles anchor_two anchor_one anchor_abs edit_as_onecell edit_as_twocell "
                 "edit_as_abs digest_titles digest_names digest_formulas digest_numfmts "
                 "digest_sources").split()
    COUNT_KEYS = TOOL_KEYS[:-5]
    CHECK_KEYS = ["drawings", "chart_rels", "typed", "largest_chart"]
    
    KIND_OF = {
        "barChart": "kind_bar", "bar3DChart": "kind_bar",
        "lineChart": "kind_line", "line3DChart": "kind_line",
        "pieChart": "kind_pie", "pie3DChart": "kind_pie",
        "doughnutChart": "kind_doughnut",
        "scatterChart": "kind_scatter",
        "ofPieChart": "kind_other", "areaChart": "kind_other", "area3DChart": "kind_other",
        "radarChart": "kind_other", "bubbleChart": "kind_other", "stockChart": "kind_other",
        "surfaceChart": "kind_other", "surface3DChart": "kind_other",
    }
    BAR = ("barChart", "bar3DChart")
    GROUPED = BAR + ("lineChart", "line3DChart", "areaChart", "area3DChart")
    ANCHORS = {"oneCellAnchor": "anchor_one", "twoCellAnchor": "anchor_two", "absoluteAnchor": "anchor_abs"}
    EDIT_AS = {"oneCell": "edit_as_onecell", "twoCell": "edit_as_twocell", "absolute": "edit_as_abs"}
    AXIS_OF = {"catAx": "axis_cat", "valAx": "axis_val", "dateAx": "axis_other", "serAx": "axis_other"}
    GROUPING = {"clustered": "grouping_clustered", "stacked": "grouping_stacked",
                "standard": "grouping_standard", "percentStacked": "grouping_percent"}
    
    
    def content_types(z):
        root = ET.fromstring(z.read(CONTENT_TYPES))
        overrides, defaults = {}, []
        for el in root:
            if el.tag == "{%s}Override" % CT_NS:
                overrides.setdefault(el.get("PartName"), el.get("ContentType"))
            elif el.tag == "{%s}Default" % CT_NS:
                defaults.append((el.get("Extension"), el.get("ContentType")))
        return overrides, defaults
    
    
    def ascii_lower(s):
        return "".join(c.lower() if c.isascii() else c for c in s)
    
    
    def type_of(name, overrides, defaults):
        if "/" + name in overrides:
            return overrides["/" + name]
        if "." not in name:
            return None
        ext = ascii_lower(name.rsplit(".", 1)[1])
        for e, t in defaults:
            if e is not None and ascii_lower(e) == ext:
                return t
        return None
    
    
    def rels_part(source):
        d, f = posixpath.split(source)
        return (d + "/" if d else "") + "_rels/" + f + ".rels"
    
    
    def resolve(source, target):
        """The entry an internal target names, or None above the root."""
        if target.startswith("/"):
            segs = []
            path = target[1:]
        else:
            d = posixpath.dirname(source)
            segs = [s for s in d.split("/") if s]
            path = target
        for s in path.split("/"):
            if s in ("", "."):
                continue
            if s == "..":
                if not segs:
                    return None
                segs.pop()
            else:
                segs.append(s)
        return "/".join(segs) if segs else None
    
    
    def relationships(z, names, source):
        part = rels_part(source)
        if part not in names:
            return {}
        root = ET.fromstring(z.read(part))
        return {r.get("Id"): (r.get("Type"), r.get("Target"), r.get("TargetMode") == "External")
                for r in root if r.tag == "{%s}Relationship" % RELS_NS}
    
    
    def is_(el, spaces, local):
        return el.tag in ["{%s}%s" % (ns, local) for ns in spaces]
    
    
    def kids(el, spaces, local):
        return [c for c in el if is_(c, spaces, local)]
    
    
    def local_of(el, spaces):
        for ns in spaces:
            if el.tag.startswith("{%s}" % ns):
                return el.tag[len(ns) + 2:]
        return None
    
    
    def rid_of(el):
        for rns in R_NS:
            v = el.get("{%s}id" % rns)
            if v is not None:
                return v
        return None
    
    
    def text(el):
        return el.text or ""
    
    
    def fnv(values):
        h = 0xcbf29ce484222325
        for v in values:
            for b in v.encode("utf-8") + b"\n":
                h ^= b
                h = (h * 0x100000001b3) & 0xFFFFFFFFFFFFFFFF
        return "%016x" % h
    
    
    def flag(el):
        """A boolean element's val, true when absent (the schema's default)."""
        v = el.get("val")
        if v in (None, "1", "true"):
            return True
        if v in ("0", "false"):
            return False
        raise ValueError("boolean")
    
    
    def workbook_part(z, names):
        for (t, target, ext) in relationships(z, names, "").values():
            if t in OFFICE_DOCUMENT and not ext:
                return resolve("", target)
        return None
    
    
    def anchors_of(drawing):
        """The anchors as P1 ruling A takes them: each root anchor, and the
        first anchor of each root AlternateContent's first Choice."""
        out = []
        for child in drawing:
            local = local_of(child, XDR_NS)
            if local in ANCHORS:
                out.append(child)
            elif is_(child, MC_NS, "AlternateContent"):
                choices = kids(child, MC_NS, "Choice")
                if choices:
                    inner = [c for c in choices[0] if local_of(c, XDR_NS) in ANCHORS]
                    if inner:
                        out.append(inner[0])
        return out
    
    
    def chart_rid(anchor):
        frames = kids(anchor, XDR_NS, "graphicFrame")
        if not frames:
            return None
        for graphic in kids(frames[0], A_NS, "graphic"):
            for data in kids(graphic, A_NS, "graphicData"):
                for c in kids(data, C_NS, "chart"):
                    rid = rid_of(c)
                    if rid is None:
                        raise ValueError("chart without r:id")
                    return rid
        return None
    
    
    def title_of(title):
        found = None
        for tx in kids(title, C_NS, "tx"):
            for form in tx:
                if is_(form, C_NS, "rich"):
                    lines = []
                    for p in kids(form, A_NS, "p"):
                        lines.append("".join(text(t) for r in kids(p, A_NS, "r") for t in kids(r, A_NS, "t")))
                    found = "\n".join(lines)
                elif is_(form, C_NS, "strRef"):
                    found = None
                    for cache in kids(form, C_NS, "strCache"):
                        pts = kids(cache, C_NS, "pt")
                        if pts and found is None:
                            vs = kids(pts[0], C_NS, "v")
                            found = text(vs[-1]) if vs else ""
        return found
    
    
    def data_of(el):
        """(formula or None, cached flag, is literal) of the last data form, or None."""
        out = None
        for form in el:
            local = local_of(form, C_NS)
            if local in ("numRef", "strRef", "multiLvlStrRef"):
                fs = kids(form, C_NS, "f")
                if not fs:
                    raise ValueError("reference without f")
                cached = any(local_of(c, C_NS) in ("numCache", "strCache", "multiLvlStrCache") for c in form)
                out = (text(fs[-1]), cached, False)
            elif local in ("numLit", "strLit"):
                out = (None, False, True)
        return out
    
    
    def count_root(root, c, sources):
        """P2's chartSpace fields: the pivot source and the style."""
        source = None
        style = False
        for child in root:
            if is_(child, C_NS, "pivotSource"):
                source = None
                for n in kids(child, C_NS, "name"):
                    source = text(n)
            elif not style and is_(child, C_NS, "style"):
                style = True
            elif not style and is_(child, MC_NS, "AlternateContent"):
                choices = kids(child, MC_NS, "Choice")
                if choices:
                    style = any(is_(s, C_NS, "style") or is_(s, C14_NS, "style") for s in choices[0])
        if source is not None:
            c["pivot_charts"] += 1
            sources.append(source)
        c["styles"] += 1 if style else 0
    
    
    def count_axes(area, c, numfmts):
        """P2's axis fields, over a plotArea's axis children in order."""
        for axis in area:
            local = local_of(axis, C_NS)
            if local not in AXIS_OF:
                continue
            c["axes"] += 1
            c[AXIS_OF[local]] += 1
            title = fmt = None
            bounds = deleted = grid = False
            for child in axis:
                name = local_of(child, C_NS)
                if name == "title":
                    title = title_of(child)
                elif name == "numFmt":
                    fmt = child.get("formatCode")
                elif name == "scaling":
                    bounds = any(local_of(b, C_NS) in ("min", "max") for b in child)
                elif name == "delete":
                    deleted = flag(child)
                elif name == "majorGridlines":
                    grid = True
            c["axis_titles"] += 1 if title is not None else 0
            if fmt is not None:
                c["axis_numfmt"] += 1
                numfmts.append(fmt)
            c["axis_bounds"] += 1 if bounds else 0
            c["axis_deleted"] += 1 if deleted else 0
            c["gridlines"] += 1 if grid else 0
    
    
    def count_chart(root, c, titles, names, formulas, numfmts, sources):
        charts = kids(root, C_NS, "chart")
        if not is_(root, C_NS, "chartSpace") or not charts:
            raise ValueError("chart part")
        count_root(root, c, sources)
        chart = charts[0]
        c["legends"] += 1 if kids(chart, C_NS, "legend") else 0
        title = None
        deleted = False
        for t in kids(chart, C_NS, "title"):
            title = title_of(t)
        for d in kids(chart, C_NS, "autoTitleDeleted"):
            deleted = flag(d)
        if title is not None:
            c["titles"] += 1
            titles.append(title)
        c["auto_title_deleted"] += 1 if deleted else 0
        areas = kids(chart, C_NS, "plotArea")
        if not areas:
            raise ValueError("no plotArea")
        count_axes(areas[0], c, numfmts)
        plots = [p for p in areas[0] if local_of(p, C_NS) in KIND_OF]
        c["plots"] += len(plots)
        c["combined"] += 1 if len(plots) >= 2 else 0
        for plot in plots:
            kind = local_of(plot, C_NS)
            c[KIND_OF[kind]] += 1
            if kind in BAR:
                for d in kids(plot, C_NS, "barDir")[-1:]:
                    c["bar_dir_bar" if d.get("val") == "bar" else "bar_dir_col"] += 1
            if kind in GROUPED:
                for g in kids(plot, C_NS, "grouping")[-1:]:
                    v = g.get("val") or ("clustered" if kind in BAR else "standard")
                    c[GROUPING[v]] += 1
            for ser in kids(plot, C_NS, "ser"):
                c["series"] += 1
                name = None
                for tx in kids(ser, C_NS, "tx"):
                    name = None
                    for form in tx:
                        if is_(form, C_NS, "strRef"):
                            fs = kids(form, C_NS, "f")
                            if not fs:
                                raise ValueError("reference without f")
                            name = ("ref", text(fs[-1]))
                        elif is_(form, C_NS, "v"):
                            name = ("text", text(form))
                if name is None:
                    c["unnamed"] += 1
                else:
                    c["name_ref" if name[0] == "ref" else "name_text"] += 1
                    names.append(name[1])
                cats = vals = sizes = None
                fill = smooth = marker = labels = False
                for child in ser:
                    local = local_of(child, C_NS)
                    if local in ("cat", "xVal"):
                        cats = data_of(child)
                    elif local in ("val", "yVal"):
                        vals = data_of(child)
                    elif local == "bubbleSize":
                        sizes = data_of(child)
                    elif local == "spPr":
                        fill = False
                        for solid in kids(child, A_NS, "solidFill"):
                            for rgb in kids(solid, A_NS, "srgbClr"):
                                fill = True
                    elif local == "smooth":
                        smooth = flag(child)
                    elif local == "marker":
                        marker = True
                    elif local == "dLbls":
                        labels = True
                for data, ref, lit in ((cats, "cat_ref", "cat_lit"), (vals, "val_ref", "val_lit"),
                                       (sizes, "sizes", "sizes")):
                    if data is None:
                        continue
                    if data[2]:
                        c[lit] += 1
                    else:
                        c[ref] += 1
                        c["cached"] += 1 if data[1] else 0
                        formulas.append(data[0])
                c["fills"] += 1 if fill else 0
                c["smooth"] += 1 if smooth else 0
                c["markers"] += 1 if marker else 0
                c["labels"] += 1 if labels else 0
    
    
    def count(data, plant=None):
        z = zipfile.ZipFile(io.BytesIO(data))
        names = z.namelist()
        sizes = {i.filename: i.file_size for i in z.infolist()}
        overrides, defaults = content_types(z)
        c = dict.fromkeys(COUNT_KEYS + CHECK_KEYS, 0)
        c["typed"] = sum(1 for n in names if type_of(n, overrides, defaults) == CHART_TYPE)
        wb = workbook_part(z, names)
        root = ET.fromstring(z.read(wb))
        wb_rels = relationships(z, names, wb)
        titles, series_names, formulas, numfmts, sources = [], [], [], [], []
        typed_all = True
        for sheets in kids(root, MAIN_NS, "sheets")[:1]:
            for sheet in kids(sheets, MAIN_NS, "sheet"):
                rel = wb_rels.get(rid_of(sheet))
                if rel is None or rel[0] not in WORKSHEET or rel[2]:
                    continue
                c["sheets"] += 1
                part = resolve(wb, rel[1])
                ws = ET.fromstring(z.read(part))
                drawings = kids(ws, MAIN_NS, "drawing")
                if not drawings:
                    continue
                sheet_rels = relationships(z, names, part)
                drel = sheet_rels.get(rid_of(drawings[0]))
                if drel is None or drel[0] not in DRAWING or drel[2]:
                    raise ValueError("drawing relationship")
                c["drawings"] += 1
                dpart = resolve(part, drel[1])
                drawing = ET.fromstring(z.read(dpart))
                drels = relationships(z, names, dpart)
                c["chart_rels"] += sum(1 for (t, _, ext) in drels.values() if t in CHART and not ext)
                for anchor in anchors_of(drawing):
                    rid = chart_rid(anchor)
                    if rid is None:
                        continue
                    crel = drels.get(rid)
                    if crel is None or crel[0] not in CHART or crel[2]:
                        raise ValueError("chart relationship")
                    cpart = resolve(dpart, crel[1])
                    c["charts"] += 1
                    kind = local_of(anchor, XDR_NS)
                    c[ANCHORS[kind]] += 1
                    if kind == "twoCellAnchor" and anchor.get("editAs") is not None:
                        c[EDIT_AS[anchor.get("editAs")]] += 1
                    typed_all = typed_all and type_of(cpart, overrides, defaults) == CHART_TYPE
                    c["largest_chart"] = max(c["largest_chart"], sizes[cpart])
                    count_chart(ET.fromstring(z.read(cpart)), c, titles, series_names, formulas, numfmts,
                                sources)
        if plant == "count":
            c["charts"] += 1
        if plant == "chart_rule":
            c["chart_rels"] += 1
        if plant == "digest":
            titles = titles + ["x"]
        if plant == "axes":
            c["axes"] += 1
        if plant == "sources":
            sources = sources + ["x"]
        c["digest_titles"] = fnv(titles)
        c["digest_names"] = fnv(series_names)
        c["digest_formulas"] = fnv(formulas)
        c["digest_numfmts"] = fnv(numfmts)
        c["digest_sources"] = fnv(sources)
        return c, typed_all
    
    
    def entries_of(data):
        z = zipfile.ZipFile(io.BytesIO(data))
        return [(i.filename, z.read(i.filename)) for i in z.infolist()]
    
    
    def compare(input_bytes, output_bytes, plant=None):
        c, typed_all = count(input_bytes, plant)
        a, b = entries_of(input_bytes), entries_of(output_bytes)
        if plant == "entries_same" and b:
            first = sorted(range(len(b)), key=lambda k: b[k][0])[0]
            data = b[first][1]
            b[first] = (b[first][0], bytes([(data[0] ^ 1) if data else 1]) + data[1:])
        flags = {
            "entries_same": a == b,
            "chart_rule": c["charts"] == c["chart_rels"] and typed_all,
        }
        out = ["%s=%s" % (k, c[k]) for k in TOOL_KEYS + CHECK_KEYS]
        out += ["%s=%s" % (f, "yes" if flags[f] else "no") for f in FLAGS_OF["charts"]]
        if plant is not None:
            out.append("planted=yes")
        return " ".join(out)
    
    
    def kv(line, key):
        for item in line.split(" "):
            if item.startswith(key + "="):
                return item[len(key) + 1:]
        return None
    
    
