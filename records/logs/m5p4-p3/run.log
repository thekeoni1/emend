command: the #[test] functions added or whose body is edited since the named record commit, and those of a .rs file whose text outside its tests differs, from the two commits' sources of every .rs file git diff --name-only <named record commit> <phase commit> names: <work>/edited.py, below (change NSG)
    """The #[test] functions whose body differs between two commits, or that
    the second adds: each file's text at both commits (git show), every
    function after a #[test] attribute (other attributes allowed between), its
    body from the fn line to the first line that is a lone closing brace in
    column one. Prints one test name per line; with a third argument
    --fixtures, instead every test whose body names an item (const,
    static, fn, struct, enum, type or mod at column one) whose lines
    outside the test bodies differ between the two commits (change
    NSG)."""
    import collections
    import re
    import subprocess
    import sys
    
    base, head = sys.argv[1:3]
    TEST = re.compile(r"#\[test\]\s*(?:#\[[^\]]*\]\s*)*fn\s+([A-Za-z0-9_]+)")
    
    
    def show(rev, path):
        run = subprocess.run(["git", "show", "%s:%s" % (rev, path)], capture_output=True)
        return run.stdout.decode() if run.returncode == 0 else ""
    
    
    def tests(text):
        out = {}
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            out[m.group(1)] = text[m.start():end if end >= 0 else len(text)]
        return out
    
    
    names = subprocess.run(["git", "diff", "--name-only", base, head, "--", "*.rs"],
                           capture_output=True, check=True).stdout.decode().split()
    ITEM = re.compile(r"^(?:pub(?:\([^)]*\))?\s+)?(?:const|static|fn|struct|enum|type|mod)\s+([A-Za-z_][A-Za-z0-9_]*)")
    
    
    def outside(text):
        out, at = [], 0
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            end = len(text) if end < 0 else end + 3
            if m.start() >= at:
                out.append(text[at:m.start()])
                at = end
        out.append(text[at:])
        return "".join(out)
    
    
    def changed_items(before_text, after_text):
        found = set()
        for text, other in ((after_text, before_text), (before_text, after_text)):
            others = collections.Counter(outside(other).split("\n"))
            current = None
            for line in outside(text).split("\n"):
                m = ITEM.match(line)
                if m:
                    current = m.group(1)
                if others[line] > 0:
                    others[line] -= 1
                elif current is not None:
                    found.add(current)
        return found
    
    
    edited = set()
    fixture = set()
    for path in names:
        before_text, after_text = show(base, path), show(head, path)
        before, after = tests(before_text), tests(after_text)
        for name, body in after.items():
            if before.get(name) != body:
                edited.add(name)
        items = changed_items(before_text, after_text)
        for name, body in after.items():
            if any(re.search(r"\b%s\b" % re.escape(i), body) for i in items):
                fixture.add(name)
    for name in sorted(fixture if sys.argv[3:] == ["--fixtures"] else edited):
        print(name)
