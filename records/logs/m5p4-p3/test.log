    echo "root: <build> stands for the build root on the disk, <phase>/test unless TEST_BUILD names another"
    echo "root: <superseded> stands for <phase>/superseded, where a rerun's superseded files are kept; read only"
    echo "root: <api> stands for <phase>/api unless TEST_API_DIR names another (a dry run's stand-in), the directory T1 writes the listing into, listing.tsv and files.tsv, refused if either is there; the carried change notes that print <api> name the earlier phases' own (changes YW, ZI and ZJ)"
    echo "root: <home>/.cache/emend-build/m3p7-p3 stands for part 7 P3's phase directory, whose gen/api-listing.py (the listing program) T1 copies; <home>/.cache/emend-build/m5p3-p3 for M5 part 3 P3's, whose api/listing.tsv (its listing) T1 and R2 read; both read only (change ZJ)"
    echo "root: <scratch>/tmp stands for <build>/tmp, the TMPDIR this script exports before its mktemp -d, under the phase directory, so every temporary file of the run is there and none in the system temporary directory (change WH)"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory, made in <scratch>/tmp (under <build>), kept on the disk after the run (changes QC and WH): <scratch>/w/counting.sh the phase commit's library, sourced; the captured cargo outputs (*.out) and the names each run passed (*.names); <scratch>/w/prev-test.log, M5 part 4 P2's test.log read at the phase commit; <scratch>/w/api, T1's archive, the program's copy, its fixture crate, the key sets, the gate widenings and R2's staged record; the keep directory <scratch>/w/keep.<random> of block K; the controls' fixtures (changes TD to TH, UC to UF, WC to WI, XA to XG, XH to XP, XQ to XX, XZ to YG, YH to YP, YQ to YW, YX to ZB, ZC to ZK)"
    
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$BUILD_ROOT" && apart "$SUPERSEDED_DIR" "$MAIN" && apart "$TARGET_DIR" "$BUILD_ROOT" && apart "$TARGET_DIR" "$MAIN"; }
    check "the roots other than <home> and <phase> are distinct, none inside another (<scratch>/w inside <build>)" "$(yn roots_distinct)"
    roots_ctl() { apart "$B" "$BUILD_ROOT"; }
    check "control: apart refuses <scratch>/w against <build>, which holds it" "$(ynnot roots_ctl)"
    # Change WH: the working directory mktemp -d made is directly in TMPDIR,
    # which is <build>/tmp.
    in_tmpdir() { [ "$(dirname "$1")" = "$TMPDIR" ] && [ "$TMPDIR" = "$BUILD_ROOT/tmp" ]; }
    echo "command: dirname <scratch>/w -> $(dirname "$B")"
    check "the directory mktemp -d made, <scratch>/w, is directly in TMPDIR, <scratch>/tmp, which is <build>/tmp (change WH)" "$(yn in_tmpdir "$B")"
    check "control: the same check refuses <build>/tmp.x, a directory beside TMPDIR, not in it" "$(ynnot in_tmpdir "$BUILD_ROOT/tmp.x")"
    check "control: the same check refuses <phase>/tmp.x, a directory outside TMPDIR" "$(ynnot in_tmpdir "$PHASE_DIR/tmp.x")"
    tmpdir_ctl() { local TMPDIR=$PHASE_DIR; in_tmpdir "$PHASE_DIR/tmp.x"; }
    check "control: the same check refuses a TMPDIR that is not <build>/tmp (<phase> itself), even holding the directory" "$(ynnot tmpdir_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them this phase's log directory, its records or specs/0035 modified $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT_SHA")"
    short_names_head() { [ "$(git rev-parse "$SHORT_SHA")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_src_ctl() { printf ' M crates/emend/src/cells.rs\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified crate source" "$(ynnot ours_src_ctl)"
    ours_roadmap_ctl() { printf ' M ROADMAP.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified ROADMAP.md (committed and clean in this phase)" "$(ynnot ours_roadmap_ctl)"
    ours_rec_ctl() { printf "?? records/logs/m5p4-p3/gate.log\n?? records/logs/m5p4-p2/gate.log\n?? records/logs/m5p4-p3x/gate.log\n M ROADMAP.md\n M specs/0035-charts-write-first-set.md\n?? specs/0035-charts-write-first-set.md\n?? records/api-review-m5p4-2026-10-14-${SHORT_SHA}.md\n?? records/size-m5p4-2026-10-14-${SHORT_SHA}.md\n?? records/m5p4-p3-charts-2026-10-14-${SHORT_SHA}.txt\n?? records/m5p4-open-2026-10-14-${SHORT_SHA}.md\n?? records/api-review-m5p4-2026-10-14-${SHORT_SHA}.txt\n?? records/m5p4-p3-2026-10-14-${SHORT_SHA}.md\n?? records/m5p4-p3-chartkinds-2026-10-14-0000000.md\n M records/m5p4-p3-charts-2026-10-14-${SHORT_SHA}.md\n?? records/m5p4-p2-2026-10-14-${SHORT_SHA}.md\n" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern takes this phase's log, specs/0035 modified and this phase's records untracked with the phase commit's short sha, six of fifteen lines: no other phase's log (P2's among them), no sibling directory, no untracked spec, no API record as .txt, no P3 record without a sample name, no other short sha, no modified record, no other phase's record (P2's stem) (changes WB, XB, XR, YA, YI, YR, YY and ZD)" "$(yn [ "$(ours_rec_ctl)" = 6 ])"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_BLOB=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum: $SPEC_BLOB; sha256sum $SPEC (the working file, printed and not asserted: planning holds its rulings during P3 uncommitted; changes WA, XA, XH, XQ, XZ, YH, YQ, YX and ZC): $SPEC_HAVE"
    check "the spec's blob at the phase commit is at the hash this log pins" "$(yn [ "$SPEC_BLOB" = "$SPEC_WANT" ])"
    spec_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$SPEC_WANT" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot spec_ctl)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    # Change XG (ruling 12): the library's counting_controls makes its one
    # mktemp -d, and removes it, itself; it inherits TMPDIR from this script's
    # environment, checked here to be <build>/tmp before it runs.
    lib_mktemps=$(count_matches -F 'mktemp' "$B/counting.sh")
    tmpdir_exported() { [ "$(printenv TMPDIR)" = "$BUILD_ROOT/tmp" ]; }
    echo "  command: count_matches -F mktemp <scratch>/w/counting.sh: $lib_mktemps; printenv TMPDIR: $(printenv TMPDIR)"
    check "the sourced library holds one mktemp call, counting_controls' mktemp -d (change XG)" "$(yn [ "$lib_mktemps" = 1 ])"
    check "the library's mktemp -d runs with TMPDIR exported as <build>/tmp, so its directory lies under TMPDIR (ruling 12; change XG)" "$(yn tmpdir_exported)"
    tmpdir_exported_ctl() { local TMPDIR=$PHASE_DIR; export TMPDIR; tmpdir_exported; }
    check "control: the same check refuses an environment whose TMPDIR is <phase>" "$(ynnot tmpdir_exported_ctl)"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    # failed_names <cargo output>: prints the name of every test the run failed,
    # from its FAILED lines, or "none" (part 6 P3's form). It prints, so it is
    # never a check's condition.
    failed_names() {
      local n
      n=$(LC_ALL=C "$G" -a -E '^test .* \.\.\. FAILED$' "$1" | sed -E 's/^test (.*) \.\.\. FAILED$/\1/')
      if [ -n "$n" ]; then printf '%s\n' "$n" | sed 's/^/    failed test: /'; else echo "    failed tests: none"; fi
    }
    printf 'test a::b ... ok\ntest a::c ... FAILED\n' >"$B/c-failed"
    check "control: failed_names prints the name of the one FAILED line of two" "$(yn [ "$(failed_names "$B/c-failed")" = "    failed test: a::c" ])"
    printf 'test a::b ... ok\n' >"$B/c-failed-none"
    check "control: failed_names prints none for a run with no FAILED line" "$(yn [ "$(failed_names "$B/c-failed-none")" = "    failed tests: none" ])"
    # diag_lines <cargo output>: the lines a warning or an error begins with
    # (rustc's and clippy's "warning:" / "warning[...]" / "error:" / "error[...]"),
    # counted by the counting library's form.
    DIAG='^(warning|error)(\[[A-Za-z0-9_:]+\])?: '
    diag_lines() { count_matches -E "$DIAG" "$1"; }
    printf 'warning: unused import\nerror[E0433]: failed to resolve\n    Finished x\nnote: this is not one\n' >"$B/c-diag"
    check "control: diag_lines counts the two diagnostic lines of a four-line fixture" "$(yn [ "$(diag_lines "$B/c-diag")" = 2 ])"
    
    CT=$TARGET_DIR/main
    SETS="off charts images charts,images charts,read all"
    # set_args <set>: the cargo arguments of a feature set.
    set_args() { case $1 in off) ;; all) echo "--all-features" ;; *) echo "--features $1" ;; esac; }
    # test_run <name> <cargo args...>: runs cargo with the args into <target>/main,
    # keeps the output as <name>.out, prints the exit, the summary lines and the
    # failed names, and writes <name>.rc, .passed, .failed, .nok and .names. It prints,
    # so it is never a check's condition; run_passed reads its files.
    test_run() {
      local name=$1 rc passed failed nok
      shift
      echo "command: CARGO_TARGET_DIR=<target>/main cargo $*"
      CARGO_TARGET_DIR=$CT cargo "$@" >"$B/$name.out" 2>&1 </dev/null
      rc=$?
      LC_ALL=C "$G" -a -E '^test result: ' "$B/$name.out" | sed 's/^/    /'
      failed_names "$B/$name.out"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/$name.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/$name.out")
      nok=$(count_matches -E '^test .* \.\.\. ok$' "$B/$name.out")
      echo "$rc" >"$B/$name.rc"; echo "$passed" >"$B/$name.passed"; echo "$failed" >"$B/$name.failed"; echo "$nok" >"$B/$name.nok"
      # Change TD: the names the run passed, sorted in the C locale.
      LC_ALL=C "$G" -a -E '^test .* \.\.\. ok$' "$B/$name.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | LC_ALL=C sort >"$B/$name.names"
      echo "  $name: exit $rc; passed $passed; failed $failed; executed (passed plus failed) $((passed + failed)); test lines ending ok $nok"
    }
    # run_passed <name>: exit 0, failed 0, passed more than 0 and equal to the ok lines.
    run_passed() {
      local rc passed failed nok
      rc=$(cat "$B/$1.rc"); passed=$(cat "$B/$1.passed"); failed=$(cat "$B/$1.failed"); nok=$(cat "$B/$1.nok")
      [ "$rc" = 0 ] && [ "$failed" = 0 ] && [ "$passed" -gt 0 ] && [ "$passed" = "$nok" ]
    }
    echo 0 >"$B/c-run.rc"; echo 3 >"$B/c-run.passed"; echo 1 >"$B/c-run.failed"; echo 3 >"$B/c-run.nok"
    check "control: run_passed refuses a run with one failed test" "$(ynnot run_passed c-run)"
    echo 0 >"$B/c-run2.rc"; echo 3 >"$B/c-run2.passed"; echo 0 >"$B/c-run2.failed"; echo 2 >"$B/c-run2.nok"
    check "control: run_passed refuses a run whose passed count is not its ok lines" "$(ynnot run_passed c-run2)"
    echo 0 >"$B/c-run3.rc"; echo 3 >"$B/c-run3.passed"; echo 0 >"$B/c-run3.failed"; echo 3 >"$B/c-run3.nok"
    check "control: run_passed takes a clean run of three" "$(yn run_passed c-run3)"
    
    echo
    echo "## W: cargo test --workspace on both targets (the gate's own test steps)"
    test_run ws-host test --workspace
    check "W host: exit 0, none failed, some ran, passed equals the ok lines" "$(yn run_passed ws-host)"
    test_run ws-i686 test --workspace --target i686-unknown-linux-musl
    check "W i686: exit 0, none failed, some ran, passed equals the ok lines" "$(yn run_passed ws-i686)"
    
    echo
    echo "## F: cargo test -p emend with the features off, charts, images, charts,images, charts,read and every feature, on both targets (changes TC, XS and YT)"
    for target in host i686; do
      for set in $SETS; do
        args=(test -p emend)
        [ "$target" = host ] || args+=(--target i686-unknown-linux-musl)
        # shellcheck disable=SC2207
        args+=($(set_args "$set"))
        test_run "f-$target-$set" "${args[@]}"
        check "F $target, features $set: exit 0, none failed, some ran, passed equals the ok lines" "$(yn run_passed "f-$target-$set")"
      done
    done
    more_with_all() { [ "$(cat "$B/f-$1-all.passed")" -gt "$(cat "$B/f-$1-off.passed")" ]; }
    check "F host: the all-features run passes more tests than the run with none (the sets differ)" "$(yn more_with_all host)"
    check "F i686: the all-features run passes more tests than the run with none" "$(yn more_with_all i686)"
    more_ctl() { [ "$(cat "$B/f-host-off.passed")" -gt "$(cat "$B/f-host-all.passed")" ]; }
    check "control: the same comparison refuses the reverse order" "$(ynnot more_ctl)"
    
    echo
    echo "## E: each F run's count by property, against M5 part 4 P2's committed test.log and the source (changes WC, XC, XJ, XT, YB, YJ, YT, YU, YZ, ZA and ZE)"
    PREVLOG=records/logs/m5p4-p2/test.log
    PREVFORM='^  E (host|i686), features [a-z,]+: this run passed [0-9]+;'
    echo "command: git show <phase commit>:$PREVLOG > <scratch>/w/prev-test.log; grep -E '$PREVFORM' <scratch>/w/prev-test.log"
    git show "$C:$PREVLOG" >"$B/prev-test.log"
    rc_prev=$?
    n_prevlines=$(count_matches -E "$PREVFORM" "$B/prev-test.log")
    echo "  exit $rc_prev; matching lines $n_prevlines:"
    LC_ALL=C "$G" -E "$PREVFORM" "$B/prev-test.log" | sed 's/^/    /'
    prev_read() { [ "$rc_prev" = 0 ] && [ "$n_prevlines" = 12 ] && [ "$(prev_count "$B/prev-test.log" host images)" != none ] && [ "$(prev_count "$B/prev-test.log" i686 images)" != none ]; }
    # prev_count <file> <target> <set>: the "this run passed <n>" figure of the
    # one E line of that log for that target and set, or "none" when the log
    # holds not exactly one. The line must START with the E prefix: the
    # committed log also prints its own script, whose lines hold the same text
    # indented. It prints, so its value is compared, never run as a condition
    # (changes UC, VD and WC).
    prev_count() {
      local hits
      hits=$(LC_ALL=C awk -v p="  E $2, features $3: this run passed " 'index($0, p) == 1 { s = substr($0, length(p) + 1); sub(/;.*$/, "", s); print s }' "$1" | LC_ALL=C "$G" -E '^[0-9]+$')
      if [ -n "$hits" ] && [ "$(printf '%s\n' "$hits" | wc -l)" = 1 ]; then echo "$hits"; else echo none; fi
    }
    printf "  E host, features off: this run passed 31; x\n  E host, features all: this run passed 32; y\n  E i686, features off: this run passed 33; z\n  E i686, features off: this run passed 34; z\n    printf \"  E host, features all: this run passed 39; q\\\\n\"\n  E host, features read: this run passed 35; w\n" >"$B/c-prev"
    check "control: prev_count reads the host off figure of a planted file, not the host all one after it" "$(yn [ "$(prev_count "$B/c-prev" host off)" = 31 ])"
    check "control: prev_count reads the host all figure, not an indented copy of its line (a printed script's)" "$(yn [ "$(prev_count "$B/c-prev" host all)" = 32 ])"
    check "control: prev_count reads none for a target and set the file gives twice (i686 off)" "$(yn [ "$(prev_count "$B/c-prev" i686 off)" = none ])"
    check "control: prev_count reads none for a set the file does not give (host read,rules), not the read line's figure" "$(yn [ "$(prev_count "$B/c-prev" host read,rules)" = none ])"
    check "control: prev_count reads the host read figure" "$(yn [ "$(prev_count "$B/c-prev" host read)" = 35 ])"
    check "M5 part 4 P2's test.log was read at the phase commit and holds one E line per target and set, twelve, the images set's on each target among them (changes YB, YJ, YU, YZ and ZE)" "$(yn prev_read)"
    # same_count <a> <b>: both are the same decimal number.
    same_count() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9]+$' && [ "$1" = "$2" ]; }
    check "control: same_count refuses 594 against 595" "$(ynnot same_count 594 595)"
    check "control: same_count refuses none against none" "$(ynnot same_count none none)"
    check "control: same_count takes 594 against 594" "$(yn same_count 594 594)"
    # The chart tests, all of them and the ones this phase adds, derived from
    # the source (M3 part 6 P3's tests_in and cfg_tests forms, each sort in the
    # C locale so comm and cmp compare one collation). Change ZE: the chart
    # read test file is the base's, unchanged; the chart write test file is
    # the base's (P2's), unchanged: its tests kept, two of them gated on
    # images, none added.
    CH_RS=crates/emend/src/package/tests/chart.rs
    CH_MOD=package::tests::chart::
    TOOL_RS=tools/emend-copy/tests/null_rewrite.rs
    tests_attr() { git show "$1:$2" 2>/dev/null | tests_in; }
    tests_in() {
      awk '
        /^[ \t]*#\[test\][ \t]*$/ { t = 1; next }
        t && /^[ \t]*#\[/ { next }
        t && /^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]/ {
          sub(/^[ \t]*(pub[ \t]+)?(async[ \t]+)?fn[ \t]+/, ""); sub(/[(<].*/, ""); print; t = 0; next
        }
        t { t = 0 }' | LC_ALL=C sort
    }
    # cfg_tests <cfg line> <file text on stdin>: the tests whose attribute
    # lines, before the fn line, hold exactly that cfg line.
    cfg_tests() {
      awk -v want="$1" '
        $0 == want { c = 1; next }
        /^#\[test\]/ { t = 1; next }
        /^#\[/ { next }
        /^fn / { if (c && t) { s = $0; sub(/^fn /, "", s); sub(/[(<].*/, "", s); print s }; c = 0; t = 0; next }
        { c = 0; t = 0 }' | LC_ALL=C sort
    }
    tests_attr "$C" "$CH_RS" >"$B/ch-all"
    tests_attr "$REC" "$CH_RS" >"$B/ch-base"
    LC_ALL=C comm -13 "$B/ch-base" "$B/ch-all" >"$B/ch-new"
    git show "$C:$CH_RS" | cfg_tests '#[cfg(feature = "rules")]' >"$B/ch-rules"
    # Change XT: no cfg line at all in the chart test file, so every test in it
    # is compiled wherever the module is, with charts.
    git show "$C:$CH_RS" >"$B/ch-src"
    CH_CFG=$(count_matches -F '#[cfg(' "$B/ch-src")
    : >"$B/none"
    CH_ALL=$(count_lines "$B/ch-all")
    CH_BASE=$(count_lines "$B/ch-base")
    CH_NEW=$(count_lines "$B/ch-new")
    CH_RULES=$(count_lines "$B/ch-rules")
    echo "  #[test] functions in $CH_RS at the phase commit: $CH_ALL; at the base: $CH_BASE; added by this phase: $CH_NEW; at the phase commit gated on rules: $CH_RULES; cfg lines in the file: $CH_CFG"
    sed 's/^/    the added chart test: /' "$B/ch-new"
    ch_shape() { [ "$CH_ALL" -ge 1 ] && [ "$CH_RULES" = 0 ] && [ "$CH_CFG" = 0 ]; }
    check "the chart test file holds tests and no cfg line, so every one is compiled with charts (FACTS.md; change XT)" "$(yn ch_shape)"
    printf '#[cfg(feature = "images")]\n#[test]\nfn ctl_gated() {}\n#[test]\nfn ctl_plain() {}\n' >"$B/c-ch-cfg"
    check "control: the same cfg count finds the one cfg line of a two-test fixture" "$(yn [ "$(count_matches -F '#[cfg(' "$B/c-ch-cfg")" = 1 ])"
    LC_ALL=C comm -23 "$B/ch-base" "$B/ch-all" >"$B/ch-gone"
    CH_GONE=$(count_lines "$B/ch-gone")
    echo "  tests of the base's chart test file not at the phase commit: $CH_GONE"
    ch_same() { [ "$CH_BASE" -ge 1 ] && [ "$CH_NEW" = 0 ] && [ "$CH_GONE" = 0 ] && [ "$CH_ALL" = "$CH_BASE" ]; }
    check "the chart read test file holds the base's tests, none added and none gone (change YU)" "$(yn ch_same)"
    ch_same_ctl() { local CH_NEW=1; ch_same; }
    check "control: the same check refuses one added test" "$(ynnot ch_same_ctl)"
    # The chart write tests (change ZE): the base's kept, none added; the ones
    # gated on images are compiled only with images.
    CW_RS=crates/emend/src/package/tests/chart_write.rs
    CW_MOD=package::tests::chart_write::
    tests_attr "$C" "$CW_RS" >"$B/cw-all"
    tests_attr "$REC" "$CW_RS" >"$B/cw-base"
    git show "$C:$CW_RS" >"$B/cw-src"
    cfg_tests '#[cfg(feature = "images")]' <"$B/cw-src" >"$B/cw-images"
    LC_ALL=C comm -23 "$B/cw-all" "$B/cw-images" >"$B/cw-charts"
    CW_ALL=$(count_lines "$B/cw-all")
    CW_IMAGES=$(count_lines "$B/cw-images")
    CW_CHARTS=$(count_lines "$B/cw-charts")
    CW_CFG=$(count_matches -F '#[cfg(' "$B/cw-src")
    CW_CFG_IMAGES=$(count_matches -xF '#[cfg(feature = "images")]' "$B/cw-src")
    LC_ALL=C comm -13 "$B/cw-base" "$B/cw-all" >"$B/cw-new"
    LC_ALL=C comm -23 "$B/cw-base" "$B/cw-all" >"$B/cw-gone"
    LC_ALL=C comm -12 "$B/cw-new" "$B/cw-images" >"$B/cw-new-images"
    CW_BASE=$(count_lines "$B/cw-base")
    CW_NEW=$(count_lines "$B/cw-new")
    CW_GONE=$(count_lines "$B/cw-gone")
    CW_NEW_IMAGES=$(count_lines "$B/cw-new-images")
    echo "  #[test] functions in $CW_RS at the phase commit: $CW_ALL; at the base: $CW_BASE; added by this phase: $CW_NEW, of them gated on images: $CW_NEW_IMAGES; at the base and not at the phase commit: $CW_GONE; gated on images: $CW_IMAGES; compiled with charts alone: $CW_CHARTS; cfg lines in the file: $CW_CFG, of them #[cfg(feature = \"images\")] alone: $CW_CFG_IMAGES"
    sed 's/^/    the chart write test gated on images: /' "$B/cw-images"
    sed 's/^/    the added chart write test: /' "$B/cw-new"
    cw_shape() { [ "$CW_BASE" -ge 1 ] && [ "$CW_NEW" = 0 ] && [ "$CW_GONE" = 0 ] && [ "$CW_NEW_IMAGES" = 0 ] && [ "$CW_ALL" = "$CW_BASE" ] && [ "$CW_IMAGES" -ge 1 ] && [ "$CW_CFG" = "$CW_IMAGES" ] && [ "$CW_CFG_IMAGES" = "$CW_IMAGES" ] && [ "$CW_ALL" = "$((CW_CHARTS + CW_IMAGES))" ]; }
    check "the chart write test file holds the base's tests, none added and none gone; its only cfg lines are images gates, each before one test (change ZE)" "$(yn cw_shape)"
    cw_shape_ctl0() { local CW_NEW=1; cw_shape; }
    check "control: the same check refuses one added test" "$(ynnot cw_shape_ctl0)"
    cw_shape_ctl() { local CW_CFG=$((CW_IMAGES + 1)); cw_shape; }
    check "control: the same check refuses a cfg line that gates no test" "$(ynnot cw_shape_ctl)"
    cw_shape_ctl2() { local CW_GONE=1; cw_shape; }
    check "control: the same check refuses a base test the phase commit lacks" "$(ynnot cw_shape_ctl2)"
    cw_shape_ctl3() { local CW_NEW_IMAGES=1; cw_shape; }
    check "control: the same check refuses an added test gated on images" "$(ynnot cw_shape_ctl3)"
    tests_attr "$C" "$TOOL_RS" >"$B/tool-all"
    tests_attr "$REC" "$TOOL_RS" >"$B/tool-base"
    LC_ALL=C comm -13 "$B/tool-base" "$B/tool-all" >"$B/tool-new"
    TOOL_NEW=$(count_lines "$B/tool-new")
    echo "  #[test] functions added to $TOOL_RS by this phase: $TOOL_NEW"
    sed 's/^/    the added tool test: /' "$B/tool-new"
    printf '#[cfg(feature = "rules")]\n#[test]\nfn ctl_on() {}\n#[test]\nfn ctl_plain() {}\n#[test]\n#[should_panic]\nfn ctl_attr() {}\n#[cfg(not(feature = "read"))]\n#[test]\nfn ctl_off() {}\n' >"$B/c-cfg"
    check "control: tests_in reads all four tests of a fixture, one with a second attribute" "$(yn [ "$(tests_in <"$B/c-cfg" | count_lines /dev/stdin)" = 4 ])"
    check "control: cfg_tests reads the one test gated on rules, not the plain ones" "$(yn [ "$(cfg_tests '#[cfg(feature = "rules")]' <"$B/c-cfg")" = ctl_on ])"
    # ch_got <run>: the chart read names the run passed, the module path
    # dropped, sorted. It prints, so it writes files, never conditions.
    ch_got() { LC_ALL=C "$G" -F "$CH_MOD" "$B/$1.names" | sed 's/^.*:://' | LC_ALL=C sort; }
    # ch_want <set>: the file of the chart read names the set compiles (none
    # off or with images alone, all of them in every set with charts; changes
    # XT and YU). cw_want <set>: the file of the chart write names the set
    # compiles, every one an added test (none off or with images alone, the
    # ungated ones with charts or charts,read, all of them with charts,images
    # or every feature; change YU). cw_added <set>: the file of the added
    # chart write names the set compiles: none in every set, the phase adding
    # none (change ZE).
    ch_want() { case $1 in off | images) echo "$B/none" ;; *) echo "$B/ch-all" ;; esac; }
    cw_want() {
      case $1 in
        off | images) echo "$B/none" ;;
        charts | charts,read) echo "$B/cw-charts" ;;
        *) echo "$B/cw-all" ;;
      esac
    }
    cw_added() { echo "$B/cw-new"; }
    # cw_got <run>: the chart write names the run passed, the module path
    # dropped, sorted.
    cw_got() { LC_ALL=C "$G" -F "$CW_MOD" "$B/$1.names" | sed 's/^.*:://' | LC_ALL=C sort; }
    printf 'package::tests::chart_write::b\npackage::tests::chart::c\npackage::tests::chart_write::a\n' >"$B/c-cw.names"
    check "control: cw_got reads the two chart write names of three, not the chart read one" "$(yn [ "$(cw_got c-cw | tr '\n' ' ')" = "a b " ])"
    printf 'package::tests::chart::b\npackage::tests::chart_write::c\n' >"$B/c-ch.names"
    check "control: ch_got reads the chart read name, not the chart write one" "$(yn [ "$(ch_got c-ch)" = b ])"
    printf 'package::tests::chart::b\npackage::tests::dxf::c\npackage::tests::chart::a\n' >"$B/c-sv.names"
    check "control: ch_got reads the two chart names of three, sorted, the module path dropped" "$(yn [ "$(ch_got c-sv | tr '\n' ' ')" = "a b " ])"
    for target in host i686; do
      for set in $SETS; do
        ch_got "f-$target-$set" >"$B/ch-got-$target-$set"
        cw_got "f-$target-$set" >"$B/cw-got-$target-$set"
        # Every set's figure is P2's committed line, the images set's among
        # them (changes YZ and ZE).
        prev=$(prev_count "$B/prev-test.log" "$target" "$set")
        case $prev in '' | *[!0-9]*) want=none ;; *) want=$((prev + $(count_lines "$(cw_added "$set")"))) ;; esac
        echo "  E $target, features $set: this run passed $(cat "$B/f-$target-$set.passed"); P2's figure $prev, plus the tests this phase adds that the set compiles $(count_lines "$(cw_added "$set")"), $want; chart tests passed $(count_lines "$B/ch-got-$target-$set") of the $(count_lines "$(ch_want "$set")") the set compiles; chart write tests passed $(count_lines "$B/cw-got-$target-$set") of the $(count_lines "$(cw_want "$set")") the set compiles"
        check "E $target, features $set: the run passes P2's figure for the set plus the tests this phase adds that the set compiles, none (changes YB, YJ, YU, YZ, ZA and ZE)" "$(yn same_count "$(cat "$B/f-$target-$set.passed")" "$want")"
        check "E $target, features $set: the chart tests the run passed are exactly the ones the set compiles, by name" "$(yn cmp -s "$B/ch-got-$target-$set" "$(ch_want "$set")")"
        check "E $target, features $set: the chart write tests the run passed are exactly the ones the set compiles, by name (changes YU and ZA)" "$(yn cmp -s "$B/cw-got-$target-$set" "$(cw_want "$set")")"
      done
    done
    plus_one=$(( $(cat "$B/f-i686-all.passed") + 1 ))
    check "control: the same comparison refuses the i686 all run's count plus one" "$(ynnot same_count "$plus_one" "$(( $(prev_count "$B/prev-test.log" i686 all) + CW_NEW ))")"
    check "control: the added chart write names, none, are not the names a set compiles, the base's being there" "$(ynnot cmp -s "$B/cw-new" "$B/cw-charts")"
    sed '1d' "$B/ch-all" >"$B/c-ch-short"
    check "control: the name comparison refuses the chart names one short" "$(ynnot cmp -s "$B/c-ch-short" "$B/ch-all")"
    check "control: the name comparison refuses the off set's want (none) for a set that compiles the chart tests" "$(ynnot cmp -s "$B/none" "$B/ch-all")"
    check "control: the charts set's chart write names are not the charts,images set's, the tests gated on images being there too" "$(ynnot cmp -s "$B/cw-charts" "$B/cw-all")"
    for set in $SETS; do
      check "E features $set: host and i686 pass the same names" "$(yn cmp -s "$B/f-host-$set.names" "$B/f-i686-$set.names")"
    done
    sed '1d' "$B/f-host-all.names" >"$B/c-names-short"
    check "control: the same comparison refuses the host all run's names one short" "$(ynnot cmp -s "$B/c-names-short" "$B/f-i686-all.names")"
    echo "### W's figure, against M5 part 4 P2's committed W line, plus the tests this phase adds, none (changes VC, WC, XC, XJ, XT, YD, YJ, YU, ZA and ZE)"
    # ws_prev <file> <target>: the passed figure of the one W line of that log
    # for that target ("  ws-<target>: exit 0; passed <n>;", anchored at its
    # start), or "none". It prints, so its value is compared.
    ws_prev() {
      local hits
      hits=$(LC_ALL=C awk -v p="  ws-$2: exit 0; passed " 'index($0, p) == 1 { s = substr($0, length(p) + 1); sub(/;.*$/, "", s); print s }' "$1" | LC_ALL=C "$G" -E '^[0-9]+$')
      if [ -n "$hits" ] && [ "$(printf '%s\n' "$hits" | wc -l)" = 1 ]; then echo "$hits"; else echo none; fi
    }
    printf "  ws-host: exit 0; passed 41; x\n    echo \"  ws-host: exit 0; passed 49; q\"\n  ws-i686: exit 0; passed 42; y\n  ws-i686: exit 0; passed 43; y\n" >"$B/c-ws"
    check "control: ws_prev reads the host figure, not an indented copy of its line" "$(yn [ "$(ws_prev "$B/c-ws" host)" = 41 ])"
    check "control: ws_prev reads none for a target the file gives twice" "$(yn [ "$(ws_prev "$B/c-ws" i686)" = none ])"
    WS_NEW=$((CW_NEW + TOOL_NEW))
    check "the phase adds no chart write test and no tool test, so W's figure is P2's (change ZE)" "$(yn [ "$WS_NEW" = 0 ])"
    check "control: the same check refuses one added test" "$(ynnot [ "$((WS_NEW + 1))" = 0 ])"
    for target in host i686; do
      wprev=$(ws_prev "$B/prev-test.log" "$target")
      case $wprev in '' | *[!0-9]*) wwant=none ;; *) wwant=$((wprev + WS_NEW)) ;; esac
      echo "  W $target: this run passed $(cat "$B/ws-$target.passed"); P2's W figure $wprev, plus the tests this phase adds, each compiled in the workspace (the chart write tests this phase adds $CW_NEW; the tool's added tests $TOOL_NEW) $WS_NEW, $wwant"
      check "W $target: the run passes P2's W figure plus the tests this phase adds, none" "$(yn same_count "$(cat "$B/ws-$target.passed")" "$wwant")"
    done
    ws_ctl() { same_count "$(( $(cat "$B/ws-host.passed") + 1 ))" "$(( $(ws_prev "$B/prev-test.log" host) + WS_NEW ))"; }
    check "control: the same comparison refuses the host W count plus one" "$(ynnot ws_ctl)"
    echo
    echo "## N: the tests the phase adds and removes, derived from the source (changes WD, XD, XK, XU, YE, YK, YU, ZA and ZF)"
    added_between() {
      # $1 older commit, $2 newer commit: "<file> <name>" per #[test] the newer
      # commit has in a .rs file the pair's diff touches and the older lacks.
      local f
      git diff --name-only "$1" "$2" -- '*.rs' | while IFS= read -r f; do
        tests_attr "$2" "$f" >"$B/ab-new"
        tests_attr "$1" "$f" >"$B/ab-old"
        LC_ALL=C comm -13 "$B/ab-old" "$B/ab-new" | sed "s#^#$f #"
      done
    }
    removed_between() { added_between "$2" "$1"; }
    echo "command: git diff --name-only <base> <phase commit> -- '*.rs'"
    git diff --name-only "$REC" "$C" -- '*.rs' >"$B/changed-rs"
    echo "  the .rs files the phase changed: $(count_lines "$B/changed-rs")"
    sed 's/^/    /' "$B/changed-rs"
    added_between "$REC" "$C" >"$B/src-added"
    removed_between "$REC" "$C" >"$B/src-removed"
    echo "  #[test] functions at the phase commit and not at the base, by file:"
    sed 's/^/    /' "$B/src-added"
    echo "  #[test] functions at the base and not at the phase commit, by file: $(count_lines "$B/src-removed")"
    sed 's/^/    /' "$B/src-removed"
    check "the source removes no test in this phase" "$(yn [ "$(count_lines "$B/src-removed")" = 0 ])"
    git diff --name-only --diff-filter=A "$REC" "$C" -- '*.rs' >"$B/new-rs"
    echo "  new .rs files: $(count_lines "$B/new-rs")"
    sed 's/^/    new .rs file: /' "$B/new-rs"
    CWM_RS=crates/emend/src/package/chart_write.rs
    : >"$B/new-rs-want"
    check "the phase adds no .rs file (changes ZA and ZF)" "$(yn cmp -s "$B/new-rs" "$B/new-rs-want")"
    printf '%s\n' "$CWM_RS" >"$B/c-new-rs"
    check "control: the same comparison refuses one new .rs file" "$(ynnot cmp -s "$B/c-new-rs" "$B/new-rs-want")"
    # Change ZF: the one .rs file the phase changes is the size probe's, which
    # holds no test; no crate, tool or test source changes.
    PROBE_RS=tools/size-probe/src/bin/probe-emend-charts-write-xml.rs
    printf '%s\n' "$PROBE_RS" >"$B/changed-rs-want"
    check "the .rs files the phase changes are exactly the size probe's (change ZF)" "$(yn cmp -s "$B/changed-rs" "$B/changed-rs-want")"
    printf '%s\n' "$PROBE_RS" crates/emend/src/package/tests.rs | LC_ALL=C sort >"$B/c-changed-rs"
    check "control: the same comparison refuses a second changed .rs file, package/tests.rs" "$(ynnot cmp -s "$B/c-changed-rs" "$B/changed-rs-want")"
    added_in_file() { awk -v f="$1" '$1 == f { print $2 }' "$B/src-added" | LC_ALL=C sort; }
    check "the source adds no test in this phase (change ZF)" "$(yn [ "$(count_lines "$B/src-added")" = 0 ])"
    printf '%s t1\n' "$PROBE_RS" >"$B/c-src-added0"
    check "control: the same count finds one test in a planted list" "$(yn [ "$(count_lines "$B/c-src-added0")" = 1 ])"
    added_in_file "$PROBE_RS" >"$B/added-probe"
    check "the size probe holds no added test (change ZF)" "$(yn [ "$(count_lines "$B/added-probe")" = 0 ])"
    added_in_file "$CWM_RS" >"$B/added-cwm"
    check "the chart write module itself adds no test" "$(yn [ "$(count_lines "$B/added-cwm")" = 0 ])"
    added_in_file "$CW_RS" >"$B/added-cw"
    check "the tests added to the chart write test module are exactly the ones block E derived, none ($(count_lines "$B/added-cw") of $CW_NEW)" "$(yn cmp -s "$B/added-cw" "$B/cw-new")"
    added_in_file "$CH_RS" >"$B/added-sv"
    check "the chart read test module gains no test ($(count_lines "$B/added-sv"))" "$(yn [ "$(count_lines "$B/added-sv")" = 0 ])"
    added_in_file crates/emend/src/package/chart.rs >"$B/added-chart-module"
    check "the chart read module itself adds no test" "$(yn [ "$(count_lines "$B/added-chart-module")" = 0 ])"
    added_in_file "$TOOL_RS" >"$B/added-tool"
    ntool=$(count_lines "$B/added-tool")
    echo "  tests added to $TOOL_RS: $ntool"
    tool_none() { [ "$ntool" = 0 ] && cmp -s "$B/added-tool" "$B/tool-new"; }
    check "the tool's test file gains no test, the count block E used for W (change ZF)" "$(yn tool_none)"
    tool_none_ctl() { local ntool=1; tool_none; }
    check "control: the same check refuses one added tool test" "$(ynnot tool_none_ctl)"
    # elsewhere <list>: the "<file> <test>" lines of <list> in neither the
    # chart write test module nor the tool's test file.
    elsewhere() { awk -v a="$CW_RS" -v d="$TOOL_RS" '$1 != a && $1 != d' "$1"; }
    elsewhere "$B/src-added" >"$B/added-elsewhere"
    check "no other file gains a test ($(count_lines "$B/added-elsewhere"))" "$(yn [ "$(count_lines "$B/added-elsewhere")" = 0 ])"
    printf '%s t1\n%s t2\nx.rs t3\n' "$CW_RS" "$TOOL_RS" >"$B/c-src-added"
    check "control: the same filter finds one test outside the two files in a list of three" "$(yn [ "$(elsewhere "$B/c-src-added" | count_lines /dev/stdin)" = 1 ])"
    # Each added test passed on both targets, by its module path: a file under
    # crates/emend/src gives <module path>::<name>, an integration test file its
    # bare name (M3 part 6 P3's change CK).
    qualified() {
      case $1 in
        crates/emend/src/*.rs) printf '%s::%s' "$(printf '%s' "${1#crates/emend/src/}" | sed 's/[.]rs$//; s#/#::#g')" "$2" ;;
        *) printf '%s' "$2" ;;
      esac
    }
    passed_on() { count_matches -E "(^|::)$1\$" "$B/$2.names"; }
    both_passed() { [ "$(passed_on "$1" "$2")" = 1 ] && [ "$(passed_on "$1" "$3")" = 1 ]; }
    echo "  each added test, by its module path, and whether it ran and passed on each target in W:"
    while read -r f name; do
      q=$(qualified "$f" "$name")
      echo "    $q (ws-host, ws-i686): host $(passed_on "$q" ws-host), i686 $(passed_on "$q" ws-i686)"
      check "  $q passed on both targets" "$(yn both_passed "$q" ws-host ws-i686)"
    done <"$B/src-added"
    check "control: both_passed refuses a name no run holds" "$(ynnot both_passed zzz_no_such_test_anywhere ws-host ws-i686)"
    while read -r name; do
      q=$(qualified "$CW_RS" "$name")
      echo "    $q, P1's, in F's host charts run (not compiled there, gated on images): $(passed_on "$q" f-host-charts)"
      check "control: both_passed refuses the chart write test gated on images (P1's) in F's charts runs, which do not compile it" "$(ynnot both_passed "$q" f-host-charts f-i686-charts)"
    done <"$B/cw-images"
    qualified_ok() { [ "$(qualified crates/emend/src/package/tests/chart.rs t)" = package::tests::chart::t ] && [ "$(qualified crates/emend/src/styles/tests.rs t)" = styles::tests::t ] && [ "$(qualified tools/emend-copy/tests/null_rewrite.rs t)" = t ]; }
    check "control: qualified gives a crate test its module path and an integration test its bare name" "$(yn qualified_ok)"
    echo
    echo "## K: the crate's tests with every feature on and EMEND_KEEP_DIR set, host (change TF)"
    KEEPD=$(mktemp -d "$B/keep.XXXXXX") || fail=1
    # Change XG (ruling 12): the keep directory, the script's second mktemp
    # call, lies under TMPDIR.
    under_tmpdir() { case "$1" in "$TMPDIR"/*) return 0 ;; *) return 1 ;; esac; }
    echo "command: the keep directory mktemp -d made, against TMPDIR: $KEEPD under $TMPDIR"
    check "the keep directory mktemp -d made lies under TMPDIR, <scratch>/tmp (ruling 12; change XG)" "$(yn under_tmpdir "$KEEPD")"
    check "control: the same check refuses <build>/keep.x, beside TMPDIR, not under it" "$(ynnot under_tmpdir "$BUILD_ROOT/keep.x")"
    echo "command: env EMEND_KEEP_DIR=<scratch>/w/keep.<random> CARGO_TARGET_DIR=<target>/main cargo test -p emend --all-features (host)"
    env EMEND_KEEP_DIR="$KEEPD" CARGO_TARGET_DIR="$CT" cargo test -p emend --all-features >"$B/keep-with.out" 2>&1 </dev/null
    echo "$?" >"$B/keep-with.rc"
    echo "  exit: $(cat "$B/keep-with.rc")"
    LC_ALL=C "$G" -a -E '^test result: ' "$B/keep-with.out" | sed 's/^/    /'
    failed_names "$B/keep-with.out"
    LC_ALL=C "$G" -a -E '^test .* \.\.\. ok$' "$B/keep-with.out" | sed -E 's/^test (.*) \.\.\. ok$/\1/' | LC_ALL=C sort >"$B/keep-with.names"
    nkeep_files=$(find "$KEEPD" -type f | count_lines /dev/stdin)
    echo "  tests passed with the variable: $(count_lines "$B/keep-with.names"); F's host all run without it: $(count_lines "$B/f-host-all.names"); files the keep holds after the run: $nkeep_files"
    keep_same() {
      [ "$(cat "$B/keep-with.rc")" = 0 ] && [ "$(count_lines "$B/keep-with.names")" -ge 1 ] && cmp -s "$B/keep-with.names" "$B/f-host-all.names"
    }
    check "with EMEND_KEEP_DIR set the crate's tests exit 0 and pass the names F's host all run passed without it" "$(yn keep_same)"
    check "the run with the variable wrote files into the keep, so the variable was read" "$(yn [ "$nkeep_files" -ge 1 ])"
    check "the variable is still unset in this script's own environment" "$(yn [ -z "${EMEND_KEEP_DIR+x}" ])"
    sed '1d' "$B/keep-with.names" >"$B/c-keep-short"
    check "control: the same comparison refuses the names one short" "$(ynnot cmp -s "$B/c-keep-short" "$B/f-host-all.names")"
    echo
    echo "## R: each F run's doc-tests result, 0 passed and 0 failed (change RC, kept: the phase's doc comments hold no doctest)"
    # doc_result <cargo output>: "<passed> <failed>" of the first "test result:"
    # line after cargo's "Doc-tests emend" line, or "none". It prints, so its
    # value is compared.
    doc_result() {
      local r
      r=$(awk '/^[[:space:]]*Doc-tests emend[[:space:]]*$/ { d = 1; next }
        d && /^test result: / { p = 0; f = 0; for (i = 1; i < NF; i++) { if ($(i + 1) ~ /^passed;$/) p = $i; if ($(i + 1) ~ /^failed;$/) f = $i }; print p, f; exit }' "$1")
      if [ -n "$r" ]; then echo "$r"; else echo none; fi
    }
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n   Doc-tests emend\n\nrunning 1 test\ntest result: ok. 1 passed; 0 failed; 0 ignored\n' >"$B/c-doc1"
    check "control: doc_result reads 1 0 for a fixture with one doctest, not the lib line before it" "$(yn [ "$(doc_result "$B/c-doc1")" = "1 0" ])"
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n' >"$B/c-doc2"
    check "control: doc_result reads none for an output with no Doc-tests line" "$(yn [ "$(doc_result "$B/c-doc2")" = none ])"
    for target in host i686; do
      for set in $SETS; do
        dl=$(count_matches -E '^[[:space:]]*Doc-tests emend[[:space:]]*$' "$B/f-$target-$set.out")
        dr=$(doc_result "$B/f-$target-$set.out")
        echo "  R $target, features $set: Doc-tests emend lines $dl; its result (passed failed) $dr"
        check "R $target, features $set: one Doc-tests emend line, its result 0 passed 0 failed" "$(yn [ "$dl:$dr" = "1:0 0" ])"
      done
    done
    
    # clean_run <name>: exit 0 and no diagnostic line in the output.
    clean_run() { [ "$(cat "$B/$1.rc")" = 0 ] && [ "$(diag_lines "$B/$1.out")" = 0 ]; }
    # lint_run <name> <env...> -- <cargo args...>: runs cargo into <target>/main,
    # prints the exit and the diagnostic line count, writes <name>.rc.
    lint_run() {
      local name=$1 rc
      shift
      echo "command: CARGO_TARGET_DIR=<target>/main $*"
      env CARGO_TARGET_DIR="$CT" "$@" >"$B/$name.out" 2>&1 </dev/null
      rc=$?
      echo "$rc" >"$B/$name.rc"
      echo "  $name: exit $rc; diagnostic lines $(diag_lines "$B/$name.out")"
      LC_ALL=C "$G" -a -E "$DIAG" "$B/$name.out" | sed 's/^/    /'
    }
    echo 0 >"$B/c-lint.rc"; printf 'warning: unused variable\n    Finished x\n' >"$B/c-lint.out"
    check "control: clean_run refuses an exit-0 run with one warning line" "$(ynnot clean_run c-lint)"
    echo 0 >"$B/c-lint2.rc"; printf '    Checking x\n    Finished x\n' >"$B/c-lint2.out"
    check "control: clean_run takes an exit-0 run with none" "$(yn clean_run c-lint2)"
    
    echo
    echo "## C: clippy with -D warnings, the crate's six sets and the workspace (changes TC, XS and YT)"
    for set in $SETS; do
      # shellcheck disable=SC2207
      sa=($(set_args "$set"))
      lint_run "c-$set" cargo clippy -p emend --all-targets "${sa[@]}" -- -D warnings
      check "C features $set: exit 0, 0 diagnostic lines" "$(yn clean_run "c-$set")"
    done
    lint_run c-workspace cargo clippy --workspace --all-targets -- -D warnings
    check "C workspace: exit 0, 0 diagnostic lines" "$(yn clean_run c-workspace)"
    
    echo
    echo "## D: rustdoc with -D warnings, the crate's six sets (changes TC, XS and YT)"
    for set in $SETS; do
      # shellcheck disable=SC2207
      sa=($(set_args "$set"))
      lint_run "d-$set" RUSTDOCFLAGS='-D warnings' cargo doc -p emend --no-deps "${sa[@]}"
      check "D features $set: exit 0, 0 diagnostic lines" "$(yn clean_run "d-$set")"
    done
    
    TAB=$(printf '\t')
    PROG_SRC=$HOME/.cache/emend-build/m3p7-p3/gen/api-listing.py
    OLD_LISTING=$HOME/.cache/emend-build/m5p3-p3/api/listing.tsv
    OLD_RECORD=records/api-review-m5p3-2026-10-13-d74ea74.md
    FORMATTER=$SELF_DIR/make_review.py
    T=$B/api
    mkdir -p "$T" || fail=1
    
    echo
    echo "## T1: the pub listing, every pub item of crates/emend reachable from the crate root, by module (specs/0035 \"P3\"; M5 part 3 P3's form; changes VG, XM, YM and ZH)"
    api_absent() { [ ! -e "$API_DIR/listing.tsv" ] && [ ! -e "$API_DIR/files.tsv" ]; }
    check "no listing is in <api> before this run" "$(yn api_absent)"
    mkdir -p "$API_DIR" "$T/src" "$T/py" "$T/fx/src" || fail=1
    echo "### the listing program, part 7 P3's own"
    cp "$PROG_SRC" "$T/py/api-listing.py" || fail=1
    PROG_SHA=$(sha256sum <"$T/py/api-listing.py" | cut -d' ' -f1)
    P7_PROG_SHA=$(git show "$C:records/logs/m3p7-p3/test.log" | awk '/^command: the listing program, written by this script/ { getline; print $1; exit }')
    echo "command: cp <home>/.cache/emend-build/m3p7-p3/gen/api-listing.py <scratch>/w/api/py/api-listing.py; sha256sum: $PROG_SHA"
    echo "command: the line after part 7's \"command: the listing program\" line in records/logs/m3p7-p3/test.log at the phase commit (git show): ${P7_PROG_SHA:-none}"
    prog_is_p7() { [ -n "$P7_PROG_SHA" ] && [ "$PROG_SHA" = "$P7_PROG_SHA" ]; }
    check "the listing program is the one part 7 P3's test log inserted and ran, by hash" "$(yn prog_is_p7)"
    prog_ctl() { local PROG_SHA; PROG_SHA=$(printf 'x' | sha256sum | cut -d' ' -f1); prog_is_p7; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot prog_ctl)"
    echo "command: git archive <phase commit> crates/emend/src | tar -x -C <scratch>/w/api/src"
    git archive "$C" crates/emend/src | tar -x -C "$T/src"
    arch_rc=$?
    n_arch=$(find "$T/src/crates/emend/src" -type f -name '*.rs' | count_lines /dev/stdin)
    n_tree=$(git ls-tree -r --name-only "$C" crates/emend/src | count_matches -E '[.]rs$' /dev/stdin)
    echo "  archive exit: $arch_rc; .rs files extracted: $n_arch; .rs files under crates/emend/src in the phase commit's tree: $n_tree"
    arch_ok() { [ "$arch_rc" = 0 ] && [ "$n_arch" -ge 1 ] && [ "$n_arch" = "$n_tree" ]; }
    check "the archive holds every .rs file of the phase commit's crates/emend/src" "$(yn arch_ok)"
    arch_ctl() { local n_tree=$((n_tree + 1)); arch_ok; }
    check "control: the same comparison refuses a tree count one more than the archive's" "$(ynnot arch_ctl)"
    
    echo "### the program's control: part 7's fixture crate, written by this log"
    printf '%s\n' 'pub mod a;' 'mod b;' '#[cfg(test)]' 'mod tests;' 'pub use b::{X, Y as Z};' '/// pub fn not_this()' 'pub(crate) fn hidden() {}' >"$T/fx/src/lib.rs"
    printf '%s\n' 'pub struct P {' '    pub f: u8,' '    g: u8,' '}' 'impl P { pub fn m(&self) { let _s = "{ pub fn fake"; } }' '#[cfg(feature = "q")]' 'pub const C: u8 = 1;' >"$T/fx/src/a.rs"
    printf '%s\n' 'pub struct X;' 'pub struct W;' 'pub enum Y {' '    V,' '}' 'impl W {' '    pub fn n() {}' '}' >"$T/fx/src/b.rs"
    printf '%s\n' 'pub fn t() {}' >"$T/fx/src/tests.rs"
    for f in lib.rs a.rs b.rs tests.rs; do
      echo "  <scratch>/w/api/fx/src/$f:"
      sed 's/^/      /' "$T/fx/src/$f"
    done
    echo "command: python3 -I -B <scratch>/w/api/py/api-listing.py <scratch>/w/api/fx/src fx <repo> <phase commit> <scratch>/w/api/fx/rows.tsv <scratch>/w/api/fx/files.tsv --no-added"
    python3 -I -B "$T/py/api-listing.py" "$T/fx/src" fx "$MAIN" "$C" "$T/fx/rows.tsv" "$T/fx/files.tsv" --no-added >"$T/fx/out" 2>"$T/fx/err"
    fx_rc=$?
    echo "  exit: $fx_rc; standard output $(wc -c <"$T/fx/out") bytes; standard error $(wc -c <"$T/fx/err") bytes; its rows, columns 2 to 8, tabs shown as |:"
    cut -f2-8 "$T/fx/rows.tsv" | tr '\t' '|' | sed 's/^/    /'
    echo "  its files table, tabs shown as |:"
    tr '\t' '|' <"$T/fx/files.tsv" | sed 's/^/    /'
    exp_line() { local IFS=$TAB; printf '%s\n' "$*"; }
    {
      exp_line file line kind name container cfg reachable
      exp_line fx/lib.rs 1 mod a - - yes
      exp_line fx/lib.rs 5 use 'b::{X, Y as Z}' - - yes
      exp_line fx/a.rs 1 struct P - - yes
      exp_line fx/a.rs 2 field f P - yes
      exp_line fx/a.rs 5 method m P - yes
      exp_line fx/a.rs 7 const C - q yes
      exp_line fx/b.rs 1 struct X - - 'yes (re-exported as crate::X)'
      exp_line fx/b.rs 2 struct W - - 'no (private module, not re-exported)'
      exp_line fx/b.rs 3 enum Y - - 'yes (re-exported as crate::Z)'
      exp_line fx/b.rs 7 method n W - 'no (its type is not reachable)'
    } >"$T/fx/expected-rows"
    {
      exp_line file module rows rows_at_line_start rows_reachable
      exp_line fx/lib.rs crate 2 2 2
      exp_line fx/a.rs crate::a 4 3 4
      exp_line fx/b.rs crate::b 4 4 2
      exp_line fx/tests 'cfg(test), not walked' - - -
    } >"$T/fx/expected-files"
    cut -f2-8 "$T/fx/rows.tsv" >"$T/fx/got-rows"
    fx_ran() { [ "$fx_rc" = 0 ] && [ ! -s "$T/fx/out" ] && [ ! -s "$T/fx/err" ]; }
    check "control: the program exits 0 on the fixture crate and prints nothing" "$(yn fx_ran)"
    check "control: the fixture's rows are the expected ones (part 7's fixture and expectation)" "$(yn cmp -s "$T/fx/got-rows" "$T/fx/expected-rows")"
    check "control: the fixture's files table is the expected one" "$(yn cmp -s "$T/fx/files.tsv" "$T/fx/expected-files")"
    cp "$T/fx/expected-rows" "$T/fx/c-rows"; printf 'x\n' >>"$T/fx/c-rows"
    check "control: the same comparison refuses the expected rows with one line more" "$(ynnot cmp -s "$T/fx/got-rows" "$T/fx/c-rows")"
    PUB_RE='^[[:space:]]*pub '
    n_fx_a=$(count_matches -E "$PUB_RE" "$T/fx/src/a.rs")
    n_fx_lib=$(count_matches -E "$PUB_RE" "$T/fx/src/lib.rs")
    echo "  command: count_matches -E '$PUB_RE' over the fixture's a.rs and lib.rs: $n_fx_a and $n_fx_lib"
    check "control: the grep form counts a.rs's three line-start pub lines" "$(yn [ "$n_fx_a" = 3 ])"
    check "control: the grep form counts lib.rs's two pub lines" "$(yn [ "$n_fx_lib" = 2 ])"
    
    echo "### the listing of the phase commit's crate"
    echo "command: python3 -I -B <scratch>/w/api/py/api-listing.py <scratch>/w/api/src/crates/emend/src crates/emend/src <repo> <phase commit> <api>/listing.tsv <api>/files.tsv"
    python3 -I -B "$T/py/api-listing.py" "$T/src/crates/emend/src" crates/emend/src "$MAIN" "$C" "$API_DIR/listing.tsv" "$API_DIR/files.tsv" >"$T/listing.out" 2>"$T/listing.err"
    lst_rc=$?
    echo "  exit: $lst_rc; standard output $(wc -c <"$T/listing.out") bytes; standard error $(wc -c <"$T/listing.err") bytes"
    listing_ran() { [ "$lst_rc" = 0 ] && [ ! -s "$T/listing.out" ] && [ ! -s "$T/listing.err" ]; }
    check "the listing program exits 0 and prints nothing" "$(yn listing_ran)"
    LISTING_SHA=$(sha256sum <"$API_DIR/listing.tsv" | cut -d' ' -f1)
    FILES_SHA=$(sha256sum <"$API_DIR/files.tsv" | cut -d' ' -f1)
    echo "  command: sha256sum <api>/listing.tsv <api>/files.tsv"
    echo "    $LISTING_SHA  listing.tsv"
    echo "    $FILES_SHA  files.tsv"
    echo "  the files table, tabs shown as |:"
    tr '\t' '|' <"$API_DIR/files.tsv" | sed 's/^/    /'
    echo "  the listing, tabs shown as |:"
    tr '\t' '|' <"$API_DIR/listing.tsv" | sed 's/^/    /'
    
    echo "### each walked file's pub lines by grep beside the listing's rows"
    echo "command: count_matches -E '$PUB_RE' <scratch>/w/api/src/<file>, for every walked file"
    pub_bad=0 nfiles=0 rows_sum=0
    while IFS=$TAB read -r f mod rows atstart reach; do
      [ "$f" = file ] && continue
      case "$rows" in -) continue ;; esac
      nfiles=$((nfiles + 1))
      rows_sum=$((rows_sum + rows))
      ng=$(count_matches -E "$PUB_RE" "$T/src/$f")
      echo "    $f ($mod): grep $ng; rows $rows; rows at line start $atstart; reachable $reach"
      if [ "$ng" != "$atstart" ]; then pub_bad=$((pub_bad + 1)); fi
      if [ "$rows" != "$atstart" ]; then
        echo "      rows whose pub follows other text on its line, which the grep form does not count: $((rows - atstart))"
      fi
    done <"$API_DIR/files.tsv"
    n_rows=$(($(count_lines "$API_DIR/listing.tsv") - 1))
    echo "  walked files: $nfiles; rows by the files table: $rows_sum; rows in the listing: $n_rows; files whose grep count differs from their rows at line start: $pub_bad"
    pub_agree() { [ "$nfiles" -ge 1 ] && [ "$pub_bad" = 0 ]; }
    check "every walked file's pub lines by grep equal the listing's rows at line start" "$(yn pub_agree)"
    rows_agree() { [ "$n_rows" -ge 1 ] && [ "$n_rows" = "$rows_sum" ]; }
    check "the listing's rows are the files table's rows, summed" "$(yn rows_agree)"
    pub_ctl() { local pub_bad=1; pub_agree; }
    check "control: the same check refuses one file differing" "$(ynnot pub_ctl)"
    find "$T/src/crates/emend/src" -type f -name '*.rs' | sed "s#^$T/src/##" | sort >"$T/all-rs"
    awk -F"$TAB" 'NR > 1 && $3 != "-" { print $1 }' "$API_DIR/files.tsv" | sort >"$T/walked"
    awk -F"$TAB" 'NR > 1 && $2 ~ /^cfg\(test\)/ { print $1 }' "$API_DIR/files.tsv" | sort >"$T/skipped"
    # unaccounted <file list>: the .rs files neither walked nor under a skipped
    # cfg(test) module (its file, or a path under its directory).
    unaccounted() {
      awk -v W="$T/walked" -v S="$T/skipped" 'BEGIN { while ((getline l < W) > 0) w[l] = 1; ns = 0; while ((getline l < S) > 0) s[++ns] = l }
        { if ($0 in w) next; ok = 0; for (i = 1; i <= ns; i++) if ($0 == s[i] ".rs" || index($0, s[i] "/") == 1) ok = 1; if (!ok) print }' "$1"
    }
    unaccounted "$T/all-rs" >"$T/unaccounted"
    n_all=$(count_lines "$T/all-rs")
    n_walked=$(count_lines "$T/walked")
    n_skipped=$(count_lines "$T/skipped")
    n_un=$(count_lines "$T/unaccounted")
    echo "  .rs files in the archive: $n_all; walked: $n_walked; cfg(test) modules not walked: $n_skipped; files neither walked nor under one: $n_un"
    sed 's/^/    unaccounted: /' "$T/unaccounted"
    check "every .rs file is walked or lies under a cfg(test) module" "$(yn [ "$n_un" = 0 ])"
    cp "$T/all-rs" "$T/c-all-rs"; printf 'crates/emend/src/extra.rs\n' >>"$T/c-all-rs"
    check "control: the same form finds one planted file neither walked nor under a test module" "$(yn [ "$(unaccounted "$T/c-all-rs" | count_lines /dev/stdin)" = 1 ])"
    echo "  rows by kind:"
    awk -F"$TAB" 'NR > 1 { print $4 }' "$API_DIR/listing.tsv" | sort | uniq -c | sed 's/^/    /'
    echo "  rows by reachable:"
    awk -F"$TAB" 'NR > 1 { r = $8; sub(/ \(.*/, "", r); print r }' "$API_DIR/listing.tsv" | sort | uniq -c | sed 's/^/    /'
    awk -F"$TAB" 'NR > 1 { print $10 }' "$API_DIR/listing.tsv" | sort -u >"$T/added"
    n_added=$(count_lines "$T/added")
    n_dash=$(awk -F"$TAB" 'NR > 1 && $10 == "-"' "$API_DIR/listing.tsv" | count_lines /dev/stdin)
    not_anc=0
    while read -r h; do
      [ "$h" = - ] && continue
      git merge-base --is-ancestor "$h" "$C" 2>/dev/null || not_anc=$((not_anc + 1))
    done <"$T/added"
    echo "  distinct added commits: $n_added; rows with no added commit (-): $n_dash; added commits not ancestors of the phase commit: $not_anc"
    check "every added commit is an ancestor of the phase commit" "$(yn [ "$not_anc" = 0 ])"
    anc_ctl() { git merge-base --is-ancestor 0000000000000000000000000000000000000000 "$C" 2>/dev/null; }
    check "control: the same test refuses the null commit" "$(ynnot anc_ctl)"
    
    echo "### the rows, and the rows that differ from M5 part 3 P3's listing by key (changes VG, XM, YM and ZH)"
    OLD_SHA=$(sha256sum <"$OLD_LISTING" | cut -d' ' -f1)
    REC_OLD_SHA=$(git show "$C:$OLD_RECORD" | LC_ALL=C "$G" -o -E 'listing[.]tsv` sha256 [0-9a-f]{64}' | awk '{ print $3 }')
    n_old=$(($(count_lines "$OLD_LISTING") - 1))
    REC_OLD_ITEMS=$(git show "$C:$OLD_RECORD" | LC_ALL=C "$G" -o -E '^- Items: [0-9]+,' | LC_ALL=C "$G" -o -E '[0-9]+')
    echo "command: sha256sum <home>/.cache/emend-build/m5p3-p3/api/listing.tsv: $OLD_SHA; its rows (lines less the header): $n_old"
    echo "command: git show <phase commit>:$OLD_RECORD | grep -o -E 'listing[.]tsv\` sha256 <64 hex>': ${REC_OLD_SHA:-none}; its \"- Items: <n>,\" line's figure: ${REC_OLD_ITEMS:-none}"
    old_is_m4() { [ -n "$REC_OLD_SHA" ] && [ "$OLD_SHA" = "$REC_OLD_SHA" ]; }
    check "M5 part 3 P3's listing file is the one its record names, by hash" "$(yn old_is_m4)"
    old_ctl() { local OLD_SHA=$LISTING_SHA; old_is_m4; }
    check "control: the same comparison refuses this phase's listing" "$(ynnot old_ctl)"
    old_rows_ok() { [ "$n_old" = 718 ] && [ "${REC_OLD_ITEMS:-none}" = 718 ]; }
    check "M5 part 3 P3's listing holds 718 rows, the figure its record states" "$(yn old_rows_ok)"
    old_rows_ctl() { local n_old=719; old_rows_ok; }
    check "control: the same check refuses 719" "$(ynnot old_rows_ctl)"
    # keys_of <listing.tsv>: one line per row, its key (module, kind, name,
    # container, cfg, added; columns 1, 4, 5, 6, 7, 10) joined by |, sorted.
    keys_of() { awk -F"$TAB" 'NR > 1 { print $1 "|" $4 "|" $5 "|" $6 "|" $7 "|" $10 }' "$1" | LC_ALL=C sort; }
    keys_of "$OLD_LISTING" >"$T/keys-old"
    keys_of "$API_DIR/listing.tsv" >"$T/keys-new"
    LC_ALL=C comm -23 "$T/keys-old" "$T/keys-new" >"$T/gone.got"
    LC_ALL=C comm -13 "$T/keys-old" "$T/keys-new" >"$T/new.got"
    n_gone=$(count_lines "$T/gone.got")
    n_new=$(count_lines "$T/new.got")
    echo "command: keys (module|kind|name|container|cfg|added) of M5 part 3 P3's listing and of this one, sorted, compared with comm"
    echo "  M5 part 3 P3's rows: $(count_lines "$T/keys-old"); this listing's rows: $(count_lines "$T/keys-new"); M5 part 3 P3's not here: $n_gone; this listing's not in M5 part 3 P3's: $n_new; equal by key: $(LC_ALL=C comm -12 "$T/keys-old" "$T/keys-new" | count_lines /dev/stdin)"
    echo "  M5 part 3 P3's rows not here:"
    sed 's/^/    - /' "$T/gone.got"
    echo "  this listing's rows not in M5 part 3 P3's:"
    sed 's/^/    + /' "$T/new.got"
    # The two sets the script-writing fork's static run of the same program
    # over the phase commit gave, typed here from gen/test-parts/api-gone.txt
    # and api-new.txt, pasted from that run's output (change ZH): the one pub
    # item M5 part 4 P1 gated with charts as well, ImageAnchor, under its old
    # cfg; and M5 part 4's new items with ImageAnchor under its widened cfg.
    {
      printf '%s\n' 'crate::package|enum|ImageAnchor|-|images|7976d9e'
    } | LC_ALL=C sort >"$T/gone.exp"
    {
      printf '%s\n' 'crate::package::chart_write|enum|NewPlot|-|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|enum|NewSeriesName|-|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|field|categories|NewSeries|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|field|category_axis_title|NewChart|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|field|legend|NewChart|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|field|name|NewSeries|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|field|plot|NewChart|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|field|series|NewChart|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|field|size|NewChart|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|field|title|NewChart|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|field|value_axis_title|NewChart|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|field|values|NewSeries|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|method|add_chart|Package|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|struct|NewChart|-|charts|4c36f05'
      printf '%s\n' 'crate::package::chart_write|struct|NewSeries|-|charts|4c36f05'
      printf '%s\n' 'crate::package|enum|ImageAnchor|-|any(images, charts)|7976d9e'
      printf '%s\n' 'crate::package|use|chart_write::{NewChart, NewPlot, NewSeries, NewSeriesName}|-|charts|4c36f05'
    } | LC_ALL=C sort >"$T/new.exp"
    n_gone_exp=$(count_lines "$T/gone.exp"); n_new_exp=$(count_lines "$T/new.exp")
    echo "  the expected sets as typed: $n_gone_exp gone, $n_new_exp new"
    check "the typed sets hold one and seventeen keys" "$(yn [ "$n_gone_exp:$n_new_exp" = 1:17 ])"
    check "M5 part 3 P3's rows not in this listing are exactly the typed one" "$(yn cmp -s "$T/gone.got" "$T/gone.exp")"
    check "this listing's rows not in M5 part 3 P3's are exactly the typed seventeen" "$(yn cmp -s "$T/new.got" "$T/new.exp")"
    { cat "$T/gone.exp"; printf '%s\n' 'crate::cells|struct|Planted|-|-|0000000'; } | LC_ALL=C sort >"$T/c-gone.exp"
    check "control: the same comparison refuses the gone set with one key planted" "$(ynnot cmp -s "$T/gone.got" "$T/c-gone.exp")"
    { cat "$T/new.exp"; printf '%s\n' 'crate::cells|struct|Planted|-|-|0000000'; } | LC_ALL=C sort >"$T/c-new.exp"
    check "control: the same comparison refuses the new set with one key planted" "$(ynnot cmp -s "$T/new.got" "$T/c-new.exp")"
    echo "  rows in the listing: $n_rows; M5 part 3 P3's $n_old, less $n_gone gone, plus $n_new new: $((n_old - n_gone + n_new))"
    rows_sum_ok() { [ "$n_rows" = "$((n_old - n_gone + n_new))" ] && [ "$n_rows" = 734 ]; }
    check "the listing holds 734 rows, M5 part 3 P3's 718 less one plus seventeen" "$(yn rows_sum_ok)"
    rows_sum_ctl() { local n_rows=735; rows_sum_ok; }
    check "control: the same check refuses 735" "$(ynnot rows_sum_ctl)"
    echo "### each new row's added commit is one of M5 part 4's two crate commits, by subject, but the widened row (changes YM and ZH)"
    by_subj() { git log --format='%H' -n 1 -F --grep="$1" "$C"; }
    added_bad=0
    for pair in "4c36f05|M5 part 4 P1: charts write, add_chart for bar and line charts" \
                "e7827bb|M5 part 4 P2: charts write, pie, scatter and area charts; the catalogue"; do
      short=${pair%%|*}; subj=${pair#*|}
      full=$(git rev-parse --verify -q "$short^{commit}"); want=$(by_subj "$subj")
      echo "  $short: $full; the commit of \"$subj\": ${want:-none}"
      if [ -z "$full" ] || [ "$full" != "$want" ]; then added_bad=$((added_bad + 1)); fi
    done
    check "each of the two crate commits is the commit of its subject" "$(yn [ "$added_bad" = 0 ])"
    awk -F'|' '$6 != "4c36f05" && $6 != "e7827bb"' "$T/new.got" >"$T/new-other.got"
    echo "  new rows whose added commit is neither of the two: $(count_lines "$T/new-other.got")"
    sed 's/^/    /' "$T/new-other.got"
    cut -d'|' -f1-4,6 "$T/new-other.got" | LC_ALL=C sort >"$T/widened.got"
    cut -d'|' -f1-4,6 "$T/gone.got" | LC_ALL=C sort >"$T/widened.want"
    check "they are exactly the gone row by module, kind, name, container and added commit, its cfg widened" "$(yn cmp -s "$T/widened.got" "$T/widened.want")"
    printf 'crate::package|const|PLANTED|-|0000000\n' >>"$T/widened.want"
    check "control: the same comparison refuses the gone rows with one row planted" "$(ynnot cmp -s "$T/widened.got" "$T/widened.want")"
    added_ctl() { [ "$(git rev-parse --verify -q "4c36f05^{commit}")" = "$(by_subj "M5 part 4 P2: charts write, pie, scatter and area charts; the catalogue")" ]; }
    check "control: the same comparison refuses P1's crate commit against P2's subject" "$(ynnot added_ctl)"
    echo "### the items the feature gates widened to charts, pub or not, since M5 part 3 P3's listing (specs/0035 \"P3\"; P1 ruling A; changes YM and ZH)"
    # Every cfg(any(...)) line naming charts that the diff over package.rs adds,
    # from M5 part 3 P3's phase commit (its listing's commit) to this one, and the
    # item it gates: the first line after it that is neither an attribute nor a
    # removed line, read for const, fn, enum or struct and its name. Change ZH:
    # an item read so whose declaration package.rs at M5 part 3 P3's phase
    # commit does not hold is a new item under the shared gate (M5 part 4
    # P1's drawing writer), not a widening; the two sets are split and each
    # compared with its typed list, and only the widened ones go to the
    # formatter.
    M2P3=$(by_subj "M5 part 3 P3: the CHANGELOG names charts read")
    # gate_widenings: name|cfg line, one per item, from a diff on stdin. It
    # prints, so it writes files, never conditions.
    gate_widenings() {
      awk '
        /^\+[[:space:]]*#\[cfg\(any\(.*feature = "charts"/ { w = 1; c = substr($0, 2); sub(/^[[:space:]]+/, "", c); next }
        w && /^[ +]/ {
          l = substr($0, 2)
          if (l ~ /^[[:space:]]*#\[/) next
          if (match(l, /(const|fn|enum|struct) [A-Za-z_][A-Za-z0-9_]*/)) { n = substr(l, RSTART, RLENGTH); sub(/^[a-z]+ /, "", n); print n "|" c }
          w = 0
        }' | LC_ALL=C sort
    }
    echo "command: git diff <M5 part 3 P3's phase commit> <phase commit> -- crates/emend/src/package.rs | gate_widenings (M5 part 3 P3's phase commit by its subject: ${M2P3:-none})"
    git diff "$M2P3" "$C" -- crates/emend/src/package.rs | gate_widenings >"$T/gates-all.got"
    echo "  items the added any(...) lines naming charts gate: $(count_lines "$T/gates-all.got"):"
    sed 's/^/    /' "$T/gates-all.got"
    # declared_before <name>: package.rs at M5 part 3 P3's phase commit holds a
    # const, fn, enum or struct of that name (change ZH).
    git show "$M2P3:crates/emend/src/package.rs" >"$T/package-before.rs"
    declared_before() { [ "$(count_matches -E "(const|fn|enum|struct) $1([^A-Za-z0-9_]|\$)" "$T/package-before.rs")" -ge 1 ]; }
    : >"$T/gates.got"; : >"$T/gates-new.got"
    while IFS='|' read -r gname gcfg; do
      if declared_before "$gname"; then printf '%s|%s\n' "$gname" "$gcfg" >>"$T/gates.got"; else printf '%s|%s\n' "$gname" "$gcfg" >>"$T/gates-new.got"; fi
    done <"$T/gates-all.got"
    echo "  of them declared in package.rs at M5 part 3 P3's phase commit, widened: $(count_lines "$T/gates.got"):"
    sed 's/^/    /' "$T/gates.got"
    echo "  not declared there, new items under the shared gate: $(count_lines "$T/gates-new.got"):"
    sed 's/^/    /' "$T/gates-new.got"
    check "control: declared_before finds ImageAnchor at M5 part 3 P3's phase commit" "$(yn declared_before ImageAnchor)"
    check "control: declared_before refuses NewDrawing, which M5 part 4 P1 adds" "$(ynnot declared_before NewDrawing)"
    # The thirteen widened and the four new the script-writing fork's run of
    # the same form gave, typed here from gen/test-parts/gates.txt and
    # gates-new.txt (P1 ruling A's drawing writer; ImageAnchor among the
    # widened).
    {
      printf '%s\n' 'DRAWING_CONTENT_TYPE|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'DrawingForm|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'DrawingRead|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'DrawingWork|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'EMU_PER_PIXEL|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'ElementPass|#[cfg(any(feature = "comments", feature = "images", feature = "charts"))]'
      printf '%s\n' 'ImageAnchor|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'anchor_bytes|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'drawing_part_bytes|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'edited_part_untouched|#[cfg(any(feature = "comments", feature = "images", feature = "charts"))]'
      printf '%s\n' 'no_image_edits|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'read_drawing|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'with_colon|#[cfg(any(feature = "images", feature = "charts"))]'
    } | LC_ALL=C sort >"$T/gates.exp"
    {
      printf '%s\n' 'NewDrawing|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'drawing_a|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'drawing_r|#[cfg(any(feature = "images", feature = "charts"))]'
      printf '%s\n' 'record_drawings|#[cfg(any(feature = "images", feature = "charts"))]'
    } | LC_ALL=C sort >"$T/gates-new.exp"
    check "the typed widenings hold thirteen items, ImageAnchor among them, and the typed new four" "$(yn [ "$(count_lines "$T/gates.exp"):$(count_matches -E '^ImageAnchor[|]' "$T/gates.exp"):$(count_lines "$T/gates-new.exp")" = 13:1:4 ])"
    check "the items the gates widened are exactly the typed thirteen, each with its cfg line" "$(yn cmp -s "$T/gates.got" "$T/gates.exp")"
    check "the new items under the shared gate are exactly the typed four, each with its cfg line" "$(yn cmp -s "$T/gates-new.got" "$T/gates-new.exp")"
    { cat "$T/gates.exp"; printf '%s\n' 'PLANTED|#[cfg(any(feature = "images", feature = "charts"))]'; } | LC_ALL=C sort >"$T/c-gates.exp"
    check "control: the same comparison refuses the typed widenings with one item planted" "$(ynnot cmp -s "$T/gates.got" "$T/c-gates.exp")"
    printf '%s\n' ' /// x' '-#[cfg(feature = "images")]' '+#[cfg(any(feature = "images", feature = "charts"))]' ' #[derive(Debug)]' ' pub enum Planted {' '+#[cfg(feature = "charts")]' '+mod planted;' '+    #[cfg(any(feature = "comments", feature = "charts"))]' '     fn planted_fn() {}' >"$T/c-gates.diff"
    gate_widenings <"$T/c-gates.diff" >"$T/c-gates.got"
    check "control: the same form reads two items from a fixture diff, past a derive line and an indent, not the new module's plain gate" "$(yn [ "$(cut -d'|' -f1 "$T/c-gates.got" | tr '\n' ' ')" = 'Planted planted_fn ' ])"
    cut -d'|' -f3 "$T/widened.got" | LC_ALL=C sort >"$T/widened-names"
    cut -d'|' -f1 "$T/gates.got" | LC_ALL=C sort >"$T/gates-names"
    echo "  of them pub, in the listing (the widened rows' names): $(count_lines "$T/widened-names"); crate-private, not in the pub listing: $(LC_ALL=C comm -13 "$T/widened-names" "$T/gates-names" | count_lines /dev/stdin)"
    pub_among() { [ "$(count_lines "$T/widened-names")" = 1 ] && [ "$(LC_ALL=C comm -23 "$T/widened-names" "$T/gates-names" | count_lines /dev/stdin)" = 0 ]; }
    check "the widened row's name is among the items the gates widened" "$(yn pub_among)"
    printf 'Planted\n' >"$T/c-gates-names"
    check "control: the same form finds a widened name outside a planted gates list" "$(yn [ "$(LC_ALL=C comm -23 "$T/widened-names" "$T/c-gates-names" | count_lines /dev/stdin)" = 1 ])"
    
    echo
    echo "## T2: the doc build with every feature and no warning, and the documented items it indexes (M5 part 3 P3's form; changes XM, YM and ZH)"
    echo "command: RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR=<target>/main cargo doc --offline -p emend --no-deps --all-features"
    RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR=$CT cargo doc --offline -p emend --no-deps --all-features >"$T/doc.out" 2>&1 </dev/null
    doc_rc=$?
    echo "  exit: $doc_rc; its output:"
    sed 's/^/    /' "$T/doc.out"
    check "the doc build exits 0" "$(yn [ "$doc_rc" = 0 ])"
    WARN_RE='^(warning|error)'
    nwarn=$(count_matches -E "$WARN_RE" "$T/doc.out")
    check "no warning or error line in its output: $nwarn" "$(yn [ "$nwarn" = 0 ])"
    printf 'warning: x\n   Finished\nerror: y\n' >"$T/c-doc"
    check "control: the same form counts two such lines in a fixture" "$(yn [ "$(count_matches -E "$WARN_RE" "$T/c-doc")" = 2 ])"
    ALL_HTML=$CT/doc/emend/all.html
    ITEM_RE='<li><a href="[^"]+"'
    # item_links <html>: one line per item link of a rustdoc all-items page.
    item_links() { LC_ALL=C "$G" -o -E "$ITEM_RE" "$1"; }
    item_links "$ALL_HTML" >"$T/all-items" 2>/dev/null
    n_links=$(count_lines "$T/all-items")
    n_anchors=$(count_matches -E '^<li><a href="#' "$T/all-items")
    n_documented=$((n_links - n_anchors))
    echo "command: grep -o -E '$ITEM_RE' <target>/main/doc/emend/all.html | count_lines; of them, the links to a section anchor (href starting #)"
    echo "  link lines in the index: $n_links; section anchors among them: $n_anchors; documented module-level items: $n_documented; by kind (the link's last path segment up to its first dot):"
    sed -E 's#^<li><a href="([^"]*/)?([A-Za-z_]+)[.].*#\2#' "$T/all-items" | sort | uniq -c | sed 's/^/    /'
    check "the index lists at least one documented item" "$(yn [ "$n_documented" -ge 1 ])"
    printf '<h3>Structs</h3><ul class="all-items"><li><a href="#structs">S</a></li><li><a href="a/struct.A.html">a::A</a></li><li><a href="struct.B.html">B</a></li></ul><h3>Functions</h3><ul class="all-items"><li><a href="fn.f.html">f</a></li></ul>\n' >"$T/c-all.html"
    item_links "$T/c-all.html" >"$T/c-all-items"
    check "control: the same form finds four links, one of them an anchor, on one line of a fixture page" "$(yn [ "$(count_lines "$T/c-all-items"):$(count_matches -E '^<li><a href="#' "$T/c-all-items")" = 4:1 ])"
    n_top=$(awk -F"$TAB" 'NR > 1 && $8 ~ /^yes/ && ($4 == "struct" || $4 == "enum" || $4 == "fn" || $4 == "const" || $4 == "type" || $4 == "trait" || $4 == "static")' "$API_DIR/listing.tsv" | count_lines /dev/stdin)
    echo "  the listing's reachable module-level types, functions, constants, statics and aliases: $n_top"
    check "the documented module-level items equal the listing's reachable module-level items" "$(yn [ "$n_documented" = "$n_top" ])"
    top_ctl() { local n_top=$((n_top + 1)); [ "$n_documented" = "$n_top" ]; }
    check "control: the same comparison refuses one item more" "$(ynnot top_ctl)"
    
    echo
    echo "## R2: the API record, written by the formatter and installed (specs/0035 \"P3\"; changes VG, XM, YM and ZH)"
    FMT_SHA=$(sha256sum <"$FORMATTER" | cut -d' ' -f1)
    echo "command: sed 's/^/    /' <scripts>/make_review.py; sha256sum: $FMT_SHA; $(wc -c <"$FORMATTER") bytes"
    sed 's/^/    /' "$FORMATTER"
    fmt_there() { [ -s "$FORMATTER" ]; }
    check "the formatter is there and not empty" "$(yn fmt_there)"
    check "control: the same check refuses a file that is not there" "$(ynnot test -s "$SELF_DIR/no-such-formatter.py")"
    REC_DATE=$(date -u +%F)
    REC_NAME=api-review-m5p4-$REC_DATE-$SHORT_SHA.md
    STAGED=$T/$REC_NAME
    echo "command: python3 -I -B <scripts>/make_review.py <api>/listing.tsv <home>/.cache/emend-build/m5p3-p3/api/listing.tsv <scratch>/w/api/$REC_NAME $REC_DATE $SHORT_SHA <listing sha256> <files sha256> <formatter sha256> $n_links $n_anchors $n_documented $n_top <scratch>/w/api/gates.got"
    python3 -I -B "$FORMATTER" "$API_DIR/listing.tsv" "$OLD_LISTING" "$STAGED" "$REC_DATE" "$SHORT_SHA" "$LISTING_SHA" "$FILES_SHA" "$FMT_SHA" "$n_links" "$n_anchors" "$n_documented" "$n_top" "$T/gates.got" >"$T/fmt.out" 2>"$T/fmt.err"
    fmt_rc=$?
    echo "  exit: $fmt_rc; standard error $(wc -c <"$T/fmt.err") bytes; its standard output:"
    sed 's/^/    /' "$T/fmt.out"
    FMT_WANT="rows 734; {'keep': 734}; differing from M5 part 3 P3: 1 gone, 17 new; gate-widened 13, 1 of them pub"
    fmt_ok() { [ "$fmt_rc" = 0 ] && [ ! -s "$T/fmt.err" ] && [ "$(cat "$T/fmt.out")" = "$FMT_WANT" ] && [ -s "$STAGED" ]; }
    check "the formatter exits 0, prints \"$FMT_WANT\" alone and writes its file" "$(yn fmt_ok)"
    fmt_ctl() { local FMT_WANT="rows 718; {'keep': 718}; differing from M5 part 3 P3: 0 gone, 0 new; gate-widened 0, 0 of them pub"; fmt_ok; }
    check "control: the same check refuses M5 part 3 P3's figures" "$(ynnot fmt_ctl)"
    n_nonascii=$(LC_ALL=C tr -cd '\200-\377' <"$STAGED" | wc -c)
    echo "  the staged record: $(wc -c <"$STAGED") bytes, sha256 $(sha256sum <"$STAGED" | cut -d' ' -f1); non-ASCII bytes in it: $n_nonascii"
    check "the staged record is ASCII" "$(yn [ "$n_nonascii" = 0 ])"
    REC_DEST=$RECORDS_DEST/$REC_NAME
    rec_absent() { [ ! -e "$REC_DEST" ]; }
    echo "command: cp <scratch>/w/api/$REC_NAME <the records' destination>/$REC_NAME, refused if that name is there (the destination: $RECORDS_DEST)"
    if rec_absent; then
      cp "$STAGED" "$REC_DEST"
      inst_rc=$?
      echo "  installed: exit $inst_rc"
      check "the record's name was not there before this run" yes
    else
      inst_rc=refused
      echo "  refused: $REC_NAME is already there"
      check "the record's name was not there before this run" no
    fi
    installed_ok() { [ "$inst_rc" = 0 ] && cmp -s "$STAGED" "$REC_DEST"; }
    check "the installed record is the staged one, byte for byte" "$(yn installed_ok)"
    echo "  the installed record: $RECORDS_DEST/$REC_NAME, sha256 $(sha256sum <"$REC_DEST" 2>/dev/null | cut -d' ' -f1), $(wc -c <"$REC_DEST" 2>/dev/null) bytes"
    check "control: the absence check refuses the staged file, which is there" "$(ynnot test ! -e "$STAGED")"
    
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.out; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's log directory, its records or specs/0035 modified: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's log directory, its untracked records or specs/0035 modified (changes TB, WB, XR, YR, YY and ZD)" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/test.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

