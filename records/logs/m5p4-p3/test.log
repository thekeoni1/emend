    OURS="^((\\?\\?| ?[MARCD]) records/logs/m5p4-p3/|[?][?] records/(size-m5p4|api-review-m5p4)-[0-9]{4}-[0-9]{2}-[0-9]{2}-${SHORT_SHA}[.]md\$|[?][?] records/m5p4-(p3-[a-z]+|open)-[0-9]{4}-[0-9]{2}-[0-9]{2}-${SHORT_SHA}[.](md|txt)\$| M specs/0035-charts-write-first-set[.]md\$)"
