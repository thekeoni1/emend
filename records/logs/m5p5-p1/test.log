    # commit's short sha: the more sample's and the open check's, .md and
    # .txt) and planning's modified specs/0036, nothing else (changes TB,
    # UB, WB, XB, XR, YA, YI, YR, YY, ZD and ZN).
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m5p5-p1/|[?][?] records/m5p5-(p1|open)-[0-9]{4}-[0-9]{2}-[0-9]{2}-${SHORT_SHA}[.](md|txt)\$| M specs/0036-charts-write-second-set[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's log directory, its records and specs/0036 modified" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$B#<scratch>/w#g" \
