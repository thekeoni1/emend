    """The messages a Rust source file's catalogue lists: each //! line whose
    text, trimmed, starts '- "', its string read to the closing quote, the
    escaped brackets unescaped, one per line, as the crate's catalogue test
    reads them.
    Usage: catalogue.py <file.rs>."""
    import re
    import sys
    
    for line in open(sys.argv[1]):
        m = re.match(r'^\s*//!\s*- "((?:[^"\\]|\\.)*)"', line)
        if m:
            print(m.group(1).replace("\\[", "[").replace("\\]", "]"))
