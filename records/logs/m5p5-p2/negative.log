## the fixtures: B0, the tool tests' appended fixture, N1 (part 4 P2's case; ruling K), N2 (part 4 P1's case) and N3 (P1's case; part 4 ruling Q); N4 is N1's through the 3D sample (this phase's case; part 4 ruling K's), B2 B0's (changes NE31 to NE38)
    """Fictional packages for M5 part 5 P2's negative log (change NE38): B0 is
    the tool tests' appended fixture, image_specs(A_CELL,
    "<drawing r:id=\"rId1\"/>", true) in tools/emend-copy/tests/null_rewrite.rs
    at the phase commit, rebuilt here entry by entry in its order, each entry
    stored or deflated as the test's Spec makes it (every piece of the helpers'
    source this rebuild copies is asserted present in that source); N1 is B0
    with the drawing part's root renamed from xdr:wsDr to xdr:userShapes in
    its start and end tags, stored, as the kinds tool test's refusal does
    (ruling K); N2 is B0 without the drawing part's entry, as the add-chart
    tool test's refusal removes it; N3 is B0 with the worksheet's drawing
    element written twice, as the two-drawing tool test builds it. The kinds
    tool test's expected line, one
    for both its cases, is read from the test's source (its string's
    continuations joined, its escapes read) into b0.line; the add-chart tool
    test's line for its appended case, read the same way, into b1.line;
    and the 3D tool test's line, one for both its cases, into b2.line (change
    NE38).
    Usage: gen-fx.py <null_rewrite.rs> <out dir>."""
    import os
    import re
    import sys
    import zipfile
    
    TYPES_NS = "http://schemas.openxmlformats.org/package/2006/content-types"
    RELS_NS = "http://schemas.openxmlformats.org/package/2006/relationships"
    MAIN_NS = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    ATTR_NS = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    RELS_TYPE = "application/vnd.openxmlformats-package.relationships+xml"
    WORKBOOK_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"
    SHEET_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"
    STRINGS_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"
    DRAWING_TYPE = "application/vnd.openxmlformats-officedocument.drawing+xml"
    XDR_NS = "http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing"
    A_NS = "http://schemas.openxmlformats.org/drawingml/2006/main"
    DECL = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    
    src, out = sys.argv[1], sys.argv[2]
    test = open(src).read()
    
    # The expected line: the kinds test fn's one `line`, asserted for both its
    # cases, the appended one (its label, its flag and its `after`) among them.
    fn = test.index("fn the_chart_kinds_sample_adds_one_chart_of_each_kind_and_reads_them_back()")
    body = test[fn:test.index("\n}\n", fn)]
    assert re.search(r'"chart-kinds-sample-appended",\n\s*true,\n\s*"<drawing r:id=\\"rId1\\"/>",\n'
                     r'\s*\),', body), "the appended case"
    m = re.search(r'let line = "((?:[^"\\]|\\.)*)";', body, re.S)
    assert m, "the kinds test's line"
    lit = re.sub(r"\\\n\s*", "", m.group(1))
    line = lit.replace("\\t", "\t").replace("\\n", "\n")
    assert "\\" not in line and line.endswith("\n") and line.count("\n") == 1
    assert "let specs = image_specs(A_CELL, after, drawing);" in body
    assert 'assert_eq!(ran.stdout, line, "the line");' in body
    open(os.path.join(out, "b0.line"), "w").write(line.rstrip("\n"))
    print("read from null_rewrite.rs: chartkinds line fields:%d" % len(line.rstrip("\n").split("\t")))
    
    # The add-chart test's line: the string after the appended case's label, its
    # flag and its `after`, in the add-chart test fn (change NE36).
    fn = test.index("fn the_add_chart_sample_adds_a_column_chart_and_reads_it_back()")
    body = test[fn:test.index("\n}\n", fn)]
    m = re.search(r'"add-chart-sample-appended",\n\s*true,\n\s*"<drawing r:id=\\"rId1\\"/>",\n'
                  r'\s*"((?:[^"\\]|\\.)*)",\n\s*\),', body, re.S)
    assert m, "the add-chart appended case's line"
    lit = re.sub(r"\\\n\s*", "", m.group(1))
    line = lit.replace("\\t", "\t").replace("\\n", "\n")
    assert "\\" not in line and line.endswith("\n") and line.count("\n") == 1
    assert "let specs = image_specs(A_CELL, after, drawing);" in body
    open(os.path.join(out, "b1.line"), "w").write(line.rstrip("\n"))
    print("read from null_rewrite.rs: addchart line fields:%d" % len(line.rstrip("\n").split("\t")))
    
    # The 3D test's line (change NE38): the fn's one `line`, asserted for both
    # its cases, the appended one (its label, its flag and its `after`) among
    # them.
    fn = test.index("fn the_chart_3d_sample_adds_the_3d_kinds_and_a_combined_chart_and_reads_them_back()")
    body = test[fn:test.index("\n}\n", fn)]
    assert re.search(r'\("chart-3d-sample-appended", true, "<drawing r:id=\\"rId1\\"/>"\),', body), \
        "the 3D appended case"
    m = re.search(r'let line = "((?:[^"\\]|\\.)*)";', body, re.S)
    assert m, "the 3D test's line"
    lit = re.sub(r"\\\n\s*", "", m.group(1))
    line = lit.replace("\\t", "\t").replace("\\n", "\n")
    assert "\\" not in line and line.endswith("\n") and line.count("\n") == 1
    assert "let specs = image_specs(A_CELL, after, drawing);" in body
    assert 'emend_copy_with(&input, &output, &["--chart-3d-sample"]);' in body
    assert 'assert_eq!(ran.stdout, line, "the line");' in body
    open(os.path.join(out, "b2.line"), "w").write(line.rstrip("\n"))
    print("read from null_rewrite.rs: chart3d line fields:%d" % len(line.rstrip("\n").split("\t")))
    
    # The helpers' source, each piece the rebuild copies.
    for needle in [
            "fn image_specs(sheet_data: &str, after: &str, drawing: bool) -> Vec<Spec> {",
            "let mut specs = edit_specs(sheet_data);",
            "fn edit_specs(sheet_data: &str) -> Vec<Spec> {",
            "let mut specs = cells_specs();",
            "fn cells_specs() -> Vec<Spec> {",
            "let mut specs = shared_strings_specs();",
            "fn shared_strings_specs() -> Vec<Spec> {",
            'const A_CELL: &str = "<sheetData><row r=\\"1\\"><c r=\\"A1\\"><v>1</v></c></row></sheetData>";',
            '<worksheet xmlns=\\"{MAIN_NS}\\" xmlns:r=\\"{ATTR_NS}\\"><dimension ref=\\"A1\\"/>\\\n         {sheet_data}<pageMargins left=\\"0.7\\"/>{after}</worksheet>',
            '*spec = Spec::stored(b"xl/worksheets/sheet1.xml", sheet.as_bytes());',
            '<Override PartName=\\"/xl/drawings/drawing1.xml\\" \\\n                             ContentType=\\"{DRAWING_TYPE}\\"/><Override \\\n                             PartName=\\"/xl/media/image1.png\\" ContentType=\\"image/png\\"/></Types>',
            '*spec = Spec::deflated(b"[Content_Types].xml", types.as_bytes());',
            'Type=\\"{ATTR_NS}/drawing\\" Target=\\"../drawings/drawing1.xml\\"/></Relationships>',
            'b"xl/worksheets/_rels/sheet1.xml.rels",',
            'b"xl/drawings/drawing1.xml",',
            'Type=\\"{ATTR_NS}/image\\" Target=\\"../media/image1.png\\"/></Relationships>',
            'b"xl/drawings/_rels/drawing1.xml.rels",',
            'specs.push(Spec::stored(b"xl/media/image1.png", b"kept image bytes"));',
            '<si><t>alpha</t></si><si><t>a\\r\\nb</t></si></sst>',
            'Spec::deflated(b"[Content_Types].xml", content_types.as_bytes()),',
            'Spec::stored(b"_rels/.rels", package_rels.as_bytes()),',
            'Spec::deflated(b"xl/workbook.xml", workbook.as_bytes()),',
            'Spec::stored(b"xl/_rels/workbook.xml.rels", workbook_rels.as_bytes()),',
            'Spec::deflated(b"xl/worksheets/sheet1.xml", b"<sheetData/>"),',
            'Spec::deflated(b"xl/sharedStrings.xml", strings.as_bytes()),',
            '<Relationship Id=\\"rId2\\" Type=\\"{ATTR_NS}/sharedStrings\\" Target=\\"sharedStrings.xml\\"/>',
            'r:embed=\\"rId1\\"/></xdr:blipFill><xdr:spPr/></xdr:pic><xdr:clientData/>',
            '.replace("xdr:wsDr", "xdr:userShapes");',
            '*spec = Spec::stored(b"xl/drawings/drawing1.xml", text.as_bytes());',
            'specs.retain(|spec| spec.name != b"xl/drawings/drawing1.xml");',
            'fn the_add_chart_sample_refuses_a_worksheet_with_two_drawing_elements_and_leaves_nothing() {',
            '"<drawing r:id=\\"rId1\\"/><drawing r:id=\\"rId1\\"/>",',
            'fn the_chart_3d_sample_refuses_a_drawing_whose_root_is_not_ws_dr_and_leaves_nothing() {',
            'let ran = emend_copy_with(&input, &output, &["--chart-3d-sample"]);']:
        assert needle in test, needle
    print("the helpers' source pieces found: yes")
    
    STORED, DEFLATED = zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED
    content_types = (DECL + '<Types xmlns="' + TYPES_NS + '">'
                     '<Default Extension="rels" ContentType="' + RELS_TYPE + '"/>'
                     '<Default Extension="xml" ContentType="application/xml"/>'
                     '<Override PartName="/xl/workbook.xml" ContentType="' + WORKBOOK_TYPE + '"/>'
                     '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="' + SHEET_TYPE + '"/>'
                     '<Override PartName="/xl/sharedStrings.xml" ContentType="' + STRINGS_TYPE + '"/>'
                     '<Override PartName="/xl/drawings/drawing1.xml" ContentType="' + DRAWING_TYPE + '"/>'
                     '<Override PartName="/xl/media/image1.png" ContentType="image/png"/></Types>')
    package_rels = ('<Relationships xmlns="' + RELS_NS + '"><Relationship Id="rId1" Type="' + ATTR_NS
                    + '/officeDocument" Target="xl/workbook.xml"/></Relationships>')
    workbook = ('<workbook xmlns="' + MAIN_NS + '" xmlns:r="' + ATTR_NS + '"><sheets>'
                '<sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets></workbook>')
    workbook_rels = ('<Relationships xmlns="' + RELS_NS + '">'
                     '<Relationship Id="rId1" Type="' + ATTR_NS + '/worksheet" Target="worksheets/sheet1.xml"/>'
                     '<Relationship Id="rId2" Type="' + ATTR_NS + '/sharedStrings" Target="sharedStrings.xml"/>'
                     '</Relationships>')
    strings = (DECL + '<sst xmlns="' + MAIN_NS + '" count="2" uniqueCount="2">'
               '<si><t>alpha</t></si><si><t>a\r\nb</t></si></sst>')
    sheet = (DECL + '<worksheet xmlns="' + MAIN_NS + '" xmlns:r="' + ATTR_NS + '"><dimension ref="A1"/>'
             '<sheetData><row r="1"><c r="A1"><v>1</v></c></row></sheetData><pageMargins left="0.7"/>'
             '<drawing r:id="rId1"/></worksheet>')
    sheet_rels = ('<Relationships xmlns="' + RELS_NS + '"><Relationship Id="rId1" Type="' + ATTR_NS
                  + '/drawing" Target="../drawings/drawing1.xml"/></Relationships>')
    drawing = (DECL + '<xdr:wsDr xmlns:xdr="' + XDR_NS + '" xmlns:a="' + A_NS + '"><xdr:twoCellAnchor>'
               '<xdr:from><xdr:col>3</xdr:col><xdr:colOff>0</xdr:colOff><xdr:row>3</xdr:row>'
               '<xdr:rowOff>0</xdr:rowOff></xdr:from><xdr:to><xdr:col>5</xdr:col><xdr:colOff>0'
               '</xdr:colOff><xdr:row>5</xdr:row><xdr:rowOff>0</xdr:rowOff></xdr:to><xdr:pic>'
               '<xdr:nvPicPr><xdr:cNvPr id="2" name="Picture 2"/><xdr:cNvPicPr/></xdr:nvPicPr>'
               '<xdr:blipFill><a:blip xmlns:r="' + ATTR_NS + '" '
               'r:embed="rId1"/></xdr:blipFill><xdr:spPr/></xdr:pic><xdr:clientData/>'
               '</xdr:twoCellAnchor></xdr:wsDr>')
    drawing_rels = ('<Relationships xmlns="' + RELS_NS + '"><Relationship Id="rId1" Type="' + ATTR_NS
                    + '/image" Target="../media/image1.png"/></Relationships>')
    DRAWING = "xl/drawings/drawing1.xml"
    B0 = [
        ("[Content_Types].xml", content_types.encode(), DEFLATED),
        ("_rels/.rels", package_rels.encode(), STORED),
        ("xl/workbook.xml", workbook.encode(), DEFLATED),
        ("xl/_rels/workbook.xml.rels", workbook_rels.encode(), STORED),
        ("xl/worksheets/sheet1.xml", sheet.encode(), STORED),
        ("xl/sharedStrings.xml", strings.encode(), DEFLATED),
        ("xl/worksheets/_rels/sheet1.xml.rels", sheet_rels.encode(), STORED),
        (DRAWING, drawing.encode(), STORED),
        ("xl/drawings/_rels/drawing1.xml.rels", drawing_rels.encode(), STORED),
        ("xl/media/image1.png", b"kept image bytes", STORED),
    ]
    
    
    def write(name, items):
        path = os.path.join(out, name + ".xlsx")
        with zipfile.ZipFile(path, "w") as z:
            for part, data, method in items:
                z.writestr(zipfile.ZipInfo(part, date_time=(1980, 1, 1, 0, 0, 0)), data, compress_type=method)
        with zipfile.ZipFile(path) as z:
            listed = z.namelist()
            back = all(z.read(p) == d for p, d, _ in items)
            methods = all(z.getinfo(p).compress_type == m for p, _, m in items)
        ct_index = listed.index("[Content_Types].xml") if "[Content_Types].xml" in listed else -1
        print("%s.xlsx entries:%d ct_index:%d read_back:%s methods:%s"
              % (name, len(listed), ct_index, "yes" if back else "no", "yes" if methods else "no"))
    
    
    write("b0", B0)
    renamed = []
    for part, data, method in B0:
        if part == DRAWING:
            assert data.count(b"xdr:wsDr") == 2 and b"xdr:userShapes" not in data
            data = data.replace(b"xdr:wsDr", b"xdr:userShapes")
            assert method == STORED
        renamed.append((part, data, method))
    print("n1 entries renamed:%d (the drawing part's root, xdr:wsDr to xdr:userShapes in its start and end tags, stored; every other entry as B0's)"
          % sum(1 for a, b in zip(B0, renamed) if a != b))
    write("n1", renamed)
    kept = [item for item in B0 if item[0] != DRAWING]
    print("n2 entries dropped:%d (the drawing part; the sheet's drawing element and relationship kept)"
          % (len(B0) - len(kept)))
    write("n2", kept)
    # N3 (change NE37): the worksheet's drawing element twice, the same
    # relationship named, every other entry as B0's.
    SHEET = "xl/worksheets/sheet1.xml"
    ONE = b'<drawing r:id="rId1"/>'
    doubled = []
    for part, data, method in B0:
        if part == SHEET:
            assert data.count(ONE) == 1 and method == STORED
            data = data.replace(ONE, ONE + ONE)
        doubled.append((part, data, method))
    print("n3 entries changed:%d (the worksheet, its drawing element twice; stored; every other entry as B0's)"
          % sum(1 for a, b in zip(B0, doubled) if a != b))
    write("n3", doubled)
