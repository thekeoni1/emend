    P53_BASE=$(git log --format='%H' -n 1 --grep='^M5 part 5 P2 record:')
    echo "  P3's base and tool commit, by subject: ${P53_BASE:-none found}, ${P53_TOOLC:-none found}"
    CWT=crates/emend/src/package/tests/chart_write.rs
    test_bodies "$P53_BASE" "$CWT" >"$W/c-tb-base" 2>/dev/null || :
    test_bodies "$P53_TOOLC" "$CWT" >"$W/c-tb-head" 2>/dev/null || :
    added_in "$W/c-tb-base" "$W/c-tb-head" "$CWT" | LC_ALL=C sort >"$W/c-p3-edited" 2>/dev/null || :
    sed 's/^/    over P3'"'"'s range: /' "$W/c-p3-edited"
    printf '%s\n' "$CWT texts_are_escaped_and_references_written_as_given + color: None," \
      "$CWT texts_are_escaped_and_references_written_as_given + labels: None," | LC_ALL=C sort >"$W/c-p3-edited-want"
    note "control: the same reader over P3's range finds P3's one edit, the two added lines 'color: None,' and 'labels: None,' (change I62)" "$(is cmp -s "$W/c-p3-edited" "$W/c-p3-edited-want")"
    printf '%s\n' 'x.rs t gone' 'x.rs u - let a = 1;' >"$W/c-edited"
    ctl "a gone test in a list, same command form" 1 count_matches -E ' gone$' "$W/c-edited"
    ctl "edit lines in a planted list of two, same command form" 2 count_lines "$W/c-edited"
    # The test names of the whole tree: every #[test] fn in every Rust file under
    # crates/ and tools/, as a sorted list of "<file> <name>", at the base and at
    # the phase commit.
    tree_test_names() {
      local at=$1 f
      for f in $(git ls-tree -r --name-only "$at" -- crates tools | LC_ALL=C "$G" -E '[.]rs$'); do
        test_bodies "$at" "$f" | cut -f1 | sed "s#^#$f #"
