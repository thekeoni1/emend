    REC=$(by_subject 'M5 part 5 P3 record: logs, the labels, removal and open records, the check')
    DOC1=$(by_subject "M5 part 5 P4: commit planning docs (the P3 verification and rulings)")
    PROBEC=$(by_subject "M5 part 5 P4: probe-emend-charts-write-xml gains the second set")
    LOGC=$(by_subject "M5 part 5 P4: the CHANGELOG names the second set of charts write")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's full subject> <phase commit>, for each role"
    echo "  P3's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
