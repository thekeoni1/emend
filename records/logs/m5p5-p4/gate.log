    roles_ctl1() { local LOGC=$PROBEC; if roles_in_order; then return 1; else return 0; fi; }
    roles_ctl2() { local DOC1=$REC; if roles_in_order; then return 1; else return 0; fi; }
    roles_ctl3() { local PROBEC=$DOC1; if roles_in_order; then return 1; else return 0; fi; }
    roles_ctl4() { local LOGC=; if roles_in_order; then return 1; else return 0; fi; }
    roles_ctl5() { local c=$PROBEC t=$LOGC; local PROBEC=$t LOGC=$c; if roles_in_order; then return 1; else return 0; fi; }
    note_fn "control: roles_in_order refuses the probe commit named as the phase commit" roles_ctl1
    note_fn "control: roles_in_order refuses the base named as the doc commit" roles_ctl2
    note_fn "control: roles_in_order refuses the doc commit named as the probe commit" roles_ctl3
    note_fn "control: roles_in_order refuses a role that resolved to nothing" roles_ctl4
    note_fn "control: roles_in_order refuses the probe and CHANGELOG commits swapped" roles_ctl5
    # Change A62: P3's crate and tool commits, found by their subjects, named
