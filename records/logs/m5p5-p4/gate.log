    # such (changes A47 to A62; L59, kept: the probe commit carries ruling O
    # into package.rs's comment).
    CODEC=$(git log --format='%H' -n 1 --diff-filter=M "$BASE..$C" -- crates/emend/src/package.rs)
    echo "  the commit in the range that modified crates/emend/src/package.rs: ${CODEC:-none found}"
    note "the commit that modified crates/emend/src/package.rs resolved from git (change L59)" "$(is [ -n "$CODEC" ])"
    note "control: commit_class calls the commit that modified crates/emend/src/package.rs a code commit (change L59)" \
      "$(is [ "$(commit_class "$CODEC")" = code ])"
    note "control: commit_class calls P3's record commit, logs and records alone, a code commit (not a doc commit)" \
      "$(is [ "$(commit_class "$CLOSE_REC")" = code ])"
    note "control: the first doc commit carries specs/0036, a path the classifier reads as a doc" \
      "$(is [ "$(git show --name-only --format= "$DOC" | count_matches -Fx specs/0036-charts-write-second-set.md /dev/stdin)" = 1 ])"
    printf 'doc a docs\ncode b code\ndoc c docs\ncode d code\n' >"$W/c-ord-ok"
    printf 'code a code\ndoc b docs\n'                        >"$W/c-ord-first"
    printf 'doc a docs\nmixed b both\ncode c code\n'          >"$W/c-ord-mixed"
    printf 'doc a docs\nempty b nothing\ncode c code\n'       >"$W/c-ord-empty"
    printf 'doc a docs\ndoc b docs\n'                         >"$W/c-ord-nocode"
    note "control: structure_sound accepts docs and code interleaved" \
      "$(is structure_sound "$W/c-ord-ok")"
    note "control: structure_sound rejects a range that opens with a code commit" \
      "$(isnot structure_sound "$W/c-ord-first")"
    note "control: structure_sound rejects a commit mixing docs and code" \
      "$(isnot structure_sound "$W/c-ord-mixed")"
    note "control: structure_sound rejects an empty commit" \
      "$(isnot structure_sound "$W/c-ord-empty")"
    note "control: isnot reports a passing command as UNEXPECTED, so it can fail" \
      "$(is [ "$(isnot true)" = UNEXPECTED ])"
    note "control: structure_sound rejects a range with no code commit" \
      "$(isnot structure_sound "$W/c-ord-nocode")"
    # Change A37, kept (A38): every doc commit before every code commit.
    docs_first() { awk '$1 == "code" { c = 1 } $1 == "doc" && c { bad = 1 } END { exit bad }' "$1"; }
    note "no doc commit follows a code commit in the range (changes A37 to A40, A42 to A62)" "$(is docs_first "$W/classes")"
    printf 'doc a docs\ndoc b docs\ncode c code\ncode d code\n' >"$W/c-ord-first-docs"
    note "control: docs_first accepts two doc commits before two code commits" "$(is docs_first "$W/c-ord-first-docs")"
    note "control: docs_first refuses docs and code interleaved" "$(isnot docs_first "$W/c-ord-ok")"
    
    echo
    echo "## every commit message in the range: ASCII, ending with the Co-Authored-By line only"
    COAUTHOR='Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>'
    msg_form_ok() {
      local last nco nsess nna ntrail
      last=$(awk 'NF { l = $0 } END { print l }' "$1")
      nco=$(count_matches -E '^Co-Authored-By:' "$1")
      nsess=$(count_matches_i -F 'claude-session' "$1")
      nna=$(count_bytes "$NONASCII_CLASS" "$1")
      ntrail=$(git interpret-trailers --parse <"$1" | count_lines /dev/stdin)
      [ "$last" = "$COAUTHOR" ] || return 1
      [ "$nco" = 1 ] || return 1
      [ "$nsess" = 0 ] || return 1
      [ "$ntrail" = 1 ] || return 1
      [ "$nna" = 0 ]
    }
    for h in $(git rev-list --reverse "$BASE..$C"); do
      git log -1 --format=%B "$h" >"$W/msg"
      echo "  $(git log -1 --format=%h "$h"): message lines $(count_lines "$W/msg"), non-ASCII bytes $(count_bytes "$NONASCII_CLASS" "$W/msg"), trailers git parses:"
      git interpret-trailers --parse <"$W/msg" | sed 's/^/      /'
      note "$(git log -1 --format=%h "$h")'s message is ASCII and ends with the Co-Authored-By line only" \
        "$(is msg_form_ok "$W/msg")"
    done
    printf 'subject\n\nbody\n\n%s\n' "$COAUTHOR" >"$W/c-msg-ok"
    printf 'subject\n\nbody\n\n%s\n%s: x\n' "$COAUTHOR" 'Claude-Session' >"$W/c-msg-session"
    printf 'subj\303\251ct\n\n%s\n' "$COAUTHOR" >"$W/c-msg-nonascii"
    printf 'subject\n\n%s\n%s\n' "$COAUTHOR" "$COAUTHOR" >"$W/c-msg-twice"
    printf 'subject\n\nbody\n' >"$W/c-msg-none"
    note "control: msg_form_ok accepts a message ending with the line" "$(is msg_form_ok "$W/c-msg-ok")"
    note "control: msg_form_ok refuses a session line after it" "$(isnot msg_form_ok "$W/c-msg-session")"
    note "control: msg_form_ok refuses a non-ASCII byte" "$(isnot msg_form_ok "$W/c-msg-nonascii")"
    note "control: msg_form_ok refuses the line twice" "$(isnot msg_form_ok "$W/c-msg-twice")"
    note "control: msg_form_ok refuses a message without it" "$(isnot msg_form_ok "$W/c-msg-none")"
    # Change J3 (specs/0018 P2 verification ruling 5 and P3 verification ruling
    # 2, G9, carried in the scan script's form): the count rule on EVERY commit
    # of the phase. A message passes when it carries the diff-alone sentence,
    # read with its line breaks folded, or when it states no count. counts_in
    # prints the numbers left in the body (the trailer dropped) once identifiers
    # are removed: words holding a slash (paths), tokens such as P1 or M2, and the
    # number after "ruling", "decision", "part", "phase" or "section", with any
    # "to" or "and" range after it; what is left, a whole-word number in digits or
    # a number word to twenty, is a count.
    COUNT_SENTENCE='No log prints a count for this commit; the diff alone carries what it changes.'
    says_diff_alone() { tr '\n' ' ' <"$1" | tr -s ' ' | LC_ALL=C "$G" -qF "$COUNT_SENTENCE"; }
    counts_in() {
      python3 -I -B - "$1" <<'COUNTS'
    import re, sys
    text = open(sys.argv[1]).read()
    body = "\n".join(l for l in text.split("\n") if not re.match(r"^Co-Authored-By:", l))
    body = " ".join(body.split())
    body = " ".join(w for w in body.split(" ") if "/" not in w)
    body = re.sub(r"\b[A-Z][0-9]+\b", " ", body)
    num = r"(?:[0-9]+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)"
    body = re.sub(r"\b(?:rulings?|decisions?|parts?|phases?|sections?)\b[^.;:]*?\b" + num + r"\b(?:,? (?:to|and) " + num + r"\b)*", " ", body, flags=re.I)
    for m in re.finditer(r"\b" + num + r"\b", body, flags=re.I):
        print(m.group(0))
    COUNTS
    }
    states_no_count() { [ -z "$(counts_in "$1")" ]; }
    count_rule_ok() { says_diff_alone "$1" || states_no_count "$1"; }
    for h in $(git rev-list --reverse "$BASE..$C"); do
      git log -1 --format=%B "$h" >"$W/msg-rule"
      found=$(counts_in "$W/msg-rule" | tr '\n' ' ')
      sentence=$(says_diff_alone "$W/msg-rule" && echo yes || echo no)
      echo "  $(git log -1 --format=%h "$h"): counts left after the identifiers: ${found:-none}; the diff-alone sentence: $sentence"
      note "$(git log -1 --format=%h "$h")'s message states no count or says the diff alone carries its counts (change J3)" "$(is count_rule_ok "$W/msg-rule")"
    done
    printf 'subject\n\nNo log prints a count for this\ncommit; the diff alone carries what it changes.\n' >"$W/c-msg-folded"
    note "control: says_diff_alone reads the sentence across a line break" "$(is says_diff_alone "$W/c-msg-folded")"
    note "control: says_diff_alone refuses a message without it" "$(isnot says_diff_alone "$W/c-msg-ok")"
    printf 'M5 part 5 P4: x\n\nThe rulings during P1, 1 to 3, and decisions 4 to 6 A; specs/0027-x.md.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-ids"
    printf 'M5 part 5 P4: x\n\nAdds three tests and 14 lines.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-count"
    printf 'M5 part 5 P4: x\n\nAdds three tests. No log prints a count for this commit; the\ndiff alone carries what it changes.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-both"
    note "control: count_rule_ok accepts a message whose numbers are identifiers and a trailer" "$(is count_rule_ok "$W/c-rule-ids")"
    note "control: count_rule_ok refuses a message stating counts without the sentence" "$(isnot count_rule_ok "$W/c-rule-count")"
    note "control: count_rule_ok accepts the same counts beside the sentence" "$(is count_rule_ok "$W/c-rule-both")"
    ctl "counts_in finds the two counts of the refused message, same command form" 2 run_lines counts_in "$W/c-rule-count"
    
    echo
    echo "## the doc commit's files against the hashes of its blobs and against the hashes its own message gives; the lines it removes printed (header change 3; changes B33, B35, D38 to D42, D43 to D49, D50 to D58, D59 to D62 and D62)"
    # The expected values were read from the doc commit's blobs when the
    # generator ran, each checked there against FACTS.md's full hash (change
    # D62). Every computed hash is printed by the command that made it.
    echo "  the doc commit: $DOC1"
    blob_sha() { git show "$1:$2" | sha256sum | cut -d' ' -f1; }
    blob_matches() {
      git cat-file -e "$1:$2" 2>/dev/null || return 1
      [ "$(blob_sha "$1" "$2")" = "$3" ]
    }
    while read -r which path given prefix; do
      case "$which" in doc1) at=$DOC1 ;; head) at=$C ;; esac
      if git cat-file -e "$at:$path" 2>/dev/null; then got=$(blob_sha "$at" "$path"); else got=absent; fi
      echo "  $which $(git rev-parse --short "$at") $path"
      echo "    command: git show <commit>:$path | sha256sum"
      echo "    sha256 $got"
      echo "    the doc commit's blob's hash: $given (the prefix planning's brief gave: $prefix)"
      note "$which's $path is the doc commit's blob" "$(is blob_matches "$at" "$path" "$given")"
      note "the hash this check expects begins with the brief's prefix" "$(is [ "${given:0:8}" = "$prefix" ])"
    done <<'HASHES'
    doc1 specs/0036-charts-write-second-set.md 157f785d886afc27bbef2f05bdf8b43e5acb55dbcca37d76766e357efd857cb2 157f785d
    doc1 ROADMAP.md b582c49a060bc74cf1974709722b4d114f4c40ac52df7f9c92e3d46c5e15f155 b582c49a
    head specs/0036-charts-write-second-set.md 157f785d886afc27bbef2f05bdf8b43e5acb55dbcca37d76766e357efd857cb2 157f785d
    head ROADMAP.md b582c49a060bc74cf1974709722b4d114f4c40ac52df7f9c92e3d46c5e15f155 b582c49a
    HASHES
    TAB=$(printf '\t')
    git show --name-status --format= "$DOC1" | LC_ALL=C sort -k2 >"$W/doc1-files"
    printf '%s\n' "M${TAB}ROADMAP.md" "M${TAB}specs/0036-charts-write-second-set.md" | LC_ALL=C sort -k2 >"$W/doc1-want"
    sed 's/^/    the doc commit carries: /' "$W/doc1-files"
    note "the doc commit modifies specs/0036 and ROADMAP.md, nothing else (change D62)" "$(is cmp -s "$W/doc1-files" "$W/doc1-want")"
    printf '%s\n' "M${TAB}ROADMAP.md" "A${TAB}specs/0036-charts-write-second-set.md" | LC_ALL=C sort -k2 >"$W/c-doc1-status"
    note "control: the comparison refuses specs/0036 added rather than modified (P1's doc commit's form; change D62)" "$(isnot cmp -s "$W/c-doc1-status" "$W/doc1-want")"
    note "control: blob_matches refuses the doc commit's ROADMAP.md hash at the base, which holds P3's copy (deab2d2f; change D62)" \
      "$(isnot blob_matches "$BASE" ROADMAP.md b582c49a060bc74cf1974709722b4d114f4c40ac52df7f9c92e3d46c5e15f155)"
    note "control: blob_matches refuses the doc commit's specs/0036 hash at the base, which holds P3's copy (4f9bc8ff; change D62)" \
      "$(isnot blob_matches "$BASE" specs/0036-charts-write-second-set.md 157f785d886afc27bbef2f05bdf8b43e5acb55dbcca37d76766e357efd857cb2)"
    note "control: blob_matches accepts P3's specs/0036 hash at the base, so the check can pass there (change D62)" \
      "$(is blob_matches "$BASE" specs/0036-charts-write-second-set.md 4f9bc8ff910151e01247dab6804d0038a99a2c0089e15bca7de49fa2fba50277)"
    note "control: blob_matches accepts P3's ROADMAP.md hash at the base (change D62)" \
      "$(is blob_matches "$BASE" ROADMAP.md deab2d2f718d2f838898bcc83a2a41178a3a2524714955533a3afdd75fa68a3f)"
    # Change R59, kept (D60 to D62; planning's ruling C, specs/0036 "Planning rulings
    # during P1"): the doc commit's own message is read with its line breaks
    # folded, as change J3's says_diff_alone reads it, and for each of the two
    # files the first "sha256 <hash>" after the file's path is taken, whatever
    # words lie between (4ef3a8c gives the one-line "<path> sha256 <hash>"
    # form, b60d4f5 a bullet form); the pairs are then compared as a set with
    # the two blobs' pairs built the same way.
    git log -1 --format=%B "$DOC1" >"$W/doc1-msg"
    DOC1_PATHS="specs/0036-charts-write-second-set.md ROADMAP.md"
    # msg_hash_pairs <message file> <path>...: "<path> sha256 <hash>" for each
    # path the folded message names with a hash after it.
    msg_hash_pairs() {
      local f=$1
      shift
      tr '\n' ' ' <"$f" | tr -s ' ' | python3 -I -B -c '
    import re, sys
    text = sys.stdin.read()
    for path in sys.argv[1:]:
        m = re.search(r"(?:^|[\s(])" + re.escape(path) + r"(?=[\s,;:)]|$)", text)
        if not m:
            continue
        h = re.search(r"\bsha256 ([0-9a-f]{64})\b", text[m.end():])
        if h:
            print("%s sha256 %s" % (path, h.group(1)))
    ' "$@" | LC_ALL=C sort -u || :
    }
    msg_hash_pairs "$W/doc1-msg" $DOC1_PATHS >"$W/doc1-msg-hashes"
    for path in $DOC1_PATHS; do
      printf '%s sha256 %s\n' "$path" "$(blob_sha "$DOC1" "$path")"
    done | LC_ALL=C sort -u >"$W/doc1-blob-hashes"
    echo "command: git log -1 --format=%B <doc commit>, line breaks folded, for each of the two paths the first 'sha256 <hash>' after it read; and, for the two files, the path, sha256 and git show <doc commit>:<path> | sha256sum (changes R59 and D62; ruling C)"
    sed 's/^/    the doc commit'"'"'s message holds: /' "$W/doc1-msg-hashes"
    sed 's/^/    the doc commit'"'"'s blobs hash: /' "$W/doc1-blob-hashes"
    note "the doc commit's message gives exactly its two blobs' hashes, in full, read folded (changes R59 and D62; ruling C)" "$(is cmp -s "$W/doc1-msg-hashes" "$W/doc1-blob-hashes")"
    # Change R59's controls, kept (D60 to D62): a planted message in b60d4f5's form (a
    # bullet per file, a parenthesis after the path, the hash on the next line)
    # is accepted; the same message with its last hash's last digit changed is
    # refused.
    while read -r path rest; do
      printf -- '- %s (planted words, more of them),\n  sha256\n  %s\n' "$path" "${rest#sha256 }"
    done <"$W/doc1-blob-hashes" >"$W/c-doc1-folded"
    msg_hash_pairs "$W/c-doc1-folded" $DOC1_PATHS >"$W/c-doc1-folded-hashes"
    note "control: the folded reading accepts a planted message in the doc commit's bullet form, a parenthesis and line breaks between each path and its hash (changes R59 and D62; ruling C)" "$(is cmp -s "$W/c-doc1-folded-hashes" "$W/doc1-blob-hashes")"
    ctl "the pairs in the planted bullet-form message of two, same command form" 2 run_lines msg_hash_pairs "$W/c-doc1-folded" $DOC1_PATHS
    sed '$ s/.$/0/' "$W/c-doc1-folded" >"$W/c-doc1-wrong"
    if cmp -s "$W/c-doc1-wrong" "$W/c-doc1-folded"; then sed '$ s/.$/1/' "$W/c-doc1-folded" >"$W/c-doc1-wrong"; fi
    msg_hash_pairs "$W/c-doc1-wrong" $DOC1_PATHS >"$W/c-doc1-wrong-hashes"
    note "control: the same check refuses the planted message with its last hash differing in its last digit (changes R59 and D62; ruling C)" "$(isnot cmp -s "$W/c-doc1-wrong-hashes" "$W/doc1-blob-hashes")"
    sed '$d' "$W/doc1-want" >"$W/c-doc-short"
    note "control: the file comparison refuses a list one file short" "$(isnot cmp -s "$W/c-doc-short" "$W/doc1-want")"
    # Change D62 (P1's D47, kept): the lines the doc commit removes are
    # planning's text and are printed.
    removed_count() { LC_ALL=C "$G" -E '^-' "$1" | LC_ALL=C "$G" -vcE '^--- ' || :; }
    for path in specs/0036-charts-write-second-set.md ROADMAP.md; do
      git show -U0 --format= "$DOC1" -- "$path" >"$W/doc1-diff"
      echo "command: git show -U0 --format= <doc commit> -- $path, the lines removed (a leading -, not the --- file line)"
      echo "  $path: lines removed $(removed_count "$W/doc1-diff")"
      git show -U0 --format= "$DOC1" -- "$path" | LC_ALL=C "$G" -E '^-' | LC_ALL=C "$G" -vE '^--- ' | sed 's#^#    '"$path"' removes (planning'"'"'s): #' || :
    done
    printf -- '--- a/x\n+++ b/x\n@@ -1,2 +1,1 @@\n-gone line\n' >"$W/c-removed"
    ctl "removed lines in a planted diff of one removal, same command form" 1 removed_count "$W/c-removed"
    
    echo
    echo "## each commit's diff and the phase's combined diff, hashed with the command that produced each"
    for h in $(git rev-list --reverse "$BASE..$C"); do
      cmd="git show --no-color --no-ext-diff --format= $h"
      echo "  command: $cmd | sha256sum"
      echo "    $($cmd | sha256sum | cut -d' ' -f1)  $(git log -1 --format=%s "$h")"
    done
    cmd="git diff --no-color --no-ext-diff $BASE $C"
    echo "  command: $cmd | sha256sum"
    echo "    $($cmd | sha256sum | cut -d' ' -f1)  the phase's combined diff"
    h1=$(git show --no-color --no-ext-diff --format= "$C" | sha256sum | cut -d' ' -f1)
    h2=$(git show --no-color --no-ext-diff --format= "$C" | sha256sum | cut -d' ' -f1)
    h3=$(git show --no-color --no-ext-diff --format= "$C^" | sha256sum | cut -d' ' -f1)
    note "control: the phase commit's diff hashes the same twice" "$(is [ "$h1" = "$h2" ])"
    note "control: its parent's diff hashes differently" "$(isnot [ "$h1" = "$h3" ])"
    
    echo
    echo "## the changed files at the phase commit"
    for f in $(git diff --name-only --diff-filter=d "$BASE" "$C"); do
      git show "$C:$f" >"$W/f" 2>/dev/null || { echo "$f: READ ERROR"; fail=1; continue; }
      echo "$f: sha256 $(sha256sum <"$W/f" | cut -d' ' -f1), bytes $(wc -c <"$W/f"), mode $(git ls-tree "$C" -- "$f" | awk '{print $1}')"
    done
    git diff --name-only --diff-filter=d "$BASE" "$C" >"$W/difffiles"
    echo "  files in the diff: $(count_lines "$W/difffiles")"
    new_mode() { [ "$(git ls-tree "$C" -- "$1" | awk '{print $1}')" = 100755 ]; }
    # Change G37, kept (G38): a modified file keeps its base mode, and an added
    # file is not executable.
    mode_at() { git ls-tree "$1" -- "$2" | awk '{print $1}'; }
    mode_kept() { [ -n "$(mode_at "$BASE" "$1")" ] && [ "$(mode_at "$BASE" "$1")" = "$(mode_at "$C" "$1")" ]; }
    git diff --name-only --diff-filter=A "$BASE" "$C" >"$W/mode-added"
    git diff --name-only --diff-filter=M "$BASE" "$C" >"$W/mode-modified"
    while IFS= read -r m; do
      echo "  $m (modified): mode at the base $(mode_at "$BASE" "$m"); at the phase commit $(mode_at "$C" "$m")"
      note "$m keeps its base mode (change G37)" "$(is mode_kept "$m")"
    done <"$W/mode-modified"
    while IFS= read -r m; do
      echo "  $m (added): mode at the phase commit $(mode_at "$C" "$m")"
      note "$m, added in this phase, is not executable" "$(isnot new_mode "$m")"
    done <"$W/mode-added"
    note "control: the same mode check finds the runner executable" "$(is new_mode scripts/passthrough-run.sh)"
    note "control: the same mode check refuses the spec (M3 part 1 P2's change C19, carried)" "$(isnot new_mode specs/0030-carries-and-api-changes.md)"
    mode_kept_ctl() { mode_kept no/such/path/in/either/commit; }
    note "control: mode_kept refuses a path neither commit holds (changes G38 to G40, G42 to G53, kept)" "$(isnot mode_kept_ctl)"
    
    echo
    echo "## the gate files this phase changed, and the self-test they require: none, so no self-test (P1's change F50 reverted to P3's form; change F51)"
    # specs/0001-bootstrap.md, "Rules for every phase": a phase that changes no
    # gate file LISTS IN gate.log the gate files it checked against the diff.
    cat >"$W/gate-files" <<'EOF'
    scripts/check.sh
    scripts/privacy.sh
    scripts/privacy-patterns.txt
    scripts/privacy-identity.txt
    scripts/sys-allowlist.txt
    scripts/install-hooks.sh
    scripts/counting.sh
    scripts/gate-self-test.sh
    .gitignore
    .github/workflows/ci.yml
    EOF
    echo "command: awk over specs/0001-bootstrap.md, the bullet opening '- A phase that changes a gate file' up to its first 'runs', backticked names"
    git show "$C:specs/0001-bootstrap.md" | awk '/^- A phase that changes a gate file/ { on = 1 } on { print } on && /runs/ { exit }' >"$W/gate-sentence"
    sed 's/^/    /' "$W/gate-sentence"
    tr -d '\n' <"$W/gate-sentence" | LC_ALL=C "$G" -o -E '`[^`]+`' | tr -d '`' | LC_ALL=C "$G" -v -E ' ' | sort >"$W/gate-from-spec"
    LC_ALL=C "$G" -v -Fx .github/workflows/ci.yml "$W/gate-files" | sort >"$W/gate-typed"
    sed 's/^/    named in specs\/0001: /' "$W/gate-from-spec"
    ci_named() { [ "$(count_matches -F 'the CI workflow' "$W/gate-sentence")" = 1 ]; }
    note "the typed gate-file list is specs/0001's backticked names plus the CI workflow" "$(is cmp -s "$W/gate-from-spec" "$W/gate-typed")"
    note "specs/0001's sentence names the CI workflow" "$(is ci_named)"
    LC_ALL=C "$G" -v -Fx scripts/counting.sh "$W/gate-typed" >"$W/c-gate-typed"
    note "control: the comparison refuses the typed list one name short" "$(isnot cmp -s "$W/gate-from-spec" "$W/c-gate-typed")"
    echo "  the gate files specs/0001 names, each checked against the phase diff:"
    sed 's/^/    checked: /' "$W/gate-files"
    touched=0
    while IFS= read -r g; do
      if LC_ALL=C "$G" -Fxq -- "$g" "$W/difffiles"; then
        echo "  gate file in the diff: $g"
        touched=$((touched + 1))
      fi
    done <"$W/gate-files"
    echo "  gate files checked: $(count_lines "$W/gate-files"); of them in the phase diff: $touched"
    note "no gate file is in the phase diff, so specs/0001 asks for this listing and no self-test (changes F38, F40 and F51)" \
      "$(is [ "$touched" = 0 ])"
    # Change F51: the same search over P1's scripts commit, which changed the
    # gate file scripts/check.sh, finds it: the control that the search can
    # find a gate file.
    P1_SCR=$(git log --format='%H' -n 1 -F --grep='M5 part 2 P1: committed scripts call python3 with -I -B' "$C")
    echo "  P1's scripts commit, by subject: ${P1_SCR:-none found}"
    git show --name-only --format= "$P1_SCR" >"$W/c-p1-scr-files"
    p1_touched=0
    while IFS= read -r g; do
      if LC_ALL=C "$G" -Fxq -- "$g" "$W/c-p1-scr-files"; then
        echo "    gate file in P1's scripts commit: $g"
        p1_touched=$((p1_touched + 1))
      fi
    done <"$W/gate-files"
    note "control: the same search over P1's scripts commit finds its one gate file, scripts/check.sh (change F51)" \
      "$(is [ "$p1_touched" = 1 ])"
    FIRST_DIFF=$(sed -n '1p' "$W/difffiles")
    echo "  a file that IS in the phase diff, taken from the diff: $FIRST_DIFF"
    found_first=$(count_matches -Fx "$FIRST_DIFF" "$W/difffiles")
    note "control: the same search finds a name the diff does hold" \
      "$(is [ "$found_first" -ge 1 ])"
    in_diff_not_gate() {
      [ "$(count_matches -Fx "$1" "$W/difffiles")" = 1 ] &&
        [ "$(count_matches -Fx "$1" "$W/gate-files")" = 0 ]
    }
    # Every file the phase diff holds, read from the diff rather than typed.
    while IFS= read -r s; do
      echo "  $s: in the phase diff $(count_matches -Fx "$s" "$W/difffiles") times; in the gate-file list $(count_matches -Fx "$s" "$W/gate-files") times"
      note "$s is in the diff and is not a gate file" "$(is in_diff_not_gate "$s")"
    done <"$W/difffiles"
    gate_ctl() { in_diff_not_gate scripts/counting.sh; }
    note "control: in_diff_not_gate refuses a gate file the phase diff does not hold (scripts/counting.sh)" "$(isnot gate_ctl)"
    ST=records/logs/m5p5-p4/self-test.log
    echo "  $ST: $([ -e "$ST" ] && echo PRESENT || echo "absent, as a phase with no gate-file change requires")"
    note "this phase committed no self-test log, having changed no gate file (changes F38, F40 to F46, F47 to F49, F51; kept)" \
      "$(is [ ! -e "$ST" ])"
    
    echo
    echo "## each code commit touches its own files, with the status git gives each; the tree at the phase commit the base's outside the phase's files; no manifest and no lock, the feature charts still off by default, and nothing under scripts/; package.rs's module comment alone and chart_write.rs's doc comments alone; the CHANGELOG gaining its one bullet alone; README.md not in the range; the crate's messages the base's (change E62; changes E53 to E61 and D35's form)"
    TAB=$(printf '\t')
    printf '%s\n' "M${TAB}crates/emend/src/package.rs" "M${TAB}crates/emend/src/package/chart_write.rs" \
      "M${TAB}crates/emend/src/package/tests/chart_write.rs" \
      "M${TAB}tools/size-probe/src/bin/probe-emend-charts-write-xml.rs" | LC_ALL=C sort -k2 >"$W/area-want-PROBEC"
    printf '%s\n' "M${TAB}CHANGELOG.md" >"$W/area-want-LOGC"
    for pair in PROBEC:probe LOGC:CHANGELOG; do
      role=${pair%%:*}; label=${pair#*:}
      at=${!role}
      echo "command: git show --name-status --format= <the $label commit> | sort -k2"
      git show --name-status --format= "$at" | LC_ALL=C sort -k2 >"$W/area-$role"
      sed 's/^/    /' "$W/area-$role"
      note "the $label commit's files are the ones FACTS.md gives, with the status git gives each (change E62)" "$(is cmp -s "$W/area-$role" "$W/area-want-$role")"
    done
    note "control: the comparison refuses the CHANGELOG commit's files given as the probe commit's" "$(isnot cmp -s "$W/area-LOGC" "$W/area-want-PROBEC")"
    note "control: the comparison refuses the probe commit's files given as the CHANGELOG commit's" "$(isnot cmp -s "$W/area-PROBEC" "$W/area-want-LOGC")"
    sed "s#^M${TAB}tools/size-probe/src/bin/probe-emend-charts-write-xml.rs\$#A${TAB}tools/size-probe/src/bin/probe-emend-charts-write-xml.rs#" "$W/area-want-PROBEC" >"$W/c-area"
    note "control: the planted list differs from the expectation (the probe source added rather than modified)" "$(isnot cmp -s "$W/c-area" "$W/area-want-PROBEC")"
    note "control: the comparison refuses the probe source added rather than modified" "$(isnot cmp -s "$W/c-area" "$W/area-PROBEC")"
    # same_outside <a> <b> <path>...: git diff --quiet between the two commits
    # over every path but the ones given.
    PHASE_FILES="specs/0036-charts-write-second-set.md ROADMAP.md $(cut -f2 "$W/area-want-PROBEC" "$W/area-want-LOGC" | LC_ALL=C sort -u | tr '\n' ' ')"
    same_outside() {
      local a=$1 b=$2 p
      shift 2
      local spec=(.)
      for p in "$@"; do spec+=(":!$p"); done
      git diff --quiet "$a" "$b" -- "${spec[@]}"
    }
    echo "command: git diff --stat <base> <phase commit> -- . ':!<each of the phase's files>'"
    echo "  the phase's files: $PHASE_FILES"
    same_spec=(.)
    for p in $PHASE_FILES; do same_spec+=(":!$p"); done
    git diff --stat "$BASE" "$C" -- "${same_spec[@]}" | sed 's/^/    /'
    note "the tree at the phase commit is the base's outside the phase's files (change E62)" "$(is same_outside "$BASE" "$C" $PHASE_FILES)"
    same_ctl() { same_outside "$BASE" "$C" $(printf '%s\n' $PHASE_FILES | LC_ALL=C "$G" -vFx CHANGELOG.md); }
    note "control: the same check refuses the exclusions with CHANGELOG.md left out" "$(isnot same_ctl)"
    # Change E62: no manifest and no lock in the phase diff; the crate manifest
    # at the phase commit still declares charts with no dependency and no
    # default feature (part 3 P1's E53, read again).
    nlock=$(count_matches -Fx Cargo.lock "$W/difffiles")
    LC_ALL=C "$G" -E '(^|/)Cargo[.]toml$' "$W/difffiles" | LC_ALL=C sort >"$W/manifests" || :
    nmanifest=$(count_lines "$W/manifests")
    echo "  Cargo.lock in the phase diff: $nlock; manifests in the phase diff: $nmanifest"
    sed 's/^/    manifest in the phase diff: /' "$W/manifests"
    note "the phase changes no Cargo.lock (change E62)" "$(is [ "$nlock" = 0 ])"
    note "the phase changes no manifest, the probe crate's among them (change E62)" "$(is [ "$nmanifest" = 0 ])"
    manifests_in() { git show --name-only --format= "$1" | count_matches -E '(^|/)Cargo[.]toml$' /dev/stdin; }
    echo "  manifests touched: by the doc commit $(manifests_in "$DOC1"), by the probe commit $(manifests_in "$PROBEC"), by the CHANGELOG commit $(manifests_in "$LOGC")"
    P31_MAN_C=$(git log --format='%H' -n 1 -F --grep='M5 part 3 P1: charts read, the anchors, the plots and series' "$C")
    echo "  part 3 P1's crate commit, by subject: ${P31_MAN_C:-none found}; manifests it touched: $(manifests_in "$P31_MAN_C")"
    note "control: the same count reads 1 over part 3 P1's crate commit, which added the feature" "$(is [ "$(manifests_in "$P31_MAN_C")" = 1 ])"
    printf 'Cargo.lock\ntools/xlsx-diff/Cargo.toml\n' >"$W/c-lock"
    ctl "a lock file in a list, same command form" 1 count_matches -Fx Cargo.lock "$W/c-lock"
    ctl "a manifest in a list, same command form" 1 count_matches -E '(^|/)Cargo[.]toml$' "$W/c-lock"
    git show "$C:crates/emend/Cargo.toml" >"$W/crate-manifest"
    ncharts=$(count_matches -Fx 'charts = []' "$W/crate-manifest")
    ndefault=$(count_matches -E '^[[:space:]]*default[[:space:]]*=' "$W/crate-manifest")
    echo "  in the crate manifest at the phase commit: 'charts = []' lines $ncharts; default-feature lines $ndefault"
    note "the crate manifest declares charts with no dependency (change E53, kept)" "$(is [ "$ncharts" = 1 ])"
    note "the crate manifest declares no default feature, so charts is off by default (change E53, kept)" "$(is [ "$ndefault" = 0 ])"
    printf '[features]\ndefault = ["charts"]\ncharts = []\n' >"$W/c-default"
    ctl "a default-feature line in a manifest, same command form" 1 count_matches -E '^[[:space:]]*default[[:space:]]*=' "$W/c-default"
    scripts_in_range() { git diff --name-only "$1" "$2" -- 'scripts/*' | count_lines /dev/stdin; }
    echo "command: git diff --name-only <base> <phase commit> -- 'scripts/*'"
    git diff --name-only "$BASE" "$C" -- 'scripts/*' | sed 's/^/    /'
    nscr=$(scripts_in_range "$BASE" "$C")
    echo "  files under scripts/ changed in the range: $nscr"
    note "the range changes nothing under scripts/ (change E62)" "$(is [ "$nscr" = 0 ])"
    P1_SCRIPTS_A=$(git log --format='%H' -n 1 -F --grep='M5 part 2 P1: committed scripts call python3 with -I -B' "$C")
    echo "  M5 part 2 P1's scripts commit, by subject: ${P1_SCRIPTS_A:-none found}"
    scr_ctl() { [ -n "$P1_SCRIPTS_A" ] && [ "$(scripts_in_range "$P1_SCRIPTS_A^" "$P1_SCRIPTS_A")" = 3 ]; }
    note "control: the same count reads 3 over M5 part 2 P1's scripts commit" "$(is scr_ctl)"
    changed_lines() {
      git diff -U0 "$1" "$2" -- "$3" | LC_ALL=C "$G" -E '^[-+]' | LC_ALL=C "$G" -vE '^(\+\+\+|---) ' || :
    }
    # package.rs (change E62; planning's ruling O (a)): the probe commit changes
    # the module comment alone, every line it adds or removes beginning //!
    # (the Limits bullet "Texts and references" and the catalogue's entry for
    # "no chart at that position" naming the new test); no other commit of the
    # range touches it.
    PKG_FILE=crates/emend/src/package.rs
    changed_lines "$BASE" "$C" "$PKG_FILE" >"$W/pkg-lines"
    npkg=$(count_lines "$W/pkg-lines")
    npkg_doc=$(count_matches -E '^[-+]//!' "$W/pkg-lines")
    echo "command: git diff -U0 <base> <phase commit> -- $PKG_FILE: lines added or removed $npkg; of them beginning //! $npkg_doc"
    sed 's/^/    /' "$W/pkg-lines"
    pkg_doc_only() { [ "$npkg" -ge 1 ] && [ "$npkg" = "$npkg_doc" ]; }
    note "the range changes package.rs's module comment alone, some lines, each beginning //! (change E62; ruling O (a))" "$(is pkg_doc_only)"
    printf '%s\n' '+//! a comment line' '+pub fn planted() {}' >"$W/c-pkg-doc"
    ctl "lines beginning //! in a planted change of two, same command form" 1 count_matches -E '^[-+]//!' "$W/c-pkg-doc"
    pkg_limits() { [ "$(count_matches -F '+//!   format or a label format) is a text too, at most 32767 bytes, written' "$W/pkg-lines")" = 1 ] &&
      [ "$(count_matches -F '+//!   upper-case hex digits (P3 ruling O). No cache is written for any' "$W/pkg-lines")" = 1 ]; }
    note "the added lines name a format code and a label format among the texts and the colour's form (change E62; ruling O (a))" "$(is pkg_limits)"
    pkg_commits() { git log --format='%H' "$BASE..$C" -- "$PKG_FILE" | count_lines /dev/stdin; }
    pkg_by_probe() { [ "$(pkg_commits)" = 1 ] && [ "$(git log --format='%H' -n 1 "$BASE..$C" -- "$PKG_FILE")" = "$PROBEC" ]; }
    note "one commit of the range touches package.rs, the probe commit (change E62)" "$(is pkg_by_probe)"
    pkg_ctl() { local PROBEC=$LOGC; pkg_by_probe; }
    note "control: the same check refuses the CHANGELOG commit named as the one" "$(isnot pkg_ctl)"
    # chart_write.rs (change E62; planning's ruling O (c)): its doc comments
    # alone, every line added or removed beginning /// after its indent (the
    # 3D pie named among the kinds the two axis formats refuse).
    CW_SRC=crates/emend/src/package/chart_write.rs
    changed_lines "$BASE" "$C" "$CW_SRC" >"$W/cw-src-lines"
    ncws=$(count_lines "$W/cw-src-lines")
    ncws_doc=$(count_matches -E '^[-+][[:space:]]*///' "$W/cw-src-lines")
    echo "command: git diff -U0 <base> <phase commit> -- $CW_SRC: lines added or removed $ncws; of them beginning /// after the indent $ncws_doc"
    sed 's/^/    /' "$W/cw-src-lines"
    cw_doc_only() { [ "$ncws" -ge 1 ] && [ "$ncws" = "$ncws_doc" ]; }
    note "the range changes chart_write.rs's doc comments alone, some lines, each beginning /// (change E62; ruling O (c))" "$(is cw_doc_only)"
    cw_pie3d() { [ "$(count_matches -F '3D pie' "$W/cw-src-lines")" = 2 ]; }
    note "two added lines name the 3D pie, one on each axis format (change E62; ruling O (c))" "$(is cw_pie3d)"
    printf '%s\n' '+    /// a doc line' '+    pub fn planted() {}' >"$W/c-cw-doc"
    ctl "lines beginning /// in a planted change of two, same command form" 1 count_matches -E '^[-+][[:space:]]*///' "$W/c-cw-doc"
    # CHANGELOG.md: the CHANGELOG commit gives "Added" its one bullet and
    # nothing else, citing specs/0036, and no other commit of the range touches
    # it (specs/0036 "P4"; change E62). The lines were read from the CHANGELOG
    # commit's diff when the generator ran.
    CHANGELOG_FILE=CHANGELOG.md
    changed_lines "$BASE" "$C" "$CHANGELOG_FILE" >"$W/changelog-lines"
    echo "command: git diff -U0 <base> <phase commit> -- $CHANGELOG_FILE, the lines added or removed"
    sed 's/^/    /' "$W/changelog-lines"
    cat >"$W/changelog-want" <<'CHANGELOGLINES'
    +- Charts write, the second set, with the feature `charts`: doughnut, radar,
    +  bubble and stock charts, the 3D bar, line, pie and area charts, combined
    +  charts with a second plot on a secondary axis, series colours, data labels
    +  and axis number formats, and a chart removed from a sheet with the parts only
    +  it reaches (`specs/0036-charts-write-second-set.md`).
    CHANGELOGLINES
    echo "  lines added or removed: $(count_lines "$W/changelog-lines"); the lines FACTS.md's bullet gives: $(count_lines "$W/changelog-want")"
    note "the range gives CHANGELOG.md exactly its one bullet's lines, none removed (change E62)" "$(is cmp -s "$W/changelog-lines" "$W/changelog-want")"
    note "the bullet cites specs/0036 (change E62)" "$(is [ "$(count_matches -F 'specs/0036-charts-write-second-set.md' "$W/changelog-lines")" = 1 ])"
    sed '1d' "$W/changelog-want" >"$W/c-changelog"
    note "control: the comparison refuses the lines one short" "$(isnot cmp -s "$W/c-changelog" "$W/changelog-want")"
    changelog_commits() { git log --format='%H' "$BASE..$C" -- "$CHANGELOG_FILE" | count_lines /dev/stdin; }
    changelog_by_log() { [ "$(changelog_commits)" = 1 ] && [ "$(git log --format='%H' -n 1 "$BASE..$C" -- "$CHANGELOG_FILE")" = "$LOGC" ]; }
    note "one commit of the range touches CHANGELOG.md, the CHANGELOG commit (change E62)" "$(is changelog_by_log)"
    changelog_ctl() { local LOGC=$PROBEC; changelog_by_log; }
    note "control: the same check refuses the probe commit named as the one" "$(isnot changelog_ctl)"
    P43_LOG_C=$(git log --format='%H' -n 1 -F --grep="M5 part 4 P3: the CHANGELOG names charts write" "$C")
    echo "  part 4 P3's CHANGELOG commit, by subject: ${P43_LOG_C:-none found}"
    changed_lines "$P43_LOG_C^" "$P43_LOG_C" "$CHANGELOG_FILE" >"$W/c-changelog-p43"
    note "control: the same comparison refuses part 4 P3's CHANGELOG bullet's lines" "$(isnot cmp -s "$W/c-changelog-p43" "$W/changelog-want")"
    p43_read() { [ "$(count_lines "$W/c-changelog-p43")" -ge 1 ]; }
    note "control: part 4 P3's CHANGELOG bullet's lines were read, some" "$(is p43_read)"
    # README.md is not in the range (P1's form, change E42).
    not_in_range() { [ "$(git diff --name-only "$1" "$2" -- "$3" | count_lines /dev/stdin)" = 0 ]; }
    for f in README.md; do
      echo "command: git diff --name-only <base> <phase commit> -- $f"
      git diff --name-only "$BASE" "$C" -- "$f" | sed 's/^/    /'
      note "$f is not in the range's diff (change E62)" "$(is not_in_range "$BASE" "$C" "$f")"
    done
    README_C=$(git log --format='%H' -n 1 -F --grep="M3 part 7 P5: the README's two sentences")
    echo "  M3 part 7 P5's README commit, by subject: ${README_C:-none found}"
    readme_ctl() { [ -n "$README_C" ] && not_in_range "$README_C^" "$README_C" README.md; }
    note "control: the same check refuses M3 part 7 P5's README commit, which changed it" "$(isnot readme_ctl)"
    # The crate's messages: every Error::Package("...") string under
    # crates/emend/src, as a set: at the phase commit the base's, none added
    # and none gone (the carry adds no message; change E62).
    messages_set() { git grep -h -o -E 'Error::Package[(]"[^"]*"[)]' "$1" -- crates/emend/src | LC_ALL=C sort -u; }
    messages_set "$BASE" >"$W/msgs-base"
    messages_set "$C" >"$W/msgs-head"
    echo "command: git grep -h -o -E 'Error::Package[(]\"[^\"]*\"[)]' <commit> -- crates/emend/src | sort -u, at the base and at the phase commit"
    echo "  distinct messages at the base: $(count_lines "$W/msgs-base"); at the phase commit: $(count_lines "$W/msgs-head")"
    LC_ALL=C comm -13 "$W/msgs-base" "$W/msgs-head" | sed 's/^/    new at the phase commit: /'
    LC_ALL=C comm -23 "$W/msgs-base" "$W/msgs-head" | sed 's/^/    gone at the phase commit: /'
    note "the crate's Error::Package messages are the base's, none added and none gone, as a set (changes E40 and E62)" "$(is cmp -s "$W/msgs-head" "$W/msgs-base")"
    note "some messages were read" "$(is [ "$(count_lines "$W/msgs-head")" -ge 1 ])"
    removal_msgs() { [ "$(count_matches -Fx 'Error::Package("no chart at that position")' "$W/msgs-head")" = 1 ] &&
      [ "$(count_matches -Fx 'Error::Package("a chart part cannot be read")' "$W/msgs-head")" = 1 ]; }
    note "the chart removal's two messages are among them (changes E61 and E62)" "$(is removal_msgs)"
    note "the chart reader's message is still among them (change E55, kept)" "$(is [ "$(count_matches -Fx 'Error::Package("a chart cannot be read")' "$W/msgs-head")" = 1 ])"
    { cat "$W/msgs-base"; printf '%s\n' 'Error::Package("a planted message")'; } | LC_ALL=C sort -u >"$W/c-msgs-extra"
    note "control: the comparison refuses the base's set with a message added" "$(isnot cmp -s "$W/msgs-head" "$W/c-msgs-extra")"
    sed '1d' "$W/msgs-head" >"$W/c-msgs"
    note "control: the comparison refuses the set one message short" "$(isnot cmp -s "$W/msgs-base" "$W/c-msgs")"
    
    echo
    echo "## every script under scripts/ parses or compiles at the phase commit (changes H37 to H40, H42 to H50)"
    parse_ok() { bash -n "$1" 2>/dev/null; }
    echo "command: git ls-tree --name-only <phase commit> scripts/, each .sh through bash -n and each .py through py_compile (doraise)"
    git ls-tree --name-only "$C" scripts/ >"$W/scripts-all"
    nsh=0; npyall=0
    while IFS= read -r s; do
      case "$s" in
        *.sh)
          git show "$C:$s" >"$W/parse.sh"
          note "$s parses at the phase commit" "$(is parse_ok "$W/parse.sh")"
          nsh=$((nsh + 1)) ;;
      esac
    done <"$W/scripts-all"
    printf 'if then\n' >"$W/c-parse.sh"
    note "control: the same parse refuses a broken if" "$(isnot parse_ok "$W/c-parse.sh")"
    echo "command: python3 -I -B --version"
    python3 -I -B --version 2>&1 | sed 's/^/    /'
    py_compiles() { python3 -I -B -c 'import py_compile, sys; py_compile.compile(sys.argv[1], cfile=sys.argv[2], doraise=True)' "$1" "$W/compiled.pyc" 2>/dev/null; }
    while IFS= read -r s; do
      case "$s" in
        *.py)
          git show "$C:$s" >"$W/compiled.py"
          note "$s compiles at the phase commit (py_compile, doraise)" "$(is py_compiles "$W/compiled.py")"
          npyall=$((npyall + 1)) ;;
      esac
    done <"$W/scripts-all"
    echo "  shell scripts parsed: $nsh; Python scripts compiled: $npyall"
    both_read() { [ "$nsh" -ge 1 ] && [ "$npyall" -ge 1 ]; }
    note "some shell scripts and some Python scripts were read" "$(is both_read)"
    printf 'def f(:\n    pass\n' >"$W/c-broken.py"
    note "control: the same compile refuses a broken def" "$(isnot py_compiles "$W/c-broken.py")"
    LC_ALL=C "$G" -E '[.]py$' "$W/difffiles" >"$W/py-in-diff" || :
    : >"$W/py-in-diff-want"
    echo "  Python scripts in the phase diff: $(count_lines "$W/py-in-diff")"
    sed 's/^/    /' "$W/py-in-diff"
    note "no Python script is in the phase diff (changes H43 to H50)" "$(is cmp -s "$W/py-in-diff" "$W/py-in-diff-want")"
    printf 'scripts/scale-gen.py\n' >"$W/c-py-one"
    note "control: the comparison refuses a list of one" "$(isnot cmp -s "$W/c-py-one" "$W/py-in-diff-want")"
    printf 'scripts/scale-gen.py\ncrates/emend/src/package.rs\n' >"$W/c-py"
    ctl "one Python script in a list of two, same command form" 1 count_matches -E '[.]py$' "$W/c-py"
    
    echo
    echo "## no committed script under scripts/ calls Python without -B, at the phase commit (changes H50 and H51; specs/0032 \"Planning verification and rulings on P3\", ruling 4)"
    # scripts_py <commit> <prefix>: every file under scripts/ at the commit,
    # its calls listed into <prefix>.calls as "<path>:<line> <I> <B>".
    scripts_py() {
      local at=$1 out=$2 f
      : >"$out.calls"
      nscanned=0
      for f in $(git ls-tree -r --name-only "$at" -- scripts); do
        git show "$at:$f" >"$W/pyb-file"
        py_calls "$W/pyb-file" | sed "s#^#$f:#" >>"$out.calls"
        nscanned=$((nscanned + 1))
      done
    }
    no_b() { awk '$3 == 0' "$1" | count_lines /dev/stdin; }
    echo "command: git ls-tree -r --name-only <phase commit> -- scripts; each file read with git show and its Python calls listed by the rule above"
    scripts_py "$C" "$W/pyb-head"
    ncalls=$(count_lines "$W/pyb-head.calls")
    nnob=$(no_b "$W/pyb-head.calls")
    echo "  files scanned: $nscanned; Python calls: $ncalls; calls without -B: $nnob"
    echo "  the calls, each <path>:<line> <-I given> <-B given>:"
    sed 's/^/    /' "$W/pyb-head.calls"
    note "some files were scanned" "$(is [ "$nscanned" -ge 1 ])"
    note "no committed script under scripts/ calls Python without -B at the phase commit (change H50)" "$(is [ "$nnob" = 0 ])"
    awk '{ split($1, a, ":"); print a[1] }' "$W/pyb-head.calls" | LC_ALL=C sort | uniq -c | awk '{ print $2, $1 }' >"$W/pyb-per-file"
    printf '%s\n' 'scripts/check.sh 1' 'scripts/edit-open-check.sh 2' 'scripts/lo-check.sh 1' >"$W/pyb-per-file-want"
    echo "  calls per file:"; sed 's/^/    /' "$W/pyb-per-file"
    note "the calls are check.sh's one, edit-open-check.sh's two and lo-check.sh's one (change H50)" "$(is cmp -s "$W/pyb-per-file" "$W/pyb-per-file-want")"
    # Change H51: the base holds no call without -B now; the control by
    # history reads the parent of P1's scripts commit, found by its subject.
    P1_SCRIPTS=$(git log --format='%H' -n 1 -F --grep='M5 part 2 P1: committed scripts call python3 with -I -B' "$C")
    echo "  P1's scripts commit, by subject: ${P1_SCRIPTS:-none found}"
    echo "command: the same over the scripts/ of P1's scripts commit's parent (the control by history: the four calls before that commit)"
    scripts_py "$P1_SCRIPTS^" "$W/pyb-base"
    nnob_base=$(no_b "$W/pyb-base.calls")
    echo "  at P1's scripts commit's parent: files scanned $nscanned; Python calls $(count_lines "$W/pyb-base.calls"); calls without -B $nnob_base"
    note "control: the same count finds the four calls without -B there (change H51)" "$(is [ "$nnob_base" = 4 ])"
    scripts_py "$BASE" "$W/pyb-base2"
    echo "  at the base: Python calls $(count_lines "$W/pyb-base2.calls"); calls without -B $(no_b "$W/pyb-base2.calls")"
    note "the base holds no call without -B either (change H51)" "$(is [ "$(no_b "$W/pyb-base2.calls")" = 0 ])"
    printf '%s\n' "x=\$($PYW -c 'x')" "y=\$($PYW -I -B -c 'x')" "# $PYW -c 'x'" "command -v $PYW" >"$W/c-pyb-fixture"
    printf '%s\n' "x=1" >"$W/c-pyb-plain"
    note "control: the planted fixture differs from a file with no call (cmp)" "$(isnot cmp -s "$W/c-pyb-fixture" "$W/c-pyb-plain")"
    py_calls "$W/c-pyb-fixture" >"$W/c-pyb.calls"
    ctl "Python calls in a planted fixture of four lines (two calls, a comment, a lookup), same command form" 2 count_lines "$W/c-pyb.calls"
    ctl "calls without -B in the same fixture, same command form" 1 no_b "$W/c-pyb.calls"
    printf '%s\n' "$PYW -IB x.py" "$PYW x.py" "$PYW -Bc 'x'" "for t in $PYW sed; do :; done" >"$W/c-pyb-forms"
    py_calls "$W/c-pyb-forms" >"$W/c-pyb-forms.calls"
    ctl "calls in a planted fixture of a bundled -IB, a bare .py, a bundled -Bc and a word list, same command form" 3 count_lines "$W/c-pyb-forms.calls"
    ctl "calls without -B in the same fixture (the bare .py), same command form" 1 no_b "$W/c-pyb-forms.calls"
    
    echo
    echo "## the new sources scored against the gate they must pass, with controls"
    OFF=$(git show "$C:scripts/check.sh" | sed -n "s/^readonly OFFICE_RE='\(.*\)'\$/\1/p")
    note "OFFICE_RE was read from check.sh and is non-empty" "$(is [ -n "$OFF" ])"
    PRE_COMMIT=$(git log --format='%H' --grep='^T0 P6d: narrow the three path patterns' -n 1)
    note "the P6d narrowing commit resolved from git" "$(is [ -n "$PRE_COMMIT" ])"
    git show "$PRE_COMMIT^:scripts/privacy-patterns.txt" >"$W/pre-all" 2>/dev/null || fail=1
    sed -n '8p;10p;11p' "$W/pre-all" >"$W/pre-patterns"
    note "three pre-P6d forms read from the narrowing commit's parent" \
      "$(is [ "$(count_lines "$W/pre-patterns")" = 3 ])"
    git show "$C:scripts/privacy-patterns.txt" >"$W/live-patterns"
    
    f_nonascii() { count_bytes "$NONASCII_CLASS" "$1"; }
    f_ctrl()     { count_bytes "$CTRL_CLASS" "$1"; }
    f_live()     { count_from_file -E "$W/live-patterns" "$1"; }
    f_pre()      { count_from_file -E "$W/pre-patterns" "$1"; }
    f_office()   { count_matches -E "$OFF" "$1"; }
    # P1 gate header change 7, kept: an office extension whose file name is a literal, the
    # name running back from the extension to a space, a quote, a slash, an
    # equals sign or the line's start with no shell expansion in it.
    f_office_literal() { count_matches -E "(^|[ \"'=/])[^ \"'=/\$]+$OFF" "$1"; }
    
    rep() { printf "$1%.0s" $(seq 1 "$2"); }
    printf 'plain\nhas \303\251 byte\n' >"$W/c-nonascii"
    printf 'x \033[31mred\033[m\017 y\n' >"$W/c-ctrl"
    printf 'x %s%s%s y\n' 'gh' 'p_' "$(rep a 24)" >"$W/c-live"
    printf 'x %s%s%s y\n' '/mnt/' 'c/' 'Users/' >"$W/c-pre"
    printf 'name.%s%s\n' 'xl' 'sx' >"$W/c-office"
    printf 'input=$KEEP/$test.in.%s%s\n' 'xl' 'sx' >"$W/c-office-expanded"
    printf 'plain ascii only\n' >"$W/c-clean"
    ctl "f_nonascii on a two-byte character" 2 f_nonascii "$W/c-nonascii"
    ctl "f_ctrl on ESC, ESC and SI" 3 f_ctrl "$W/c-ctrl"
    ctl "f_live on a token shape" 1 f_live "$W/c-live"
    ctl "f_pre on a bare path shape" 1 f_pre "$W/c-pre"
    ctl "f_office on an office file name" 1 f_office "$W/c-office"
    ctl "f_office_literal on the same literal name" 1 f_office_literal "$W/c-office"
    ctl "f_office on a name built from variables" 1 f_office "$W/c-office-expanded"
    ctl "f_office_literal on the same built name" 0 f_office_literal "$W/c-office-expanded"
    for f in f_nonascii f_ctrl f_live f_pre f_office f_office_literal; do
      ctl "$f on a clean file" 0 "$f" "$W/c-clean"
    done
    clean_source() {
      [ "$(f_nonascii "$1")" = 0 ] && [ "$(f_ctrl "$1")" = 0 ] &&
        [ "$(f_live "$1")" = 0 ] && [ "$(f_pre "$1")" = 0 ] && [ "$(f_office_literal "$1")" = 0 ]
    }
    
    git diff --name-only --diff-filter=A "$BASE" "$C" >"$W/added"
    echo "  files added in this phase: $(count_lines "$W/added")"
    nscored=0
    while IFS= read -r s; do
      git show "$C:$s" >"$W/a-at-head" 2>/dev/null || { echo "$s: READ ERROR"; fail=1; continue; }
      echo "$s (new in this phase):"
      echo "  non-ASCII bytes: $(f_nonascii "$W/a-at-head")"
      echo "  control bytes: $(f_ctrl "$W/a-at-head")"
      echo "  hits against all $(count_lines "$W/live-patterns") live privacy patterns: $(f_live "$W/a-at-head")"
      echo "  hits against the three pre-P6d bare forms: $(f_pre "$W/a-at-head")"
      echo "  lines with an office extension: $(f_office "$W/a-at-head"); of them a literal file name: $(f_office_literal "$W/a-at-head")"
      note "$s is clean on the five forms, office names counted as literals" "$(is clean_source "$W/a-at-head")"
      nscored=$((nscored + 1))
    done <"$W/added"
    
    echo
    echo "## the files this phase MODIFIED, scored by change rather than absolutely"
    git diff --name-only --diff-filter=M "$BASE" "$C" >"$W/modified"
    echo "  files modified in this phase: $(count_lines "$W/modified")"
    unchanged_by_this_phase() {
      [ "$added" = 0 ] && [ "$at_base" != error ] && [ "$at_head" != error ] &&
        [ "$at_base" = "$at_head" ]
    }
    while IFS= read -r M; do
      git show "$BASE:$M" >"$W/m-at-base" 2>/dev/null || { echo "$M: READ ERROR at base"; fail=1; continue; }
      git show "$C:$M" >"$W/m-at-head" 2>/dev/null || { echo "$M: READ ERROR at the phase commit"; fail=1; continue; }
      git diff -U0 "$BASE" "$C" -- "$M" |
        LC_ALL=C "$G" '^+' | LC_ALL=C "$G" -v '^+++' | sed 's/^+//' >"$W/m-added"
      echo "$M (modified in this phase):"
      echo "  added lines: $(count_lines "$W/m-added")"
      for form in f_nonascii f_ctrl f_live f_pre f_office_literal f_office; do
        at_base=$("$form" "$W/m-at-base")
        added=$("$form" "$W/m-added")
        at_head=$("$form" "$W/m-at-head")
        echo "  $form: at the base $at_base, in the added lines $added, at the phase commit $at_head"
        if [ "$form" = f_office ]; then
          # Printed only: a moved or rebuilt line can lower the count, and the
          # literal form above is the one held to "nothing new".
          continue
        fi
        note "$M: $form introduces nothing new in this phase" "$(is unchanged_by_this_phase)"
      done
      nscored=$((nscored + 1))
    done <"$W/modified"
    
    echo
    echo "## every file in the diff was scored"
    ndiff=$(count_lines "$W/difffiles")
    echo "  files in the diff: $ndiff; files scored as new or modified: $nscored"
    note "every file in the phase diff was scored" "$(is [ "$ndiff" = "$nscored" ])"
    
    echo
    echo "## the public fn and const first lines, the base's line for line with their cfg lines, a file's items taking the cfg line of its mod declaration (changes E36, L47 to L56, L57, L61 and L62; P3's E35, P2's E34, P1's E33, M3 part 5 P2's E31, P1's E30, M3 part 4 P1's E28, M3 part 3 P3's E26 reader, M2 part 4c P2's E12, part 4b P1's E7 and part 4a P4's D5, kept)"
    # The first line of every "pub fn" and "pub const" in crates/emend/src outside
    # the test files, leading space, "mut " before a parameter and a trailing brace
    # dropped, each beside the attribute before it when the line before is one
    # ("#[...", an attribute over several lines joined into one line, change
    # E26), else "-", sorted by the first line. Change E31: an item with neither
    # its own cfg line nor a gated impl's takes the cfg line of its file's mod
    # declaration in the parent file, when that line is one. Change L62: the
    # phase adds no pub fn or const, loses none and moves no cfg line.
    # file_gate <commit> <path>: the line before the path's mod declaration in
    # its parent file (crates/emend/src/a/b.rs: `mod b;` in crates/emend/src/a.rs)
    # when that line is a feature cfg line, else nothing (change E31).
    file_gate() {
      local at=$1 f=$2 dir name
      case "$f" in crates/emend/src/*/*.rs) ;; *) return 0 ;; esac
      dir=${f%/*}; name=${f##*/}; name=${name%.rs}
      git show "$at:$dir.rs" 2>/dev/null | awk -v m="mod $name;" '$0 == m { print p; exit } { p = $0 }' |
        LC_ALL=C "$G" -E '^#\[cfg\(feature = "[a-z]+"\)\]$' || :
    }
    pub_with_attrs() {
      local at=$1 f
      for f in $(git ls-tree -r --name-only "$at" -- crates/emend/src | LC_ALL=C "$G" -E '[.]rs$' | LC_ALL=C "$G" -vE '(/tests[.]rs|/testing[.]rs|/tests/)'); do
        git show "$at:$f" | awk -v filecfg="$(file_gate "$at" "$f")" '
          function trimmed(s) { sub(/^[[:space:]]*/, "", s); return s }
          function joined(s) { gsub(/[(] /, "(", s); gsub(/ [)]/, ")", s); return s }
          # Change E26: an attribute over several lines, from its "#[" line to
          # the line ending "]", is one line, a space between its pieces and
          # none just inside a parenthesis.
          inattr { attr = attr " " trimmed($0); if ($0 ~ /\]$/) { inattr = 0; prev = joined(attr) }; next }
          /^[[:space:]]*#\[/ && $0 !~ /\]$/ { inattr = 1; attr = trimmed($0); next }
          # Change D5, kept and widened by E7: an impl whose own attribute line is
          # a feature cfg gates every pub fn inside it with that line, up to the
          # impl'"'"'s closing brace at the margin.
          # Change E31: outside a gated impl, the gate of the file itself.
          BEGIN { gated = filecfg }
          /^impl/ { gated = (prev ~ /^#\[cfg\(feature = "[a-z]+"\)\]$/) ? prev : filecfg }
          /^}/ { gated = filecfg }
          /^[[:space:]]*pub (fn|const) / {
            line = $0; sub(/^[[:space:]]*/, "", line); sub(/ [{]$/, "", line)
            gsub(/[(]mut /, "(", line); gsub(/, mut /, ", ", line)
            a = prev; sub(/^[[:space:]]*/, "", a)
            if (a !~ /^#\[/) a = (gated != "" ? gated : "-")
            print a "\t" line
          }
          { prev = $0 }'
      done | LC_ALL=C sort -t "$(printf '\t')" -k2
    }
    TAB=$(printf '\t')
    READ_CFG='#[cfg(feature = "read")]'
    COMMENTS_CFG='#[cfg(feature = "comments")]'
    IMAGES_CFG='#[cfg(feature = "images")]'
    METADATA_CFG='#[cfg(feature = "metadata")]'
    COPY_CFG='#[cfg(feature = "copy")]'
    CHARTS_CFG='#[cfg(feature = "charts")]'
    DRAWING_OLD='#[cfg(any(feature = "images", feature = "read"))]'
    DRAWING_NEW='#[cfg(any(feature = "images", feature = "read", feature = "charts"))]'
    CHART_NEW='#[cfg(any(feature = "read", feature = "charts"))]'
    COMMENTS_ANY='#[cfg(any(feature = "comments", feature = "copy"))]'
    METADATA_ANY='#[cfg(any(feature = "metadata", feature = "copy"))]'
    PAIR_CFG='#[cfg(all(feature = "sheetprops", feature = "metadata"))]'
    TABLE_NEW='#[cfg(any(feature = "rowcol", feature = "tables", all(feature = "sheetprops", feature = "metadata")))]'
    echo "command: git show <commit>:<each crates/emend/src/*.rs outside the tests> | awk (a pub fn or pub const first line, beside the previous line when it is an attribute, one over several lines joined), sorted, at the base and at the phase commit"
    pub_with_attrs "$BASE" >"$W/pubattr-base"
    pub_with_attrs "$C" >"$W/pubattr-head"
    echo "  at the phase commit, every pub fn and pub const first line with its attribute:"
    sed 's/^/    /' "$W/pubattr-head"
    cut -f2 "$W/pubattr-base" | LC_ALL=C sort >"$W/pub-base"
    cut -f2 "$W/pubattr-head" | LC_ALL=C sort >"$W/pub-on"
    echo "  pub first lines: at the base $(count_lines "$W/pub-base"); at the phase commit $(count_lines "$W/pub-on")"
    LC_ALL=C comm -13 "$W/pub-base" "$W/pub-on" >"$W/pub-new"
    LC_ALL=C comm -23 "$W/pub-base" "$W/pub-on" >"$W/pub-lost"
    echo "  the lines the base's list loses at the phase commit:"; sed 's/^/    /' "$W/pub-lost"
    echo "  the lines the phase commit's list adds to the base's:"; sed 's/^/    /' "$W/pub-new"
    # Change L62: the list is the base's, line for line: the phase adds no pub
    # fn and no pub const (the probe's additions lie in tools/, ruling O's
    # carry in comments and one test), loses none and moves no cfg line.
    : >"$W/pub-new-want"
    echo "  the lines the phase commit adds: $(count_lines "$W/pub-new"); the lines the base's list loses: $(count_lines "$W/pub-lost")"
    note "the phase commit's list adds nothing to the base's (change L62)" "$(is cmp -s "$W/pub-new" "$W/pub-new-want")"
    note "no line of the base's list is lost (changes L57, L61 and L62)" "$(is [ "$(count_lines "$W/pub-lost")" = 0 ])"
    note "some first lines were read" "$(is [ "$(count_lines "$W/pub-on")" -ge 1 ])"
    printf '%s\n' 'pub fn planted(&self)' >"$W/c-pub-extra"
    note "control: the comparison refuses a list one call long" "$(isnot cmp -s "$W/c-pub-extra" "$W/pub-new-want")"
    printf '%s\n' 'pub fn remove_chart(&mut self, part: &[u8], index: usize) -> Result<(), Error>' >"$W/c-pub-p3"
    note "control: the comparison refuses P3's one added line, remove_chart, given as this phase's (change L62)" "$(isnot cmp -s "$W/c-pub-p3" "$W/pub-new-want")"
    gated_by() {
      awk -F "$TAB" -v cfg="$2" '$1 == cfg { print $2 }' "$1" |
        sed -E 's/^pub (fn|const) ([A-Za-z_0-9]+).*/\1 \2/' | LC_ALL=C sort
    }
    # The phase commit's list with attributes is the base's, line for line:
    # no cfg line moves (change L62).
    LC_ALL=C sort "$W/pubattr-base" >"$W/pubattr-want"
    LC_ALL=C sort "$W/pubattr-head" >"$W/pubattr-head-sorted"
    note "the phase commit's list with attributes is the base's, line for line (change L62)" "$(is cmp -s "$W/pubattr-head-sorted" "$W/pubattr-want")"
    { cat "$W/pubattr-want"; printf '%s\t%s\n' "$CHARTS_CFG" 'pub fn planted(&self)'; } | LC_ALL=C sort >"$W/c-pubattr-extra"
    note "control: the same comparison refuses the expected list with a line added under the charts cfg line" "$(isnot cmp -s "$W/pubattr-head-sorted" "$W/c-pubattr-extra")"
    awk -F "$TAB" -v OFS="$TAB" -v cnew="$CHARTS_CFG" -v cold="$IMAGES_CFG" '$2 ~ /^pub fn remove_chart[(]/ && $1 == cnew { $1 = cold } { print }' "$W/pubattr-want" | LC_ALL=C sort >"$W/c-pubattr-moved"
    note "control: the same comparison refuses the expected list with remove_chart moved to the images cfg line" "$(isnot cmp -s "$W/pubattr-head-sorted" "$W/c-pubattr-moved")"
    # Change E36, kept: P3's copy_sheet stands under the copy cfg line.
    gated_by "$W/pubattr-head" "$COPY_CFG" >"$W/gated-copy"
    printf 'fn copy_sheet\n' >"$W/gated-copy-want"
    echo "  under $COPY_CFG at the phase commit: $(tr '\n' ' ' <"$W/gated-copy")"
    note "the item under the copy cfg line is copy_sheet alone (change E36)" "$(is cmp -s "$W/gated-copy" "$W/gated-copy-want")"
    echo "  file_gate at the phase commit: package/chart_write.rs '$(file_gate "$C" crates/emend/src/package/chart_write.rs)'; package/chart.rs '$(file_gate "$C" crates/emend/src/package/chart.rs)'; package/extlink.rs '$(file_gate "$C" crates/emend/src/package/extlink.rs)'; package/pivot.rs '$(file_gate "$C" crates/emend/src/package/pivot.rs)'; package/survey.rs '$(file_gate "$C" crates/emend/src/package/survey.rs)'; package/sheet_read.rs '$(file_gate "$C" crates/emend/src/package/sheet_read.rs)'; styles/elements.rs '$(file_gate "$C" crates/emend/src/styles/elements.rs)'; package.rs '$(file_gate "$C" crates/emend/src/package.rs)'"
    note "file_gate gives package/chart_write.rs, P1's, the charts cfg line (change L56, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/chart_write.rs)" = "$CHARTS_CFG" ])"
    note "file_gate gives package/chart.rs, part 3 P1's, the charts cfg line (change L53, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/chart.rs)" = "$CHARTS_CFG" ])"
    note "file_gate gives package/extlink.rs, part 2 P3's, the read cfg line (change L52, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/extlink.rs)" = "$READ_CFG" ])"
    note "file_gate gives package/pivot.rs, P2's, the read cfg line (change L51, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/pivot.rs)" = "$READ_CFG" ])"
    note "file_gate gives package/survey.rs, P1's, the read cfg line (change L50, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/survey.rs)" = "$READ_CFG" ])"
    note "file_gate gives package/sheet_read.rs the read cfg line (M3 part 5 P2's E31)" "$(is [ "$(file_gate "$C" crates/emend/src/package/sheet_read.rs)" = "$READ_CFG" ])"
    note "control: file_gate gives an ungated module (styles/elements.rs) nothing" "$(is [ -z "$(file_gate "$C" crates/emend/src/styles/elements.rs)" ])"
    note "control: file_gate gives a top-level file (package.rs) nothing" "$(is [ -z "$(file_gate "$C" crates/emend/src/package.rs)" ])"
    # The cfg lines the list carries: the base's, none new and none gone
    # (changes L54, L56 and L57).
    awk -F "$TAB" '$1 ~ /^#\[cfg\(/ { print $1 }' "$W/pubattr-head" | LC_ALL=C sort -u >"$W/cfgs"
    awk -F "$TAB" '$1 ~ /^#\[cfg\(/ { print $1 }' "$W/pubattr-base" | LC_ALL=C sort -u >"$W/cfgs-base"
    echo "  the cfg lines the list carries at the phase commit:"; sed 's/^/    /' "$W/cfgs"
    note "the cfg lines the list carries are the base's (changes L54, L56 and L57)" "$(is cmp -s "$W/cfgs" "$W/cfgs-base")"
    sed '1d' "$W/cfgs-base" >"$W/c-cfgs"
    note "control: the comparison refuses the base's lines one short" "$(isnot cmp -s "$W/cfgs" "$W/c-cfgs")"
    note "the read cfg line is among them (change E33)" "$(is [ "$(count_matches -Fx "$READ_CFG" "$W/cfgs")" = 1 ])"
    while IFS= read -r cfg; do
      gated_by "$W/pubattr-head" "$cfg" >"$W/gated-head"
      gated_by "$W/pubattr-base" "$cfg" >"$W/gated-base"
      echo "  $cfg: items at the base $(count_lines "$W/gated-base"), at the phase commit $(count_lines "$W/gated-head")"
    done <"$W/cfgs"
    gated_by "$W/pubattr-head" "$READ_CFG" >"$W/gated-read-head"
    gated_by "$W/pubattr-base" "$READ_CFG" >"$W/gated-read-base"
    note "the items under the read cfg line are the base's, item for item (changes L54, L56 and L57)" "$(is cmp -s "$W/gated-read-head" "$W/gated-read-base")"
    gated_by "$W/pubattr-head" "$CHARTS_CFG" >"$W/gated-charts"
    printf 'fn add_chart\nfn charts\nfn remove_chart\n' | LC_ALL=C sort >"$W/gated-charts-want"
    echo "  under $CHARTS_CFG at the phase commit: $(tr '\n' ' ' <"$W/gated-charts")"
    note "the items under the charts cfg line are charts, add_chart and remove_chart (changes L53, L56, L57 and L61)" "$(is cmp -s "$W/gated-charts" "$W/gated-charts-want")"
    gated_by "$W/pubattr-head" "$DRAWING_NEW" >"$W/gated-dnew"
    gated_by "$W/pubattr-head" "$CHART_NEW" >"$W/gated-cnew"
    echo "  under $DRAWING_NEW: $(tr '\n' ' ' <"$W/gated-dnew"); under $CHART_NEW: $(tr '\n' ' ' <"$W/gated-cnew")"
    dc_alone() { [ "$(cat "$W/gated-dnew")" = 'const DRAWING' ] && [ "$(cat "$W/gated-cnew")" = 'const CHART' ]; }
    note "DRAWING alone is still under the first widened cfg line and CHART alone under the second (changes L53, L56 and L57)" "$(is dc_alone)"
    note "control: the charts comparison refuses the list of the read cfg line" "$(isnot cmp -s "$W/gated-read-head" "$W/gated-charts-want")"
    : >"$W/c-gated-short"
    note "control: the copy comparison refuses a list one item short" "$(isnot cmp -s "$W/gated-copy" "$W/c-gated-short")"
    printf '%s\n' "    $PAIR_CFG" '    pub fn x(&self) {' '    /// doc' '    pub const Y: u8 = 1;' >"$W/c-attr.rs"
    c_attr() {
      awk '
        /^[[:space:]]*pub (fn|const) / { a = prev; sub(/^[[:space:]]*/, "", a); if (a !~ /^#\[/) a = "-"; print a }
        { prev = $0 }' "$W/c-attr.rs" | tr '\n' '|'
    }
    c_attr_ok() { [ "$(c_attr)" = "$PAIR_CFG|-|" ]; }
    note "control: the attribute reader pairs a cfg line with the fn after it and a doc line with '-'" "$(is c_attr_ok)"
    # Change E26's control: the joining reader over a fixture holding TABLE's
    # six-line cfg, a one-line one and a doc line.
    printf '%s\n' '#[cfg(any(' '    feature = "rowcol",' '    feature = "tables",' '    all(feature = "sheetprops", feature = "metadata")' '))]' 'pub const T: u8 = 1;' "$PAIR_CFG" 'pub fn f(&self) {}' '/// doc' 'pub fn g(&self) {}' >"$W/c-multi.rs"
    c_multi() {
      awk '
        function trimmed(s) { sub(/^[[:space:]]*/, "", s); return s }
        function joined(s) { gsub(/[(] /, "(", s); gsub(/ [)]/, ")", s); return s }
        inattr { attr = attr " " trimmed($0); if ($0 ~ /\]$/) { inattr = 0; prev = joined(attr) }; next }
        /^[[:space:]]*#\[/ && $0 !~ /\]$/ { inattr = 1; attr = trimmed($0); next }
        /^[[:space:]]*pub (fn|const) / { a = prev; sub(/^[[:space:]]*/, "", a); if (a !~ /^#\[/) a = "-"; print a }
        { prev = $0 }' "$W/c-multi.rs" | tr '\n' '|'
    }
    c_multi_ok() { [ "$(c_multi)" = "$TABLE_NEW|$PAIR_CFG|-|" ]; }
    note "control: the reader joins a six-line attribute into the widened cfg line and keeps one-line attributes and doc lines (change E26)" "$(is c_multi_ok)"
    # Change D5's control, widened by E7: the reader itself, over a fixture with
    # a gated impl and an ungated one, gives the pub fn inside the gated impl the
    # cfg line.
    FEATURE_CFG='#[cfg(feature = "sheetprops")]'
    printf '%s\n' "$FEATURE_CFG" 'impl A {' '    /// doc' '    pub fn inside(&self) {}' '}' 'impl B {' '    /// doc' '    pub fn outside(&self) {}' '}' >"$W/c-impl.rs"
    c_impl() {
      awk '
        /^impl/ { gated = (prev ~ /^#\[cfg\(feature = "[a-z]+"\)\]$/) ? prev : "" }
        /^}/ { gated = "" }
        /^[[:space:]]*pub (fn|const) / { a = prev; sub(/^[[:space:]]*/, "", a); if (a !~ /^#\[/) a = (gated != "" ? gated : "-"); print a }
        { prev = $0 }' "$W/c-impl.rs" | tr '\n' '|'
    }
    c_impl_ok() { [ "$(c_impl)" = "$FEATURE_CFG|-|" ]; }
    note "control: the reader gives a pub fn in a gated impl the cfg line and one in an ungated impl '-' (change D5)" "$(is c_impl_ok)"
    nunsafe=$(git grep -c -w -e unsafe "$C" -- crates/emend/src | awk -F: '{ n += $NF } END { print n + 0 }')
    nforbid=$(git show "$C:crates/emend/src/lib.rs" | count_matches -Fx '#![forbid(unsafe_code)]' /dev/stdin)
    echo "  lines holding the word unsafe under crates/emend/src at the phase commit: $nunsafe; lib.rs's forbid line: $nforbid"
    note "lib.rs still forbids unsafe code" "$(is [ "$nforbid" = 1 ])"
    
    echo
    echo "## the base's tests: the test file in the range, none gone and none edited, with a control over P3's range; the test names of the whole tree the base's with the one new test the diff adds (change F6, kept; changes F35, I38 to I40, I43, I44, I47 to I61 and I62)"
    git diff --name-only "$BASE" "$C" | LC_ALL=C "$G" -E '(/tests[.]rs|/tests/|^tools/.*/tests/)' >"$W/test-files" || :
    sed 's/^/    test file changed: /' "$W/test-files"
    # test_bodies <commit> <file>: "<name>\t<body with each line joined by a
    # form feed>" per #[test] fn, the body from the fn line to the first line
    # that is a closing brace at the left margin.
    test_bodies() {
      python3 -I -B - "$1" "$2" <<'BODIES'
    import re, subprocess, sys
    at, path = sys.argv[1:3]
    if subprocess.run(["git", "cat-file", "-e", at + "^{commit}"], capture_output=True).returncode != 0:
        sys.exit("no such commit")
    if subprocess.run(["git", "cat-file", "-e", f"{at}:{path}"], capture_output=True).returncode != 0:
        sys.exit(0)
    text = subprocess.run(["git", "show", f"{at}:{path}"], capture_output=True, text=True,
                          check=True).stdout.split("\n")
    i = 0
    while i < len(text):
        if text[i].strip() == "#[test]":
            j = i + 1
            while j < len(text) and not re.match(r"^\s*fn ", text[j]):
                j += 1
            if j >= len(text):
                break
            name = re.match(r"^\s*fn ([a-z0-9_]+)", text[j]).group(1)
            k = j
            while k < len(text) and text[k] != "}":
                k += 1
            print(name + "\t" + "\f".join(text[j:k + 1]))
            i = k
        i += 1
    BODIES
    }
    # added_in <base bodies> <head bodies> <file>: per base test, "gone", or one
    # line "<file> <test> - <line, stripped>" per line removed from its body and
    # "<file> <test> + <line, stripped>" per line added, by a line diff of the
    # body at the base against the body now (change I4).
    added_in() {
      python3 -I -B - "$1" "$2" "$3" <<'ADDED'
    import difflib, sys
    base = dict(l.rstrip("\n").split("\t", 1) for l in open(sys.argv[1]) if l.strip())
    head = dict(l.rstrip("\n").split("\t", 1) for l in open(sys.argv[2]) if l.strip())
    for name, body in sorted(base.items()):
        if name not in head:
            print("%s %s gone" % (sys.argv[3], name))
            continue
        old, new = body.split("\f"), head[name].split("\f")
        for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
            if tag in ("replace", "delete"):
                for line in old[i1:i2]:
                    print("%s %s - %s" % (sys.argv[3], name, line.strip()))
            if tag in ("replace", "insert"):
                for line in new[j1:j2]:
                    print("%s %s + %s" % (sys.argv[3], name, line.strip()))
    ADDED
    }
    : >"$W/tests-edited"; tb_fail=0
    nbase_tests=0
    while IFS= read -r tf; do
