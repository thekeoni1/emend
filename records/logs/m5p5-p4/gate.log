    note "some base tests were read" "$(is [ "$nbase_tests" -ge 1 ])"
    printf '%s\n' crates/emend/src/package/tests/chart_write.rs >"$W/test-files-want"
    LC_ALL=C sort "$W/test-files" >"$W/test-files-sorted"
    echo "  test files in the phase diff: $(count_lines "$W/test-files")"
    note "the test file in the phase diff is the one FACTS.md names (change I62)" "$(is cmp -s "$W/test-files-sorted" "$W/test-files-want")"
    { cat "$W/test-files-want"; printf '%s\n' tools/emend-copy/tests/null_rewrite.rs; } | LC_ALL=C sort >"$W/c-test-files-long"
    note "control: the comparison refuses the list one file long" "$(isnot cmp -s "$W/c-test-files-long" "$W/test-files-want")"
    printf 'crates/emend/src/package/tests.rs\nscripts/counting.sh\n' >"$W/c-test-files"
    ctl "test files in a planted list of two, the same pattern" 1 count_matches -E '(/tests[.]rs|/tests/|^tools/.*/tests/)' "$W/c-test-files"
    note "no test of the base is gone ($ngone; change I62)" "$(is [ "$ngone" = 0 ])"
    nedit=$(count_lines "$W/tests-edited")
    awk '{ print $1 " " $2 }' "$W/tests-edited" | LC_ALL=C sort -u >"$W/tests-edited-names"
    echo "  edit lines: $nedit; base tests edited: $(count_lines "$W/tests-edited-names")"
    sed 's/^/    edited: /' "$W/tests-edited-names"
    note "no base test is edited, no line added to or removed from any base test's body (change I62)" "$(is [ "$nedit" = 0 ])"
    # Change I62's control: the same reader over P3's range (P2's record commit
    # to P3's tool commit, each found by its subject) finds P3's one edit, the
    # two added lines "color: None," and "labels: None," in one test, so the
