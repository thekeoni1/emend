    echo "command: for each test file in the phase diff, the #[test] fns at the phase commit (the same reader) whose 'fn <name>(' line git diff -U0 <base> <phase commit> adds"
    echo "  new tests derived from the diff: $(count_lines "$W/names-from-diff")"
    note "the names the phase commit adds are exactly the new tests derived from the diff, some (changes I47 to I62)" "$(is cmp -s "$W/names-new" "$W/names-from-diff")"
    note "some new tests were derived" "$(is [ "$(count_lines "$W/names-from-diff")" -ge 1 ])"
    cat >"$W/names-new-want" <<'NAMESNEW'
    crates/emend/src/package/tests/chart_write.rs a_chart_removal_on_a_part_the_same_write_adds_an_image_to_is_refused
    NAMESNEW
    LC_ALL=C sort -o "$W/names-new-want" "$W/names-new-want"
    echo "  the new tests FACTS.md names: $(count_lines "$W/names-new-want")"
    note "the new test is the one FACTS.md names, by name (change I62)" "$(is cmp -s "$W/names-from-diff" "$W/names-new-want")"
    # Change I60, kept (I61, I62): the planted name is the last one with
    # _planted appended.
    sed '$ s/$/_planted/' "$W/names-new-want" >"$W/c-names-new-want"
    note "control: the planted list differs from the expectation (cmp)" "$(isnot cmp -s "$W/c-names-new-want" "$W/names-new-want")"
    note "control: the same comparison refuses another name" "$(isnot cmp -s "$W/names-from-diff" "$W/c-names-new-want")"
    LC_ALL=C sort -m "$W/names-base" "$W/names-from-diff" >"$W/names-want"
    note "the test names of the whole tree are the base's and the new tests, nothing else (changes I47 to I62)" "$(is cmp -s "$W/names-head" "$W/names-want")"
    note "some test names were read" "$(is [ "$(count_lines "$W/names-head")" -ge 1 ])"
