    echo
    echo "## script"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$W/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    # Change T52 (specs/0033 "Planning rulings on P2", ruling 7): the shared
    # library's one mktemp call, counting_controls's control directory, lies
    # under TMPDIR. The controls run once more in a subshell, their output
    # dropped, with mktemp wrapped by a function that records the path the
    # real command printed; TMPDIR is the one given. The library removes the
    # directory itself; the recorded path is checked under TMPDIR, and the
    # control runs the same with TMPDIR set to <build> and refuses the path.
    LIB_MK=$W/lib-mktemp
    lib_mktemp_dirs() {
      (
        : >"$LIB_MK"
        mktemp() { local p; p=$(command mktemp "$@") || return 1; printf '%s\n' "$p" >>"$LIB_MK"; printf '%s\n' "$p"; }
        export TMPDIR=$1
        counting_controls >/dev/null 2>&1
      )
      cat "$LIB_MK"
    }
    LIB_DIRS=$(lib_mktemp_dirs "$TMPDIR")
