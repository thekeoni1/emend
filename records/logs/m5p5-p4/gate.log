    }
    tree_test_names "$BASE" >"$W/names-base"
    tree_test_names "$C" >"$W/names-head"
    echo "command: every #[test] fn's name in every .rs file under crates/ and tools/, read by the same reader at the base and at the phase commit, sorted"
    echo "  test names at the base: $(count_lines "$W/names-base"); at the phase commit: $(count_lines "$W/names-head")"
    LC_ALL=C comm -23 "$W/names-base" "$W/names-head" >"$W/names-lost"
    LC_ALL=C comm -13 "$W/names-base" "$W/names-head" >"$W/names-new"
