## R2: the API record, written by the formatter and installed (specs/0036 "P4"; changes VG, XM, YM, ZH and ZZO)
command: sed 's/^/    /' <scripts>/make_review.py; sha256sum: 34460e101007a4a41f8e6a6d07e92f47c895b700333c12f9f15836bb39178540; 9212 bytes
    #!/usr/bin/env python3
    """Assembles records/api-review-m5p5-<date>-<sha>.md from M5 part 5 P4's
    test.log listing (<phase>/api/listing.tsv) and M5 part 4 P3's listing
    (specs/0036-charts-write-second-set.md, "P4": the API listing rerun as part
    4 P3 did, the changed rows named). Generated by M5 part 5 P4's gen/test.py
    from M5 part 4 P3's formatter (its print in records/logs/m5p4-p3/test.log,
    sha256 fff6843c...), changed so: its map of parts to specs gains "M5 part
    5" -> specs/0036, its comparison is M5 part 4 P3's listing in place of M5
    part 3 P3's, and its prose is this rerun's (change ZZO). Its table of
    verdicts other than keep stays empty. It only formats and counts; it
    judges nothing.
    
    Usage: make_review.py <listing.tsv> <M5 part 4 P3 listing.tsv> <out.md> <date>
           <short> <listing sha256> <files sha256> <formatter sha256>
           <doc links> <doc anchors> <doc items> <listed module-level items>
           <gate widenings>"""
    import re, sys
    from collections import Counter
    
    (listing, old_listing, out, date, short, listing_sha, files_sha, self_sha,
     doc_links, doc_anchors, doc_items, listed_items, gates_path) = sys.argv[1:14]
    
    # Each part's spec: the specs/*.md file its first doc commit added (git log
    # --diff-filter=A -- 'specs/*.md', read in the session).
    SPEC = {
        "M1 part 1": "0008", "M1 part 2": "0009", "M1 part 3": "0010", "M1 part 4": "0011",
        "M1 part 5": "0012", "M1 part 6": "0013", "M2 part 1": "0016", "M2 part 2": "0017",
        "M2 part 3": "0018", "M2 part 4a": "0019", "M2 part 4b": "0020", "M2 part 4c": "0021",
        "M2 part 4d": "0022", "M3 part 2": "0024", "M3 part 3": "0025", "M3 part 4": "0026",
        "M3 part 5": "0027", "M3 part 6": "0028", "M4 part 1": "0030",
        "M4 part 2": "0031", "M5 part 1": "0032", "M5 part 2": "0033",
        "M5 part 3": "0034", "M5 part 4": "0035", "M5 part 5": "0036",
    }
    
    # The verdicts that are not "keep": none. Part 7 P3's six (five renames and
    # one hide) were applied by M4 part 1 P2; every item listed now is keep, the
    # new items of M5 part 5 among them.
    CHANGE = {}
    
    def spec_of(subject):
        m = re.match(r"^(M\d+ part \d+[a-z]?)", subject)
        return ("specs/" + SPEC[m.group(1)]) if m and m.group(1) in SPEC else "-"
    
    def load(path):
        with open(path) as f:
            header = f.readline().rstrip("\n").split("\t")
            return [dict(zip(header, line.rstrip("\n").split("\t"))) for line in f]
    
    def key(r):
        return (r["module"], r["kind"], r["name"], r["container"], r["cfg"], r["added"])
    
    rows = load(listing)
    old = load(old_listing)
    
    lines = []
    verdicts = Counter()
    by_module = {}
    for r in rows:
        by_module.setdefault(r["module"], []).append(r)
    n = 0
    for module in sorted(by_module, key=lambda m: (m.count("::"), m)):
        lines.append("")
        lines.append("### `%s`" % module)
        lines.append("")
        lines.append("| # | item | kind | feature | added by | spec | verdict |")
        lines.append("| --- | --- | --- | --- | --- | --- | --- |")
        for r in by_module[module]:
            n += 1
            name = r["name"] if r["container"] == "-" else "%s.%s" % (r["container"], r["name"])
            if r["kind"] == "use":
                name = "use %s" % r["name"]
            feature = r["cfg"] if r["cfg"] != "-" else "core"
            verdicts["keep"] += 1
            name = name.replace("|", "\\|")
            lines.append("| %d | `%s` | %s | %s | %s | %s | keep |" % (
                n, name, r["kind"], feature.replace("|", "\\|"), r["added"], spec_of(r["added_subject"])))
    
    new_keys = [key(r) for r in rows]
    old_keys = [key(r) for r in old]
    gone = sorted(set(old_keys) - set(new_keys))
    came = sorted(set(new_keys) - set(old_keys))
    
    def show(k):
        module, kind, name, container, cfg, added = k
        item = name if container == "-" else "%s.%s" % (container, name)
        if kind == "use":
            item = "use %s" % name
        return "`%s` %s in `%s`, feature %s, added by %s" % (
            item, kind, module, cfg if cfg != "-" else "core", added)
    
    kinds = Counter(r["kind"] for r in rows)
    head = [
        "# API review rerun, Milestone 5 part 5 P4 (%s, %s)" % (date, short),
        "",
        "The API listing rerun as Milestone 5 part 4 P3 did, after M5 part 5 added the second set of charts write under the feature `charts` (`NewCombined`, `NewLabels`, `LabelPosition`, `RadarStyle`, the new fields of `NewChart` and `NewSeries`, and `Package::remove_chart`) and shared the drawing removal with `images` (`specs/0036-charts-write-second-set.md`, \"P4\"). M5 part 4 P3's record is `records/api-review-m5p4-2026-10-14-574a77d.md`.",
        "",
        "- Listing: every `pub` item of `crates/emend` reachable from the crate root, as `records/logs/m5p5-p4/test.log` (section T1) prints it from the phase commit's sources with part 7 P3's listing program; its file `listing.tsv` sha256 %s, `files.tsv` sha256 %s." % (listing_sha, files_sha),
        "- Formatter: this record is assembled by `make_review.py`, generated from M5 part 4 P3's formatter, sha256 %s (printed in test.log, section R2), its table of non-keep verdicts empty and its spec map extended to M5 part 5." % self_sha,
        "- Items: %d, by kind: %s." % (len(rows), ", ".join("%s %d" % (k, kinds[k]) for k in sorted(kinds, key=lambda k: (-kinds[k], k)))),
        "- The doc build (test.log section T2): `cargo doc` with every feature and `-D warnings`, exit 0, no warning line; its index `all.html` holds %s link lines, of which %s are the page's section anchors, leaving %s documented module-level items, against the listing's %s reachable module-level types, functions, constants and aliases." % (doc_links, doc_anchors, doc_items, listed_items),
        "- Columns: as part 7's record: `item` is the item's name, `Container.name` for a method or field, `use ...` for a re-export; `feature` is the cfg in force at the item (`core` for none); `added by` is the commit the listing finds introducing the item's declaration (a heuristic the listing program states); `spec` is that commit's part's spec.",
        "- Verdicts: every item keep.",
    ]
    diff = ["", "## Rows that differ from M5 part 4 P3's listing", "",
            "Compared by key (module, kind, name, container, cfg, added by): %d of M5 part 4 P3's rows are not in this listing and %d of this listing's rows are not in M5 part 4 P3's; every other row is equal." % (len(gone), len(came)), "",
            "M5 part 4 P3's rows not here:", ""]
    diff += ["- %s" % show(k) for k in gone]
    # Changes YM, ZH and ZZO (M5 part 5 P4): of the rows not in M5 part 4
    # P3's, those equal to a gone row but for the cfg are items whose gate
    # was widened;
    # the others are new items. A new row whose added-by commit differs from
    # its new type's row's is named, the cause not judged.
    gone_bare = set(k[:4] + k[5:] for k in gone)
    widened = [k for k in came if k[:4] + k[5:] in gone_bare]
    diff += ["", "This listing's rows not in M5 part 4 P3's (%d listed: %d cfg-widened items, %d new by key):" % (len(came), len(widened), len(came) - len(widened)), ""]
    diff += ["The %d cfg-widened items are M5 part 4 P3's rows not here with their cfg widened; the other %d rows are new by key, the items M5 part 5 adds and any row whose key changed (the rows not here above)." % (len(widened), len(came) - len(widened)), ""]
    owner = {(k[0], k[2]): k[5] for k in came if k[1] in ("struct", "enum") and k[3] == "-"}
    split = [k for k in came if k[3] != "-" and (k[0], k[3]) in owner and owner[(k[0], k[3])] != k[5]]
    if split:
        diff += ["%d new rows have an added-by commit other than their new type's: either a later commit added the member to the type, or the listing heuristic dates the declaration line to an earlier commit that already held an equal line in the same file. This record does not say which." % len(split), ""]
        diff += ["- `%s.%s`: %s; `%s`: %s" % (k[3], k[2], k[5], k[3], owner[(k[0], k[3])]) for k in split]
        diff += [""]
    diff += ["- %s" % show(k) for k in came]
    # Change YM: the items the feature gates widened, pub or not (P1 ruling A),
    # from the thirteenth argument, one name|cfg line each.
    gates = [line.split("|", 1) for line in open(gates_path).read().split("\n") if line]
    pub_names = set(k[2] for k in widened)
    n_pub = sum(1 for name, _c in gates if name in pub_names)
    diff += ["", "## Items the feature gates widened to `charts`", "",
             "%d items, each gated with `charts` as well since M5 part 4 P3's listing, read from the diff over `crates/emend/src/package.rs` and declared there at M5 part 4 P3's phase commit (test.log section T1): %d pub, in this listing as the cfg-widened rows above; %d crate-private, not in the pub listing." % (len(gates), n_pub, len(gates) - n_pub), ""]
    diff += ["- `%s`: %s, `%s`" % (name, "pub, in the listing" if name in pub_names else "crate-private, not in the pub listing", cfg) for name, cfg in gates]
    tail = ["", "## Counts per verdict", ""]
    for v in ("keep", "rename before publication", "hide", "widen or narrow"):
        tail.append("- %s: %d" % (v, verdicts[v]))
    tail.append("- in all: %d" % sum(verdicts.values()))
    tail.append("")
    with open(out, "w") as f:
        f.write("\n".join(head + diff + ["", "## The items, by module"] + lines + tail))
    print("rows %d; %s; differing from M5 part 4 P3: %d gone, %d new; gate-widened %d, %d of them pub" % (len(rows), dict(verdicts), len(gone), len(came), len(gates), n_pub))
