    """Writes the openpyxl image record (specs/0037 "The openpyxl image") from
    values the test log read and printed, given in the environment; refuses a
    file that is there. Prints nothing."""
    import os
    import sys
    
    e = os.environ
    path = e["IMG_REC"]
    if os.path.exists(path):
        sys.exit(1)
    packages = [line.split("\t") for line in open(e["PACKAGES"]).read().split("\n") if line]
    out = [
        "# openpyxl image for the comparison, %s" % e["DATE"],
        "",
        "Written by the Milestone 5 part 6 P1 test log (`records/logs/m5p6-p1/test.log`)"
        " at the phase commit %s, from the values the commands it prints read;"
        " `specs/0037-measurement-and-close.md`, \"The openpyxl image\" (decision 1 A)."
        " The image is amd64 and runs on the host only, with `--network=none` and"
        " `--userns=keep-id`, one workbook at a time, read-only." % e["COMMIT"],
        "",
        "## Pins",
        "",
        "| Item | Value |",
        "|------|-------|",
        "| Image tag | `%s` |" % e["IMAGE"],
        "| Image id | `%s` |" % e["IMG_ID"],
        "| Image bytes | %s |" % e["IMG_SIZE"],
        "| Image created | %s |" % e["IMG_CREATED"],
        "| Base image | `%s` (the LibreOffice image's, `records/libreoffice-2026-09-15.md`) |" % e["CF_FROM"],
        "| Containerfile | `tools/openpyxl-image/Containerfile`, sha256 `%s` |" % e["CF_SHA"],
        "| Package pin | `%s`; `python3-pil` unpinned, its version below |" % e["PIN"],
        "| Python | %s |" % e["PY_V"],
        "| `openpyxl.__version__` | %s |" % e["OX_V"],
        "| `PIL.__version__` | %s |" % e["PIL_V"],
        "| Builder | %s, rootless (`%s`), no elevation |" % (e["PODMAN_V"], e["ROOTLESS"]),
        "",
        "## Installed python3 packages (`/py-packages.txt`)",
        "",
        "| Package | Version |",
        "|---------|---------|",
    ]
    out += ["| %s | %s |" % (name, version) for name, version in packages]
    out += [
        "",
        "## Build",
        "",
        "`podman build -t %s tools/openpyxl-image`, rootless, the network used at"
        " build time only; the Containerfile is committed and its sha256 is above."
        " If Debian's suite no longer offers the pinned version, the build is"
        " pinned to snapshot.debian.org at this record's date, a ruling and not a"
        " silent change (specs/0037)." % e["IMAGE"],
    ]
    with open(path, "x", encoding="ascii", newline="\n") as handle:
        handle.write("\n".join(out) + "\n")
    os.chmod(path, 0o644)
