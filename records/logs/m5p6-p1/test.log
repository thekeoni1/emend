command: the checker <scratch>/w/fx/cmpcheck.py (printed below, sha256 0f30c3a5b3dc66f8193f4420c262cc10e11a59edc534d5134324755926dcf7c4), run as python3 -I -B <checker> <run directory> <op> with the expectations in its environment
    """Checks one comparison run directory against what the test log expects:
    the three headers, one summary row per expected id in manifest order, each
    row's fields, its output and nothing else in the output directory, the
    entries rows, and the one run row. Prints "yes" or "no", a tab and what
    was checked, one line each; never a cell value."""
    import os
    import re
    import sys
    
    e = os.environ
    run, op = sys.argv[1], sys.argv[2]
    want_ids = [pair.split(":") for pair in e["IDS"].split(",")]
    out = []
    
    
    def say(ok, what):
        out.append("%s\t%s: %s" % ("yes" if ok else "no", op, what))
    
    
    def table(name):
        try:
            lines = open(os.path.join(run, name)).read().split("\n")
        except OSError:
            return None, []
        if lines and lines[-1] == "":
            lines.pop()
        return (lines[0] if lines else None), [line.split("\t") for line in lines[1:]]
    
    
    sh, srows = table("summary.openpyxl.tsv")
    eh, erows = table("entries.openpyxl.tsv")
    rh, rrows = table("run.openpyxl.tsv")
    summary_header = e["SUM_H"].replace("\\t", "\t")
    say(sh == summary_header, "summary.openpyxl.tsv's header is the runner's")
    say(eh == e["ENT_H"].replace("\\t", "\t"), "entries.openpyxl.tsv's header is the runner's")
    say(rh == e["RUN_H"].replace("\\t", "\t"), "run.openpyxl.tsv's header is ruling E's")
    cols = summary_header.split("\t")
    rows = [dict(zip(cols, r)) for r in srows if len(r) == len(cols)]
    say(len(rows) == len(srows) and [r["id"] for r in rows] == [i for i, _ in want_ids],
        "one summary row per expected id, in manifest order")
    for (wid, ext), r in zip(want_ids, rows):
        o = os.path.join(run, wid, "out.openpyxl", wid + "." + ext)
        others = sorted(set(os.listdir(os.path.dirname(o))) - {wid + "." + ext}) if os.path.isdir(os.path.dirname(o)) else ["-"]
        say(r["label"] == "openpyxl", "%s: label openpyxl" % wid)
        say(r["outcome"] == e["OUTCOME"] and r["exit"] == e["EXIT"], "%s: outcome %s, exit %s" % (wid, e["OUTCOME"], e["EXIT"]))
        say(r["lo"] == e["LO"] and r["lo_in"] == "-", "%s: lo %s, lo_in - (ruling C)" % (wid, e["LO"]))
        say(r["leftover"] == "no" and not others, "%s: leftover no, nothing beside the output in its directory" % wid)
        if e["OUTCOME"] == "ok":
            say(os.path.isfile(o) and r["out_bytes"] == str(os.path.getsize(o)),
                "%s: the output keeps the extension %s (ruling D) and out_bytes is its size" % (wid, ext))
            say(r["diff_exit"] in ("0", "1"), "%s: xlsx-diff exit 0 or 1" % wid)
            say(re.fullmatch(r"[0-9]+\.[0-9]{2}", r["wall_s"]) is not None and re.fullmatch(r"[1-9][0-9]*", r["peak_rss_kb"]) is not None,
                "%s: a wall time and a peak RSS" % wid)
            say(any(x[0] == wid and x[1] == "openpyxl" for x in erows), "%s: entries rows under label openpyxl" % wid)
    say(all(len(x) > 1 and x[1] == "openpyxl" for x in erows), "every entries row is under label openpyxl")
    run_cols = e["RUN_H"].replace("\\t", "\t").split("\t")
    ok = len(rrows) == 1 and len(rrows[0]) == len(run_cols)
    r = dict(zip(run_cols, rrows[0])) if ok else {}
    say(ok, "one run row")
    say(r.get("commit") == e["COMMIT"], "the run row's commit is the phase commit")
    say(r.get("image_id") == e["IMG_ID"], "the run row's image id is the image's")
    say(r.get("openpyxl") == "3.1.5", "the run row's openpyxl is 3.1.5")
    say(r.get("ops_sha256") == e["OPS_SHA"] and r.get("xlsx_diff_sha256") == e["XD_SHA"],
        "the run row's ops script and xlsx-diff hashes are the clone's and the built binary's")
    say(r.get("op") == op and r.get("files") == str(len(want_ids)), "the run row's op and file count")
    say((r.get("timeout_s"), r.get("lo_timeout_s"), r.get("memory_mib")) == ("300", "600", "2048"),
        "the run row's settings are the defaults, 300 s, 600 s and 2048 MiB")
    print("\n".join(out))
