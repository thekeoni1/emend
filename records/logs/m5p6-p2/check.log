    # kept beside it, <phase>/superseded/run-script-3/run.stderr. Ruling R: no run is made again; what
    # runs again with the fix named is the checks. This log:
    #   1. names the failing run log by sha256 and quotes its end lines, and
    #      reads its failing check lines: exactly the three ruling Q names;
    #   2. recomputes the sha256 and byte count of every record the run log
    #      installed and matches each against the line the run log printed,
    #      counting matches against the record count (143: 71 record pairs and
    #      the comparison record), every record of the run's stamp on the disk
    #      named by the run log; and recomputes the host keep's listing and
    #      matches its sha256 against the run log's line;
    #   3. runs the restored keep check (keep_pairs_ok) on that listing, and the
    #      corrected record check (its 12 or 18 checks, the family check
    #      ruling Q's) over every record pair, corpus and scale, each pair's run
    #      directory the one the run log's record command named; with ruling Q's
    #      controls;
    #   4. prints the tree state as the run log does;
    #   5. ends "check log checks all as expected: yes|no", its standard error
    #      counted.
    # Nothing here writes a record, a run directory or the keep; every input is
    # read. Never a name or a path under the corpus: run directory names, record
    # stems, counts and hashes only.
    #
    # GENERATED by <phase>/gen/check.py; the shape greps, the status pattern,
    # the record check program with keep_pairs_ok and ruling Q's controls, the
    # status block and the standard error block are carried from the
    # regenerated run script <phase>/scripts/m5p6-p2-run.sh (sha256 asserted by
    # the generator), the rest is this log's.
    #
    # Usage: m5p6-p2-check.sh <phase commit> <the failing run log> > <file
    # outside the tree>; the caller moves the output to
    # records/logs/m5p6-p2/check.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/check.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    RUN_LOG=${2:?the failing run log required}
    # Every environment input, as it was set, before any is unset.
    INPUT_NAMES="RUN_KEEP EMEND_CORPUS_DIR EMEND_KEEP_DIR HOME"
    declare -A INPUT_SEEN
    for v in $INPUT_NAMES; do
      if [ -n "${!v+x}" ]; then INPUT_SEEN[$v]=${!v}; else INPUT_SEEN[$v]=unset; fi
    done
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    SCALE=$CORPUS/scale
    # Python writes no bytecode, so nothing arises to be removed.
    export PYTHONDONTWRITEBYTECODE=1
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR
    SPEC=specs/0037-measurement-and-close.md
    # Change RB: the committed blob the doc commit 09d82ac holds (planning's P2
    # brief, pasted from sha256sum).
    SPEC_WANT=160c2984b483df57b2e2045d111d5655a944d4a2f1a9b56485fb5bad707404b0
    # Rulings Q and R: planning's working spec holding them (planning's message,
    # pasted from sha256sum).
    SPEC_WORKING=ce89ba9c957a650667ed1c856934be86d5327f6741db24e74e7d346c9ebff8d0
    # The eleven ops, in the spec's order, and emend's tool argument for each
    # (ruling O: roundtrip is the passthrough, no tool argument).
    ALL_OPS="roundtrip read edit format insert-rows names table comment image add-chart copy"
    declare -A EDITS=([roundtrip]="" [read]=--read-sample [edit]=--edit-sample [format]=--format-sample [insert-rows]=--insert-rows-sample [names]=--names-sample [table]=--table-sample [comment]=--comment-sample [image]=--image-sample [add-chart]=--add-chart-sample [copy]=--copy-sample)
    PHASE_DIR=$HOME/.cache/emend-build/m5p6-p2
    KEEP=${RUN_KEEP:-$PHASE_DIR/keep-host}
    RUN_OUT_ROOT=$CORPUS/runs
    RUN_SCALE_OUT=$SCALE/runs
    # The record count: 22 corpus pairs, 48 scale pairs (tiers a and b every
    # op, c and d roundtrip, two tools), the open pair, and the comparison
    # record.
    N_PAIRS_CHECKED_WANT=70
    N_RECORDS_WANT=143
    # TMPDIR is <scratch>/tmp, the phase's directory's, made and exported before
    # any mktemp (close-out ruling 1); the working directory is the one mktemp
    # -d makes under it, on the disk, kept; nothing here is removed.
    TMPDIR=$PHASE_DIR/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    B=$(mktemp -d) || exit 2
    # The counting library is the phase commit's, by git show.
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    if [ ! -f "$RUN_LOG" ]; then echo "the run log names no file" >&2; exit 2; fi
    if [ ! -d "$KEEP" ]; then echo "the keep is not there" >&2; exit 2; fi
    if [ ! -f "$PHASE_DIR/superseded/run-script-3/run.stderr" ]; then echo "the run script's kept standard error is not there" >&2; exit 2; fi
    SHORT=$(git rev-parse --short=7 "$C")
    # The run's stamp is the run log's, read from its record stems line: the
    # run was made on its date, not this log's.
    RUN=$(sed -n 's/^the record stems: m5p6-<op>-\([0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}-[0-9a-f]\{7\}\), .*/\1/p' "$RUN_LOG")
    case $RUN in *-"$SHORT") ;; *) echo "the run log's record stems line names no stamp of the phase commit" >&2; exit 2 ;; esac
    DATE=${RUN%-"$SHORT"}
    # Change RI: what the status pattern admits: this phase's log directory,
    # its record pairs (named by the run's date and the phase commit's short
    # sha, untracked), the comparison record and planning's modified specs/0037;
    # nothing else.
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m5p6-p2/|\\?\\? records/m5p6-(openpyxl-)?(scale-[abcd]-)?(roundtrip|read|edit|format|insert-rows|names|table|comment|image|add-chart|copy)-$DATE-$SHORT[.](md|txt)\$|\\?\\? records/m5p6-open-$DATE-$SHORT[.](md|txt)\$|\\?\\? records/compare-m5p6-$DATE-$SHORT[.]md\$| M specs/0037-measurement-and-close[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs, records and planning's spec" >&2
      exit 2
    fi
    STEM_OPEN=m5p6-open-$DATE-$SHORT
    STEM_COMPARE=compare-m5p6-$DATE-$SHORT
    
    # The scale runs' parent and the scale directory begin with the corpus's
    # path, which begins with <repo>'s parent's; so they are replaced first, the
    # corpus runs and the corpus next, the phase's directories before <phase>,
    # and <home> last.
    scrub() {
      sed -e "s#$B#<work>#g" -e "s#$TMPDIR#<scratch>/tmp#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$KEEP#<keep>#g" \
        -e "s#$RUN_SCALE_OUT#<scaleruns>#g" -e "s#$SCALE#<scale>#g" \
        -e "s#$RUN_OUT_ROOT#<runs>#g" -e "s#$CORPUS#<corpus>#g" \
        -e "s#$MAIN#<repo>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M5 part 6 P2 check log (rulings Q and R) at the phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo "input (as exported by this script): PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE"
    echo "input: TMPDIR=$TMPDIR"
    echo "  (TMPDIR set, made and exported by this script before any mktemp; <work> is made under it: close-out ruling 1)"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "root: <repo> stands for the repository's top level (inside <home>, scrubbed after the corpus's paths); scripts/counting.sh is read from it at the phase commit by git show; scripts/passthrough-record.py is read from it (its part-family rules), checked equal to the phase commit's; the installed records are read under its records/"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m5p6-p2 on the disk, the phase's directory; <phase>/gen holds the generator that wrote this script, <phase>/logs/run.log is the failing run log"
    echo "root: <scratch> stands for <phase>, the phase's directory, named <scratch> where TMPDIR is concerned: TMPDIR is <scratch>/tmp, made and exported by this script before any mktemp, and <work> is made under it (close-out ruling 1)"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory; this script's own standard error goes to <scripts>/out/check.stderr (specs/0017 P1 verification ruling 7), and the run log's record lines name <scripts>/out/records, where it wrote the records first"
    echo "root: <work> stands for this log's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (the counting library, the checks' programs and outputs), kept after the run and never removed"
    echo "root: <keep> stands for <phase>/keep-host on the disk unless RUN_KEEP names another for a dry run, the run log's host keep, read"
    echo "root: <corpus> stands for the private corpus directory, not read here beyond its run directories"
    echo "root: <runs> stands for the corpus run directories' parent, <corpus>/runs; the run log's corpus run directories <runs>/$RUN-<op> and <runs>/$RUN-openpyxl-<op> are read"
    echo "root: <scale> stands for the scale directory, <corpus>/scale, not read here beyond its run directories"
    echo "root: <scaleruns> stands for the scale run directories' parent, <scale>/runs; the run log's scale run directories <scaleruns>/$RUN-scale-<tier>-<op> and <scaleruns>/$RUN-openpyxl-scale-<tier>-<op> are read"
    echo "the run's stamp, from the run log's record stems line: $RUN; the record stems: m5p6-<op>-$RUN, m5p6-openpyxl-<op>-$RUN, m5p6-scale-<tier>-<op>-$RUN, m5p6-openpyxl-scale-<tier>-<op>-$RUN, $STEM_OPEN and $STEM_COMPARE"
    echo
    echo "## the spec, pinned at the doc commit (change RB), and planning's working copy"
    DOC=$(git log --format='%H' -n 1 -F --grep='M5 part 6 P2: commit planning docs (the P1 verification and rulings)')
    echo "command: git log --format=%H -n 1 -F --grep=<the doc commit's subject>: ${DOC:-none}"
    SPEC_AT_DOC=$(git show "$DOC:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "the spec pin: $SPEC at the doc commit, git show <doc commit>:$SPEC | sha256sum: $SPEC_AT_DOC"
    echo "  the working file: sha256 $(sha_of "$SPEC") (planning's, rulings L to R, uncommitted)"
    check "the doc commit's spec is the pin, $SPEC_WANT" "$(yn [ "$SPEC_AT_DOC" = "$SPEC_WANT" ])"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change NTJ: the fourth shape, PYB: a Python call without -I -B (the word
    # followed by whitespace and an option or a .py path, outside a comment,
    # and not by " -I -B"). The word is built from two halves, so that this
    # form's own text is no call.
    PYW=pyth
    PYW=${PYW}on3
    pyb_count() {
      awk -v w="$PYW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { r = substr(s, i + length(w)); if (r ~ /^[ \t]+(-|[^ \t]*[.]py([ \t"]|$))/ && r !~ /^ -I -B( |$)/) { n++; break }; s = r }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "$PYW -c x" "$PYW -I -B -c x" "# $PYW -c x" "command -v $PYW" "$PYW tool.py" >"$B/pyb-fixture"
    n_self=$(pyb_count "$SELF")
    n_fix=$(pyb_count "$B/pyb-fixture")
    echo "command: pyb_count <this script>, and the same over a fixture of five lines: a call with -c, one with -I -B -c, a comment, a command -v, a call of a .py path"
    echo "  shape PYB: in this script $n_self; in the fixture $n_fix"
    check "PYB: this script holds none (change NTJ)" "$(yn [ "$n_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's two calls without -I -B and not its other three lines" "$(yn [ "$n_fix" = 2 ])"
    
    
    echo
    echo "## 1. the failing run log (ruling R item 1)"
    echo "command: sha256sum, wc -c and wc -l of <phase>/logs/run.log; tail -n 2 of it"
    echo "  the run log: sha256 $(sha_of "$RUN_LOG"), $(wc -c <"$RUN_LOG") bytes, $(count_lines "$RUN_LOG") lines"
    tail -n 2 "$RUN_LOG" | sed 's/^/    its end lines: /'
    check "its last line is \"run log checks all as expected: no\"" "$(yn [ "$(tail -n 1 "$RUN_LOG")" = "run log checks all as expected: no" ])"
    ended_ok() { tail -n 2 "$RUN_LOG" | head -n 1 | LC_ALL=C "$G" -qxE 'run ended at [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z'; }
    check "the line before it is the run's \"run ended at\" line" "$(yn ended_ok)"
    # A check line is two blanks, then the name; the printed script and the
    # programs' outputs are indented four.
    LC_ALL=C "$G" -E '^  [^ ].*: no$' "$RUN_LOG" >"$B/run.failing"
    echo "  the run log's failing check lines (two blanks, then a name ending \": no\"): $(count_lines "$B/run.failing")"
    sed 's/^/    /' "$B/run.failing"
    printf '%s\n' \
      "  m5p6-openpyxl-image-$RUN: the record's three tables are the run directory's, its family tables are counted from them, and its tool line is the label's (12 checks): no" \
      "  the host keep's pairs times two equals its files (keep_pairs_ok): no" \
      "  this script wrote nothing to its standard error: no" >"$B/run.failing.want"
    check "they are exactly the three ruling Q names: the openpyxl image record's check block, keep_pairs_ok and the script's standard error" "$(yn cmp -s "$B/run.failing" "$B/run.failing.want")"
    printf '  planted: no\n' | cat "$B/run.failing" - >"$B/c-run.failing"
    check "control: the same comparison refuses the list with one planted failing line" "$(ynnot cmp -s "$B/c-run.failing" "$B/run.failing.want")"
    fam_no() { [ "$(count_matches -xF "    openpyxl: the xml families are the changed entries' families: no" "$RUN_LOG")" = 1 ]; }
    check "within the image record's block, the one sub-check read no is the family check ruling Q narrows" "$(yn fam_no)"
    LC_ALL=C "$G" -E '^    [^ #].*: no$' "$RUN_LOG" >"$B/run.sub.failing"
    echo "  the run log's sub-check lines that read no (four blanks, then a name that is not a printed comment, ending \": no\"): $(count_lines "$B/run.sub.failing")"
    sed 's/^/      /' "$B/run.sub.failing"
    sub_one() { [ "$(count_lines "$B/run.sub.failing")" = 1 ]; }
    check "the family check is the run log's only sub-check that read no" "$(yn sub_one)"
    RUN_ERR=$PHASE_DIR/superseded/run-script-3/run.stderr
    echo "  the run log's own count of its standard error: $(LC_ALL=C "$G" -xE '  command: wc -c <scripts>/out/run.stderr: [0-9]+ bytes; a copy with one byte appended: [0-9]+' "$RUN_LOG" | sed 's/^ *//')"
    echo "command: wc -c and cat of <phase>/superseded/run-script-3/run.stderr, the run script's standard error kept beside it"
    echo "  bytes: $(wc -c <"$RUN_ERR"); lines: $(count_lines "$RUN_ERR"); its one line (scrubbed): $(cat "$RUN_ERR")"
    err_count_ok() { [ "$(count_matches -xF "  command: wc -c <scripts>/out/run.stderr: $(wc -c <"$RUN_ERR") bytes; a copy with one byte appended: $(( $(wc -c <"$RUN_ERR") + 1 ))" "$RUN_LOG")" = 1 ]; }
    check "the kept standard error's byte count is the one the run log printed" "$(yn err_count_ok)"
    err_line_ok() { [ "$(count_lines "$RUN_ERR")" = 1 ] && [ "$(count_matches -E ': line [0-9]+: keep_pairs_ok: command not found$' "$RUN_ERR")" = 1 ]; }
    check "it is one line, keep_pairs_ok's \"command not found\"" "$(yn err_line_ok)"
    
    echo
    echo "## 2. the installed records and the keep's listing against the run log's lines (ruling R item 2)"
    echo "command: the run log's lines \"installed records/<file>: sha256 <hex>, <n> bytes, mode 644\"; sha256sum, wc -c and stat -c %a of each records/<file> in <repo>"
    sed -nE 's/^    installed records\/([^:]+): sha256 ([0-9a-f]{64}), ([0-9]+) bytes, mode ([0-7]+)$/\1\t\2\t\3\t\4/p' "$RUN_LOG" >"$B/inst.lines"
    cut -f1 "$B/inst.lines" | LC_ALL=C sort -u >"$B/inst.names"
    n_lines=$(count_lines "$B/inst.lines")
    n_names=$(count_lines "$B/inst.names")
    : >"$B/inst.match"
    : >"$B/inst.differ"
    while IFS="$TAB" read -r f h n m; do
      if [ -f "records/$f" ] && [ "$(sha_of "records/$f")" = "$h" ] && [ "$(wc -c <"records/$f")" = "$n" ] && [ "$(stat -c %a "records/$f")" = "$m" ] && [ "$m" = 644 ]; then
        printf '%s\n' "$f" >>"$B/inst.match"
      else
        printf '%s\n' "$f" >>"$B/inst.differ"
      fi
    done <"$B/inst.lines"
    n_match=$(count_lines "$B/inst.match")
    echo "  installed-record lines in the run log: $n_lines; distinct files: $n_names; files whose sha256, bytes and mode 644 are the line's now: $n_match; that differ: $(count_lines "$B/inst.differ")"
    sed 's/^/    differs: /' "$B/inst.differ"
    inst_each_once() { [ "$n_lines" = "$N_RECORDS_WANT" ] && [ "$n_names" = "$N_RECORDS_WANT" ]; }
    check "the run log names $N_RECORDS_WANT installed records, each once" "$(yn inst_each_once)"
    check "every one of them matches its line: $n_match of $N_RECORDS_WANT" "$(yn [ "$n_match" = "$N_RECORDS_WANT" ])"
    (cd records && find . -maxdepth 1 -type f \( -name "m5p6-*-$RUN.md" -o -name "m5p6-*-$RUN.txt" -o -name "$STEM_COMPARE.md" \) -printf '%P\n' | LC_ALL=C sort) >"$B/disk.names"
    echo "  record files of the run's stamp under records/ on the disk: $(count_lines "$B/disk.names")"
    check "they are exactly the files the run log installed" "$(yn cmp -s "$B/disk.names" "$B/inst.names")"
    inst_one=$(head -n 1 "$B/inst.lines")
    cp "records/${inst_one%%"$TAB"*}" "$B/c-record"; printf 'x' >>"$B/c-record"
    sha_ctl() { [ "$(sha_of "$B/c-record")" != "$(printf '%s' "$inst_one" | cut -f2)" ]; }
    check "control: the first installed record with one byte appended does not match its line" "$(yn sha_ctl)"
    check "the run log's count of installed records reads $N_RECORDS_WANT, yes" "$(yn [ "$(count_matches -F "  this run installed the record files it writes ($N_RECORDS_WANT: " "$RUN_LOG")" = 1 ])"
    inst_count_yes() { [ "$(LC_ALL=C "$G" -F "  this run installed the record files it writes ($N_RECORDS_WANT: " "$RUN_LOG" | LC_ALL=C "$G" -c ': yes$')" = 1 ]; }
    check "and that check line of the run log reads yes" "$(yn inst_count_yes)"
    echo "command: (cd <keep> && find . -type f -printf '%P\\t%s\\n' | LC_ALL=C sort), the run log's listing form"
    (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/keep.listing"
    KEEP_SHA_LOG=$(sed -nE "s/^  the host keep's listing: pairs [0-9]+; files [0-9]+; listing sha256 ([0-9a-f]{64})$/\\1/p" "$RUN_LOG")
    echo "  the host keep's listing now: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/keep.listing"); files $(count_lines "$B/keep.listing"); listing sha256 $(sha_of "$B/keep.listing"); the run log's: ${KEEP_SHA_LOG:-none}"
    check "the keep's listing sha256 is the run log's" "$(yn [ "$(sha_of "$B/keep.listing")" = "$KEEP_SHA_LOG" ])"
    printf 'x.1.in.xlsx\t1\n' | cat "$B/keep.listing" - >"$B/c-keep-extra.listing"
    check "control: the listing with one planted line does not read the run log's sha256" "$(yn [ "$(sha_of "$B/c-keep-extra.listing")" != "$KEEP_SHA_LOG" ])"
    
    echo
    echo "## 3. the restored keep check and the corrected record check (ruling R item 3, ruling Q)"
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names. Change VJ: the dropped families are an
    input, as the changed and added ones are. Change RE (M5 part 6 P2): the
    openpyxl label is read as the two emend labels are, and the last input is
    the whole tool line the label's record carries. Change RL (ruling Q): the
    family check is xml_fams_ok's, the xml families against the changed
    entries' xml families; with --xml-fams <record script> <entries table>
    <xml rows> it reads that rule alone over planted tables."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    XML_FAMS = sys.argv[1] == "--xml-fams"
    if XML_FAMS:
        rec_script, ctl_entries, ctl_xml = sys.argv[2:5]
    else:
        rec_script, run_dir, txt, md, want_changed, want_added, want_dropped, tool_arg = sys.argv[1:9]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    def listed(value):
        return value.split(",") if value else []
    
    
    def xml_fams_ok(e, x):
        """Ruling Q: the families of the xml rows `x` (this program's form: id,
        label, then the diff table's xml row) are the families of the changed
        entries of the entries table `e` (its header first) that have an xml
        row, matched by workbook id and entry name."""
        head = e[0].split("\t")
        have = set()
        xfams = set()
        for line in x:
            c = line.split("\t")
            if c[4] == "parse":
                have.add((c[0], c[3]))
                xfams.add(record.family(c[3]))
        changed = set()
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            if r["status"] == "changed" and (r["id"], r["name"]) in have:
                changed.add(record.family(r["name"]))
        return sorted(xfams) == sorted(changed)
    
    
    if XML_FAMS:
        print("xml_fams_ok: %s" % ("yes" if xml_fams_ok(lines(ctl_entries), lines(ctl_xml)) else "no"))
        sys.exit(0)
    
    
    labels = [l for l in ("host", "i686", "openpyxl") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        changed_f = sorted(f for f in fam if fam[f].get("changed"))
        dropped_f = sorted(f for f in fam if fam[f].get("dropped"))
        added_f = sorted(f for f in fam if fam[f].get("added"))
        checks.append(("%s: the xml families are the changed entries' xml families (ruling Q)" % label, xml_fams_ok(e, x)))
        checks.append(("%s: the changed entries' families are %s" % (label, want_changed or "none"), changed_f == listed(want_changed)))
        checks.append(("%s: the dropped entries' families are %s" % (label, want_dropped or "none"), dropped_f == listed(want_dropped)))
        checks.append(("%s: the added entries' families are %s" % (label, want_added or "none"), added_f == listed(want_added)))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's tool line", tool_arg in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    fams_of() {
      python3 -I -B -c 'import importlib.util, sys
    spec = importlib.util.spec_from_file_location("record", sys.argv[1])
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    rows = [l.split("\t", 1) for l in open(sys.argv[2]).read().split("\n") if l]
    print(",".join(sorted({record.family(n) for (k, n) in rows if k == sys.argv[3]})))' scripts/passthrough-record.py "$1" "$2"
    }
    # Change JI: no bytecode was written, so there is nothing to remove.
    no_pycache() { [ ! -e scripts/__pycache__ ]; }
    echo
    echo "## the record check's xml-family rule over planted tables (ruling Q, change RL)"
    printf 'id\tname\tstatus\nw1\txl/media/image1.png\tchanged\nw1\txl/worksheets/sheet1.xml\tchanged\n' >"$B/c-fam-media.entries"
    printf 'id\tname\tstatus\nw1\txl/media/image1.png\tchanged\nw1\txl/worksheets/sheet1.xml\tidentical\n' >"$B/c-fam-extra.entries"
    printf 'w1\thost\txml\txl/worksheets/sheet1.xml\tparse\tok\tok\t\t0\t0\n' >"$B/c-fam.xml"
    echo "command: python3 -I -B <work>/reccheck.py --xml-fams scripts/passthrough-record.py <entries> <xml>, over two planted entries tables and one xml row (xl/worksheets/sheet1.xml of workbook w1)"
    python3 -I -B "$B/reccheck.py" --xml-fams scripts/passthrough-record.py "$B/c-fam-media.entries" "$B/c-fam.xml" >"$B/c-fam-media.out" 2>&1
    python3 -I -B "$B/reccheck.py" --xml-fams scripts/passthrough-record.py "$B/c-fam-extra.entries" "$B/c-fam.xml" >"$B/c-fam-extra.out" 2>&1
    echo "    a changed media entry with no xml row and a changed worksheet with one: $(cat "$B/c-fam-media.out")"
    echo "    a changed media entry and the worksheet identical, the xml row naming the worksheet: $(cat "$B/c-fam-extra.out")"
    check "the rule reads yes on an entries table with a changed media entry and no xml row for it" "$(yn [ "$(cat "$B/c-fam-media.out")" = 'xml_fams_ok: yes' ])"
    check "control: the rule reads no on an xml table naming a family with no changed entry" "$(yn [ "$(cat "$B/c-fam-extra.out")" = 'xml_fams_ok: no' ])"
    echo
    echo "## keep_pairs_ok and its planted controls (ruling Q, change RK; M5 part 5 P4's form)"
    # keep_pairs_ok <listing>: the .in.xlsx lines times two equal the listing's
    # lines (the pattern in double quotes so the tab is interpolated).
    keep_pairs_ok() {
      local pairs files
      pairs=$(count_matches -E "[.]in[.]xlsx${TAB}" "$1")
      files=$(count_lines "$1")
      [ "$files" -ge 2 ] && [ "$((pairs * 2))" = "$files" ]
    }
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\n' "$TAB" "$TAB" >"$B/c-keep.listing"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\ny.1.out.xlsx%s1\n' "$TAB" "$TAB" "$TAB" >"$B/c-keep-odd.listing"
    echo "  planted keep listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep.listing"), files $(count_lines "$B/c-keep.listing"); with an unpaired output: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep-odd.listing"), files $(count_lines "$B/c-keep-odd.listing")"
    check "keep_pairs_ok passes a planted listing of one whole pair" "$(yn keep_pairs_ok "$B/c-keep.listing")"
    check "control: keep_pairs_ok refuses a planted listing with an unpaired output" "$(ynnot keep_pairs_ok "$B/c-keep-odd.listing")"
    check "the host keep's pairs times two equals its files (keep_pairs_ok, restored)" "$(yn keep_pairs_ok "$B/keep.listing")"
    echo
    echo "## the scripts the record check reads, against the phase commit"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    check "scripts/passthrough-record.py in the main tree is the phase commit's (sha256 $(sha_of scripts/passthrough-record.py))" "$(yn tree_is_commit scripts/passthrough-record.py)"
    
    # rec_check <run directory> <its placeholder form> <stem> <tool line> [--allow-single]:
    # the record pair the run log installed, checked against its run directory
    # by the corrected record check; the run log's record command named that
    # directory for that stem.
    N_CHECKED=0
    N_CHECKED_YES=0
    rec_check() {
      local O=$1 shown=$2 stem=$3 toolline=$4 single=${5:-} nlab fam_label cmd
      echo
      echo "### $stem"
      cmd="command: python3 -I -B scripts/passthrough-record.py --run $shown --out <scripts>/out/records --stem $stem${single:+ $single}"
      echo "  the run log's record command for it: $cmd"
      cmd_once() { [ "$(count_matches -xF "$cmd" "$RUN_LOG")" = 1 ]; }
      check "$stem: the run log ran its record command once, over this run directory" "$(yn cmd_once)"
      if [ -f "$O/summary.openpyxl.tsv" ]; then fam_label=openpyxl; nlab=1; else fam_label=host; nlab=2; fi
      awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] ~ /^(changed|added|dropped)$/ { print $k["status"] "\t" $k["name"] }' "$O/entries.$fam_label.tsv" >"$B/w.parts"
      local FAM_CHANGED FAM_ADDED FAM_DROPPED
      FAM_CHANGED=$(fams_of "$B/w.parts" changed)
      FAM_ADDED=$(fams_of "$B/w.parts" added)
      FAM_DROPPED=$(fams_of "$B/w.parts" dropped)
      echo "  the families of the $fam_label entries table (the run's own, change RE): changed ${FAM_CHANGED:-none}; added ${FAM_ADDED:-none}; dropped ${FAM_DROPPED:-none}"
      echo "command: python3 -I -B <work>/reccheck.py scripts/passthrough-record.py $shown records/$stem.txt records/$stem.md <the families> <the tool line>"
      python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "records/$stem.txt" "records/$stem.md" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$toolline" >"$B/reccheck.out" 2>&1
      echo "  exit: $?"
      sed 's/^/    /' "$B/reccheck.out"
      local want_yes=$((4 + 6 * nlab + 2))
      rec_all() { [ "$(count_matches -E ': yes$' "$B/reccheck.out")" = "$want_yes" ] && [ "$(count_matches -E ': no$' "$B/reccheck.out")" = 0 ]; }
      check "$stem: the record's three tables are the run directory's, its family tables are counted from them, and its tool line is the label's ($want_yes checks, the family check ruling Q's)" "$(yn rec_all)"
      N_CHECKED=$((N_CHECKED + 1))
      if rec_all; then N_CHECKED_YES=$((N_CHECKED_YES + 1)); fi
      check "the record check left no scripts/__pycache__ (PYTHONDONTWRITEBYTECODE)" "$(yn no_pycache)"
    }
    
    echo
    echo "## the corpus record pairs"
    for op in $ALL_OPS; do
      EDIT=${EDITS[$op]}
      if [ -z "$EDIT" ]; then TOOLLINE="- Tool arguments: none"; else TOOLLINE="- Tool arguments: $EDIT"; fi
      rec_check "$RUN_OUT_ROOT/$RUN-$op" "<runs>/$RUN-$op" "m5p6-$op-$RUN" "$TOOLLINE"
      rec_check "$RUN_OUT_ROOT/$RUN-openpyxl-$op" "<runs>/$RUN-openpyxl-$op" "m5p6-openpyxl-$op-$RUN" "- openpyxl: version 3.1.5; op $op" --allow-single
    done
    echo
    echo "## the scale record pairs (tiers a and b every op, c and d roundtrip)"
    for t in a b c d; do
      for op in $ALL_OPS; do
        case $t in a | b) ;; *) [ "$op" = roundtrip ] || continue ;; esac
        EDIT=${EDITS[$op]}
        if [ -z "$EDIT" ]; then TOOLLINE="- Tool arguments: none"; else TOOLLINE="- Tool arguments: $EDIT"; fi
        rec_check "$RUN_SCALE_OUT/$RUN-openpyxl-scale-$t-$op" "<scaleruns>/$RUN-openpyxl-scale-$t-$op" "m5p6-openpyxl-scale-$t-$op-$RUN" "- openpyxl: version 3.1.5; op $op" --allow-single
        rec_check "$RUN_SCALE_OUT/$RUN-scale-$t-$op" "<scaleruns>/$RUN-scale-$t-$op" "m5p6-scale-$t-$op-$RUN" "$TOOLLINE"
      done
    done
    echo
    echo "## the record check's totals"
    echo "  record pairs checked: $N_CHECKED; of them every check yes: $N_CHECKED_YES; the run log's record commands: $(count_matches -E '^command: python3 -I -B scripts/passthrough-record.py --run ' "$RUN_LOG")"
    check "every record pair the run log wrote is checked here: $N_CHECKED of $N_PAIRS_CHECKED_WANT" "$(yn [ "$N_CHECKED" = "$N_PAIRS_CHECKED_WANT" ])"
    check "the run log ran exactly that many record commands" "$(yn [ "$(count_matches -E '^command: python3 -I -B scripts/passthrough-record.py --run ' "$RUN_LOG")" = "$N_PAIRS_CHECKED_WANT" ])"
    check "every record pair reads every check yes: $N_CHECKED_YES of $N_PAIRS_CHECKED_WANT" "$(yn [ "$N_CHECKED_YES" = "$N_PAIRS_CHECKED_WANT" ])"
    reccheck_ctl() {
      python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$RUN_OUT_ROOT/$RUN-openpyxl-image" "records/m5p6-openpyxl-image-$RUN.txt" "records/m5p6-openpyxl-image-$RUN.md" "" "" "" "- openpyxl: version 3.1.5; op planted" >"$B/c-reccheck.out" 2>&1
      [ "$(count_matches -E ': no$' "$B/c-reccheck.out")" -ge 1 ]
    }
    check "control: the record check refuses the openpyxl image record against a planted op and no families" "$(yn reccheck_ctl)"
    
    echo
    echo "## 4. the tree (ruling R item 4)"
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m5p6-p2/run.log\n?? records/m5p6-edit-%s-%s.md\n?? records/m5p6-openpyxl-scale-b-copy-%s-%s.txt\n?? records/m5p6-open-%s-%s.txt\n?? records/compare-m5p6-%s-%s.md\n?? records/logs/m5p6-p1/run.log\n?? records/m5p6-edit-%s-abcdef0.md\n?? records/m5p6-p1-edit-%s-%s.md\n?? records/m5p6-scale-e-copy-%s-%s.md\n?? records/logs/m5p6-p2x/run.log\n M ROADMAP.md\n M specs/0036-charts-write-second-set.md\n M records/m5p6-edit-%s-%s.md\n M scripts/compare-run.sh\n' "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$SHORT" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern admits this phase's log, an op's record, a scale record, the open and comparison records at this commit alone; it refuses another phase's log, a record of another commit, a record stem with another word, a tier that is not one of the four, a sibling directory, ROADMAP.md, specs/0036, a modified record and a source file (change RI)" "$(yn [ "$(ours_rec_ctl)" = 5 ])"
    echo "## status after the checks"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  planning's uncommitted spec: $SPEC, sha256 $(sha_of "$SPEC")"
    echo "status lines: $st_all; of them this phase's logs, its record pairs or planning's uncommitted spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    check "planning's working spec is the one holding rulings Q and R ($SPEC_WORKING)" "$(yn [ "$(sha_of "$SPEC")" = "$SPEC_WORKING" ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources (the phase commit's, by git show)"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/check.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "check ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "check log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources (the phase commit's, by git show)
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
  control count_matches with a regular expression: 2 (expect 2)
