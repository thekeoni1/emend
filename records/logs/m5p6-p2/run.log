    #      outputs by sha256, their lines and their diff tables P2's runs' byte
    #      for byte (change VF's form for three samples), the run directories
    #      read from the "the run directories:" line of P2's run log at P2's
    #      record commit and checked against the run directory P2's committed
    #      anchor record names; no record pair is written for the reruns.
    #  XG. Change UG's no-row rule gives way: the copy makes the write a formula
    #      change when S holds a formula (specs/0013's rule, "The copy"), so
    #      each chain workbook's calcChain row is dropped exactly there, and is
    #      identical and unflagged elsewhere; some row is dropped.
    #  XH. Change PH (the open check's own TMPDIR device) stands, unchanged.
    #  XI. The plants: every flag's planted control runs on the first ok
    #      workbook in manifest order of the plain case (S's comments not
    #      carried) and of the carried case, each on its own check line, the
    #      plant turning its own flag; every flag has a plant on both cases.
    #      The xml values check wants some value written (the workbook's new
    #      sheet; change LF's form).
    #  XJ. The run loop, the record pair, the keep and the open check are VJ's
    #      with this phase's names; the record's families are derived from its
    #      entries table, which the rule checked row by row; four record files
    #      installed, two when the keep is skipped.
    #  XK. Ruling 8 of the planning rulings during P2 (build pruning) and
    #      ruling 10 of the planning rulings during P3 (one target root per
    #      phase, one subdirectory per source tree): the phase's target root is
    #      <target>, <home>/.cache/emend-build/m3p6-p3/target, and every build
    #      of <repo> by this script, dry or logged, goes into <target>/main
    #      (CARGO_TARGET_DIR), the subdirectory ruling 10 gives the main tree;
    #      this script builds from no other tree. P2's <build> placeholder (a
    #      run directory holding its own target) is gone with the input
    #      RUN_BUILD_ROOT, so no run moves the builds, and nothing here cleans
    #      them; the i686 keep is <work>/keep-i686, kept, not under the target.
    #      VK stands: this script runs no `rm -rf`.
    #
    # Usage: m5p6-p2-run.sh <phase commit> > <file outside the tree>; the caller
    # moves the output to records/logs/m5p6-p2/run.log (change RA).
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    # Every environment input, as it was set, before any is unset.
    INPUT_NAMES="RERUN_NOTE RERUN_FILES RECORDS_DEST RUN_KEEP RUN_OUT_ROOT RUN_SCALE_OUT RUN_SKIP_KEEP RUN_IDS RUN_OPS RUN_SCALE_TIERS EMEND_CORPUS_DIR EMEND_KEEP_DIR HOME"
    declare -A INPUT_SEEN
    for v in $INPUT_NAMES; do
      if [ -n "${!v+x}" ]; then INPUT_SEEN[$v]=${!v}; else INPUT_SEEN[$v]=unset; fi
    done
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    SCALE=$CORPUS/scale
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    # Python writes no bytecode, so nothing arises to be removed.
    export PYTHONDONTWRITEBYTECODE=1
    # Every cargo command of this log runs offline; the two settings are printed below.
    export CARGO_NET_OFFLINE=true
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR RUSTDOCFLAGS RUSTFLAGS
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    OX_IMAGE=localhost/emend-openpyxl:3.1.5-dfsg-2-deb13
    LO_TIMEOUT_S=600
    SPEC=specs/0037-measurement-and-close.md
    # Change RB: the committed blob the doc commit 09d82ac holds (planning's P2
    # brief, pasted from sha256sum).
    SPEC_WANT=160c2984b483df57b2e2045d111d5655a944d4a2f1a9b56485fb5bad707404b0
    IMAGE_RECORD=records/openpyxl-image-2026-10-16.md
    # The eleven ops, in the spec's order, and emend's tool argument for each
    # (ruling O: roundtrip is the passthrough, no tool argument).
    ALL_OPS="roundtrip read edit format insert-rows names table comment image add-chart copy"
    declare -A EDITS=([roundtrip]="" [read]=--read-sample [edit]=--edit-sample [format]=--format-sample [insert-rows]=--insert-rows-sample [names]=--names-sample [table]=--table-sample [comment]=--comment-sample [image]=--image-sample [add-chart]=--add-chart-sample [copy]=--copy-sample)
    PHASE_DIR=$HOME/.cache/emend-build/m5p6-p2
    # Every build of <repo> goes into the main tree's subdirectory of the
    # phase's one target root, <target>/main; nothing here cleans it.
    TARGET_ROOT=$PHASE_DIR/target
    BUILD_ROOT=$TARGET_ROOT/main
    KEEP=${RUN_KEEP:-$PHASE_DIR/keep-host}
    RUN_OUT_ROOT=${RUN_OUT_ROOT:-$CORPUS/runs}
    RUN_SCALE_OUT=${RUN_SCALE_OUT:-$SCALE/runs}
    RUN_SKIP_KEEP=${RUN_SKIP_KEEP:-no}
    case $RUN_SKIP_KEEP in yes | no) ;; *) echo "RUN_SKIP_KEEP is yes or no" >&2; exit 2 ;; esac
    # Changes RD and RG: a dry run may restrict the ops, the corpus ids and the
    # scale tiers; the logged run sets none of the three.
    OPS=${RUN_OPS:-$ALL_OPS}
    for op in $OPS; do
      case " $ALL_OPS " in *" $op "*) ;; *) echo "RUN_OPS names an op that is not one of the eleven" >&2; exit 2 ;; esac
    done
    TIERS=${RUN_SCALE_TIERS:-a b c d}
    for t in $TIERS; do
      case $t in a | b | c | d) ;; *) echo "RUN_SCALE_TIERS names a tier that is not a, b, c or d" >&2; exit 2 ;; esac
    done
    RUN_IDS=${RUN_IDS:-}
    if [ -n "$RUN_IDS" ] && [ ! -f "$RUN_IDS" ]; then echo "RUN_IDS names no file" >&2; exit 2; fi
    RESTRICTED=no
    if [ -n "${RUN_OPS:-}" ] || [ -n "${RUN_SCALE_TIERS:-}" ] || [ -n "$RUN_IDS" ]; then RESTRICTED=yes; fi
    INSTALLED=()
    I686=i686-unknown-linux-musl
    RECORDS_DEST=${RECORDS_DEST:-records}
    if [ "$RUN_SKIP_KEEP" = no ] && [ -e "$KEEP" ]; then echo "$KEEP is already there; move it aside first" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT
    RECORDS=$SELF_DIR/out/records
    # TMPDIR is <scratch>/tmp, the phase's directory's, made and exported before
    # any mktemp (close-out ruling 1); the working directory is the one mktemp
    # -d makes under it, on the disk, kept; nothing here is removed.
    TMPDIR=$PHASE_DIR/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    B=$(mktemp -d) || exit 2
    # The counting library is the phase commit's, by git show.
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT=$(git rev-parse --short=7 "$C")
    DATE=$(date -u +%Y-%m-%d)
    RUN=$DATE-$SHORT
    # Change RI: what the status pattern admits: this phase's log directory,
    # its record pairs (named by the run's date and the phase commit's short
    # sha, untracked), the comparison record and planning's modified specs/0037;
    # nothing else.
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m5p6-p2/|\\?\\? records/m5p6-(openpyxl-)?(scale-[abcd]-)?(roundtrip|read|edit|format|insert-rows|names|table|comment|image|add-chart|copy)-$DATE-$SHORT[.](md|txt)\$|\\?\\? records/m5p6-open-$DATE-$SHORT[.](md|txt)\$|\\?\\? records/compare-m5p6-$DATE-$SHORT[.]md\$| M specs/0037-measurement-and-close[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs, records and planning's spec" >&2
      exit 2
    fi
    STEM_OPEN=m5p6-open-$DATE-$SHORT
    STEM_COMPARE=compare-m5p6-$DATE-$SHORT
    mkdir -p "$RECORDS" "$RECORDS_DEST" || exit 2
    # The run directories this log writes, each refused if it is there already
    # (the runners refuse an earlier run's directories themselves too).
    SCALE_PLAN=""
    for t in $TIERS; do
      for op in $OPS; do
        case $t in a | b) SCALE_PLAN="$SCALE_PLAN $t:$op" ;; *) [ "$op" = roundtrip ] && SCALE_PLAN="$SCALE_PLAN $t:$op" ;; esac
      done
    done
    for op in $OPS; do
      for d in "$RUN_OUT_ROOT/$RUN-$op" "$RUN_OUT_ROOT/$RUN-openpyxl-$op"; do
        if [ -e "$d" ]; then echo "$d is already there; name a fresh run" >&2; exit 2; fi
      done
      for stem in "m5p6-$op-$RUN" "m5p6-openpyxl-$op-$RUN"; do
        for f in "$RECORDS/$stem.md" "$RECORDS/$stem.txt" "$RECORDS_DEST/$stem.md" "$RECORDS_DEST/$stem.txt"; do
          if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
        done
      done
    done
    for tp in $SCALE_PLAN; do
      t=${tp%%:*}; op=${tp#*:}
      for d in "$RUN_SCALE_OUT/$RUN-scale-$t-$op" "$RUN_SCALE_OUT/$RUN-openpyxl-scale-$t-$op"; do
        if [ -e "$d" ]; then echo "$d is already there; name a fresh run" >&2; exit 2; fi
      done
    done
    for f in "$RECORDS/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS/$STEM_COMPARE.md" "$RECORDS_DEST/$STEM_COMPARE.md"; do
      if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
    done
    
    # The scale runs' parent and the scale directory begin with the corpus's
    # path, which begins with <repo>'s parent's; so they are replaced first, the
    # corpus runs and the corpus next, the phase's directories before <phase>,
    # and <home> last.
    scrub() {
      sed -e "s#$B#<work>#g" -e "s#$TMPDIR#<scratch>/tmp#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$KEEP#<keep>#g" \
        -e "s#$TARGET_ROOT#<target>#g" -e "s#$RUN_SCALE_OUT#<scaleruns>#g" -e "s#$SCALE#<scale>#g" \
        -e "s#$RUN_OUT_ROOT#<runs>#g" -e "s#$CORPUS#<corpus>#g" \
        -e "s#$MAIN#<repo>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M5 part 6 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # The environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo "input (as exported by this script): PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE CARGO_NET_OFFLINE=$CARGO_NET_OFFLINE"
    echo "input: TMPDIR=$TMPDIR"
    echo "  (TMPDIR set, made and exported by this script before any mktemp; <work> is made under it: close-out ruling 1)"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "the ops run: $OPS; the scale tiers run: $TIERS; the corpus ids: $([ -n "$RUN_IDS" ] && echo "the $(count_lines "$RUN_IDS") of RUN_IDS" || echo "every manifest row")"
    if [ "$RESTRICTED" = yes ]; then
      echo "RESTRICTED: a dry run (RUN_OPS, RUN_IDS or RUN_SCALE_TIERS set): the comparison record and its re-derivation are skipped below, and every count expected is the restricted one"
    fi
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change NTJ: the fourth shape, PYB: a Python call without -I -B (the word
    # followed by whitespace and an option or a .py path, outside a comment,
    # and not by " -I -B"). The word is built from two halves, so that this
    # form's own text is no call.
    PYW=pyth
    PYW=${PYW}on3
    pyb_count() {
      awk -v w="$PYW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { r = substr(s, i + length(w)); if (r ~ /^[ \t]+(-|[^ \t]*[.]py([ \t"]|$))/ && r !~ /^ -I -B( |$)/) { n++; break }; s = r }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "$PYW -c x" "$PYW -I -B -c x" "# $PYW -c x" "command -v $PYW" "$PYW tool.py" >"$B/pyb-fixture"
    n_self=$(pyb_count "$SELF")
    n_fix=$(pyb_count "$B/pyb-fixture")
    echo "command: pyb_count <this script>, and the same over a fixture of five lines: a call with -c, one with -I -B -c, a comment, a command -v, a call of a .py path"
    echo "  shape PYB: in this script $n_self; in the fixture $n_fix"
    check "PYB: this script holds none (change NTJ)" "$(yn [ "$n_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's two calls without -I -B and not its other three lines" "$(yn [ "$n_fix" = 2 ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M5 part 6 P1 record: logs, the image record, the check')
    DOC=$(by_subject 'M5 part 6 P2: commit planning docs (the P1 verification and rulings)')
    TRAP=$(by_subject "M5 part 6 P2: the runner counts the image's containers in an EXIT trap")
    START=$(by_subject 'M5 part 6 P2: the record script names the container start of an openpyxl run')
    COMPARE=$(by_subject 'M5 part 6 P2: scripts/compare-record.py and its test')
    # Change RA: the record the keep is compared with is part 5 P4's open-check
    # record, which part 5 P4's record commit added (no hash is typed here);
    # checked below to be the last committed.
    PREV_OPEN_REC=$(by_subject 'M5 part 5 P4 record: logs, the size and API records, the sample and open records, the check')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  M5 part 6 P1's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the trap commit (ruling I): ${TRAP:-none}"
    echo "  the start commit (rulings K and P): ${START:-none}"
    echo "  the compare commit, the phase commit: ${COMPARE:-none}"
    echo "  M5 part 5 P4's record commit, the last to add an open-check record (change RA): ${PREV_OPEN_REC:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$COMPARE" "$START" "$TRAP" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the compare commit, the start commit, the trap commit, the doc commit and the base, each the next one's parent, the compare commit the phase commit (change RA)" "$(yn roles_in_order)"
    roles_ctl() { local COMPARE=$START; roles_in_order; }
    check "control: roles_in_order refuses the start commit named as the phase commit" "$(ynnot roles_ctl)"
    roles_ctl2() { local REC=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the base" "$(ynnot roles_ctl2)"
    roles_ctl3() { local TRAP=$START; roles_in_order; }
    check "control: roles_in_order refuses the start commit named as the trap commit" "$(ynnot roles_ctl3)"
    # record_is <commit> <subject prefix>: the commit is there, its subject
    # begins with the prefix, and it is an ancestor of the phase commit.
    record_is() { [ -n "$1" ] && git cat-file -e "$1^{commit}" && [ "$(git log -1 --format=%s "$1" | LC_ALL=C "$G" -cE "^$2")" = 1 ] && git merge-base --is-ancestor "$1" "$C"; }
    echo "command: git log -1 --format=%s <M5 part 5 P4's record commit>"
    echo "    $(git log -1 --format=%s "$PREV_OPEN_REC")"
    check "the named record commit is M5 part 5 P4's record commit, an ancestor of the phase commit (change RA)" "$(yn record_is "$PREV_OPEN_REC" 'M5 part 5 P4 record: ')"
    check "control: the same check refuses the base named instead" "$(ynnot record_is "$REC" 'M5 part 5 P4 record: ')"
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the compare commit, by its subject (change RA)" "$(yn [ "$COMPARE" = "$C" ])"
    check "control: the same comparison refuses the start commit" "$(ynnot [ "$START" = "$C" ])"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT")"
    short_names_head() { [ "$(git rev-parse "$SHORT")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    echo "phase: Milestone 5 part 6 P2 ($SPEC) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run builds into <target>/main, the main tree's subdirectory of the phase's target root (CARGO_TARGET_DIR)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "SETTINGS CHOSEN BEFORE THE RUN, never tuned during it: emend on the corpus with the runner's defaults (--timeout 300, --memory 2048) and --lo-timeout $LO_TIMEOUT_S; openpyxl on the corpus --memory 4096 --timeout 600 (ruling N); the scale tiers openpyxl --memory 16384 --timeout 3600 (decision 2 A), emend --memory 2048 --timeout 3600 (ruling M)"
    echo "root: <repo> stands for the repository's top level (inside <home>, scrubbed after the corpus's paths); scripts/counting.sh is read from it at the phase commit by git show; scripts/passthrough-run.sh, scripts/compare-run.sh, scripts/passthrough-record.py, scripts/compare-record.py and scripts/edit-open-check.sh are run from it, each checked equal to the phase commit's; the runners and the open check source scripts/lo-check.sh; it is built into <target>/main; the keep's tests run in it; the record pairs are installed into its $RECORDS_DEST/"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m5p6-p2 on the disk, the phase's directory; <phase>/gen holds the generator that wrote this script"
    echo "root: <scratch> stands for <phase>, the phase's directory, named <scratch> where TMPDIR is concerned: TMPDIR is <scratch>/tmp, made and exported by this script before any mktemp, and <work> is made under it (close-out ruling 1)"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory; the record pairs are written into <scripts>/out/records first, and this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (the counting library, the checks' programs and outputs, the runs' TMPDIR <work>/tmp-run, the open check's TMPDIR <work>/tmp, the empty runs' output directory <work>/empty-out), kept after the run and never removed"
    echo "root: <target> stands for <phase>/target on the disk, the phase's one target root: this log builds <repo> into <target>/main and into no other"
    echo "root: <keep> stands for <phase>/keep-host on the disk unless RUN_KEEP names another for a dry run, this phase's host keep; kept after the run for planning"
    echo "root: <corpus> stands for the private corpus directory (the manifest and the inputs under <corpus>/corpus, read)"
    echo "root: <runs> stands for the corpus run directories' parent, <corpus>/runs unless RUN_OUT_ROOT names another for a dry run; this log's corpus run directories <runs>/$RUN-<op> and <runs>/$RUN-openpyxl-<op> are written there"
    echo "root: <scale> stands for the scale directory, <corpus>/scale (its manifest and the four tiers under <scale>/corpus, read; specs/0023)"
    echo "root: <scaleruns> stands for the scale run directories' parent, <scale>/runs unless RUN_SCALE_OUT names another for a dry run; this log's scale run directories <scaleruns>/$RUN-scale-<tier>-<op> and <scaleruns>/$RUN-openpyxl-scale-<tier>-<op> are written there (ruling L)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$SELF_DIR" "$BUILD_ROOT" "$MAIN" "$KEEP" "$CORPUS" "$TMPDIR")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots other than <home>, <phase>, <work>, <runs>, <scale> and <scaleruns> are distinct, none inside another (TMPDIR, <scratch>/tmp, among them)" "$(yn roots_distinct)"
    work_in_tmpdir() { case "$B/" in "$TMPDIR/"*) return 0 ;; esac; return 1; }
    check "<work>, the directory mktemp -d made, is under TMPDIR, <scratch>/tmp (close-out ruling 1)" "$(yn work_in_tmpdir)"
    work_ctl() { local B=/tmp/x; work_in_tmpdir; }
    check "control: the same test refuses a working directory under /tmp" "$(ynnot work_ctl)"
    tmpdir_ctl() { local TMPDIR=$SELF_DIR/out; work_in_tmpdir; }
    check "control: the same test refuses <work> against a TMPDIR it is not under" "$(ynnot tmpdir_ctl)"
    # Every mktemp call of this script is checked under TMPDIR, so the source is
    # read for its calls outside comments; the call's text is built from
    # pieces, so this form's own text is no call.
    MKW='$('
    MKW=${MKW}mkt
    MKW=${MKW}emp
    count_tempcalls() {
      awk -v w="$MKW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { n++; s = substr(s, i + length(w)) }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "A=$MKW -d)" "F=$MKW)" "# $MKW -d)" >"$B/mktemp-fixture"
    n_mk=$(count_tempcalls "$SELF")
    n_mk_fix=$(count_tempcalls "$B/mktemp-fixture")
    echo "command: count_tempcalls <this script>, and the same over a fixture of three lines: a directory call, a file call, a comment"
    echo "  mktemp calls in this script outside comments: $n_mk (the one that makes <work>, checked under TMPDIR above); in the fixture: $n_mk_fix"
    check "this script makes one mktemp call, <work>'s, and no plain temporary file" "$(yn [ "$n_mk" = 1 ])"
    check "control: the same count finds the fixture's two calls and not its comment" "$(yn [ "$n_mk_fix" = 2 ])"
    runs_apart() { apart "$RUN_OUT_ROOT" "$MAIN" && apart "$RUN_OUT_ROOT" "$SELF_DIR" && apart "$RUN_SCALE_OUT" "$MAIN" && apart "$RUN_SCALE_OUT" "$SELF_DIR"; }
    check "<runs> and <scaleruns> lie outside <repo> and <scripts>" "$(yn runs_apart)"
    check "control: apart refuses <target>/main/release against <target>/main, which holds it" "$(ynnot apart "$BUILD_ROOT/release" "$BUILD_ROOT")"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "the corpus run directories: <runs>/$RUN-<op> and <runs>/$RUN-openpyxl-<op> for each op run; the scale runs, tier:op: $SCALE_PLAN"
    echo "the record stems: m5p6-<op>-$RUN, m5p6-openpyxl-<op>-$RUN, m5p6-scale-<tier>-<op>-$RUN, m5p6-openpyxl-scale-<tier>-<op>-$RUN, $STEM_OPEN and $STEM_COMPARE; the records' destination: $RECORDS_DEST; RUN_SKIP_KEEP: $RUN_SKIP_KEEP"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs, its record pairs, the open pair, the comparison record, planning's modified specs/0037) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m5p6-p2/run.log\n?? records/m5p6-edit-%s-%s.md\n?? records/m5p6-openpyxl-scale-b-copy-%s-%s.txt\n?? records/m5p6-open-%s-%s.txt\n?? records/compare-m5p6-%s-%s.md\n?? records/logs/m5p6-p1/run.log\n?? records/m5p6-edit-%s-abcdef0.md\n?? records/m5p6-p1-edit-%s-%s.md\n?? records/m5p6-scale-e-copy-%s-%s.md\n?? records/logs/m5p6-p2x/run.log\n M ROADMAP.md\n M specs/0036-charts-write-second-set.md\n M records/m5p6-edit-%s-%s.md\n M scripts/compare-run.sh\n' "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$SHORT" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern admits this phase's log, an op's record, a scale record, the open and comparison records at this commit alone; it refuses another phase's log, a record of another commit, a record stem with another word, a tier that is not one of the four, a sibling directory, ROADMAP.md, specs/0036, a modified record and a source file (change RI)" "$(yn [ "$(ours_rec_ctl)" = 5 ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources (the phase commit's, by git show)"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts, against the phase commit, and planning's uncommitted spec"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/passthrough-run.sh scripts/compare-run.sh scripts/openpyxl-ops.py scripts/passthrough-record.py scripts/compare-record.py scripts/lo-check.sh scripts/edit-open-check.sh "$IMAGE_RECORD"; do
      check "$s in the main tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { [ "$(git show "$C:scripts/compare-run.sh" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/passthrough-run.sh)" ]; }
    check "control: the same hash comparison tells two different scripts apart" "$(ynnot tree_ctl)"
    spec_now=$(sha_of "$SPEC")
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    spec_doc=$(git show "$DOC:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum; git show <doc commit>:$SPEC | sha256sum; sha256sum $SPEC (the working file, printed and not asserted: planning holds its rulings during P2 uncommitted; change RB)"
    echo "  at the phase commit: $spec_committed; at the doc commit: $spec_doc; the pin: $SPEC_WANT"
    echo "the spec pin: $SPEC at the doc commit, git show <doc commit>:$SPEC | sha256sum: $spec_doc"
    echo "  the working tree's copy (planning's uncommitted rulings): sha256 $spec_now"
    spec_ok() { [ "$spec_committed" = "$SPEC_WANT" ]; }
    check "the spec at the phase commit is at the pinned hash" "$(yn spec_ok)"
    check "the spec at the phase commit is the doc commit's" "$(yn [ "$spec_committed" = "$spec_doc" ])"
    spec_ctl() { local spec_committed=1111111111111111111111111111111111111111111111111111111111111111; spec_ok; }
    check "control: the same check refuses the spec against another hash" "$(ynnot spec_ctl)"
    echo "command: podman image exists $IMAGE; podman image exists $OX_IMAGE; podman image inspect --format '{{.Id}}' $OX_IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    check "the openpyxl image is there" "$(yn podman image exists "$OX_IMAGE")"
    OX_ID=$(podman image inspect --format '{{.Id}}' "$OX_IMAGE" </dev/null)
    echo "  the openpyxl image's id: $OX_ID"
    OX_ID_REC=$(sed -n 's/^| Image id | `\([0-9a-f]\{64\}\)` |$/\1/p' "$IMAGE_RECORD")
    echo "  the id the image record names ($IMAGE_RECORD): ${OX_ID_REC:-none}"
    check "the openpyxl image is the one its committed record names" "$(yn [ "$OX_ID" = "$OX_ID_REC" ])"
    check "control: the same comparison refuses the LibreOffice image's id" "$(ynnot [ "$(podman image inspect --format '{{.Id}}' "$IMAGE" </dev/null)" = "$OX_ID_REC" ])"
    podman ps -a --filter "ancestor=$OX_IMAGE" --format '{{.Names}}' </dev/null >"$B/ox-containers-entry"
    echo "command: podman ps -a --filter ancestor=$OX_IMAGE --format '{{.Names}}': containers of the image at entry: $(count_lines "$B/ox-containers-entry")"
    check "no container of the openpyxl image is there at entry" "$(yn [ "$(count_lines "$B/ox-containers-entry")" = 0 ])"
    
    echo
    echo "## the release binaries, built from the phase commit into <target>/main, host and i686 (change RC)"
    for pkg in emend-copy xlsx-diff; do
      for tgt in host "$I686"; do
        if [ "$tgt" = host ]; then targs=(); else targs=(--target "$tgt"); fi
        echo "command: cargo build --release --locked --offline -p $pkg ${targs[*]}"
        cargo build --release --locked --offline -p "$pkg" "${targs[@]}" >"$B/build-$pkg-$tgt.out" 2>&1 </dev/null
        brc=$?
        nwarn=$(count_matches -E '^(warning|error)' "$B/build-$pkg-$tgt.out")
        echo "  exit $brc; lines $(count_lines "$B/build-$pkg-$tgt.out"); warning or error lines $nwarn"
        check "$pkg ($tgt): the release build exits 0" "$(yn [ "$brc" = 0 ])"
        check "$pkg ($tgt): no warning or error line" "$(yn [ "$nwarn" = 0 ])"
      done
    done
    PT_host=$BUILD_ROOT/release/emend-copy
    XD_host=$BUILD_ROOT/release/xlsx-diff
    PT_i686=$BUILD_ROOT/$I686/release/emend-copy
    XD_i686=$BUILD_ROOT/$I686/release/xlsx-diff
    for b in "$PT_host" "$XD_host" "$PT_i686" "$XD_i686"; do
      echo "  $b: sha256 $(sha_of "$b"), bytes $(stat -c %s "$b")"
      check "$(basename "$b") at $(dirname "$b") is an executable file" "$(yn [ -x "$b" ])"
    done
    OPS_SCRIPT=scripts/openpyxl-ops.py
    
    echo
    echo "## the corpus manifest and the scale manifest"
    manifest_rows=$(awk 'NR > 1' "$CORPUS/manifest.tsv" | wc -l)
    awk -F'\t' 'NR > 1 { print $1 "\t" $4 }' "$CORPUS/manifest.tsv" >"$B/order.all"
    if [ -n "$RUN_IDS" ]; then
      awk -F'\t' 'NR == FNR { want[$1] = 1; next } want[$1]' <(tr -d ' \t' <"$RUN_IDS") "$B/order.all" >"$B/order"
    else
      cp "$B/order.all" "$B/order"
    fi
    want_rows=$(count_lines "$B/order")
    echo "command: awk over <corpus>/manifest.tsv: rows $manifest_rows; the rows this run selects: $want_rows"
    check "the corpus manifest has rows" "$(yn [ "$manifest_rows" -ge 1 ])"
    check "every selected id is a manifest row" "$(yn [ "$want_rows" -ge 1 ])"
    FIRST_ID=$(head -n 1 "$B/order" | cut -f1)
    FIRST_EXT=$(head -n 1 "$B/order" | cut -f2)
    declare -A TIER_ID TIER_EXT
    for t in a b c d; do
      TIER_ID[$t]=$(awk -F'\t' -v tag="scale,tier$t" 'NR > 1 && $9 == tag { print $1 }' "$SCALE/manifest.tsv")
      TIER_EXT[$t]=$(awk -F'\t' -v tag="scale,tier$t" 'NR > 1 && $9 == tag { print $4 }' "$SCALE/manifest.tsv")
      printf '%s\n' "${TIER_ID[$t]}" >"$B/ids-$t"
      echo "  scale tier $t: id ${TIER_ID[$t]:-none}, ext ${TIER_EXT[$t]:-none}, $(stat -c %s "$SCALE/corpus/${TIER_ID[$t]}.${TIER_EXT[$t]}" 2>/dev/null) bytes"
      tier_one() { [ "$(printf '%s\n' "${TIER_ID[$t]}" | count_matches -E '^[0-9a-f]{12}$' /dev/stdin)" = 1 ]; }
      check "the scale manifest names tier $t once, by its tags" "$(yn tier_one)"
    done
    
    echo
    echo "## TMPDIR for the runs, on the disk"
    RUNTMP=$B/tmp-run
    mkdir "$RUNTMP" || exit 2
    dev_tmp=$(stat -c %d "$RUNTMP")
    dev_corpus=$(stat -c %d "$CORPUS/corpus")
    dev_scale=$(stat -c %d "$SCALE/corpus")
    dev_proc=$(stat -c %d /proc)
    echo "command: mkdir <work>/tmp-run; stat -c %d <work>/tmp-run <corpus>/corpus <scale>/corpus /proc"
    echo "  device of TMPDIR (<work>/tmp-run): $dev_tmp; of the corpus directory: $dev_corpus; of the scale directory: $dev_scale; of /proc (the control): $dev_proc"
    check "TMPDIR for the runs and the corpus directory are on one device" "$(yn [ "$dev_tmp" = "$dev_corpus" ])"
    check "TMPDIR for the runs and the scale directory are on one device (specs/0023 ruling 4)" "$(yn [ "$dev_tmp" = "$dev_scale" ])"
    check "control: the same comparison tells /proc's device from the corpus directory's" "$(yn [ "$dev_proc" != "$dev_corpus" ])"
    
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names. Change VJ: the dropped families are an
    input, as the changed and added ones are. Change RE (M5 part 6 P2): the
    openpyxl label is read as the two emend labels are, and the last input is
    the whole tool line the label's record carries."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, want_changed, want_added, want_dropped, tool_arg = sys.argv[1:9]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    def listed(value):
        return value.split(",") if value else []
    
    
    labels = [l for l in ("host", "i686", "openpyxl") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        changed_f = sorted(f for f in fam if fam[f].get("changed"))
        dropped_f = sorted(f for f in fam if fam[f].get("dropped"))
        added_f = sorted(f for f in fam if fam[f].get("added"))
        checks.append(("%s: the xml families are the changed entries' families" % label, sorted(xf) == changed_f))
        checks.append(("%s: the changed entries' families are %s" % (label, want_changed or "none"), changed_f == listed(want_changed)))
        checks.append(("%s: the dropped entries' families are %s" % (label, want_dropped or "none"), dropped_f == listed(want_dropped)))
        checks.append(("%s: the added entries' families are %s" % (label, want_added or "none"), added_f == listed(want_added)))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's tool line", tool_arg in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    fams_of() {
      python3 -I -B -c 'import importlib.util, sys
    spec = importlib.util.spec_from_file_location("record", sys.argv[1])
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    rows = [l.split("\t", 1) for l in open(sys.argv[2]).read().split("\n") if l]
    print(",".join(sorted({record.family(n) for (k, n) in rows if k == sys.argv[3]})))' scripts/passthrough-record.py "$1" "$2"
    }
    inst_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
    # Change JI: no bytecode was written, so there is nothing to remove.
    no_pycache() { [ ! -e scripts/__pycache__ ]; }
    # The tables' helpers: by header name, so a column's place is never typed.
    row_field() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && NR == 2 { print $k }' "$1"; }
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    sum_col() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { n += $k } END { print n + 0 }' "$1"; }
    status_rows() { awk -F'\t' -v s="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "status") k = i; next } k && $k == s { n++ } END { print n + 0 }' "$1"; }
    # outcome_counts <summary>: every outcome the summary holds, with its count.
    outcome_counts() { awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "outcome") k = i; next } { n[$k]++ } END { for (o in n) printf "%s %d; ", o, n[o] }' "$1" | sed 's/; $//'; }
    N_INST_WANT=0
    
    # empty_time <run directory> <input> <name in the container> <MiB>: three
    # empty runs of the openpyxl image, with the mounts and flags
    # scripts/compare-run.sh gives a run (the input read-only, an output
    # directory, the ops script read-only, --network=none --userns=keep-id, the
    # same ulimit), each timed around podman run as the runner times it,
    # written to <run directory>/empty.openpyxl.tsv; the median is printed
    # (rulings K and P).
    empty_time() {
      local d=$1 in=$2 name=$3 mib=$4 n t0 t1 rc
      mkdir -p "$B/empty-out" || return 1
      printf 'run\twall_s\n' >"$d/empty.openpyxl.tsv"
      for n in 1 2 3; do
        t0=$(date +%s%N)
        podman run --rm --name "emend-openpyxl-empty-$$-$n" --network=none --userns=keep-id \
          -v "$in":"/in/$name":ro -v "$B/empty-out":/out -v "$MAIN/$OPS_SCRIPT":/ops.py:ro "$OX_IMAGE" \
          sh -c 'ulimit -v "$1" && exec python3 -I -B -c pass' sh "$((mib * 1024))" \
          </dev/null >"$B/empty-$n.out" 2>"$B/empty-$n.err"
        rc=$?
        t1=$(date +%s%N)
        printf '%s\t%s\n' "$n" "$(awk -v a="$t0" -v b="$t1" 'BEGIN { printf "%.2f", (b - a) / 1e9 }')" >>"$d/empty.openpyxl.tsv"
        echo "    empty run $n: exit $rc; stdout bytes $(wc -c <"$B/empty-$n.out"); stderr bytes $(wc -c <"$B/empty-$n.err")"
        [ "$rc" = 0 ] && [ ! -s "$B/empty-$n.out" ] && [ ! -s "$B/empty-$n.err" ] || return 1
      done
    }
    empty_median() { tail -n +2 "$1/empty.openpyxl.tsv" | cut -f2 | sort -n | sed -n 2p; }
    # stderr_counts <run directory>: ruling H's figures, the non-empty
    # stderr.openpyxl.txt files and their total bytes (never their content).
    stderr_counts() {
      local files bytes
      files=$(find "$1" -name stderr.openpyxl.txt -size +0c | wc -l)
      bytes=$(find "$1" -name stderr.openpyxl.txt -printf '%s\n' | awk '{ n += $1 } END { print n + 0 }')
      echo "  openpyxl's standard error in this run directory (ruling H): non-empty stderr.openpyxl.txt files $files; their total bytes $bytes (the content stays there)"
    }
    
    # emend_run <run directory> <label> <ids file or -> <xlsx-diff> <memory> <timeout> <open: yes|no> <tool argument or ->:
    # one passthrough run, its lines printed and checked; the rows expected are
    # the ids file's or the selected corpus rows.
    emend_run() {
      local O=$1 label=$2 ids=$3 XD=$4 mem=$5 tmo=$6 open=$7 arg=$8 corpus=$9 want=${10}
      local var PT rc args
      var=PT_$label; PT=${!var}
      args=(--label "$label" --passthrough "$PT" --xlsx-diff "$XD" --corpus "$corpus" --out "$O" --memory "$mem" --timeout "$tmo")
      if [ "$ids" != - ]; then args+=(--ids "$ids"); fi
      if [ "$open" = yes ]; then args+=(--libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S"); fi
      if [ "$arg" != - ]; then args+=(--tool-arg "$arg"); fi
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh ${args[*]}"
      local started
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/passthrough-run.sh "${args[@]}" >"$B/run.stdout" 2>"$B/run.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run.stderr")"
      sed 's/^/    /' "$B/run.stdout"
      check "$label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$label: its stderr is empty" "$(yn [ ! -s "$B/run.stderr" ])"
      local n_left SUM ENT R rows
      n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
      echo "  entries left in <work>/tmp-run after the run: $n_left"
      check "$label: the runs' TMPDIR is empty after the run" "$(yn [ "$n_left" = 0 ])"
      SUM=$O/summary.$label.tsv
      ENT=$O/entries.$label.tsv
      R=$O/run.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      echo "  summary rows: $rows; outcomes: $(outcome_counts "$SUM"); lo ok $(count_where "$SUM" lo ok); lo_in ok $(count_where "$SUM" lo_in ok); leftover no $(count_where "$SUM" leftover no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      check "$label: one summary row per selected workbook ($want)" "$(yn [ "$rows" = "$want" ])"
      totals_agree() {
        local st
        for st in identical recompressed changed dropped added; do
          [ "$(sum_col "$SUM" "$st")" = "$(status_rows "$ENT" "$st")" ] || return 1
        done
      }
      check "$label: the summary's status totals are the entries table's rows" "$(yn totals_agree)"
      run_row_ok() { [ "$(row_field "$R" passthrough_sha256) $(row_field "$R" xlsx_diff_sha256) $(row_field "$R" commit) $(row_field "$R" memory_mib) $(row_field "$R" timeout_s)" = "$(sha_of "$PT") $(sha_of "$XD") $C $mem $tmo" ]; }
      check "$label: the run row records the two binaries by sha256, the phase commit and the settings ($mem MiB, $tmo s)" "$(yn run_row_ok)"
      local want_arg=$arg
      [ "$arg" = - ] && want_arg=""
      check "$label: the run row's tool_args is ${want_arg:-empty} (ruling O)" "$(yn [ "$(row_field "$R" tool_args)" = "$want_arg" ])"
    }
    
    # ox_run <run directory> <op> <ids file or -> <memory> <timeout> <open: yes|no> <corpus> <rows wanted> <input for the empty runs> <its name>:
    # one openpyxl run, its lines printed and checked; then the empty runs and
    # the stderr counts.
    ox_run() {
      local O=$1 op=$2 ids=$3 mem=$4 tmo=$5 open=$6 corpus=$7 want=$8 ein=$9 ename=${10}
      local rc args SUM R rows
      args=(--op "$op" --image "$OX_IMAGE" --xlsx-diff "$XD_host" --corpus "$corpus" --out "$O" --memory "$mem" --timeout "$tmo")
      if [ "$ids" != - ]; then args+=(--ids "$ids"); fi
      if [ "$open" = yes ]; then args+=(--libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S"); fi
      echo "command: TMPDIR=<work>/tmp-run scripts/compare-run.sh ${args[*]}"
      local started
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/compare-run.sh "${args[@]}" >"$B/ox.stdout" 2>"$B/ox.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/ox.stderr")"
      sed 's/^/    /' "$B/ox.stdout"
      check "openpyxl $op: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "openpyxl $op: its stderr is empty" "$(yn [ ! -s "$B/ox.stderr" ])"
      check "openpyxl $op: the runner's last line names 0 containers of the image remaining (rulings A and I)" "$(yn [ "$(tail -n 1 "$B/ox.stdout")" = "containers of the image remaining: 0" ])"
      check "openpyxl $op: the count line names $want files" "$(yn [ "$(count_matches -E "^files $want ok [0-9]+ error [0-9]+ timeout [0-9]+ cap [0-9]+ no-output [0-9]+\$" "$B/ox.stdout")" = 1 ])"
      SUM=$O/summary.openpyxl.tsv
      R=$O/run.openpyxl.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      echo "  summary rows: $rows; outcomes: $(outcome_counts "$SUM"); lo ok $(count_where "$SUM" lo ok); lo_in - $(count_where "$SUM" lo_in -); leftover no $(count_where "$SUM" leftover no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added)"
      check "openpyxl $op: one summary row per selected workbook ($want)" "$(yn [ "$rows" = "$want" ])"
      check "openpyxl $op: lo_in is - on every row (ruling C)" "$(yn [ "$(count_where "$SUM" lo_in -)" = "$rows" ])"
      ox_row_ok() { [ "$(row_field "$R" commit) $(row_field "$R" image_id) $(row_field "$R" openpyxl) $(row_field "$R" op) $(row_field "$R" memory_mib) $(row_field "$R" timeout_s) $(row_field "$R" ops_sha256) $(row_field "$R" xlsx_diff_sha256)" = "$C $OX_ID 3.1.5 $op $mem $tmo $(sha_of "$OPS_SCRIPT") $(sha_of "$XD_host")" ]; }
      check "openpyxl $op: the run row names the phase commit, the image, openpyxl 3.1.5, the op, $mem MiB, $tmo s, the ops script and xlsx-diff" "$(yn ox_row_ok)"
      echo "command: three empty runs of the image, timed (rulings K and P): podman run --rm --network=none --userns=keep-id, the input $ename read-only, <work>/empty-out, the ops script read-only, sh -c 'ulimit -v <MiB*1024> && exec python3 -I -B -c pass'"
      empty_time "$O" "$ein" "$ename" "$mem"
      local erc=$?
      check "openpyxl $op: the three empty runs exit 0 and print nothing" "$(yn [ "$erc" = 0 ])"
      echo "  the empty runs' wall times: $(tail -n +2 "$O/empty.openpyxl.tsv" | cut -f2 | tr '\n' ' ')s; median $(empty_median "$O") s (written to empty.openpyxl.tsv in the run directory)"
      stderr_counts "$O"
    }
    
    # write_record <run directory> <stem> <tool line> [--allow-single]: the
    # record pair, checked against its run directory by the record check program
    # (change RE), installed.
    write_record() {
      local O=$1 stem=$2 toolline=$3 single=${4:-} rrc nlab fam_label
      local args=(--run "$O" --out "$RECORDS" --stem "$stem")
      [ -n "$single" ] && args+=("$single")
      echo "command: python3 -I -B scripts/passthrough-record.py ${args[*]}"
      python3 -I -B scripts/passthrough-record.py "${args[@]}" >"$B/record.out" 2>&1
      rrc=$?
      sed 's/^/    /' "$B/record.out"
      check "$stem: the record script exits 0" "$(yn [ "$rrc" = 0 ])"
      if [ -f "$O/summary.openpyxl.tsv" ]; then fam_label=openpyxl; nlab=1; else fam_label=host; nlab=2; fi
      awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] ~ /^(changed|added|dropped)$/ { print $k["status"] "\t" $k["name"] }' "$O/entries.$fam_label.tsv" >"$B/w.parts"
      local FAM_CHANGED FAM_ADDED FAM_DROPPED
      FAM_CHANGED=$(fams_of "$B/w.parts" changed)
      FAM_ADDED=$(fams_of "$B/w.parts" added)
      FAM_DROPPED=$(fams_of "$B/w.parts" dropped)
      echo "  the families of the $fam_label entries table (the run's own, change RE): changed ${FAM_CHANGED:-none}; added ${FAM_ADDED:-none}; dropped ${FAM_DROPPED:-none}"
      python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RECORDS/$stem.txt" "$RECORDS/$stem.md" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$toolline" >"$B/reccheck.out" 2>&1
      echo "  exit: $?"
      sed 's/^/    /' "$B/reccheck.out"
      local want_yes=$((4 + 6 * nlab + 2))
      rec_all() { [ "$(count_matches -E ': yes$' "$B/reccheck.out")" = "$want_yes" ] && [ "$(count_matches -E ': no$' "$B/reccheck.out")" = 0 ]; }
      check "$stem: the record's three tables are the run directory's, its family tables are counted from them, and its tool line is the label's ($want_yes checks)" "$(yn rec_all)"
      if [ "$fam_label" = openpyxl ]; then
        local med
        med=$(empty_median "$O")
        start_ok() { [ "$(count_matches -E "^- Container start: .*, median $med s; " "$RECORDS/$stem.md")" = 1 ]; }
        check "$stem: the record names the container start, median $med s, once (rulings K and P)" "$(yn start_ok)"
      fi
      check "the record script and the record check left no scripts/__pycache__ (PYTHONDONTWRITEBYTECODE)" "$(yn no_pycache)"
      echo "command: install -m 644 <scripts>/out/records/$stem.md <scripts>/out/records/$stem.txt <repo>/$RECORDS_DEST/"
      install -m 644 "$RECORDS/$stem.md" "$RECORDS/$stem.txt" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$stem.md" "$RECORDS_DEST/$stem.txt")
      echo "  exit: $?"
      local f
      for f in "$stem.md" "$stem.txt"; do
        echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
        check "the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
      done
      N_INST_WANT=$((N_INST_WANT + 2))
    }
    
    if [ -n "$RUN_IDS" ]; then IDS_ARG=$RUN_IDS; else IDS_ARG=-; fi
    for op in $OPS; do
      EDIT=${EDITS[$op]:--}
      EO=$RUN_OUT_ROOT/$RUN-$op
      OO=$RUN_OUT_ROOT/$RUN-openpyxl-$op
      for label in host i686; do
        var=XD_$label
        echo
        echo "## $op: emend, $label, over the corpus (ruling O: tool argument ${EDITS[$op]:-none})"
        emend_run "$EO" "$label" "$IDS_ARG" "${!var}" 2048 300 yes "$EDIT" "$CORPUS" "$want_rows"
      done
      echo
      echo "## $op: openpyxl over the corpus, --memory 4096 --timeout 600 (ruling N)"
      ox_run "$OO" "$op" "$IDS_ARG" 4096 600 yes "$CORPUS" "$want_rows" "$CORPUS/corpus/$FIRST_ID.$FIRST_EXT" "$FIRST_ID.$FIRST_EXT"
      echo
      echo "## $op: the record pairs"
      if [ "$EDIT" = - ]; then TOOLLINE="- Tool arguments: none"; else TOOLLINE="- Tool arguments: $EDIT"; fi
      write_record "$EO" "m5p6-$op-$RUN" "$TOOLLINE"
      write_record "$OO" "m5p6-openpyxl-$op-$RUN" "- openpyxl: version 3.1.5; op $op" --allow-single
    done
    reccheck_ctl() {
      python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$OO" "$RECORDS/m5p6-openpyxl-$op-$RUN.txt" "$RECORDS/m5p6-openpyxl-$op-$RUN.md" "" "" "" "- openpyxl: version 3.1.5; op planted" >"$B/c-reccheck.out" 2>&1
      [ "$(count_matches -E ': no$' "$B/c-reccheck.out")" -ge 1 ]
    }
    check "control: the record check refuses the last openpyxl record against a planted op and no families" "$(yn reccheck_ctl)"
    
    echo
    if [ "$RUN_SKIP_KEEP" = yes ]; then
    echo "## the keep and the open check: SKIPPED (RUN_SKIP_KEEP=yes, a dry run)"
    else
    echo "## the host keep regenerated (change NSF: M3 part 7 P5's form, one cargo test; carried)"
    mkdir "$KEEP" || exit 2
    echo "command: EMEND_KEEP_DIR=<keep> cargo test --workspace (host; CARGO_TARGET_DIR=<target>/main)"
    EMEND_KEEP_DIR=$KEEP cargo test --workspace >"$B/keep.out" 2>&1 </dev/null
    rc=$?
    echo "  exit: $rc"
    LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$B/keep.out" | sed 's/^ */    /'
    failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    echo "  passed $passed; failed $failed"
    check "the tests with the keep set exit 0" "$(yn [ "$rc" = 0 ])"
    check "no test failed" "$(yn [ "$failed" = 0 ])"
    echo "  files in the keep: $(find "$KEEP" -type f | wc -l); entries that are not regular files: $(find "$KEEP" -mindepth 1 ! -type f | wc -l)"
    (cd "$KEEP" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/host.files"
    nfiles=$(count_lines "$B/host.files")
    n_in=$(count_matches -E '\.in\.xlsx$' "$B/host.files")
    n_out=$(count_matches -E '\.out\.xlsx$' "$B/host.files")
    n_other=$(count_matches -vE '^[A-Za-z0-9_.-]+\.[0-9]+\.(in|out)\.xlsx$' "$B/host.files")
    LC_ALL=C sed -nE 's/^(.*)\.in\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.names"
    LC_ALL=C sed -nE 's/^(.*)\.out\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.out.names"
    echo "  .in.xlsx $n_in; .out.xlsx $n_out; names not of the form <test>.<n>.in|out.xlsx: $n_other"
    all_pairs() { [ "$n_in" = "$n_out" ] && [ "$((n_in * 2))" = "$nfiles" ] && [ "$n_other" = 0 ] && cmp -s "$B/pair.names" "$B/pair.out.names"; }
    check "the keep holds only whole pairs named <test>.<n>" "$(yn all_pairs)"
    NPAIRS=$n_in
    (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/keep.listing"
    echo "  the host keep's listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/keep.listing"); files $(count_lines "$B/keep.listing"); listing sha256 $(sha_of "$B/keep.listing")"
    check "the host keep's pairs times two equals its files (keep_pairs_ok)" "$(yn keep_pairs_ok "$B/keep.listing")"
    
    echo
    echo "## the host keep against M5 part 5 P4's committed open-check record, named by its record commit (change RA)"
    PREV_TXT=$(git show --name-only --format= "$PREV_OPEN_REC" | LC_ALL=C "$G" -E '^records/[a-z0-9]+-open-.*[.]txt$')
    echo "command: git show --name-only --format= <M5 part 5 P4's record commit>, the open-check .txt it added; git show <phase commit>:<it>"
    echo "  the record: $PREV_TXT (sha256 $(git show "$C:$PREV_TXT" | sha256sum | cut -d' ' -f1))"
    check "the named record commit added exactly one open-check .txt" "$(yn [ "$(printf '%s\n' "$PREV_TXT" | count_lines /dev/stdin)" = 1 ])"
    no_later_open() { [ -z "$(git log --format=%H "$PREV_OPEN_REC..$C" -- 'records/*-open-*.txt')" ]; }
    check "no commit after it adds an open-check record, so it is the last committed" "$(yn no_later_open)"
    git show "$C:$PREV_TXT" >"$B/prev.txt"
    while IFS= read -r t; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$t" "$(stat -c %s "$KEEP/$t.in.xlsx")" "$(sha_of "$KEEP/$t.in.xlsx")" \
        "$(stat -c %s "$KEEP/$t.out.xlsx")" "$(sha_of "$KEEP/$t.out.xlsx")"
    done <"$B/pair.names" >"$B/keep.rows"
    tail -n +2 "$B/prev.txt" | cut -f1-5 | LC_ALL=C sort >"$B/prev.rows"
    LC_ALL=C sort "$B/keep.rows" >"$B/keep.sorted"
    n_prev=$(count_lines "$B/prev.rows")
    n_kept_prev=$(LC_ALL=C comm -12 "$B/prev.rows" "$B/keep.sorted" | count_lines /dev/stdin)
    cut -f1 "$B/prev.rows" >"$B/prev.names"
    LC_ALL=C comm -13 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/gone.pairs"
    echo "  rows: the regenerated keep $(count_lines "$B/keep.rows"), the record $n_prev; its rows found in the keep with the same name, bytes and both sha256s: $n_kept_prev"
    echo "  pairs in the keep and not in the record: $(count_lines "$B/new.pairs"); in the record and not in the keep: $(count_lines "$B/gone.pairs")"
    sed 's/^/    new: /' "$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.rows" "$B/keep.sorted" | cut -f1 >"$B/changed.pairs"
    echo "  pairs of the record whose bytes differ in the keep: $(count_lines "$B/changed.pairs")"
    sed 's/^/    changed: /' "$B/changed.pairs"
    check "no pair of the record is gone" "$(yn [ "$(count_lines "$B/gone.pairs")" = 0 ])"
    check "every pair of the record is in the keep, unchanged or changed ($n_kept_prev + $(count_lines "$B/changed.pairs") = $n_prev)" "$(yn [ "$((n_kept_prev + $(count_lines "$B/changed.pairs")))" = "$n_prev" ])"
    # Change RF: no new pair: the crate is not changed since the named record.
    : >"$B/want-new.pairs"
    echo "  the new pairs expected: $(count_lines "$B/want-new.pairs") (change NWF)"
    new_exact() { cmp -s "$B/new.pairs" "$B/want-new.pairs"; }
    check "the keep holds no pair the record does not, by name (change NWF)" "$(yn new_exact)"
    new_ctl() { printf '%s\n' package.tests.chart_write.planted.1 >"$B/c-new.pairs"; cmp -s "$B/c-new.pairs" "$B/want-new.pairs"; }
    check "control: the same comparison refuses a list holding one planted pair" "$(ynnot new_ctl)"
    check "no pair of the record changed its bytes (change NWF)" "$(yn [ "$(count_lines "$B/changed.pairs")" = 0 ])"
    changed_ctl() { printf '%s\n' other.1 >"$B/c-changed.pairs"; [ "$(count_lines "$B/c-changed.pairs")" = 0 ]; }
    check "control: the same count refuses one planted changed pair" "$(ynnot changed_ctl)"
    echo "command: the #[test] functions added or whose body is edited since the named record commit, and those of a .rs file whose text outside its tests differs, from the two commits' sources of every .rs file git diff --name-only <named record commit> <phase commit> names: <work>/edited.py, below (change NSG)"
    cat >"$B/edited.py" <<'PY'
    """The #[test] functions whose body differs between two commits, or that
    the second adds: each file's text at both commits (git show), every
    function after a #[test] attribute (other attributes allowed between), its
    body from the fn line to the first line that is a lone closing brace in
    column one. Prints one test name per line; with a third argument
    --fixtures, instead every test whose body names an item (const,
    static, fn, struct, enum, type or mod at column one) whose lines
    outside the test bodies differ between the two commits (change
    NSG)."""
    import collections
    import re
    import subprocess
    import sys
    
    base, head = sys.argv[1:3]
    TEST = re.compile(r"#\[test\]\s*(?:#\[[^\]]*\]\s*)*fn\s+([A-Za-z0-9_]+)")
    
    
    def show(rev, path):
        run = subprocess.run(["git", "show", "%s:%s" % (rev, path)], capture_output=True)
        return run.stdout.decode() if run.returncode == 0 else ""
    
    
    def tests(text):
        out = {}
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            out[m.group(1)] = text[m.start():end if end >= 0 else len(text)]
        return out
    
    
    names = subprocess.run(["git", "diff", "--name-only", base, head, "--", "*.rs"],
                           capture_output=True, check=True).stdout.decode().split()
    ITEM = re.compile(r"^(?:pub(?:\([^)]*\))?\s+)?(?:const|static|fn|struct|enum|type|mod)\s+([A-Za-z_][A-Za-z0-9_]*)")
    
    
    def outside(text):
        out, at = [], 0
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            end = len(text) if end < 0 else end + 3
            if m.start() >= at:
                out.append(text[at:m.start()])
                at = end
        out.append(text[at:])
        return "".join(out)
    
    
    def changed_items(before_text, after_text):
        found = set()
        for text, other in ((after_text, before_text), (before_text, after_text)):
            others = collections.Counter(outside(other).split("\n"))
            current = None
            for line in outside(text).split("\n"):
                m = ITEM.match(line)
                if m:
                    current = m.group(1)
                if others[line] > 0:
                    others[line] -= 1
                elif current is not None:
                    found.add(current)
        return found
    
    
    edited = set()
    fixture = set()
    for path in names:
        before_text, after_text = show(base, path), show(head, path)
        before, after = tests(before_text), tests(after_text)
        for name, body in after.items():
            if before.get(name) != body:
                edited.add(name)
        items = changed_items(before_text, after_text)
        for name, body in after.items():
            if any(re.search(r"\b%s\b" % re.escape(i), body) for i in items):
                fixture.add(name)
    for name in sorted(fixture if sys.argv[3:] == ["--fixtures"] else edited):
        print(name)
    PY
    sed 's/^/    /' "$B/edited.py"
    python3 -I -B "$B/edited.py" "$PREV_OPEN_REC" "$C" | LC_ALL=C sort >"$B/edited.tests"
    python3 -I -B "$B/edited.py" "$PREV_OPEN_REC" "$C" --fixtures | LC_ALL=C sort >"$B/fixture.tests"
    LC_ALL=C sort -u "$B/edited.tests" "$B/fixture.tests" >"$B/touched.tests"
    sed 's/^/    added or edited test: /' "$B/edited.tests"
    sed 's/^/    test of a file whose text outside its tests differs: /' "$B/fixture.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/new.pairs" | LC_ALL=C sort -u >"$B/new.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/changed.pairs" | LC_ALL=C sort -u >"$B/changed.tests"
    echo "  tests with a new pair: $(count_lines "$B/new.tests"); tests with a changed pair: $(count_lines "$B/changed.tests"); tests added or edited: $(count_lines "$B/edited.tests"); tests of a file whose text outside its tests differs: $(count_lines "$B/fixture.tests")"
    check "no test is added or edited since the named record: no .rs file in the range (change RF)" "$(yn [ "$(count_lines "$B/edited.tests")" = 0 ])"
    new_from_edited() { [ "$(LC_ALL=C comm -23 "$B/new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every new pair is kept by a test added or edited since the record" "$(yn new_from_edited)"
    changed_from_touched() { [ "$(LC_ALL=C comm -23 "$B/changed.tests" "$B/touched.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every changed pair of the record is kept by a test edited since it, or of a file whose fixtures or helpers changed (change NSG)" "$(yn changed_from_touched)"
    printf 'zzz_not_an_edited_test\n' | LC_ALL=C sort -m - "$B/new.tests" >"$B/c-new.tests"
    new_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a pair of a test not added or edited" "$(yn new_ctl)"
    printf 'zzz_not_a_touched_test\n' | LC_ALL=C sort -m - "$B/changed.tests" >"$B/c-changed.tests"
    touched_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-changed.tests" "$B/touched.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a changed pair of a test neither edited nor of a changed file" "$(yn touched_ctl)"
    
    echo
    echo "## scripts/edit-open-check.sh on the host keep (specs/0018 \"Harness runs\": every phase's run log runs it over its keep)"
    mkdir "$B/tmp"
    # The open check's own TMPDIR, its device beside the runs' and the corpus
    # directory's.
    dev_open=$(stat -c %d "$B/tmp")
    echo "command: stat -c %d <work>/tmp <work>/tmp-run <corpus>/corpus /proc"
    echo "  device of the open check's TMPDIR (<work>/tmp): $dev_open; of the runs' TMPDIR (<work>/tmp-run): $(stat -c %d "$RUNTMP"); of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    check "the open check's TMPDIR and the corpus directory are on one device" "$(yn [ "$dev_open" = "$dev_corpus" ])"
    check "control: the same comparison tells /proc's device from the open check's TMPDIR's" "$(yn [ "$dev_proc" != "$dev_open" ])"
    echo "command: TMPDIR=<work>/tmp scripts/edit-open-check.sh --keep <keep> --libreoffice $IMAGE --out <scripts>/out/records --stem $STEM_OPEN"
    TMPDIR=$B/tmp scripts/edit-open-check.sh --keep "$KEEP" --libreoffice "$IMAGE" --out "$RECORDS" --stem "$STEM_OPEN" \
      >"$B/oc.stdout" 2>"$B/oc.stderr" </dev/null
    oc_rc=$?
    echo "  exit: $oc_rc"
    echo "  stdout:"; sed 's/^/    /' "$B/oc.stdout"
    echo "  stderr bytes: $(wc -c <"$B/oc.stderr")"
    check "the script exits 0 (no finding, no check errored)" "$(yn [ "$oc_rc" = 0 ])"
    check "its stderr is empty" "$(yn [ ! -s "$B/oc.stderr" ])"
    echo "  the reasons the script kept (its reasons directory under <work>/tmp), one line per refused side:"
    find "$B/tmp" -name '*-reason.txt' | LC_ALL=C sort | while IFS= read -r f; do echo "    ${f#"$B/tmp/"}: $(cat "$f")"; done
    TXT=$RECORDS/$STEM_OPEN.txt
    MD=$RECORDS/$STEM_OPEN.md
    TXT_HEADER=$(git show "$C:scripts/edit-open-check.sh" | sed -n "s/^readonly TXT_HEADER=\\$'\\(.*\\)'\$/\\1/p" | sed 's/\\t/\t/g')
    check "the .txt's header is the script's TXT_HEADER, read from the phase commit (nine columns)" "$(yn [ "$(head -n 1 "$TXT")" = "$TXT_HEADER" ])"
    tail -n +2 "$TXT" | cut -f1-5 >"$B/txt.rows"
    nrow_same=$(paste -d'\n' "$B/keep.rows" "$B/txt.rows" | awk 'NR % 2 == 1 { a = $0; next } a == $0 { n++ } END { print n + 0 }')
    echo "  rows: the keep $(count_lines "$B/keep.rows"), the .txt $(count_lines "$B/txt.rows"); rows whose name, bytes and hashes are the keep's, compared row by row: $nrow_same"
    rows_same() { [ "$(count_lines "$B/keep.rows")" = "$(count_lines "$B/txt.rows")" ] && [ "$nrow_same" = "$(count_lines "$B/keep.rows")" ] && [ "$nrow_same" = "$NPAIRS" ]; }
    check "every .txt row is one kept pair's name, byte counts and sha256s, in name order, one row per pair" "$(yn rows_same)"
    bad_rows=$(tail -n +2 "$TXT" | awk -F'\t' 'NF != 9 || $6 !~ /^(ok|fail|error)$/ || $7 !~ /^(ok|fail|error)$/ || $8 !~ /^(none|refused|count|error)$/ || $9 !~ /^(none|refused|count|error)$/' | wc -l)
    check "every row has nine columns, lo_in and lo each ok, fail or error, and each class none, refused, count or error ($bad_rows rows otherwise)" "$(yn [ "$bad_rows" = 0 ])"
    bad_fit=$(tail -n +2 "$TXT" | awk -F'\t' '{ print $6 ":" $8; print $7 ":" $9 }' | LC_ALL=C "$G" -cvxE 'ok:none|fail:refused|fail:count|error:error')
    check "every side's class fits its verdict ($bad_fit sides otherwise)" "$(yn [ "$bad_fit" = 0 ])"
    stdout_rows() { [ "$(awk -F'\t' 'NF == 3' "$B/oc.stdout")" = "$(tail -n +2 "$TXT" | cut -f1,6,7)" ]; }
    check "the script's per-pair stdout lines are the .txt's test, lo_in and lo columns" "$(yn stdout_rows)"
    echo "command: python3 -I -B <work>/wb.py over each kept input: its xl/workbook.xml entry, its sheet elements by local name (expat, no pattern) and of them those with a prefix"
    cat >"$B/wb.py" <<'PY'
    import sys, zipfile
    from xml.parsers import expat
    for path in sys.argv[1:]:
        name = path.rsplit("/", 1)[1][: -len(".in.xlsx")]
        try:
            z = zipfile.ZipFile(path)
        except zipfile.BadZipFile:
            print("%s\tunreadable\t-\t-" % name)
            continue
        if "xl/workbook.xml" not in z.namelist():
            print("%s\tno\t-\t-" % name)
            continue
        found = {"all": 0, "prefixed": 0}
    
        def start(tag, attrs):
            prefix, _, local = tag.rpartition(":")
            if local == "sheet":
                found["all"] += 1
                found["prefixed"] += 1 if prefix else 0
        p = expat.ParserCreate()
        p.StartElementHandler = start
        try:
            p.Parse(z.read("xl/workbook.xml"), True)
        except expat.ExpatError:
            print("%s\tyes\tunparsed\t-" % name)
            continue
        print("%s\tyes\t%d\t%d" % (name, found["all"], found["prefixed"]))
    PY
    sed 's/^/    /' "$B/wb.py"
    python3 -I -B "$B/wb.py" $(sed "s#^#$KEEP/#; s#\$#.in.xlsx#" "$B/pair.names") | LC_ALL=C sort >"$B/wb.all"
    echo "  kept inputs by workbook entry and sheet elements (entry, all, prefixed: pairs):"
    cut -f2- "$B/wb.all" | sort | uniq -c | sed 's/^/    /'
    echo "  the .md checked against the .txt and the kept inputs, with the heading specs/0015 P2 verification ruling 1 gives: <work>/mdcheck.py, below"
    cat >"$B/mdcheck.py" <<'PY'
    import sys
    txt, md, wb = sys.argv[1:4]
    rows = [l.split("\t") for l in open(txt).read().split("\n")[1:] if l]
    sheets = {l.split("\t")[0]: l.split("\t")[2] for l in open(wb).read().split("\n") if l}
    text = open(md).read().split("\n")
    REFUSED = ("Inputs refused by LibreOffice (allowed: a fixture LibreOffice cannot load: zip-level,"
               " or a package with no relationships part or an empty content-types root)")
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line:
                out.append(line)
        return out
    
    
    def listed(names):
        return ["- `%s`" % n for n in names] if names else ["None."]
    
    
    def count(col, v):
        return sum(1 for r in rows if r[col] == v)
    
    
    totals = [len(rows)] + [count(5, v) for v in ("ok", "fail", "error")] + [count(6, v) for v in ("ok", "fail", "error")]
    classes = ["| %s | " % side + " | ".join(str(count(col, c)) for c in ("none", "refused", "count", "error")) + " |"
               for side, col in (("reason_in", 7), ("reason_out", 8))]
    tot = section("Totals")
    checks = [
        ("Totals", tot[2:3] == ["| " + " | ".join(str(t) for t in totals) + " |"] and tot[5:] == classes),
        ("the refused-inputs heading reads as ruled, once", text.count("## " + REFUSED) == 1),
        ("Inputs refused by LibreOffice", section(REFUSED) == listed([r[0] for r in rows if r[7] == "refused"])),
        ("the sheet count did not apply", section("Inputs the sheet count did not apply to (allowed: a workbook fixture with no sheet element)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) == "0"])),
        ("counts differ", section("Inputs whose sheet and table counts differ (a finding)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) != "0"])),
        ("Outputs refused on an accepted input", section("Outputs refused on an input LibreOffice accepted (a finding)") == listed([r[0] for r in rows if r[6] == "fail" and r[5] == "ok"])),
        ("Checks that did not run", section("Checks that did not run (error)") == listed([r[0] for r in rows if "error" in (r[5], r[6])])),
        ("Pairs", section("Pairs")[2:] == ["| `%s` | %s | %s | %s | %s | %s | %s | %s | %s |" % tuple(r) for r in rows]),
        ("the Pairs line", ("- Pairs: %d" % len(rows)) in text),
    ]
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("totals: pairs %d; lo_in ok %d fail %d error %d; lo ok %d fail %d error %d" % tuple(totals))
    PY
    sed 's/^/    /' "$B/mdcheck.py"
    python3 -I -B "$B/mdcheck.py" "$TXT" "$MD" "$B/wb.all" >"$B/mdcheck.out"
    sed 's/^/    /' "$B/mdcheck.out"
    md_all() { [ "$(count_matches -E ': yes$' "$B/mdcheck.out")" = 9 ] && [ "$(count_matches -E ': no$' "$B/mdcheck.out")" = 0 ]; }
    check "the .md's nine parts are derived from the .txt and the kept inputs' sheet elements, the heading as ruled" "$(yn md_all)"
    head -n 2 "$TXT" >"$B/c-short.txt"
    python3 -I -B "$B/mdcheck.py" "$B/c-short.txt" "$MD" "$B/wb.all" >"$B/c-mdcheck.out"
    md_ctl() { [ "$(count_matches -E ': no$' "$B/c-mdcheck.out")" -ge 1 ]; }
    check "control: the same check on a .txt cut to one row finds the .md does not match it" "$(yn md_ctl)"
    OLD8=records/m1p8-open-2026-09-24-da080f1
    python3 -I -B "$B/mdcheck.py" "$OLD8.txt" "$OLD8.md" "$B/wb.all" >"$B/c-prevmd.out"
    old_heading() { [ "$(count_matches -F 'the refused-inputs heading reads as ruled, once: no' "$B/c-prevmd.out")" = 1 ]; }
    check "control: the same check on part 8 P2's committed .md finds the old heading, not the ruled one" "$(yn old_heading)"
    totals_line() { [ "$(sed -n 's/^wrote .*\.txt: \(pairs [^;]*; lo_in [^;]*; lo [^;]*\); inputs refused .*/\1/p' "$B/oc.stdout")" = "$(sed -n 's/^totals: //p' "$B/mdcheck.out")" ]; }
    check "the script's totals line is the totals derived from the .txt" "$(yn totals_line)"
    echo
    echo "### the verdicts against the named record"
    join -t "$TAB" <(tail -n +2 "$B/prev.txt" | cut -f1,6,7,8,9 | LC_ALL=C sort) <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) >"$B/both"
    check "every pair of the named record has a row in this record" "$(yn [ "$(count_lines "$B/both")" = "$n_prev" ])"
    awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9 { print $1 "\t" $2 "/" $3 "/" $4 "/" $5 " -> " $6 "/" $7 "/" $8 "/" $9 }' "$B/both" >"$B/moved"
    echo "  the named record's pairs whose lo_in, lo or either class changed: $(count_lines "$B/moved")"
    sed 's/^/    /' "$B/moved"
    check "no verdict and no class of the named record's pairs moved" "$(yn [ "$(count_lines "$B/moved")" = 0 ])"
    printf 'x\tok\tok\tnone\tnone\tok\tfail\tnone\trefused\n' >"$B/c-both"
    moved_ctl() { [ "$(awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9' "$B/c-both" | wc -l)" = 1 ]; }
    check "control: the same form finds a planted row whose lo moved" "$(yn moved_ctl)"
    echo "  the changed pairs' verdicts (test, lo_in, lo, reason_in, reason_out; none expected, change NWF):"
    join -t "$TAB" "$B/changed.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) | sed 's/^/    /'
    echo "  the new pairs' verdicts (test, lo_in, lo, reason_in, reason_out):"
    join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) | sed 's/^/    /'
    no_new_finding() { [ "$(join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7 | LC_ALL=C sort) | awk -F'\t' '$2 == "ok" && $3 != "ok"' | wc -l)" = 0 ]; }
    check "no new pair's output is refused on an accepted input" "$(yn no_new_finding)"
    echo
    echo "### acceptance, and the inputs LibreOffice did not accept"
    tail -n +2 "$TXT" | awk -F'\t' -v OFS='\t' '{ print ($1 ~ /^emend-copy\./ ? "tool" : "crate"), $1, $6, $7, $8, $9 }' >"$B/verdicts"
    for side in crate tool; do
      n=$(awk -F'\t' -v s="$side" '$1 == s' "$B/verdicts" | wc -l)
      nfind=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "ok" && $4 == "fail"' "$B/verdicts" | wc -l)
      nerr=$(awk -F'\t' -v s="$side" '$1 == s && ($3 == "error" || $4 == "error")' "$B/verdicts" | wc -l)
      nin=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "fail"' "$B/verdicts" | wc -l)
      echo "  $side: pairs $n; inputs refused $nin; outputs refused on an accepted input $nfind; checks that did not run $nerr"
      check "$side: no output refused on an accepted input" "$(yn [ "$nfind" = 0 ])"
      check "$side: no check errored" "$(yn [ "$nerr" = 0 ])"
    done
    awk -F'\t' '$5 == "count" { print $2 }' "$B/verdicts" >"$B/count.pairs"
    awk -F'\t' '$2 == "yes" && $3 == "0" { print $1 }' "$B/wb.all" >"$B/zero.pairs"
    echo "  count-class inputs $(count_lines "$B/count.pairs"); kept inputs with a workbook entry and no sheet element $(count_lines "$B/zero.pairs")"
    check "the count-class inputs are exactly the kept inputs with a workbook entry and no sheet element, so no count differs" "$(yn cmp -s "$B/count.pairs" "$B/zero.pairs")"
    echo "  the pairs whose input LibreOffice did not accept, with the class of the input's reason:"
    awk -F'\t' '$3 != "ok" { print $2 "\t" $5 }' "$B/verdicts" | sed 's/^/    /'
    echo
    echo "### the open-check record installed into records/"
    echo "command: install -m 644 <scripts>/out/records/$STEM_OPEN.md <scripts>/out/records/$STEM_OPEN.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt")
    echo "  exit: $?"
    for f in "$STEM_OPEN.md" "$STEM_OPEN.txt"; do
      echo "    written <scripts>/out/records/$f: sha256 $(sha_of "$RECORDS/$f"), $(wc -c <"$RECORDS/$f") bytes"
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, byte for byte, mode 644" "$(yn inst_same "$f")"
    done
    fi
    
    echo
    echo "## the scale tiers, one run at a time, openpyxl then emend per op (decision 2 A; rulings L and M)"
    for tp in $SCALE_PLAN; do
      t=${tp%%:*}; op=${tp#*:}
      EDIT=${EDITS[$op]:--}
      TID=${TIER_ID[$t]}
      TIN=$SCALE/corpus/$TID.${TIER_EXT[$t]}
      SO=$RUN_SCALE_OUT/$RUN-openpyxl-scale-$t-$op
      SE=$RUN_SCALE_OUT/$RUN-scale-$t-$op
      if [ "$t" = a ]; then OPEN=yes; OPEN_WORD="the open check on"; else OPEN=no; OPEN_WORD="no open check (tier a only, ruling M)"; fi
      echo
      echo "## tier $t, $op: openpyxl, --memory 16384 --timeout 3600, $OPEN_WORD"
      ox_run "$SO" "$op" "$B/ids-$t" 16384 3600 "$OPEN" "$SCALE" 1 "$TIN" "$TID.${TIER_EXT[$t]}"
      for label in host i686; do
        # Ruling M: the host xlsx-diff for both labels on tier c.
        if [ "$t" = c ]; then XD=$XD_host; else var=XD_$label; XD=${!var}; fi
        echo
        echo "## tier $t, $op: emend, $label, --memory 2048 --timeout 3600$([ "$t" = c ] && echo ', the host xlsx-diff (ruling M)')"
        emend_run "$SE" "$label" "$B/ids-$t" "$XD" 2048 3600 "$OPEN" "$EDIT" "$SCALE" 1
      done
      echo
      echo "## tier $t, $op: the record pairs"
      write_record "$SO" "m5p6-openpyxl-scale-$t-$op-$RUN" "- openpyxl: version 3.1.5; op $op" --allow-single
      if [ "$EDIT" = - ]; then TOOLLINE="- Tool arguments: none"; else TOOLLINE="- Tool arguments: $EDIT"; fi
      write_record "$SE" "m5p6-scale-$t-$op-$RUN" "$TOOLLINE"
    done
    
    echo
    if [ "$RESTRICTED" = yes ]; then
    echo "## the comparison record: SKIPPED (a restricted dry run; change RH)"
    else
    echo "## the comparison record, by scripts/compare-record.py from the run directories (change RH)"
    echo "command: python3 -I -B scripts/compare-record.py --corpus-runs <runs> --scale-runs <scaleruns> --stamp $RUN --image-record $IMAGE_RECORD --out <scripts>/out/records"
    python3 -I -B scripts/compare-record.py --corpus-runs "$RUN_OUT_ROOT" --scale-runs "$RUN_SCALE_OUT" --stamp "$RUN" \
      --image-record "$IMAGE_RECORD" --out "$RECORDS" >"$B/compare.out" 2>"$B/compare.err"
    crc=$?
    echo "  exit $crc; stderr bytes $(wc -c <"$B/compare.err")"
    sed 's/^/    /' "$B/compare.out"
    check "the comparison record script exits 0 with nothing on stderr" "$(yn [ "$crc" = 0 ])"
    check "its one line names the stem, 11 ops and 72 scale rows" "$(yn [ "$(cat "$B/compare.out")" = "wrote $STEM_COMPARE.md: ops 11; scale rows 72" ])"
    check "the comparison record script left nothing on stderr" "$(yn [ ! -s "$B/compare.err" ])"
    echo "  the record's re-derivation, from the summaries, run and empty-run files alone, by this log's own program: <work>/derive.py, below"
    cat >"$B/derive.py" <<'PY'
    """This log's re-derivation of the comparison record (change RH): every row
    of every table, built again from the run directories' summary, run and
    empty-run files and the openpyxl rows' stdout files, compared cell by cell
    with the record's table; then the derivations specs/0037 "What is measured
    and how it is read" names, printed. It does not import
    scripts/compare-record.py."""
    import hashlib
    import os
    import re
    import statistics
    import sys
    
    corpus_runs, scale_runs, stamp, image_record, md = sys.argv[1:6]
    OPS = ["roundtrip", "read", "edit", "format", "insert-rows", "names", "table",
           "comment", "image", "add-chart", "copy"]
    OUTS = ["ok", "error", "timeout", "cap", "no-output", "panic", "crash"]
    ENTRY = ["identical", "recompressed", "changed", "dropped", "added"]
    LO = ["ok", "fail", "error", "-"]
    
    
    def rows_of(path):
        lines = [l for l in open(path, encoding="utf-8").read().split("\n") if l]
        head = lines[0].split("\t")
        return [dict(zip(head, l.split("\t"))) for l in lines[1:]]
    
    
    def num(v):
        return "%d" % v if float(v) == int(v) else "%.2f" % v
    
    
    def middle(path):
        return "%.2f" % sorted(float(r["wall_s"]) for r in rows_of(path))[1]
    
    
    def corpus_row(rows, lo_in_rows):
        cells = [str(len(rows))] + [str(sum(r["outcome"] == o for r in rows)) for o in OUTS]
        cells += [str(sum(int(r[c]) for r in rows if r[c].isdigit())) for c in ENTRY]
        cells += [str(sum(r["lo"] == v for r in rows)) for v in LO]
        cells += [str(sum(r["lo_in"] == v for r in lo_in_rows)) for v in LO]
        w = [float(r["wall_s"]) for r in rows if re.fullmatch(r"[0-9]+([.][0-9]+)?", r["wall_s"])]
        m = [int(r["peak_rss_kb"]) for r in rows if r["peak_rss_kb"].isdigit()]
        cells += [num(statistics.median(w)) if w else "-", num(sum(w)) if w else "-",
                  num(statistics.median(m)) if m else "-", num(max(m)) if m else "-"]
        return cells
    
    
    def table(heading):
        lines = open(md, encoding="utf-8").read().split("\n")
        i = lines.index(heading)
        out = []
        for line in lines[i + 1:]:
            if line.startswith("## "):
                break
            if line.startswith("| ") and not line.startswith("| ---"):
                out.append([c.strip() for c in line.strip("|").split("|")])
        return out[1:]
    
    
    want_corpus, want_detail, figures = [], [], []
    for op in OPS:
        e = os.path.join(corpus_runs, "%s-%s" % (stamp, op))
        o = os.path.join(corpus_runs, "%s-openpyxl-%s" % (stamp, op))
        host, i686, ox = rows_of(e + "/summary.host.tsv"), rows_of(e + "/summary.i686.tsv"), rows_of(o + "/summary.openpyxl.tsv")
        want_corpus += [[op, "emend", "host"] + corpus_row(host, host), [op, "emend", "i686"] + corpus_row(i686, i686),
                        [op, "openpyxl", "openpyxl"] + corpus_row(ox, host)]
        runs = rows_of(o + "/run.openpyxl.tsv")
        classes = {}
        for r in ox:
            if r["outcome"] == "error":
                try:
                    first = open(os.path.join(o, r["id"], "stdout.openpyxl.txt"), encoding="utf-8").readline().strip()
                except OSError:
                    first = ""
                name = first if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.]*", first) else "unread"
                classes[name] = classes.get(name, 0) + 1
        want_detail.append([op, os.path.basename(o), "timeout %s s; memory %s MiB" % (
            ", ".join(sorted({r["timeout_s"] for r in runs})), ", ".join(sorted({r["memory_mib"] for r in runs}))),
            middle(o + "/empty.openpyxl.tsv"), os.path.basename(e),
            ", ".join("%s %d" % (k, classes[k]) for k in sorted(classes)) or "none"])
        figures.append((op, host, i686, ox))
    want_scale = []
    for tier, ops in (("a", OPS), ("b", OPS), ("c", ["roundtrip"]), ("d", ["roundtrip"])):
        for op in ops:
            e = os.path.join(scale_runs, "%s-scale-%s-%s" % (stamp, tier, op))
            o = os.path.join(scale_runs, "%s-openpyxl-scale-%s-%s" % (stamp, tier, op))
            for tool, label, d in (("emend", "host", e), ("emend", "i686", e), ("openpyxl", "openpyxl", o)):
                r = rows_of("%s/summary.%s.tsv" % (d, label))[0]
                want_scale.append([tier, op, tool, label] + [r[c] or "-" for c in
                                  ("outcome", "exit", "wall_s", "peak_rss_kb", "in_bytes", "out_bytes")] +
                                  [r[c] or "-" for c in ENTRY] + [r["lo"] or "-"] +
                                  [middle(d + "/empty.openpyxl.tsv") if tool == "openpyxl" else "-"])
    checks = []
    for name, heading, want in (("corpus", "## The corpus, per op", want_corpus),
                                ("openpyxl detail", "## The openpyxl runs: settings, container start and error classes", want_detail),
                                ("scale", "## The scale tiers", want_scale)):
        have = table(heading)
        diff = sum(1 for a, b in zip(have, want) if a != b) + abs(len(have) - len(want))
        print("%s: rows in the record %d; rows derived %d; rows that differ %d" % (name, len(have), len(want), diff))
        checks.append(diff == 0)
    sha = hashlib.sha256(open(image_record, "rb").read()).hexdigest()
    img = "`records/%s`, sha256 %s." % (os.path.basename(image_record), sha) in open(md, encoding="utf-8").read()
    print("the image record's line names its sha256 %s: %s" % (sha, "yes" if img else "no"))
    checks.append(img)
    print("derived equal: %s" % ("yes" if all(checks) else "no"))
    print("the derivations (specs/0037 \"What is measured and how it is read\"):")
    for op, host, i686, ox in figures:
        def med(rows, col):
            v = [float(r[col]) for r in rows if re.fullmatch(r"[0-9]+([.][0-9]+)?", r[col])]
            return statistics.median(v) if v else None
        parts = []
        for tool, rows in (("emend host", host), ("emend i686", i686), ("openpyxl", ox)):
            rss = [int(r["peak_rss_kb"]) for r in rows if r["peak_rss_kb"].isdigit()]
            parts.append("%s: outputs %d of %d, identical %d, dropped %d, opened %d, wall median %s s, peak RSS median %s kB max %s kB" % (
                tool, sum(r["outcome"] == "ok" for r in rows), len(rows),
                sum(int(r["identical"]) for r in rows if r["identical"].isdigit()),
                sum(int(r["dropped"]) for r in rows if r["dropped"].isdigit()),
                sum(r["lo"] == "ok" for r in rows), num(med(rows, "wall_s")) if med(rows, "wall_s") is not None else "-",
                num(statistics.median(rss)) if rss else "-", max(rss) if rss else "-"))
        a, b = med(ox, "wall_s"), med(host, "wall_s")
        ratio = "%.2f" % (a / b) if a is not None and b else "-"
        print("  %s: %s; the ratio of openpyxl's median wall time over emend host's: %s" % (op, "; ".join(parts), ratio))
    PY
    sed 's/^/    /' "$B/derive.py"
    python3 -I -B "$B/derive.py" "$RUN_OUT_ROOT" "$RUN_SCALE_OUT" "$RUN" "$IMAGE_RECORD" "$RECORDS/$STEM_COMPARE.md" >"$B/derive.out" 2>&1
    drc=$?
    echo "  exit: $drc"
    sed 's/^/    /' "$B/derive.out"
    check "every row of the comparison record is the one derived here from the summaries (corpus, openpyxl detail and scale tables), and its image line names the record's sha256" "$(yn [ "$(count_matches -xF 'derived equal: yes' "$B/derive.out")" = 1 ])"
    sed -E '0,/^\| roundtrip \| emend \| host \| [0-9]+ \|/s//| roundtrip | emend | host | 999999 |/' "$RECORDS/$STEM_COMPARE.md" >"$B/c-compare.md"
    python3 -I -B "$B/derive.py" "$RUN_OUT_ROOT" "$RUN_SCALE_OUT" "$RUN" "$IMAGE_RECORD" "$B/c-compare.md" >"$B/c-derive.out" 2>&1
    check "control: the same derivation finds the one planted wrong cell (the first row's file count)" "$(yn [ "$(count_matches -xF 'corpus: rows in the record 33; rows derived 33; rows that differ 1' "$B/c-derive.out")" = 1 ])"
    echo "command: install -m 644 <scripts>/out/records/$STEM_COMPARE.md <repo>/$RECORDS_DEST/"
    install -m 644 "$RECORDS/$STEM_COMPARE.md" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM_COMPARE.md")
    echo "  exit: $?"
    echo "    installed $RECORDS_DEST/$STEM_COMPARE.md: sha256 $(sha_of "$RECORDS_DEST/$STEM_COMPARE.md"), $(wc -c <"$RECORDS_DEST/$STEM_COMPARE.md") bytes, mode $(stat -c %a "$RECORDS_DEST/$STEM_COMPARE.md")"
    check "the installed $STEM_COMPARE.md is the written one, mode 644" "$(yn inst_same "$STEM_COMPARE.md")"
    N_INST_WANT=$((N_INST_WANT + 1))
    fi
    podman ps -a --filter "ancestor=$OX_IMAGE" --format '{{.Names}}' </dev/null >"$B/ox-containers-end"
    echo "command: podman ps -a --filter ancestor=$OX_IMAGE --format '{{.Names}}': containers of the image at the end: $(count_lines "$B/ox-containers-end")"
    check "no container of the openpyxl image is left at the end (ruling A)" "$(yn [ "$(count_lines "$B/ox-containers-end")" = 0 ])"
    
    echo "## the record files this run installed hold no path"
    echo "  record files installed by this run: ${#INSTALLED[@]}"
    no_path() {
      local f
      [ "${#INSTALLED[@]}" -ge 1 ] || return 1
      for f in "${INSTALLED[@]}"; do
        [ "$(count_matches -F "$HOME" "$f")" = 0 ] || return 1
        [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$f")" = 0 ] || return 1
      done
    }
    check "no record file this run installed names <home>, a home, mount, temporary or corpus path" "$(yn no_path)"
    n_inst_want=$N_INST_WANT
    if [ "$RUN_SKIP_KEEP" = no ]; then n_inst_want=$((n_inst_want + 2)); fi
    check "this run installed the record files it writes ($n_inst_want: every run's record pair, the comparison record unless the run was restricted, and the open pair unless the keep was skipped; change RJ)" "$(yn [ "${#INSTALLED[@]}" = "$n_inst_want" ])"
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x' >"$B/c-path"
    path_ctl() { [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$B/c-path")" = 1 ]; }
    check "control: the same form finds a planted path" "$(yn path_ctl)"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  planning's uncommitted spec: $SPEC, sha256 $(sha_of "$SPEC")"
    echo "status lines: $st_all; of them this phase's logs, its record pairs or planning's uncommitted spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources (the phase commit's, by git show)
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

