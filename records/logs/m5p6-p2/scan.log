    printf 'x %s(ynnot %s%s /usr/bin/grep -q x f)\n' '$' 'LC_ALL' '=C' >"$T/g-assign-ynnot"
    check_ctl "f_shape on a fixture holding the chained form after ynnot (change BW)" 1 f_shape "$T/g-shape-ynnot"
    check_ctl "f_bang on a fixture holding the leading-bang form after ynnot (change BW)" 1 f_bang "$T/g-bang-ynnot"
    check_ctl "f_assign on a fixture holding the assignment-prefix form after ynnot (change BW)" 1 f_assign "$T/g-assign-ynnot"
    g_shape=$(f_shape "$0"); g_bang=$(f_bang "$0"); g_assign=$(f_assign "$0"); g_pyb=$(f_pyb "$0")
    echo "  over this script's source: chained=$g_shape leading-bang=$g_bang assignment=$g_assign python-without-I-B=$g_pyb"
    self_shapes_clean() { [ "$g_shape" = 0 ] && [ "$g_bang" = 0 ] && [ "$g_assign" = 0 ] && [ "$g_pyb" = 0 ]; }
    structural "this script's own source holds none of the three shapes and no Python call without -I -B (change FO), checked before it is printed" \
      "$(yn self_shapes_clean)"
    echo
    echo "## the phase's commits by role"
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $HEAD_SHA"
    structural "the phase commit given to this script is HEAD" "$(yn is_head "$C")"
    structural "control: the same form refuses a commit that is not HEAD" \
      "$(yn not_head "$NULL_SHA")"
    structural "control: the same form refuses a short sha of the real commit" \
      "$(yn not_head "$(printf '%s' "$C" | cut -c1-7)")"
    echo "command: git log --format='%H' --grep='$DOC_PATTERN'"
    echo "  commits matching the pattern: $NDOC"
    echo "  the doc commit resolves to $DOC; its parent is the base, $BASE"
    echo "command: git log -1 --format='%s' $BASE"
    BASE_SUBJECT=$(git log -1 --format='%s' "$BASE")
    echo "    $BASE_SUBJECT"
    BASE_PREFIX='M5 part 6 P1 record: '
    base_is_closeout_record() { case "$1" in "$BASE_PREFIX"*) return 0 ;; *) return 1 ;; esac; }
    not_closeout_record() { if base_is_closeout_record "$1"; then return 1; else return 0; fi; }
    echo "command: git log --reverse --format='%H %s' $BASE..$C"
    git log --reverse --format='%H %s' "$BASE..$C" >"$T/phase-commits"
    sed 's/^/    /' "$T/phase-commits"
    PHASE_PREFIX='M5 part 6 P2: '
    DOC_SUBJECT='M5 part 6 P2: commit planning docs '
    : >"$T/phase-docs"; : >"$T/phase-code"; nforeign=0; doc_after_code=0; last_code=
    while IFS=' ' read -r sha subj; do
