        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' \
            "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
    fi
    # SERIALIZED as the coordinator arranged, with the measurement at entry
    # (change I, P2 verification ruling 6).
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight (the coordinator's arrangement); cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc"
    structural "no cargo or rustc process was running at entry" "$(yn [ "$((n_cargo + n_rustc))" = 0 ])"
    # One line per root (change I, P2 verification ruling 5).
    echo "root: <scratch> stands for <home>/.cache/emend-build/m5p6-p2, the phase's directory, the name specs/0032 close-out ruling 1 gives it (change FN); <scratch>/tmp is TMPDIR, made if missing, and this run's mktemp -d working directory (the fixtures, copies and message files) lies under it, deleted on exit"
    echo "root: <phase> stands for <home>/.cache/emend-build/m5p6-p2, the phase's directory on disk, the directory above this script's own (change AM); <phase>/superseded keeps superseded attempts"
    echo "root: <phase>/scripts stands for this script's own directory, which holds the script the invocation names and, in <phase>/scripts/out, its own standard error (changes R and Q)"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to; scripts/counting.sh is sourced from it and every file scanned is read from it or from git"
    script_dir_is_scripts() { [ "$(cd "$(dirname "$0")" && pwd)" = "$SROOT/scripts" ]; }
    structural "the script's own directory is <phase>/scripts" "$(yn script_dir_is_scripts)"
    phase_dir_is_m5p6p2() { [ "$SROOT" = "$HOME/.cache/emend-build/m5p6-p2" ]; }
    structural "the phase's directory is <home>/.cache/emend-build/m5p6-p2 (change AM)" "$(yn phase_dir_is_m5p6p2)"
    # Change FN: TMPDIR and the working directory, with a control.
    tmpdir_is_scratch() { [ "$TMPDIR" = "$SROOT/tmp" ]; }
    under_tmpdir() { case "$1" in "$TMPDIR"/*) return 0 ;; *) return 1 ;; esac; }
    not_under_tmpdir() { if under_tmpdir "$1"; then return 1; else return 0; fi; }
    structural "TMPDIR is <scratch>/tmp, the phase's directory's tmp (change FN)" "$(yn tmpdir_is_scratch)"
    structural "this run's mktemp -d working directory lies under TMPDIR (change FN)" "$(yn under_tmpdir "$T")"
    structural "control: the same check refuses a directory beside TMPDIR, not under it (change FN)" "$(yn not_under_tmpdir "$SROOT/tmpx/w")"
    if [ -n "$PLANNING_SPEC" ]; then
      structural "the spec in the working tree hashes to PLANNING_SPEC, planning's uncommitted copy (change AV)" "$(yn [ "$SPEC_SHA" = "$PLANNING_SPEC" ])"
      planning_spec_ctl() { if [ "$SPEC_AT_C" = "$PLANNING_SPEC" ]; then return 1; else return 0; fi; }
      structural "control: the same comparison refuses the phase commit's copy against PLANNING_SPEC (change AV)" "$(yn planning_spec_ctl)"
    else
      structural "the spec in the working tree hashes to the pin (change AN)" "$(yn [ "$SPEC_SHA" = "$SPEC_PIN" ])"
    fi
    structural "the spec at the phase commit hashes to the pin (change AN)" "$(yn [ "$SPEC_AT_C" = "$SPEC_PIN" ])"
    # Change AP: every superseded file a rerun names lies in <phase>/superseded.
    rerun_files_kept() {
      local sf
      for sf in ${RERUN_FILES:-}; do
        case "$sf" in "$SUP_DIR"/*) ;; *) return 1 ;; esac
      done
      return 0
    }
    structural "every file RERUN_FILES names lies in <phase>/superseded (change AP)" "$(yn rerun_files_kept)"
    kept_ctl() { local RERUN_FILES="$SROOT/elsewhere/x.log"; if rerun_files_kept; then return 1; else return 0; fi; }
    structural "control: the same check refuses a file outside it" "$(yn kept_ctl)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY+set}" ]; }
    structural "ANTHROPIC_API_KEY is not set in this shell (change AU)" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; if key_unset; then return 1; else return 0; fi; }
    structural "control: the same check refuses a shell where it is set" "$(yn key_set_ctl)"
    dirs_default() { [ "$LOGDIR" = records/logs/m5p6-p2 ] && [ "$RECDIR" = records ]; }
    structural "LOGDIR and RECDIR are the defaults, so this is not a dry run (change AK)" "$(yn dirs_default)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    together() { if apart "$1" "$2"; then return 1; else return 0; fi; }
    structural "this run's working directory and <repo> are distinct directories, neither inside the other (change FP)" "$(yn apart "$T" "$MAIN")"
    structural "control: the same form refuses a root inside the other" "$(yn together "$SROOT/scripts" "$SROOT")"
    structural "the doc commit pattern matches exactly one commit" "$(yn [ "$NDOC" = 1 ])"
    structural "the base is M5 part 6 P1's record commit, by its subject (change IE)" "$(yn base_is_closeout_record "$BASE_SUBJECT")"
    structural "control: the same form refuses P1's runner commit's subject, the base's parent's (change IE)" \
      "$(yn not_closeout_record "M5 part 6 P1: scripts/compare-run.sh and the record script's openpyxl label")"
    echo
    echo "## the records this phase writes, by stem (changes CA, EY and FJ)"
    echo "  the pair stems, a .md and a .txt each, -<date>-$SHORT: $PAIR_STEMS ($NPAIR)"
    echo "  the single stems, a .md each, -<date>-$SHORT: $SINGLE_STEMS ($NSINGLE)"
    echo "  record files expected: $NREC_WANT"
    structural "the pair stems are 71 and the single stems one (change IF)" "$(yn [ "$NPAIR.$NSINGLE" = 71.1 ])"
    # count_found <dir>: the phase's records found in <dir>, by the same list the
    # scan below reads; the control runs it over a fixture directory (change CA).
    count_found() {
      local RECDIR=$1 n=0 f
      for f in $(phase_records); do [ -f "$f" ] && n=$((n + 1)); done
      printf '%s' "$n"
    }
    mkdir -p "$T/c-rec"
    : >"$T/c-rec/m5p6-edit-2026-01-01-$SHORT.md"
    : >"$T/c-rec/m5p6-edit-2026-01-01-$SHORT.txt"
    : >"$T/c-rec/m5p6-openpyxl-scale-b-copy-2026-01-01-$SHORT.md"
    : >"$T/c-rec/compare-m5p6-2026-01-01-$SHORT.md"
    : >"$T/c-rec/compare-m5p6-2026-01-01-$SHORT.txt"
    : >"$T/c-rec/openpyxl-image-2026-01-01.md"
    : >"$T/c-rec/m5p6-edit-x-2026-01-01-$SHORT.md"
    : >"$T/c-rec/m5p6-openpyxl-scale-c-copy-2026-01-01-$SHORT.md"
    : >"$T/c-rec/m5p6-edit-2026-01-01-0000000.md"
    check_ctl "count_found on a fixture with one emend corpus pair, one openpyxl scale record and the comparison record of this sha, and a .txt beside the comparison record, an image record of a date, a longer stem, a tier c op that is not roundtrip and a record of another sha, same command form (changes DE, EY, FS, FX and IF)" 4 count_found "$T/c-rec"
    structural "every commit of the range carries the phase's subject prefix" "$(yn [ "$nforeign" = 0 ])"
    docs_present() { [ "$NDOCS" != error ] && [ "$NDOCS" -ge 1 ]; }
    structural "the range holds at least one doc commit" "$(yn docs_present)"
    structural "the first doc commit listed is the one the pattern found" "$(yn first_doc_is_pattern)"
    structural "the range holds at least one code commit (changes EO and EZ)" "$(yn code_present)"
    structural "no doc commit follows a code commit" "$(yn [ "$doc_after_code" = 0 ])"
    # Change DK: each commit's role by the paths it touches. role_paths_ok
    # <commit> <ERE>: the commit touches at least one path and every path it
    # touches matches the pattern. It prints nothing.
    DOC_PATHS='^(specs/[^/]+[.]md|ROADMAP[.]md)$'
    CODE_PATHS='^scripts/[^/]+[.](sh|py)$'
    role_paths_ok() {
      local n m
      git diff-tree --no-commit-id --name-only -r "$1" >"$T/role-paths" 2>/dev/null || return 1
      n=$(count_lines "$T/role-paths")
      m=$(count_matches -E "$2" "$T/role-paths")
      [ "$n" != error ] || return 1
      [ "$m" != error ] || return 1
      [ "$n" -gt 0 ] || return 1
      [ "$n" = "$m" ]
    }
    role_paths_refused() { if role_paths_ok "$1" "$2"; then return 1; else return 0; fi; }
    echo "command: git diff-tree --no-commit-id --name-only -r <commit>, for every commit of the range"
    while IFS= read -r c; do
      echo "  doc commit $c touches: $(git diff-tree --no-commit-id --name-only -r "$c" | tr '\n' ' ')"
      structural "  doc commit $c touches specs/*.md and ROADMAP.md alone (changes DK and EZ)" "$(yn role_paths_ok "$c" "$DOC_PATHS")"
    done <"$T/phase-docs"
    while IFS= read -r c; do
      echo "  code commit $c touches: $(git diff-tree --no-commit-id --name-only -r "$c" | tr '\n' ' ')"
      structural "  code commit $c touches .sh and .py files under scripts/ alone (changes DK, FL and IH)" "$(yn role_paths_ok "$c" "$CODE_PATHS")"
    done <"$T/phase-code"
    P1PH=$(git log --format='%H' -n 1 -F --grep="M4 part 2 P1: the README and the licence texts in the package" "$C")
