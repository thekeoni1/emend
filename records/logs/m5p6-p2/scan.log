    #      specs/0037, so a run gives PLANNING_SPEC (change AV). Planning's files
    #      are the TWO the doc commit holds, specs/0037 and ROADMAP.md (both
    #      modified), the control refusing P1's doc commit (three files), found
    #      by its subject; the listing of modified planning files reads specs/0037
    #      and ROADMAP.md. The commit-message rule's fixtures name M5 part 6 P2.
    #  IF. The logs and records: FOUR sibling logs, gate, test, negative and run,
    #      every one printing a script, so SIBLINGS and SCRIPT_LOGS are the same
    #      four. The records are named by the short sha: 71 pairs, a .md and a
    #      .txt each (the eleven ops' emend corpus records m5p6-<op> and openpyxl
    #      corpus records m5p6-openpyxl-<op>; the scale records
    #      m5p6-scale-<tier>-<op> and m5p6-openpyxl-scale-<tier>-<op>, tiers a
    #      and b for every op and c and d for roundtrip, ruling L; the open
    #      record m5p6-open) and one single record, a .md, the comparison record
    #      compare-m5p6; no dated record. Every record named by the short sha is
    #      one of these (P1's "none" and "one image record" checks give way to
    #      part 5 P4's form). The fixture control plants one emend corpus pair,
    #      one openpyxl scale record and the comparison record of this sha
    #      (counted, 4), and an image record, a .txt beside the comparison
    #      record, a longer stem and a P1 record of another sha (none counted);
    #      the status admits this phase's log directory and records, by what
    #      each alternative admits.
    #  IG. No archive in this phase's diff: P1's archive reading (change IC)
    #      stands for any file of the diff, and the phase's archives must be
    #      none; the control counts one planted archive line. The signature
    #      controls read P1's committed fixture, outside this range.
    #  IH. The roles: P2's trap, start and compare commits by their full
    #      subjects, the compare commit the phase commit touching
    #      scripts/compare-record.py and scripts/compare-record-test.py alone,
    #      its parent the start commit (scripts/passthrough-record.py alone),
    #      whose parent is the trap commit (scripts/compare-run.sh alone), the
    #      doc commit's child; each with a control refusing another role's
    #      commit. Change GN's control refuses the start commit, the phase
    #      commit's parent, whose message names no sha256. The code paths: .sh
    #      and .py files under scripts/; the controls accept M4 part 1 P1's
    #      runner commit and refuse P1's ops commit (the Containerfile and the
    #      fixture), M4 part 2 P1's phase commit, M5 part 1 P3's probe commit,
    #      part 4 P3's CHANGELOG commit and part 5 P3's tool commit.
    #  II. Rulings Q and R (specs/0037, the planning rulings during P2, second
    #      set): the run log ended "run log checks all as expected: no" and
    #      stays as records/logs/m5p6-p2/run.log; the check-only log, check.log,
    #      reran its failing checks with the fix named. So FIVE sibling logs,
    #      gate, test, negative, run and check, every one printing a script,
    #      SIBLINGS and SCRIPT_LOGS the same five.
    set -uo pipefail
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    SELF_DIR0=$(cd "$(dirname "$0")" && pwd)
    mkdir -p "$SELF_DIR0/out" || exit 2
    ERR=$SELF_DIR0/out/scan-${2:-none}.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    . scripts/counting.sh
    # Change FN (specs/0032 close-out ruling 1): every temporary file of this run
    # lies under <scratch>/tmp, <scratch> the phase's directory.
    TMPDIR=$(cd "$SELF_DIR0/.." && pwd)/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    
    unset EMEND_PRIVATE_DENYLIST
    DENY_FILE=$HOME/.config/emend/private-denylist.txt
    COAUTHOR='Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>'
    # The close-out's other line, which this range does not carry (change C): a
    # refusal control, never an accepted line.
    COAUTHOR_OTHER='Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>'
    # coauthor_ok <line>: the line is the one this range carries (change C).
    coauthor_ok() { [ "$1" = "$COAUTHOR" ]; }
    coauthor_refused() { if coauthor_ok "$1"; then return 1; else return 0; fi; }
    T=$(mktemp -d)
    trap 'rm -rf "${T:?}"' EXIT INT TERM HUP
    EMDASH=$(printf '\342\200\224')
    HOST=$(hostname)
    FQDN=$(hostname -f 2>/dev/null || hostname)
    hits=0; err=0; bad=0; ctl_fail=0
    
    DOC_PATTERN='^M5 part 6 P2: commit planning docs [(]the P1 verification and rulings[)]'
    git log --format='%H' --grep="$DOC_PATTERN" >"$T/doc-matches"
    NDOC=$(count_lines "$T/doc-matches")
    DOC=$(git log --format='%H' --grep="$DOC_PATTERN" -n 1)
    [ -n "$DOC" ] || { echo "the phase's doc commit was not found" >&2; exit 2; }
    BASE=$(git rev-parse --verify "$DOC^") || { echo "cannot resolve the base" >&2; exit 2; }
    C=${1:?phase commit required}
    SHORT=$(git rev-parse --short=7 "$C")
    # Change AK: where the sibling logs and records are read from; the values as
    # given are kept for the input lines (change AO).
    if [ -n "${LOGDIR+set}" ]; then LOGDIR_IN=$LOGDIR; fi
    if [ -n "${RECDIR+set}" ]; then RECDIR_IN=$RECDIR; fi
    LOGDIR=${LOGDIR:-records/logs/m5p6-p2}
    RECDIR=${RECDIR:-records}
    # Four, two and two digits: a stem that begins another's cannot match the
    # other's records (change BY).
    DATE_GLOB='[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
    # The stems of the phase's record pairs, a .md and a .txt each (change IF):
    # the eleven ops' emend and openpyxl corpus records, the scale records of
    # both tools (tiers a and b for every op, c and d for roundtrip; specs/0037
    # ruling L) and the open record, built from the op and tier lists.
    OPS_LIST="roundtrip read edit format insert-rows names table comment image add-chart copy"
    PAIR_STEMS=""
    for op in $OPS_LIST; do PAIR_STEMS="$PAIR_STEMS m5p6-$op m5p6-openpyxl-$op"; done
    for tier in a b; do
      for op in $OPS_LIST; do PAIR_STEMS="$PAIR_STEMS m5p6-scale-$tier-$op m5p6-openpyxl-scale-$tier-$op"; done
    done
    for tier in c d; do PAIR_STEMS="$PAIR_STEMS m5p6-scale-$tier-roundtrip m5p6-openpyxl-scale-$tier-roundtrip"; done
    PAIR_STEMS="${PAIR_STEMS# } m5p6-open"
    NPAIR=$(printf '%s\n' $PAIR_STEMS | wc -l)
    # The stems of the phase's single records, a .md alone (change IF): the
    # comparison record scripts/compare-record.py writes.
    SINGLE_STEMS="compare-m5p6"
    NSINGLE=$(printf '%s\n' $SINGLE_STEMS | wc -l)
    # The phase's records (change CH), one list for every loop that reads them. A
    # glob that matches nothing is printed as written and fails the -f test of the
    # loop that reads it, so a missing record lowers the count.
    phase_records() {
      local s
      for s in $PAIR_STEMS; do
        printf '%s\n' "$RECDIR/$s"-$DATE_GLOB-"$SHORT".md
        printf '%s\n' "$RECDIR/$s"-$DATE_GLOB-"$SHORT".txt
      done
      for s in $SINGLE_STEMS; do
        printf '%s\n' "$RECDIR/$s"-$DATE_GLOB-"$SHORT".md
      done
    }
    # Two files per pair stem and one per single stem (changes CO, EY and IF).
    NREC_WANT=$((2 * NPAIR + NSINGLE))
    # The sibling logs (change BV), one list; every count below is derived from
    # it. Five, the run and check logs among them, no self-test log (changes FT,
    # IF and II): the phase changes no gate file. Every sibling prints a script,
    # so SCRIPT_LOGS, read by the shape greps, the removal classification and
    # the spec pin, is the same list.
    SIBLINGS="$LOGDIR/gate.log $LOGDIR/test.log $LOGDIR/negative.log $LOGDIR/run.log $LOGDIR/check.log"
    NSIB=$(printf '%s\n' $SIBLINGS | wc -l)
    SCRIPT_LOGS="$LOGDIR/gate.log $LOGDIR/test.log $LOGDIR/negative.log $LOGDIR/run.log $LOGDIR/check.log"
    NSCRIPT=$(printf '%s\n' $SCRIPT_LOGS | wc -l)
    STAGE=${2:?stage required: pre-check or final}
    case $STAGE in pre-check | final) ;; *) echo "the stage must be pre-check or final" >&2; exit 2 ;; esac
    HEAD_SHA=$(git rev-parse HEAD)
    # specs/0001 "Rules for every phase" (M1 part 3 P1 ruling 11): the phase
    # commit is GIVEN to the script and compared with HEAD, with a control that
    # refuses a fabricated commit, and the header prints both values and the
    # comparison. A header that reads HEAD and prints it twice asserts nothing.
    NULL_SHA=0000000000000000000000000000000000000000
    full_sha() {
      # /usr/bin/grep explicitly: in this tool shell `grep` is a different
      # program (specs/0001, "Rules for every phase").
      printf '%s' "$1" | LC_ALL=C /usr/bin/grep -qE '^[0-9a-f]{40}$'
    }
    is_head() { full_sha "$1" && [ "$1" = "$HEAD_SHA" ]; }
    not_head() { if is_head "$1"; then return 1; else return 0; fi; }
    ID_EMAIL=$(git show "$C:scripts/privacy-identity.txt" | sed -n 2p)
    EMAIL_RE='[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+([.][A-Za-z0-9-]+)*[.][A-Za-z]{2,}'
    
    P6=()
    while IFS= read -r line; do P6+=("$line"); done < scripts/privacy-patterns.txt
    printf '%s\n' "${P6[@]}" >"$T/p6-patterns"
    PRE_COMMIT=$(git log --format='%H' --grep='^T0 P6d: narrow the three path patterns' -n 1)
    [ -n "$PRE_COMMIT" ] || { echo "cannot find the P6d narrowing commit" >&2; exit 2; }
    git show "$PRE_COMMIT^:scripts/privacy-patterns.txt" >"$T/pre-all" ||
      { echo "cannot read the pre-P6d patterns" >&2; exit 2; }
    sed -n '8p'  "$T/pre-all" >"$T/pre1"
    sed -n '10p' "$T/pre-all" >"$T/pre2"
    sed -n '11p' "$T/pre-all" >"$T/pre3"
    cat "$T/pre1" "$T/pre2" "$T/pre3" >"$T/pre-patterns"
    printf '%s\n%s\n' "$HOST" "$FQDN" | sort -u >"$T/host-patterns"
    # f_home came in with part 2 P3 and is inherited here, not new in this run.
    # The two sentences that stood here claimed it was new and claimed that both
    # independent checks of THIS phase had found an absolute path in negative.log
    # and observed that no form could catch it. Neither was true of part 3 P1:
    # those were part 2 P3's findings, and the comment was carried over verbatim
    # from that phase's script, where it was true; part 3 P1's independent
    # check 3 found it committed there. A comment that asserts what a check found is a claim like
    # any other and goes stale when the script is reused, so this one now says
    # what the form DOES rather than who asked for it.
    #
    # What the form is for: the P6d patterns are narrowed to one host's
    # user-directory prefix, named here by description and not written out, and
    # the three pre-P6d forms are bare shapes, so a path under this machine's
    # home directory would otherwise match nothing. The description rather than
    # the shape is deliberate: the self-scan
    # above ran the pre-P6d forms over this source and caught an inherited copy of
    # this very comment that spelled the prefix, which is the same defect the part
    # 2 P3 scan.log was committed carrying. The form asks the property the T0 P6d ruling
    # states: no log or check answer names this machine's home directory. The
    # pattern is $HOME, read from the environment and never printed, so the
    # scan cannot leak what it is looking for.
    #
    # ONE EXEMPTION, and the reason it is not a hole. A first version of this
    # form counted every occurrence of $HOME and failed the scan on ROADMAP.md,
    # which names the private corpus directory. That is not a leak: CLAUDE.md
    # and ROADMAP.md both name that directory deliberately, committed by the
    # maintainer long before this phase, and the corpus rule quotes
    # it as the place the corpus lives. So the form exempts $HOME/$CORPUS_DIR
    # and nothing else. It counts OCCURRENCES, not lines, because the helpers
    # here use grep -c: subtracting line counts would let one line holding both
    # the corpus root and a real leak net out to zero. A control covers exactly
    # that line, and another proves the exemption is one directory deep, since
    # the repository itself sits beside the corpus under the same parent.
    CORPUS_DIR=emend-testing
    # The exemption is a whole path SEGMENT, not a prefix: a directory beside the
    # corpus whose name merely begins with the corpus name is a leak like any
    # other, and a control asserts that. The boundary is "not a filename
    # character" rather than "a slash or the end of the line", because the two
    # committed mentions are followed by a backtick and by a full stop, and a
    # boundary of slash-or-end would have failed the scan on ROADMAP.md while
    # still exempting the sibling directory. That needs the exemption as a regex,
    # the one pattern here built with -E, so the home directory must contain no
    # ERE metacharacter. Rather than escape it and hope, the run refuses to
    # proceed if it does: an unescaped metacharacter would silently widen the
    # exemption, which is the one direction this form must not fail in.
    case $HOME in
      *[][.^\$*+?\(\)\{\}\|\\]*)
        echo "the home directory holds a regex metacharacter; f_home would" >&2
        echo "  widen its exemption silently. Stopping rather than guessing." >&2
        exit 2 ;;
    esac
    
    f_nonascii() { count_bytes "$NONASCII_CLASS" "$1"; }
    f_ctrl()     { count_bytes "$CTRL_CLASS" "$1"; }
    f_emdash()   { count_matches -F "$EMDASH" "$1"; }
    f_session()  { count_matches -E '^Claude-Session:' "$1"; }
    f_p6()       { count_from_file -E "$T/p6-patterns" "$1"; }
    f_pre()      { count_from_file -E "$T/pre-patterns" "$1"; }
    f_pre1()     { count_from_file -E "$T/pre1" "$1"; }
    f_pre2()     { count_from_file -E "$T/pre2" "$1"; }
    f_pre3()     { count_from_file -E "$T/pre3" "$1"; }
    f_host()     { count_from_file -F "$T/host-patterns" "$1"; }
    f_home() {
      local out rc all corpus
      out=$(LC_ALL=C "$G" -a -o -E -e "$HOME/[-A-Za-z0-9._]" -- "$1" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      all=$(printf '%s' "$out" | LC_ALL=C awk 'NF { n++ } END { print n + 0 }')
      out=$(LC_ALL=C "$G" -a -o -E -e "$HOME/$CORPUS_DIR([^-A-Za-z0-9._]|\$)" -- "$1" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      corpus=$(printf '%s' "$out" | LC_ALL=C awk 'NF { n++ } END { print n + 0 }')
      printf '%s' "$((all - corpus))"
    }
    f_deny()     { count_from_file -iwF "$T/deny" "$1"; }
    # Change EQ: the substring form parts before used, kept for one control only.
    f_deny_substring() { count_from_file -F "$T/deny" "$1"; }
    f_email() {
      local out rc
      out=$(LC_ALL=C "$G" -a -o -E -e "$EMAIL_RE" "$1" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      if [ "$rc" -eq 1 ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C awk -v id="$ID_EMAIL" '
        { a = tolower($0) }
        a == tolower(id) || a == "noreply@anthropic.com" || a ~ /@example[.]invalid$/ { next }
        { n++ }
        END { print n + 0 }'
    }
    FORMS="f_nonascii f_ctrl f_emdash f_session f_p6 f_home f_host f_deny f_email"
    # Change IC: the forms that do not judge bytes, run over an archive's raw
    # bytes; the byte classes and U+2014 would score the deflated stream, so an
    # archive's content is read as its entries' uncompressed text (archive_text).
    RAW_FORMS="f_session f_p6 f_home f_host f_deny f_email"
    # is_zip <file>: the file's first four bytes are the zip signature.
    is_zip() { [ "$(od -An -tx1 -N4 -- "$1" 2>/dev/null | tr -d ' \n')" = 504b0304 ]; }
    not_zip() { if is_zip "$1"; then return 1; else return 0; fi; }
    # archive_text <zip> <out>: every entry's uncompressed bytes, each followed by
    # a newline, written to <out>; prints the number of entries; exits non-zero
    # when the archive or an entry cannot be read. Prints no entry's content.
    archive_text() {
      python3 -I -B - "$1" "$2" <<'ZIPTEXT'
    import sys, zipfile
    try:
        with zipfile.ZipFile(sys.argv[1]) as z, open(sys.argv[2], "wb") as out:
            n = 0
            for info in z.infolist():
                out.write(z.read(info))
                out.write(b"\n")
                n += 1
    except Exception as err:
        sys.stdout.write("error %s\n" % type(err).__name__)
        sys.exit(1)
    sys.stdout.write("%d\n" % n)
    ZIPTEXT
    }
    # archive_path_ok <path>: an archive's path lies directly under tests/fixtures/.
    archive_path_ok() { case "$1" in tests/fixtures/*/*) return 1 ;; tests/fixtures/?*) return 0 ;; *) return 1 ;; esac; }
    archive_path_refused() { if archive_path_ok "$1"; then return 1; else return 0; fi; }
    # archive_named <sha256> <readme file>: the README names the hash.
    archive_named() { [ -n "$1" ] && LC_ALL=C "$G" -q -F -e "$1" -- "$2" 2>/dev/null; }
    archive_unnamed() { if archive_named "$1" "$2"; then return 1; else return 0; fi; }
    
    run() {
      local n
      n=$("$1" "$2")
      echo "  form=$1 count=$n"
      if [ "$n" = error ]; then err=1; elif [ "$n" != 0 ]; then hits=$((hits + n)); fi
    }
    check_ctl() {
      local label=$1 want=$2 n r
      shift 2
      n=$("$@")
      r=$([ "$n" = "$want" ] && echo as-expected || echo UNEXPECTED)
      echo "  control $label count=$n expected=$want: $r"
      [ "$r" = as-expected ] || ctl_fail=1
    }
    # bad COUNTS the failing structural checks (independent check 1 F7: it was a
    # 0/1 flag printed as a count); the verdict still reads it as "0 or not".
    structural() { echo "$1: $2"; [ "$2" = yes ] || bad=$((bad + 1)); }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    rep() { printf "$1%.0s" $(seq 1 "$2"); }
    
    # The phase's directory, the one above this script's own (change AM).
    SROOT=$(cd "$(dirname "$0")/.." && pwd)
    echo "command: git rev-parse HEAD"
    # The invocation as run, the script's directory written as <repo> or <phase>:
    # an absolute machine path in a log is a defect (T0 P6d ruling).
    MAIN=$(pwd)
    inv_path=$0
    case "$inv_path" in
      "$MAIN"/*) inv_path="<repo>/${inv_path#"$MAIN"/}" ;;
      "$SROOT"/*) inv_path="<phase>/${inv_path#"$SROOT"/}" ;;
      /*) inv_path="<phase>/scripts/$(basename "$inv_path")" ;;
    esac
    echo "invocation: bash $inv_path $*"
    # Change AO: every environment input, on a labelled line, set or not, the
    # phase's directory and the home directory written as their placeholders.
    SPEC_PIN_SET=${SPEC_PIN+set}
    SPEC_PIN=${SPEC_PIN:-160c2984b483df57b2e2045d111d5655a944d4a2f1a9b56485fb5bad707404b0}
    scrub_input() { sed -e "s#$SROOT#<phase>#g" -e "s#$HOME#<home>#g"; }
    show_input() {
      if [ -n "${!1+set}" ]; then
        printf 'input: %s=%s\n' "${1%_IN}" "$(printf '%s' "${!1}" | scrub_input)"
      else
        printf 'input: %s is not set\n' "${1%_IN}"
      fi
    }
    for name in LOGDIR_IN RECDIR_IN RERUN_NOTE RERUN_FILES; do show_input "$name"; done
    if [ -n "$SPEC_PIN_SET" ]; then echo "input: SPEC_PIN=$SPEC_PIN"; else echo "input: SPEC_PIN is not set; the default, $SPEC_PIN, is used"; fi
    PLANNING_SPEC=${PLANNING_SPEC:-}
    if [ -n "$PLANNING_SPEC" ]; then echo "input: PLANNING_SPEC=$PLANNING_SPEC (change AV)"; else echo "input: PLANNING_SPEC is not set"; fi
    echo "input: TMPDIR=$(printf '%s' "$TMPDIR" | sed -e "s#^$SROOT#<scratch>#") (set by this script before its mktemp -d; change FN)"
    if [ -n "${PYTHONDONTWRITEBYTECODE+set}" ]; then echo "input: PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE (as given; change FH)"; else echo "input: PYTHONDONTWRITEBYTECODE is not set (as given; change FH)"; fi
    export PYTHONDONTWRITEBYTECODE=1
    bytecode_off() { [ "$(printenv PYTHONDONTWRITEBYTECODE)" = 1 ]; }
    structural "PYTHONDONTWRITEBYTECODE is exported as 1 for every command this script runs (specs/0032 P2 verification ruling 6; change FH)" "$(yn bytecode_off)"
    # Change AU: HOME and ANTHROPIC_API_KEY, read by this script, labelled; the
    # values themselves are never printed.
    if [ -n "${HOME+set}" ]; then echo "input: HOME=<home> (read for the home-path scan and the phase's directory; its value is the placeholder's)"; else echo "input: HOME is not set"; fi
    if [ -n "${ANTHROPIC_API_KEY+set}" ]; then echo "input: ANTHROPIC_API_KEY is set (its value is never printed)"; else echo "input: ANTHROPIC_API_KEY is not set"; fi
    echo "about: M5 part 6 P2 phase diff $BASE..$C; HEAD at run: $HEAD_SHA"
    echo
    echo "## the three shape greps over this script's own source, before it is printed (change E)"
    echo "specs/0001: the shape greps run over a script before its log does. They"
    echo "run here, each with a control fixture that must score 1, and each must"
    echo "score 0 on this script's source."
    SHAPE='[$][(](yn|is|isnot|ynnot) .*(&&|[|][|])'
    BANG='[$][(](yn|is|isnot|ynnot) [!]'
    ASSIGN='[$][(](yn|is|isnot|ynnot) [A-Za-z_][A-Za-z_0-9]*='
    echo "  the first pattern, assembled at run time:  $SHAPE"
    echo "  the second pattern, assembled at run time: $BANG"
    echo "  the third pattern, assembled at run time:  $ASSIGN"
    f_shape() { count_matches -E "$SHAPE" "$1"; }
    f_bang() { count_matches -E "$BANG" "$1"; }
    f_assign() { count_matches -E "$ASSIGN" "$1"; }
    # Change FO: PYB, a Python call without -I -B, over this script's own source.
    # The word is assembled, so the source spells no call the form would count.
    PYW="pyth""on3"
    PYCALL="$PYW[[:space:]]+(-|[^[:space:]]+[.]py)"
    PYOK="$PYW -I -B( |\$)"
    echo "  the fourth pattern (change FO), assembled at run time: a call $PYCALL on a line not opening with a comment, not followed by -I -B"
    f_pyb() {
      LC_ALL=C "$G" -a -v -E '^[[:space:]]*#' "$1" | LC_ALL=C "$G" -a -E "$PYCALL" | LC_ALL=C "$G" -a -v -E "$PYOK" | count_lines /dev/stdin
    }
    printf 'x=%s(%s -c x)\n' '$' "$PYW" >"$T/g-pyb"
    printf '# %s -c x\n' "$PYW" >"$T/g-pyb-comment"
    printf 'x=%s(%s -I -B -c x)\n' '$' "$PYW" >"$T/g-pyb-ok"
    check_ctl "f_pyb on a fixture holding a call without -I -B (change FO)" 1 f_pyb "$T/g-pyb"
    check_ctl "f_pyb on the same call in a comment line (change FO)" 0 f_pyb "$T/g-pyb-comment"
    check_ctl "f_pyb on a call with -I -B (change FO)" 0 f_pyb "$T/g-pyb-ok"
    printf 'x %s(is [ a = a ] && [ b = b ])\n' '$' >"$T/g-shape"
    printf 'x %s(is %s f a b)\n' '$' '!' >"$T/g-bang"
    printf 'x %s(isnot %s%s /usr/bin/grep -q x f)\n' '$' 'LC_ALL' '=C' >"$T/g-assign"
    check_ctl "f_shape on a fixture holding the chained form" 1 f_shape "$T/g-shape"
    check_ctl "f_bang on a fixture holding the leading-bang form" 1 f_bang "$T/g-bang"
    check_ctl "f_assign on a fixture holding the assignment-prefix form" 1 f_assign "$T/g-assign"
    # Change BW: the same three forms after the negating helper ynnot.
