    echo "phase: Milestone 5 part 6 P2 (specs/0037-measurement-and-close.md) scan.log, stage $STAGE; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # Change AN: the spec's hash this log pins, one hash, SPEC_PIN; the file as it
    # stands and as the phase commit holds it.
    SPEC=specs/0037-measurement-and-close.md
