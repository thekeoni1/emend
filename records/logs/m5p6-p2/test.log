      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$B#<scratch>/w#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$SUPERSEDED_DIR#<superseded>#g" \
        -e "s#$TARGET_DIR#<target>#g" -e "s#$PHASE_DIR#<phase>#g" \
        -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    # The environment and path inputs, each on its labelled line.
    echo "input: RERUN_NOTE: ${RERUN_NOTE:-unset}"
    echo "input: RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: HOME: set, read for the paths under it, printed as <home>"
    echo "input: TEST_BUILD: ${TEST_BUILD:-unset} (the build root, <build>)"
    echo "about: M5 part 6 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M5 part 6 P1 record: logs, the image record, the check')
    DOC2=$(by_subject 'M5 part 6 P2: commit planning docs (the P1 verification and rulings)')
    TRAP2=$(by_subject "M5 part 6 P2: the runner counts the image's containers in an EXIT trap")
    START2=$(by_subject 'M5 part 6 P2: the record script names the container start of an openpyxl run')
    CMP2=$(by_subject 'M5 part 6 P2: scripts/compare-record.py and its test')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's full subject>, for each role"
    echo "  M5 part 6 P1's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC2:-none}"
    echo "  the trap commit (scripts/compare-run.sh, ruling I): ${TRAP2:-none}"
    echo "  the start commit (scripts/passthrough-record.py, rulings K and P): ${START2:-none}"
    echo "  the compare commit (scripts/compare-record.py and its test, the phase commit): ${CMP2:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CMP2" "$START2" "$TRAP2" "$DOC2" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the compare commit, the start commit, the trap commit, the doc commit and the base, each the next one's parent, the compare commit the phase commit (change RA)" "$(yn roles_in_order)"
    # The roles' full shas as this phase recorded them (FACTS.md); a role found
    # by its subject at another sha fails here (change RA).
    roles_pinned() { [ "$REC" = 1cdd3ed8d05e275b4e1018f15f88da6544111c51 ] && [ "$DOC2" = 09d82ac5cc8582358cab39b9759aef61a7042408 ] && [ "$TRAP2" = 8593ba0049562d250931c33776da14eaf779561c ] && [ "$START2" = 89ef6eb75b414c525c8dc7de659266720498e5b6 ] && [ "$CMP2" = 5e52758e379966672baa2e350e4bf997346aee01 ]; }
    check "each role is at the full sha this phase recorded for it" "$(yn roles_pinned)"
    roles_pinned_ctl() { local DOC2=$TRAP2; roles_pinned; }
    check "control: roles_pinned refuses the trap commit named as the doc commit" "$(ynnot roles_pinned_ctl)"
    roles_ctl() { local CMP2=$START2; roles_in_order; }
    check "control: roles_in_order refuses the start commit named as the compare commit" "$(ynnot roles_ctl)"
    roles_ctl2() { local TRAP2=$DOC2; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the trap commit" "$(ynnot roles_ctl2)"
    echo
    echo "phase: Milestone 5 part 6 P2 ($SPEC) test.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "rerun: the superseded files are kept in <superseded>"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this log builds the release emend-copy and xlsx-diff for the host and emend-copy for i686 from a clone at the phase commit into <target>/test (change QD), and runs the phase commit's scripts over fictional fixtures (changes QB, QC and RB); it writes no record (change RA)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh and $SPEC are read from it by git show at the phase commit, the working spec is hashed in it, it is cloned (read only) into <scratch>/w/clone and <scratch>/w/plant; nothing in it is run, built or written (change RA)"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m5p6-p2, the phase's directory on the disk"
    echo "root: <scripts> stands for <phase>/scripts, this script's own directory on the disk, which holds the script and, in <scripts>/out, its own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <target> stands for <phase>/target, the phase's one target root (specs/0001); this log builds into <target>/test alone (change QD)"
    echo "root: <build> stands for the build root on the disk, <phase>/test unless TEST_BUILD names another"
    echo "root: <superseded> stands for <phase>/superseded, where a rerun's superseded files are kept; read only"
    # Change RB: the two words scripts/compare-record.py's printed docstring
    # puts before a slash.
    echo "root: <corpus-runs> stands for, in the printed scripts/compare-record.py, the directory it is given with --corpus-runs"
    echo "root: <scale-runs> stands for, in the printed scripts/compare-record.py, the directory it is given with --scale-runs"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory under <build>, kept on the disk after the run (change QC): <scratch>/w/counting.sh the phase commit's library, sourced; <scratch>/w/clone a clone of <repo> at the phase commit, whose scripts are run and built; <scratch>/w/plant a second clone, the plants' (change QJ); <scratch>/w/bin the built binaries, copied; <scratch>/w/fx the fictional corpus, the programs this log writes and the run directories; <scratch>/w/rec the records the cases write; <scratch>/w/tmp the TMPDIR of every script this log runs, compare-record-test.py's temporary directory among them (change RB)"
    
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$BUILD_ROOT" && apart "$SUPERSEDED_DIR" "$MAIN" && apart "$TARGET_DIR" "$BUILD_ROOT" && apart "$TARGET_DIR" "$MAIN"; }
    check "the roots other than <home> and <phase> are distinct, none inside another (<scratch>/w inside <build>)" "$(yn roots_distinct)"
    roots_ctl() { apart "$B" "$BUILD_ROOT"; }
    check "control: apart refuses <scratch>/w against <build>, which holds it" "$(ynnot roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them this phase's logs or planning's spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT_SHA")"
    short_names_head() { [ "$(git rev-parse "$SHORT_SHA")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_spec_ctl() { printf ' M specs/0036-charts-write-second-set.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified spec other than specs/0037" "$(ynnot ours_spec_ctl)"
    ours_roadmap_ctl() { printf ' M ROADMAP.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified ROADMAP.md (committed and clean in this phase)" "$(ynnot ours_roadmap_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m5p6-p2/test.log\n?? records/logs/m5p6-p1/gate.log\n?? records/openpyxl-image-2026-01-01.md\n?? records/compare-m5p6-2026-01-01-%s.md\n?? records/logs/m5p6-p2x/gate.log\n M ROADMAP.md\n M specs/0037-measurement-and-close.md\n?? specs/0037-measurement-and-close.md\n' "$SHORT_SHA" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern takes this phase's log and planning's modified spec alone, no other phase's log, no record, no sibling directory and no untracked spec (change RA)" "$(yn [ "$(ours_rec_ctl)" = 2 ])"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_BLOB=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum: $SPEC_BLOB; sha256sum $SPEC (the working file, printed and not asserted: planning holds its rulings during P2 uncommitted; change RA): $SPEC_HAVE"
    check "the spec's blob at the phase commit is at the hash this log pins" "$(yn [ "$SPEC_BLOB" = "$SPEC_WANT" ])"
    spec_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$SPEC_WANT" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot spec_ctl)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    SPEC_AT_DOC=$(git show "$DOC2:$SPEC" 2>/dev/null | sha256sum | cut -d' ' -f1)
    echo "command: git show <doc commit>:$SPEC | sha256sum: $SPEC_AT_DOC (the spec pin, read at the doc commit)"
    check "the spec's blob at the doc commit is the pin, $SPEC_WANT" "$(yn [ "$SPEC_AT_DOC" = "$SPEC_WANT" ])"
    echo
    echo "## the scripts under test, at the phase commit (change QB)"
    echo "command: git clone -q <repo> <scratch>/w/clone; git -C <scratch>/w/clone checkout -q --detach <phase commit> (a scratch copy: nothing in <repo> is written)"
    CL=$B/clone
    git clone -q "$MAIN" "$CL" >"$B/clone.out" 2>"$B/clone.err" </dev/null
    rc_clone=$?
    git -C "$CL" checkout -q --detach "$C" >>"$B/clone.out" 2>>"$B/clone.err" </dev/null
    rc_co=$?
    CLONE_HEAD=$(git -C "$CL" rev-parse HEAD 2>/dev/null)
    echo "  clone exit $rc_clone; checkout exit $rc_co; the clone's HEAD: ${CLONE_HEAD:-none}; output bytes $(wc -c <"$B/clone.out"), standard error bytes $(wc -c <"$B/clone.err")"
    clone_ok() { [ "$rc_clone" = 0 ] && [ "$rc_co" = 0 ] && [ "$CLONE_HEAD" = "$C" ]; }
    check "the clone is at the phase commit" "$(yn clone_ok)"
    clone_ctl() { local CLONE_HEAD=$START2; clone_ok; }
    check "control: the same check refuses a clone at the start commit" "$(ynnot clone_ctl)"
    clone_clean() { [ -z "$(git -C "$CL" status --porcelain 2>/dev/null)" ]; }
    check "the clone's working tree is clean" "$(yn clone_clean)"
    # Change RB: this phase's four scripts under test, and the scripts this log
    # runs that the phase does not change.
    UNDER_TEST="scripts/compare-run.sh scripts/passthrough-record.py scripts/compare-record.py scripts/compare-record-test.py scripts/openpyxl-ops.py scripts/openpyxl-ops-test.sh scripts/passthrough-run.sh scripts/lo-check.sh scripts/scale-gen.py tests/fixtures/openpyxl-ops.xlsx"
    echo "command: sha256sum of each file under test in the clone, and git show <phase commit>:<file> | sha256sum"
    blobs_ok=yes
    for file in $UNDER_TEST; do
      have=$(sha256sum <"$CL/$file" 2>/dev/null | cut -d' ' -f1)
      want=$(git show "$C:$file" 2>/dev/null | sha256sum | cut -d' ' -f1)
      echo "  $file: ${have:-none}"
      [ -n "$have" ] && [ "$have" = "$want" ] || blobs_ok=no
    done
    check "each file under test in the clone is the phase commit's blob" "$(yn [ "$blobs_ok" = yes ])"
    for file in scripts/compare-record.py scripts/compare-record-test.py; do
      echo "command: sed 's/^/    /' <scratch>/w/clone/$file"
      sed 's/^/    /' "$CL/$file"
    done
    for file in scripts/compare-run.sh scripts/passthrough-record.py; do
      echo "command: git diff <base> <phase commit> -- $file"
      git diff "$REC" "$C" -- "$file" | sed 's/^/    /'
    done
    changed_paths=$(git diff --name-only "$REC" "$C" -- scripts/openpyxl-ops.py scripts/openpyxl-ops-test.sh scripts/passthrough-run.sh scripts/lo-check.sh scripts/scale-gen.py tests/fixtures | wc -l)
    echo "  the ops script, its test, the passthrough runner, the open-check library, the generator and the fixtures changed between the base and the phase commit: $changed_paths"
    check "the scripts this log runs and the phase does not change are the base's (change RB)" "$(yn [ "$changed_paths" = 0 ])"
    mkdir -p "$B/tmp" "$B/rec" || exit 2
    
    echo
    echo "## the release binaries this log builds (change QD)"
    BIN=$B/bin
    TB=$TARGET_DIR/test
    mkdir -p "$BIN" || exit 2
    echo "command: (cd <scratch>/w/clone && CARGO_TARGET_DIR=<target>/test cargo build --release --locked --offline -p emend-copy -p xlsx-diff)"
    (cd "$CL" && CARGO_TARGET_DIR=$TB cargo build --release --locked --offline -p emend-copy -p xlsx-diff) >"$B/build-host.out" 2>"$B/build-host.err" </dev/null
    rc_bh=$?
    echo "command: (cd <scratch>/w/clone && CARGO_TARGET_DIR=<target>/test cargo build --release --locked --offline --target i686-unknown-linux-musl -p emend-copy)"
    (cd "$CL" && CARGO_TARGET_DIR=$TB cargo build --release --locked --offline --target i686-unknown-linux-musl -p emend-copy) >"$B/build-i686.out" 2>"$B/build-i686.err" </dev/null
    rc_bi=$?
    nw_h=$(count_matches -E '^(warning|error)' "$B/build-host.err")
    nw_i=$(count_matches -E '^(warning|error)' "$B/build-i686.err")
    echo "  host build: exit $rc_bh; warning or error lines $nw_h; i686 build: exit $rc_bi; warning or error lines $nw_i"
    builds_ok() { [ "$rc_bh" = 0 ] && [ "$rc_bi" = 0 ] && [ "$nw_h" = 0 ] && [ "$nw_i" = 0 ]; }
    check "both builds exit 0 with no warning or error line" "$(yn builds_ok)"
    cp "$TB/release/emend-copy" "$BIN/emend-copy" && cp "$TB/release/xlsx-diff" "$BIN/xlsx-diff" &&
      cp "$TB/i686-unknown-linux-musl/release/emend-copy" "$BIN/emend-copy-i686" || exit 2
    for b in emend-copy xlsx-diff emend-copy-i686; do
      echo "  <scratch>/w/bin/$b: sha256 $(sha256sum <"$BIN/$b" | cut -d' ' -f1), bytes $(wc -c <"$BIN/$b")"
    done
    bins_x() { [ -x "$BIN/emend-copy" ] && [ -x "$BIN/xlsx-diff" ] && [ -x "$BIN/emend-copy-i686" ]; }
    check "the three copies are executable" "$(yn bins_x)"
    XD_SHA=$(sha256sum <"$BIN/xlsx-diff" | cut -d' ' -f1)
    OPS_SCRIPT_SHA=$(sha256sum <"$CL/scripts/openpyxl-ops.py" | cut -d' ' -f1)
    IMG_ID=$(podman image inspect --format '{{.Id}}' localhost/emend-openpyxl:3.1.5-dfsg-2-deb13 2>/dev/null </dev/null)
    echo "command: podman image inspect --format '{{.Id}}' localhost/emend-openpyxl:3.1.5-dfsg-2-deb13: ${IMG_ID:-none}"
    check "the image is the one P1 recorded, 894b239f (change RB)" "$(yn [ "${IMG_ID:0:8}" = 894b239f ])"
    
    IMAGE=localhost/emend-openpyxl:3.1.5-dfsg-2-deb13
    LO_IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    echo
    echo "## the image's containers at entry (ruling A; change QI)"
    # image_containers: the names of every container of the image, running or not.
    image_containers() { podman ps -a --filter "ancestor=$IMAGE" --format '{{.Names}}' </dev/null; }
    echo "command: podman ps -a --filter ancestor=$IMAGE --format '{{.Names}}'"
    image_containers >"$B/containers-entry.out" 2>"$B/containers-entry.err"
    rc=$?
    n_entry=$(awk 'NF { n++ } END { print n + 0 }' "$B/containers-entry.out")
    echo "  exit $rc; containers of the image at entry: $n_entry"
    entry_none() { [ "$rc" = 0 ] && [ "$n_entry" = 0 ]; }
    check "podman lists the image's containers, and there are none at entry" "$(yn entry_none)"
    
    echo
    echo "## T1: scripts/compare-record-test.py (specs/0037 P2, the comparison record's test; change RC)"
    echo "command: TMPDIR=<scratch>/w/tmp python3 -I -B <scratch>/w/clone/scripts/compare-record-test.py"
    # cr_test <name> <root>: a clone's compare-record test, its exit and outputs kept as <name>.rc/.out/.err.
    cr_test() {
      TMPDIR=$B/tmp python3 -I -B "$2/scripts/compare-record-test.py" >"$B/$1.out" 2>"$B/$1.err" </dev/null
      echo "$?" >"$B/$1.rc"
    }
    cr_test T1 "$CL"
    echo "  exit: $(cat "$B/T1.rc"); standard output:"
    sed 's/^/    /' "$B/T1.out"
    echo "  standard error:"
    sed 's/^/    /' "$B/T1.err"
    # The lines the test must print, each once (its source's check texts).
    cat >"$B/T1.want" <<'CRWANT'
    ok the record is written, exit 0, nothing on stderr
    ok the one line names the stem, 11 ops and 72 scale rows
    ok the corpus table holds 33 rows, three per op
    ok emend host: 3 files, 3 ok
    ok emend host: the entry totals 12, 1, 1, 0, 1
    ok emend host: lo ok 3; lo_in ok 2, fail 1
    ok emend host: wall median 2, sum 7; peak RSS median 2000, max 3000
    ok openpyxl: 2 ok, 1 error
    ok openpyxl: the entry totals over its ok rows 1, 7, 3, 5
    ok openpyxl: lo ok 1, fail 1, not-run 1
    ok openpyxl: lo_in counted from the emend host run, ok 2 and fail 1 (ruling C)
    ok openpyxl: wall median 3, sum 9.50; peak RSS median 40000, max 50000
    ok the openpyxl detail table holds 11 rows
    ok the container start median of 0.40, 0.50, 0.70 is 0.50 (rulings K and P)
    ok the settings named from run.openpyxl.tsv (ruling N)
    ok the error row's class read from its stdout file
    ok the lo_in source directory named (ruling C)
    ok the scale table holds 72 rows: 24 ops over tiers a to d, three rows each
    ok a scale cap row: outcome cap, no entry counts, the container start named
    ok a scale emend row: ok, its wall time, lo ok on tier a, no container start
    ok tier b records lo not-run as -
    ok the image record's sha256
    ok the record is ASCII
    ok no workbook id is named
    ok an existing record is refused
    ok a missing openpyxl run directory refused, nothing written
    ok a missing empty-run file refused
    ok a summary with another header refused
    ok a run row naming another op refused
    ok runs that do not cover the same workbooks refused
    ok a bad stamp refused
    compare-record-test: PASS
    CRWANT
    echo "  lines the log expects once each: $(count_lines "$B/T1.want")"
    # cr_passed <name>: exit 0, every expected line once, no FAIL line, 31 ok lines, the last line PASS, stderr empty.
    cr_passed() {
      local line
      [ "$(cat "$B/$1.rc")" = 0 ] && [ ! -s "$B/$1.err" ] || return 1
      [ "$(count_matches -E '^FAIL ' "$B/$1.out")" = 0 ] && [ "$(count_matches -E '^ok ' "$B/$1.out")" = 31 ] || return 1
      [ "$(tail -n 1 "$B/$1.out")" = "compare-record-test: PASS" ] || return 1
      while IFS= read -r line; do
        [ "$(count_matches -xF "$line" "$B/$1.out")" = 1 ] || return 1
      done <"$B/T1.want"
    }
    check "T1: exit 0, every expected line once, 31 ok lines, no FAIL, the last line PASS, nothing on stderr" "$(yn cr_passed T1)"
    sed '0,/^ok /s//FAIL /' "$B/T1.out" >"$B/T1c.out"; cp "$B/T1.rc" "$B/T1c.rc"; : >"$B/T1c.err"
    check "control: the same check refuses the output with one ok line made FAIL" "$(ynnot cr_passed T1c)"
    echo
    echo "## T2: scripts/openpyxl-ops-test.sh in the image (ruling F; change QF, carried by change RD)"
    echo "command: TMPDIR=<scratch>/w/tmp bash <scratch>/w/clone/scripts/openpyxl-ops-test.sh $IMAGE"
    # ops_test <name> <root>: a clone's ops test, its exit and outputs kept as <name>.rc/.out/.err.
    ops_test() {
      TMPDIR=$B/tmp bash "$2/scripts/openpyxl-ops-test.sh" "$IMAGE" >"$B/$1.out" 2>"$B/$1.err" </dev/null
      echo "$?" >"$B/$1.rc"
    }
    ops_test T2 "$CL"
    echo "  exit: $(cat "$B/T2.rc"); standard output:"
    sed 's/^/    /' "$B/T2.out"
    echo "  standard error:"
    sed 's/^/    /' "$B/T2.err"
    OPS_LIST="roundtrip read edit format insert-rows names table comment image add-chart copy"
    # The lines the ops test must print, each once (from its source's check texts).
    {
      echo "ok scale-gen.py tier t exits 0"
      echo "ok the generator reports tier t with the fixture's sha256"
      echo "ok the committed fixture's sha256 is the one tests/fixtures/README.md names"
      echo "ok the regenerated workbook is the committed fixture, byte for byte"
      for op in $OPS_LIST; do
        echo "ok $op: exit 0"
        echo "ok $op: an output was written"
        echo "ok $op: the last line is openpyxl=3.1.5 and a peak RSS"
        echo "ok $op: nothing on standard error"
      done
      echo "ok read: the line cells=2500 (2 sheets, 2500 cells)"
      echo "ok read: two lines, the count and the last line"
      for op in $OPS_LIST; do [ "$op" = read ] || echo "ok $op: one line, the last line"; done
      echo "ok the parts reader exits 0"
      echo "ok the parts reader made its 12 checks"
      echo "ok an unknown op exits 2"
      echo "ok an unknown op prints the one line unknown op"
      echo "openpyxl-ops-test: PASS"
    } >"$B/T2.want"
    echo "  lines the log expects once each: $(count_lines "$B/T2.want")"
    # ops_passed <name>: exit 0, every expected line once, no FAIL line, 76 ok lines, the last line PASS, stderr empty.
    ops_passed() {
      local line
      [ "$(cat "$B/$1.rc")" = 0 ] && [ ! -s "$B/$1.err" ] || return 1
      [ "$(count_matches -E '^FAIL ' "$B/$1.out")" = 0 ] && [ "$(count_matches -E '^ok ' "$B/$1.out")" = 76 ] || return 1
      [ "$(tail -n 1 "$B/$1.out")" = "openpyxl-ops-test: PASS" ] || return 1
      while IFS= read -r line; do
        [ "$(count_matches -xF "$line" "$B/$1.out")" = 1 ] || return 1
      done <"$B/T2.want"
    }
    check "T2: exit 0, every expected line once, 76 ok lines, no FAIL, the last line PASS, nothing on stderr" "$(yn ops_passed T2)"
    sed '0,/^ok /s//FAIL /' "$B/T2.out" >"$B/T2c.out"; cp "$B/T2.rc" "$B/T2c.rc"; : >"$B/T2c.err"
    check "control: the same check refuses the output with one ok line made FAIL" "$(ynnot ops_passed T2c)"
    
    echo
    echo "## T3: scripts/compare-run.sh over a fictional corpus, the roundtrip and edit ops (rulings A to E and I; changes QC, QG and RE)"
    FX=$B/fx
    mkdir -p "$FX" "$FX/runs" || exit 2
    echo "command: python3 -I -B <scratch>/w/clone/scripts/scale-gen.py t <scratch>/w/fx/corpus"
    python3 -I -B "$CL/scripts/scale-gen.py" t "$FX/corpus" >"$B/gen.out" 2>"$B/gen.err" </dev/null
    rc_gen=$?
    sed 's/^/    /' "$B/gen.out"
    read -r _ G_TIER G_ID _ G_SHA _ <"$B/gen.out"
    FIXTURE_SHA=$(sed -n 's/^- sha256: `\([0-9a-f]\{64\}\)`\.$/\1/p' "$CL/tests/fixtures/README.md")
    echo "  exit $rc_gen; tier ${G_TIER:-none}; id ${G_ID:-none}; sha256 ${G_SHA:-none}; tests/fixtures/README.md's sha256 ${FIXTURE_SHA:-none}"
    gen_ok() { [ "$rc_gen" = 0 ] && [ "$G_TIER" = t ] && [ -n "$FIXTURE_SHA" ] && [ "$G_SHA" = "$FIXTURE_SHA" ] && [ -f "$FX/corpus/corpus/$G_ID.xlsx" ]; }
    check "the generator wrote tier t, the committed fixture's bytes, into a corpus directory" "$(yn gen_ok)"
    CORPUS=$FX/corpus
    cat >"$FX/mkxltx.py" <<'MKXLTX'
    """Adds to the generated corpus a template copy of its one workbook: the same
    entries, the workbook part's content type made the template's, the id fixed
    below, the extension xltx, and its manifest row (the generated row with its
    id, sha256, bytes and extension replaced). Fictional; prints nothing."""
    import hashlib
    import os
    import sys
    import zipfile
    
    top, src_id = sys.argv[1], sys.argv[2]
    NEW_ID = "f00000000071"
    MAIN_CT = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"
    TEMPLATE_CT = "application/vnd.openxmlformats-officedocument.spreadsheetml.template.main+xml"
    src = os.path.join(top, "corpus", src_id + ".xlsx")
    dst = os.path.join(top, "corpus", NEW_ID + ".xltx")
    with zipfile.ZipFile(src) as zin, zipfile.ZipFile(dst, "x") as zout:
        for info in zin.infolist():
            data = zin.read(info.filename)
            if info.filename == "[Content_Types].xml":
                text = data.decode("utf-8")
                if text.count(MAIN_CT) != 1:
                    sys.exit(1)
                data = text.replace(MAIN_CT, TEMPLATE_CT).encode("utf-8")
            zout.writestr(info, data)
    blob = open(dst, "rb").read()
    path = os.path.join(top, "manifest.tsv")
    lines = open(path).read().split("\n")
    rows = [line for line in lines[1:] if line.startswith(src_id + "\t")]
    if len(rows) != 1 or lines[-1] != "":
        sys.exit(1)
    cells = rows[0].split("\t")
    cells[0:4] = [NEW_ID, hashlib.sha256(blob).hexdigest(), str(len(blob)), "xltx"]
    with open(path, "a") as handle:
        handle.write("\t".join(cells) + "\n")
    MKXLTX
    echo "command: python3 -I -B <scratch>/w/fx/mkxltx.py <scratch>/w/fx/corpus $G_ID (the program, printed below, sha256 $(sha256sum <"$FX/mkxltx.py" | cut -d' ' -f1))"
    sed 's/^/    /' "$FX/mkxltx.py"
    python3 -I -B "$FX/mkxltx.py" "$CORPUS" "$G_ID" >"$B/mkxltx.out" 2>"$B/mkxltx.err" </dev/null
    rc_mk=$?
    T_ID=f00000000071
    echo "  exit $rc_mk; output bytes $(wc -c <"$B/mkxltx.out"); standard error bytes $(wc -c <"$B/mkxltx.err")"
    echo "command: cut -f 1,3,4,5,9 <scratch>/w/fx/corpus/manifest.tsv (id, bytes, ext, producer, tags)"
    cut -f 1,3,4,5,9 "$CORPUS/manifest.tsv" | sed 's/^/    /'
    mk_ok() { [ "$rc_mk" = 0 ] && [ ! -s "$B/mkxltx.out" ] && [ ! -s "$B/mkxltx.err" ] && [ -f "$CORPUS/corpus/$T_ID.xltx" ] && [ "$(count_lines "$CORPUS/manifest.tsv")" = 3 ] && [ "$(awk -F'\t' -v i="$T_ID" '$1 == i { print $4 }' "$CORPUS/manifest.tsv")" = xltx ]; }
    check "the corpus holds the generated workbook and its xltx template copy, each with a manifest row" "$(yn mk_ok)"
    
    # The runner's two table headers, read from scripts/passthrough-run.sh, and the
    # comparison runner's own; ruling E's run header, as the ruling lists it.
    hdr_of() { sed -n "s/^readonly $1=\\$'\\(.*\\)'\$/\\1/p" "$2"; }
    SUM_H=$(hdr_of SUMMARY_HEADER "$CL/scripts/passthrough-run.sh")
    ENT_H=$(hdr_of ENTRIES_HEADER "$CL/scripts/passthrough-run.sh")
    echo "  the runner's summary header (from its source): $SUM_H"
    echo "  the runner's entries header (from its source): $ENT_H"
    heads_same() { [ -n "$SUM_H" ] && [ -n "$ENT_H" ] && [ "$(hdr_of SUMMARY_HEADER "$CL/scripts/compare-run.sh")" = "$SUM_H" ] && [ "$(hdr_of ENTRIES_HEADER "$CL/scripts/compare-run.sh")" = "$ENT_H" ]; }
    check "scripts/compare-run.sh declares the runner's summary and entries headers, character for character" "$(yn heads_same)"
    heads_ctl() { [ "$(hdr_of RUN_HEADER "$CL/scripts/compare-run.sh")" = "$(hdr_of RUN_HEADER "$CL/scripts/passthrough-run.sh")" ]; }
    check "control: the same reading tells the two run headers apart" "$(ynnot heads_ctl)"
    RUN_H='commit\tstarted\tended\timage_id\topenpyxl\ttimeout_s\tlo_timeout_s\tmemory_mib\tops_sha256\txlsx_diff_sha256\tfiles\top'
    cat >"$FX/cmpcheck.py" <<'CMPCHECK'
    """Checks one comparison run directory against what the test log expects:
    the three headers, one summary row per expected id in manifest order, each
    row's fields, its output and nothing else in the output directory, the
    entries rows, and the one run row. Prints "yes" or "no", a tab and what
    was checked, one line each; never a cell value."""
    import os
    import re
    import sys
    
    e = os.environ
    run, op = sys.argv[1], sys.argv[2]
    want_ids = [pair.split(":") for pair in e["IDS"].split(",")]
    out = []
    
    
    def say(ok, what):
        out.append("%s\t%s: %s" % ("yes" if ok else "no", op, what))
    
    
    def table(name):
        try:
            lines = open(os.path.join(run, name)).read().split("\n")
        except OSError:
            return None, []
        if lines and lines[-1] == "":
            lines.pop()
        return (lines[0] if lines else None), [line.split("\t") for line in lines[1:]]
    
    
    sh, srows = table("summary.openpyxl.tsv")
    eh, erows = table("entries.openpyxl.tsv")
    rh, rrows = table("run.openpyxl.tsv")
    summary_header = e["SUM_H"].replace("\\t", "\t")
    say(sh == summary_header, "summary.openpyxl.tsv's header is the runner's")
    say(eh == e["ENT_H"].replace("\\t", "\t"), "entries.openpyxl.tsv's header is the runner's")
    say(rh == e["RUN_H"].replace("\\t", "\t"), "run.openpyxl.tsv's header is ruling E's")
    cols = summary_header.split("\t")
    rows = [dict(zip(cols, r)) for r in srows if len(r) == len(cols)]
    say(len(rows) == len(srows) and [r["id"] for r in rows] == [i for i, _ in want_ids],
        "one summary row per expected id, in manifest order")
    for (wid, ext), r in zip(want_ids, rows):
        o = os.path.join(run, wid, "out.openpyxl", wid + "." + ext)
        others = sorted(set(os.listdir(os.path.dirname(o))) - {wid + "." + ext}) if os.path.isdir(os.path.dirname(o)) else ["-"]
        say(r["label"] == "openpyxl", "%s: label openpyxl" % wid)
        say(r["outcome"] == e["OUTCOME"] and r["exit"] == e["EXIT"], "%s: outcome %s, exit %s" % (wid, e["OUTCOME"], e["EXIT"]))
        say(r["lo"] == e["LO"] and r["lo_in"] == "-", "%s: lo %s, lo_in - (ruling C)" % (wid, e["LO"]))
        say(r["leftover"] == "no" and not others, "%s: leftover no, nothing beside the output in its directory" % wid)
        if e["OUTCOME"] == "ok":
            say(os.path.isfile(o) and r["out_bytes"] == str(os.path.getsize(o)),
                "%s: the output keeps the extension %s (ruling D) and out_bytes is its size" % (wid, ext))
            say(r["diff_exit"] in ("0", "1"), "%s: xlsx-diff exit 0 or 1" % wid)
            say(re.fullmatch(r"[0-9]+\.[0-9]{2}", r["wall_s"]) is not None and re.fullmatch(r"[1-9][0-9]*", r["peak_rss_kb"]) is not None,
                "%s: a wall time and a peak RSS" % wid)
            say(any(x[0] == wid and x[1] == "openpyxl" for x in erows), "%s: entries rows under label openpyxl" % wid)
    say(all(len(x) > 1 and x[1] == "openpyxl" for x in erows), "every entries row is under label openpyxl")
    run_cols = e["RUN_H"].replace("\\t", "\t").split("\t")
    ok = len(rrows) == 1 and len(rrows[0]) == len(run_cols)
    r = dict(zip(run_cols, rrows[0])) if ok else {}
    say(ok, "one run row")
    say(r.get("commit") == e["COMMIT"], "the run row's commit is the phase commit")
    say(r.get("image_id") == e["IMG_ID"], "the run row's image id is the image's")
    say(r.get("openpyxl") == "3.1.5", "the run row's openpyxl is 3.1.5")
    say(r.get("ops_sha256") == e["OPS_SHA"] and r.get("xlsx_diff_sha256") == e["XD_SHA"],
        "the run row's ops script and xlsx-diff hashes are the clone's and the built binary's")
    say(r.get("op") == op and r.get("files") == str(len(want_ids)), "the run row's op and file count")
    say((r.get("timeout_s"), r.get("lo_timeout_s"), r.get("memory_mib")) == ("300", "600", "2048"),
        "the run row's settings are the defaults, 300 s, 600 s and 2048 MiB")
    print("\n".join(out))
    CMPCHECK
    echo "command: the checker <scratch>/w/fx/cmpcheck.py (printed below, sha256 $(sha256sum <"$FX/cmpcheck.py" | cut -d' ' -f1)), run as python3 -I -B <checker> <run directory> <op> with the expectations in its environment"
    sed 's/^/    /' "$FX/cmpcheck.py"
    # compare_case <name> <root> <op> <out dir> [arguments...]: a clone's comparison
    # runner over the fictional corpus with the image and the built xlsx-diff;
    # exit, stdout and stderr kept as <name>.rc/.out/.err.
    compare_case() {
      local name=$1 root=$2 op=$3 out=$4 rc
      shift 4
      echo "### $name"
      echo "command: TMPDIR=<scratch>/w/tmp bash $root/scripts/compare-run.sh --op $op --image $IMAGE --xlsx-diff <scratch>/w/bin/xlsx-diff --corpus <scratch>/w/fx/corpus --out $out $*"
      TMPDIR=$B/tmp bash "$root/scripts/compare-run.sh" --op "$op" --image "$IMAGE" --xlsx-diff "$BIN/xlsx-diff" \
        --corpus "$CORPUS" --out "$out" "$@" >"$B/$name.out" 2>"$B/$name.err" </dev/null
      rc=$?
      echo "$rc" >"$B/$name.rc"
      echo "  exit: $rc; standard output:"
      sed 's/^/    /' "$B/$name.out"
      echo "  standard error:"
      sed 's/^/    /' "$B/$name.err"
    }
    rc_of() { cat "$B/$1.rc"; }
    # run_checker <name> <run dir> <op> <ids> <outcome> <exit> <lo>: the checker's lines into <name>.chk.
    run_checker() {
      IDS=$4 OUTCOME=$5 EXIT=$6 LO=$7 SUM_H=$SUM_H ENT_H=$ENT_H RUN_H=$RUN_H COMMIT=$C IMG_ID=$IMG_ID \
        OPS_SHA=$OPS_SCRIPT_SHA XD_SHA=$XD_SHA python3 -I -B "$FX/cmpcheck.py" "$2" "$3" >"$B/$1.chk" 2>"$B/$1.chkerr" </dev/null
      echo "$?" >"$B/$1.chkrc"
    }
    # checker_pass <name>: the checker exited 0, wrote lines, every one yes.
    checker_pass() { [ "$(cat "$B/$1.chkrc")" = 0 ] && [ ! -s "$B/$1.chkerr" ] && [ "$(count_lines "$B/$1.chk")" -ge 1 ] && [ "$(count_matches -E '^no' "$B/$1.chk")" = 0 ]; }
    # stdout_ok <name> <id>...: one line per id (id ok 0 wall rss), the count line, the containers line, nothing else, no slash.
    stdout_ok() {
      local name=$1 id n=0
      shift
      for id in "$@"; do
        [ "$(count_matches -E "^$id ok 0 [0-9]+[.][0-9]{2} [1-9][0-9]*\$" "$B/$name.out")" = 1 ] || return 1
        n=$((n + 1))
      done
      [ "$(count_matches -xF "files $n ok $n error 0 timeout 0 cap 0 no-output 0" "$B/$name.out")" = 1 ] || return 1
      [ "$(count_matches -xF "containers of the image remaining: 0" "$B/$name.out")" = 1 ] || return 1
      [ "$(count_lines "$B/$name.out")" = "$((n + 2))" ] && [ "$(count_matches -F / "$B/$name.out")" = 0 ] && [ ! -s "$B/$name.err" ] && [ "$(rc_of "$name")" = 0 ]
    }
    IDS_BOTH=$G_ID:xlsx,$T_ID:xltx
    # Change RE: two ops, the runner's trap (ruling I) the change under test.
    # trap_order <name>: the last two lines are the files line, then the containers line, once each.
    trap_order() {
      [ "$(tail -n 2 "$B/$1.out" | head -n 1)" = "files 2 ok 2 error 0 timeout 0 cap 0 no-output 0" ] || return 1
      [ "$(tail -n 1 "$B/$1.out")" = "containers of the image remaining: 0" ] || return 1
      [ "$(count_matches -E '^containers of the image remaining: ' "$B/$1.out")" = 1 ]
    }
    for op in roundtrip edit; do
      compare_case "C-$op" "$CL" "$op" "$FX/runs/$op" --libreoffice "$LO_IMAGE"
      check "C-$op: exit 0, one line per workbook, the count line and the containers line, no path, nothing on stderr" "$(yn stdout_ok "C-$op" "$G_ID" "$T_ID")"
      check "C-$op: the containers line exactly once, the last line, after the files line (ruling I)" "$(yn trap_order "C-$op")"
      run_checker "C-$op" "$FX/runs/$op" "$op" "$IDS_BOTH" ok 0 ok
      echo "  the checker: exit $(cat "$B/C-$op.chkrc"); standard error bytes $(wc -c <"$B/C-$op.chkerr")"
      while IFS=$TAB read -r verdict what; do
        check "C-$op: $what" "$verdict"
      done <"$B/C-$op.chk"
      check "C-$op: the checker exited 0 and every one of its lines reads yes" "$(yn checker_pass "C-$op")"
    done
    echo "### the controls"
    run_checker C-ctl "$FX/runs/roundtrip" edit "$IDS_BOTH" ok 0 ok
    check "control: the checker refuses the roundtrip run read as the edit op's" "$(ynnot checker_pass C-ctl)"
    { cat "$B/C-roundtrip.out"; echo "$G_ID ok 0 0.10 1 /planted/path"; } >"$B/C-pathctl.out"
    cp "$B/C-roundtrip.rc" "$B/C-pathctl.rc"; : >"$B/C-pathctl.err"
    check "control: the stdout check refuses an output holding a planted path" "$(ynnot stdout_ok C-pathctl "$G_ID" "$T_ID")"
    head -n -1 "$B/C-roundtrip.out" >"$B/C-trapctl.out"; cp "$B/C-roundtrip.rc" "$B/C-trapctl.rc"; : >"$B/C-trapctl.err"
    check "control: the order check refuses an output without its containers line" "$(ynnot trap_order C-trapctl)"
    
    echo
    echo "### T3 refusals, every message read from scripts/compare-run.sh; the trap prints its line once the work directory exists (ruling I)"
    CR=$CL/scripts/compare-run.sh
    USAGE_V=$(sed -n 's/^readonly USAGE="\(.*\)"$/\1/p' "$CR")
    die_of() { LC_ALL=C "$G" -o -e "die \"$1[^\"]*\"" "$CR" | sed -e 's/^die "//' -e 's/"$//'; }
    RAW_OP=$(die_of '--op must name')
    RAW_DUP=$(die_of 'id [$]dup already has a row')
    MSG_OP=${RAW_OP/\$USAGE/$USAGE_V}
    MSG_DUP=${RAW_DUP/\$dup/$G_ID}
    MSG_DUP=${MSG_DUP/\$LABEL/openpyxl}
    echo "  the unknown-op message: $MSG_OP"
    echo "  the rerun message: $MSG_DUP"
    one_line_msg() { [ -n "$1" ] && [ "$(printf '%s\n' "$1" | wc -l)" = 1 ]; }
    msgs_ok() { one_line_msg "$RAW_OP" && one_line_msg "$RAW_DUP" && [ -n "$USAGE_V" ]; }
    check "each message is found once in the source, and the usage line" "$(yn msgs_ok)"
    msg_ctl() { one_line_msg "$(die_of 'no such message')"; }
    check "control: the same reading finds no message for a start the source does not hold" "$(ynnot msg_ctl)"
    # refused_as <name> <message>: exit 2, the one error line, nothing on stdout.
    refused_as() { [ "$(rc_of "$1")" = 2 ] && [ "$(count_lines "$B/$1.err")" = 1 ] && [ "$(count_matches -xF "error: $2" "$B/$1.err")" = 1 ] && [ ! -s "$B/$1.out" ]; }
    # refused_counted <name> <message>: exit 2, the one error line, and stdout the containers line alone (ruling I).
    refused_counted() { [ "$(rc_of "$1")" = 2 ] && [ "$(count_lines "$B/$1.err")" = 1 ] && [ "$(count_matches -xF "error: $2" "$B/$1.err")" = 1 ] && [ "$(cat "$B/$1.out")" = "containers of the image remaining: 0" ]; }
    compare_case R-op "$CL" no-such-op "$FX/runs/no-such-op"
    check "R-op: an unknown op refused with its message before the work directory exists, so nothing on stdout" "$(yn refused_as R-op "$MSG_OP")"
    check "R-op: the run directory was not made" "$(ynnot test -e "$FX/runs/no-such-op")"
    compare_case R-rerun "$CL" roundtrip "$FX/runs/roundtrip"
    check "R-rerun: a rerun into a run directory holding the ids refused with its message, and the trap's containers line printed (ruling I)" "$(yn refused_counted R-rerun "$MSG_DUP")"
    check "R-rerun: the summary still holds its two rows" "$(yn [ "$(count_lines "$FX/runs/roundtrip/summary.openpyxl.tsv")" = 3 ])"
    check "control: the counted refusal check refuses R-op's output, which has no containers line" "$(ynnot refused_counted R-op "$MSG_OP")"
    echo
    echo "## T4: scripts/passthrough-record.py, the container start (rulings K and P; change RF)"
    REC_NEW=$CL/scripts/passthrough-record.py
    REC_OLD=$B/record-base.py
    git show "$REC:scripts/passthrough-record.py" >"$REC_OLD" || exit 2
    echo "command: git show <base>:scripts/passthrough-record.py > <scratch>/w/record-base.py; sha256sum: $(sha256sum <"$REC_OLD" | cut -d' ' -f1); the phase commit's: $(sha256sum <"$REC_NEW" | cut -d' ' -f1)"
    fail_of() { LC_ALL=C "$G" -o -e "Failure(\"$1[^\"]*\"" "$REC_NEW" | sed -e 's/^Failure("//' -e 's/"$//'; }
    MSG_EMPTY=$(fail_of 'empty.openpyxl.tsv does not hold runs 1 to 3')
    RAW_HEADER=$(fail_of '%s does not start with the expected header')
    MSG_HEADER=$(printf "$RAW_HEADER" empty.openpyxl.tsv)
    echo "  the malformed-file message: $MSG_EMPTY"
    echo "  the header message for the empty-run file: $MSG_HEADER"
    msgs4_ok() { one_line_msg "$MSG_EMPTY" && one_line_msg "$RAW_HEADER"; }
    check "each record message is found once in the source" "$(yn msgs4_ok)"
    # record_case <name> <script> <run dir> <stem> [arguments...]: the record script into <scratch>/w/rec.
    record_case() {
      local name=$1 script=$2 run=$3 stem=$4 rc
      shift 4
      echo "### $name"
      echo "command: python3 -I -B $script --run $run --out <scratch>/w/rec --stem $stem $*"
      python3 -I -B "$script" --run "$run" --out "$B/rec" --stem "$stem" "$@" >"$B/$name.out" 2>"$B/$name.err" </dev/null
      rc=$?
      echo "$rc" >"$B/$name.rc"
      echo "  exit: $rc; standard output:"
      sed 's/^/    /' "$B/$name.out"
      echo "  standard error:"
      sed 's/^/    /' "$B/$name.err"
    }
    # empty_file <run dir> <lines...>: the empty-run file written as given, printed.
    empty_file() {
      local run=$1
      shift
      printf '%s\n' "$@" >"$run/empty.openpyxl.tsv" || exit 2
      echo "command: printf into $run/empty.openpyxl.tsv:"
      sed 's/^/    /' "$run/empty.openpyxl.tsv"
    }
    EMPTY_LINE='- Container start: an empty run of the image (python3 -I -B -c pass, the same mounts and flags), three runs 0.52, 0.48, 0.61 s, median 0.52 s; the openpyxl wall times include it (specs/0037 rulings K and P)'
    echo "  the container-start line expected: $EMPTY_LINE"
    # start_ok <name> <stem>: written, exit 0, the container-start line once, exactly.
    start_ok() { [ "$(rc_of "$1")" = 0 ] && [ ! -s "$B/$1.err" ] && [ "$(count_matches -xF "$EMPTY_LINE" "$B/rec/$2.md")" = 1 ]; }
    # start_absent <name> <stem>: written, exit 0, no container-start line.
    start_absent() { [ "$(rc_of "$1")" = 0 ] && [ ! -s "$B/$1.err" ] && [ "$(count_matches -F 'Container start' "$B/rec/$2.md")" = 0 ]; }
    for d in start nostart short badhead; do cp -a "$FX/runs/roundtrip" "$FX/runs/$d" || exit 2; done
    echo "command: cp -a <scratch>/w/fx/runs/roundtrip to <scratch>/w/fx/runs/start, nostart, short and badhead"
    empty_file "$FX/runs/start" 'run	wall_s' '1	0.52' '2	0.48' '3	0.61'
    record_case S1 "$REC_NEW" "$FX/runs/start" s1 --allow-single
    check "S1: with empty.openpyxl.tsv, the record names the three runs and their median, the exact line" "$(yn start_ok S1 s1)"
    record_case S2 "$REC_NEW" "$FX/runs/nostart" s2 --allow-single
    check "S2: without the file, no container-start line" "$(yn start_absent S2 s2)"
    check "control: the start check refuses S2's record" "$(ynnot start_ok S2 s2)"
    empty_file "$FX/runs/short" 'run	wall_s' '1	0.52'
    record_case S3 "$REC_NEW" "$FX/runs/short" s3 --allow-single
    check "S3: a file of one run refused with its message, no record written" "$(yn refused_as S3 "$MSG_EMPTY")"
    check "S3: no record was written" "$(ynnot test -e "$B/rec/s3.md")"
    empty_file "$FX/runs/badhead" 'run	seconds' '1	0.52' '2	0.48' '3	0.61'
    record_case S4 "$REC_NEW" "$FX/runs/badhead" s4 --allow-single
    check "S4: a file with another header refused with its message" "$(yn refused_as S4 "$MSG_HEADER")"
    # same_record <old stem> <new stem>: the .txt byte for byte; the .md the same once its one "Record written" line is left out.
    same_record() {
      local o=$B/rec/$1 n=$B/rec/$2
      cmp -s "$o.txt" "$n.txt" || return 1
      [ "$(count_matches -E '^- Record written: ' "$o.md")" = 1 ] && [ "$(count_matches -E '^- Record written: ' "$n.md")" = 1 ] || return 1
      # Each record names its own companion .txt by its stem; the stems differ
      # by design, so each is read as STEM before the comparison.
      LC_ALL=C "$G" -v -E '^- Record written: ' "$o.md" | sed "s/\\b$1[.]txt\\b/STEM.txt/g" >"$o.cmp" &&
        LC_ALL=C "$G" -v -E '^- Record written: ' "$n.md" | sed "s/\\b$2[.]txt\\b/STEM.txt/g" >"$n.cmp" && cmp -s "$o.cmp" "$n.cmp"
    }
    record_case S5-old "$REC_OLD" "$FX/runs/nostart" s5-old --allow-single
    record_case S5-new "$REC_NEW" "$FX/runs/nostart" s5-new --allow-single
    check "S5: an openpyxl record without the file, the base commit's record script and the phase commit's the same but for the Record written line" "$(yn same_record s5-old s5-new)"
    record_case S6-old "$REC_OLD" "$FX/runs/start" s6-old --allow-single
    check "control: the comparison refuses the base commit's record of the directory holding the file against S1's, which names it" "$(ynnot same_record s6-old s1)"
    
    echo
    echo "### T4: the emend records, the base commit's record script against the phase commit's"
    # runner_case <name> <label> <binary> <out dir> [arguments...]: the clone's passthrough runner over the fictional corpus.
    runner_case() {
      local name=$1 label=$2 bin=$3 out=$4 rc
      shift 4
      echo "### $name"
      echo "command: TMPDIR=<scratch>/w/tmp bash <scratch>/w/clone/scripts/passthrough-run.sh --label $label --passthrough $bin --xlsx-diff <scratch>/w/bin/xlsx-diff --corpus <scratch>/w/fx/corpus --out $out --libreoffice $LO_IMAGE $*"
      TMPDIR=$B/tmp bash "$CL/scripts/passthrough-run.sh" --label "$label" --passthrough "$bin" --xlsx-diff "$BIN/xlsx-diff" \
        --corpus "$CORPUS" --out "$out" --libreoffice "$LO_IMAGE" "$@" >"$B/$name.out" 2>"$B/$name.err" </dev/null
      rc=$?
      echo "$rc" >"$B/$name.rc"
      echo "  exit: $rc; standard output:"
      sed 's/^/    /' "$B/$name.out"
      echo "  standard error:"
      sed 's/^/    /' "$B/$name.err"
    }
    ran_two() { [ "$(rc_of "$1")" = 0 ] && [ ! -s "$B/$1.err" ] && [ "$(count_matches -xF "files 2 ok 2 error 0 timeout 0 panic 0 crash 0" "$B/$1.out")" = 1 ]; }
    runner_case E-host host "$BIN/emend-copy" "$FX/runs/emend"
    check "E-host: the host run over the two workbooks, both ok" "$(yn ran_two E-host)"
    runner_case E-i686 i686 "$BIN/emend-copy-i686" "$FX/runs/emend"
    check "E-i686: the i686 run into the same run directory, both ok" "$(yn ran_two E-i686)"
    runner_case E-solo host "$BIN/emend-copy" "$FX/runs/emend-solo"
    check "E-solo: a host run alone, both ok" "$(yn ran_two E-solo)"
    record_case R6-old "$REC_OLD" "$FX/runs/emend" e2-old
    record_case R6-new "$REC_NEW" "$FX/runs/emend" e2-new
    record_case R7-old "$REC_OLD" "$FX/runs/emend-solo" e1-old --allow-single
    record_case R7-new "$REC_NEW" "$FX/runs/emend-solo" e1-new --allow-single
    rec_ran() { [ "$(rc_of "$1")" = 0 ] && [ ! -s "$B/$1.err" ]; }
    both_ran() { rec_ran R6-old && rec_ran R6-new && rec_ran R7-old && rec_ran R7-new; }
    check "the four records were written, each exit 0 with nothing on stderr" "$(yn both_ran)"
    echo "  host and i686: the md's line counts $(count_lines "$B/rec/e2-old.md") and $(count_lines "$B/rec/e2-new.md"); host alone: $(count_lines "$B/rec/e1-old.md") and $(count_lines "$B/rec/e1-new.md")"
    check "R6: host and i686, the base commit's record and the phase commit's are the same but for the Record written line" "$(yn same_record e2-old e2-new)"
    check "R7: host alone, the same" "$(yn same_record e1-old e1-new)"
    sed 's/^- Targets: .*/- Targets: planted/' "$B/rec/e2-new.md" >"$B/rec/e2-ctl.md" && cp "$B/rec/e2-new.txt" "$B/rec/e2-ctl.txt"
    check "control: the comparison refuses a record with its Targets line changed" "$(ynnot same_record e2-old e2-ctl)"
    echo
    echo "## T5: the plants, in a second clone (change QJ's machinery; this phase's plants, change RG)"
    PL=$B/plant
    echo "command: git clone -q <repo> <scratch>/w/plant; git -C <scratch>/w/plant checkout -q --detach <phase commit>"
    git clone -q "$MAIN" "$PL" >"$B/plant-clone.out" 2>"$B/plant-clone.err" </dev/null &&
      git -C "$PL" checkout -q --detach "$C" >>"$B/plant-clone.out" 2>>"$B/plant-clone.err" </dev/null
    rc=$?
    plant_at_c() { [ "$(git -C "$PL" rev-parse HEAD)" = "$C" ] && [ -z "$(git -C "$PL" status --porcelain)" ]; }
    plant_made() { [ "$rc" = 0 ] && plant_at_c; }
    check "the plant clone is at the phase commit, its tree clean" "$(yn plant_made)"
    cat >"$B/plant.py" <<'PLANT'
    """Replaces one text in one file of the plant clone, refusing unless the old
    text is there exactly once. Prints nothing."""
    import os
    import sys
    
    path = sys.argv[1]
    old, new = os.environ["PLANT_OLD"], os.environ["PLANT_NEW"]
    text = open(path).read()
    if text.count(old) != 1:
        sys.exit(1)
    open(path, "w").write(text.replace(old, new))
    PLANT
    echo "command: the planter <scratch>/w/plant.py (printed below, sha256 $(sha256sum <"$B/plant.py" | cut -d' ' -f1)), run as python3 -I -B <planter> <file> with the old and new text in its environment"
    sed 's/^/    /' "$B/plant.py"
    # plant <name> <file> <old> <new>: the mutation in the plant clone, printed.
    plant() {
      echo "### $1: in $2, the text"
      printf '%s\n' "$3" | sed 's/^/    /'
      echo "  made"
      printf '%s\n' "$4" | sed 's/^/    /'
      PLANT_OLD=$3 PLANT_NEW=$4 python3 -I -B "$B/plant.py" "$PL/$2" >"$B/$1-plant.out" 2>"$B/$1-plant.err" </dev/null
      echo "$?" >"$B/$1-plant.rc"
      check "$1: planted (the old text found once)" "$(yn [ "$(cat "$B/$1-plant.rc")" = 0 ])"
    }
    # unplant <name> <file>: the file restored from the phase commit, the clone clean again.
    unplant() {
      git -C "$PL" checkout -q -- "$2" >"$B/$1-unplant.out" 2>"$B/$1-unplant.err" </dev/null
      check "$1: undone, the plant clone clean" "$(yn [ -z "$(git -C "$PL" status --porcelain)" ])"
    }
    plant P1 scripts/compare-run.sh 'trap finish EXIT' 'trap '"'"'rm -rf "${WORK:?}"'"'"' EXIT'
    compare_case P1 "$PL" roundtrip "$FX/runs/p1"
    check "P1: the trap set back to the removal alone caught: the stdout check refuses the run, which prints no containers line" "$(ynnot stdout_ok P1 "$G_ID" "$T_ID")"
    check "P1: and the order check refuses it (ruling I)" "$(ynnot trap_order P1)"
    unplant P1 scripts/compare-run.sh
    plant P2 scripts/compare-record.py 'corpus_cells(stats(ox, lo_in_rows=host))' 'corpus_cells(stats(ox))'
    cr_test P2 "$PL"
    echo "  the plant's compare-record test: exit $(cat "$B/P2.rc"); its FAIL lines:"
    LC_ALL=C "$G" -E '^FAIL ' "$B/P2.out" | sed 's/^/    /'
    p2_caught() { [ "$(count_matches -xF "FAIL openpyxl: lo_in counted from the emend host run, ok 2 and fail 1 (ruling C)" "$B/P2.out")" = 1 ] && [ "$(cat "$B/P2.rc")" = 1 ]; }
    check "P2: compare-record taking lo_in from the openpyxl summary caught by its test's ruling C line" "$(yn p2_caught)"
    check "P2: the T1 pass check refuses the plant's output" "$(ynnot cr_passed P2)"
    unplant P2 scripts/compare-record.py
    plant P3 scripts/compare-record.py 'out["wall median"] = statistics.median(walls) if walls else None' 'out["wall median"] = statistics.mean(walls) if walls else None'
    cr_test P3 "$PL"
    echo "  the plant's compare-record test: exit $(cat "$B/P3.rc"); its FAIL lines:"
    LC_ALL=C "$G" -E '^FAIL ' "$B/P3.out" | sed 's/^/    /'
    p3_caught() { [ "$(count_matches -xF "FAIL emend host: wall median 2, sum 7; peak RSS median 2000, max 3000" "$B/P3.out")" = 1 ] && [ "$(cat "$B/P3.rc")" = 1 ]; }
    check "P3: the wall median computed as a mean caught by its test's emend host median line" "$(yn p3_caught)"
    unplant P3 scripts/compare-record.py
    plant P4 scripts/passthrough-record.py '    if empty is not None:' '    if False:'
    record_case P4 "$PL/scripts/passthrough-record.py" "$FX/runs/start" p4 --allow-single
    check "P4: the record script dropping the container-start line caught by S1's check" "$(ynnot start_ok P4 p4)"
    unplant P4 scripts/passthrough-record.py
    check "the plant clone is back at the phase commit's bytes" "$(yn plant_at_c)"
    echo "  the unplanted control: T1, T3 and T4 above ran the same scripts from <scratch>/w/clone at the phase commit and passed"
    echo
    echo "## the image's containers at the end (ruling A; change QI)"
    image_containers >"$B/containers-end.out" 2>"$B/containers-end.err"
    rc=$?
    n_end=$(awk 'NF { n++ } END { print n + 0 }' "$B/containers-end.out")
    echo "command: podman ps -a --filter ancestor=$IMAGE --format '{{.Names}}': exit $rc; containers of the image: $n_end"
    end_none() { [ "$rc" = 0 ] && [ "$n_end" = 0 ]; }
    check "no container of the image remains at the end" "$(yn end_none)"
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.out "$B"/*.err; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or planning's spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's logs or planning's uncommitted spec (change RA)" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/test.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
