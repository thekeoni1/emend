command: cat <scratch>/w/fx/plant.py (the plant program; sha256 ac573a1b341a9e382c56337e30896269b68afcdefae3858bf3ddfba69a8b7349)
    """Plants one line in a copy of scripts/openpyxl-ops.py, before its one
    load_workbook line: exception raises ValueError with the text of
    PLANT_TEXT as its message; memory raises MemoryError; path writes the text
    of PLANT_TEXT and a newline to standard error and goes on. Exit 3 when the
    anchor is not there once; prints nothing."""
    import os
    import sys
    
    path, kind = sys.argv[1], sys.argv[2]
    ANCHOR = "    wb = openpyxl.load_workbook(source)\n"
    text = open(path).read()
    if text.count(ANCHOR) != 1:
        sys.exit(3)
    plant = {
        "exception": "    raise ValueError(%r)\n" % os.environ.get("PLANT_TEXT", ""),
        "memory": "    raise MemoryError()\n",
        "path": "    import sys as _s; _s.stderr.write(%r)\n" % (os.environ.get("PLANT_TEXT", "") + "\n"),
    }[kind]
    open(path, "w").write(text.replace(ANCHOR, plant + ANCHOR))
