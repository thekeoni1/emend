    #      planning holds "Planning rulings during P1" uncommitted. The pattern
    #      allows this phase's logs and its records/m3p3-p1- and records/m3p3-open-
    #      stems.
    #  HB. One family, S0 to S3C, the generator gen-p1.py written for this phase:
    #      the template's sheetData given a head of root children before it. The
    #      new write message reached two ways (two sheetPr, one out of order),
    #      part 3's message once (two sheetViews), each with its control.
    #  HC. The part's messages are the constants package.rs defines under the
    #      Cargo feature sheetprops (a reader printed below takes each const
    #      whose line follows #[cfg(feature = "sheetprops")]), compared as a SET
    #      with the constants the three bodies return: Parts::set_tab_color,
    #      Parts::set_sheet_view (the private fns) and SettingsPass::observe.
    #      Part 3's two-elements message is recorded apart (as P3 recorded the
    #      index message), since it is not the part's. "a sheet setting is out of
    #      range" is stated unreachable through the tool (the sample's colour and
    #      zoom are its constants), with the crate test that covers it and the
    #      test's body asserted to hold the message. "Errors"' other shared
    #      messages are every edit's, not the sample's constants, and earlier
    #      parts' negative logs reach them; they are printed, not accounted.
    #  HD. Nothing of P3's carried rules is dropped. This script removes no
    #      directory: the worktree goes by git worktree remove, the scratch
    #      directory is kept on the disk under <build>, and no rm of any form is
    #      run (specs/0024 P2 ruling 1 needs none here).
    #
    # Usage: m5p6-p3-negative.sh <phase commit> > <file outside the tree>; the
    # caller moves the output to records/logs/m5p6-p3/negative.log.
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/negative.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never PYTHONDONTWRITEBYTECODE=1
    PHASE_DIR=$HOME/.cache/emend-build/m5p6-p3
    BUILD_ROOT=${NEGATIVE_BUILD:-$PHASE_DIR/negative}
    SUPERSEDED_DIR=$PHASE_DIR/superseded
    TARGET_DIR=$PHASE_DIR/target
    GATE_LOG=${GATE_LOG:-$PHASE_DIR/logs/gate.log}
    SPEC=specs/0037-measurement-and-close.md
    SPEC_WANT=88c0fa8b91cab7ee18d47b9c149dae8e787aac0f0c4333bed873abe516df8cac
    IMAGE=localhost/emend-openpyxl:3.1.5-dfsg-2-deb13
    mkdir -p "$BUILD_ROOT" || exit 2
    # Change PX3: made on the disk under <build> and kept after the run.
    B=$(mktemp -d -p "$BUILD_ROOT") || exit 2
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT_SHA=${C:0:7}
    # This phase's logs, the test log's API record and planning's uncommitted
    # spec (changes PY2, PZ2 and PZ8): this log runs after the test log writes
    # the API record and before the size and run logs write the others.
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m5p6-p3/|[?][?] records/api-review-m5p6-[0-9]{4}-[0-9]{2}-[0-9]{2}-${SHORT_SHA}[.]md\$| M specs/0037-measurement-and-close[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs and planning's spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$B#<scratch>/w#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$SUPERSEDED_DIR#<superseded>#g" \
        -e "s#$TARGET_DIR#<target>#g" -e "s#$PHASE_DIR#<phase>#g" \
        -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    # The environment and path inputs, each on its labelled line.
    echo "input: RERUN_NOTE: ${RERUN_NOTE:-unset}"
    echo "input: RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: HOME: set, read for the paths under it, printed as <home>"
    echo "input: NEGATIVE_BUILD: ${NEGATIVE_BUILD:-unset} (the build root, <build>)"
    echo "input: GATE_LOG: ${GATE_LOG} (the gate log whose DEBUG xlsx-diff hash this log checks its copy against)"
    echo "input: the openpyxl image: $IMAGE"
    echo "about: M5 part 6 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M5 part 6 P2 record: the runs, the comparison record, the logs, the check')
    DOC=$(by_subject 'M5 part 6 P3: commit planning docs (the P2 verification and rulings)')
    FIX=$(by_subject 'M5 part 6 P3: the self-closing drawing root appended to; the comparison record reads its scale settings')
    LOCHK=$(by_subject 'M5 part 6 P3: the open check names its container and removes it after a timeout')
    OPS=$(by_subject 'M5 part 6 P3: the ops script ends a MemoryError as the cap wherever it is raised')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's full subject>, for each role"
    echo "  M5 part 6 P2's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the fix commit (the self-closing drawing root, decision 3 A; compare-record.py's scale settings, ruling U): ${FIX:-none}"
    echo "  the open-check commit (scripts/lo-check.sh's named container and removal, ruling A, item 7): ${LOCHK:-none}"
    echo "  the ops commit (a MemoryError ends as the cap wherever it is raised, ruling Y; the phase commit): ${OPS:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$OPS" "$LOCHK" "$FIX" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the ops commit, the open-check commit, the fix commit, the doc commit and the base, each the next one's parent, the ops commit the phase commit (changes PZ1 and PZ7)" "$(yn roles_in_order)"
    roles_ctl() { local OPS=$LOCHK; roles_in_order; }
    check "control: roles_in_order refuses the open-check commit named as the ops commit" "$(ynnot roles_ctl)"
    roles_ctl2() { local FIX=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the fix commit" "$(ynnot roles_ctl2)"
    # The full shas the phase's FACTS.md names for each role (change PZ1).
    roles_pinned() { [ "$REC" = d5e73cbb2e0f66d9ffd1f31fdde260c553201ee0 ] && [ "$DOC" = c4b25985c57a7a26ec821a2bdeb236c8dac12b2d ] && [ "$FIX" = ab007354339428d6fe5fb6396ce542435e459bac ] && [ "$LOCHK" = 940a1ef0aa55f5f67ebe8dc3471e4dc0f3b75971 ] && [ "$OPS" = ef9da373bc462ed8a9ced3992c5e404b9c954e09 ]; }
    echo "  the full shas pinned for the roles: base d5e73cbb2e0f66d9ffd1f31fdde260c553201ee0; doc c4b25985c57a7a26ec821a2bdeb236c8dac12b2d; fix ab007354339428d6fe5fb6396ce542435e459bac; open check 940a1ef0aa55f5f67ebe8dc3471e4dc0f3b75971; ops ef9da373bc462ed8a9ced3992c5e404b9c954e09"
    check "each role's commit, found by its subject, is the full sha pinned for it" "$(yn roles_pinned)"
    pinned_ctl() { local LOCHK=$OPS; roles_pinned; }
    check "control: the same comparison refuses the ops commit named as the open-check commit" "$(ynnot pinned_ctl)"
    echo
    echo "phase: Milestone 5 part 6 P3 ($SPEC) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "rerun: the superseded files are kept in <superseded>"
      echo "command: sha256sum and wc -c over each superseded attempt named above"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time\n' "$(basename "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this log builds nothing: it runs the phase commit's scripts over fictional workbooks in the openpyxl image and, for N8, the LibreOffice image, with the gate's DEBUG xlsx-diff copied (changes PX2, PX3 and PZ5)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh and $SPEC are read from it by git show at the phase commit, the working spec is hashed in it, and it is cloned (read only) into <scratch>/w/clone and the planted clones; nothing in it is run or built"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m5p6-p3, the phase's directory on the disk; <phase>/logs/gate.log is the gate log read for the DEBUG xlsx-diff's hash"
    echo "root: <scripts> stands for <phase>/scripts, this script's own directory on the disk, which holds the script and, in <scripts>/out, its own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <target> stands for <phase>/target, the phase's one target root (specs/0001); <target>/main/debug holds the gate's DEBUG binaries, read only (copied, never run in place)"
    echo "root: <build> stands for the build root on the disk, <phase>/negative unless NEGATIVE_BUILD names another"
    echo "root: <superseded> stands for <phase>/superseded, where a rerun's superseded files are kept; read only"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory under <build>, kept on the disk after the run (change PX3): <scratch>/w/counting.sh the phase commit's library, sourced; <scratch>/w/clone a clone of <repo> at the phase commit, whose scripts/compare-run.sh, scripts/openpyxl-ops.py and scripts/scale-gen.py are run; <scratch>/w/clone-n2, clone-n3 and clone-n6 the planted clones; <scratch>/w/bin the copied xlsx-diff; <scratch>/w/fx the generated workbooks and the plant program; <scratch>/w/runs the run directories; <scratch>/w/tmp the runner's TMPDIR; <scratch>/w/lo N8's fixture copy and its lo_check work directories (change PZ5); the cases' captured outputs beside them"
    echo "root: <close> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change PX5)"
    echo "root: <gatebuild> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change PX5)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$BUILD_ROOT" && apart "$SUPERSEDED_DIR" "$MAIN" && apart "$TARGET_DIR" "$BUILD_ROOT" && apart "$TARGET_DIR" "$MAIN"; }
    check "the roots other than <home> and <phase> are distinct, none inside another (<scratch>/w inside <build>)" "$(yn roots_distinct)"
    roots_ctl() { apart "$B" "$BUILD_ROOT"; }
    check "control: apart refuses <scratch>/w against <build>, which holds it" "$(ynnot roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them this phase's logs or planning's spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT_SHA")"
    short_names_head() { [ "$(git rev-parse "$SHORT_SHA")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_spec_ctl() { printf ' M specs/0036-charts-write-second-set.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified spec other than specs/0037" "$(ynnot ours_spec_ctl)"
    ours_roadmap_ctl() { printf ' M ROADMAP.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified ROADMAP.md (committed and clean in this phase)" "$(ynnot ours_roadmap_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m5p6-p3/gate.log\n?? records/logs/m5p6-p2/gate.log\n?? records/m5p6-p3-x-2026-01-01-%s.md\n?? records/logs/m5p6-p3x/gate.log\n M ROADMAP.md\n M specs/0037-measurement-and-close.md\n?? specs/0037-measurement-and-close.md\n?? records/openpyxl-image-2026-01-01.md\n?? records/compare-m5p6-2026-01-01-%s.md\n M records/openpyxl-image-2026-10-16.md\n?? records/api-review-m5p6-2026-01-01-%s.md\n?? records/api-review-m5p6-2026-01-01-0000000.md\n?? records/size-m5p6-2026-01-01-%s.md\n' "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern takes this phase's log, the API record named by the phase commit and planning's modified spec alone, no other phase's log, no other record, no API record of another commit, no size record, no sibling directory, no untracked spec, no image record (changes PY2, PZ2 and PZ8)" "$(yn [ "$(ours_rec_ctl)" = 3 ])"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_BLOB=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum: $SPEC_BLOB; sha256sum $SPEC (the working file, printed and not asserted: planning may hold a later ruling uncommitted; change PZ1): $SPEC_HAVE"
    check "the spec's blob at the phase commit is at the hash this log pins" "$(yn [ "$SPEC_BLOB" = "$SPEC_WANT" ])"
    SPEC_DOC=$(git show "$DOC:$SPEC" 2>/dev/null | sha256sum | cut -d' ' -f1)
    echo "the spec pin: $SPEC at the doc commit, git show <doc commit>:$SPEC | sha256sum: $SPEC_DOC"
    check "the spec's blob at the doc commit is the pin, and the phase commit's is the same blob" "$(yn [ "$SPEC_DOC $SPEC_BLOB" = "$SPEC_WANT $SPEC_WANT" ])"
    spec_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$SPEC_WANT" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot spec_ctl)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts under test, at the phase commit (change PX2)"
    # clone_at <dir>: a git clone --shared of <repo> checked out at the phase
    # commit, its exit codes and HEAD in <dir>.status.
    clone_at() {
      local dir=$1 rc_clone rc_co head
      git clone -q --shared "$MAIN" "$dir" >"$dir.clone.out" 2>"$dir.clone.err" </dev/null
      rc_clone=$?
      git -C "$dir" checkout -q --detach "$C" >>"$dir.clone.out" 2>>"$dir.clone.err" </dev/null
      rc_co=$?
      head=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
      echo "$rc_clone $rc_co ${head:-none}" >"$dir.status"
    }
    clone_ok() { [ "$(cat "$1.status")" = "0 0 $C" ] && [ -z "$(git -C "$1" status --porcelain 2>/dev/null)" ]; }
    echo "command: git clone -q --shared <repo> <scratch>/w/clone; git -C <scratch>/w/clone checkout -q --detach <phase commit> (a scratch copy: nothing in <repo> is written)"
    clone_at "$B/clone"
    echo "  clone exit, checkout exit and HEAD: $(cat "$B/clone.status"); output bytes $(wc -c <"$B/clone.clone.out"), standard error bytes $(wc -c <"$B/clone.clone.err")"
    check "the clone is at the phase commit, its working tree clean" "$(yn clone_ok "$B/clone")"
    clone_ctl() { local C=$LOCHK; clone_ok "$B/clone"; }
    check "control: the same check refuses the clone read against the open-check commit (change PZ3)" "$(ynnot clone_ctl)"
    RUNNER=$B/clone/scripts/compare-run.sh
    OPSPY=$B/clone/scripts/openpyxl-ops.py
    SCALEGEN=$B/clone/scripts/scale-gen.py
    for f in compare-run.sh openpyxl-ops.py scale-gen.py lo-check.sh; do
      have=$(sha256sum <"$B/clone/scripts/$f" | cut -d' ' -f1)
      want=$(git show "$C:scripts/$f" | sha256sum | cut -d' ' -f1)
      echo "command: sha256sum <scratch>/w/clone/scripts/$f: $have; the phase commit's blob: $want"
      same_blob() { [ -n "$want" ] && [ "$have" = "$want" ]; }
      check "the clone's scripts/$f is the phase commit's blob" "$(yn same_blob)"
    done
    for f in compare-run.sh openpyxl-ops.py lo-check.sh; do
      echo "command: cat <scratch>/w/clone/scripts/$f (the script under test)"
      sed 's/^/    /' "$B/clone/scripts/$f"
    done
    echo "  <scratch>/w/clone/scripts/lo-check.sh is sourced by the runner, and no runner case gives --libreoffice; N8 sources it itself and runs its lo_check (change PZ4)"
    echo "  <scratch>/w/clone/scripts/scale-gen.py makes the workbooks; its text is the phase commit's blob (hashed above)"
    
    echo
    echo "## the image (ruling A's containers are the image's)"
    echo "command: podman image exists $IMAGE; podman image inspect --format '{{.Id}}' $IMAGE"
    podman image exists "$IMAGE" </dev/null >/dev/null 2>"$B/image.err"
    rc_img=$?
    IMAGE_ID=$(podman image inspect --format '{{.Id}}' "$IMAGE" </dev/null 2>>"$B/image.err")
    echo "  exists exit $rc_img; the image id: ${IMAGE_ID:-none}; standard error bytes $(wc -c <"$B/image.err")"
    image_ok() { [ "$rc_img" = 0 ] && printf '%s' "$IMAGE_ID" | LC_ALL=C "$G" -qE '^[0-9a-f]{64}$'; }
    check "the openpyxl image is there, its id read" "$(yn image_ok)"
    image_ctl() { podman image exists localhost/emend-openpyxl:no-such-tag </dev/null >/dev/null 2>&1; }
    check "control: the same check refuses a tag podman does not hold" "$(ynnot image_ctl)"
    
    echo
    echo "## the gate's DEBUG xlsx-diff, copied and checked against the gate log (change PX2)"
    BIN=$B/bin
    mkdir -p "$BIN" || exit 2
    gate_there() { [ -f "$GATE_LOG" ]; }
    check "the gate log is there" "$(yn gate_there)"
    # gate_sha <name>: the hash gate.log printed for <target>/main/debug/<name>,
    # from its one line of the form "<target>/main/debug/<name>: sha256 <hash>,
    # bytes N"; empty unless there is exactly one.
    gate_sha() {
      local n
      n=$(count_matches -F "<target>/main/debug/$1: sha256 " "$GATE_LOG")
      [ "$n" = 1 ] || return 0
      LC_ALL=C "$G" -F "<target>/main/debug/$1: sha256 " "$GATE_LOG" | sed -e 's/^.*: sha256 //' -e 's/,.*$//'
    }
    want=$(gate_sha xlsx-diff)
    cp "$TARGET_DIR/main/debug/xlsx-diff" "$BIN/xlsx-diff" 2>/dev/null
    have=$(sha256sum <"$BIN/xlsx-diff" 2>/dev/null | cut -d' ' -f1)
    echo "command: grep -F '<target>/main/debug/xlsx-diff: sha256 ' <phase>/logs/gate.log: ${want:-not exactly one line}; cp <target>/main/debug/xlsx-diff <scratch>/w/bin/xlsx-diff; sha256sum: ${have:-none}"
    bin_ok() { [ -n "$want" ] && [ "$have" = "$want" ] && [ -x "$BIN/xlsx-diff" ]; }
    check "the copy is executable and hashes as gate.log printed for the binary it copies" "$(yn bin_ok)"
    gate_sha_ctl() { [ -n "$(gate_sha no-such-binary)" ]; }
    check "control: the same reading finds no hash for a binary gate.log does not name" "$(ynnot gate_sha_ctl)"
    
    echo
    echo "## the generated workbooks and the plants (change PX3)"
    FX=$B/fx
    mkdir -p "$FX" "$B/runs" "$B/tmp" || exit 2
    TIER_A_ROWS=$(sed -n 's/^    "a": (\([0-9][0-9]*\), .*$/\1/p' "$SCALEGEN")
    echo "command: sed -n <the TIERS row of tier a> <scratch>/w/clone/scripts/scale-gen.py: tier a rows $TIER_A_ROWS (read from the source, never typed)"
    check "tier a's row count is read from scale-gen.py's TIERS, one number" "$(yn [ "$(printf '%s\n' "$TIER_A_ROWS" | count_matches -xE '[1-9][0-9]*' /dev/stdin)" = 1 ])"
    for tier in t a; do
      echo "command: python3 -I -B <scratch>/w/clone/scripts/scale-gen.py $tier <scratch>/w/fx/$tier"
      python3 -I -B "$SCALEGEN" "$tier" "$FX/$tier" >"$B/gen-$tier.out" 2>"$B/gen-$tier.err" </dev/null
      echo "$?" >"$B/gen-$tier.rc"
      echo "  exit $(cat "$B/gen-$tier.rc"); its line: $(cat "$B/gen-$tier.out"); standard error bytes $(wc -c <"$B/gen-$tier.err")"
    done
    gen_ok() { [ "$(cat "$B/gen-$1.rc")" = 0 ] && [ "$(count_matches -E "^generated $1 [0-9a-f]{12} [0-9]+ [0-9a-f]{64} " "$B/gen-$1.out")" = 1 ] && [ ! -s "$B/gen-$1.err" ] && [ "$(count_lines "$FX/$1/manifest.tsv")" = 2 ]; }
    check "tier t generated: exit 0, one generated line, a manifest of one row" "$(yn gen_ok t)"
    check "tier a generated: exit 0, one generated line, a manifest of one row" "$(yn gen_ok a)"
    gen_ctl() { gen_ok x; }
    echo x >"$B/gen-x.rc"; : >"$B/gen-x.out"; : >"$B/gen-x.err"; mkdir -p "$FX/x"; : >"$FX/x/manifest.tsv"
    check "control: the same check refuses a generation that did not happen" "$(ynnot gen_ctl)"
    T_ID=$(awk -F'\t' 'NR == 2 { print $1 }' "$FX/t/manifest.tsv")
    A_ID=$(awk -F'\t' 'NR == 2 { print $1 }' "$FX/a/manifest.tsv")
    echo "  tier t id $T_ID; tier a id $A_ID"
    
    # The plant program: one anchor line of the ops script's run(), the load,
    # gets a line before it; the planted text comes from the environment, so
    # nothing in this script's text is the marker or the path.
    cat >"$FX/plant.py" <<'PLANT'
    """Plants one line in a copy of scripts/openpyxl-ops.py, before its one
    load_workbook line: exception raises ValueError with the text of
    PLANT_TEXT as its message; memory raises MemoryError; path writes the text
    of PLANT_TEXT and a newline to standard error and goes on. Exit 3 when the
    anchor is not there once; prints nothing."""
    import os
    import sys
    
    path, kind = sys.argv[1], sys.argv[2]
    ANCHOR = "    wb = openpyxl.load_workbook(source)\n"
    text = open(path).read()
    if text.count(ANCHOR) != 1:
        sys.exit(3)
    plant = {
        "exception": "    raise ValueError(%r)\n" % os.environ.get("PLANT_TEXT", ""),
        "memory": "    raise MemoryError()\n",
        "path": "    import sys as _s; _s.stderr.write(%r)\n" % (os.environ.get("PLANT_TEXT", "") + "\n"),
    }[kind]
    open(path, "w").write(text.replace(ANCHOR, plant + ANCHOR))
    PLANT
    echo "command: cat <scratch>/w/fx/plant.py (the plant program; sha256 $(sha256sum <"$FX/plant.py" | cut -d' ' -f1))"
    sed 's/^/    /' "$FX/plant.py"
    # The marker and the path are assembled here at run time and never printed.
    MARK_A=plant MARK_B=marker
    MARKER="${MARK_A}ed-$((6 * 7))-${MARK_B}-message"
    PLANT_PATH="/ho""me/someone/emend-""testing/corpus/fixture.xlsx"
    PATH_RE='(/ho''me/|/m''nt/|/Us''ers/|/t''mp/|emend-''testing)'
    # plant_clone <name> <kind> [<text>]: a clone at the phase commit with the plant made in its ops script.
    plant_clone() {
      local dir=$B/clone-$1
      clone_at "$dir"
      PLANT_TEXT=${3:-} python3 -I -B "$FX/plant.py" "$dir/scripts/openpyxl-ops.py" "$2" >"$B/plant-$1.out" 2>"$B/plant-$1.err" </dev/null
      echo "$?" >"$B/plant-$1.rc"
      echo "command: git clone -q --shared <repo> <scratch>/w/clone-$1 at the phase commit; PLANT_TEXT=<assembled at run time, not printed> python3 -I -B <scratch>/w/fx/plant.py <scratch>/w/clone-$1/scripts/openpyxl-ops.py $2"
      echo "  clone exit, checkout exit and HEAD: $(cat "$dir.status"); plant exit $(cat "$B/plant-$1.rc"), output bytes $(wc -c <"$B/plant-$1.out"), standard error bytes $(wc -c <"$B/plant-$1.err"); the planted script's lines changed against the phase commit's: $(git -C "$dir" diff --numstat -- scripts/openpyxl-ops.py | awk '{ print $1 " added, " $2 " removed" }')"
    }
    # planted_ok_unplanted: the same numstat test on the unplanted clone, the control.
    planted_ok_unplanted() { [ "$(git -C "$B/clone" diff --numstat -- scripts/openpyxl-ops.py | awk '{ print $1 " " $2 }')" = "1 0" ]; }
    planted_ok() { [ "$(cat "$B/clone-$1.status")" = "0 0 $C" ] && [ "$(cat "$B/plant-$1.rc")" = 0 ] && [ ! -s "$B/plant-$1.out" ] && [ ! -s "$B/plant-$1.err" ] && [ "$(git -C "$B/clone-$1" diff --numstat -- scripts/openpyxl-ops.py | awk '{ print $1 " " $2 }')" = "1 0" ]; }
    plant_clone n2 exception "$MARKER"
    check "N2's clone: the plant made, one line added to its ops script and nothing else" "$(yn planted_ok n2)"
    plant_clone n3 memory
    check "N3's clone: the plant made, one line added" "$(yn planted_ok n3)"
    plant_clone n6 path "$PLANT_PATH"
    check "N6's clone: the plant made, one line added" "$(yn planted_ok n6)"
    check "control: the same check refuses the unplanted clone" "$(ynnot planted_ok_unplanted)"
    
    echo
    echo "## the messages, read from the sources at the phase commit (never typed)"
    echo "command: grep -o -E 'print\\(\"unknown op\"\\)' <scratch>/w/clone/scripts/openpyxl-ops.py; grep -o -E 'die \"--op must name one of the eleven ops[^\"]*\"' and the readonly USAGE line of <scratch>/w/clone/scripts/compare-run.sh; grep -o -E 'echo \"containers of the image remaining: ' the same; the text between the quotes"
    MSG_UNKNOWN=$(LC_ALL=C "$G" -o -E 'print\("unknown op"\)' "$OPSPY" | sed -e 's/^print("//' -e 's/")$//')
    MSG_OP_RAW=$(LC_ALL=C "$G" -o -E 'die "--op must name one of the eleven ops[^"]*"' "$RUNNER" | sed -e 's/^die "//' -e 's/"$//')
    USAGE_TEXT=$(sed -n 's/^readonly USAGE="\(.*\)"$/\1/p' "$RUNNER")
    MSG_OP=${MSG_OP_RAW/\$USAGE/$USAGE_TEXT}
    MSG_REMAIN=$(LC_ALL=C "$G" -o -E 'echo "containers of the image remaining: ' "$RUNNER" | sed -e 's/^echo "//')
    # Change PY4: N7's message, the runner's die on its summary append, $LABEL
    # filled from the source's readonly LABEL line.
    MSG_APPEND_RAW=$(LC_ALL=C "$G" -o -E 'die "cannot append to summary[.][$]LABEL[.]tsv"' "$RUNNER" | sed -e 's/^die "//' -e 's/"$//')
    LABEL_TEXT=$(sed -n 's/^readonly LABEL=\([a-z]*\)$/\1/p' "$RUNNER")
    MSG_APPEND=${MSG_APPEND_RAW/\$LABEL/$LABEL_TEXT}
    echo "command: grep -o -E 'die \"cannot append to summary[.][\$]LABEL[.]tsv\"' and sed -n <the readonly LABEL line> <scratch>/w/clone/scripts/compare-run.sh (change PY4)"
    echo "  the runner's message on a failed summary append, its \$LABEL filled from the source: $MSG_APPEND"
    append_msg_ok() { one_line_msg "$MSG_APPEND" && [ "$MSG_APPEND" != "$MSG_APPEND_RAW" ] && [ "$LABEL_TEXT" = openpyxl ]; }
    echo "  the ops script's unknown-op line: $MSG_UNKNOWN"
    echo "  the runner's unknown-op message, its \$USAGE filled from the source: $MSG_OP"
    echo "  the runner's container count line, its start: $MSG_REMAIN"
    one_line_msg() { [ -n "$1" ] && [ "$(printf '%s\n' "$1" | wc -l)" = 1 ]; }
    msgs_ok() { one_line_msg "$MSG_UNKNOWN" && one_line_msg "$MSG_OP" && one_line_msg "$USAGE_TEXT" && one_line_msg "$MSG_REMAIN" && [ "$MSG_OP" != "$MSG_OP_RAW" ]; }
    check "each message is found once in its source, not empty, the runner's \$USAGE filled" "$(yn msgs_ok)"
    check "the append message is found once in the runner's source, its \$LABEL filled with openpyxl (change PY4)" "$(yn append_msg_ok)"
    msg_ctl() { one_line_msg "$(LC_ALL=C "$G" -o -E 'die "no such message[^"]*"' "$RUNNER")"; }
    check "control: the same reading finds no message for a start the source does not hold" "$(ynnot msg_ctl)"
    
    # run_case <name> <clone> <corpus tier> <runner arguments...>: the clone's
    # compare-run.sh over <scratch>/w/fx/<tier> with the copied xlsx-diff, the
    # run directory <scratch>/w/runs/<name>, TMPDIR in <scratch>/w/tmp; exit,
    # stdout and stderr kept as <name>.rc/.out/.err.
    run_case() {
      local name=$1 clone=$2 tier=$3 rc
      shift 3
      echo "### $name"
      echo "command: TMPDIR=<scratch>/w/tmp bash <scratch>/w/${clone##*/}/scripts/compare-run.sh --image $IMAGE --xlsx-diff <scratch>/w/bin/xlsx-diff --corpus <scratch>/w/fx/$tier --out <scratch>/w/runs/$name $*"
      TMPDIR=$B/tmp bash "$clone/scripts/compare-run.sh" --image "$IMAGE" --xlsx-diff "$BIN/xlsx-diff" --corpus "$FX/$tier" --out "$B/runs/$name" "$@" >"$B/$name.out" 2>"$B/$name.err" </dev/null
      rc=$?
      echo "$rc" >"$B/$name.rc"
      echo "  exit: $rc; standard output:"
      sed 's/^/    /' "$B/$name.out"
      echo "  standard error:"
      sed 's/^/    /' "$B/$name.err"
    }
    rc_of() { cat "$B/$1.rc"; }
    # field <name> <column>: the column, found by its header name, of the run's one summary row.
    field() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } NR == 2 { print $k }' "$B/runs/$1/summary.openpyxl.tsv"; }
    # row_line <name>: the row's outcome, exit, signal, wall, peak RSS and leftover, as printed.
    row_line() { echo "  $1's row: outcome $(field "$1" outcome); exit $(field "$1" exit); signal $(field "$1" signal); wall_s $(field "$1" wall_s); peak_rss_kb $(field "$1" peak_rss_kb); leftover $(field "$1" leftover); diff_exit $(field "$1" diff_exit)"; }
    # ran_as <name> <outcome> <exit>: the runner exited 0 with nothing on stderr,
    # its summary one row of that outcome and exit, its last line no container left.
    ran_as() { [ "$(rc_of "$1")" = 0 ] && [ ! -s "$B/$1.err" ] && [ "$(count_lines "$B/runs/$1/summary.openpyxl.tsv")" = 2 ] && [ "$(field "$1" outcome)" = "$2" ] && [ "$(field "$1" exit)" = "$3" ] && [ "$(tail -n 1 "$B/$1.out")" = "${MSG_REMAIN}0" ]; }
    # ops_stdout <name>: the ops script's stdout in the run subdirectory.
    ops_stdout() { echo "$B/runs/$1/$2/stdout.openpyxl.txt"; }
    # class_then_last <file> <class>: two lines, the class name alone, then the last line.
    class_then_last() { [ "$(count_lines "$1")" = 2 ] && [ "$(head -n 1 "$1")" = "$2" ] && [ "$(tail -n 1 "$1" | count_matches -E "^openpyxl=[0-9][^$TAB]*${TAB}peak_rss_kb=[0-9]+\$" /dev/stdin)" = 1 ]; }
    # podman_count: the image's containers, all states; "error" when podman fails.
    podman_count() {
      podman ps -a --filter "ancestor=$IMAGE" --format '{{.Names}}' </dev/null >"$B/ps.out" 2>"$B/ps.err" || { echo error; return; }
      awk 'NF { n++ } END { print n + 0 }' "$B/ps.out"
    }
    
    echo
    echo "## C0: the control, an unplanted roundtrip over tier t"
    run_case C0 "$B/clone" t --op roundtrip
    row_line C0
    check "C0: one row, ok, exit 0, no container left" "$(yn ran_as C0 ok 0)"
    # Change PY4: ruling I keeps the loop's count line; the trap's follows it.
    files_then_count() { [ "$(count_lines "$B/$1.out")" -ge 2 ] && [ "$(tail -n 2 "$B/$1.out" | head -n 1 | count_matches -E '^files [0-9]+ ok [0-9]+ error [0-9]+ timeout [0-9]+ cap [0-9]+ no-output [0-9]+$' /dev/stdin)" = 1 ] && [ "$(tail -n 1 "$B/$1.out")" = "${MSG_REMAIN}0" ]; }
    check "C0: the loop's files line, then the trap's count line naming 0 containers, last (ruling I; change PY4)" "$(yn files_then_count C0)"
    echo "command: podman run --rm --network=none --userns=keep-id -v <tier t's workbook>:/in/x.xlsx:ro -v <scratch>/w/c0-direct:/out -v <scratch>/w/clone/scripts/openpyxl-ops.py:/ops.py:ro $IMAGE python3 -I -B /ops.py roundtrip /in/x.xlsx /out/x.xlsx"
    mkdir -p "$B/c0-direct" || exit 2
    podman run --rm --network=none --userns=keep-id -v "$FX/t/corpus/$T_ID.xlsx":/in/x.xlsx:ro -v "$B/c0-direct":/out -v "$OPSPY":/ops.py:ro "$IMAGE" \
      python3 -I -B /ops.py roundtrip /in/x.xlsx /out/x.xlsx </dev/null >"$B/C0d.out" 2>"$B/C0d.err"
    echo "$?" >"$B/C0d.rc"
    echo "  exit: $(rc_of C0d); standard output:"
    sed 's/^/    /' "$B/C0d.out"
    echo "  standard error bytes: $(wc -c <"$B/C0d.err")"
    c0d_ok() { [ "$(rc_of C0d)" = 0 ] && [ -f "$B/c0-direct/x.xlsx" ] && [ "$(count_lines "$B/C0d.out")" = 1 ] && [ ! -s "$B/C0d.err" ]; }
    check "C0: the ops script itself: exit 0, an output, the last line alone, nothing on stderr" "$(yn c0d_ok)"
    
    echo
    echo "## N1: an unknown op"
    echo "command: podman run --rm --network=none --userns=keep-id -v <scratch>/w/clone/scripts/openpyxl-ops.py:/ops.py:ro $IMAGE python3 -I -B /ops.py no-such-op /in/x.xlsx /out/x.xlsx"
    podman run --rm --network=none --userns=keep-id -v "$OPSPY":/ops.py:ro "$IMAGE" \
      python3 -I -B /ops.py no-such-op /in/x.xlsx /out/x.xlsx </dev/null >"$B/N1d.out" 2>"$B/N1d.err"
    echo "$?" >"$B/N1d.rc"
    echo "  exit: $(rc_of N1d); standard output:"
    sed 's/^/    /' "$B/N1d.out"
    echo "  standard error bytes: $(wc -c <"$B/N1d.err")"
    unknown_refused() { [ "$(rc_of "$1")" = 2 ] && [ "$(count_lines "$B/$1.out")" = 1 ] && [ "$(count_matches -xF "$MSG_UNKNOWN" "$B/$1.out")" = 1 ] && [ ! -s "$B/$1.err" ]; }
    check "N1: the ops script refuses the op: exit 2, the one line from its source, nothing on stderr" "$(yn unknown_refused N1d)"
    check "control: the same check refuses C0's direct run" "$(ynnot unknown_refused C0d)"
    run_case N1 "$B/clone" t --op no-such-op
    runner_refused() { [ "$(rc_of "$1")" = 2 ] && [ "$(count_lines "$B/$1.err")" = 1 ] && [ "$(count_matches -xF "error: $MSG_OP" "$B/$1.err")" = 1 ] && [ ! -s "$B/$1.out" ] && [ ! -e "$B/runs/$1" ]; }
    check "N1: the runner refuses the op: exit 2, its one error line from the source, nothing on stdout, no run directory" "$(yn runner_refused N1)"
    check "control: the same check refuses C0" "$(ynnot runner_refused C0)"
    
    echo
    echo "## N2: a planted exception prints its class and never its message"
    run_case N2 "$B/clone-n2" t --op roundtrip
    row_line N2
    check "N2: one row, error, exit 1, no container left" "$(yn ran_as N2 error 1)"
    N2_STDOUT=$(ops_stdout N2 "$T_ID")
    echo "  the ops script's stdout in the run subdirectory, $(count_lines "$N2_STDOUT") lines:"
    sed 's/^/    /' "$N2_STDOUT"
    check "N2: the ops script printed the class name ValueError alone, then the last line" "$(yn class_then_last "$N2_STDOUT" ValueError)"
    n2_files=$(cd "$B/runs/N2" && find . -type f | LC_ALL=C sort)
    echo "  the run directory's files: $(printf '%s\n' "$n2_files" | count_lines /dev/stdin)"
    n_mark_run=$(cd "$B/runs/N2" && find . -type f -exec cat {} + | count_matches -F "$MARKER" /dev/stdin)
    n_mark_cap=$(cat "$B/N2.out" "$B/N2.err" | count_matches -F "$MARKER" /dev/stdin)
    n_mark_plant=$(count_matches -F "$MARKER" "$B/clone-n2/scripts/openpyxl-ops.py")
    echo "  lines holding the marker: in the run directory's files $n_mark_run; in the runner's captured output $n_mark_cap; in the planted ops script $n_mark_plant"
    check "N2: the exception's message is in no file of the run directory and not in the runner's output" "$(yn [ "$n_mark_run$n_mark_cap" = 00 ])"
    check "control: the same count finds the marker in the planted script" "$(yn [ "$n_mark_plant" = 1 ])"
    check "control: the class check refuses C0's stdout" "$(ynnot class_then_last "$(ops_stdout C0 "$T_ID")" ValueError)"
    
    echo
    echo "## N3: a planted MemoryError ends as cap"
    run_case N3 "$B/clone-n3" t --op roundtrip
    row_line N3
    check "N3: one row, cap, exit 137, no container left" "$(yn ran_as N3 cap 137)"
    N3_STDOUT=$(ops_stdout N3 "$T_ID")
    echo "  the ops script's stdout in the run subdirectory:"
    sed 's/^/    /' "$N3_STDOUT"
    check "N3: the ops script printed MemoryError alone, then the last line" "$(yn class_then_last "$N3_STDOUT" MemoryError)"
    check "control: the outcome check refuses N2's row as cap" "$(ynnot ran_as N2 cap 137)"
    
    echo
    echo "## N4: a cap of 64 MiB ends tier a ($TIER_A_ROWS rows) as cap"
    run_case N4 "$B/clone" a --op roundtrip --memory 64
    row_line N4
    check "N4: tier a under --memory 64: one row, cap, exit 137, no container left" "$(yn ran_as N4 cap 137)"
    check "N4: the ops script printed MemoryError alone, then the last line" "$(yn class_then_last "$(ops_stdout N4 "$A_ID")" MemoryError)"
    run_case N4c "$B/clone" a --op roundtrip --memory 4096 --timeout 900
    row_line N4c
    check "N4c (the control): the same workbook under --memory 4096: ok, exit 0" "$(yn ran_as N4c ok 0)"
    check "control: the cap check refuses N4c's row" "$(ynnot ran_as N4c cap 137)"
    
    echo
    echo "## N5: a timeout of 1 s ends as timeout, and its container goes (ruling A)"
    echo "command: podman ps -a --filter ancestor=$IMAGE --format '{{.Names}}', counted"
    N5_BEFORE=$(podman_count)
    echo "  the image's containers before: $N5_BEFORE"
    run_case N5 "$B/clone" a --op roundtrip --timeout 1
    row_line N5
    N5_AFTER=$(podman_count)
    echo "  the image's containers after: $N5_AFTER"
    check "N5: tier a under --timeout 1: one row, timeout, exit 124, the runner's last line naming 0 containers" "$(yn ran_as N5 timeout 124)"
    check "N5: the row's signal is 9" "$(yn [ "$(field N5 signal)" = 9 ])"
    RM_EXIT=$(cat "$B/runs/N5/$A_ID/rm-exit.openpyxl.txt" 2>/dev/null)
    echo "  the removal's exit, from the run subdirectory: ${RM_EXIT:-none}; its output lines $(count_lines "$B/runs/N5/$A_ID/rm.openpyxl.txt")"
    check "N5: the runner removed the container by name, exit 0" "$(yn [ "$RM_EXIT" = 0 ])"
    check "N5: the image's containers were 0 before and are 0 after" "$(yn [ "$N5_BEFORE $N5_AFTER" = "0 0" ])"
    echo "command: podman run -d --name emend-openpyxl-negctl-<pid> --network=none $IMAGE sleep 300 (the control's own container)"
    CTL_NAME=emend-openpyxl-negctl-$$
    podman run -d --name "$CTL_NAME" --network=none "$IMAGE" sleep 300 </dev/null >"$B/N5c-run.out" 2>"$B/N5c-run.err"
    echo "  exit $?; standard error bytes $(wc -c <"$B/N5c-run.err")"
    N5C_DURING=$(podman_count)
    echo "command: podman rm -f --time 0 emend-openpyxl-negctl-<pid>"
    podman rm -f --time 0 "$CTL_NAME" </dev/null >"$B/N5c-rm.out" 2>"$B/N5c-rm.err"
    echo "  exit $?; standard error bytes $(wc -c <"$B/N5c-rm.err")"
    N5C_AFTER=$(podman_count)
    echo "  the image's containers with the control's running: $N5C_DURING; after its removal: $N5C_AFTER"
    check "N5c (the control): the same count reads 1 while this script's own container runs and 0 after" "$(yn [ "$N5C_DURING $N5C_AFTER" = "1 0" ])"
    check "control: the timeout check refuses N4's row" "$(ynnot ran_as N4 timeout 124)"
    
    echo
    echo "## N6: a run prints no path; a planted path stays in the run directory"
    run_case N6 "$B/clone-n6" t --op roundtrip
    row_line N6
    check "N6: one row, ok, exit 0, no container left" "$(yn ran_as N6 ok 0)"
    N6_ERR=$B/runs/N6/$T_ID/stderr.openpyxl.txt
    n_path_err=$(count_matches -E "$PATH_RE" "$N6_ERR")
    n_path_cap=$(cat "$B/N6.out" "$B/N6.err" | count_matches -E "$PATH_RE" /dev/stdin)
    n_path_tables=$(cat "$B/runs/N6/summary.openpyxl.tsv" "$B/runs/N6/entries.openpyxl.tsv" "$B/runs/N6/run.openpyxl.tsv" | count_matches -E "$PATH_RE" /dev/stdin)
    echo "  the path form (header change PX6): lines in the run subdirectory's stderr.openpyxl.txt $n_path_err (its bytes $(wc -c <"$N6_ERR")); in the runner's captured output $n_path_cap; in the run directory's three tables $n_path_tables"
    check "N6: the runner printed no path, and the tables hold none" "$(yn [ "$n_path_cap$n_path_tables" = 00 ])"
    check "control: the planted path is in the run subdirectory's stderr file, where the runner leaves it" "$(yn [ "$n_path_err" = 1 ])"
    printf 'x %s%s%s y\n' '/ho' 'me/someone/' 'emend-''testing/corpus/x.xlsx' >"$B/path-plant"
    printf 'x clean y\n' >"$B/path-clean"
    check "control: the path form counts a planted path 1 and a clean line 0" "$(yn [ "$(count_matches -E "$PATH_RE" "$B/path-plant") $(count_matches -E "$PATH_RE" "$B/path-clean")" = "1 0" ])"
    
    echo
    echo "## N7: a die inside the loop still prints the trap's count line (ruling I; change PY4)"
    echo "command: mkdir <scratch>/w/runs/N7; head -n 1 <scratch>/w/runs/C0/summary.openpyxl.tsv > <scratch>/w/runs/N7/summary.openpyxl.tsv; chmod 444 it (the runner's own header, made read-only)"
    mkdir -p "$B/runs/N7" || exit 2
    head -n 1 "$B/runs/C0/summary.openpyxl.tsv" >"$B/runs/N7/summary.openpyxl.tsv" || exit 2
    chmod 444 "$B/runs/N7/summary.openpyxl.tsv" || exit 2
    n7_ready() { [ "$(count_lines "$B/runs/N7/summary.openpyxl.tsv")" = 1 ] && [ ! -w "$B/runs/N7/summary.openpyxl.tsv" ]; }
    check "N7: the summary holds the runner's header alone and is not writable" "$(yn n7_ready)"
    N7_BEFORE=$(podman_count)
    echo "  the image's containers before: $N7_BEFORE"
    run_case N7 "$B/clone" t --op roundtrip
    N7_AFTER=$(podman_count)
    echo "  the image's containers after: $N7_AFTER"
    # died_counted <name>: exit 2, the one error line the source holds for the
    # append, and standard output the trap's count line alone, naming 0.
    died_counted() { [ "$(rc_of "$1")" = 2 ] && [ "$(count_lines "$B/$1.err")" = 1 ] && [ "$(count_matches -xF "error: $MSG_APPEND" "$B/$1.err")" = 1 ] && [ "$(count_lines "$B/$1.out")" = 1 ] && [ "$(tail -n 1 "$B/$1.out")" = "${MSG_REMAIN}0" ]; }
    check "N7: the runner died inside the loop with its append message, exit 2, and printed the trap's count line naming 0 containers" "$(yn died_counted N7)"
    # The runner writes run.openpyxl.tsv's header before the loop and its row
    # after it, so a die in the loop leaves the header alone.
    n7_no_row() { [ "$(count_lines "$B/runs/N7/summary.openpyxl.tsv")" = 1 ] && [ "$(count_lines "$B/runs/N7/run.openpyxl.tsv")" = 1 ]; }
    echo "  the summary's lines after the run: $(count_lines "$B/runs/N7/summary.openpyxl.tsv"); run.openpyxl.tsv lines: $(count_lines "$B/runs/N7/run.openpyxl.tsv")"
    check "N7: no summary row and no run row were written" "$(yn n7_no_row)"
    check "N7: the image's containers were 0 before and are 0 after" "$(yn [ "$N7_BEFORE $N7_AFTER" = "0 0" ])"
    echo "command: the control's captures: N7's exit and standard error, its standard output with the count line taken out"
    cp "$B/N7.rc" "$B/N7x.rc" && cp "$B/N7.err" "$B/N7x.err" && LC_ALL=C "$G" -v -F "$MSG_REMAIN" "$B/N7.out" >"$B/N7x.out"
    echo "  the control's standard output lines: $(count_lines "$B/N7x.out")"
    check "control: the same check refuses the run's captures with the count line taken out" "$(ynnot died_counted N7x)"
    check "control: the same check refuses C0, which did not die" "$(ynnot died_counted C0)"
    
    echo
    echo "## N8: a planted slow conversion: the open check's container is named and removed (ruling A, engineering-close item 7; change PZ4)"
    LO_IMG=localhost/emend-lo:25.2.3-2-deb13u6
    echo "command: podman image exists $LO_IMG; podman image inspect --format '{{.Id}}' $LO_IMG"
    podman image exists "$LO_IMG" </dev/null >/dev/null 2>"$B/lo-image.err"
    rc_lo_img=$?
    LO_IMAGE_ID=$(podman image inspect --format '{{.Id}}' "$LO_IMG" </dev/null 2>>"$B/lo-image.err")
    echo "  exists exit $rc_lo_img; the image id: ${LO_IMAGE_ID:-none}; standard error bytes $(wc -c <"$B/lo-image.err")"
    lo_image_ok() { [ "$rc_lo_img" = 0 ] && printf '%s' "$LO_IMAGE_ID" | LC_ALL=C "$G" -qE '^[0-9a-f]{64}$'; }
    check "N8: the LibreOffice image is there, its id read" "$(yn lo_image_ok)"
    # lo_count: the LibreOffice image's containers, all states; "error" when podman fails.
    lo_count() {
      podman ps -a --filter "ancestor=$LO_IMG" --format '{{.Names}}' </dev/null >"$B/lops.out" 2>"$B/lops.err" || { echo error; return; }
      awk 'NF { n++ } END { print n + 0 }' "$B/lops.out"
    }
    LOCHK_SH=$B/clone/scripts/lo-check.sh
    MSG_LO_RAW=$(LC_ALL=C "$G" -o -E "printf 'the conversion timed out after %s s" "$LOCHK_SH" | sed -e "s/^printf '//")
    MSG_LO=${MSG_LO_RAW/\%s/1}
    echo "command: grep -o -E \"printf 'the conversion timed out after %s s\" <scratch>/w/clone/scripts/lo-check.sh, its %s filled with N8's LO_TIMEOUT, 1"
    echo "  the open check's timeout reason: $MSG_LO"
    lo_msg_ok() { one_line_msg "$MSG_LO" && [ "$MSG_LO" != "$MSG_LO_RAW" ]; }
    check "N8: the timeout reason is found once in lo-check.sh, its %s filled" "$(yn lo_msg_ok)"
    mkdir -p "$B/lo/in" || exit 2
    cp "$B/clone/tests/fixtures/openpyxl-ops.xlsx" "$B/lo/in/x.xlsx" || exit 2
    fx_have=$(sha256sum <"$B/lo/in/x.xlsx" | cut -d' ' -f1)
    fx_want=$(git show "$C:tests/fixtures/openpyxl-ops.xlsx" | sha256sum | cut -d' ' -f1)
    echo "command: cp <scratch>/w/clone/tests/fixtures/openpyxl-ops.xlsx <scratch>/w/lo/in/x.xlsx (the committed fictional fixture); sha256 $fx_have; the phase commit's blob $fx_want"
    check "N8: the fixture copy is the phase commit's blob" "$(yn [ "$fx_have" = "$fx_want" ])"
    # lo_case <name> <seconds>: the clone's lo_check on the fixture in a
    # subshell, LO_IMAGE the LibreOffice image and LO_TIMEOUT the seconds, its
    # work directory <scratch>/w/lo/<name>, its reason <scratch>/w/lo/<name>-reason.txt;
    # its return in <name>.rc, its output in <name>.out and .err.
    lo_case() {
      local name=$1 secs=$2
      echo "### $name"
      echo "command: ( . <scratch>/w/clone/scripts/lo-check.sh; LO_IMAGE=$LO_IMG; LO_TIMEOUT=$secs; lo_check <scratch>/w/lo/in/x.xlsx <scratch>/w/lo/$name <scratch>/w/lo/$name-reason.txt <scratch>/w/lo/in/x.xlsx )"
      ( . "$LOCHK_SH"; LO_IMAGE=$LO_IMG; LO_TIMEOUT=$secs; lo_check "$B/lo/in/x.xlsx" "$B/lo/$name" "$B/lo/$name-reason.txt" "$B/lo/in/x.xlsx"; echo "$?" >"$B/$name.rc" ) </dev/null >"$B/$name.out" 2>"$B/$name.err"
      echo "  return: $(rc_of "$name"); standard output bytes $(wc -c <"$B/$name.out"); standard error bytes $(wc -c <"$B/$name.err")"
      echo "  the reason file: $(cat "$B/lo/$name-reason.txt" 2>/dev/null || echo none)"
      echo "  rm-exit.txt: $(cat "$B/lo/$name/rm-exit.txt" 2>/dev/null || echo none); rm.txt: $(cat "$B/lo/$name/rm.txt" 2>/dev/null || echo none)"
    }
    echo "command: podman ps -a --filter ancestor=$LO_IMG --format '{{.Names}}', counted"
    N8_BEFORE=$(lo_count)
    echo "  the LibreOffice image's containers before: $N8_BEFORE"
    lo_case N8 1
    N8_AFTER=$(lo_count)
    echo "  the LibreOffice image's containers after: $N8_AFTER"
    # timed_out_removed <name>: lo_check returned 2 and printed nothing; its
    # reason is the timeout line; the removal exited 0 and printed the one name
    # emend-lo-<this script's pid>-<a pid>-1.
    timed_out_removed() { [ "$(rc_of "$1")" = 2 ] && [ ! -s "$B/$1.out" ] && [ ! -s "$B/$1.err" ] && [ "$(cat "$B/lo/$1-reason.txt" 2>/dev/null)" = "$MSG_LO" ] && [ "$(cat "$B/lo/$1/rm-exit.txt" 2>/dev/null)" = 0 ] && [ "$(count_lines "$B/lo/$1/rm.txt")" = 1 ] && [ "$(count_matches -xE "emend-lo-$$-[0-9]+-1" "$B/lo/$1/rm.txt")" = 1 ]; }
    check "N8: under LO_TIMEOUT=1 lo_check returned 2 with the timeout reason, and removed its container by name, exit 0 (ruling A)" "$(yn timed_out_removed N8)"
    check "N8: the LibreOffice image's containers were 0 before and are 0 after" "$(yn [ "$N8_BEFORE $N8_AFTER" = "0 0" ])"
    lo_case N8c 600
    # converted_no_rm <name>: lo_check returned 0, printed nothing, and wrote no removal files.
    converted_no_rm() { [ "$(rc_of "$1")" = 0 ] && [ ! -s "$B/$1.out" ] && [ ! -s "$B/$1.err" ] && [ ! -e "$B/lo/$1/rm.txt" ] && [ ! -e "$B/lo/$1/rm-exit.txt" ]; }
    check "N8c (the control): under LO_TIMEOUT=600 the same conversion returns 0 with no rm.txt and no rm-exit.txt" "$(yn converted_no_rm N8c)"
    check "control: the N8 check refuses N8c" "$(ynnot timed_out_removed N8c)"
    check "control: the N8c check refuses N8" "$(ynnot converted_no_rm N8)"
    N8C_AFTER=$(lo_count)
    echo "  the LibreOffice image's containers after N8c: $N8C_AFTER"
    check "N8c: no container of the LibreOffice image is left" "$(yn [ "$N8C_AFTER" = 0 ])"
    echo "command: podman create --name emend-lo-negctl-<pid> --network=none $LO_IMG (the control's own container, created and never started)"
    LO_CTL=emend-lo-negctl-$$
    podman create --name "$LO_CTL" --network=none "$LO_IMG" </dev/null >"$B/N8k-create.out" 2>"$B/N8k-create.err"
    echo "  exit $?; standard error bytes $(wc -c <"$B/N8k-create.err")"
    N8K_DURING=$(lo_count)
    echo "command: podman rm -f --time 0 emend-lo-negctl-<pid>"
    podman rm -f --time 0 "$LO_CTL" </dev/null >"$B/N8k-rm.out" 2>"$B/N8k-rm.err"
    echo "  exit $?; standard error bytes $(wc -c <"$B/N8k-rm.err")"
    N8K_AFTER=$(lo_count)
    echo "  the LibreOffice image's containers with the control's created: $N8K_DURING; after its removal: $N8K_AFTER"
    check "N8k (the control): the same count reads 1 while this script's own container exists and 0 after" "$(yn [ "$N8K_DURING $N8K_AFTER" = "1 0" ])"
    
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.out "$B"/*.err; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or planning's spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's logs or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/negative.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
  control count_matches with a regular expression: 2 (expect 2)
  control count_matches on an unreadable file: error (expect error)
  control count_matches on readable plus unreadable: error (expect error)
  control count_from_file on the same file: 2 (expect 2)
  control count_from_file on a file with none: 0 (expect 0)
  control count_from_file on an unreadable file: error (expect error)
  control count_bytes, control bytes in a file with ESC, ESC and SI: 3 (expect 3)
  control count_bytes, non-ASCII bytes in a file with one two-byte character: 2 (expect 2)
  control count_bytes on a clean file: 0 (expect 0)
  control count_bytes on an unreadable file: error (expect error)
  control count_lines on a three-line file: 3 (expect 3)
  control count_lines on an unreadable file: error (expect error)
  control count_matches_i on mixed case: 2 (expect 2)
  control count_matches on the same file, case sensitive: 1 (expect 1)
  control count_matches_i on an unreadable file: error (expect error)
  control run_lines on a command printing three lines: 3 (expect 3)
  control run_lines on a command printing nothing: 0 (expect 0)
  control run_lines on a FAILING command: error (expect error)
  control run_lines on a command that cannot run: error (expect error)
  control run_matches on a command printing one match: 1 (expect 1)
  control run_matches on a FAILING command: error (expect error)
  counting controls: all as expected

