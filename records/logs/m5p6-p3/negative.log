    #!/usr/bin/env bash
    # emend openpyxl comparison runner (specs/0037-measurement-and-close.md, "The
    # comparison runner", and "Planning rulings during P1", A to E), modelled on
    # scripts/passthrough-run.sh and sharing scripts/lo-check.sh.
    # For every manifest row, or every id listed with --ids, in manifest order:
    # run scripts/openpyxl-ops.py <op> in the openpyxl image on that one workbook,
    # mounted read-only, under a timeout and an address space limit, classify the
    # outcome, compare input and output with xlsx-diff on the host, and append to
    # summary.openpyxl.tsv and entries.openpyxl.tsv in the run directory, in the
    # runner's columns. Each invocation also appends one row to run.openpyxl.tsv
    # (commit, times, the image id, the openpyxl version, the settings, the op).
    # It prints one line per file (id, outcome, exit, wall seconds, peak RSS in
    # kB) and a final count line. It never prints an original name, a path under
    # the corpus directory or a byte of content: openpyxl's own output, warnings
    # included, stays in the run directory. Errors print one "error: " line
    # without a path and exit 2: once the arguments are checked, the script's own
    # stderr goes to /dev/null, and the error line goes to the saved descriptor.
    #
    # The container: named emend-openpyxl-<this script's pid>-<id>, run with
    # --network=none --userns=keep-id, the input at /in/<id>.<ext> read-only, the
    # run subdirectory's out.openpyxl/ at /out and the ops script at /ops.py
    # read-only, the command sh -c 'ulimit -v <MiB*1024> && exec python3 -I -B
    # /ops.py <op> /in/<id>.<ext> /out/<id>.<ext>' under timeout --signal=KILL.
    # The output keeps the input's extension (ruling D). A timeout kills the
    # podman client and not the container, so after exit 124 the runner removes
    # the container by name with podman rm -f --time 0 (no grace period), its
    # output and exit kept in the run subdirectory; at the end it counts the
    # image's containers and fails if any remain (ruling A). The count runs in
    # an EXIT trap, so it is printed whatever ends the script once the work
    # directory exists, a die inside the loop included (specs/0037 "Planning
    # verification of P1", ruling I).
    #
    # Outcomes (ruling B): ok, exit 0 with an output file; no-output, exit 0
    # without one; timeout, exit 124; cap, exit 137 (the ops script's MemoryError);
    # error, exit 1 and every other exit, the exit in the exit column. Wall time is
    # the runner's, around the container; peak RSS is the ops script's last line.
    # lo_in is "-": the input's verdict is the emend run's (ruling C).
    set -uo pipefail
    umask 077
    
    readonly USAGE="usage: scripts/compare-run.sh --op <op> --image <image> --xlsx-diff <path> [--corpus <dir>] [--out <dir>] [--timeout <secs>] [--memory <MiB>] [--ids <file>] [--libreoffice <image>] [--lo-timeout <secs>]"
    readonly LABEL=openpyxl
    readonly OPS_LIST=" roundtrip read edit format insert-rows names table comment image add-chart copy "
    readonly MANIFEST_HEADER=$'id\tsha256\tbytes\text\tproducer\tproducer_version\tapp\tsource\ttags\tadded\toriginal_name\tnote'
    readonly SUMMARY_HEADER=$'id\tlabel\tproducer\ttags\toutcome\texit\tsignal\twall_s\tpeak_rss_kb\tin_bytes\tout_bytes\tdiff_exit\tidentical\trecompressed\tchanged\tdropped\tadded\tflagged\torder_preserved\tcomment_equal\tfiles_identical\tleftover\tlo\tlo_in'
    readonly ENTRIES_HEADER=$'id\tlabel\trow\tname\tstatus\tindex_in\tindex_out\tmethod_in\tmethod_out\tuncompressed_in\tuncompressed_out\tcompressed_in\tcompressed_out\tcrc_in\tcrc_out\tfirst_difference\tdiffering_bytes\tlast_difference\tflags'
    readonly RUN_HEADER=$'commit\tstarted\tended\timage_id\topenpyxl\ttimeout_s\tlo_timeout_s\tmemory_mib\tops_sha256\txlsx_diff_sha256\tfiles\top'
    DIE_FD=2
    die() {
      echo "error: $1" >&"$DIE_FD"
      exit 2
    }
    
    . "$(dirname -- "${BASH_SOURCE[0]}")/lo-check.sh" || die "cannot source scripts/lo-check.sh"
    
    OP="" IMAGE="" XD="" CORPUS="" OUT="" TIMEOUT=300 MEMORY=2048 IDS="" LO_IMAGE="" LO_TIMEOUT=600
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --op | --image | --xlsx-diff | --corpus | --out | --timeout | --memory | --ids | --libreoffice | --lo-timeout)
          [ "$#" -ge 2 ] || die "$1 needs a value; $USAGE"
          case "$1" in
            --op) OP=$2 ;;
            --image) IMAGE=$2 ;;
            --xlsx-diff) XD=$2 ;;
            --corpus) CORPUS=$2 ;;
            --out) OUT=$2 ;;
            --timeout) TIMEOUT=$2 ;;
            --memory) MEMORY=$2 ;;
            --ids) IDS=$2 ;;
            --libreoffice) LO_IMAGE=$2 ;;
            --lo-timeout) LO_TIMEOUT=$2 ;;
          esac
          shift 2
          ;;
        *) die "unknown argument; $USAGE" ;;
      esac
    done
    
    [ -n "$OP" ] && [[ "$OPS_LIST" == *" $OP "* ]] || die "--op must name one of the eleven ops; $USAGE"
    [[ "$IMAGE" =~ ^[A-Za-z0-9][A-Za-z0-9._:/@-]*$ ]] || die "--image must name an image"
    [ -n "$XD" ] && [ -f "$XD" ] && [ -x "$XD" ] || die "--xlsx-diff must name an executable file"
    [[ "$TIMEOUT" =~ ^[1-9][0-9]*$ ]] || die "--timeout must be a positive whole number of seconds"
    [[ "$MEMORY" =~ ^[1-9][0-9]*$ ]] || die "--memory must be a positive whole number of MiB"
    [[ "$LO_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || die "--lo-timeout must be a positive whole number of seconds"
    command -v podman >/dev/null 2>&1 || die "the runner needs podman"
    podman image exists "$IMAGE" >/dev/null 2>&1 || die "--image is not an image podman holds"
    if [ -n "$LO_IMAGE" ]; then
      [[ "$LO_IMAGE" =~ ^[A-Za-z0-9][A-Za-z0-9._:/@-]*$ ]] || die "--libreoffice must name an image"
      command -v python3 >/dev/null 2>&1 || die "--libreoffice needs python3 to count sheets and tables"
    fi
    
    exec 3>&2 2>/dev/null
    DIE_FD=3
    
    ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd) || die "cannot find the repository"
    readonly OPS_SCRIPT=$ROOT/scripts/openpyxl-ops.py
    [ -f "$OPS_SCRIPT" ] || die "cannot find scripts/openpyxl-ops.py"
    if [ -z "$CORPUS" ]; then
      CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    fi
    [ -d "$CORPUS" ] || die "the corpus directory does not exist"
    readonly MANIFEST=$CORPUS/manifest.tsv
    [ -f "$MANIFEST" ] || die "the corpus has no manifest.tsv"
    [ "$(head -n 1 "$MANIFEST")" = "$MANIFEST_HEADER" ] || die "the manifest header is not the one specs/0005-corpus.md defines"
    
    COMMIT=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null) || die "cannot read the repository commit"
    SHORT=$(git -C "$ROOT" rev-parse --short HEAD)
    if [ -z "$OUT" ]; then
      OUT=$CORPUS/runs/$(date -u +%Y-%m-%d)-$SHORT-openpyxl-$OP
    fi
    mkdir -p "$OUT" || die "cannot create the run directory"
    
    WORK=$(mktemp -d) || die "cannot create a temporary directory"
    
    # finish: on every exit from here on, count the image's containers, print the
    # count line, fail if any remain or the count cannot be made, and remove the
    # work directory (ruling I). A non-zero status already on its way out is kept.
    finish() {
      local rc=$? remaining=""
      if podman ps -a --filter "ancestor=$IMAGE" --format '{{.Names}}' </dev/null >"$WORK/containers" 3>&-; then
        remaining=$(awk 'NF { n++ } END { print n + 0 }' "$WORK/containers")
      fi
      if [ -z "$remaining" ]; then
        echo "error: cannot count the image's containers" >&"$DIE_FD"
        rc=2
      else
        echo "containers of the image remaining: $remaining"
        if [ "$remaining" != 0 ]; then
          echo "error: containers of the image remain after the run: $remaining" >&"$DIE_FD"
          rc=2
        fi
      fi
      rm -rf "${WORK:?}"
      exit "$rc"
    }
    trap finish EXIT
    
    # The manifest's id, ext, producer and tags columns, in manifest order. The
    # private columns are never read into the script.
    if ! awk -F'\t' -v OFS='\t' '
      NR == 1 { next }
      NF != 12 { print "bad", NR; exit 3 }
      $1 !~ /^[0-9a-f]{12}$/ || $4 !~ /^(xlsx|xlsm|xltx|xltm)$/ || $5 !~ /^[a-z-]+$/ || $9 !~ /^[a-z0-9,]+$/ { print "bad", NR; exit 3 }
      seen[$1]++ { print "duplicate", $1; exit 3 }
      { print $1, $4, $5, $9 }
    ' "$MANIFEST" >"$WORK/rows"; then
      die "manifest row $(awk '{ print $2 }' "$WORK/rows" | tail -n 1) is not valid (id, ext, producer, tags or column count)"
    fi
    
    if [ -n "$IDS" ]; then
      [ -f "$IDS" ] || die "--ids must name a file"
      : >"$WORK/wanted" || die "cannot write a scratch file"
      while IFS= read -r line || [ -n "$line" ]; do
        id=${line//[[:space:]]/}
        [ -z "$id" ] && continue
        [[ "$id" =~ ^[0-9a-f]{12}$ ]] || die "an entry in the --ids file is not a 12-digit id"
        awk -F'\t' -v id="$id" '$1 == id { found = 1 } END { exit !found }' "$WORK/rows" ||
          die "id $id is not in the manifest"
        printf '%s\n' "$id" >>"$WORK/wanted" || die "cannot write a scratch file"
      done <"$IDS" || die "cannot read the --ids file"
      awk -F'\t' 'NR == FNR { want[$1] = 1; next } want[$1]' "$WORK/wanted" "$WORK/rows" >"$WORK/selected" ||
        die "cannot write a scratch file"
    else
      cp "$WORK/rows" "$WORK/selected" || die "cannot write a scratch file"
    fi
    
    # header_ok <file> <header> <name>: the file is absent (the header is written)
    # or starts with that header; anything else is an error.
    header_ok() {
      if [ -e "$1" ]; then
        [ "$(head -n 1 "$1")" = "$2" ] || die "$3 in the run directory has another header"
      else
        printf '%s\n' "$2" >"$1" || die "cannot write the header of $3"
      fi
    }
    SUMMARY=$OUT/summary.$LABEL.tsv
    ENTRIES=$OUT/entries.$LABEL.tsv
    RUNS=$OUT/run.$LABEL.tsv
    header_ok "$SUMMARY" "$SUMMARY_HEADER" "summary.$LABEL.tsv"
    header_ok "$ENTRIES" "$ENTRIES_HEADER" "entries.$LABEL.tsv"
    header_ok "$RUNS" "$RUN_HEADER" "run.$LABEL.tsv"
    
    # An id already in the summary would give it a second row; a run directory
    # holding an earlier run's conversion or output directories is refused, as the
    # passthrough runner refuses its own (specs/0030 decision 1 A).
    dup=$(awk -F'\t' 'FILENAME == ARGV[1] { if (FNR > 1) have[$1] = 1; next } ($1 in have) { print $1; exit }' \
      "$SUMMARY" "$WORK/selected") || die "cannot read summary.$LABEL.tsv"
    [ -z "$dup" ] || die "id $dup already has a row in summary.$LABEL.tsv; use a new run directory"
    earlier=$(find "$OUT" -mindepth 2 -maxdepth 2 \( -name "lo.$LABEL" -o -name "out.$LABEL" \) -print -quit) ||
      die "cannot read the run directory"
    [ -z "$earlier" ] || die "the run directory holds an earlier run; name a fresh one"
    
    STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    IMAGE_ID=$(podman image inspect --format '{{.Id}}' "$IMAGE" </dev/null) || die "cannot read the image id"
    VERSION=$(podman run --rm --network=none --userns=keep-id "$IMAGE" \
      python3 -I -B -c 'import openpyxl; print(openpyxl.__version__)' </dev/null) || die "cannot read the openpyxl version"
    [[ "$VERSION" =~ ^[0-9A-Za-z.+-]+$ ]] || die "the openpyxl version is not a version"
    OPS_SHA=$(sha256sum <"$OPS_SCRIPT" | cut -d' ' -f1) || die "cannot hash the ops script"
    XD_SHA=$(sha256sum <"$XD" | cut -d' ' -f1) || die "cannot hash the xlsx-diff binary"
    
    # now_ns: the time in nanoseconds since the epoch.
    now_ns() {
      date +%s%N
    }
    
    n_files=0 n_ok=0 n_error=0 n_timeout=0 n_cap=0 n_nooutput=0
    while IFS=$'\t' read -r id ext producer tags; do
      n_files=$((n_files + 1))
      dir=$OUT/$id
      outdir=$dir/out.$LABEL
      mkdir -p "$dir" "$outdir" || die "cannot create a run subdirectory"
      input=$CORPUS/corpus/$id.$ext
      output=$outdir/$id.$ext
      name=emend-openpyxl-$$-$id
      in_bytes=$(stat -c %s -- "$input" 2>/dev/null) || in_bytes=""
    
      t0=$(now_ns)
      timeout --signal=KILL "$TIMEOUT" podman run --rm --name "$name" --network=none --userns=keep-id \
        -v "$input":"/in/$id.$ext":ro -v "$outdir":/out -v "$OPS_SCRIPT":/ops.py:ro "$IMAGE" \
        sh -c 'ulimit -v "$1" && exec python3 -I -B /ops.py "$2" "$3" "$4"' sh \
        "$((MEMORY * 1024))" "$OP" "/in/$id.$ext" "/out/$id.$ext" \
        </dev/null >"$dir/stdout.$LABEL.txt" 2>"$dir/stderr.$LABEL.txt" 3>&-
      rc=$?
      t1=$(now_ns)
      wall=$(awk -v a="$t0" -v b="$t1" 'BEGIN { printf "%.2f", (b - a) / 1e9 }')
    
      signal=""
      if [ "$rc" -eq 124 ]; then
        # The kill ended the podman client; the container is removed by name.
        signal=9
        podman rm -f --time 0 "$name" </dev/null >"$dir/rm.$LABEL.txt" 2>&1 3>&-
        echo "$?" >"$dir/rm-exit.$LABEL.txt" || die "cannot write the removal's exit"
      fi
    
      case "$rc" in
        0)
          if [ -f "$output" ]; then outcome=ok; else outcome=no-output; fi
          ;;
        124) outcome=timeout ;;
        137) outcome=cap ;;
        *) outcome=error ;;
      esac
    
      # The ops script's last line, when it wrote one.
      rss=$(tail -n 1 "$dir/stdout.$LABEL.txt" 2>/dev/null | sed -n 's/^openpyxl=[^\t]*\tpeak_rss_kb=\([0-9][0-9]*\)$/\1/p')
    
      # Anything in the output directory beside the output is a leftover.
      leftover=no
      held=$(find "$outdir" -mindepth 1 ! -path "$output" -print -quit) || die "cannot read the output directory"
      [ -n "$held" ] && leftover=yes
    
      out_bytes="" diff_exit="" values=$'\t\t\t\t\t\t\t\t'
      if [ "$outcome" = ok ]; then
        out_bytes=$(stat -c %s -- "$output" 2>/dev/null) || out_bytes=""
        "$XD" "$input" "$output" </dev/null >"$dir/diff.$LABEL.tsv" 2>"$dir/diff-stderr.$LABEL.txt" 3>&-
        diff_exit=$?
        if [ "$diff_exit" -eq 0 ] || [ "$diff_exit" -eq 1 ]; then
          values=$(awk -F'\t' -v OFS='\t' '
            $1 == "archive" { v[$2] = $3 }
            END { print v["identical"], v["recompressed"], v["changed"], v["dropped"], v["added"], v["flagged"], v["order_preserved"], v["comment_equal"], v["files_identical"] }
          ' "$dir/diff.$LABEL.tsv") || die "cannot read the diff rows"
          awk -F'\t' -v OFS='\t' -v id="$id" -v label="$LABEL" '$1 == "entry" { print id, label, $0 }' \
            "$dir/diff.$LABEL.tsv" >>"$ENTRIES" || die "cannot append to entries.$LABEL.tsv"
        fi
      fi
    
      lo=- lo_in=-
      if [ -n "$LO_IMAGE" ] && [ "$outcome" = ok ]; then
        lo_check "$output" "$dir/lo.$LABEL" "$dir/lo-reason.$LABEL.txt" "$output"
        case $? in
          0) lo=ok ;;
          1) lo=fail ;;
          *) lo=error ;;
        esac
      fi
    
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$LABEL" "$producer" "$tags" \
        "$outcome" "$rc" "$signal" "$wall" "$rss" "$in_bytes" "$out_bytes" "$diff_exit" "$values" "$leftover" \
        "$lo" "$lo_in" >>"$SUMMARY" ||
        die "cannot append to summary.$LABEL.tsv"
      printf '%s %s %s %s %s\n' "$id" "$outcome" "$rc" "$wall" "${rss:--}"
      case "$outcome" in
        ok) n_ok=$((n_ok + 1)) ;;
        error) n_error=$((n_error + 1)) ;;
        timeout) n_timeout=$((n_timeout + 1)) ;;
        cap) n_cap=$((n_cap + 1)) ;;
        no-output) n_nooutput=$((n_nooutput + 1)) ;;
      esac
    done <"$WORK/selected"
    
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$COMMIT" "$STARTED" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      "$IMAGE_ID" "$VERSION" "$TIMEOUT" "$LO_TIMEOUT" "$MEMORY" "$OPS_SHA" "$XD_SHA" "$n_files" "$OP" >>"$RUNS" ||
      die "cannot append to run.$LABEL.tsv"
    echo "files $n_files ok $n_ok error $n_error timeout $n_timeout cap $n_cap no-output $n_nooutput"
    
    # No container of the image may outlive the run (ruling A): the EXIT trap,
    # finish, counts them and prints the line (ruling I).
command: cat <scratch>/w/clone/scripts/openpyxl-ops.py (the script under test)
    #!/usr/bin/env python3
    """The openpyxl side of the comparison (specs/0037-measurement-and-close.md,
    "The operations").
    
    usage: python3 -I -B openpyxl-ops.py <op> <in> <out>
    
    Runs inside the openpyxl image (tools/openpyxl-image/Containerfile), started
    by scripts/compare-run.sh. Each op loads <in> with openpyxl's ordinary
    load_workbook (never read_only or write_only), makes the one request that
    matches an emend-copy sample, and saves to <out>. W is the first worksheet of
    kind Worksheet (wb.worksheets[0]) and M its last used row (ws.max_row); every
    addition goes below M, as the emend samples place theirs.
    
    The ops and every constant they write:
    
      roundtrip    load; save. (emend: emend-copy <in> <out>)
      read         load; every cell of every worksheet visited by iter_rows and
                   counted, the count printed as "cells=<n>"; save, since openpyxl
                   has no other output to hand the harness. (--read-sample)
      edit         EDIT_NUMBER 42.5 in (M+1, A), EDIT_TEXT "emend compare" in
                   (M+1, B), EDIT_BOOLEAN True in (M+1, C). (--edit-sample)
      format       FORMAT_NUMBER 1234.5 in (M+1, A), its number_format FORMAT_CODE
                   "#,##0.00". (--format-sample)
      insert-rows  insert_rows(INSERT_AT 1, INSERT_COUNT 1) on W.
                   (--insert-rows-sample)
      names        one defined name NAME "emend_compare" over W's $A$1.
                   (--names-sample)
      table        TABLE_HEADERS "Item" and "Value" in (M+2, A) and (M+2, B),
                   TABLE_ROW "first" and 1 in (M+3, A) and (M+3, B), a Table
                   TABLE_NAME "EmendCompare" over A(M+2):B(M+3). (--table-sample)
      comment      a Comment COMMENT_TEXT "emend compare" by COMMENT_AUTHOR
                   "emend" on (M+1, A). (--comment-sample)
      image        PNG, a 2 by 2 PNG held below as 73 bytes, added at (M+2, A).
                   (--image-sample)
      add-chart    a BarChart, one series over B2:B(M+1), categories A2:A(M+1),
                   added at (M+2, A). (--add-chart-sample)
      copy         copy_worksheet(W). (--copy-sample)
    
    What it prints, on standard output: for read, the line "cells=<n>"; for an
    exception, one line holding the exception's class name only, never its
    message, which may quote workbook content; and last, whatever happened after
    the op began, the line "openpyxl=<version>\\tpeak_rss_kb=<ru_maxrss>" from
    resource.getrusage(RUSAGE_SELF). Nothing it prints names a path or a cell
    value.
    
    Exits: 0 when the op saved its output; 1 on an exception (its class printed);
    137 on MemoryError, so the runner classes it as the cap, a MemoryError raised
    while the script reports another exception included (specs/0037, ruling Y:
    that path writes its two lines with bytes made before the op, by os.write,
    and leaves by os._exit, so it needs no new memory to end); 2, with the one line
    "unknown op" and nothing else, for an op it does not know or a wrong number of
    arguments. openpyxl's own warnings go to standard error, which the runner
    keeps in the run directory and never prints.
    """
    import os
    import resource
    import sys
    
    OPS = ("roundtrip", "read", "edit", "format", "insert-rows", "names", "table",
           "comment", "image", "add-chart", "copy")
    
    EDIT_NUMBER = 42.5
    EDIT_TEXT = "emend compare"
    EDIT_BOOLEAN = True
    FORMAT_NUMBER = 1234.5
    FORMAT_CODE = "#,##0.00"
    INSERT_AT = 1
    INSERT_COUNT = 1
    NAME = "emend_compare"
    TABLE_HEADERS = ("Item", "Value")
    TABLE_ROW = ("first", 1)
    TABLE_NAME = "EmendCompare"
    COMMENT_TEXT = "emend compare"
    COMMENT_AUTHOR = "emend"
    # A 2 by 2 RGB PNG, 73 bytes: red and blue on each row.
    PNG = bytes.fromhex(
        "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a73"
        "000000104944415478da63f8cf0004ff192014001bf203fd3e975da40000000049"
        "454e44ae426082"
    )
    
    
    def run(op, source, target):
        import io
        import openpyxl
        from openpyxl.chart import BarChart, Reference
        from openpyxl.comments import Comment
        from openpyxl.drawing.image import Image
        from openpyxl.utils import quote_sheetname
        from openpyxl.workbook.defined_name import DefinedName
        from openpyxl.worksheet.table import Table
    
        wb = openpyxl.load_workbook(source)
        ws = wb.worksheets[0]
        m = ws.max_row
        if op == "read":
            cells = 0
            for sheet in wb.worksheets:
                for row in sheet.iter_rows():
                    cells += len(row)
            print("cells=%d" % cells)
        elif op == "edit":
            ws.cell(row=m + 1, column=1, value=EDIT_NUMBER)
            ws.cell(row=m + 1, column=2, value=EDIT_TEXT)
            ws.cell(row=m + 1, column=3, value=EDIT_BOOLEAN)
        elif op == "format":
            ws.cell(row=m + 1, column=1, value=FORMAT_NUMBER).number_format = FORMAT_CODE
        elif op == "insert-rows":
            ws.insert_rows(INSERT_AT, INSERT_COUNT)
        elif op == "names":
            ref = "%s!$A$1" % quote_sheetname(ws.title)
            wb.defined_names[NAME] = DefinedName(NAME, attr_text=ref)
        elif op == "table":
            ws.cell(row=m + 2, column=1, value=TABLE_HEADERS[0])
            ws.cell(row=m + 2, column=2, value=TABLE_HEADERS[1])
            ws.cell(row=m + 3, column=1, value=TABLE_ROW[0])
            ws.cell(row=m + 3, column=2, value=TABLE_ROW[1])
            ws.add_table(Table(displayName=TABLE_NAME, ref="A%d:B%d" % (m + 2, m + 3)))
        elif op == "comment":
            ws.cell(row=m + 1, column=1).comment = Comment(COMMENT_TEXT, COMMENT_AUTHOR)
        elif op == "image":
            ws.add_image(Image(io.BytesIO(PNG)), "A%d" % (m + 2))
        elif op == "add-chart":
            chart = BarChart()
            chart.add_data(Reference(ws, min_col=2, min_row=2, max_row=m + 1), titles_from_data=False)
            chart.set_categories(Reference(ws, min_col=1, min_row=2, max_row=m + 1))
            ws.add_chart(chart, "A%d" % (m + 2))
        elif op == "copy":
            wb.copy_worksheet(ws)
        wb.save(target)
        return openpyxl.__version__
    
    
    def last_line(version):
        rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
        print("openpyxl=%s\tpeak_rss_kb=%d" % (version, rss))
    
    
    # The cap's two lines, made before the op (ruling Y): the class name, and the
    # last line's prefix, its version filled in once openpyxl is imported.
    MEMORY_LINE = b"MemoryError\n"
    NO_RSS = b"-\n"
    LAST_PREFIX = [b"openpyxl=-\tpeak_rss_kb="]
    
    
    def cap_exit():
        """Ends the script with 137 after a MemoryError, wherever it was raised:
        what print has buffered is flushed if it can be, the two lines go out by
        os.write, the peak RSS as "-" if even its digits cannot be made, and
        os._exit leaves whatever happens on the way."""
        try:
            try:
                sys.stdout.flush()
            except BaseException:
                pass
            os.write(1, MEMORY_LINE)
            os.write(1, LAST_PREFIX[0])
            try:
                rss = b"%d\n" % resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
            except MemoryError:
                rss = NO_RSS
            os.write(1, rss)
        finally:
            os._exit(137)
    
    
    def main(argv):
        if len(argv) != 3 or argv[0] not in OPS:
            print("unknown op")
            return 2
        version = "-"
        try:
            import openpyxl
            version = openpyxl.__version__
            LAST_PREFIX[0] = ("openpyxl=%s\tpeak_rss_kb=" % version).encode()
            run(*argv)
        except MemoryError:
            cap_exit()
        except Exception as err:
            print(type(err).__name__)
            last_line(version)
            return 1
        last_line(version)
        return 0
    
    
    if __name__ == "__main__":
        # A MemoryError raised while another exception is reported, or anywhere
        # outside the op, ends as the cap too (ruling Y).
        try:
            code = main(sys.argv[1:])
        except MemoryError:
            cap_exit()
        sys.exit(code)
command: cat <scratch>/w/clone/scripts/lo-check.sh (the script under test)
    # emend open-check library (specs/0015-open-checks.md, "The open-check
    # library"): the LibreOffice open check of specs/0006-passthrough.md P3 and
    # its constant, moved here unchanged from scripts/passthrough-run.sh so that
    # the runner and scripts/edit-open-check.sh run the one definition.
    #
    # Sourced, never run. The caller sets LO_IMAGE (the pinned image) and
    # LO_TIMEOUT (whole seconds per conversion) before calling lo_check, and has
    # podman, timeout and python3 on PATH. Grep is named by path here, as the
    # runner names it, so the library does not depend on a caller's variable.
    readonly LO_GREP=/usr/bin/grep
    # The image has no Java by design, so every conversion writes this one line to
    # stderr. Planning ruled on 2026-09-15 that it is the only allowed line holding
    # Error or Warning, matched whole (records/libreoffice-2026-09-15.md).
    readonly LO_ALLOWED_STDERR='Warning: failed to launch javaldx - java may not function correctly'
    # The sheet elements of xl/workbook.xml, as a Python regular expression: a
    # sheet element with any namespace prefix or none, followed by whitespace, a
    # slash or the tag's end. <sheets> and <sheetData do not match. P1
    # verification ruling 3 (a) amended T3 P3's definition, which matched only an
    # unprefixed <sheet, so a prefixed workbook counted 0. A sheet element of a
    # foreign namespace would count too; no corpus file or fixture has one, and
    # the check is a count, not a schema (P2 ruling 4). scripts/edit-open-check.sh
    # counts a kept input's sheets with this same pattern.
    readonly LO_SHEET_PATTERN='<(?:[A-Za-z_][A-Za-z0-9._-]*:)?sheet(?=[\s/>])'
    
    # lo_check <file> <work dir> <reason file> <reference workbook>: the open check
    # of specs/0006-passthrough.md P3. The file's directory is mounted read-only as
    # /in and the work directory's ods/ as /out, and the copy is converted to ODS
    # under --lo-timeout, which is its own budget, one per conversion. It is ok
    # when the conversion exits 0, its stderr holds no line with Error or Warning
    # other than the allowed javaldx line, the ODS exists, and its content.xml
    # holds as many <table:table elements as the reference workbook's
    # xl/workbook.xml holds <sheet elements. It prints nothing: the reason goes to
    # the reason file, which stays in the run directory.
    # The container is named emend-lo-<shell pid>-<subshell pid>-<n>, n counting
    # this shell's calls. A timeout kills the podman client and not the
    # container, so after exit 124 the container is removed by name with podman
    # rm -f --time 0 (no grace period), its output and exit kept in the work
    # directory as rm.txt and rm-exit.txt (specs/0037-measurement-and-close.md,
    # "Planning rulings during P1", ruling A, carried to P3 as engineering-close
    # item 7: the runner's form).
    # Returns 0 for ok, 1 for fail (LibreOffice refused the file, or the ODS is
    # missing or wrong) and 2 for error, which is the check not running at all:
    # the conversion directory, a conversion that timed out under --lo-timeout, a
    # conversion killed by a signal, podman itself, python3, or an ODS or workbook
    # part that cannot be read. Planning ruled the two apart on 2026-09-15 and
    # fixed their order on 2026-09-16, so a broken tool is never read as a broken
    # archive.
    LO_CHECK_N=0
    lo_check() {
      local file=$1 work=$2 reason=$3 reference=$4
      local indir base outdir ods rc counts sheets tables name
      LO_CHECK_N=$((LO_CHECK_N + 1))
      name=emend-lo-$$-$BASHPID-$LO_CHECK_N
      indir=$(dirname -- "$file")
      base=$(basename -- "$file")
      outdir=$work/ods
      mkdir -p "$work" && rm -rf "$outdir" && mkdir -p "$outdir" ||
        { printf 'cannot prepare the conversion directory\n' >"$reason"; return 2; }
      timeout --signal=KILL "$LO_TIMEOUT" podman run --rm --name "$name" --network=none --userns=keep-id \
        -v "$indir":/in:ro -v "$outdir":/out "$LO_IMAGE" \
        --convert-to ods --outdir /out "/in/$base" \
        </dev/null >"$work/stdout.txt" 2>"$work/stderr.txt" 3>&-
      rc=$?
      # Planning's ruling 1 of 2026-09-16: the conversion process itself is judged
      # first, and a status of 0 decides nothing on its own, so it falls through to
      # the checks below. 124 is this timeout's own kill; 125 to 127 are podman
      # failing to start the container; 128 and above mean the contained process
      # died by a signal (137 is KILL, which is also what the kernel's OOM killer
      # produces). None of those three is evidence about the archive, so each is an
      # error. A status of 1 to 123 is LibreOffice refusing the file: a fail, with
      # the status in the reason.
      if [ "$rc" -eq 124 ]; then
        # The kill ended the podman client; the container is removed by name.
        podman rm -f --time 0 "$name" </dev/null >"$work/rm.txt" 2>&1 3>&-
        echo "$?" >"$work/rm-exit.txt"
        printf 'the conversion timed out after %s s\n' "$LO_TIMEOUT" >"$reason"
        return 2
      fi
      if [ "$rc" -ge 125 ] && [ "$rc" -le 127 ]; then
        printf 'podman could not run the container, exit %s\n' "$rc" >"$reason"
        return 2
      fi
      if [ "$rc" -ge 128 ]; then
        printf 'the conversion was killed, exit status %s\n' "$rc" >"$reason"
        return 2
      fi
      if [ "$rc" -ne 0 ]; then
        printf 'the conversion exited %s\n' "$rc" >"$reason"
        return 1
      fi
      # The two greps are evaluated with their exit codes read, because an error
      # from either (exit 2 or more) must never read as "no disallowed line"
      # (specs/0001-bootstrap.md, "Rules for every phase": an error is never
      # reported as zero hits). Independent check 1 found the piped form doing
      # exactly that.
      LC_ALL=C "$LO_GREP" -a -E 'Error|Warning' "$work/stderr.txt" >"$work/flagged.txt"
      rc=$?
      if [ "$rc" -ge 2 ]; then
        printf 'the stderr scan failed, grep exit %s\n' "$rc" >"$reason"
        return 2
      fi
      LC_ALL=C "$LO_GREP" -a -q -v -x -F -e "$LO_ALLOWED_STDERR" "$work/flagged.txt"
      rc=$?
      if [ "$rc" -ge 2 ]; then
        printf 'the stderr allowance scan failed, grep exit %s\n' "$rc" >"$reason"
        return 2
      fi
      if [ "$rc" -eq 0 ]; then
        printf 'stderr holds a line with Error or Warning other than the allowed javaldx line\n' >"$reason"
        return 1
      fi
      ods=$outdir/${base%.*}.ods
      if [ ! -f "$ods" ]; then
        printf 'no ods file was written\n' >"$reason"
        return 1
      fi
      counts=$(LO_REFERENCE=$reference LO_ODS=$ods LO_SHEET=$LO_SHEET_PATTERN python3 -I -B -c '
    import os, re, sys, zipfile
    try:
        workbook = zipfile.ZipFile(os.environ["LO_REFERENCE"]).read("xl/workbook.xml").decode("utf-8", "replace")
        content = zipfile.ZipFile(os.environ["LO_ODS"]).read("content.xml").decode("utf-8", "replace")
    except Exception as err:
        sys.stdout.write("error %s" % type(err).__name__)
    else:
        # Tolerant of any whitespace after the name, and of a tag closed straight
        # away: <sheet\n, <sheet\t, <sheet/> and <sheet> all count, with any prefix
        # (LO_SHEET_PATTERN), while <sheets> and <sheetData do not, and
        # <table:table-row and <table:table-cell do not.
        sheet = os.environ["LO_SHEET"]
        table = r"<table:table(?=[\s/>])"
        sys.stdout.write("%d %d" % (len(re.findall(sheet, workbook)), len(re.findall(table, content))))
    ') || { printf 'cannot count sheets and tables\n' >"$reason"; return 2; }
      read -r sheets tables <<<"$counts"
      if ! [[ "$sheets" =~ ^[0-9]+$ ]] || ! [[ "${tables:-}" =~ ^[0-9]+$ ]]; then
        printf 'cannot read the ods or the workbook part\n' >"$reason"
        return 2
      fi
      if [ "$sheets" -eq 0 ] || [ "$sheets" -ne "$tables" ]; then
        printf 'the ods holds %s table elements and the workbook %s sheet elements\n' "$tables" "$sheets" >"$reason"
        return 1
      fi
      return 0
    }
