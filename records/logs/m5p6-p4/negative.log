    echo "  the size record: lines holding 436992 $(word_count 436992 "$B/size-rec.md"), 436993 $(word_count 436993 "$B/size-rec.md"), 1027828 $(word_count 1027828 "$B/size-rec.md")"
    echo "  the README: lines holding 105916 $(word_count 105916 "$B/README.md"), 105917 $(word_count 105917 "$B/README.md"), 1027828 $(word_count 1027828 "$B/README.md"); charts feature lines $(count_matches -E '^- `charts`, ' "$B/README.md")"
    targets_ok() { [ "$(word_count 436992 "$B/size-rec.md")" -ge 1 ] && [ "$(word_count 436993 "$B/size-rec.md")" = 0 ] && [ "$(word_count 1027828 "$B/size-rec.md")" -ge 1 ] && [ "$(word_count 105916 "$B/README.md")" = 1 ] && [ "$(word_count 105917 "$B/README.md")" = 0 ] && [ "$(word_count 1027828 "$B/README.md")" = 0 ] && [ "$(count_matches -E '^- `charts`, ' "$B/README.md")" = 1 ]; }
    check "the plants' targets: the size record holds 436992 and 1027828 and not 436993; the README holds 105916 once and neither 105917 nor 1027828, and one charts feature line (ruling AF)" "$(yn targets_ok)"
