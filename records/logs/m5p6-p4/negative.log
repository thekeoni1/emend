    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## the README check program, the run log's (change QZ3)
command: sha256sum <scripts>/readme_check.py: acf17a2f10684fee713c2055a664646b3c3148834f17ddc80b487a3dac86154e
    #!/usr/bin/env python3
    """README check of M5 part 6 P4 (specs/0037-measurement-and-close.md, "The
    README" and "P4: the README"), the successor of M3 part 7 P4's program (whose
    citation check it keeps, unit for unit): over the README, the phase commit's
    file list and a root holding the phase commit's crates/emend/Cargo.toml and
    every records/ file the README cites at its repository path.
    
    Usage: python3 -I -B readme_check.py <README> <tree.txt> <root>
    
    Units: a fenced code block is one unit; outside fences, a heading line, a list
    item (a line starting "- " with its continuation lines) and a paragraph (lines
    up to a blank line) are units, and a prose unit is split into sentences after
    ".", "!" or "?" followed by white space. The checks, each refusal one line
    starting with its kind word and never holding README text:
      UNCITED unit <i>    a sentence holding a digit cites no records/ path;
      MISSING <path>      a cited records/ path the tree does not hold;
      FIGURE <label>      a figure row's fragment, built from the figures read
                          from its record, is not in the README once, or the
                          row's figures do not agree; FIGURE unit <i>: a number
                          of a cited sentence that no record it cites holds;
      NUMBER unit <i>     a number of a cited sentence that a record it cites
                          holds but no figure row reads;
      FEATURE <name>      a feature of the manifest with no README line, a line
                          naming no specs/ path or one the tree lacks, or a
                          README feature the manifest does not have;
      DASH unit <i>       U+2014;
      ABSPATH unit <i>    an absolute path;
      WORD unit <i>       one of the two comparatives specs/0037 forbids.
    A sentence's numbers are its digit runs outside records/ and specs/ paths, the
    licence files' names, the target's name, the milestone names (with "part
    <n>" after one) and "3D". Each
    figure row passed prints "checked <label>", each cited sentence "cited <n>
    unit <i>"; the last line is the summary "sentences <s> with-digit <d> cited
    <c> uncited <u> missing <m> figure <f> number <n> feature <x> dash <k> abspath
    <a> word <w> figures-checked <t>". Exit 0 when no line refuses, 1 when one
    does, 2 on a usage or read error of the README, the tree or the manifest."""
    import os
    import re
    import sys
    
    SIZE5 = "records/size-m5p6-2026-10-18-ef9da37.md"
    M3_SAMPLES = ["records/m3p6-p4-copy-2026-10-08-9cfd92e.md", "records/m3p6-p4-anchor-2026-10-08-9cfd92e.md",
                  "records/m3p6-p4-removeimage-2026-10-08-9cfd92e.md", "records/m3p6-p4-commentbox-2026-10-08-9cfd92e.md"]
    COPY = M3_SAMPLES[0]
    M5_SAMPLES = ["records/m5p5-p4-charts-2026-10-15-a8bfe71.md", "records/m5p5-p4-chartmore-2026-10-15-a8bfe71.md",
                  "records/m5p5-p4-chart3d-2026-10-15-a8bfe71.md", "records/m5p5-p4-chartlabels-2026-10-15-a8bfe71.md",
                  "records/m5p5-p4-removechart-2026-10-15-a8bfe71.md"]
    OPEN = "records/m3p6-open-2026-10-08-9cfd92e.md"
    SCALE = "records/scale-m3p1-2026-10-02-6578925.md"
    CMP = "records/compare-m5p6-2026-10-16-5e52758.md"
    WORDS = {"4": "four", "5": "five", "11": "eleven"}
    PATH = re.compile(r"records/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]")
    NUM = re.compile(r"[0-9]+(?:[.][0-9]+)?")
    # Built from pieces, so this program holds neither word.
    COMPARATIVES = re.compile(r"\b(?:" + "fast" + "er|" + "bett" + r"er)\b", re.I)
    ABS = re.compile(r"(?:^|[\s(`'\"])(?:/[A-Za-z0-9._-]+/|[A-Za-z]:[\\/])")
    DASH = chr(0x2014)
    
    
    def units(lines):
        out, cur, fence = [], [], False
    
        def flush():
            if cur:
                out.append((" ".join(x.strip() for x in cur), False))
                cur.clear()
        for ln in lines:
            if ln.startswith("```"):
                if fence:
                    cur.append(ln)
                    out.append(("\n".join(cur), True))
                    cur.clear()
                    fence = False
                else:
                    flush()
                    cur.append(ln)
                    fence = True
                continue
            if fence:
                cur.append(ln)
                continue
            if not ln.strip():
                flush()
                continue
            if ln.startswith("#") or ln.startswith("- "):
                flush()
                cur.append(ln)
                if ln.startswith("#"):
                    flush()
                continue
            cur.append(ln)
        if fence:
            print("error: an unclosed code fence", file=sys.stderr)
            sys.exit(2)
        flush()
        return out
    
    
    def stripped(text):
        """The text without the paths and names whose digits are not numbers."""
        text = re.sub(r"(records|specs)/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]", "", text)
        text = re.sub(r"LICENSE-[A-Z]+", "", text)
        text = text.replace("i686-unknown-linux-musl", "")
        text = re.sub(r"Milestone [0-9]+(?: part [0-9]+)?", "", text)
        return re.sub(r"(^|[^A-Za-z0-9])3D([^A-Za-z0-9]|$)", r"\1\2", text)
    
    
    def section(text, heading):
        """The lines of the section opened by the first line starting with the
        heading, up to the next "## " heading."""
        lines = text.split("\n")
        for i, l in enumerate(lines):
            if l.startswith(heading):
                out = []
                for m in lines[i + 1:]:
                    if m.startswith("## "):
                        break
                    out.append(m)
                return out
        return []
    
    
    def cells(line):
        return [c.strip() for c in line.split("|")[1:-1]]
    
    
    def tables(text, heading):
        """Each table of the section as (header, data rows)."""
        out, cur = [], None
        for l in section(text, heading):
            if l.startswith("|"):
                if cur is None:
                    cur = (cells(l), [])
                    out.append(cur)
                else:
                    row = cells(l)
                    if row and re.fullmatch(r"-+", row[0]):
                        continue
                    cur[1].append(row)
            else:
                cur = None
        return out
    
    
    def where(text, heading, col, **conds):
        """The column's cell of each data row meeting every condition, over the
        section's tables whose header names the column and the conditions'."""
        vals = []
        for head, rows in tables(text, heading):
            names = [col] + list(conds)
            if any(n not in head for n in names):
                continue
            for r in rows:
                if len(r) != len(head):
                    continue
                if all(r[head.index(k)] == v for k, v in conds.items()):
                    vals.append(r[head.index(col)])
        return vals
    
    
    def first_col(text, heading, col, label, prefix=False):
        vals = []
        for head, rows in tables(text, heading):
            if col not in head:
                continue
            for r in rows:
                if len(r) == len(head) and (r[0].startswith(label) if prefix else r[0] == label):
                    vals.append(r[head.index(col)])
        return vals
    
    
    def joined(text):
        return text.replace("\n", " ")
    
    
    def one(vals):
        return vals[0] if len(vals) == 1 else None
    
    
    def is_num(v):
        return v is not None and NUM.fullmatch(v) is not None
    
    
    class Checker:
        def __init__(self, readme, root):
            self.readme = readme
            self.root = root
            self.figs = set()
            self.figure = 0
            self.checked = 0
    
        def rec(self, path):
            try:
                return open(os.path.join(self.root, path), encoding="utf-8").read()
            except (OSError, UnicodeDecodeError):
                return None
    
        def row(self, label, ok, values, fragments):
            """A figure row: its figures agree (ok), each is a number, and each
            fragment is in the README once."""
            good = ok and all(is_num(v) for v in values) and all(self.readme.count(f) == 1 for f in fragments)
            if good:
                self.checked += 1
                self.figs.update(values)
                print("checked %s" % label)
            else:
                self.figure += 1
                print("FIGURE %s" % label)
    
        def line_of(self, fragment):
            for l in self.readme.split("\n"):
                if fragment in l:
                    return l
            return ""
    
    
    def main():
        if len(sys.argv) != 4:
            print("usage: readme_check.py <README> <tree.txt> <root>", file=sys.stderr)
            sys.exit(2)
        try:
            readme = open(sys.argv[1], encoding="utf-8").read()
            tree = set(open(sys.argv[2], encoding="utf-8").read().split("\n"))
            manifest = open(os.path.join(sys.argv[3], "crates/emend/Cargo.toml"), encoding="utf-8").read()
        except (OSError, UnicodeDecodeError) as e:
            print("error: %s" % type(e).__name__, file=sys.stderr)
            sys.exit(2)
        ck = Checker(readme, sys.argv[3])
        lines = readme.split("\n")
        feature = 0
    
        # The features: the manifest's against the README's lines, and each
        # line's cost from M5 part 6 P3's size record, which every line cites
        # (ruling AI).
        feats, inside = [], False
        for l in manifest.split("\n"):
            if l.strip() == "[features]":
                inside = True
                continue
            if l.startswith("["):
                inside = False
            m = re.match(r"([a-z][a-z0-9_-]*) = ", l)
            if inside and m:
                feats.append(m.group(1))
        readme_feats = [m.group(1) for m in (re.match(r"- `([a-z][a-z0-9_-]*)`, ", l) for l in lines) if m]
        for name in sorted(set(readme_feats) - set(feats)):
            feature += 1
            print("FEATURE %s" % name)
        for f in feats:
            fl = [l for l in lines if l.startswith("- `%s`, " % f)]
            if len(fl) != 1:
                feature += 1
                print("FEATURE %s" % f)
                continue
            specs = re.findall(r"specs/[0-9]{4}-[a-z0-9-]+[.]md", fl[0])
            if not specs or any(s not in tree for s in specs):
                feature += 1
                print("FEATURE %s" % f)
                continue
            recs = PATH.findall(fl[0])
            text = ck.rec(recs[0]) if len(recs) == 1 else None
            v = one(first_col(text, "## The figures", "Sections", "the `%s` feature's cost," % f, True)) if text else None
            ck.row("feature-%s" % f, text is not None and recs[0] == SIZE5, [v],
                   [": %s " % v])
    
        # The size sentence, from M5 part 6 P3's size record.
        t = ck.rec(SIZE5) or ""
        b = one(first_col(t, "## The figures", "Sections", "the budget,", True))
        m = re.search(r"The budget figure is ([0-9]+) section bytes, ([0-9]+) under the ceiling[.]", joined(t))
        c = re.search(r"The ceiling is ([0-9]+) section bytes", joined(t))
        b2, h = (m.group(1), m.group(2)) if m else (None, None)
        cl = c.group(1) if c else None
        ok = all(is_num(x) for x in (b, b2, h, cl)) and b == b2 and int(h) == int(cl) - int(b)
        ck.row("size", ok, [b, h, cl], ["is %s section bytes, %s under the ceiling of %s (`%s`)" % (b, h, cl, SIZE5)])
    
        # Fidelity, M3 part 6 P4's four samples: the host row of each.
        def files_row(path, lab):
            t = ck.rec(path) or ""
            return [one(first_col(t, "## Files by outcome", c, lab)) for c in ("files", "ok", "lo ok", "lo_in ok")]
        rows = [files_row(p, "host") for p in M3_SAMPLES]
        f, o, lo, li = rows[0]
        ok = all(r == rows[0] for r in rows) and o == lo
        frag = "ran over the %s workbooks of the private test corpus, and on the host all %s outputs were written and opened in LibreOffice, as were all %s inputs (" % (f, o, li)
        line = ck.line_of(frag)
        ok = ok and all("`%s`" % p in line for p in M3_SAMPLES) and WORDS.get(str(len(M3_SAMPLES))) is not None
        ck.row("fidelity-m3", ok, [f, o, li], [frag, "each of the %s editing samples (" % WORDS.get(str(len(M3_SAMPLES)), "")])
    
        # Fidelity, part 5 P4's five chart samples: both labels' rows (ruling AF).
        rows = [files_row(p, lab) for p in M5_SAMPLES for lab in ("host", "i686")]
        f, o, lo, li = rows[0]
        ok = all(r == rows[0] for r in rows) and o == lo
        frag = "ran over the same %s workbooks, and on the host and on the static target all %s outputs were written and opened in LibreOffice, as were all %s inputs (" % (f, o, li)
        line = ck.line_of(frag)
        ok = ok and all("`%s`" % p in line for p in M5_SAMPLES)
        ck.row("fidelity-m5", ok, [f, o, li], [frag, "Each of Milestone 5 part 5's %s chart samples (" % WORDS.get(str(len(M5_SAMPLES)), "")])
    
        # The copy sample's host total row.
        t = ck.rec(COPY) or ""
        e = one(first_col(t, "## Entries by part family: host", "entries", "total"))
        i = one(first_col(t, "## Entries by part family: host", "identical", "total"))
        ck.row("copy", True, [e, i], ["In the copy sample, %s of the %s zip entries on the host came back byte for byte: the entries the copy did not touch (`%s`)" % (i, e, COPY)])
    
        # The open record's totals, its "eleven" the pairs less the opened.
        t = ck.rec(OPEN) or ""
        tot = tables(t, "## Totals")
        pairs = olo = None
        if tot and tot[0][1] and "pairs" in tot[0][0] and "lo ok" in tot[0][0]:
            pairs = tot[0][1][0][tot[0][0].index("pairs")]
            olo = tot[0][1][0][tot[0][0].index("lo ok")]
        rest = WORDS.get(str(int(pairs) - int(olo))) if is_num(pairs) and is_num(olo) else None
        ck.row("open", rest is not None, [pairs, olo],
               ["Of the %s output files the crate's and the copy tool's tests keep, LibreOffice opened %s; the record's own sections explain the %s it did not (`%s`)" % (pairs, olo, rest, OPEN)])
    
        # The scale record: the peaks, the largest sheet entry, the throughput
        # table and tier c's rewriting samples.
        t = ck.rec(SCALE) or ""
        j = joined(t)
        m = re.search(r"Every streaming sample peaks between ([0-9]+) and ([0-9]+) kB on every tier it completes, tier c's ([0-9]+)-byte sheet entry included[.]", j)
        r = re.search(r"Tier c's figure includes the raw-copy samples; its rewriting samples run at ([0-9]+[.][0-9]+) to ([0-9]+[.][0-9]+) MB/s[.]", j)
        hosts = where(t, "## Throughput", "host MB/s")
        i686s = where(t, "## Throughput", "i686 MB/s")
        ok = m is not None and r is not None and len(hosts) == 4 and len(i686s) == 4 and all(is_num(x) for x in hosts + i686s)
        if ok:
            plo, phi, big = m.groups()
            rlo, rhi = r.groups()
            hs = sorted(hosts, key=float)
            js = sorted(i686s, key=float)
            hc = one(where(t, "## Throughput", "host MB/s", tier="c"))
            jc = one(where(t, "## Throughput", "i686 MB/s", tier="c"))
            ok = hc == hs[-1] and jc == js[-1]
            vals = [big, plo, phi, hs[0], hs[-1], js[0], js[-1], rlo, rhi]
            frag = ("up to a %s-byte sheet entry, the streaming samples peaked between %s and %s kB on every tier they completed, and throughput ran from %s to %s MB/s on the host and from %s to %s MB/s on the static target, the largest tier's figures including the raw-copy samples, whose rewriting samples ran at %s to %s MB/s (`%s`)"
                    % (big, plo, phi, hs[0], hs[-1], js[0], js[-1], rlo, rhi, SCALE))
            ck.row("speed", ok, vals, [frag])
        else:
            ck.row("speed", False, [], [])
    
        # The comparison record: the tier rerun's figure and the paragraph.
        t = ck.rec(CMP) or ""
        cs, ss = "## The corpus, per op", "## The scale tiers"
        ops = sorted(set(where(t, cs, "op")))
        n_rows = len(where(t, cs, "op"))
        per = [len(where(t, cs, "op", tool=tl, label=lb)) for tl, lb in (("emend", "host"), ("emend", "i686"), ("openpyxl", "openpyxl"))]
        nf = one(where(t, cs, "files", op="roundtrip", tool="emend", label="host"))
        nok = one(where(t, cs, "ok", op="roundtrip", tool="emend", label="host"))
        every = (set(where(t, cs, "files")) == {nf} and set(where(t, cs, "ok")) == {nok}
                 and set(where(t, cs, "lo ok")) == {nok})
        w_ops = WORDS.get(str(len(ops)))
        ok = w_ops is not None and n_rows == 3 * len(ops) and per == [len(ops)] * 3 and every
        ck.row("comparison-outputs", ok, [nf, nok],
               ["over the %s workbooks and the %s ops of the comparison" % (nf, w_ops),
                "emend on the host and on the static target and openpyxl each wrote %s of %s outputs for every op, and LibreOffice opened every one" % (nok, nf)])
    
        def rt(col, tool, lab):
            return one(where(t, cs, col, op="roundtrip", tool=tool, label=lab))
        ehi, ehd = rt("identical", "emend", "host"), rt("dropped", "emend", "host")
        eii, eid = rt("identical", "emend", "i686"), rt("dropped", "emend", "i686")
        oi, od = rt("identical", "openpyxl", "openpyxl"), rt("dropped", "openpyxl", "openpyxl")
        ck.row("comparison-roundtrip", ehi == eii and ehd == "0" and eid == "0", [ehi, oi, od],
               ["On the roundtrip emend left %s zip entries byte-identical and dropped none, where openpyxl left %s identical and dropped %s" % (ehi, oi, od)])
        me, mo = rt("wall median s", "emend", "host"), rt("wall median s", "openpyxl", "openpyxl")
        ok = (set(where(t, cs, "wall median s", tool="emend", label="host")) == {me}
              and set(where(t, cs, "wall median s", tool="openpyxl", label="openpyxl")) == {mo})
        ck.row("comparison-medians", ok, [me, mo],
               ["The median wall time per workbook was %s s for emend on the host and %s s for openpyxl on every op" % (me, mo)])
        re_, ro = rt("peak RSS max kB", "emend", "host"), rt("peak RSS max kB", "openpyxl", "openpyxl")
        ck.row("comparison-rss", True, [re_, ro],
               ["the roundtrip's largest peak RSS was %s kB for emend on the host and %s kB for openpyxl" % (re_, ro)])
        eo = set(where(t, ss, "outcome", tool="emend"))
    
        def sc(col, **k):
            return one(where(t, ss, col, **k))
        cap = sc("outcome", tier="c", op="roundtrip", tool="openpyxl")
        cx, cw, cp = (sc(c, tier="c", op="roundtrip", tool="openpyxl") for c in ("exit", "wall_s", "peak_rss_kb"))
        ck.row("comparison-scale", eo == {"ok"} and cap == "cap", [cx, cw, cp],
               ["On the scale tiers emend completed every run, and openpyxl ended at its memory cap on the tier c roundtrip, exit %s after %s s at a peak of %s kB" % (cx, cw, cp)])
        tout = sc("outcome", tier="c", op="roundtrip", tool="emend", label="host")
        ti, tw, tp = (sc(c, tier="c", op="roundtrip", tool="emend", label="host") for c in ("in_bytes", "wall_s", "peak_rss_kb"))
        ck.row("tier-rerun", tout == "ok", [ti, tw, tp],
               ["In Milestone 5's rerun of the tiers, emend's roundtrip of the tier c workbook, %s bytes, took %s s at a peak of %s kB on the host (`%s`)" % (ti, tw, tp, CMP)])
        para = [l for l in lines if l.startswith("Comparison with openpyxl: ")]
        ck.row("comparison-cites", len(para) == 1 and sorted(set(PATH.findall(para[0]))) == [CMP], [], [])
    
        # The sentences: citations, numbers, the dash, paths and words.
        s = d = cited = u = miss = number = dash = absn = word = 0
        for idx, (text, code) in enumerate(units(lines), 1):
            if DASH in text:
                dash += 1
                print("DASH unit %d" % idx)
            if ABS.search(text):
                absn += 1
                print("ABSPATH unit %d" % idx)
            if COMPARATIVES.search(text):
                word += 1
                print("WORD unit %d" % idx)
            sents = [text] if code else [x for x in re.split(r"(?<=[.!?])\s+", text) if x]
            for sent in sents:
                s += 1
                if not re.search(r"[0-9]", sent):
                    continue
                d += 1
                paths = PATH.findall(sent)
                if not paths:
                    u += 1
                    print("UNCITED unit %d" % idx)
                    continue
                bad = [p for p in paths if p not in tree]
                for p in bad:
                    miss += 1
                    print("MISSING %s" % p)
                if bad:
                    continue
                cited += 1
                print("cited %d unit %d" % (len(paths), idx))
                texts = [ck.rec(p) or "" for p in paths]
                for n in NUM.findall(stripped(sent)):
                    pat = re.compile(r"(?<![0-9.])" + re.escape(n) + r"(?![0-9]|[.][0-9])")
                    if not any(pat.search(x) for x in texts):
                        ck.figure += 1
                        print("FIGURE unit %d" % idx)
                    elif n not in ck.figs:
                        number += 1
                        print("NUMBER unit %d" % idx)
        print("sentences %d with-digit %d cited %d uncited %d missing %d figure %d number %d feature %d dash %d abspath %d word %d figures-checked %d"
              % (s, d, cited, u, miss, ck.figure, number, feature, dash, absn, word, ck.checked))
        sys.exit(0 if u + miss + ck.figure + number + feature + dash + absn + word == 0 else 1)
    
    
    main()

