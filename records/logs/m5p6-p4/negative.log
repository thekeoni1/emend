    check "control: the phase's status pattern takes this phase's untracked log directory and log and planning's modified spec alone, no other phase's log, no record, no sibling directory, no modified log, no ROADMAP.md, no untracked or staged spec (change QZ1, ruling AF)" "$(yn [ "$(ours_rec_ctl)" = 3 ])"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
