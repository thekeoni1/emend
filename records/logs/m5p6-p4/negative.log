    check "the eleven cases each ran" "$(yn [ "$n_ran" = 11 ])"
    KINDS="UNCITED MISSING FIGURE NUMBER FEATURE DASH ABSPATH WORD"
    rc_of() { cat "$B/$1.rc"; }
    n_kind() { count_matches -E "^$2( |\$)" "$B/$1.out"; }
    none_kind() { local k; for k in $KINDS; do [ "$(n_kind "$1" "$k")" = 0 ] || return 1; done; }
    nc_ok() { [ "$(rc_of NC)" = 0 ] && none_kind NC && [ ! -s "$B/NC.err" ]; }
    check "NC (the control): the README as committed passes: exit 0, no line of any refusal kind ($KINDS), nothing on stderr" "$(yn nc_ok)"
    refused_as() { [ "$(rc_of "$1")" = 1 ] && [ "$(n_kind "$1" "$2")" -ge 1 ] && [ ! -s "$B/$1.err" ]; }
    cat >"$B/expect" <<EXPECT
    N1${TAB}UNCITED${TAB}the planted sentence holding a digit and citing nothing is refused
    N2${TAB}MISSING${TAB}the planted citation of a records/ path the tree does not hold is refused
    N3${TAB}FIGURE${TAB}the charts feature line's figure moved by one is refused
    N4${TAB}FIGURE${TAB}the planted citation of a record the tree holds, with a figure that record does not hold, is refused (ruling AF)
    N5${TAB}DASH${TAB}the planted sentence holding U+2014 is refused
    N6${TAB}ABSPATH${TAB}the planted sentence naming an absolute path is refused
    N7${TAB}WORD${TAB}the planted sentence holding the first forbidden comparative is refused
    N8${TAB}WORD${TAB}the planted sentence holding the second forbidden comparative is refused
    N9${TAB}FEATURE${TAB}the README with the charts feature line removed is refused
    N10${TAB}NUMBER${TAB}the planted citation of the size record with a figure it holds that no figure row reads is refused
    EXPECT
    echo "  the expected refusals (case|kind|what), tabs shown as |:"
    tr '\t' '|' <"$B/expect" | sed 's/^/    /'
    n_exp=0
    while IFS=$TAB read -r name kind what; do
      check "$name: $what: exit 1, at least one $kind line, nothing on stderr" "$(yn refused_as "$name" "$kind")"
      n_exp=$((n_exp + 1))
    done <"$B/expect"
    check "the ten plants were each checked" "$(yn [ "$n_exp" = 10 ])"
    check "N2: a MISSING line names the absent path" "$(yn [ "$(count_matches -xF "MISSING $NO_REC" "$B/N2.out")" = 1 ])"
    check "N10: no FIGURE line, its figure being one the record it cites holds" "$(yn [ "$(n_kind N10 FIGURE)" = 0 ])"
    check "control: refused_as refuses the control's output as N1's refusal" "$(ynnot refused_as NC UNCITED)"
    check "control: none_kind refuses N1's output" "$(ynnot none_kind N1)"
    echo
