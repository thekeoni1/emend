    echo "command: grep -o -E 'records/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]' over the cases, sorted and unique; each path the tree holds copied by git show <phase commit>:<path> into <scratch>/w/root/<path>"
    cat "$B"/N*.md | LC_ALL=C "$G" -o -E 'records/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]' | LC_ALL=C sort -u >"$B/cited.txt"
