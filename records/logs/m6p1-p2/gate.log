    note "control: the same comparison refuses another spec's blob (specs/0027 at the phase commit)" \
      "$(isnot [ "$(git show "$C:specs/0027-read-back.md" | sha256sum | cut -d' ' -f1)" = "$SPEC_GAVE" ])"
    
    echo
    echo "## the phase's commits by role, read from git (header change 2)"
    note_fn() { local label=$1; shift; note "$label" "$(is "$@")"; }
    by_subject() { git log --format='%H' -n 1 -F --grep="$1" "$C"; }
    REC=$(by_subject "M6 part 1 P1 record: the logs, the run's records, the check, the scan")
    DOC1=$(by_subject "M6 part 1 P2: commit planning docs (the P1 verification and rulings)")
    CARRY=$(by_subject "M6 part 1 P2: the carry, a pending chartsheet renamed and moved")
    OPC=$(by_subject "M6 part 1 P2: the openpyxl chartsheet op and its test line")
    LIMITS=$(by_subject "M6 part 1 P2: the package header's limits for chartsheets")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's full subject> <phase commit>, for each role"
    echo "  P1's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  the carry commit (planning's P1 verification ruling E): ${CARRY:-none}"
    echo "  the op commit (specs/0038 \"Harness runs\", the openpyxl fixture): ${OPC:-none}"
    echo "  the limits commit (the package header's limits), the phase commit: ${LIMITS:-none}"
    echo "command: git log -1 --format=%s <each role's commit>"
    for r in "$REC" "$DOC1" "$CARRY" "$OPC" "$LIMITS"; do
      [ -n "$r" ] && git log -1 --format='    %s' "$r"
    done
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$REC" "$DOC1" "$CARRY" "$OPC" "$LIMITS"; do
        [ -n "$r" ] || return 1
      done
      for r in "$LIMITS" "$OPC" "$CARRY" "$DOC1" "$REC"; do
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    note_fn "the doc commit, then the carry commit, then the op commit, then the limits commit, P1's record commit the doc commit's parent, each the next one's parent (change A69)" roles_in_order
    roles_ctl1() { local LIMITS=$OPC; if roles_in_order; then return 1; else return 0; fi; }
    roles_ctl2() { local DOC1=$REC; if roles_in_order; then return 1; else return 0; fi; }
    roles_ctl4() { local LIMITS=; if roles_in_order; then return 1; else return 0; fi; }
    roles_ctl5() { local c=$DOC1 t=$CARRY; local DOC1=$t CARRY=$c; if roles_in_order; then return 1; else return 0; fi; }
    note_fn "control: roles_in_order refuses the op commit named as the phase commit (change A69)" roles_ctl1
    note_fn "control: roles_in_order refuses the base named as the doc commit" roles_ctl2
    note_fn "control: roles_in_order refuses a role that resolved to nothing" roles_ctl4
    note_fn "control: roles_in_order refuses the doc and carry commits swapped (change A69)" roles_ctl5
    roles_ctl7() { local c=$CARRY t=$OPC; local CARRY=$t OPC=$c; if roles_in_order; then return 1; else return 0; fi; }
    note_fn "control: roles_in_order refuses the carry and op commits swapped (change A69)" roles_ctl7
    roles_ctl9() { local c=$OPC t=$LIMITS; local OPC=$t LIMITS=$c; if roles_in_order; then return 1; else return 0; fi; }
    note_fn "control: roles_in_order refuses the op and limits commits swapped (change A69)" roles_ctl9
    # Change A69 (A68's form): P1's tool commit named as the phase commit and
