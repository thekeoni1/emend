    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run builds <repo> into <target>/main and the consumer crate into <target>/consumer (CARGO_TARGET_DIR; changes J35, K35 and K36)"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to (it lies inside <home>, so it is scrubbed first); scripts/check.sh is run from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/${PHASE_DIR#"$HOME"/}, this phase's directory on the disk (change A33); <phase>/superseded keeps a superseded attempt's files; <phase>/out holds this script's own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <scripts> stands for <phase>/$(basename "$SELF_DIR"), the directory holding this script"
    echo "root: <build> stands for $([ -n "${GATE_BUILD_ROOT:-}" ] && echo "the directory GATE_BUILD_ROOT names, a dry run's" || echo "<phase>/gate"), this log's build directory (header change 1; change A35): <build>/bin/host and <build>/bin/i686 keep the copies of the DEBUG binaries, the carried form (changes J35, K38, K39 and K40)"
    echo "root: <target> stands for <phase>/target, this phase's cargo target root (specs/0029 item 2 and the specs/0001 rule it writes; changes J35, K35 and K36), one subdirectory per source tree: <target>/main for every build of <repo> (the gate, the crate's feature runs, its clippy and doc runs, the probe crate's clippy runs), as the phase's other logs and dry runs use it, and <target>/consumer for the consumer crate"
    echo "root: <scratch> stands for <phase> where this log names its temporary directories (change T50): <scratch>/tmp is TMPDIR, which this script sets, and <scratch>/w stands for this run's mktemp -d working directory inside it, <scratch>/consumer for the consumer crate's, a mktemp -d directory this run makes under TMPDIR and removes at its end (changes A24 and T51); scripts/counting.sh is read at the phase commit into <scratch>/w/counting.sh and sourced from there (change C3)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    note_fn "<scratch>/w lies inside <scratch>/tmp, TMPDIR, as change T50 makes it" under "$W" "$TMPDIR"
    note_fn "<scratch>/w and <repo> are distinct directories, neither inside the other" apart "$W" "$MAIN"
    note_fn "<phase> and <repo> are distinct directories, neither inside the other" apart "$PHASE_DIR" "$MAIN"
    note_fn "<build> and <scripts> are distinct directories, neither inside the other" apart "$BUILD_ROOT" "$SELF_DIR"
    note_fn "<scratch>/consumer lies inside <scratch>/tmp, TMPDIR, as change T51 makes it" under "$CONSUMER" "$TMPDIR"
    note_fn "<build> and <target> are distinct directories, neither inside the other" apart "$BUILD_ROOT" "$SHARED_TARGET"
    note_fn "<target>/main and <target>/consumer are distinct directories, neither inside the other (change K35)" apart "$MAIN_TARGET" "$CONSUMER_TARGET"
    apart_ctl() { if apart "$BUILD_ROOT" "$PHASE_DIR"; then return 1; else return 0; fi; }
    note_fn "control: apart refuses a directory inside another (<build> inside <phase>)" apart_ctl
    note "no cargo or rustc process was running at entry" "$(is [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    note "ANTHROPIC_API_KEY is not set" "$(is key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    note "control: the same check refuses a shell where the variable is set" "$(isnot key_set_ctl)"
    echo "DEPARTURE: CARGO_BUILD_JOBS=4 (this box stopped two T0 P6d gate runs for low memory)"
    echo
    echo "## script"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$W/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    # Change T52 (specs/0033 "Planning rulings on P2", ruling 7): the shared
    # library's one mktemp call, counting_controls's control directory, lies
    # under TMPDIR. The controls run once more in a subshell, their output
    # dropped, with mktemp wrapped by a function that records the path the
    # real command printed; TMPDIR is the one given. The library removes the
    # directory itself; the recorded path is checked under TMPDIR, and the
    # control runs the same with TMPDIR set to <build> and refuses the path.
    LIB_MK=$W/lib-mktemp
    lib_mktemp_dirs() {
      (
        : >"$LIB_MK"
        mktemp() { local p; p=$(command mktemp "$@") || return 1; printf '%s\n' "$p" >>"$LIB_MK"; printf '%s\n' "$p"; }
        export TMPDIR=$1
        counting_controls >/dev/null 2>&1
      )
      cat "$LIB_MK"
    }
    LIB_DIRS=$(lib_mktemp_dirs "$TMPDIR")
    LIB_CTL_DIRS=$(lib_mktemp_dirs "$BUILD_ROOT")
    lib_one_under() { [ "$(printf '%s\n' "$1" | count_lines /dev/stdin)" = 1 ] && [ -n "$1" ] && under "$1" "$2"; }
    echo "command: counting_controls run again in a subshell with mktemp wrapped to record its path, TMPDIR the one given: the library's mktemp directory with TMPDIR <scratch>/tmp: $LIB_DIRS; with TMPDIR <build> (the control): $LIB_CTL_DIRS"
    note "the counting library's one mktemp directory lies under TMPDIR (change T52; specs/0033 Planning rulings on P2, ruling 7)" "$(is lib_one_under "$LIB_DIRS" "$TMPDIR")"
    lib_ctl() { lib_one_under "$LIB_CTL_DIRS" "$TMPDIR"; }
    note "control: the same check refuses the directory the library made with TMPDIR set to <build>, which it made there (change T52)" "$(isnot lib_ctl)"
    
    echo
    echo "## the phase base, resolved from git and checked for ambiguity"
    # specs/0001 requires the base to be read from git by the first doc commit's
    # subject, never typed; its parent is the base. The count of doc commits is
    # deliberately NOT asserted; structure_sound below asserts the structure.
    DOC_PATTERN='^M6 part 1 P2: commit planning docs [(]the P1 verification and rulings[)]'
    echo "command: git log --format='%H' --grep='$DOC_PATTERN'"
    git log --format='%H' --grep="$DOC_PATTERN" >"$W/doc-matches"
    nmatch=$(count_lines "$W/doc-matches")
    echo "  commits matching the first doc commit's pattern: $nmatch"
    note "the first doc commit's pattern matches exactly one commit" "$(is [ "$nmatch" = 1 ])"
    DOC=$(git log --format='%H' --grep="$DOC_PATTERN" -n 1)
    BASE=$(git rev-parse --verify "$DOC^" 2>/dev/null)
    echo "  the first doc commit is $DOC"
    echo "  its parent, the phase base, is $BASE"
    note "the base resolved from git, not typed" "$(is [ -n "$BASE" ])"
    CLOSE_REC=$(git log --format='%H' -n 1 --grep='^M6 part 1 P1 record:')
    echo "  P1's record commit, by subject: ${CLOSE_REC:-none found}"
    note "the phase base is P1's record commit" "$(is [ "$BASE" = "$CLOSE_REC" ])"
    note "control: the same comparison refuses the first doc commit as the base" \
      "$(isnot [ "$DOC" = "$CLOSE_REC" ])"
    
    echo
    echo "## the phase's commits"
    echo "command: git log --reverse --format='%H %s' <base>..<phase commit>"
    git log --reverse --format='    %H %s' "$BASE..$C"
    ncommits=$(git rev-list --count "$BASE..$C")
    echo "  commits in the range: $ncommits"
    # Each commit is classified by the paths it touches, and the sequence is
    # checked as one property in one function (changes A45 to A69): a mixed
    # or empty commit fails, the range opens with a doc commit and holds at
    # least one code commit.
    commit_class() {
      git show --name-only --format= "$1" | awk '
        NF { total++; if ($0 ~ /^specs\// || $0 == "ROADMAP.md" || $0 == "CLAUDE.md") docs++ }
        END {
          if (total == 0) { print "empty"; exit }
          if (docs == total) print "doc"; else if (docs == 0) print "code"; else print "mixed"
        }'
    }
    structure_sound() {
      awk 'NR == 1 && $1 != "doc" { bad = 1 }
           $1 == "mixed" || $1 == "empty" { bad = 1 }
           $1 == "code" { code = 1 }
           END { exit (bad || !code || NR == 0) }' "$1"
    }
    : >"$W/classes"
    for h in $(git rev-list --reverse "$BASE..$C"); do
      printf '%s %s\n' "$(commit_class "$h")" "$(git log --format='%h %s' -n 1 "$h")" >>"$W/classes"
    done
    sed 's/^/    /' "$W/classes"
    note "every commit is planning docs alone or code alone, the range opens with a doc commit and holds code (change A69)" \
      "$(is structure_sound "$W/classes")"
    ndoc=$(count_matches -E '^doc ' "$W/classes")
    ncode=$(count_matches -E '^code ' "$W/classes")
    echo "  of the $ncommits commits in the range: $ndoc planning-doc, $ncode code"
    note "the phase holds at least one doc commit, counted in the range" \
      "$(is [ "$ndoc" -ge 1 ])"
    note "control: the same count finds this phase's code commits too" \
      "$(is [ "$ncode" -ge 1 ])"
    note "control: the two classes account for every commit in the range" \
      "$(is [ "$((ndoc + ncode))" = "$ncommits" ])"
    note "control: commit_class calls the first doc commit a doc commit" \
      "$(is [ "$(commit_class "$DOC")" = doc ])"
    # The code-commit control names its commit by what that commit DID: the
    # commit in the range that modified scripts/openpyxl-ops.py, the last such
    # (changes A47 to A69; L59's form: the op commit modifies the ops script).
    CODEC=$(git log --format='%H' -n 1 --diff-filter=M "$BASE..$C" -- scripts/openpyxl-ops.py)
    echo "  the commit in the range that modified scripts/openpyxl-ops.py: ${CODEC:-none found}"
    note "the commit that modified scripts/openpyxl-ops.py resolved from git (change A69)" "$(is [ -n "$CODEC" ])"
    note "control: commit_class calls the commit that modified scripts/openpyxl-ops.py a code commit (change A69)" \
      "$(is [ "$(commit_class "$CODEC")" = code ])"
    note "control: commit_class calls P1's record commit, its logs and records, a code commit (not a doc commit)" \
      "$(is [ "$(commit_class "$CLOSE_REC")" = code ])"
    note "control: the first doc commit carries specs/0038, a path the classifier reads as a doc" \
      "$(is [ "$(git show --name-only --format= "$DOC" | count_matches -Fx specs/0038-chartsheets.md /dev/stdin)" = 1 ])"
    printf 'doc a docs\ncode b code\ndoc c docs\ncode d code\n' >"$W/c-ord-ok"
    printf 'code a code\ndoc b docs\n'                        >"$W/c-ord-first"
    printf 'doc a docs\nmixed b both\ncode c code\n'          >"$W/c-ord-mixed"
    printf 'doc a docs\nempty b nothing\ncode c code\n'       >"$W/c-ord-empty"
    printf 'doc a docs\ndoc b docs\n'                         >"$W/c-ord-nocode"
    note "control: structure_sound accepts docs and code interleaved" \
      "$(is structure_sound "$W/c-ord-ok")"
    note "control: structure_sound rejects a range that opens with a code commit" \
      "$(isnot structure_sound "$W/c-ord-first")"
    note "control: structure_sound rejects a commit mixing docs and code" \
      "$(isnot structure_sound "$W/c-ord-mixed")"
    note "control: structure_sound rejects an empty commit" \
      "$(isnot structure_sound "$W/c-ord-empty")"
    note "control: isnot reports a passing command as UNEXPECTED, so it can fail" \
      "$(is [ "$(isnot true)" = UNEXPECTED ])"
    note "control: structure_sound rejects a range with no code commit" \
      "$(isnot structure_sound "$W/c-ord-nocode")"
    # Change A37, kept (A38): every doc commit before every code commit.
    docs_first() { awk '$1 == "code" { c = 1 } $1 == "doc" && c { bad = 1 } END { exit bad }' "$1"; }
    note "no doc commit follows a code commit in the range (changes A37 to A40, A42 to A69)" "$(is docs_first "$W/classes")"
    printf 'doc a docs\ndoc b docs\ncode c code\ncode d code\n' >"$W/c-ord-first-docs"
    note "control: docs_first accepts two doc commits before two code commits" "$(is docs_first "$W/c-ord-first-docs")"
    note "control: docs_first refuses docs and code interleaved" "$(isnot docs_first "$W/c-ord-ok")"
    
    echo
    echo "## every commit message in the range: ASCII, ending with the Co-Authored-By line only"
    COAUTHOR='Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>'
    msg_form_ok() {
      local last nco nsess nna ntrail
      last=$(awk 'NF { l = $0 } END { print l }' "$1")
      nco=$(count_matches -E '^Co-Authored-By:' "$1")
      nsess=$(count_matches_i -F 'claude-session' "$1")
      nna=$(count_bytes "$NONASCII_CLASS" "$1")
      ntrail=$(git interpret-trailers --parse <"$1" | count_lines /dev/stdin)
      [ "$last" = "$COAUTHOR" ] || return 1
      [ "$nco" = 1 ] || return 1
      [ "$nsess" = 0 ] || return 1
      [ "$ntrail" = 1 ] || return 1
      [ "$nna" = 0 ]
    }
    for h in $(git rev-list --reverse "$BASE..$C"); do
      git log -1 --format=%B "$h" >"$W/msg"
      echo "  $(git log -1 --format=%h "$h"): message lines $(count_lines "$W/msg"), non-ASCII bytes $(count_bytes "$NONASCII_CLASS" "$W/msg"), trailers git parses:"
      git interpret-trailers --parse <"$W/msg" | sed 's/^/      /'
      note "$(git log -1 --format=%h "$h")'s message is ASCII and ends with the Co-Authored-By line only" \
        "$(is msg_form_ok "$W/msg")"
    done
    printf 'subject\n\nbody\n\n%s\n' "$COAUTHOR" >"$W/c-msg-ok"
    printf 'subject\n\nbody\n\n%s\n%s: x\n' "$COAUTHOR" 'Claude-Session' >"$W/c-msg-session"
    printf 'subj\303\251ct\n\n%s\n' "$COAUTHOR" >"$W/c-msg-nonascii"
    printf 'subject\n\n%s\n%s\n' "$COAUTHOR" "$COAUTHOR" >"$W/c-msg-twice"
    printf 'subject\n\nbody\n' >"$W/c-msg-none"
    note "control: msg_form_ok accepts a message ending with the line" "$(is msg_form_ok "$W/c-msg-ok")"
    note "control: msg_form_ok refuses a session line after it" "$(isnot msg_form_ok "$W/c-msg-session")"
    note "control: msg_form_ok refuses a non-ASCII byte" "$(isnot msg_form_ok "$W/c-msg-nonascii")"
    note "control: msg_form_ok refuses the line twice" "$(isnot msg_form_ok "$W/c-msg-twice")"
    note "control: msg_form_ok refuses a message without it" "$(isnot msg_form_ok "$W/c-msg-none")"
    # Change J3 (specs/0018 P2 verification ruling 5 and P3 verification ruling
    # 2, G9, carried in the scan script's form): the count rule on EVERY commit
    # of the phase. A message passes when it carries the diff-alone sentence,
    # read with its line breaks folded, or when it states no count. counts_in
    # prints the numbers left in the body (the trailer dropped) once identifiers
    # are removed: words holding a slash (paths), tokens such as P1 or M2, and the
    # number after "ruling", "decision", "part", "phase" or "section", with any
    # "to" or "and" range after it; what is left, a whole-word number in digits or
    # a number word to twenty, is a count.
    COUNT_SENTENCE='No log prints a count for this commit; the diff alone carries what it changes.'
    says_diff_alone() { tr '\n' ' ' <"$1" | tr -s ' ' | LC_ALL=C "$G" -qF "$COUNT_SENTENCE"; }
    counts_in() {
      python3 -I -B - "$1" <<'COUNTS'
    import re, sys
    text = open(sys.argv[1]).read()
    body = "\n".join(l for l in text.split("\n") if not re.match(r"^Co-Authored-By:", l))
    body = " ".join(body.split())
    body = " ".join(w for w in body.split(" ") if "/" not in w)
    body = re.sub(r"\b[A-Z][0-9]+\b", " ", body)
    num = r"(?:[0-9]+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)"
    body = re.sub(r"\b(?:rulings?|decisions?|parts?|phases?|sections?)\b[^.;:]*?\b" + num + r"\b(?:,? (?:to|and) " + num + r"\b)*", " ", body, flags=re.I)
    for m in re.finditer(r"\b" + num + r"\b", body, flags=re.I):
        print(m.group(0))
    COUNTS
    }
    states_no_count() { [ -z "$(counts_in "$1")" ]; }
    count_rule_ok() { says_diff_alone "$1" || states_no_count "$1"; }
    for h in $(git rev-list --reverse "$BASE..$C"); do
      git log -1 --format=%B "$h" >"$W/msg-rule"
      found=$(counts_in "$W/msg-rule" | tr '\n' ' ')
      sentence=$(says_diff_alone "$W/msg-rule" && echo yes || echo no)
      echo "  $(git log -1 --format=%h "$h"): counts left after the identifiers: ${found:-none}; the diff-alone sentence: $sentence"
      note "$(git log -1 --format=%h "$h")'s message states no count or says the diff alone carries its counts (change J3)" "$(is count_rule_ok "$W/msg-rule")"
    done
    printf 'subject\n\nNo log prints a count for this\ncommit; the diff alone carries what it changes.\n' >"$W/c-msg-folded"
    note "control: says_diff_alone reads the sentence across a line break" "$(is says_diff_alone "$W/c-msg-folded")"
    note "control: says_diff_alone refuses a message without it" "$(isnot says_diff_alone "$W/c-msg-ok")"
    printf 'M6 part 1 P2: x\n\nThe rulings during P1, 1 to 3, and decisions 4 to 6 A; specs/0027-x.md.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-ids"
    printf 'M6 part 1 P2: x\n\nAdds three tests and 14 lines.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-count"
    printf 'M6 part 1 P2: x\n\nAdds three tests. No log prints a count for this commit; the\ndiff alone carries what it changes.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-both"
    note "control: count_rule_ok accepts a message whose numbers are identifiers and a trailer" "$(is count_rule_ok "$W/c-rule-ids")"
    note "control: count_rule_ok refuses a message stating counts without the sentence" "$(isnot count_rule_ok "$W/c-rule-count")"
    note "control: count_rule_ok accepts the same counts beside the sentence" "$(is count_rule_ok "$W/c-rule-both")"
    ctl "counts_in finds the two counts of the refused message, same command form" 2 run_lines counts_in "$W/c-rule-count"
    
    echo
    echo "## the doc commit's files against the hashes of its blobs and against the hashes its own message gives; the lines it removes printed (header change 3; changes B33, B35, D38 to D42, D43 to D49, D50 to D58, D59 to D62, D63, D66 to D69)"
    # The expected values were read from the doc commit's blobs when the
    # generator ran, each checked there against the brief's full hash (changes
    # D63, D66 to D69). Every computed hash is printed by the command that made it.
    echo "  the doc commit: $DOC1"
    blob_sha() { git show "$1:$2" | sha256sum | cut -d' ' -f1; }
    blob_matches() {
      git cat-file -e "$1:$2" 2>/dev/null || return 1
      [ "$(blob_sha "$1" "$2")" = "$3" ]
    }
    while read -r which path given prefix; do
      case "$which" in doc1) at=$DOC1 ;; head) at=$C ;; esac
      if git cat-file -e "$at:$path" 2>/dev/null; then got=$(blob_sha "$at" "$path"); else got=absent; fi
      echo "  $which $(git rev-parse --short "$at") $path"
      echo "    command: git show <commit>:$path | sha256sum"
      echo "    sha256 $got"
      echo "    the doc commit's blob's hash: $given (the prefix planning's brief gave: $prefix)"
      note "$which's $path is the doc commit's blob" "$(is blob_matches "$at" "$path" "$given")"
      note "the hash this check expects begins with the brief's prefix" "$(is [ "${given:0:8}" = "$prefix" ])"
    done <<'HASHES'
    doc1 specs/0038-chartsheets.md 0681b458e3cce8910cb071c18248fe979012b6c5fadfb719c0181395eef0b181 0681b458
    doc1 ROADMAP.md 2a4da8e1861dfb6ca2ddd9fb788b652055f48ee9b8083165ad75baf42b7b2b9a 2a4da8e1
    head specs/0038-chartsheets.md 0681b458e3cce8910cb071c18248fe979012b6c5fadfb719c0181395eef0b181 0681b458
    head ROADMAP.md 2a4da8e1861dfb6ca2ddd9fb788b652055f48ee9b8083165ad75baf42b7b2b9a 2a4da8e1
    HASHES
    TAB=$(printf '\t')
    git show --name-status --format= "$DOC1" | LC_ALL=C sort -k2 >"$W/doc1-files"
    printf '%s\n' "M${TAB}ROADMAP.md" "M${TAB}specs/0038-chartsheets.md" | LC_ALL=C sort -k2 >"$W/doc1-want"
    sed 's/^/    the doc commit carries: /' "$W/doc1-files"
    note "the doc commit modifies specs/0038 and ROADMAP.md, nothing else (change D69)" "$(is cmp -s "$W/doc1-files" "$W/doc1-want")"
    printf '%s\n' "M${TAB}ROADMAP.md" "A${TAB}specs/0038-chartsheets.md" | LC_ALL=C sort -k2 >"$W/c-doc1-status"
    note "control: the comparison refuses specs/0038 added rather than modified (change D69)" "$(isnot cmp -s "$W/c-doc1-status" "$W/doc1-want")"
    note "control: blob_matches refuses the doc commit's ROADMAP.md hash at the base, which holds P1's copy (6f3295e5; change D69)" \
      "$(isnot blob_matches "$BASE" ROADMAP.md 2a4da8e1861dfb6ca2ddd9fb788b652055f48ee9b8083165ad75baf42b7b2b9a)"
    note "control: blob_matches refuses the doc commit's specs/0038 hash at the base, which holds P1's copy (abe3f167; change D69)" \
      "$(isnot blob_matches "$BASE" specs/0038-chartsheets.md 0681b458e3cce8910cb071c18248fe979012b6c5fadfb719c0181395eef0b181)"
    note "control: blob_matches accepts P1's specs/0038 hash at the base, so the check can pass there (change D69)" \
      "$(is blob_matches "$BASE" specs/0038-chartsheets.md abe3f16744752e361c75bf9a8a709f2f68103d884030f754701d83ad8adb3cce)"
    note "control: blob_matches accepts P1's ROADMAP.md hash at the base (change D69)" \
      "$(is blob_matches "$BASE" ROADMAP.md 6f3295e5e2fee47c0066ef4054329fbcc72df13da402804dc924f32828753b9e)"
    # Change R59, kept (D60 to D69; planning's ruling C, specs/0036 "Planning
    # rulings during P1"): the doc commit's own message is read with its line
    # breaks folded, as change J3's says_diff_alone reads it, and for each of
    # the two files the first "sha256 <hash>" after the file's path is taken,
    # whatever words lie between; the pairs are then compared as a set with the
    # two blobs' pairs built the same way.
    git log -1 --format=%B "$DOC1" >"$W/doc1-msg"
    DOC1_PATHS="specs/0038-chartsheets.md ROADMAP.md"
    # msg_hash_pairs <message file> <path>...: "<path> sha256 <hash>" for each
    # path the folded message names with a hash after it.
    msg_hash_pairs() {
      local f=$1
      shift
      tr '\n' ' ' <"$f" | tr -s ' ' | python3 -I -B -c '
    import re, sys
    text = sys.stdin.read()
    for path in sys.argv[1:]:
        m = re.search(r"(?:^|[\s(])" + re.escape(path) + r"(?=[\s,;:)]|$)", text)
        if not m:
            continue
        h = re.search(r"\bsha256 ([0-9a-f]{64})\b", text[m.end():])
        if h:
            print("%s sha256 %s" % (path, h.group(1)))
    ' "$@" | LC_ALL=C sort -u || :
    }
    msg_hash_pairs "$W/doc1-msg" $DOC1_PATHS >"$W/doc1-msg-hashes"
    for path in $DOC1_PATHS; do
      printf '%s sha256 %s\n' "$path" "$(blob_sha "$DOC1" "$path")"
    done | LC_ALL=C sort -u >"$W/doc1-blob-hashes"
    echo "command: git log -1 --format=%B <doc commit>, line breaks folded, for each of the two paths the first 'sha256 <hash>' after it read; and, for the two files, the path, sha256 and git show <doc commit>:<path> | sha256sum (changes R59 and D69; ruling C)"
    sed 's/^/    the doc commit'"'"'s message holds: /' "$W/doc1-msg-hashes"
    sed 's/^/    the doc commit'"'"'s blobs hash: /' "$W/doc1-blob-hashes"
    note "the doc commit's message gives exactly its two blobs' hashes, in full, read folded (changes R59 and D69; ruling C)" "$(is cmp -s "$W/doc1-msg-hashes" "$W/doc1-blob-hashes")"
    # Change R59's controls, kept (D60 to D69): a planted message in b60d4f5's
    # form (a bullet per file, a parenthesis after the path, the hash on the
    # next line) is accepted; the same message with its last hash's last digit
    # changed is refused.
    while read -r path rest; do
      printf -- '- %s (planted words, more of them),\n  sha256\n  %s\n' "$path" "${rest#sha256 }"
    done <"$W/doc1-blob-hashes" >"$W/c-doc1-folded"
    msg_hash_pairs "$W/c-doc1-folded" $DOC1_PATHS >"$W/c-doc1-folded-hashes"
    note "control: the folded reading accepts a planted message in the bullet form, a parenthesis and line breaks between each path and its hash (changes R59 and D69; ruling C)" "$(is cmp -s "$W/c-doc1-folded-hashes" "$W/doc1-blob-hashes")"
    ctl "the pairs in the planted bullet-form message of two, same command form" 2 run_lines msg_hash_pairs "$W/c-doc1-folded" $DOC1_PATHS
    sed '$ s/.$/0/' "$W/c-doc1-folded" >"$W/c-doc1-wrong"
    if cmp -s "$W/c-doc1-wrong" "$W/c-doc1-folded"; then sed '$ s/.$/1/' "$W/c-doc1-folded" >"$W/c-doc1-wrong"; fi
    msg_hash_pairs "$W/c-doc1-wrong" $DOC1_PATHS >"$W/c-doc1-wrong-hashes"
    note "control: the same check refuses the planted message with its last hash differing in its last digit (changes R59 and D69; ruling C)" "$(isnot cmp -s "$W/c-doc1-wrong-hashes" "$W/doc1-blob-hashes")"
    sed '$d' "$W/doc1-want" >"$W/c-doc-short"
    note "control: the file comparison refuses a list one file short" "$(isnot cmp -s "$W/c-doc-short" "$W/doc1-want")"
    # Change D69 (P1's D47, kept): the lines the doc commit removes are
    # planning's text and are printed.
    removed_count() { LC_ALL=C "$G" -E '^-' "$1" | LC_ALL=C "$G" -vcE '^--- ' || :; }
    for path in specs/0038-chartsheets.md ROADMAP.md; do
      git show -U0 --format= "$DOC1" -- "$path" >"$W/doc1-diff"
      echo "command: git show -U0 --format= <doc commit> -- $path, the lines removed (a leading -, not the --- file line)"
      echo "  $path: lines removed $(removed_count "$W/doc1-diff")"
      git show -U0 --format= "$DOC1" -- "$path" | LC_ALL=C "$G" -E '^-' | LC_ALL=C "$G" -vE '^--- ' | sed 's#^#    '"$path"' removes (planning'"'"'s): #' || :
    done
    printf -- '--- a/x\n+++ b/x\n@@ -1,2 +1,1 @@\n-gone line\n' >"$W/c-removed"
    ctl "removed lines in a planted diff of one removal, same command form" 1 removed_count "$W/c-removed"
    
    echo
    echo "## each commit's diff and the phase's combined diff, hashed with the command that produced each"
    for h in $(git rev-list --reverse "$BASE..$C"); do
      cmd="git show --no-color --no-ext-diff --format= $h"
      echo "  command: $cmd | sha256sum"
      echo "    $($cmd | sha256sum | cut -d' ' -f1)  $(git log -1 --format=%s "$h")"
    done
    cmd="git diff --no-color --no-ext-diff $BASE $C"
    echo "  command: $cmd | sha256sum"
    echo "    $($cmd | sha256sum | cut -d' ' -f1)  the phase's combined diff"
    h1=$(git show --no-color --no-ext-diff --format= "$C" | sha256sum | cut -d' ' -f1)
    h2=$(git show --no-color --no-ext-diff --format= "$C" | sha256sum | cut -d' ' -f1)
    h3=$(git show --no-color --no-ext-diff --format= "$C^" | sha256sum | cut -d' ' -f1)
    note "control: the phase commit's diff hashes the same twice" "$(is [ "$h1" = "$h2" ])"
    note "control: its parent's diff hashes differently" "$(isnot [ "$h1" = "$h3" ])"
    
    echo
    echo "## the changed files at the phase commit"
    for f in $(git diff --name-only --diff-filter=d "$BASE" "$C"); do
      git show "$C:$f" >"$W/f" 2>/dev/null || { echo "$f: READ ERROR"; fail=1; continue; }
      echo "$f: sha256 $(sha256sum <"$W/f" | cut -d' ' -f1), bytes $(wc -c <"$W/f"), mode $(git ls-tree "$C" -- "$f" | awk '{print $1}')"
    done
    git diff --name-only --diff-filter=d "$BASE" "$C" >"$W/difffiles"
    echo "  files in the diff: $(count_lines "$W/difffiles")"
    new_mode() { [ "$(git ls-tree "$C" -- "$1" | awk '{print $1}')" = 100755 ]; }
    # Change G37, kept (G38): a modified file keeps its base mode, and an added
    # file is not executable.
    mode_at() { git ls-tree "$1" -- "$2" | awk '{print $1}'; }
    mode_kept() { [ -n "$(mode_at "$BASE" "$1")" ] && [ "$(mode_at "$BASE" "$1")" = "$(mode_at "$C" "$1")" ]; }
    git diff --name-only --diff-filter=A "$BASE" "$C" >"$W/mode-added"
    git diff --name-only --diff-filter=M "$BASE" "$C" >"$W/mode-modified"
    while IFS= read -r m; do
      echo "  $m (modified): mode at the base $(mode_at "$BASE" "$m"); at the phase commit $(mode_at "$C" "$m")"
      note "$m keeps its base mode (change G37)" "$(is mode_kept "$m")"
    done <"$W/mode-modified"
    # Change G63, kept (G65 to G69): the names this phase's checks need, built
    # from pieces: the fixture's, so this text holds no office file name (the
    # header's rule), and the ops test's, the comparison record's test's and
    # the container tool's, so that the count in the areas section reads this
    # script's calls and not its own words.
    XL=xl; SX=sx
    FIXTURE_PATH=tests/fixtures/openpyxl-ops.$XL$SX
    OT_WORD=openpyxl-ops-; OT_WORD=${OT_WORD}test
    CT_WORD=compare-record-; CT_WORD=${CT_WORD}test
    PM_WORD=pod; PM_WORD=${PM_WORD}man
    OT_PATH=scripts/$OT_WORD.sh
    CT_PATH=scripts/$CT_WORD.py
    # Change G69: this phase adds no file; every file it modifies keeps its
    # base mode (above), the ops test's 100755 among them.
    EXEC_ADDED=""
    exec_expected() { case " $EXEC_ADDED " in *" $1 "*) return 0 ;; esac; return 1; }
    nexec=0
    nadded=0
    while IFS= read -r m; do
      echo "  $m (added): mode at the phase commit $(mode_at "$C" "$m")"
      nadded=$((nadded + 1))
      if exec_expected "$m"; then
        note "$m, a script this phase adds under scripts/, is executable" "$(is new_mode "$m")"
        nexec=$((nexec + 1))
      else
        note "$m, added in this phase, is not executable" "$(isnot new_mode "$m")"
      fi
    done <"$W/mode-added"
    echo "  files added in this phase: $nadded"
    git diff --name-only --diff-filter=A "$BASE" "$C" | LC_ALL=C sort >"$W/mode-added-sorted"
    : >"$W/mode-added-want"
    note "the phase adds no file (change G69)" "$(is [ "$nadded.$nexec" = 0.0 ])"
    note "the list of added files is empty (change G69)" "$(is cmp -s "$W/mode-added-sorted" "$W/mode-added-want")"
    printf '%s\n' specs/0038-chartsheets.md >"$W/c-mode-added"
    note "control: the comparison refuses a list of one file, the spec P1 added (change G69)" "$(isnot cmp -s "$W/c-mode-added" "$W/mode-added-want")"
    note "control: exec_expected refuses the comparison record, which part 6 P2 added (change G69)" "$(isnot exec_expected scripts/compare-record.py)"
    ops_test_mode() { [ "$(mode_at "$C" "$OT_PATH")" = 100755 ] && mode_kept "$OT_PATH"; }
    note "the ops test, modified in this phase, keeps its mode 100755 (change G69)" "$(is ops_test_mode)"
    note "control: the same mode check finds the runner executable" "$(is new_mode scripts/passthrough-run.sh)"
    note "control: the same mode check refuses the spec (M3 part 1 P2's change C19, carried)" "$(isnot new_mode specs/0030-carries-and-api-changes.md)"
    mode_kept_ctl() { mode_kept no/such/path/in/either/commit; }
    note "control: mode_kept refuses a path neither commit holds (changes G38 to G40, G42 to G53, kept)" "$(isnot mode_kept_ctl)"
    
    echo
    echo "## the gate files this phase changed, and the self-test they require: none, so no self-test (P1's change F50 reverted to P3's form; change F51)"
    # specs/0001-bootstrap.md, "Rules for every phase": a phase that changes no
    # gate file LISTS IN gate.log the gate files it checked against the diff.
    cat >"$W/gate-files" <<'EOF'
    scripts/check.sh
    scripts/privacy.sh
    scripts/privacy-patterns.txt
    scripts/privacy-identity.txt
    scripts/sys-allowlist.txt
    scripts/install-hooks.sh
    scripts/counting.sh
    scripts/gate-self-test.sh
    .gitignore
    .github/workflows/ci.yml
    EOF
    echo "command: awk over specs/0001-bootstrap.md, the bullet opening '- A phase that changes a gate file' up to its first 'runs', backticked names"
    git show "$C:specs/0001-bootstrap.md" | awk '/^- A phase that changes a gate file/ { on = 1 } on { print } on && /runs/ { exit }' >"$W/gate-sentence"
    sed 's/^/    /' "$W/gate-sentence"
    tr -d '\n' <"$W/gate-sentence" | LC_ALL=C "$G" -o -E '`[^`]+`' | tr -d '`' | LC_ALL=C "$G" -v -E ' ' | sort >"$W/gate-from-spec"
    LC_ALL=C "$G" -v -Fx .github/workflows/ci.yml "$W/gate-files" | sort >"$W/gate-typed"
    sed 's/^/    named in specs\/0001: /' "$W/gate-from-spec"
    ci_named() { [ "$(count_matches -F 'the CI workflow' "$W/gate-sentence")" = 1 ]; }
    note "the typed gate-file list is specs/0001's backticked names plus the CI workflow" "$(is cmp -s "$W/gate-from-spec" "$W/gate-typed")"
    note "specs/0001's sentence names the CI workflow" "$(is ci_named)"
    LC_ALL=C "$G" -v -Fx scripts/counting.sh "$W/gate-typed" >"$W/c-gate-typed"
    note "control: the comparison refuses the typed list one name short" "$(isnot cmp -s "$W/gate-from-spec" "$W/c-gate-typed")"
    echo "  the gate files specs/0001 names, each checked against the phase diff:"
    sed 's/^/    checked: /' "$W/gate-files"
    touched=0
    while IFS= read -r g; do
      if LC_ALL=C "$G" -Fxq -- "$g" "$W/difffiles"; then
        echo "  gate file in the diff: $g"
        touched=$((touched + 1))
      fi
    done <"$W/gate-files"
    echo "  gate files checked: $(count_lines "$W/gate-files"); of them in the phase diff: $touched"
    note "no gate file is in the phase diff, so specs/0001 asks for this listing and no self-test (changes F38, F40 and F51)" \
      "$(is [ "$touched" = 0 ])"
    # Change F51: the same search over P1's scripts commit, which changed the
    # gate file scripts/check.sh, finds it: the control that the search can
    # find a gate file.
    P1_SCR=$(git log --format='%H' -n 1 -F --grep='M5 part 2 P1: committed scripts call python3 with -I -B' "$C")
    echo "  P1's scripts commit, by subject: ${P1_SCR:-none found}"
    git show --name-only --format= "$P1_SCR" >"$W/c-p1-scr-files"
    p1_touched=0
    while IFS= read -r g; do
      if LC_ALL=C "$G" -Fxq -- "$g" "$W/c-p1-scr-files"; then
        echo "    gate file in P1's scripts commit: $g"
        p1_touched=$((p1_touched + 1))
      fi
    done <"$W/gate-files"
    note "control: the same search over P1's scripts commit finds its one gate file, scripts/check.sh (change F51)" \
      "$(is [ "$p1_touched" = 1 ])"
    FIRST_DIFF=$(sed -n '1p' "$W/difffiles")
    echo "  a file that IS in the phase diff, taken from the diff: $FIRST_DIFF"
    found_first=$(count_matches -Fx "$FIRST_DIFF" "$W/difffiles")
    note "control: the same search finds a name the diff does hold" \
      "$(is [ "$found_first" -ge 1 ])"
    in_diff_not_gate() {
      [ "$(count_matches -Fx "$1" "$W/difffiles")" = 1 ] &&
        [ "$(count_matches -Fx "$1" "$W/gate-files")" = 0 ]
    }
    # Every file the phase diff holds, read from the diff rather than typed.
    while IFS= read -r s; do
      echo "  $s: in the phase diff $(count_matches -Fx "$s" "$W/difffiles") times; in the gate-file list $(count_matches -Fx "$s" "$W/gate-files") times"
      note "$s is in the diff and is not a gate file" "$(is in_diff_not_gate "$s")"
    done <"$W/difffiles"
    gate_ctl() { in_diff_not_gate scripts/counting.sh; }
    note "control: in_diff_not_gate refuses a gate file the phase diff does not hold (scripts/counting.sh)" "$(isnot gate_ctl)"
    ST=records/logs/m6p1-p2/self-test.log
    echo "  $ST: $([ -e "$ST" ] && echo PRESENT || echo "absent, as a phase with no gate-file change requires")"
    note "this phase committed no self-test log, having changed no gate file (changes F38, F40 to F46, F47 to F49, F51; kept)" \
      "$(is [ ! -e "$ST" ])"
    
    echo
    echo "## each code commit touches its own files, with the status git gives each; the tree at the phase commit the base's outside the phase's files; no manifest and no lock; two Rust sources, both under crates/emend/src; the op commit's two files under scripts/; CHANGELOG.md, README.md and scripts/passthrough-run.sh not in the range; the crate's messages the base's, none added and none gone; this script runs neither the ops test, the comparison record's test nor the container tool (change E69; changes E53 to E68 and D35's form)"
    TAB=$(printf '\t')
    # FIXTURE_PATH, OT_PATH, OT_WORD, CT_PATH, CT_WORD and PM_WORD are set
    # above, with the modes.
    # Change E69: the carry commit's one file, the op commit's two (the ops
    # test's path is OT_PATH, built from pieces above) and the limits commit's
    # one, each modified.
    printf '%s\n' "M${TAB}crates/emend/src/package/tests/chartsheet.rs" | LC_ALL=C sort -k2 >"$W/area-want-CARRY"
    printf '%s\n' "M${TAB}scripts/openpyxl-ops.py" "M${TAB}$OT_PATH" | LC_ALL=C sort -k2 >"$W/area-want-OPC"
    printf '%s\n' "M${TAB}crates/emend/src/package.rs" | LC_ALL=C sort -k2 >"$W/area-want-LIMITS"
    for pair in CARRY:carry OPC:op LIMITS:limits; do
      role=${pair%%:*}; label=${pair#*:}
      at=${!role}
      echo "command: git show --name-status --format= <the $label commit> | sort -k2"
      git show --name-status --format= "$at" | LC_ALL=C sort -k2 >"$W/area-$role"
      sed 's/^/    /' "$W/area-$role"
      note "the $label commit's files are the ones FACTS.md gives, with the status git gives each (change E69)" "$(is cmp -s "$W/area-$role" "$W/area-want-$role")"
    done
    note "control: the comparison refuses the op commit's files given as the carry commit's (change E69)" "$(isnot cmp -s "$W/area-OPC" "$W/area-want-CARRY")"
    note "control: the comparison refuses the limits commit's files given as the carry commit's (change E69)" "$(isnot cmp -s "$W/area-LIMITS" "$W/area-want-CARRY")"
    sed "s#^M${TAB}crates/emend/src/package/tests/chartsheet.rs\$#A${TAB}crates/emend/src/package/tests/chartsheet.rs#" "$W/area-want-CARRY" >"$W/c-area"
    note "control: the planted list differs from the expectation (the chartsheet tests added rather than modified)" "$(isnot cmp -s "$W/c-area" "$W/area-want-CARRY")"
    note "control: the comparison refuses the chartsheet tests added rather than modified" "$(isnot cmp -s "$W/c-area" "$W/area-CARRY")"
    # same_outside <a> <b> <path>...: git diff --quiet between the two commits
    # over every path but the ones given.
    PHASE_FILES="specs/0038-chartsheets.md ROADMAP.md $(cut -f2 "$W/area-want-CARRY" "$W/area-want-OPC" "$W/area-want-LIMITS" | LC_ALL=C sort -u | tr '\n' ' ')"
    same_outside() {
      local a=$1 b=$2 p
      shift 2
      local spec=(.)
      for p in "$@"; do spec+=(":!$p"); done
      git diff --quiet "$a" "$b" -- "${spec[@]}"
    }
    echo "command: git diff --stat <base> <phase commit> -- . ':!<each of the phase's files>'"
    echo "  the phase's files: $PHASE_FILES"
    same_spec=(.)
    for p in $PHASE_FILES; do same_spec+=(":!$p"); done
    git diff --stat "$BASE" "$C" -- "${same_spec[@]}" | sed 's/^/    /'
    note "the tree at the phase commit is the base's outside the phase's files (change E69)" "$(is same_outside "$BASE" "$C" $PHASE_FILES)"
    same_ctl() { same_outside "$BASE" "$C" $(printf '%s\n' $PHASE_FILES | LC_ALL=C "$G" -vFx crates/emend/src/package.rs); }
    note "control: the same check refuses the exclusions with crates/emend/src/package.rs left out (change E69)" "$(isnot same_ctl)"
    echo "command: git diff --name-only <base> <phase commit>"
    git diff --name-only "$BASE" "$C" | LC_ALL=C sort >"$W/phase-names"
    sed 's/^/    /' "$W/phase-names"
    printf '%s\n' $PHASE_FILES | LC_ALL=C sort >"$W/phase-names-want"
    note "the phase diff is the doc commit's two files and the code commits' four, nothing else (change E69)" "$(is cmp -s "$W/phase-names" "$W/phase-names-want")"
    sed '1d' "$W/phase-names-want" >"$W/c-phase-names"
    note "control: the comparison refuses the list one file short (change E69)" "$(isnot cmp -s "$W/phase-names" "$W/c-phase-names")"
    # Change E69: no manifest and no lock in the phase diff; the crate manifest
    # at the phase commit still declares charts with no dependency and no
    # default feature (part 3 P1's E53, read again).
    nlock=$(count_matches -Fx Cargo.lock "$W/difffiles")
    LC_ALL=C "$G" -E '(^|/)Cargo[.]toml$' "$W/difffiles" | LC_ALL=C sort >"$W/manifests" || :
    nmanifest=$(count_lines "$W/manifests")
    echo "  Cargo.lock in the phase diff: $nlock; manifests in the phase diff: $nmanifest"
    sed 's/^/    manifest in the phase diff: /' "$W/manifests"
    note "the phase changes no Cargo.lock (change E69)" "$(is [ "$nlock" = 0 ])"
    note "the phase changes no manifest (change E69)" "$(is [ "$nmanifest" = 0 ])"
    manifests_in() { git show --name-only --format= "$1" | count_matches -E '(^|/)Cargo[.]toml$' /dev/stdin; }
    echo "  manifests touched: by the doc commit $(manifests_in "$DOC1"), by the carry commit $(manifests_in "$CARRY"), by the op commit $(manifests_in "$OPC"), by the limits commit $(manifests_in "$LIMITS")"
    P31_MAN_C=$(git log --format='%H' -n 1 -F --grep='M5 part 3 P1: charts read, the anchors, the plots and series' "$C")
    echo "  part 3 P1's crate commit, by subject: ${P31_MAN_C:-none found}; manifests it touched: $(manifests_in "$P31_MAN_C")"
    note "control: the same count reads 1 over part 3 P1's crate commit, which added the feature" "$(is [ "$(manifests_in "$P31_MAN_C")" = 1 ])"
    printf 'Cargo.lock\ntools/xlsx-diff/Cargo.toml\n' >"$W/c-lock"
    ctl "a lock file in a list, same command form" 1 count_matches -Fx Cargo.lock "$W/c-lock"
    ctl "a manifest in a list, same command form" 1 count_matches -E '(^|/)Cargo[.]toml$' "$W/c-lock"
    git show "$C:crates/emend/Cargo.toml" >"$W/crate-manifest"
    ncharts=$(count_matches -Fx 'charts = []' "$W/crate-manifest")
    ndefault=$(count_matches -E '^[[:space:]]*default[[:space:]]*=' "$W/crate-manifest")
    echo "  in the crate manifest at the phase commit: 'charts = []' lines $ncharts; default-feature lines $ndefault"
    note "the crate manifest declares charts with no dependency (change E53, kept)" "$(is [ "$ncharts" = 1 ])"
    note "the crate manifest declares no default feature, so charts is off by default (change E53, kept)" "$(is [ "$ndefault" = 0 ])"
    printf '[features]\ndefault = ["charts"]\ncharts = []\n' >"$W/c-default"
    ctl "a default-feature line in a manifest, same command form" 1 count_matches -E '^[[:space:]]*default[[:space:]]*=' "$W/c-default"
    # Change E69 (specs/0038 "P2: the openpyxl fixture and the catalogue"):
    # the Rust sources in the diff are the carry commit's one and the limits
    # commit's one, both under crates/emend/src; nothing under tools/; the files
    # under scripts/ the op commit's two.
    rs_in() { git show --name-only --format= "$1" | count_matches -E '[.]rs$' /dev/stdin; }
    LC_ALL=C "$G" -E '[.]rs$' "$W/difffiles" | LC_ALL=C sort >"$W/rs-files"
    cut -f2 "$W/area-want-CARRY" "$W/area-want-LIMITS" | LC_ALL=C sort >"$W/rs-want"
    nrs=$(count_lines "$W/rs-files")
    ncrates=$(git diff --name-only "$BASE" "$C" -- crates | count_lines /dev/stdin)
    ntools=$(git diff --name-only "$BASE" "$C" -- tools | count_lines /dev/stdin)
    echo "  Rust sources in the phase diff: $nrs; files under crates/ in the phase diff: $ncrates; under tools/: $ntools"
    sed 's/^/    Rust source in the phase diff: /' "$W/rs-files"
    note "the Rust sources in the phase diff are the carry commit's one and the limits commit's one (change E69)" "$(is cmp -s "$W/rs-files" "$W/rs-want")"
    note "the files under crates/ in the phase diff are those two (change E69)" "$(is [ "$ncrates" = 2 ])"
    note "nothing under tools/ is in the phase diff (change E69)" "$(is [ "$ntools" = 0 ])"
    note "the carry commit holds one Rust source, the op commit none and the limits commit one (change E69)" "$(is [ "$(rs_in "$CARRY").$(rs_in "$OPC").$(rs_in "$LIMITS")" = 1.0.1 ])"
    echo "  part 5 P4's probe commit, by subject: ${P54_PROBEC:-none found}; Rust sources it touched: $(rs_in "$P54_PROBEC")"
    note "control: the same count reads 4 over part 5 P4's probe commit (changes E63, E65 to E69)" "$(is [ "$(rs_in "$P54_PROBEC")" = 4 ])"
    sed '1d' "$W/rs-want" >"$W/c-rs-short"
    note "control: the source comparison refuses the list one file short (change E69)" "$(isnot cmp -s "$W/rs-files" "$W/c-rs-short")"
    scripts_in_range() { git diff --name-only "$1" "$2" -- 'scripts/*' | count_lines /dev/stdin; }
    nscr=$(scripts_in_range "$BASE" "$C")
    echo "  files under scripts/ changed in the range: $nscr"
    git diff --name-only "$BASE" "$C" -- 'scripts/*' | LC_ALL=C sort >"$W/scripts-in-range"
    cut -f2 "$W/area-want-OPC" | LC_ALL=C sort >"$W/scripts-in-range-want"
    sed 's/^/    /' "$W/scripts-in-range"
    note "the files under scripts/ changed in the range are the op commit's two, scripts/openpyxl-ops.py and the ops test (change E69)" "$(is cmp -s "$W/scripts-in-range" "$W/scripts-in-range-want")"
    P1_SCRIPTS_A=$(git log --format='%H' -n 1 -F --grep='M5 part 2 P1: committed scripts call python3 with -I -B' "$C")
    echo "  M5 part 2 P1's scripts commit, by subject: ${P1_SCRIPTS_A:-none found}"
    scr_ctl() { [ -n "$P1_SCRIPTS_A" ] && [ "$(scripts_in_range "$P1_SCRIPTS_A^" "$P1_SCRIPTS_A")" = 3 ]; }
    note "control: the same count reads 3 over M5 part 2 P1's scripts commit" "$(is scr_ctl)"
    note "control: the scripts comparison refuses the list one file short (change E69)" "$(isnot cmp -s "$W/scripts-in-range" <(sed '1d' "$W/scripts-in-range-want"))"
    # CHANGELOG.md is not in the range (specs/0038 "Phases": its bullet is
    # P3's), nor are README.md and scripts/passthrough-run.sh (change E69).
    not_in_range() { [ "$(git diff --name-only "$1" "$2" -- "$3" | count_lines /dev/stdin)" = 0 ]; }
    for f in CHANGELOG.md README.md scripts/passthrough-run.sh; do
      echo "command: git diff --name-only <base> <phase commit> -- $f"
      git diff --name-only "$BASE" "$C" -- "$f" | sed 's/^/    /'
      note "$f is not in the range's diff (change E69)" "$(is not_in_range "$BASE" "$C" "$f")"
    done
    changelog_ctl() { [ -n "$P54_LOGC" ] && not_in_range "$P54_LOGC^" "$P54_LOGC" CHANGELOG.md; }
    note "control: not_in_range refuses part 5 P4's CHANGELOG commit, which changed CHANGELOG.md (changes E63, E65 to E69)" "$(isnot changelog_ctl)"
    README_C=$(git log --format='%H' -n 1 -F --grep="M3 part 7 P5: the README's two sentences")
    echo "  M3 part 7 P5's README commit, by subject: ${README_C:-none found}"
    readme_ctl() { [ -n "$README_C" ] && not_in_range "$README_C^" "$README_C" README.md; }
    note "control: not_in_range refuses M3 part 7 P5's README commit, which changed it" "$(isnot readme_ctl)"
    # The crate's messages: every Error::Package("...") string under
    # crates/emend/src, as a set: at the phase commit the base's, none added and
    # none gone (change E69; planning's P1 verification ruling G: P1 added the
    # part's three and catalogued them, so this phase's catalogue is the
    # limits alone).
    messages_set() { git grep -h -o -E 'Error::Package[(]"[^"]*"[)]' "$1" -- crates/emend/src | LC_ALL=C sort -u; }
    messages_set "$BASE" >"$W/msgs-base"
    messages_set "$C" >"$W/msgs-head"
    echo "command: git grep -h -o -E 'Error::Package[(]\"[^\"]*\"[)]' <commit> -- crates/emend/src | sort -u, at the base and at the phase commit"
    echo "  distinct messages at the base: $(count_lines "$W/msgs-base"); at the phase commit: $(count_lines "$W/msgs-head")"
    LC_ALL=C comm -13 "$W/msgs-base" "$W/msgs-head" | sed 's/^/    new at the phase commit: /'
    LC_ALL=C comm -23 "$W/msgs-base" "$W/msgs-head" | sed 's/^/    gone at the phase commit: /'
    note "the crate's Error::Package messages are the base's, none added and none gone, as a set (changes E40, E63, E65 to E69)" "$(is cmp -s "$W/msgs-head" "$W/msgs-base")"
    note "some messages were read" "$(is [ "$(count_lines "$W/msgs-head")" -ge 1 ])"
    note "the base's set holds P1's three (change E69)" "$(is [ "$(count_matches -F 'chartsheet' "$W/msgs-base")" = 3 ])"
    { cat "$W/msgs-base"; printf '%s\n' 'Error::Package("a planted message")'; } | LC_ALL=C sort -u >"$W/c-msgs-extra"
    note "control: the comparison refuses the base's set with a message added (change E69)" "$(isnot cmp -s "$W/msgs-head" "$W/c-msgs-extra")"
    LC_ALL=C "$G" -vF 'chartsheet' "$W/msgs-base" >"$W/c-msgs-short"
    note "control: the comparison refuses the base's set with P1's three left out (change E69)" "$(isnot cmp -s "$W/msgs-head" "$W/c-msgs-short")"
    # Change E65, kept (E66 to E69): no line of this script outside a comment
    # names the ops test, the comparison record's test or the container tool.
    # The three words are built from pieces, so the count reads this script's
    # own calls and not its pattern.
    runs_named() { awk -v a="$OT_WORD" -v b="$PM_WORD" -v c="$CT_WORD" '{ t = $0; sub(/^[[:space:]]+/, "", t) } substr(t, 1, 1) != "#" && (index($0, a) || index($0, b) || index($0, c)) { n++ } END { print n + 0 }' "$1"; }
    echo "command: the non-comment lines of this script naming the ops test, the comparison record's test or the container tool"
    echo "  lines: $(runs_named "$SELF")"
    note "this script runs neither the ops test, $OT_PATH, the comparison record's test, $CT_PATH, nor the container tool (change E69)" "$(is [ "$(runs_named "$SELF")" = 0 ])"
    printf '%s\n' "# $PM_WORD run in a comment" "x=\$($PM_WORD run img)" "bash scripts/$OT_WORD.sh img" "./scripts/$CT_WORD.py" "y=1" >"$W/c-runs"
    ctl "lines naming any of the three in a planted file of five, a comment and three calls among them, same command form (change E69)" 3 runs_named "$W/c-runs"
    
    echo
    echo "## every script under scripts/ parses or compiles at the phase commit (changes H37 to H40, H42 to H50)"
    parse_ok() { bash -n "$1" 2>/dev/null; }
    echo "command: git ls-tree --name-only <phase commit> scripts/, each .sh through bash -n and each .py through py_compile (doraise)"
    git ls-tree --name-only "$C" scripts/ >"$W/scripts-all"
    nsh=0; npyall=0
    while IFS= read -r s; do
      case "$s" in
        *.sh)
          git show "$C:$s" >"$W/parse.sh"
          note "$s parses at the phase commit" "$(is parse_ok "$W/parse.sh")"
          nsh=$((nsh + 1)) ;;
      esac
    done <"$W/scripts-all"
    printf 'if then\n' >"$W/c-parse.sh"
    note "control: the same parse refuses a broken if" "$(isnot parse_ok "$W/c-parse.sh")"
    echo "command: python3 -I -B --version"
    python3 -I -B --version 2>&1 | sed 's/^/    /'
    py_compiles() { python3 -I -B -c 'import py_compile, sys; py_compile.compile(sys.argv[1], cfile=sys.argv[2], doraise=True)' "$1" "$W/compiled.pyc" 2>/dev/null; }
    while IFS= read -r s; do
      case "$s" in
        *.py)
          git show "$C:$s" >"$W/compiled.py"
          note "$s compiles at the phase commit (py_compile, doraise)" "$(is py_compiles "$W/compiled.py")"
          npyall=$((npyall + 1)) ;;
      esac
    done <"$W/scripts-all"
    echo "  shell scripts parsed: $nsh; Python scripts compiled: $npyall"
    both_read() { [ "$nsh" -ge 1 ] && [ "$npyall" -ge 1 ]; }
    note "some shell scripts and some Python scripts were read" "$(is both_read)"
    printf 'def f(:\n    pass\n' >"$W/c-broken.py"
    note "control: the same compile refuses a broken def" "$(isnot py_compiles "$W/c-broken.py")"
    LC_ALL=C "$G" -E '[.]py$' "$W/difffiles" >"$W/py-in-diff" || :
    # Change H69: one Python script is in the phase diff, the op commit's
    # scripts/openpyxl-ops.py, compiled above with every Python script under
    # scripts/.
    printf '%s\n' scripts/openpyxl-ops.py >"$W/py-in-diff-want"
    echo "  Python scripts in the phase diff: $(count_lines "$W/py-in-diff")"
    sed 's/^/    /' "$W/py-in-diff"
    note "the one Python script in the phase diff is scripts/openpyxl-ops.py (change H69)" "$(is cmp -s "$W/py-in-diff" "$W/py-in-diff-want")"
    printf 'scripts/compare-record.py\n' >"$W/c-py-one"
    note "control: the comparison refuses a list of one, the comparison record alone (change H69)" "$(isnot cmp -s "$W/c-py-one" "$W/py-in-diff-want")"
    printf 'scripts/scale-gen.py\ncrates/emend/src/package.rs\n' >"$W/c-py"
    ctl "one Python script in a list of two, same command form" 1 count_matches -E '[.]py$' "$W/c-py"
    
    echo
    echo "## no committed script under scripts/ calls Python without -B, at the phase commit (changes H50 and H51; specs/0032 \"Planning verification and rulings on P3\", ruling 4)"
    # scripts_py <commit> <prefix>: every file under scripts/ at the commit,
    # its calls listed into <prefix>.calls as "<path>:<line> <I> <B>".
    scripts_py() {
      local at=$1 out=$2 f
      : >"$out.calls"
      nscanned=0
      for f in $(git ls-tree -r --name-only "$at" -- scripts); do
        git show "$at:$f" >"$W/pyb-file"
        py_calls "$W/pyb-file" | sed "s#^#$f:#" >>"$out.calls"
        nscanned=$((nscanned + 1))
      done
    }
    no_b() { awk '$3 == 0' "$1" | count_lines /dev/stdin; }
    echo "command: git ls-tree -r --name-only <phase commit> -- scripts; each file read with git show and its Python calls listed by the rule above"
    scripts_py "$C" "$W/pyb-head"
    ncalls=$(count_lines "$W/pyb-head.calls")
    nnob=$(no_b "$W/pyb-head.calls")
    echo "  files scanned: $nscanned; Python calls: $ncalls; calls without -B: $nnob"
    echo "  the calls, each <path>:<line> <-I given> <-B given>:"
    sed 's/^/    /' "$W/pyb-head.calls"
    note "some files were scanned" "$(is [ "$nscanned" -ge 1 ])"
    note "no committed script under scripts/ calls Python without -B at the phase commit (change H50)" "$(is [ "$nnob" = 0 ])"
    awk '{ split($1, a, ":"); print a[1] }' "$W/pyb-head.calls" | LC_ALL=C sort | uniq -c | awk '{ print $2, $1 }' >"$W/pyb-per-file"
    # Change H69 (H63's form): every file's calls, read from the phase commit
    # by this same reader when the generator ran, P1's: the op commit adds
    # Python code to the ops script and a check to its test, no Python call;
    # the ops test's name is OT_PATH, built from pieces above.
    printf '%s\n' "scripts/check.sh 1" "scripts/compare-run.sh 2" "scripts/edit-open-check.sh 2" "scripts/lo-check.sh 1" "$OT_PATH 7" "scripts/openpyxl-ops.py 1" "scripts/passthrough-record.py 1" | LC_ALL=C sort >"$W/pyb-per-file-want"
    echo "  calls per file:"; sed 's/^/    /' "$W/pyb-per-file"
    note "the calls per file are the ones the generator read: check.sh's 1, compare-run.sh's 2, edit-open-check.sh's 2, lo-check.sh's 1, the ops test's 7, openpyxl-ops.py's 1, passthrough-record.py's 1 (changes H50, H63, H65 to H69)" "$(is cmp -s "$W/pyb-per-file" "$W/pyb-per-file-want")"
    # Change H51: the base holds no call without -B now; the control by
    # history reads the parent of P1's scripts commit, found by its subject.
    P1_SCRIPTS=$(git log --format='%H' -n 1 -F --grep='M5 part 2 P1: committed scripts call python3 with -I -B' "$C")
    echo "  P1's scripts commit, by subject: ${P1_SCRIPTS:-none found}"
    echo "command: the same over the scripts/ of P1's scripts commit's parent (the control by history: the four calls before that commit)"
    scripts_py "$P1_SCRIPTS^" "$W/pyb-base"
    nnob_base=$(no_b "$W/pyb-base.calls")
    echo "  at P1's scripts commit's parent: files scanned $nscanned; Python calls $(count_lines "$W/pyb-base.calls"); calls without -B $nnob_base"
    note "control: the same count finds the four calls without -B there (change H51)" "$(is [ "$nnob_base" = 4 ])"
    scripts_py "$BASE" "$W/pyb-base2"
    echo "  at the base: Python calls $(count_lines "$W/pyb-base2.calls"); calls without -B $(no_b "$W/pyb-base2.calls")"
    note "the base holds no call without -B either (change H51)" "$(is [ "$(no_b "$W/pyb-base2.calls")" = 0 ])"
    printf '%s\n' "x=\$($PYW -c 'x')" "y=\$($PYW -I -B -c 'x')" "# $PYW -c 'x'" "command -v $PYW" >"$W/c-pyb-fixture"
    printf '%s\n' "x=1" >"$W/c-pyb-plain"
    note "control: the planted fixture differs from a file with no call (cmp)" "$(isnot cmp -s "$W/c-pyb-fixture" "$W/c-pyb-plain")"
    py_calls "$W/c-pyb-fixture" >"$W/c-pyb.calls"
    ctl "Python calls in a planted fixture of four lines (two calls, a comment, a lookup), same command form" 2 count_lines "$W/c-pyb.calls"
    ctl "calls without -B in the same fixture, same command form" 1 no_b "$W/c-pyb.calls"
    printf '%s\n' "$PYW -IB x.py" "$PYW x.py" "$PYW -Bc 'x'" "for t in $PYW sed; do :; done" >"$W/c-pyb-forms"
    py_calls "$W/c-pyb-forms" >"$W/c-pyb-forms.calls"
    ctl "calls in a planted fixture of a bundled -IB, a bare .py, a bundled -Bc and a word list, same command form" 3 count_lines "$W/c-pyb-forms.calls"
    ctl "calls without -B in the same fixture (the bare .py), same command form" 1 no_b "$W/c-pyb-forms.calls"
    
    echo
    echo "## the new sources scored against the gate they must pass, with controls"
    OFF=$(git show "$C:scripts/check.sh" | sed -n "s/^readonly OFFICE_RE='\(.*\)'\$/\1/p")
    note "OFFICE_RE was read from check.sh and is non-empty" "$(is [ -n "$OFF" ])"
    PRE_COMMIT=$(git log --format='%H' --grep='^T0 P6d: narrow the three path patterns' -n 1)
    note "the P6d narrowing commit resolved from git" "$(is [ -n "$PRE_COMMIT" ])"
    git show "$PRE_COMMIT^:scripts/privacy-patterns.txt" >"$W/pre-all" 2>/dev/null || fail=1
    sed -n '8p;10p;11p' "$W/pre-all" >"$W/pre-patterns"
    note "three pre-P6d forms read from the narrowing commit's parent" \
      "$(is [ "$(count_lines "$W/pre-patterns")" = 3 ])"
    git show "$C:scripts/privacy-patterns.txt" >"$W/live-patterns"
    
    f_nonascii() { count_bytes "$NONASCII_CLASS" "$1"; }
    f_ctrl()     { count_bytes "$CTRL_CLASS" "$1"; }
    f_live()     { count_from_file -E "$W/live-patterns" "$1"; }
    f_pre()      { count_from_file -E "$W/pre-patterns" "$1"; }
    f_office()   { count_matches -E "$OFF" "$1"; }
    # P1 gate header change 7, kept: an office extension whose file name is a literal, the
    # name running back from the extension to a space, a quote, a slash, an
    # equals sign or the line's start with no shell expansion in it.
    f_office_literal() { count_matches -E "(^|[ \"'=/])[^ \"'=/\$]+$OFF" "$1"; }
    
    rep() { printf "$1%.0s" $(seq 1 "$2"); }
    printf 'plain\nhas \303\251 byte\n' >"$W/c-nonascii"
    printf 'x \033[31mred\033[m\017 y\n' >"$W/c-ctrl"
    printf 'x %s%s%s y\n' 'gh' 'p_' "$(rep a 24)" >"$W/c-live"
    printf 'x %s%s%s y\n' '/mnt/' 'c/' 'Users/' >"$W/c-pre"
    printf 'name.%s%s\n' 'xl' 'sx' >"$W/c-office"
    printf 'input=$KEEP/$test.in.%s%s\n' 'xl' 'sx' >"$W/c-office-expanded"
    printf 'plain ascii only\n' >"$W/c-clean"
    ctl "f_nonascii on a two-byte character" 2 f_nonascii "$W/c-nonascii"
    ctl "f_ctrl on ESC, ESC and SI" 3 f_ctrl "$W/c-ctrl"
    ctl "f_live on a token shape" 1 f_live "$W/c-live"
    ctl "f_pre on a bare path shape" 1 f_pre "$W/c-pre"
    ctl "f_office on an office file name" 1 f_office "$W/c-office"
    ctl "f_office_literal on the same literal name" 1 f_office_literal "$W/c-office"
    ctl "f_office on a name built from variables" 1 f_office "$W/c-office-expanded"
    ctl "f_office_literal on the same built name" 0 f_office_literal "$W/c-office-expanded"
    for f in f_nonascii f_ctrl f_live f_pre f_office f_office_literal; do
      ctl "$f on a clean file" 0 "$f" "$W/c-clean"
    done
    # Change O63: a literal office name in an added text file is allowed when
    # it is one of the four the phase needs, each built from pieces: the
    # fixture's own name, the name the ops test mounts it under in the
    # container, the corpus manifest's (the passthrough runner names it at
    # the base) and the comparison runner's run table. f_office_other counts
    # the literal-name lines left once those four are removed.
    TS=ts; TV=v
    OFFICE_ALLOWED="openpyxl-ops.$XL$SX fixture.$XL$SX manifest.$TS$TV run.openpyxl.$TS$TV"
    f_office_other() {
      local n e
      cp "$1" "$W/office-other" || return 1
      for n in $OFFICE_ALLOWED; do
        e=$(printf '%s' "$n" | sed 's/[.]/[.]/g')
        sed -E -i "s#(^|[ \"'=/])$e#\\1#g" "$W/office-other"
      done
      f_office_literal "$W/office-other"
    }
    clean_source() {
      [ "$(f_nonascii "$1")" = 0 ] && [ "$(f_ctrl "$1")" = 0 ] &&
        [ "$(f_live "$1")" = 0 ] && [ "$(f_pre "$1")" = 0 ] && [ "$(f_office_other "$1")" = 0 ]
    }
    printf 'm=$CORPUS/manifest.%s%s\nf=/in/fixture.%s%s:ro\n' "$TS" "$TV" "$XL" "$SX" >"$W/c-office-allowed"
    ctl "f_office_literal on two allowed literal names, same command form (change O63)" 2 f_office_literal "$W/c-office-allowed"
    ctl "f_office_other on the same two, same command form (change O63)" 0 f_office_other "$W/c-office-allowed"
    ctl "f_office_other on a literal name not allowed, same command form (change O63)" 1 f_office_other "$W/c-office"
    printf 'x=/in/myfixture.%s%s\n' "$XL" "$SX" >"$W/c-office-near"
    ctl "f_office_other on a name that only ends like an allowed one, same command form (change O63)" 1 f_office_other "$W/c-office-near"
    
    git diff --name-only --diff-filter=A "$BASE" "$C" >"$W/added"
    echo "  files added in this phase: $(count_lines "$W/added")"
    nscored=0
    # Change O63: the committed fixture, a binary, is not scored as text; its
    # bytes are checked against the sha256 tests/fixtures/README.md gives,
    # read at the phase commit.
    FIXTURE_DOC=$(git show "$C:tests/fixtures/README.md" | sed -n 's/^- sha256: `\([0-9a-f]\{64\}\)`[.]$/\1/p')
    while IFS= read -r s; do
      if [ "$s" = "$FIXTURE_PATH" ]; then
        git show "$C:$s" >"$W/fixture-at-head" 2>/dev/null || { echo "$s: READ ERROR"; fail=1; continue; }
        echo "$s (new in this phase, the committed fixture, a binary; change O63):"
        echo "  bytes $(wc -c <"$W/fixture-at-head"); sha256 $(sha256sum <"$W/fixture-at-head" | cut -d' ' -f1); the sha256 tests/fixtures/README.md gives: ${FIXTURE_DOC:-none}"
        note "$s hashes as tests/fixtures/README.md gives (change O63)" "$(is [ "$(sha256sum <"$W/fixture-at-head" | cut -d' ' -f1)" = "$FIXTURE_DOC" ])"
        note "control: the README's hash is not the Containerfile's (change O63)" "$(isnot [ "$(git show "$C:tools/openpyxl-image/Containerfile" | sha256sum | cut -d' ' -f1)" = "$FIXTURE_DOC" ])"
        nscored=$((nscored + 1))
        continue
      fi
      git show "$C:$s" >"$W/a-at-head" 2>/dev/null || { echo "$s: READ ERROR"; fail=1; continue; }
      echo "$s (new in this phase):"
      echo "  non-ASCII bytes: $(f_nonascii "$W/a-at-head")"
      echo "  control bytes: $(f_ctrl "$W/a-at-head")"
      echo "  hits against all $(count_lines "$W/live-patterns") live privacy patterns: $(f_live "$W/a-at-head")"
      echo "  hits against the three pre-P6d bare forms: $(f_pre "$W/a-at-head")"
      echo "  lines with an office extension: $(f_office "$W/a-at-head"); of them a literal file name: $(f_office_literal "$W/a-at-head"); of those a name other than the four allowed: $(f_office_other "$W/a-at-head")"
      note "$s is clean on the five forms, office names counted as literals, the four the phase needs allowed (change O63)" "$(is clean_source "$W/a-at-head")"
      nscored=$((nscored + 1))
    done <"$W/added"
    
    echo
    echo "## the files this phase MODIFIED, scored by change rather than absolutely"
    git diff --name-only --diff-filter=M "$BASE" "$C" >"$W/modified"
    echo "  files modified in this phase: $(count_lines "$W/modified")"
    unchanged_by_this_phase() {
      [ "$added" = 0 ] && [ "$at_base" != error ] && [ "$at_head" != error ] &&
        [ "$at_base" = "$at_head" ]
    }
    while IFS= read -r M; do
      git show "$BASE:$M" >"$W/m-at-base" 2>/dev/null || { echo "$M: READ ERROR at base"; fail=1; continue; }
      git show "$C:$M" >"$W/m-at-head" 2>/dev/null || { echo "$M: READ ERROR at the phase commit"; fail=1; continue; }
      git diff -U0 "$BASE" "$C" -- "$M" |
        LC_ALL=C "$G" '^+' | LC_ALL=C "$G" -v '^+++' | sed 's/^+//' >"$W/m-added"
      echo "$M (modified in this phase):"
      echo "  added lines: $(count_lines "$W/m-added")"
      for form in f_nonascii f_ctrl f_live f_pre f_office_literal f_office; do
        at_base=$("$form" "$W/m-at-base")
        added=$("$form" "$W/m-added")
        at_head=$("$form" "$W/m-at-head")
        echo "  $form: at the base $at_base, in the added lines $added, at the phase commit $at_head"
        if [ "$form" = f_office ]; then
          # Printed only: a moved or rebuilt line can lower the count, and the
          # literal form above is the one held to "nothing new".
          continue
        fi
        note "$M: $form introduces nothing new in this phase" "$(is unchanged_by_this_phase)"
      done
      nscored=$((nscored + 1))
    done <"$W/modified"
    
    echo
    echo "## every file in the diff was scored"
    ndiff=$(count_lines "$W/difffiles")
    echo "  files in the diff: $ndiff; files scored as new or modified: $nscored"
    note "every file in the phase diff was scored" "$(is [ "$ndiff" = "$nscored" ])"
    
    echo
    echo "## the public fn and const first lines, the base's line for line with their cfg lines, a file's items taking the cfg line of its mod declaration (changes E36, L47 to L56, L57, L61 to L64; P3's E35, P2's E34, P1's E33, M3 part 5 P2's E31, P1's E30, M3 part 4 P1's E28, M3 part 3 P3's E26 reader, M2 part 4c P2's E12, part 4b P1's E7 and part 4a P4's D5, kept)"
    # The first line of every "pub fn" and "pub const" in crates/emend/src outside
    # the test files, leading space, "mut " before a parameter and a trailing brace
    # dropped, each beside the attribute before it when the line before is one
    # ("#[...", an attribute over several lines joined into one line, change
    # E26), else "-", sorted by the first line. Change E31: an item with neither
    # its own cfg line nor a gated impl's takes the cfg line of its file's mod
    # declaration in the parent file, when that line is one. Change L64: the
    # phase adds no pub fn or const (the limits commit changes doc comments
    # alone), loses none and moves no cfg line.
    # file_gate <commit> <path>: the line before the path's mod declaration in
    # its parent file (crates/emend/src/a/b.rs: `mod b;` in crates/emend/src/a.rs)
    # when that line is a feature cfg line, else nothing (change E31).
    file_gate() {
      local at=$1 f=$2 dir name
      case "$f" in crates/emend/src/*/*.rs) ;; *) return 0 ;; esac
      dir=${f%/*}; name=${f##*/}; name=${name%.rs}
      git show "$at:$dir.rs" 2>/dev/null | awk -v m="mod $name;" '$0 == m { print p; exit } { p = $0 }' |
        LC_ALL=C "$G" -E '^#\[cfg\(feature = "[a-z]+"\)\]$' || :
    }
    pub_with_attrs() {
      local at=$1 f
      for f in $(git ls-tree -r --name-only "$at" -- crates/emend/src | LC_ALL=C "$G" -E '[.]rs$' | LC_ALL=C "$G" -vE '(/tests[.]rs|/testing[.]rs|/tests/)'); do
        git show "$at:$f" | awk -v filecfg="$(file_gate "$at" "$f")" '
          function trimmed(s) { sub(/^[[:space:]]*/, "", s); return s }
          function joined(s) { gsub(/[(] /, "(", s); gsub(/ [)]/, ")", s); return s }
          # Change E26: an attribute over several lines, from its "#[" line to
          # the line ending "]", is one line, a space between its pieces and
          # none just inside a parenthesis.
          inattr { attr = attr " " trimmed($0); if ($0 ~ /\]$/) { inattr = 0; prev = joined(attr) }; next }
          /^[[:space:]]*#\[/ && $0 !~ /\]$/ { inattr = 1; attr = trimmed($0); next }
          # Change D5, kept and widened by E7: an impl whose own attribute line is
          # a feature cfg gates every pub fn inside it with that line, up to the
          # impl'"'"'s closing brace at the margin.
          # Change E31: outside a gated impl, the gate of the file itself.
          BEGIN { gated = filecfg }
          /^impl/ { gated = (prev ~ /^#\[cfg\(feature = "[a-z]+"\)\]$/) ? prev : filecfg }
          /^}/ { gated = filecfg }
          /^[[:space:]]*pub (fn|const) / {
            line = $0; sub(/^[[:space:]]*/, "", line); sub(/ [{]$/, "", line)
            gsub(/[(]mut /, "(", line); gsub(/, mut /, ", ", line)
            a = prev; sub(/^[[:space:]]*/, "", a)
            if (a !~ /^#\[/) a = (gated != "" ? gated : "-")
            print a "\t" line
          }
          { prev = $0 }'
      done | LC_ALL=C sort -t "$(printf '\t')" -k2
    }
    TAB=$(printf '\t')
    READ_CFG='#[cfg(feature = "read")]'
    COMMENTS_CFG='#[cfg(feature = "comments")]'
    IMAGES_CFG='#[cfg(feature = "images")]'
    METADATA_CFG='#[cfg(feature = "metadata")]'
    COPY_CFG='#[cfg(feature = "copy")]'
    CHARTS_CFG='#[cfg(feature = "charts")]'
    DRAWING_OLD='#[cfg(any(feature = "images", feature = "read"))]'
    DRAWING_NEW='#[cfg(any(feature = "images", feature = "read", feature = "charts"))]'
    CHART_NEW='#[cfg(any(feature = "read", feature = "charts"))]'
    COMMENTS_ANY='#[cfg(any(feature = "comments", feature = "copy"))]'
    METADATA_ANY='#[cfg(any(feature = "metadata", feature = "copy"))]'
    PAIR_CFG='#[cfg(all(feature = "sheetprops", feature = "metadata"))]'
    TABLE_NEW='#[cfg(any(feature = "rowcol", feature = "tables", all(feature = "sheetprops", feature = "metadata")))]'
    echo "command: git show <commit>:<each crates/emend/src/*.rs outside the tests> | awk (a pub fn or pub const first line, beside the previous line when it is an attribute, one over several lines joined), sorted, at the base and at the phase commit"
    pub_with_attrs "$BASE" >"$W/pubattr-base"
    pub_with_attrs "$C" >"$W/pubattr-head"
    echo "  at the phase commit, every pub fn and pub const first line with its attribute:"
    sed 's/^/    /' "$W/pubattr-head"
    cut -f2 "$W/pubattr-base" | LC_ALL=C sort >"$W/pub-base"
    cut -f2 "$W/pubattr-head" | LC_ALL=C sort >"$W/pub-on"
    echo "  pub first lines: at the base $(count_lines "$W/pub-base"); at the phase commit $(count_lines "$W/pub-on")"
    LC_ALL=C comm -13 "$W/pub-base" "$W/pub-on" >"$W/pub-new"
    LC_ALL=C comm -23 "$W/pub-base" "$W/pub-on" >"$W/pub-lost"
    echo "  the lines the base's list loses at the phase commit:"; sed 's/^/    /' "$W/pub-lost"
    echo "  the lines the phase commit's list adds to the base's:"; sed 's/^/    /' "$W/pub-new"
    # Change L64: the list is the base's, line for line: the phase adds no
    # pub fn and no pub const, loses none and moves no cfg line.
    : >"$W/pub-new-want"
    echo "  the lines the phase commit adds: $(count_lines "$W/pub-new"); the lines the base's list loses: $(count_lines "$W/pub-lost")"
    note "the phase commit's list adds nothing to the base's (change L64)" "$(is cmp -s "$W/pub-new" "$W/pub-new-want")"
    note "no line of the base's list is lost (changes L57, L61 to L64)" "$(is [ "$(count_lines "$W/pub-lost")" = 0 ])"
    note "some first lines were read" "$(is [ "$(count_lines "$W/pub-on")" -ge 1 ])"
    printf '%s\n' 'pub fn planted(&self)' >"$W/c-pub-extra"
    note "control: the comparison refuses a list of one other call" "$(isnot cmp -s "$W/c-pub-extra" "$W/pub-new-want")"
    printf '%s\n' 'pub fn add_chartsheet(&mut self, name: &str, chart: &NewChart<'"'"'_>) -> Result<Vec<u8>, Error>' >"$W/c-pub-p3"
    note "control: the comparison refuses P1's one added line, add_chartsheet, given as this phase's (change L64)" "$(isnot cmp -s "$W/c-pub-p3" "$W/pub-new-want")"
    gated_by() {
      awk -F "$TAB" -v cfg="$2" '$1 == cfg { print $2 }' "$1" |
        sed -E 's/^pub (fn|const) ([A-Za-z_0-9]+).*/\1 \2/' | LC_ALL=C sort
    }
    # The phase commit's list with attributes is the base's, line for line:
    # no cfg line moves (change L64).
    LC_ALL=C sort "$W/pubattr-base" >"$W/pubattr-want"
    LC_ALL=C sort "$W/pubattr-head" >"$W/pubattr-head-sorted"
    note "the phase commit's list with attributes is the base's, line for line (change L64)" "$(is cmp -s "$W/pubattr-head-sorted" "$W/pubattr-want")"
    { cat "$W/pubattr-want"; printf '%s\t%s\n' "$CHARTS_CFG" 'pub fn planted(&self)'; } | LC_ALL=C sort >"$W/c-pubattr-extra"
    note "control: the same comparison refuses the expected list with a line added under the charts cfg line" "$(isnot cmp -s "$W/pubattr-head-sorted" "$W/c-pubattr-extra")"
    awk -F "$TAB" -v OFS="$TAB" -v cnew="$CHARTS_CFG" -v cold="$IMAGES_CFG" '$2 ~ /^pub fn remove_chart[(]/ && $1 == cnew { $1 = cold } { print }' "$W/pubattr-want" | LC_ALL=C sort >"$W/c-pubattr-moved"
    note "control: the same comparison refuses the expected list with remove_chart moved to the images cfg line" "$(isnot cmp -s "$W/pubattr-head-sorted" "$W/c-pubattr-moved")"
    # Change E36, kept: P3's copy_sheet stands under the copy cfg line.
    gated_by "$W/pubattr-head" "$COPY_CFG" >"$W/gated-copy"
    printf 'fn copy_sheet\n' >"$W/gated-copy-want"
    echo "  under $COPY_CFG at the phase commit: $(tr '\n' ' ' <"$W/gated-copy")"
    note "the item under the copy cfg line is copy_sheet alone (change E36)" "$(is cmp -s "$W/gated-copy" "$W/gated-copy-want")"
    echo "  file_gate at the phase commit: package/chart_write.rs '$(file_gate "$C" crates/emend/src/package/chart_write.rs)'; package/chart.rs '$(file_gate "$C" crates/emend/src/package/chart.rs)'; package/extlink.rs '$(file_gate "$C" crates/emend/src/package/extlink.rs)'; package/pivot.rs '$(file_gate "$C" crates/emend/src/package/pivot.rs)'; package/survey.rs '$(file_gate "$C" crates/emend/src/package/survey.rs)'; package/sheet_read.rs '$(file_gate "$C" crates/emend/src/package/sheet_read.rs)'; styles/elements.rs '$(file_gate "$C" crates/emend/src/styles/elements.rs)'; package.rs '$(file_gate "$C" crates/emend/src/package.rs)'"
    note "file_gate gives package/chart_write.rs, P1's, the charts cfg line (change L56, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/chart_write.rs)" = "$CHARTS_CFG" ])"
    note "file_gate gives package/chart.rs, part 3 P1's, the charts cfg line (change L53, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/chart.rs)" = "$CHARTS_CFG" ])"
    note "file_gate gives package/extlink.rs, part 2 P3's, the read cfg line (change L52, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/extlink.rs)" = "$READ_CFG" ])"
    note "file_gate gives package/pivot.rs, P2's, the read cfg line (change L51, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/pivot.rs)" = "$READ_CFG" ])"
    note "file_gate gives package/survey.rs, P1's, the read cfg line (change L50, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/survey.rs)" = "$READ_CFG" ])"
    note "file_gate gives package/sheet_read.rs the read cfg line (M3 part 5 P2's E31)" "$(is [ "$(file_gate "$C" crates/emend/src/package/sheet_read.rs)" = "$READ_CFG" ])"
    note "control: file_gate gives an ungated module (styles/elements.rs) nothing" "$(is [ -z "$(file_gate "$C" crates/emend/src/styles/elements.rs)" ])"
    note "control: file_gate gives a top-level file (package.rs) nothing" "$(is [ -z "$(file_gate "$C" crates/emend/src/package.rs)" ])"
    # The cfg lines the list carries: the base's, none new and none gone
    # (changes L54, L56 and L57).
    awk -F "$TAB" '$1 ~ /^#\[cfg\(/ { print $1 }' "$W/pubattr-head" | LC_ALL=C sort -u >"$W/cfgs"
    awk -F "$TAB" '$1 ~ /^#\[cfg\(/ { print $1 }' "$W/pubattr-base" | LC_ALL=C sort -u >"$W/cfgs-base"
    echo "  the cfg lines the list carries at the phase commit:"; sed 's/^/    /' "$W/cfgs"
    note "the cfg lines the list carries are the base's (changes L54, L56 and L57)" "$(is cmp -s "$W/cfgs" "$W/cfgs-base")"
    sed '1d' "$W/cfgs-base" >"$W/c-cfgs"
    note "control: the comparison refuses the base's lines one short" "$(isnot cmp -s "$W/cfgs" "$W/c-cfgs")"
    note "the read cfg line is among them (change E33)" "$(is [ "$(count_matches -Fx "$READ_CFG" "$W/cfgs")" = 1 ])"
    while IFS= read -r cfg; do
      gated_by "$W/pubattr-head" "$cfg" >"$W/gated-head"
      gated_by "$W/pubattr-base" "$cfg" >"$W/gated-base"
      echo "  $cfg: items at the base $(count_lines "$W/gated-base"), at the phase commit $(count_lines "$W/gated-head")"
    done <"$W/cfgs"
    gated_by "$W/pubattr-head" "$READ_CFG" >"$W/gated-read-head"
    gated_by "$W/pubattr-base" "$READ_CFG" >"$W/gated-read-base"
    note "the items under the read cfg line are the base's, item for item (changes L54, L56 and L57)" "$(is cmp -s "$W/gated-read-head" "$W/gated-read-base")"
    gated_by "$W/pubattr-head" "$CHARTS_CFG" >"$W/gated-charts"
    printf 'fn add_chart\nfn add_chartsheet\nfn charts\nfn remove_chart\n' | LC_ALL=C sort >"$W/gated-charts-want"
    echo "  under $CHARTS_CFG at the phase commit: $(tr '\n' ' ' <"$W/gated-charts")"
    note "the items under the charts cfg line are charts, add_chart, remove_chart and add_chartsheet, as P1 left them (changes L53, L56, L57, L61, L63 and L64)" "$(is cmp -s "$W/gated-charts" "$W/gated-charts-want")"
    gated_by "$W/pubattr-head" "$DRAWING_NEW" >"$W/gated-dnew"
    gated_by "$W/pubattr-head" "$CHART_NEW" >"$W/gated-cnew"
    echo "  under $DRAWING_NEW: $(tr '\n' ' ' <"$W/gated-dnew"); under $CHART_NEW: $(tr '\n' ' ' <"$W/gated-cnew")"
    dc_alone() { [ "$(cat "$W/gated-dnew")" = 'const DRAWING' ] && [ "$(cat "$W/gated-cnew")" = 'const CHART' ]; }
    note "DRAWING alone is still under the first widened cfg line and CHART alone under the second (changes L53, L56 and L57)" "$(is dc_alone)"
    note "control: the charts comparison refuses the list of the read cfg line" "$(isnot cmp -s "$W/gated-read-head" "$W/gated-charts-want")"
    : >"$W/c-gated-short"
    note "control: the copy comparison refuses a list one item short" "$(isnot cmp -s "$W/gated-copy" "$W/c-gated-short")"
    printf '%s\n' "    $PAIR_CFG" '    pub fn x(&self) {' '    /// doc' '    pub const Y: u8 = 1;' >"$W/c-attr.rs"
    c_attr() {
      awk '
        /^[[:space:]]*pub (fn|const) / { a = prev; sub(/^[[:space:]]*/, "", a); if (a !~ /^#\[/) a = "-"; print a }
        { prev = $0 }' "$W/c-attr.rs" | tr '\n' '|'
    }
    c_attr_ok() { [ "$(c_attr)" = "$PAIR_CFG|-|" ]; }
    note "control: the attribute reader pairs a cfg line with the fn after it and a doc line with '-'" "$(is c_attr_ok)"
    # Change E26's control: the joining reader over a fixture holding TABLE's
    # six-line cfg, a one-line one and a doc line.
    printf '%s\n' '#[cfg(any(' '    feature = "rowcol",' '    feature = "tables",' '    all(feature = "sheetprops", feature = "metadata")' '))]' 'pub const T: u8 = 1;' "$PAIR_CFG" 'pub fn f(&self) {}' '/// doc' 'pub fn g(&self) {}' >"$W/c-multi.rs"
    c_multi() {
      awk '
        function trimmed(s) { sub(/^[[:space:]]*/, "", s); return s }
        function joined(s) { gsub(/[(] /, "(", s); gsub(/ [)]/, ")", s); return s }
        inattr { attr = attr " " trimmed($0); if ($0 ~ /\]$/) { inattr = 0; prev = joined(attr) }; next }
        /^[[:space:]]*#\[/ && $0 !~ /\]$/ { inattr = 1; attr = trimmed($0); next }
        /^[[:space:]]*pub (fn|const) / { a = prev; sub(/^[[:space:]]*/, "", a); if (a !~ /^#\[/) a = "-"; print a }
        { prev = $0 }' "$W/c-multi.rs" | tr '\n' '|'
    }
    c_multi_ok() { [ "$(c_multi)" = "$TABLE_NEW|$PAIR_CFG|-|" ]; }
    note "control: the reader joins a six-line attribute into the widened cfg line and keeps one-line attributes and doc lines (change E26)" "$(is c_multi_ok)"
    # Change D5's control, widened by E7: the reader itself, over a fixture with
    # a gated impl and an ungated one, gives the pub fn inside the gated impl the
    # cfg line.
    FEATURE_CFG='#[cfg(feature = "sheetprops")]'
    printf '%s\n' "$FEATURE_CFG" 'impl A {' '    /// doc' '    pub fn inside(&self) {}' '}' 'impl B {' '    /// doc' '    pub fn outside(&self) {}' '}' >"$W/c-impl.rs"
    c_impl() {
      awk '
        /^impl/ { gated = (prev ~ /^#\[cfg\(feature = "[a-z]+"\)\]$/) ? prev : "" }
        /^}/ { gated = "" }
        /^[[:space:]]*pub (fn|const) / { a = prev; sub(/^[[:space:]]*/, "", a); if (a !~ /^#\[/) a = (gated != "" ? gated : "-"); print a }
        { prev = $0 }' "$W/c-impl.rs" | tr '\n' '|'
    }
    c_impl_ok() { [ "$(c_impl)" = "$FEATURE_CFG|-|" ]; }
    note "control: the reader gives a pub fn in a gated impl the cfg line and one in an ungated impl '-' (change D5)" "$(is c_impl_ok)"
    nunsafe=$(git grep -c -w -e unsafe "$C" -- crates/emend/src | awk -F: '{ n += $NF } END { print n + 0 }')
    nforbid=$(git show "$C:crates/emend/src/lib.rs" | count_matches -Fx '#![forbid(unsafe_code)]' /dev/stdin)
    echo "  lines holding the word unsafe under crates/emend/src at the phase commit: $nunsafe; lib.rs's forbid line: $nforbid"
    note "lib.rs still forbids unsafe code" "$(is [ "$nforbid" = 1 ])"
    
    echo
    echo "## the base's tests: one test file in the range, tests/chartsheet.rs, none of its base tests gone and none edited, with a control over part 5 P3's range; the test names of the whole tree the base's and the one new test derived from the diff (change F6, kept; changes F35, I38 to I40, I43, I44, I47 to I62, I63, I65 to I69)"
    git diff --name-only "$BASE" "$C" | LC_ALL=C "$G" -E '(/tests[.]rs|/tests/|^tools/.*/tests/)' >"$W/test-files" || :
    sed 's/^/    test file changed: /' "$W/test-files"
    # test_bodies <commit> <file>: "<name>\t<body with each line joined by a
    # form feed>" per #[test] fn, the body from the fn line to the first line
    # that is a closing brace at the left margin.
    test_bodies() {
      python3 -I -B - "$1" "$2" <<'BODIES'
    import re, subprocess, sys
    at, path = sys.argv[1:3]
    if subprocess.run(["git", "cat-file", "-e", at + "^{commit}"], capture_output=True).returncode != 0:
        sys.exit("no such commit")
    if subprocess.run(["git", "cat-file", "-e", f"{at}:{path}"], capture_output=True).returncode != 0:
        sys.exit(0)
    text = subprocess.run(["git", "show", f"{at}:{path}"], capture_output=True, text=True,
                          check=True).stdout.split("\n")
    i = 0
    while i < len(text):
        if text[i].strip() == "#[test]":
            j = i + 1
            while j < len(text) and not re.match(r"^\s*fn ", text[j]):
                j += 1
            if j >= len(text):
                break
            name = re.match(r"^\s*fn ([a-z0-9_]+)", text[j]).group(1)
            k = j
            while k < len(text) and text[k] != "}":
                k += 1
            print(name + "\t" + "\f".join(text[j:k + 1]))
            i = k
        i += 1
    BODIES
    }
    # added_in <base bodies> <head bodies> <file>: per base test, "gone", or one
    # line "<file> <test> - <line, stripped>" per line removed from its body and
    # "<file> <test> + <line, stripped>" per line added, by a line diff of the
    # body at the base against the body now (change I4).
    added_in() {
      python3 -I -B - "$1" "$2" "$3" <<'ADDED'
    import difflib, sys
    base = dict(l.rstrip("\n").split("\t", 1) for l in open(sys.argv[1]) if l.strip())
    head = dict(l.rstrip("\n").split("\t", 1) for l in open(sys.argv[2]) if l.strip())
    for name, body in sorted(base.items()):
        if name not in head:
            print("%s %s gone" % (sys.argv[3], name))
            continue
        old, new = body.split("\f"), head[name].split("\f")
        for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
            if tag in ("replace", "delete"):
                for line in old[i1:i2]:
                    print("%s %s - %s" % (sys.argv[3], name, line.strip()))
            if tag in ("replace", "insert"):
                for line in new[j1:j2]:
                    print("%s %s + %s" % (sys.argv[3], name, line.strip()))
    ADDED
    }
    : >"$W/tests-edited"; tb_fail=0
    nbase_tests=0
    while IFS= read -r tf; do
      test_bodies "$BASE" "$tf" >"$W/tb-base" || tb_fail=1
      test_bodies "$C" "$tf" >"$W/tb-head" || tb_fail=1
      nbase_tests=$((nbase_tests + $(count_lines "$W/tb-base")))
      added_in "$W/tb-base" "$W/tb-head" "$tf" >>"$W/tests-edited" || tb_fail=1
    done <"$W/test-files"
    echo "command: every #[test] fn of the base in each changed test file, read at the base and at the phase commit; the lines removed from it and added to it, by a line diff, and any gone"
    echo "  base tests read in the changed files: $nbase_tests"
    sed 's/^/    /' "$W/tests-edited"
    LC_ALL=C sort "$W/tests-edited" >"$W/tests-edited-sorted"
    # Change I69: the one test file in the phase diff is the carry commit's
    # package/tests/chartsheet.rs (planning's P1 verification ruling E: one
    # test added). Every base test in it is read; none is gone and none is
    # edited; the test names of the whole tree are the base's and the new test
    # derived from the diff. PKG_TESTS, set in P1's block, is set here.
    PKG_TESTS=crates/emend/src/package/tests.rs
    ngone=$(count_matches -E ' gone$' "$W/tests-edited")
    note "every test of the base and the phase commit was read, none failing" "$(is [ "$tb_fail" = 0 ])"
    printf '%s\n' crates/emend/src/package/tests/chartsheet.rs >"$W/test-files-want"
    LC_ALL=C sort "$W/test-files" >"$W/test-files-sorted"
    echo "  test files in the phase diff: $(count_lines "$W/test-files")"
    note "the one test file in the phase diff is tests/chartsheet.rs (change I69)" "$(is cmp -s "$W/test-files-sorted" "$W/test-files-want")"
    note "the base tests of the file were read, 18 in all (change I69)" "$(is [ "$nbase_tests" = 18 ])"
    printf '%s\n' crates/emend/src/package/tests/chart_write.rs >"$W/c-test-files-long"
    note "control: the comparison refuses a list of another test file (change I69)" "$(isnot cmp -s "$W/c-test-files-long" "$W/test-files-want")"
    printf 'crates/emend/src/package/tests.rs\nscripts/counting.sh\n' >"$W/c-test-files"
    ctl "test files in a planted list of two, the same pattern" 1 count_matches -E '(/tests[.]rs|/tests/|^tools/.*/tests/)' "$W/c-test-files"
    printf '%s\n' specs/0038-chartsheets.md crates/emend/src/package.rs scripts/openpyxl-ops.py >"$W/c-test-fixtures"
    ctl "test files among three of the phase's files that are not tests, the same pattern (change I69)" 0 count_matches -E '(/tests[.]rs|/tests/|^tools/.*/tests/)' "$W/c-test-fixtures"
    : >"$W/tests-edited-want"
    note "no test of the base is gone ($ngone; change I69)" "$(is [ "$ngone" = 0 ])"
    nedit=$(count_lines "$W/tests-edited")
    awk '{ print $1 " " $2 }' "$W/tests-edited" | LC_ALL=C sort -u >"$W/tests-edited-names"
    echo "  edit lines: $nedit; base tests edited or gone: $(count_lines "$W/tests-edited-names")"
    sed 's/^/    edited or gone: /' "$W/tests-edited-names"
    note "the reader's lines are none: no line added to or removed from any base test's body (change I69)" "$(is cmp -s "$W/tests-edited-sorted" "$W/tests-edited-want")"
    printf '%s\n' "crates/emend/src/package/tests/chartsheet.rs a_second_chart_on_a_chartsheet_is_refused - }" >"$W/c-tests-edited"
    note "control: the comparison refuses a planted edit line (change I69)" "$(isnot cmp -s "$W/c-tests-edited" "$W/tests-edited-want")"
    # Change I62's control, kept (I63, I65 to I69): the same reader over part 5 P3's range
    # (P2's record commit to P3's tool commit, each found by its subject) finds
    # P3's one edit, the two added lines "color: None," and "labels: None," in
    # one test, so the reader can see an edit and the one line above is this
    # phase's.
    P53_BASE=$(git log --format='%H' -n 1 --grep='^M5 part 5 P2 record:')
    P53_TOOLC=$(by_subject "M5 part 5 P3: emend-copy --chart-labels-sample and --remove-chart-sample")
    echo "  part 5 P3's base and tool commit, by subject: ${P53_BASE:-none found}, ${P53_TOOLC:-none found}"
    CWT=crates/emend/src/package/tests/chart_write.rs
    test_bodies "$P53_BASE" "$CWT" >"$W/c-tb-base" 2>/dev/null || :
    test_bodies "$P53_TOOLC" "$CWT" >"$W/c-tb-head" 2>/dev/null || :
    added_in "$W/c-tb-base" "$W/c-tb-head" "$CWT" | LC_ALL=C sort >"$W/c-p3-edited" 2>/dev/null || :
    sed 's/^/    over part 5 P3'"'"'s range: /' "$W/c-p3-edited"
    printf '%s\n' "$CWT texts_are_escaped_and_references_written_as_given + color: None," \
      "$CWT texts_are_escaped_and_references_written_as_given + labels: None," | LC_ALL=C sort >"$W/c-p3-edited-want"
    note "control: the same reader over part 5 P3's range finds P3's one edit, the two added lines 'color: None,' and 'labels: None,' (changes I62, I63 and I65 to I69)" "$(is cmp -s "$W/c-p3-edited" "$W/c-p3-edited-want")"
    printf '%s\n' 'x.rs t gone' 'x.rs u - let a = 1;' >"$W/c-edited"
    ctl "a gone test in a list, same command form" 1 count_matches -E ' gone$' "$W/c-edited"
    ctl "edit lines in a planted list of two, same command form" 2 count_lines "$W/c-edited"
    # The test names of the whole tree: every #[test] fn in every Rust file under
    # crates/ and tools/, as a sorted list of "<file> <name>", at the base and at
    # the phase commit.
    tree_test_names() {
      local at=$1 f
      for f in $(git ls-tree -r --name-only "$at" -- crates tools | LC_ALL=C "$G" -E '[.]rs$'); do
        test_bodies "$at" "$f" | cut -f1 | sed "s#^#$f #"
      done | LC_ALL=C sort
    }
    tree_test_names "$BASE" >"$W/names-base"
    tree_test_names "$C" >"$W/names-head"
    echo "command: every #[test] fn's name in every .rs file under crates/ and tools/, read by the same reader at the base and at the phase commit, sorted"
    echo "  test names at the base: $(count_lines "$W/names-base"); at the phase commit: $(count_lines "$W/names-head")"
    LC_ALL=C comm -23 "$W/names-base" "$W/names-head" >"$W/names-lost"
    LC_ALL=C comm -13 "$W/names-base" "$W/names-head" >"$W/names-new"
    echo "  names the base has and the phase commit lacks: $(count_lines "$W/names-lost")"
    sed 's/^/    lost: /' "$W/names-lost"
    echo "  names the phase commit adds: $(count_lines "$W/names-new")"
    sed 's/^/    new: /' "$W/names-new"
    : >"$W/names-lost-want"
    note "no test name of the base is lost (changes I47 to I69)" "$(is cmp -s "$W/names-lost" "$W/names-lost-want")"
    printf '%s\n' 'crates/emend/src/package/tests/chart.rs a_chartsheet_part_is_refused_as_not_a_worksheet' >"$W/c-names-lost"
    note "control: the comparison refuses a list of one, the name P1 superseded (change I69)" "$(isnot cmp -s "$W/c-names-lost" "$W/names-lost-want")"
    # diff_new_tests: for each test file in the phase diff, the #[test] fns at
    # the phase commit whose fn line is an added line of the range's diff.
    diff_new_tests() {
      local tf
      while IFS= read -r tf; do
        test_bodies "$C" "$tf" | cut -f1 | LC_ALL=C sort -u >"$W/dn-tests"
        git diff -U0 "$BASE" "$C" -- "$tf" | LC_ALL=C "$G" -E '^[+][[:space:]]*fn [a-z0-9_]+[(]' |
          sed -E 's/^[+][[:space:]]*fn ([a-z0-9_]+)[(].*/\1/' | LC_ALL=C sort -u >"$W/dn-added"
        LC_ALL=C comm -12 "$W/dn-tests" "$W/dn-added" | sed "s#^#$tf #"
      done <"$W/test-files"
    }
    diff_new_tests | LC_ALL=C sort >"$W/names-from-diff"
    echo "command: for each test file in the phase diff, the #[test] fns at the phase commit (the same reader) whose 'fn <name>(' line git diff -U0 <base> <phase commit> adds"
    echo "  new tests derived from the diff: $(count_lines "$W/names-from-diff")"
    note "the names the phase commit adds are exactly the new tests derived from the diff (changes I47 to I69)" "$(is cmp -s "$W/names-new" "$W/names-from-diff")"
    note "one new test was derived, the carry's (change I69)" "$(is [ "$(count_lines "$W/names-from-diff")" = 1 ])"
    # Change I69: the new test FACTS.md names (planning's P1 verification
    # ruling E), read from the phase commit by the same reader when the
    # generator ran.
    printf '%s\n' 'crates/emend/src/package/tests/chartsheet.rs a_chartsheet_renamed_and_moved_in_the_write_that_added_it_is_written_so' | LC_ALL=C sort >"$W/names-new-want"
    LC_ALL=C sort -o "$W/names-new-want" "$W/names-new-want"
    echo "  the new tests FACTS.md names: $(count_lines "$W/names-new-want")"
    note "the new test, as FACTS.md gives (change I69)" "$(is cmp -s "$W/names-from-diff" "$W/names-new-want")"
    # Change I63: the planted list is one name, a test the diff does not add.
    printf '%s\n' 'crates/emend/src/package/tests/chart_write.rs a_planted_name' >"$W/c-names-new-want"
    note "control: the planted list differs from the expectation (cmp)" "$(isnot cmp -s "$W/c-names-new-want" "$W/names-new-want")"
    note "control: the same comparison refuses another name" "$(isnot cmp -s "$W/names-from-diff" "$W/c-names-new-want")"
    LC_ALL=C sort -m "$W/names-base" "$W/names-from-diff" >"$W/names-want"
    note "the test names of the whole tree are the base's and the new test, nothing else (changes I47 to I69)" "$(is cmp -s "$W/names-head" "$W/names-want")"
    note "some test names were read" "$(is [ "$(count_lines "$W/names-head")" -ge 1 ])"
    sed '1d' "$W/names-head" >"$W/c-names-short"
    note "control: the comparison refuses the list one name short" "$(isnot cmp -s "$W/names-want" "$W/c-names-short")"
    { cat "$W/names-from-diff"; echo 'crates/emend/src/package/tests/chart_write.rs a_planted_name_the_diff_does_not_add'; } | LC_ALL=C sort >"$W/c-names-new"
    note "control: the comparison refuses a new name the diff does not add" "$(isnot cmp -s "$W/c-names-new" "$W/names-from-diff")"
    # The colors module's tests, read at the phase commit for the crate runs
    # below: all of them, and those gated to rules (#[cfg(feature = "rules")] on
    # the line before #[test]), none expected (changes I48 to I52). The carry test of
    # styles/tests.rs, gated cfg(not(feature = "read")) on the line before its
    # #[test], runs with read off alone (specs/0032 "Planning verification and
    # rulings on P1", ruling 3).
    CO_FILE=crates/emend/src/package/tests/colors.rs
    STYLES_TESTS=crates/emend/src/styles/tests.rs
    CARRY_TEST=a_second_cell_style_xfs_cell_styles_or_dxfs_is_walked_past
    rules_gated() { awk 'p == "#[cfg(feature = \"rules\")]" && $0 == "#[test]" { n++ } { p = $0 } END { print n + 0 }' "$1"; }
    git show "$C:$CO_FILE" >"$W/co-file"
    N_CO=$(test_bodies "$C" "$CO_FILE" | count_lines /dev/stdin)
    R_CO=$(rules_gated "$W/co-file")
    echo "command: the #[test] fns of $CO_FILE at the phase commit (the same reader), and those whose line before #[test] is #[cfg(feature = \"rules\")]"
    echo "  colors tests: $N_CO; of them gated to rules: $R_CO"
    co_none_gated() { [ "$N_CO" -ge 1 ] && [ "$R_CO" = 0 ]; }
    note "some colors tests, none gated to rules (changes I48 to I52)" "$(is co_none_gated)"
    printf '%s\n' '#[test]' 'fn a() {}' '#[cfg(feature = "rules")]' '#[test]' 'fn b() {}' '#[cfg(feature = "rules")]' 'const X: u8 = 1;' >"$W/c-co"
    ctl "rules-gated tests in a planted file of two tests, one gated, and a gated constant, same command form" 1 rules_gated "$W/c-co"
    # carry_gate <file>: the two lines before the carry test's fn line, joined
    # by a bar.
    carry_gate() { awk -v f="fn $CARRY_TEST() {" '$0 == f { print a "|" b; exit } { a = b; b = $0 }' "$1"; }
    git show "$C:$STYLES_TESTS" >"$W/styles-tests-file"
    echo "command: the two lines before 'fn $CARRY_TEST() {' in $STYLES_TESTS at the phase commit"
    echo "  $(carry_gate "$W/styles-tests-file")"
    CARRY_WANT='#[cfg(not(feature = "read"))]|#[test]'
    note "the carry test is still a test gated to the feature read off (changes I48 to I52)" "$(is [ "$(carry_gate "$W/styles-tests-file")" = "$CARRY_WANT" ])"
    printf '%s\n' '#[cfg(feature = "read")]' '#[test]' "fn $CARRY_TEST() {" '}' >"$W/c-carry"
    note "control: the planted fixture differs from the file (cmp)" "$(isnot cmp -s "$W/c-carry" "$W/styles-tests-file")"
    note "control: the same check refuses the test gated to the feature read on" "$(isnot [ "$(carry_gate "$W/c-carry")" = "$CARRY_WANT" ])"
    # Change I50: the survey module's tests, read at the phase commit for the
    # crate runs below: all of them, and those gated to rules, none expected.
    SV_FILE=crates/emend/src/package/tests/survey.rs
    git show "$C:$SV_FILE" >"$W/sv-file"
    N_SV=$(test_bodies "$C" "$SV_FILE" | count_lines /dev/stdin)
    R_SV=$(rules_gated "$W/sv-file")
    echo "command: the #[test] fns of $SV_FILE at the phase commit (the same reader), and those whose line before #[test] is #[cfg(feature = \"rules\")]"
    echo "  survey tests: $N_SV; of them gated to rules: $R_SV"
    sv_none_gated() { [ "$N_SV" -ge 1 ] && [ "$R_SV" = 0 ]; }
    note "some survey tests, none gated to rules (change I50)" "$(is sv_none_gated)"
    # Change I51: the pivot module's tests, read at the phase commit for the
    # crate runs below: all of them, and those gated to rules, none expected.
    PV_FILE=crates/emend/src/package/tests/pivot.rs
    git show "$C:$PV_FILE" >"$W/pv-file"
    N_PV=$(test_bodies "$C" "$PV_FILE" | count_lines /dev/stdin)
    R_PV=$(rules_gated "$W/pv-file")
    echo "command: the #[test] fns of $PV_FILE at the phase commit (the same reader), and those whose line before #[test] is #[cfg(feature = \"rules\")]"
    echo "  pivot tests: $N_PV; of them gated to rules: $R_PV"
    pv_fourteen() { [ "$N_PV" = 14 ] && [ "$R_PV" = 0 ]; }
    note "fourteen pivot tests, none gated to rules (change I51, kept)" "$(is pv_fourteen)"
    # Change I52: the extlink module's tests, read at the phase commit for the
    # crate runs below: all of them, and those gated to rules, none expected.
    EL_FILE=crates/emend/src/package/tests/extlink.rs
    git show "$C:$EL_FILE" >"$W/el-file"
    N_EL=$(test_bodies "$C" "$EL_FILE" | count_lines /dev/stdin)
    R_EL=$(rules_gated "$W/el-file")
    echo "command: the #[test] fns of $EL_FILE at the phase commit (the same reader), and those whose line before #[test] is #[cfg(feature = \"rules\")]"
    echo "  extlink tests: $N_EL; of them gated to rules: $R_EL"
    el_ten() { [ "$N_EL" = 10 ] && [ "$R_EL" = 0 ]; }
    note "ten extlink tests, none gated to rules (change I52, kept)" "$(is el_ten)"
    # Change I53: the chart module's tests, read at the phase commit for the
    # crate runs below: all of them, and those whose line before #[test] is a
    # cfg line, none expected (the module is compiled with charts alone).
    CH_FILE=crates/emend/src/package/tests/chart.rs
    git show "$C:$CH_FILE" >"$W/ch-file"
    N_CH=$(test_bodies "$C" "$CH_FILE" | count_lines /dev/stdin)
    cfg_gated() { awk 'p ~ /^#\[cfg\(/ && $0 == "#[test]" { n++ } { p = $0 } END { print n + 0 }' "$1"; }
    G_CH=$(cfg_gated "$W/ch-file")
    echo "command: the #[test] fns of $CH_FILE at the phase commit (the same reader), and those whose line before #[test] is a cfg line"
    echo "  chart tests: $N_CH; of them gated by a cfg line of their own: $G_CH"
    ch_40() { [ "$N_CH" = 40 ] && [ "$G_CH" = 0 ]; }
    note "forty chart tests, none gated by a cfg line of its own (change I55, kept)" "$(is ch_40)"
    printf '%s\n' '#[test]' 'fn a() {}' '#[cfg(feature = "read")]' '#[test]' 'fn b() {}' >"$W/c-ch"
    ctl "cfg-gated tests in a planted file of two tests, one gated, same command form" 1 cfg_gated "$W/c-ch"
    # Change I62 (I66): the chart-write module's tests, read at the phase
    # commit for the crate runs below: all of them, sixty-seven (decision 3's
    # test the sixty-seventh, gated by none), and those whose line
    # before #[test] is a cfg line (four expected, each gated to images: the
    # image with a chart in one write, the image removal with a chart, P3's
    # image and chart removed in one write, and this phase's chart removal on
    # a part the same write adds an image to; the rest are gated by none).
    CW_FILE=crates/emend/src/package/tests/chart_write.rs
    git show "$C:$CW_FILE" >"$W/cw-file"
    N_CW=$(test_bodies "$C" "$CW_FILE" | count_lines /dev/stdin)
    G_CW=$(cfg_gated "$W/cw-file")
    I_CW=$(awk 'p == "#[cfg(feature = \"images\")]" && $0 == "#[test]" { n++ } { p = $0 } END { print n + 0 }' "$W/cw-file")
    echo "command: the #[test] fns of $CW_FILE at the phase commit (the same reader), those whose line before #[test] is a cfg line, and of them those gated to images"
    echo "  chart-write tests: $N_CW; gated by a cfg line of their own: $G_CW; of them to images: $I_CW"
    cw_67() { [ "$N_CW" = 67 ] && [ "$G_CW" = 4 ] && [ "$I_CW" = 4 ]; }
    note "sixty-seven chart-write tests, four of them gated to images and none to anything else (changes I62 and I66)" "$(is cw_67)"
    # Change I68, kept (I69): the chartsheet module's tests, read at the phase
    # commit for the crate runs below: all of them, those whose line before
    # #[test] is a cfg line, and of them those gated to images and to comments
    # (one each); the carry's new test gated by none.
    CS_FILE=crates/emend/src/package/tests/chartsheet.rs
    git show "$C:$CS_FILE" >"$W/cs-file"
    N_CS=$(test_bodies "$C" "$CS_FILE" | count_lines /dev/stdin)
    G_CS=$(cfg_gated "$W/cs-file")
    I_CS=$(awk 'p == "#[cfg(feature = \"images\")]" && $0 == "#[test]" { n++ } { p = $0 } END { print n + 0 }' "$W/cs-file")
    M_CS=$(awk 'p == "#[cfg(feature = \"comments\")]" && $0 == "#[test]" { n++ } { p = $0 } END { print n + 0 }' "$W/cs-file")
    echo "command: the #[test] fns of $CS_FILE at the phase commit (the same reader), those whose line before #[test] is a cfg line, and of them those gated to images and to comments"
    echo "  chartsheet tests: $N_CS; gated by a cfg line of their own: $G_CS; of them to images: $I_CS; to comments: $M_CS"
    cs_n() { [ "$N_CS" = 19 ] && [ "$G_CS" = 2 ] && [ "$I_CS" = 1 ] && [ "$M_CS" = 1 ]; }
    note "19 chartsheet tests, the carry's among them, one gated to images, one to comments and none to anything else (changes I68 and I69)" "$(is cs_n)"
    # Change I56, kept: the image modules' tests (package/tests/images.rs and its
    # anchors and removal submodules), read at the phase commit for the crate
    # runs below: all of them, and those whose line before #[test] is a cfg
    # line (each a feature other than images and charts: rowcol, comments, and
    # sheetprops with metadata).
    IM_FILES="crates/emend/src/package/tests/images.rs crates/emend/src/package/tests/images/anchors.rs crates/emend/src/package/tests/images/removal.rs"
    N_IM=0; G_IM=0
    for f in $IM_FILES; do
      git show "$C:$f" >"$W/im-file"
      n=$(test_bodies "$C" "$f" | count_lines /dev/stdin)
      g=$(cfg_gated "$W/im-file")
      echo "  $f: tests $n; gated by a cfg line of their own $g"
      awk 'p ~ /^#\[cfg\(/ && $0 == "#[test]" { print "    gated: " p } { p = $0 }' "$W/im-file"
      N_IM=$((N_IM + n)); G_IM=$((G_IM + g))
    done
    echo "  image tests: $N_IM; gated by a cfg line of their own: $G_IM"
    im_40() { [ "$N_IM" = 40 ] && [ "$G_IM" = 3 ]; }
    note "forty image tests, decision 3's the fortieth, three gated to other features (changes I56 and I66)" "$(is im_40)"
    gated_line_before() {
      git show "$C:$PKG_TESTS" | awk '
        /^fn a_local_sheet_id_that_is_not_a_number_refuses_a_move_at_the_write[(]/ { print p2 "|" p1; exit }
        { p2 = p1; p1 = $0 }'
    }
    echo "  the two lines before part 1's test's fn line at the phase commit: $(gated_line_before)"
    gated_ok() { [ "$(gated_line_before)" = '#[cfg(not(feature = "metadata"))]|#[test]' ]; }
    note "part 1's test at the write is still gated to the feature off" "$(is gated_ok)"
    STY_TESTS=crates/emend/src/styles/tests.rs
    counts_gate_before() {
      git show "$1:$STY_TESTS" | awk '
        /^fn the_counts_are_the_children_not_the_count_attribute[(]/ { print p2 "|" p1; exit }
        { p2 = p1; p1 = $0 }'
    }
    echo "  the two lines before the core count test's fn line at the phase commit: $(counts_gate_before "$C")"
    counts_gated_ok() { [ "$(counts_gate_before "$1")" = '#[cfg(not(feature = "read"))]|#[test]' ]; }
    note "the core count test is still gated to the feature read off (M3 part 5 P1's F30)" "$(is counts_gated_ok "$C")"
    PRE_P1=$(git log --format='%H' -n 1 --grep='^M3 part 4 close-out record:')
    echo "  the record commit before M3 part 5 P1, by subject: ${PRE_P1:-none found}; the two lines there: $(counts_gate_before "$PRE_P1")"
    note "control: the same reader refuses the commit before P1, where the test was not gated" "$(isnot counts_gated_ok "$PRE_P1")"
    
    echo
    echo "## full run on the phase's main-tree target directory, started from / by absolute path, its doc directory removed first (changes J35, K35 and L40)"
    echo "  CARGO_TARGET_DIR: <target>/main; rulings 8 and 10 share it across the phase's dry and logged runs of <repo>, so no cargo clean runs and the cache is warm, but <target>/main/doc goes before every doc build (specs/0029 P3 verification ruling 2)"
    # Change L40: <target>/main/doc, printed as there or not, removed by rm -r
    # without -f when there, and checked gone, before every doc build.
    DOC_DIR=$MAIN_TARGET/doc
    doc_gone() { [ ! -e "$DOC_DIR" ]; }
    doc_fresh() {
      if [ -d "$DOC_DIR" ]; then
        echo "  <target>/main/doc is there: yes"
        echo "command: rm -r <target>/main/doc"
        rm -r "${DOC_DIR:?}" </dev/null
        echo "    rm -r exit $?"
      else
        echo "  <target>/main/doc is there: no"
      fi
      note "<target>/main/doc is gone before the doc build (change L40)" "$(is doc_gone)"
    }
    doc_gone_ctl() { local DOC_DIR=$MAIN_TARGET; doc_gone; }
    note "control: doc_gone refuses a directory that is there (<target>/main)" "$(isnot doc_gone_ctl)"
    doc_fresh
    GATE=$MAIN/scripts/check.sh
    echo "command: (cd / && <repo>/scripts/check.sh)"
    ( cd / && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4 "$GATE" ) >"$W/gate.out" 2>"$W/gate.err"
    grc=$?
    sed 's/^/    /' "$W/gate.out"
    echo "exit: $grc; stderr bytes: $(wc -c <"$W/gate.err")"
    npass=$(count_matches -E '^PASS ' "$W/gate.out")
    ndoc_step=$(count_matches -E '^PASS doc$' "$W/gate.out")
    note "the gate exits 0" "$(is [ "$grc" -eq 0 ])"
    note "nine PASS lines" "$(is [ "$npass" = 9 ])"
    note "the doc step is one of them, by name" "$(is [ "$ndoc_step" = 1 ])"
    note "stderr is empty" "$(is [ "$(wc -c <"$W/gate.err")" -eq 0 ])"
    # The full gate prints nothing of its doc step but its PASS line; its
    # cargo doc --workspace writes <target>/main/doc again, removed above.
    index_there() { [ -s "$DOC_DIR/emend/all.html" ]; }
    echo "  <target>/main/doc/emend/all.html after the full gate: $([ -s "$DOC_DIR/emend/all.html" ] && echo "there, $(wc -c <"$DOC_DIR/emend/all.html") bytes" || echo "not there")"
    note "the full gate's doc step wrote the index again after the directory was removed (change L40)" "$(is index_there)"
    index_ctl() { local DOC_DIR=$W/no-such-doc; index_there; }
    note "control: index_there refuses a directory that does not exist" "$(isnot index_ctl)"
    
    echo
    echo "## the binaries the gate built, both targets: the DEBUG builds of emend-copy and xlsx-diff, host and i686 (the later logs of this phase read the two emend-copy hashes against these lines)"
    bins_ok=yes
    for b in "$CARGO_TARGET_DIR"/debug/emend-copy "$CARGO_TARGET_DIR"/debug/xlsx-diff \
             "$CARGO_TARGET_DIR"/i686-unknown-linux-musl/debug/emend-copy \
             "$CARGO_TARGET_DIR"/i686-unknown-linux-musl/debug/xlsx-diff; do
      if [ -x "$b" ]; then
        echo "  $b: sha256 $(sha256sum <"$b" | cut -d' ' -f1), bytes $(wc -c <"$b")"
      else
        echo "  $b: MISSING or not executable"
        bins_ok=no
      fi
    done
    note "the gate left all four binaries, both targets, executable" "$(is [ "$bins_ok" = yes ])"
    # Change J35 (c): a later log may rebuild into the shared target, so the
    # negative log reads the gate's binaries from copies kept under <build>
    # (changes K39 to K43 and K44: the copies stay as the carried form).
    mkdir -p "$BUILD_ROOT/bin/host" "$BUILD_ROOT/bin/i686" || fail=1
    echo "command: cp each DEBUG binary above into <build>/bin/host or <build>/bin/i686 under its own name; sha256sum each copy"
    copies_ok=yes
    for pair in "host:$CARGO_TARGET_DIR/debug" "i686:$CARGO_TARGET_DIR/i686-unknown-linux-musl/debug"; do
      label=${pair%%:*}; dir=${pair#*:}
      for name in emend-copy xlsx-diff; do
        cp "$dir/$name" "$BUILD_ROOT/bin/$label/$name" || copies_ok=no
        a=$(sha256sum <"$dir/$name" | cut -d' ' -f1)
        b=$(sha256sum <"$BUILD_ROOT/bin/$label/$name" | cut -d' ' -f1)
        echo "  <build>/bin/$label/$name: sha256 $b, bytes $(wc -c <"$BUILD_ROOT/bin/$label/$name")"
        [ "$a" = "$b" ] || copies_ok=no
      done
    done
    note "each copy is executable and hashes as the binary it copies" "$(is [ "$copies_ok" = yes ])"
    
    echo
    echo "## clippy and doc with the features off, charts alone, images alone, charts with images, charts with comments, charts with read, and every feature, and clippy over the probe crate's feature sets (change H4, kept; changes G6, G16, G21, G24, G26, G28, G29, G30, G31, G33, G34, G35, G36, M47 to M55, M56 and M68)"
    # Changes J35 (b) and K35: the main tree's target directory for every run of
    # <repo>.
    FEAT_TARGET=$MAIN_TARGET
    PROBE_TARGET=$MAIN_TARGET
    diag_lines() { count_matches -E '^(warning|error)(\[|:)' "$1"; }
    lint_clean() { [ "$1" = 0 ] && [ "$2" = 0 ]; }
    lint_run() {
      local label=$1 dir=$2 rc n
      shift 2
      echo "command: ${LINT_SHOWN}"
      ( cd "$MAIN" && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4 CARGO_TARGET_DIR=$dir "$@" ) >"$W/lint.out" 2>&1
      rc=$?
      n=$(diag_lines "$W/lint.out")
      LC_ALL=C "$G" -a -E '^(warning|error)(\[|:)' "$W/lint.out" | sed 's/^/    /'
      echo "  $label: exit $rc; warning or error lines $n"
      note "$label is clean: exit 0 and no warning or error line" "$(is lint_clean "$rc" "$n")"
    }
    LINT_SHOWN="CARGO_TARGET_DIR=<target>/main cargo clippy -p emend --all-targets -- -D warnings"
    lint_run "clippy, the crate, feature off" "$FEAT_TARGET" cargo clippy -p emend --all-targets -- -D warnings
    for fs in charts images charts,images charts,comments charts,read; do
      LINT_SHOWN="CARGO_TARGET_DIR=<target>/main cargo clippy -p emend --all-targets --features $fs -- -D warnings"
      lint_run "clippy, the crate, features $fs" "$FEAT_TARGET" cargo clippy -p emend --all-targets --features "$fs" -- -D warnings
    done
    LINT_SHOWN="CARGO_TARGET_DIR=<target>/main cargo clippy -p emend --all-targets --all-features -- -D warnings"
    lint_run "clippy, the crate, every feature on" "$FEAT_TARGET" cargo clippy -p emend --all-targets --all-features -- -D warnings
    # Change L40: each doc build after doc_fresh, and its output holding a
    # line "Documenting emend", so rustdoc ran in this log.
    documenting_seen() { [ "$(count_matches -E '^ *Documenting emend ' "$1")" -ge 1 ]; }
    doc_run() {
      local label=$1
      shift
      doc_fresh
      lint_run "$label" "$FEAT_TARGET" "$@"
      echo "  lines of the build's output reading \"Documenting emend\": $(count_matches -E '^ *Documenting emend ' "$W/lint.out")"
      note "$label: rustdoc ran (\"Documenting emend\" in cargo's output; change L40)" "$(is documenting_seen "$W/lint.out")"
    }
    LINT_SHOWN="RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR=<target>/main cargo doc -p emend --no-deps"
    doc_run "doc, the crate, feature off" env RUSTDOCFLAGS='-D warnings' cargo doc -p emend --no-deps
    for fs in charts images charts,images charts,comments charts,read; do
      LINT_SHOWN="RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR=<target>/main cargo doc -p emend --no-deps --features $fs"
      doc_run "doc, the crate, features $fs" env RUSTDOCFLAGS='-D warnings' cargo doc -p emend --no-deps --features "$fs"
    done
    LINT_SHOWN="RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR=<target>/main cargo doc -p emend --no-deps --all-features"
    doc_run "doc, the crate, every feature on" env RUSTDOCFLAGS='-D warnings' cargo doc -p emend --no-deps --all-features
    printf '    Finished `dev` profile [unoptimized + debuginfo] target(s) in 0.05s\n   Generated /x/doc/emend/index.html\n' >"$W/c-doc-fresh"
    printf '    Checking emend v0.1.0\n Documenting emend v0.1.0 (/x)\n    Finished `dev` profile\n' >"$W/c-doc-ran"
    note "control: documenting_seen refuses an output holding only Finished and Generated (P3's 0.05 s case)" "$(isnot documenting_seen "$W/c-doc-fresh")"
    note "control: documenting_seen accepts an output holding the line" "$(is documenting_seen "$W/c-doc-ran")"
    # Change L40 (P3 verification ruling 3): the every-feature index's item
    # links, the section anchors (links to "#...") excluded.
    ALL_HTML=$DOC_DIR/emend/all.html
    echo "command: grep -o -E '<li><a href=\"[^\"]*\"' <target>/main/doc/emend/all.html; the links counted, those to \"#...\" (the section anchors) and the others (the items)"
    LC_ALL=C "$G" -o -E '<li><a href="[^"]*"' "$ALL_HTML" >"$W/all-links" 2>/dev/null || :
    nlinks=$(count_lines "$W/all-links")
    nanchors=$(count_matches -E 'href="#' "$W/all-links")
    nitems=$(count_matches -E 'href="[^#"]' "$W/all-links")
    echo "  links: $nlinks; section anchors: $nanchors; item links: $nitems"
    echo "  item links by kind (the link's file name up to its first dot):"
    LC_ALL=C "$G" -E 'href="[^#"]' "$W/all-links" | sed -E 's/.*href="([^"]*)"/\1/; s#.*/##; s/[.].*//' | sort | uniq -c | sed 's/^/    /' || :
    items_ok() { [ "$nitems" != error ] && [ "$nanchors" != error ] && [ "$nitems" -ge 1 ] && [ "$((nitems + nanchors))" = "$nlinks" ]; }
    note "the index's item links were counted, the anchors excluded, and the two account for every link (change L40)" "$(is items_ok)"
    printf '<li><a href="#structs">S</a></li><li><a href="#enums">E</a></li>\n<li><a href="struct.A.html">A</a></li>\n<li><a href="sub/enum.B.html">B</a></li>\n<li><a href="fn.c.html">c</a></li>\n' >"$W/c-all.html"
    LC_ALL=C "$G" -o -E '<li><a href="[^"]*"' "$W/c-all.html" >"$W/c-all-links"
    ctl "item links in a planted index of three items and two anchors, same command form" 3 count_matches -E 'href="[^#"]' "$W/c-all-links"
    ctl "section anchors in the same planted index, same command form" 2 count_matches -E 'href="#' "$W/c-all-links"
    # Change G36, kept: the probe crate's feature sets as part 6 P4 left them,
    # copy and copy with comments among them; change M55: charts added, the
    # feature the probe commit gives probe-emend-charts-write-xml.
    for pf in emend,xml dates rowcol metadata rules tables comments images richtext comments,richtext sheetprops metadata,sheetprops read copy copy,comments charts; do
      LINT_SHOWN="CARGO_TARGET_DIR=<target>/main cargo clippy -p size-probe --all-targets --features $pf -- -D warnings"
      lint_run "clippy, the probe crate, features $pf" "$PROBE_TARGET" cargo clippy -p size-probe --all-targets --features "$pf" -- -D warnings
    done
    printf 'warning: unused variable: `x`\nerror[E0425]: cannot find value\n    Checking emend v0.1.0\nnote: warning is not at the start\n' >"$W/c-diag"
    ctl "diag_lines over two diagnostics and two other lines, same command form" 2 diag_lines "$W/c-diag"
    
    echo
    echo "## the crate's tests with the features off, charts alone, images alone, charts with images, charts with comments, charts with read and every feature, both targets, each total P1's committed figure plus the one new chartsheet test where the set compiles it (specs/0035 ruling T; change M69), the chart, chart-write, chartsheet, image, colors, survey, pivot and extlink tests and the carry test counted in each (changes G24, G25, G26, G28, G29, G30, G31, G33, G34, G35, M47 to M53, M56, M57, M59 to M63, M68 and M69)"
    # The workspace build above turns `read` and `charts` on through the tool's
    # dependency (features unify across the workspace), so the crate alone is
    # built here with each feature set, into the main tree's target directory
    # (change K35).
    passed_sum() { awk '/^test result: /{ for (i = 1; i <= NF; i++) if ($(i + 1) ~ /^passed;?$/) n += $i } END { print n + 0 }' "$1"; }
    failed_sum() { awk '/^test result: /{ for (i = 1; i <= NF; i++) if ($(i + 1) ~ /^failed;?$/) n += $i } END { print n + 0 }' "$1"; }
    ran_clean() { [ "$1" = 0 ] && [ "$2" = 0 ] && [ "$3" -gt 0 ]; }
    CH_PASSED_RE='^test package::tests::chart::[a-z0-9_]+ [.][.][.] ok$'
    ch_passed() { count_matches -E "$CH_PASSED_RE" "$1"; }
    CW_PASSED_RE='^test package::tests::chart_write::[a-z0-9_]+ [.][.][.] ok$'
    cw_passed() { count_matches -E "$CW_PASSED_RE" "$1"; }
    CS_PASSED_RE='^test package::tests::chartsheet::[a-z0-9_]+ [.][.][.] ok$'
    cs_passed() { count_matches -E "$CS_PASSED_RE" "$1"; }
    IM_PASSED_RE='^test package::tests::images::([a-z0-9_]+::)?[a-z0-9_]+ [.][.][.] ok$'
    im_passed() { count_matches -E "$IM_PASSED_RE" "$1"; }
    CO_PASSED_RE='^test package::tests::colors::[a-z0-9_]+ [.][.][.] ok$'
    co_passed() { count_matches -E "$CO_PASSED_RE" "$1"; }
    CARRY_PASSED_RE="^test styles::tests::$CARRY_TEST [.][.][.] ok\$"
    carry_passed() { count_matches -E "$CARRY_PASSED_RE" "$1"; }
    SV_PASSED_RE='^test package::tests::survey::[a-z0-9_]+ [.][.][.] ok$'
    sv_passed() { count_matches -E "$SV_PASSED_RE" "$1"; }
    PV_PASSED_RE='^test package::tests::pivot::[a-z0-9_]+ [.][.][.] ok$'
    pv_passed() { count_matches -E "$PV_PASSED_RE" "$1"; }
    EL_PASSED_RE='^test package::tests::extlink::[a-z0-9_]+ [.][.][.] ok$'
    el_passed() { count_matches -E "$EL_PASSED_RE" "$1"; }
    # Change M56: "off" the features off, "ch" charts alone, "im" images alone,
    # "ci" charts and images, "cr" charts and read, "all" every feature
    # (specs/0035 "Phases" and planning's ruling D, carried); change M68: "cc"
    # charts and comments (specs/0038 "Phases"). Change M69 (specs/0035 ruling
    # T, M59's form): each set's total is P1's committed figure plus the one
    # new chartsheet test (the carry's, gated by no cfg line of its own) where
    # the set compiles the module: off and im none, every set with charts one.
    # The figures of off, ch, ci, cc, cr and every feature are read from
    # records/logs/m6p1-p1/test.log at the base, P1's record commit, its host
    # line checked equal to its i686 line; im, which P1's test log does not
    # run, from P1's committed gate.log, the gate's own lines, host equal to
    # i686; and P1's gate.log figures of the six other sets checked equal to
    # its test.log's.
    P61_REC=$BASE
    echo "command: git show <the base>:records/logs/m6p1-p1/test.log, its '  f-<target>-<set>: exit 0; passed <n>;' lines; git show <the base>:records/logs/m6p1-p1/gate.log, its '  <target>, feature <set>: exit 0; passed <n>;' lines"
    git show "$P61_REC:records/logs/m6p1-p1/test.log" >"$W/p61-test.log" 2>/dev/null || : >"$W/p61-test.log"
    git show "$P61_REC:records/logs/m6p1-p1/gate.log" >"$W/p61-gate.log" 2>/dev/null || : >"$W/p61-gate.log"
    P54_REC=$(git log --format='%H' -n 1 -F --grep='M5 part 5 P4 record: logs, the size and API records, the sample and open records, the check' "$C")
    echo "  part 5 P4's record commit, by subject: ${P54_REC:-none found}"
    P53_REC=$(git log --format='%H' -n 1 -F --grep='M5 part 5 P3 record: logs, the labels, removal and open records, the check' "$C")
    git show "$P53_REC:records/logs/m5p5-p3/test.log" >"$W/p53-test.log" 2>/dev/null || : >"$W/p53-test.log"
    set_name() { case $1 in off) echo off ;; ch) echo charts ;; im) echo images ;; ci) echo charts,images ;; cc) echo charts,comments ;; cr) echo charts,read ;; all) echo all ;; esac; }
    # log_total <log> <target> <set name>: the passed figure of the line
    # "  f-<target>-<set name>: exit 0; passed <n>; ...", the first such line.
    log_total() {
      awk -v want="  f-$2-$3: exit 0;" 'index($0, want) == 1 {
        for (i = 1; i <= NF; i++) if ($i == "passed") { v = $(i + 1); sub(/;$/, "", v); print v; exit }
      }' "$1"
    }
    # gate_total <log> <target> <set>: the passed figure of a gate log's line
    # "  <target>, feature <set>: exit 0; passed <n>; ...", the first such line.
    gate_total() {
      awk -v want="  $2, feature $3: exit 0;" 'index($0, want) == 1 {
        for (i = 1; i <= NF; i++) if ($i == "passed") { v = $(i + 1); sub(/;$/, "", v); print v; exit }
      }' "$1"
    }
    same_figure() { [ -n "$1" ] && [ "$1" = "$2" ]; }
    added_by_phase() { case $1 in off | im) echo 0 ;; ch | ci | cc | cr | all) echo 1 ;; esac; }
    for feat in off ch ci cc cr all; do
      ph=$(log_total "$W/p61-test.log" host "$(set_name "$feat")")
      pi=$(log_total "$W/p61-test.log" i686 "$(set_name "$feat")")
      gh=$(gate_total "$W/p61-gate.log" host "$feat")
      echo "    $feat ($(set_name "$feat")): P1's committed test.log figure, host ${ph:-none}, i686 ${pi:-none}; P1's gate.log, host ${gh:-none}; the chartsheet tests this phase adds that the set compiles $(added_by_phase "$feat")"
      printf -v "PREV_$feat" '%s' "$ph"
      note "P1's committed test.log gives the set $feat one figure on both targets (changes M63 and M69)" "$(is same_figure "$ph" "$pi")"
      note "P1's committed gate.log gives the set $feat the same figure (change M69)" "$(is same_figure "$gh" "$ph")"
    done
    ph=$(gate_total "$W/p61-gate.log" host im)
    pi=$(gate_total "$W/p61-gate.log" i686 im)
    echo "    im (images): P1's committed gate.log figure, host ${ph:-none}, i686 ${pi:-none} (P1's test.log runs no images alone set); the chartsheet tests this phase adds that the set compiles $(added_by_phase im)"
    PREV_im=$ph
    note "P1's committed gate.log gives the set im one figure on both targets (change M69)" "$(is same_figure "$ph" "$pi")"
    note "control: log_total reads no images alone figure from P1's test.log, which runs no such set (change M69)" "$(is [ -z "$(log_total "$W/p61-test.log" host images)" ])"
    ctl "gate_total over P1's committed gate.log, charts and comments on the host, same command form (its figure, P1's test.log's)" 679 gate_total "$W/p61-gate.log" host cc
    want_total() {
      local prev
      case $1 in off | ch | im | ci | cc | cr | all) ;; *) return 0 ;; esac
      prev=PREV_$1
      [ -n "${!prev}" ] || return 0
      echo $((${!prev} + $(added_by_phase "$1")))
    }
    echo "  the figures this run must give: off $(want_total off), ch $(want_total ch), im $(want_total im), ci $(want_total ci), cc $(want_total cc), cr $(want_total cr), all $(want_total all)"
    ctl "log_total over part 5 P3's committed test.log, charts and images on the host, same command form (its figure, one fewer than P4's)" 656 log_total "$W/p53-test.log" host charts,images
    note "control: log_total reads no figure for a set the log does not name" "$(is [ -z "$(log_total "$W/p61-test.log" host planted)" ])"
    for target in host i686; do
      for feat in off ch im ci cc cr all; do
        args=(test -p emend)
        [ "$target" = i686 ] && args+=(--target i686-unknown-linux-musl)
        case $feat in
          ch) args+=(--features charts) ;;
          im) args+=(--features images) ;;
          ci) args+=(--features charts,images) ;;
          cc) args+=(--features charts,comments) ;;
          cr) args+=(--features charts,read) ;;
          all) args+=(--all-features) ;;
        esac
        echo "command: CARGO_TARGET_DIR=<target>/main cargo ${args[*]}"
        ( cd "$MAIN" && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4 CARGO_TARGET_DIR=$FEAT_TARGET cargo "${args[@]}" ) >"$W/t-$target-$feat.out" 2>"$W/t-$target-$feat.err"
        rc=$?
        LC_ALL=C "$G" -a -E '^test result: ' "$W/t-$target-$feat.out" | sed 's/^/    /'
        p=$(passed_sum "$W/t-$target-$feat.out"); fl=$(failed_sum "$W/t-$target-$feat.out")
        echo "  $target, feature $feat: exit $rc; passed $p; failed $fl; P1's committed figure plus this phase's chartsheet test where the set compiles it $(want_total "$feat")"
        printf -v "P_${target}_${feat}" '%s' "$p"
        note "the crate's tests pass on $target with the feature $feat, some run and none failed" "$(is ran_clean "$rc" "$fl" "$p")"
        note "the crate's tests that passed on $target with the feature $feat are P1's committed figure plus this phase's chartsheet test where the set compiles it ($(want_total "$feat"); changes M56, M59 to M63 and M69; specs/0035 ruling T)" "$(is [ "$p" = "$(want_total "$feat")" ])"
        # Change M56: the chart module's tests in this run: none without
        # charts, all with it; the chart-write module's none without charts,
        # all less the four gated to images without images, all with both; the
        # image modules' none without images, all less the three gated to
        # other features with images but not every feature, all with every
        # feature; the read modules' tests (colors, survey, pivot, extlink)
        # none without read, all less the ones gated to rules with charts and
        # read, all with every feature (N_* and R_* read at the phase commit
        # above); the carry test with read off.
        nch=$(ch_passed "$W/t-$target-$feat.out")
        ncw=$(cw_passed "$W/t-$target-$feat.out")
        nim=$(im_passed "$W/t-$target-$feat.out")
        nco=$(co_passed "$W/t-$target-$feat.out")
        ncarry=$(carry_passed "$W/t-$target-$feat.out")
        nsv=$(sv_passed "$W/t-$target-$feat.out")
        npv=$(pv_passed "$W/t-$target-$feat.out")
        nel=$(el_passed "$W/t-$target-$feat.out")
        ncs=$(cs_passed "$W/t-$target-$feat.out")
        case $feat in
          off) want_ch=0; want_cw=0; want_im=0; want_co=0; want_carry=1; want_sv=0; want_pv=0; want_el=0 ;;
          ch) want_ch=$N_CH; want_cw=$((N_CW - G_CW)); want_im=0; want_co=0; want_carry=1; want_sv=0; want_pv=0; want_el=0 ;;
          im) want_ch=0; want_cw=0; want_im=$((N_IM - G_IM)); want_co=0; want_carry=1; want_sv=0; want_pv=0; want_el=0 ;;
          ci) want_ch=$N_CH; want_cw=$N_CW; want_im=$((N_IM - G_IM)); want_co=0; want_carry=1; want_sv=0; want_pv=0; want_el=0 ;;
          cc) want_ch=$N_CH; want_cw=$((N_CW - G_CW)); want_im=0; want_co=0; want_carry=1; want_sv=0; want_pv=0; want_el=0 ;;
          cr) want_ch=$N_CH; want_cw=$((N_CW - G_CW)); want_im=0; want_co=$((N_CO - R_CO)); want_carry=0; want_sv=$((N_SV - R_SV)); want_pv=$((N_PV - R_PV)); want_el=$((N_EL - R_EL)) ;;
          *) want_ch=$N_CH; want_cw=$N_CW; want_im=$N_IM; want_co=$N_CO; want_carry=0; want_sv=$N_SV; want_pv=$N_PV; want_el=$N_EL ;;
        esac
        echo "  $target, feature $feat: chart tests passed $nch; expected $want_ch"
        note "the chart tests that ran on $target with the feature $feat are the ones its cfg lines compile ($want_ch; changes M53 and M56)" "$(is [ "$nch" = "$want_ch" ])"
        case $feat in
          off | im) want_cs=0 ;;
          ch | cr) want_cs=$((N_CS - G_CS)) ;;
          ci) want_cs=$((N_CS - M_CS)) ;;
          cc) want_cs=$((N_CS - I_CS)) ;;
          *) want_cs=$N_CS ;;
        esac
        echo "  $target, feature $feat: chartsheet tests passed $ncs; expected $want_cs"
        note "the chartsheet tests that ran on $target with the feature $feat are the ones their cfg lines compile ($want_cs; change M68)" "$(is [ "$ncs" = "$want_cs" ])"
        echo "  $target, feature $feat: chart-write tests passed $ncw; expected $want_cw"
        note "the chart-write tests that ran on $target with the feature $feat are the ones their cfg lines compile ($want_cw; change M56)" "$(is [ "$ncw" = "$want_cw" ])"
        echo "  $target, feature $feat: image tests passed $nim; expected $want_im"
        note "the image tests that ran on $target with the feature $feat are the ones their cfg lines compile ($want_im; change M56)" "$(is [ "$nim" = "$want_im" ])"
        echo "  $target, feature $feat: extlink tests passed $nel; expected $want_el"
        note "the extlink tests that ran on $target with the feature $feat are the ones its cfg lines compile ($want_el; changes M52, M53 and M56)" "$(is [ "$nel" = "$want_el" ])"
        echo "  $target, feature $feat: pivot tests passed $npv; expected $want_pv"
        note "the pivot tests that ran on $target with the feature $feat are the ones its cfg lines compile ($want_pv; changes M51, M53 and M56)" "$(is [ "$npv" = "$want_pv" ])"
        echo "  $target, feature $feat: survey tests passed $nsv; expected $want_sv"
        note "the survey tests that ran on $target with the feature $feat are the ones its cfg lines compile ($want_sv; changes M50, M53 and M56)" "$(is [ "$nsv" = "$want_sv" ])"
        echo "  $target, feature $feat: colors tests passed $nco; expected $want_co; the carry test passed $ncarry; expected $want_carry"
        note "the colors tests that ran on $target with the feature $feat are the ones its cfg lines compile ($want_co; changes M48, M49, M53 and M56)" "$(is [ "$nco" = "$want_co" ])"
        note "the carry test ran on $target with the feature $feat as its cfg line compiles it ($want_carry; changes M48, M49, M53 and M56)" "$(is [ "$ncarry" = "$want_carry" ])"
      done
    done
    echo "  passed: host off $P_host_off, host ch $P_host_ch, host im $P_host_im, host ci $P_host_ci, host cc $P_host_cc, host cr $P_host_cr, host all $P_host_all, i686 off $P_i686_off, i686 ch $P_i686_ch, i686 im $P_i686_im, i686 ci $P_i686_ci, i686 cc $P_i686_cc, i686 cr $P_i686_cr, i686 all $P_i686_all (ch: charts alone; im: images alone; ci: charts and images; cc: charts and comments; cr: charts and read; all: every feature)"
    note "the host and i686 run the same tests with the features off" "$(is [ "$P_host_off" = "$P_i686_off" ])"
    note "the host and i686 run the same tests with charts alone (change M53)" "$(is [ "$P_host_ch" = "$P_i686_ch" ])"
    note "the host and i686 run the same tests with images alone (change M56)" "$(is [ "$P_host_im" = "$P_i686_im" ])"
    note "the host and i686 run the same tests with charts and images (change M53)" "$(is [ "$P_host_ci" = "$P_i686_ci" ])"
    note "the host and i686 run the same tests with charts and comments (change M68)" "$(is [ "$P_host_cc" = "$P_i686_cc" ])"
    note "the host and i686 run the same tests with charts and read (change M53)" "$(is [ "$P_host_cr" = "$P_i686_cr" ])"
    note "with charts and comments more tests run than with charts alone, on the host (change M68)" "$(is [ "$P_host_cc" -gt "$P_host_ch" ])"
    note "with every feature more tests run than with charts and comments, on the host (change M68)" "$(is [ "$P_host_all" -gt "$P_host_cc" ])"
    note "the host and i686 run the same tests with every feature" "$(is [ "$P_host_all" = "$P_i686_all" ])"
    note "with charts alone more tests run than with the features off, on the host (change M53)" "$(is [ "$P_host_ch" -gt "$P_host_off" ])"
    note "with charts alone more tests run than with the features off, on i686 (change M53)" "$(is [ "$P_i686_ch" -gt "$P_i686_off" ])"
    note "with images alone more tests run than with the features off, on the host (change M56)" "$(is [ "$P_host_im" -gt "$P_host_off" ])"
    note "with charts and images more tests run than with charts alone, on the host (change M53)" "$(is [ "$P_host_ci" -gt "$P_host_ch" ])"
    note "with charts and images more tests run than with images alone, on the host (change M56)" "$(is [ "$P_host_ci" -gt "$P_host_im" ])"
    note "with charts and read more tests run than with charts alone, on the host (change M53)" "$(is [ "$P_host_cr" -gt "$P_host_ch" ])"
    note "with every feature more tests run than with charts and read, on the host (change M53)" "$(is [ "$P_host_all" -gt "$P_host_cr" ])"
    note "with every feature more tests run than with charts and images, on the host (change M53)" "$(is [ "$P_host_all" -gt "$P_host_ci" ])"
    note "control: want_total refuses a set it does not name" "$(is [ -z "$(want_total xx)" ])"
    printf 'test result: ok. 7 passed; 1 failed; 2 ignored; 0 measured; 0 filtered out\ntest result: ok. 3 passed; 0 failed; 0 ignored\n' >"$W/c-results"
    ctl "passed_sum over two result lines, same command form" 10 passed_sum "$W/c-results"
    ctl "failed_sum over the same lines, same command form" 1 failed_sum "$W/c-results"
    printf '%s\n' 'test package::tests::colors::a_b ... ok' 'test package::tests::colors::c ... FAILED' \
      'test package::tests::readback::d ... ok' 'test package::tests::colors::e ... ignored' \
      "test styles::tests::$CARRY_TEST ... ok" "test styles::tests::${CARRY_TEST}_x ... ok" \
      'test package::tests::survey::a_b ... ok' 'test package::tests::survey::c ... FAILED' \
      'test package::tests::pivot::a_b ... ok' 'test package::tests::pivot::c ... FAILED' \
      'test package::tests::extlink::a_b ... ok' 'test package::tests::extlink::c ... FAILED' \
      'test package::tests::chart::a_b ... ok' 'test package::tests::chart::c ... FAILED' \
      'test package::tests::chart_write::a_b ... ok' 'test package::tests::chart_write::c ... FAILED' \
      'test package::tests::images::a_b ... ok' 'test package::tests::images::anchors::c ... ok' \
      'test package::tests::images::removal::d ... FAILED' 'test package::tests::imagesx::e ... ok' \
      'test package::tests::chartsheet::a_b ... ok' 'test package::tests::chartsheet::c ... FAILED' >"$W/c-co-out"
    ctl "co_passed over one passing colors test among twenty-two lines, same command form" 1 co_passed "$W/c-co-out"
    ctl "carry_passed over the carry test's one passing line among twenty-two, same command form" 1 carry_passed "$W/c-co-out"
    ctl "sv_passed over one passing survey test among twenty-two lines, same command form" 1 sv_passed "$W/c-co-out"
    ctl "pv_passed over one passing pivot test among twenty-two lines, same command form" 1 pv_passed "$W/c-co-out"
    ctl "el_passed over one passing extlink test among twenty-two lines, same command form" 1 el_passed "$W/c-co-out"
    ctl "ch_passed over one passing chart test among twenty-two lines, the chart-write and chartsheet lines not among them, same command form" 1 ch_passed "$W/c-co-out"
    ctl "cw_passed over one passing chart-write test among twenty-two lines, same command form" 1 cw_passed "$W/c-co-out"
    ctl "im_passed over two passing image tests, one in a submodule, among twenty-two lines, same command form" 2 im_passed "$W/c-co-out"
    ctl "cs_passed over one passing chartsheet test among twenty-two lines, same command form (change M68)" 1 cs_passed "$W/c-co-out"
    
    echo
    echo "## the charts probe's size-profile build on i686 and its section total, printed against P1's committed gate.log's figure, part 6's size record's, part 6 P3's committed gate.log's, part 4's 1055368 and part 5 P4's, and told to planning at any value, judged nowhere here: P3's size log measures and judges this part's cost (specs/0038 \"Size and packaging\"; changes Q59 to Q62, Q63, Q66 to Q69)"
    # Change Q63 (Q59's form, kept): the probe probe-emend-charts-write-xml
    # built with the feature charts in the size profile for i686, into the main
    # tree's target directory, and the section total `size -A` gives, beside
    # part 4's figure 1055368 (part 4 P3's size record) and part 5 P4's, read
    # from P4's committed gate.log, with the difference to each. Change Q68
    # (part 5 P1's form, a part's first phase): the figure is printed against
    # part 6's size record's, records/size-m5p6-2026-10-18-ef9da37.md read at
    # the base (its verdicts table's charts probe row, the column of the
    # sections at the record's commit), with the difference, and against part
    # 6 P3's committed gate.log's figure, checked equal to the record's; it is
    # told to planning at any value and judged nowhere here (specs/0038 "Size
    # and packaging": the size record of P3 states the cost). The checks are
    # that the build exits 0, that a figure was read and that the earlier
    # figures were read. Change Q69: also against P1's committed gate.log
    # figure, records/logs/m6p1-p1/gate.log read at the base, with the
    # difference, told at any value.
    PROBE_BIN=$MAIN_TARGET/i686-unknown-linux-musl/size/probe-emend-charts-write-xml
    PART4_CHARTS=1055368
    # prev_probe <log>: the figure of the line "  the charts probe's sections:
    # <n>; ...", the first such line at the margin of two spaces.
    prev_probe() { awk 'index($0, "  the charts probe'"'"'s sections: ") == 1 { v = $5; sub(/;$/, "", v); print v; exit }' "$1"; }
    P54_GREC=$(git log --format='%H' -n 1 -F --grep='M5 part 5 P4 record: logs, the size and API records, the sample and open records, the check' "$C")
    echo "command: git show <part 5 P4's record commit>:records/logs/m5p5-p4/gate.log, its '  the charts probe's sections: <n>;' line"
    git show "$P54_GREC:records/logs/m5p5-p4/gate.log" >"$W/p54-gate.log" 2>/dev/null || : >"$W/p54-gate.log"
    P4_CHARTS=$(prev_probe "$W/p54-gate.log")
    echo "  part 5 P4's figure, from its committed gate.log: ${P4_CHARTS:-none}"
    p4_read() { [ -n "$P4_CHARTS" ] && [ "$P4_CHARTS" -gt 0 ]; }
    note "part 5 P4's figure was read from its committed gate.log (change Q63)" "$(is p4_read)"
    P43_GREC=$(git log --format='%H' -n 1 -F --grep='M5 part 4 P3 record: logs, the size and API records, the sample and open records, the check' "$C")
    git show "$P43_GREC:records/logs/m5p4-p3/gate.log" >"$W/p43-gate.log" 2>/dev/null || : >"$W/p43-gate.log"
    note "control: prev_probe reads no figure from part 4 P3's committed gate.log, which printed none (changes Q61 to Q63)" "$(is [ -z "$(prev_probe "$W/p43-gate.log")" ])"
    echo "command: git show <the base>:records/logs/m5p6-p3/gate.log, its '  the charts probe's sections: <n>;' line"
    git show "$BASE:records/logs/m5p6-p3/gate.log" >"$W/p63-gate.log" 2>/dev/null || : >"$W/p63-gate.log"
    P63_CHARTS=$(prev_probe "$W/p63-gate.log")
    echo "  part 6 P3's figure, from its committed gate.log: ${P63_CHARTS:-none}"
    p63_read() { [ -n "$P63_CHARTS" ] && [ "$P63_CHARTS" -gt 0 ]; }
    note "part 6 P3's figure was read from its committed gate.log (changes Q67 and Q68)" "$(is p63_read)"
    # record_probe <record>: the fifth cell of the verdicts table's row for the
    # charts probe, a row of seven cells, the sections at the record's commit.
    record_probe() { awk -F ' [|] ' 'index($0, "| `probe-emend-charts-write-xml` | ") == 1 && NF == 7 { print $5; exit }' "$1"; }
    SIZE_RECORD=records/size-m5p6-2026-10-18-ef9da37.md
    echo "command: git show <the base>:$SIZE_RECORD, its verdicts table's row for the charts probe, the sections at the record's commit"
    git show "$BASE:$SIZE_RECORD" >"$W/size-m5p6.md" 2>/dev/null || : >"$W/size-m5p6.md"
    SR_CHARTS=$(record_probe "$W/size-m5p6.md")
    echo "  part 6's size record's figure: ${SR_CHARTS:-none}"
    sr_read() { [ -n "$SR_CHARTS" ] && [ "$SR_CHARTS" -gt 0 ]; }
    note "part 6's size record's figure was read from the committed record (change Q68)" "$(is sr_read)"
    note "it is part 6 P3's committed gate.log's figure (change Q68)" "$(is [ "$SR_CHARTS" = "$P63_CHARTS" ])"
    printf '%s\n' '| `probe-emend-charts-write-xml` | a description of the work | 1 | 2 | 3 |' '| `probe-emend-charts-write-xml` | 10 | 10 | 20 | 30 | 10 | code |' >"$W/c-size-record"
    ctl "record_probe over a planted record holding the work table's row and the verdicts row, same command form (the verdicts row's fifth cell)" 30 record_probe "$W/c-size-record"
    echo "command: git show <the base>:records/logs/m6p1-p1/gate.log, its '  the charts probe's sections: <n>;' line"
    git show "$BASE:records/logs/m6p1-p1/gate.log" >"$W/p61-probe-gate.log" 2>/dev/null || : >"$W/p61-probe-gate.log"
    P61_CHARTS=$(prev_probe "$W/p61-probe-gate.log")
    echo "  P1's figure, from its committed gate.log: ${P61_CHARTS:-none}"
    p61_read() { [ -n "$P61_CHARTS" ] && [ "$P61_CHARTS" -gt 0 ]; }
    note "P1's figure was read from its committed gate.log (change Q69)" "$(is p61_read)"
    echo "command: CARGO_TARGET_DIR=<target>/main cargo build -p size-probe --bin probe-emend-charts-write-xml --features charts --profile size --target i686-unknown-linux-musl"
    ( cd "$MAIN" && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4 CARGO_TARGET_DIR=$MAIN_TARGET cargo build -p size-probe --bin probe-emend-charts-write-xml --features charts --profile size --target i686-unknown-linux-musl ) >"$W/probe-build.out" 2>&1
    probe_rc=$?
    LC_ALL=C "$G" -a -E '^(warning|error)(\[|:)' "$W/probe-build.out" | sed 's/^/    /'
    echo "  the build: exit $probe_rc"
    note "the charts probe's size-profile build on i686 exits 0 (changes Q59 to Q63)" "$(is [ "$probe_rc" = 0 ])"
    # section_total <file>: the Total line of size -A.
    section_total() { size -A "$1" 2>/dev/null | awk '$1 == "Total" { print $2 }'; }
    echo "command: size -A <target>/main/i686-unknown-linux-musl/size/probe-emend-charts-write-xml, its Total line; sha256sum and wc -c of the same file"
    probe_sections=$(section_total "$PROBE_BIN")
    if [ -f "$PROBE_BIN" ]; then
      echo "  <target>/main/i686-unknown-linux-musl/size/probe-emend-charts-write-xml: file $(wc -c <"$PROBE_BIN") bytes; sections ${probe_sections:-none}; sha256 $(sha256sum <"$PROBE_BIN" | cut -d' ' -f1)"
    else
      echo "  <target>/main/i686-unknown-linux-musl/size/probe-emend-charts-write-xml: not there"
    fi
    probe_read() { [ -n "$probe_sections" ] && [ "$probe_sections" -gt 0 ]; }
    note "a section total was read (changes Q59 to Q63)" "$(is probe_read)"
    if probe_read; then
      echo "  the charts probe's sections: $probe_sections; part 4's: $PART4_CHARTS; the difference (this phase's figure less part 4's): $((probe_sections - PART4_CHARTS)); printed (changes Q63, Q66 to Q69)"
      if p4_read; then
        echo "  against part 5 P4's: $P4_CHARTS; the difference (this phase's figure less P4's): $((probe_sections - P4_CHARTS)); printed (changes Q63, Q66 to Q69)"
      fi
      if sr_read; then
        echo "  against part 6's size record's: $SR_CHARTS; the difference (this phase's figure less the record's): $((probe_sections - SR_CHARTS)); printed and told to planning at any value, judged nowhere here (change Q68)"
      fi
      if p61_read; then
        echo "  against P1's committed gate.log: $P61_CHARTS; the difference (this phase's figure less P1's): $((probe_sections - P61_CHARTS)); printed and told to planning at any value, judged nowhere here (change Q69)"
      fi
    fi
    ctl "section_total over this shell, same command form (a figure above zero read, its value not judged)" 1 run_lines section_total "$(command -v bash)"
    note "control: section_total reads nothing from a file that is not there" "$(is [ -z "$(section_total "$W/no-such-binary")" ])"
    
    echo
    echo "## the consumer crate naming NewLabels, LabelPosition, the series' colour and labels fields, the chart's two axis format fields and remove_chart, which the feature charts gained in part 5 P3, and add_chartsheet, which it gained in P1, none added since (changes K61 to K65), with the features off, images alone, charts alone and the two together, and a planted variant the enum lacks refused (part 4a P1's change G3, kept; changes E35, M47 to M50, K51 to K60, K61 and K62)"
    mkdir -p "$CONSUMER/src" || fail=1
    {
      printf '[package]\nname = "charts-consumer"\nversion = "0.0.0"\nedition = "2024"\npublish = false\n\n'
      printf '[workspace]\n\n[dependencies]\nemend = { path = "%s" }\n\n' "$MAIN/crates/emend"
      printf '[features]\ncharts = ["emend/charts"]\nimages = ["emend/images"]\n'
    } >"$CONSUMER/Cargo.toml"
    cat >"$CONSUMER/src/lib.rs" <<'CONSUMER'
    //! Names, once each, the labels' struct and position enum, the series'
    //! colour and labels fields, the chart's two axis format fields and the
    //! chart removal the feature `charts` gains in M5 part 5 P3
    //! (specs/0036-charts-write-second-set.md, "The call"), and the chartsheet
    //! addition it gains in M6 part 1 P1 (specs/0038-chartsheets.md,
    //! "`add_chartsheet`"), each by its full path so that an error names the
    //! item itself.
    pub const K1: emend::package::LabelPosition = emend::package::LabelPosition::OutsideEnd;
    pub const K2: emend::package::NewLabels<'static> = emend::package::NewLabels {
        value: true,
        category: false,
        series_name: false,
        percent: false,
        position: Some(K1),
        number_format: Some("0.0"),
    };
    pub const K3: emend::package::NewSeries<'static> = emend::package::NewSeries {
        name: None,
        categories: None,
        values: "Sheet1!$B$2:$B$4",
        sizes: None,
        color: Some(0x1F77B4),
        labels: Some(K2),
    };
    pub const K4: emend::package::NewChart<'static> = emend::package::NewChart {
        plot: emend::package::NewPlot::Bar {
            direction: emend::package::BarDirection::Column,
            grouping: emend::package::Grouping::Clustered,
        },
        title: None,
        series: &[K3],
        category_axis_title: None,
        value_axis_title: None,
        category_axis_format: Some("@"),
        value_axis_format: Some("0.00"),
        legend: None,
        size: None,
        combined: None,
    };
    pub fn k5(
        package: &mut emend::package::Package<std::io::Cursor<Vec<u8>>>,
    ) -> Result<(), emend::archive::Error> {
        package.remove_chart(b"xl/worksheets/sheet1.xml", 0)
    }
    pub fn k7(
        package: &mut emend::package::Package<std::io::Cursor<Vec<u8>>>,
    ) -> Result<Vec<u8>, emend::archive::Error> {
        package.add_chartsheet("Chart1", &K4)
    }
    CONSUMER
    # The workspace's lock, so the check resolves offline to the versions the
    # workspace pins.
    cp "$MAIN/Cargo.lock" "$CONSUMER/Cargo.lock" || fail=1
    echo "  <scratch>/consumer/Cargo.toml:"; sed 's/^/    /' "$CONSUMER/Cargo.toml"
    echo "  <scratch>/consumer/src/lib.rs:"; sed 's/^/    /' "$CONSUMER/src/lib.rs"
    # Change K57, kept (K59 to K62): "off" the features off, "im" images alone, "ch" charts alone,
    # "ci" charts and images; into the consumer's own target directory (K35).
    # The fifth run, "pl", is charts alone over the planted copy below.
    consumer_check() {
      local feat=$1 args=(check --offline --message-format short)
      case $feat in
        im) args+=(--features images) ;;
        ch | pl) args+=(--features charts) ;;
        ci) args+=(--features charts,images) ;;
      esac
      echo "command: (cd <scratch>/consumer && CARGO_TARGET_DIR=<target>/consumer cargo ${args[*]})"
      ( cd "$CONSUMER" && RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_TARGET_DIR=$CONSUMER_TARGET cargo "${args[@]}" ) >"$W/k-$feat.out" 2>&1
      printf -v "K_RC_$feat" '%s' "$?"
      LC_ALL=C "$G" -a -E '(error|warning)' "$W/k-$feat.out" | sed 's/^/    /'
    }
    for feat in off im ch ci; do
      consumer_check "$feat"
    done
    # Change K61: the planted copy, the items above and a label position the
    # enum lacks (Outside); with charts alone its one error line names the
    # planted variant.
    printf '%s\n' 'pub const K6: emend::package::LabelPosition = emend::package::LabelPosition::Outside;' >>"$CONSUMER/src/lib.rs"
    echo "  <scratch>/consumer/src/lib.rs, planted (the control):"; sed 's/^/    /' "$CONSUMER/src/lib.rs"
    consumer_check pl
    nerr_off=$(count_matches -E 'error' "$W/k-off.out")
    nerr_im=$(count_matches -E 'error' "$W/k-im.out")
    nerr_ch=$(count_matches -E 'error' "$W/k-ch.out")
    nerr_ci=$(count_matches -E 'error' "$W/k-ci.out")
    ncode_pl=$(count_matches -E 'error\[E[0-9]+\]' "$W/k-pl.out")
    # names_in <output> <item>: the error lines with a code naming the item.
    names_in() { LC_ALL=C "$G" -E 'error\[E[0-9]+\]' "$1" | count_matches -F "\`$2\`" /dev/stdin; }
    echo "  features off: exit $K_RC_off, lines naming an error $nerr_off, error lines with a code naming LabelPosition $(names_in "$W/k-off.out" LabelPosition); images alone: exit $K_RC_im, lines naming an error $nerr_im, error lines with a code naming LabelPosition $(names_in "$W/k-im.out" LabelPosition); charts alone: exit $K_RC_ch, lines naming an error $nerr_ch; charts and images: exit $K_RC_ci, lines naming an error $nerr_ci; the planted copy with charts alone: exit $K_RC_pl, error lines with a code $ncode_pl, of them naming Outside $(names_in "$W/k-pl.out" Outside)"
    note "with the features off cargo check fails (change K61)" "$(isnot [ "$K_RC_off" = 0 ])"
    note "with the features off an error line with a code names LabelPosition (change K61)" "$(is [ "$(names_in "$W/k-off.out" LabelPosition)" -ge 1 ])"
    note "with images alone cargo check fails (change K61)" "$(isnot [ "$K_RC_im" = 0 ])"
    note "with images alone an error line with a code names LabelPosition (change K61)" "$(is [ "$(names_in "$W/k-im.out" LabelPosition)" -ge 1 ])"
    note "with charts alone cargo check passes, the struct, the enum, the four fields, remove_chart and add_chartsheet among what it reads (changes K61, K64 and K65)" "$(is [ "$K_RC_ch" = 0 ])"
    note "with charts alone no line names an error (change K61)" "$(is [ "$nerr_ch" = 0 ])"
    note "with charts and images cargo check passes (change K61)" "$(is [ "$K_RC_ci" = 0 ])"
    note "with charts and images no line names an error (change K61)" "$(is [ "$nerr_ci" = 0 ])"
    note "control: the planted copy fails with charts alone (change K61)" "$(isnot [ "$K_RC_pl" = 0 ])"
    planted_named() { [ "$ncode_pl" = 1 ] && [ "$(names_in "$W/k-pl.out" Outside)" = 1 ]; }
    note "control: the planted copy's one error line with a code names the planted variant, Outside (change K61)" "$(is planted_named)"
    printf 'src/lib.rs:3:31: error[E0412]: cannot find type `NewPlot` in module `emend::package`\nsrc/lib.rs:7:35: error[E0412]: cannot find type `NewPlotX` in module `emend::package`\n' >"$W/c-k"
    ctl "error lines with a code naming NewPlot in a planted output naming NewPlot and NewPlotX, same command form (the backquotes keep NewPlotX out)" 1 names_in "$W/c-k" NewPlot
    
    echo
    echo "## status after the run, the lines printed (change K4)"
    # run_lines and run_matches read the command's own exit status. Each
    # pattern is labelled by what it admits (M4 part 2 P1 verification ruling
    # 3; changes J47 to J63, J65 to J69): untracked or modified files under
    # records/logs/m6p1-p2/ (this phase's logs; this log runs before the run
    # log writes its records); specs/0038 modified and uncommitted, admitted
    # only when PLANNING_SPEC is given and the working tree's copy hashes to it
    # (planning's ruling J); and ROADMAP.md modified and uncommitted, admitted
    # only when the working tree's copy hashes to PLANNING_ROADMAP (ruling J's
    # parity item), each sha256 printed. The tree may hold none of them;
    # nothing else is admitted.
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    PLAN_RE='^ M specs/0038-chartsheets[.]md$'
    ROADMAP_RE='^ M ROADMAP[.]md$'
    SPEC_NOW=$(sha256sum <specs/0038-chartsheets.md | cut -d' ' -f1)
    ROADMAP_NOW=$(sha256sum <ROADMAP.md | cut -d' ' -f1)
    echo "  specs/0038 in the working tree: sha256 $SPEC_NOW; PLANNING_SPEC: ${PLANNING_SPEC:-unset} (change J69; ruling J)"
    echo "  ROADMAP.md in the working tree: sha256 $ROADMAP_NOW; PLANNING_ROADMAP: $PLANNING_ROADMAP (change J69; ruling J)"
    # plan_admitted: the modified spec is admitted when PLANNING_SPEC is given
    # and the working tree's copy hashes to it (ruling J).
    plan_admitted() { [ -n "$PLANNING_SPEC" ] && [ "$SPEC_NOW" = "$PLANNING_SPEC" ]; }
    # roadmap_admitted: the modified ROADMAP.md is admitted when the working
    # tree's copy hashes to planning's (change J69).
    roadmap_admitted() { [ -n "$PLANNING_ROADMAP" ] && [ "$ROADMAP_NOW" = "$PLANNING_ROADMAP" ]; }
    st_all=$(run_lines git status --porcelain)
    st_untracked_log=$(run_matches -E '^[?][?] records/logs/m6p1-p2/' git status --porcelain)
    st_tracked_log=$(run_matches -E '^ ?[MARCD] records/logs/m6p1-p2/' git status --porcelain)
    if plan_admitted; then
      st_planning=$(run_matches -E "$PLAN_RE" git status --porcelain)
    else
      st_planning=0
    fi
    if roadmap_admitted; then
      st_roadmap=$(run_matches -E "$ROADMAP_RE" git status --porcelain)
    else
      st_roadmap=0
    fi
    echo "status lines: $st_all; untracked under records/logs/m6p1-p2/: $st_untracked_log; tracked and modified under records/logs/m6p1-p2/: $st_tracked_log; specs/0038 modified and uncommitted, admitted under PLANNING_SPEC: $st_planning; ROADMAP.md modified and uncommitted, admitted at PLANNING_ROADMAP: $st_roadmap"
    status_accounted() {
      [ "$st_all" != error ] && [ "$st_untracked_log" != error ] &&
        [ "$st_tracked_log" != error ] && [ "$st_planning" != error ] && [ "$st_roadmap" != error ] &&
        [ "$st_all" = "$((st_untracked_log + st_tracked_log + st_planning + st_roadmap))" ]
    }
    note "every change in the working tree is a file under records/logs/m6p1-p2/, specs/0038 modified at PLANNING_SPEC or ROADMAP.md modified at PLANNING_ROADMAP, nothing else (change J69; ruling J)" "$(is status_accounted)"
    printf '?? records/logs/m6p1-p2/gate.log\n?? records/logs/m6p1-p1/x.log\n?? records/logs/m6p1-p2x/y.log\n M scripts/check.sh\n' >"$W/c-status"
    ctl "untracked files under records/logs/m6p1-p2/ in a status listing of four, same pattern" 1 count_matches -E '^[?][?] records/logs/m6p1-p2/' "$W/c-status"
    printf ' M specs/0038-chartsheets.md\n M ROADMAP.md\n M specs/0037-measurement-and-close.md\n?? specs/0038-chartsheets.md\n' >"$W/c-spec"
    ctl "specs/0038 modified in a status listing of four, same pattern" 1 count_matches -E "$PLAN_RE" "$W/c-spec"
    ctl "ROADMAP.md modified in the same listing, same pattern (change J69)" 1 count_matches -E "$ROADMAP_RE" "$W/c-spec"
    plan_ctl() { local PLANNING_SPEC=; plan_admitted; }
    note "control: plan_admitted refuses the modified spec when PLANNING_SPEC is not given (ruling J)" "$(isnot plan_ctl)"
    plan_ctl2() { local SPEC_NOW=$SPEC_GAVE; plan_admitted; }
    note "control: plan_admitted refuses a working copy at the pin's hash rather than PLANNING_SPEC's (ruling J)" "$(isnot plan_ctl2)"
    roadmap_ctl() { local ROADMAP_NOW=2a4da8e1861dfb6ca2ddd9fb788b652055f48ee9b8083165ad75baf42b7b2b9a; roadmap_admitted; }
    note "control: roadmap_admitted refuses a working copy at the doc commit's hash rather than planning's (change J69)" "$(isnot roadmap_ctl)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$W/c-err"; printf 'x' >>"$W/c-err"
    nerr_ctl=$(wc -c <"$W/c-err")
    echo "  command: wc -c <phase>/out/gate.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    note "this script wrote nothing to its standard error" "$(is [ "$nerr" = 0 ])"
    note "control: the same count reads one byte more in the copy" "$(is [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "gate log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

