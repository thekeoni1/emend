command: python3 -I -B <work>/opxcorpus.py <work>/opx/chartsheet.xlsx <work>/opxcorpus 2026-10-19; the program:
    """Copies the workbook given first into corpus/<id>.xlsx in the directory
    given second, and writes manifest.tsv beside corpus there, one row in
    specs/0005's form, <id> the first twelve hex digits of the workbook's
    sha256; the date given third is the row's added column. Prints the id, the
    byte count and the sha256."""
    import hashlib
    import os
    import sys
    
    sys.dont_write_bytecode = True
    MANIFEST_HEADER = ("id\tsha256\tbytes\text\tproducer\tproducer_version\tapp\tsource\ttags\tadded"
                       "\toriginal_name\tnote")
    src, out, date = sys.argv[1:4]
    data = open(src, "rb").read()
    digest = hashlib.sha256(data).hexdigest()
    ident = digest[:12]
    os.makedirs(os.path.join(out, "corpus"))
    with open(os.path.join(out, "corpus", ident + ".xlsx"), "wb") as f:
        f.write(data)
    row = [ident, digest, str(len(data)), "xlsx", "openpyxl", "3.1.5", "openpyxl", "generated", "fixture",
           date, "openpyxl-chartsheet.xlsx", "fictional"]
    with open(os.path.join(out, "manifest.tsv"), "w", encoding="utf-8", newline="\n") as f:
        f.write(MANIFEST_HEADER + "\n" + "\t".join(row) + "\n")
    print("%s\t%d\t%s" % (ident, len(data), digest))
