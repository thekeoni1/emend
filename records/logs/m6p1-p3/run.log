    """Prints the sheet count of each workbook given: the <sheet> children of the
    <sheets> element of the workbook part, the part _rels/.rels names with an
    officeDocument relationship of either namespace form; "error" for a
    workbook this cannot read. Counts only: no name, part or path printed."""
    import posixpath
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    
    
    def local(tag):
        return tag.rsplit("}", 1)[-1]
    
    
    for path in sys.argv[1:]:
        try:
            z = zipfile.ZipFile(path)
            rels = ET.fromstring(z.read("_rels/.rels"))
            targets = [r.get("Target") for r in rels if local(r.tag) == "Relationship"
                       and (r.get("Type") or "").endswith("/officeDocument")]
            part = posixpath.normpath(targets[0].lstrip("/"))
            root = ET.fromstring(z.read(part))
            sheets = [c for c in root if local(c.tag) == "sheets"]
            print(sum(1 for s in sheets for c in s if local(c.tag) == "sheet"))
        except Exception:
            print("error")

