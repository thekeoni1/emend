command: python3 -I -B <work>/opxcheck.py <work>/opx/chartsheet.xlsx; and over the committed fixture tests/fixtures/openpyxl-ops.xlsx (the control); the program:
    """Checks the chartsheet openpyxl's chartsheet op wrote into <workbook>: three
    sheets, the last named Chart with a relationship of the chartsheet type, the
    part it names with its Override of the chartsheet content type and a root
    of chartsheet; the drawing its drawing element names through the part's
    rels: one absoluteAnchor with pos 0,0 and ext 0 by 0, its frame naming one
    chart part holding a barChart; and the workbook root's start tag binding no
    prefix for the relationships namespace. Prints one "name: yes|no" line per
    check, a check that cannot be read "no"; the workbook's text is not
    printed."""
    import posixpath
    import re
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    CS_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml.chartsheet+xml"
    REL_NS = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    R = "{%s}id" % REL_NS
    
    
    def local(tag):
        return tag.rsplit("}", 1)[-1]
    
    
    def resolve(base, target):
        if target.startswith("/"):
            return target[1:]
        return posixpath.normpath(posixpath.join(posixpath.dirname(base), target))
    
    
    def rels_of(z, part):
        d, b = posixpath.split(part)
        root = ET.fromstring(z.read(posixpath.join(d, "_rels", b + ".rels")))
        return {r.get("Id"): (r.get("Type") or "", resolve(part, r.get("Target") or ""))
                for r in root if local(r.tag) == "Relationship"}
    
    
    state = {}
    checks = []
    
    
    def check(name, fn):
        try:
            ok = bool(fn())
        except Exception:
            ok = False
        checks.append((name, ok))
    
    
    z = zipfile.ZipFile(sys.argv[1])
    wb = "xl/workbook.xml"
    
    
    def sheets():
        s = [e for c in ET.fromstring(z.read(wb)) if local(c.tag) == "sheets" for e in c]
        state["last"] = s[-1]
        return len(s) == 3 and s[-1].get("name") == "Chart"
    
    
    def sheet_rel():
        kind, part = rels_of(z, wb)[state["last"].get(R)]
        state["part"] = part
        return kind.endswith("/relationships/chartsheet") and part == "xl/chartsheets/sheet1.xml"
    
    
    def override():
        types = ET.fromstring(z.read("[Content_Types].xml"))
        over = [o.get("ContentType") for o in types if local(o.tag) == "Override" and o.get("PartName") == "/" + state["part"]]
        return over == [CS_TYPE]
    
    
    def root_is():
        state["root"] = ET.fromstring(z.read(state["part"]))
        return local(state["root"].tag) == "chartsheet"
    
    
    def drawing_rel():
        el = [c for c in state["root"] if local(c.tag) == "drawing"]
        kind, part = rels_of(z, state["part"])[el[0].get(R)]
        state["drawing"] = part
        return len(el) == 1 and kind.endswith("/relationships/drawing") and part in z.namelist()
    
    
    def one_anchor():
        anchors = list(ET.fromstring(z.read(state["drawing"])))
        state["anchor"] = anchors[0]
        return len(anchors) == 1 and local(anchors[0].tag) == "absoluteAnchor"
    
    
    def pos_zero():
        pos = [c for c in state["anchor"] if local(c.tag) == "pos"]
        return len(pos) == 1 and pos[0].get("x") == "0" and pos[0].get("y") == "0"
    
    
    def ext_zero():
        ext = [c for c in state["anchor"] if local(c.tag) == "ext"]
        return len(ext) == 1 and ext[0].get("cx") == "0" and ext[0].get("cy") == "0"
    
    
    def bar_chart():
        ids = [e.get(R) for e in state["anchor"].iter() if local(e.tag) == "chart"]
        kind, part = rels_of(z, state["drawing"])[ids[0]]
        plot = ET.fromstring(z.read(part))
        return len(ids) == 1 and kind.endswith("/relationships/chart") and any(local(e.tag) == "barChart" for e in plot.iter())
    
    
    def no_prefix():
        text = z.read(wb).decode("utf-8")
        start = re.search(r"<(?:[A-Za-z_][\w.-]*:)?workbook\b[^>]*>", text).group(0)
        return REL_NS not in start
    
    
    check("three sheets, the last named Chart", sheets)
    check("its relationship is of the chartsheet type, naming xl/chartsheets/sheet1.xml", sheet_rel)
    check("its part has one Override, of the chartsheet content type", override)
    check("the part's root is chartsheet", root_is)
    check("its one drawing element names a drawing relationship, its target resolved to an entry", drawing_rel)
    check("the drawing holds one absoluteAnchor", one_anchor)
    check("its pos is 0,0", pos_zero)
    check("its ext is 0 by 0", ext_zero)
    check("its frame names one chart part, which holds a barChart", bar_chart)
    check("the workbook root's start tag binds no prefix for the relationships namespace", no_prefix)
    for name, good in checks:
        print("%s: %s" % (name, "yes" if good else "no"))
