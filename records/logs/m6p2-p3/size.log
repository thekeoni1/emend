    import posixpath, sys, zipfile
    import xml.etree.ElementTree as ET
    
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    RID = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"
    PR = "{http://schemas.openxmlformats.org/package/2006/relationships}"
    CT = "{http://schemas.openxmlformats.org/package/2006/content-types}"
    V = "application/vnd.openxmlformats-officedocument.spreadsheetml."
    z = zipfile.ZipFile(sys.argv[1])
    names = z.namelist()
    types = ET.fromstring(z.read("[Content_Types].xml"))
    defaults = {d.get("Extension").lower(): d.get("ContentType") for d in types.iter(CT + "Default")}
    overrides = {o.get("PartName").lstrip("/"): o.get("ContentType") for o in types.iter(CT + "Override")}
    
    
    def type_of(name):
        if name in overrides:
            return overrides[name]
        base = name.rsplit("/", 1)[-1]
        return defaults.get(base.rsplit(".", 1)[-1].lower()) if "." in base else None
    
    
    def count(kind):
        return sum(1 for n in names if n != "[Content_Types].xml" and type_of(n) == V + kind)
    
    
    def rels_of(part):
        folder, base = posixpath.split(part)
        rels = posixpath.join(folder, "_rels", base + ".rels")
        return list(ET.fromstring(z.read(rels)).iter(PR + "Relationship")) if rels in names else []
    
    
    def resolve(source, target):
        if target.startswith("/"):
            return target[1:]
        return posixpath.normpath(posixpath.join(posixpath.dirname(source), target))
    
    
    book_part = [resolve("", r.get("Target")) for r in rels_of("") if r.get("Type").endswith("/officeDocument")][0]
    book = ET.fromstring(z.read(book_part))
    book_rels = {r.get("Id"): r for r in rels_of(book_part)}
    first = book.find(M + "sheets").find(M + "sheet")
    sheet = resolve(book_part, book_rels[first.get(RID)].get("Target"))
    drawings = sum(1 for r in rels_of(sheet) if r.get("Type").endswith("/relationships/drawing"))
    refs = book.find(M + "externalReferences")
    print("read_worksheets %d" % count("worksheet+xml"))
    print("read_drawings %d" % drawings)
    print("read_pivots %d" % count("pivotTable+xml"))
    print("read_links %d" % (0 if refs is None else len(refs.findall(M + "externalReference"))))
