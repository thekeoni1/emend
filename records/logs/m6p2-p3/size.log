command: the source-set reader, python3 -I -B <scratch>/w/sources.py <dir> <emend features>, printed:
    import os, re, sys
    
    root = sys.argv[1]
    features = set(f for f in sys.argv[2].split(",") if f)
    
    
    def split_args(s):
        parts, depth, cur, quoted = [], 0, "", False
        for ch in s:
            if ch == '"':
                quoted = not quoted
            if not quoted and ch == "(":
                depth += 1
            if not quoted and ch == ")":
                depth -= 1
            if not quoted and depth == 0 and ch == ",":
                parts.append(cur)
                cur = ""
                continue
            cur += ch
        if cur.strip():
            parts.append(cur)
        return parts
    
    
    def ev(expr):
        expr = expr.strip()
        m = re.fullmatch(r'feature\s*=\s*"([^"]+)"', expr)
        if m:
            return m.group(1) in features
        if expr == "test":
            return False
        m = re.fullmatch(r"(any|all|not)\s*\((.*)\)", expr, re.S)
        if m:
            vals = [ev(p) for p in split_args(m.group(2))]
            if m.group(1) == "any":
                return any(vals)
            if m.group(1) == "all":
                return all(vals)
            if len(vals) != 1:
                raise SystemExit("not() with %d arguments" % len(vals))
            return not vals[0]
        raise SystemExit("a cfg this reader does not know: %r" % expr)
    
    
    out = []
    
    
    def walk(path, childdir):
        out.append(path)
        pending = []
        held = None
        for line in open(os.path.join(root, path)):
            t = line.strip()
            # A cfg attribute may run over several lines: held until its
            # brackets close, then read as one.
            if held is not None:
                held += " " + t
                if held.count("[") == held.count("]"):
                    t, held = held, None
                else:
                    continue
            elif t.startswith("#[cfg(") and t.count("[") != t.count("]"):
                held = t
                continue
            if t.startswith("#[cfg("):
                m = re.fullmatch(r"#\[cfg\((.*)\)\]", t, re.S)
                if m is None:
                    raise SystemExit("a cfg attribute this reader cannot read in %s" % path)
                pending.append(m.group(1))
                continue
            if t.startswith("#[") or t.startswith("//") or t == "":
                continue
            m = re.fullmatch(r"(pub(\([^)]*\))?\s+)?mod\s+([a-z_][a-z0-9_]*)\s*;", t)
            if m and all(ev(c) for c in pending):
                name = m.group(3)
                cands = [os.path.join(childdir, name + ".rs"), os.path.join(childdir, name, "mod.rs")]
                found = [c for c in cands if os.path.exists(os.path.join(root, c))]
                if len(found) != 1:
                    raise SystemExit("module %s declared in %s: %d files" % (name, path, len(found)))
                walk(found[0], os.path.join(childdir, name))
            pending = []
    
    
    walk("lib.rs", "")
    for p in sorted(out):
        print(p)
control: the reader takes the any() module with feature b alone, and not the feature-a module or the cfg(test) one: yes
control: the reader takes neither feature module with no feature: yes
control: the reader takes both feature modules with feature a: yes
