    parts to specs gains "M6 part 3" -> specs/0040, its comparison is M6 part 2
    P3's listing, its Eq mark names this spec's "P3", and its prose is this
    rerun's (change WU). Its table of verdicts other than keep stays empty. It
    only formats and counts; it judges nothing.
    
    Usage: make_review.py <listing.tsv> <M6 part 2 P3 listing.tsv> <out.md> <date>
           <short> <listing sha256> <files sha256> <formatter sha256>
           <doc links> <doc anchors> <doc items> <listed module-level items>
           <gate widenings> <new items under the shared gate> <rows that lost Eq>"""
    import re, sys
    from collections import Counter
    
    (listing, old_listing, out, date, short, listing_sha, files_sha, self_sha,
     doc_links, doc_anchors, doc_items, listed_items, gates_path, gates_new_path, eq_path) = sys.argv[1:16]
    
    # Each part's spec: the specs/*.md file its first doc commit added (git log
    # --diff-filter=A -- 'specs/*.md', read in the session).
    SPEC = {
        "M1 part 1": "0008", "M1 part 2": "0009", "M1 part 3": "0010", "M1 part 4": "0011",
        "M1 part 5": "0012", "M1 part 6": "0013", "M2 part 1": "0016", "M2 part 2": "0017",
        "M2 part 3": "0018", "M2 part 4a": "0019", "M2 part 4b": "0020", "M2 part 4c": "0021",
        "M2 part 4d": "0022", "M3 part 2": "0024", "M3 part 3": "0025", "M3 part 4": "0026",
        "M3 part 5": "0027", "M3 part 6": "0028", "M4 part 1": "0030",
        "M4 part 2": "0031", "M5 part 1": "0032", "M5 part 2": "0033",
        "M5 part 3": "0034", "M5 part 4": "0035", "M5 part 5": "0036",
        "M5 part 6": "0037", "M6 part 1": "0038", "M6 part 2": "0039",
        "M6 part 3": "0040",
    }
    
    # The verdicts that are not "keep": none. Part 7 P3's six (five renames and
    # one hide) were applied by M4 part 1 P2; every item listed now is keep, the
    # items of M6 part 3 among them.
    CHANGE = {}
    
    # Changes VY and WU (specs/0040 "P3"): the rows that keep their key and
    # lost Eq, from the fifteenth argument, one name|kind|module|before|now line
    # each; marked in the table, the verdict keep.
    eq_rows = [line.split("|", 4) for line in open(eq_path).read().split("\n") if line]
    eq_keys = set((module, kind, name) for name, kind, module, _b, _a in eq_rows)
    
    def spec_of(subject):
        m = re.match(r"^(M\d+ part \d+[a-z]?)", subject)
        return ("specs/" + SPEC[m.group(1)]) if m and m.group(1) in SPEC else "-"
    
    def load(path):
        with open(path) as f:
            header = f.readline().rstrip("\n").split("\t")
            return [dict(zip(header, line.rstrip("\n").split("\t"))) for line in f]
    
    def key(r):
        return (r["module"], r["kind"], r["name"], r["container"], r["cfg"], r["added"])
    
    rows = load(listing)
    old = load(old_listing)
    
    lines = []
    verdicts = Counter()
    by_module = {}
    for r in rows:
        by_module.setdefault(r["module"], []).append(r)
    n = 0
    for module in sorted(by_module, key=lambda m: (m.count("::"), m)):
        lines.append("")
        lines.append("### `%s`" % module)
        lines.append("")
        lines.append("| # | item | kind | feature | added by | spec | verdict |")
        lines.append("| --- | --- | --- | --- | --- | --- | --- |")
        for r in by_module[module]:
            n += 1
            name = r["name"] if r["container"] == "-" else "%s.%s" % (r["container"], r["name"])
            if r["kind"] == "use":
                name = "use %s" % r["name"]
            feature = r["cfg"] if r["cfg"] != "-" else "core"
            verdicts["keep"] += 1
            name = name.replace("|", "\\|")
            mark = "keep; Eq dropped (specs/0040 \"P3\")" if (r["module"], r["kind"], r["name"]) in eq_keys and r["container"] == "-" else "keep"
            lines.append("| %d | `%s` | %s | %s | %s | %s | %s |" % (
                n, name, r["kind"], feature.replace("|", "\\|"), r["added"], spec_of(r["added_subject"]), mark))
    
    new_keys = [key(r) for r in rows]
    old_keys = [key(r) for r in old]
    gone = sorted(set(old_keys) - set(new_keys))
    came = sorted(set(new_keys) - set(old_keys))
    
    def show(k):
        module, kind, name, container, cfg, added = k
        item = name if container == "-" else "%s.%s" % (container, name)
        if kind == "use":
            item = "use %s" % name
        return "`%s` %s in `%s`, feature %s, added by %s" % (
            item, kind, module, cfg if cfg != "-" else "core", added)
    
    kinds = Counter(r["kind"] for r in rows)
    head = [
        "# API review rerun, Milestone 6 part 3 P3 (%s, %s)" % (date, short),
        "",
        "The API listing rerun as Milestone 6 part 2 P3 did, after Milestone 6 part 3 added a series' trendline and error bars, a chart's drop lines, high-low lines and up-down bars, and its axes' options and date form under the feature `charts` (`specs/0040-analytic-chart-elements.md`, \"P3\"). Every change against part 2's listing is named: forty rows new and one gone, below. The gone row and one of the new are the `charts` re-export in `crate::package`, its name list grown by the part's nine new types (`NewTrendline`, `TrendlineKind`, `NewErrorBars`, `ErrorDirection`, `ErrorBarKind`, `ErrorValue`, `NewAxis`, `NewDateAxis` and `TimeUnit`), so its key changed. One row keeps its key and changes (specs/0040 \"P3\": the rows that lose `Eq` marked): `NewSeries` derives `PartialEq` without `Eq` since part 3 P1, its `NewTrendline` and `NewErrorBars` holding `f64`; it is marked in the table and listed below. The part adds no message and no `NewPlot` variant (test.log section T1 checks both). M6 part 2 P3's record is `records/api-review-m6p2-2026-10-20-50a3989.md`.",
        "",
        "- Listing: every `pub` item of `crates/emend` reachable from the crate root, as `records/logs/m6p3-p3/test.log` (section T1) prints it from the phase commit's sources with part 7 P3's listing program; its file `listing.tsv` sha256 %s, `files.tsv` sha256 %s." % (listing_sha, files_sha),
        "- Formatter: this record is assembled by `make_review.py`, generated from M6 part 2 P3's formatter, sha256 %s (printed in test.log, section R2), its table of non-keep verdicts empty and its spec map extended to M6 part 3." % self_sha,
        "- Items: %d, by kind: %s." % (len(rows), ", ".join("%s %d" % (k, kinds[k]) for k in sorted(kinds, key=lambda k: (-kinds[k], k)))),
        "- The doc build (test.log section T2): `cargo doc` with every feature and `-D warnings`, exit 0, no warning line; its index `all.html` holds %s link lines, of which %s are the page's section anchors, leaving %s documented module-level items, against the listing's %s reachable module-level types, functions, constants and aliases." % (doc_links, doc_anchors, doc_items, listed_items),
        "- Columns: as part 7's record: `item` is the item's name, `Container.name` for a method or field, `use ...` for a re-export; `feature` is the cfg in force at the item (`core` for none); `added by` is the commit the listing finds introducing the item's declaration (a heuristic the listing program states); `spec` is that commit's part's spec.",
        "- Verdicts: every item keep; the row that lost Eq marked so beside it.",
    ]
    diff = ["", "## Rows that differ from M6 part 2 P3's listing", "",
            "Compared by key (module, kind, name, container, cfg, added by): %d of M6 part 2 P3's rows are not in this listing and %d of this listing's rows are not in M6 part 2 P3's; every other row is equal." % (len(gone), len(came)), "",
            "M6 part 2 P3's rows not here:", ""]
    diff += ["- %s" % show(k) for k in gone]
    # Changes YM, ZH, ZZO and ZZW (M5 part 6 P3), VD (M6 part 2 P3), VY (M6
    # part 2 P3) and WU (M6 part 3 P3): of the rows not in M6 part 2 P3's, those equal to a gone row but for the cfg are items whose gate
    # was widened;
    # the others are new items. A new row whose added-by commit differs from
    # its new type's row's is named, the cause not judged.
    gone_bare = set(k[:4] + k[5:] for k in gone)
    widened = [k for k in came if k[:4] + k[5:] in gone_bare]
    diff += ["", "This listing's rows not in M6 part 2 P3's (%d listed: %d cfg-widened items, %d new by key):" % (len(came), len(widened), len(came) - len(widened)), ""]
    diff += ["The %d cfg-widened items are M6 part 2 P3's rows not here with their cfg widened; the other %d rows are new by key, the items M6 part 3 adds and any row whose key changed (the rows not here above)." % (len(widened), len(came) - len(widened)), ""]
    owner = {(k[0], k[2]): k[5] for k in came if k[1] in ("struct", "enum") and k[3] == "-"}
    split = [k for k in came if k[3] != "-" and (k[0], k[3]) in owner and owner[(k[0], k[3])] != k[5]]
    if split:
        diff += ["%d new rows have an added-by commit other than their new type's: either a later commit added the member to the type, or the listing heuristic dates the declaration line to an earlier commit that already held an equal line in the same file. This record does not say which." % len(split), ""]
        diff += ["- `%s.%s`: %s; `%s`: %s" % (k[3], k[2], k[5], k[3], owner[(k[0], k[3])]) for k in split]
        diff += [""]
    diff += ["- %s" % show(k) for k in came]
    # Change YM: the items the feature gates widened, pub or not (P1 ruling A),
    # from the thirteenth argument, one name|cfg line each.
    gates = [line.split("|", 1) for line in open(gates_path).read().split("\n") if line]
    pub_names = set(k[2] for k in widened)
    n_pub = sum(1 for name, _c in gates if name in pub_names)
    diff += ["", "## Items the feature gates widened to `charts`", "",
             "%d items, each gated with `charts` as well since M6 part 2 P3's listing, read from the diff over `crates/emend/src/package.rs` and declared there at M6 part 2 P3's phase commit (test.log section T1): %d pub, in this listing as the cfg-widened rows above; %d crate-private, not in the pub listing." % (len(gates), n_pub, len(gates) - n_pub), ""]
    diff += ["- `%s`: %s, `%s`" % (name, "pub, in the listing" if name in pub_names else "crate-private, not in the pub listing", cfg) for name, cfg in gates]
    # Change VD: the items new under the shared gate since M6 part 2 P3's
    # listing, from the fourteenth argument, one name|cfg line each: not
    # widenings, items this milestone adds.
    gates_new = [line.split("|", 1) for line in open(gates_new_path).read().split("\n") if line]
    diff += ["", "## Items new under the shared gate", "",
             "%d items, each gated with `charts` and another feature since M6 part 2 P3's listing and not declared in `crates/emend/src/package.rs` at its phase commit (test.log section T1): new items, crate-private, not in the pub listing." % len(gates_new), ""]
    diff += ["- `%s`: `%s`" % (name, cfg) for name, cfg in gates_new]
    # Changes VY and WU: the rows that keep their key and lost Eq.
    diff += ["", "## Rows that keep their key and lost Eq", "",
             "%d rows equal by key in both listings, whose derive drops `Eq` since M6 part 2 P3's phase commit (specs/0040 \"P3\"; test.log section T1 reads each derive line at both commits): the listing's key does not see the change, so it is marked here and in the table, the verdict keep." % len(eq_rows), ""]
    diff += ["- `%s` %s in `%s`: `%s` at M6 part 2 P3's phase commit, `%s` now" % (name, kind, module, b, a) for name, kind, module, b, a in eq_rows]
    tail = ["", "## Counts per verdict", ""]
    for v in ("keep", "rename before publication", "hide", "widen or narrow"):
        tail.append("- %s: %d" % (v, verdicts[v]))
    tail.append("- in all: %d" % sum(verdicts.values()))
    tail.append("")
    with open(out, "w") as f:
        f.write("\n".join(head + diff + ["", "## The items, by module"] + lines + tail))
    print("rows %d; %s; differing from M6 part 2 P3: %d gone, %d new; gate-widened %d, %d of them pub; new under the shared gate %d; Eq dropped %d" % (len(rows), dict(verdicts), len(gone), len(came), len(gates), n_pub, len(gates_new), len(eq_rows)))
