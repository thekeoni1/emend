    printf '%s\n' package.tests.chart_write.the_texts_follow_the_check_order.14 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.chart_write.the_texts_follow_the_check_order.15 >>"$B/want-new.pairs"
