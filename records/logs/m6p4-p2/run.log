command: python3 -I -B <work>/txcmp.py <work>/opxcorpus/corpus/e6dcd6ce27d0.xlsx <work>/opxrun-chart-text/e6dcd6ce27d0/out.host.xlsx <work>/opxrun-chart-edit/e6dcd6ce27d0/out.host.xlsx; over the fixture against itself (the control); and with --place-control; the program:
    """Compares the text forms emend's text sample wrote with those openpyxl's
    chart-text op wrote, field by field where both write the field
    (specs/0041 "Harness runs", the openpyxl fixture; specs/0040 ruling N's
    shape).
    
    Usage: python3 -I -B txcmp.py <fixture> <text sample's output> <edit sample's output>
           python3 -I -B txcmp.py --place-control
    
    openpyxl's elements are read from the fixture's one chart part: its
    category axis's txPr, its data labels' txPr (the plot's dLbls) and that
    axis txPr's defRPr. emend's are read from the parts the output adds beside
    the fixture's: the column chart's category axis's txPr and its series'
    data labels' txPr (sz there), and the pie's data labels' defRPr (b and the
    latin typeface, which the column does not write); and the style from the
    one chart part the edit sample's output adds beside the fixture's (ruling
    G). Each element is found by
    its local name, by ElementTree, the namespace ignored (openpyxl writes the
    chart namespace as the default one, emend with the c: prefix).
    
    The fields compared:
      txPr under catAx, and txPr under dLbls: each side's txPr found there,
        its preceding sibling printed, its place among its siblings by the
        schema's sequence (CT_CatAx, CT_DLbls), the dLbls's own parent
        printed for both;
      sz on the category axis's defRPr, and sz on the labels' defRPr: a
        decimal on both sides, the values printed, equality not required;
      b on a defRPr, and the latin typeface on a defRPr: both written, equal
        (openpyxl's 1 and Arial are the op's constants, emend's the sample's),
        latin placed among the defRPr's children by CT_TextCharacterProperties;
      style: the root's c:style val, a decimal on both sides, equal (26 =
        26, required; ruling G), each side's preceding sibling printed as found
        (emend's roundedCorners, openpyxl's none: its style the root's first
        child), named and not judged.
    Named and not compared: i (openpyxl writes none), openpyxl's empty run in
    each txPr (a:r with an empty a:t), its bare endParaRPr, and its title's
    run without rPr after an empty defRPr; each printed with what openpyxl
    writes.
    
    --place-control runs the judgment and the place rule over planted
    readings and sibling lists, one "name: yes|no" line each, yes where the
    rule gives the planted case's expected answer."""
    import re
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    SHARED = ["axId", "scaling", "delete", "axPos", "majorGridlines", "minorGridlines", "title", "numFmt",
              "majorTickMark", "minorTickMark", "tickLblPos", "spPr", "txPr", "crossAx", "crosses", "crossesAt"]
    SEQUENCE = {
        "catAx": SHARED + ["auto", "lblAlgn", "lblOffset", "tickLblSkip", "tickMarkSkip", "noMultiLvlLbl", "extLst"],
        "dLbls": ["dLbl", "delete", "numFmt", "spPr", "txPr", "dLblPos", "showLegendKey", "showVal", "showCatName",
                  "showSerName", "showPercent", "showBubbleSize", "separator", "showLeaderLines", "leaderLines",
                  "extLst"],
        "chartSpace": ["date1904", "lang", "roundedCorners", "AlternateContent", "style", "clrMapOvr",
                       "pivotSource", "protection", "chart", "spPr", "txPr", "externalData", "printSettings",
                       "userShapes", "extLst"],
        "defRPr": ["ln", "noFill", "solidFill", "gradFill", "blipFill", "pattFill", "grpFill", "effectLst",
                   "effectDag", "highlight", "uLnTx", "uLn", "uFillTx", "uFill", "latin", "ea", "cs", "sym",
                   "hlinkClick", "hlinkMouseOver", "rtl", "extLst"],
    }
    # crosses and crossesAt are a choice: one rank; so are the fills.
    FILLS = ("noFill", "solidFill", "gradFill", "blipFill", "pattFill", "grpFill")
    RANK = {}
    for parent, seq in SEQUENCE.items():
        rank = {}
        for i, n in enumerate(seq):
            if n == "crossesAt":
                rank[n] = seq.index("crosses")
            elif n in FILLS:
                rank[n] = seq.index("noFill")
            else:
                rank[n] = i
        RANK[parent] = rank
    DECIMAL = re.compile(r"[0-9]+")
    BOOLEAN = {"0", "1", "true", "false"}
    
    
    def local(tag):
        return tag.rsplit("}", 1)[-1]
    
    
    def kid(element, name):
        if element is None:
            return None
        found = [c for c in element if local(c.tag) == name]
        return found[0] if found else None
    
    
    def place_ok(parent_name, siblings, index):
        """Whether siblings[index] sits where the parent's sequence puts it."""
        rank = RANK[parent_name]
        me = siblings[index]
        if me not in rank:
            return False
        if any(s not in rank or rank[s] > rank[me] for s in siblings[:index]):
            return False
        if any(s not in rank or rank[s] < rank[me] for s in siblings[index + 1:]):
            return False
        return True
    
    
    def placed(parent, name):
        """(found, the preceding sibling or "none", place ok) of the one child
        `name` of `parent`."""
        if parent is None:
            return None
        names = [local(c.tag) for c in parent]
        found = [i for i, n in enumerate(names) if n == name]
        if len(found) != 1:
            return None
        i = found[0]
        return parent[i], (names[i - 1] if i else "none"), place_ok(local(parent.tag), names, i)
    
    
    def defrpr(txpr):
        return kid(kid(kid(txpr, "p"), "pPr"), "defRPr")
    
    
    def judged(kind, a, b, equal):
        """Whether two readings (value, place ok) are the same form."""
        if a is None or b is None:
            return False
        ok_a = DECIMAL.fullmatch(a[0] or "") if kind == "decimal" else (a[0] in BOOLEAN if kind == "boolean" else bool(a[0]))
        ok_b = DECIMAL.fullmatch(b[0] or "") if kind == "decimal" else (b[0] in BOOLEAN if kind == "boolean" else bool(b[0]))
        return bool(ok_a) and bool(ok_b) and a[1] and b[1] and (a[0] == b[0] or not equal)
    
    
    def place_control():
        cases = [
            ("txPr after tickLblPos on a category axis", "catAx", ["axId", "minorTickMark", "tickLblPos", "txPr", "crossAx"], 3, True),
            ("txPr after minorTickMark with no tickLblPos (openpyxl's form)", "catAx", ["axId", "axPos", "majorTickMark", "minorTickMark", "txPr", "crossAx"], 4, True),
            ("control: txPr before tickLblPos refused", "catAx", ["axId", "txPr", "tickLblPos", "crossAx"], 1, False),
            ("txPr first in dLbls", "dLbls", ["txPr", "showLegendKey", "showVal"], 0, True),
            ("txPr after numFmt in dLbls", "dLbls", ["numFmt", "txPr", "dLblPos", "showVal"], 1, True),
            ("control: txPr after showVal refused", "dLbls", ["showVal", "txPr"], 1, False),
            ("latin after solidFill in defRPr", "defRPr", ["solidFill", "latin"], 1, True),
            ("control: latin before solidFill refused", "defRPr", ["latin", "solidFill"], 0, False),
            ("control: an element the sequence does not hold refused", "dLbls", ["txPr", "planted"], 0, False),
        ]
        for name, parent, siblings, index, want in cases:
            print("%s: %s" % (name, "yes" if place_ok(parent, siblings, index) == want else "no"))
        judged_cases = [
            ("sz 1400 against 900 taken, equality not required", "decimal", ("1400", True), ("900", True), False, True),
            ("control: sz against a value that is not a number refused", "decimal", ("1400", True), ("x", True), False, False),
            ("control: b 1 against 0 refused, equality required", "boolean", ("1", True), ("0", True), True, False),
            ("control: a typeface against another refused, equality required", "text", ("Arial", True), ("Calibri", True), True, False),
            ("control: a field out of place on one side refused", "text", ("Arial", True), ("Arial", False), True, False),
            ("control: a field one side does not write refused", "decimal", ("900", True), None, False, False),
            ("control: style 26 against 2 refused, equality required", "decimal", ("26", True), ("2", True), True, False),
        ]
        for name, kind, a, b, equal, want in judged_cases:
            print("%s: %s" % (name, "yes" if judged(kind, a, b, equal) == want else "no"))
    
    
    def charts(path, skip=()):
        z = zipfile.ZipFile(path)
        out = []
        for name in sorted(n for n in z.namelist() if re.match(r"xl/charts/chart[0-9]+\.xml$", n)):
            if name not in skip:
                out.append((name, ET.fromstring(z.read(name))))
        return out
    
    
    def area_of(root):
        return kid(kid(root, "chart"), "plotArea")
    
    
    def main():
        if sys.argv[1:] == ["--place-control"]:
            place_control()
            return
        fixture, output, edited = sys.argv[1:4]
        theirs = charts(fixture)
        skip = {n for n, _ in theirs}
        their_area = area_of(theirs[0][1]) if len(theirs) == 1 else None
        column = pie = None
        for _, root in charts(output, skip):
            area = area_of(root)
            if kid(area, "barChart") is not None and column is None:
                column = area
            if kid(area, "pieChart") is not None and pie is None:
                pie = area
        their_cat = kid(their_area, "catAx")
        their_labels = kid(kid(their_area, "barChart"), "dLbls")
        our_cat = kid(column, "catAx")
        our_labels = kid(kid(kid(column, "barChart"), "ser"), "dLbls")
        pie_rpr = defrpr(kid(kid(kid(kid(pie, "pieChart"), "ser"), "dLbls"), "txPr"))
        their_rpr = defrpr(kid(their_cat, "txPr"))
        same = 0
        lines = []
        # The two txPr places.
        for field, a_parent, b_parent, a_where, b_where in (
                ("txPr under catAx", their_cat, our_cat, "the plot area", "the plot area"),
                ("txPr under dLbls", their_labels, our_labels, "barChart", "ser")):
            a, b = placed(a_parent, "txPr"), placed(b_parent, "txPr")
            good = a is not None and b is not None and a[2] and b[2]
            if a is None or b is None:
                detail = "written by openpyxl %s, by emend %s" % ("yes" if a else "no", "yes" if b else "no")
            else:
                detail = ("openpyxl after %s, its parent's parent %s; emend after %s, its parent's parent %s; place %s, %s"
                          % (a[1], a_where, b[1], b_where, "yes" if a[2] else "no", "yes" if b[2] else "no"))
            same += 1 if good else 0
            lines.append("%s: %s; the same form: %s" % (field, detail, "yes" if good else "no"))
        # sz on the two defRPr.
        for field, a_rpr, b_rpr in (("sz on the category axis's defRPr", their_rpr, defrpr(kid(our_cat, "txPr"))),
                                    ("sz on the labels' defRPr", defrpr(kid(their_labels, "txPr")),
                                     defrpr(kid(our_labels, "txPr")))):
            a = (a_rpr.get("sz"), True) if a_rpr is not None and a_rpr.get("sz") is not None else None
            b = (b_rpr.get("sz"), True) if b_rpr is not None and b_rpr.get("sz") is not None else None
            good = judged("decimal", a, b, False)
            detail = ("openpyxl %s; emend %s; decimal both; equal not required" % (a[0], b[0])) if a and b else \
                "written by openpyxl %s, by emend %s" % ("yes" if a else "no", "yes" if b else "no")
            same += 1 if good else 0
            lines.append("%s: %s; the same form: %s" % (field, detail, "yes" if good else "no"))
        # b, and the latin typeface with its place.
        a = (their_rpr.get("b"), True) if their_rpr is not None and their_rpr.get("b") is not None else None
        b = (pie_rpr.get("b"), True) if pie_rpr is not None and pie_rpr.get("b") is not None else None
        good = judged("boolean", a, b, True)
        same += 1 if good else 0
        lines.append("b on a defRPr: %s; the same form: %s"
                     % (("openpyxl %s (the category axis's); emend %s (the pie's labels'); equal required" % (a[0], b[0]))
                        if a and b else "written by openpyxl %s, by emend %s" % ("yes" if a else "no", "yes" if b else "no"),
                        "yes" if good else "no"))
        la, lb = placed(their_rpr, "latin"), placed(pie_rpr, "latin")
        a = (la[0].get("typeface"), la[2]) if la else None
        b = (lb[0].get("typeface"), lb[2]) if lb else None
        good = judged("text", a, b, True)
        same += 1 if good else 0
        lines.append("latin typeface on a defRPr: %s; the same form: %s"
                     % (("openpyxl %s, after %s; emend %s, after %s; place %s, %s; equal required"
                         % (a[0], la[1], b[0], lb[1], "yes" if a[1] else "no", "yes" if b[1] else "no"))
                        if a and b else "written by openpyxl %s, by emend %s" % ("yes" if a else "no", "yes" if b else "no"),
                        "yes" if good else "no"))
        # The style: openpyxl's from the fixture's root, emend's from the one
        # chart part the edit sample adds (ruling G).
        their_root = theirs[0][1] if len(theirs) == 1 else None
        ours_added = charts(edited, skip)
        our_root = ours_added[0][1] if len(ours_added) == 1 else None
        sa, sb = placed(their_root, "style"), placed(our_root, "style")
        a = (sa[0].get("val"), True) if sa else None
        b = (sb[0].get("val"), True) if sb else None
        good = judged("decimal", a, b, True)
        same += 1 if good else 0
        lines.append("style on the chartSpace: %s; the same form: %s"
                     % (("openpyxl %s, after %s; emend %s (the edit sample's added chart), after %s; the preceding "
                         "siblings named, not judged; equal required" % (a[0], sa[1], b[0], sb[1]))
                        if a and b else "written by openpyxl %s, by emend %s" % ("yes" if a else "no", "yes" if b else "no"),
                        "yes" if good else "no"))
        for line in lines:
            print(line)
        rprs = [e for e in (their_root.iter() if their_root is not None else []) if local(e.tag) in ("defRPr", "rPr")]
        print("named, not compared: i: openpyxl writes %s" % ("one" if any(e.get("i") is not None for e in rprs) else "none"))
        txprs = [e for e in (their_root.iter() if their_root is not None else []) if local(e.tag) == "txPr"]
        empty = sum(1 for t in txprs for p in t if local(p.tag) == "p" for r in p if local(r.tag) == "r"
                    and all(not (x.text or "") for x in r if local(x.tag) == "t"))
        bare = sum(1 for t in txprs for p in t if local(p.tag) == "p" for e in p if local(e.tag) == "endParaRPr"
                   and not e.attrib and len(e) == 0)
        print("named, not compared: the empty run in a txPr: openpyxl writes %d, in its %d txPr" % (empty, len(txprs)))
        print("named, not compared: the bare endParaRPr: openpyxl writes %d" % bare)
        title = kid(kid(kid(kid(their_root, "chart"), "title"), "tx"), "rich")
        paragraph = kid(title, "p")
        run = kid(paragraph, "r")
        print("named, not compared: the title's run: openpyxl writes it %s rPr, after a%s defRPr"
              % ("with" if kid(run, "rPr") is not None else "without",
                 "n empty" if defrpr(title) is not None and not defrpr(title).attrib and len(defrpr(title)) == 0
                 else " written"))
        print("fields compared 7; the same form %d" % same)
    
    
    main()
