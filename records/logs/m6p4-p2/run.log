    """Checks the forms of the text fixture and of a text sample's output of it
    (specs/0041-chart-text-and-edits.md, "The chart part" and ruling B; the
    schema's orders, its "Facts"). Given the fixture alone, checks its own
    chart part: the chartSpace's children in the schema's order, the root
    mc:AlternateContent after roundedCorners holding c14:style 102 in its
    first Choice and c:style 2 in its Fallback; the title's rich text with
    a:pPr a:defRPr sz 1400 b 1 before the run and the run's a:rPr sz 1400 b 1;
    the dLbls's txPr before showLegendKey; the catAx's and the valAx's txPr
    after tickLblPos; the legend's after overlay; and the chart part's rels
    naming a chartStyle and a chartColorStyle part, each there with its root
    (cs:chartStyle, cs:colorStyle) and its Override. Given the fixture and an
    output, checks the fixture's chart part, its rels part and both style
    parts in the output byte for byte, the kept part's AlternateContent again
    (102 and 2), and the chart parts the output adds: three, a barChart, a
    lineChart and a pieChart; each txPr's parent and its preceding sibling
    printed, each placed by the schema's sequence (an axis's after
    tickLblPos, a legend's after overlay, a dLbls's after numFmt or first,
    before dLblPos or showLegendKey); six txPr and no style in the added
    parts; each title whose paragraph has a:pPr its a:defRPr before the run
    and the run's a:rPr with the same attributes and children. Given --axis
    and a comma-separated list of child names, judges that list by the axis
    rule (txPr after tickLblPos and before crossAx) and prints one line.
    Prints one "name: yes|no" line per check; no text of the workbook is
    printed."""
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    MC = "{http://schemas.openxmlformats.org/markup-compatibility/2006}"
    C14 = "{http://schemas.microsoft.com/office/drawing/2007/8/2/chart}"
    CNS = "{http://schemas.openxmlformats.org/drawingml/2006/chart}"
    FIX = "xl/charts/chart1.xml"
    KEPT = (FIX, "xl/charts/_rels/chart1.xml.rels", "xl/charts/style1.xml", "xl/charts/colors1.xml")
    
    
    def local(tag):
        return tag.rsplit("}", 1)[-1]
    
    
    def names(element):
        return [local(c.tag) for c in element]
    
    
    def ordered(got, order):
        at = 0
        for name in got:
            while at < len(order) and order[at] != name:
                at += 1
            if at == len(order):
                return False
        return True
    
    
    SPACE = ["date1904", "lang", "roundedCorners", "AlternateContent", "style", "clrMapOvr", "pivotSource",
             "protection", "chart", "spPr", "txPr", "externalData", "printSettings", "userShapes", "extLst"]
    AXIS_BEFORE = ("tickLblPos", "spPr")
    AXIS_AFTER = ("crossAx", "crosses", "crossesAt")
    
    
    def axis_ok(got):
        """The axis's txPr after tickLblPos (or spPr) and before crossAx."""
        if got.count("txPr") != 1:
            return False
        i = got.index("txPr")
        return i > 0 and got[i - 1] in AXIS_BEFORE and i + 1 < len(got) and got[i + 1] in AXIS_AFTER
    
    
    def place_ok(parent, got):
        i = got.index("txPr")
        before = got[i - 1] if i > 0 else None
        after = got[i + 1] if i + 1 < len(got) else None
        if parent in ("catAx", "valAx", "dateAx"):
            return axis_ok(got)
        if parent == "legend":
            return before in ("overlay", "spPr") and after in (None, "extLst")
        if parent == "dLbls":
            return before in (None, "numFmt", "spPr") and after in ("dLblPos", "showLegendKey")
        return False
    
    
    def chart_of(text):
        root = ET.fromstring(text)
        return root, [c for c in root if local(c.tag) == "chart"][0]
    
    
    def style_alternate(root):
        alt = [c for c in root if c.tag == MC + "AlternateContent"]
        if len(alt) != 1:
            return None
        choice = [c for c in alt[0] if c.tag == MC + "Choice"]
        fallback = [c for c in alt[0] if c.tag == MC + "Fallback"]
        if not choice or len(fallback) != 1:
            return None
        first = [c.get("val") for c in choice[0] if c.tag == C14 + "style"]
        back = [c.get("val") for c in fallback[0] if c.tag == CNS + "style"]
        return (first[0] if len(first) == 1 else None, back[0] if len(back) == 1 else None)
    
    
    def run_props(title):
        """The title's paragraph's defRPr and its run's rPr, as (attributes,
        children names), or None for a part without them."""
        paragraphs = [p for p in title.iter() if local(p.tag) == "p"]
        if len(paragraphs) != 1:
            return None
        p = paragraphs[0]
        kids = list(p)
        if not kids or local(kids[0].tag) != "pPr":
            return "bare"
        defr = [c for c in kids[0] if local(c.tag) == "defRPr"]
        runs = [c for c in kids if local(c.tag) == "r"]
        if len(defr) != 1 or len(runs) != 1 or kids.index(kids[0]) > kids.index(runs[0]):
            return None
        rpr = [c for c in runs[0] if local(c.tag) == "rPr"]
        if len(rpr) != 1 or names(runs[0])[0] != "rPr":
            return None
        return ((dict(defr[0].attrib), names(defr[0])), (dict(rpr[0].attrib), names(rpr[0])))
    
    
    if sys.argv[1:2] == ["--axis"]:
        got = sys.argv[2].split(",")
        print("the planted axis %s: %s" % (" ".join(got), "yes" if axis_ok(got) else "no"))
        sys.exit(0)
    checks = []
    z_in = zipfile.ZipFile(sys.argv[1])
    if len(sys.argv) == 2:
        root, chart = chart_of(z_in.read(FIX))
        checks.append(("the fixture's chartSpace children in the schema's order", ordered(names(root), SPACE)))
        checks.append(("its root mc:AlternateContent after roundedCorners",
                       names(root).index("AlternateContent") == names(root).index("roundedCorners") + 1))
        checks.append(("its first Choice holds c14:style 102 and its Fallback c:style 2",
                       style_alternate(root) == ("102", "2")))
        titles = [c for c in chart if local(c.tag) == "title"]
        props = run_props(titles[0]) if len(titles) == 1 else None
        checks.append(("its title's a:pPr a:defRPr sz 1400 b 1 before the run, the run's a:rPr sz 1400 b 1",
                       isinstance(props, tuple) and props[0][0] == {"sz": "1400", "b": "1"}
                       and props[1][0].get("sz") == "1400" and props[1][0].get("b") == "1"))
        found = {}
        for parent in chart.iter():
            if "txPr" in names(parent):
                found.setdefault(local(parent.tag), []).append(names(parent))
        for parent in ("dLbls", "catAx", "valAx", "legend"):
            got = found.get(parent, [])
            checks.append(("its %s's txPr in its place" % parent, len(got) == 1 and place_ok(parent, got[0])))
        rels = ET.fromstring(z_in.read("xl/charts/_rels/chart1.xml.rels"))
        types = sorted((r.get("Type").rsplit("/", 1)[-1], r.get("Target")) for r in rels)
        ct = z_in.read("[Content_Types].xml").decode()
        style_root = local(ET.fromstring(z_in.read("xl/charts/style1.xml")).tag)
        color_root = local(ET.fromstring(z_in.read("xl/charts/colors1.xml")).tag)
        checks.append(("its rels name a chartStyle part and a chartColorStyle part, each there with its root and Override",
                       types == [("chartColorStyle", "colors1.xml"), ("chartStyle", "style1.xml")]
                       and style_root == "chartStyle" and color_root == "colorStyle"
                       and 'PartName="/xl/charts/style1.xml" ContentType="application/vnd.ms-office.chartstyle+xml"' in ct
                       and 'PartName="/xl/charts/colors1.xml" ContentType="application/vnd.ms-office.chartcolorstyle+xml"' in ct))
    else:
        z = zipfile.ZipFile(sys.argv[2])
        for name in KEPT:
            checks.append(("the output's %s is the fixture's, byte for byte" % name,
                           name in z.namelist() and z.read(name) == z_in.read(name)))
        root, _ = chart_of(z.read(FIX))
        checks.append(("in the output's kept chart part, the first Choice holds c14:style 102 and the Fallback c:style 2",
                       style_alternate(root) == ("102", "2")))
        added = sorted(n for n in z.namelist()
                       if n.startswith("xl/charts/chart") and n.endswith(".xml") and n not in z_in.namelist())
        checks.append(("the output adds three chart parts", len(added) == 3))
        kinds, n_text, n_style, placed, titled = [], 0, 0, [], []
        for name in added:
            root, chart = chart_of(z.read(name))
            area = [c for c in chart if local(c.tag) == "plotArea"][0]
            kinds += [local(c.tag) for c in area if local(c.tag).endswith("Chart")]
            n_style += sum(1 for e in root.iter() if local(e.tag) == "style")
            for parent in root.iter():
                got = names(parent)
                for i, n in enumerate(got):
                    if n == "txPr":
                        n_text += 1
                        before = got[i - 1] if i > 0 else "(first)"
                        print("txPr in %s after %s: %s" % (local(parent.tag), before,
                                                          "in its place" if place_ok(local(parent.tag), got) else "OUT OF PLACE"))
                        placed.append(place_ok(local(parent.tag), got))
            for title in chart.iter():
                if local(title.tag) != "title":
                    continue
                props = run_props(title)
                if props == "bare":
                    continue
                titled.append(isinstance(props, tuple) and props[0] == props[1])
        print("added plots %s; txPr %d; style %d; titles with text properties %d" % (" ".join(kinds), n_text, n_style, len(titled)))
        checks.append(("a barChart, a lineChart and a pieChart among them", sorted(kinds) == ["barChart", "lineChart", "pieChart"]))
        checks.append(("each txPr in its place by the schema's sequence", bool(placed) and all(placed)))
        checks.append(("six txPr and no style in the added parts", n_text == 6 and n_style == 0))
        checks.append(("four titles with text properties, each run's a:rPr the a:defRPr's attributes and children",
                       len(titled) == 4 and all(titled)))
    for name, good in checks:
        print("%s: %s" % (name, "yes" if good else "no"))
