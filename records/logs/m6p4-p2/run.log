    # Usage: m6p4-p2-run.sh <phase commit> > <file outside the tree>; the caller
    # moves the output to records/logs/m6p4-p2/run.log (change NYY).
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    # Every environment input, as it was set, before any is unset.
    INPUT_NAMES="RUN_SUFFIX SUPERSEDED_RUN SUPERSEDED_KEEP RERUN_NOTE RERUN_FILES RECORDS_DEST RUN_KEEP RUN_OUT_ROOT RUN_SKIP_KEEP PLANNING_SPEC EMEND_CORPUS_DIR EMEND_KEEP_DIR HOME"
    declare -A INPUT_SEEN
    for v in $INPUT_NAMES; do
      if [ -n "${!v+x}" ]; then INPUT_SEEN[$v]=${!v}; else INPUT_SEEN[$v]=unset; fi
    done
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    # Python writes no bytecode, so nothing arises to be removed.
    export PYTHONDONTWRITEBYTECODE=1
    # Change NTK (M5 part 1 P3's NTC, carried): every cargo command of this log
    # runs offline; the two settings are printed below.
    export CARGO_NET_OFFLINE=true
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR RUSTDOCFLAGS RUSTFLAGS
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    LO_TIMEOUT_S=600
    SPEC=specs/0041-chart-text-and-edits.md
    # Change NYY: the committed blob the doc commit 8faf930 holds (planning's
    # P2 brief, by hash).
    SPEC_WANT=fd01e97ea3469a12f1ae72fc51daf44f8ef542d6ccf1e862f3890b21727e71f6
    # Change NYY: the two samples, each with its tool argument: the edit
    # sample's corpus run, then P1's text sample's rerun (change NZA).
    SAMPLES="chartedit charttext"
    declare -A EDITS=([chartedit]=--chart-edit-sample [charttext]=--chart-text-sample)
    PLANNING_SPEC=${PLANNING_SPEC:-}
    PHASE_DIR=$HOME/.cache/emend-build/m6p4-p2
    # Change NSK: every build of <repo>, dry or logged, goes into the main tree's
    # subdirectory of the phase's one target root, <target>/main; no input moves
    # it and nothing here cleans it. The logged run leaves RUN_KEEP unset; a dry
    # run points it elsewhere so it leaves no keep where the logged run refuses
    # one.
    TARGET_ROOT=$PHASE_DIR/target
    BUILD_ROOT=$TARGET_ROOT/main
    KEEP=${RUN_KEEP:-$PHASE_DIR/keep-host}
    RUN_OUT_ROOT=${RUN_OUT_ROOT:-$CORPUS/runs}
    RUN_SKIP_KEEP=${RUN_SKIP_KEEP:-no}
    case $RUN_SKIP_KEEP in yes | no) ;; *) echo "RUN_SKIP_KEEP is yes or no" >&2; exit 2 ;; esac
    INSTALLED=()
    I686=i686-unknown-linux-musl
    RECORDS_DEST=${RECORDS_DEST:-records}
    # A keep in place is another attempt's, moved below once the header can list
    # it; without SUPERSEDED_KEEP naming the attempt it is refused.
    SUPERSEDED_KEEP=${SUPERSEDED_KEEP:-}
    case $SUPERSEDED_KEEP in '' | attempt-[1-9]) ;; *) echo "SUPERSEDED_KEEP is attempt-<n> or nothing" >&2; exit 2 ;; esac
    if [ "$RUN_SKIP_KEEP" = no ] && [ -e "$KEEP" ] && [ -z "$SUPERSEDED_KEEP" ]; then echo "$KEEP is already there; name its attempt in SUPERSEDED_KEEP" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT
    # Change NWS: a dry run (RECORDS_DEST other than records) stages its
    # records in RECORDS_DEST/staged, so it leaves nothing in
    # <scripts>/out/records for the logged run to refuse.
    if [ "$RECORDS_DEST" = records ]; then RECORDS=$SELF_DIR/out/records; else RECORDS=$RECORDS_DEST/staged; fi
    # Change NTI: TMPDIR is <scratch>/tmp, the phase's directory's, made and
    # exported before any mktemp (close-out ruling 1); the working directory
    # is the one mktemp -d makes under it, on the disk, kept; nothing here is
    # removed.
    TMPDIR=$PHASE_DIR/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    B=$(mktemp -d) || exit 2
    # Change NSB: the counting library is the phase commit's, by git show.
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT=$(git rev-parse --short=7 "$C")
    DATE=$(date -u +%Y-%m-%d)
    # What the status pattern admits (changes NSB, NUB, NUI, NXL, NXT, NYD, NYU
    # and NYY): this phase's log directory and this phase's three record pairs
    # (named by the run's date and the phase commit's short sha, untracked);
    # and, as change NXS gave it, planning's modified specs/0041 when
    # PLANNING_SPEC is given and the working file hashes to it; nothing else.
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m6p4-p2/|\\?\\? records/m6p4-(p2-chartedit|p2-charttext|open)-$DATE-$SHORT[.](md|txt)\$)"
    PLAN_SPEC_NOW=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    plan_admitted() { [ -n "${PLANNING_SPEC:-}" ] && [ "$PLAN_SPEC_NOW" = "$PLANNING_SPEC" ]; }
    if plan_admitted; then OURS="^((\\?\\?| ?[MARCD]) records/logs/m6p4-p2/|\\?\\? records/m6p4-(p2-chartedit|p2-charttext|open)-$DATE-$SHORT[.](md|txt)\$| M specs/0041-chart-text-and-edits[.]md\$)"; fi
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs and records" >&2
      exit 2
    fi
    # Change NYY: each sample's record stem, the phase's with the sample's
    # word (M5 part 5 P4's form).
    declare -A STEMS=([chartedit]=m6p4-p2-chartedit-$DATE-$SHORT [charttext]=m6p4-p2-charttext-$DATE-$SHORT)
    STEM_OPEN=m6p4-open-$DATE-$SHORT
    # A rerun takes a suffix, so its run directory is never the superseded one.
    RUN_SUFFIX=${RUN_SUFFIX:-}
    case $RUN_SUFFIX in '' | -[b-z]) ;; *) echo "RUN_SUFFIX is -b to -z or nothing" >&2; exit 2 ;; esac
    RUN=$DATE-$SHORT$RUN_SUFFIX
    mkdir -p "$RECORDS" "$RECORDS_DEST" || exit 2
    # A rerun names the superseded run directory, which is MOVED into
    # <scripts>/out/superseded after the header prints it, never removed; it
    # must be another run of this phase, not this one.
    SUPERSEDED_RUN=${SUPERSEDED_RUN:-}
    case $SUPERSEDED_RUN in
      '' | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f] | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[b-z]) ;;
      *) echo "SUPERSEDED_RUN is not a run directory's name" >&2; exit 2 ;;
    esac
    if [ -n "$SUPERSEDED_RUN" ] && [ "$SUPERSEDED_RUN" = "$RUN" ]; then echo "SUPERSEDED_RUN names this run's own directory" >&2; exit 2; fi
    for f in "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt" \
             "$RECORDS/${STEMS[chartedit]}.md" "$RECORDS/${STEMS[chartedit]}.txt" "$RECORDS_DEST/${STEMS[chartedit]}.md" "$RECORDS_DEST/${STEMS[chartedit]}.txt" \
             "$RECORDS/${STEMS[charttext]}.md" "$RECORDS/${STEMS[charttext]}.txt" "$RECORDS_DEST/${STEMS[charttext]}.md" "$RECORDS_DEST/${STEMS[charttext]}.txt"; do
      if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
    done
    # A run directory that exists before the run is another attempt's; refused
    # (the runner itself refuses one holding an earlier run's conversion
    # directories, specs/0030 decision 1 A).
    # Change NVX: each sample's run directory (two, change NYY).
    for s in $SAMPLES; do
      if [ -e "$RUN_OUT_ROOT/$RUN-$s" ]; then echo "$RUN_OUT_ROOT/$RUN-$s is already there; name a fresh run" >&2; exit 2; fi
    done
    
    # The corpus's path begins with <repo>'s, so <runs> and <corpus> are
    # replaced before <repo> (M4 part 1 P3's order); the phase's directories
    # before <phase>, and <home> last.
    scrub() {
      sed -e "s#$B#<work>#g" -e "s#$TMPDIR#<scratch>/tmp#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$KEEP#<keep>#g" \
        -e "s#$TARGET_ROOT#<target>#g" -e "s#$RUN_OUT_ROOT#<runs>#g" -e "s#$CORPUS#<corpus>#g" \
        -e "s#$MAIN#<repo>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M6 part 4 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # The environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo "input (as exported by this script, change NTK): PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE CARGO_NET_OFFLINE=$CARGO_NET_OFFLINE"
    echo "input: TMPDIR=$TMPDIR"
    echo "  (TMPDIR set, made and exported by this script before any mktemp; <work> is made under it: close-out ruling 1; change NTI)"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change NTJ: the fourth shape, PYB: a Python call without -I -B (the word
    # followed by whitespace and an option or a .py path, outside a comment,
    # and not by " -I -B"). The word is built from two halves, so that this
    # form's own text is no call.
    PYW=pyth
    PYW=${PYW}on3
    pyb_count() {
      awk -v w="$PYW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { r = substr(s, i + length(w)); if (r ~ /^[ \t]+(-|[^ \t]*[.]py([ \t"]|$))/ && r !~ /^ -I -B( |$)/) { n++; break }; s = r }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "$PYW -c x" "$PYW -I -B -c x" "# $PYW -c x" "command -v $PYW" "$PYW tool.py" >"$B/pyb-fixture"
    n_self=$(pyb_count "$SELF")
    n_fix=$(pyb_count "$B/pyb-fixture")
    echo "command: pyb_count <this script>, and the same over a fixture of five lines: a call with -c, one with -I -B -c, a comment, a command -v, a call of a .py path"
    echo "  shape PYB: in this script $n_self; in the fixture $n_fix"
    check "PYB: this script holds none (change NTJ)" "$(yn [ "$n_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's two calls without -I -B and not its other three lines" "$(yn [ "$n_fix" = 2 ])"
    # Rulings Z, AD and AK a (change NWT): the defined-helper check over this
    # script's own source, and its planted controls. The program is written
    # into <work> from this script's text, so nothing is copied beside it; the
    # planted calls are built from pieces, so this text holds no call of an
    # undefined name.
    cat >"$B/defined_check.py" <<'PY'
    """The defined-helper check (specs/0037: ruling Q, carried into each script's
    own shape block by ruling Z, widened by rulings AD and AK a): every helper
    a yn, ynnot, is or isnot call names is defined in the script, and each of
    the four the script calls is itself defined in it.
    
    Usage: python3 -I -B defined_check.py <script>
    
    A call's name is the word after a command substitution's opening, a dollar
    sign and a parenthesis, followed by one of the four names and a space,
    outside a comment line; a name is defined when a line of the script reads
    "<name>() {" (leading blanks allowed). The commands a script calls by name
    through them, "[", "cmp", "true" and "podman", are not helpers
    (gen/defined.py's list). Prints one line, "called <n>; undefined: <names or
    none>; yn defined: <yes|no|not called>; ynnot defined: ...; is defined:
    ...; isnot defined: ..."; exit 0 when no name is undefined and none of the
    four is called undefined, 1 otherwise, 2 on a usage or read error."""
    import re
    import sys
    
    COMMANDS = ("[", "cmp", "true", "podman")
    WRAPPERS = ("yn", "ynnot", "is", "isnot")
    CALL = re.compile(r"\$\((yn|ynnot|is|isnot) ([^ )\"]+)")
    
    
    def main():
        if len(sys.argv) != 2:
            print("usage: defined_check.py <script>", file=sys.stderr)
            sys.exit(2)
        try:
            text = open(sys.argv[1], encoding="utf-8").read()
        except OSError as err:
            print("cannot read the script: %s" % err.strerror, file=sys.stderr)
            sys.exit(2)
        called, wrappers = set(), set()
        for line in text.split("\n"):
            if line.lstrip().startswith("#"):
                continue
            for wrapper, name in CALL.findall(line):
                wrappers.add(wrapper)
                called.add(name)
        defined = set(re.findall(r"^[ \t]*([A-Za-z_][A-Za-z0-9_]*)\(\) \{", text, re.M))
        missing = sorted(n for n in called if n not in COMMANDS and n not in defined)
    
        def state(w):
            if w not in wrappers:
                return "not called"
            return "yes" if w in defined else "no"
        print("called %d; undefined: %s; %s"
              % (len(called), " ".join(missing) if missing else "none",
                 "; ".join("%s defined: %s" % (w, state(w)) for w in WRAPPERS)))
        bad = missing or any(state(w) == "no" for w in WRAPPERS)
        sys.exit(1 if bad else 0)
    
    
    main()
    PY
    echo "command: python3 -I -B <work>/defined_check.py <this script> (the program, written from this script's text, below; sha256 $(sha_of "$B/defined_check.py")), and the same over a copy of this script with one planted yn call and one planted is call of undefined helpers, and over a planted script that calls yn and is and defines neither (rulings Z, AD and AK a)"
    sed 's/^/    /' "$B/defined_check.py"
    python3 -I -B "$B/defined_check.py" "$SELF" >"$B/def-self.out" 2>"$B/def-self.err" </dev/null
    def_rc=$?
    sed 's/^/    /' "$B/def-self.out"
    def_self_ok() { [ "$def_rc" = 0 ] && [ ! -s "$B/def-self.err" ] && [ "$(count_matches -F 'undefined: none; yn defined: yes; ynnot defined: yes; is defined: not called; isnot defined: not called' "$B/def-self.out")" = 1 ]; }
    check "every helper a yn or ynnot call of this script names is defined in it, yn and ynnot are themselves defined, and it calls neither is nor isnot (rulings Z, AD and AK a)" "$(yn def_self_ok)"
    { cat "$SELF"; printf '%s\n' "zz=\$""(yn zz_planted_undefined_helper)" "zi=\$""(is zz_planted_is_helper)"; } >"$B/def-plant.sh"
    python3 -I -B "$B/defined_check.py" "$B/def-plant.sh" >"$B/def-plant.out" 2>"$B/def-plant.err" </dev/null
    def_prc=$?
    echo "  over the planted copy: exit $def_prc; $(cat "$B/def-plant.out")"
    def_plant_ok() { [ "$def_prc" = 1 ] && [ "$(count_matches -F 'undefined: zz_planted_is_helper zz_planted_undefined_helper;' "$B/def-plant.out")" = 1 ] && [ "$(count_matches -F '; is defined: no;' "$B/def-plant.out")" = 1 ]; }
    check "control: the same check names the two planted undefined helpers in a copy of this script, the is call's among them, and is undefined there (rulings Z and AK a)" "$(yn def_plant_ok)"
    printf '%s\n' 'f() { :; }' "x=\$""(yn f)" "y=\$""(is f)" >"$B/def-noyn.sh"
    python3 -I -B "$B/defined_check.py" "$B/def-noyn.sh" >"$B/def-noyn.out" 2>"$B/def-noyn.err" </dev/null
    def_nrc=$?
    echo "  over a planted script defining f and calling yn f and is f: exit $def_nrc; $(cat "$B/def-noyn.out")"
    def_noyn_ok() { [ "$def_nrc" = 1 ] && [ "$(count_matches -F '; yn defined: no;' "$B/def-noyn.out")" = 1 ] && [ "$(count_matches -F '; is defined: no;' "$B/def-noyn.out")" = 1 ]; }
    check "control: the same check refuses a planted script that calls yn and is and defines neither (rulings AD and AK a)" "$(yn def_noyn_ok)"
    # P1 verification ruling D (change NXD): the placeholder check, the scan's
    # rule, over this script's own source, printed in this log with its
    # controls. A placeholder is a lower-case angle-bracketed word printed
    # immediately before a slash, or the target of a scrub; it is declared when
    # a root line says the word stands for something. The planted tokens are
    # built from pieces, so this text holds none.
    ph_used() {
      {
        LC_ALL=C "$G" -a -o -E 's#[^#]*#<[a-z][a-z0-9_-]*>' "$1" | LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>$'
        LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>/' "$1" | sed 's#/$##'
      } | LC_ALL=C sort -u
    }
    ph_declared() {
      LC_ALL=C "$G" -a -E '(^|echo ")root: ' "$1" | LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>(/[a-z0-9]+)? stands for' |
        LC_ALL=C "$G" -a -o -E '^<[a-z][a-z0-9_-]*>' | LC_ALL=C sort -u
    }
    ph_undeclared() { LC_ALL=C comm -23 <(ph_used "$1") <(ph_declared "$1") | count_lines /dev/stdin; }
    PL='<'
    { cat "$SELF"; printf '%s\n' "read ${PL}zzplanted>/x"; } >"$B/ph-plant.sh"
    { cat "$SELF"; printf '%s\n' "read ${PL}zzplanted>/x" "echo \"root: ${PL}zzplanted> stands for x\""; } >"$B/ph-decl.sh"
    { cat "$SELF"; printf '%s\n' "  sed -e \"s#\$X#${PL}zzscrub>#g\""; } >"$B/ph-scrub.sh"
    echo "command: the scan's placeholder rule (the tokens before a slash and the scrub targets, against the tokens the root lines declare) over this script, and over three planted copies of it: one printing a token before a slash, the same with a root line declaring it, one scrubbing to a token (P1 verification ruling D; change NXD)"
    echo "  this script: placeholders printed: $(ph_used "$SELF" | tr '\n' ' '); declared by root lines: $(ph_declared "$SELF" | tr '\n' ' '); undeclared: $(ph_undeclared "$SELF")"
    check "every placeholder this script prints is declared by a root line (the scan's rule; P1 verification ruling D; change NXD)" "$(yn [ "$(ph_undeclared "$SELF")" = 0 ])"
    echo "  the planted copies: undeclared $(ph_undeclared "$B/ph-plant.sh"), $(ph_undeclared "$B/ph-decl.sh") and $(ph_undeclared "$B/ph-scrub.sh")"
    check "control: the same check finds the one token a planted copy prints before a slash with no root line (change NXD)" "$(yn [ "$(ph_undeclared "$B/ph-plant.sh")" = 1 ])"
    check "control: the same check finds none when a root line in the planted copy declares it (change NXD)" "$(yn [ "$(ph_undeclared "$B/ph-decl.sh")" = 0 ])"
    check "control: the same check finds the scrub target a planted copy writes with no root line (change NXD)" "$(yn [ "$(ph_undeclared "$B/ph-scrub.sh")" = 1 ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M6 part 4 P1 record: the logs, the records, the check, the scan')
    DOC=$(by_subject 'M6 part 4 P2: commit planning docs (the P1 verification and rulings)')
    CORE=$(by_subject 'M6 part 4 P2: charts write, the style and the in-place edits')
    TOOL=$(by_subject 'M6 part 4 P2: emend-copy --chart-edit-sample')
    # Change NYY: the op commit (part 3 P2's five roles).
    OP=$(by_subject 'M6 part 4 P2: the openpyxl chart-text op')
    # Change NZE: the style commit, the phase commit, the op commit its parent
    # (ruling G).
    STY=$(by_subject "M6 part 4 P2: the edit sample's chart takes style 26 (ruling G)")
    # Change NZD: the record the keep is compared with is the last committed
    # open-check record, the one P1's record commit, the base, added, found by
    # its subject (no hash is typed here); checked below to be an ancestor and
    # the last.
    PREV_OPEN_REC=$(by_subject 'M6 part 4 P1 record: the logs, the records, the check, the scan')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  P1's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the core commit: ${CORE:-none}"
    echo "  the tool commit: ${TOOL:-none}"
    echo "  the op commit: ${OP:-none}"
    echo "  the style commit, the phase commit (change NZE): ${STY:-none}"
    echo "  the record commit the keep is compared with (the last to add an open-check record, the base; change NZD): ${PREV_OPEN_REC:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~5"
    for k in 0 1 2 3 4 5; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$STY" "$OP" "$TOOL" "$CORE" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the style commit, the op commit, the tool commit, the core commit, the doc commit and the base, each the next one's parent, the style commit the phase commit (changes NYY and NZE)" "$(yn roles_in_order)"
    roles_ctl() { local OP=$TOOL; roles_in_order; }
    check "control: roles_in_order refuses the tool commit named as the op commit (change NYY)" "$(ynnot roles_ctl)"
    roles_ctl2() { local REC=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the base" "$(ynnot roles_ctl2)"
    roles_ctl3() { local CORE=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the core commit (change NYY)" "$(ynnot roles_ctl3)"
    roles_ctl4() { local TOOL=$CORE; roles_in_order; }
    check "control: roles_in_order refuses the core commit named as the tool commit (change NYY)" "$(ynnot roles_ctl4)"
    roles_ctl5() { local STY=$OP; roles_in_order; }
    check "control: roles_in_order refuses the op commit named as the style commit, the phase commit (change NZE)" "$(ynnot roles_ctl5)"
    # record_is <commit> <subject prefix>: the commit is there, its subject
    # begins with the prefix, and it is an ancestor of the phase commit.
    record_is() { [ -n "$1" ] && git cat-file -e "$1^{commit}" && [ "$(git log -1 --format=%s "$1" | LC_ALL=C "$G" -cE "^$2")" = 1 ] && git merge-base --is-ancestor "$1" "$C"; }
    echo "command: git log -1 --format=%s <P1's record commit>"
    echo "    $(git log -1 --format=%s "$PREV_OPEN_REC")"
    check "the named record commit is P1's record commit, an ancestor of the phase commit (change NZD)" "$(yn record_is "$PREV_OPEN_REC" 'M6 part 4 P1 record: ')"
    check "control: the same check refuses the doc commit named instead" "$(ynnot record_is "$DOC" 'M6 part 4 P1 record: ')"
    check "control: the same check refuses the core commit named instead" "$(ynnot record_is "$CORE" 'M6 part 4 P1 record: ')"
    check "the base is P1's record commit, the named record commit (change NYY)" "$(yn [ "$REC" = "$PREV_OPEN_REC" ])"
    # row_field <run.tsv> <column>: the run row's column, by header name.
    row_field() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && NR == 2 { print $k }' "$1"; }
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the style commit, by its subject (change NZE)" "$(yn [ "$STY" = "$C" ])"
    check "control: the same comparison refuses the op commit (change NZE)" "$(ynnot [ "$OP" = "$C" ])"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT")"
    short_names_head() { [ "$(git rev-parse "$SHORT")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    echo "phase: Milestone 6 part 4 P2 ($SPEC) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # Rulings AA and AK b (change NWV): every attempt refused at entry, or
    # superseded, is named by RERUN_NOTE and each of its files hashed here,
    # the hashing asserted by a check line (M5 part 6 P4's run log's form).
    # Change NXE (P1 verification ruling F): rerun_script <files>: some
    # file named is a .sh under <phase>/superseded, the superseded script that
    # wrote the attempt; its control runs every time.
    rerun_script() { local sf; for sf in $1; do case $sf in "$PHASE_DIR"/superseded/*.sh) return 0 ;; esac; done; return 1; }
    rerun_script_ctl() { ! rerun_script "$PHASE_DIR/superseded/x/run.log" && rerun_script "$PHASE_DIR/superseded/x/run.log $PHASE_DIR/superseded/x/m6p4-p2-run.sh"; }
    check "control: rerun_script refuses a planted RERUN_FILES naming a log alone, and takes one naming a script beside it (change NXE)" "$(yn rerun_script_ctl)"
    n_rerun_files=0
    n_rerun_missing=0
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in (ruling AA)"
      for sf in ${RERUN_FILES:-}; do
        n_rerun_files=$((n_rerun_files + 1))
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          n_rerun_missing=$((n_rerun_missing + 1))
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
      rerun_hashed() { [ "$n_rerun_files" -gt 0 ] && [ "$n_rerun_missing" = 0 ]; }
      check "every file of the attempt RERUN_NOTE names is hashed above, and RERUN_FILES names at least one (rulings AA and AK b)" "$(yn rerun_hashed)"
      # Change NWV: every file RERUN_FILES names lies in <phase>/superseded.
      rerun_kept() { local sf; for sf in ${RERUN_FILES:-}; do case $sf in "$PHASE_DIR"/superseded/*) ;; *) return 1 ;; esac; done; }
      check "every file RERUN_FILES names lies in <phase>/superseded (ruling AA)" "$(yn rerun_kept)"
      rerun_script_given() { rerun_script "${RERUN_FILES:-}"; }
      check "RERUN_FILES names the superseded script that wrote the attempt, a .sh under <phase>/superseded (P1 verification ruling F; change NXE)" "$(yn rerun_script_given)"
    fi
    
    # The two move checks as functions, run over planted inputs every time
    # below, and over a real moved keep or run directory when there is one.
    # keep_pairs_ok <listing>: the .in.xlsx lines times two equal the listing's
    # lines (the pattern in double quotes so the tab is interpolated).
    keep_pairs_ok() {
      local pairs files
      pairs=$(count_matches -E "[.]in[.]xlsx${TAB}" "$1")
      files=$(count_lines "$1")
      [ "$files" -ge 2 ] && [ "$((pairs * 2))" = "$files" ]
    }
    # run_listing <dir> <listing>: the listing of a run directory, one line per
    # file, path and bytes.
    run_listing() { (cd "$1" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$2"; }
    # run_listing_ok <dir> <listing>: the listing names each file once and at
    # least one.
    run_listing_ok() {
      local files lines uniq
      files=$(find "$1" -type f | wc -l)
      lines=$(count_lines "$2")
      uniq=$(cut -f1 "$2" | LC_ALL=C sort -u | count_lines /dev/stdin)
      [ "$files" -ge 1 ] && [ "$lines" = "$files" ] && [ "$uniq" = "$files" ]
    }
    
    if [ -n "$SUPERSEDED_RUN" ]; then
    for SUP_S in $SAMPLES; do
      SUP_OUT=$RUN_OUT_ROOT/$SUPERSEDED_RUN-$SUP_S
      SUP_TO=$SELF_DIR/out/superseded/run-$SUPERSEDED_RUN-$SUP_S
      echo "the superseded run directory, moved before this run: <runs>/$SUPERSEDED_RUN-$SUP_S to <scripts>/out/superseded/run-$SUPERSEDED_RUN-$SUP_S"
      sup_there=no
      if [ -d "$SUP_OUT" ]; then
        sup_there=yes
        echo "command: sha256sum <runs>/$SUPERSEDED_RUN-$SUP_S/summary.host.tsv and summary.i686.tsv; mv <runs>/$SUPERSEDED_RUN-$SUP_S <scripts>/out/superseded/run-$SUPERSEDED_RUN-$SUP_S"
        for sl in host i686; do
          if [ -f "$SUP_OUT/summary.$sl.tsv" ]; then echo "    summary.$sl.tsv sha256 $(sha_of "$SUP_OUT/summary.$sl.tsv")"; else echo "    summary.$sl.tsv: NO HASH EXISTS, the file is not there"; fi
        done
        run_listing "$SUP_OUT" "$B/superseded-run.listing"
        echo "command: (cd <runs>/$SUPERSEDED_RUN-$SUP_S && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum"
        echo "    files $(find "$SUP_OUT" -type f | wc -l); listing lines $(count_lines "$B/superseded-run.listing"); listing sha256 $(sha_of "$B/superseded-run.listing")"
        check "the listing of $SUPERSEDED_RUN-$SUP_S names each of its files once" "$(yn run_listing_ok "$SUP_OUT" "$B/superseded-run.listing")"
        if [ -e "$SUP_TO" ]; then echo "    $SUP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$SUP_OUT" "$SUP_TO"; fi
      fi
      sup_moved() { [ ! -e "$SUP_OUT" ] && [ -d "$SUP_TO" ]; }
      if [ "$sup_there" = yes ]; then
        check "the superseded run directory $SUPERSEDED_RUN-$SUP_S is moved, not removed, before the run" "$(yn sup_moved)"
      else
        echo "    <runs>/$SUPERSEDED_RUN-$SUP_S was not there; nothing to move (P3's NTT, carried; change NUB)"
      fi
    done
    fi
    if [ -n "$SUPERSEDED_KEEP" ]; then
      KEEP_TO=$SELF_DIR/out/superseded/keep-$SUPERSEDED_KEEP
      echo "the superseded keep, moved before this run: <keep> to <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
      if [ -d "$KEEP" ]; then
        (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/superseded-keep.listing"
        echo "command: (cd <keep> && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum; the .in.xlsx files counted; mv <keep> <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
        echo "    pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/superseded-keep.listing"); files $(count_lines "$B/superseded-keep.listing"); listing sha256 $(sha_of "$B/superseded-keep.listing")"
        check "the moved keep's pairs times two equals its files" "$(yn keep_pairs_ok "$B/superseded-keep.listing")"
        if [ -e "$KEEP_TO" ]; then echo "    $KEEP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$KEEP" "$KEEP_TO"; fi
      else
        echo "    NO LISTING EXISTS: there is no keep in place to move"
      fi
      keep_moved() { [ ! -e "$KEEP" ] && [ -d "$KEEP_TO" ]; }
      check "the superseded keep is moved, not removed, before the run" "$(yn keep_moved)"
    fi
    echo "superseded run directory named: ${SUPERSEDED_RUN:-none}; superseded keep named: ${SUPERSEDED_KEEP:-none}"
    echo
    echo "## the two move checks over planted inputs, run every time"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\n' "$TAB" "$TAB" >"$B/c-keep.listing"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\ny.1.out.xlsx%s1\n' "$TAB" "$TAB" "$TAB" >"$B/c-keep-odd.listing"
    echo "  planted keep listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep.listing"), files $(count_lines "$B/c-keep.listing"); with an unpaired output: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep-odd.listing"), files $(count_lines "$B/c-keep-odd.listing")"
    check "keep_pairs_ok passes a planted listing of one whole pair" "$(yn keep_pairs_ok "$B/c-keep.listing")"
    check "control: keep_pairs_ok refuses a planted listing with an unpaired output" "$(ynnot keep_pairs_ok "$B/c-keep-odd.listing")"
    mkdir -p "$B/c-run/abc123" && printf 'a' >"$B/c-run/summary.host.tsv" && printf 'bb' >"$B/c-run/abc123/out.host.xlsx" && printf 'ccc' >"$B/c-run/abc123/stdout.host.txt"
    run_listing "$B/c-run" "$B/c-run.listing"
    echo "  planted run directory: files $(find "$B/c-run" -type f | wc -l); listing lines $(count_lines "$B/c-run.listing"); listing sha256 $(sha_of "$B/c-run.listing")"
    check "run_listing_ok passes the planted run directory's own listing" "$(yn run_listing_ok "$B/c-run" "$B/c-run.listing")"
    { cat "$B/c-run.listing"; head -n 1 "$B/c-run.listing"; } >"$B/c-run-dup.listing"
    check "control: run_listing_ok refuses a listing that names one file twice" "$(ynnot run_listing_ok "$B/c-run" "$B/c-run-dup.listing")"
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run builds into <target>/main, the main tree's subdirectory of the phase's target root (CARGO_TARGET_DIR; change NSU)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the sample's child and --lo-timeout $LO_TIMEOUT_S per conversion, the figures every corpus run since Milestone 3 used; not tuned during the run."
    echo "root: <repo> stands for the repository's top level (inside <home>, scrubbed after <runs> and <corpus>, whose paths begin with it); scripts/counting.sh is read from it at the phase commit by git show; scripts/passthrough-run.sh, scripts/passthrough-record.py and scripts/edit-open-check.sh are run from it, each checked equal to the phase commit's, and the runner and the open check each source scripts/lo-check.sh, which is never run; scripts/openpyxl-ops.py and tests/fixtures/openpyxl-ops.xlsx are mounted read-only from it into the openpyxl image, each checked equal to the phase commit's (change NZC); the keep's tests run in it; the three record pairs are installed into its $RECORDS_DEST/"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m6p4-p2 on the disk, the phase's directory; a superseded attempt's files are kept in <phase>/superseded"
    echo "root: <scratch> stands for <phase>, the phase's directory, named <scratch> where TMPDIR is concerned as the close-out's scripts name it: TMPDIR is <scratch>/tmp, made and exported by this script before any mktemp, and <work> is made under it (close-out ruling 1; change NTI)"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory, which holds the script alone (change NVO); the three record pairs are written into <scripts>/out/records first (a dry run's into RECORDS_DEST/staged: change NWS), a superseded run directory and a superseded keep are moved into <scripts>/out/superseded, and this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (change NTI; the counting library, the checks' programs and outputs, derived tables, the planted listings, run directory and entry rows, the runs' TMPDIR <work>/tmp-run, the open check's TMPDIR <work>/tmp, the placeholder controls, the planted rows of the comparison with P1's run <work>/c-ident, the Excel-form fixture's corpus <work>/fixcorpus and its three samples' run directories <work>/fixrun-charts, <work>/fixrun-chart-text and <work>/fixrun-chart-edit, and the openpyxl fixture's output directory <work>/opx, its corpus <work>/opxcorpus and its three samples' run directories <work>/opxrun-charts, <work>/opxrun-chart-text and <work>/opxrun-chart-edit: changes NXD, NYW, NZA, NZB and NZC), kept after the run and never removed"
    echo "root: <target> stands for <phase>/target on the disk, the phase's one target root: this log builds <repo> into <target>/main, the main tree's subdirectory, release binaries and the keep's tests, and into no other (changes NSK and NVM)"
    echo "root: <keep> stands for <phase>/keep-host on the disk unless RUN_KEEP names another for a dry run, this phase's host keep; kept after the run for planning"
    echo "root: <corpus> stands for the private corpus directory (the manifest and the inputs under <corpus>/corpus, read)"
    echo "root: <runs> stands for the corpus run directories' parent, <corpus>/runs unless RUN_OUT_ROOT names another for a dry run; this log's run directories <runs>/$RUN-chartedit and <runs>/$RUN-charttext are written there (change NYY); P1's run directory, the one P1's text record names, is read from <corpus>/runs and never written (change NZA)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$SELF_DIR" "$BUILD_ROOT" "$MAIN" "$KEEP" "$CORPUS" "$TMPDIR")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots other than <home>, <phase>, <work> and <runs> are distinct, none inside another (TMPDIR, <scratch>/tmp, among them; change NTI)" "$(yn roots_distinct)"
    work_in_tmpdir() { case "$B/" in "$TMPDIR/"*) return 0 ;; esac; return 1; }
    check "<work>, the directory mktemp -d made, is under TMPDIR, <scratch>/tmp (close-out ruling 1; change NTI)" "$(yn work_in_tmpdir)"
    work_ctl() { local B=/tmp/x; work_in_tmpdir; }
    check "control: the same test refuses a working directory under /tmp" "$(ynnot work_ctl)"
    work_ctl2() { local B=$SELF_DIR/out/work.x; work_in_tmpdir; }
    check "control: the same test refuses one under <scripts>/out, where the carried form made it" "$(ynnot work_ctl2)"
    tmpdir_ctl() { local TMPDIR=$SELF_DIR/out; work_in_tmpdir; }
    check "control: the same test refuses <work> against a TMPDIR it is not under" "$(ynnot tmpdir_ctl)"
    # Change NTS (specs/0033 "Planning rulings on P1", ruling 12): every
    # mktemp call of this script is checked under TMPDIR, so the source is
    # read for its calls outside comments; the call's text is built from
    # pieces, so this form's own text is no call.
    MKW='$('
    MKW=${MKW}mkt
    MKW=${MKW}emp
    count_tempcalls() {
      awk -v w="$MKW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { n++; s = substr(s, i + length(w)) }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "A=$MKW -d)" "F=$MKW)" "# $MKW -d)" >"$B/mktemp-fixture"
    n_mk=$(count_tempcalls "$SELF")
    n_mk_fix=$(count_tempcalls "$B/mktemp-fixture")
    echo "command: count_tempcalls <this script>, and the same over a fixture of three lines: a directory call, a file call, a comment"
    echo "  mktemp calls in this script outside comments: $n_mk (the one that makes <work>, checked under TMPDIR above); in the fixture: $n_mk_fix"
    check "this script makes one mktemp call, <work>'s, and no plain temporary file (ruling 12; change NTS)" "$(yn [ "$n_mk" = 1 ])"
    check "control: the same count finds the fixture's two calls and not its comment" "$(yn [ "$n_mk_fix" = 2 ])"
    runs_apart() { apart "$RUN_OUT_ROOT" "$MAIN" && apart "$RUN_OUT_ROOT" "$SELF_DIR"; }
    check "<runs> lies outside <repo> and <scripts>" "$(yn runs_apart)"
    check "control: apart refuses <target>/main/release against <target>/main, which holds it" "$(ynnot apart "$BUILD_ROOT/release" "$BUILD_ROOT")"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "the run directories: $(for s in $SAMPLES; do printf '<runs>/%s-%s ' "$RUN" "$s"; done)(change NVX)"
    echo "the record stems: ${STEMS[chartedit]}, ${STEMS[charttext]} and $STEM_OPEN; the records' destination: $RECORDS_DEST; RUN_SKIP_KEEP: $RUN_SKIP_KEEP"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs and its three record pairs) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    if plan_admitted; then n_ours_ctl_want=5; else n_ours_ctl_want=4; fi
    ours_rec_ctl() {
      {
        printf '?? records/logs/m6p4-p2/run.log\n?? records/logs/m6p4-p1/run.log\n'
        printf '?? records/m6p4-p2-chartedit-%s-%s.md\n?? records/m6p4-p2-charttext-%s-%s.txt\n?? records/m6p4-open-%s-%s.txt\n' "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$SHORT"
        printf '?? records/m6p4-p2-chartedit-%s-abcdef0.md\n?? records/m6p4-p2-%s-%s.md\n?? records/m6p4-p2-chartaxis-%s-%s.md\n' "$DATE" "$DATE" "$SHORT" "$DATE" "$SHORT"
        printf '?? records/m6p4-p1-charttext-%s-%s.md\n?? records/m6p3-open-%s-%s.txt\n?? records/logs/m6p4-p2x/run.log\n' "$DATE" "$SHORT" "$DATE" "$SHORT"
        printf ' M ROADMAP.md\n M specs/0041-chart-text-and-edits.md\n M records/m6p4-p2-chartedit-%s-%s.md\n' "$DATE" "$SHORT"
        printf ' M crates/emend/src/package.rs\n?? records/size-m6p4-2026-01-01-%s.md\n' "$SHORT"
      } | count_matches -E "$OURS" /dev/stdin
    }
    check "control: the phase's status pattern admits this phase's log and its three untracked record pairs alone; it refuses another phase's log, a record of another commit, a stem without a sample word or with another, P1's record stem, another part's, a sibling directory, a modified roadmap or spec, a modified record, a source file and a size record (changes NSB, NUI and NYY; the modified spec admitted only at PLANNING_SPEC, change NXS)" "$(yn [ "$(ours_rec_ctl)" = "$n_ours_ctl_want" ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources (the phase commit's, by git show; change NSB)"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts and the spec, against the phase commit"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh scripts/edit-open-check.sh scripts/openpyxl-ops.py tests/fixtures/openpyxl-ops.xlsx; do
      check "$s in the main tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { [ "$(git show "$C:scripts/excel-check-list.py" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/edit-open-check.sh)" ]; }
    check "control: the same hash comparison tells two different scripts apart" "$(ynnot tree_ctl)"
    spec_now=$(sha_of "$SPEC")
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    spec_doc=$(git show "$DOC:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum; git show <doc commit>:$SPEC | sha256sum; sha256sum $SPEC (the working file, the committed one or the copy planning gives as PLANNING_SPEC, as the status check above holds; checked against PLANNING_SPEC when it is given; changes NXL and NXS)"
    echo "  at the phase commit: $spec_committed; at the doc commit: $spec_doc; the pin: $SPEC_WANT"
    echo "  the working tree's copy: sha256 $spec_now"
    spec_ok() { [ "$spec_committed" = "$SPEC_WANT" ]; }
    check "the spec at the phase commit is at the pinned hash" "$(yn spec_ok)"
    check "the spec at the phase commit is the doc commit's" "$(yn [ "$spec_committed" = "$spec_doc" ])"
    spec_ctl() { local spec_committed=1111111111111111111111111111111111111111111111111111111111111111; spec_ok; }
    check "control: the same check refuses the spec against another hash" "$(ynnot spec_ctl)"
    echo "  PLANNING_SPEC: ${PLANNING_SPEC:-unset}"
    planning_spec_ok() { [ -z "$PLANNING_SPEC" ] || [ "$spec_now" = "$PLANNING_SPEC" ]; }
    check "the working copy of the spec is at PLANNING_SPEC when it is given (change NWS)" "$(yn planning_spec_ok)"
    planning_spec_ctl() { local PLANNING_SPEC=1111111111111111111111111111111111111111111111111111111111111111; planning_spec_ok; }
    check "control: the same check refuses a working copy against another hash" "$(ynnot planning_spec_ctl)"
    echo "command: podman image exists $IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    
    echo
    echo "## the release binaries, built here at the phase commit, both targets (M5 part 4 P2's block, M5 part 3 P2's carried; change NVM)"
    echo "command: cargo build --release -p emend-copy -p xlsx-diff; the same with --target $I686 (CARGO_TARGET_DIR=<target>/main)"
    cargo build --release -p emend-copy -p xlsx-diff >"$B/build-host.out" 2>&1 </dev/null
    rc_h=$?
    cargo build --release -p emend-copy -p xlsx-diff --target "$I686" >"$B/build-i686.out" 2>&1 </dev/null
    rc_i=$?
    echo "  exit: host $rc_h, $I686 $rc_i"
    check "both release builds exit 0" "$(yn [ "$((rc_h + rc_i))" = 0 ])"
    PT_host=$CARGO_TARGET_DIR/release/emend-copy
    XD_host=$CARGO_TARGET_DIR/release/xlsx-diff
    PT_i686=$CARGO_TARGET_DIR/$I686/release/emend-copy
    XD_i686=$CARGO_TARGET_DIR/$I686/release/xlsx-diff
    for b in "$PT_host" "$XD_host" "$PT_i686" "$XD_i686"; do echo "  $b: sha256 $(sha_of "$b"), bytes $(stat -c %s "$b")"; done
    echo "  $(rustc --version)"
    
    echo
    echo "## the corpus manifest, and its workbooks holding a calculation chain (specs/0025 P3 verification ruling 4; change NSI)"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv" >"$B/order"
    manifest_rows=$(count_lines "$B/order")
    n_regular=$(find "$CORPUS/corpus" -maxdepth 1 -type f | wc -l)
    echo "command: awk over <corpus>/manifest.tsv's id and ext columns by header name; find <corpus>/corpus -maxdepth 1 -type f"
    echo "  manifest rows: $manifest_rows; regular files under <corpus>/corpus: $n_regular"
    check "the manifest names one workbook per regular file of the corpus directory" "$(yn [ "$manifest_rows" = "$n_regular" ])"
    check "the manifest names some workbook" "$(yn [ "$manifest_rows" -ge 1 ])"
    : >"$B/chain-ids"
    while IFS="$TAB" read -r id ext; do
      if [ "$(python3 -I -B -c 'import sys, zipfile; print(1 if "xl/calcChain.xml" in zipfile.ZipFile(sys.argv[1]).namelist() else 0)' "$CORPUS/corpus/$id.$ext")" = 1 ]; then
        printf '%s\n' "$id" >>"$B/chain-ids"
      fi
    done <"$B/order"
    N_CHAIN=$(count_lines "$B/chain-ids")
    echo "command: python3 -I -B -c <zipfile namelist> <corpus>/corpus/<id>.<ext>, for each manifest row"
    echo "  corpus workbooks holding xl/calcChain.xml: $N_CHAIN of $manifest_rows (ids: $(paste -sd' ' "$B/chain-ids"))"
    echo "  the rule covering them (change NSI): the sample writes no cell, so each calcChain entry is identical and unflagged on both labels, and none is dropped"
    check "some corpus workbook holds a calculation chain, so the chain rows below are read" "$(yn [ "$N_CHAIN" -ge 1 ])"
    
    echo
    echo "## the surface, text and edit samples' line and entry rules, with their controls (specs/0039 and specs/0041 \"Harness runs\"; changes NXM, NYV and NYZ)"
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    # The tool's keys, in its order (tools/emend-copy, --chart-surface-sample).
    # Change NXR: rows, the data rows referenced (ruling A), after series.
    KEYS_chartsurface="charts_before charts_after surface surface_3d of_pie series rows read_back chart_parts_after"
    echo "  the surface sample's keys, in the tool's order: $KEYS_chartsurface"
    # keys_ok <word> <keys> <tool line>: the word, then the keys in the tool's
    # order, each a number.
    keys_ok() {
      local k v got
      got=$(printf '%s\n' "$3" | tr '\t' '\n' | sed -n '2,$s/=.*//p' | paste -sd' ')
      [ "$(printf '%s\n' "$3" | cut -f1)" = "$1" ] || return 1
      [ "$got" = "$2" ] || return 1
      for k in $2; do
        v=$(kv "$3" "$k")
        printf '%s' "$v" | LC_ALL=C "$G" -qxE '[0-9]+' || return 1
      done
    }
    # surface_line_ok <tool line>: what "Harness runs" asks of the line: four
    # charts more than before, one contour, one 3D surface and two of-pie
    # plots among them, eight series, the four read back, and four chart
    # parts at least after (change NXM); the data rows referenced 1 to 1000
    # (ruling A; change NXR).
    surface_line_ok() {
      keys_ok chartsurface "$KEYS_chartsurface" "$1" || return 1
      [ "$(kv "$1" charts_after)" = "$(($(kv "$1" charts_before) + 4))" ] || return 1
      [ "$(kv "$1" surface)" = 1 ] && [ "$(kv "$1" surface_3d)" = 1 ] && [ "$(kv "$1" of_pie)" = 2 ] || return 1
      [ "$(kv "$1" series)" = 8 ] && [ "$(kv "$1" read_back)" = 4 ] || return 1
      [ "$(kv "$1" rows)" -ge 1 ] && [ "$(kv "$1" rows)" -le 1000 ] || return 1
      [ "$(kv "$1" chart_parts_after)" -ge 4 ]
    }
    # The tool test's line (tools/emend-copy/tests/null_rewrite.rs).
    LINE_S=$(printf 'chartsurface\tcharts_before=0\tcharts_after=4\tsurface=1\tsurface_3d=1\tof_pie=2\tseries=8\trows=1\tread_back=4\tchart_parts_after=4')
    echo "  the tool test's line: $(printf '%s' "$LINE_S" | tr '\t' ' ')"
    check "control: surface_line_ok accepts the tool test's line" "$(yn surface_line_ok "$LINE_S")"
    check "control: surface_line_ok refuses the line with charts_after not four more" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/charts_after=4/charts_after=3/')")"
    check "control: surface_line_ok refuses the line with two contours" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/surface=1/surface=2/')")"
    check "control: surface_line_ok refuses the line with no 3D surface" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/surface_3d=1/surface_3d=0/')")"
    check "control: surface_line_ok refuses the line with one of-pie plot" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/of_pie=2/of_pie=1/')")"
    check "control: surface_line_ok refuses the line with seven series" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/series=8/series=7/')")"
    check "control: surface_line_ok refuses the line with three read back" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/read_back=4/read_back=3/')")"
    check "control: surface_line_ok refuses the line with three chart parts after" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/chart_parts_after=4/chart_parts_after=3/')")"
    check "control: surface_line_ok refuses the line with a key missing" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/\tseries=8//')")"
    check "control: surface_line_ok refuses the keys out of the tool's order" "$(ynnot surface_line_ok "$(printf '%s\tseries=8' "$(printf '%s' "$LINE_S" | sed 's/\tseries=8//')")")"
    check "control: surface_line_ok refuses the 3D sample's word" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/^chartsurface/chart3d/')")"
    check "control: surface_line_ok refuses the line with rows 1001, past the bound (change NXR)" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/rows=1/rows=1001/')")"
    check "control: surface_line_ok refuses the line with rows 0 (change NXR)" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/rows=1/rows=0/')")"
    check "control: surface_line_ok refuses a value that is not a number" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/charts_before=0/charts_before=x/')")"
    # P1's summary helpers, carried verbatim (part 4 P2's change NVA, carried).
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    # count_ok_where <summary> <column> <value>: among the rows whose outcome is ok.
    count_ok_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) { if ($i == c) k = i; if ($i == "outcome") o = i }; next } k && o && $o == "ok" && $k == v { n++ } END { print n + 0 }' "$1"; }
    sum_col() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { n += $k } END { print n + 0 }' "$1"; }
    # status_rows <entries> <status>: the entry rows of that status, every
    # workbook.
    status_rows() { awk -F'\t' -v s="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "status") k = i; next } k && $k == s { n++ } END { print n + 0 }' "$1"; }
    # surface_made <entries> <id>: 1 when the runner's rows for the workbook
    # add a drawing part, else 0; the line prints no drawing_created, so the
    # form is read from the rows (M5 part 5 P3's labels_made, carried; change
    # NXM).
    surface_made() {
      awk -F'\t' -v id="$2" '
        NR == 1 { for (c = 1; c <= NF; c++) k[$c] = c; next }
        $k["id"] == id && $k["status"] == "added" && $k["name"] ~ /^xl\/drawings\/drawing[0-9]+[.]xml$/ { n++ }
        END { print (n > 0 ? 1 : 0) }' "$1"
    }
    # surface_named <entries> <id> <made> [<chart parts>]: the runner's rows for one workbook
    # as "Harness runs" gives them for the surface sample, the kinds sample's
    # pattern (M5 part 5 P3's labels_named for four charts; change NXM):
    # [Content_Types].xml changed; four chart parts xl/charts/chart<N>.xml
    # added; with a drawing created, one drawing part and its rels part added,
    # one worksheet part changed and one worksheet rels part added or changed;
    # with none, one drawing part changed and one drawing rels part added or
    # changed and no worksheet part changed; every added row unflagged (a
    # changed row may carry the runner's flags, its local header rewritten);
    # every other row identical and unflagged; nothing dropped or
    # recompressed. The chart parts added are four unless the fourth argument
    # gives their count (the text sample's three; changes NXU and NYV).
    surface_named() {
      awk -F'\t' -v id="$2" -v made="$3" -v want="${4:-4}" '
        NR == 1 { for (c = 1; c <= NF; c++) k[$c] = c; next }
        $k["id"] != id { next }
        {
          n++; s = $k["status"]; f = $k["flags"]; nm = $k["name"]
          if (s == "identical") { if (f != "") bad++; next }
          if (s == "added") {
            if (f != "") bad++
            if (nm ~ /^xl\/charts\/chart[0-9]+[.]xml$/) chart++
            else if (made == 1 && nm ~ /^xl\/drawings\/drawing[0-9]+[.]xml$/) dpart++
            else if (nm ~ /^xl\/drawings\/_rels\/drawing[0-9]+[.]xml[.]rels$/) drels++
            else if (made == 1 && nm ~ /^xl\/worksheets\/_rels\/[^\/]+[.]xml[.]rels$/) srels++
            else bad++
            next
          }
          if (s == "changed") {
            if (nm == "[Content_Types].xml") ct++
            else if (made == 1 && nm ~ /^xl\/worksheets\/[^\/]+[.]xml$/) sheet++
            else if (made == 1 && nm ~ /^xl\/worksheets\/_rels\/[^\/]+[.]xml[.]rels$/) srels++
            else if (made == 0 && nm ~ /^xl\/drawings\/drawing[0-9]+[.]xml$/) dpart++
            else if (made == 0 && nm ~ /^xl\/drawings\/_rels\/drawing[0-9]+[.]xml[.]rels$/) drels++
            else bad++
            next
          }
          bad++
        }
        END {
          if (n == 0 || bad > 0 || ct != 1 || chart != want || dpart != 1 || drels != 1) exit 1
          if (made == 1 && (sheet != 1 || srels != 1)) exit 1
          if (made == 0 && (sheet + srels) != 0) exit 1
          if (made != 0 && made != 1) exit 1
        }' "$1"
    }
    # chain_rows_of <entries> <id>: the workbook's calcChain rows, those
    # identical and unflagged, and those dropped (change NSI).
    chain_rows_of() {
      awk -F'\t' -v id="$2" '
        NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next }
        $col["id"] == id && $col["name"] == "xl/calcChain.xml" { n++; if ($col["status"] == "identical" && $col["flags"] == "") s++; if ($col["status"] == "dropped") d++ }
        END { print n + 0, s + 0, d + 0 }' "$1"
    }
    # The rule's controls: accepted where it holds, refused on each planted row
    # where it does not (change NXM).
    etsv() { { printf 'id\tname\tstatus\tflags\n'; printf "$@"; } >"$B/ce.tsv"; }
    CT='w\t[Content_Types].xml\tchanged\tdescriptor\n'
    KEPT='w\txl/styles.xml\tidentical\t\nw\txl/workbook.xml\tidentical\t\n'
    CHART3='w\txl/charts/chart3.xml\tadded\t\nw\txl/charts/chart4.xml\tadded\t\nw\txl/charts/chart5.xml\tadded\t\n'
    CHART4="${CHART3}"'w\txl/charts/chart6.xml\tadded\t\n'
    CHART5="${CHART4}"'w\txl/charts/chart7.xml\tadded\t\n'
    MADE='w\txl/worksheets/sheet1.xml\tchanged\tdescriptor\nw\txl/worksheets/_rels/sheet1.xml.rels\tchanged\t\nw\txl/drawings/drawing2.xml\tadded\t\nw\txl/drawings/_rels/drawing2.xml.rels\tadded\t\n'
    APPENDED='w\txl/drawings/drawing1.xml\tchanged\tdescriptor\nw\txl/drawings/_rels/drawing1.xml.rels\tchanged\t\n'
    sn_made() { surface_named "$B/ce.tsv" w 1; }
    sn_kept() { surface_named "$B/ce.tsv" w 0; }
    etsv "$KEPT$CT$CHART4$MADE"
    check "control: surface_named accepts a planted created drawing" "$(yn sn_made)"
    check "control: surface_named refuses the same rows read as an appended drawing" "$(ynnot sn_kept)"
    check "control: surface_made reads the planted created drawing as created" "$(yn [ "$(surface_made "$B/ce.tsv" w)" = 1 ])"
    etsv "$KEPT${CT}${CHART4}w\txl/worksheets/sheet1.xml\tchanged\tdescriptor\nw\txl/worksheets/_rels/sheet1.xml.rels\tadded\t\nw\txl/drawings/drawing1.xml\tadded\t\nw\txl/drawings/_rels/drawing1.xml.rels\tadded\t\n"
    check "control: surface_named accepts a created drawing whose worksheet rels part is added" "$(yn sn_made)"
    etsv "$KEPT$CT$CHART4$APPENDED"
    check "control: surface_named accepts a planted appended drawing" "$(yn sn_kept)"
    check "control: surface_named refuses the same rows read as a created drawing" "$(ynnot sn_made)"
    check "control: surface_made reads the planted appended drawing as appended to" "$(yn [ "$(surface_made "$B/ce.tsv" w)" = 0 ])"
    etsv "$KEPT${CT}${CHART4}w\txl/drawings/drawing1.xml\tchanged\t\nw\txl/drawings/_rels/drawing1.xml.rels\tadded\t\n"
    check "control: surface_named accepts an appended drawing whose rels part is added" "$(yn sn_kept)"
    etsv "$KEPT$CT$CHART3$APPENDED"
    check "control: surface_named refuses three chart parts added" "$(ynnot sn_kept)"
    etsv "$KEPT$CT$CHART5$APPENDED"
    check "control: surface_named refuses five chart parts added" "$(ynnot sn_kept)"
    etsv "$KEPT$CHART4$APPENDED"
    check "control: surface_named refuses [Content_Types].xml unchanged" "$(ynnot sn_kept)"
    etsv "${KEPT}w\txl/theme/theme1.xml\tchanged\t\n$CT$CHART4$APPENDED"
    check "control: surface_named refuses another part changed" "$(ynnot sn_kept)"
    etsv "${KEPT}w\txl/styles.xml\tidentical\tmtime\n$CT$CHART4$APPENDED"
    check "control: surface_named refuses an identical row flagged" "$(ynnot sn_kept)"
    etsv "$KEPT${CT}${CHART3}w\txl/charts/chart9.xml\tadded\tdescriptor\n$APPENDED"
    check "control: surface_named refuses an added row flagged" "$(ynnot sn_kept)"
    etsv "$KEPT$CT$CHART4${APPENDED}w\txl/calcChain.xml\tdropped\t\n"
    check "control: surface_named refuses a dropped row" "$(ynnot sn_kept)"
    etsv "$KEPT$CT$CHART4${APPENDED}w\txl/calcChain.xml\trecompressed\t\n"
    check "control: surface_named refuses a recompressed row" "$(ynnot sn_kept)"
    etsv "$KEPT$CT$CHART4${APPENDED}w\txl/media/image1.png\tadded\t\n"
    check "control: surface_named refuses another part added" "$(ynnot sn_kept)"
    etsv "$KEPT$CT$CHART4$APPENDED"
    sn_two() { surface_named "$B/ce.tsv" w 2; }
    check "control: surface_named refuses a form other than 0 or 1" "$(ynnot sn_two)"
    sn_none() { surface_named "$B/ce.tsv" v 0; }
    check "control: surface_named refuses a workbook with no rows" "$(ynnot sn_none)"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\tidentical\t\n'
    check "control: chain_rows_of reads the planted workbook's one calcChain row, identical and unflagged" "$(yn [ "$(chain_rows_of "$B/ce.tsv" w)" = "1 1 0" ])"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\tdropped\t\n'
    check "control: chain_rows_of reads a dropped calcChain row as dropped" "$(yn [ "$(chain_rows_of "$B/ce.tsv" w)" = "1 0 1" ])"
    # Change NYV: the text sample's rule in place of part 3 P1's trend
    # sample's (specs/0041 "Harness runs", --chart-text-sample, and specs/0039
    # ruling C, which specs/0041 "Phases" carries). Its keys, in the tool's
    # order (tools/emend-copy, --chart-text-sample).
    KEYS_charttext="charts_before charts_after series rows texts styles read_back"
    echo "  the text sample's keys, in the tool's order: $KEYS_charttext"
    # text_line_ok <tool line>: what "Harness runs" asks of the line: three
    # charts more than before, four series, six txPr and no style element in
    # the three new chart parts (the style value is P2's), the three charts
    # read back, and the data rows referenced 1 to 1000 (change NYV).
    text_line_ok() {
      keys_ok charttext "$KEYS_charttext" "$1" || return 1
      [ "$(kv "$1" charts_after)" = "$(($(kv "$1" charts_before) + 3))" ] || return 1
      [ "$(kv "$1" series)" = 4 ] && [ "$(kv "$1" read_back)" = 3 ] || return 1
      [ "$(kv "$1" texts)" = 6 ] && [ "$(kv "$1" styles)" = 0 ] || return 1
      [ "$(kv "$1" rows)" -ge 1 ] && [ "$(kv "$1" rows)" -le 1000 ]
    }
    # The text tool test's line (tools/emend-copy/tests/null_rewrite.rs).
    LINE_X=$(printf 'charttext\tcharts_before=0\tcharts_after=3\tseries=4\trows=1\ttexts=6\tstyles=0\tread_back=3')
    echo "  the text tool test's line: $(printf '%s' "$LINE_X" | tr '\t' ' ')"
    check "control: text_line_ok accepts the text tool test's line (change NYV)" "$(yn text_line_ok "$LINE_X")"
    check "control: text_line_ok refuses the line with charts_after not three more" "$(ynnot text_line_ok "$(printf '%s' "$LINE_X" | sed 's/charts_after=3/charts_after=4/')")"
    check "control: text_line_ok refuses the line with three series" "$(ynnot text_line_ok "$(printf '%s' "$LINE_X" | sed 's/series=4/series=3/')")"
    check "control: text_line_ok refuses the line with five txPr" "$(ynnot text_line_ok "$(printf '%s' "$LINE_X" | sed 's/texts=6/texts=5/')")"
    check "control: text_line_ok refuses the line with one style element" "$(ynnot text_line_ok "$(printf '%s' "$LINE_X" | sed 's/styles=0/styles=1/')")"
    check "control: text_line_ok refuses the line with two read back" "$(ynnot text_line_ok "$(printf '%s' "$LINE_X" | sed 's/read_back=3/read_back=2/')")"
    check "control: text_line_ok refuses the line with rows 1001, past the bound (ruling C)" "$(ynnot text_line_ok "$(printf '%s' "$LINE_X" | sed 's/rows=1/rows=1001/')")"
    check "control: text_line_ok refuses the line with rows 0" "$(ynnot text_line_ok "$(printf '%s' "$LINE_X" | sed 's/rows=1/rows=0/')")"
    check "control: text_line_ok refuses the line with a key missing" "$(ynnot text_line_ok "$(printf '%s' "$LINE_X" | sed 's/\ttexts=6//')")"
    check "control: text_line_ok refuses the keys out of the tool's order (texts moved last)" "$(ynnot text_line_ok "$(printf '%s\ttexts=6' "$(printf '%s' "$LINE_X" | sed 's/\ttexts=6//')")")"
    check "control: text_line_ok refuses the surface sample's line" "$(ynnot text_line_ok "$LINE_S")"
    check "control: surface_line_ok refuses the text sample's line" "$(ynnot surface_line_ok "$LINE_X")"
    check "control: text_line_ok refuses the trend sample's word (part 3 P1's sample)" "$(ynnot text_line_ok "$(printf '%s' "$LINE_X" | sed 's/^charttext/charttrend/')")"
    check "control: text_line_ok refuses a value that is not a number" "$(ynnot text_line_ok "$(printf '%s' "$LINE_X" | sed 's/series=4/series=x/')")"
    # text_named <entries> <id> <made>: the surface rule's pattern with three
    # chart parts added (change NYV, as part 3 P1's trend rule).
    text_named() { surface_named "$1" "$2" "$3" 3; }
    xn_made() { text_named "$B/ce.tsv" w 1; }
    xn_kept() { text_named "$B/ce.tsv" w 0; }
    etsv "$KEPT$CT$CHART3$MADE"
    check "control: text_named accepts a planted created drawing with three chart parts added (change NYV)" "$(yn xn_made)"
    check "control: surface_named refuses the same rows, three chart parts for its four" "$(ynnot sn_made)"
    etsv "$KEPT$CT$CHART3$APPENDED"
    check "control: text_named accepts a planted appended drawing with three chart parts added" "$(yn xn_kept)"
    check "control: text_named refuses the same rows read as a created drawing" "$(ynnot xn_made)"
    etsv "$KEPT$CT$CHART4$APPENDED"
    check "control: text_named refuses four chart parts added" "$(ynnot xn_kept)"
    etsv "$KEPT${CT}w\txl/charts/chart3.xml\tadded\t\nw\txl/charts/chart4.xml\tadded\t\n$APPENDED"
    check "control: text_named refuses two chart parts added" "$(ynnot xn_kept)"
    etsv "$KEPT$CHART3$APPENDED"
    check "control: text_named refuses [Content_Types].xml unchanged" "$(ynnot xn_kept)"
    # Change NYZ: the edit sample's rule beside the text sample's (specs/0041
    # "Harness runs", --chart-edit-sample, ruling E; specs/0039 ruling C, which
    # specs/0041 "Phases" carries). Its keys, in the tool's order
    # (tools/emend-copy, --chart-edit-sample).
    KEYS_chartedit="charts series rows read_back kept_edited"
    echo "  the edit sample's keys, in the tool's order: $KEYS_chartedit"
    # edit_line_ok <tool line>: what "Harness runs" asks of the line: W's
    # charts one at least (the first write's one more than before), the edited
    # chart's one series, its title, name and two ranges read back as set
    # (read_back 3), the first kept chart retitled (kept_edited 1) exactly
    # when W held a chart before, so when charts is above 1, and the data rows
    # referenced 1 to 1000 (change NYZ).
    edit_line_ok() {
      keys_ok chartedit "$KEYS_chartedit" "$1" || return 1
      [ "$(kv "$1" charts)" -ge 1 ] || return 1
      [ "$(kv "$1" series)" = 1 ] && [ "$(kv "$1" read_back)" = 3 ] || return 1
      if [ "$(kv "$1" charts)" -gt 1 ]; then
        [ "$(kv "$1" kept_edited)" = 1 ] || return 1
      else
        [ "$(kv "$1" kept_edited)" = 0 ] || return 1
      fi
      [ "$(kv "$1" rows)" -ge 1 ] && [ "$(kv "$1" rows)" -le 1000 ]
    }
    # The edit tool tests' lines (tools/emend-copy/tests/null_rewrite.rs): no
    # chart kept, and two kept.
    LINE_E=$(printf 'chartedit\tcharts=1\tseries=1\trows=1\tread_back=3\tkept_edited=0')
    LINE_EK=$(printf 'chartedit\tcharts=3\tseries=1\trows=1\tread_back=3\tkept_edited=1')
    echo "  the edit tool tests' lines: $(printf '%s' "$LINE_E" | tr '\t' ' '); $(printf '%s' "$LINE_EK" | tr '\t' ' ')"
    check "control: edit_line_ok accepts the edit tool test's line with no chart kept (change NYZ)" "$(yn edit_line_ok "$LINE_E")"
    check "control: edit_line_ok accepts the edit tool test's line with two charts kept (change NYZ)" "$(yn edit_line_ok "$LINE_EK")"
    check "control: edit_line_ok refuses the line with no chart" "$(ynnot edit_line_ok "$(printf '%s' "$LINE_E" | sed 's/charts=1/charts=0/')")"
    check "control: edit_line_ok refuses the line with two series" "$(ynnot edit_line_ok "$(printf '%s' "$LINE_E" | sed 's/series=1/series=2/')")"
    check "control: edit_line_ok refuses the line with two read back" "$(ynnot edit_line_ok "$(printf '%s' "$LINE_E" | sed 's/read_back=3/read_back=2/')")"
    check "control: edit_line_ok refuses kept_edited 1 where no chart was kept" "$(ynnot edit_line_ok "$(printf '%s' "$LINE_E" | sed 's/kept_edited=0/kept_edited=1/')")"
    check "control: edit_line_ok refuses kept_edited 0 where charts were kept" "$(ynnot edit_line_ok "$(printf '%s' "$LINE_EK" | sed 's/kept_edited=1/kept_edited=0/')")"
    check "control: edit_line_ok refuses the line with rows 1001, past the bound (ruling C)" "$(ynnot edit_line_ok "$(printf '%s' "$LINE_E" | sed 's/rows=1/rows=1001/')")"
    check "control: edit_line_ok refuses the line with rows 0" "$(ynnot edit_line_ok "$(printf '%s' "$LINE_E" | sed 's/rows=1/rows=0/')")"
    check "control: edit_line_ok refuses the line with a key missing" "$(ynnot edit_line_ok "$(printf '%s' "$LINE_E" | sed 's/\tread_back=3//')")"
    check "control: edit_line_ok refuses the keys out of the tool's order (series moved last)" "$(ynnot edit_line_ok "$(printf '%s\tseries=1' "$(printf '%s' "$LINE_E" | sed 's/\tseries=1//')")")"
    check "control: edit_line_ok refuses the text sample's line" "$(ynnot edit_line_ok "$LINE_X")"
    check "control: text_line_ok refuses the edit sample's line" "$(ynnot text_line_ok "$LINE_E")"
    check "control: edit_line_ok refuses the text sample's word" "$(ynnot edit_line_ok "$(printf '%s' "$LINE_E" | sed 's/^chartedit/charttext/')")"
    check "control: edit_line_ok refuses a value that is not a number" "$(ynnot edit_line_ok "$(printf '%s' "$LINE_E" | sed 's/series=1/series=x/')")"
    # edit_named <entries> <id> <made> <kept>: the surface rule's pattern with
    # one chart part added, once the workbook's changed chart parts are set
    # aside; and of those, exactly <kept> (the kept chart the sample retitles,
    # 1, or none, 0). The rows are copied into <work>/en.tsv (change NYZ).
    edit_named() {
      local n
      n=$(awk -F'\t' -v id="$2" 'NR == 1 { for (c = 1; c <= NF; c++) k[$c] = c; next } $k["id"] == id && $k["status"] == "changed" && $k["name"] ~ /^xl\/charts\/chart[0-9]+[.]xml$/ { n++ } END { print n + 0 }' "$1")
      [ "$n" = "$4" ] || return 1
      awk -F'\t' -v id="$2" 'NR == 1 { for (c = 1; c <= NF; c++) k[$c] = c; print; next } !($k["id"] == id && $k["status"] == "changed" && $k["name"] ~ /^xl\/charts\/chart[0-9]+[.]xml$/)' "$1" >"$B/en.tsv"
      surface_named "$B/en.tsv" "$2" "$3" 1
    }
    CHART1='w\txl/charts/chart3.xml\tadded\t\n'
    KEPTCHG='w\txl/charts/chart1.xml\tchanged\tdescriptor\n'
    en_made0() { edit_named "$B/ce.tsv" w 1 0; }
    en_kept0() { edit_named "$B/ce.tsv" w 0 0; }
    en_kept1() { edit_named "$B/ce.tsv" w 0 1; }
    etsv "$KEPT$CT$CHART1$MADE"
    check "control: edit_named accepts a planted created drawing with one chart part added and no chart kept (change NYZ)" "$(yn en_made0)"
    check "control: edit_named refuses the same rows read as an appended drawing" "$(ynnot en_kept0)"
    etsv "$KEPT$CT$CHART1$KEPTCHG$APPENDED"
    check "control: edit_named accepts a planted appended drawing with one chart part added and the kept chart's part changed (change NYZ)" "$(yn en_kept1)"
    check "control: edit_named refuses the same rows where no chart was kept" "$(ynnot en_kept0)"
    etsv "$KEPT$CT$CHART1$APPENDED"
    check "control: edit_named refuses a kept chart retitled with no chart part changed" "$(ynnot en_kept1)"
    etsv "$KEPT$CT$CHART1${KEPTCHG}w\txl/charts/chart2.xml\tchanged\t\n$APPENDED"
    check "control: edit_named refuses two chart parts changed" "$(ynnot en_kept1)"
    etsv "$KEPT${CT}${CHART1}w\txl/charts/chart4.xml\tadded\t\n$KEPTCHG$APPENDED"
    check "control: edit_named refuses two chart parts added" "$(ynnot en_kept1)"
    etsv "$KEPT$CHART1$KEPTCHG$APPENDED"
    check "control: edit_named refuses [Content_Types].xml unchanged" "$(ynnot en_kept1)"
    etsv "$KEPT$CT$CHART1${KEPTCHG}w\txl/charts/_rels/chart1.xml.rels\tchanged\t\n$APPENDED"
    check "control: edit_named refuses the kept chart's rels part changed" "$(ynnot en_kept1)"
    # Change NZE: the edit sample's style form (ruling G): the program the
    # per-sample block runs over the edit sample's run directory on each
    # label, and the fixture blocks over theirs, with planted controls there.
    cat >"$B/stcheck.py" <<'PY'
    """Checks the edit sample's style form over a run directory
    (specs/0041-chart-text-and-edits.md, ruling G): in each ok workbook's
    output, the one chart part the sample added holds one root c:style, of
    val 26, right after c:roundedCorners, and no root mc:AlternateContent;
    and each chart part the sample changed (the kept chart it retitled)
    keeps the input's style, a root c:style's val or a root
    mc:AlternateContent's first Choice's style and its Fallback's, or none.
    
    Usage: python3 -I -B stcheck.py <run dir> <label> <corpus dir> <order>
    
    <order> holds "<id><TAB><ext>" lines; the input is the corpus
    directory's corpus/ID.EXT, the output the run directory's ID/out.LABEL.EXT
    (ID the workbook's id), the rows the run directory's entries.LABEL.tsv. Prints one line per workbook, its id and
    two verdicts, then the totals; no part name, text or reference of a
    workbook."""
    import re
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    MC = "{http://schemas.openxmlformats.org/markup-compatibility/2006}"
    CHART = re.compile(r"xl/charts/chart[0-9]+\.xml$")
    
    
    def local(tag):
        return tag.rsplit("}", 1)[-1]
    
    
    def style_of(root):
        plain = [c for c in root if local(c.tag) == "style"]
        alternate = [c for c in root if c.tag == MC + "AlternateContent"]
        if plain:
            return ("plain", tuple(c.get("val") for c in plain))
        if alternate:
            out = []
            for branch in alternate[0]:
                found = [c for c in branch if local(c.tag) == "style"]
                out.append((local(branch.tag), found[0].get("val") if found else None))
            return ("alternate", tuple(out))
        return ("none",)
    
    
    def added_ok(root):
        """One root c:style of val 26 right after roundedCorners, no root
        mc:AlternateContent."""
        names = [local(c.tag) for c in root]
        styles = [c for c in root if local(c.tag) == "style"]
        if len(styles) != 1 or styles[0].get("val") != "26":
            return False
        if any(c.tag == MC + "AlternateContent" for c in root):
            return False
        i = names.index("style")
        return i > 0 and names[i - 1] == "roundedCorners"
    
    
    run, label, corpus, order = sys.argv[1:5]
    rows = {}
    with open("%s/entries.%s.tsv" % (run, label), encoding="utf-8") as f:
        head = f.readline().rstrip("\n").split("\t")
        k = {n: i for i, n in enumerate(head)}
        for line in f:
            c = line.rstrip("\n").split("\t")
            rows.setdefault(c[k["id"]], []).append((c[k["name"]], c[k["status"]]))
    n = n_added = n_kept = n_kept_ok = 0
    for line in open(order, encoding="utf-8"):
        ident, ext = line.rstrip("\n").split("\t")[:2]
        entries = rows.get(ident, [])
        added = [name for name, status in entries if status == "added" and CHART.match(name)]
        changed = [name for name, status in entries if status == "changed" and CHART.match(name)]
        try:
            out = zipfile.ZipFile("%s/%s/out.%s.%s" % (run, ident, label, ext))
            inp = zipfile.ZipFile("%s/corpus/%s.%s" % (corpus, ident, ext))
        except (OSError, zipfile.BadZipFile):
            print("%s: the output or the input cannot be read" % ident)
            n += 1
            continue
        n += 1
        good = len(added) == 1 and added_ok(ET.fromstring(out.read(added[0])))
        n_added += 1 if good else 0
        kept = "none"
        for name in changed:
            n_kept += 1
            same = style_of(ET.fromstring(inp.read(name))) == style_of(ET.fromstring(out.read(name)))
            n_kept_ok += 1 if same else 0
            kept = "yes" if same and kept != "no" else "no"
        print("%s: the added chart part's style 26 after roundedCorners: %s; the kept chart's style the input's: %s"
              % (ident, "yes" if good else "no", kept))
    print("workbooks %d; whose added chart part holds one style 26 after roundedCorners %d; kept chart parts %d, "
          "their style the input's %d" % (n, n_added, n_kept, n_kept_ok))
    PY
    echo "command: <work>/stcheck.py <run dir> <label> <corpus> <order>, written here; the program:"
    sed 's/^/    /' "$B/stcheck.py"
    # st_ok <stcheck output> <workbooks> <kept>: every workbook's added chart
    # part holds one style 26 after roundedCorners, and the kept chart parts,
    # <kept> of them, each keep the input's style.
    st_ok() {
      local line
      line=$(tail -n 1 "$1")
      [ "$line" = "workbooks $2; whose added chart part holds one style 26 after roundedCorners $2; kept chart parts $3, their style the input's $3" ]
    }
    # refusal_of <run dir> <id> <label>: the layer's one "error: " line when the
    # row is a refusal, else nothing.
    refusal_of() { sed -n '1s/^error: //p' "$1/$2/stderr.$3.txt"; }
    
    
    echo
    echo "## TMPDIR for the corpus runs, on the disk"
    RUNTMP=$B/tmp-run
    mkdir "$RUNTMP" || exit 2
    dev_tmp=$(stat -c %d "$RUNTMP")
    dev_corpus=$(stat -c %d "$CORPUS/corpus")
    dev_proc=$(stat -c %d /proc)
    echo "command: mkdir <work>/tmp-run; stat -c %d <work>/tmp-run <corpus>/corpus /proc; df --output=fstype,target <work>/tmp-run <corpus>/corpus"
    echo "  device of TMPDIR (<work>/tmp-run): $dev_tmp; of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    df --output=fstype,target "$RUNTMP" "$CORPUS/corpus" | sed 's/^/    /'
    check "TMPDIR for the corpus runs and the corpus directory are on one device" "$(yn [ "$dev_tmp" = "$dev_corpus" ])"
    check "control: the same comparison tells /proc's device from the corpus directory's" "$(yn [ "$dev_proc" != "$dev_corpus" ])"
    
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names. Change VJ: the dropped families are an
    input, as the changed and added ones are."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, want_changed, want_added, want_dropped, tool_arg = sys.argv[1:9]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    def listed(value):
        return value.split(",") if value else []
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        changed_f = sorted(f for f in fam if fam[f].get("changed"))
        dropped_f = sorted(f for f in fam if fam[f].get("dropped"))
        added_f = sorted(f for f in fam if fam[f].get("added"))
        checks.append(("%s: the xml families are the changed entries' families" % label, sorted(xf) == changed_f))
        checks.append(("%s: the changed entries' families are %s" % (label, want_changed or "none"), changed_f == listed(want_changed)))
        checks.append(("%s: the dropped entries' families are %s" % (label, want_dropped or "none"), dropped_f == listed(want_dropped)))
        checks.append(("%s: the added entries' families are %s" % (label, want_added or "none"), added_f == listed(want_added)))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: " + tool_arg in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    fams_of() {
      python3 -I -B -c 'import importlib.util, sys
    spec = importlib.util.spec_from_file_location("record", sys.argv[1])
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    rows = [l.split("\t", 1) for l in open(sys.argv[2]).read().split("\n") if l]
    print(",".join(sorted({record.family(n) for (k, n) in rows if k == sys.argv[3]})))' scripts/passthrough-record.py "$1" "$2"
    }
    inst_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
    # Change JI: no bytecode was written, so there is nothing to remove.
    no_pycache() { [ ! -e scripts/__pycache__ ]; }
    # Change NVX: the per-sample block P2 ran once, run for each sample in
    # turn, here the two (changes NYV and NYZ): line_ok, form_of and named give
    # the sample's rule; every file under <work> carries the sample's word.
    # line_ok <tool line> <id>: the line by the rule.
    line_ok() {
      case $SAMPLE in
        chartedit) edit_line_ok "$1" ;;
        charttext) text_line_ok "$1" ;;
        *) return 1 ;;
      esac
    }
    # form_of <entries> <id> <tool line>: the drawing created (1) or appended
    # to (0), read from the rows (changes NXM, NYV and NYZ).
    form_of() {
      case $SAMPLE in
        chartedit | charttext) surface_made "$1" "$2" ;;
      esac
    }
    # named <entries> <id> <form> <tool line>: the workbook's rows by the
    # sample's rule for that form.
    named() {
      case $SAMPLE in
        chartedit) edit_named "$1" "$2" "$3" "$(kv "$4" kept_edited)" ;;
        charttext) text_named "$1" "$2" "$3" ;;
        *) return 1 ;;
      esac
    }
    for SAMPLE in $SAMPLES; do
    EDIT=${EDITS[$SAMPLE]}
    STEM=${STEMS[$SAMPLE]}
    O=$RUN_OUT_ROOT/$RUN-$SAMPLE
    case $SAMPLE in
      chartedit)
        LINE_WHAT="W's charts one more than before, the edited chart's one series, its title, name and two ranges read back as set, kept_edited 1 exactly where W held a chart, the data rows referenced 1 to 1000"
        ROWS_WHAT="nothing dropped or recompressed, files_identical no in every ok row; each workbook's rows by the edit rule above, for the form its rows give and its kept_edited"
        SUMMARY_WHAT="nothing dropped or recompressed"
        FORM_WHAT="a drawing created"
        # The control below: the first workbook's line with one series more.
        SERIES_SED='s/series=1/series=2/'
        ;;
      charttext)
        LINE_WHAT="three charts more, four series, six txPr and no style element in the three new parts, three read back, the data rows referenced 1 to 1000"
        ROWS_WHAT="nothing dropped or recompressed, files_identical no in every ok row; each workbook's rows by the text rule above, for the form its rows give"
        SUMMARY_WHAT="nothing dropped or recompressed"
        FORM_WHAT="a drawing created"
        # The control below: the first workbook's line with one series more.
        SERIES_SED='s/series=4/series=5/'
        ;;
    esac
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      echo
      echo "## $SAMPLE: $label run, --tool-arg $EDIT"
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --out <runs>/$RUN-$SAMPLE --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$O" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
        >"$B/run-$SAMPLE-$label.stdout" 2>"$B/run-$SAMPLE-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$SAMPLE-$label.stderr")"
      sed 's/^/    /' "$B/run-$SAMPLE-$label.stdout"
      check "$SAMPLE $label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$SAMPLE $label: its stderr is empty" "$(yn [ ! -s "$B/run-$SAMPLE-$label.stderr" ])"
      n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
      echo "  entries left in <work>/tmp-run after the run: $n_left"
      check "$SAMPLE $label: the runs' TMPDIR is empty after the run" "$(yn [ "$n_left" = 0 ])"
      SUM=$O/summary.$label.tsv
      ENT=$O/entries.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      n_ok=$(count_where "$SUM" outcome ok)
      # The refusals, by id and message.
      : >"$B/refused-$SAMPLE-$label"
      while IFS="$TAB" read -r id ext; do
        if [ "$(awk -F'\t' -v id="$id" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id { print $k["outcome"] " " $k["exit"] }' "$SUM")" = "error 2" ] \
           && [ "$(count_lines "$O/$id/stderr.$label.txt")" = 1 ] && [ -n "$(refusal_of "$O" "$id" "$label")" ]; then
          printf '%s\t%s\n' "$id" "$(refusal_of "$O" "$id" "$label")" >>"$B/refused-$SAMPLE-$label"
        fi
      done <"$B/order"
      n_ref=$(count_lines "$B/refused-$SAMPLE-$label")
      echo "  summary rows: $rows; outcome ok: $n_ok; refused by the layer (a finding; fails the summary): $n_ref"
      sed 's/^/    refused: /' "$B/refused-$SAMPLE-$label"
      echo "  among the ok rows: lo ok $(count_ok_where "$SUM" lo ok); lo_in ok $(count_ok_where "$SUM" lo_in ok); leftover no $(count_ok_where "$SUM" leftover no); order_preserved yes $(count_ok_where "$SUM" order_preserved yes); comment_equal yes $(count_ok_where "$SUM" comment_equal yes); files_identical no $(count_ok_where "$SUM" files_identical no), yes $(count_ok_where "$SUM" files_identical yes)"
      echo "  every row: lo_in ok $(count_where "$SUM" lo_in ok); leftover no $(count_where "$SUM" leftover no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      echo "  the entries table's rows by status: identical $(status_rows "$ENT" identical), recompressed $(status_rows "$ENT" recompressed), changed $(status_rows "$ENT" changed), dropped $(status_rows "$ENT" dropped), added $(status_rows "$ENT" added)"
      echo "  the entry totals the ok rows imply (an edit sample; changes NVW and NVX): $ROWS_WHAT"
      summary_ok() {
        local col st
        [ "$rows" = "$manifest_rows" ] || return 1
        [ "$n_ok" = "$rows" ] && [ "$n_ref" = 0 ] || return 1
        for col in "lo ok" "lo_in ok" "leftover no" "order_preserved yes" "comment_equal yes" "files_identical no"; do
          [ "$(count_ok_where "$SUM" ${col% *} ${col#* })" = "$n_ok" ] || return 1
        done
        [ "$(count_where "$SUM" lo_in ok)" = "$rows" ] || return 1
        [ "$(count_where "$SUM" leftover no)" = "$rows" ] || return 1
        if [ "$SAMPLE" = chartedit ] || [ "$SAMPLE" = charttext ]; then
          for st in dropped recompressed; do
            [ "$(sum_col "$SUM" "$st")" = 0 ] || return 1
          done
        fi
        for st in identical recompressed changed dropped added; do
          [ "$(sum_col "$SUM" "$st")" = "$(status_rows "$ENT" "$st")" ] || return 1
        done
      }
      check "$SAMPLE $label: every row ok; every row's input opens (lo_in ok) with no leftover; every output opens (lo ok), order and comment kept, files_identical no; $SUMMARY_WHAT; the summary's status totals the entries table's (change NVX)" "$(yn summary_ok)"
      echo "  per ok workbook: id and the tool's line (counts and flags only)"
      : >"$B/lines-$SAMPLE-$label"
      : >"$B/made-$SAMPLE-$label"
      nwb=0; nline=0; nentries=0; nform=0
      nchain=0; nchain_same=0; nchain_drop=0
      while IFS="$TAB" read -r id ext; do
        if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$SAMPLE-$label")" ]; then continue; fi
        nwb=$((nwb + 1))
        e=$(cat "$O/$id/stdout.$label.txt")
        printf '%s\t%s\n' "$id" "$e" >>"$B/lines-$SAMPLE-$label"
        printf '    %s %s\n' "$id" "$(printf '%s' "$e" | tr '\t' ' ')"
        form=$(form_of "$ENT" "$id" "$e")
        printf '%s\t%s\n' "$id" "$form" >>"$B/made-$SAMPLE-$label"
        if [ "$form" = 1 ]; then nform=$((nform + 1)); fi
        if LC_ALL=C "$G" -qxF "$id" "$B/chain-ids"; then
          cr=$(chain_rows_of "$ENT" "$id")
          set -- $cr
          nchain=$((nchain + $1)); nchain_same=$((nchain_same + $2)); nchain_drop=$((nchain_drop + $3))
        fi
        if line_ok "$e" "$id"; then nline=$((nline + 1)); else echo "    $id: the tool's line is not what the spec reads"; fi
        if named "$ENT" "$id" "$form" "$e"; then nentries=$((nentries + 1)); else echo "    $id: the entry rows are not what the rule gives for the form read, $form"; fi
      done <"$B/order"
      echo "  ok workbooks read: $nwb; the line as the spec reads: $nline; entry rows as the rule gives: $nentries; $FORM_WHAT: $nform, not: $((nwb - nform))"
      check "$SAMPLE $label: every ok workbook's line was read" "$(yn [ "$nwb" = "$n_ok" ])"
      check "$SAMPLE $label: every line is what the spec reads ($LINE_WHAT; change NWW)" "$(yn [ "$nline" = "$n_ok" ])"
      check "$SAMPLE $label: every ok workbook's entry rows are as the rule gives (change NWW)" "$(yn [ "$nentries" = "$n_ok" ])"
      # Change NZE: the edit sample's style form (ruling G).
      if [ "$SAMPLE" = chartedit ]; then
        echo "command: python3 -I -B <work>/stcheck.py <runs>/$RUN-$SAMPLE $label <corpus> <work>/order"
        python3 -I -B "$B/stcheck.py" "$O" "$label" "$CORPUS" "$B/order" >"$B/stcheck-$label.out" 2>&1
        echo "  exit: $?"
        sed 's/^/    /' "$B/stcheck-$label.out"
        n_kept_now=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] == "changed" && $k["name"] ~ /^xl\/charts\/chart[0-9]+[.]xml$/ { n++ } END { print n + 0 }' "$ENT")
        check "$SAMPLE $label: every workbook's added chart part holds one c:style val 26 right after roundedCorners, and each kept chart part retitled, $n_kept_now, keeps the input's style (ruling G; change NZE)" "$(yn st_ok "$B/stcheck-$label.out" "$n_ok" "$n_kept_now")"
      fi
      echo "  calcChain rows in the ok rows of the chain workbooks: $nchain; identical and unflagged: $nchain_same; dropped: $nchain_drop (change NSI)"
      chain_kept() { [ "$nchain" = "$N_CHAIN" ] && [ "$nchain_same" = "$nchain" ] && [ "$nchain_drop" = 0 ]; }
      check "$SAMPLE $label: every chain workbook has one calcChain row, identical and unflagged, none dropped (change NSI)" "$(yn chain_kept)"
      R=$O/run.$label.tsv
      args=$(row_field "$R" tool_args)
      bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
      check "$SAMPLE $label: the run row records the two release binaries built here by sha256 and the phase commit (change NVM)" "$(yn bins_in_row)"
      check "$SAMPLE $label: the run row's tool_args is $EDIT" "$(yn [ "$args" = "$EDIT" ])"
    done
    check "$SAMPLE: the same workbooks are refused on both targets, with the same messages (none)" "$(yn cmp -s "$B/refused-$SAMPLE-host" "$B/refused-$SAMPLE-i686")"
    cp "$B/refused-$SAMPLE-host" "$B/c-refused"; printf 'x\tsome message\n' >>"$B/c-refused"
    check "control: the same comparison tells a planted refusal list from the host's" "$(ynnot cmp -s "$B/c-refused" "$B/refused-$SAMPLE-i686")"
    mkdir -p "$B/c-refrun/r1"
    printf 'error: a planted message\n' >"$B/c-refrun/r1/stderr.host.txt"
    ref_read() { [ "$(refusal_of "$B/c-refrun" r1 host)" = "a planted message" ]; }
    check "control: refusal_of reads a planted refusal's message" "$(yn ref_read)"
    : >"$B/c-refrun/r1/stderr.host.txt"
    ref_none() { [ -z "$(refusal_of "$B/c-refrun" r1 host)" ]; }
    check "control: refusal_of reads nothing from an empty standard error" "$(yn ref_none)"
    first_line() { awk -F'\t' -v id="$1" '$1 == id { sub(/^[^\t]*\t/, ""); print; exit }' "$B/lines-$SAMPLE-host"; }
    entries_ctl() {
      local id
      id=$(head -n 1 "$B/order" | cut -f1)
      named "$O/entries.host.tsv" "${id}x" 0 "$(first_line "$id")"
    }
    check "control: $SAMPLE: named refuses the first workbook's id with a letter appended, which has no rows" "$(ynnot entries_ctl)"
    first_line_ctl() { local id ext ENT; id=$(head -n 1 "$B/order" | cut -f1); ext=$(head -n 1 "$B/order" | cut -f2); ENT=$O/entries.host.tsv; line_ok "$(first_line "$id" | sed "$SERIES_SED")" "$id"; }
    check "control: $SAMPLE: line_ok refuses the first workbook's host line with one series more (changes NXM and NXU)" "$(ynnot first_line_ctl)"
    
    echo
    echo "### $SAMPLE: the corpus totals over the host's ok workbooks (counts only; change NVX)"
    total_of() { cut -f2- "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | awk '{ n += $1 } END { print n + 0 }'; }
    wbs_of() { cut -f2- "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | awk '$1 > 0 { n++ } END { print n + 0 }'; }
    keys_var=KEYS_$SAMPLE
    for k in ${!keys_var}; do
      echo "    $k: $(total_of "$B/lines-$SAMPLE-host" "$k") in $(wbs_of "$B/lines-$SAMPLE-host" "$k") workbooks"
    done
    # Changes NYV and NYZ: each sample's corpus totals.
    case $SAMPLE in
      chartedit)
        # kept_edited: the workbooks whose W held a chart, read from the lines.
        kept_wbs() { cut -f2- "$1" | tr '\t ' '\n\n' | sed -n 's/^charts=//p' | awk '$1 > 1 { n++ } END { print n + 0 }'; }
        read_all() { [ "$(total_of "$B/lines-$SAMPLE-host" read_back)" = "$((3 * manifest_rows))" ] && [ "$(total_of "$B/lines-$SAMPLE-host" series)" = "$manifest_rows" ] && [ "$(total_of "$B/lines-$SAMPLE-host" kept_edited)" = "$(kept_wbs "$B/lines-$SAMPLE-host")" ] && [ "$(count_lines "$B/lines-$SAMPLE-host")" = "$manifest_rows" ]; }
        READ_WHAT="every workbook's edited chart read back as set, read_back $(total_of "$B/lines-$SAMPLE-host" read_back) of $((3 * manifest_rows)), series $(total_of "$B/lines-$SAMPLE-host" series) of $manifest_rows, kept_edited $(total_of "$B/lines-$SAMPLE-host" kept_edited), the workbooks whose W held a chart $(kept_wbs "$B/lines-$SAMPLE-host") (change NYZ)"
        ;;
      charttext)
        read_all() { [ "$(total_of "$B/lines-$SAMPLE-host" read_back)" = "$((3 * manifest_rows))" ] && [ "$(total_of "$B/lines-$SAMPLE-host" series)" = "$((4 * manifest_rows))" ] && [ "$(total_of "$B/lines-$SAMPLE-host" texts)" = "$((6 * manifest_rows))" ] && [ "$(total_of "$B/lines-$SAMPLE-host" styles)" = 0 ] && [ "$(count_lines "$B/lines-$SAMPLE-host")" = "$manifest_rows" ]; }
        READ_WHAT="every workbook's three charts read back, read_back $(total_of "$B/lines-$SAMPLE-host" read_back) of $((3 * manifest_rows)), series $(total_of "$B/lines-$SAMPLE-host" series) of $((4 * manifest_rows)), texts $(total_of "$B/lines-$SAMPLE-host" texts) of $((6 * manifest_rows)), styles $(total_of "$B/lines-$SAMPLE-host" styles) (change NYV)"
        ;;
    esac
    check "$SAMPLE: $READ_WHAT" "$(yn read_all)"
    # Change NXR (specs/0039 "Planning rulings during P1", ruling A): the data
    # rows each workbook's charts reference, the line's rows: 1000 at most, and
    # 1000 for the two large workbooks dry run 2 found LibreOffice timing out
    # on, where the bound applies.
    rows_of() { awk -F'\t' -v id="$2" '$1 == id' "$1" | cut -f2- | tr '\t ' '\n\n' | sed -n 's/^rows=//p' | head -1; }
    rows_max() { cut -f2- "$1" | tr '\t ' '\n\n' | sed -n 's/^rows=//p' | sort -n | tail -n 1; }
    rows_at_bound() { cut -f2- "$1" | tr '\t ' '\n\n' | count_matches -x 'rows=1000' /dev/stdin; }
    echo "  rows (the data rows referenced): at most $(rows_max "$B/lines-$SAMPLE-host"); workbooks at the bound, rows 1000: $(rows_at_bound "$B/lines-$SAMPLE-host"); 9132ce5303d8 $(rows_of "$B/lines-$SAMPLE-host" 9132ce5303d8), ab0e6a529465 $(rows_of "$B/lines-$SAMPLE-host" ab0e6a529465)"
    rows_bounded() { [ -n "$(rows_max "$1")" ] && [ "$(rows_max "$1")" -le 1000 ]; }
    check "$SAMPLE: every workbook's charts reference 1000 data rows at most (specs/0039 rulings A and C; changes NXR, NYV and NYZ)" "$(yn rows_bounded "$B/lines-$SAMPLE-host")"
    bound_applied() { [ "$(rows_of "$1" 9132ce5303d8)" = 1000 ] && [ "$(rows_of "$1" ab0e6a529465)" = 1000 ]; }
    check "$SAMPLE: the two large workbooks, 9132ce5303d8 and ab0e6a529465, reference 1000, the bound applied (specs/0039 rulings A and C; changes NXR, NYV and NYZ)" "$(yn bound_applied "$B/lines-$SAMPLE-host")"
    printf '9132ce5303d8\tchartsurface\trows=1001\nab0e6a529465\tchartsurface\trows=1000\n' >"$B/c-rows"
    check "control: rows_bounded refuses a planted file with one workbook at rows 1001 (change NXR)" "$(ynnot rows_bounded "$B/c-rows")"
    check "control: bound_applied refuses the same planted file (change NXR)" "$(ynnot bound_applied "$B/c-rows")"
    
    echo
    echo "### $SAMPLE: the two labels' outputs"
    same_out=0
    nboth=0
    while IFS="$TAB" read -r id ext; do
      if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$SAMPLE-host")" ]; then continue; fi
      nboth=$((nboth + 1))
      if cmp -s "$O/$id/out.host.$ext" "$O/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
    done <"$B/order"
    echo "  ok workbooks: $nboth; whose host and i686 outputs are byte for byte the same: $same_out"
    check "$SAMPLE: every output is the same on both targets" "$(yn [ "$same_out" = "$nboth" ])"
    check "$SAMPLE: both targets printed the same line for every ok workbook" "$(yn cmp -s "$B/lines-$SAMPLE-host" "$B/lines-$SAMPLE-i686")"
    cp "$B/lines-$SAMPLE-host" "$B/c-lines"; printf 'x\n' >>"$B/c-lines"
    check "control: the same comparison tells a line list with one line added" "$(ynnot cmp -s "$B/c-lines" "$B/lines-$SAMPLE-i686")"
    
    echo
    echo "## the $SAMPLE run's record pair"
    echo "command: python3 -I -B scripts/passthrough-record.py --run <runs>/$RUN-$SAMPLE --out <scripts>/out/records --stem $STEM (changes NTJ, NUW and NVX)"
    python3 -I -B scripts/passthrough-record.py --run "$O" --out "$RECORDS" --stem "$STEM" >"$B/record-$SAMPLE.out" 2>&1
    rrc=$?
    sed 's/^/    /' "$B/record-$SAMPLE.out"
    check "$SAMPLE: the record script exits 0" "$(yn [ "$rrc" = 0 ])"
    RTXT=$RECORDS/$STEM.txt
    RMD=$RECORDS/$STEM.md
    # The families: the names of the host entries table's changed, added and
    # dropped rows (change NSR), against the sample's (changes NUW and NVX).
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] ~ /^(changed|added|dropped)$/ { print $k["status"] "\t" $k["name"] }' "$O/entries.host.tsv" >"$B/w-$SAMPLE.parts"
    check "$SAMPLE: some changed, added or dropped name in the host entries table ($(count_lines "$B/w-$SAMPLE.parts") names; change NSR)" "$(yn [ "$(count_lines "$B/w-$SAMPLE.parts")" -ge 1 ])"
    FAM_CHANGED=$(fams_of "$B/w-$SAMPLE.parts" changed)
    FAM_ADDED=$(fams_of "$B/w-$SAMPLE.parts" added)
    FAM_DROPPED=$(fams_of "$B/w-$SAMPLE.parts" dropped)
    echo "  the families: changed ${FAM_CHANGED:-none}; added ${FAM_ADDED:-none}; dropped ${FAM_DROPPED:-none}"
    case $SAMPLE in
      chartedit)
        # A kept chart retitled changes its chart part (change NYZ).
        if [ "$(total_of "$B/lines-$SAMPLE-host" kept_edited)" -gt 0 ]; then
          WANT_FAMS="chart,content-types,drawing,rels,worksheet chart,drawing,rels -"
        else
          WANT_FAMS="content-types,drawing,rels,worksheet chart,drawing,rels -"
        fi
        ;;
      charttext) WANT_FAMS="content-types,drawing,rels,worksheet chart,drawing,rels -" ;;
    esac
    fams_ok() { [ "$FAM_CHANGED ${FAM_ADDED:--} ${FAM_DROPPED:--}" = "$WANT_FAMS" ]; }
    check "$SAMPLE: the changed, added and dropped families are the sample's: $WANT_FAMS (- for none; changes NUW, NXM, NYV and NYZ)" "$(yn fams_ok)"
    fams_ctl() { local FAM_ADDED=planted; fams_ok; }
    check "control: the same check refuses a planted added family" "$(ynnot fams_ctl)"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/reccheck-$SAMPLE.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/reccheck-$SAMPLE.out"
    rec_all() { [ "$(count_matches -E ': yes$' "$B/reccheck-$SAMPLE.out")" = 18 ] && [ "$(count_matches -E ': no$' "$B/reccheck-$SAMPLE.out")" = 0 ]; }
    check "$SAMPLE: the record's three tables are the run directory's, and its family tables are counted from them (eighteen checks: four, six per label, two)" "$(yn rec_all)"
    awk '!done && /^[|] total [|]/ { done = 1; next } { print }' "$RMD" >"$B/c-rec.md"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$B/c-rec.md" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/c-reccheck.out" 2>&1
    sed '2d' "$RTXT" >"$B/c-rec.txt"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$B/c-rec.txt" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/c-reccheck2.out" 2>&1
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "planted" "$EDIT" >"$B/c-reccheck3.out" 2>&1
    rec_ctl() { [ "$(count_matches -E ': no$' "$B/c-reccheck.out")" -ge 1 ] && [ "$(count_matches -F "the summary table is every label's summary: no" "$B/c-reccheck2.out")" = 1 ]; }
    check "control: the same check finds an .md with a family table's total row dropped and a .txt one summary row short" "$(yn rec_ctl)"
    rec_drop() { [ "$(count_matches -E "the dropped entries' families are planted: no\$" "$B/c-reccheck3.out")" = 2 ]; }
    check "control: the same check finds the dropped families differ from a planted family, on each label" "$(yn rec_drop)"
    check "the record script and the record check left no scripts/__pycache__ (PYTHONDONTWRITEBYTECODE)" "$(yn no_pycache)"
    echo "command: install -m 644 <scripts>/out/records/$STEM.md <scripts>/out/records/$STEM.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RMD" "$RTXT" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM.md" "$RECORDS_DEST/$STEM.txt")
    echo "  exit: $?"
    for f in "$STEM.md" "$STEM.txt"; do
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
    done
    done
    echo
    echo "## the charttext run against P1's, the run the record P1's record commit, the base, added names, by sha256 (specs/0041 \"P2\": P1's corpus run rerun byte-identical; part 3 P2's change NYK, its form; a difference is a finding, not a fix; change NZA)"
    # run_of_md <record .md>: the run directory the committed record names.
    run_of_md() { git show "$C:$1" 2>/dev/null | sed -n 's/^Written by .* from the run directory `\([^`]*\)`.*$/\1/p' | head -n 1; }
    P1_PAT=records/m6p4-p1-charttext-
    P1_WANT=records/m6p4-p1-charttext-2026-10-21-f838d65.txt
    P1_MD=$(git show --name-only --format= "$REC" | LC_ALL=C "$G" -E "^${P1_PAT}[0-9-]+-[0-9a-f]{7}[.]md\$")
    P1_TXT=$(git show --name-only --format= "$REC" | LC_ALL=C "$G" -E "^${P1_PAT}[0-9-]+-[0-9a-f]{7}[.]txt\$")
    echo "command: git show --name-only --format= <P1's record commit>, the text record's .md and .txt it added: ${P1_MD:-none} ${P1_TXT:-none}"
    check "P1's record commit added exactly one text record .md and one .txt (change NZA)" "$(yn [ "$(printf '%s\n%s\n' "$P1_MD" "$P1_TXT" | count_matches -E '^records/' /dev/stdin)" = 2 ])"
    check "the record is the one this phase names, $P1_WANT (change NZA)" "$(yn [ "$P1_TXT" = "$P1_WANT" ])"
    p1_later() { [ -z "$(git log --format=%H "$REC..$C" -- "${P1_PAT}*.md")" ]; }
    check "no later commit adds a record of that stem, so it is the latest committed (change NZA)" "$(yn p1_later)"
    p1_want_ctl() { [ "$P1_TXT" = records/m6p4-open-2026-10-21-f838d65.txt ]; }
    check "control: the record-name check refuses the record against P1's open-check record's name" "$(ynnot p1_want_ctl)"
    P1_RUN_NAME=$(run_of_md "$P1_MD")
    P1_RUN=$CORPUS/runs/$P1_RUN_NAME
    echo "  the run directory the record names: <corpus>/runs/${P1_RUN_NAME:-none} (read only)"
    p1_run_ok() { [ -n "$P1_RUN_NAME" ] && [ -d "$P1_RUN" ] && [ -f "$P1_RUN/summary.host.tsv" ] && [ -f "$P1_RUN/summary.i686.tsv" ]; }
    check "the run directory is there with both labels' summaries (change NZA)" "$(yn p1_run_ok)"
    p1_run_ctl() { local P1_RUN=$CORPUS/runs/no-such-run; p1_run_ok; }
    check "control: the same check refuses a run directory that is not there" "$(ynnot p1_run_ctl)"
    check "the run's run row names --chart-text-sample (change NZA)" "$(yn [ "$(row_field "$P1_RUN/run.host.tsv" tool_args)" = --chart-text-sample ])"
    check "the run's run row names P1's record commit's parent, P1's phase commit (change NZA)" "$(yn [ "$(row_field "$P1_RUN/run.host.tsv" commit)" = "$(git rev-parse "$REC~1")" ])"
    check "control: the run row check refuses the run's row against this phase's commit" "$(ynnot [ "$(row_field "$P1_RUN/run.host.tsv" commit)" = "$C" ])"
    # same_row <run dir> <earlier run dir> <id> <ext> <label>: the row's output
    # and its tool line in the two run directories, both there, the same by
    # sha256 (M5 part 5 P4's change NWB, its P2's change NVS's form).
    same_row() {
      local f
      for f in "out.$5.$4" "stdout.$5.txt"; do
        [ -f "$1/$3/$f" ] && [ -f "$2/$3/$f" ] || return 1
        [ "$(sha_of "$1/$3/$f")" = "$(sha_of "$2/$3/$f")" ] || return 1
      done
    }
    mkdir -p "$B/c-ident/a/w" "$B/c-ident/b/w" "$B/c-ident/c/w" "$B/c-ident/d/w"
    printf 'pk' >"$B/c-ident/a/w/out.host.xlsx"; printf 'line\n' >"$B/c-ident/a/w/stdout.host.txt"
    cp "$B/c-ident/a/w/out.host.xlsx" "$B/c-ident/a/w/stdout.host.txt" "$B/c-ident/b/w/"
    cp "$B/c-ident/a/w/out.host.xlsx" "$B/c-ident/c/w/"; printf 'line2\n' >"$B/c-ident/c/w/stdout.host.txt"
    cp "$B/c-ident/a/w/stdout.host.txt" "$B/c-ident/d/w/"
    check "control: the planted differing line differs from the original (cmp)" "$(ynnot cmp -s "$B/c-ident/a/w/stdout.host.txt" "$B/c-ident/c/w/stdout.host.txt")"
    check "control: same_row accepts two planted rows the same byte for byte" "$(yn same_row "$B/c-ident/a" "$B/c-ident/b" w xlsx host)"
    check "control: same_row refuses a planted row whose line differs" "$(ynnot same_row "$B/c-ident/a" "$B/c-ident/c" w xlsx host)"
    check "control: same_row refuses a planted row with no output" "$(ynnot same_row "$B/c-ident/a" "$B/c-ident/d" w xlsx host)"
    # prevrec.py <run dir> <record .txt>: the earlier run directory's summaries,
    # every label's in order, against the summary table, the first of three, of
    # that run's committed record (M5 part 5 P4's, carried).
    cat >"$B/prevrec.py" <<'PY'
    import os
    import sys
    
    sys.dont_write_bytecode = True
    run_dir, txt = sys.argv[1:3]
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    summary = []
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        summary += s[1:]
    tables = "\n".join(lines(txt)).split("\n\n")
    ok = len(labels) == 2 and len(tables) == 3 and tables[0].split("\n") == summary
    print("labels %s; summary rows %d; the record's summary table is the run directory's: %s" % (",".join(labels), len(summary) - 1, "yes" if ok else "no"))
    PY
    echo "command: <work>/prevrec.py <earlier run directory> <its committed record's .txt>; the program:"
    sed 's/^/    /' "$B/prevrec.py"
    git show "$C:$P1_TXT" >"$B/prev-p1.txt"
    echo "command: git show <phase commit>:$P1_TXT; <work>/prevrec.py <corpus>/runs/${P1_RUN_NAME:-none} <it>"
    python3 -I -B "$B/prevrec.py" "$P1_RUN" "$B/prev-p1.txt" >"$B/prevrec-p1.out" 2>&1
    echo "  $(cat "$B/prevrec-p1.out")"
    check "P1's run directory's summaries, both labels, are its committed record's summary table (change NZA)" "$(yn [ "$(count_matches -E "is the run directory's: yes\$" "$B/prevrec-p1.out")" = 1 ])"
    sed '2d' "$B/prev-p1.txt" >"$B/c-prev-p1.txt"
    python3 -I -B "$B/prevrec.py" "$P1_RUN" "$B/c-prev-p1.txt" >"$B/c-prevrec-p1.out" 2>&1
    check "control: the same program refuses that record with one summary row dropped" "$(yn [ "$(count_matches -E "is the run directory's: no\$" "$B/c-prevrec-p1.out")" = 1 ])"
    NOW_RUN=$RUN_OUT_ROOT/$RUN-charttext
    for label in host i686; do
      nrow=0; nsame=0
      : >"$B/ident-$label"
      while IFS="$TAB" read -r id ext; do
        nrow=$((nrow + 1))
        printf '    %s %s out %s %s line %s %s\n' "$id" "$label" \
          "$(sha_of "$NOW_RUN/$id/out.$label.$ext" 2>/dev/null)" "$(sha_of "$P1_RUN/$id/out.$label.$ext" 2>/dev/null)" \
          "$(sha_of "$NOW_RUN/$id/stdout.$label.txt" 2>/dev/null)" "$(sha_of "$P1_RUN/$id/stdout.$label.txt" 2>/dev/null)" >>"$B/ident-$label"
        if same_row "$NOW_RUN" "$P1_RUN" "$id" "$ext" "$label"; then nsame=$((nsame + 1)); else echo "    FINDING (an output byte of the sample moved since P1's run; change NZA): $id: $label: the output or the line differs from P1's run"; fi
      done <"$B/order"
      echo "  charttext $label: per row, id, label, the output's sha256 now and in P1's run, the line's now and in P1's run:"
      cat "$B/ident-$label"
      echo "  charttext $label: rows compared $nrow; identical, output and line, by sha256: $nsame"
      rr_same() { [ "$nrow" = "$manifest_rows" ] && [ "$nsame" = "$nrow" ]; }
      check "charttext $label: every row's output and line are byte-identical to P1's run, by sha256, $nsame of $manifest_rows (change NZA)" "$(yn rr_same)"
    done
    rr_first_id=$(head -n 1 "$B/order" | cut -f1)
    rr_first_ext=$(head -n 1 "$B/order" | cut -f2)
    rr_ctl() { same_row "$NOW_RUN" "$P1_RUN" "${rr_first_id}x" "$rr_first_ext" host; }
    check "control: same_row refuses the first workbook's id with a letter appended, which neither run holds" "$(ynnot rr_ctl)"
    echo
    # Change NYZ: per workbook, the edit sample's charts less one, W's charts
    # before its first write, are the text sample's charts_before, both read
    # from the host's lines; and kept_edited is 1 exactly where charts_before
    # is above 0. et_count <edit lines> <text lines>: the workbooks of the text
    # lines, and of them those that hold.
    et_count() {
      awk -F'\t' '
        FNR == 1 { f++ }
        { v = ""; e = ""
          for (i = 2; i <= NF; i++) {
            split($i, p, "=")
            if (f == 1 && p[1] == "charts") v = p[2] - 1
            if (f == 1 && p[1] == "kept_edited") e = p[2]
            if (f == 2 && p[1] == "charts_before") v = p[2]
          }
          if (f == 1) { a[$1] = v; ke[$1] = e } else { b[$1] = v } }
        END { n = 0; m = 0
          for (id in b) { n++; if ((id in a) && a[id] == b[id] && ke[id] == (b[id] > 0 ? 1 : 0)) m++ }
          print n " " m }' "$1" "$2"
    }
    read -r et_n et_m <<<"$(et_count "$B/lines-chartedit-host" "$B/lines-charttext-host")"
    echo "  workbooks read in both samples' host lines: $et_n; whose edit sample's charts less one are the text sample's charts_before, kept_edited 1 exactly where that is above 0: $et_m"
    et_all() { [ "$et_n" = "$manifest_rows" ] && [ "$et_m" = "$et_n" ]; }
    check "every workbook's edit sample line names the charts the text sample read before its write, and retitles a kept chart exactly where there was one (change NYZ)" "$(yn et_all)"
    awk -F'\t' 'NR == 1 { sub(/\tcharts=[0-9]+/, "\tcharts=99") } { print }' "$B/lines-chartedit-host" >"$B/c-lines-edit"
    read -r et_cn et_cm <<<"$(et_count "$B/c-lines-edit" "$B/lines-charttext-host")"
    et_ctl() { [ "$et_cn" = "$et_n" ] && [ "$et_cm" = "$((et_n - 1))" ]; }
    check "control: the same count finds the one planted line whose charts are not the text sample's charts_before plus one" "$(yn et_ctl)"
    echo
    echo "## the Excel-form fixture: --charts-sample, --chart-text-sample and --chart-edit-sample on it through the runner, both targets (specs/0041 \"Harness runs\", the first fixture, and rulings B and E; P1's change NYW, its form; change NZB)"
    # The fixture is fictional and its values printable; it is written under
    # <work>, never committed, as a one-workbook corpus the runner takes with
    # --corpus, so lo and lo_in are the runner's open checks.
    cat >"$B/txfix.py" <<'PY'
    """The run log's fictional Excel-form text fixture
    (specs/0041-chart-text-and-edits.md, "Harness runs", the first fixture,
    and ruling B): one worksheet of twelve cells (A1:B6, numbers: the
    categories 1 to 6 in A, values in B), its drawing in one twoCellAnchor
    holding a barChart of one series (values B1:B6 against A1:A6) whose dLbls
    holds a txPr; a title whose rich text carries a:pPr with a:defRPr and the
    run's a:rPr (14 pt bold); a catAx and a valAx each with a txPr after
    tickLblPos; a legend with a txPr after overlay; and a root
    mc:AlternateContent after roundedCorners holding c14:style 102 in its
    Choice and c:style 2 in its Fallback (the corpus's form), with a chart
    style part and a chart colour style part reached from the chart part's
    rels, each with its Override; every element's children in the schema's
    order. Writes the workbook with zipfile at fixed timestamps into
    corpus/<id>.xlsx in the directory it is given, and a one-row manifest,
    manifest.tsv, beside corpus there, in specs/0005's form, <id> the first
    twelve hex digits of the workbook's sha256; prints the id, the byte count
    and the sha256."""
    import hashlib
    import io
    import os
    import sys
    import zipfile
    
    sys.dont_write_bytecode = True
    MAIN = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    REL = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    PKG = "http://schemas.openxmlformats.org/package/2006/relationships"
    CT = "http://schemas.openxmlformats.org/package/2006/content-types"
    XDR = "http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing"
    A = "http://schemas.openxmlformats.org/drawingml/2006/main"
    C = "http://schemas.openxmlformats.org/drawingml/2006/chart"
    MC = "http://schemas.openxmlformats.org/markup-compatibility/2006"
    C14 = "http://schemas.microsoft.com/office/drawing/2007/8/2/chart"
    CS = "http://schemas.microsoft.com/office/drawing/2012/chartStyle"
    MSREL = "http://schemas.microsoft.com/office/2011/relationships"
    VND = "application/vnd.openxmlformats-officedocument"
    DECL = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    MANIFEST_HEADER = ("id\tsha256\tbytes\text\tproducer\tproducer_version\tapp\tsource\ttags\tadded"
                       "\toriginal_name\tnote")
    CATEGORIES = (1, 2, 3, 4, 5, 6)
    VALUES = (12, 30, 21, 44, 37, 50)
    
    
    def rels(body):
        return DECL + '<Relationships xmlns="%s">%s</Relationships>' % (PKG, body)
    
    
    def ref(element, form, formula):
        return "<c:%s><c:%s><c:f>%s</c:f></c:%s></c:%s>" % (element, form, formula, form, element)
    
    
    def text_pr(run):
        return ('<c:txPr><a:bodyPr/><a:lstStyle/><a:p><a:pPr>%s</a:pPr><a:endParaRPr lang="en-US"/></a:p>'
                '</c:txPr>' % run)
    
    
    labels = ('<c:dLbls>%s<c:showLegendKey val="0"/><c:showVal val="1"/><c:showCatName val="0"/>'
              '<c:showSerName val="0"/><c:showPercent val="0"/><c:showBubbleSize val="0"/></c:dLbls>'
              % text_pr('<a:defRPr sz="900"/>'))
    ser = ('<c:ser><c:idx val="0"/><c:order val="0"/><c:tx><c:v>Fixture</c:v></c:tx>%s%s%s</c:ser>'
           % (labels, ref("cat", "numRef", "Sheet1!$A$1:$A$6"), ref("val", "numRef", "Sheet1!$B$1:$B$6")))
    plot = ('<c:barChart><c:barDir val="col"/><c:grouping val="clustered"/><c:varyColors val="0"/>%s'
            '<c:gapWidth val="150"/><c:axId val="10"/><c:axId val="20"/></c:barChart>' % ser)
    TICKS = '<c:majorTickMark val="out"/><c:minorTickMark val="none"/><c:tickLblPos val="nextTo"/>'
    AXIS_TEXT = text_pr('<a:defRPr sz="900" b="1"/>')
    cat_ax = ('<c:catAx><c:axId val="10"/><c:scaling><c:orientation val="minMax"/></c:scaling>'
              '<c:delete val="0"/><c:axPos val="b"/><c:numFmt formatCode="General" sourceLinked="1"/>%s%s'
              '<c:crossAx val="20"/><c:crosses val="autoZero"/><c:auto val="1"/><c:lblAlgn val="ctr"/>'
              '<c:lblOffset val="100"/><c:noMultiLvlLbl val="0"/></c:catAx>' % (TICKS, AXIS_TEXT))
    val_ax = ('<c:valAx><c:axId val="20"/><c:scaling><c:orientation val="minMax"/></c:scaling>'
              '<c:delete val="0"/><c:axPos val="l"/><c:majorGridlines/><c:numFmt formatCode="General" '
              'sourceLinked="1"/>%s%s<c:crossAx val="10"/><c:crosses val="autoZero"/>'
              '<c:crossBetween val="between"/></c:valAx>' % (TICKS, AXIS_TEXT))
    title = ('<c:title><c:tx><c:rich><a:bodyPr/><a:lstStyle/><a:p><a:pPr><a:defRPr sz="1400" b="1"/></a:pPr>'
             '<a:r><a:rPr lang="en-US" sz="1400" b="1"/><a:t>Fixture title</a:t></a:r></a:p></c:rich></c:tx>'
             '<c:overlay val="0"/></c:title>')
    style = ('<mc:AlternateContent xmlns:mc="%s"><mc:Choice Requires="c14" xmlns:c14="%s">'
             '<c14:style val="102"/></mc:Choice><mc:Fallback><c:style val="2"/></mc:Fallback>'
             '</mc:AlternateContent>' % (MC, C14))
    chart = (DECL + '<c:chartSpace xmlns:c="%s" xmlns:a="%s" xmlns:r="%s"><c:date1904 val="0"/>'
             '<c:roundedCorners val="0"/>%s<c:chart>%s<c:autoTitleDeleted val="0"/><c:plotArea><c:layout/>%s%s%s'
             '</c:plotArea><c:legend><c:legendPos val="r"/><c:overlay val="0"/>%s</c:legend>'
             '<c:plotVisOnly val="1"/><c:dispBlanksAs val="gap"/></c:chart></c:chartSpace>'
             % (C, A, REL, style, title, plot, cat_ax, val_ax, text_pr('<a:defRPr sz="900"/>')))
    chart_style = (DECL + '<cs:chartStyle xmlns:cs="%s" xmlns:a="%s" id="201"><cs:axisTitle><cs:lnRef idx="0"/>'
                   '<cs:fillRef idx="0"/><cs:effectRef idx="0"/><cs:fontRef idx="minor"><a:schemeClr val="tx1"/>'
                   '</cs:fontRef><cs:defRPr sz="1000" b="1"/></cs:axisTitle></cs:chartStyle>' % (CS, A))
    color_style = (DECL + '<cs:colorStyle xmlns:cs="%s" xmlns:a="%s" meth="cycle" id="10">'
                   '<a:schemeClr val="accent1"/><a:schemeClr val="accent2"/><cs:variation/></cs:colorStyle>' % (CS, A))
    frame = ('<xdr:twoCellAnchor><xdr:from><xdr:col>3</xdr:col><xdr:colOff>0</xdr:colOff><xdr:row>0</xdr:row>'
             '<xdr:rowOff>0</xdr:rowOff></xdr:from><xdr:to><xdr:col>10</xdr:col><xdr:colOff>0</xdr:colOff>'
             '<xdr:row>15</xdr:row><xdr:rowOff>0</xdr:rowOff></xdr:to><xdr:graphicFrame macro="">'
             '<xdr:nvGraphicFramePr><xdr:cNvPr id="2" name="Chart 1"/><xdr:cNvGraphicFramePr/>'
             '</xdr:nvGraphicFramePr><xdr:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/></xdr:xfrm><a:graphic>'
             '<a:graphicData uri="%s"><c:chart xmlns:c="%s" xmlns:r="%s" r:id="rId1"/></a:graphicData>'
             '</a:graphic></xdr:graphicFrame><xdr:clientData/></xdr:twoCellAnchor>' % (C, C, REL))
    cells = "".join('<row r="%d"><c r="A%d"><v>%d</v></c><c r="B%d"><v>%d</v></c></row>'
                    % (r, r, d, r, v) for r, d, v in zip(range(1, 7), CATEGORIES, VALUES))
    drawing = DECL + '<xdr:wsDr xmlns:xdr="%s" xmlns:a="%s">%s</xdr:wsDr>' % (XDR, A, frame)
    parts = [
        ("[Content_Types].xml", DECL + '<Types xmlns="%s">'
         '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
         '<Default Extension="xml" ContentType="application/xml"/>'
         '<Override PartName="/xl/workbook.xml" ContentType="%s.spreadsheetml.sheet.main+xml"/>'
         '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="%s.spreadsheetml.worksheet+xml"/>'
         '<Override PartName="/xl/drawings/drawing1.xml" ContentType="%s.drawing+xml"/>'
         '<Override PartName="/xl/charts/chart1.xml" ContentType="%s.drawingml.chart+xml"/>'
         '<Override PartName="/xl/charts/style1.xml" ContentType="application/vnd.ms-office.chartstyle+xml"/>'
         '<Override PartName="/xl/charts/colors1.xml" ContentType="application/vnd.ms-office.chartcolorstyle+xml"/>'
         '</Types>' % (CT, VND, VND, VND, VND)),
        ("_rels/.rels", rels('<Relationship Id="rId1" Type="%s/officeDocument" Target="xl/workbook.xml"/>' % REL)),
        ("xl/workbook.xml", DECL + '<workbook xmlns="%s" xmlns:r="%s"><sheets>'
         '<sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets></workbook>' % (MAIN, REL)),
        ("xl/_rels/workbook.xml.rels", rels(
            '<Relationship Id="rId1" Type="%s/worksheet" Target="worksheets/sheet1.xml"/>' % REL)),
        ("xl/worksheets/sheet1.xml", DECL + '<worksheet xmlns="%s" xmlns:r="%s"><sheetData>%s</sheetData>'
         '<drawing r:id="rId1"/></worksheet>' % (MAIN, REL, cells)),
        ("xl/worksheets/_rels/sheet1.xml.rels", rels(
            '<Relationship Id="rId1" Type="%s/drawing" Target="../drawings/drawing1.xml"/>' % REL)),
        ("xl/drawings/drawing1.xml", drawing),
        ("xl/drawings/_rels/drawing1.xml.rels", rels(
            '<Relationship Id="rId1" Type="%s/chart" Target="../charts/chart1.xml"/>' % REL)),
        ("xl/charts/chart1.xml", chart),
        ("xl/charts/_rels/chart1.xml.rels", rels(
            '<Relationship Id="rId1" Type="%s/chartStyle" Target="style1.xml"/>'
            '<Relationship Id="rId2" Type="%s/chartColorStyle" Target="colors1.xml"/>' % (MSREL, MSREL))),
        ("xl/charts/style1.xml", chart_style),
        ("xl/charts/colors1.xml", color_style),
    ]
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as z:
        for name, text in parts:
            info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            info.compress_type = zipfile.ZIP_DEFLATED
            z.writestr(info, text.encode("utf-8"))
    data = buf.getvalue()
    digest = hashlib.sha256(data).hexdigest()
    ident = digest[:12]
    os.makedirs(os.path.join(sys.argv[1], "corpus"))
    with open(os.path.join(sys.argv[1], "corpus", ident + ".xlsx"), "wb") as f:
        f.write(data)
    row = [ident, digest, str(len(data)), "xlsx", "emend-run-log", "1", "zipfile", "generated", "fixture",
           "2026-10-21", "text-fixture.xlsx", "fictional"]
    with open(os.path.join(sys.argv[1], "manifest.tsv"), "w", encoding="utf-8", newline="\n") as f:
        f.write(MANIFEST_HEADER + "\n" + "\t".join(row) + "\n")
    print("%s\t%d\t%s" % (ident, len(data), digest))
    PY
    echo "command: python3 -I -B <work>/txfix.py <work>/fixcorpus; the program:"
    sed 's/^/    /' "$B/txfix.py"
    python3 -I -B "$B/txfix.py" "$B/fixcorpus" >"$B/txfix.out" 2>"$B/txfix.err" </dev/null
    fx_rc=$?
    FX_ID=$(cut -f1 "$B/txfix.out")
    FX_IN=$B/fixcorpus/corpus/$FX_ID.xlsx
    echo "  exit: $fx_rc; standard error $(wc -c <"$B/txfix.err") bytes; the fixture: id $FX_ID, $(cut -f2 "$B/txfix.out") bytes, sha256 $(cut -f3 "$B/txfix.out")"
    fx_written() { [ "$fx_rc" = 0 ] && [ ! -s "$B/txfix.err" ] && [ -s "$FX_IN" ] && [ "$(sha_of "$FX_IN")" = "$(cut -f3 "$B/txfix.out")" ]; }
    check "the fixture program exits 0, writes nothing to its standard error, and wrote the fixture it hashes" "$(yn fx_written)"
    # The forms check (change NYW): read with zipfile and ElementTree; the
    # style value through the root mc:AlternateContent (ruling B).
    cat >"$B/txcheck.py" <<'PY'
    """Checks the forms of the text fixture and of a text sample's output of it
    (specs/0041-chart-text-and-edits.md, "The chart part" and ruling B; the
    schema's orders, its "Facts"). Given the fixture alone, checks its own
    chart part: the chartSpace's children in the schema's order, the root
    mc:AlternateContent after roundedCorners holding c14:style 102 in its
    first Choice and c:style 2 in its Fallback; the title's rich text with
    a:pPr a:defRPr sz 1400 b 1 before the run and the run's a:rPr sz 1400 b 1;
    the dLbls's txPr before showLegendKey; the catAx's and the valAx's txPr
    after tickLblPos; the legend's after overlay; and the chart part's rels
    naming a chartStyle and a chartColorStyle part, each there with its root
    (cs:chartStyle, cs:colorStyle) and its Override. Given the fixture and an
    output, checks the fixture's chart part, its rels part and both style
    parts in the output byte for byte, the kept part's AlternateContent again
    (102 and 2), and the chart parts the output adds: three, a barChart, a
    lineChart and a pieChart; each txPr's parent and its preceding sibling
    printed, each placed by the schema's sequence (an axis's after
    tickLblPos, a legend's after overlay, a dLbls's after numFmt or first,
    before dLblPos or showLegendKey); six txPr and no style in the added
    parts; each title whose paragraph has a:pPr its a:defRPr before the run
    and the run's a:rPr with the same attributes and children. Given --axis
    and a comma-separated list of child names, judges that list by the axis
    rule (txPr after tickLblPos and before crossAx) and prints one line.
    Prints one "name: yes|no" line per check; no text of the workbook is
    printed."""
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    MC = "{http://schemas.openxmlformats.org/markup-compatibility/2006}"
    C14 = "{http://schemas.microsoft.com/office/drawing/2007/8/2/chart}"
    CNS = "{http://schemas.openxmlformats.org/drawingml/2006/chart}"
    FIX = "xl/charts/chart1.xml"
    KEPT = (FIX, "xl/charts/_rels/chart1.xml.rels", "xl/charts/style1.xml", "xl/charts/colors1.xml")
    
    
    def local(tag):
        return tag.rsplit("}", 1)[-1]
    
    
    def names(element):
        return [local(c.tag) for c in element]
    
    
    def ordered(got, order):
        at = 0
        for name in got:
            while at < len(order) and order[at] != name:
                at += 1
            if at == len(order):
                return False
        return True
    
    
    SPACE = ["date1904", "lang", "roundedCorners", "AlternateContent", "style", "clrMapOvr", "pivotSource",
             "protection", "chart", "spPr", "txPr", "externalData", "printSettings", "userShapes", "extLst"]
    AXIS_BEFORE = ("tickLblPos", "spPr")
    AXIS_AFTER = ("crossAx", "crosses", "crossesAt")
    
    
    def axis_ok(got):
        """The axis's txPr after tickLblPos (or spPr) and before crossAx."""
        if got.count("txPr") != 1:
            return False
        i = got.index("txPr")
        return i > 0 and got[i - 1] in AXIS_BEFORE and i + 1 < len(got) and got[i + 1] in AXIS_AFTER
    
    
    def place_ok(parent, got):
        i = got.index("txPr")
        before = got[i - 1] if i > 0 else None
        after = got[i + 1] if i + 1 < len(got) else None
        if parent in ("catAx", "valAx", "dateAx"):
            return axis_ok(got)
        if parent == "legend":
            return before in ("overlay", "spPr") and after in (None, "extLst")
        if parent == "dLbls":
            return before in (None, "numFmt", "spPr") and after in ("dLblPos", "showLegendKey")
        return False
    
    
    def chart_of(text):
        root = ET.fromstring(text)
        return root, [c for c in root if local(c.tag) == "chart"][0]
    
    
    def style_alternate(root):
        alt = [c for c in root if c.tag == MC + "AlternateContent"]
        if len(alt) != 1:
            return None
        choice = [c for c in alt[0] if c.tag == MC + "Choice"]
        fallback = [c for c in alt[0] if c.tag == MC + "Fallback"]
        if not choice or len(fallback) != 1:
            return None
        first = [c.get("val") for c in choice[0] if c.tag == C14 + "style"]
        back = [c.get("val") for c in fallback[0] if c.tag == CNS + "style"]
        return (first[0] if len(first) == 1 else None, back[0] if len(back) == 1 else None)
    
    
    def run_props(title):
        """The title's paragraph's defRPr and its run's rPr, as (attributes,
        children names), or None for a part without them."""
        paragraphs = [p for p in title.iter() if local(p.tag) == "p"]
        if len(paragraphs) != 1:
            return None
        p = paragraphs[0]
        kids = list(p)
        if not kids or local(kids[0].tag) != "pPr":
            return "bare"
        defr = [c for c in kids[0] if local(c.tag) == "defRPr"]
        runs = [c for c in kids if local(c.tag) == "r"]
        if len(defr) != 1 or len(runs) != 1 or kids.index(kids[0]) > kids.index(runs[0]):
            return None
        rpr = [c for c in runs[0] if local(c.tag) == "rPr"]
        if len(rpr) != 1 or names(runs[0])[0] != "rPr":
            return None
        return ((dict(defr[0].attrib), names(defr[0])), (dict(rpr[0].attrib), names(rpr[0])))
    
    
    if sys.argv[1:2] == ["--axis"]:
        got = sys.argv[2].split(",")
        print("the planted axis %s: %s" % (" ".join(got), "yes" if axis_ok(got) else "no"))
        sys.exit(0)
    checks = []
    z_in = zipfile.ZipFile(sys.argv[1])
    if len(sys.argv) == 2:
        root, chart = chart_of(z_in.read(FIX))
        checks.append(("the fixture's chartSpace children in the schema's order", ordered(names(root), SPACE)))
        checks.append(("its root mc:AlternateContent after roundedCorners",
                       names(root).index("AlternateContent") == names(root).index("roundedCorners") + 1))
        checks.append(("its first Choice holds c14:style 102 and its Fallback c:style 2",
                       style_alternate(root) == ("102", "2")))
        titles = [c for c in chart if local(c.tag) == "title"]
        props = run_props(titles[0]) if len(titles) == 1 else None
        checks.append(("its title's a:pPr a:defRPr sz 1400 b 1 before the run, the run's a:rPr sz 1400 b 1",
                       isinstance(props, tuple) and props[0][0] == {"sz": "1400", "b": "1"}
                       and props[1][0].get("sz") == "1400" and props[1][0].get("b") == "1"))
        found = {}
        for parent in chart.iter():
            if "txPr" in names(parent):
                found.setdefault(local(parent.tag), []).append(names(parent))
        for parent in ("dLbls", "catAx", "valAx", "legend"):
            got = found.get(parent, [])
            checks.append(("its %s's txPr in its place" % parent, len(got) == 1 and place_ok(parent, got[0])))
        rels = ET.fromstring(z_in.read("xl/charts/_rels/chart1.xml.rels"))
        types = sorted((r.get("Type").rsplit("/", 1)[-1], r.get("Target")) for r in rels)
        ct = z_in.read("[Content_Types].xml").decode()
        style_root = local(ET.fromstring(z_in.read("xl/charts/style1.xml")).tag)
        color_root = local(ET.fromstring(z_in.read("xl/charts/colors1.xml")).tag)
        checks.append(("its rels name a chartStyle part and a chartColorStyle part, each there with its root and Override",
                       types == [("chartColorStyle", "colors1.xml"), ("chartStyle", "style1.xml")]
                       and style_root == "chartStyle" and color_root == "colorStyle"
                       and 'PartName="/xl/charts/style1.xml" ContentType="application/vnd.ms-office.chartstyle+xml"' in ct
                       and 'PartName="/xl/charts/colors1.xml" ContentType="application/vnd.ms-office.chartcolorstyle+xml"' in ct))
    else:
        z = zipfile.ZipFile(sys.argv[2])
        for name in KEPT:
            checks.append(("the output's %s is the fixture's, byte for byte" % name,
                           name in z.namelist() and z.read(name) == z_in.read(name)))
        root, _ = chart_of(z.read(FIX))
        checks.append(("in the output's kept chart part, the first Choice holds c14:style 102 and the Fallback c:style 2",
                       style_alternate(root) == ("102", "2")))
        added = sorted(n for n in z.namelist()
                       if n.startswith("xl/charts/chart") and n.endswith(".xml") and n not in z_in.namelist())
        checks.append(("the output adds three chart parts", len(added) == 3))
        kinds, n_text, n_style, placed, titled = [], 0, 0, [], []
        for name in added:
            root, chart = chart_of(z.read(name))
            area = [c for c in chart if local(c.tag) == "plotArea"][0]
            kinds += [local(c.tag) for c in area if local(c.tag).endswith("Chart")]
            n_style += sum(1 for e in root.iter() if local(e.tag) == "style")
            for parent in root.iter():
                got = names(parent)
                for i, n in enumerate(got):
                    if n == "txPr":
                        n_text += 1
                        before = got[i - 1] if i > 0 else "(first)"
                        print("txPr in %s after %s: %s" % (local(parent.tag), before,
                                                          "in its place" if place_ok(local(parent.tag), got) else "OUT OF PLACE"))
                        placed.append(place_ok(local(parent.tag), got))
            for title in chart.iter():
                if local(title.tag) != "title":
                    continue
                props = run_props(title)
                if props == "bare":
                    continue
                titled.append(isinstance(props, tuple) and props[0] == props[1])
        print("added plots %s; txPr %d; style %d; titles with text properties %d" % (" ".join(kinds), n_text, n_style, len(titled)))
        checks.append(("a barChart, a lineChart and a pieChart among them", sorted(kinds) == ["barChart", "lineChart", "pieChart"]))
        checks.append(("each txPr in its place by the schema's sequence", bool(placed) and all(placed)))
        checks.append(("six txPr and no style in the added parts", n_text == 6 and n_style == 0))
        checks.append(("four titles with text properties, each run's a:rPr the a:defRPr's attributes and children",
                       len(titled) == 4 and all(titled)))
    for name, good in checks:
        print("%s: %s" % (name, "yes" if good else "no"))
    PY
    sed 's/^/    /' "$B/txcheck.py"
    echo "command: python3 -I -B <work>/txcheck.py <work>/fixcorpus/corpus/$FX_ID.xlsx (the fixture's own forms, before the text sample)"
    python3 -I -B "$B/txcheck.py" "$FX_IN" >"$B/txcheck-in.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/txcheck-in.out"
    tx_in_all() { [ "$(count_matches -E ': yes$' "$B/txcheck-in.out")" = 9 ] && [ "$(count_matches -E ': no$' "$B/txcheck-in.out")" = 0 ]; }
    check "fixture: its own forms' nine checks hold (the chartSpace's order, the mc:AlternateContent after roundedCorners with c14:style 102 and the fallback c:style 2, the title's defRPr and rPr, the four txPr in their places, the two style parts reached from the rels; ruling B; change NYW)" "$(yn tx_in_all)"
    echo "command: python3 -I -B <work>/txcheck.py --axis tickLblPos,txPr,crossAx; and --axis txPr,tickLblPos,crossAx (the control: the txPr before tickLblPos)"
    python3 -I -B "$B/txcheck.py" --axis tickLblPos,txPr,crossAx >"$B/txaxis-good.out" 2>&1
    python3 -I -B "$B/txcheck.py" --axis txPr,tickLblPos,crossAx >"$B/txaxis-bad.out" 2>&1
    sed 's/^/    /' "$B/txaxis-good.out" "$B/txaxis-bad.out"
    check "the axis rule accepts a planted axis whose txPr follows tickLblPos" "$(yn [ "$(count_matches -E ': yes$' "$B/txaxis-good.out")" = 1 ])"
    check "control: the same rule refuses a planted axis whose txPr precedes tickLblPos (change NYW)" "$(yn [ "$(count_matches -E ': no$' "$B/txaxis-bad.out")" = 1 ])"
    # The fixture runs: each sample on each target into its own directory under
    # <work>; the charts sample's line read for its keys, the text and edit
    # samples' by the corpus rules (change NZB).
    for FS in charts chart-text chart-edit; do
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      FO=$B/fixrun-$FS
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --corpus <work>/fixcorpus --out <work>/fixrun-$FS --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg --$FS-sample"
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --corpus "$B/fixcorpus" --out "$FO" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "--$FS-sample" \
        >"$B/fix-$FS-$label.stdout" 2>"$B/fix-$FS-$label.stderr" </dev/null
      frc=$?
      echo "  exit $frc; stderr bytes: $(wc -c <"$B/fix-$FS-$label.stderr")"
      sed 's/^/    /' "$B/fix-$FS-$label.stdout"
      FSUM=$FO/summary.$label.tsv
      fix_row_ok() { [ "$frc" = 0 ] && [ ! -s "$B/fix-$FS-$label.stderr" ] && [ "$(awk 'NR > 1' "$FSUM" | wc -l)" = 1 ] \
        && [ "$(count_where "$FSUM" outcome ok)" = 1 ] && [ "$(count_where "$FSUM" lo ok)" = 1 ] \
        && [ "$(count_where "$FSUM" lo_in ok)" = 1 ] && [ "$(count_where "$FSUM" leftover no)" = 1 ]; }
      check "fixture $FS $label: the run exits 0 with an empty stderr, its one row ok, the input and the output opening in LibreOffice (lo_in and lo ok), nothing left over" "$(yn fix_row_ok)"
      e=$(cat "$FO/$FX_ID/stdout.$label.txt")
      printf '%s\n' "$e" >"$B/fixline-$FS-$label"
      echo "  the line: $(printf '%s' "$e" | tr '\t' ' ')"
    done
    check "fixture $FS: both targets printed the same line" "$(yn cmp -s "$B/fixline-$FS-host" "$B/fixline-$FS-i686")"
    check "fixture $FS: the output is the same on both targets, byte for byte" "$(yn cmp -s "$FO/$FX_ID/out.host.xlsx" "$FO/$FX_ID/out.i686.xlsx")"
    done
    FL=$(cat "$B/fixline-charts-host")
    fix_charts_ok() { [ "$(printf '%s\n' "$FL" | cut -f1)" = charts ] && [ "$(kv "$FL" sheets)" = 1 ] && [ "$(kv "$FL" charts)" = 1 ] \
      && [ "$(kv "$FL" plots)" = 1 ] && [ "$(kv "$FL" kind_bar)" = 1 ] && [ "$(kv "$FL" series)" = 1 ] && [ "$(kv "$FL" combined)" = 0 ] \
      && [ "$(kv "$FL" labels)" = 1 ] && [ "$(kv "$FL" titles)" = 1 ] && [ "$(kv "$FL" axes)" = 2 ] && [ "$(kv "$FL" axis_cat)" = 1 ] \
      && [ "$(kv "$FL" axis_val)" = 1 ] && [ "$(kv "$FL" legends)" = 1 ] && [ "$(kv "$FL" styles)" = 1 ]; }
    check "fixture charts: the line reads the chart (sheets 1; charts 1; plots 1, kind_bar 1; series 1, its labels 1; combined 0; titles 1; axes 2, axis_cat 1 and axis_val 1; legends 1; styles 1, the style read through the mc:AlternateContent's first Choice: ruling B)" "$(yn fix_charts_ok)"
    fix_charts_ctl() { local FL; FL=$(printf '%s' "$(cat "$B/fixline-charts-host")" | sed 's/\tseries=1\t/\tseries=2\t/'); fix_charts_ok; }
    check "control: the same check refuses the line with series 2" "$(ynnot fix_charts_ctl)"
    fix_charts_ctl2() { local FL; FL=$(printf '%s' "$(cat "$B/fixline-charts-host")" | sed 's/\tstyles=1\t/\tstyles=0\t/'); fix_charts_ok; }
    check "control: the same check refuses the line with no style read (styles 0; ruling B)" "$(ynnot fix_charts_ctl2)"
    FE=$B/fixrun-charts/entries.host.tsv
    n_fix_rows=$(awk 'NR > 1' "$FE" | wc -l)
    echo "  the charts sample's entry rows: $n_fix_rows; identical and unflagged: $(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] == "identical" && $k["flags"] == ""' "$FE" | wc -l)"
    fix_same() { [ "$n_fix_rows" = 12 ] && [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] == "identical" && $k["flags"] == ""' "$FE" | wc -l)" = 12 ]; }
    check "fixture charts: the input written back unedited, each of its twelve entries identical and unflagged" "$(yn fix_same)"
    TL=$(cat "$B/fixline-chart-text-host")
    SE=$B/fixrun-chart-text/entries.host.tsv
    check "fixture chart-text: the line is what the spec reads (change NYV's rule)" "$(yn text_line_ok "$TL")"
    fix_text_counts() { [ "$(kv "$TL" charts_before)" = 1 ] && [ "$(kv "$TL" charts_after)" = 4 ] && [ "$(kv "$TL" rows)" = 6 ] && [ "$(kv "$TL" texts)" = 6 ] && [ "$(kv "$TL" styles)" = 0 ]; }
    check "fixture chart-text: charts_before 1, charts_after 4: three added beside the fixture's one; rows 6; texts 6 and styles 0 in the three added parts" "$(yn fix_text_counts)"
    check "fixture chart-text: the drawing is appended to, not created (surface_made 0)" "$(yn [ "$(surface_made "$SE" "$FX_ID")" = 0 ])"
    check "fixture chart-text: the entry rows are as the corpus rule gives for a drawing appended to" "$(yn text_named "$SE" "$FX_ID" 0)"
    fix_kept() {
      local p
      for p in xl/charts/chart1.xml xl/charts/_rels/chart1.xml.rels xl/charts/style1.xml xl/charts/colors1.xml xl/worksheets/sheet1.xml; do
        [ "$(awk -F'\t' -v id="$FX_ID" -v p="$p" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id && $k["name"] == p { print $k["status"] "/" $k["flags"] }' "$SE")" = "identical/" ] || return 1
      done
    }
    check "fixture chart-text: the fixture's chart part, its rels part, both style parts and its worksheet are identical and unflagged (ruling B)" "$(yn fix_kept)"
    echo "command: python3 -I -B <work>/txcheck.py <work>/fixcorpus/corpus/$FX_ID.xlsx <work>/fixrun-chart-text/$FX_ID/out.host.xlsx (after the text sample); and over the fixture against itself (the control)"
    python3 -I -B "$B/txcheck.py" "$FX_IN" "$B/fixrun-chart-text/$FX_ID/out.host.xlsx" >"$B/txcheck.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/txcheck.out"
    tx_all() { [ "$(count_matches -E ': yes$' "$B/txcheck.out")" = 10 ] && [ "$(count_matches -E ': no$' "$B/txcheck.out")" = 0 ] && [ "$(count_matches -xF 'added plots barChart lineChart pieChart; txPr 6; style 0; titles with text properties 4' "$B/txcheck.out")" = 1 ] && [ "$(count_matches -F 'OUT OF PLACE' "$B/txcheck.out")" = 0 ]; }
    check "fixture chart-text: the forms' ten checks hold (the fixture's chart part, its rels and both style parts kept byte for byte, its c14:style 102 and fallback c:style 2 after the text sample, three parts added, a column, a line and a pie, each txPr in its place, six txPr and no style, four titles whose run's rPr is its defRPr; ruling B; change NYW)" "$(yn tx_all)"
    python3 -I -B "$B/txcheck.py" "$FX_IN" "$FX_IN" >"$B/c-txcheck.out" 2>&1
    echo "  over the fixture against itself, which adds nothing: $(count_matches -E ': no$' "$B/c-txcheck.out") checks no"
    tx_ctl() { [ "$(count_matches -E ': no$' "$B/c-txcheck.out")" -ge 3 ]; }
    check "control: the same check finds no added part, plot or txPr in the fixture against itself" "$(yn tx_ctl)"
    # Change NZB: the edit sample on the fixture (specs/0041 "Harness runs",
    # the first fixture: --chart-edit-sample edits it in place, kept_edited 1;
    # ruling E, Q7).
    DL=$(cat "$B/fixline-chart-edit-host")
    DE=$B/fixrun-chart-edit/entries.host.tsv
    check "fixture chart-edit: the line is what the spec reads (change NYZ's rule)" "$(yn edit_line_ok "$DL")"
    fix_edit_counts() { [ "$(kv "$DL" charts)" = 2 ] && [ "$(kv "$DL" kept_edited)" = 1 ] && [ "$(kv "$DL" rows)" = 6 ]; }
    check "fixture chart-edit: charts 2, the fixture's one and the first write's; kept_edited 1; rows 6 (change NZB)" "$(yn fix_edit_counts)"
    check "fixture chart-edit: the drawing is appended to, not created (surface_made 0)" "$(yn [ "$(surface_made "$DE" "$FX_ID")" = 0 ])"
    check "fixture chart-edit: the entry rows are as the corpus rule gives for a drawing appended to, the kept chart's part changed (change NYZ)" "$(yn edit_named "$DE" "$FX_ID" 0 1)"
    # fix_row <entries> <part>: the fixture's row for the part, "status/flags".
    fix_row() { awk -F'\t' -v id="$FX_ID" -v p="$2" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id && $k["name"] == p { print $k["status"] "/" $k["flags"] }' "$1"; }
    fix_edit_rows() {
      local p
      [ "$(fix_row "$DE" xl/charts/chart1.xml | cut -d/ -f1)" = changed ] || return 1
      for p in xl/charts/_rels/chart1.xml.rels xl/charts/style1.xml xl/charts/colors1.xml xl/worksheets/sheet1.xml; do
        [ "$(fix_row "$DE" "$p")" = identical/ ] || return 1
      done
    }
    check "fixture chart-edit: the fixture's chart part changed; its rels part, both style parts and its worksheet identical and unflagged (change NZB)" "$(yn fix_edit_rows)"
    fix_edit_rows_ctl() { local DE=$SE; fix_edit_rows; }
    check "control: the same check refuses the text sample's rows, where the chart part is kept" "$(ynnot fix_edit_rows_ctl)"
    # The edited part, by bytes and with ElementTree (ruling E, Q7; change
    # NZB).
    cat >"$B/edcheck.py" <<'PY'
    """Checks an edit sample's output of a fixture holding one chart
    (specs/0041-chart-text-and-edits.md, "The chart part", ruling E): the
    kept chart part xl/charts/chart1.xml, the fixture's first chart, retitled
    in place, and the one chart part the output adds, edited in place after
    its first write.
    
    Usage: python3 -I -B edcheck.py <fixture> <output> <old title> <new title>
    
    Checks, one "name: yes|no" line each:
     1. the fixture's kept part holds its title's run text, <a:t> and the old
        title, exactly once;
     2. the output's kept part is the fixture's with that run text alone
        replaced by the new title, byte for byte (Q7: bodyPr, lstStyle, the
        paragraph's pPr and the run's rPr kept);
     3. the kept part's txPr elements, by ElementTree, are as many as the
        fixture's, at least one;
     4. its style, a root c:style's val or a root mc:AlternateContent's first
        Choice's c14:style and its Fallback's c:style, is the fixture's;
     5. its title's first paragraph's pPr and its first run's rPr, tag,
        attributes and children, are the fixture's (none where it has none);
     6. its title reads the new title (every run's t of the first paragraph);
     7. each part the kept part's rels part names, and that rels part, where
        the fixture has one, byte for byte the fixture's (the count printed);
     8. the output adds exactly one chart part, a barChart;
     9. whose title reads emend edited, its one series' name a strRef and its
        categories and values each a strRef or numRef holding f alone, no
        cache (strCache or numCache) anywhere in the part.
    Prints nothing of the workbook but the counts named."""
    import re
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    KEPT = "xl/charts/chart1.xml"
    RELS = "xl/charts/_rels/chart1.xml.rels"
    MC = "{http://schemas.openxmlformats.org/markup-compatibility/2006}"
    
    
    def local(tag):
        return tag.rsplit("}", 1)[-1]
    
    
    def kid(element, name):
        if element is None:
            return None
        found = [c for c in element if local(c.tag) == name]
        return found[0] if found else None
    
    
    def every(element, name):
        return [e for e in element.iter() if local(e.tag) == name]
    
    
    def style_of(root):
        """The root's style, as (form, values)."""
        plain = kid(root, "style")
        if plain is not None:
            return ("plain", plain.get("val"))
        for alt in (c for c in root if c.tag == MC + "AlternateContent"):
            choice = kid(alt, "Choice")
            fallback = kid(alt, "Fallback")
            return ("alternate", kid(choice, "style").get("val") if kid(choice, "style") is not None else None,
                    kid(fallback, "style").get("val") if kid(fallback, "style") is not None else None)
        return ("none",)
    
    
    def shape(element):
        """An element's tag, attributes and children, recursively."""
        if element is None:
            return None
        return (local(element.tag), sorted(element.attrib.items()), [shape(c) for c in element])
    
    
    def title_parts(root):
        """The title's first paragraph's pPr, its first run's rPr, and its
        text."""
        rich = kid(kid(kid(kid(root, "chart"), "title"), "tx"), "rich")
        paragraph = kid(rich, "p")
        run = kid(paragraph, "r")
        text = "".join(t.text or "" for r in (paragraph if paragraph is not None else []) if local(r.tag) == "r"
                       for t in r if local(t.tag) == "t")
        return shape(kid(paragraph, "pPr")), shape(kid(run, "rPr")), text if paragraph is not None else None
    
    
    def main():
        fixture, output, old, new = sys.argv[1:5]
        a, b = zipfile.ZipFile(fixture), zipfile.ZipFile(output)
        names_a, names_b = set(a.namelist()), set(b.namelist())
        x = a.read(KEPT) if KEPT in names_a else b""
        y = b.read(KEPT) if KEPT in names_b else b""
        old_run = ("<a:t>%s</a:t>" % old).encode()
        new_run = ("<a:t>%s</a:t>" % new).encode()
        checks = []
        checks.append(("the fixture's kept chart part holds its title's run text once", x.count(old_run) == 1))
        checks.append(("the output's kept chart part is the fixture's with that run text alone replaced, byte for byte",
                       x.count(old_run) == 1 and y == x.replace(old_run, new_run)))
        ra = ET.fromstring(x) if x else None
        rb = ET.fromstring(y) if y else None
        txa = len(every(ra, "txPr")) if ra is not None else -1
        txb = len(every(rb, "txPr")) if rb is not None else -2
        print("the kept part's txPr: the fixture's %d; the output's %d" % (txa, txb))
        checks.append(("its txPr as many as the fixture's, at least one", txa == txb and txa >= 1))
        checks.append(("its style the fixture's", ra is not None and rb is not None and style_of(ra) == style_of(rb)
                       and style_of(ra) != ("none",)))
        ta = title_parts(ra) if ra is not None else (None, None, None)
        tb = title_parts(rb) if rb is not None else (None, None, 0)
        checks.append(("its title's first paragraph's pPr and first run's rPr the fixture's", ta[0] == tb[0] and ta[1] == tb[1]))
        checks.append(("its title reads the new title", tb[2] == new))
        kept = [RELS] if RELS in names_a else []
        if RELS in names_a:
            rels = ET.fromstring(a.read(RELS))
            for rel in rels:
                target = rel.get("Target", "")
                if rel.get("TargetMode") != "External" and not target.startswith("/"):
                    kept.append("xl/charts/" + target)
        same = sum(1 for n in kept if n in names_b and a.read(n) == b.read(n))
        print("the kept part's rels part and the parts it names: %d; byte for byte the fixture's: %d" % (len(kept), same))
        checks.append(("its rels part and the parts it names byte for byte the fixture's", same == len(kept)))
        added = sorted(n for n in names_b - names_a if re.match(r"xl/charts/chart[0-9]+\.xml$", n))
        root = ET.fromstring(b.read(added[0])) if len(added) == 1 else None
        area = kid(kid(root, "chart"), "plotArea")
        checks.append(("the output adds one chart part, a barChart", len(added) == 1 and kid(area, "barChart") is not None))
        ser = kid(kid(area, "barChart"), "ser")
    
        def ref_alone(element, forms):
            if element is None or len(element) != 1 or local(element[0].tag) not in forms:
                return False
            return [local(c.tag) for c in element[0]] == ["f"]
    
        edited = (root is not None and title_parts(root)[2] == "emend edited"
                  and ref_alone(kid(ser, "tx"), ("strRef",))
                  and ref_alone(kid(ser, "cat"), ("strRef", "numRef"))
                  and ref_alone(kid(ser, "val"), ("numRef",))
                  and not every(root, "strCache") and not every(root, "numCache"))
        checks.append(("its title reads emend edited, its series' name, categories and values each f alone, no cache", edited))
        for name, good in checks:
            print("%s: %s" % (name, "yes" if good else "no"))
    
    
    main()
    PY
    echo "command: python3 -I -B <work>/edcheck.py <work>/fixcorpus/corpus/$FX_ID.xlsx <work>/fixrun-chart-edit/$FX_ID/out.host.xlsx 'Fixture title' 'emend kept'; and over the fixture against itself (the control); the program:"
    sed 's/^/    /' "$B/edcheck.py"
    python3 -I -B "$B/edcheck.py" "$FX_IN" "$B/fixrun-chart-edit/$FX_ID/out.host.xlsx" "Fixture title" "emend kept" >"$B/edcheck.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/edcheck.out"
    ed_all() { [ "$(count_matches -E ': yes$' "$B/edcheck.out")" = 9 ] && [ "$(count_matches -E ': no$' "$B/edcheck.out")" = 0 ]; }
    check "fixture chart-edit: the edit's nine checks hold (the fixture's chart part with its title's first run's t alone replaced, byte for byte; its four txPr, its c14:style 102 and fallback c:style 2, its title's pPr defRPr and run rPr the fixture's; its rels part and both style parts byte for byte; the title reading emend kept; one chart part added, a barChart titled emend edited whose series' name, categories and values hold f alone, no cache; ruling E; change NZB)" "$(yn ed_all)"
    python3 -I -B "$B/edcheck.py" "$FX_IN" "$FX_IN" "Fixture title" "emend kept" >"$B/c-edcheck.out" 2>&1
    echo "  over the fixture against itself, which edits nothing: $(count_matches -E ': no$' "$B/c-edcheck.out") checks no"
    ed_ctl() { [ "$(count_matches -E ': no$' "$B/c-edcheck.out")" = 4 ]; }
    check "control: the same check finds no edit and no added chart in the fixture against itself (four checks no: the bytes, the title, the part added, its edit)" "$(yn ed_ctl)"
    # Change NZE: the edit sample's style form on the fixture (ruling G), and
    # the planted copies the program must refuse: the added part's style
    # removed, the style before roundedCorners, and the kept part's c14:style
    # changed.
    printf '%s\txlsx\n' "$FX_ID" >"$B/fix-order"
    echo "command: python3 -I -B <work>/stcheck.py <work>/fixrun-chart-edit host <work>/fixcorpus <work>/fix-order"
    python3 -I -B "$B/stcheck.py" "$B/fixrun-chart-edit" host "$B/fixcorpus" "$B/fix-order" >"$B/fix-stcheck.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/fix-stcheck.out"
    check "fixture chart-edit: the added chart part holds one c:style val 26 after roundedCorners, and the kept part keeps its mc:AlternateContent style (ruling G; change NZE)" "$(yn st_ok "$B/fix-stcheck.out" 1 1)"
    cat >"$B/stplant.py" <<'PY'
    """Writes a copy of an output with one planted change: "nostyle" removes
    the c:style of val 26 from every chart part, "before" moves it before
    roundedCorners, "kept" changes xl/charts/chart1.xml's c14:style val 102 to
    103."""
    import sys
    import zipfile
    
    sys.dont_write_bytecode = True
    src, dst, mode = sys.argv[1:4]
    STYLE = b'<c:style val="26"/>'
    CORNERS = b'<c:roundedCorners val="0"/>'
    with zipfile.ZipFile(src) as a, zipfile.ZipFile(dst, "w", zipfile.ZIP_DEFLATED) as b:
        for info in a.infolist():
            data = a.read(info.filename)
            if info.filename.startswith("xl/charts/chart"):
                if mode == "nostyle":
                    data = data.replace(STYLE, b"")
                elif mode == "before":
                    data = data.replace(CORNERS + STYLE, STYLE + CORNERS)
                elif mode == "kept" and info.filename == "xl/charts/chart1.xml":
                    data = data.replace(b'<c14:style val="102"/>', b'<c14:style val="103"/>')
            b.writestr(info, data)
    PY
    echo "command: python3 -I -B <work>/stplant.py <the edit output> <the planted copy> MODE, for MODE nostyle, before and kept, each copy in its own run directory <work>/c-st-nostyle, <work>/c-st-before and <work>/c-st-kept; stcheck.py over each; the program:"
    sed 's/^/    /' "$B/stplant.py"
    for mode in nostyle before kept; do
      mkdir -p "$B/c-st-$mode/$FX_ID"
      cp "$B/fixrun-chart-edit/entries.host.tsv" "$B/c-st-$mode/"
      python3 -I -B "$B/stplant.py" "$B/fixrun-chart-edit/$FX_ID/out.host.xlsx" "$B/c-st-$mode/$FX_ID/out.host.xlsx" "$mode"
      python3 -I -B "$B/stcheck.py" "$B/c-st-$mode" host "$B/fixcorpus" "$B/fix-order" >"$B/c-st-$mode.out" 2>&1
      echo "  $mode: $(tail -n 1 "$B/c-st-$mode.out")"
    done
    st_ctl() {
      [ "$(tail -n 1 "$B/c-st-nostyle.out")" = "workbooks 1; whose added chart part holds one style 26 after roundedCorners 0; kept chart parts 1, their style the input's 1" ] &&
        [ "$(tail -n 1 "$B/c-st-before.out")" = "workbooks 1; whose added chart part holds one style 26 after roundedCorners 0; kept chart parts 1, their style the input's 1" ] &&
        [ "$(tail -n 1 "$B/c-st-kept.out")" = "workbooks 1; whose added chart part holds one style 26 after roundedCorners 1; kept chart parts 1, their style the input's 0" ]
    }
    check "control: the same check refuses the added part with no style and with the style before roundedCorners, and the kept part whose style changed" "$(yn st_ctl)"
    n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
    check "fixture: the runs' TMPDIR is empty after the runs" "$(yn [ "$n_left" = 0 ])"
    
    echo
    echo "## the openpyxl fixture: written by the pinned image, --charts-sample, --chart-text-sample and --chart-edit-sample on it through the runner, both targets (specs/0041 \"Harness runs\", the second fixture; part 3 P2's change NYL, its image block; change NZC)"
    OPX_IMAGE=localhost/emend-openpyxl:3.1.5-dfsg-2-deb13
    OPX_REC=records/openpyxl-image-2026-10-16.md
    echo "plan (printed before any container of this block runs): one rootless podman run of $OPX_IMAGE, an image already built (no pull, no build, no install), with --network=none and --userns=keep-id, tests/fixtures/openpyxl-ops.xlsx and scripts/openpyxl-ops.py mounted read-only from <repo>, <work>/opx the one writable mount; then the runner over its output under <work>, as for the corpus; nothing needs elevation"
    uid_now=$(id -u)
    rootless_now=$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null)
    echo "command: id -u; podman info --format '{{.Host.Security.Rootless}}'"
    echo "  uid $uid_now; rootless ${rootless_now:-none}"
    not_root() { [ "$uid_now" != 0 ]; }
    check "this script runs as an account other than root (change NZC)" "$(yn not_root)"
    not_root_ctl() { local uid_now=0; not_root; }
    check "control: the same check refuses uid 0" "$(ynnot not_root_ctl)"
    is_rootless() { [ "$rootless_now" = true ]; }
    check "podman runs rootless (change NZC)" "$(yn is_rootless)"
    echo "command: podman image exists $OPX_IMAGE"
    check "the pinned openpyxl image is there" "$(yn podman image exists "$OPX_IMAGE")"
    rec_id=$(git show "$C:$OPX_REC" | sed -n 's/^| Image id | `\([0-9a-f]\{64\}\)` |$/\1/p')
    img_id=$(podman image inspect --format '{{.Id}}' "$OPX_IMAGE" 2>/dev/null | sed 's/^sha256://')
    lo_id=$(podman image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null | sed 's/^sha256://')
    echo "command: git show <phase commit>:$OPX_REC, its Image id row; podman image inspect --format '{{.Id}}' $OPX_IMAGE"
    echo "  the record's image id: ${rec_id:-none}; the image's: ${img_id:-none}"
    id_ok() { printf '%s' "$rec_id" | LC_ALL=C "$G" -qxE '[0-9a-f]{64}' && [ "$img_id" = "$rec_id" ]; }
    check "the openpyxl image's id is the one $OPX_REC records (change NZC)" "$(yn id_ok)"
    id_ctl() { local img_id=$lo_id; id_ok; }
    check "control: the same check refuses the LibreOffice image's id" "$(ynnot id_ctl)"
    mkdir "$B/opx" || exit 2
    OPX_OUT=$B/opx/chart-text.xlsx
    echo "command: podman run --rm --network=none --userns=keep-id -v <repo>/tests/fixtures/openpyxl-ops.xlsx:/in/fixture.xlsx:ro -v <work>/opx:/out -v <repo>/scripts/openpyxl-ops.py:/ops.py:ro $OPX_IMAGE python3 -I -B /ops.py chart-text /in/fixture.xlsx /out/chart-text.xlsx"
    podman run --rm --network=none --userns=keep-id \
      -v "$MAIN/tests/fixtures/openpyxl-ops.xlsx":/in/fixture.xlsx:ro -v "$B/opx":/out -v "$MAIN/scripts/openpyxl-ops.py":/ops.py:ro "$OPX_IMAGE" \
      python3 -I -B /ops.py chart-text /in/fixture.xlsx /out/chart-text.xlsx </dev/null >"$B/opx.stdout" 2>"$B/opx.stderr"
    opx_rc=$?
    echo "  exit $opx_rc; standard error $(wc -c <"$B/opx.stderr") bytes; standard output:"
    sed 's/^/    /' "$B/opx.stdout"
    opx_ok() {
      [ "$opx_rc" = 0 ] && [ ! -s "$B/opx.stderr" ] && [ "$(count_lines "$B/opx.stdout")" = 1 ] || return 1
      LC_ALL=C "$G" -qE "^openpyxl=3[.]1[.]5${TAB}peak_rss_kb=[1-9][0-9]*\$" "$B/opx.stdout" && [ -s "$OPX_OUT" ]
    }
    check "the op exits 0 with nothing on standard error, its one line openpyxl 3.1.5 and a peak RSS, and writes its output (change NZC)" "$(yn opx_ok)"
    echo "  the output: $(stat -c %s "$OPX_OUT" 2>/dev/null) bytes, sha256 $(sha_of "$OPX_OUT" 2>/dev/null)"
    # The op's own forms, read with zipfile and ElementTree by local name
    # (openpyxl writes the chart namespace as the default one; the plain
    # c:style val 26 read here, ruling B; change NZC).
    cat >"$B/ctcheck.py" <<'PY'
    """Checks what openpyxl's chart-text op wrote into <workbook>
    (scripts/openpyxl-ops.py's constants; specs/0041 "Harness runs", the
    openpyxl fixture, and ruling B): one chart part, a barChart; the root's
    style a plain c:style of val 26, no mc:AlternateContent; the title's run
    reading emend text; the category axis's txPr whose defRPr has sz 1400, b
    1 and a latin child of typeface Arial; the data labels' txPr whose
    defRPr has sz 900, the labels showing the values (showVal 1). Read with
    zipfile and ElementTree by local name (openpyxl writes the chart
    namespace as the default one). Prints one "name: yes|no" line per check;
    nothing else of the workbook."""
    import re
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    MC = "{http://schemas.openxmlformats.org/markup-compatibility/2006}"
    
    
    def local(tag):
        return tag.rsplit("}", 1)[-1]
    
    
    def kid(element, name):
        if element is None:
            return None
        found = [c for c in element if local(c.tag) == name]
        return found[0] if found else None
    
    
    def defrpr(txpr):
        return kid(kid(kid(txpr, "p"), "pPr"), "defRPr")
    
    
    z = zipfile.ZipFile(sys.argv[1])
    names = sorted(n for n in z.namelist() if re.match(r"xl/charts/chart[0-9]+\.xml$", n))
    root = ET.fromstring(z.read(names[0])) if len(names) == 1 else None
    chart = kid(root, "chart")
    area = kid(chart, "plotArea")
    bar = kid(area, "barChart")
    style = kid(root, "style")
    alternate = [c for c in root if c.tag == MC + "AlternateContent"] if root is not None else []
    title = kid(kid(kid(chart, "title"), "tx"), "rich")
    runs = [t.text for p in (title if title is not None else []) if local(p.tag) == "p"
            for r in p if local(r.tag) == "r" for t in r if local(t.tag) == "t"]
    axis = defrpr(kid(kid(area, "catAx"), "txPr"))
    latin = kid(axis, "latin")
    labels = kid(bar, "dLbls")
    label_rpr = defrpr(kid(labels, "txPr"))
    checks = [
        ("one chart part, a barChart", root is not None and bar is not None),
        ("the root's style a plain c:style of val 26, no mc:AlternateContent",
         style is not None and style.get("val") == "26" and not alternate),
        ("the title's run reads emend text", runs == ["emend text"]),
        ("the category axis's txPr: defRPr sz 1400, b 1, latin typeface Arial",
         axis is not None and axis.get("sz") == "1400" and axis.get("b") == "1"
         and latin is not None and latin.get("typeface") == "Arial"),
        ("the data labels' txPr: defRPr sz 900, showVal 1",
         label_rpr is not None and label_rpr.get("sz") == "900" and kid(labels, "showVal") is not None
         and kid(labels, "showVal").get("val") == "1"),
    ]
    for name, good in checks:
        print("%s: %s" % (name, "yes" if good else "no"))
    PY
    echo "command: python3 -I -B <work>/ctcheck.py <work>/opx/chart-text.xlsx; and over the committed fixture tests/fixtures/openpyxl-ops.xlsx (the control); the program:"
    sed 's/^/    /' "$B/ctcheck.py"
    python3 -I -B "$B/ctcheck.py" "$OPX_OUT" >"$B/ctcheck.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/ctcheck.out"
    ct_all() { [ "$(count_matches -E ': yes$' "$B/ctcheck.out")" = 5 ] && [ "$(count_matches -E ': no$' "$B/ctcheck.out")" = 0 ]; }
    check "fixture: the op's output holds its bar chart with the op's constants: the plain c:style val 26 (ruling B), the title emend text, the category axis's txPr of sz 1400 bold with the latin typeface Arial and the labels' txPr of sz 900 showing the values (five checks; change NZC)" "$(yn ct_all)"
    python3 -I -B "$B/ctcheck.py" tests/fixtures/openpyxl-ops.xlsx >"$B/c-ctcheck.out" 2>&1
    echo "  over the committed fixture, which holds no chart: $(count_matches -E ': no$' "$B/c-ctcheck.out") checks no"
    ct_ctl() { [ "$(count_matches -E ': no$' "$B/c-ctcheck.out")" = 5 ]; }
    check "control: the same check finds the committed fixture holds no such chart (five checks no)" "$(yn ct_ctl)"
    # The one-workbook corpus the runner takes with --corpus.
    cat >"$B/opxcorpus.py" <<'PY'
    """Copies the workbook given first into corpus/<id>.xlsx in the directory
    given second, and writes manifest.tsv beside corpus there, one row in
    specs/0005's form, <id> the first twelve hex digits of the workbook's
    sha256; the date given third is the row's added column. Prints the id, the
    byte count and the sha256."""
    import hashlib
    import os
    import sys
    
    sys.dont_write_bytecode = True
    MANIFEST_HEADER = ("id\tsha256\tbytes\text\tproducer\tproducer_version\tapp\tsource\ttags\tadded"
                       "\toriginal_name\tnote")
    src, out, date = sys.argv[1:4]
    data = open(src, "rb").read()
    digest = hashlib.sha256(data).hexdigest()
    ident = digest[:12]
    os.makedirs(os.path.join(out, "corpus"))
    with open(os.path.join(out, "corpus", ident + ".xlsx"), "wb") as f:
        f.write(data)
    row = [ident, digest, str(len(data)), "xlsx", "openpyxl", "3.1.5", "openpyxl", "generated", "fixture",
           date, "openpyxl-chart-text.xlsx", "fictional"]
    with open(os.path.join(out, "manifest.tsv"), "w", encoding="utf-8", newline="\n") as f:
        f.write(MANIFEST_HEADER + "\n" + "\t".join(row) + "\n")
    print("%s\t%d\t%s" % (ident, len(data), digest))
    PY
    echo "command: python3 -I -B <work>/opxcorpus.py <work>/opx/chart-text.xlsx <work>/opxcorpus $DATE; the program:"
    sed 's/^/    /' "$B/opxcorpus.py"
    python3 -I -B "$B/opxcorpus.py" "$OPX_OUT" "$B/opxcorpus" "$DATE" >"$B/opxcorpus.out" 2>"$B/opxcorpus.err" </dev/null
    oc_rc=$?
    OPX_ID=$(cut -f1 "$B/opxcorpus.out")
    OPX_IN=$B/opxcorpus/corpus/$OPX_ID.xlsx
    echo "  exit: $oc_rc; standard error $(wc -c <"$B/opxcorpus.err") bytes; the fixture: id $OPX_ID, $(cut -f2 "$B/opxcorpus.out") bytes, sha256 $(cut -f3 "$B/opxcorpus.out")"
    oc_ok() { [ "$oc_rc" = 0 ] && [ ! -s "$B/opxcorpus.err" ] && cmp -s "$OPX_IN" "$OPX_OUT"; }
    check "the corpus program exits 0, writes nothing to its standard error, and its copy is the op's output byte for byte" "$(yn oc_ok)"
    OPX_ENTRIES=$(python3 -I -B -c 'import sys, zipfile; print(len(zipfile.ZipFile(sys.argv[1]).namelist()))' "$OPX_IN" 2>/dev/null)
    echo "  the fixture's entries: ${OPX_ENTRIES:-none}"
    # The fixture runs: each sample on each target into its own directory under
    # <work>; the charts sample's line read for its keys, the text and edit
    # samples' by the corpus rules.
    for FS in charts chart-text chart-edit; do
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      FO=$B/opxrun-$FS
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --corpus <work>/opxcorpus --out <work>/opxrun-$FS --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg --$FS-sample"
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --corpus "$B/opxcorpus" --out "$FO" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "--$FS-sample" \
        >"$B/opx-$FS-$label.stdout" 2>"$B/opx-$FS-$label.stderr" </dev/null
      frc=$?
      echo "  exit $frc; stderr bytes: $(wc -c <"$B/opx-$FS-$label.stderr")"
      sed 's/^/    /' "$B/opx-$FS-$label.stdout"
      FSUM=$FO/summary.$label.tsv
      opx_row_ok() { [ "$frc" = 0 ] && [ ! -s "$B/opx-$FS-$label.stderr" ] && [ "$(awk 'NR > 1' "$FSUM" | wc -l)" = 1 ] \
        && [ "$(count_where "$FSUM" outcome ok)" = 1 ] && [ "$(count_where "$FSUM" lo ok)" = 1 ] \
        && [ "$(count_where "$FSUM" lo_in ok)" = 1 ] && [ "$(count_where "$FSUM" leftover no)" = 1 ]; }
      check "fixture $FS $label: the run exits 0 with an empty stderr, its one row ok, the input and the output opening in LibreOffice (lo_in and lo ok), nothing left over" "$(yn opx_row_ok)"
      e=$(cat "$FO/$OPX_ID/stdout.$label.txt")
      printf '%s\n' "$e" >"$B/opxline-$FS-$label"
      echo "  the line: $(printf '%s' "$e" | tr '\t' ' ')"
    done
    check "fixture $FS: both targets printed the same line" "$(yn cmp -s "$B/opxline-$FS-host" "$B/opxline-$FS-i686")"
    check "fixture $FS: the output is the same on both targets, byte for byte" "$(yn cmp -s "$FO/$OPX_ID/out.host.xlsx" "$FO/$OPX_ID/out.i686.xlsx")"
    done
    OL=$(cat "$B/opxline-charts-host")
    opx_charts_ok() { [ "$(printf '%s\n' "$OL" | cut -f1)" = charts ] && [ "$(kv "$OL" sheets)" = 2 ] && [ "$(kv "$OL" charts)" = 1 ] \
      && [ "$(kv "$OL" plots)" = 1 ] && [ "$(kv "$OL" kind_bar)" = 1 ] && [ "$(kv "$OL" series)" = 1 ] && [ "$(kv "$OL" combined)" = 0 ] \
      && [ "$(kv "$OL" labels)" = 0 ] && [ "$(kv "$OL" titles)" = 1 ] && [ "$(kv "$OL" axes)" = 2 ] && [ "$(kv "$OL" axis_cat)" = 1 ] \
      && [ "$(kv "$OL" axis_val)" = 1 ] && [ "$(kv "$OL" legends)" = 1 ] && [ "$(kv "$OL" styles)" = 1 ]; }
    check "fixture charts: the line reads openpyxl's chart (sheets 2; charts 1; plots 1, kind_bar 1; series 1, its labels 0, openpyxl's labels being the plot's; combined 0; titles 1; axes 2, axis_cat 1 and axis_val 1; legends 1; styles 1, the plain c:style read: ruling B; change NZC)" "$(yn opx_charts_ok)"
    opx_charts_ctl() { local OL; OL=$(cat "$B/opxline-charts-host" | sed 's/\tseries=1\t/\tseries=2\t/'); opx_charts_ok; }
    echo "  named, a reading fact (ruling G): the charts sample reads labels 0 on openpyxl's chart, its dLbls being the plot's (barChart's), not the series'; the reader's labels flag is the series'"
    check "control: the same check refuses the line with series 2" "$(ynnot opx_charts_ctl)"
    opx_charts_ctl2() { local OL; OL=$(cat "$B/opxline-charts-host" | sed 's/\tstyles=1\t/\tstyles=0\t/'); opx_charts_ok; }
    check "control: the same check refuses the line with no style read (styles 0; ruling B)" "$(ynnot opx_charts_ctl2)"
    FE=$B/opxrun-charts/entries.host.tsv
    n_opx_rows=$(awk 'NR > 1' "$FE" | wc -l)
    n_opx_same=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] == "identical" && $k["flags"] == ""' "$FE" | wc -l)
    echo "  the charts sample's entry rows: $n_opx_rows; identical and unflagged: $n_opx_same; the fixture's entries: ${OPX_ENTRIES:-none}"
    opx_same() { [ -n "$OPX_ENTRIES" ] && [ "$n_opx_rows" = "$OPX_ENTRIES" ] && [ "$n_opx_same" = "$OPX_ENTRIES" ]; }
    check "fixture charts: the input written back unedited, each of its entries identical and unflagged" "$(yn opx_same)"
    opx_same_ctl() { local n_opx_same=$((n_opx_same - 1)); opx_same; }
    check "control: the same check refuses one entry fewer identical" "$(ynnot opx_same_ctl)"
    # opx_rows <entries> <part>: the status and flags of the fixture's row for
    # the part, "status/flags".
    opx_rows() { awk -F'\t' -v id="$OPX_ID" -v p="$2" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id && $k["name"] == p { print $k["status"] "/" $k["flags"] }' "$1"; }
    # opx_kept <entries>: openpyxl's chart part and the worksheet the chart
    # sits on identical and unflagged in the sample's rows.
    opx_kept() { [ "$(opx_rows "$1" xl/charts/chart1.xml)" = identical/ ] && [ "$(opx_rows "$1" xl/worksheets/sheet1.xml)" = identical/ ]; }
    TL=$(cat "$B/opxline-chart-text-host")
    TE=$B/opxrun-chart-text/entries.host.tsv
    check "fixture chart-text: the line is what the spec reads (P1's rule, change NYV)" "$(yn text_line_ok "$TL")"
    fix_text_counts() { [ "$(kv "$TL" charts_before)" = 1 ] && [ "$(kv "$TL" charts_after)" = 4 ] && [ "$(kv "$TL" rows)" = 100 ] && [ "$(kv "$TL" texts)" = 6 ] && [ "$(kv "$TL" styles)" = 0 ]; }
    check "fixture chart-text: charts_before 1, charts_after 4: three added beside openpyxl's one; rows 100, the fixture's first sheet's; texts 6 and styles 0 (change NZC)" "$(yn fix_text_counts)"
    check "fixture chart-text: the drawing is appended to, not created (surface_made 0)" "$(yn [ "$(surface_made "$TE" "$OPX_ID")" = 0 ])"
    check "fixture chart-text: the entry rows are as the corpus rule gives for a drawing appended to" "$(yn text_named "$TE" "$OPX_ID" 0)"
    check "fixture chart-text: openpyxl's chart part and the worksheet are identical and unflagged" "$(yn opx_kept "$TE")"
    DL=$(cat "$B/opxline-chart-edit-host")
    DE=$B/opxrun-chart-edit/entries.host.tsv
    check "fixture chart-edit: the line is what the spec reads (change NYZ's rule)" "$(yn edit_line_ok "$DL")"
    fix_opx_edit_counts() { [ "$(kv "$DL" charts)" = 2 ] && [ "$(kv "$DL" kept_edited)" = 1 ] && [ "$(kv "$DL" rows)" = 100 ]; }
    check "fixture chart-edit: charts 2, openpyxl's and the first write's; kept_edited 1; rows 100 (change NZC)" "$(yn fix_opx_edit_counts)"
    check "fixture chart-edit: the drawing is appended to, not created (surface_made 0)" "$(yn [ "$(surface_made "$DE" "$OPX_ID")" = 0 ])"
    check "fixture chart-edit: the entry rows are as the corpus rule gives for a drawing appended to, the kept chart's part changed (change NYZ)" "$(yn edit_named "$DE" "$OPX_ID" 0 1)"
    opx_edit_rows() { [ "$(opx_rows "$DE" xl/charts/chart1.xml | cut -d/ -f1)" = changed ] && [ "$(opx_rows "$DE" xl/worksheets/sheet1.xml)" = identical/ ]; }
    check "fixture chart-edit: openpyxl's chart part changed, the worksheet identical and unflagged" "$(yn opx_edit_rows)"
    opx_kept_ctl() { opx_kept "$B/ce.tsv"; }
    check "control: opx_kept refuses rows that name neither part" "$(ynnot opx_kept_ctl)"
    echo "command: python3 -I -B <work>/edcheck.py <work>/opxcorpus/corpus/$OPX_ID.xlsx <work>/opxrun-chart-edit/$OPX_ID/out.host.xlsx 'emend text' 'emend kept' (the program printed above)"
    python3 -I -B "$B/edcheck.py" "$OPX_IN" "$B/opxrun-chart-edit/$OPX_ID/out.host.xlsx" "emend text" "emend kept" >"$B/opx-edcheck.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/opx-edcheck.out"
    opx_ed_all() { [ "$(count_matches -E ': yes$' "$B/opx-edcheck.out")" = 9 ] && [ "$(count_matches -E ': no$' "$B/opx-edcheck.out")" = 0 ]; }
    printf '%s\txlsx\n' "$OPX_ID" >"$B/opx-order"
    echo "command: python3 -I -B <work>/stcheck.py <work>/opxrun-chart-edit host <work>/opxcorpus <work>/opx-order (change NZE)"
    python3 -I -B "$B/stcheck.py" "$B/opxrun-chart-edit" host "$B/opxcorpus" "$B/opx-order" >"$B/opx-stcheck.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/opx-stcheck.out"
    check "fixture chart-edit: the added chart part holds one c:style val 26 after roundedCorners, and openpyxl's part keeps its plain c:style 26 (ruling G; change NZE)" "$(yn st_ok "$B/opx-stcheck.out" 1 1)"
    check "fixture chart-edit: the edit's nine checks hold over openpyxl's part (its title's run text alone replaced, byte for byte, its two txPr, its plain c:style 26, its title's pPr kept, the chart the first write added edited as set, no cache; ruling E; change NZC)" "$(yn opx_ed_all)"
    # The comparison of the written text forms with openpyxl's, field by
    # field where both write the field (specs/0041 "Harness runs"; specs/0040
    # ruling N's shape; change NZC).
    cat >"$B/txcmp.py" <<'PY'
    """Compares the text forms emend's text sample wrote with those openpyxl's
    chart-text op wrote, field by field where both write the field
    (specs/0041 "Harness runs", the openpyxl fixture; specs/0040 ruling N's
    shape).
    
    Usage: python3 -I -B txcmp.py <fixture> <text sample's output> <edit sample's output>
           python3 -I -B txcmp.py --place-control
    
    openpyxl's elements are read from the fixture's one chart part: its
    category axis's txPr, its data labels' txPr (the plot's dLbls) and that
    axis txPr's defRPr. emend's are read from the parts the output adds beside
    the fixture's: the column chart's category axis's txPr and its series'
    data labels' txPr (sz there), and the pie's data labels' defRPr (b and the
    latin typeface, which the column does not write); and the style from the
    one chart part the edit sample's output adds beside the fixture's (ruling
    G). Each element is found by
    its local name, by ElementTree, the namespace ignored (openpyxl writes the
    chart namespace as the default one, emend with the c: prefix).
    
    The fields compared:
      txPr under catAx, and txPr under dLbls: each side's txPr found there,
        its preceding sibling printed, its place among its siblings by the
        schema's sequence (CT_CatAx, CT_DLbls), the dLbls's own parent
        printed for both;
      sz on the category axis's defRPr, and sz on the labels' defRPr: a
        decimal on both sides, the values printed, equality not required;
      b on a defRPr, and the latin typeface on a defRPr: both written, equal
        (openpyxl's 1 and Arial are the op's constants, emend's the sample's),
        latin placed among the defRPr's children by CT_TextCharacterProperties;
      style: the root's c:style val, a decimal on both sides, equal (26 =
        26, required; ruling G), each side's preceding sibling printed as found
        (emend's roundedCorners, openpyxl's none: its style the root's first
        child), named and not judged.
    Named and not compared: i (openpyxl writes none), openpyxl's empty run in
    each txPr (a:r with an empty a:t), its bare endParaRPr, and its title's
    run without rPr after an empty defRPr; each printed with what openpyxl
    writes.
    
    --place-control runs the judgment and the place rule over planted
    readings and sibling lists, one "name: yes|no" line each, yes where the
    rule gives the planted case's expected answer."""
    import re
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    SHARED = ["axId", "scaling", "delete", "axPos", "majorGridlines", "minorGridlines", "title", "numFmt",
              "majorTickMark", "minorTickMark", "tickLblPos", "spPr", "txPr", "crossAx", "crosses", "crossesAt"]
    SEQUENCE = {
        "catAx": SHARED + ["auto", "lblAlgn", "lblOffset", "tickLblSkip", "tickMarkSkip", "noMultiLvlLbl", "extLst"],
        "dLbls": ["dLbl", "delete", "numFmt", "spPr", "txPr", "dLblPos", "showLegendKey", "showVal", "showCatName",
                  "showSerName", "showPercent", "showBubbleSize", "separator", "showLeaderLines", "leaderLines",
                  "extLst"],
        "chartSpace": ["date1904", "lang", "roundedCorners", "AlternateContent", "style", "clrMapOvr",
                       "pivotSource", "protection", "chart", "spPr", "txPr", "externalData", "printSettings",
                       "userShapes", "extLst"],
        "defRPr": ["ln", "noFill", "solidFill", "gradFill", "blipFill", "pattFill", "grpFill", "effectLst",
                   "effectDag", "highlight", "uLnTx", "uLn", "uFillTx", "uFill", "latin", "ea", "cs", "sym",
                   "hlinkClick", "hlinkMouseOver", "rtl", "extLst"],
    }
    # crosses and crossesAt are a choice: one rank; so are the fills.
    FILLS = ("noFill", "solidFill", "gradFill", "blipFill", "pattFill", "grpFill")
    RANK = {}
    for parent, seq in SEQUENCE.items():
        rank = {}
        for i, n in enumerate(seq):
            if n == "crossesAt":
                rank[n] = seq.index("crosses")
            elif n in FILLS:
                rank[n] = seq.index("noFill")
            else:
                rank[n] = i
        RANK[parent] = rank
    DECIMAL = re.compile(r"[0-9]+")
    BOOLEAN = {"0", "1", "true", "false"}
    
    
    def local(tag):
        return tag.rsplit("}", 1)[-1]
    
    
    def kid(element, name):
        if element is None:
            return None
        found = [c for c in element if local(c.tag) == name]
        return found[0] if found else None
    
    
    def place_ok(parent_name, siblings, index):
        """Whether siblings[index] sits where the parent's sequence puts it."""
        rank = RANK[parent_name]
        me = siblings[index]
        if me not in rank:
            return False
        if any(s not in rank or rank[s] > rank[me] for s in siblings[:index]):
            return False
        if any(s not in rank or rank[s] < rank[me] for s in siblings[index + 1:]):
            return False
        return True
    
    
    def placed(parent, name):
        """(found, the preceding sibling or "none", place ok) of the one child
        `name` of `parent`."""
        if parent is None:
            return None
        names = [local(c.tag) for c in parent]
        found = [i for i, n in enumerate(names) if n == name]
        if len(found) != 1:
            return None
        i = found[0]
        return parent[i], (names[i - 1] if i else "none"), place_ok(local(parent.tag), names, i)
    
    
    def defrpr(txpr):
        return kid(kid(kid(txpr, "p"), "pPr"), "defRPr")
    
    
    def judged(kind, a, b, equal):
        """Whether two readings (value, place ok) are the same form."""
        if a is None or b is None:
            return False
        ok_a = DECIMAL.fullmatch(a[0] or "") if kind == "decimal" else (a[0] in BOOLEAN if kind == "boolean" else bool(a[0]))
        ok_b = DECIMAL.fullmatch(b[0] or "") if kind == "decimal" else (b[0] in BOOLEAN if kind == "boolean" else bool(b[0]))
        return bool(ok_a) and bool(ok_b) and a[1] and b[1] and (a[0] == b[0] or not equal)
    
    
    def place_control():
        cases = [
            ("txPr after tickLblPos on a category axis", "catAx", ["axId", "minorTickMark", "tickLblPos", "txPr", "crossAx"], 3, True),
            ("txPr after minorTickMark with no tickLblPos (openpyxl's form)", "catAx", ["axId", "axPos", "majorTickMark", "minorTickMark", "txPr", "crossAx"], 4, True),
            ("control: txPr before tickLblPos refused", "catAx", ["axId", "txPr", "tickLblPos", "crossAx"], 1, False),
            ("txPr first in dLbls", "dLbls", ["txPr", "showLegendKey", "showVal"], 0, True),
            ("txPr after numFmt in dLbls", "dLbls", ["numFmt", "txPr", "dLblPos", "showVal"], 1, True),
            ("control: txPr after showVal refused", "dLbls", ["showVal", "txPr"], 1, False),
            ("latin after solidFill in defRPr", "defRPr", ["solidFill", "latin"], 1, True),
            ("control: latin before solidFill refused", "defRPr", ["latin", "solidFill"], 0, False),
            ("control: an element the sequence does not hold refused", "dLbls", ["txPr", "planted"], 0, False),
        ]
        for name, parent, siblings, index, want in cases:
            print("%s: %s" % (name, "yes" if place_ok(parent, siblings, index) == want else "no"))
        judged_cases = [
            ("sz 1400 against 900 taken, equality not required", "decimal", ("1400", True), ("900", True), False, True),
            ("control: sz against a value that is not a number refused", "decimal", ("1400", True), ("x", True), False, False),
            ("control: b 1 against 0 refused, equality required", "boolean", ("1", True), ("0", True), True, False),
            ("control: a typeface against another refused, equality required", "text", ("Arial", True), ("Calibri", True), True, False),
            ("control: a field out of place on one side refused", "text", ("Arial", True), ("Arial", False), True, False),
            ("control: a field one side does not write refused", "decimal", ("900", True), None, False, False),
            ("control: style 26 against 2 refused, equality required", "decimal", ("26", True), ("2", True), True, False),
        ]
        for name, kind, a, b, equal, want in judged_cases:
            print("%s: %s" % (name, "yes" if judged(kind, a, b, equal) == want else "no"))
    
    
    def charts(path, skip=()):
        z = zipfile.ZipFile(path)
        out = []
        for name in sorted(n for n in z.namelist() if re.match(r"xl/charts/chart[0-9]+\.xml$", n)):
            if name not in skip:
                out.append((name, ET.fromstring(z.read(name))))
        return out
    
    
    def area_of(root):
        return kid(kid(root, "chart"), "plotArea")
    
    
    def main():
        if sys.argv[1:] == ["--place-control"]:
            place_control()
            return
        fixture, output, edited = sys.argv[1:4]
        theirs = charts(fixture)
        skip = {n for n, _ in theirs}
        their_area = area_of(theirs[0][1]) if len(theirs) == 1 else None
        column = pie = None
        for _, root in charts(output, skip):
            area = area_of(root)
            if kid(area, "barChart") is not None and column is None:
                column = area
            if kid(area, "pieChart") is not None and pie is None:
                pie = area
        their_cat = kid(their_area, "catAx")
        their_labels = kid(kid(their_area, "barChart"), "dLbls")
        our_cat = kid(column, "catAx")
        our_labels = kid(kid(kid(column, "barChart"), "ser"), "dLbls")
        pie_rpr = defrpr(kid(kid(kid(kid(pie, "pieChart"), "ser"), "dLbls"), "txPr"))
        their_rpr = defrpr(kid(their_cat, "txPr"))
        same = 0
        lines = []
        # The two txPr places.
        for field, a_parent, b_parent, a_where, b_where in (
                ("txPr under catAx", their_cat, our_cat, "the plot area", "the plot area"),
                ("txPr under dLbls", their_labels, our_labels, "barChart", "ser")):
            a, b = placed(a_parent, "txPr"), placed(b_parent, "txPr")
            good = a is not None and b is not None and a[2] and b[2]
            if a is None or b is None:
                detail = "written by openpyxl %s, by emend %s" % ("yes" if a else "no", "yes" if b else "no")
            else:
                detail = ("openpyxl after %s, its parent's parent %s; emend after %s, its parent's parent %s; place %s, %s"
                          % (a[1], a_where, b[1], b_where, "yes" if a[2] else "no", "yes" if b[2] else "no"))
            same += 1 if good else 0
            lines.append("%s: %s; the same form: %s" % (field, detail, "yes" if good else "no"))
        # sz on the two defRPr.
        for field, a_rpr, b_rpr in (("sz on the category axis's defRPr", their_rpr, defrpr(kid(our_cat, "txPr"))),
                                    ("sz on the labels' defRPr", defrpr(kid(their_labels, "txPr")),
                                     defrpr(kid(our_labels, "txPr")))):
            a = (a_rpr.get("sz"), True) if a_rpr is not None and a_rpr.get("sz") is not None else None
            b = (b_rpr.get("sz"), True) if b_rpr is not None and b_rpr.get("sz") is not None else None
            good = judged("decimal", a, b, False)
            detail = ("openpyxl %s; emend %s; decimal both; equal not required" % (a[0], b[0])) if a and b else \
                "written by openpyxl %s, by emend %s" % ("yes" if a else "no", "yes" if b else "no")
            same += 1 if good else 0
            lines.append("%s: %s; the same form: %s" % (field, detail, "yes" if good else "no"))
        # b, and the latin typeface with its place.
        a = (their_rpr.get("b"), True) if their_rpr is not None and their_rpr.get("b") is not None else None
        b = (pie_rpr.get("b"), True) if pie_rpr is not None and pie_rpr.get("b") is not None else None
        good = judged("boolean", a, b, True)
        same += 1 if good else 0
        lines.append("b on a defRPr: %s; the same form: %s"
                     % (("openpyxl %s (the category axis's); emend %s (the pie's labels'); equal required" % (a[0], b[0]))
                        if a and b else "written by openpyxl %s, by emend %s" % ("yes" if a else "no", "yes" if b else "no"),
                        "yes" if good else "no"))
        la, lb = placed(their_rpr, "latin"), placed(pie_rpr, "latin")
        a = (la[0].get("typeface"), la[2]) if la else None
        b = (lb[0].get("typeface"), lb[2]) if lb else None
        good = judged("text", a, b, True)
        same += 1 if good else 0
        lines.append("latin typeface on a defRPr: %s; the same form: %s"
                     % (("openpyxl %s, after %s; emend %s, after %s; place %s, %s; equal required"
                         % (a[0], la[1], b[0], lb[1], "yes" if a[1] else "no", "yes" if b[1] else "no"))
                        if a and b else "written by openpyxl %s, by emend %s" % ("yes" if a else "no", "yes" if b else "no"),
                        "yes" if good else "no"))
        # The style: openpyxl's from the fixture's root, emend's from the one
        # chart part the edit sample adds (ruling G).
        their_root = theirs[0][1] if len(theirs) == 1 else None
        ours_added = charts(edited, skip)
        our_root = ours_added[0][1] if len(ours_added) == 1 else None
        sa, sb = placed(their_root, "style"), placed(our_root, "style")
        a = (sa[0].get("val"), True) if sa else None
        b = (sb[0].get("val"), True) if sb else None
        good = judged("decimal", a, b, True)
        same += 1 if good else 0
        lines.append("style on the chartSpace: %s; the same form: %s"
                     % (("openpyxl %s, after %s; emend %s (the edit sample's added chart), after %s; the preceding "
                         "siblings named, not judged; equal required" % (a[0], sa[1], b[0], sb[1]))
                        if a and b else "written by openpyxl %s, by emend %s" % ("yes" if a else "no", "yes" if b else "no"),
                        "yes" if good else "no"))
        for line in lines:
            print(line)
        rprs = [e for e in (their_root.iter() if their_root is not None else []) if local(e.tag) in ("defRPr", "rPr")]
        print("named, not compared: i: openpyxl writes %s" % ("one" if any(e.get("i") is not None for e in rprs) else "none"))
        txprs = [e for e in (their_root.iter() if their_root is not None else []) if local(e.tag) == "txPr"]
        empty = sum(1 for t in txprs for p in t if local(p.tag) == "p" for r in p if local(r.tag) == "r"
                    and all(not (x.text or "") for x in r if local(x.tag) == "t"))
        bare = sum(1 for t in txprs for p in t if local(p.tag) == "p" for e in p if local(e.tag) == "endParaRPr"
                   and not e.attrib and len(e) == 0)
        print("named, not compared: the empty run in a txPr: openpyxl writes %d, in its %d txPr" % (empty, len(txprs)))
        print("named, not compared: the bare endParaRPr: openpyxl writes %d" % bare)
        title = kid(kid(kid(kid(their_root, "chart"), "title"), "tx"), "rich")
        paragraph = kid(title, "p")
        run = kid(paragraph, "r")
        print("named, not compared: the title's run: openpyxl writes it %s rPr, after a%s defRPr"
              % ("with" if kid(run, "rPr") is not None else "without",
                 "n empty" if defrpr(title) is not None and not defrpr(title).attrib and len(defrpr(title)) == 0
                 else " written"))
        print("fields compared 7; the same form %d" % same)
    
    
    main()
    PY
    echo "command: python3 -I -B <work>/txcmp.py <work>/opxcorpus/corpus/$OPX_ID.xlsx <work>/opxrun-chart-text/$OPX_ID/out.host.xlsx <work>/opxrun-chart-edit/$OPX_ID/out.host.xlsx; over the fixture against itself (the control); and with --place-control; the program:"
    sed 's/^/    /' "$B/txcmp.py"
    python3 -I -B "$B/txcmp.py" "$OPX_IN" "$B/opxrun-chart-text/$OPX_ID/out.host.xlsx" "$B/opxrun-chart-edit/$OPX_ID/out.host.xlsx" >"$B/txcmp.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/txcmp.out"
    tc_all() { [ "$(count_matches -E '; the same form: yes$' "$B/txcmp.out")" = 7 ] && [ "$(count_matches -E '; the same form: no$' "$B/txcmp.out")" = 0 ] \
      && [ "$(count_matches -E '^named, not compared: ' "$B/txcmp.out")" = 4 ] && [ "$(count_matches -F 'fields compared 7; the same form 7' "$B/txcmp.out")" = 1 ]; }
    check "fixture: every field both write has the same form in emend's outputs and openpyxl's, seven of seven: the category axis's txPr and the labels' txPr each placed by the schema's sequence, the preceding sibling printed for both; sz on each defRPr; b and the latin typeface on a defRPr, equal; the style val, emend's from the edit sample's added chart, equal, 26 = 26 (ruling G), its preceding siblings named and not judged; i, openpyxl's empty run in each txPr, its bare endParaRPr and its title's run without rPr named and not compared (ruling N's shape; changes NZC and NZE)" "$(yn tc_all)"
    python3 -I -B "$B/txcmp.py" "$OPX_IN" "$OPX_IN" "$OPX_IN" >"$B/c-txcmp.out" 2>&1
    echo "  over the fixture against itself, which adds nothing: $(count_matches -E '; the same form: no$' "$B/c-txcmp.out") fields no"
    tc_ctl() { [ "$(count_matches -E '; the same form: no$' "$B/c-txcmp.out")" = 7 ]; }
    check "control: the same comparison finds none of the seven fields in outputs that add no chart" "$(yn tc_ctl)"
    python3 -I -B "$B/txcmp.py" --place-control >"$B/c-txplace.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/c-txplace.out"
    txplace_ctl() { [ "$(count_matches -E ': yes$' "$B/c-txplace.out")" = 16 ] && [ "$(count_matches -E ': no$' "$B/c-txplace.out")" = 0 ]; }
    check "control: the place rule takes each txPr and latin where the schema's sequence puts it, openpyxl's axis txPr after minorTickMark among them, and refuses it elsewhere, and the judgment refuses a value unequal where equality is required (a style 26 against 2 among them), one not a number, a field out of place and one not written (sixteen planted cases)" "$(yn txplace_ctl)"
    n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
    check "fixture: the runs' TMPDIR is empty after the runs" "$(yn [ "$n_left" = 0 ])"
    
    echo
    if [ "$RUN_SKIP_KEEP" = yes ]; then
    echo "## the keep and the open check: SKIPPED (RUN_SKIP_KEEP=yes, a dry run)"
    else
    echo "## the host keep regenerated (change NSF: M3 part 7 P5's form, one cargo test; carried)"
    mkdir "$KEEP" || exit 2
    echo "command: EMEND_KEEP_DIR=<keep> cargo test --workspace (host; CARGO_TARGET_DIR=<target>/main)"
    EMEND_KEEP_DIR=$KEEP cargo test --workspace >"$B/keep.out" 2>&1 </dev/null
    rc=$?
    echo "  exit: $rc"
    LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$B/keep.out" | sed 's/^ */    /'
    failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    echo "  passed $passed; failed $failed"
    check "the tests with the keep set exit 0" "$(yn [ "$rc" = 0 ])"
    check "no test failed" "$(yn [ "$failed" = 0 ])"
    echo "  files in the keep: $(find "$KEEP" -type f | wc -l); entries that are not regular files: $(find "$KEEP" -mindepth 1 ! -type f | wc -l)"
    (cd "$KEEP" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/host.files"
    nfiles=$(count_lines "$B/host.files")
    n_in=$(count_matches -E '\.in\.xlsx$' "$B/host.files")
    n_out=$(count_matches -E '\.out\.xlsx$' "$B/host.files")
    n_other=$(count_matches -vE '^[A-Za-z0-9_.-]+\.[0-9]+\.(in|out)\.xlsx$' "$B/host.files")
    LC_ALL=C sed -nE 's/^(.*)\.in\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.names"
    LC_ALL=C sed -nE 's/^(.*)\.out\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.out.names"
    echo "  .in.xlsx $n_in; .out.xlsx $n_out; names not of the form <test>.<n>.in|out.xlsx: $n_other"
    all_pairs() { [ "$n_in" = "$n_out" ] && [ "$((n_in * 2))" = "$nfiles" ] && [ "$n_other" = 0 ] && cmp -s "$B/pair.names" "$B/pair.out.names"; }
    check "the keep holds only whole pairs named <test>.<n>" "$(yn all_pairs)"
    NPAIRS=$n_in
    (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/keep.listing"
    echo "  the host keep's listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/keep.listing"); files $(count_lines "$B/keep.listing"); listing sha256 $(sha_of "$B/keep.listing")"
    check "the host keep's pairs times two equals its files (keep_pairs_ok)" "$(yn keep_pairs_ok "$B/keep.listing")"
    
    echo
    echo "## the host keep against P1's committed open-check record, named by its record commit, the base, the last to add one (change NZD)"
