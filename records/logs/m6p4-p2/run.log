## the Excel-form fixture: --charts-sample, --chart-text-sample and --chart-edit-sample on it through the runner, both targets (specs/0041 "Harness runs", the first fixture, and rulings B and E; P1's change NYW, its form; change NZB)
command: python3 -I -B <work>/txfix.py <work>/fixcorpus; the program:
    """The run log's fictional Excel-form text fixture
    (specs/0041-chart-text-and-edits.md, "Harness runs", the first fixture,
    and ruling B): one worksheet of twelve cells (A1:B6, numbers: the
    categories 1 to 6 in A, values in B), its drawing in one twoCellAnchor
    holding a barChart of one series (values B1:B6 against A1:A6) whose dLbls
    holds a txPr; a title whose rich text carries a:pPr with a:defRPr and the
    run's a:rPr (14 pt bold); a catAx and a valAx each with a txPr after
    tickLblPos; a legend with a txPr after overlay; and a root
    mc:AlternateContent after roundedCorners holding c14:style 102 in its
    Choice and c:style 2 in its Fallback (the corpus's form), with a chart
    style part and a chart colour style part reached from the chart part's
    rels, each with its Override; every element's children in the schema's
    order. Writes the workbook with zipfile at fixed timestamps into
    corpus/<id>.xlsx in the directory it is given, and a one-row manifest,
    manifest.tsv, beside corpus there, in specs/0005's form, <id> the first
    twelve hex digits of the workbook's sha256; prints the id, the byte count
    and the sha256."""
    import hashlib
    import io
    import os
    import sys
    import zipfile
    
    sys.dont_write_bytecode = True
    MAIN = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    REL = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    PKG = "http://schemas.openxmlformats.org/package/2006/relationships"
    CT = "http://schemas.openxmlformats.org/package/2006/content-types"
    XDR = "http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing"
    A = "http://schemas.openxmlformats.org/drawingml/2006/main"
    C = "http://schemas.openxmlformats.org/drawingml/2006/chart"
    MC = "http://schemas.openxmlformats.org/markup-compatibility/2006"
    C14 = "http://schemas.microsoft.com/office/drawing/2007/8/2/chart"
    CS = "http://schemas.microsoft.com/office/drawing/2012/chartStyle"
    MSREL = "http://schemas.microsoft.com/office/2011/relationships"
    VND = "application/vnd.openxmlformats-officedocument"
    DECL = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    MANIFEST_HEADER = ("id\tsha256\tbytes\text\tproducer\tproducer_version\tapp\tsource\ttags\tadded"
                       "\toriginal_name\tnote")
    CATEGORIES = (1, 2, 3, 4, 5, 6)
    VALUES = (12, 30, 21, 44, 37, 50)
    
    
    def rels(body):
        return DECL + '<Relationships xmlns="%s">%s</Relationships>' % (PKG, body)
    
    
    def ref(element, form, formula):
        return "<c:%s><c:%s><c:f>%s</c:f></c:%s></c:%s>" % (element, form, formula, form, element)
    
    
    def text_pr(run):
        return ('<c:txPr><a:bodyPr/><a:lstStyle/><a:p><a:pPr>%s</a:pPr><a:endParaRPr lang="en-US"/></a:p>'
                '</c:txPr>' % run)
    
    
    labels = ('<c:dLbls>%s<c:showLegendKey val="0"/><c:showVal val="1"/><c:showCatName val="0"/>'
              '<c:showSerName val="0"/><c:showPercent val="0"/><c:showBubbleSize val="0"/></c:dLbls>'
              % text_pr('<a:defRPr sz="900"/>'))
    ser = ('<c:ser><c:idx val="0"/><c:order val="0"/><c:tx><c:v>Fixture</c:v></c:tx>%s%s%s</c:ser>'
           % (labels, ref("cat", "numRef", "Sheet1!$A$1:$A$6"), ref("val", "numRef", "Sheet1!$B$1:$B$6")))
    plot = ('<c:barChart><c:barDir val="col"/><c:grouping val="clustered"/><c:varyColors val="0"/>%s'
            '<c:gapWidth val="150"/><c:axId val="10"/><c:axId val="20"/></c:barChart>' % ser)
    TICKS = '<c:majorTickMark val="out"/><c:minorTickMark val="none"/><c:tickLblPos val="nextTo"/>'
    AXIS_TEXT = text_pr('<a:defRPr sz="900" b="1"/>')
    cat_ax = ('<c:catAx><c:axId val="10"/><c:scaling><c:orientation val="minMax"/></c:scaling>'
              '<c:delete val="0"/><c:axPos val="b"/><c:numFmt formatCode="General" sourceLinked="1"/>%s%s'
              '<c:crossAx val="20"/><c:crosses val="autoZero"/><c:auto val="1"/><c:lblAlgn val="ctr"/>'
              '<c:lblOffset val="100"/><c:noMultiLvlLbl val="0"/></c:catAx>' % (TICKS, AXIS_TEXT))
    val_ax = ('<c:valAx><c:axId val="20"/><c:scaling><c:orientation val="minMax"/></c:scaling>'
              '<c:delete val="0"/><c:axPos val="l"/><c:majorGridlines/><c:numFmt formatCode="General" '
              'sourceLinked="1"/>%s%s<c:crossAx val="10"/><c:crosses val="autoZero"/>'
              '<c:crossBetween val="between"/></c:valAx>' % (TICKS, AXIS_TEXT))
    title = ('<c:title><c:tx><c:rich><a:bodyPr/><a:lstStyle/><a:p><a:pPr><a:defRPr sz="1400" b="1"/></a:pPr>'
             '<a:r><a:rPr lang="en-US" sz="1400" b="1"/><a:t>Fixture title</a:t></a:r></a:p></c:rich></c:tx>'
             '<c:overlay val="0"/></c:title>')
    style = ('<mc:AlternateContent xmlns:mc="%s"><mc:Choice Requires="c14" xmlns:c14="%s">'
             '<c14:style val="102"/></mc:Choice><mc:Fallback><c:style val="2"/></mc:Fallback>'
             '</mc:AlternateContent>' % (MC, C14))
    chart = (DECL + '<c:chartSpace xmlns:c="%s" xmlns:a="%s" xmlns:r="%s"><c:date1904 val="0"/>'
             '<c:roundedCorners val="0"/>%s<c:chart>%s<c:autoTitleDeleted val="0"/><c:plotArea><c:layout/>%s%s%s'
             '</c:plotArea><c:legend><c:legendPos val="r"/><c:overlay val="0"/>%s</c:legend>'
             '<c:plotVisOnly val="1"/><c:dispBlanksAs val="gap"/></c:chart></c:chartSpace>'
             % (C, A, REL, style, title, plot, cat_ax, val_ax, text_pr('<a:defRPr sz="900"/>')))
    chart_style = (DECL + '<cs:chartStyle xmlns:cs="%s" xmlns:a="%s" id="201"><cs:axisTitle><cs:lnRef idx="0"/>'
                   '<cs:fillRef idx="0"/><cs:effectRef idx="0"/><cs:fontRef idx="minor"><a:schemeClr val="tx1"/>'
                   '</cs:fontRef><cs:defRPr sz="1000" b="1"/></cs:axisTitle></cs:chartStyle>' % (CS, A))
    color_style = (DECL + '<cs:colorStyle xmlns:cs="%s" xmlns:a="%s" meth="cycle" id="10">'
                   '<a:schemeClr val="accent1"/><a:schemeClr val="accent2"/><cs:variation/></cs:colorStyle>' % (CS, A))
    frame = ('<xdr:twoCellAnchor><xdr:from><xdr:col>3</xdr:col><xdr:colOff>0</xdr:colOff><xdr:row>0</xdr:row>'
             '<xdr:rowOff>0</xdr:rowOff></xdr:from><xdr:to><xdr:col>10</xdr:col><xdr:colOff>0</xdr:colOff>'
             '<xdr:row>15</xdr:row><xdr:rowOff>0</xdr:rowOff></xdr:to><xdr:graphicFrame macro="">'
             '<xdr:nvGraphicFramePr><xdr:cNvPr id="2" name="Chart 1"/><xdr:cNvGraphicFramePr/>'
             '</xdr:nvGraphicFramePr><xdr:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/></xdr:xfrm><a:graphic>'
