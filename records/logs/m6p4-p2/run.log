command: <work>/stcheck.py <run dir> <label> <corpus> <order>, written here; the program:
    """Checks the edit sample's style form over a run directory
    (specs/0041-chart-text-and-edits.md, ruling G): in each ok workbook's
    output, the one chart part the sample added holds one root c:style, of
    val 26, right after c:roundedCorners, and no root mc:AlternateContent;
    and each chart part the sample changed (the kept chart it retitled)
    keeps the input's style, a root c:style's val or a root
    mc:AlternateContent's first Choice's style and its Fallback's, or none.
    
    Usage: python3 -I -B stcheck.py <run dir> <label> <corpus dir> <order>
    
    <order> holds "<id><TAB><ext>" lines; the input is the corpus
    directory's corpus/ID.EXT, the output the run directory's ID/out.LABEL.EXT
    (ID the workbook's id), the rows the run directory's entries.LABEL.tsv. Prints one line per workbook, its id and
    two verdicts, then the totals; no part name, text or reference of a
    workbook."""
    import re
    import sys
    import zipfile
    import xml.etree.ElementTree as ET
    
    sys.dont_write_bytecode = True
    MC = "{http://schemas.openxmlformats.org/markup-compatibility/2006}"
    CHART = re.compile(r"xl/charts/chart[0-9]+\.xml$")
    
    
    def local(tag):
        return tag.rsplit("}", 1)[-1]
    
    
    def style_of(root):
        plain = [c for c in root if local(c.tag) == "style"]
        alternate = [c for c in root if c.tag == MC + "AlternateContent"]
        if plain:
            return ("plain", tuple(c.get("val") for c in plain))
        if alternate:
            out = []
            for branch in alternate[0]:
                found = [c for c in branch if local(c.tag) == "style"]
                out.append((local(branch.tag), found[0].get("val") if found else None))
            return ("alternate", tuple(out))
        return ("none",)
    
    
    def added_ok(root):
        """One root c:style of val 26 right after roundedCorners, no root
        mc:AlternateContent."""
        names = [local(c.tag) for c in root]
        styles = [c for c in root if local(c.tag) == "style"]
        if len(styles) != 1 or styles[0].get("val") != "26":
            return False
        if any(c.tag == MC + "AlternateContent" for c in root):
            return False
        i = names.index("style")
        return i > 0 and names[i - 1] == "roundedCorners"
    
    
    run, label, corpus, order = sys.argv[1:5]
    rows = {}
    with open("%s/entries.%s.tsv" % (run, label), encoding="utf-8") as f:
        head = f.readline().rstrip("\n").split("\t")
        k = {n: i for i, n in enumerate(head)}
        for line in f:
            c = line.rstrip("\n").split("\t")
            rows.setdefault(c[k["id"]], []).append((c[k["name"]], c[k["status"]]))
    n = n_added = n_kept = n_kept_ok = 0
    for line in open(order, encoding="utf-8"):
        ident, ext = line.rstrip("\n").split("\t")[:2]
        entries = rows.get(ident, [])
        added = [name for name, status in entries if status == "added" and CHART.match(name)]
        changed = [name for name, status in entries if status == "changed" and CHART.match(name)]
        try:
            out = zipfile.ZipFile("%s/%s/out.%s.%s" % (run, ident, label, ext))
            inp = zipfile.ZipFile("%s/corpus/%s.%s" % (corpus, ident, ext))
        except (OSError, zipfile.BadZipFile):
            print("%s: the output or the input cannot be read" % ident)
            n += 1
            continue
        n += 1
        good = len(added) == 1 and added_ok(ET.fromstring(out.read(added[0])))
        n_added += 1 if good else 0
        kept = "none"
        for name in changed:
            n_kept += 1
            same = style_of(ET.fromstring(inp.read(name))) == style_of(ET.fromstring(out.read(name)))
            n_kept_ok += 1 if same else 0
            kept = "yes" if same and kept != "no" else "no"
        print("%s: the added chart part's style 26 after roundedCorners: %s; the kept chart's style the input's: %s"
              % (ident, "yes" if good else "no", kept))
    print("workbooks %d; whose added chart part holds one style 26 after roundedCorners %d; kept chart parts %d, "
          "their style the input's %d" % (n, n_added, n_kept, n_kept_ok))

