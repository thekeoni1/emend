    doc_holds_two() { [ "$(git diff-tree --no-commit-id --name-only -r "$1" 2>/dev/null | LC_ALL=C sort | tr '\n' ' ')" = "ROADMAP.md specs/0041-chart-text-and-edits.md " ]; }
