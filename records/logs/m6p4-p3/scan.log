    P31DOCC=$(git log --format='%H' -n 1 -F --grep="M6 part 3 P1: commit planning docs (the spec, the M6 part 2 close-out verification)" "$C")
    echo "  M6 part 3 P1's doc commit, outside the range, by its subject: ${P31DOCC:-none found}"
    structural "control: the same form refuses M6 part 3 P1's doc commit, which holds three other planning files (change KF)" "$(yn doc_holds_other "$P31DOCC")"
    P33DOCC=$(git log --format='%H' -n 1 -F --grep="M6 part 3 P3: commit planning docs (the P2 verification and rulings)" "$C")
    echo "  M6 part 3 P3's doc commit, outside the range, by its subject: ${P33DOCC:-none found}"
