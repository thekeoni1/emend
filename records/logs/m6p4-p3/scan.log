    P3CLOSEC=$(git log --format='%H' -n 1 -F --grep="M6 part 3 close-out: commit planning docs (the P3 verification and rulings)" "$C")
    echo "  M6 part 3's close-out doc commit, outside the range, by its subject: ${P3CLOSEC:-none found}"
    structural "control: the same form refuses M6 part 3's close-out doc commit, which holds two other planning files (change KF)" "$(yn doc_holds_other "$P3CLOSEC")"
    # Change GN: the doc commit's message names each file the commit holds with
    # its blob's sha256. Change HP (planning ruling C during P1): the message is
    # read with its line breaks folded, as change J3's diff-alone check reads
    # it, and each file's path must be followed by "sha256 <hash>", no other
    # "sha256" between them. doc_msg_hashes_in <message file> <commit> reads
    # the files and blobs from the commit and the text from the file.
    doc_msg_hashes_in() {
      local msg=$1 c=$2 f h n=0 m=0 folded rest seg
      folded=$(tr '\n' ' ' <"$msg" | tr -s ' ')
      for f in $(git diff-tree --no-commit-id --name-only -r "$c"); do
        n=$((n + 1))
        h=$(git show "$c:$f" | sha256sum | cut -d' ' -f1)
        rest=${folded#*"$f"}
        [ "$rest" != "$folded" ] || continue
        seg=${rest%%"sha256 $h"*}
        [ "$seg" != "$rest" ] || continue
        case "$seg" in *sha256*) continue ;; esac
        m=$((m + 1))
      done
      [ "$n" -ge 1 ] && [ "$n" = "$m" ]
    }
    doc_msg_hashes() {
      git log -1 --format=%B "$1" >"$T/doc-msg"
      doc_msg_hashes_in "$T/doc-msg" "$1"
    }
    doc_msg_refused() { if doc_msg_hashes "$1"; then return 1; else return 0; fi; }
    echo "command: git log -1 --format=%B $DOC, and for each file of the doc commit git show <doc commit>:<file> | sha256sum (change GN)"
    for f in $(git diff-tree --no-commit-id --name-only -r "$DOC"); do echo "    $f sha256 $(git show "$DOC:$f" | sha256sum | cut -d' ' -f1)"; done
    structural "the doc commit's message names each file it holds followed by sha256 and its blob's hash, read with its line breaks folded (changes GN and HP)" "$(yn doc_msg_hashes "$DOC")"
    for f in $(git diff-tree --no-commit-id --name-only -r "$DOC"); do
      printf -- '- %s (planted),\nsha256\n  %s\n' "$f" "$(git show "$DOC:$f" | sha256sum | cut -d' ' -f1)"
    done >"$T/c-doc-folded"
    structural "control: the same form accepts a message giving each file, then sha256 and its hash on later lines, of the doc commit (change HP)" "$(yn doc_msg_hashes_in "$T/c-doc-folded" "$DOC")"
    sed '3s/[0-9a-f]$/x/' "$T/c-doc-folded" >"$T/c-doc-wrong"
    doc_msg_wrong_refused() { if doc_msg_hashes_in "$T/c-doc-wrong" "$DOC"; then return 1; else return 0; fi; }
    structural "control: the same form refuses that message with one hash wrong (change HP)" "$(yn doc_msg_wrong_refused)"
    structural "control: the same form refuses the CHANGELOG commit, the phase commit, whose message names no sha256 (changes GN and KK)" "$(yn doc_msg_refused "$C")"
    structural "control: the same form refuses the null commit (change DK)" \
      "$(yn role_paths_refused "$NULL_SHA" "$CODE_PATHS")"
    structural "the phase commit given is the last code commit of the range (changes EO and EZ)" "$(yn last_code_is "$C")"
    structural "control: the same form refuses the null commit as the last code commit" \
      "$(yn not_last_code "$NULL_SHA")"
    FIRST_CODE=$(sed -n 1p "$T/phase-code")
    first_code_distinct() { [ "$NCODE" != error ] && [ "$NCODE" -ge 2 ]; }
    if first_code_distinct; then
      structural "control: the same form refuses the first code commit, which is not the last" \
        "$(yn not_last_code "$FIRST_CODE")"
    fi
    # Change KK: the CHANGELOG commit, the phase commit, its parent the probe
    # commit, its parent the doc commit, each by its subject (no carry commit:
    # planning accepted the skip).
    PROBEPC=$(git log --format='%H' -n 1 -F --grep="M6 part 4 P3: probe-emend-charts-write-xml gains the text properties, the style and the in-place edit" "$C")
    LOGPC=$(git log --format='%H' -n 1 -F --grep="M6 part 4 P3: the CHANGELOG names the chart text and in-place edits" "$C")
    echo "command: git log --format=%H -n 1 -F --grep=<subject> <phase commit>, for the probe and the CHANGELOG commits (change KK)"
    echo "  the probe commit: ${PROBEPC:-none found}; the CHANGELOG commit: ${LOGPC:-none found}"
    # parent_is <commit> <parent>: both found, and the second the first's parent.
    parent_is() { [ -n "$1" ] && [ -n "$2" ] && [ "$(git rev-parse "$1^")" = "$2" ]; }
    log_commit_is() { [ -n "$LOGPC" ] && [ "$LOGPC" = "$1" ] && parent_is "$1" "$PROBEPC" && parent_is "$PROBEPC" "$DOC"; }
    log_commit_refused() { if log_commit_is "$1"; then return 1; else return 0; fi; }
    structural "the phase commit given is the CHANGELOG commit by its subject, the probe commit its parent, the doc commit the probe commit's (change KK)" "$(yn log_commit_is "$C")"
    structural "control: the same form refuses the probe commit as the phase commit (change KK)" "$(yn log_commit_refused "$PROBEPC")"
    structural "control: the same form refuses the doc commit as the phase commit (change KK)" "$(yn log_commit_refused "$DOC")"
    probe_parent_ok() { parent_is "$PROBEPC" "$DOC"; }
    probe_parent_refused() { if parent_is "$LOGPC" "$DOC"; then return 1; else return 0; fi; }
    structural "the probe commit's parent is the doc commit (change KK)" "$(yn probe_parent_ok)"
    structural "control: the same form refuses the CHANGELOG commit as the doc commit's child (change KK)" "$(yn probe_parent_refused)"
    # paths_are <commit> <sorted paths, space-separated, with a trailing space>.
    paths_are() { [ "$(git diff-tree --no-commit-id --name-only -r "$1" | LC_ALL=C sort | tr '\n' ' ')" = "$2" ]; }
    paths_not() { if paths_are "$1" "$2"; then return 1; else return 0; fi; }
    PROBE_FILES="tools/size-probe/src/bin/probe-emend-charts-write-xml.rs "
    CHANGELOG_FILES="CHANGELOG.md "
    structural "the probe commit touches tools/size-probe/src/bin/probe-emend-charts-write-xml.rs alone (change KK)" "$(yn paths_are "$PROBEPC" "$PROBE_FILES")"
    structural "the CHANGELOG commit touches CHANGELOG.md alone (change KK)" "$(yn paths_are "$LOGPC" "$CHANGELOG_FILES")"
    structural "control: the same form refuses the CHANGELOG commit's paths for the probe commit (change KK)" "$(yn paths_not "$PROBEPC" "$CHANGELOG_FILES")"
    structural "control: the same form refuses the probe commit's paths for the CHANGELOG commit (change KK)" "$(yn paths_not "$LOGPC" "$PROBE_FILES")"
    structural "control: the same form refuses the doc commit (change KK)" "$(yn paths_not "$DOC" "$PROBE_FILES")"
    structural "control: the doc-message form refuses the probe commit, whose message names no sha256 (changes GN and KK)" "$(yn doc_msg_refused "$PROBEPC")"
    echo
    echo "## this script's own source, scanned before it is printed"
    echo "specs/0001 \"Rules for every phase\": a scan script runs the pre-P6d forms"
    echo "over its own source before printing itself, because no scan reads the log"
    echo "it writes, and a bare shape written by a COMMENT OF MY OWN in the part 2"
    echo "P3 scan script survived every form that phase ran and was committed in"
    echo "its scan.log. Planning ruled that a true finding. This block is the rule"
    echo "that came out of it, and the zero it reports is the claim that log could"
    echo "not make."
    self_n=$(f_pre "$0")
    echo "  pre-P6d forms over this script's source: count=$self_n"
    self_clean() { [ "$1" != error ] && [ "$1" = 0 ]; }
    structural "this script's own source writes no bare shape" "$(yn self_clean "$self_n")"
    # The control plants ONE shape, built by concatenation, in a COPY of the source,
    # so a count of 0 above means the form looked and found nothing rather than that
    # it could not look. The copy is never printed and never leaves the scratch
    # directory.
    cp "$0" "$T/self-copy"
    printf '# %s%s%s\n' '/mnt/' 'c/' 'Users/' >>"$T/self-copy"
    ctl_n=$(f_pre "$T/self-copy")
    echo "  the same form over a copy with one concatenated shape appended: count=$ctl_n"
    structural "the self-scan can report a hit, so the zero above means something" "$(yn [ "$ctl_n" = 1 ])"
    
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' scripts/counting.sh
    
    echo
    echo "## counting controls"
    counting_controls
    structural "every counting form behaves on a match, a miss and an unreadable file" "$(yn [ "$counting_controls_ok" = yes ])"
    
    echo
    echo "## environment"
    echo "grep: $G, $("$G" --version | head -1)"
    echo "EMEND_PRIVATE_DENYLIST set: no (unset by this script)"
    if [ ! -f "$DENY_FILE" ]; then echo "private denylist: MISSING"; exit 2; fi
    echo "private denylist: present, mode $(stat -c %a "$DENY_FILE")"
    LC_ALL=C "$G" -v -E '^[[:space:]]*(#|$)' "$DENY_FILE" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' >"$T/deny"
    NDENY=$(count_lines "$T/deny")
    echo "denylist entries: $NDENY (never printed)"
    denylist_usable() { [ "$NDENY" != error ] && [ "$NDENY" -gt 0 ]; }
    structural "the denylist is readable and not empty" "$(yn denylist_usable)"
    # The read and the comparison are two statements, not one and-chain: a failed
    # git show used to skip this check instead of failing it (independent check 1
    # of M1 part 2 P1, which is where the finding was made). patterns_match is
    # one function returning yes or no, and it reports no when the file cannot
    # be read.
    patterns_match() {
      git show "$C:scripts/privacy-patterns.txt" >"$T/patterns-at-c" 2>/dev/null || return 1
      cmp -s "$T/p6-patterns" "$T/patterns-at-c"
    }
    structural "this script's patterns equal scripts/privacy-patterns.txt at $C" \
      "$(yn patterns_match)"
    echo "command: git log --format='%H' --grep='^T0 P6d: narrow the three path patterns' -n 1"
    echo "  the narrowing commit resolves to $PRE_COMMIT; the pre-P6d patterns are read from its parent"
    structural "the three pre-P6d forms were read from git, not typed (lines read: $(count_lines "$T/pre-patterns"))" \
      "$(yn [ "$(count_lines "$T/pre-patterns")" = 3 ])"
    
    echo
    echo "## controls (the same command forms as the scans)"
    printf 'plain\nhas \303\251 byte\n' >"$T/c-nonascii"
    printf 'x \033[31mred\033[m\017 y\n' >"$T/c-ctrl"
    printf 'plain\ttab\r\n' >"$T/c-tabcr"
    printf 'has %s here\n' "$EMDASH" >"$T/c-emdash"
    printf 'subject\n\nClaude-Session: control\n' >"$T/c-session"
    printf 'x %s%s%s y\n' 'gh' 'p_' "$(rep a 24)" >"$T/c-p6"
    printf 'x %s%s%s%s y\n' '/mnt/' 'c/' 'Users/' 'bob' >"$T/c-p6-path"
    printf 'x %s%s%s y\n' '/mnt/' 'c/' 'Users/' >"$T/c-bare"
    printf 'x %s y\n' "$HOST" >"$T/c-host"
    printf 'x %s%s%s y\n' 'zq12' '@exam' 'ple.com' >"$T/c-email-bad"
    printf 'x %s noreply@anthropic.com zq@example.invalid y\n' "$ID_EMAIL" >"$T/c-email-ok"
    printf 'plain ascii only\nno session line\n' >"$T/c-clean"
    sed -n 1p "$T/deny" | awk '{ print "x " $0 " y" }' >"$T/c-deny"
    check_ctl "f_nonascii on a two-byte character" 2 f_nonascii "$T/c-nonascii"
    check_ctl "f_ctrl on ESC, ESC and SI" 3 f_ctrl "$T/c-ctrl"
    check_ctl "f_ctrl on tab and CR only" 0 f_ctrl "$T/c-tabcr"
    check_ctl "f_emdash on U+2014" 1 f_emdash "$T/c-emdash"
    check_ctl "f_emdash on another non-ASCII byte" 0 f_emdash "$T/c-nonascii"
    check_ctl "f_session on the trailer" 1 f_session "$T/c-session"
    check_ctl "f_p6 on a token shape" 1 f_p6 "$T/c-p6"
    check_ctl "f_p6 on a real path of the narrowed form" 1 f_p6 "$T/c-p6-path"
    check_ctl "f_p6 on a bare shape (P6d: must not match)" 0 f_p6 "$T/c-bare"
    check_ctl "f_pre on the same bare shape (the pre-P6d form does match)" 1 f_pre "$T/c-bare"
    printf 'x C%s%sUsers%s y\n' ':' '\' '\' >"$T/c-bare2"
    printf 'x %s%s y\n' '.claude' '/projects/' >"$T/c-bare3"
    check_ctl "f_pre1 on the bare /mnt form" 1 f_pre1 "$T/c-bare"
    check_ctl "f_pre2 on the bare drive-letter form" 1 f_pre2 "$T/c-bare2"
    check_ctl "f_pre3 on the bare projects form" 1 f_pre3 "$T/c-bare3"
    check_ctl "f_p6 on the bare drive-letter form (P6d: must not match)" 0 f_p6 "$T/c-bare2"
    check_ctl "f_p6 on the bare projects form (P6d: must not match)" 0 f_p6 "$T/c-bare3"
    check_ctl "f_host on a file naming this host" 1 f_host "$T/c-host"
    # f_home's controls. The positive fixture holds this machine's home
    # directory; the label says so without printing it. The two negatives are
    # the shapes that must NOT be flagged: the synthetic control path P1 and P2
    # already committed in their run logs, which names an account this machine
    # does not have, and the repo-relative form the T0 P6d ruling asks for,
    # which is the shape the corrected negative.log now prints on that line.
    printf 'x %s/crates/emend/src/lib.rs y\n' "$HOME" >"$T/c-home"
    printf 'x %s%s y\n' '/home/' 'someone/emend-testing/corpus/x.xlsx' >"$T/c-home-other"
    printf 'x %s y\n' '<repo>/crates/emend/src/package/tests.rs' >"$T/c-home-rel"
    printf 'x %s/%s/corpus/x.xlsx y\n' "$HOME" "$CORPUS_DIR" >"$T/c-home-corpus"
    printf 'x %s/%s/a and %s/crates/b y\n' "$HOME" "$CORPUS_DIR" "$HOME" >"$T/c-home-both"
    printf 'x %s/%s-notes/a y\n' "$HOME" "$CORPUS_DIR" >"$T/c-home-prefix"
    printf 'Private, in `%s/%s`. Nothing from it is committed.\n' "$HOME" "$CORPUS_DIR" >"$T/c-home-roadmap"
    check_ctl "f_home on a path under this machine's home directory" 1 f_home "$T/c-home"
    check_ctl "f_home on a home path of another account (must not match)" 0 f_home "$T/c-home-other"
    check_ctl "f_home on the repo-relative form (must not match)" 0 f_home "$T/c-home-rel"
    check_ctl "f_home on the documented corpus directory (exempt, must not match)" 0 f_home "$T/c-home-corpus"
    check_ctl "f_home on one line holding the corpus root AND a real leak" 1 f_home "$T/c-home-both"
    check_ctl "f_home on a sibling whose name merely starts with the corpus name" 1 f_home "$T/c-home-prefix"
    check_ctl "f_home on the committed sentence's shape, corpus root then punctuation" 0 f_home "$T/c-home-roadmap"
    check_ctl "f_host on the same path under this home directory" 0 f_host "$T/c-home"
    check_ctl "f_p6 on the same path (the narrowed patterns do not reach it)" 0 f_p6 "$T/c-home"
    check_ctl "f_pre on the same path (nor do the pre-P6d forms)" 0 f_pre "$T/c-home"
    check_ctl "f_deny on one denylist entry (not printed), under the whole-word form -i -w -F (change EQ)" 1 f_deny "$T/c-deny"
    # Change EQ (specs/0031 "Planning rulings during P1", ruling 6): the reason for
    # the form. The licence copy is read at the phase commit; only counts print.
    echo "  change EQ: the substring form -F over-matches one line of the Apache licence text, which decision 4 A copies into crates/emend/; specs/0031 ruling 6 gives f_deny the hook's whole-word form -i -w -F (counts only, nothing matched is printed)"
    if ! git show "$C:crates/emend/LICENSE-APACHE" >"$T/c-apache" 2>/dev/null; then echo "  crates/emend/LICENSE-APACHE at the phase commit: READ ERROR"; err=1; fi
    echo "  crates/emend/LICENSE-APACHE at the phase commit: $(wc -c <"$T/c-apache") bytes, sha256 $(sha256sum <"$T/c-apache" | cut -d' ' -f1)"
    check_ctl "f_deny_substring, the old substring form -F, on crates/emend/LICENSE-APACHE at the phase commit: its one hit, the reason for change EQ (ruling 6)" 1 f_deny_substring "$T/c-apache"
    check_ctl "f_deny, the whole-word form -i -w -F, on the same file (change EQ)" 0 f_deny "$T/c-apache"
    check_ctl "f_email on an address outside the allowlist" 1 f_email "$T/c-email-bad"
    # Change IC: an archive's entries reach the forms. Two generated zips, each
    # with one deflated entry: the first denylist entry (never printed), and a
    # two-byte character.
    make_zip() {
      python3 -I -B - "$1" "$2" <<'MKZIP'
    import sys, zipfile
    with zipfile.ZipFile(sys.argv[1], "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("xl/sharedStrings.xml", open(sys.argv[2], "rb").read())
    MKZIP
    }
    deny_entry_count() { archive_text "$T/c-zip-deny" "$T/c-zip-deny-text" >/dev/null && f_deny "$T/c-zip-deny-text"; }
    nonascii_entry_count() { archive_text "$T/c-zip-nonascii" "$T/c-zip-nonascii-text" >/dev/null && f_nonascii "$T/c-zip-nonascii-text"; }
    make_zip "$T/c-zip-deny" "$T/c-deny"
    make_zip "$T/c-zip-nonascii" "$T/c-nonascii"
    check_ctl "f_deny over the entries of a generated zip whose one entry holds the first denylist entry (change IC)" 1 deny_entry_count
    check_ctl "f_nonascii over the entries of a generated zip whose one entry holds a two-byte character (change IC)" 2 nonascii_entry_count
    check_ctl "f_email on only allowed addresses" 0 f_email "$T/c-email-ok"
    for f in $FORMS; do check_ctl "$f on a clean file" 0 "$f" "$T/c-clean"; done
    check_ctl "f_pre on a clean file" 0 f_pre "$T/c-clean"
    # The count's control (change J): two planted failing structural checks and one
    # passing one, inside a function whose local bad shadows the run's, count 2.
    struct_count_control() {
      local bad=0
      structural "planted failing check one" no >/dev/null
      structural "planted failing check two" no >/dev/null
      structural "planted passing check" yes >/dev/null
      [ "$bad" = 2 ]
    }
    structural "control: two planted failing structural checks count 2" "$(yn struct_count_control)"
    echo "controls: $([ "$ctl_fail" -eq 0 ] && echo "all as expected" || echo FAILED)"
    
    echo
    echo "## commits in the phase range"
    echo "command: git log --reverse --format='%H %s' $BASE..$C"
    git log --reverse --format='    %H %s' "$BASE..$C"
    
    echo
    echo "## files changed in the phase diff (contents at $C)"
    echo "command: git diff --name-status $BASE $C"
    git diff --name-status "$BASE" "$C" | sed 's/^/    /'
    nf=0; nread=0
    : >"$T/archives"
    while IFS= read -r f; do
      nf=$((nf + 1))
      if git show "$C:$f" >"$T/f" 2>/dev/null; then nread=$((nread + 1)); else echo "file $f: READ ERROR"; err=1; continue; fi
      echo "file $f (sha256 $(sha256sum <"$T/f" | cut -d' ' -f1))"
      if is_zip "$T/f"; then
        # Change IC: an archive, read as its entries' text and, for the forms
        # that do not judge bytes, as its raw bytes.
        printf '%s\t%s\n' "$f" "$(sha256sum <"$T/f" | cut -d' ' -f1)" >>"$T/archives"
        if nent=$(archive_text "$T/f" "$T/f-text"); then
          echo "  an archive (the zip signature): entries $nent, read as their uncompressed text through every form (change IC)"
          for form in $FORMS; do run "$form" "$T/f-text"; done
        else
          echo "  an archive (the zip signature) whose entries cannot be read: $nent"; err=1
        fi
        echo "  its raw bytes, through the forms that do not judge bytes (change IC)"
        for form in $RAW_FORMS; do run "$form" "$T/f"; done
      else
        for form in $FORMS; do run "$form" "$T/f"; done
      fi
    done < <(git diff --name-only --diff-filter=d "$BASE" "$C")
    git diff --name-only --diff-filter=d "$BASE" "$C" >"$T/difffiles"
    want=$(count_lines "$T/difffiles")
    files_complete() { [ "$want" != error ] && [ "$nf" -eq "$want" ] && [ "$nread" -eq "$want" ] && [ "$want" -gt 0 ]; }
    structural "files in the diff: $want; scanned: $nf; read: $nread" "$(yn files_complete)"
    # Change IC: every archive of the diff lies under tests/fixtures/ and is named
    # by its sha256 in tests/fixtures/README.md at the phase commit. Change IG:
    # this phase's archives are none.
    git show "$C:tests/fixtures/README.md" >"$T/fixtures-readme" 2>/dev/null || { echo "tests/fixtures/README.md at $C: READ ERROR"; err=1; }
    narch=0; narch_ok=0
    while IFS=$'\t' read -r f h; do
      narch=$((narch + 1))
      pa=$(yn archive_path_ok "$f"); na=$(yn archive_named "$h" "$T/fixtures-readme")
      echo "  archive in the diff: $f; under tests/fixtures/: $pa; its sha256 named in tests/fixtures/README.md: $na"
      if [ "$pa" = yes ] && [ "$na" = yes ]; then narch_ok=$((narch_ok + 1)); fi
    done <"$T/archives"
    echo "  archives in the diff: $narch; under tests/fixtures/ and named in its README: $narch_ok"
    structural "every archive in the phase diff lies under tests/fixtures/ and is named by its sha256 in tests/fixtures/README.md (change IC)" "$(yn [ "$narch" = "$narch_ok" ])"
    # archives_none <list>: the list of the diff's archives is empty (change IG).
    archives_none() { [ ! -s "$1" ]; }
    archives_some() { if archives_none "$1"; then return 1; else return 0; fi; }
    structural "the phase's diff holds no archive (change IG)" "$(yn archives_none "$T/archives")"
    printf 'tests/fixtures/x.xlsx\t%064d\n' 0 >"$T/c-archives"
    structural "control: the same form refuses a list holding one planted archive (change IG)" "$(yn archives_some "$T/c-archives")"
    git show "$C:tests/fixtures/openpyxl-ops.xlsx" >"$T/c-zip" 2>/dev/null || { echo "P1's fixture at $C: READ ERROR"; err=1; }
    structural "control: the signature test accepts P1's committed fixture, outside this range (changes IC and IG)" "$(yn is_zip "$T/c-zip")"
    structural "control: the signature test refuses a text file, tests/fixtures/README.md (change IC)" "$(yn not_zip "$T/fixtures-readme")"
    structural "control: the path check refuses an archive outside tests/fixtures/ (change IC)" "$(yn archive_path_refused records/x.xlsx)"
    structural "control: the path check refuses an archive in a directory below tests/fixtures/ (change IC)" "$(yn archive_path_refused tests/fixtures/sub/x.xlsx)"
    structural "control: the README check refuses a sha256 it does not name (change IC)" "$(yn archive_unnamed "$(printf '%064d' 0)" "$T/fixtures-readme")"
    
    echo
    echo "## commit messages in the phase range"
    # The Co-Authored-By check's controls (change C), before it is used.
    structural "control: the check accepts the Opus 5.5 line" "$(yn coauthor_ok "$COAUTHOR")"
    structural "control: the check refuses the Opus 5 line, which this range does not carry" "$(yn coauthor_refused "$COAUTHOR_OTHER")"
    structural "control: the check refuses a similar third line" "$(yn coauthor_refused 'Co-Authored-By: Claude Opus 5.1 (1M context) <noreply@anthropic.com>')"
    structural "control: the check refuses a session trailer" "$(yn coauthor_refused 'Claude-Session: control')"
    nm=0; nb=0
    for c in $(git rev-list "$BASE..$C"); do
      nm=$((nm + 1))
      if ! git cat-file commit "$c" >"$T/raw"; then echo "message $c: READ ERROR"; err=1; continue; fi
      sed '1,/^$/d' "$T/raw" >"$T/m"
      last=$(awk 'NF { l = $0 } END { print l }' "$T/m")
      echo "message $c"
      case "$last" in
        "$COAUTHOR") echo "  ends with the Opus 5.5 line"; nb=$((nb + 1)) ;;
      esac
      structural "  last non-empty line is the Co-Authored-By line this range carries" "$(yn coauthor_ok "$last")"
      for form in $FORMS; do run "$form" "$T/m"; done
    done
    NR_RANGE=$(git rev-list --count "$BASE..$C")
    messages_complete() { [ "$nm" -eq "$NR_RANGE" ] && [ "$nm" -gt 0 ]; }
    structural "messages scanned: $nm; commits in range: $NR_RANGE" "$(yn messages_complete)"
    echo "  messages ending with the Opus 5.5 line: $nb"
    split_complete() { [ "$nb" -eq "$nm" ]; }
    structural "the count sums to the messages scanned" "$(yn split_complete)"
    # Change AB (specs/0018 P2 verification ruling 5): each code commit's message
    # says that no log prints a count for it and the diff alone carries it.
    DIFF_ALONE='the diff alone carries what it changes'
    diff_alone_count() { git log -1 --format=%B "$1" | tr '\n' ' ' | tr -s ' ' | count_matches -F "$DIFF_ALONE" /dev/stdin; }
    ncode_said=0
    while IFS= read -r c; do
      n=$(diff_alone_count "$c")
      echo "  code commit $c: the sentence \"$DIFF_ALONE\" found $n time(s)"
      if [ "$n" != error ] && [ "$n" -ge 1 ]; then ncode_said=$((ncode_said + 1)); fi
    done <"$T/phase-code"
    # Change AJ: printed, not a structural check; AD below is the rule.
    echo "  code commits whose message says the diff alone carries what it changes: $ncode_said of $NCODE (information, change AJ)"
    printf 'subject\n\nA message with a count and no such sentence.\n' >"$T/c-msg"
    diff_alone_ctl() { tr '\n' ' ' <"$T/c-msg" | count_matches -F "$DIFF_ALONE" /dev/stdin; }
    check_ctl "the same count on a message without the sentence" 0 diff_alone_ctl
    printf 'subject\n\nNo log prints a count for this commit; the diff alone\ncarries what it changes.\n' >"$T/c-msg2"
    diff_alone_ctl2() { tr '\n' ' ' <"$T/c-msg2" | tr -s ' ' | count_matches -F "$DIFF_ALONE" /dev/stdin; }
    check_ctl "the same count on a message whose sentence wraps a line" 1 diff_alone_ctl2
    # Change AD (P3 verification ruling 2, G8): the count rule on EVERY commit of
    # the phase, the doc commit included, by the gate log's form (its change Y2).
    # counts_in prints the numbers left in the body (the trailer dropped) once
    # identifiers are removed: words holding a slash (paths), tokens such as P4, M2
    # or F20, and the number after "ruling", "decision", "part", "phase" or
    # "section", with any "to" or "and" range after it; what is left, a whole-word
    # number in digits or a number word to twenty, is a count.
    COUNT_SENTENCE='No log prints a count for this commit; the diff alone carries what it changes.'
    says_diff_alone() { tr '\n' ' ' <"$1" | tr -s ' ' | LC_ALL=C "$G" -qF "$COUNT_SENTENCE"; }
    counts_in() {
      python3 -I -B - "$1" <<'COUNTS'
    import re, sys
    text = open(sys.argv[1]).read()
    body = "\n".join(l for l in text.split("\n") if not re.match(r"^Co-Authored-By:", l))
    body = " ".join(body.split())
    body = " ".join(w for w in body.split(" ") if "/" not in w)
    body = re.sub(r"\b[A-Z][0-9]+\b", " ", body)
    num = r"(?:[0-9]+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)"
    body = re.sub(r"\b(?:rulings?|decisions?|parts?|phases?|sections?)\b[^.;:]*?\b" + num + r"\b(?:,? (?:to|and) " + num + r"\b)*", " ", body, flags=re.I)
    for m in re.finditer(r"\b" + num + r"\b", body, flags=re.I):
        print(m.group(0))
    COUNTS
    }
    states_no_count() { [ -z "$(counts_in "$1")" ]; }
    count_rule_ok() { says_diff_alone "$1" || states_no_count "$1"; }
    count_rule_refused() { if count_rule_ok "$1"; then return 1; else return 0; fi; }
    nrule=0; nrule_ok=0
    for c in $(git rev-list --reverse "$BASE..$C"); do
      nrule=$((nrule + 1))
      git log -1 --format=%B "$c" >"$T/msg-rule"
      found=$(counts_in "$T/msg-rule" | tr '\n' ' ')
      sentence=$(yn says_diff_alone "$T/msg-rule")
      echo "  $c: counts left after the identifiers: ${found:-none}; the diff-alone sentence: $sentence"
      r=$(yn count_rule_ok "$T/msg-rule")
      structural "  its message states no count or says the diff alone carries its counts (change AD)" "$r"
      if [ "$r" = yes ]; then nrule_ok=$((nrule_ok + 1)); fi
    done
    structural "every commit of the range went through the count rule: $nrule of $NR_RANGE; passed: $nrule_ok" \
      "$(yn [ "$nrule" = "$NR_RANGE" ])"
    printf 'M6 part 4 P3: x\n\nThe rulings during P1, 1 to 3, and decision 1 A; specs/0018-rows.md.\n\n%s\n' "$COAUTHOR" >"$T/c-rule-ids"
    printf 'M6 part 4 P3: x\n\nAdds three tests and 14 lines.\n\n%s\n' "$COAUTHOR" >"$T/c-rule-count"
    printf 'M6 part 4 P3: x\n\nAdds three tests. No log prints a count for this commit; the\ndiff alone carries what it changes.\n\n%s\n' "$COAUTHOR" >"$T/c-rule-both"
    structural "control: count_rule_ok accepts a message whose numbers are identifiers and a trailer" "$(yn count_rule_ok "$T/c-rule-ids")"
    structural "control: count_rule_ok refuses a message stating counts without the sentence" "$(yn count_rule_refused "$T/c-rule-count")"
    structural "control: count_rule_ok accepts the same counts beside the sentence" "$(yn count_rule_ok "$T/c-rule-both")"
    counts_in_lines() { counts_in "$1" | count_lines /dev/stdin; }
    check_ctl "counts_in finds the two counts of the refused message, same command form" 2 counts_in_lines "$T/c-rule-count"
    
    echo
    echo "## the sibling logs, the check answers and the records (a log cannot scan itself)"
    echo "The five sibling logs are always present: this phase writes gate, test,"
    echo "negative, size and run logs (changes IF, KA and KJ). It writes no self-test log because it changed"
    echo "no gate file, which is measured below rather than assumed. The check"
    echo "answers are present only"
    echo "in the FINAL run of this"
    echo "scan, which specs/0001 requires to be the last log written; the count"
    echo "below says which run this is."
    echo "command: wc -c and sha256sum over each file scanned below"
    nl=0; nans=0
    echo "  the sibling logs, listed once: $SIBLINGS ($NSIB)"
    for f in $SIBLINGS; do
      if [ ! -f "$f" ]; then echo "file $f: MISSING"; bad=$((bad + 1)); continue; fi
      nl=$((nl + 1))
      echo "scanned $f ($(wc -c <"$f") bytes, sha256 $(sha256sum "$f" | cut -d' ' -f1))"
      for form in $FORMS; do run "$form" "$f"; done
    done
    structural "sibling logs scanned: $nl (expected $NSIB, the list's length; scan.log cannot scan itself)" "$(yn [ "$nl" -eq "$NSIB" ])"
    # Changes AI and AN: every sibling log pins the spec's hash OUTSIDE its printed
    # scripts, counted by the same form as its controls. outside_scripts drops
    # every line from a heading "## script..." up to the next "## " heading.
    outside_scripts() { awk '/^## / { inside = ($0 ~ /^## script/) } !inside { print }' "$1"; }
    pin_count() { outside_scripts "$1" | count_matches -F "$SPEC_PIN" /dev/stdin; }
    printf 'a log that names no hash\n' >"$T/c-pin-none"
    printf 'spec sha256 %s\n' "$SPEC_PIN" >"$T/c-pin-one"
    printf 'header\n## script\n    SPEC=%s\n## the next block\nno hash here\n' "$SPEC_PIN" >"$T/c-pin-script"
    printf 'spec sha256 %s\n## script that wrote this log\n    SPEC=%s\n## after\n' "$SPEC_PIN" "$SPEC_PIN" >"$T/c-pin-both"
    check_ctl "pin_count on a file without the spec's hash" 0 pin_count "$T/c-pin-none"
    check_ctl "pin_count on a file carrying it once" 1 pin_count "$T/c-pin-one"
    check_ctl "pin_count on a log whose only copy is inside its printed script (change AN)" 0 pin_count "$T/c-pin-script"
    check_ctl "pin_count on a log with a copy outside its printed script and one inside" 1 pin_count "$T/c-pin-both"
    npinned=0
    for f in $SCRIPT_LOGS; do
      [ -f "$f" ] || continue
      n=$(pin_count "$f")
      echo "  lines of $f carrying the spec's hash outside its printed scripts: $n"
      if [ "$n" != error ] && [ "$n" -ge 1 ]; then npinned=$((npinned + 1)); fi
    done
    structural "every log that prints a script pins the spec's hash: $npinned of $NSCRIPT (changes AI, BT and IF)" "$(yn [ "$npinned" -eq "$NSCRIPT" ])"
    # The self-test log is absent, and that is a PROPERTY of the phase diff and
    # not an assumption: specs/0001 asks for one only from a phase that changes a
    # gate file (changes DM, DT and FT). The ten names are the spec's, scored
    # against the diff this scan already read; the phase changes none of them.
    # Controls: the same search finds a name the diff does hold, and does not
    # find a gate file the diff does not hold.
    cat >"$T/gate-files" <<'EOF'
    scripts/check.sh
    scripts/privacy.sh
    scripts/privacy-patterns.txt
    scripts/privacy-identity.txt
    scripts/sys-allowlist.txt
    scripts/install-hooks.sh
    scripts/counting.sh
    scripts/gate-self-test.sh
    .gitignore
    .github/workflows/ci.yml
    EOF
    gate_touched=0
    while IFS= read -r g; do
      hit=$(count_matches -Fx "$g" "$T/difffiles")
      if [ "$hit" = error ]; then err=1; continue; fi
      if [ "$hit" -gt 0 ]; then
        echo "  gate file in the phase diff: $g"
        gate_touched=$((gate_touched + hit))
      fi
    done <"$T/gate-files"
    echo "  gate files checked against the diff: $(count_lines "$T/gate-files"); of them in it: $gate_touched"
    structural "no gate file is in the phase diff, so no self-test log is due (changes DM, DT and FT)" \
      "$(yn [ "$gate_touched" = 0 ])"
    FIRST_DIFF=$(sed -n '1p' "$T/difffiles")
    first_hit=$(count_matches -Fx "$FIRST_DIFF" "$T/difffiles")
    echo "  control: a file that IS in the diff, taken from the diff, is found $first_hit time(s)"
    structural "control: the same search finds a name the diff does hold" \
      "$(yn [ "$first_hit" -ge 1 ])"
    absent_hit=$(count_matches -Fx scripts/counting.sh "$T/difffiles")
    echo "  control: a gate file the phase does not change, scripts/counting.sh, is found $absent_hit time(s)"
    structural "control: the same search does not find a gate file the diff does not hold (changes DM, DT and FT)" \
      "$(yn [ "$absent_hit" = 0 ])"
    structural "no self-test log is present in this phase's log directory (changes DM, DT and FT)" \
      "$(yn [ ! -f "$LOGDIR"/self-test.log ])"
    for f in "$LOGDIR"/independent-check-*.md; do
      [ -f "$f" ] || continue
      nans=$((nans + 1))
      echo "scanned $f ($(wc -c <"$f") bytes, sha256 $(sha256sum "$f" | cut -d' ' -f1))"
      for form in $FORMS; do run "$form" "$f"; done
    done
    echo "check answers scanned: $nans"
    # Change II: the logs README, through the same forms.
    if [ -f "$LOGDIR"/README.md ]; then
      echo "scanned $LOGDIR/README.md ($(wc -c <"$LOGDIR"/README.md) bytes, sha256 $(sha256sum "$LOGDIR"/README.md | cut -d' ' -f1))"
      for form in $FORMS; do run "$form" "$LOGDIR"/README.md; done
    fi
    # Changes IK and IO: the logs README is optional in this phase; its presence is printed.
    echo "  the logs README in the log directory: $([ -f "$LOGDIR"/README.md ] && echo "present, scanned above" || echo "absent (optional, changes IK and IO)")"
    # None before the checks, one or two in the final run (change C): at most two
    # independent checks per phase.
    answers_count_ok() { if [ "$STAGE" = pre-check ]; then [ "$nans" -eq 0 ]; else [ "$nans" -ge 1 ] && [ "$nans" -le 2 ]; fi; }
    structural "check answers present: $nans (stage $STAGE: none before the checks, one or two in the final run)" "$(yn answers_count_ok)"
    nrec=0
    for f in $(phase_records); do
      [ -f "$f" ] || continue
      nrec=$((nrec + 1))
      echo "scanned $f ($(wc -c <"$f") bytes, sha256 $(sha256sum "$f" | cut -d' ' -f1))"
      for form in $FORMS; do run "$form" "$f"; done
    done
    echo "records scanned: $nrec"
    # A .md and a .txt per pair stem and a .md per single stem (changes CA, CO,
    # EY and IF), the count derived above.
    structural "the phase's records were scanned: $nrec (expected $NREC_WANT, changes CO, EY and IF)" "$(yn [ "$nrec" -eq "$NREC_WANT" ])"
    # No other record named by this phase's short sha stands in the records
    # directory, so a record of a stem the list does not know (or a second date)
    # cannot pass unseen (changes BY, CA and IF).
    nsha_all=0
    for f in "$RECDIR"/*-"$SHORT".md "$RECDIR"/*-"$SHORT".txt; do [ -f "$f" ] && nsha_all=$((nsha_all + 1)); done
    echo "  files in the records directory whose name ends in -$SHORT.md or -$SHORT.txt: $nsha_all"
    structural "every record named by this phase's short sha is one of the phase's records (changes BY, CA and IF)" "$(yn [ "$nsha_all" -eq "$nrec" ])"
    
    echo
    echo "## planning's uncommitted files, as they stand (change D)"
    echo "Part 5 P2 ruling 8: planning's files modified and uncommitted, should any stand,"
    echo "are planning's text, not this phase's; each is scanned here so a hit is"
    echo "reported before a later commit carries it."
    echo "command: git status --porcelain (every line printed), and of them the lines naming specs/0041-chart-text-and-edits.md, specs/0040-analytic-chart-elements.md or ROADMAP.md as modified (changes FM, FU, IE, IT, IX, JF, JQ and KC)"
    git status --porcelain | sed 's/^/    /'
    git status --porcelain | LC_ALL=C "$G" -E '^ M (specs/0041-chart-text-and-edits[.]md|specs/0040-analytic-chart-elements[.]md|ROADMAP[.]md)$' | cut -c4- >"$T/planning-files"
    nplan=0
    while IFS= read -r f; do
      nplan=$((nplan + 1))
      echo "scanned $f as it stands in the working tree ($(wc -c <"$f") bytes, sha256 $(sha256sum "$f" | cut -d' ' -f1))"
      for form in $FORMS; do run "$form" "$f"; done
      n=$(f_pre "$f")
      echo "  pre-P6d forms in $f: count=$n"
      if [ "$n" = error ]; then err=1; elif [ "$n" != 0 ]; then hits=$((hits + n)); fi
    done <"$T/planning-files"
    echo "planning's modified, uncommitted files scanned: $nplan"
    # Change AQ: planning's files are committed in this phase's doc commit, so none
    # stands modified, and the tree holds nothing but this phase's log directory
    # and its records (changes EY and FX).
    # only_spec <listing> <count>: the listing of planning files modified names
    # the spec alone (changes AV and DX), a named function so the control below
    # runs it in the same form (change AY).
    only_spec() { [ "$2" = 1 ] && [ "$(cat "$1")" = "$SPEC" ]; }
    printf '%s\n%s\n' "$SPEC" ROADMAP.md >"$T/c-planning-two"
    only_spec_ctl() { if only_spec "$T/c-planning-two" 2; then return 1; else return 0; fi; }
    structural "control: the planning-file check refuses a listing with another planning file modified (change AY)" "$(yn only_spec_ctl)"
    # Change BB (specs/0019 P4 verification ruling 7): a ONE-line listing, so the
    # count clause passes and only the content comparison can refuse it.
    printf '%s\n' ROADMAP.md >"$T/c-planning-other"
    only_spec_other_ctl() { if only_spec "$T/c-planning-other" 1; then return 1; else return 0; fi; }
    structural "control: the planning-file check refuses a one-line listing naming a file that is not the spec, on its content (change BB)" "$(yn only_spec_other_ctl)"
    printf '%s\n' "$SPEC" >"$T/c-planning-spec"
    structural "control: the same check accepts a one-line listing naming the spec (change BB)" "$(yn only_spec "$T/c-planning-spec" 1)"
    # Change IX: with PLANNING_ROADMAP given too, the two planning files modified
    # are exactly the spec and ROADMAP.md, read sorted, with controls both ways.
    spec_and_roadmap() { [ "$2" = 2 ] && [ "$(LC_ALL=C sort "$1" | tr '\n' ' ')" = "ROADMAP.md $SPEC " ]; }
    structural "control: the two-file check accepts a listing of the spec, then ROADMAP.md (change IX)" "$(yn spec_and_roadmap "$T/c-planning-two" 2)"
    printf 'specs/0040-analytic-chart-elements.md\n%s\n' "$SPEC" >"$T/c-planning-0040"
    two_other_ctl() { if spec_and_roadmap "$T/c-planning-0040" 2; then return 1; else return 0; fi; }
    structural "control: the two-file check refuses a two-line listing of specs/0040 and the spec, on its content (changes IX, JF, JQ and KC)" "$(yn two_other_ctl)"
    two_spec_ctl() { if spec_and_roadmap "$T/c-planning-spec" 1; then return 1; else return 0; fi; }
    structural "control: the two-file check refuses a one-line listing naming the spec (change IX)" "$(yn two_spec_ctl)"
    if [ -n "$PLANNING_SPEC" ] && [ -n "$PLANNING_ROADMAP" ]; then
      structural "the two planning files modified and uncommitted are ROADMAP.md at PLANNING_ROADMAP and the spec at PLANNING_SPEC (change IX)" "$(yn spec_and_roadmap "$T/planning-files" "$nplan")"
    elif [ -n "$PLANNING_SPEC" ]; then
      structural "the one planning file modified and uncommitted is the spec at PLANNING_SPEC (changes AV, DX and EB)" "$(yn only_spec "$T/planning-files" "$nplan")"
    else
      structural "no planning file stands modified and uncommitted (change AQ)" "$(yn [ "$nplan" = 0 ])"
    fi
    OURS_RE='^[?][?] records/logs/m6p4-p3/$|^[?][?] records/(m6p4-p3-chartedit|m6p4-p3-charttext|m6p4-open)-[0-9]{4}-[0-9]{2}-[0-9]{2}-'"$SHORT"'[.](md|txt)$|^[?][?] records/(size-m6p4|api-review-m6p4)-[0-9]{4}-[0-9]{2}-[0-9]{2}-'"$SHORT"'[.]md$'
    if [ -n "$PLANNING_SPEC" ]; then OURS_RE="$OURS_RE|^ M specs/0041-chart-text-and-edits[.]md\$"; fi
    if [ -n "$PLANNING_ROADMAP" ]; then OURS_RE="$OURS_RE|^ M ROADMAP[.]md\$"; fi
    git status --porcelain >"$T/status"
    nstatus=$(count_lines "$T/status")
    nours=$(count_matches -E "$OURS_RE" "$T/status")
    # Change AY: the labels read as the tree stands (change IY: the ROADMAP too).
    OURS_WHAT="the untracked records/logs/m6p4-p3/ and the phase's records"
    if [ -n "$PLANNING_SPEC" ]; then OURS_WHAT="$OURS_WHAT, or the modified specs/0041-chart-text-and-edits.md"; fi
    if [ -n "$PLANNING_ROADMAP" ]; then OURS_WHAT="$OURS_WHAT, or the modified ROADMAP.md"; fi
    echo "  status lines: $nstatus; of them $OURS_WHAT: $nours"
    structural "the working tree holds nothing but $OURS_WHAT (changes AQ, IU, IY, JG, JK, JR, KA, KD and KJ)" "$(yn [ "$nstatus" = "$nours" ])"
    printf '?? records/logs/m6p4-p3/\n?? records/m6p4-p3-chartedit-2026-01-01-%s.txt\n?? records/m6p4-p3-charttext-2026-01-01-%s.md\n?? records/size-m6p4-2026-01-01-%s.md\n?? records/api-review-m6p4-2026-01-01-%s.md\n?? records/logs/m6p4-p2/\n?? records/m6p4-p2-chartedit-2026-01-01-%s.md\n?? records/size-m6p4-2026-01-01-%s.txt\n?? records/m6p4-p3-chartaxis-2026-01-01-%s.md\n M crates/emend/src/lib.rs\n?? records/logs/m6p4-p3x/\n?? records/m6p4-p3-chartedit-2026-01-01-0000000.md\n' "$SHORT" "$SHORT" "$SHORT" "$SHORT" "$SHORT" "$SHORT" "$SHORT" >"$T/c-status"
    check_ctl "the same pattern over a listing with the log directory, two of the phase's sample records, the size record and the API record, and seven foreign lines (P2's log directory, P2's edit record stem, a .txt beside the size record, a sample stem the list does not hold, a modified source, a sibling directory, a record of another sha) (changes EY, FS, IU, IY, JG, JK, JR, KA, KD and KJ)" 5 count_matches -E "$OURS_RE" "$T/c-status"
    
    echo
    echo "## the pre-P6d bare-shape control over this phase's files"
    echo "The narrowed patterns are blind to a bare shape by design, so this scan's"
    echo "own zero hits cannot establish that no bare shape was committed. The three"
    echo "pre-P6d forms are run here for that, with the controls above."
    # EVERY file in the phase diff, not a hand-listed subset. An earlier version
    # named four sources and the runner, so three files the phase ADDS
    # (crates/emend/Cargo.toml, tools/emend-copy/Cargo.toml and this spec) were
    # seen only by the narrowed live patterns, which specs/0001 says are blind to
    # a bare shape by design. Both independent checks of an earlier phase
    # found it: the omission was exactly the gap this control exists to
    # close.
    pre_hits=0; pre_err=0; pre_files=0
    # The diff's files are read at the phase commit.
    while IFS= read -r f; do
      if ! git show "$C:$f" >"$T/pre-f" 2>/dev/null; then echo "  $f at $C: READ ERROR"; pre_err=1; continue; fi
      pre_files=$((pre_files + 1))
      if is_zip "$T/pre-f"; then
        # Change IC: an archive's entries' text.
        if archive_text "$T/pre-f" "$T/pre-t" >/dev/null; then n=$(f_pre "$T/pre-t"); else n=error; fi
        echo "  pre-P6d forms in $f at the phase commit, read as its entries' text (change IC): count=$n"
      else
        n=$(f_pre "$T/pre-f")
        echo "  pre-P6d forms in $f at the phase commit: count=$n"
      fi
      if [ "$n" = error ]; then pre_err=1; elif [ "$n" != 0 ]; then pre_hits=$((pre_hits + n)); fi
    done <"$T/difffiles"
    : >"$T/pre-targets"
    for extra in $SIBLINGS \
                 "$LOGDIR"/independent-check-1.md \
                 "$LOGDIR"/independent-check-2.md \
                 "$LOGDIR"/README.md \
                 $(phase_records); do
      [ -f "$extra" ] && printf '%s\n' "$extra" >>"$T/pre-targets"
    done
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      pre_files=$((pre_files + 1))
      n=$(f_pre "$f")
      echo "  pre-P6d forms in $f: count=$n"
      if [ "$n" = error ]; then pre_err=1; elif [ "$n" != 0 ]; then pre_hits=$((pre_hits + n)); fi
    done <"$T/pre-targets"
    echo "  files run through the pre-P6d forms: $pre_files"
    ndiff=$(count_lines "$T/difffiles")
    pre_covers_diff() { [ "$ndiff" != error ] && [ "$pre_files" -ge "$ndiff" ]; }
    structural "every file in the phase diff went through the bare-shape control (diff files: $ndiff)" \
      "$(yn pre_covers_diff)"
    pre_clean() { [ "$pre_hits" -eq 0 ] && [ "$pre_err" -eq 0 ]; }
    structural "bare shapes found by the pre-P6d forms: $pre_hits (expect 0); errors: $pre_err" "$(yn pre_clean)"
    
    echo
    echo "## the three shapes specs/0001 forbids, over every printed script"
    # The part 1 P3 repair-round rulings (specs/0008-zip-layer.md) require the
    # phase's scan log to run this itself: planning found 31 instances of the form
    # across six phases that no check had caught, because the rule had been
    # enforced by reading rather than by a grep. The form calls the yn or is helper
    # on a test and then chains another test after it with an and- or or-operator
    # inside ONE command substitution; the helper runs its arguments, the operator
    # binds outside the substitution, and only the first test is ever captured.
    #
    # The pattern is ASSEMBLED here rather than written out, so this script's own
    # printed text cannot trip the check it performs. It is unanchored, as the
    # ruling words it.
    # The pattern and both control fixtures are ASSEMBLED from pieces, so the
    # literal form never appears in this script's own text and the check cannot
    # trip on the script that performs it.
    #
    # THE THIRD FORM is the one specs/0001 gained from part 3 P1 ruling 11: the
    # helper is handed an ASSIGNMENT where the command should be, as in a check
    # that wanted a locale set for one search. The shell looks for a command named
    # by the assignment, fails, and the check reports as-expected whatever the
    # file held: the same defect as the leading bang, reached by another spelling.
    # It was part 3 P1's own run script that tripped over it, and neither of the two
    # older forms could see it.
    # The three patterns and their count functions are defined in the first
    # block after the opening lines (change E) and used here unchanged.
    echo "  the three patterns, as the first block printed them, are used again here"
    # Four controls, all through the same command forms: a fixture holding each
    # forbidden form must score 1, and a fixture doing the same work correctly,
    # with a named function and with the negating helper, must score 0 for both.
    printf 'x %s(is [ a = a ] && [ b = b ])\n' '$' >"$T/c-shape"
    printf 'x %s(is %s f a b)\n' '$' '!' >"$T/c-bang"
    printf 'x %s(isnot %s%s /usr/bin/grep -q x f)\n' '$' 'LC_ALL' '=C' >"$T/c-assign"
    printf 'ok() { [ a = a ] || return 1; [ b = b ] || return 1; }\nnote "x" "%s(is ok)"\nnote "y" "%s(isnot ok)"\n' '$' '$' >"$T/c-shape-ok"
    check_ctl "f_shape on a fixture holding the chained form" 1 f_shape "$T/c-shape"
    check_ctl "f_shape on a named function doing the same work" 0 f_shape "$T/c-shape-ok"
    check_ctl "f_bang on a fixture holding the leading-bang form" 1 f_bang "$T/c-bang"
    check_ctl "f_bang on a named function and the negating helper" 0 f_bang "$T/c-shape-ok"
    # And the cross controls, so neither pattern is silently matching the other's
    # form: each scores 0 on the other's fixture.
    check_ctl "f_assign on a fixture holding the assignment-prefix form" 1 f_assign "$T/c-assign"
    check_ctl "f_assign on a named function doing the same work" 0 f_assign "$T/c-shape-ok"
    # The cross controls, so no pattern is silently matching another's form: each
    # scores 0 on the other two fixtures. Six pairs, all through the same command
    # form as the scans themselves.
    check_ctl "f_shape on the leading-bang fixture" 0 f_shape "$T/c-bang"
    check_ctl "f_bang on the chained fixture" 0 f_bang "$T/c-shape"
    check_ctl "f_shape on the assignment-prefix fixture" 0 f_shape "$T/c-assign"
    check_ctl "f_bang on the assignment-prefix fixture" 0 f_bang "$T/c-assign"
    check_ctl "f_assign on the chained fixture" 0 f_assign "$T/c-shape"
    check_ctl "f_assign on the leading-bang fixture" 0 f_assign "$T/c-bang"
    shape_hits=0; shape_err=0; shape_files=0
    # One place where a count is taken, so no file goes through two of the three
    # forms and not the third.
    shape_scan() {
      local f=$1 n b a
      n=$(f_shape "$f")
      b=$(f_bang "$f")
      a=$(f_assign "$f")
      echo "  the forbidden shapes in $2: chained=$n leading-bang=$b assignment=$a"
      shape_files=$((shape_files + 1))
      for one in "$n" "$b" "$a"; do
        if [ "$one" = error ]; then shape_err=1
        elif [ "$one" != 0 ]; then shape_hits=$((shape_hits + one)); fi
      done
    }
    # Every printed script goes through all three greps, which for this phase
    # means FOUR logs: gate, test, negative and run, each of which prints a
    # script of its own (change S; change HL). The count is
    # asserted below so a list left at an older phase's length would fail.
    for f in $SCRIPT_LOGS; do
      [ -f "$f" ] || { echo "  $f: MISSING"; bad=$((bad + 1)); continue; }
      shape_scan "$f" "$f"
    done
    # This script's own source, which no log can grep while it is being written:
    # scan.log prints this script, so "every printed script" is only true if this
    # file goes through the same three greps as the rest. An independent check of
    # an earlier phase found the loop above covered the sibling logs and the check
    # answers and stopped there, while the heading claimed every printed script. The pre-P6d
    # self-scan higher up is a different form and does not stand in for these three.
    shape_scan "$0" "this script's own source"
    
    # The check answers are scripts' readers, not scripts, but they quote them, so
    # they go through the same greps when they exist.
    # THE CHECK ANSWERS ARE PROSE, and prose about these very forms. An answer
    # that says which form it looked for, or quotes a line of a log that carries a
    # helper call, matches the pattern as surely as a script would, and a match
    # there is not a defect: nothing in an answer is executed. So the answers go
    # through all three greps, their counts are printed, and each matching LINE
    # NUMBER is named so a reader can look at it, but they are not added to the
    # hit total. specs/0001 puts the forms over the phase's printed SCRIPTS, which
    # is what the loop above covers, this script's own source included.
    ans_files=0
    ans_hits=0
    for f in "$LOGDIR"/independent-check-*.md; do
      [ -f "$f" ] || continue
      ans_files=$((ans_files + 1))
      n=$(f_shape "$f")
      b=$(f_bang "$f")
      a=$(f_assign "$f")
      echo "  the forms QUOTED in $f: chained=$n leading-bang=$b assignment=$a"
      for one in "$n" "$b" "$a"; do
        if [ "$one" = error ]; then err=1
        elif [ "$one" != 0 ]; then ans_hits=$((ans_hits + one)); fi
      done
      if [ "$n" != 0 ] && [ "$n" != error ]; then
        echo "    lines quoting the chained form: $(LC_ALL=C "$G" -nE "$SHAPE" "$f" | cut -d: -f1 | tr '\n' ' ')"
      fi
      if [ "$b" != 0 ] && [ "$b" != error ]; then
        echo "    lines quoting the leading-bang form: $(LC_ALL=C "$G" -nE "$BANG" "$f" | cut -d: -f1 | tr '\n' ' ')"
      fi
      if [ "$a" != 0 ] && [ "$a" != error ]; then
        echo "    lines quoting the assignment form: $(LC_ALL=C "$G" -nE "$ASSIGN" "$f" | cut -d: -f1 | tr '\n' ' ')"
      fi
    done
    echo "  check answers run through the three greps: $ans_files; forms quoted in them: $ans_hits"
    # The answers are scanned, so a reader is told whether the greps looked at
    # them at all; the count above is a quotation count and not a hit.
    answers_scanned() { if [ "$STAGE" = pre-check ]; then [ "$ans_files" -eq 0 ]; else [ "$ans_files" -ge 1 ]; fi; }
    structural "the check answers went through all three greps as prose (stage $STAGE; none before the checks)" \
      "$(yn answers_scanned)"
    # Change IV: the phase does not change README.md, so change IQ's
    # README-as-prose block is dropped.
    # And the records, which quote figures out of the scripts and are files the
    # phase commits like any other (changes B, DQ, EJ and EV).
    for f in $(phase_records); do
      [ -f "$f" ] || continue
      shape_scan "$f" "$f"
    done
    echo "  files run through the three shape greps: $shape_files"
    # The sibling logs and this script are always among them, so a list that lost one
    # would show here rather than in a smaller total nobody reads.
    shape_covered() { [ "$shape_files" -ge "$((NSCRIPT + 1))" ]; }
    structural "every printed script went through all three greps: $shape_files files" \
      "$(yn shape_covered)"
    shape_clean() { [ "$shape_hits" -eq 0 ] && [ "$shape_err" -eq 0 ]; }
    structural "instances of any of the three forbidden shapes: $shape_hits (expect 0); errors: $shape_err" \
      "$(yn shape_clean)"
    
    echo
    echo "## every recursive removal in a printed script is the ruled form (change CC)"
    echo "specs/0024 \"Planning rulings during P2\" ruling 1 (committed at M3 part 2 P3's doc commit; change CI):"
    echo "a script removes recursively only a directory it created in that run, and a"
    echo "script written or changed from P2 on writes the target as a quoted"
    echo "\${NAME:?} expansion, alone or with a path after it inside the quotes; the"
    echo "committed scripts' existing forms stand. Each removal written as a command"
    echo "is classified ruled, standing (a committed scripts/ line, outside a printed"
    echo "script block) or unruled; unruled must be 0. Lines are named by number,"
    echo "never printed."
    # The committed scripts' lines at the phase commit, leading space dropped: the
    # standing forms.
    : >"$T/standing"
    while IFS= read -r sf; do
      git show "$C:$sf" 2>/dev/null | sed 's/^[[:space:]]*//' >>"$T/standing"
    done < <(git ls-tree -r --name-only "$C" scripts/)
    echo "  committed scripts under scripts/ read for the standing forms: $(git ls-tree -r --name-only "$C" scripts/ | wc -l); lines: $(count_lines "$T/standing")"
    # rmrf_classify <file> <mode>: prints "ruled standing unruled" and, on a second
    # line, the unruled line numbers; mode "source" admits no standing line.
    rmrf_classify() {
      python3 -I -B - "$1" "$T/standing" "$2" <<'RMRF'
    import re, sys
    path, standing_path, mode = sys.argv[1], sys.argv[2], sys.argv[3]
    standing = set(l.rstrip("\n") for l in open(standing_path, errors="replace"))
    word = "rm" + " -" + "rf"
    cmd = re.compile(re.escape(word) + r"(?: --)?((?: +[\"$][^ ;|&)']*)+)")
    ok = re.compile(r'^"\$\{[A-Za-z_][A-Za-z0-9_]*:\?\}(/[^"]*)?"$')
    ruled = kept = 0
    bad = []
    inside = False
    for n, line in enumerate(open(path, errors="replace"), 1):
        line = line.rstrip("\n")
        if line.startswith("## "):
            inside = line.startswith("## script")
        for m in cmd.finditer(line):
            targets = m.group(1).split()
            if all(ok.match(t) for t in targets):
                ruled += 1
            elif mode == "log" and not inside and line.lstrip() in standing:
                kept += 1
            else:
                bad.append(str(n))
    print(ruled, kept, len(bad))
    print(" ".join(bad))
    RMRF
    }
    rmrf_unruled() { rmrf_classify "$1" "$2" | sed -n 1p | cut -d' ' -f3; }
    rmrf_standing() { rmrf_classify "$1" "$2" | sed -n 1p | cut -d' ' -f2; }
    # The fixtures, the command word built from pieces so this source spells no
    # removal outside the ruled form.
    RW="rm -""rf"
    printf '## script\n    %s "$T"\n' "$RW" >"$T/c-rm-bare"
    printf '## script\n    trap '"'"'%s "${T:?}"'"'"' EXIT\n    %s "${B:?}/x"\n' "$RW" "$RW" >"$T/c-rm-ruled"
    printf '## the shared counting library this log sources\n      %s "$d"\n' "$RW" >"$T/c-rm-lib"
    printf '## script\n      %s "$d"\n' "$RW" >"$T/c-rm-lib-inside"
    printf '## script\n    %s "${A:?}" "$B/x"\n' "$RW" >"$T/c-rm-mixed"
    printf '## script\n    # the rule: no `%s` on anything pre-existing\n' "$RW" >"$T/c-rm-prose"
    check_ctl "rmrf_unruled on an unquoted-expansion target in a script block" 1 rmrf_unruled "$T/c-rm-bare" log
    check_ctl "rmrf_unruled on ruled single and path targets" 0 rmrf_unruled "$T/c-rm-ruled" log
    check_ctl "rmrf_standing on the counting library's own line outside a script block" 1 rmrf_standing "$T/c-rm-lib" log
    check_ctl "rmrf_unruled on the same line outside a script block" 0 rmrf_unruled "$T/c-rm-lib" log
    check_ctl "rmrf_unruled on the same line inside a script block (no standing there)" 1 rmrf_unruled "$T/c-rm-lib-inside" log
    check_ctl "rmrf_unruled on the library line in source mode (no standing there)" 1 rmrf_unruled "$T/c-rm-lib" source
    check_ctl "rmrf_unruled on one ruled and one unruled target in one command" 1 rmrf_unruled "$T/c-rm-mixed" log
    check_ctl "rmrf_unruled on a prose mention (not a command)" 0 rmrf_unruled "$T/c-rm-prose" log
    rm_files=0; rm_unruled=0; rm_err=0
    rmrf_scan() {
      local f=$1 name=$2 mode=$3 out first ruled kept unr
      out=$(rmrf_classify "$f" "$mode") || { echo "  $name: ERROR"; rm_err=1; return; }
      first=$(printf '%s\n' "$out" | sed -n 1p)
      read -r ruled kept unr <<<"$first"
      rm_files=$((rm_files + 1))
      echo "  $name: ruled=$ruled standing=$kept unruled=$unr"
      if [ "$unr" != 0 ]; then
        echo "    unruled at line(s): $(printf '%s\n' "$out" | sed -n 2p)"
        rm_unruled=$((rm_unruled + unr))
      fi
    }
    # The logs that print a script (changes DI, FK, IF and IO): the four siblings that print one.
    for f in $SCRIPT_LOGS; do
      [ -f "$f" ] || { echo "  $f: MISSING"; bad=$((bad + 1)); continue; }
      rmrf_scan "$f" "$f" log
    done
    rmrf_scan "$0" "this script's own source" source
    rm_covered() { [ "$rm_files" -eq "$((NSCRIPT + 1))" ]; }
    structural "the $NSCRIPT logs that print a script and this script went through the removal classification" "$(yn rm_covered)"
    rm_clean() { [ "$rm_unruled" -eq 0 ] && [ "$rm_err" -eq 0 ]; }
    structural "recursive removals not in the ruled form: $rm_unruled (expect 0); errors: $rm_err (change CC)" "$(yn rm_clean)"
    
    echo
    echo "## every placeholder a log prints is declared by its root lines (change N)"
    echo "specs/0016 P5 verification ruling 3, carried by specs/0017 \"Phases\": a"
    echo "placeholder is a token a log's printed scrub writes in place of a path, or"
    echo "a lower-case angle-bracketed word printed immediately before a slash; it"
    echo "is declared when a root line says the word stands for something. Tokens are"
    echo "counted, never their lines."
    # placeholders_used <file>: the sorted tokens, one per line.
    placeholders_used() {
      {
        LC_ALL=C "$G" -a -o -E 's#[^#]*#<[a-z][a-z0-9_-]*>' "$1" | LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>$'
        LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>/' "$1" | sed 's#/$##'
      } | LC_ALL=C sort -u
    }
    # placeholders_declared <file>: the tokens a root line says stand for
    # something, at its head or later in it.
    placeholders_declared() {
      LC_ALL=C "$G" -a -E '(^|echo ")root: ' "$1" | LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>(/[a-z0-9]+)? stands for' |
        LC_ALL=C "$G" -a -o -E '^<[a-z][a-z0-9_-]*>' | LC_ALL=C sort -u
    }
    undeclared() { LC_ALL=C comm -23 <(placeholders_used "$1") <(placeholders_declared "$1") | count_lines /dev/stdin; }
    # undeclared_by <log> <declaring file>: the tokens the log prints that the
    # other file's root lines do not declare (change FQ).
    undeclared_by() { LC_ALL=C comm -23 <(placeholders_used "$1") <(placeholders_declared "$2") | count_lines /dev/stdin; }
    # The fixtures' tokens are assembled from pieces, so this source spells none.
    L='<'
    printf 'root: %srepo> stands for x\nread %srepo>/a and %sbld>/b\n' "$L" "$L" "$L" >"$T/c-ph-bad"
    printf 'root: %srepo> stands for x; %sbld> stands for y\nread %srepo>/a and %sbld>/b\n' "$L" "$L" "$L" "$L" >"$T/c-ph-ok"
    printf '  sed -e "s#$X#%sgbld>#g"\nroot: %srepo> stands for x\n' "$L" "$L" >"$T/c-ph-scrub"
    check_ctl "undeclared on a log printing a token before a slash with no root line for it" 1 undeclared "$T/c-ph-bad"
    check_ctl "undeclared on the same log with the token declared later in a root line" 0 undeclared "$T/c-ph-ok"
    check_ctl "undeclared on a scrub target with no root line" 1 undeclared "$T/c-ph-scrub"
    check_ctl "undeclared_by on a log printing a token the declaring file declares (change FQ)" 0 undeclared_by "$T/c-ph-bad" "$T/c-ph-ok"
    check_ctl "undeclared_by on a log printing a token the declaring file does not declare (change FQ)" 1 undeclared_by "$T/c-ph-bad" "$T/c-ph-scrub"
    # Change AH: no exemption. The single-letter token part 3 P4's size.log was
    # ruled to carry counts like any other undeclared token here.
    printf 'root: %srepo> stands for x\nread %sn>/p\n' "$L" "$L" >"$T/c-ph-letter"
    check_ctl "undeclared on a single-letter token before a slash (no exemption, change AH)" 1 undeclared "$T/c-ph-letter"
    nph_files=0
    for f in $SIBLINGS "$0"; do
      [ -f "$f" ] || { echo "  $f: MISSING"; bad=$((bad + 1)); continue; }
      nph_files=$((nph_files + 1))
      name=$f; [ "$f" = "$0" ] && name="this script's own source"
      used=$(placeholders_used "$f" | tr '\n' ' ')
      decl=$(placeholders_declared "$f" | tr '\n' ' ')
      n=$(undeclared "$f")
      if [ "$f" = "$LOGDIR/self-test.log" ]; then
        # Change FQ: the self-test log writes no root line; this script's own
        # root lines declare its tokens. No list holds it in this phase (change
        # FT), so this branch does not run.
        decl=$(placeholders_declared "$0" | tr '\n' ' ')
        n=$(undeclared_by "$f" "$0")
        name="$name (declared by this script's root lines, change FQ)"
      fi
      echo "  $name: placeholders printed: $used; declared by root lines: $decl; undeclared: $n"
      structural "every placeholder $name prints is declared by a root line" "$(yn [ "$n" = 0 ])"
    done
    structural "the $NSIB sibling logs and this script went through the placeholder check" "$(yn [ "$nph_files" = "$((NSIB + 1))" ])"
    # Change JA (P1 verification ruling D): the check over this script's own
    # source prints its own control here, a copy with one undeclared token
    # appended (the token assembled from pieces, so this source spells none).
    cp "$0" "$T/self-ph-copy"
    printf '# read %sjaq>/x\n' "$L" >>"$T/self-ph-copy"
    self_ph=$(undeclared "$0")
    self_ph_ctl=$(undeclared "$T/self-ph-copy")
    echo "  this script's own source: undeclared $self_ph; a copy of it with one undeclared token appended: undeclared $self_ph_ctl (change JA)"
    self_ph_one_more() { [ "$self_ph" != error ] && [ "$self_ph_ctl" != error ] && [ "$self_ph_ctl" = "$((self_ph + 1))" ]; }
    structural "control: the placeholder check over this script's own source finds the token appended to a copy of it, one undeclared more (change JA, ruling D)" "$(yn self_ph_one_more)"
    
    echo
    echo "## this script's own standard output, read back for the home directory (change KL, specs/0041 ruling I)"
    # The caller redirects the output to a file (the usage line); it is read back
    # through this shell's standard output, every line printed so far, the rerun
    # line among them. The file's name is not printed.
    OWN_OUT=$(readlink "/proc/$$/fd/1" 2>/dev/null)
    own_out_file() { [ -n "$OWN_OUT" ] && [ -f "$OWN_OUT" ]; }
    echo "command: readlink /proc/PID/fd/1 (PID this shell's), then the lines of that file holding the home directory, counted (grep -c -F)"
    structural "this script's standard output is a regular file, read back here (change KL)" "$(yn own_out_file)"
    if own_out_file; then
      cp "$OWN_OUT" "$T/own-out"
    else
      : >"$T/own-out"
    fi
    own_home=$(count_matches -F "$HOME" "$T/own-out")
    cp "$T/own-out" "$T/c-own-out"
    printf 'rerun: final scan try 1 (%s/.cache/x/superseded/scan-final-try1/final.log)\n' "$HOME" >>"$T/c-own-out"
    own_home_ctl=$(count_matches -F "$HOME" "$T/c-own-out")
    echo "  lines of this script's output so far: $(count_lines "$T/own-out"); of them holding the home directory: $own_home; a copy with one planted rerun line holding it appended: $own_home_ctl"
    structural "no line of this script's output, the rerun line printing RERUN_NOTE among them, holds the home directory (change KL, specs/0041 ruling I)" "$(yn [ "$own_home" = 0 ])"
    own_home_one_more() { [ "$own_home" != error ] && [ "$own_home_ctl" != error ] && [ "$own_home_ctl" = "$((own_home + 1))" ]; }
    structural "control: the same count finds a planted rerun line holding the home directory appended to a copy, one more (change KL)" "$(yn own_home_one_more)"
    
    echo
    echo "## this script's own standard error (change Q, specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$T/c-err"; printf 'x' >>"$T/c-err"
    nerr_ctl=$(wc -c <"$T/c-err")
    echo "  command: wc -c <phase>/scripts/out/scan-$STAGE.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    structural "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    structural "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    
    echo
    echo "total hits: $hits"
    echo "read or counting errors: $err"
    echo "structural checks failed: $bad"
    scan_passed() {
      [ "$ctl_fail" -eq 0 ] || return 1
      [ "$err" -eq 0 ] || return 1
      [ "$hits" -eq 0 ] || return 1
      [ "$bad" -eq 0 ] || return 1
      [ "$shape_hits" -eq 0 ] || return 1
      [ "$shape_err" -eq 0 ] || return 1
    }
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if scan_passed; then
      echo "RESULT: PASS"
    else
      echo "RESULT: FAIL"
      exit 1
    fi

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
  control count_matches with a regular expression: 2 (expect 2)
  control count_matches on an unreadable file: error (expect error)
  control count_matches on readable plus unreadable: error (expect error)
  control count_from_file on the same file: 2 (expect 2)
  control count_from_file on a file with none: 0 (expect 0)
  control count_from_file on an unreadable file: error (expect error)
  control count_bytes, control bytes in a file with ESC, ESC and SI: 3 (expect 3)
  control count_bytes, non-ASCII bytes in a file with one two-byte character: 2 (expect 2)
  control count_bytes on a clean file: 0 (expect 0)
  control count_bytes on an unreadable file: error (expect error)
  control count_lines on a three-line file: 3 (expect 3)
  control count_lines on an unreadable file: error (expect error)
  control count_matches_i on mixed case: 2 (expect 2)
