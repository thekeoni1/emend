    old_heading() { [ "$(count_matches -F 'the refused-inputs heading reads as ruled, once: no' "$B/c-prevmd.out")" = 1 ]; }
    check "control: the same check on part 8 P2's committed .md finds the old heading, not the ruled one" "$(yn old_heading)"
    totals_line() { [ "$(sed -n 's/^wrote .*\.txt: \(pairs [^;]*; lo_in [^;]*; lo [^;]*\); inputs refused .*/\1/p' "$B/oc.stdout")" = "$(sed -n 's/^totals: //p' "$B/mdcheck.out")" ]; }
    check "the script's totals line is the totals derived from the .txt" "$(yn totals_line)"
    echo
