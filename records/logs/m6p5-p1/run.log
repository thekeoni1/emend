  read: 2026-10-16-5e52758-read: tool_args host [--read-sample], i686 [--read-sample]
  the earlier read run's rows name --read-sample on both labels (change NZN): yes
  roundtrip: 2026-10-05-6b6125b-roundtrip: tool_args host [--roundtrip-sample], i686 [--roundtrip-sample]
  the earlier roundtrip run's rows name --roundtrip-sample on both labels (change NZN): yes
  the directory ruling F named for the round trip, 2026-10-16-5e52758-roundtrip: tool_args host []
  control: the same column refuses 2026-10-16-5e52758-roundtrip as a --roundtrip-sample run (its tool_args are empty; change NZN): yes
  the comparison: <work>/fieldcmp.py, below (sha256 5e1d75268c79d89f32bda87b78143d90f1c05a9fa97ddf6d0d3ef9c2603d74c8)
    """This log's field-by-field comparison of two corpus runs' sample lines
    (specs/0042 ruling F): for each workbook id given, the earlier run's and
    this run's stdout.<label>.txt, each one line of a word and key=value
    pairs; prints each moved field as "<id> <key>: <earlier> -> <now>" (a key
    on one side alone printed with "-" for the other) and one summary line,
    "lines equal <n> of <m>; fields moved <k>; lines missing <l>". Counts and
    flags only: the samples print nothing else. Usage: fieldcmp.py <earlier
    run dir> <this run dir> <label> <id>..."""
    import os
    import sys
    
    sys.dont_write_bytecode = True
    earlier, now, label = sys.argv[1:4]
    ids = sys.argv[4:]
    
    
    def line(d, i):
        path = os.path.join(d, i, "stdout.%s.txt" % label)
        if not os.path.exists(path):
            return None
        text = open(path, encoding="ascii").read()
        return text[:-1] if text.endswith("\n") else text
    
    
    def fields(text):
        cells = text.split("\t")
        out = [("(word)", cells[0])]
        for c in cells[1:]:
            k, _, v = c.partition("=")
            out.append((k, v))
        return out
    
    
    equal = moved = missing = 0
    for i in ids:
        a, b = line(earlier, i), line(now, i)
        if a is None or b is None:
            missing += 1
            print("%s: a line is missing (earlier %s, now %s)" % (i, "yes" if a is not None else "no",
                                                                 "yes" if b is not None else "no"))
            continue
        if a == b:
            equal += 1
            continue
        fa, fb = dict(fields(a)), dict(fields(b))
        for k in [k for k, _ in fields(a)] + [k for k, _ in fields(b) if k not in fa]:
            if fa.get(k) != fb.get(k):
                moved += 1
                print("%s %s: %s -> %s" % (i, k, fa.get(k, "-"), fb.get(k, "-")))
        if [k for k, _ in fields(a)] == [k for k, _ in fields(b)] and fa == fb:
            print("%s: the fields agree and the line differs in its form" % i)
            moved += 1
    print("lines equal %d of %d; fields moved %d; lines missing %d" % (equal, len(ids), moved, missing))

