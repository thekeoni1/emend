    # its read sample (no comparison, every entry identical) and tier d's
    # --items needed, none of which arises here; a sample that writes parts,
    # with a comparison and a survey, is P1's shape. What differs, and why:
    #  UA. The phase, the log directory, the subjects, the script directory
    #      (<scripts>, <home>/.cache/emend-build/m3p6-p1/scripts, on the disk),
    #      the build directory (m3p6-p1/run) and the keep (m3p6-p1/keep-host) are
    #      this phase's; the base is M3 part 5's close-out record commit ("M3
    #      part 5 close-out record:"); the phase commit is P1's tool commit by
    #      its subject ("M3 part 6 P1: emend-copy --commentbox-sample"); the
    #      record stems are m3p6-p1- and m3p6-open-; the spec is
    #      specs/0028-images-and-comments-second-half.md, its committed blob at
    #      P1's doc commit pinned through SPEC_SHA, a ruling of planning's
    #      standing uncommitted in the working tree's copy should one come.
    #  UB. Change SB's form (after a close-out): the committed open-check record
    #      the keep is compared with is M3 part 5 P3's, the last committed, named
    #      by its record commit, resolved by its subject ("M3 part 5 P3
    #      record:"; no hash is typed into this script), checked to be a record
    #      commit that added exactly one open-check .txt with no later commit
    #      adding another; it is an ancestor of the base, not the base, and the
    #      base is the parent of P1's doc commit; the control names the base
    #      instead.
    #  UC. The comparison is cbcmp.py, built for this phase from M2 part 4d P1's
    #      cmtcmp.py (<home>/.cache/emend-build/m3p6-p1/gen/cbcmp_build.py,
    #      each replacement asserted): its ten flags stand with the sample's
    #      text emend box and the note the shown box's, and five are added:
    #      box_style, visible_child and kept_shapes (the spec's commentbox
    #      checks), xml_values and flagged (specs/0024 P1 verification ruling 6,
    #      rtcmp.py's form over every changed .xml, .rels and .vml entry);
    #      --parts prints part 4d's seven lines. The line's relations are the
    #      spec's: comments_after and shapes_after one more than before,
    #      sized_before no more than comments_before, box_equal and
    #      visible_after 1; the tool's counts equal the comparison's (comments
    #      and note shapes in and out, the sized comments in, box_ok and
    #      visible_out). The entries are part 4d P1's rule (its change EC), by
    #      W's legacyDrawing and comments relationship: where W has neither, W
    #      and the content types changed, W's rels part changed or added where
    #      the input has none, the comments and VML parts added; where W has
    #      both, the comments and VML parts changed; where W has the VML part
    #      alone, the VML part, the rels part and the content types changed and
    #      the comments part added; every other row identical and unflagged,
    #      nothing recompressed or dropped; a changed row flagged descriptor at
    #      most, and exactly when its input entry sets bit 3 by the
    #      comparison's flagged. The created parts (2, 1 or 0) are printed per
    #      workbook and totalled.
    #  UD. NEW, the survey (cbsurvey.py, <scripts>, copied into <work> and
    #      printed) replaces SD's, in SD's form: <corpus> its parameter, every
    #      regular file of <corpus>/corpus listed, one wb line of nine fields
    #      per workbook; the log checks its forms, prints the distributions and
    #      checks every line's comments_before, shapes_before and sized_before
    #      against it.
    #  UE. Changes PE, QE and SE (every row ok) stand; LF (the descriptor flags
    #      and the derived values, now over every changed .xml, .rels and .vml
    #      entry) and LG (TMPDIR on the disk) stand.
    #  UF. Change SF (the calculation chain) stands, the entries rule (UC)
    #      leaving the chain identical: no cell or formula is written.
    #  UG. Change SG (no row written) stands: the comment goes on (M + 1, 1)
    #      in the comments and VML parts; W gains at most a legacyDrawing.
    #  UH. Change PH (the open check's own TMPDIR device) stands, unchanged.
    #  UI. The plants: every flag's planted control runs on the first ok
    #      workbook in manifest order whose comments and VML parts the sample
    #      creates (created 2) and on the first whose it keeps (created 0), each
    #      on its own check line, the plant turning its own flag; kept_shapes on
    #      the created case has no kept shape to change, and its line checks the
    #      plant reports planted=no there and the flag stays yes; a case the
    #      corpus does not hold fails its line.
    #  UJ. The run loop, the record pair, the keep and the open check are SJ's
    #      with this phase's names; the families the record's check derives are
    #      the ones UC's rule changes and adds, by the record script's own
    #      family rule.
    #  UK. SK stands: this script runs no `rm -rf`; the sourced
    #      scripts/counting.sh, a committed script, runs one on the directory its
    #      counting controls make (allowed: a directory the script created in
    #      that run); the working directory and the keeps stand, kept, and
    #      Python writes no bytecode.
    #
    #
    #
    # CARRIED TO M3 part 6 P2 from M3 part 6 P1's run script (at the phase
    # commit 2adf953, printed in records/logs/m3p6-p1/run.log; its change lists
    # up to UK are above), generated by <home>/.cache/emend-build/m3p6-p2/gen/
    # run.py, every replacement asserted to occur as often as it says, the top
    # summary and the body from the survey to the corpus record pair's
    # installation replaced whole (gen/run_block.sh, by its anchor lines), and
    # the body grepped afterwards for P1's names, subjects, stems and the tokens
    # cbcmp, cbsurvey, m3p6-p1 and STEM_RUN. What differs, and why:
    #  VA. The phase, the log directory, the subjects, the script directory
    #      (<scripts>, <home>/.cache/emend-build/m3p6-p2/scripts, on the disk),
    #      the build directory (m3p6-p2/run) and the keep (m3p6-p2/keep-host) are
    #      this phase's; the base is P1's record commit ("M3 part 6 P1
    #      record:"); the phase commit is P2's tool commit by its subject ("M3
    #      part 6 P2: emend-copy --anchor-sample and --remove-image-sample"); two
    #      samples, anchor and removeimage, each with its run directory
    #      <runs>/<date>-<sha>-<sample> and its record stem
    #      m3p6-p2-<sample>-<date>-<sha> (M3 part 5 P3's form), and a third run
    #      directory <runs>/<date>-<sha>-commentbox for the comment box sample's
    #      rerun; SUPERSEDED_RUN names the three by their common stem; the spec
    #      pinned through SPEC_SHA at P2's doc commit, planning's rulings during
    #      P2 standing uncommitted in the working tree's copy, printed.
    #  VB. Change UB's form: the committed open-check record the keep is
    #      compared with is P1's, the last committed, named by its record
    #      commit, resolved by its subject ("M3 part 6 P1 record:"; no hash is
    #      typed here); it is the base itself, the parent of P2's doc commit; the
    #      control names the doc commit instead.
    #  VC. The comparison is imgcmp.py, built for this phase (<home>/.cache/
    #      emend-build/m3p6-p2/gen/imgcmp_build.py) from M2 part 4d P3's
    #      imgcmp.py and P1's cbcmp.py readers, one program with a mode per
    #      sample: anchor carries part 4d's ten flags for two anchors and adds
    #      two_form, absolute_form and kept_children (the spec's anchor check),
    #      xml_values and flagged; removeimage has sheet_same, drawing_children,
    #      drawing_rels_set, media_dropped (the spec's removeimage checks),
    #      types_set, wrels_set, added_empty (ruling 2), images_read, xml_values
    #      and flagged. flagged reads every rewritten entry (changed or
    #      recompressed, ruling 1) and wants descriptor exactly when bit 3 or
    #      the bytes after the data differ, xlsx-diff's rule computed through
    #      the local headers: for a changed entry whose bit 3 both sides keep,
    #      that is P1's "when the input sets bit 3", and a recompressed one's
    #      descriptor carries its new compressed size. The lines' relations are
    #      the spec's: anchor two images, anchors and media entries more, one
    #      image of each anchor kind more; removeimage images_after the images
    #      less kept_removed, media_dropped the entries gone, 0 with nothing kept
    #      removed. The tool's counts equal the comparison's.
    #  VD. NEW, the survey (imgsurvey.py, <scripts>, copied into <work> and
    #      printed) replaces UD's, in its form: <corpus> its parameter, every
    #      regular file of <corpus>/corpus listed, one wb line of thirteen
    #      fields per workbook, one drawings line (decision 8: the drawing parts
    #      and the largest drawing's anchor count, printed); the log checks its
    #      forms, prints the distributions and checks every line's figures
    #      against it, and the comparison's parts against it.
    #  VE. Changes PE, QE and SE (every row ok) stand. The entries rules: anchor
    #      is M2 part 4d P3's image rule with two media entries; removeimage is
    #      the planning rulings during P2: with nothing kept removed, W, W's rels
    #      part, the content types and a drawing that stays identical or
    #      recompressed, its rels part changed with the same relationships
    #      allowed (ruling 1); at most one added row, W's rels part or the
    #      drawing's where the input has none, its root childless (ruling 2);
    #      an empty input drawing dropped with W, W's rels part and the content
    #      types changed or recompressed (ruling 3); with the first image
    #      removed, the spec's: the drawing and its rels part changed, the media
    #      entries the count rule drops dropped, the content types changed where
    #      an Override went. Each allowance has a control that accepts it where
    #      it applies and one that refuses it where it does not. The removal's
    #      summary totals are checked against its entries table, every row by
    #      the rule.
    #  VF. NEW, the comment box sample once more on both targets, its outputs
    #      by sha256, its lines and its diff tables P1's run's byte for byte, the
    #      run directory named by P1's record commit through the run record it
    #      added (M3 part 5 P3's change WC form); no record pair is written for
    #      the rerun.
    #  VG. Change UG's no-row rule stands: neither sample writes a cell, so the
    #      calculation chain's entry stays identical (change UF).
    #  VH. Change PH (the open check's own TMPDIR device) stands, unchanged.
    #  VI. The plants: every flag's planted control runs, for each sample, on
    #      the first ok workbook in manifest order of its created case (anchor:
    #      W has no drawing; removeimage: no image is kept and W has no drawing)
    #      and of its kept case (anchor: W has a drawing; removeimage: the first
    #      image is removed), each on its own check line, the plant turning its
    #      own flag; kept_children on the anchor's created case has no kept
    #      child to change, and its line checks the plant reports planted=no
    #      there and the flag stays yes; the anchor's kept case is a drawing
    #      with a root child (an empty drawing gives the case other). The xml
    #      values check wants some value written by the anchor sample and some
    #      removed by the removal, which writes none (change LF's form).
    #  VJ. The run loop, the record pairs, the keep and the open check are SJ's
    #      and WJ's with this phase's names; reccheck.py takes the dropped
    #      families as an input beside the changed and added ones; the anchor
    #      record's families are derived from the --parts lines, the removal
    #      record's from its entries table, which the rule checked row by row
    #      (the rulings allow a row recompressed or changed); six record files
    #      installed, four when the keep is skipped.
    #  VK. UK stands: this script runs no `rm -rf`; the sourced
    #      scripts/counting.sh, a committed script, runs one on the directory its
    #      counting controls make (allowed: a directory the script created in
    #      that run); the working directory and the keeps stand, kept, and
    #      Python writes no bytecode.
    #
    #
    #
    # CARRIED TO M3 part 6 P3 from M3 part 6 P2's run script (at the phase
    # commit d3c4a9c, printed in records/logs/m3p6-p2/run.log; its change lists
    # up to VK are above), generated by <home>/.cache/emend-build/m3p6-p3/gen/
    # run.py, every replacement asserted to occur as often as it says, the top
    # summary and the body from the survey to the corpus record pairs'
    # installation replaced whole (gen/run_block.sh, by its anchor lines, P2's
    # record check carried into it unchanged), and the body grepped afterwards
    # for P2's names, subjects, stems and the tokens imgcmp, imgsurvey,
    # m3p6-p2-, P1_REC and PREV_CB. What differs, and why:
    #  XA. The phase, the log directory, the subjects, the script directory
    #      (<scripts>, <home>/.cache/emend-build/m3p6-p3/scripts, on the disk)
    #      and the keep (m3p6-p3/keep-host) are this phase's; the base is P2's
    #      record commit ("M3 part 6 P2 record:"); the phase commit is P3's tool
    #      commit by its subject ("M3 part 6 P3: emend-copy --copy-sample"); one
    #      sample, copy, with its run directory <runs>/<date>-<sha>-copy and its
    #      record stem m3p6-p3-<date>-<sha> (the spec's name), and three rerun
    #      directories <runs>/<date>-<sha>-anchor, -removeimage and -commentbox
    #      (RERUNS); SUPERSEDED_RUN names the four by their common stem; the
    #      spec pinned through SPEC_SHA at P3's doc commit, planning's rulings
    #      during P3 standing uncommitted in the working tree's copy, printed.
    #  XB. Change VB's form: the committed open-check record the keep is
    #      compared with is P2's, the last committed, named by its record
    #      commit, resolved by its subject ("M3 part 6 P2 record:"; no hash is
    #      typed here); it is the base itself, the parent of P3's doc commit; the
    #      control names the doc commit instead. P2_REC names the same commit, the
    #      one whose run directories the reruns are compared with (change XF).
    #  XC. The comparison is copycmp.py, built for this phase (<home>/.cache/
    #      emend-build/m3p6-p3/gen/copycmp_build.py) with P2's imgcmp.py
    #      readers copied by name, one mode, copy, fifteen flags: whole_bytes,
    #      data_same, kept_same, views_same, setup_same, dropped_gone (the
    #      spec's copy check, and the copy built from S byte for byte),
    #      rels_set (ruling 1), comments_same and notes_placed (the spec's
    #      carried checks), workbook_sheet, types_set, chain_rule, rest_same,
    #      xml_values and flagged (P2's). The lines' relations are the spec's:
    #      one sheet more, the copy's counts its source's, no chain after a
    #      formula. The tool's counts equal the comparison's.
    #  XD. NEW, the survey (copysurvey.py, <scripts>, copied into <work> and
    #      printed) replaces VD's, in its form: <corpus> its parameter, every
    #      regular file of <corpus>/corpus listed, one wb line of twenty fields
    #      per workbook; the log checks its forms, prints the distributions and
    #      checks every line's figures against it, and the comparison's parts
    #      against it. No drawings line (no decision rests on one here).
    #  XE. Changes PE, QE, SE and VE (every row ok) stand. The entries rule is
    #      the rulings during P3's: the copy's entry added; its rels part added
    #      exactly when S has a hyperlink or a comments relationship (ruling 1);
    #      the comments and VML parts added when carried; the workbook part, its
    #      rels part and the content types changed, flagged descriptor at most;
    #      the chain's entry dropped exactly when S holds a formula and the
    #      workbook a chain; every other row identical and unflagged; nothing
    #      recompressed. Each allowance has a control that accepts it where it
    #      applies and one that refuses it where it does not. The summary's
    #      totals are checked against what the rows imply and against the
    #      entries table.
    #  XF. NEW, the three earlier samples once more on both targets, their
    #      outputs by sha256, their lines and their diff tables P2's runs' byte
    #      for byte (change VF's form for three samples), the run directories
    #      read from the "the run directories:" line of P2's run log at P2's
    #      record commit and checked against the run directory P2's committed
    #      anchor record names; no record pair is written for the reruns.
    #  XG. Change UG's no-row rule gives way: the copy makes the write a formula
    #      change when S holds a formula (specs/0013's rule, "The copy"), so
    #      each chain workbook's calcChain row is dropped exactly there, and is
    #      identical and unflagged elsewhere; some row is dropped.
    #  XH. Change PH (the open check's own TMPDIR device) stands, unchanged.
    #  XI. The plants: every flag's planted control runs on the first ok
    #      workbook in manifest order of the plain case (S's comments not
    #      carried) and of the carried case, each on its own check line, the
    #      plant turning its own flag; every flag has a plant on both cases.
    #      The xml values check wants some value written (the workbook's new
    #      sheet; change LF's form).
    #  XJ. The run loop, the record pair, the keep and the open check are VJ's
    #      with this phase's names; the record's families are derived from its
    #      entries table, which the rule checked row by row; four record files
    #      installed, two when the keep is skipped.
    #  XK. Ruling 8 of the planning rulings during P2 (build pruning) and
    #      ruling 10 of the planning rulings during P3 (one target root per
    #      phase, one subdirectory per source tree): the phase's target root is
    #      <target>, <home>/.cache/emend-build/m3p6-p3/target, and every build
    #      of <repo> by this script, dry or logged, goes into <target>/main
    #      (CARGO_TARGET_DIR), the subdirectory ruling 10 gives the main tree;
    #      this script builds from no other tree. P2's <build> placeholder (a
    #      run directory holding its own target) is gone with the input
    #      RUN_BUILD_ROOT, so no run moves the builds, and nothing here cleans
    #      them; the i686 keep is <work>/keep-i686, kept, not under the target.
    #      VK stands: this script runs no `rm -rf`.
    #
    # Usage: m6p5-p1-run.sh <phase commit> > <file outside the tree>; the caller
    # moves the output to records/logs/m6p5-p1/run.log (change NZL).
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    # Every environment input, as it was set, before any is unset.
    INPUT_NAMES="RUN_SUFFIX SUPERSEDED_RUN SUPERSEDED_KEEP RERUN_NOTE RERUN_FILES RECORDS_DEST RUN_KEEP RUN_OUT_ROOT RUN_SKIP_KEEP PLANNING_SPEC EMEND_CORPUS_DIR EMEND_KEEP_DIR HOME"
    declare -A INPUT_SEEN
    for v in $INPUT_NAMES; do
      if [ -n "${!v+x}" ]; then INPUT_SEEN[$v]=${!v}; else INPUT_SEEN[$v]=unset; fi
    done
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=4
    # Python writes no bytecode, so nothing arises to be removed.
    export PYTHONDONTWRITEBYTECODE=1
    # Change NTK (M5 part 1 P3's NTC, carried): every cargo command of this log
    # runs offline; the two settings are printed below.
    export CARGO_NET_OFFLINE=true
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR RUSTDOCFLAGS RUSTFLAGS
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    LO_TIMEOUT_S=600
    SPEC=specs/0042-gradient-fills-and-named-styles.md
    # Change NZL: the committed blob the doc commit 893e12c holds (planning's
    # P1 brief, by hash).
    SPEC_WANT=68f67c4a95194ea34fb00f972e8a527abc4a109a45fdedc3b49c29d7a59666c0
    # Change NZL: the one sample, with its tool argument.
    SAMPLES="gradient"
    declare -A EDITS=([gradient]=--gradient-sample)
    # Change NZN: ruling F's three reruns, each with --tool-arg --<name>-sample.
    RERUNS="namedstyles read roundtrip"
    PLANNING_SPEC=${PLANNING_SPEC:-}
    PHASE_DIR=$HOME/.cache/emend-build/m6p5-p1
    # Change NSK: every build of <repo>, dry or logged, goes into the main tree's
    # subdirectory of the phase's one target root, <target>/main; no input moves
    # it and nothing here cleans it. The logged run leaves RUN_KEEP unset; a dry
    # run points it elsewhere so it leaves no keep where the logged run refuses
    # one.
    TARGET_ROOT=$PHASE_DIR/target
    BUILD_ROOT=$TARGET_ROOT/main
    KEEP=${RUN_KEEP:-$PHASE_DIR/keep-host}
    RUN_OUT_ROOT=${RUN_OUT_ROOT:-$CORPUS/runs}
    RUN_SKIP_KEEP=${RUN_SKIP_KEEP:-no}
    case $RUN_SKIP_KEEP in yes | no) ;; *) echo "RUN_SKIP_KEEP is yes or no" >&2; exit 2 ;; esac
    INSTALLED=()
    I686=i686-unknown-linux-musl
    RECORDS_DEST=${RECORDS_DEST:-records}
    # A keep in place is another attempt's, moved below once the header can list
    # it; without SUPERSEDED_KEEP naming the attempt it is refused.
    SUPERSEDED_KEEP=${SUPERSEDED_KEEP:-}
    case $SUPERSEDED_KEEP in '' | attempt-[1-9]) ;; *) echo "SUPERSEDED_KEEP is attempt-<n> or nothing" >&2; exit 2 ;; esac
    if [ "$RUN_SKIP_KEEP" = no ] && [ -e "$KEEP" ] && [ -z "$SUPERSEDED_KEEP" ]; then echo "$KEEP is already there; name its attempt in SUPERSEDED_KEEP" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT
    # Change NWS: a dry run (RECORDS_DEST other than records) stages its
    # records in RECORDS_DEST/staged, so it leaves nothing in
    # <scripts>/out/records for the logged run to refuse.
    if [ "$RECORDS_DEST" = records ]; then RECORDS=$SELF_DIR/out/records; else RECORDS=$RECORDS_DEST/staged; fi
    # Change NTI: TMPDIR is <scratch>/tmp, the phase's directory's, made and
    # exported before any mktemp (close-out ruling 1); the working directory
    # is the one mktemp -d makes under it, on the disk, kept; nothing here is
    # removed.
    TMPDIR=$PHASE_DIR/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    B=$(mktemp -d) || exit 2
    # Change NSB: the counting library is the phase commit's, by git show.
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT=$(git rev-parse --short=7 "$C")
    DATE=$(date -u +%Y-%m-%d)
    # What the status pattern admits (changes NSB, NUB, NUI, NXL, NXT, NYD, NYU
    # and NZL): this phase's log directory and this phase's two record pairs
    # (named by the run's date and the phase commit's short sha, untracked);
    # and, as change NXS gave it, planning's modified specs/0042 when
    # PLANNING_SPEC is given and the working file hashes to it; nothing else.
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m6p5-p1/|\\?\\? records/m6p5-(p1-gradient|open)-$DATE-$SHORT[.](md|txt)\$)"
    PLAN_SPEC_NOW=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    plan_admitted() { [ -n "${PLANNING_SPEC:-}" ] && [ "$PLAN_SPEC_NOW" = "$PLANNING_SPEC" ]; }
    if plan_admitted; then OURS="^((\\?\\?| ?[MARCD]) records/logs/m6p5-p1/|\\?\\? records/m6p5-(p1-gradient|open)-$DATE-$SHORT[.](md|txt)\$| M specs/0042-gradient-fills-and-named-styles[.]md\$)"; fi
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs and records" >&2
      exit 2
    fi
    # Change NZL: the sample's record stem, the phase's with the sample's
    # word (M5 part 5 P4's form); the reruns of change NZN write no record.
    declare -A STEMS=([gradient]=m6p5-p1-gradient-$DATE-$SHORT)
    STEM_OPEN=m6p5-open-$DATE-$SHORT
    # A rerun takes a suffix, so its run directory is never the superseded one.
    RUN_SUFFIX=${RUN_SUFFIX:-}
    case $RUN_SUFFIX in '' | -[b-z]) ;; *) echo "RUN_SUFFIX is -b to -z or nothing" >&2; exit 2 ;; esac
    RUN=$DATE-$SHORT$RUN_SUFFIX
    mkdir -p "$RECORDS" "$RECORDS_DEST" || exit 2
    # A rerun names the superseded run directory, which is MOVED into
    # <scripts>/out/superseded after the header prints it, never removed; it
    # must be another run of this phase, not this one.
    SUPERSEDED_RUN=${SUPERSEDED_RUN:-}
    case $SUPERSEDED_RUN in
      '' | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f] | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[b-z]) ;;
      *) echo "SUPERSEDED_RUN is not a run directory's name" >&2; exit 2 ;;
    esac
    if [ -n "$SUPERSEDED_RUN" ] && [ "$SUPERSEDED_RUN" = "$RUN" ]; then echo "SUPERSEDED_RUN names this run's own directory" >&2; exit 2; fi
    for f in "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt" \
             "$RECORDS/${STEMS[gradient]}.md" "$RECORDS/${STEMS[gradient]}.txt" "$RECORDS_DEST/${STEMS[gradient]}.md" "$RECORDS_DEST/${STEMS[gradient]}.txt"; do
      if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
    done
    # A run directory that exists before the run is another attempt's; refused
    # (the runner itself refuses one holding an earlier run's conversion
    # directories, specs/0030 decision 1 A).
    # Change NVX: each sample's run directory (one, and the three reruns'
    # of change NZN).
    for s in $SAMPLES $RERUNS; do
      if [ -e "$RUN_OUT_ROOT/$RUN-$s" ]; then echo "$RUN_OUT_ROOT/$RUN-$s is already there; name a fresh run" >&2; exit 2; fi
    done
    
    # The corpus's path begins with <repo>'s, so <runs> and <corpus> are
    # replaced before <repo> (M4 part 1 P3's order); the phase's directories
    # before <phase>, and <home> last.
    scrub() {
      sed -e "s#$B#<work>#g" -e "s#$TMPDIR#<scratch>/tmp#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$KEEP#<keep>#g" \
        -e "s#$TARGET_ROOT#<target>#g" -e "s#$RUN_OUT_ROOT#<runs>#g" -e "s#$CORPUS#<corpus>#g" \
        -e "s#$MAIN#<repo>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M6 part 5 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # The environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo "input (as exported by this script, change NTK): PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE CARGO_NET_OFFLINE=$CARGO_NET_OFFLINE"
    echo "input: TMPDIR=$TMPDIR"
    echo "  (TMPDIR set, made and exported by this script before any mktemp; <work> is made under it: close-out ruling 1; change NTI)"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change NTJ: the fourth shape, PYB: a Python call without -I -B (the word
    # followed by whitespace and an option or a .py path, outside a comment,
    # and not by " -I -B"). The word is built from two halves, so that this
    # form's own text is no call.
    PYW=pyth
    PYW=${PYW}on3
    pyb_count() {
      awk -v w="$PYW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { r = substr(s, i + length(w)); if (r ~ /^[ \t]+(-|[^ \t]*[.]py([ \t"]|$))/ && r !~ /^ -I -B( |$)/) { n++; break }; s = r }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "$PYW -c x" "$PYW -I -B -c x" "# $PYW -c x" "command -v $PYW" "$PYW tool.py" >"$B/pyb-fixture"
    n_self=$(pyb_count "$SELF")
    n_fix=$(pyb_count "$B/pyb-fixture")
    echo "command: pyb_count <this script>, and the same over a fixture of five lines: a call with -c, one with -I -B -c, a comment, a command -v, a call of a .py path"
    echo "  shape PYB: in this script $n_self; in the fixture $n_fix"
    check "PYB: this script holds none (change NTJ)" "$(yn [ "$n_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's two calls without -I -B and not its other three lines" "$(yn [ "$n_fix" = 2 ])"
    # Rulings Z, AD and AK a (change NWT): the defined-helper check over this
    # script's own source, and its planted controls. The program is written
    # into <work> from this script's text, so nothing is copied beside it; the
    # planted calls are built from pieces, so this text holds no call of an
    # undefined name.
    cat >"$B/defined_check.py" <<'PY'
    """The defined-helper check (specs/0037: ruling Q, carried into each script's
    own shape block by ruling Z, widened by rulings AD and AK a): every helper
    a yn, ynnot, is or isnot call names is defined in the script, and each of
    the four the script calls is itself defined in it.
    
    Usage: python3 -I -B defined_check.py <script>
    
    A call's name is the word after a command substitution's opening, a dollar
    sign and a parenthesis, followed by one of the four names and a space,
    outside a comment line; a name is defined when a line of the script reads
    "<name>() {" (leading blanks allowed). The commands a script calls by name
    through them, "[", "cmp", "true" and "podman", are not helpers
    (gen/defined.py's list). Prints one line, "called <n>; undefined: <names or
    none>; yn defined: <yes|no|not called>; ynnot defined: ...; is defined:
    ...; isnot defined: ..."; exit 0 when no name is undefined and none of the
    four is called undefined, 1 otherwise, 2 on a usage or read error."""
    import re
    import sys
    
    COMMANDS = ("[", "cmp", "true", "podman")
    WRAPPERS = ("yn", "ynnot", "is", "isnot")
    CALL = re.compile(r"\$\((yn|ynnot|is|isnot) ([^ )\"]+)")
    
    
    def main():
        if len(sys.argv) != 2:
            print("usage: defined_check.py <script>", file=sys.stderr)
            sys.exit(2)
        try:
            text = open(sys.argv[1], encoding="utf-8").read()
        except OSError as err:
            print("cannot read the script: %s" % err.strerror, file=sys.stderr)
            sys.exit(2)
        called, wrappers = set(), set()
        for line in text.split("\n"):
            if line.lstrip().startswith("#"):
                continue
            for wrapper, name in CALL.findall(line):
                wrappers.add(wrapper)
                called.add(name)
        defined = set(re.findall(r"^[ \t]*([A-Za-z_][A-Za-z0-9_]*)\(\) \{", text, re.M))
        missing = sorted(n for n in called if n not in COMMANDS and n not in defined)
    
        def state(w):
            if w not in wrappers:
                return "not called"
            return "yes" if w in defined else "no"
        print("called %d; undefined: %s; %s"
              % (len(called), " ".join(missing) if missing else "none",
                 "; ".join("%s defined: %s" % (w, state(w)) for w in WRAPPERS)))
        bad = missing or any(state(w) == "no" for w in WRAPPERS)
        sys.exit(1 if bad else 0)
    
    
    main()
    PY
    echo "command: python3 -I -B <work>/defined_check.py <this script> (the program, written from this script's text, below; sha256 $(sha_of "$B/defined_check.py")), and the same over a copy of this script with one planted yn call and one planted is call of undefined helpers, and over a planted script that calls yn and is and defines neither (rulings Z, AD and AK a)"
    sed 's/^/    /' "$B/defined_check.py"
    python3 -I -B "$B/defined_check.py" "$SELF" >"$B/def-self.out" 2>"$B/def-self.err" </dev/null
    def_rc=$?
    sed 's/^/    /' "$B/def-self.out"
    def_self_ok() { [ "$def_rc" = 0 ] && [ ! -s "$B/def-self.err" ] && [ "$(count_matches -F 'undefined: none; yn defined: yes; ynnot defined: yes; is defined: not called; isnot defined: not called' "$B/def-self.out")" = 1 ]; }
    check "every helper a yn or ynnot call of this script names is defined in it, yn and ynnot are themselves defined, and it calls neither is nor isnot (rulings Z, AD and AK a)" "$(yn def_self_ok)"
    { cat "$SELF"; printf '%s\n' "zz=\$""(yn zz_planted_undefined_helper)" "zi=\$""(is zz_planted_is_helper)"; } >"$B/def-plant.sh"
    python3 -I -B "$B/defined_check.py" "$B/def-plant.sh" >"$B/def-plant.out" 2>"$B/def-plant.err" </dev/null
    def_prc=$?
    echo "  over the planted copy: exit $def_prc; $(cat "$B/def-plant.out")"
    def_plant_ok() { [ "$def_prc" = 1 ] && [ "$(count_matches -F 'undefined: zz_planted_is_helper zz_planted_undefined_helper;' "$B/def-plant.out")" = 1 ] && [ "$(count_matches -F '; is defined: no;' "$B/def-plant.out")" = 1 ]; }
    check "control: the same check names the two planted undefined helpers in a copy of this script, the is call's among them, and is undefined there (rulings Z and AK a)" "$(yn def_plant_ok)"
    printf '%s\n' 'f() { :; }' "x=\$""(yn f)" "y=\$""(is f)" >"$B/def-noyn.sh"
    python3 -I -B "$B/defined_check.py" "$B/def-noyn.sh" >"$B/def-noyn.out" 2>"$B/def-noyn.err" </dev/null
    def_nrc=$?
    echo "  over a planted script defining f and calling yn f and is f: exit $def_nrc; $(cat "$B/def-noyn.out")"
    def_noyn_ok() { [ "$def_nrc" = 1 ] && [ "$(count_matches -F '; yn defined: no;' "$B/def-noyn.out")" = 1 ] && [ "$(count_matches -F '; is defined: no;' "$B/def-noyn.out")" = 1 ]; }
    check "control: the same check refuses a planted script that calls yn and is and defines neither (rulings AD and AK a)" "$(yn def_noyn_ok)"
    # P1 verification ruling D (change NXD): the placeholder check, the scan's
    # rule, over this script's own source, printed in this log with its
    # controls. A placeholder is a lower-case angle-bracketed word printed
    # immediately before a slash, or the target of a scrub; it is declared when
    # a root line says the word stands for something. The planted tokens are
    # built from pieces, so this text holds none.
    ph_used() {
      {
        LC_ALL=C "$G" -a -o -E 's#[^#]*#<[a-z][a-z0-9_-]*>' "$1" | LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>$'
        LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>/' "$1" | sed 's#/$##'
      } | LC_ALL=C sort -u
    }
    ph_declared() {
      LC_ALL=C "$G" -a -E '(^|echo ")root: ' "$1" | LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>(/[a-z0-9]+)? stands for' |
        LC_ALL=C "$G" -a -o -E '^<[a-z][a-z0-9_-]*>' | LC_ALL=C sort -u
    }
    ph_undeclared() { LC_ALL=C comm -23 <(ph_used "$1") <(ph_declared "$1") | count_lines /dev/stdin; }
    PL='<'
    { cat "$SELF"; printf '%s\n' "read ${PL}zzplanted>/x"; } >"$B/ph-plant.sh"
    { cat "$SELF"; printf '%s\n' "read ${PL}zzplanted>/x" "echo \"root: ${PL}zzplanted> stands for x\""; } >"$B/ph-decl.sh"
    { cat "$SELF"; printf '%s\n' "  sed -e \"s#\$X#${PL}zzscrub>#g\""; } >"$B/ph-scrub.sh"
    echo "command: the scan's placeholder rule (the tokens before a slash and the scrub targets, against the tokens the root lines declare) over this script, and over three planted copies of it: one printing a token before a slash, the same with a root line declaring it, one scrubbing to a token (P1 verification ruling D; change NXD)"
    echo "  this script: placeholders printed: $(ph_used "$SELF" | tr '\n' ' '); declared by root lines: $(ph_declared "$SELF" | tr '\n' ' '); undeclared: $(ph_undeclared "$SELF")"
    check "every placeholder this script prints is declared by a root line (the scan's rule; P1 verification ruling D; change NXD)" "$(yn [ "$(ph_undeclared "$SELF")" = 0 ])"
    echo "  the planted copies: undeclared $(ph_undeclared "$B/ph-plant.sh"), $(ph_undeclared "$B/ph-decl.sh") and $(ph_undeclared "$B/ph-scrub.sh")"
    check "control: the same check finds the one token a planted copy prints before a slash with no root line (change NXD)" "$(yn [ "$(ph_undeclared "$B/ph-plant.sh")" = 1 ])"
    check "control: the same check finds none when a root line in the planted copy declares it (change NXD)" "$(yn [ "$(ph_undeclared "$B/ph-decl.sh")" = 0 ])"
    check "control: the same check finds the scrub target a planted copy writes with no root line (change NXD)" "$(yn [ "$(ph_undeclared "$B/ph-scrub.sh")" = 1 ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M6 part 4 close-out record: the push, the CI run and the scan')
    DOC=$(by_subject "M6 part 5 P1: commit planning docs (the spec, part 4's close-out verification)")
    CORE=$(by_subject 'M6 part 5 P1: Fill gains a gradient: the types, the composer, the checks and the typed read')
    TOOL=$(by_subject 'M6 part 5 P1: emend-copy --gradient-sample')
    # Change NZL: the fix commit, the phase commit (specs/0042 ruling I, finding
    # M2: the core and tool commits stay, the fix commit is the fifth role).
    FIX=$(by_subject 'M6 part 5 P1: Fill::compose under the rules feature (finding M2)')
    # Change NZP: the record the keep is compared with is the last committed
    # open-check record, the one part 4 P3's record commit added, found by its
    # subject (no hash is typed here); checked below to be an ancestor and the
    # last. The base, part 4's close-out record commit, adds logs alone.
    PREV_OPEN_REC=$(by_subject 'M6 part 4 P3 record: the logs, the records, the check, the scan')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  M6 part 4's close-out record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the core commit: ${CORE:-none}"
    echo "  the tool commit: ${TOOL:-none}"
    echo "  the fix commit, the phase commit (ruling I): ${FIX:-none}"
    echo "  the record commit the keep is compared with (the last to add an open-check record, part 4 P3's; change NZP): ${PREV_OPEN_REC:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$FIX" "$TOOL" "$CORE" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the fix commit, the tool commit, the core commit, the doc commit and the base, each the next one's parent, the fix commit the phase commit (change NZL)" "$(yn roles_in_order)"
    roles_ctl() { local FIX=$TOOL; roles_in_order; }
    check "control: roles_in_order refuses the tool commit named as the phase commit (change NZL)" "$(ynnot roles_ctl)"
    roles_ctl2() { local REC=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the base" "$(ynnot roles_ctl2)"
    roles_ctl3() { local CORE=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the core commit" "$(ynnot roles_ctl3)"
    roles_ctl4() { local TOOL=$CORE; roles_in_order; }
    check "control: roles_in_order refuses the core commit named as the tool commit (change NZL)" "$(ynnot roles_ctl4)"
    # record_is <commit> <subject prefix>: the commit is there, its subject
    # begins with the prefix, and it is an ancestor of the phase commit.
    record_is() { [ -n "$1" ] && git cat-file -e "$1^{commit}" && [ "$(git log -1 --format=%s "$1" | LC_ALL=C "$G" -cE "^$2")" = 1 ] && git merge-base --is-ancestor "$1" "$C"; }
    echo "command: git log -1 --format=%s <part 4 P3's record commit>"
    echo "    $(git log -1 --format=%s "$PREV_OPEN_REC")"
    check "the named record commit is M6 part 4 P3's record commit, an ancestor of the phase commit (change NZP)" "$(yn record_is "$PREV_OPEN_REC" 'M6 part 4 P3 record: ')"
    check "control: the same check refuses the base named instead" "$(ynnot record_is "$REC" 'M6 part 4 P3 record: ')"
    check "control: the same check refuses the doc commit named instead" "$(ynnot record_is "$DOC" 'M6 part 4 P3 record: ')"
    check "the base is M6 part 4's close-out record commit, an ancestor of the phase commit (change NZL)" "$(yn record_is "$REC" 'M6 part 4 close-out record: ')"
    # row_field <run.tsv> <column>: the run row's column, by header name.
    row_field() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && NR == 2 { print $k }' "$1"; }
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the fix commit, by its subject (ruling I; change NZL)" "$(yn [ "$FIX" = "$C" ])"
    check "control: the same comparison refuses the tool commit (change NZL)" "$(ynnot [ "$TOOL" = "$C" ])"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT")"
    short_names_head() { [ "$(git rev-parse "$SHORT")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    echo "phase: Milestone 6 part 5 P1 ($SPEC) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # Rulings AA and AK b (change NWV): every attempt refused at entry, or
    # superseded, is named by RERUN_NOTE and each of its files hashed here,
    # the hashing asserted by a check line (M5 part 6 P4's run log's form).
    # Change NXE (P1 verification ruling F): rerun_script <files>: some
    # file named is a .sh under <phase>/superseded, the superseded script that
    # wrote the attempt; its control runs every time.
    rerun_script() { local sf; for sf in $1; do case $sf in "$PHASE_DIR"/superseded/*.sh) return 0 ;; esac; done; return 1; }
    rerun_script_ctl() { ! rerun_script "$PHASE_DIR/superseded/x/run.log" && rerun_script "$PHASE_DIR/superseded/x/run.log $PHASE_DIR/superseded/x/m6p5-p1-run.sh"; }
    check "control: rerun_script refuses a planted RERUN_FILES naming a log alone, and takes one naming a script beside it (change NXE)" "$(yn rerun_script_ctl)"
    n_rerun_files=0
    n_rerun_missing=0
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in (ruling AA)"
      for sf in ${RERUN_FILES:-}; do
        n_rerun_files=$((n_rerun_files + 1))
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          n_rerun_missing=$((n_rerun_missing + 1))
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
      rerun_hashed() { [ "$n_rerun_files" -gt 0 ] && [ "$n_rerun_missing" = 0 ]; }
      check "every file of the attempt RERUN_NOTE names is hashed above, and RERUN_FILES names at least one (rulings AA and AK b)" "$(yn rerun_hashed)"
      # Change NWV: every file RERUN_FILES names lies in <phase>/superseded.
      rerun_kept() { local sf; for sf in ${RERUN_FILES:-}; do case $sf in "$PHASE_DIR"/superseded/*) ;; *) return 1 ;; esac; done; }
      check "every file RERUN_FILES names lies in <phase>/superseded (ruling AA)" "$(yn rerun_kept)"
      rerun_script_given() { rerun_script "${RERUN_FILES:-}"; }
      check "RERUN_FILES names the superseded script that wrote the attempt, a .sh under <phase>/superseded (P1 verification ruling F; change NXE)" "$(yn rerun_script_given)"
    fi
    
    # The two move checks as functions, run over planted inputs every time
    # below, and over a real moved keep or run directory when there is one.
    # keep_pairs_ok <listing>: the .in.xlsx lines times two equal the listing's
    # lines (the pattern in double quotes so the tab is interpolated).
    keep_pairs_ok() {
      local pairs files
      pairs=$(count_matches -E "[.]in[.]xlsx${TAB}" "$1")
      files=$(count_lines "$1")
      [ "$files" -ge 2 ] && [ "$((pairs * 2))" = "$files" ]
    }
    # run_listing <dir> <listing>: the listing of a run directory, one line per
    # file, path and bytes.
    run_listing() { (cd "$1" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$2"; }
    # run_listing_ok <dir> <listing>: the listing names each file once and at
    # least one.
    run_listing_ok() {
      local files lines uniq
      files=$(find "$1" -type f | wc -l)
      lines=$(count_lines "$2")
      uniq=$(cut -f1 "$2" | LC_ALL=C sort -u | count_lines /dev/stdin)
      [ "$files" -ge 1 ] && [ "$lines" = "$files" ] && [ "$uniq" = "$files" ]
    }
    
    if [ -n "$SUPERSEDED_RUN" ]; then
    for SUP_S in $SAMPLES $RERUNS; do
      SUP_OUT=$RUN_OUT_ROOT/$SUPERSEDED_RUN-$SUP_S
      SUP_TO=$SELF_DIR/out/superseded/run-$SUPERSEDED_RUN-$SUP_S
      echo "the superseded run directory, moved before this run: <runs>/$SUPERSEDED_RUN-$SUP_S to <scripts>/out/superseded/run-$SUPERSEDED_RUN-$SUP_S"
      sup_there=no
      if [ -d "$SUP_OUT" ]; then
        sup_there=yes
        echo "command: sha256sum <runs>/$SUPERSEDED_RUN-$SUP_S/summary.host.tsv and summary.i686.tsv; mv <runs>/$SUPERSEDED_RUN-$SUP_S <scripts>/out/superseded/run-$SUPERSEDED_RUN-$SUP_S"
        for sl in host i686; do
          if [ -f "$SUP_OUT/summary.$sl.tsv" ]; then echo "    summary.$sl.tsv sha256 $(sha_of "$SUP_OUT/summary.$sl.tsv")"; else echo "    summary.$sl.tsv: NO HASH EXISTS, the file is not there"; fi
        done
        run_listing "$SUP_OUT" "$B/superseded-run.listing"
        echo "command: (cd <runs>/$SUPERSEDED_RUN-$SUP_S && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum"
        echo "    files $(find "$SUP_OUT" -type f | wc -l); listing lines $(count_lines "$B/superseded-run.listing"); listing sha256 $(sha_of "$B/superseded-run.listing")"
        check "the listing of $SUPERSEDED_RUN-$SUP_S names each of its files once" "$(yn run_listing_ok "$SUP_OUT" "$B/superseded-run.listing")"
        if [ -e "$SUP_TO" ]; then echo "    $SUP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$SUP_OUT" "$SUP_TO"; fi
      fi
      sup_moved() { [ ! -e "$SUP_OUT" ] && [ -d "$SUP_TO" ]; }
      if [ "$sup_there" = yes ]; then
        check "the superseded run directory $SUPERSEDED_RUN-$SUP_S is moved, not removed, before the run" "$(yn sup_moved)"
      else
        echo "    <runs>/$SUPERSEDED_RUN-$SUP_S was not there; nothing to move (P3's NTT, carried; change NUB)"
      fi
    done
    fi
    if [ -n "$SUPERSEDED_KEEP" ]; then
      KEEP_TO=$SELF_DIR/out/superseded/keep-$SUPERSEDED_KEEP
      echo "the superseded keep, moved before this run: <keep> to <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
      if [ -d "$KEEP" ]; then
        (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/superseded-keep.listing"
        echo "command: (cd <keep> && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum; the .in.xlsx files counted; mv <keep> <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
        echo "    pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/superseded-keep.listing"); files $(count_lines "$B/superseded-keep.listing"); listing sha256 $(sha_of "$B/superseded-keep.listing")"
        check "the moved keep's pairs times two equals its files" "$(yn keep_pairs_ok "$B/superseded-keep.listing")"
        if [ -e "$KEEP_TO" ]; then echo "    $KEEP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$KEEP" "$KEEP_TO"; fi
      else
        echo "    NO LISTING EXISTS: there is no keep in place to move"
      fi
      keep_moved() { [ ! -e "$KEEP" ] && [ -d "$KEEP_TO" ]; }
      check "the superseded keep is moved, not removed, before the run" "$(yn keep_moved)"
    fi
    echo "superseded run directory named: ${SUPERSEDED_RUN:-none}; superseded keep named: ${SUPERSEDED_KEEP:-none}"
    echo
    echo "## the two move checks over planted inputs, run every time"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\n' "$TAB" "$TAB" >"$B/c-keep.listing"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\ny.1.out.xlsx%s1\n' "$TAB" "$TAB" "$TAB" >"$B/c-keep-odd.listing"
    echo "  planted keep listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep.listing"), files $(count_lines "$B/c-keep.listing"); with an unpaired output: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep-odd.listing"), files $(count_lines "$B/c-keep-odd.listing")"
    check "keep_pairs_ok passes a planted listing of one whole pair" "$(yn keep_pairs_ok "$B/c-keep.listing")"
    check "control: keep_pairs_ok refuses a planted listing with an unpaired output" "$(ynnot keep_pairs_ok "$B/c-keep-odd.listing")"
    mkdir -p "$B/c-run/abc123" && printf 'a' >"$B/c-run/summary.host.tsv" && printf 'bb' >"$B/c-run/abc123/out.host.xlsx" && printf 'ccc' >"$B/c-run/abc123/stdout.host.txt"
    run_listing "$B/c-run" "$B/c-run.listing"
    echo "  planted run directory: files $(find "$B/c-run" -type f | wc -l); listing lines $(count_lines "$B/c-run.listing"); listing sha256 $(sha_of "$B/c-run.listing")"
    check "run_listing_ok passes the planted run directory's own listing" "$(yn run_listing_ok "$B/c-run" "$B/c-run.listing")"
    { cat "$B/c-run.listing"; head -n 1 "$B/c-run.listing"; } >"$B/c-run-dup.listing"
    check "control: run_listing_ok refuses a listing that names one file twice" "$(ynnot run_listing_ok "$B/c-run" "$B/c-run-dup.listing")"
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run builds into <target>/main, the main tree's subdirectory of the phase's target root (CARGO_TARGET_DIR; change NSU)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the sample's child and --lo-timeout $LO_TIMEOUT_S per conversion, the figures every corpus run since Milestone 3 used; not tuned during the run."
    echo "root: <repo> stands for the repository's top level (inside <home>, scrubbed after <runs> and <corpus>, whose paths begin with it); scripts/counting.sh is read from it at the phase commit by git show; scripts/passthrough-run.sh, scripts/passthrough-record.py and scripts/edit-open-check.sh are run from it, each checked equal to the phase commit's, and the runner and the open check each source scripts/lo-check.sh, which is never run; the keep's tests run in it; the two record pairs are installed into its $RECORDS_DEST/"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m6p5-p1 on the disk, the phase's directory; a superseded attempt's files are kept in <phase>/superseded"
    echo "root: <scratch> stands for <phase>, the phase's directory, named <scratch> where TMPDIR is concerned as the close-out's scripts name it: TMPDIR is <scratch>/tmp, made and exported by this script before any mktemp, and <work> is made under it (close-out ruling 1; change NTI)"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory, which holds the script alone (change NVO); the two record pairs are written into <scripts>/out/records first (a dry run's into RECORDS_DEST/staged: change NWS), a superseded run directory and a superseded keep are moved into <scripts>/out/superseded, and this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (change NTI; the counting library, the checks' programs and outputs, derived tables, the planted listings, run directory and entry rows, the runs' TMPDIR <work>/tmp-run, the open check's TMPDIR <work>/tmp, the placeholder controls, ruling F's comparison and count programs and the comparison's planted run directory <work>/c-fc, and the Excel-form fixture's corpus <work>/fixcorpus and its two samples' run directories <work>/fixrun-namedstyles and <work>/fixrun-gradient: changes NXD, NZN and NZO), kept after the run and never removed"
    echo "root: <target> stands for <phase>/target on the disk, the phase's one target root: this log builds <repo> into <target>/main, the main tree's subdirectory, release binaries and the keep's tests, and into no other (changes NSK and NVM)"
    echo "root: <keep> stands for <phase>/keep-host on the disk unless RUN_KEEP names another for a dry run, this phase's host keep; kept after the run for planning"
    echo "root: <corpus> stands for the private corpus directory (the manifest and the inputs under <corpus>/corpus, read)"
    echo "root: <runs> stands for the corpus run directories' parent, <corpus>/runs unless RUN_OUT_ROOT names another for a dry run; this log's run directories <runs>/$RUN-gradient, <runs>/$RUN-namedstyles, <runs>/$RUN-read and <runs>/$RUN-roundtrip are written there (changes NZL and NZN); the three earlier runs ruling F compares with, and the run it names for the round trip, are read from <corpus>/runs and never written (change NZN)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$SELF_DIR" "$BUILD_ROOT" "$MAIN" "$KEEP" "$CORPUS" "$TMPDIR")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots other than <home>, <phase>, <work> and <runs> are distinct, none inside another (TMPDIR, <scratch>/tmp, among them; change NTI)" "$(yn roots_distinct)"
    work_in_tmpdir() { case "$B/" in "$TMPDIR/"*) return 0 ;; esac; return 1; }
    check "<work>, the directory mktemp -d made, is under TMPDIR, <scratch>/tmp (close-out ruling 1; change NTI)" "$(yn work_in_tmpdir)"
    work_ctl() { local B=/tmp/x; work_in_tmpdir; }
    check "control: the same test refuses a working directory under /tmp" "$(ynnot work_ctl)"
    work_ctl2() { local B=$SELF_DIR/out/work.x; work_in_tmpdir; }
    check "control: the same test refuses one under <scripts>/out, where the carried form made it" "$(ynnot work_ctl2)"
    tmpdir_ctl() { local TMPDIR=$SELF_DIR/out; work_in_tmpdir; }
    check "control: the same test refuses <work> against a TMPDIR it is not under" "$(ynnot tmpdir_ctl)"
    # Change NTS (specs/0033 "Planning rulings on P1", ruling 12): every
    # mktemp call of this script is checked under TMPDIR, so the source is
    # read for its calls outside comments; the call's text is built from
    # pieces, so this form's own text is no call.
    MKW='$('
    MKW=${MKW}mkt
    MKW=${MKW}emp
    count_tempcalls() {
      awk -v w="$MKW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { n++; s = substr(s, i + length(w)) }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "A=$MKW -d)" "F=$MKW)" "# $MKW -d)" >"$B/mktemp-fixture"
    n_mk=$(count_tempcalls "$SELF")
    n_mk_fix=$(count_tempcalls "$B/mktemp-fixture")
    echo "command: count_tempcalls <this script>, and the same over a fixture of three lines: a directory call, a file call, a comment"
    echo "  mktemp calls in this script outside comments: $n_mk (the one that makes <work>, checked under TMPDIR above); in the fixture: $n_mk_fix"
    check "this script makes one mktemp call, <work>'s, and no plain temporary file (ruling 12; change NTS)" "$(yn [ "$n_mk" = 1 ])"
    check "control: the same count finds the fixture's two calls and not its comment" "$(yn [ "$n_mk_fix" = 2 ])"
    runs_apart() { apart "$RUN_OUT_ROOT" "$MAIN" && apart "$RUN_OUT_ROOT" "$SELF_DIR"; }
    check "<runs> lies outside <repo> and <scripts>" "$(yn runs_apart)"
    check "control: apart refuses <target>/main/release against <target>/main, which holds it" "$(ynnot apart "$BUILD_ROOT/release" "$BUILD_ROOT")"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "the run directories: $(for s in $SAMPLES $RERUNS; do printf '<runs>/%s-%s ' "$RUN" "$s"; done)(changes NVX and NZN)"
    echo "the record stems: ${STEMS[gradient]} and $STEM_OPEN; the records' destination: $RECORDS_DEST; RUN_SKIP_KEEP: $RUN_SKIP_KEEP"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs and its two record pairs) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    if plan_admitted; then n_ours_ctl_want=4; else n_ours_ctl_want=3; fi
    ours_rec_ctl() {
      {
        printf '?? records/logs/m6p5-p1/run.log\n?? records/logs/m6p4-p3/run.log\n'
        printf '?? records/m6p5-p1-gradient-%s-%s.md\n?? records/m6p5-open-%s-%s.txt\n' "$DATE" "$SHORT" "$DATE" "$SHORT"
        printf '?? records/m6p5-p1-gradient-%s-abcdef0.md\n?? records/m6p5-p1-%s-%s.md\n?? records/m6p5-p1-namedstyles-%s-%s.md\n' "$DATE" "$DATE" "$SHORT" "$DATE" "$SHORT"
        printf '?? records/m6p4-p1-charttext-%s-%s.md\n?? records/m6p4-open-%s-%s.txt\n?? records/logs/m6p5-p1x/run.log\n' "$DATE" "$SHORT" "$DATE" "$SHORT"
        printf ' M ROADMAP.md\n M specs/0042-gradient-fills-and-named-styles.md\n M records/m6p5-p1-gradient-%s-%s.md\n' "$DATE" "$SHORT"
        printf ' M crates/emend/src/package.rs\n?? records/size-m6p5-2026-01-01-%s.md\n' "$SHORT"
      } | count_matches -E "$OURS" /dev/stdin
    }
    check "control: the phase's status pattern admits this phase's log and its two untracked record pairs alone; it refuses another phase's log, a record of another commit, a stem without a sample word or with another, another part's record stem, a sibling directory, a modified roadmap or spec, a modified record, a source file and a size record (changes NSB, NUI and NZL; the modified spec admitted only at PLANNING_SPEC, change NXS)" "$(yn [ "$(ours_rec_ctl)" = "$n_ours_ctl_want" ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources (the phase commit's, by git show; change NSB)"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts and the spec, against the phase commit"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh scripts/edit-open-check.sh; do
      check "$s in the main tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { [ "$(git show "$C:scripts/excel-check-list.py" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/edit-open-check.sh)" ]; }
    check "control: the same hash comparison tells two different scripts apart" "$(ynnot tree_ctl)"
    spec_now=$(sha_of "$SPEC")
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    spec_doc=$(git show "$DOC:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum; git show <doc commit>:$SPEC | sha256sum; sha256sum $SPEC (the working file, the committed one or the copy planning gives as PLANNING_SPEC, as the status check above holds; checked against PLANNING_SPEC when it is given; changes NXL and NXS)"
    echo "  at the phase commit: $spec_committed; at the doc commit: $spec_doc; the pin: $SPEC_WANT"
    echo "  the working tree's copy: sha256 $spec_now"
    spec_ok() { [ "$spec_committed" = "$SPEC_WANT" ]; }
    check "the spec at the phase commit is at the pinned hash" "$(yn spec_ok)"
    check "the spec at the phase commit is the doc commit's" "$(yn [ "$spec_committed" = "$spec_doc" ])"
    spec_ctl() { local spec_committed=1111111111111111111111111111111111111111111111111111111111111111; spec_ok; }
    check "control: the same check refuses the spec against another hash" "$(ynnot spec_ctl)"
    echo "  PLANNING_SPEC: ${PLANNING_SPEC:-unset}"
    planning_spec_ok() { [ -z "$PLANNING_SPEC" ] || [ "$spec_now" = "$PLANNING_SPEC" ]; }
    check "the working copy of the spec is at PLANNING_SPEC when it is given (change NWS)" "$(yn planning_spec_ok)"
    planning_spec_ctl() { local PLANNING_SPEC=1111111111111111111111111111111111111111111111111111111111111111; planning_spec_ok; }
    check "control: the same check refuses a working copy against another hash" "$(ynnot planning_spec_ctl)"
    echo "command: podman image exists $IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    
    echo
    echo "## the release binaries, built here at the phase commit, both targets (M5 part 4 P2's block, M5 part 3 P2's carried; change NVM)"
    echo "command: cargo build --release -p emend-copy -p xlsx-diff; the same with --target $I686 (CARGO_TARGET_DIR=<target>/main)"
    cargo build --release -p emend-copy -p xlsx-diff >"$B/build-host.out" 2>&1 </dev/null
    rc_h=$?
    cargo build --release -p emend-copy -p xlsx-diff --target "$I686" >"$B/build-i686.out" 2>&1 </dev/null
    rc_i=$?
    echo "  exit: host $rc_h, $I686 $rc_i"
    check "both release builds exit 0" "$(yn [ "$((rc_h + rc_i))" = 0 ])"
    PT_host=$CARGO_TARGET_DIR/release/emend-copy
    XD_host=$CARGO_TARGET_DIR/release/xlsx-diff
    PT_i686=$CARGO_TARGET_DIR/$I686/release/emend-copy
    XD_i686=$CARGO_TARGET_DIR/$I686/release/xlsx-diff
    for b in "$PT_host" "$XD_host" "$PT_i686" "$XD_i686"; do echo "  $b: sha256 $(sha_of "$b"), bytes $(stat -c %s "$b")"; done
    echo "  $(rustc --version)"
    
    echo
    echo "## the corpus manifest, and its workbooks holding a calculation chain (specs/0025 P3 verification ruling 4; change NSI)"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv" >"$B/order"
    manifest_rows=$(count_lines "$B/order")
    n_regular=$(find "$CORPUS/corpus" -maxdepth 1 -type f | wc -l)
    echo "command: awk over <corpus>/manifest.tsv's id and ext columns by header name; find <corpus>/corpus -maxdepth 1 -type f"
    echo "  manifest rows: $manifest_rows; regular files under <corpus>/corpus: $n_regular"
    check "the manifest names one workbook per regular file of the corpus directory" "$(yn [ "$manifest_rows" = "$n_regular" ])"
    check "the manifest names some workbook" "$(yn [ "$manifest_rows" -ge 1 ])"
    : >"$B/chain-ids"
    while IFS="$TAB" read -r id ext; do
      if [ "$(python3 -I -B -c 'import sys, zipfile; print(1 if "xl/calcChain.xml" in zipfile.ZipFile(sys.argv[1]).namelist() else 0)' "$CORPUS/corpus/$id.$ext")" = 1 ]; then
        printf '%s\n' "$id" >>"$B/chain-ids"
      fi
    done <"$B/order"
    N_CHAIN=$(count_lines "$B/chain-ids")
    echo "command: python3 -I -B -c <zipfile namelist> <corpus>/corpus/<id>.<ext>, for each manifest row"
    echo "  corpus workbooks holding xl/calcChain.xml: $N_CHAIN of $manifest_rows (ids: $(paste -sd' ' "$B/chain-ids"))"
    echo "  the rule covering them (changes NSI and NZM): the sample writes two value cells and no formula, so each calcChain entry is identical and unflagged on both labels, and none is dropped"
    check "some corpus workbook holds a calculation chain, so the chain rows below are read" "$(yn [ "$N_CHAIN" -ge 1 ])"
    
    echo
    echo "## the surface and gradient samples' line and entry rules, with their controls (specs/0039 and specs/0042 \"Harness runs\"; changes NXM and NZM)"
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    # The tool's keys, in its order (tools/emend-copy, --chart-surface-sample).
    # Change NXR: rows, the data rows referenced (ruling A), after series.
    KEYS_chartsurface="charts_before charts_after surface surface_3d of_pie series rows read_back chart_parts_after"
    echo "  the surface sample's keys, in the tool's order: $KEYS_chartsurface"
    # keys_ok <word> <keys> <tool line>: the word, then the keys in the tool's
    # order, each a number.
    keys_ok() {
      local k v got
      got=$(printf '%s\n' "$3" | tr '\t' '\n' | sed -n '2,$s/=.*//p' | paste -sd' ')
      [ "$(printf '%s\n' "$3" | cut -f1)" = "$1" ] || return 1
      [ "$got" = "$2" ] || return 1
      for k in $2; do
        v=$(kv "$3" "$k")
        printf '%s' "$v" | LC_ALL=C "$G" -qxE '[0-9]+' || return 1
      done
    }
    # surface_line_ok <tool line>: what "Harness runs" asks of the line: four
    # charts more than before, one contour, one 3D surface and two of-pie
    # plots among them, eight series, the four read back, and four chart
    # parts at least after (change NXM); the data rows referenced 1 to 1000
    # (ruling A; change NXR).
    surface_line_ok() {
      keys_ok chartsurface "$KEYS_chartsurface" "$1" || return 1
      [ "$(kv "$1" charts_after)" = "$(($(kv "$1" charts_before) + 4))" ] || return 1
      [ "$(kv "$1" surface)" = 1 ] && [ "$(kv "$1" surface_3d)" = 1 ] && [ "$(kv "$1" of_pie)" = 2 ] || return 1
      [ "$(kv "$1" series)" = 8 ] && [ "$(kv "$1" read_back)" = 4 ] || return 1
      [ "$(kv "$1" rows)" -ge 1 ] && [ "$(kv "$1" rows)" -le 1000 ] || return 1
      [ "$(kv "$1" chart_parts_after)" -ge 4 ]
    }
    # The tool test's line (tools/emend-copy/tests/null_rewrite.rs).
    LINE_S=$(printf 'chartsurface\tcharts_before=0\tcharts_after=4\tsurface=1\tsurface_3d=1\tof_pie=2\tseries=8\trows=1\tread_back=4\tchart_parts_after=4')
    echo "  the tool test's line: $(printf '%s' "$LINE_S" | tr '\t' ' ')"
    check "control: surface_line_ok accepts the tool test's line" "$(yn surface_line_ok "$LINE_S")"
    check "control: surface_line_ok refuses the line with charts_after not four more" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/charts_after=4/charts_after=3/')")"
    check "control: surface_line_ok refuses the line with two contours" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/surface=1/surface=2/')")"
    check "control: surface_line_ok refuses the line with no 3D surface" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/surface_3d=1/surface_3d=0/')")"
    check "control: surface_line_ok refuses the line with one of-pie plot" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/of_pie=2/of_pie=1/')")"
    check "control: surface_line_ok refuses the line with seven series" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/series=8/series=7/')")"
    check "control: surface_line_ok refuses the line with three read back" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/read_back=4/read_back=3/')")"
    check "control: surface_line_ok refuses the line with three chart parts after" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/chart_parts_after=4/chart_parts_after=3/')")"
    check "control: surface_line_ok refuses the line with a key missing" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/\tseries=8//')")"
    check "control: surface_line_ok refuses the keys out of the tool's order" "$(ynnot surface_line_ok "$(printf '%s\tseries=8' "$(printf '%s' "$LINE_S" | sed 's/\tseries=8//')")")"
    check "control: surface_line_ok refuses the 3D sample's word" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/^chartsurface/chart3d/')")"
    check "control: surface_line_ok refuses the line with rows 1001, past the bound (change NXR)" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/rows=1/rows=1001/')")"
    check "control: surface_line_ok refuses the line with rows 0 (change NXR)" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/rows=1/rows=0/')")"
    check "control: surface_line_ok refuses a value that is not a number" "$(ynnot surface_line_ok "$(printf '%s' "$LINE_S" | sed 's/charts_before=0/charts_before=x/')")"
    # P1's summary helpers, carried verbatim (part 4 P2's change NVA, carried).
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    # count_ok_where <summary> <column> <value>: among the rows whose outcome is ok.
    count_ok_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) { if ($i == c) k = i; if ($i == "outcome") o = i }; next } k && o && $o == "ok" && $k == v { n++ } END { print n + 0 }' "$1"; }
    sum_col() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { n += $k } END { print n + 0 }' "$1"; }
    # status_rows <entries> <status>: the entry rows of that status, every
    # workbook.
    status_rows() { awk -F'\t' -v s="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "status") k = i; next } k && $k == s { n++ } END { print n + 0 }' "$1"; }
    # surface_made <entries> <id>: 1 when the runner's rows for the workbook
    # add a drawing part, else 0; the line prints no drawing_created, so the
    # form is read from the rows (M5 part 5 P3's labels_made, carried; change
    # NXM).
    surface_made() {
      awk -F'\t' -v id="$2" '
        NR == 1 { for (c = 1; c <= NF; c++) k[$c] = c; next }
        $k["id"] == id && $k["status"] == "added" && $k["name"] ~ /^xl\/drawings\/drawing[0-9]+[.]xml$/ { n++ }
        END { print (n > 0 ? 1 : 0) }' "$1"
    }
    # surface_named <entries> <id> <made> [<chart parts>]: the runner's rows for one workbook
    # as "Harness runs" gives them for the surface sample, the kinds sample's
    # pattern (M5 part 5 P3's labels_named for four charts; change NXM):
    # [Content_Types].xml changed; four chart parts xl/charts/chart<N>.xml
    # added; with a drawing created, one drawing part and its rels part added,
    # one worksheet part changed and one worksheet rels part added or changed;
    # with none, one drawing part changed and one drawing rels part added or
    # changed and no worksheet part changed; every added row unflagged (a
    # changed row may carry the runner's flags, its local header rewritten);
    # every other row identical and unflagged; nothing dropped or
    # recompressed. The chart parts added are four unless the fourth argument
    # gives their count (part 4 P1's text sample took three; changes NXU and
    # NYV). The surface rule is carried as the controls' foil (change NZM).
    surface_named() {
      awk -F'\t' -v id="$2" -v made="$3" -v want="${4:-4}" '
        NR == 1 { for (c = 1; c <= NF; c++) k[$c] = c; next }
        $k["id"] != id { next }
        {
          n++; s = $k["status"]; f = $k["flags"]; nm = $k["name"]
          if (s == "identical") { if (f != "") bad++; next }
          if (s == "added") {
            if (f != "") bad++
            if (nm ~ /^xl\/charts\/chart[0-9]+[.]xml$/) chart++
            else if (made == 1 && nm ~ /^xl\/drawings\/drawing[0-9]+[.]xml$/) dpart++
            else if (nm ~ /^xl\/drawings\/_rels\/drawing[0-9]+[.]xml[.]rels$/) drels++
            else if (made == 1 && nm ~ /^xl\/worksheets\/_rels\/[^\/]+[.]xml[.]rels$/) srels++
            else bad++
            next
          }
          if (s == "changed") {
            if (nm == "[Content_Types].xml") ct++
            else if (made == 1 && nm ~ /^xl\/worksheets\/[^\/]+[.]xml$/) sheet++
            else if (made == 1 && nm ~ /^xl\/worksheets\/_rels\/[^\/]+[.]xml[.]rels$/) srels++
            else if (made == 0 && nm ~ /^xl\/drawings\/drawing[0-9]+[.]xml$/) dpart++
            else if (made == 0 && nm ~ /^xl\/drawings\/_rels\/drawing[0-9]+[.]xml[.]rels$/) drels++
            else bad++
            next
          }
          bad++
        }
        END {
          if (n == 0 || bad > 0 || ct != 1 || chart != want || dpart != 1 || drels != 1) exit 1
          if (made == 1 && (sheet != 1 || srels != 1)) exit 1
          if (made == 0 && (sheet + srels) != 0) exit 1
          if (made != 0 && made != 1) exit 1
        }' "$1"
    }
    # chain_rows_of <entries> <id>: the workbook's calcChain rows, those
    # identical and unflagged, and those dropped (change NSI).
    chain_rows_of() {
      awk -F'\t' -v id="$2" '
        NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next }
        $col["id"] == id && $col["name"] == "xl/calcChain.xml" { n++; if ($col["status"] == "identical" && $col["flags"] == "") s++; if ($col["status"] == "dropped") d++ }
        END { print n + 0, s + 0, d + 0 }' "$1"
    }
    # The rule's controls: accepted where it holds, refused on each planted row
    # where it does not (change NXM).
    etsv() { { printf 'id\tname\tstatus\tflags\n'; printf "$@"; } >"$B/ce.tsv"; }
    CT='w\t[Content_Types].xml\tchanged\tdescriptor\n'
    KEPT='w\txl/styles.xml\tidentical\t\nw\txl/workbook.xml\tidentical\t\n'
    CHART3='w\txl/charts/chart3.xml\tadded\t\nw\txl/charts/chart4.xml\tadded\t\nw\txl/charts/chart5.xml\tadded\t\n'
    CHART4="${CHART3}"'w\txl/charts/chart6.xml\tadded\t\n'
    CHART5="${CHART4}"'w\txl/charts/chart7.xml\tadded\t\n'
    MADE='w\txl/worksheets/sheet1.xml\tchanged\tdescriptor\nw\txl/worksheets/_rels/sheet1.xml.rels\tchanged\t\nw\txl/drawings/drawing2.xml\tadded\t\nw\txl/drawings/_rels/drawing2.xml.rels\tadded\t\n'
    APPENDED='w\txl/drawings/drawing1.xml\tchanged\tdescriptor\nw\txl/drawings/_rels/drawing1.xml.rels\tchanged\t\n'
    sn_made() { surface_named "$B/ce.tsv" w 1; }
    sn_kept() { surface_named "$B/ce.tsv" w 0; }
    etsv "$KEPT$CT$CHART4$MADE"
    check "control: surface_named accepts a planted created drawing" "$(yn sn_made)"
    check "control: surface_named refuses the same rows read as an appended drawing" "$(ynnot sn_kept)"
    check "control: surface_made reads the planted created drawing as created" "$(yn [ "$(surface_made "$B/ce.tsv" w)" = 1 ])"
    etsv "$KEPT${CT}${CHART4}w\txl/worksheets/sheet1.xml\tchanged\tdescriptor\nw\txl/worksheets/_rels/sheet1.xml.rels\tadded\t\nw\txl/drawings/drawing1.xml\tadded\t\nw\txl/drawings/_rels/drawing1.xml.rels\tadded\t\n"
    check "control: surface_named accepts a created drawing whose worksheet rels part is added" "$(yn sn_made)"
    etsv "$KEPT$CT$CHART4$APPENDED"
    check "control: surface_named accepts a planted appended drawing" "$(yn sn_kept)"
    check "control: surface_named refuses the same rows read as a created drawing" "$(ynnot sn_made)"
    check "control: surface_made reads the planted appended drawing as appended to" "$(yn [ "$(surface_made "$B/ce.tsv" w)" = 0 ])"
    etsv "$KEPT${CT}${CHART4}w\txl/drawings/drawing1.xml\tchanged\t\nw\txl/drawings/_rels/drawing1.xml.rels\tadded\t\n"
    check "control: surface_named accepts an appended drawing whose rels part is added" "$(yn sn_kept)"
    etsv "$KEPT$CT$CHART3$APPENDED"
    check "control: surface_named refuses three chart parts added" "$(ynnot sn_kept)"
    etsv "$KEPT$CT$CHART5$APPENDED"
    check "control: surface_named refuses five chart parts added" "$(ynnot sn_kept)"
    etsv "$KEPT$CHART4$APPENDED"
    check "control: surface_named refuses [Content_Types].xml unchanged" "$(ynnot sn_kept)"
    etsv "${KEPT}w\txl/theme/theme1.xml\tchanged\t\n$CT$CHART4$APPENDED"
    check "control: surface_named refuses another part changed" "$(ynnot sn_kept)"
    etsv "${KEPT}w\txl/styles.xml\tidentical\tmtime\n$CT$CHART4$APPENDED"
    check "control: surface_named refuses an identical row flagged" "$(ynnot sn_kept)"
    etsv "$KEPT${CT}${CHART3}w\txl/charts/chart9.xml\tadded\tdescriptor\n$APPENDED"
    check "control: surface_named refuses an added row flagged" "$(ynnot sn_kept)"
    etsv "$KEPT$CT$CHART4${APPENDED}w\txl/calcChain.xml\tdropped\t\n"
    check "control: surface_named refuses a dropped row" "$(ynnot sn_kept)"
    etsv "$KEPT$CT$CHART4${APPENDED}w\txl/calcChain.xml\trecompressed\t\n"
    check "control: surface_named refuses a recompressed row" "$(ynnot sn_kept)"
    etsv "$KEPT$CT$CHART4${APPENDED}w\txl/media/image1.png\tadded\t\n"
    check "control: surface_named refuses another part added" "$(ynnot sn_kept)"
    etsv "$KEPT$CT$CHART4$APPENDED"
    sn_two() { surface_named "$B/ce.tsv" w 2; }
    check "control: surface_named refuses a form other than 0 or 1" "$(ynnot sn_two)"
    sn_none() { surface_named "$B/ce.tsv" v 0; }
    check "control: surface_named refuses a workbook with no rows" "$(ynnot sn_none)"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\tidentical\t\n'
    check "control: chain_rows_of reads the planted workbook's one calcChain row, identical and unflagged" "$(yn [ "$(chain_rows_of "$B/ce.tsv" w)" = "1 1 0" ])"
    etsv 'w\txl/styles.xml\tidentical\t\nw\txl/calcChain.xml\tdropped\t\n'
    check "control: chain_rows_of reads a dropped calcChain row as dropped" "$(yn [ "$(chain_rows_of "$B/ce.tsv" w)" = "1 0 1" ])"
    # Change NZM: the gradient sample's rule in place of part 4 P1's text
    # sample's (specs/0042 "Harness runs", --gradient-sample). Its keys, in the
    # tool's order (tools/emend-copy, --gradient-sample).
    KEYS_gradient="added xfs_before xfs_after fills_added cells_before cells_after read_back gradients_before"
    echo "  the gradient sample's keys, in the tool's order: $KEYS_gradient"
    # gradient_line_ok <tool line>: what "Harness runs" asks of the line: the
    # word edit, two cell formats added (xfs_after two more than xfs_before),
    # two fills added, two cells more, both fills read back with their
    # gradient (read_back 2, asserted by the tool as --style-sample's are), and
    # gradients_before a count (change NZM).
    gradient_line_ok() {
      keys_ok edit "$KEYS_gradient" "$1" || return 1
      [ "$(kv "$1" added)" = 2 ] && [ "$(kv "$1" fills_added)" = 2 ] && [ "$(kv "$1" read_back)" = 2 ] || return 1
      [ "$(kv "$1" xfs_after)" = "$(($(kv "$1" xfs_before) + 2))" ] || return 1
      [ "$(kv "$1" cells_after)" = "$(($(kv "$1" cells_before) + 2))" ]
    }
    # The gradient tool test's line (tools/emend-copy/tests/null_rewrite.rs,
    # the_gradient_sample_adds_two_gradient_fills_and_two_formats).
    LINE_G=$(printf 'edit\tadded=2\txfs_before=3\txfs_after=5\tfills_added=2\tcells_before=2\tcells_after=4\tread_back=2\tgradients_before=1')
    echo "  the gradient tool test's line: $(printf '%s' "$LINE_G" | tr '\t' ' ')"
    check "control: gradient_line_ok accepts the gradient tool test's line (change NZM)" "$(yn gradient_line_ok "$LINE_G")"
    check "control: gradient_line_ok refuses the line with one format added" "$(ynnot gradient_line_ok "$(printf '%s' "$LINE_G" | sed 's/added=2/added=1/')")"
    check "control: gradient_line_ok refuses the line with xfs_after not two more" "$(ynnot gradient_line_ok "$(printf '%s' "$LINE_G" | sed 's/xfs_after=5/xfs_after=4/')")"
    check "control: gradient_line_ok refuses the line with one fill added" "$(ynnot gradient_line_ok "$(printf '%s' "$LINE_G" | sed 's/fills_added=2/fills_added=1/')")"
    check "control: gradient_line_ok refuses the line with cells_after one more" "$(ynnot gradient_line_ok "$(printf '%s' "$LINE_G" | sed 's/cells_after=4/cells_after=3/')")"
    check "control: gradient_line_ok refuses the line with one read back" "$(ynnot gradient_line_ok "$(printf '%s' "$LINE_G" | sed 's/read_back=2/read_back=1/')")"
    check "control: gradient_line_ok refuses the line with a key missing" "$(ynnot gradient_line_ok "$(printf '%s' "$LINE_G" | sed 's/\tfills_added=2//')")"
    check "control: gradient_line_ok refuses the keys out of the tool's order (read_back moved last)" "$(ynnot gradient_line_ok "$(printf '%s\tread_back=2' "$(printf '%s' "$LINE_G" | sed 's/\tread_back=2//')")")"
    check "control: gradient_line_ok refuses a line whose first word is not edit" "$(ynnot gradient_line_ok "$(printf '%s' "$LINE_G" | sed 's/^edit/font/')")"
    check "control: gradient_line_ok refuses the surface sample's line" "$(ynnot gradient_line_ok "$LINE_S")"
    check "control: surface_line_ok refuses the gradient sample's line" "$(ynnot surface_line_ok "$LINE_G")"
    check "control: gradient_line_ok refuses a value that is not a number" "$(ynnot gradient_line_ok "$(printf '%s' "$LINE_G" | sed 's/gradients_before=1/gradients_before=x/')")"
    # gradient_made <entries> <id>: the sample has one form, 0 (it creates no
    # part); kept so the per-sample block reads a form as before.
    gradient_made() { echo 0; }
    # gradient_named <entries> <id> <made>: the runner's rows for one workbook
    # as "Harness runs" gives them for the gradient sample: xl/styles.xml
    # changed (two fills and two cell formats appended) and one worksheet part
    # changed (the two new cells); every other row identical and unflagged (a
    # changed row may carry the runner's flags, its local header rewritten);
    # nothing added, dropped or recompressed; the form 0 alone (change NZM).
    gradient_named() {
      awk -F'\t' -v id="$2" -v made="$3" '
        NR == 1 { for (c = 1; c <= NF; c++) k[$c] = c; next }
        $k["id"] != id { next }
        {
          n++; s = $k["status"]; f = $k["flags"]; nm = $k["name"]
          if (s == "identical") { if (f != "") bad++; next }
          if (s == "changed") {
            if (nm == "xl/styles.xml") st++
            else if (nm ~ /^xl\/worksheets\/[^\/]+[.]xml$/) sheet++
            else bad++
            next
          }
          bad++
        }
        END { if (n == 0 || bad > 0 || st != 1 || sheet != 1 || made != 0) exit 1 }' "$1"
    }
    GKEPT='w\t[Content_Types].xml\tidentical\t\nw\txl/workbook.xml\tidentical\t\nw\txl/worksheets/sheet2.xml\tidentical\t\n'
    GST='w\txl/styles.xml\tchanged\tdescriptor\n'
    GSH='w\txl/worksheets/sheet1.xml\tchanged\tdescriptor\n'
    gn() { gradient_named "$B/ce.tsv" w 0; }
    etsv "$GKEPT$GST$GSH"
    check "control: gradient_named accepts a planted workbook with its styles part and one worksheet changed (change NZM)" "$(yn gn)"
    gn1() { gradient_named "$B/ce.tsv" w 1; }
    check "control: gradient_named refuses the same rows read in a form other than 0" "$(ynnot gn1)"
    check "control: gradient_made reads the form 0" "$(yn [ "$(gradient_made "$B/ce.tsv" w)" = 0 ])"
    etsv "$GKEPT$GSH"
    check "control: gradient_named refuses the styles part unchanged" "$(ynnot gn)"
    etsv "$GKEPT$GST"
    check "control: gradient_named refuses no worksheet changed" "$(ynnot gn)"
    etsv "$GKEPT$GST${GSH}w\txl/worksheets/sheet3.xml\tchanged\t\n"
    check "control: gradient_named refuses two worksheets changed" "$(ynnot gn)"
    etsv "$GKEPT$GST${GSH}w\txl/theme/theme1.xml\tchanged\t\n"
    check "control: gradient_named refuses another part changed" "$(ynnot gn)"
    etsv "$GKEPT$GST${GSH}w\txl/media/image1.png\tadded\t\n"
    check "control: gradient_named refuses a part added" "$(ynnot gn)"
    etsv "$GKEPT$GST${GSH}w\txl/calcChain.xml\tdropped\t\n"
    check "control: gradient_named refuses a dropped row" "$(ynnot gn)"
    etsv "$GKEPT$GST${GSH}w\txl/calcChain.xml\trecompressed\t\n"
    check "control: gradient_named refuses a recompressed row" "$(ynnot gn)"
    etsv "${GKEPT}w\txl/sharedStrings.xml\tidentical\tmtime\n$GST$GSH"
    check "control: gradient_named refuses an identical row flagged" "$(ynnot gn)"
    etsv "$GKEPT$GST$GSH"
    gnv() { gradient_named "$B/ce.tsv" v 0; }
    check "control: gradient_named refuses a workbook with no rows" "$(ynnot gnv)"
    # refusal_of <run dir> <id> <label>: the layer's one "error: " line when the
    # row is a refusal, else nothing.
    refusal_of() { sed -n '1s/^error: //p' "$1/$2/stderr.$3.txt"; }
    
    
    echo
    echo "## TMPDIR for the corpus runs, on the disk"
    RUNTMP=$B/tmp-run
    mkdir "$RUNTMP" || exit 2
    dev_tmp=$(stat -c %d "$RUNTMP")
    dev_corpus=$(stat -c %d "$CORPUS/corpus")
    dev_proc=$(stat -c %d /proc)
    echo "command: mkdir <work>/tmp-run; stat -c %d <work>/tmp-run <corpus>/corpus /proc; df --output=fstype,target <work>/tmp-run <corpus>/corpus"
    echo "  device of TMPDIR (<work>/tmp-run): $dev_tmp; of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    df --output=fstype,target "$RUNTMP" "$CORPUS/corpus" | sed 's/^/    /'
    check "TMPDIR for the corpus runs and the corpus directory are on one device" "$(yn [ "$dev_tmp" = "$dev_corpus" ])"
    check "control: the same comparison tells /proc's device from the corpus directory's" "$(yn [ "$dev_proc" != "$dev_corpus" ])"
    
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names. Change VJ: the dropped families are an
    input, as the changed and added ones are."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, want_changed, want_added, want_dropped, tool_arg = sys.argv[1:9]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    def listed(value):
        return value.split(",") if value else []
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        changed_f = sorted(f for f in fam if fam[f].get("changed"))
        dropped_f = sorted(f for f in fam if fam[f].get("dropped"))
        added_f = sorted(f for f in fam if fam[f].get("added"))
        checks.append(("%s: the xml families are the changed entries' families" % label, sorted(xf) == changed_f))
        checks.append(("%s: the changed entries' families are %s" % (label, want_changed or "none"), changed_f == listed(want_changed)))
        checks.append(("%s: the dropped entries' families are %s" % (label, want_dropped or "none"), dropped_f == listed(want_dropped)))
        checks.append(("%s: the added entries' families are %s" % (label, want_added or "none"), added_f == listed(want_added)))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: " + tool_arg in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    fams_of() {
      python3 -I -B -c 'import importlib.util, sys
    spec = importlib.util.spec_from_file_location("record", sys.argv[1])
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    rows = [l.split("\t", 1) for l in open(sys.argv[2]).read().split("\n") if l]
    print(",".join(sorted({record.family(n) for (k, n) in rows if k == sys.argv[3]})))' scripts/passthrough-record.py "$1" "$2"
    }
    inst_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
    # Change JI: no bytecode was written, so there is nothing to remove.
    no_pycache() { [ ! -e scripts/__pycache__ ]; }
    # Change NVX: the per-sample block P2 ran once, run for each sample in
    # turn, here the one (change NZM): line_ok, form_of and named give the
    # sample's rule; every file under <work> carries the sample's word.
    # line_ok <tool line> <id>: the line by the rule.
    line_ok() {
      case $SAMPLE in
        gradient) gradient_line_ok "$1" ;;
        *) return 1 ;;
      esac
    }
    # form_of <entries> <id> <tool line>: the sample's one form, 0 (change
    # NZM).
    form_of() {
      case $SAMPLE in
        gradient) gradient_made "$1" "$2" ;;
      esac
    }
    # named <entries> <id> <form> <tool line>: the workbook's rows by the
    # sample's rule for that form.
    named() {
      case $SAMPLE in
        gradient) gradient_named "$1" "$2" "$3" ;;
        *) return 1 ;;
      esac
    }
    for SAMPLE in $SAMPLES; do
    EDIT=${EDITS[$SAMPLE]}
    STEM=${STEMS[$SAMPLE]}
    O=$RUN_OUT_ROOT/$RUN-$SAMPLE
    case $SAMPLE in
      gradient)
        LINE_WHAT="the word edit, two cell formats added, two fills added, two cells more, both fills read back with their gradient"
        ROWS_WHAT="nothing added, dropped or recompressed, files_identical no in every ok row; each workbook's rows by the gradient rule above: the styles part and one worksheet changed"
        SUMMARY_WHAT="nothing dropped or recompressed"
        FORM_WHAT="a form other than 0 (none expected)"
        # The control below: the first workbook's line with one read back more
        # (change NZM).
        SERIES_SED='s/read_back=2/read_back=3/'
        ;;
    esac
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      echo
      echo "## $SAMPLE: $label run, --tool-arg $EDIT"
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --out <runs>/$RUN-$SAMPLE --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$O" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
        >"$B/run-$SAMPLE-$label.stdout" 2>"$B/run-$SAMPLE-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$SAMPLE-$label.stderr")"
      sed 's/^/    /' "$B/run-$SAMPLE-$label.stdout"
      check "$SAMPLE $label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$SAMPLE $label: its stderr is empty" "$(yn [ ! -s "$B/run-$SAMPLE-$label.stderr" ])"
      n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
      echo "  entries left in <work>/tmp-run after the run: $n_left"
      check "$SAMPLE $label: the runs' TMPDIR is empty after the run" "$(yn [ "$n_left" = 0 ])"
      SUM=$O/summary.$label.tsv
      ENT=$O/entries.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      n_ok=$(count_where "$SUM" outcome ok)
      # The refusals, by id and message.
      : >"$B/refused-$SAMPLE-$label"
      while IFS="$TAB" read -r id ext; do
        if [ "$(awk -F'\t' -v id="$id" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id { print $k["outcome"] " " $k["exit"] }' "$SUM")" = "error 2" ] \
           && [ "$(count_lines "$O/$id/stderr.$label.txt")" = 1 ] && [ -n "$(refusal_of "$O" "$id" "$label")" ]; then
          printf '%s\t%s\n' "$id" "$(refusal_of "$O" "$id" "$label")" >>"$B/refused-$SAMPLE-$label"
        fi
      done <"$B/order"
      n_ref=$(count_lines "$B/refused-$SAMPLE-$label")
      echo "  summary rows: $rows; outcome ok: $n_ok; refused by the layer (a finding; fails the summary): $n_ref"
      sed 's/^/    refused: /' "$B/refused-$SAMPLE-$label"
      echo "  among the ok rows: lo ok $(count_ok_where "$SUM" lo ok); lo_in ok $(count_ok_where "$SUM" lo_in ok); leftover no $(count_ok_where "$SUM" leftover no); order_preserved yes $(count_ok_where "$SUM" order_preserved yes); comment_equal yes $(count_ok_where "$SUM" comment_equal yes); files_identical no $(count_ok_where "$SUM" files_identical no), yes $(count_ok_where "$SUM" files_identical yes)"
      echo "  every row: lo_in ok $(count_where "$SUM" lo_in ok); leftover no $(count_where "$SUM" leftover no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      echo "  the entries table's rows by status: identical $(status_rows "$ENT" identical), recompressed $(status_rows "$ENT" recompressed), changed $(status_rows "$ENT" changed), dropped $(status_rows "$ENT" dropped), added $(status_rows "$ENT" added)"
      echo "  the entry totals the ok rows imply (an edit sample; changes NVW and NVX): $ROWS_WHAT"
      summary_ok() {
        local col st
        [ "$rows" = "$manifest_rows" ] || return 1
        [ "$n_ok" = "$rows" ] && [ "$n_ref" = 0 ] || return 1
        for col in "lo ok" "lo_in ok" "leftover no" "order_preserved yes" "comment_equal yes" "files_identical no"; do
          [ "$(count_ok_where "$SUM" ${col% *} ${col#* })" = "$n_ok" ] || return 1
        done
        [ "$(count_where "$SUM" lo_in ok)" = "$rows" ] || return 1
        [ "$(count_where "$SUM" leftover no)" = "$rows" ] || return 1
        if [ "$SAMPLE" = gradient ]; then
          for st in dropped recompressed; do
            [ "$(sum_col "$SUM" "$st")" = 0 ] || return 1
          done
        fi
        for st in identical recompressed changed dropped added; do
          [ "$(sum_col "$SUM" "$st")" = "$(status_rows "$ENT" "$st")" ] || return 1
        done
      }
      check "$SAMPLE $label: every row ok; every row's input opens (lo_in ok) with no leftover; every output opens (lo ok), order and comment kept, files_identical no; $SUMMARY_WHAT; the summary's status totals the entries table's (change NVX)" "$(yn summary_ok)"
      echo "  per ok workbook: id and the tool's line (counts and flags only)"
      : >"$B/lines-$SAMPLE-$label"
      : >"$B/made-$SAMPLE-$label"
      nwb=0; nline=0; nentries=0; nform=0
      nchain=0; nchain_same=0; nchain_drop=0
      while IFS="$TAB" read -r id ext; do
        if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$SAMPLE-$label")" ]; then continue; fi
        nwb=$((nwb + 1))
        e=$(cat "$O/$id/stdout.$label.txt")
        printf '%s\t%s\n' "$id" "$e" >>"$B/lines-$SAMPLE-$label"
        printf '    %s %s\n' "$id" "$(printf '%s' "$e" | tr '\t' ' ')"
        form=$(form_of "$ENT" "$id" "$e")
        printf '%s\t%s\n' "$id" "$form" >>"$B/made-$SAMPLE-$label"
        if [ "$form" = 1 ]; then nform=$((nform + 1)); fi
        if LC_ALL=C "$G" -qxF "$id" "$B/chain-ids"; then
          cr=$(chain_rows_of "$ENT" "$id")
          set -- $cr
          nchain=$((nchain + $1)); nchain_same=$((nchain_same + $2)); nchain_drop=$((nchain_drop + $3))
        fi
        if line_ok "$e" "$id"; then nline=$((nline + 1)); else echo "    $id: the tool's line is not what the spec reads"; fi
        if named "$ENT" "$id" "$form" "$e"; then nentries=$((nentries + 1)); else echo "    $id: the entry rows are not what the rule gives for the form read, $form"; fi
      done <"$B/order"
      echo "  ok workbooks read: $nwb; the line as the spec reads: $nline; entry rows as the rule gives: $nentries; $FORM_WHAT: $nform, not: $((nwb - nform))"
      check "$SAMPLE $label: every ok workbook's line was read" "$(yn [ "$nwb" = "$n_ok" ])"
      check "$SAMPLE $label: every line is what the spec reads ($LINE_WHAT; change NWW)" "$(yn [ "$nline" = "$n_ok" ])"
      check "$SAMPLE $label: every ok workbook's entry rows are as the rule gives (change NWW)" "$(yn [ "$nentries" = "$n_ok" ])"
      echo "  calcChain rows in the ok rows of the chain workbooks: $nchain; identical and unflagged: $nchain_same; dropped: $nchain_drop (change NSI)"
      chain_kept() { [ "$nchain" = "$N_CHAIN" ] && [ "$nchain_same" = "$nchain" ] && [ "$nchain_drop" = 0 ]; }
      check "$SAMPLE $label: every chain workbook has one calcChain row, identical and unflagged, none dropped (change NSI)" "$(yn chain_kept)"
      R=$O/run.$label.tsv
      args=$(row_field "$R" tool_args)
      bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
      check "$SAMPLE $label: the run row records the two release binaries built here by sha256 and the phase commit (change NVM)" "$(yn bins_in_row)"
      check "$SAMPLE $label: the run row's tool_args is $EDIT" "$(yn [ "$args" = "$EDIT" ])"
    done
    check "$SAMPLE: the same workbooks are refused on both targets, with the same messages (none)" "$(yn cmp -s "$B/refused-$SAMPLE-host" "$B/refused-$SAMPLE-i686")"
    cp "$B/refused-$SAMPLE-host" "$B/c-refused"; printf 'x\tsome message\n' >>"$B/c-refused"
    check "control: the same comparison tells a planted refusal list from the host's" "$(ynnot cmp -s "$B/c-refused" "$B/refused-$SAMPLE-i686")"
    mkdir -p "$B/c-refrun/r1"
    printf 'error: a planted message\n' >"$B/c-refrun/r1/stderr.host.txt"
    ref_read() { [ "$(refusal_of "$B/c-refrun" r1 host)" = "a planted message" ]; }
    check "control: refusal_of reads a planted refusal's message" "$(yn ref_read)"
    : >"$B/c-refrun/r1/stderr.host.txt"
    ref_none() { [ -z "$(refusal_of "$B/c-refrun" r1 host)" ]; }
    check "control: refusal_of reads nothing from an empty standard error" "$(yn ref_none)"
    first_line() { awk -F'\t' -v id="$1" '$1 == id { sub(/^[^\t]*\t/, ""); print; exit }' "$B/lines-$SAMPLE-host"; }
    entries_ctl() {
      local id
      id=$(head -n 1 "$B/order" | cut -f1)
      named "$O/entries.host.tsv" "${id}x" 0 "$(first_line "$id")"
    }
    check "control: $SAMPLE: named refuses the first workbook's id with a letter appended, which has no rows" "$(ynnot entries_ctl)"
    first_line_ctl() { local id ext ENT; id=$(head -n 1 "$B/order" | cut -f1); ext=$(head -n 1 "$B/order" | cut -f2); ENT=$O/entries.host.tsv; line_ok "$(first_line "$id" | sed "$SERIES_SED")" "$id"; }
    check "control: $SAMPLE: line_ok refuses the first workbook's host line with one read back more (changes NXM, NXU and NZM)" "$(ynnot first_line_ctl)"
    
    echo
    echo "### $SAMPLE: the corpus totals over the host's ok workbooks (counts only; change NVX)"
    total_of() { cut -f2- "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | awk '{ n += $1 } END { print n + 0 }'; }
    wbs_of() { cut -f2- "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | awk '$1 > 0 { n++ } END { print n + 0 }'; }
    keys_var=KEYS_$SAMPLE
    for k in ${!keys_var}; do
      echo "    $k: $(total_of "$B/lines-$SAMPLE-host" "$k") in $(wbs_of "$B/lines-$SAMPLE-host" "$k") workbooks"
    done
    # Change NZM: the sample's corpus totals.
    case $SAMPLE in
      gradient)
        read_all() { [ "$(total_of "$B/lines-$SAMPLE-host" read_back)" = "$((2 * manifest_rows))" ] && [ "$(total_of "$B/lines-$SAMPLE-host" added)" = "$((2 * manifest_rows))" ] && [ "$(total_of "$B/lines-$SAMPLE-host" fills_added)" = "$((2 * manifest_rows))" ] && [ "$(count_lines "$B/lines-$SAMPLE-host")" = "$manifest_rows" ]; }
        READ_WHAT="every workbook's two gradient fills read back, read_back $(total_of "$B/lines-$SAMPLE-host" read_back) of $((2 * manifest_rows)), added $(total_of "$B/lines-$SAMPLE-host" added) of $((2 * manifest_rows)), fills_added $(total_of "$B/lines-$SAMPLE-host" fills_added) of $((2 * manifest_rows)) (change NZM)"
        ;;
    esac
    check "$SAMPLE: $READ_WHAT" "$(yn read_all)"
    # Change NZM (ruling F): the workbooks' own gradientFill elements, the
    # line's gradients_before: six over the run, in the two workbooks ruling F
    # names.
    gb_of() { awk -F'\t' -v id="$2" '$1 == id' "$1" | cut -f2- | tr '\t ' '\n\n' | sed -n 's/^gradients_before=//p' | head -1; }
    echo "  gradients_before: $(total_of "$B/lines-$SAMPLE-host" gradients_before) in $(wbs_of "$B/lines-$SAMPLE-host" gradients_before) workbooks; 18d1e8ba72b5 $(gb_of "$B/lines-$SAMPLE-host" 18d1e8ba72b5), f9efcac9808f $(gb_of "$B/lines-$SAMPLE-host" f9efcac9808f)"
    gb_ok() { [ "$(total_of "$1" gradients_before)" = 6 ] && [ "$(wbs_of "$1" gradients_before)" = 2 ] && [ "$(gb_of "$1" 18d1e8ba72b5)" = 4 ] && [ "$(gb_of "$1" f9efcac9808f)" = 2 ]; }
    check "$SAMPLE: the corpus's own gradientFill elements, gradients_before, are six, in 18d1e8ba72b5 (4) and f9efcac9808f (2) (ruling F; change NZM)" "$(yn gb_ok "$B/lines-$SAMPLE-host")"
    printf '18d1e8ba72b5\tedit\tgradients_before=4\nf9efcac9808f\tedit\tgradients_before=1\n' >"$B/c-gb"
    check "control: gb_ok refuses a planted file with five over the two workbooks (change NZM)" "$(ynnot gb_ok "$B/c-gb")"
    
    echo
    echo "### $SAMPLE: the two labels' outputs"
    same_out=0
    nboth=0
    while IFS="$TAB" read -r id ext; do
      if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$SAMPLE-host")" ]; then continue; fi
      nboth=$((nboth + 1))
      if cmp -s "$O/$id/out.host.$ext" "$O/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
    done <"$B/order"
    echo "  ok workbooks: $nboth; whose host and i686 outputs are byte for byte the same: $same_out"
    check "$SAMPLE: every output is the same on both targets" "$(yn [ "$same_out" = "$nboth" ])"
    check "$SAMPLE: both targets printed the same line for every ok workbook" "$(yn cmp -s "$B/lines-$SAMPLE-host" "$B/lines-$SAMPLE-i686")"
    cp "$B/lines-$SAMPLE-host" "$B/c-lines"; printf 'x\n' >>"$B/c-lines"
    check "control: the same comparison tells a line list with one line added" "$(ynnot cmp -s "$B/c-lines" "$B/lines-$SAMPLE-i686")"
    
    echo
    echo "## the $SAMPLE run's record pair"
    echo "command: python3 -I -B scripts/passthrough-record.py --run <runs>/$RUN-$SAMPLE --out <scripts>/out/records --stem $STEM (changes NTJ, NUW and NVX)"
    python3 -I -B scripts/passthrough-record.py --run "$O" --out "$RECORDS" --stem "$STEM" >"$B/record-$SAMPLE.out" 2>&1
    rrc=$?
    sed 's/^/    /' "$B/record-$SAMPLE.out"
    check "$SAMPLE: the record script exits 0" "$(yn [ "$rrc" = 0 ])"
    RTXT=$RECORDS/$STEM.txt
    RMD=$RECORDS/$STEM.md
    # The families: the names of the host entries table's changed, added and
    # dropped rows (change NSR), against the sample's (changes NUW and NVX).
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] ~ /^(changed|added|dropped)$/ { print $k["status"] "\t" $k["name"] }' "$O/entries.host.tsv" >"$B/w-$SAMPLE.parts"
    check "$SAMPLE: some changed, added or dropped name in the host entries table ($(count_lines "$B/w-$SAMPLE.parts") names; change NSR)" "$(yn [ "$(count_lines "$B/w-$SAMPLE.parts")" -ge 1 ])"
    FAM_CHANGED=$(fams_of "$B/w-$SAMPLE.parts" changed)
    FAM_ADDED=$(fams_of "$B/w-$SAMPLE.parts" added)
    FAM_DROPPED=$(fams_of "$B/w-$SAMPLE.parts" dropped)
    echo "  the families: changed ${FAM_CHANGED:-none}; added ${FAM_ADDED:-none}; dropped ${FAM_DROPPED:-none}"
    case $SAMPLE in
      gradient) WANT_FAMS="styles,worksheet - -" ;;
    esac
    fams_ok() { [ "$FAM_CHANGED ${FAM_ADDED:--} ${FAM_DROPPED:--}" = "$WANT_FAMS" ]; }
    check "$SAMPLE: the changed, added and dropped families are the sample's: $WANT_FAMS (- for none; changes NUW, NXM and NZM)" "$(yn fams_ok)"
    fams_ctl() { local FAM_ADDED=planted; fams_ok; }
    check "control: the same check refuses a planted added family" "$(ynnot fams_ctl)"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/reccheck-$SAMPLE.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/reccheck-$SAMPLE.out"
    rec_all() { [ "$(count_matches -E ': yes$' "$B/reccheck-$SAMPLE.out")" = 18 ] && [ "$(count_matches -E ': no$' "$B/reccheck-$SAMPLE.out")" = 0 ]; }
    check "$SAMPLE: the record's three tables are the run directory's, and its family tables are counted from them (eighteen checks: four, six per label, two)" "$(yn rec_all)"
    awk '!done && /^[|] total [|]/ { done = 1; next } { print }' "$RMD" >"$B/c-rec.md"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$B/c-rec.md" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/c-reccheck.out" 2>&1
    sed '2d' "$RTXT" >"$B/c-rec.txt"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$B/c-rec.txt" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/c-reccheck2.out" 2>&1
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "planted" "$EDIT" >"$B/c-reccheck3.out" 2>&1
    rec_ctl() { [ "$(count_matches -E ': no$' "$B/c-reccheck.out")" -ge 1 ] && [ "$(count_matches -F "the summary table is every label's summary: no" "$B/c-reccheck2.out")" = 1 ]; }
    check "control: the same check finds an .md with a family table's total row dropped and a .txt one summary row short" "$(yn rec_ctl)"
    rec_drop() { [ "$(count_matches -E "the dropped entries' families are planted: no\$" "$B/c-reccheck3.out")" = 2 ]; }
    check "control: the same check finds the dropped families differ from a planted family, on each label" "$(yn rec_drop)"
    check "the record script and the record check left no scripts/__pycache__ (PYTHONDONTWRITEBYTECODE)" "$(yn no_pycache)"
    echo "command: install -m 644 <scripts>/out/records/$STEM.md <scripts>/out/records/$STEM.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RMD" "$RTXT" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM.md" "$RECORDS_DEST/$STEM.txt")
    echo "  exit: $?"
    for f in "$STEM.md" "$STEM.txt"; do
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
    done
    done
    echo
    echo "## ruling F: --namedstyles-sample, --read-sample and --roundtrip-sample rerun on the corpus, both targets, each line compared field by field with the earlier run's (specs/0042 \"Planning rulings during P1\", ruling F; change NZN)"
    # The earlier runs are read from <corpus>/runs and never written: each
    # sample's latest corpus run, checked by its run rows' tool_args. Ruling F
    # names 2026-10-16-5e52758-roundtrip for the round trip, but that
    # directory's run rows carry no tool_args (it is not a --roundtrip-sample
    # run); the round trip's latest corpus run is 2026-10-05-6b6125b-roundtrip,
    # read here, with the named one shown as the control (change NZN).
    EARLIER_RUNS=$CORPUS/runs
    declare -A EARLIER=([namedstyles]=2026-10-12-6f51899-namedstyles [read]=2026-10-16-5e52758-read [roundtrip]=2026-10-05-6b6125b-roundtrip)
    earlier_args() { row_field "$EARLIER_RUNS/$1/run.$2.tsv" tool_args; }
    echo "command: the tool_args column of <corpus>/runs/<earlier run>/run.host.tsv and run.i686.tsv, for each sample's earlier run"
    for s in $RERUNS; do
      echo "  $s: ${EARLIER[$s]}: tool_args host [$(earlier_args "${EARLIER[$s]}" host)], i686 [$(earlier_args "${EARLIER[$s]}" i686)]"
      earlier_is() { [ "$(earlier_args "${EARLIER[$1]}" host)" = "--$1-sample" ] && [ "$(earlier_args "${EARLIER[$1]}" i686)" = "--$1-sample" ]; }
      check "the earlier $s run's rows name --$s-sample on both labels (change NZN)" "$(yn earlier_is "$s")"
    done
    echo "  the directory ruling F named for the round trip, 2026-10-16-5e52758-roundtrip: tool_args host [$(earlier_args 2026-10-16-5e52758-roundtrip host)]"
    named_not_rt() { [ "$(earlier_args 2026-10-16-5e52758-roundtrip host)" != --roundtrip-sample ]; }
    check "control: the same column refuses 2026-10-16-5e52758-roundtrip as a --roundtrip-sample run (its tool_args are empty; change NZN)" "$(yn named_not_rt)"
    cat >"$B/fieldcmp.py" <<'PY'
    """This log's field-by-field comparison of two corpus runs' sample lines
    (specs/0042 ruling F): for each workbook id given, the earlier run's and
    this run's stdout.<label>.txt, each one line of a word and key=value
    pairs; prints each moved field as "<id> <key>: <earlier> -> <now>" (a key
    on one side alone printed with "-" for the other) and one summary line,
    "lines equal <n> of <m>; fields moved <k>; lines missing <l>". Counts and
    flags only: the samples print nothing else. Usage: fieldcmp.py <earlier
    run dir> <this run dir> <label> <id>..."""
    import os
    import sys
    
    sys.dont_write_bytecode = True
    earlier, now, label = sys.argv[1:4]
    ids = sys.argv[4:]
    
    
    def line(d, i):
        path = os.path.join(d, i, "stdout.%s.txt" % label)
        if not os.path.exists(path):
            return None
        text = open(path, encoding="ascii").read()
        return text[:-1] if text.endswith("\n") else text
    
    
    def fields(text):
        cells = text.split("\t")
        out = [("(word)", cells[0])]
        for c in cells[1:]:
            k, _, v = c.partition("=")
            out.append((k, v))
        return out
    
    
    equal = moved = missing = 0
    for i in ids:
        a, b = line(earlier, i), line(now, i)
        if a is None or b is None:
            missing += 1
            print("%s: a line is missing (earlier %s, now %s)" % (i, "yes" if a is not None else "no",
                                                                 "yes" if b is not None else "no"))
            continue
        if a == b:
            equal += 1
            continue
        fa, fb = dict(fields(a)), dict(fields(b))
        for k in [k for k, _ in fields(a)] + [k for k, _ in fields(b) if k not in fa]:
            if fa.get(k) != fb.get(k):
                moved += 1
                print("%s %s: %s -> %s" % (i, k, fa.get(k, "-"), fb.get(k, "-")))
        if [k for k, _ in fields(a)] == [k for k, _ in fields(b)] and fa == fb:
            print("%s: the fields agree and the line differs in its form" % i)
            moved += 1
    print("lines equal %d of %d; fields moved %d; lines missing %d" % (equal, len(ids), moved, missing))
    PY
    echo "  the comparison: <work>/fieldcmp.py, below (sha256 $(sha_of "$B/fieldcmp.py"))"
    sed 's/^/    /' "$B/fieldcmp.py"
    ALL_IDS=$(cut -f1 "$B/order" | paste -sd' ')
    for s in $RERUNS; do
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      O=$RUN_OUT_ROOT/$RUN-$s
      echo
      echo "### $s: $label rerun, --tool-arg --$s-sample (no open check: the lines are compared; change NZN)"
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --out <runs>/$RUN-$s --timeout 300 --tool-arg --$s-sample"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$O" \
        --timeout 300 --tool-arg "--$s-sample" >"$B/rerun-$s-$label.stdout" 2>"$B/rerun-$s-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/rerun-$s-$label.stderr")"
      sed 's/^/    /' "$B/rerun-$s-$label.stdout"
      SUM=$O/summary.$label.tsv
      rerun_ok() { [ "$rc" = 0 ] && [ ! -s "$B/rerun-$s-$label.stderr" ] && [ "$(awk 'NR > 1' "$SUM" | wc -l)" = "$manifest_rows" ] && [ "$(count_where "$SUM" outcome ok)" = "$manifest_rows" ] && [ "$(count_where "$SUM" leftover no)" = "$manifest_rows" ]; }
      check "$s $label: the rerun exits 0 with an empty stderr, every one of the $manifest_rows rows ok, nothing left over" "$(yn rerun_ok)"
      n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
      check "$s $label: the runs' TMPDIR is empty after the rerun" "$(yn [ "$n_left" = 0 ])"
      R=$O/run.$label.tsv
      rerun_bins() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] " " $k["tool_args"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C --$s-sample" ]; }
      check "$s $label: the run row records the two release binaries built here, the phase commit and --$s-sample" "$(yn rerun_bins)"
      echo "command: python3 -I -B <work>/fieldcmp.py <corpus>/runs/${EARLIER[$s]} <runs>/$RUN-$s $label <the manifest's ids>"
      # shellcheck disable=SC2086
      python3 -I -B "$B/fieldcmp.py" "$EARLIER_RUNS/${EARLIER[$s]}" "$O" "$label" $ALL_IDS >"$B/fc-$s-$label.out" 2>&1
      fc_rc=$?
      sed 's/^/    /' "$B/fc-$s-$label.out"
      fc_all() { [ "$fc_rc" = 0 ] && [ "$(count_matches -xF "lines equal $manifest_rows of $manifest_rows; fields moved 0; lines missing 0" "$B/fc-$s-$label.out")" = 1 ] && [ "$(count_lines "$B/fc-$s-$label.out")" = 1 ]; }
      check "$s $label: $manifest_rows of $manifest_rows lines equal to the earlier run's, no field moved (ruling F: no move expected; a move is a finding)" "$(yn fc_all)"
    done
    done
    # The comparison's control: a planted copy of the first workbook's earlier
    # round-trip line with one count raised, against the earlier line.
    FC_ID=$(head -n 1 "$B/order" | cut -f1)
    mkdir -p "$B/c-fc/$FC_ID"
    sed 's/\tequal=\([0-9]*\)/\tequal=1\1/' "$EARLIER_RUNS/${EARLIER[roundtrip]}/$FC_ID/stdout.host.txt" >"$B/c-fc/$FC_ID/stdout.host.txt"
    python3 -I -B "$B/fieldcmp.py" "$EARLIER_RUNS/${EARLIER[roundtrip]}" "$B/c-fc" host "$FC_ID" >"$B/c-fc.out" 2>&1
    echo "  over a planted copy of $FC_ID's earlier round-trip line with its equal count raised:"
    sed 's/^/    /' "$B/c-fc.out"
    fc_ctl() { [ "$(count_matches -xF "lines equal 0 of 1; fields moved 1; lines missing 0" "$B/c-fc.out")" = 1 ] && [ "$(count_matches -E "^$FC_ID equal: " "$B/c-fc.out")" = 1 ]; }
    check "control: the same comparison finds the one planted field, beside its earlier figure" "$(yn fc_ctl)"
    echo
    echo "### ruling F: the corpus's gradientFill elements by place, by this log's own count (counts only; change NZN)"
    cat >"$B/extcount.py" <<'PY'
    """This log's count of the gradientFill elements of each workbook's
    xl/styles.xml by place (specs/0042 ruling F): inside the root's extLst
    (any depth), as a fill of <fills>, as a fill of the main namespace's
    <dxfs>, and anywhere else. Prints one line per workbook holding any,
    "<id> extLst <n> fills <n> dxfs <n> other <n>", then "total extLst <n>
    fills <n> dxfs <n> other <n>; workbooks <n> of <m>". Usage: extcount.py
    <workbook>..., each named <id>.<ext>. Counts and ids only."""
    import os
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    sys.dont_write_bytecode = True
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    total = dict.fromkeys(("extLst", "fills", "dxfs", "other"), 0)
    holding = 0
    for path in sys.argv[1:]:
        wid = os.path.basename(path).rsplit(".", 1)[0]
        z = zipfile.ZipFile(path)
        if "xl/styles.xml" not in z.namelist():
            continue
        root = ET.fromstring(z.read("xl/styles.xml"))
        n = dict.fromkeys(total, 0)
        every = sum(1 for _ in root.iter(M + "gradientFill"))
        for ext in root.findall(M + "extLst"):
            n["extLst"] += sum(1 for _ in ext.iter(M + "gradientFill"))
        n["fills"] = len(root.findall(M + "fills/" + M + "fill/" + M + "gradientFill"))
        n["dxfs"] = len(root.findall(M + "dxfs/" + M + "dxf/" + M + "fill/" + M + "gradientFill"))
        n["other"] = every - n["extLst"] - n["fills"] - n["dxfs"]
        if every:
            holding += 1
            print("%s extLst %d fills %d dxfs %d other %d" % (wid, n["extLst"], n["fills"], n["dxfs"], n["other"]))
        for k in total:
            total[k] += n[k]
    print("total extLst %d fills %d dxfs %d other %d; workbooks %d of %d"
          % (total["extLst"], total["fills"], total["dxfs"], total["other"], holding, len(sys.argv) - 1))
    PY
    sed 's/^/    /' "$B/extcount.py"
    echo "command: python3 -I -B <work>/extcount.py <corpus>/corpus/<id>.<ext>, every manifest row"
    # shellcheck disable=SC2046
    python3 -I -B "$B/extcount.py" $(awk -F'\t' -v d="$CORPUS/corpus" '{ print d "/" $1 "." $2 }' "$B/order") >"$B/extcount.out" 2>&1
    ec_rc=$?
    sed 's/^/    /' "$B/extcount.out"
    ext_all() { [ "$ec_rc" = 0 ] && [ "$(tail -n 1 "$B/extcount.out")" = "total extLst 6 fills 0 dxfs 0 other 0; workbooks 2 of $manifest_rows" ] \
      && [ "$(count_matches -xF '18d1e8ba72b5 extLst 4 fills 0 dxfs 0 other 0' "$B/extcount.out")" = 1 ] \
      && [ "$(count_matches -xF 'f9efcac9808f extLst 2 fills 0 dxfs 0 other 0' "$B/extcount.out")" = 1 ]; }
    check "the corpus's six gradientFill elements all sit inside extLst, none in <fills> or the main <dxfs>, in 18d1e8ba72b5 (4) and f9efcac9808f (2) (ruling F; change NZN)" "$(yn ext_all)"
    
    echo
    echo "## the Excel-form fixture: --namedstyles-sample and --gradient-sample on it through the runner, both targets (specs/0042 \"Harness runs\", the first fixture; part 4 P1's change NYW, its form; change NZO)"
    # The fixture is fictional and its values printable; it is written under
    # <work>, never committed, as a one-workbook corpus the runner takes with
    # --corpus, so lo and lo_in are the runner's open checks.
    cat >"$B/gradfix.py" <<'PY'
    """The run log's fictional Excel-form gradient fixture
    (specs/0042-gradient-fills-and-named-styles.md, "Harness runs", the first
    fixture): one worksheet of four cells (A1:B2, numbers 1 to 4); a styles
    part in the corpus's shape (fonts, fills, borders, cellStyleXfs, cellXfs,
    cellStyles, dxfs, tableStyles) whose fills hold the two required pattern
    fills (none, gray125), a linear gradientFill of two stops with a degree
    (90) and a path gradientFill of two stops (type path, the four 0.5), each
    stop's colour a theme colour as Excel writes them; three cellStyleXfs
    formats; three cellStyle entries, Normal with builtinId 0, Good with its
    builtinId 26 and one custom entry, Fixture, with no builtinId; four cell
    formats, the second and third naming the two gradient fills and the
    fourth with xfId 2. Writes the workbook with zipfile at fixed timestamps
    into corpus/<id>.xlsx in the directory it is given, and a one-row
    manifest, manifest.tsv, beside corpus there, in specs/0005's form, <id>
    the first twelve hex digits of the workbook's sha256; prints the id, the
    byte count and the sha256, tab-separated."""
    import hashlib
    import io
    import os
    import sys
    import zipfile
    
    sys.dont_write_bytecode = True
    MAIN = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    REL = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    PKG = "http://schemas.openxmlformats.org/package/2006/relationships"
    CT = "http://schemas.openxmlformats.org/package/2006/content-types"
    VND = "application/vnd.openxmlformats-officedocument"
    DECL = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    MANIFEST_HEADER = ("id\tsha256\tbytes\text\tproducer\tproducer_version\tapp\tsource\ttags\tadded"
                       "\toriginal_name\tnote")
    
    
    def rels(body):
        return DECL + '<Relationships xmlns="%s">%s</Relationships>' % (PKG, body)
    
    
    STOPS = '<stop position="0"><color theme="0"/></stop><stop position="1"><color theme="4"/></stop>'
    STYLES = (DECL + '<styleSheet xmlns="%s">'
              '<fonts count="1"><font><sz val="11"/><color theme="1"/><name val="Calibri"/>'
              '<family val="2"/><scheme val="minor"/></font></fonts>'
              '<fills count="4"><fill><patternFill patternType="none"/></fill>'
              '<fill><patternFill patternType="gray125"/></fill>'
              '<fill><gradientFill degree="90">%s</gradientFill></fill>'
              '<fill><gradientFill type="path" left="0.5" right="0.5" top="0.5" bottom="0.5">%s'
              '</gradientFill></fill></fills>'
              '<borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders>'
              '<cellStyleXfs count="3"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/>'
              '<xf numFmtId="0" fontId="0" fillId="2" borderId="0" applyFill="0"/>'
              '<xf numFmtId="0" fontId="0" fillId="3" borderId="0" applyFill="0"/></cellStyleXfs>'
              '<cellXfs count="4"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/>'
              '<xf numFmtId="0" fontId="0" fillId="2" borderId="0" xfId="0" applyFill="1"/>'
              '<xf numFmtId="0" fontId="0" fillId="3" borderId="0" xfId="0" applyFill="1"/>'
              '<xf numFmtId="0" fontId="0" fillId="3" borderId="0" xfId="2"/></cellXfs>'
              '<cellStyles count="3"><cellStyle name="Normal" xfId="0" builtinId="0"/>'
              '<cellStyle name="Good" xfId="1" builtinId="26"/>'
              '<cellStyle name="Fixture" xfId="2"/></cellStyles>'
              '<dxfs count="0"/><tableStyles count="0" defaultTableStyle="TableStyleMedium2"'
              ' defaultPivotStyle="PivotStyleLight16"/></styleSheet>' % (MAIN, STOPS, STOPS))
    SHEET = (DECL + '<worksheet xmlns="%s" xmlns:r="%s"><dimension ref="A1:B2"/>'
             '<sheetViews><sheetView workbookViewId="0"/></sheetViews>'
             '<sheetFormatPr defaultRowHeight="15"/><sheetData>'
             '<row r="1"><c r="A1" s="1"><v>1</v></c><c r="B1" s="2"><v>2</v></c></row>'
             '<row r="2"><c r="A2" s="3"><v>3</v></c><c r="B2"><v>4</v></c></row>'
             '</sheetData><pageMargins left="0.7" right="0.7" top="0.75" bottom="0.75" header="0.3"'
             ' footer="0.3"/></worksheet>' % (MAIN, REL))
    WORKBOOK = (DECL + '<workbook xmlns="%s" xmlns:r="%s"><bookViews><workbookView/></bookViews>'
                '<sheets><sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets></workbook>' % (MAIN, REL))
    TYPES = (DECL + '<Types xmlns="%s">'
             '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
             '<Default Extension="xml" ContentType="application/xml"/>'
             '<Override PartName="/xl/workbook.xml" ContentType="%s.spreadsheetml.sheet.main+xml"/>'
             '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="%s.spreadsheetml.worksheet+xml"/>'
             '<Override PartName="/xl/styles.xml" ContentType="%s.spreadsheetml.styles+xml"/>'
             '</Types>' % (CT, VND, VND, VND))
    ENTRIES = (
        ("[Content_Types].xml", TYPES),
        ("_rels/.rels", rels('<Relationship Id="rId1" Type="%s/officeDocument" Target="xl/workbook.xml"/>' % REL)),
        ("xl/workbook.xml", WORKBOOK),
        ("xl/_rels/workbook.xml.rels",
         rels('<Relationship Id="rId1" Type="%s/worksheet" Target="worksheets/sheet1.xml"/>'
              '<Relationship Id="rId2" Type="%s/styles" Target="styles.xml"/>' % (REL, REL))),
        ("xl/worksheets/sheet1.xml", SHEET),
        ("xl/styles.xml", STYLES),
    )
    
    
    def main():
        if len(sys.argv) != 2:
            print("usage: gradfix.py <dir>", file=sys.stderr)
            sys.exit(2)
        out = io.BytesIO()
        with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
            for name, text in ENTRIES:
                info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
                info.compress_type = zipfile.ZIP_DEFLATED
                z.writestr(info, text.encode("ascii"))
        data = out.getvalue()
        digest = hashlib.sha256(data).hexdigest()
        wid = digest[:12]
        corpus = os.path.join(sys.argv[1], "corpus")
        os.makedirs(corpus)
        with open(os.path.join(corpus, wid + ".xlsx"), "xb") as f:
            f.write(data)
        with open(os.path.join(sys.argv[1], "manifest.tsv"), "x", encoding="ascii") as f:
            f.write(MANIFEST_HEADER + "\n")
            f.write("\t".join((wid, digest, str(len(data)), "xlsx", "emend-run-log", "1", "zipfile",
                               "generated", "fixture", "2026-10-22", "gradient-fixture.xlsx",
                               "fictional")) + "\n")
        print("%s\t%d\t%s" % (wid, len(data), digest))
    
    
    main()
    PY
    echo "command: python3 -I -B <work>/gradfix.py <work>/fixcorpus; the program:"
    sed 's/^/    /' "$B/gradfix.py"
    python3 -I -B "$B/gradfix.py" "$B/fixcorpus" >"$B/gradfix.out" 2>"$B/gradfix.err" </dev/null
    fx_rc=$?
    FX_ID=$(cut -f1 "$B/gradfix.out")
    FX_IN=$B/fixcorpus/corpus/$FX_ID.xlsx
    echo "  exit: $fx_rc; standard error $(wc -c <"$B/gradfix.err") bytes; the fixture: id $FX_ID, $(cut -f2 "$B/gradfix.out") bytes, sha256 $(cut -f3 "$B/gradfix.out")"
    fx_written() { [ "$fx_rc" = 0 ] && [ ! -s "$B/gradfix.err" ] && [ -s "$FX_IN" ] && [ "$(sha_of "$FX_IN")" = "$(cut -f3 "$B/gradfix.out")" ]; }
    check "the fixture program exits 0, writes nothing to its standard error, and wrote the fixture it hashes" "$(yn fx_written)"
    echo "command: python3 -I -B <work>/extcount.py <work>/fixcorpus/corpus/$FX_ID.xlsx (ruling F's count over the fixture: its two gradients in <fills>, the count's control)"
    python3 -I -B "$B/extcount.py" "$FX_IN" >"$B/extcount-fix.out" 2>&1
    sed 's/^/    /' "$B/extcount-fix.out"
    ext_fix() { [ "$(count_matches -xF "$FX_ID extLst 0 fills 2 dxfs 0 other 0" "$B/extcount-fix.out")" = 1 ] && [ "$(tail -n 1 "$B/extcount-fix.out")" = "total extLst 0 fills 2 dxfs 0 other 0; workbooks 1 of 1" ]; }
    check "control: the same count reads the fixture's two gradients in <fills> and none inside extLst (change NZN)" "$(yn ext_fix)"
    # The forms check (change NZO): read with zipfile, ElementTree and the
    # styles part's raw bytes.
    cat >"$B/gradcheck.py" <<'PY'
    """The run log's check of the gradient sample's output on the Excel-form
    fixture (specs/0042-gradient-fills-and-named-styles.md, "Harness runs",
    the first fixture), read with zipfile, ElementTree and the raw bytes of
    xl/styles.xml: the fixture's four fills, three cellStyleXfs formats,
    three cellStyle entries, four cell formats and every other child of the
    root kept byte for byte; the two fills the sample adds in the writer's
    form (G1: degree 90, its stops 0 and 1 in FF4F81BD and FFFFFFFF; G2: type
    path, the four 0.5, its stops 0 and 1 in FFFFFFFF and FFC0504D); the two
    cell formats it adds naming them (fillId 4 and 5, applyFill 1, xfId 0);
    and the counts. Usage: gradcheck.py <fixture> <output> [--plant], where
    --plant moves G2's second stop to 0.9 in the output's bytes before the
    checks (the control). Prints one "name: yes|no" line per check and one
    summary line. Counts and the tool's own constants only."""
    import re
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    sys.dont_write_bytecode = True
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    G1 = ('<fill><gradientFill degree="90"><stop position="0"><color rgb="FF4F81BD"/></stop>'
          '<stop position="1"><color rgb="FFFFFFFF"/></stop></gradientFill></fill>')
    G2 = ('<fill><gradientFill type="path" left="0.5" right="0.5" top="0.5" bottom="0.5">'
          '<stop position="0"><color rgb="FFFFFFFF"/></stop><stop position="1"><color rgb="FFC0504D"/>'
          '</stop></gradientFill></fill>')
    
    
    def styles(path):
        return zipfile.ZipFile(path).read("xl/styles.xml").decode("utf-8")
    
    
    def block(text, name):
        m = re.search(r"<%s(?: [^>]*)?(?:/>|>(.*?)</%s>)" % (name, name), text, re.S)
        return m
    
    
    def children(text, container, child):
        m = block(text, container)
        if not m or m.group(1) is None:
            return []
        return re.findall(r"<%s(?: [^>]*)?(?:/>|>.*?</%s>)" % (child, child), m.group(1), re.S)
    
    
    def count_attr(text, container):
        m = re.search(r"<%s(?= )[^>]* count=\"([0-9]+)\"" % container, text)
        return m.group(1) if m else None
    
    
    def main():
        args = sys.argv[1:]
        plant = "--plant" in args
        args = [a for a in args if a != "--plant"]
        if len(args) != 2:
            print("usage: gradcheck.py <fixture> <output> [--plant]", file=sys.stderr)
            sys.exit(2)
        a, b = styles(args[0]), styles(args[1])
        if plant:
            b = b.replace('<stop position="1"><color rgb="FFC0504D"/>', '<stop position="0.9"><color rgb="FFC0504D"/>')
        fa, fb = children(a, "fills", "fill"), children(b, "fills", "fill")
        xa, xb = children(a, "cellXfs", "xf"), children(b, "cellXfs", "xf")
        root = ET.fromstring(b.encode("utf-8"))
        added = list(root.find(M + "fills"))[len(fa):] if root.find(M + "fills") is not None else []
    
        def grad(fill):
            g = fill.find(M + "gradientFill")
            if g is None or len(list(fill)) != 1:
                return None
            stops = [(s.get("position"), [c.get("rgb") for c in s]) for s in g]
            return (dict(g.attrib), stops, all(s.tag == M + "stop" for s in g))
    
        want1 = ({"degree": "90"}, [("0", ["FF4F81BD"]), ("1", ["FFFFFFFF"])], True)
        want2 = ({"type": "path", "left": "0.5", "right": "0.5", "top": "0.5", "bottom": "0.5"},
                 [("0", ["FFFFFFFF"]), ("1", ["FFC0504D"])], True)
        new_xfs = list(root.find(M + "cellXfs"))[len(xa):] if root.find(M + "cellXfs") is not None else []
    
        def xf_names(xf, fill):
            return (xf.get("fillId") == str(fill) and xf.get("applyFill") == "1" and xf.get("xfId") == "0"
                    and xf.get("numFmtId") == "0" and xf.get("fontId") == "0" and xf.get("borderId") == "0")
    
        def others(text):
            out = re.sub(r"<(fills|cellXfs)(?: [^>]*)?(?:/>|>.*?</\1>)", "", text, flags=re.S)
            return out
    
        checks = [
            ("the fixture's four fills kept byte for byte, in order", len(fa) == 4 and fb[:4] == fa),
            ("two fills added, the fills count 6", len(fb) == 6 and count_attr(b, "fills") == "6"),
            ("the first added fill is G1 in the writer's form, byte for byte", fb[4:5] == [G1]),
            ("the second added fill is G2 in the writer's form, byte for byte", fb[5:6] == [G2]),
            ("the added fills read by ElementTree: a linear gradient at degree 90 and a path gradient at the "
             "centre, two stops each with their rgb", len(added) == 2 and grad(added[0]) == want1
             and grad(added[1]) == want2),
            ("the fixture's four cell formats kept byte for byte, the cellXfs count 6",
             len(xa) == 4 and xb[:4] == xa and len(xb) == 6 and count_attr(b, "cellXfs") == "6"),
            ("the two added cell formats name fills 4 and 5 (applyFill 1, xfId 0)",
             len(new_xfs) == 2 and xf_names(new_xfs[0], 4) and xf_names(new_xfs[1], 5)),
            ("the three cellStyleXfs formats kept byte for byte, count 3",
             len(children(b, "cellStyleXfs", "xf")) == 3 and children(b, "cellStyleXfs", "xf")
             == children(a, "cellStyleXfs", "xf") and count_attr(b, "cellStyleXfs") == "3"),
            ("the three cellStyle entries kept byte for byte, count 3",
             len(children(b, "cellStyles", "cellStyle")) == 3 and children(b, "cellStyles", "cellStyle")
             == children(a, "cellStyles", "cellStyle") and count_attr(b, "cellStyles") == "3"),
            ("everything outside fills and cellXfs kept byte for byte", others(a) == others(b)),
        ]
        for name, ok in checks:
            print("%s: %s" % (name, "yes" if ok else "no"))
        print("fills %d -> %d; cellXfs %d -> %d; cellStyleXfs %d; cellStyle %d; gradientFill in the output %d"
              % (len(fa), len(fb), len(xa), len(xb), len(children(b, "cellStyleXfs", "xf")),
                 len(children(b, "cellStyles", "cellStyle")), len(list(root.iter(M + "gradientFill")))))
    
    
    main()
    PY
    sed 's/^/    /' "$B/gradcheck.py"
    # The fixture runs: each sample on each target into its own directory under
    # <work>; the named styles sample's line against its reading by hand, the
    # gradient sample's by the corpus rule.
    for FS in namedstyles gradient; do
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      FO=$B/fixrun-$FS
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/emend-copy --xlsx-diff <target>/main/$([ "$label" = i686 ] && echo "$I686/")release/xlsx-diff --corpus <work>/fixcorpus --out <work>/fixrun-$FS --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg --$FS-sample"
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --corpus "$B/fixcorpus" --out "$FO" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "--$FS-sample" \
        >"$B/fix-$FS-$label.stdout" 2>"$B/fix-$FS-$label.stderr" </dev/null
      frc=$?
      echo "  exit $frc; stderr bytes: $(wc -c <"$B/fix-$FS-$label.stderr")"
      sed 's/^/    /' "$B/fix-$FS-$label.stdout"
      FSUM=$FO/summary.$label.tsv
      fix_row_ok() { [ "$frc" = 0 ] && [ ! -s "$B/fix-$FS-$label.stderr" ] && [ "$(awk 'NR > 1' "$FSUM" | wc -l)" = 1 ] \
        && [ "$(count_where "$FSUM" outcome ok)" = 1 ] && [ "$(count_where "$FSUM" lo ok)" = 1 ] \
        && [ "$(count_where "$FSUM" lo_in ok)" = 1 ] && [ "$(count_where "$FSUM" leftover no)" = 1 ]; }
      check "fixture $FS $label: the run exits 0 with an empty stderr, its one row ok, the input and the output opening in LibreOffice (lo_in and lo ok), nothing left over" "$(yn fix_row_ok)"
      e=$(cat "$FO/$FX_ID/stdout.$label.txt")
      printf '%s\n' "$e" >"$B/fixline-$FS-$label"
      echo "  the line: $(printf '%s' "$e" | tr '\t' ' ')"
    done
    check "fixture $FS: both targets printed the same line" "$(yn cmp -s "$B/fixline-$FS-host" "$B/fixline-$FS-i686")"
    check "fixture $FS: the output is the same on both targets, byte for byte" "$(yn cmp -s "$FO/$FX_ID/out.host.xlsx" "$FO/$FX_ID/out.i686.xlsx")"
    done
    # The named styles sample's line on the fixture, read by hand at the phase
    # commit with debug binaries on both targets (change NZO): three named
    # styles over three formats, two with a builtinId (the tool's builtin) and
    # none with customBuiltin (the tool's custom), all three resolved, the
    # default font's size 11, no dxf.
    NS_WANT=$(printf 'namedstyles\tnamed=3\tnamed_xfs=3\tbuiltin=2\tcustom=0\tresolved=3\tdefault_font_size=11\tdxfs=0\tdxf_fonts=0\tdxf_fills=0\tdxf_borders=0\tdxf_numfmts=0\tdxf_alignments=0\tdxf_protections=0\tdxf_gradients=0\tdxf_implied_solid=0\tdxf_inside_sides=0\tdxf_written=0\tdxf_equal=0')
    FL=$(cat "$B/fixline-namedstyles-host")
    echo "  the line read by hand: $(printf '%s' "$NS_WANT" | tr '\t' ' ')"
    fix_ns_ok() { [ "$FL" = "$NS_WANT" ]; }
    check "fixture namedstyles: the line reads the three named styles over the three cellStyleXfs formats, two built in, all resolved, no dxf (the typed read takes the fixture's two gradient fills; change NZO)" "$(yn fix_ns_ok)"
    fix_ns_ctl() { local FL; FL=$(printf '%s' "$NS_WANT" | sed 's/\tnamed=3\t/\tnamed=2\t/'); fix_ns_ok; }
    check "control: the same check refuses the line with two named styles" "$(ynnot fix_ns_ctl)"
    FE=$B/fixrun-namedstyles/entries.host.tsv
    n_fix_rows=$(awk 'NR > 1' "$FE" | wc -l)
    echo "  the named styles sample's entry rows: $n_fix_rows; identical and unflagged: $(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] == "identical" && $k["flags"] == ""' "$FE" | wc -l)"
    fix_same() { [ "$n_fix_rows" = 6 ] && [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] == "identical" && $k["flags"] == ""' "$FE" | wc -l)" = 6 ]; }
    check "fixture namedstyles: the input written back unedited (nothing to write: no dxf), each of its six entries identical and unflagged" "$(yn fix_same)"
    GL=$(cat "$B/fixline-gradient-host")
    SE=$B/fixrun-gradient/entries.host.tsv
    check "fixture gradient: the line is what the spec reads (change NZM's rule)" "$(yn gradient_line_ok "$GL")"
    fix_grad_counts() { [ "$(kv "$GL" xfs_before)" = 4 ] && [ "$(kv "$GL" xfs_after)" = 6 ] && [ "$(kv "$GL" cells_before)" = 4 ] && [ "$(kv "$GL" cells_after)" = 6 ] && [ "$(kv "$GL" read_back)" = 2 ] && [ "$(kv "$GL" gradients_before)" = 2 ]; }
    check "fixture gradient: xfs 4 to 6, cells 4 to 6, both added fills read back, and the fixture's own two gradientFill elements counted (gradients_before 2)" "$(yn fix_grad_counts)"
    fix_grad_ctl() { local GL; GL=$(printf '%s' "$(cat "$B/fixline-gradient-host")" | sed 's/gradients_before=2/gradients_before=0/'); fix_grad_counts; }
    check "control: the same check refuses the line with gradients_before 0" "$(ynnot fix_grad_ctl)"
    check "fixture gradient: the entry rows are as the corpus rule gives (the styles part and the worksheet changed, the rest identical)" "$(yn gradient_named "$SE" "$FX_ID" 0)"
    echo "command: python3 -I -B <work>/gradcheck.py <work>/fixcorpus/corpus/$FX_ID.xlsx <work>/fixrun-gradient/$FX_ID/out.host.xlsx; the same with --plant (G2's second stop moved to 0.9, the control); and over the fixture against itself (the control)"
    python3 -I -B "$B/gradcheck.py" "$FX_IN" "$B/fixrun-gradient/$FX_ID/out.host.xlsx" >"$B/gradcheck.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/gradcheck.out"
    gc_all() { [ "$(count_matches -E ': yes$' "$B/gradcheck.out")" = 10 ] && [ "$(count_matches -E ': no$' "$B/gradcheck.out")" = 0 ] && [ "$(count_matches -xF 'fills 4 -> 6; cellXfs 4 -> 6; cellStyleXfs 3; cellStyle 3; gradientFill in the output 4' "$B/gradcheck.out")" = 1 ]; }
    check "fixture gradient: the forms' ten checks hold (the fixture's four fills, four cell formats, three cellStyleXfs formats, three cellStyle entries and the rest of the part kept byte for byte; G1 and G2 appended in the writer's form; the two new cell formats naming them; change NZO)" "$(yn gc_all)"
    python3 -I -B "$B/gradcheck.py" "$FX_IN" "$B/fixrun-gradient/$FX_ID/out.host.xlsx" --plant >"$B/c-gradcheck-plant.out" 2>&1
    echo "  with the planted stop: $(count_matches -E ': no$' "$B/c-gradcheck-plant.out") checks no:"
    LC_ALL=C "$G" -E ': no$' "$B/c-gradcheck-plant.out" | sed 's/^/    /'
    gc_plant() { [ "$(count_matches -E ': no$' "$B/c-gradcheck-plant.out")" = 2 ] && [ "$(count_matches -xF 'the second added fill is G2 in the writer'"'"'s form, byte for byte: no' "$B/c-gradcheck-plant.out")" = 1 ]; }
    check "control: the same check refuses the output with G2's second stop planted at 0.9, in G2's two checks alone" "$(yn gc_plant)"
    python3 -I -B "$B/gradcheck.py" "$FX_IN" "$FX_IN" >"$B/c-gradcheck.out" 2>&1
    echo "  over the fixture against itself, which adds nothing: $(count_matches -E ': no$' "$B/c-gradcheck.out") checks no"
    gc_ctl() { [ "$(count_matches -E ': no$' "$B/c-gradcheck.out")" -ge 3 ]; }
    check "control: the same check finds no added fill or cell format in the fixture against itself" "$(yn gc_ctl)"
    n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
    check "fixture: the runs' TMPDIR is empty after the runs" "$(yn [ "$n_left" = 0 ])"
    
    echo
    if [ "$RUN_SKIP_KEEP" = yes ]; then
    echo "## the keep and the open check: SKIPPED (RUN_SKIP_KEEP=yes, a dry run)"
    else
    echo "## the host keep regenerated (change NSF: M3 part 7 P5's form, one cargo test; carried)"
    mkdir "$KEEP" || exit 2
    echo "command: EMEND_KEEP_DIR=<keep> cargo test --workspace (host; CARGO_TARGET_DIR=<target>/main)"
    EMEND_KEEP_DIR=$KEEP cargo test --workspace >"$B/keep.out" 2>&1 </dev/null
    rc=$?
    echo "  exit: $rc"
    LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$B/keep.out" | sed 's/^ */    /'
    failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    echo "  passed $passed; failed $failed"
    check "the tests with the keep set exit 0" "$(yn [ "$rc" = 0 ])"
    check "no test failed" "$(yn [ "$failed" = 0 ])"
    echo "  files in the keep: $(find "$KEEP" -type f | wc -l); entries that are not regular files: $(find "$KEEP" -mindepth 1 ! -type f | wc -l)"
    (cd "$KEEP" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/host.files"
    nfiles=$(count_lines "$B/host.files")
    n_in=$(count_matches -E '\.in\.xlsx$' "$B/host.files")
    n_out=$(count_matches -E '\.out\.xlsx$' "$B/host.files")
    n_other=$(count_matches -vE '^[A-Za-z0-9_.-]+\.[0-9]+\.(in|out)\.xlsx$' "$B/host.files")
    LC_ALL=C sed -nE 's/^(.*)\.in\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.names"
    LC_ALL=C sed -nE 's/^(.*)\.out\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.out.names"
    echo "  .in.xlsx $n_in; .out.xlsx $n_out; names not of the form <test>.<n>.in|out.xlsx: $n_other"
    all_pairs() { [ "$n_in" = "$n_out" ] && [ "$((n_in * 2))" = "$nfiles" ] && [ "$n_other" = 0 ] && cmp -s "$B/pair.names" "$B/pair.out.names"; }
    check "the keep holds only whole pairs named <test>.<n>" "$(yn all_pairs)"
    NPAIRS=$n_in
    (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/keep.listing"
    echo "  the host keep's listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/keep.listing"); files $(count_lines "$B/keep.listing"); listing sha256 $(sha_of "$B/keep.listing")"
    check "the host keep's pairs times two equals its files (keep_pairs_ok)" "$(yn keep_pairs_ok "$B/keep.listing")"
    
    echo
    echo "## the host keep against part 4 P3's committed open-check record, named by its record commit, the last to add one (change NZP)"
    PREV_TXT=$(git show --name-only --format= "$PREV_OPEN_REC" | LC_ALL=C "$G" -E '^records/[a-z0-9]+-open-.*[.]txt$')
    echo "command: git show --name-only --format= <part 4 P3's record commit>, the open-check .txt it added; git show <phase commit>:<it>"
    echo "  the record: $PREV_TXT (sha256 $(git show "$C:$PREV_TXT" | sha256sum | cut -d' ' -f1))"
    check "the named record commit added exactly one open-check .txt" "$(yn [ "$(printf '%s\n' "$PREV_TXT" | count_lines /dev/stdin)" = 1 ])"
    no_later_open() { [ -z "$(git log --format=%H "$PREV_OPEN_REC..$C" -- 'records/*-open-*.txt')" ]; }
    check "no commit after it adds an open-check record, so it is the last committed" "$(yn no_later_open)"
    git show "$C:$PREV_TXT" >"$B/prev.txt"
    while IFS= read -r t; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$t" "$(stat -c %s "$KEEP/$t.in.xlsx")" "$(sha_of "$KEEP/$t.in.xlsx")" \
        "$(stat -c %s "$KEEP/$t.out.xlsx")" "$(sha_of "$KEEP/$t.out.xlsx")"
    done <"$B/pair.names" >"$B/keep.rows"
    tail -n +2 "$B/prev.txt" | cut -f1-5 | LC_ALL=C sort >"$B/prev.rows"
    LC_ALL=C sort "$B/keep.rows" >"$B/keep.sorted"
    n_prev=$(count_lines "$B/prev.rows")
    n_kept_prev=$(LC_ALL=C comm -12 "$B/prev.rows" "$B/keep.sorted" | count_lines /dev/stdin)
    cut -f1 "$B/prev.rows" >"$B/prev.names"
    LC_ALL=C comm -13 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/gone.pairs"
    echo "  rows: the regenerated keep $(count_lines "$B/keep.rows"), the record $n_prev; its rows found in the keep with the same name, bytes and both sha256s: $n_kept_prev"
    echo "  pairs in the keep and not in the record: $(count_lines "$B/new.pairs"); in the record and not in the keep: $(count_lines "$B/gone.pairs")"
    sed 's/^/    new: /' "$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.rows" "$B/keep.sorted" | cut -f1 >"$B/changed.pairs"
    echo "  pairs of the record whose bytes differ in the keep: $(count_lines "$B/changed.pairs")"
    sed 's/^/    changed: /' "$B/changed.pairs"
    check "no pair of the record is gone" "$(yn [ "$(count_lines "$B/gone.pairs")" = 0 ])"
    check "every pair of the record is in the keep, unchanged or changed ($n_kept_prev + $(count_lines "$B/changed.pairs") = $n_prev)" "$(yn [ "$((n_kept_prev + $(count_lines "$B/changed.pairs")))" = "$n_prev" ])"
    # Change NZP: the new pairs this phase's tests write, each a new crate
    # test's write or a new tool test's, in byte order
    # (gen/run-parts/expected-new.txt, from a dev keep).
    : >"$B/want-new.pairs"
    printf '%s\n' emend-copy.the_gradient_sample_adds_two_gradient_fills_and_two_formats.1 >>"$B/want-new.pairs"
    printf '%s\n' emend-copy.the_roundtrip_sample_writes_a_gradient_fill_back_as_read.1 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.gradient.a_differential_style_s_gradient_is_written_back_through_the_same_composer.1 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.gradient.a_linear_gradient_is_written_with_its_degree_and_its_stops.1 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.gradient.a_linear_gradient_is_written_with_its_degree_and_its_stops.2 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.gradient.a_linear_gradient_is_written_with_its_degree_and_its_stops.3 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.gradient.a_linear_gradient_of_degree_zero_writes_no_degree.1 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.gradient.a_path_gradient_writes_its_type_and_all_four_sides.1 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.gradient.a_path_gradient_writes_its_type_and_all_four_sides.2 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.gradient.a_stop_takes_each_colour_form_and_equal_gradients_share_one_fill.1 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.gradient.a_written_gradient_reads_back_equal_to_what_was_given.1 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.gradient.the_gradient_s_elements_take_the_fills_prefix.1 >>"$B/want-new.pairs"
    echo "  the new pairs expected: $(count_lines "$B/want-new.pairs") (change NZP)"
    new_exact() { cmp -s "$B/new.pairs" "$B/want-new.pairs"; }
    check "the new pairs are exactly the $(count_lines "$B/want-new.pairs") this phase's tests write, by name (change NZP)" "$(yn new_exact)"
    new_ctl() { head -n -1 "$B/want-new.pairs" >"$B/c-new.pairs"; cmp -s "$B/new.pairs" "$B/c-new.pairs"; }
    check "control: the same comparison refuses the list one pair short" "$(ynnot new_ctl)"
    # Change NZP (ruling C): the two pairs of the record whose bytes this
    # phase changes, by name, in byte order: the named styles sample's test,
    # whose output now holds the gradient dxf written back, and the round-trip
    # sample's None-fill test, whose input's fill is now an empty fill.
    : >"$B/want-changed.pairs"
    printf '%s\n' emend-copy.the_namedstyles_sample_reads_every_style_and_writes_the_differential_ones_back.1 >>"$B/want-changed.pairs"
    printf '%s\n' emend-copy.the_roundtrip_sample_compares_a_none_fill_with_fill_0_s_value.1 >>"$B/want-changed.pairs"
    changed_exact() { cmp -s "$B/changed.pairs" "$B/want-changed.pairs"; }
    check "the pairs of the record whose bytes differ are exactly the $(count_lines "$B/want-changed.pairs") ruling C names, by name (change NZP)" "$(yn changed_exact)"
    changed_ctl() { { cat "$B/want-changed.pairs"; printf '%s\n' other.1; } >"$B/c-changed.pairs"; cmp -s "$B/changed.pairs" "$B/c-changed.pairs"; }
    check "control: the same comparison refuses the list with a planted third pair (change NZP)" "$(ynnot changed_ctl)"
    changed_ctl2() { head -n 1 "$B/want-changed.pairs" >"$B/c-changed2.pairs"; cmp -s "$B/changed.pairs" "$B/c-changed2.pairs"; }
    check "control: the same comparison refuses the list with one of the two alone (change NZP)" "$(ynnot changed_ctl2)"
    echo "command: the #[test] functions added or whose body is edited since the named record commit, and those of a .rs file whose text outside its tests differs, from the two commits' sources of every .rs file git diff --name-only <named record commit> <phase commit> names: <work>/edited.py, below (change NSG)"
    cat >"$B/edited.py" <<'PY'
    """The #[test] functions whose body differs between two commits, or that
    the second adds: each file's text at both commits (git show), every
    function after a #[test] attribute (other attributes allowed between), its
    body from the fn line to the first line that is a lone closing brace in
    column one. Prints one test name per line; with a third argument
    --fixtures, instead every test whose body names an item (const,
    static, fn, struct, enum, type or mod at column one) whose lines
    outside the test bodies differ between the two commits (change
    NSG)."""
    import collections
    import re
    import subprocess
    import sys
    
    base, head = sys.argv[1:3]
    TEST = re.compile(r"#\[test\]\s*(?:#\[[^\]]*\]\s*)*fn\s+([A-Za-z0-9_]+)")
    
    
    def show(rev, path):
        run = subprocess.run(["git", "show", "%s:%s" % (rev, path)], capture_output=True)
        return run.stdout.decode() if run.returncode == 0 else ""
    
    
    def tests(text):
        out = {}
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            out[m.group(1)] = text[m.start():end if end >= 0 else len(text)]
        return out
    
    
    names = subprocess.run(["git", "diff", "--name-only", base, head, "--", "*.rs"],
                           capture_output=True, check=True).stdout.decode().split()
    ITEM = re.compile(r"^(?:pub(?:\([^)]*\))?\s+)?(?:const|static|fn|struct|enum|type|mod)\s+([A-Za-z_][A-Za-z0-9_]*)")
    
    
    def outside(text):
        out, at = [], 0
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            end = len(text) if end < 0 else end + 3
            if m.start() >= at:
                out.append(text[at:m.start()])
                at = end
        out.append(text[at:])
        return "".join(out)
    
    
    def changed_items(before_text, after_text):
        found = set()
        for text, other in ((after_text, before_text), (before_text, after_text)):
            others = collections.Counter(outside(other).split("\n"))
            current = None
            for line in outside(text).split("\n"):
                m = ITEM.match(line)
                if m:
                    current = m.group(1)
                if others[line] > 0:
                    others[line] -= 1
                elif current is not None:
                    found.add(current)
        return found
    
    
    edited = set()
    fixture = set()
    for path in names:
        before_text, after_text = show(base, path), show(head, path)
        before, after = tests(before_text), tests(after_text)
        for name, body in after.items():
            if before.get(name) != body:
                edited.add(name)
        items = changed_items(before_text, after_text)
        for name, body in after.items():
            if any(re.search(r"\b%s\b" % re.escape(i), body) for i in items):
                fixture.add(name)
    for name in sorted(fixture if sys.argv[3:] == ["--fixtures"] else edited):
        print(name)
    PY
    sed 's/^/    /' "$B/edited.py"
    python3 -I -B "$B/edited.py" "$PREV_OPEN_REC" "$C" | LC_ALL=C sort >"$B/edited.tests"
    python3 -I -B "$B/edited.py" "$PREV_OPEN_REC" "$C" --fixtures | LC_ALL=C sort >"$B/fixture.tests"
    LC_ALL=C sort -u "$B/edited.tests" "$B/fixture.tests" >"$B/touched.tests"
    sed 's/^/    added or edited test: /' "$B/edited.tests"
    sed 's/^/    test of a file whose text outside its tests differs: /' "$B/fixture.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/new.pairs" | LC_ALL=C sort -u >"$B/new.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/changed.pairs" | LC_ALL=C sort -u >"$B/changed.tests"
    echo "  tests with a new pair: $(count_lines "$B/new.tests"); tests with a changed pair: $(count_lines "$B/changed.tests"); tests added or edited: $(count_lines "$B/edited.tests"); tests of a file whose text outside its tests differs: $(count_lines "$B/fixture.tests")"
    check "some test is added or edited, so the list was read (change NWU)" "$(yn [ "$(count_lines "$B/edited.tests")" -ge 1 ])"
    new_from_edited() { [ "$(LC_ALL=C comm -23 "$B/new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every new pair is kept by a test added or edited since the record" "$(yn new_from_edited)"
    changed_from_touched() { [ "$(LC_ALL=C comm -23 "$B/changed.tests" "$B/touched.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every changed pair of the record is kept by a test edited since it, or of a file whose fixtures or helpers changed (change NSG)" "$(yn changed_from_touched)"
    printf 'zzz_not_an_edited_test\n' | LC_ALL=C sort -m - "$B/new.tests" >"$B/c-new.tests"
    new_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a pair of a test not added or edited" "$(yn new_ctl)"
    printf 'zzz_not_a_touched_test\n' | LC_ALL=C sort -m - "$B/changed.tests" >"$B/c-changed.tests"
    touched_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-changed.tests" "$B/touched.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a changed pair of a test neither edited nor of a changed file" "$(yn touched_ctl)"
    
    echo
    echo "## scripts/edit-open-check.sh on the host keep (specs/0018 \"Harness runs\": every phase's run log runs it over its keep)"
    mkdir "$B/tmp"
    # The open check's own TMPDIR, its device beside the runs' and the corpus
    # directory's.
    dev_open=$(stat -c %d "$B/tmp")
    echo "command: stat -c %d <work>/tmp <work>/tmp-run <corpus>/corpus /proc"
    echo "  device of the open check's TMPDIR (<work>/tmp): $dev_open; of the runs' TMPDIR (<work>/tmp-run): $(stat -c %d "$RUNTMP"); of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    check "the open check's TMPDIR and the corpus directory are on one device" "$(yn [ "$dev_open" = "$dev_corpus" ])"
    check "control: the same comparison tells /proc's device from the open check's TMPDIR's" "$(yn [ "$dev_proc" != "$dev_open" ])"
    echo "command: TMPDIR=<work>/tmp scripts/edit-open-check.sh --keep <keep> --libreoffice $IMAGE --out <scripts>/out/records --stem $STEM_OPEN"
    TMPDIR=$B/tmp scripts/edit-open-check.sh --keep "$KEEP" --libreoffice "$IMAGE" --out "$RECORDS" --stem "$STEM_OPEN" \
      >"$B/oc.stdout" 2>"$B/oc.stderr" </dev/null
    oc_rc=$?
    echo "  exit: $oc_rc"
    echo "  stdout:"; sed 's/^/    /' "$B/oc.stdout"
    echo "  stderr bytes: $(wc -c <"$B/oc.stderr")"
    check "the script exits 0 (no finding, no check errored)" "$(yn [ "$oc_rc" = 0 ])"
    check "its stderr is empty" "$(yn [ ! -s "$B/oc.stderr" ])"
    echo "  the reasons the script kept (its reasons directory under <work>/tmp), one line per refused side:"
    find "$B/tmp" -name '*-reason.txt' | LC_ALL=C sort | while IFS= read -r f; do echo "    ${f#"$B/tmp/"}: $(cat "$f")"; done
    TXT=$RECORDS/$STEM_OPEN.txt
    MD=$RECORDS/$STEM_OPEN.md
    TXT_HEADER=$(git show "$C:scripts/edit-open-check.sh" | sed -n "s/^readonly TXT_HEADER=\\$'\\(.*\\)'\$/\\1/p" | sed 's/\\t/\t/g')
    check "the .txt's header is the script's TXT_HEADER, read from the phase commit (nine columns)" "$(yn [ "$(head -n 1 "$TXT")" = "$TXT_HEADER" ])"
    tail -n +2 "$TXT" | cut -f1-5 >"$B/txt.rows"
    nrow_same=$(paste -d'\n' "$B/keep.rows" "$B/txt.rows" | awk 'NR % 2 == 1 { a = $0; next } a == $0 { n++ } END { print n + 0 }')
    echo "  rows: the keep $(count_lines "$B/keep.rows"), the .txt $(count_lines "$B/txt.rows"); rows whose name, bytes and hashes are the keep's, compared row by row: $nrow_same"
    rows_same() { [ "$(count_lines "$B/keep.rows")" = "$(count_lines "$B/txt.rows")" ] && [ "$nrow_same" = "$(count_lines "$B/keep.rows")" ] && [ "$nrow_same" = "$NPAIRS" ]; }
    check "every .txt row is one kept pair's name, byte counts and sha256s, in name order, one row per pair" "$(yn rows_same)"
    bad_rows=$(tail -n +2 "$TXT" | awk -F'\t' 'NF != 9 || $6 !~ /^(ok|fail|error)$/ || $7 !~ /^(ok|fail|error)$/ || $8 !~ /^(none|refused|count|error)$/ || $9 !~ /^(none|refused|count|error)$/' | wc -l)
    check "every row has nine columns, lo_in and lo each ok, fail or error, and each class none, refused, count or error ($bad_rows rows otherwise)" "$(yn [ "$bad_rows" = 0 ])"
    bad_fit=$(tail -n +2 "$TXT" | awk -F'\t' '{ print $6 ":" $8; print $7 ":" $9 }' | LC_ALL=C "$G" -cvxE 'ok:none|fail:refused|fail:count|error:error')
