    """The run log's fictional Excel-form gradient fixture
    (specs/0042-gradient-fills-and-named-styles.md, "Harness runs", the first
    fixture): one worksheet of four cells (A1:B2, numbers 1 to 4); a styles
    part in the corpus's shape (fonts, fills, borders, cellStyleXfs, cellXfs,
    cellStyles, dxfs, tableStyles) whose fills hold the two required pattern
    fills (none, gray125), a linear gradientFill of two stops with a degree
    (90) and a path gradientFill of two stops (type path, the four 0.5), each
    stop's colour a theme colour as Excel writes them; three cellStyleXfs
    formats; three cellStyle entries, Normal with builtinId 0, Good with its
    builtinId 26 and one custom entry, Fixture, with no builtinId; four cell
    formats, the second and third naming the two gradient fills and the
    fourth with xfId 2. Writes the workbook with zipfile at fixed timestamps
    into corpus/<id>.xlsx in the directory it is given, and a one-row
    manifest, manifest.tsv, beside corpus there, in specs/0005's form, <id>
    the first twelve hex digits of the workbook's sha256; prints the id, the
    byte count and the sha256, tab-separated."""
    import hashlib
    import io
    import os
    import sys
    import zipfile
    
    sys.dont_write_bytecode = True
    MAIN = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    REL = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    PKG = "http://schemas.openxmlformats.org/package/2006/relationships"
    CT = "http://schemas.openxmlformats.org/package/2006/content-types"
    VND = "application/vnd.openxmlformats-officedocument"
    DECL = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
    MANIFEST_HEADER = ("id\tsha256\tbytes\text\tproducer\tproducer_version\tapp\tsource\ttags\tadded"
                       "\toriginal_name\tnote")
    
    
    def rels(body):
        return DECL + '<Relationships xmlns="%s">%s</Relationships>' % (PKG, body)
    
    
    STOPS = '<stop position="0"><color theme="0"/></stop><stop position="1"><color theme="4"/></stop>'
    STYLES = (DECL + '<styleSheet xmlns="%s">'
              '<fonts count="1"><font><sz val="11"/><color theme="1"/><name val="Calibri"/>'
              '<family val="2"/><scheme val="minor"/></font></fonts>'
              '<fills count="4"><fill><patternFill patternType="none"/></fill>'
              '<fill><patternFill patternType="gray125"/></fill>'
              '<fill><gradientFill degree="90">%s</gradientFill></fill>'
              '<fill><gradientFill type="path" left="0.5" right="0.5" top="0.5" bottom="0.5">%s'
              '</gradientFill></fill></fills>'
              '<borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders>'
              '<cellStyleXfs count="3"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/>'
              '<xf numFmtId="0" fontId="0" fillId="2" borderId="0" applyFill="0"/>'
              '<xf numFmtId="0" fontId="0" fillId="3" borderId="0" applyFill="0"/></cellStyleXfs>'
              '<cellXfs count="4"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/>'
              '<xf numFmtId="0" fontId="0" fillId="2" borderId="0" xfId="0" applyFill="1"/>'
              '<xf numFmtId="0" fontId="0" fillId="3" borderId="0" xfId="0" applyFill="1"/>'
              '<xf numFmtId="0" fontId="0" fillId="3" borderId="0" xfId="2"/></cellXfs>'
              '<cellStyles count="3"><cellStyle name="Normal" xfId="0" builtinId="0"/>'
              '<cellStyle name="Good" xfId="1" builtinId="26"/>'
              '<cellStyle name="Fixture" xfId="2"/></cellStyles>'
              '<dxfs count="0"/><tableStyles count="0" defaultTableStyle="TableStyleMedium2"'
              ' defaultPivotStyle="PivotStyleLight16"/></styleSheet>' % (MAIN, STOPS, STOPS))
    SHEET = (DECL + '<worksheet xmlns="%s" xmlns:r="%s"><dimension ref="A1:B2"/>'
             '<sheetViews><sheetView workbookViewId="0"/></sheetViews>'
             '<sheetFormatPr defaultRowHeight="15"/><sheetData>'
             '<row r="1"><c r="A1" s="1"><v>1</v></c><c r="B1" s="2"><v>2</v></c></row>'
             '<row r="2"><c r="A2" s="3"><v>3</v></c><c r="B2"><v>4</v></c></row>'
             '</sheetData><pageMargins left="0.7" right="0.7" top="0.75" bottom="0.75" header="0.3"'
             ' footer="0.3"/></worksheet>' % (MAIN, REL))
    WORKBOOK = (DECL + '<workbook xmlns="%s" xmlns:r="%s"><bookViews><workbookView/></bookViews>'
                '<sheets><sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets></workbook>' % (MAIN, REL))
    TYPES = (DECL + '<Types xmlns="%s">'
             '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
             '<Default Extension="xml" ContentType="application/xml"/>'
             '<Override PartName="/xl/workbook.xml" ContentType="%s.spreadsheetml.sheet.main+xml"/>'
             '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="%s.spreadsheetml.worksheet+xml"/>'
             '<Override PartName="/xl/styles.xml" ContentType="%s.spreadsheetml.styles+xml"/>'
             '</Types>' % (CT, VND, VND, VND))
    ENTRIES = (
        ("[Content_Types].xml", TYPES),
        ("_rels/.rels", rels('<Relationship Id="rId1" Type="%s/officeDocument" Target="xl/workbook.xml"/>' % REL)),
        ("xl/workbook.xml", WORKBOOK),
        ("xl/_rels/workbook.xml.rels",
         rels('<Relationship Id="rId1" Type="%s/worksheet" Target="worksheets/sheet1.xml"/>'
              '<Relationship Id="rId2" Type="%s/styles" Target="styles.xml"/>' % (REL, REL))),
        ("xl/worksheets/sheet1.xml", SHEET),
        ("xl/styles.xml", STYLES),
    )
    
    
    def main():
        if len(sys.argv) != 2:
            print("usage: gradfix.py <dir>", file=sys.stderr)
            sys.exit(2)
        out = io.BytesIO()
        with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
            for name, text in ENTRIES:
                info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
                info.compress_type = zipfile.ZIP_DEFLATED
                z.writestr(info, text.encode("ascii"))
        data = out.getvalue()
        digest = hashlib.sha256(data).hexdigest()
        wid = digest[:12]
        corpus = os.path.join(sys.argv[1], "corpus")
        os.makedirs(corpus)
        with open(os.path.join(corpus, wid + ".xlsx"), "xb") as f:
            f.write(data)
        with open(os.path.join(sys.argv[1], "manifest.tsv"), "x", encoding="ascii") as f:
            f.write(MANIFEST_HEADER + "\n")
            f.write("\t".join((wid, digest, str(len(data)), "xlsx", "emend-run-log", "1", "zipfile",
                               "generated", "fixture", "2026-10-22", "gradient-fixture.xlsx",
                               "fictional")) + "\n")
        print("%s\t%d\t%s" % (wid, len(data), digest))
    
    
    main()
