### ruling F: the corpus's gradientFill elements by place, by this log's own count (counts only; change NZN)
    """This log's count of the gradientFill elements of each workbook's
    xl/styles.xml by place (specs/0042 ruling F): inside the root's extLst
    (any depth), as a fill of <fills>, as a fill of the main namespace's
    <dxfs>, and anywhere else. Prints one line per workbook holding any,
    "<id> extLst <n> fills <n> dxfs <n> other <n>", then "total extLst <n>
    fills <n> dxfs <n> other <n>; workbooks <n> of <m>". Usage: extcount.py
    <workbook>..., each named <id>.<ext>. Counts and ids only."""
    import os
    import sys
    import xml.etree.ElementTree as ET
    import zipfile
    
    sys.dont_write_bytecode = True
    M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    total = dict.fromkeys(("extLst", "fills", "dxfs", "other"), 0)
    holding = 0
    for path in sys.argv[1:]:
        wid = os.path.basename(path).rsplit(".", 1)[0]
        z = zipfile.ZipFile(path)
        if "xl/styles.xml" not in z.namelist():
            continue
        root = ET.fromstring(z.read("xl/styles.xml"))
        n = dict.fromkeys(total, 0)
        every = sum(1 for _ in root.iter(M + "gradientFill"))
        for ext in root.findall(M + "extLst"):
            n["extLst"] += sum(1 for _ in ext.iter(M + "gradientFill"))
        n["fills"] = len(root.findall(M + "fills/" + M + "fill/" + M + "gradientFill"))
        n["dxfs"] = len(root.findall(M + "dxfs/" + M + "dxf/" + M + "fill/" + M + "gradientFill"))
        n["other"] = every - n["extLst"] - n["fills"] - n["dxfs"]
        if every:
            holding += 1
            print("%s extLst %d fills %d dxfs %d other %d" % (wid, n["extLst"], n["fills"], n["dxfs"], n["other"]))
        for k in total:
            total[k] += n[k]
    print("total extLst %d fills %d dxfs %d other %d; workbooks %d of %d"
          % (total["extLst"], total["fills"], total["dxfs"], total["other"], holding, len(sys.argv) - 1))
