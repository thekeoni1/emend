    printf 'root: %srepo> stands for x; %sbld> stands for y\nread %srepo>/a and %sbld>/b\n' "$L" "$L" "$L" "$L" >"$B/c-ph-ok"
    printf '  sed -e "s#$X#%sgbld>#g"\nroot: %srepo> stands for x\n' "$L" "$L" >"$B/c-ph-scrub"
    check "control: the same rule finds one undeclared token before a slash in a planted file (ruling D; change UV)" "$(yn [ "$(undeclared "$B/c-ph-bad")" = 1 ])"
    check "control: the same rule finds none when a root line declares it" "$(yn [ "$(undeclared "$B/c-ph-ok")" = 0 ])"
    check "control: the same rule finds an undeclared scrub target" "$(yn [ "$(undeclared "$B/c-ph-scrub")" = 1 ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject "M6 part 5 P2 record: the logs, the records, the check, the scan")
    DOC=$(by_subject "M6 part 5 P3: commit planning docs (the P2 verification and rulings)")
    TESTC=$(by_subject "M6 part 5 P3: a test of self-closing cellStyleXfs and cellStyles opened for a named style")
    PROBE=$(by_subject "M6 part 5 P3: the size probes gain the gradient and the named style")
    CHANGELOG=$(by_subject "M6 part 5 P3: the CHANGELOG names gradient fills and named styles")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's full subject>, for each role"
    echo "  the previous record commit (the base, M6 part 5 P2's record): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the test commit (a test of self-closing cellStyleXfs and cellStyles opened for a named style): ${TESTC:-none}"
    echo "  the probe commit (the size probes gain the gradient and the named style): ${PROBE:-none}"
    echo "  the CHANGELOG commit, the phase commit: ${CHANGELOG:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CHANGELOG" "$PROBE" "$TESTC" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
