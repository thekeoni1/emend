    roles_files_ctl3() { local PROBE=$CHANGELOG; roles_files; }
    check "control: the same check refuses the CHANGELOG commit named as the probe commit (change YJ)" "$(ynnot roles_files_ctl3)"
    roles_files_ctl4() { local CHANGELOG=$PROBE; roles_files; }
    check "control: the same check refuses the probe commit named as the CHANGELOG commit (change YJ)" "$(ynnot roles_files_ctl4)"
    echo
