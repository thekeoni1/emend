    OURS="^(\\?\\? records/logs/m6p5-p3/|\\?\\? records/api-review-m6p5-[0-9]{4}-[0-9]{2}-[0-9]{2}-${SHORT_SHA}[.]md\$)"
    OWN=$OURS
