    check "the CHANGELOG commit, the probe commit, the test commit, the doc commit and the base, each the next one's parent, the CHANGELOG commit the phase commit (change YJ)" "$(yn roles_in_order)"
    roles_ctl() { local CHANGELOG=$PROBE; roles_in_order; }
    check "control: roles_in_order refuses the probe commit named as the phase commit (change YJ)" "$(ynnot roles_ctl)"
    roles_ctl2() { local DOC=$REC; roles_in_order; }
