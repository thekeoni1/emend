command: sed 's/^/    /' <scripts>/make_review.py; sha256sum: 3f7d4da214320dbeb009e1ba4208c97398e8db3f5923c88edcf6767e4c2dc90e; 13031 bytes
    #!/usr/bin/env python3
    """Assembles records/api-review-m6p5-<date>-<sha>.md from M6 part 5 P3's
    test.log listing (<phase>/api/listing.tsv) and M6 part 4 P3's listing
    (specs/0042-gradient-fills-and-named-styles.md, "P3": the API listing rerun,
    specs/0040 ruling V's added-by rule; rulings AS and AY). Generated by M6
    part 5 P3's gen/test.py from M6 part 4 P3's formatter (its print in
    records/logs/m6p4-p3/test.log, sha256 f960fb37...), changed so (change
    YO): its map of parts to specs gains "M6 part 5" -> specs/0042; its
    comparison is M6 part 4 P3's listing by the key without the added column;
    it takes the one cfg-widened row (name|cfg then|cfg now) in place of the
    gate sets, and the rows the diff dates otherwise than the listing's
    heuristic (ruling AY: key|the heuristic's commit|the diff's commit) and the
    program's hash in place of ruling V's re-dated rows and both programs'
    hashes; and its prose is this rerun's. Its table of verdicts other than
    keep stays empty. It only formats and counts; it judges nothing.
    
    Usage: make_review.py <listing.tsv> <M6 part 4 P3 listing.tsv> <out.md> <date>
           <short> <listing sha256> <files sha256> <formatter sha256>
           <doc links> <doc anchors> <doc items> <listed module-level items>
           <cfg-widened rows> <rows that lost Eq> <rows the diff dates otherwise>
           <program sha256>"""
    import re, sys
    from collections import Counter
    
    (listing, old_listing, out, date, short, listing_sha, files_sha, self_sha,
     doc_links, doc_anchors, doc_items, listed_items, widened_path, eq_path,
     dated_path, prog_sha) = sys.argv[1:17]
    
    # Each part's spec: the specs/*.md file its first doc commit added (git log
    # --diff-filter=A -- 'specs/*.md', read in the session).
    SPEC = {
        "M1 part 1": "0008", "M1 part 2": "0009", "M1 part 3": "0010", "M1 part 4": "0011",
        "M1 part 5": "0012", "M1 part 6": "0013", "M2 part 1": "0016", "M2 part 2": "0017",
        "M2 part 3": "0018", "M2 part 4a": "0019", "M2 part 4b": "0020", "M2 part 4c": "0021",
        "M2 part 4d": "0022", "M3 part 2": "0024", "M3 part 3": "0025", "M3 part 4": "0026",
        "M3 part 5": "0027", "M3 part 6": "0028", "M4 part 1": "0030",
        "M4 part 2": "0031", "M5 part 1": "0032", "M5 part 2": "0033",
        "M5 part 3": "0034", "M5 part 4": "0035", "M5 part 5": "0036",
        "M5 part 6": "0037", "M6 part 1": "0038", "M6 part 2": "0039",
        "M6 part 3": "0040", "M6 part 4": "0041", "M6 part 5": "0042",
    }
    
    # The verdicts that are not "keep": none. Part 7 P3's six (five renames and
    # one hide) were applied by M4 part 1 P2; every item listed now is keep, the
    # items of M6 part 5 among them.
    CHANGE = {}
    
    # Changes VY, WU and XS: the rows that keep their key and lost Eq, from the
    # fifteenth argument, one name|kind|module|before|now line each; marked in
    # the table, the verdict keep (none in M6 part 5).
    eq_rows = [line.split("|", 4) for line in open(eq_path).read().split("\n") if line]
    eq_keys = set((module, kind, name) for name, kind, module, _b, _a in eq_rows)
    
    def spec_of(subject):
        m = re.match(r"^(M\d+ part \d+[a-z]?)", subject)
        return ("specs/" + SPEC[m.group(1)]) if m and m.group(1) in SPEC else "-"
    
    def load(path):
        with open(path) as f:
            header = f.readline().rstrip("\n").split("\t")
            return [dict(zip(header, line.rstrip("\n").split("\t"))) for line in f]
    
    # Changes XS and YO (specs/0041 ruling L): the key without the added column.
    def key(r):
        return (r["module"], r["kind"], r["name"], r["container"], r["cfg"])
    
    rows = load(listing)
    old = load(old_listing)
    
    lines = []
    verdicts = Counter()
    by_module = {}
    for r in rows:
        by_module.setdefault(r["module"], []).append(r)
    n = 0
    for module in sorted(by_module, key=lambda m: (m.count("::"), m)):
        lines.append("")
        lines.append("### `%s`" % module)
        lines.append("")
        lines.append("| # | item | kind | feature | added by | spec | verdict |")
        lines.append("| --- | --- | --- | --- | --- | --- | --- |")
        for r in by_module[module]:
            n += 1
            name = r["name"] if r["container"] == "-" else "%s.%s" % (r["container"], r["name"])
            if r["kind"] == "use":
                name = "use %s" % r["name"]
            feature = r["cfg"] if r["cfg"] != "-" else "core"
            verdicts["keep"] += 1
            name = name.replace("|", "\\|")
            mark = "keep; Eq dropped (specs/0042 \"P3\")" if (r["module"], r["kind"], r["name"]) in eq_keys and r["container"] == "-" else "keep"
            lines.append("| %d | `%s` | %s | %s | %s | %s | %s |" % (
                n, name, r["kind"], feature.replace("|", "\\|"), r["added"], spec_of(r["added_subject"]), mark))
    
    new_keys = [key(r) for r in rows]
    old_keys = [key(r) for r in old]
    new_added = {key(r): r["added"] for r in rows}
    old_added = {key(r): r["added"] for r in old}
    gone = sorted(set(old_keys) - set(new_keys))
    came = sorted(set(new_keys) - set(old_keys))
    
    def show(k, added):
        module, kind, name, container, cfg = k
        item = name if container == "-" else "%s.%s" % (container, name)
        if kind == "use":
            item = "use %s" % name
        return "`%s` %s in `%s`, feature %s, added by %s" % (
            item, kind, module, cfg if cfg != "-" else "core", added)
    
    kinds = Counter(r["kind"] for r in rows)
    head = [
        "# API review rerun, Milestone 6 part 5 P3 (%s, %s)" % (date, short),
        "",
        "The API listing rerun as Milestone 6 part 4 P3 did, after Milestone 6 part 5 added gradient fills (`Gradient`, `GradientKind` and `Stop`, `Fill`'s `gradient` field) and named styles (`Style`'s `named` field, `Package::add_named_style`, and `Styles`'s `cell_style_xfs` read in the core) (`specs/0042-gradient-fills-and-named-styles.md`, \"P3\"). Every change against part 4's listing is named: thirteen rows new and three gone, below, compared by key without the added-by column (`specs/0041` ruling L). Two of the gone rows and two of the new are the re-exports of the styles elements, `use styles::{...}` in the crate root and `use elements::{...}` in `crate::styles`, each name list grown by `Gradient`, `GradientKind` and `Stop`, so each key changed; the third gone row and one of the new are `Styles.cell_style_xfs`, its cfg widened from `read` to the core (ruling R). Three rows the listing's heuristic dates to a commit whose diff did not make them so are listed below with the diff's commit beside the heuristic's (ruling AY). No row keeps its key and loses `Eq`: `Fill` loses `Copy` (decision 1 A) and derived no `Eq`; the part adds one message, `a style name is empty, too long or taken` (`STYLE_NAME_REFUSED`), private and in no row (test.log section T1 checks each). M6 part 4 P3's record is `records/api-review-m6p4-2026-10-22-1cc0de4.md`.",
        "",
        "- Listing: every `pub` item of `crates/emend` reachable from the crate root, as `records/logs/m6p5-p3/test.log` (section T1) prints it from the phase commit's sources with the listing program, sha256 %s (M6 part 4 P3's: part 7 P3's with change AV1); its file `listing.tsv` sha256 %s, `files.tsv` sha256 %s." % (prog_sha, listing_sha, files_sha),
        "- Formatter: this record is assembled by `make_review.py`, generated from M6 part 4 P3's formatter, sha256 %s (printed in test.log, section R2), its table of non-keep verdicts empty and its spec map extended to M6 part 5." % self_sha,
        "- Items: %d, by kind: %s." % (len(rows), ", ".join("%s %d" % (k, kinds[k]) for k in sorted(kinds, key=lambda k: (-kinds[k], k)))),
        "- The doc build (test.log section T2): `cargo doc` with every feature and `-D warnings`, exit 0, no warning line; its index `all.html` holds %s link lines, of which %s are the page's section anchors, leaving %s documented module-level items, against the listing's %s reachable module-level types, functions, constants and aliases." % (doc_links, doc_anchors, doc_items, listed_items),
        "- Columns: as part 7's record: `item` is the item's name, `Container.name` for a method or field, `use ...` for a re-export; `feature` is the cfg in force at the item (`core` for none); `added by` is the commit the listing finds introducing the item's declaration: for a member (a field, method or associated item of a type) the oldest commit whose copy of its file holds it in its type (change AV1), for any other row the oldest commit changing the count of its declaration text in its file (a heuristic the listing program states); `spec` is that commit's part's spec.",
        "- Verdicts: every item keep; no row lost Eq.",
    ]
    diff = ["", "## Rows that differ from M6 part 4 P3's listing", "",
            "Compared by key (module, kind, name, container, cfg; specs/0041 ruling L, the added-by column no part of it): %d of M6 part 4 P3's rows are not in this listing and %d of this listing's rows are not in M6 part 4 P3's; every other row is equal by key." % (len(gone), len(came)), "",
            "M6 part 4 P3's rows not here (added by as M6 part 4 P3's listing gives it):", ""]
    diff += ["- %s" % show(k, old_added[k]) for k in gone]
    # Changes YM, ZH, ZZO and ZZW (M5 part 6 P3), VD (M6 part 1 P3), VY (M6
    # part 2 P3), WU (M6 part 3 P3), XS (M6 part 4 P3) and YO (M6 part 5 P3): of the rows not in M6 part 4 P3's, those equal to a gone row but for the cfg are items whose gate
    # was widened;
    # the others are new items. A new row whose added-by commit differs from
    # its new type's row's is named, the cause not judged.
    gone_bare = set(k[:4] for k in gone)
    widened = [k for k in came if k[:4] in gone_bare]
    diff += ["", "This listing's rows not in M6 part 4 P3's (%d listed: %d cfg-widened items, %d new by key):" % (len(came), len(widened), len(came) - len(widened)), ""]
    diff += ["The %d cfg-widened items are M6 part 4 P3's rows not here with their cfg widened; the other %d rows are new by key, the items M6 part 5 adds and any row whose key changed (the rows not here above)." % (len(widened), len(came) - len(widened)), ""]
    owner = {(k[0], k[2]): new_added[k] for k in came if k[1] in ("struct", "enum") and k[3] == "-"}
    split = [k for k in came if k[3] != "-" and (k[0], k[3]) in owner and owner[(k[0], k[3])] != new_added[k]]
    if split:
        diff += ["%d new rows have an added-by commit other than their new type's: a later commit added the member to the type (change AV1 dates a member by its type)." % len(split), ""]
        diff += ["- `%s.%s`: %s; `%s`: %s" % (k[3], k[2], new_added[k], k[3], owner[(k[0], k[3])]) for k in split]
        diff += [""]
    diff += ["- %s" % show(k, new_added[k]) for k in came]
    # Change YO: the cfg-widened rows, from the thirteenth argument, one
    # name|cfg then|cfg now line each.
    wid = [line.split("|", 2) for line in open(widened_path).read().split("\n") if line]
    diff += ["", "## Items whose cfg widened", "",
             "%d items, in M6 part 4 P3's listing under a feature and in this one under a wider cfg (test.log section T1 reads the line above each declaration at both commits)." % len(wid), ""]
    diff += ["- `%s`: `%s` at M6 part 4 P3's phase commit, `%s` now (ruling R)" % (name, then, now) for name, then, now in wid]
    # Changes VY, WU, XS and YO: the rows that keep their key and lost Eq.
    diff += ["", "## Rows that keep their key and lost Eq", "",
             "%d rows equal by key in both listings, whose derive drops `Eq` since M6 part 4 P3's phase commit (test.log section T1 reads each derive line at both commits)." % len(eq_rows), ""]
    diff += ["- `%s` %s in `%s`: `%s` at M6 part 4 P3's phase commit, `%s` now" % (name, kind, module, b, a) for name, kind, module, b, a in eq_rows]
    # Change YO (ruling AY): the rows the diff dates otherwise than the
    # listing's heuristic, from the fifteenth argument, one
    # module|kind|name|container|cfg|the heuristic's|the diff's line each.
    dated = [line.split("|") for line in open(dated_path).read().split("\n") if line]
    diff += ["", "## added-by: the rows the diff dates otherwise (ruling AY)", "",
             "%d rows whose added-by the listing's heuristic (the oldest commit changing the count of the row's declaration text in its file) gives as a commit older than this part, while the diff that made the row so is this part's: a field whose cfg the diff widened, and two re-exports whose name lists the diff grew, so their keys changed (test.log section T1 reads each diff). The table below carries the heuristic's commit, as the listing gives it." % len(dated), ""]
    diff += ["- `%s` %s in `%s`, feature %s: %s by the listing's heuristic, %s by the diff" % (
        ("use %s" % n if kd == "use" else n if c == "-" else "%s.%s" % (c, n)), kd, m, (cf if cf != "-" else "core"), o, w) for m, kd, n, c, cf, o, w in dated]
    tail = ["", "## Counts per verdict", ""]
    for v in ("keep", "rename before publication", "hide", "widen or narrow"):
        tail.append("- %s: %d" % (v, verdicts[v]))
    tail.append("- in all: %d" % sum(verdicts.values()))
    tail.append("")
    with open(out, "w") as f:
        f.write("\n".join(head + diff + ["", "## The items, by module"] + lines + tail))
    print("rows %d; %s; differing from M6 part 4 P3: %d gone, %d new; cfg-widened %d; dated otherwise by the diff %d; Eq dropped %d" % (len(rows), dict(verdicts), len(gone), len(came), len(wid), len(dated), len(eq_rows)))
