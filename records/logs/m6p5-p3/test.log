        [ "$(files_of "$DOC" "$TESTC")" = "crates/emend/src/package/tests/named_style.rs" ] &&
        [ "$(files_of "$TESTC" "$PROBE")" = "tools/size-probe/src/bin/probe-emend-charts-write-xml.rs tools/size-probe/src/bin/probe-emend-comments-write-xml.rs tools/size-probe/src/bin/probe-emend-copy-write-xml.rs tools/size-probe/src/bin/probe-emend-copycomments-write-xml.rs tools/size-probe/src/bin/probe-emend-format-write-xml.rs tools/size-probe/src/bin/probe-emend-fullstyles-write-xml.rs tools/size-probe/src/bin/probe-emend-images-write-xml.rs tools/size-probe/src/bin/probe-emend-metadata-write-xml.rs tools/size-probe/src/bin/probe-emend-printnames-write-xml.rs tools/size-probe/src/bin/probe-emend-read-write-xml.rs tools/size-probe/src/bin/probe-emend-richcomment-write-xml.rs tools/size-probe/src/bin/probe-emend-richtext-write-xml.rs tools/size-probe/src/bin/probe-emend-rowcol-write-xml.rs tools/size-probe/src/bin/probe-emend-rules-write-xml.rs tools/size-probe/src/bin/probe-emend-sheetprops-write-xml.rs tools/size-probe/src/bin/probe-emend-tables-write-xml.rs" ] &&
        [ "$(files_of "$PROBE" "$CHANGELOG")" = "CHANGELOG.md" ]
