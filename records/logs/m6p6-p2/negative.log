    MK=mktemp
    # A call is a line that is not a comment holding a command substitution of
    # mktemp; a call in TMPDIR's form takes no argument but -d (no -p, no
    # --tmpdir, no -t and no template), so mktemp puts it in TMPDIR.
    MK_CALL="^[^#]*[$][(]${MK}([[:space:]]|[)])"
    MK_FORM="[$][(]${MK}( -d)?[)]"
    # mk_calls <file>: the calls; mk_bad <file>: the calls not in that form.
    mk_calls() { count_matches -E "$MK_CALL" "$1"; }
    mk_bad() { LC_ALL=C "$G" -E "$MK_CALL" "$1" | LC_ALL=C "$G" -cvE "$MK_FORM"; }
    printf '%s\n' "a=${D}(${MK} -d) || exit 2" "b=${D}(${MK} -p /x)" "# c=${D}(${MK} -p /y)" "d=${D}(${MK})" "echo ${MK} -d" >"$B/c-mktemp"
    for f in "$SELF" "$B/counting.sh"; do
      name=$([ "$f" = "$SELF" ] && echo "this script" || echo "the counting library, <scratch>/w/counting.sh")
      echo "  $name: mktemp calls $(mk_calls "$f"); of them not in TMPDIR's form $(mk_bad "$f")"
      LC_ALL=C "$G" -E "$MK_CALL" "$f" | sed 's/^[[:space:]]*/    /'
    done
    check "this script holds one mktemp call, B's mktemp -d, in TMPDIR's form, and makes no plain file" "$(yn [ "$(mk_calls "$SELF")$(mk_bad "$SELF")" = 10 ])"
    check "the counting library's mktemp calls (one, its controls' directory, removed by it) are each in TMPDIR's form" "$(yn [ "$(mk_bad "$B/counting.sh")" = 0 ])"
    check "control: the same count finds the fixture's three calls, not its comment or its echo" "$(yn [ "$(mk_calls "$B/c-mktemp")" = 3 ])"
    check "control: the same form refuses the fixture's one call with -p" "$(yn [ "$(mk_bad "$B/c-mktemp")" = 1 ])"
    echo "  the library's directory is made after TMPDIR is exported (change MP), so it lies under TMPDIR as <scratch>/w does, whose place is checked above"
    
    echo
    echo "## the scripts under test, at the phase commit (change NE58; M5 part 6 P2's change PX2)"
    # clone_at <dir>: a git clone --shared of <repo> checked out at the phase
    # commit, its exit codes and HEAD in <dir>.status.
    clone_at() {
      local dir=$1 rc_clone rc_co head
      git clone -q --shared "$MAIN" "$dir" >"$dir.clone.out" 2>"$dir.clone.err" </dev/null
      rc_clone=$?
      git -C "$dir" checkout -q --detach "$C" >>"$dir.clone.out" 2>>"$dir.clone.err" </dev/null
      rc_co=$?
      head=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
      echo "$rc_clone $rc_co ${head:-none}" >"$dir.status"
    }
    clone_ok() { [ "$(cat "$1.status")" = "0 0 $C" ] && [ -z "$(git -C "$1" status --porcelain 2>/dev/null)" ]; }
    echo "command: git clone -q --shared <repo> <scratch>/w/clone; git -C <scratch>/w/clone checkout -q --detach <phase commit> (a scratch copy: nothing in <repo> is written)"
    clone_at "$B/clone"
    echo "  clone exit, checkout exit and HEAD: $(cat "$B/clone.status"); output bytes $(wc -c <"$B/clone.clone.out"), standard error bytes $(wc -c <"$B/clone.clone.err")"
    check "the clone is at the phase commit, its working tree clean" "$(yn clone_ok "$B/clone")"
    clone_ctl() { local C=$REC; clone_ok "$B/clone"; }
    check "control: the same check refuses the clone read against the base (change NE58)" "$(ynnot clone_ctl)"
    RUNNER=$B/clone/scripts/compare-run.sh
    RECORD=$B/clone/scripts/compare-record.py
    RTEST=$B/clone/scripts/compare-record-test.py
    SCALEGEN=$B/clone/scripts/scale-gen.py
    same_blob() { [ -n "$want" ] && [ "$have" = "$want" ]; }
    for f in compare-run.sh compare-record.py compare-record-test.py openpyxl-ops.py scale-gen.py lo-check.sh; do
      have=$(sha256sum <"$B/clone/scripts/$f" | cut -d' ' -f1)
      want=$(git show "$C:scripts/$f" | sha256sum | cut -d' ' -f1)
      echo "command: sha256sum <scratch>/w/clone/scripts/$f: $have; the phase commit's blob: $want"
      check "the clone's scripts/$f is the phase commit's blob" "$(yn same_blob)"
    done
    for f in compare-run.sh compare-record.py compare-record-test.py; do
      echo "command: cat <scratch>/w/clone/scripts/$f (a script under test, or, for compare-record-test.py, the source of the fictional runs' builder)"
      sed 's/^/    /' "$B/clone/scripts/$f"
    done
    echo "  <scratch>/w/clone/scripts/lo-check.sh is sourced by the runner; no case gives --libreoffice, so its check never runs"
    echo "  <scratch>/w/clone/scripts/openpyxl-ops.py runs in the image (the cases below); scripts/scale-gen.py makes the workbook; their texts are the phase commit's blobs (hashed above)"
    
    echo
    echo "## the image (ruling A's containers are the image's; change NB58)"
    echo "command: podman image exists $IMAGE; podman image inspect --format '{{.Id}}' $IMAGE"
    podman image exists "$IMAGE" </dev/null >/dev/null 2>"$B/image.err"
    rc_img=$?
    IMAGE_ID=$(podman image inspect --format '{{.Id}}' "$IMAGE" </dev/null 2>>"$B/image.err")
    echo "  exists exit $rc_img; the image id: ${IMAGE_ID:-none}; standard error bytes $(wc -c <"$B/image.err")"
    image_ok() { [ "$rc_img" = 0 ] && printf '%s' "$IMAGE_ID" | LC_ALL=C "$G" -qE '^[0-9a-f]{64}$'; }
    check "the openpyxl image is there, its id read" "$(yn image_ok)"
    image_ctl() { podman image exists localhost/emend-openpyxl:no-such-tag </dev/null >/dev/null 2>&1; }
    check "control: the same check refuses a tag podman does not hold" "$(ynnot image_ctl)"
    
    echo
    echo "## the generated workbook and the plant (change NE58; M5 part 6 P2's change PX3)"
    FX=$B/fx
    mkdir -p "$FX" "$B/runs" "$B/tmp" "$B/rc" || exit 2
    echo "command: python3 -I -B <scratch>/w/clone/scripts/scale-gen.py t <scratch>/w/fx/t"
    python3 -I -B "$SCALEGEN" t "$FX/t" >"$B/gen-t.out" 2>"$B/gen-t.err" </dev/null
    echo "$?" >"$B/gen-t.rc"
    echo "  exit $(cat "$B/gen-t.rc"); its line: $(cat "$B/gen-t.out"); standard error bytes $(wc -c <"$B/gen-t.err")"
    gen_ok() { [ "$(cat "$B/gen-$1.rc")" = 0 ] && [ "$(count_matches -E "^generated $1 [0-9a-f]{12} [0-9]+ [0-9a-f]{64} " "$B/gen-$1.out")" = 1 ] && [ ! -s "$B/gen-$1.err" ] && [ "$(count_lines "$FX/$1/manifest.tsv")" = 2 ]; }
    check "tier t generated: exit 0, one generated line, a manifest of one row" "$(yn gen_ok t)"
    gen_ctl() { gen_ok x; }
    echo x >"$B/gen-x.rc"; : >"$B/gen-x.out"; : >"$B/gen-x.err"; mkdir -p "$FX/x"; : >"$FX/x/manifest.tsv"
    check "control: the same check refuses a generation that did not happen" "$(ynnot gen_ctl)"
    T_ID=$(awk -F'\t' 'NR == 2 { print $1 }' "$FX/t/manifest.tsv")
    echo "  tier t id $T_ID"
    
    # The plant program: one anchor line of the ops script's run(), the load,
    # gets a line before it; the planted text comes from the environment, so
    # nothing in this script's text is the path (change NE58: the path plant
    # alone of M5 part 6 P2's three).
    cat >"$FX/plant.py" <<'PLANT'
    """Plants one line in a copy of scripts/openpyxl-ops.py, before its one
    load_workbook line: the line writes the text of PLANT_TEXT and a newline to
    standard error and goes on. Exit 3 when the anchor is not there once;
    prints nothing."""
    import os
    import sys
    
    path = sys.argv[1]
    ANCHOR = "    wb = openpyxl.load_workbook(source)\n"
    text = open(path).read()
    if text.count(ANCHOR) != 1:
        sys.exit(3)
    plant = "    import sys as _s; _s.stderr.write(%r)\n" % (os.environ.get("PLANT_TEXT", "") + "\n")
    open(path, "w").write(text.replace(ANCHOR, plant + ANCHOR))
    PLANT
    echo "command: cat <scratch>/w/fx/plant.py (the plant program; sha256 $(sha256sum <"$FX/plant.py" | cut -d' ' -f1))"
    sed 's/^/    /' "$FX/plant.py"
    # The path is assembled here at run time and never printed.
    PLANT_PATH="/ho""me/someone/emend-""testing/corpus/fixture.xlsx"
    PATH_RE='(/ho''me/|/m''nt/|/Us''ers/|/t''mp/|emend-''testing)'
    # plant_clone <name>: a clone at the phase commit with the path plant made in its ops script.
    plant_clone() {
      local dir=$B/clone-$1
      clone_at "$dir"
      PLANT_TEXT=$PLANT_PATH python3 -I -B "$FX/plant.py" "$dir/scripts/openpyxl-ops.py" >"$B/plant-$1.out" 2>"$B/plant-$1.err" </dev/null
      echo "$?" >"$B/plant-$1.rc"
      echo "command: git clone -q --shared <repo> <scratch>/w/clone-$1 at the phase commit; PLANT_TEXT=<assembled at run time, not printed> python3 -I -B <scratch>/w/fx/plant.py <scratch>/w/clone-$1/scripts/openpyxl-ops.py"
      echo "  clone exit, checkout exit and HEAD: $(cat "$dir.status"); plant exit $(cat "$B/plant-$1.rc"), output bytes $(wc -c <"$B/plant-$1.out"), standard error bytes $(wc -c <"$B/plant-$1.err"); the planted script's lines changed against the phase commit's: $(git -C "$dir" diff --numstat -- scripts/openpyxl-ops.py | awk '{ print $1 " added, " $2 " removed" }')"
    }
    # planted_ok_unplanted: the same numstat test on the unplanted clone, the control.
    planted_ok_unplanted() { [ "$(git -C "$B/clone" diff --numstat -- scripts/openpyxl-ops.py | awk '{ print $1 " " $2 }')" = "1 0" ]; }
    planted_ok() { [ "$(cat "$B/clone-$1.status")" = "0 0 $C" ] && [ "$(cat "$B/plant-$1.rc")" = 0 ] && [ ! -s "$B/plant-$1.out" ] && [ ! -s "$B/plant-$1.err" ] && [ "$(git -C "$B/clone-$1" diff --numstat -- scripts/openpyxl-ops.py | awk '{ print $1 " " $2 }')" = "1 0" ]; }
    plant_clone n4
    check "N4's clone: the plant made, one line added to its ops script and nothing else" "$(yn planted_ok n4)"
    check "control: the same check refuses the unplanted clone" "$(ynnot planted_ok_unplanted)"
    
    echo
    echo "## the messages, read from the sources at the phase commit (never typed; change NC58)"
    echo "command: grep -o -E 'die \"--op must name one of the sixteen ops[^\"]*\"', sed -n for the readonly USAGE and OPS_LIST lines and grep -o -E 'echo \"containers of the image remaining: ' over <scratch>/w/clone/scripts/compare-run.sh; grep -o -F for the record script's two refusals over <scratch>/w/clone/scripts/compare-record.py, its corpus run row's 'raise Failure(\"%s run.openpyxl.tsv names another op\" % o_name)' and 'raise Failure(\"the %s runs do not cover the same workbooks\" % op)'; the text between the quotes"
    MSG_OP_RAW=$(LC_ALL=C "$G" -o -E 'die "--op must name one of the sixteen ops[^"]*"' "$RUNNER" | sed -e 's/^die "//' -e 's/"$//')
    USAGE_TEXT=$(sed -n 's/^readonly USAGE="\(.*\)"$/\1/p' "$RUNNER")
    MSG_OP=${MSG_OP_RAW/\$USAGE/$USAGE_TEXT}
    MSG_REMAIN=$(LC_ALL=C "$G" -o -E 'echo "containers of the image remaining: ' "$RUNNER" | sed -e 's/^echo "//')
    OPS_WORDS=$(sed -n 's/^readonly OPS_LIST="\(.*\)"$/\1/p' "$RUNNER")
    N_RUNNER_OPS=$(printf '%s\n' $OPS_WORDS | count_lines /dev/stdin)
    FMT_OTHER=$(LC_ALL=C "$G" -o -F 'raise Failure("%s run.openpyxl.tsv names another op" % o_name)' "$RECORD" | sed -e 's/^raise Failure("//' -e 's/" % o_name)$//')
    FMT_SAME=$(LC_ALL=C "$G" -o -F 'raise Failure("the %s runs do not cover the same workbooks" % op)' "$RECORD" | sed -e 's/^raise Failure("//' -e 's/" % op)$//')
    echo "  the runner's unknown-op message, its \$USAGE filled from the source: $MSG_OP"
    echo "  the runner's container count line, its start: $MSG_REMAIN"
    echo "  the runner's OPS_LIST: $OPS_WORDS ($N_RUNNER_OPS words)"
    echo "  the record script's run-row refusal, its format: $FMT_OTHER"
    echo "  the record script's workbooks refusal, its format: $FMT_SAME"
    one_line_msg() { [ -n "$1" ] && [ "$(printf '%s\n' "$1" | wc -l)" = 1 ]; }
    msgs_ok() { one_line_msg "$MSG_OP" && one_line_msg "$USAGE_TEXT" && one_line_msg "$MSG_REMAIN" && one_line_msg "$OPS_WORDS" && one_line_msg "$FMT_OTHER" && one_line_msg "$FMT_SAME" && [ "$MSG_OP" != "$MSG_OP_RAW" ]; }
    check "each message is found once in its source, not empty, the runner's \$USAGE filled (change NC58)" "$(yn msgs_ok)"
    msg_ctl() { one_line_msg "$(LC_ALL=C "$G" -o -E 'die "no such message[^"]*"' "$RUNNER")"; }
    check "control: the same reading finds no message for a start the source does not hold" "$(ynnot msg_ctl)"
    # Change NC59: the runner before P1's code commit, at P1's doc commit, where
    # its refusal names the eleven (the base, P1's record, names the sixteen).
    git show "$DOC1:scripts/compare-run.sh" >"$B/base-compare-run.sh" 2>"$B/base-compare-run.err"
    n_six_now=$(count_matches -F 'die "--op must name one of the sixteen ops' "$RUNNER")
    n_ele_now=$(count_matches -F 'die "--op must name one of the eleven ops' "$RUNNER")
    n_six_base=$(count_matches -F 'die "--op must name one of the sixteen ops' "$B/base-compare-run.sh")
    n_ele_base=$(count_matches -F 'die "--op must name one of the eleven ops' "$B/base-compare-run.sh")
    echo "command: count_matches -F of the refusal's start, naming the sixteen and naming the eleven, over the clone's runner and over git show <P1's doc commit>:scripts/compare-run.sh: sixteen $n_six_now and eleven $n_ele_now at the phase commit; sixteen $n_six_base and eleven $n_ele_base before P1's code commit (change NC59)"
    check "the runner's refusal names the sixteen at the phase commit, once, and the eleven not; the runner before P1's code commit names the eleven, once, and the sixteen not (ruling B, Q1; changes NC58 and NC59)" "$(yn [ "$n_six_now $n_ele_now $n_six_base $n_ele_base" = "1 0 0 1" ])"
    
    # run_case <name> <clone> <corpus tier> <runner arguments...>: the clone's
    # compare-run.sh over <scratch>/w/fx/<tier> with the copied xlsx-diff, the
    # run directory <scratch>/w/runs/<name>, TMPDIR in <scratch>/w/tmp; exit,
    # stdout and stderr kept as <name>.rc/.out/.err.
    run_case() {
      local name=$1 clone=$2 tier=$3 rc
      shift 3
      echo "### $name"
      echo "command: TMPDIR=<scratch>/w/tmp bash <scratch>/w/${clone##*/}/scripts/compare-run.sh --image $IMAGE --xlsx-diff <scratch>/w/bin/xlsx-diff --corpus <scratch>/w/fx/$tier --out <scratch>/w/runs/$name $*"
      TMPDIR=$B/tmp bash "$clone/scripts/compare-run.sh" --image "$IMAGE" --xlsx-diff "$XD" --corpus "$FX/$tier" --out "$B/runs/$name" "$@" >"$B/$name.out" 2>"$B/$name.err" </dev/null
      rc=$?
      echo "$rc" >"$B/$name.rc"
      echo "  exit: $rc; standard output:"
      sed 's/^/    /' "$B/$name.out"
      echo "  standard error:"
      sed 's/^/    /' "$B/$name.err"
    }
    rc_of() { cat "$B/$1.rc"; }
    # field <name> <column>: the column, found by its header name, of the run's one summary row.
    field() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } NR == 2 { print $k }' "$B/runs/$1/summary.openpyxl.tsv"; }
    # row_line <name>: the row's outcome, exit, signal, wall, peak RSS and leftover, as printed.
    row_line() { echo "  $1's row: outcome $(field "$1" outcome); exit $(field "$1" exit); signal $(field "$1" signal); wall_s $(field "$1" wall_s); peak_rss_kb $(field "$1" peak_rss_kb); leftover $(field "$1" leftover); diff_exit $(field "$1" diff_exit)"; }
    # ran_as <name> <outcome> <exit>: the runner exited 0 with nothing on stderr,
    # its summary one row of that outcome and exit, its last line no container left.
    ran_as() { [ "$(rc_of "$1")" = 0 ] && [ ! -s "$B/$1.err" ] && [ "$(count_lines "$B/runs/$1/summary.openpyxl.tsv")" = 2 ] && [ "$(field "$1" outcome)" = "$2" ] && [ "$(field "$1" exit)" = "$3" ] && [ "$(tail -n 1 "$B/$1.out")" = "${MSG_REMAIN}0" ]; }
    runner_refused() { [ "$(rc_of "$1")" = 2 ] && [ "$(count_lines "$B/$1.err")" = 1 ] && [ "$(count_matches -xF "error: $MSG_OP" "$B/$1.err")" = 1 ] && [ ! -s "$B/$1.out" ] && [ ! -e "$B/runs/$1" ]; }
    
    # The record script's fictional runs (change NG58): rfx.py builds them with
    # the clone's compare-record-test.py's own build() and makes one case's
    # change; it prints what it built and changed, never a path.
    cat >"$B/rfx.py" <<'RFX'
    """Fictional run directories for the negative log's record-script cases
    (specs/0043 "P1: the scripts"; ruling B, Q3), in the forms the phase
    commit's scripts/compare-record-test.py builds: its own build(), loaded
    from <test> by path (its main is not run), makes the sixteen ops' corpus
    and scale runs under <base>; then one change by <case>:
      R0  none (the control);
      N1b the openpyxl chart-text run's run.openpyxl.tsv names no-such-op, an
          op outside the sixteen;
      N2  the same file names named-style, another of the sixteen;
      N3  the openpyxl named-style run's summary holds one workbook of three.
    usage: rfx.py <test> <base> <case>
    Prints "stamp", "ops", "corpus", "scale" and "record" lines (the stamp, the
    number of ops the test builds and the three names under <base>) and, for a
    case that changes something, "changed <run directory>" and "op <op>"; no
    path. Exits 2 on an unknown case. Everything it writes is fictional."""
    import importlib.util
    import os
    import sys
    
    test, base, case = sys.argv[1], sys.argv[2], sys.argv[3]
    if case not in ("R0", "N1b", "N2", "N3"):
        print("unknown case")
        sys.exit(2)
    spec = importlib.util.spec_from_file_location("crt", test)
    crt = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(crt)
    corpus, scale, record = crt.build(base)
    print("stamp %s" % crt.STAMP)
    print("ops %d" % len(crt.OPS))
    print("corpus %s" % os.path.basename(corpus))
    print("scale %s" % os.path.basename(scale))
    print("record %s" % os.path.basename(record))
    if case in ("N1b", "N2"):
        name = "%s-openpyxl-chart-text" % crt.STAMP
        op = "no-such-op" if case == "N1b" else "named-style"
        crt.write(os.path.join(corpus, name, "run.openpyxl.tsv"),
                  [crt.OX_RUN, "c\ts\te\timg\t3.1.5\t600\t600\t4096\to\tx\t3\t" + op])
        print("changed %s" % name)
        print("op %s" % op)
    elif case == "N3":
        name = "%s-openpyxl-named-style" % crt.STAMP
        crt.write(os.path.join(corpus, name, "summary.openpyxl.tsv"),
                  [crt.SUMMARY_HEADER, crt.row(crt.IDS[0], "openpyxl", "ok", "1.00", "1", ("1", "0", "0", "0", "0"), "ok", "-")])
        print("changed %s" % name)
        print("op named-style")
    RFX
    echo "command: cat <scratch>/w/rfx.py (the fictional runs' program; sha256 $(sha256sum <"$B/rfx.py" | cut -d' ' -f1))"
    sed 's/^/    /' "$B/rfx.py"
    # fx_line <name> <word>: the value rfx.py printed after <word> for case <name>.
    fx_line() { sed -n "s/^$2 //p" "$B/$1-fx.out"; }
    # rcase <name>: rfx.py builds the case's directory under <scratch>/w/rc and
    # makes the case's change; the clone's compare-record.py runs on it with
    # --out the directory's out; exits, outputs and errors kept as
    # <name>-fx.rc/.out/.err and <name>.rc/.out/.err.
    rcase() {
      local name=$1 d=$B/rc/$1
      mkdir -p "$d/out" || exit 2
      echo "### $name"
      echo "command: python3 -I -B <scratch>/w/rfx.py <scratch>/w/clone/scripts/compare-record-test.py <scratch>/w/rc/$name $name"
      python3 -I -B "$B/rfx.py" "$RTEST" "$d" "$name" >"$B/$name-fx.out" 2>"$B/$name-fx.err" </dev/null
      echo "$?" >"$B/$name-fx.rc"
      echo "  exit $(rc_of "$name-fx"); standard error bytes $(wc -c <"$B/$name-fx.err"); its lines:"
      sed 's/^/    /' "$B/$name-fx.out"
      echo "command: python3 -I -B <scratch>/w/clone/scripts/compare-record.py --corpus-runs <scratch>/w/rc/$name/$(fx_line "$name" corpus) --scale-runs <scratch>/w/rc/$name/$(fx_line "$name" scale) --stamp $(fx_line "$name" stamp) --image-record <scratch>/w/rc/$name/$(fx_line "$name" record) --out <scratch>/w/rc/$name/out"
      python3 -I -B "$RECORD" --corpus-runs "$d/$(fx_line "$name" corpus)" --scale-runs "$d/$(fx_line "$name" scale)" --stamp "$(fx_line "$name" stamp)" \
        --image-record "$d/$(fx_line "$name" record)" --out "$d/out" >"$B/$name.out" 2>"$B/$name.err" </dev/null
      echo "$?" >"$B/$name.rc"
      echo "  exit: $(rc_of "$name"); standard output:"
      sed 's/^/    /' "$B/$name.out"
      echo "  standard error:"
      sed 's/^/    /' "$B/$name.err"
      echo "  files written to <scratch>/w/rc/$name/out: $(find "$d/out" -type f | count_lines /dev/stdin)"
    }
    # fx_ok <name> <changed>: rfx.py exited 0 with nothing on stderr, and
    # changed one run directory (yes) or none (no).
    fx_ok() { [ "$(rc_of "$1-fx")" = 0 ] && [ ! -s "$B/$1-fx.err" ] && [ "$(count_matches -E '^changed ' "$B/$1-fx.out")" = "$([ "$2" = yes ] && echo 1 || echo 0)" ]; }
    # op_in_row <name>: the op the changed run.openpyxl.tsv's one row names, its last column.
    op_in_row() { awk -F'\t' 'NR == 2 { print $NF }' "$B/rc/$1/$(fx_line "$1" corpus)/$(fx_line "$1" changed)/run.openpyxl.tsv"; }
    in_ops_list() { [[ "$OPS_WORDS" == *" $1 "* ]]; }
    # refused_with <name> <line>: exit 2, nothing on stdout, the one error line,
    # and no record written.
    refused_with() { [ "$(rc_of "$1")" = 2 ] && [ ! -s "$B/$1.out" ] && [ "$(count_lines "$B/$1.err")" = 1 ] && [ "$(count_matches -xF "$2" "$B/$1.err")" = 1 ] && [ "$(find "$B/rc/$1/out" -type f | count_lines /dev/stdin)" = 0 ]; }
    
    echo
    echo "## C0: the runner's control, an unplanted roundtrip over tier t"
    run_case C0 "$B/clone" t --op roundtrip
    row_line C0
    check "C0: one row, ok, exit 0, no container left" "$(yn ran_as C0 ok 0)"
    # Change PY4 (M5 part 6 P2): ruling I keeps the loop's count line; the trap's follows it.
    files_then_count() { [ "$(count_lines "$B/$1.out")" -ge 2 ] && [ "$(tail -n 2 "$B/$1.out" | head -n 1 | count_matches -E '^files [0-9]+ ok [0-9]+ error [0-9]+ timeout [0-9]+ cap [0-9]+ no-output [0-9]+$' /dev/stdin)" = 1 ] && [ "$(tail -n 1 "$B/$1.out")" = "${MSG_REMAIN}0" ]; }
    check "C0: the loop's files line, then the trap's count line naming 0 containers, last (ruling I)" "$(yn files_then_count C0)"
    
    echo
    echo "## R0: the record script's control, the fictional runs of the sixteen ops unchanged (change NG58)"
    rcase R0
    N_TEST_OPS=$(fx_line R0 ops)
    r0_ok() { fx_ok R0 no && [ "$(rc_of R0)" = 0 ] && [ ! -s "$B/R0.err" ] && [ "$(count_lines "$B/R0.out")" = 1 ] && [ "$(count_matches -E "^wrote compare-m6p6-$(fx_line R0 stamp)[.]md: ops $N_TEST_OPS; scale rows [0-9]+\$" "$B/R0.out")" = 1 ] && [ "$(find "$B/rc/R0/out" -type f | count_lines /dev/stdin)" = 1 ]; }
    check "R0: the fictional runs built, nothing changed; the record script writes its one record under the default stem compare-m6p6-, exit 0, one line naming as many ops as the test builds, nothing on stderr (change NG58)" "$(yn r0_ok)"
    echo "  ops: the test builds $N_TEST_OPS; the runner's OPS_LIST holds $N_RUNNER_OPS"
    check "the record script's test and the runner's OPS_LIST name the same number of ops, read and never typed (change NG58)" "$(yn [ "$N_TEST_OPS" = "$N_RUNNER_OPS" ])"
    r0_ctl() { local N_TEST_OPS=$((N_TEST_OPS + 1)); r0_ok; }
    check "control: the same check refuses R0's line read against one op more" "$(ynnot r0_ctl)"
    
    echo
    echo "## N1: an op outside the sixteen, refused by the runner and by the record script (specs/0043 \"P1: the scripts\"; ruling B, Q3)"
    run_case N1 "$B/clone" t --op no-such-op
    check "N1: the runner refuses the op: exit 2, its one error line from the source, nothing on stdout, no run directory" "$(yn runner_refused N1)"
    check "control: the same check refuses C0" "$(ynnot runner_refused C0)"
    rcase N1b
    N1B_MSG=$(printf "$FMT_OTHER" "$(fx_line N1b changed)")
    echo "  the op the changed run.openpyxl.tsv names: $(op_in_row N1b); the expected error line, the source's format filled with the changed directory: error: $N1B_MSG"
    check "N1: the fictional runs built, one run directory changed" "$(yn fx_ok N1b yes)"
    check "N1: the changed run row names an op that is not a word of the runner's OPS_LIST, outside the sixteen" "$(ynnot in_ops_list "$(op_in_row N1b)")"
    check "control: the same test finds chart-text, the changed run's own op, in OPS_LIST" "$(yn in_ops_list chart-text)"
    check "N1: the record script refuses it: exit 2, its one error line, nothing on stdout, no record written" "$(yn refused_with N1b "error: $N1B_MSG")"
    check "control: the same check refuses R0" "$(ynnot refused_with R0 "error: $N1B_MSG")"
    
    echo
    echo "## N2: a run directory whose run.openpyxl.tsv names another of the sixteen, refused by the record script"
    rcase N2
    N2_MSG=$(printf "$FMT_OTHER" "$(fx_line N2 changed)")
    echo "  the op the changed run.openpyxl.tsv names: $(op_in_row N2); the expected error line: error: $N2_MSG"
    check "N2: the fictional runs built, one run directory changed" "$(yn fx_ok N2 yes)"
    check "N2: the changed run row names another word of the runner's OPS_LIST, not the run's own op" "$(yn in_ops_list "$(op_in_row N2)")"
    n2_other() { [ "$(op_in_row N2)" != chart-text ]; }
    check "N2: the op named is not chart-text, the run directory's own" "$(yn n2_other)"
    check "N2: the record script refuses it: exit 2, its one error line, nothing on stdout, no record written" "$(yn refused_with N2 "error: $N2_MSG")"
    check "control: the same check refuses R0" "$(ynnot refused_with R0 "error: $N2_MSG")"
    
    echo
    echo "## N3: runs that do not cover the same workbooks, refused by the record script"
    rcase N3
    N3_MSG=$(printf "$FMT_SAME" "$(fx_line N3 op)")
    echo "  the changed summary's rows: $(($(count_lines "$B/rc/N3/$(fx_line N3 corpus)/$(fx_line N3 changed)/summary.openpyxl.tsv") - 1)); the expected error line: error: $N3_MSG"
    check "N3: the fictional runs built, one run directory changed" "$(yn fx_ok N3 yes)"
    check "N3: the record script refuses it: exit 2, its one error line, nothing on stdout, no record written" "$(yn refused_with N3 "error: $N3_MSG")"
    check "control: the same check refuses N2's run against N3's line" "$(ynnot refused_with N2 "error: $N3_MSG")"
    check "control: the same check refuses R0" "$(ynnot refused_with R0 "error: $N3_MSG")"
    
    echo
    echo "## N4: a run prints no path; a planted path stays in the run directory (M5 part 6 P2's N6)"
    run_case N4 "$B/clone-n4" t --op roundtrip
    row_line N4
    check "N4: one row, ok, exit 0, no container left" "$(yn ran_as N4 ok 0)"
    N4_ERR=$B/runs/N4/$T_ID/stderr.openpyxl.txt
    n_path_err=$(count_matches -E "$PATH_RE" "$N4_ERR")
    n_path_cap=$(cat "$B/N4.out" "$B/N4.err" | count_matches -E "$PATH_RE" /dev/stdin)
    n_path_tables=$(cat "$B/runs/N4/summary.openpyxl.tsv" "$B/runs/N4/entries.openpyxl.tsv" "$B/runs/N4/run.openpyxl.tsv" | count_matches -E "$PATH_RE" /dev/stdin)
    echo "  the path form: lines in the run subdirectory's stderr.openpyxl.txt $n_path_err (its bytes $(wc -c <"$N4_ERR")); in the runner's captured output $n_path_cap; in the run directory's three tables $n_path_tables"
    check "N4: the runner printed no path, and the tables hold none" "$(yn [ "$n_path_cap$n_path_tables" = 00 ])"
    check "control: the planted path is in the run subdirectory's stderr file, where the runner leaves it" "$(yn [ "$n_path_err" = 1 ])"
    printf 'x %s%s%s y\n' '/ho' 'me/someone/' 'emend-''testing/corpus/x.xlsx' >"$B/path-plant"
    printf 'x clean y\n' >"$B/path-clean"
    check "control: the path form counts a planted path 1 and a clean line 0" "$(yn [ "$(count_matches -E "$PATH_RE" "$B/path-plant") $(count_matches -E "$PATH_RE" "$B/path-clean")" = "1 0" ])"
    n_path_c0=$(count_matches -E "$PATH_RE" "$B/runs/C0/$T_ID/stderr.openpyxl.txt")
    check "control: C0's stderr file, unplanted, holds no path" "$(yn [ "$n_path_c0" = 0 ])"
    
    
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.out "$B"/*.err; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them admitted by the phase's pattern (this phase's logs, planning's modified specs/0043): $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is admitted by the phase's pattern: this phase's logs or planning's modified specs/0043 (changes NA53 to NA58)" "$(yn status_accounted)"
    echo
    echo "## this run's directory removed (change HC)"
    # Change NG48 (ruling G): rm -r without -f, on this run's own directory,
    # its standard input /dev/null so nothing is asked.
    echo "command: rm -r <scratch>/w </dev/null (this run's own mktemp -d directory, written \"\${B:?}\"; ruling G, change NG48)"
    rm -r "${B:?}" </dev/null
    b_present() { [ -e "$B" ]; }
    check "<scratch>/w is gone" "$(ynnot b_present)"
    check "control: the same test finds <build>, which stays" "$(yn [ -e "$BUILD_ROOT" ])"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    # Change MW (ruling 12): the copy with one byte appended is counted
    # through a pipe, so no plain file is made.
    nerr_ctl=$({ cat "$ERR"; printf 'x'; } | wc -c)
    echo "  command: wc -c <scripts>/out/negative.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
  control count_matches with a regular expression: 2 (expect 2)
  control count_matches on an unreadable file: error (expect error)
  control count_matches on readable plus unreadable: error (expect error)
  control count_from_file on the same file: 2 (expect 2)
  control count_from_file on a file with none: 0 (expect 0)
  control count_from_file on an unreadable file: error (expect error)
  control count_bytes, control bytes in a file with ESC, ESC and SI: 3 (expect 3)
  control count_bytes, non-ASCII bytes in a file with one two-byte character: 2 (expect 2)
  control count_bytes on a clean file: 0 (expect 0)
  control count_bytes on an unreadable file: error (expect error)
  control count_lines on a three-line file: 3 (expect 3)
  control count_lines on an unreadable file: error (expect error)
  control count_matches_i on mixed case: 2 (expect 2)
  control count_matches on the same file, case sensitive: 1 (expect 1)
  control count_matches_i on an unreadable file: error (expect error)
  control run_lines on a command printing three lines: 3 (expect 3)
  control run_lines on a command printing nothing: 0 (expect 0)
  control run_lines on a FAILING command: error (expect error)
  control run_lines on a command that cannot run: error (expect error)
  control run_matches on a command printing one match: 1 (expect 1)
  control run_matches on a FAILING command: error (expect error)
  counting controls: all as expected

