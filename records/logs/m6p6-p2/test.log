    sed '0,/^ok /s//FAIL /' "$B/ops-test.out" >"$B/ops-ctl.out"; cp "$B/ops-test.rc" "$B/ops-ctl.rc"; : >"$B/ops-ctl.err"
    check "control: the same check refuses the output with one ok line made FAIL" "$(ynnot ops_passed ops-ctl)"
    LC_ALL=C "$G" -v -x -F "ok named-style: exit 0" "$B/ops-test.out" >"$B/ops-ctl2.out"; cp "$B/ops-test.rc" "$B/ops-ctl2.rc"; : >"$B/ops-ctl2.err"
