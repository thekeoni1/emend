    echo "  lines the log expects once each: $(count_lines "$B/ops-test.want"); the named-style op's: $(count_matches -E '^ok named-style: ' "$B/ops-test.want")"
    # ops_passed <name>: exit 0, nothing on stderr, no FAIL line, 109 ok lines,
