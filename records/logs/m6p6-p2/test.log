command: sed 's/^/    /' <scratch>/w/defined.py
    """Ruling Q (specs/0037, the planning rulings during P2, second set): every
    helper a yn or ynnot call names is defined in the script that calls it,
    the shape bash -n cannot see. Ruling AD (specs/0037, "Planning
    verification of P3"): yn and ynnot themselves are defined in each script
    that calls them. Loaded by the phase's generators by path (they run with
    python3 -I -B). A call's name is the word after "$(yn " or "$(ynnot "
    outside a comment line; it is defined when a line of the script reads
    "<name>() {" (leading blanks allowed). The commands the scripts call by
    name through yn are the four in COMMANDS, which are not helpers. M5 part 6
    P3's copy, with the AD check added and its first two lines unchanged.
    Ruling AK a (specs/0037, "Planning verification of P4"): the gate calls its
    helpers through is and isnot, which this program now reads as it reads yn
    and ynnot, so the gate's count is no longer 0; is and isnot are checked as
    defined as yn and ynnot are. M6 part 1 P1's copy (specs/0038, "Generator
    rules")."""
    import re
    
    COMMANDS = ("[", "cmp", "true", "podman")
    CALL = re.compile(r"\$\((?:yn|ynnot|is|isnot) ([^ )\"]+)")
    WRAP = re.compile(r"\$\((yn|ynnot|is|isnot) ")
    DEF = re.compile(r"^[ \t]*([A-Za-z_][A-Za-z0-9_]*)\(\) \{", re.M)
    
    
    def undefined(script):
        """The names a yn, ynnot, is or isnot call of `script` gives that are neither a
        command of COMMANDS nor defined in it, sorted; and the count of
        distinct names called."""
        called = set()
        for line in script.split("\n"):
            if line.lstrip().startswith("#"):
                continue
            called.update(CALL.findall(line))
        defined = set(DEF.findall(script))
        return sorted(n for n in called if n not in COMMANDS and n not in defined), len(called)
    
    
    def wrappers_undefined(script):
        """Ruling AD: of yn, ynnot, is and isnot, the ones `script` calls outside a comment
        line and does not define, sorted; and the ones it calls, sorted."""
        called = set()
        for line in script.split("\n"):
            if line.lstrip().startswith("#"):
                continue
            called.update(WRAP.findall(line))
        defined = set(DEF.findall(script))
        return sorted(w for w in called if w not in defined), sorted(called)
    
    
    def check(script, name):
        """Prints the ruling Q line for `script` and its planted control, then
        ruling AD's line and its control, and exits when any is not as
        expected."""
        missing, n = undefined(script)
        print("%s: every helper a yn, ynnot, is or isnot call names is defined in it (%d names called; the commands %s are not helpers): %s"
              % (name, n, " ".join(COMMANDS), "yes" if not missing else "no, undefined: " + " ".join(missing)))
        planted = script + '\ncheck "planted" "$(yn zz_planted_undefined_helper)"\n'
        pmissing, _ = undefined(planted)
        ok_ctl = pmissing == missing + ["zz_planted_undefined_helper"] if not missing else False
        print("%s: control: the same check finds a planted call of an undefined helper: %s"
              % (name, "yes" if ok_ctl else "no"))
        wmissing, wcalled = wrappers_undefined(script)
        print("%s: yn, ynnot, is and isnot, where it calls them, are defined in it (it calls %s): %s"
              % (name, " and ".join(wcalled) if wcalled else "neither",
                 "yes" if not wmissing else "no, undefined: " + " ".join(wmissing)))
        # The control: a planted script calling yn and is and defining neither.
        cmissing, _ = wrappers_undefined('x="$(yn true)"\ny="$(is true)"\n')
        ok_wctl = cmissing == ["is", "yn"]
        print("%s: control: the same check finds yn and is undefined in a planted script calling both and defining neither: %s"
              % (name, "yes" if ok_wctl else "no"))
        # Ruling AK a's control: a planted is call of an undefined helper.
        imissing, _ = undefined(script + '\ncheck "planted" "$(is zz_planted_is_helper)"\n')
        ok_ictl = imissing == missing + ["zz_planted_is_helper"] if not missing else False
        print("%s: control: the same check finds a planted is call of an undefined helper: %s"
              % (name, "yes" if ok_ictl else "no"))
        if missing or not ok_ctl or wmissing or not ok_wctl or not ok_ictl:
            raise SystemExit("%s: a yn, ynnot, is or isnot call names an undefined helper, one of the four is undefined, or a control failed" % name)
