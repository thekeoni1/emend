    sed '0,/^ok /s//FAIL /' "$B/T1.out" >"$B/T1c.out"; cp "$B/T1.rc" "$B/T1c.rc"; : >"$B/T1c.err"
    check "control: the same check refuses the output with one ok line made FAIL" "$(ynnot cr_passed T1c)"
    LC_ALL=C "$G" -v -x -F "ok the one line names the stem, 16 ops and 102 scale rows" "$B/T1.out" >"$B/T1c2.out"; cp "$B/T1.rc" "$B/T1c2.rc"; : >"$B/T1c2.err"
    check "control: the same check refuses the output without the stem line, 16 ops and 102 scale rows (change YW)" "$(ynnot cr_passed T1c2)"
    
    
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.out; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
