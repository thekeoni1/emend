    check "P: the four files in <repo> are the phase commit's blobs (change YU)" "$(yn [ "$n_blob_ok" = 4 ])"
    blob_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$(git show "$C:scripts/compare-record.py" | sha256sum | cut -d' ' -f1)" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot blob_ctl)"
    for f in scripts/compare-record-test.py scripts/openpyxl-ops-test.sh; do
