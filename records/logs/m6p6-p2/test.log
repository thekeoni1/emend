    echo "status lines: $st_all; of them this phase's logs: $st_own; planning's working spec, admitted at PLANNING_SPEC: $st_plan; the two read by the accounted pattern: $st_ours (changes WW, XM, XW, YA, YI and YR)"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's logs or, when admitted, planning's working spec (changes UR, UY, VJ, WE, WS, WW, XD, XM, YA, YI and YR)" "$(yn status_accounted)"
    own_sum() { [ "$st_own" != error ] && [ "$st_plan" != error ] && [ "$st_ours" = "$((st_own + st_plan))" ]; }
    check "the accounted lines are the own lines and the plan line, summed (change WW)" "$(yn own_sum)"
    echo
