    NS_FORMS="COVER_NS_WRITE COVER_NS_INDEX COVER_NS_ESCAPE COVER_NS_NOBASE COVER_NS_RECORDED COVER_NS_BASE COVER_NS_PASS COVER_NS_READ"
    TWO_CORE_TESTS="COVER_TWO_CORE COVER_TWO_NUM COVER_TWO_XFS COVER_TWO_COLL"
    echo "command: count_matches -F 'fn <name>()' for this phase's tests over package/tests/named_style.rs, styles/tests.rs, package/tests/namedstyles.rs and tools/emend-copy/tests/null_rewrite.rs at the phase commit (change ND56)"
    for name in $NS_FORMS COVER_NS_PAST COVER_NS_NAME COVER_NS_DUP COVER_NS_COLL COVER_NS_NAMED COVER_NS_ORDER COVER_NS_DXF; do
