    check "control: the same check refuses a copy whose chart takes a combined plot" "$(ynnot reach_has "$TE_CHART" "$B/c-edit-combined.out")"
    check "control: the same check refuses a copy whose title is empty" "$(ynnot reach_has "$TE_RULE" "$B/c-edit-title.out")"
    check "control: the same check refuses a copy retitling the kept chart at index 1" "$(ynnot reach_has "$TE_KEPT" "$B/c-edit-kept.out")"
    check "control: the same check refuses a copy whose values are empty" "$(ynnot reach_has "$TE_REFS" "$B/c-edit-ref.out")"
    check "control: the same check refuses a copy whose last row is not bounded" "$(ynnot reach_has "$TE_REFS" "$B/c-edit-bound.out")"
    check "control: the same check refuses a copy whose first chart literal takes a style of 49" "$(ynnot reach_has "$TE_STYLE" "$B/c-edit-style.out")"
    check "control: the same check refuses a copy whose edit sample's style is 49 (ruling G)" "$(ynnot reach_has "$TE_STYLE" "$B/c-edit-range.out")"
    check "control: the chart check refuses the same copy, its style not 26 (ruling G)" "$(ynnot reach_has "$TE_CHART" "$B/c-edit-range.out")"
    # Change ND55: this phase's covering crate tests, each once in
