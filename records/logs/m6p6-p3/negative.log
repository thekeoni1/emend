        (DRAWING, drawing.encode(), STORED),
        ("xl/drawings/_rels/drawing1.xml.rels", drawing_rels.encode(), STORED),
        ("xl/media/image1.png", b"kept image bytes", STORED),
    ]
    
    
    def write(name, items):
        path = os.path.join(out, name + ".xlsx")
        with zipfile.ZipFile(path, "w") as z:
            for part, data, method in items:
                z.writestr(zipfile.ZipInfo(part, date_time=(1980, 1, 1, 0, 0, 0)), data, compress_type=method)
        with zipfile.ZipFile(path) as z:
            listed = z.namelist()
            back = all(z.read(p) == d for p, d, _ in items)
            methods = all(z.getinfo(p).compress_type == m for p, _, m in items)
        ct_index = listed.index("[Content_Types].xml") if "[Content_Types].xml" in listed else -1
        print("%s.xlsx entries:%d ct_index:%d read_back:%s methods:%s"
              % (name, len(listed), ct_index, "yes" if back else "no", "yes" if methods else "no"))
    
    
    write("b0", B0)
    renamed = []
    for part, data, method in B0:
        if part == DRAWING:
            assert data.count(b"xdr:wsDr") == 2 and b"xdr:userShapes" not in data
            data = data.replace(b"xdr:wsDr", b"xdr:userShapes")
            assert method == STORED
        renamed.append((part, data, method))
    print("n1 entries renamed:%d (the drawing part's root, xdr:wsDr to xdr:userShapes in its start and end tags, stored; every other entry as B0's)"
          % sum(1 for a, b in zip(B0, renamed) if a != b))
    write("n1", renamed)
    kept = [item for item in B0 if item[0] != DRAWING]
    print("n2 entries dropped:%d (the drawing part; the sheet's drawing element and relationship kept)"
          % (len(B0) - len(kept)))
    write("n2", kept)
    # N3 (change NE37): the worksheet's drawing element twice, the same
    # relationship named, every other entry as B0's.
    SHEET = "xl/worksheets/sheet1.xml"
    ONE = b'<drawing r:id="rId1"/>'
    doubled = []
    for part, data, method in B0:
        if part == SHEET:
            assert data.count(ONE) == 1 and method == STORED
            data = data.replace(ONE, ONE + ONE)
        doubled.append((part, data, method))
    print("n3 entries changed:%d (the worksheet, its drawing element twice; stored; every other entry as B0's)"
          % sum(1 for a, b in zip(B0, doubled) if a != b))
    write("n3", doubled)
    
    # B3 and N5 (change NE39): the charts fixture, rebuilt from the helpers'
    # own literals at the phase commit.
    LIT = re.compile(r'b?"((?:[^"\\]|\\.)*)"', re.S)
    
    
    def rust(raw):
        """A Rust string literal's value: a backslash and newline with the
        next line's leading whitespace dropped, then the escapes read."""
        s = re.sub(r"\\\n\s*", "", raw)
        return re.sub(r'\\(["\\nrt])', lambda m: {'"': '"', "\\": "\\", "n": "\n", "r": "\r", "t": "\t"}[m.group(1)], s)
    
    
    def fill(fmt, named, positional=()):
        """format!'s named and positional arguments put in; no brace escape."""
        assert "{{" not in fmt and "}}" not in fmt
        args = iter(positional)
        out = re.sub(r"\{([A-Za-z_]*)\}", lambda m: named[m.group(1)] if m.group(1) else next(args), fmt)
        assert next(args, None) is None
        return out
    
    
    def body_of(start):
        i = test.index(start)
        return test[i:test.index("\n}\n", i) + 3]
    
    
    def const(name):
        m = re.search(r"^const " + name + r': &str =\s*"((?:[^"\\]|\\.)*)";', test, re.M)
        assert m, name
        return rust(m.group(1))
    
    
    helpers = body_of("fn package_specs_with(extra: &str) -> Vec<Spec> {")
    charts = body_of("fn charts_specs(second: &str, position: &str) -> Vec<Spec> {")
    P = [rust(x) for x in LIT.findall(helpers)]
    C = [rust(x) for x in LIT.findall(charts)]
    ok = len(P) == 13 and len(C) == 21
    # The helpers' entry order and methods, as their source writes them.
    for needle in [
            'Spec::deflated(b"[Content_Types].xml", content_types.as_bytes()),',
            'Spec::stored(b"_rels/.rels", package_rels.as_bytes()),',
            'Spec::deflated(b"xl/workbook.xml", workbook.as_bytes()),',
            'Spec::stored(b"xl/_rels/workbook.xml.rels", workbook_rels.as_bytes()),',
            'Spec::deflated(b"xl/worksheets/sheet1.xml", b"<sheetData/>"),',
            'Spec::deflated(b"xl/styles.xml", b"<styleSheet/>"),',
            'Spec::deflated(b"xl/media/image1.bin", &binary_part()),']:
        ok = ok and needle in helpers
    for needle in [
            'let mut specs = package_specs_with(&format!(',
            'let vnd = "application/vnd.openxmlformats-officedocument";',
            'let c_ns = "http://schemas.openxmlformats.org/drawingml/2006/chart";',
            '*spec = Spec::deflated(b"xl/worksheets/sheet1.xml", sheet.as_bytes());',
            'frame("rId1"),\n        frame(second)',
            'let first = space(\n        "<c:style val=\\"2\\"/>",',
            'let second_chart = space(',
            'specs.push(Spec::stored(\n        b"xl/worksheets/_rels/sheet1.xml.rels",\n        sheet_rels.as_bytes(),\n    ));',
            'specs.push(Spec::deflated(\n        b"xl/drawings/drawing1.xml",\n        drawing.as_bytes(),\n    ));',
            'specs.push(Spec::stored(\n        b"xl/drawings/_rels/drawing1.xml.rels",\n        drawing_rels.as_bytes(),\n    ));',
            'specs.push(Spec::deflated(b"xl/charts/chart1.xml", first.as_bytes()));',
            'specs.push(Spec::deflated(\n        b"xl/charts/chart2.xml",\n        second_chart.as_bytes(),\n    ));']:
        ok = ok and needle in charts
    binary = body_of("fn binary_part() -> Vec<u8> {")
    ok = ok and binary == ('fn binary_part() -> Vec<u8> {\n    let mut data = Vec::from(&b"\\x89PNG\\r\\n\\x1a\\n"[..]);\n'
                           '    for n in 0..300u32 {\n        data.extend_from_slice(&n.to_le_bytes());\n'
                           '        data.push(0xFF);\n        data.push(0x80);\n    }\n    data\n}\n')
    ok = ok and [C[k] for k in (0, 2, 4, 9, 12, 16, 17, 18, 19, 20)] == [
