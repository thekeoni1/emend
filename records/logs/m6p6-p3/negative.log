        if not im:
            rules_ok = applies_ok = False
            continue
        fl = fields(im.group(1))
        d = dict(base)
        own = dict(fl)
        if own.get("..") != "base":
            rules_ok = applies_ok = False
        d.update({k: v for k, v in own.items() if k != ".."})
