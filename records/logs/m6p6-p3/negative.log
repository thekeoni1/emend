    refused_test = body_of("fn the_remove_chart_sample_refuses_a_frame_naming_no_part_and_leaves_nothing() {")
    ok = ok and 'let specs = charts_specs("rId2", "<c:axPos val=\\"l\\"/>");' in kept_test
    ok = ok and 'let ran = emend_copy_with(&input, &output, &["--remove-chart-sample"]);' in kept_test
    ok = ok and 'let mut missing = charts_specs("rId2", "<c:axPos val=\\"l\\"/>");' in refused_test
    ok = ok and 'missing.retain(|spec| spec.name != b"xl/charts/chart1.xml");' in refused_test
    ok = ok and '"--remove-chart-sample",' in refused_test
    print("the charts helpers read: literals %d and %d: %s" % (len(P), len(C), "yes" if ok else "no"))
    assert ok, "the charts helpers"
    named = {"TYPES_NS": const("TYPES_NS"), "RELS_NS": const("RELS_NS"), "MAIN_NS": const("MAIN_NS"),
             "ATTR_NS": const("ATTR_NS"), "RELS_TYPE": const("RELS_TYPE"),
             "WORKBOOK_TYPE": const("WORKBOOK_TYPE"), "SHEET_TYPE": const("SHEET_TYPE"),
             "vnd": C[0], "c_ns": C[2], "second": "rId2", "position": '<c:axPos val="l"/>'}
    named["extra"] = fill(C[1], named)
    data = bytearray(b"\x89PNG\r\n\x1a\n")
    for n in range(300):
        data += n.to_bytes(4, "little") + b"\xff\x80"
    
    
    def frame(rel):
        return fill(C[7], dict(named, id=rel))
    
    
    def space(before, body):
        return fill(C[11], dict(named, before=before, body=body))
    
    
    B3 = [
        ("[Content_Types].xml", fill(P[0], named).encode(), DEFLATED),
        ("_rels/.rels", fill(P[1], named).encode(), STORED),
        ("xl/workbook.xml", fill(P[2], named).encode(), DEFLATED),
        ("xl/_rels/workbook.xml.rels", fill(P[3], named).encode(), STORED),
        ("xl/worksheets/sheet1.xml", fill(C[3], named).encode(), DEFLATED),
        ("xl/styles.xml", P[11].encode(), DEFLATED),
        ("xl/media/image1.bin", bytes(data), DEFLATED),
        (C[16], fill(C[6], named).encode(), STORED),
        (C[17], fill(C[8], named, (frame(C[9]), frame(named["second"]))).encode(), DEFLATED),
        (C[18], fill(C[10], named).encode(), STORED),
        (C[19], space(C[12], fill(C[13], named)).encode(), DEFLATED),
        (C[20], space(C[14], fill(C[15], named)).encode(), DEFLATED),
    ]
    write("b3", B3)
    CHART1 = "xl/charts/chart1.xml"
    kept5 = [item for item in B3 if item[0] != CHART1]
    print("n5 entries dropped:%d (xl/charts/chart1.xml; the drawing's frame and relationship naming it kept)"
          % (len(B3) - len(kept5)))
    write("n5", kept5)
    # The kept remove-chart test's line, the string asserted against stdout.
    m = re.search(r'assert_eq!\(\n\s*ran\.stdout,\n\s*"((?:[^"\\]|\\.)*)",\n\s*"the line"\n\s*\);', kept_test, re.S)
    assert m, "the kept remove-chart test's line"
    line = rust(m.group(1))
