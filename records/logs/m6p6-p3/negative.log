    check "the named style tool test $COVER_NS_NOSTYLES is at the phase commit, once, runs the named style sample and holds the collection message (change ND56)" "$(yn [ "$(yn covered_once "$COVER_NS_NOSTYLES" "$B/null_rewrite.rs")$(yn body_holds "$COVER_NS_NOSTYLES" "$B/null_rewrite.rs" "\"--namedstyle-sample\"")$(yn body_holds "$COVER_NS_NOSTYLES" "$B/null_rewrite.rs" "\"$COLLECTION_MSG\"")" = yesyesyes ])"
    check "control: body_holds says no for the named style sample in $COVER_GRAD_LINE's body (change ND56)" "$(ynnot body_holds "$COVER_GRAD_LINE" "$B/null_rewrite.rs" "\"--namedstyle-sample\"")"
    # Change ND56: the named style sample cannot give the name rules a bad name,
    # a named style a named, or the named arm an index it did not get: the
    # phase commit's tools/emend-copy/src/main.rs read by reach9.py, with a
    # planted copy per check. What the binary CAN reach is ruling X's four,
    # N20 to N23 below.
    cat >"$B/reach9.py" <<'PY'
    """The named style sample's constants (change ND56): the phase commit's
    tools/emend-copy/src/main.rs split into its top-level functions, as
    reach.py splits it. The functions calling add_named_style are
    namedstyle_sample alone, once, with SAMPLE_STYLE_NAME and the style
    sample_named_style gives; the constant is a name the name rules take (not
    empty, at most 255 characters, none a character XML cannot carry);
    sample_named_style's style gives no named; the functions giving a style
    named: Some(..) are namedstyle_sample alone, twice, each the index the
    add_named_style call returned; every other named field of the tool is
    named: None. Usage: reach9.py <main.rs>."""
    import re
    import sys
    
    src = open(sys.argv[1]).read()
    FN = re.compile(r"^(?:pub(?:\([a-z]+\))? )?fn ([a-z_0-9]+)[<(]", re.M)
    fns = {}
    for m in FN.finditer(src):
        end = src.find("\n}\n", m.start())
        assert end > 0, m.group(1)
        fns.setdefault(m.group(1), []).append(src[m.start():end + 3])
    
    
    def body(name):
        assert len(fns.get(name, [])) == 1, name
        return fns[name][0]
    
    
    callers = sorted(n for n, bs in fns.items() for b in bs if ".add_named_style(" in b)
    print("functions calling add_named_style: " + " ".join(callers))
    s = body("namedstyle_sample") if "namedstyle_sample" in fns else ""
    calls = re.findall(r"let (\w+) = package\.add_named_style\((\w+), &(\w+)\)\?;", s)
    set_from = re.findall(r"let (\w+) = (\w+)\(\);", s)
    one_call = (len(re.findall(r"\.add_named_style\(", s)) == 1 and len(calls) == 1
                and calls[0][1] == "SAMPLE_STYLE_NAME" and (calls[0][2], "sample_named_style") in set_from)
    print("namedstyle_sample calls add_named_style once, with SAMPLE_STYLE_NAME and sample_named_style's style: %s"
          % ("yes" if one_call else "no"))
    const = re.findall(r'^const SAMPLE_STYLE_NAME: &str = "((?:[^"\\]|\\.)*)";', src, re.M)
    FORBIDDEN = re.compile("[\x00-\x08\x0b\x0c\x0e-\x1f\ufffe\uffff]")
    name_ok = (len(const) == 1 and "\\" not in const[0] and 0 < len(const[0]) <= 255
               and not FORBIDDEN.search(const[0]))
    shown = const[0] if len(const) == 1 and re.fullmatch(r"[ -~]*", const[0]) else "(not printable ASCII, not printed)"
    print("SAMPLE_STYLE_NAME: %s; a name the name rules take: %s"
          % (shown if const else "none", "yes" if name_ok else "no"))
    style = body("sample_named_style") if "sample_named_style" in fns else ""
    print("sample_named_style's style gives no named: %s"
          % ("yes" if style and not re.search(r"\bnamed:", style) and "..Style::default()" in style else "no"))
    k = calls[0][0] if len(calls) == 1 else None
    some = sorted(set(n for n, bs in fns.items() for b in bs if re.search(r"\bnamed: Some\(", b)))
    given = re.findall(r"\bnamed: Some\((\w+)\)", s)
    print("functions giving named: Some: %s; namedstyle_sample gives it %d times, each the returned index: %s"
          % (" ".join(some) or "none", len(given), "yes" if given and k and all(g == k for g in given) else "no"))
    others = re.findall(r"\bnamed: (?!Some\()([^,\n]*),", src)
    print("every other named field of the tool is named: None: %s (%d)"
          % ("yes" if others and all(o == "None" for o in others) else "no", len(others)))
    PY
    python3 -I -B "$B/reach9.py" "$B/main.rs" >"$B/named.out" 2>&1
    echo "command: python3 -I -B <scratch>/w/reach9.py <scratch>/w/main.rs (tools/emend-copy/src/main.rs, git show <phase commit>; change ND56)"
    sed 's/^/    /' "$B/reach9.py"
    sed 's/^/    /' "$B/named.out"
    TN_CALLERS="functions calling add_named_style: namedstyle_sample"
    TN_CALL="namedstyle_sample calls add_named_style once, with SAMPLE_STYLE_NAME and sample_named_style's style: yes"
    TN_NAME="SAMPLE_STYLE_NAME: emend sample style; a name the name rules take: yes"
    TN_STYLE="sample_named_style's style gives no named: yes"
    TN_SOME="functions giving named: Some: namedstyle_sample; namedstyle_sample gives it 2 times, each the returned index: yes"
    TN_OTHERS="every other named field of the tool is named: None: yes (1)"
    check "the functions of the tool calling add_named_style are namedstyle_sample alone (change ND56)" "$(yn reach_has "$TN_CALLERS" "$B/named.out")"
    check "namedstyle_sample calls add_named_style once, with the constant SAMPLE_STYLE_NAME and sample_named_style's style (change ND56)" "$(yn reach_has "$TN_CALL" "$B/named.out")"
    check "the constant is emend sample style, a name the name rules take: not empty, at most 255 characters, none a character XML cannot carry (ruling W; change ND56)" "$(yn reach_has "$TN_NAME" "$B/named.out")"
    check "sample_named_style's style gives no named, so the named style's own check is not met (change ND56)" "$(yn reach_has "$TN_STYLE" "$B/named.out")"
    check "named: Some is given by namedstyle_sample alone, twice, each the index add_named_style returned (change ND56)" "$(yn reach_has "$TN_SOME" "$B/named.out")"
    check "every other named field of the tool, one, is named: None (change ND56)" "$(yn reach_has "$TN_OTHERS" "$B/named.out")"
    python3 -I -B - "$B/main.rs" "$B" <<'PY' >"$B/named-plant.out" 2>&1
    import sys
    
    src = open(sys.argv[1]).read()
    out = sys.argv[2]
    PLANTS = [
        ("caller", "fn sample_named_style() -> Style {",
         "fn planted_named(package: &mut Package<File>) {\n    let _ = package.add_named_style(\"x\", &Style::default());\n}\n\nfn sample_named_style() -> Style {",
         "a function other than namedstyle_sample calling add_named_style"),
        ("name", 'const SAMPLE_STYLE_NAME: &str = "emend sample style";', 'const SAMPLE_STYLE_NAME: &str = "";',
         "the constant name empty"),
        ("control", 'const SAMPLE_STYLE_NAME: &str = "emend sample style";',
         'const SAMPLE_STYLE_NAME: &str = "emend\x01sample";', "the constant name holding U+0001"),
        ("style", "fn sample_named_style() -> Style {\n    Style {\n",
         "fn sample_named_style() -> Style {\n    Style {\n        named: Some(0),\n", "the named style's style giving named 0"),
        ("index", "            named: Some(k),\n            ..Style::default()\n        },\n    )?;\n    for",
         "            named: Some(9),\n            ..Style::default()\n        },\n    )?;\n    for", "the second format naming 9, not k"),
        ("other", "                named: None,\n", "                named: Some(0),\n", "the round-trip literal giving named 0"),
    ]
    for name, old, new, what in PLANTS:
        assert src.count(old) == 1, name
        text = src.replace(old, new)
        assert text != src, name
        open("%s/c-named-%s.rs" % (out, name), "w").write(text)
        print("c-named-%s.rs: %s" % (name, what))
    PY
    echo "command: the same program over six planted copies, each changing one thing (change ND56):"
    sed 's/^/    /' "$B/named-plant.out"
    for c in caller name control style index other; do
      python3 -I -B "$B/reach9.py" "$B/c-named-$c.rs" >"$B/c-named-$c.out" 2>&1
    done
