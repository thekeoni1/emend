          % yes(applies_ok and labels_ok))
    loop = re.search(r"for \(chart, k\) in charts\.iter\(\)\.zip\(0u32\.\.\) \{", body)
    calls = body.count("package.add_chart(&part, anchor, chart)?;")
    print("charts added: %s" % (" ".join(charts) if loop and calls == 1 else "-"))
    print("every chart of the list is added, once: %s" % yes(bool(loop) and calls == 1 and len(charts) == 3))
