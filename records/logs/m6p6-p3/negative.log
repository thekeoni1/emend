    import sys
    
    src = open(sys.argv[1]).read()
    out = sys.argv[2]
    POS1 = "                position: 1.0,\n                color: Color::Rgb(to),\n"
    STOP2 = "            Stop {\n" + POS1 + "            },\n"
    PLANTS = [
        ("build", "fn sample_gradients() -> [Fill; 2] {",
         "fn planted_gradient() -> GradientKind {\n    GradientKind::Linear { degree: 1.0 }\n}\n\nfn sample_gradients() -> [Fill; 2] {",
         "a function other than sample_gradients naming GradientKind"),
        ("degree", "GradientKind::Linear { degree: 90.0 }", "GradientKind::Linear { degree: 400.0 }",
         "the linear gradient's degree 400"),
        ("side", "                left: 0.5,\n", "                left: 1.5,\n", "the path gradient's left 1.5"),
        ("position", POS1, POS1.replace("1.0", "1.5"), "the second stop's position 1.5"),
        ("order", "                position: 0.0,\n", None, None),
        ("stops", STOP2, "", "the stops closure of one stop"),
        ("pattern", "        pattern: Pattern::None,\n        foreground: None,\n        background: None,\n        gradient: Some(",
         "        pattern: Pattern::Solid,\n        foreground: None,\n        background: None,\n        gradient: Some(",
         "the fill closure's pattern Solid"),
        ("tint", "                color: Color::Rgb(to),\n",
         "                color: Color::Theme {\n                    index: 0,\n                    tint: Some(1.5),\n                },\n",
         "the second stop's colour a theme colour with a tint"),
        ("base", "package.add_style(None, &style)?", "package.add_style(Some(0), &style)?",
