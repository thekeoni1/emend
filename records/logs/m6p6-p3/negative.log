    cat >"$B/activetab.py" <<'PY'
    """The message emend-copy prints when the sheet sample's read-back finds the
    first view's active tab not one more (specs/0043 ruling P): the
    SheetSample Display arm's format string, its {what} the word
    sheet_read_back passes for the active tab. Usage: activetab.py <main.rs>."""
    import re
    import sys
    
    src = open(sys.argv[1]).read()
    fmt = re.findall(r'Error::SheetSample\(what\) => \{\s*write!\(f, "([^"]*)"\)', src)
    word = re.findall(r'return Err\(Error::SheetSample\("(active tab)"\)\);', src)
    if len(fmt) != 1 or len(word) != 1 or "{what}" not in fmt[0]:
        sys.exit("the sheet sample's active-tab message is not found once")
    print(fmt[0].replace("{what}", word[0]))
    PY
    sed 's/^/    /' "$B/activetab.py"
    echo "command: python3 -I -B <scratch>/w/activetab.py <scratch>/w/main.rs (tools/emend-copy/src/main.rs at the phase commit)"
    ACTIVE_MSG=$(python3 -I -B "$B/activetab.py" "$B/main.rs" 2>/dev/null)
    echo "  the message: ${ACTIVE_MSG:-none}"
