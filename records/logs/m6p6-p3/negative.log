      cp "$SIZE_BUILD/${tp}release/emend-copy" "$B/rel/$label/emend-copy" </dev/null
      want=$(sized_of "$SIZE_LOG" "$tp" emend-copy)
      have=$(sha256sum <"$B/rel/$label/emend-copy" 2>/dev/null | cut -d' ' -f1)
      echo "command: cp <target>/main/${tp}release/emend-copy <scratch>/w/rel/$label/emend-copy (the size log's build directory)"
      echo "  <scratch>/w/rel/$label/emend-copy: sha256 $have; the size log's line: ${want:-none}"
