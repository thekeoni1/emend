    body_holds_folded() { [ "$(body_of "$1" "$2" | python3 -I -B -c 'import re, sys; sys.stdout.write(re.sub(r"\\\n\s*", "", sys.stdin.read()))' | count_matches -F "$3" /dev/stdin)" -ge 1 ]; }
    COVER_NS_WRITE=a_named_style_writes_its_format_without_xf_id_and_its_entry_with_both_counts
