    done
    check "control: the same check refuses a copy building a trendline in another function (change ND47)" "$(ynnot reach_has "$TR_BUILD" "$B/c-trend-build.out")"
    check "control: the same check refuses a copy whose closure forecasts forward" "$(ynnot reach_has "$TR_DEFAULTS" "$B/c-trend-default.out")"
    check "control: the same check refuses a copy whose polynomial's order is 7" "$(ynnot reach_has "$TR_RULES" "$B/c-trend-order.out")"
    check "control: the same check refuses a copy whose moving average's period is 1" "$(ynnot reach_has "$TR_RULES" "$B/c-trend-period.out")"
    check "control: the same check refuses a copy whose moving average forecasts forward" "$(ynnot reach_has "$TR_RULES" "$B/c-trend-average.out")"
    check "control: the same check refuses a copy with an intercept on a power trendline" "$(ynnot reach_has "$TR_RULES" "$B/c-trend-intercept.out")"
    check "control: the same check refuses a copy forecasting forward -2" "$(ynnot reach_has "$TR_RULES" "$B/c-trend-forecast.out")"
    check "control: the same check refuses a copy whose trendline name is empty" "$(ynnot reach_has "$TR_NAMES" "$B/c-trend-name.out")"
    check "control: the same check refuses a copy whose fixed length is 0" "$(ynnot reach_has "$TR_VALUES" "$B/c-trend-length.out")"
    check "control: the same check refuses a copy whose custom minus is not one of the column references" "$(ynnot reach_has "$TR_CUSTOM" "$B/c-trend-custom.out")"
    check "control: the same check refuses a copy giving the line's fixed bars a direction" "$(ynnot reach_has "$TR_KINDS" "$B/c-trend-direction.out")"
    check "control: the same check refuses a copy whose scatter takes two sets of one direction" "$(ynnot reach_has "$TR_KINDS" "$B/c-trend-same.out")"
    check "control: the same check refuses a copy whose line takes the two sets" "$(ynnot reach_has "$TR_KINDS" "$B/c-trend-two.out")"
    check "control: the same check refuses a copy whose column is a 3D column" "$(ynnot reach_has "$TR_KINDS" "$B/c-trend-kind.out")"
    check "control: the same check refuses a copy whose charts take a combined plot" "$(ynnot reach_has "$TR_COMBINED" "$B/c-trend-combined.out")"
    # Change ND48: this phase's covering crate tests, each once in
    # package/tests/chart_write.rs, the refusing ones' bodies asserting their
    # messages (body_asserts); the axis tool tests, once each, each running the
    # axis sample.
    COVER_LINES_KINDS=the_plot_lines_are_taken_by_the_kinds_that_take_them_and_refused_by_the_others
    COVER_LINES_FORMS=the_plot_lines_are_written_after_the_series_and_before_the_marker_and_the_axis_ids
    COVER_AXIS_KINDS=the_axis_options_are_taken_by_each_kind_s_axes_by_their_form_and_refused_by_the_round_kinds
    COVER_SCALING=the_scaling_is_written_in_the_schema_s_order_and_the_units_and_skips_in_their_places
    COVER_DATE=a_date_axis_takes_the_category_axis_s_place_with_its_units
    COVER_AXIS_RULES=the_axis_field_rules_are_refused
    COVER_AXIS_ORDER=the_plot_lines_and_the_axes_follow_the_check_order
    COVER_AXIS_LINE=the_chart_axis_sample_adds_a_line_a_scatter_and_a_column_and_reads_them_back
    COVER_AXIS_TOOL_FORMS=the_chart_axis_sample_writes_each_plot_line_and_axis_form
    COVER_AXIS_BOUND=the_chart_axis_sample_references_at_most_a_thousand_rows
    AXIS_RANGE="COVER_AXIS_RULES COVER_AXIS_ORDER"
    AXIS_OPTION="COVER_LINES_KINDS COVER_AXIS_KINDS"
    AXIS_FORMS="COVER_LINES_FORMS COVER_SCALING COVER_DATE"
    AXIS_TOOL="COVER_AXIS_LINE COVER_AXIS_TOOL_FORMS COVER_AXIS_BOUND"
    echo "command: count_matches -F 'fn <name>()' for this phase's tests over package/tests/chart_write.rs and tools/emend-copy/tests/null_rewrite.rs at the phase commit (change ND48)"
    for name in $AXIS_RANGE $AXIS_OPTION $AXIS_FORMS; do
      echo "  chart_write::${!name} $(count_matches -F "fn ${!name}()" "$B/write-tests.rs")"
    done
    for name in $AXIS_TOOL; do
      echo "  ${!name} $(count_matches -F "fn ${!name}()" "$B/null_rewrite.rs")"
    done
    for name in $AXIS_RANGE; do
      check "${!name} is at the phase commit, once, and asserts the range message, RANGE, and the option message, OPTION (change ND48)" "$(yn [ "$(yn covered_once "${!name}" "$B/write-tests.rs")$(yn body_asserts "${!name}" RANGE)$(yn body_asserts "${!name}" OPTION)" = yesyesyes ])"
    done
    for name in $AXIS_OPTION; do
      check "${!name} is at the phase commit, once, and asserts the option message, OPTION (change ND48)" "$(yn [ "$(yn covered_once "${!name}" "$B/write-tests.rs")$(yn body_asserts "${!name}" OPTION)" = yesyes ])"
    done
    check "control: body_asserts says no for RANGE against $COVER_LINES_KINDS (change ND48)" "$(ynnot body_asserts "$COVER_LINES_KINDS" RANGE)"
    for name in $AXIS_FORMS; do
      check "the form test ${!name} is at the phase commit, once (change ND48)" "$(yn covered_once "${!name}" "$B/write-tests.rs")"
    done
    for name in $AXIS_TOOL; do
      check "the axis tool test ${!name} is at the phase commit, once, and runs the axis sample (change ND48)" "$(yn [ "$(yn covered_once "${!name}" "$B/null_rewrite.rs")$(yn body_holds "${!name}" "$B/null_rewrite.rs" "&[\"--chart-axis-sample\"]")" = yesyes ])"
    done
    check "control: body_holds says no for the axis sample in $COVER_TREND_LINE's body (change ND48)" "$(ynnot body_holds "$COVER_TREND_LINE" "$B/null_rewrite.rs" "&[\"--chart-axis-sample\"]")"
    # Change ND48: CHART_OPTION_KIND and CHART_VALUE_RANGE for this phase's
    # plot line and axis rules (specs/0040 "Applicability", rulings J and K),
    # raised at the call, are not reachable through emend-copy. The phase
    # commit's tools/emend-copy/src/main.rs read by a program that splits it
    # into its top-level functions, as reach.py does: the functions building an
    # axis or a date axis are chart_axis_sample alone; every other chart
    # literal of the tool gives no drop lines, no up-down bars and no axis
    # option, and high-low lines false on a literal plot other than a stock
    # plot, true on a literal stock plot, or its plot compared with
    # NewPlot::Stock (the core commit's field line), a spread literal setting
    # none of the five and no stock plot; in chart_axis_sample the axis default
    # gives no option, the closure chart no plot line, no axis option and no
    # combined plot; its three charts take the plot lines and the axis fields
    # by the rules (plot lines on a line, an area or a stock plot as each
    # takes them, a stock plot's high-low lines always; no axis on a round
    # kind; a date form on a bar's, a line's, an area's or a stock plot's
    # category axis alone; each field on the form that takes it; the bounds
    # finite and the minimum below the maximum; a base 2 to 1000; the units
    # finite and positive; the skips and date counts 1 or more); the charts
    # added are the three. Each check has a planted copy it refuses.
    cat >"$B/reach5.py" <<'PY'
    import re
    import sys
    
    main = open(sys.argv[1]).read()
    lines = main.split("\n")
    fns = {}
    order = []
    cur = None
    for line in lines:
        m = re.match(r"(pub(\(crate\))? )?fn ([a-z0-9_]+)", line)
        if m and cur is None:
            cur = (m.group(3), [])
        if cur is not None:
            cur[1].append(line)
            if line == "}":
                fns[cur[0]] = cur[1]
                order.append(cur[0])
                cur = None
    
    
    def yes(ok):
        return "yes" if ok else "no"
    
    
    def closing(text, start):
        """The index just past the bracket closing the one opened before start."""
        depth, j = 1, start
        while depth:
            c = text[j]
            if c in "{[(":
                depth += 1
            elif c in "}])":
                depth -= 1
            j += 1
        return j
    
    
    def fields(body):
        """A struct literal's top-level fields as (name, value), a spread as
        ("..", base), a shorthand field as (name, name)."""
        parts, depth, cur = [], 0, ""
        for c in body:
            if c in "{[(":
                depth += 1
            elif c in "}])":
                depth -= 1
            if c == "," and depth == 0:
                parts.append(cur.strip())
                cur = ""
            else:
                cur += c
        if cur.strip():
            parts.append(cur.strip())
        out = []
        for p in parts:
            if p.startswith(".."):
                out.append(("..", " ".join(p[2:].split())))
            elif re.match(r"[a-z_]+: ", p):
                name, value = p.split(": ", 1)
                out.append((name, " ".join(value.split())))
            else:
                out.append((p, p))
        return out
    
    
    def literals(text, name):
        out = []
        for m in re.finditer(r"\b%s \{" % name, text):
            j = closing(text, m.end())
            out.append((m.start(), fields(text[m.end():j - 1])))
        return out
    
    
    FIVE = ("drop_lines", "high_low_lines", "up_down_bars", "category_axis", "value_axis")
    builders = [n for n in order if re.search(r"\b(NewAxis|NewDateAxis) \{", "\n".join(fns[n]))]
    print("functions building an axis or a date axis: %s" % " ".join(builders))
    # Every chart literal outside the axis sample: no plot line but a stock
    # plot's high-low lines, no axis option.
    others_ok, n_full, n_spread = True, 0, 0
    for name in order:
        if name == "chart_axis_sample":
            continue
        for _, fl in literals("\n".join(fns[name]), "NewChart"):
            d = dict(fl)
            if ".." in d:
                n_spread += 1
                plot = d.get("plot")
                others_ok = others_ok and not any(f in d for f in FIVE)
                others_ok = others_ok and (plot is None or (plot.startswith("NewPlot::")
                                                            and not plot.startswith("NewPlot::Stock")))
                continue
            n_full += 1
            plot = d.get("plot", "")
            hl = d.get("high_low_lines", "")
            ok = (d.get("drop_lines") == "false" and d.get("up_down_bars") == "false"
                  and d.get("category_axis") == "None" and d.get("value_axis") == "None")
            if hl == "false":
                ok = ok and plot.startswith("NewPlot::") and not plot.startswith("NewPlot::Stock")
            elif hl == "true":
                ok = ok and plot == "NewPlot::Stock"
            else:
                ok = ok and re.fullmatch(r"[a-z_]+", plot) is not None and hl == "%s == NewPlot::Stock" % plot
            others_ok = others_ok and ok
    print("every other chart literal: no plot line but a stock plot's high-low lines, no axis option: %s"
          " (%d full, %d spread)" % (yes(others_ok and n_full > 0), n_full, n_spread))
    body = "\n".join(fns.get("chart_axis_sample", []))
    AXIS_NONE = [("min", "None"), ("max", "None"), ("log_base", "None"), ("reversed", "false"),
                 ("major_unit", "None"), ("minor_unit", "None"), ("tick_label_skip", "None"),
                 ("tick_mark_skip", "None"), ("date", "None")]
    am = re.search(r"let axis = NewAxis \{", body)
    axis_ok = bool(am) and fields(body[am.end():closing(body, am.end()) - 1]) == AXIS_NONE
    print("the axis default gives no option: %s" % yes(axis_ok))
    cm = re.search(r"let chart = \|plot: NewPlot\| NewChart \{", body)
    closure = dict(fields(body[cm.end():closing(body, cm.end()) - 1])) if cm else {}
    closure_ok = bool(closure) and closure.get("plot") == "plot" and all(
        closure.get(f) == v for f, v in (("drop_lines", "false"), ("high_low_lines", "false"),
                                         ("up_down_bars", "false"), ("category_axis", "None"),
                                         ("value_axis", "None"), ("combined", "None")))
    print("the closure chart gives no plot line, no axis option and no combined plot: %s" % yes(closure_ok))
    NUM = r"-?[0-9]+(?:\.[0-9]+)?"
    charts = {}
    for m in re.finditer(r"let ([a-z_]+) = NewChart \{", body):
        fl = fields(body[m.end():closing(body, m.end()) - 1])
        d = dict(fl)
        base = d.get("..", "")
        pm = re.fullmatch(r"chart\(NewPlot::([A-Za-z0-9]+)(?: \{(.*)\})?\)", base)
        if pm:
            charts[m.group(1)] = (pm.group(1), re.sub(r"\s", "", pm.group(2) or ""), d)
    ROUND = {"Pie", "Pie3D", "Doughnut", "OfPie"}
    XY = {"Scatter", "Bubble"}
    DATED = {"Bar", "Line", "Area", "Stock"}
    shown = []
    lines_ok = bool(charts)
    axes_shown = []
    axes_ok = bool(charts)
    
    
    def axis_fields(value):
        am = re.fullmatch(r"Some\(NewAxis \{(.*)\}\)", value, re.S)
        if not am:
            return None
        fl = fields(am.group(1))
        if fl[-1:] != [("..", "axis")]:
            return None
        return dict(fl[:-1])
    
    
    def number(v):
        m = re.fullmatch(r"Some\((%s)\)" % NUM, v)
        return float(m.group(1)) if m else None
    
    
    for name, (kind, opts, d) in charts.items():
        flags = {f: d.get(f, "false") for f in FIVE[:3]}
        shown.append("%s %s%s %s" % (name, kind, "{%s}" % opts if opts else "",
                                     ",".join("%s=%s" % kv for kv in sorted(flags.items()) if kv[1] != "false") or "-"))
        takes = {"drop_lines": kind in ("Line", "Area", "Stock"), "high_low_lines": kind in ("Line", "Stock"),
                 "up_down_bars": kind in ("Line", "Stock")}
        for f, v in flags.items():
            lines_ok = lines_ok and v in ("true", "false") and (v == "false" or takes[f])
        if kind == "Stock":
            lines_ok = lines_ok and flags["high_low_lines"] == "true"
        for which in ("category_axis", "value_axis"):
            value = d.get(which)
            if value is None:
                continue
            af = axis_fields(value)
            if af is None:
                axes_ok = False
                axes_shown.append("%s %s unread" % (name, which))
                continue
            axes_shown.append("%s %s %s" % (name, which.split("_")[0],
                                            ",".join("%s=%s" % kv for kv in sorted(af.items()))))
            if kind in ROUND:
                axes_ok = False
                continue
            category = which == "category_axis"
            date = af.get("date", "None")
            if date != "None":
                dm = re.fullmatch(r"Some\(NewDateAxis \{ base_unit: TimeUnit::(Days|Months|Years), "
                                  r"major: (None|Some\(\(([0-9]+), TimeUnit::(Days|Months|Years)\)\)), "
                                  r"minor: (None|Some\(\(([0-9]+), TimeUnit::(Days|Months|Years)\)\)), \}\)", date)
                if not dm or not category or kind not in DATED or kind in XY:
                    axes_ok = False
                    form = None
                else:
                    form = "date"
                    for count in (dm.group(3), dm.group(6)):
