    git show "$C:crates/emend/src/package/tests/gradient.rs" >"$B/gradient-tests.rs"
    COVER_GRAD_LINEAR=a_linear_gradient_is_written_with_its_degree_and_its_stops
    COVER_GRAD_ZERO=a_linear_gradient_of_degree_zero_writes_no_degree
    COVER_GRAD_PATH=a_path_gradient_writes_its_type_and_all_four_sides
    COVER_GRAD_COLOURS=a_stop_takes_each_colour_form_and_equal_gradients_share_one_fill
    COVER_GRAD_PREFIX=the_gradient_s_elements_take_the_fills_prefix
    COVER_GRAD_CHILD=a_gradient_beside_a_pattern_or_a_colour_is_refused_and_records_nothing
    COVER_GRAD_RANGE=each_gradient_range_is_refused_and_records_nothing
    COVER_GRAD_ORDER=the_gradient_is_checked_after_the_cell_format_s_own_children
    COVER_GRAD_READ=each_form_reads_back_as_the_writer_takes_it
    COVER_GRAD_UNREAD=a_gradient_that_cannot_be_read_is_refused
    COVER_GRAD_BACK=a_written_gradient_reads_back_equal_to_what_was_given
    COVER_GRAD_DXF=a_differential_style_s_gradient_is_written_back_through_the_same_composer
    COVER_GRAD_LINE=the_gradient_sample_adds_two_gradient_fills_and_two_formats
    COVER_GRAD_NOFILLS=the_gradient_sample_refuses_a_part_without_fills_and_leaves_nothing
    GRAD_FORMS="COVER_GRAD_LINEAR COVER_GRAD_ZERO COVER_GRAD_PATH COVER_GRAD_COLOURS COVER_GRAD_PREFIX COVER_GRAD_READ COVER_GRAD_BACK COVER_GRAD_DXF"
    GRAD_TOOL="COVER_GRAD_LINE COVER_GRAD_NOFILLS"
    echo "command: count_matches -F 'fn <name>()' for this phase's tests over package/tests/gradient.rs and tools/emend-copy/tests/null_rewrite.rs at the phase commit (change ND55)"
    for name in COVER_GRAD_CHILD COVER_GRAD_RANGE COVER_GRAD_ORDER COVER_GRAD_UNREAD $GRAD_FORMS; do
      echo "  gradient::${!name} $(count_matches -F "fn ${!name}()" "$B/gradient-tests.rs")"
    done
