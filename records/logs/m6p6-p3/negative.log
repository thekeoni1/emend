    import re
    import sys
    
    main = open(sys.argv[1]).read()
    lines = main.split("\n")
    fns = {}
    order = []
    cur = None
    for line in lines:
        m = re.match(r"(pub(\(crate\))? )?fn ([a-z0-9_]+)", line)
        if m and cur is None:
            cur = (m.group(3), [])
        if cur is not None:
            cur[1].append(line)
            if line == "}":
                fns[cur[0]] = cur[1]
                order.append(cur[0])
                cur = None
    
    
    def yes(ok):
        return "yes" if ok else "no"
    
    
    def closing(text, start):
        """The index just past the bracket closing the one opened before start."""
        depth, j = 1, start
        while depth:
            c = text[j]
            if c in "{[(":
                depth += 1
            elif c in "}])":
                depth -= 1
            j += 1
        return j
    
    
    def split_top(body):
        parts, depth, cur = [], 0, ""
        for c in body:
            if c in "{[(":
                depth += 1
            elif c in "}])":
                depth -= 1
            if c == "," and depth == 0:
                parts.append(cur.strip())
                cur = ""
            else:
                cur += c
        if cur.strip():
            parts.append(cur.strip())
        return parts
    
    
    def fields(body):
        """A struct literal's top-level fields as (name, value), a spread as
        ("..", base), a shorthand field as (name, name)."""
        out = []
        for p in split_top(body):
            if p.startswith(".."):
                out.append(("..", " ".join(p[2:].split())))
            elif re.match(r"[a-z_]+: ", p):
                name, value = p.split(": ", 1)
                out.append((name, " ".join(value.split())))
            else:
                out.append((p, p))
        return out
    
    
    def literals(text, name):
        out = []
        for m in re.finditer(r"\b%s \{" % name, text):
            j = closing(text, m.end())
            out.append((m.start(), fields(text[m.end():j - 1])))
        return out
    
    
    TEXTS = ("title_text", "axis_title_text", "axis_label_text", "legend_text")
    builders = [n for n in order if re.search(r"\bNewText(::default\(\)| \{)", "\n".join(fns[n]))]
    print("functions building a text: %s" % " ".join(builders))
    # Every chart and labels literal outside the text sample gives no text.
    others_ok, n_full, n_spread, n_labels = True, 0, 0, 0
    for name in order:
        if name == "chart_text_sample":
            continue
        text = "\n".join(fns[name])
        for _, fl in literals(text, "NewChart"):
            d = dict(fl)
            if ".." in d:
                n_spread += 1
                others_ok = others_ok and not any(f in d for f in TEXTS)
                continue
            n_full += 1
            others_ok = others_ok and all(d.get(f) == "None" for f in TEXTS)
        for _, fl in literals(text, "NewLabels"):
            d = dict(fl)
            n_labels += 1
            others_ok = others_ok and (d.get("text") == "None" or (".." in d and "text" not in d))
    print("every other chart and labels literal: no text: %s (%d full, %d spread, %d labels)"
          % (yes(others_ok and n_full > 0), n_full, n_spread, n_labels))
    body = "\n".join(fns.get("chart_text_sample", []))
    sm = re.search(r"let sized = \|size: u16\| NewText \{", body)
    sized = fields(body[sm.end():closing(body, sm.end()) - 1]) if sm else []
    sized_ok = sized == [("size", "Some(size)"), ("..", "NewText::default()")]
    print("the size closure gives the size alone: %s" % yes(sized_ok))
    lm = re.search(r"let value_labels = \|text: NewText<'static>\| NewLabels \{", body)
    labels = dict(fields(body[lm.end():closing(body, lm.end()) - 1])) if lm else {}
    labels_ok = labels == {"value": "true", "category": "false", "series_name": "false", "percent": "false",
                           "position": "None", "number_format": "None", "text": "Some(text)"}
    print("the labels closure gives value labels, no position, no format and the text given: %s" % yes(labels_ok))
    
    
    def text_of(expr):
        """A NewText expression's fields, or None for a form not read."""
        expr = " ".join(expr.split())
        if expr == "NewText::default()":
            return {}
        m = re.fullmatch(r"sized\(([0-9_]+)\)", expr)
        if m:
            return {"size": int(m.group(1).replace("_", ""))}
        m = re.fullmatch(r"NewText \{(.*)\}", expr)
        if not m:
            return None
        fl = fields(m.group(1))
        if not fl or fl[-1][0] != "..":
            return None
        base = text_of(fl[-1][1])
        if base is None:
            return None
        out = dict(base)
        for name, value in fl[:-1]:
            if name in ("bold", "italic") and value in ("true", "false"):
                out[name] = value == "true"
            elif name == "color" and re.fullmatch(r"Some\(0x[0-9A-Fa-f_]+\)", value):
                out[name] = int(value[5:-1].replace("_", ""), 16)
            elif name == "font" and re.fullmatch(r'Some\("[^"\\]*"\)', value):
                out[name] = value[6:-2]
            else:
                return None
        return out
    
    
    def show(t):
        if t is None:
            return "unread"
        parts = []
        for k in ("size", "bold", "italic", "color", "font"):
            if k in t:
                v = t[k]
                parts.append("%s=%s" % (k, "%06X" % v if k == "color" else v))
        return ",".join(parts) or "default"
    
    
    def text_ok(t):
        if t is None:
            return False
        if "size" in t and not 100 <= t["size"] <= 40000:
            return False
        if "color" in t and t["color"] > 0xFFFFFF:
            return False
        if "font" in t:
            f = t["font"]
            b = f.encode("utf-8")
            if not 1 <= len(b) <= 31 or any(c < "\x20" or c in "\ufffe\uffff" for c in f):
                return False
        return True
    
    
    def series_texts(name):
        """The labels' texts of the series array `name`, in order."""
        m = re.search(r"let %s = \[" % re.escape(name), body)
        if not m:
            return None
        arr = body[m.end():closing(body, m.end()) - 1]
        out = []
        for item in split_top(arr):
            im = re.fullmatch(r"NewSeries \{(.*)\}", " ".join(item.split()), re.S)
            if not im:
                out.append(("plain", None))
                continue
            d = dict(fields(im.group(1)))
            lab = d.get("labels")
            if lab is None:
                out.append(("plain", None))
                continue
            vm = re.fullmatch(r"Some\(value_labels\((.*)\)\)", lab)
            out.append(("labels", text_of(vm.group(1)) if vm else None))
