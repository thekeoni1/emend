        ("other", "        background: Some(Color::Indexed(64)),\n        gradient: None,\n",
         "        background: Some(Color::Indexed(64)),\n        gradient: sample_gradients()[0].gradient.clone(),\n",
         "sample_fill taking a gradient"),
    ]
    for name, old, new, what in PLANTS:
        if name == "order":
            # The first stop's position made 1.0, the second's 0.0: out of order.
            assert src.count(old) == 1 and src.count(POS1) == 1, name
            text = src.replace(old, "                position: 1.0,\n").replace(POS1, POS1.replace("1.0", "0.0"))
            what = "the stops' positions 1 then 0"
        else:
            assert src.count(old) == 1, name
            text = src.replace(old, new)
        assert text != src, name
        open("%s/c-grad-%s.rs" % (out, name), "w").write(text)
        print("c-grad-%s.rs: %s" % (name, what))
    PY
