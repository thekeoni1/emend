    echo "  the messages the refusing tests hold: $FIELD_NAME \"$FIELD_MSG\"; STYLE_UNREADABLE \"$STYLE_UNREAD_MSG\"; NEEDS_COLLECTION \"$COLLECTION_MSG\""
    check "$COVER_GRAD_CHILD is at the phase commit, once, and its body holds $FIELD_NAME's message as a string literal: the one-child rule (change ND55)" "$(yn [ "$(yn covered_once "$COVER_GRAD_CHILD" "$B/gradient-tests.rs")$(yn body_holds "$COVER_GRAD_CHILD" "$B/gradient-tests.rs" "\"$FIELD_MSG\"")" = yesyes ])"
    check "$COVER_GRAD_RANGE is at the phase commit, once, and its body holds $FIELD_NAME's message: each range, the stop count, the order and a stop's tint (change ND55)" "$(yn [ "$(yn covered_once "$COVER_GRAD_RANGE" "$B/gradient-tests.rs")$(yn body_holds "$COVER_GRAD_RANGE" "$B/gradient-tests.rs" "\"$FIELD_MSG\"")" = yesyes ])"
    check "$COVER_GRAD_ORDER is at the phase commit, once, and its body holds the collection message, NEEDS_COLLECTION's: the gradient checked after the cell format's own children (ruling E; change ND55)" "$(yn [ "$(yn covered_once "$COVER_GRAD_ORDER" "$B/gradient-tests.rs")$(yn body_holds "$COVER_GRAD_ORDER" "$B/gradient-tests.rs" "\"$COLLECTION_MSG\"")" = yesyes ])"
    check "$COVER_GRAD_UNREAD is at the phase commit, once, and its body holds STYLE_UNREADABLE's message (change ND55)" "$(yn [ "$(yn covered_once "$COVER_GRAD_UNREAD" "$B/gradient-tests.rs")$(yn body_holds "$COVER_GRAD_UNREAD" "$B/gradient-tests.rs" "\"$STYLE_UNREAD_MSG\"")" = yesyes ])"
    check "control: body_holds says no for STYLE_UNREADABLE's message in $COVER_GRAD_RANGE's body (change ND55)" "$(ynnot body_holds "$COVER_GRAD_RANGE" "$B/gradient-tests.rs" "\"$STYLE_UNREAD_MSG\"")"
    check "control: the same count finds no gradient test of a planted name (change ND55)" "$(ynnot covered_once a_planted_gradient_test "$B/gradient-tests.rs")"
    for name in $GRAD_FORMS; do
      check "the form test ${!name} is at the phase commit, once (change ND55)" "$(yn covered_once "${!name}" "$B/gradient-tests.rs")"
    done
    for name in $GRAD_TOOL; do
      check "the gradient tool test ${!name} is at the phase commit, once, and runs the gradient sample (change ND55)" "$(yn [ "$(yn covered_once "${!name}" "$B/null_rewrite.rs")$(yn body_holds "${!name}" "$B/null_rewrite.rs" "\"--gradient-sample\"")" = yesyes ])"
    done
    check "control: body_holds says no for the gradient sample in $COVER_EDIT_LINE's body (change ND55)" "$(ynnot body_holds "$COVER_EDIT_LINE" "$B/null_rewrite.rs" "\"--gradient-sample\"")"
    # Change ND55: the gradient sample cannot give the writer a gradient out of
    # its range: the phase commit's tools/emend-copy/src/main.rs read by a
    # program that splits it into its top-level functions, as reach.py does:
    # the functions naming Gradient, GradientKind or Stop are
    # sample_gradients alone; its two fills (a linear gradient at 90 degrees, a
    # path gradient from the centre) take Pattern::None and no pattern colour,
    # two stops each at 0 and 1 in Rgb colours with no tint, every number in
    # the writer's range; the functions calling sample_gradients are
    # gradient_sample alone, giving each fill alone to add_style over no base;
    # every other Fill literal of the tool takes gradient: None. Each check
    # has a planted copy it refuses. What the binary CAN give the writer is a
    # gradient read from an input (ruling D: the typed read takes any finite
    # number and any stop count), written back by the round-trip and the named
    # styles samples: N18 and N19 below show it.
    cat >"$B/reach8.py" <<'PY'
    """The gradient sample's constants (change ND55): the phase commit's
    tools/emend-copy/src/main.rs split into its top-level functions, as
    reach.py splits it. The functions naming Gradient, GradientKind or Stop
    are sample_gradients alone; its two fills are a linear gradient and a path
    gradient, each through the one fill closure (pattern None, no pattern
    colour, the gradient given) and the one stops closure (two stops, their
    positions non-decreasing, each colour Rgb, no tint); every number is in the
    writer's range (a degree finite in 0 to 360, a path side and a position
    finite in 0 to 1); the functions calling sample_gradients are
    gradient_sample alone, which gives each fill alone to add_style over no
    base; every other Fill literal of the tool takes gradient: None. Usage:
    reach8.py <main.rs>."""
    import re
    import sys
    
    src = open(sys.argv[1]).read()
    FN = re.compile(r"^(?:pub(?:\([a-z]+\))? )?fn ([a-z_0-9]+)[<(]", re.M)
    fns = {}
    for m in FN.finditer(src):
        end = src.find("\n}\n", m.start())
        assert end > 0, m.group(1)
        fns.setdefault(m.group(1), []).append(src[m.start():end + 3])
    
    
    def body(name):
        assert len(fns.get(name, [])) == 1, name
        return fns[name][0]
    
    
    GRAD = re.compile(r"\bGradient \{|\bGradientKind::|\bStop \{")
    building = sorted(n for n, bs in fns.items() for b in bs if GRAD.search(b))
    print("functions naming Gradient, GradientKind or Stop: " + " ".join(building))
    g = body("sample_gradients")
    NUM = r"(-?[0-9]+(?:\.[0-9]+)?)"
    
    
    def nums(name):
        return [float(x) for x in re.findall(r"\b" + name + r": " + NUM + r"\b", g)]
    
    
    degrees = nums("degree")
    sides = [nums(s) for s in ("left", "right", "top", "bottom")]
    positions = nums("position")
    linear = len(re.findall(r"GradientKind::Linear \{", g))
    path = len(re.findall(r"GradientKind::Path \{", g))
    stop_lits = len(re.findall(r"\bStop \{", g))
    fill_calls = len(re.findall(r"^\s+fill\(\n", g, re.M))
    stops_calls = len(re.findall(r"\bstops\(0x", g))
    in_range = (all(0.0 <= d <= 360.0 for d in degrees) and all(0.0 <= v <= 1.0 for s in sides for v in s)
                and all(0.0 <= p <= 1.0 for p in positions))
    ordered = all(a <= b for a, b in zip(positions, positions[1:]))
    shape = (linear == 1 and path == 1 and len(degrees) == 1 and all(len(s) == 1 for s in sides)
             and stop_lits == 2 and len(positions) == 2 and fill_calls == 2 and stops_calls == 2)
    print("the gradients' numbers: degree %s; path %s; positions %s; two fills, each of the two stops: %s, in range: %s, "
          "non-decreasing: %s" % (" ".join("%g" % d for d in degrees), " ".join("%g" % v for s in sides for v in s),
                                  " ".join("%g" % p for p in positions), "yes" if shape else "no",
                                  "yes" if in_range else "no", "yes" if ordered else "no"))
    one_child = (len(re.findall(r"\| Fill \{", g)) == 1 and "pattern: Pattern::None," in g
                 and "foreground: None," in g and "background: None," in g
                 and "gradient: Some(Gradient { kind, stops })," in g
                 and not re.search(r"Pattern::(?!None)", g))
    print("the gradient fills take Pattern::None and no pattern colour: %s" % ("yes" if one_child else "no"))
    colours = re.findall(r"color: (Color::[A-Za-z]+)", g)
    print("the stops' colours: %s, no tint: %s" % (" ".join(colours) or "none",
                                                   "yes" if colours and all(c == "Color::Rgb" for c in colours)
                                                   and "tint" not in g else "no"))
    callers = sorted(n for n, bs in fns.items() for b in bs if n != "sample_gradients" and "sample_gradients()" in b)
    print("functions calling sample_gradients: " + " ".join(callers))
    s = body("gradient_sample")
    alone = ("fill: Some(fill.clone()),\n            ..Style::default()" in s
             and len(re.findall(r"\.add_style\(", s)) == 1 and "package.add_style(None, &style)?" in s)
    print("gradient_sample gives each fill alone to add_style over no base: %s" % ("yes" if alone else "no"))
    # Every other Fill literal: `Fill {` not after `-> ` (a return type) and not
    # the closure's, its braces matched, holding `gradient: None`.
    others, bad = 0, 0
    for m in re.finditer(r"(?<!-> )(?<![A-Za-z_])Fill \{", src):
        if src[max(0, m.start() - 2):m.start()] == "| ":
            continue
        i, depth = m.end() - 1, 0
        for j in range(i, len(src)):
            if src[j] == "{":
                depth += 1
            elif src[j] == "}":
                depth -= 1
                if depth == 0:
                    break
        lit = src[i:j + 1]
        others += 1
        if "gradient: None" not in lit or "gradient: Some" in lit:
            bad += 1
    print("every other Fill literal of the tool takes gradient: None: %s (%d)" % ("yes" if bad == 0 else "no", others))
    PY
    python3 -I -B "$B/reach8.py" "$B/main.rs" >"$B/grad.out" 2>&1
    echo "command: python3 -I -B <scratch>/w/reach8.py <scratch>/w/main.rs (tools/emend-copy/src/main.rs, git show <phase commit>; change ND55)"
    sed 's/^/    /' "$B/reach8.py"
    sed 's/^/    /' "$B/grad.out"
    TG_BUILD="functions naming Gradient, GradientKind or Stop: sample_gradients"
