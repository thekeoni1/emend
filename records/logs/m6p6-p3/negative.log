    rm_ = re.search(r'let rows = "((?:[^"\\]|\\.)*)";', nbody, re.S)
    assert rm_, "the named style test's rows"
    nrows = rust(rm_.group(1))
    assert nrows == grows, "the named style test's rows are the gradient test's"
    fn = test.index("fn the_namedstyle_sample_refuses_a_part_without_cell_styles_and_leaves_nothing()")
