    plant("c-edit-title.rs", "Some(\"emend edited\")", "Some(\"\")")
    plant("c-edit-kept.rs", "added.set_chart_title(&part, 0,", "added.set_chart_title(&part, 1,")
    plant("c-edit-ref.rs", "        values: Some(&c),\n    };", "        values: Some(\"\"),\n    };")
    plant("c-edit-bound.rs", "    let last = bounded_last_row(sampled.max_row);\n", "    let last = sampled.max_row;\n")
    plant("c-edit-style.rs", "        style: None,\n", "        style: Some(49),\n", whole=True)
