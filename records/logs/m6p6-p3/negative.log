    # its plots are a standard line, a pie and a lineMarker scatter, markers and
    # lines on the line and the scatter, the exploded point on the pie and the
    # point's marker on the line; its colours are at most 0xFFFFFF; it combines
    # no plot. Each check has a planted copy it refuses.
    cat >"$B/reach3.py" <<'PY'
    import re
    import sys
    
    main = open(sys.argv[1]).read()
    lines = main.split("\n")
    fns = {}
    order = []
    cur = None
    for line in lines:
        m = re.match(r"(pub(\(crate\))? )?fn ([a-z0-9_]+)", line)
        if m and cur is None:
            cur = (m.group(3), [])
        if cur is not None:
            cur[1].append(line)
            if line == "}":
                fns[cur[0]] = cur[1]
                order.append(cur[0])
                cur = None
    
    
    def yes(ok):
        return "yes" if ok else "no"
    
    
    builders = [n for n in order if re.search(r"\b(NewMarker|NewLine|NewPoint) \{", "\n".join(fns[n]))]
    print("functions building a marker, a line or a point: %s" % " ".join(builders))
    body = "\n".join(fns.get("chart_format_sample", []))
    sizes = re.findall(r"\bsize: Some\(([0-9]+)\)", body)
    print("marker sizes: %s; each 2 to 72: %s" % (" ".join(sizes), yes(sizes and all(2 <= int(s) <= 72 for s in sizes))))
    widths = re.findall(r"\bwidth: Some\(([0-9]+)\)", body)
    print("line widths: %s; each at most 20116800: %s"
          % (" ".join(widths), yes(widths and all(int(w) <= 20116800 for w in widths))))
    markers = re.findall(r"NewMarker \{\s*symbol: MarkerSymbol::([A-Za-z]+),\s*size: ([^,\n]+),\s*color: ([^,\n]+),\s*\}", body)
    nones = [m for m in markers if m[0] == "None"]
    print("markers: %s; the none marker takes no size and no colour: %s"
          % (" ".join("/".join(m) for m in markers),
             yes(nones and all(s == "None" and c == "None" for _, s, c in nones)
                 and len(markers) == body.count("NewMarker {"))))
    lns = re.findall(r"NewLine \{\s*width: ([^,\n]+),\s*dash: ([^,\n]+),\s*\}", body)
    print("lines: %s; each with a width or a dash: %s"
          % (" ".join("/".join(m) for m in lns),
             yes(lns and len(lns) == body.count("NewLine {") and all(w != "None" or d != "None" for w, d in lns))))
    
    
    def arrays():
        found = {}
        for m in re.finditer(r"let ([a-z_]+) = \[", body):
            end = body.index("];", m.end())
            found[m.group(1)] = body[m.end():end]
        return found
    
    
    ARR = arrays()
    POINT = re.compile(r"NewPoint \{\s*index: ([0-9]+),\s*color: ([^\n]+?),\s*explosion: ([^\n]+?),\s*"
                       r"marker: (None|Some\(NewMarker \{[^}]*\}\)),\s*\}")
    point_sets = []
    ok_points = True
    nparsed = 0
    for name, text in ARR.items():
        pts = POINT.findall(text)
        if not pts:
            continue
        nparsed += len(pts)
        shown = []
        for index, color, explosion, marker in pts:
            shown.append("%s:%s:%s:%s" % (index, "colour" if color != "None" else "-",
                                          re.sub(r"^Some\(([0-9]+)\)$", r"\1", explosion) if explosion != "None" else "-",
                                          "marker" if marker != "None" else "-"))
            ok_points = ok_points and (color != "None" or explosion != "None" or marker != "None")
        idx = [p[0] for p in pts]
        ok_points = ok_points and len(set(idx)) == len(idx)
        point_sets.append("%s %s" % (name, " ".join(shown)))
    ok_points = ok_points and nparsed == body.count("NewPoint {") and nparsed > 0
    print("points: %s; each with a field, its indexes distinct: %s" % ("; ".join(point_sets), yes(ok_points)))
    plots = re.findall(r"\(\s*NewPlot::([A-Za-z0-9]+)((?: \{[^}]*\})?),\s*&([a-z_]+),?\s*\)", body)
    print("plots: %s" % " ".join("%s%s=%s" % (k, re.sub(r"[\s,]", "", o), s) for k, o, s in plots))
    kinds = {s: k for k, _, s in plots}
    opts = []
    # Change ND48: the core commit's field line high_low_lines: plot ==
    # NewPlot::Stock, once in the sample, names no plot.
    stock_field = body.count("high_low_lines: plot == NewPlot::Stock,")
    ok_kinds = bool(plots) and stock_field == 1 and body.count("NewPlot::") - stock_field == len(plots)
    MARKER_KINDS = {"Line", "Scatter"}
    LINE_KINDS = {"Line", "Line3D", "Scatter", "Radar", "Stock"}
    ROUND = {"Pie", "Pie3D", "Doughnut", "OfPie"}
    for _, _, s in plots:
        text = ARR.get(s, "")
        nm = text.count("marker: Some(NewMarker")
        nl = text.count("line: Some(NewLine")
        ref = re.findall(r"points: &([a-z_]+)", text)
        opts.append("%s markers %d lines %d points %s" % (s, nm, nl, " ".join(ref) or "-"))
        kind = kinds[s]
        if nm and kind not in MARKER_KINDS:
            ok_kinds = False
        if nl and kind not in LINE_KINDS:
            ok_kinds = False
        for r in ref:
            pts = POINT.findall(ARR.get(r, ""))
            if any(e != "None" for _, _, e, _ in pts) and kind not in ROUND:
                ok_kinds = False
            if any(mk != "None" for _, _, _, mk in pts) and kind not in MARKER_KINDS:
                ok_kinds = False
    print("series options: %s" % "; ".join(opts))
    print("by kind: markers on a line or a scatter, lines on a line-drawing kind, an explosion on a round kind, a point's marker where the series takes one: %s"
          % yes(ok_kinds))
    colours = re.findall(r"color: Some\((0x[0-9A-Fa-f_]+)\)", body)
    print("colours: %s; each at most 0xFFFFFF: %s"
          % (" ".join(colours), yes(colours and all(int(c.replace("_", ""), 16) <= 0xFFFFFF for c in colours))))
    print("combined plots: none: %s" % yes(body.count("combined: None,") == 1 and "combined: Some" not in body))
    PY
    python3 -I -B "$B/reach3.py" "$B/main.rs" >"$B/fmt.out" 2>&1
    echo "command: python3 -I -B <scratch>/w/reach3.py <scratch>/w/main.rs (tools/emend-copy/src/main.rs, git show <phase commit>; change ND45)"
    sed 's/^/    /' "$B/reach3.py"
    sed 's/^/    /' "$B/fmt.out"
    FMT_BUILD="functions building a marker, a line or a point: chart_format_sample"
    FMT_SIZES="marker sizes: 7 5; each 2 to 72: yes"
    FMT_WIDTHS="line widths: 28575 12700; each at most 20116800: yes"
    FMT_MARKERS="markers: Square/None/None Circle/Some(7)/Some(0x1F_77B4) None/None/None Diamond/Some(5)/None; the none marker takes no size and no colour: yes"
    FMT_LINES="lines: Some(28575)/Some(DashStyle::Dash) None/Some(DashStyle::SystemDot) Some(12700)/Some(DashStyle::LargeDash); each with a width or a dash: yes"
    FMT_POINTS="points: line_point 1:colour:-:marker; pie_points 0:-:10:- 1:colour:-:-; each with a field, its indexes distinct: yes"
    FMT_PLOTS="plots: Line{grouping:Grouping::Standard}=line_series Pie=pie_series Scatter{style:ScatterStyle::LineMarker}=scatter_series"
    FMT_KINDS="by kind: markers on a line or a scatter, lines on a line-drawing kind, an explosion on a round kind, a point's marker where the series takes one: yes"
    FMT_COLOURS="colours: 0xD6_2728 0x1F_77B4 0x2C_A02C; each at most 0xFFFFFF: yes"
    FMT_COMBINED="combined plots: none: yes"
    check "the functions of the tool building a marker, a line or a point are chart_format_sample alone (change ND45)" "$(yn reach_has "$FMT_BUILD" "$B/fmt.out")"
    check "chart_format_sample's marker sizes, 7 and 5, are each 2 to 72: no size out of its range reaches Package::add_chart (change ND45)" "$(yn reach_has "$FMT_SIZES" "$B/fmt.out")"
    check "chart_format_sample's line widths, 28575 and 12700, are each at most 20116800: no width out of its range reaches Package::add_chart (change ND45)" "$(yn reach_has "$FMT_WIDTHS" "$B/fmt.out")"
    check "chart_format_sample's four markers, square, circle, none and diamond, the none marker with no size and no colour (change ND45)" "$(yn reach_has "$FMT_MARKERS" "$B/fmt.out")"
    check "chart_format_sample's three lines each take a width or a dash (change ND45)" "$(yn reach_has "$FMT_LINES" "$B/fmt.out")"
    check "chart_format_sample's points each take a field beside the index, the indexes of each list distinct (change ND45)" "$(yn reach_has "$FMT_POINTS" "$B/fmt.out")"
    check "chart_format_sample's plots are a standard line, a pie and a lineMarker scatter, over their own series (change ND45)" "$(yn reach_has "$FMT_PLOTS" "$B/fmt.out")"
    check "chart_format_sample's markers and lines go to the line and the scatter, the explosion to the pie's point and the point's marker to the line's, each a kind that takes it (change ND45)" "$(yn reach_has "$FMT_KINDS" "$B/fmt.out")"
    check "chart_format_sample's colours are each at most 0xFFFFFF (change ND45)" "$(yn reach_has "$FMT_COLOURS" "$B/fmt.out")"
    check "chart_format_sample combines no plot (change ND45)" "$(yn reach_has "$FMT_COMBINED" "$B/fmt.out")"
    python3 -I -B - "$B/main.rs" "$B" <<'PY' >"$B/fmt-plant.out" 2>&1
    import sys
    main = open(sys.argv[1]).read()
    out = sys.argv[2]
    i = main.index("\nfn chart_format_sample(")
    
    
    def plant(name, a, b, whole=False):
        text = main if whole else main[i:]
        assert text.count(a) >= 1, (name, a)
        new = text.replace(a, b, 1)
        open(out + "/" + name, "w").write(new if whole else main[:i] + new)
        print("planted %s" % name)
    
    
    plant("c-fmt-build.rs", "\nfn first_worksheet<", "\nfn planted_line() -> NewLine {\n    NewLine {\n        width: Some(1),\n        dash: None,\n    }\n}\n\nfn first_worksheet<", whole=True)
    plant("c-fmt-size.rs", "size: Some(7),", "size: Some(1),")
    plant("c-fmt-width.rs", "width: Some(28575),", "width: Some(20116801),")
    plant("c-fmt-none.rs", "MarkerSymbol::None,\n                size: None,", "MarkerSymbol::None,\n                size: Some(7),")
    plant("c-fmt-line.rs", "width: None,\n                dash: Some(DashStyle::SystemDot),", "width: None,\n                dash: None,")
    plant("c-fmt-bare.rs", "color: Some(0x2C_A02C),", "color: None,")
    plant("c-fmt-repeat.rs", "index: 1,\n            color: Some(0x2C_A02C),", "index: 0,\n            color: Some(0x2C_A02C),")
    plant("c-fmt-explode.rs", "explosion: None,", "explosion: Some(5),")
    plant("c-fmt-kind.rs", "(NewPlot::Pie, &pie_series),", "(NewPlot::Pie, &line_series),")
    plant("c-fmt-colour.rs", "color: Some(0x1F_77B4),", "color: Some(0x100_0000),")
    plant("c-fmt-combined.rs", "            combined: None,\n", "            combined: Some(SECOND),\n")
    PY
    echo "command: the same program over eleven planted copies, each changing one thing (change ND45):"
    sed 's/^/    /' "$B/fmt-plant.out"
    for c in build size width none line bare repeat explode kind colour combined; do
      python3 -I -B "$B/reach3.py" "$B/c-fmt-$c.rs" >"$B/c-fmt-$c.out" 2>&1
    done
    check "control: the same check refuses a copy building a line in another function (change ND45)" "$(ynnot reach_has "$FMT_BUILD" "$B/c-fmt-build.out")"
    check "control: the same check refuses a copy whose marker size is 1" "$(ynnot reach_has "$FMT_SIZES" "$B/c-fmt-size.out")"
    check "control: the same check refuses a copy whose line width is 20116801" "$(ynnot reach_has "$FMT_WIDTHS" "$B/c-fmt-width.out")"
    check "control: the same check refuses a copy whose none marker takes a size" "$(ynnot reach_has "$FMT_MARKERS" "$B/c-fmt-none.out")"
    check "control: the same check refuses a copy with a line of neither field" "$(ynnot reach_has "$FMT_LINES" "$B/c-fmt-line.out")"
    check "control: the same check refuses a copy with a point of its index alone" "$(ynnot reach_has "$FMT_POINTS" "$B/c-fmt-bare.out")"
    check "control: the same check refuses a copy with two points of one index" "$(ynnot reach_has "$FMT_POINTS" "$B/c-fmt-repeat.out")"
    check "control: the same check refuses a copy exploding the line's point" "$(ynnot reach_has "$FMT_KINDS" "$B/c-fmt-explode.out")"
    check "control: the same check refuses a copy whose pie takes the line's series, markers and lines on a pie" "$(ynnot reach_has "$FMT_KINDS" "$B/c-fmt-kind.out")"
    check "control: the same check refuses a copy whose marker colour is above 0xFFFFFF" "$(ynnot reach_has "$FMT_COLOURS" "$B/c-fmt-colour.out")"
    check "control: the same check refuses a copy whose charts take a combined plot" "$(ynnot reach_has "$FMT_COMBINED" "$B/c-fmt-combined.out")"
    # Change ND47: this phase's covering crate tests, each once in
    # package/tests/chart_write.rs, the refusing ones' bodies asserting their
    # messages (body_asserts, on the call's line or on a line of its own); the
    # trend tool tests, once each, each running the trend sample.
    COVER_TREND_KINDS=a_trendline_and_error_bars_are_taken_by_the_kinds_that_take_them_and_refused_by_the_others
    COVER_TREND_FORMS=each_trendline_kind_writes_its_type_its_order_or_period_and_its_fields
    COVER_ERROR_FORMS=each_error_value_writes_its_type_and_its_length_or_its_references
    COVER_TWO_SETS=a_scatter_and_a_bubble_take_two_sets_of_error_bars_in_the_order_given
    COVER_TREND_RULES=the_trendline_and_error_bar_field_rules_are_refused
    COVER_TREND_ORDER=the_trendline_and_error_bars_follow_the_check_order
    COVER_TREND_COMBINED=a_combined_second_plot_s_series_take_a_trendline_and_error_bars_by_its_own_kind
    COVER_TREND_LINE=the_chart_trend_sample_adds_a_line_a_scatter_and_a_column_and_reads_them_back
    COVER_TREND_TOOL_FORMS=the_chart_trend_sample_writes_each_trendline_and_error_bar_form
    COVER_TREND_BOUND=the_chart_trend_sample_references_at_most_a_thousand_rows
    TREND_RANGE="COVER_TREND_RULES COVER_TREND_ORDER"
    TREND_OPTION="COVER_TREND_KINDS COVER_TREND_COMBINED"
    TREND_FORMS="COVER_TREND_FORMS COVER_ERROR_FORMS COVER_TWO_SETS"
    TREND_TOOL="COVER_TREND_LINE COVER_TREND_TOOL_FORMS COVER_TREND_BOUND"
    echo "command: count_matches -F 'fn <name>()' for this phase's tests over package/tests/chart_write.rs and tools/emend-copy/tests/null_rewrite.rs at the phase commit (change ND47)"
    for name in $TREND_RANGE $TREND_OPTION $TREND_FORMS; do
      echo "  chart_write::${!name} $(count_matches -F "fn ${!name}()" "$B/write-tests.rs")"
    done
    for name in $TREND_TOOL; do
      echo "  ${!name} $(count_matches -F "fn ${!name}()" "$B/null_rewrite.rs")"
    done
    for name in $TREND_RANGE; do
      check "${!name} is at the phase commit, once, and asserts the range message, RANGE, and the option message, OPTION (change ND47)" "$(yn [ "$(yn covered_once "${!name}" "$B/write-tests.rs")$(yn body_asserts "${!name}" RANGE)$(yn body_asserts "${!name}" OPTION)" = yesyesyes ])"
    done
    check "$COVER_TREND_RULES asserts the text message, TEXT, for a trendline's name and a custom reference (change ND47)" "$(yn body_asserts "$COVER_TREND_RULES" TEXT)"
    for name in $TREND_OPTION; do
      check "${!name} is at the phase commit, once, and asserts the option message, OPTION (change ND47)" "$(yn [ "$(yn covered_once "${!name}" "$B/write-tests.rs")$(yn body_asserts "${!name}" OPTION)" = yesyes ])"
    done
    check "control: body_asserts says no for RANGE against $COVER_TREND_KINDS (change ND47)" "$(ynnot body_asserts "$COVER_TREND_KINDS" RANGE)"
    for name in $TREND_FORMS; do
      check "the form test ${!name} is at the phase commit, once (change ND47)" "$(yn covered_once "${!name}" "$B/write-tests.rs")"
    done
    for name in $TREND_TOOL; do
      check "the trend tool test ${!name} is at the phase commit, once, and runs the trend sample (change ND47)" "$(yn [ "$(yn covered_once "${!name}" "$B/null_rewrite.rs")$(yn body_holds "${!name}" "$B/null_rewrite.rs" "&[\"--chart-trend-sample\"]")" = yesyes ])"
    done
    check "control: body_holds says no for the trend sample in $COVER_FORMAT_LINE's body (change ND47)" "$(ynnot body_holds "$COVER_FORMAT_LINE" "$B/null_rewrite.rs" "&[\"--chart-trend-sample\"]")"
    # Change ND47: CHART_VALUE_RANGE and CHART_OPTION_KIND for this phase's
    # trendline and error bar rules, and CHART_TEXT_INVALID for a trendline's
    # name and a custom reference, raised at the call, are not reachable
    # through emend-copy. The phase commit's tools/emend-copy/src/main.rs read
    # by a program that splits it into its top-level functions, as reach.py
    # does: the functions building a trendline or error bars are
    # chart_trend_sample alone; its trendlines are built from a closure giving
    # no forecast, intercept, equation, R-squared or name; its polynomial's
    # order is 2 to 6 and its moving average's period 2 or more, the moving
    # average with no forecast, intercept, equation or R-squared, no intercept
    # off a linear, exponential or polynomial trendline, every forecast finite
    # and not negative; its trendline name a text a chart takes; its fixed,
    # percentage and standard deviation lengths finite and positive; its
    # custom references two of the sample's bounded column references; its
    # trendlines and error bars on a line, a scatter and a column alone, every
    # set of the scatter's series with a direction, the two of different
    # directions, and none elsewhere; no combined plot. Each check has a
    # planted copy it refuses.
    cat >"$B/reach4.py" <<'PY'
    import re
    import sys
    
    main = open(sys.argv[1]).read()
    lines = main.split("\n")
    fns = {}
    order = []
    cur = None
    for line in lines:
        m = re.match(r"(pub(\(crate\))? )?fn ([a-z0-9_]+)", line)
        if m and cur is None:
            cur = (m.group(3), [])
        if cur is not None:
            cur[1].append(line)
            if line == "}":
                fns[cur[0]] = cur[1]
                order.append(cur[0])
                cur = None
    
    
    def yes(ok):
        return "yes" if ok else "no"
    
    
    builders = [n for n in order if re.search(r"\b(NewTrendline|NewErrorBars) \{", "\n".join(fns[n]))]
    print("functions building a trendline or error bars: %s" % " ".join(builders))
    body = "\n".join(fns.get("chart_trend_sample", []))
    # The closure every trendline is built from: its defaults.
    dm = re.search(r"let trend = \|kind: TrendlineKind\| NewTrendline \{\s*kind,\s*forward: ([^,\n]+),\s*"
                   r"backward: ([^,\n]+),\s*intercept: ([^,\n]+),\s*show_equation: ([^,\n]+),\s*"
                   r"show_r_squared: ([^,\n]+),\s*name: ([^,\n]+),\s*\};", body)
    defaults_ok = bool(dm) and dm.groups() == ("None", "None", "None", "false", "false", "None")
    print("the closure trend gives no forecast, intercept, equation, R-squared or name: %s" % yes(defaults_ok))
    # Each trendline: a literal over the closure, or the closure alone.
    NUM = r"-?[0-9]+(?:\.[0-9]+)?"
    trends = []
    rules_ok = defaults_ok
    for m in re.finditer(r"trendline: Some\((NewTrendline \{(.*?)\.\.trend\(TrendlineKind::([A-Za-z]+)(?:\(([0-9]+)\))?\)\s*\}"
                         r"|trend\(TrendlineKind::([A-Za-z]+)(?:\(([0-9]+)\))?\))\),", body, re.S):
        if m.group(5):
            kind, count, fields = m.group(5), m.group(6), {}
        else:
            kind, count = m.group(3), m.group(4)
            fields = dict(re.findall(r"(forward|backward|intercept|show_equation|show_r_squared|name): ([^\n]+?),\n",
                                     m.group(2)))
        shown = ",".join("%s=%s" % kv for kv in sorted(fields.items())) or "-"
        trends.append("%s%s %s" % (kind, "(%s)" % count if count else "", shown))
        if kind == "Polynomial":
            rules_ok = rules_ok and count is not None and 2 <= int(count) <= 6
        elif kind == "MovingAverage":
            rules_ok = rules_ok and count is not None and int(count) >= 2
            rules_ok = rules_ok and not any(k in fields for k in ("forward", "backward", "intercept"))
            rules_ok = rules_ok and all(fields.get(k, "false") == "false" for k in ("show_equation", "show_r_squared"))
        else:
            rules_ok = rules_ok and count is None
        if "intercept" in fields:
            rules_ok = rules_ok and kind in ("Linear", "Exponential", "Polynomial")
            im = re.fullmatch(r"Some\((%s)\)" % NUM, fields["intercept"])
            rules_ok = rules_ok and bool(im)
        for k in ("forward", "backward"):
            if k in fields:
                fm = re.fullmatch(r"Some\((%s)\)" % NUM, fields[k])
                rules_ok = rules_ok and bool(fm) and float(fm.group(1)) >= 0.0
    nsites = body.count("trendline: Some(")
    rules_ok = rules_ok and len(trends) == nsites and nsites > 0
    print("trendlines: %s" % "; ".join(trends))
    print("the trendline rules: orders 2 to 6, periods 2 or more, a moving average with no forecast, intercept, "
          "equation or R-squared, an intercept on a linear, exponential or polynomial trendline alone, forecasts "
          "finite and not negative: %s" % yes(rules_ok))
    names = re.findall(r'name: Some\("([^"]*)"\)', body)
    names_ok = bool(names) and all(n and not any(ord(ch) < 0x20 for ch in n) and len(n) <= 32767 for n in names)
    print("trendline names: %s; each a text a chart takes: %s" % (" ".join(names), yes(names_ok)))
    values = re.findall(r"ErrorValue::([A-Za-z]+)(?:\(([^)]*)\))?", body)
    lengths_ok = bool(values)
    for kind, arg in values:
        if kind in ("Fixed", "Percentage", "StandardDeviation"):
            lengths_ok = lengths_ok and bool(re.fullmatch(NUM, arg)) and float(arg) > 0.0
        elif kind not in ("StandardError", "Custom"):
            lengths_ok = False
        elif arg:
            lengths_ok = False
    print("error values: %s; the lengths finite and positive: %s"
          % (" ".join("%s(%s)" % (k, a) if a else k for k, a in values), yes(lengths_ok)))
    cols = re.search(r"let \(a, b, c, d\) = \(column\('A'\), column\('B'\), column\('C'\), column\('D'\)\);", body)
    customs = re.findall(r"ErrorValue::Custom \{\s*plus: &([a-z_]+),\s*minus: &([a-z_]+),\s*\}", body)
    custom_ok = bool(cols) and bool(customs) and all(p in "abcd" and q in "abcd" for p, q in customs) \
        and len(customs) == body.count("ErrorValue::Custom")
    print("custom references: %s; each a column reference the sample bounds: %s"
          % (" ".join("plus=%s,minus=%s" % c for c in customs), yes(custom_ok)))
    
    
    def arrays():
        found = {}
        for m in re.finditer(r"let ([a-z_]+) = \[", body):
            depth, j = 1, m.end()
            while depth:
                if body[j] == "[":
                    depth += 1
                elif body[j] == "]":
                    depth -= 1
                j += 1
            found[m.group(1)] = body[m.end():j - 1]
        return found
    
    
    ARR = arrays()
    sets = {}
    for name, text in ARR.items():
        dirs = re.findall(r"bars\(\s*(None|Some\(ErrorDirection::([XY])\))", text)
        if dirs:
            sets[name] = [d[1] or "None" for d in dirs]
    print("error bar sets: %s" % "; ".join("%s %s" % (n, " ".join(d)) for n, d in sorted(sets.items())))
    plots = re.findall(r"\(\s*NewPlot::([A-Za-z0-9]+)((?: \{[^}]*\})?),\s*&([a-z_]+),?\s*\)", body)
    print("plots: %s" % " ".join("%s%s=%s" % (k, re.sub(r"\s", "", o).replace(",}", "}"), s) for k, o, s in plots))
    TAKES = {"Bar", "Line", "Scatter", "Area", "Bubble"}
    XY = {"Scatter", "Bubble"}
    # Change ND48: the core commit's field line high_low_lines: plot ==
