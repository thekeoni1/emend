    echo "  the messages the refusing tests hold: $NAME_NAME \"$NAME_MSG\"; STYLE_OUT_OF_RANGE \"$INDEX_MSG\"; NEEDS_COLLECTION \"$COLLECTION_MSG\"; $FIELD_NAME \"$FIELD_MSG\"; DXF_FIELD \"$DXF_FIELD_MSG\"; $TWO_NAME \"$TWO_MSG\""
    holds_once() { covered_once "$1" "$2" && body_holds "$1" "$2" "\"$3\""; }
    check "$COVER_NS_NAME is at the phase commit, once, and its body holds $NAME_NAME's message: an empty name, 256 characters, a character XML cannot carry (ruling S; change ND56)" "$(yn holds_once "$COVER_NS_NAME" "$B/named-style-tests.rs" "$NAME_MSG")"
    check "$COVER_NS_DUP is at the phase commit, once, and its body holds $NAME_NAME's message: a name equal ignoring ASCII case to one the part holds or one recorded (decision 4 A; change ND56)" "$(yn holds_once "$COVER_NS_DUP" "$B/named-style-tests.rs" "$NAME_MSG")"
    check "$COVER_NS_COLL is at the phase commit, once, and its body holds the collection message and $NAME_NAME's: the name before the containers (ruling T; change ND56)" "$(yn [ "$(yn holds_once "$COVER_NS_COLL" "$B/named-style-tests.rs" "$COLLECTION_MSG")$(yn body_holds "$COVER_NS_COLL" "$B/named-style-tests.rs" "\"$NAME_MSG\"")" = yesyes ])"
    check "$COVER_NS_PAST is at the phase commit, once, and its body holds the index message: a named index past the count and those recorded (ruling U; change ND56)" "$(yn holds_once "$COVER_NS_PAST" "$B/named-style-tests.rs" "$INDEX_MSG")"
    check "$COVER_NS_NAMED is at the phase commit, once, and its body holds $FIELD_NAME's message: named on a named style (change ND56)" "$(yn holds_once "$COVER_NS_NAMED" "$B/named-style-tests.rs" "$FIELD_MSG")"
    check "$COVER_NS_ORDER is at the phase commit, once, and its body holds the index message and $FIELD_NAME's: the index after protection and before the gradient (ruling U; change ND56)" "$(yn [ "$(yn holds_once "$COVER_NS_ORDER" "$B/named-style-tests.rs" "$INDEX_MSG")$(yn body_holds "$COVER_NS_ORDER" "$B/named-style-tests.rs" "\"$FIELD_MSG\"")" = yesyes ])"
    check "$COVER_NS_DXF is at the phase commit, once, and its body holds DXF_FIELD's message: named on a differential style (ruling AB; change ND56)" "$(yn holds_once "$COVER_NS_DXF" "$B/named-style-tests.rs" "$DXF_FIELD_MSG")"
    for name in $NS_FORMS; do
