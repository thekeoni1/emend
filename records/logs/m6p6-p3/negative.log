command: python3 -I -B <scratch>/w/reach2.py <scratch>/w/main.rs (tools/emend-copy/src/main.rs, git show <phase commit>; change ND44)
    import re
    import sys
    
    main = open(sys.argv[1]).read()
    lines = main.split("\n")
    fns = {}
    order = []
    cur = None
    for line in lines:
        m = re.match(r"(pub(\(crate\))? )?fn ([a-z0-9_]+)", line)
        if m and cur is None:
            cur = (m.group(3), [])
        if cur is not None:
            cur[1].append(line)
            if line == "}":
                fns[cur[0]] = cur[1]
                order.append(cur[0])
                cur = None
    splits = re.findall(r"OfPieSplit::([A-Za-z]+)(\([^)]*\))?", main)
    print("OfPieSplit forms named in the tool: %s" % " ".join(a + b for a, b in splits))
    builders = [n for n in order if re.search(r"NewPlot::(Surface|Surface3D|OfPie) \{\s*(wireframe|kind)", "\n".join(fns[n]))]
    print("functions building a surface or an of-pie plot: %s" % " ".join(builders))
    body = "\n".join(fns.get("chart_surface_sample", []))
    literals = body.count("NewSeries {")
    spreads = body.count("..over_b")
    ok_series = (literals == 3 and spreads == 2
                 and body.count("let over_b = NewSeries {") == 1
                 and body.count("color: None,") == 1 and body.count("labels: None,") == 1
                 and not re.search(r"\b(color|labels): Some", body))
    print("chart_surface_sample's series: one literal with no colour and no labels, two copies of it: %s"
          % ("yes" if ok_series else "no"))
    ok_chart = (body.count("combined: None,") == 1 and "combined: Some" not in body
                and body.count("category_axis_format: None,") == 1 and body.count("value_axis_format: None,") == 1
                and body.count('category_axis_title: surface.then_some("emend x"),') == 1
                and body.count('value_axis_title: surface.then_some("emend y"),') == 1
                and len(re.findall(r"axis_(title|format):", body)) == 4)
    print("chart_surface_sample's charts: no combined plot, no axis format, the axis titles on the surfaces alone: %s"
          % ("yes" if ok_chart else "no"))
    pies = re.findall(r"NewPlot::OfPie \{\s*kind: OfPieKind::(Pie|Bar),\s*split: ([^\n]*),\s*\},\s*&([a-z]+),", body)
    ok_pies = (body.count("let one = [over_b];") == 1 and len(pies) == 2
               and all(series == "one" for _, _, series in pies) and body.count("NewPlot::OfPie {") == 2)
    print("chart_surface_sample's of-pies: %s; each on the one series: %s"
          % (" ".join("%s,%s" % (k, s) for k, s, _ in pies), "yes" if ok_pies else "no"))
