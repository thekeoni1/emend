    SIZE_LAST='size log checks all as expected: yes'
    echo "command: sha256sum <the size log>: $(sha256sum <"$SIZE_LOG" 2>/dev/null | cut -d' ' -f1); tail -n 1 <the size log>: $(tail -n 1 "$SIZE_LOG" 2>/dev/null)"
    size_log_passed() { [ -s "$1" ] && [ "$(tail -n 1 "$1")" = "$SIZE_LAST" ]; }
