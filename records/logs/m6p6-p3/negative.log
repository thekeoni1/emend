    import re
    import sys
    
    main = open(sys.argv[1]).read()
    lines = main.split("\n")
    fns = {}
    order = []
    cur = None
    for line in lines:
        m = re.match(r"(pub(\(crate\))? )?fn ([a-z0-9_]+)", line)
        if m and cur is None:
            cur = (m.group(3), [])
        if cur is not None:
            cur[1].append(line)
            if line == "}":
                fns[cur[0]] = cur[1]
                order.append(cur[0])
                cur = None
    
    
    def yes(ok):
        return "yes" if ok else "no"
    
    
    builders = [n for n in order if re.search(r"\b(NewMarker|NewLine|NewPoint) \{", "\n".join(fns[n]))]
    print("functions building a marker, a line or a point: %s" % " ".join(builders))
    body = "\n".join(fns.get("chart_format_sample", []))
    sizes = re.findall(r"\bsize: Some\(([0-9]+)\)", body)
    print("marker sizes: %s; each 2 to 72: %s" % (" ".join(sizes), yes(sizes and all(2 <= int(s) <= 72 for s in sizes))))
    widths = re.findall(r"\bwidth: Some\(([0-9]+)\)", body)
    print("line widths: %s; each at most 20116800: %s"
          % (" ".join(widths), yes(widths and all(int(w) <= 20116800 for w in widths))))
    markers = re.findall(r"NewMarker \{\s*symbol: MarkerSymbol::([A-Za-z]+),\s*size: ([^,\n]+),\s*color: ([^,\n]+),\s*\}", body)
    nones = [m for m in markers if m[0] == "None"]
    print("markers: %s; the none marker takes no size and no colour: %s"
          % (" ".join("/".join(m) for m in markers),
             yes(nones and all(s == "None" and c == "None" for _, s, c in nones)
                 and len(markers) == body.count("NewMarker {"))))
    lns = re.findall(r"NewLine \{\s*width: ([^,\n]+),\s*dash: ([^,\n]+),\s*\}", body)
    print("lines: %s; each with a width or a dash: %s"
          % (" ".join("/".join(m) for m in lns),
             yes(lns and len(lns) == body.count("NewLine {") and all(w != "None" or d != "None" for w, d in lns))))
    
    
    def arrays():
        found = {}
        for m in re.finditer(r"let ([a-z_]+) = \[", body):
            end = body.index("];", m.end())
            found[m.group(1)] = body[m.end():end]
        return found
    
    
    ARR = arrays()
    POINT = re.compile(r"NewPoint \{\s*index: ([0-9]+),\s*color: ([^\n]+?),\s*explosion: ([^\n]+?),\s*"
                       r"marker: (None|Some\(NewMarker \{[^}]*\}\)),\s*\}")
    point_sets = []
    ok_points = True
    nparsed = 0
    for name, text in ARR.items():
        pts = POINT.findall(text)
        if not pts:
            continue
        nparsed += len(pts)
        shown = []
        for index, color, explosion, marker in pts:
            shown.append("%s:%s:%s:%s" % (index, "colour" if color != "None" else "-",
                                          re.sub(r"^Some\(([0-9]+)\)$", r"\1", explosion) if explosion != "None" else "-",
                                          "marker" if marker != "None" else "-"))
            ok_points = ok_points and (color != "None" or explosion != "None" or marker != "None")
        idx = [p[0] for p in pts]
        ok_points = ok_points and len(set(idx)) == len(idx)
        point_sets.append("%s %s" % (name, " ".join(shown)))
    ok_points = ok_points and nparsed == body.count("NewPoint {") and nparsed > 0
    print("points: %s; each with a field, its indexes distinct: %s" % ("; ".join(point_sets), yes(ok_points)))
    plots = re.findall(r"\(\s*NewPlot::([A-Za-z0-9]+)((?: \{[^}]*\})?),\s*&([a-z_]+),?\s*\)", body)
    print("plots: %s" % " ".join("%s%s=%s" % (k, re.sub(r"[\s,]", "", o), s) for k, o, s in plots))
    kinds = {s: k for k, _, s in plots}
    opts = []
    # Change ND48: the core commit's field line high_low_lines: plot ==
    # NewPlot::Stock, once in the sample, names no plot.
    stock_field = body.count("high_low_lines: plot == NewPlot::Stock,")
    ok_kinds = bool(plots) and stock_field == 1 and body.count("NewPlot::") - stock_field == len(plots)
    MARKER_KINDS = {"Line", "Scatter"}
    LINE_KINDS = {"Line", "Line3D", "Scatter", "Radar", "Stock"}
    ROUND = {"Pie", "Pie3D", "Doughnut", "OfPie"}
    for _, _, s in plots:
        text = ARR.get(s, "")
        nm = text.count("marker: Some(NewMarker")
        nl = text.count("line: Some(NewLine")
        ref = re.findall(r"points: &([a-z_]+)", text)
        opts.append("%s markers %d lines %d points %s" % (s, nm, nl, " ".join(ref) or "-"))
        kind = kinds[s]
        if nm and kind not in MARKER_KINDS:
            ok_kinds = False
        if nl and kind not in LINE_KINDS:
            ok_kinds = False
        for r in ref:
            pts = POINT.findall(ARR.get(r, ""))
            if any(e != "None" for _, _, e, _ in pts) and kind not in ROUND:
                ok_kinds = False
            if any(mk != "None" for _, _, _, mk in pts) and kind not in MARKER_KINDS:
                ok_kinds = False
    print("series options: %s" % "; ".join(opts))
    print("by kind: markers on a line or a scatter, lines on a line-drawing kind, an explosion on a round kind, a point's marker where the series takes one: %s"
          % yes(ok_kinds))
    colours = re.findall(r"color: Some\((0x[0-9A-Fa-f_]+)\)", body)
    print("colours: %s; each at most 0xFFFFFF: %s"
          % (" ".join(colours), yes(colours and all(int(c.replace("_", ""), 16) <= 0xFFFFFF for c in colours))))
    print("combined plots: none: %s" % yes(body.count("combined: None,") == 1 and "combined: Some" not in body))
