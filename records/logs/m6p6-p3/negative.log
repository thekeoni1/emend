    def const_s(name):
        """const() over a literal its continuations carry across lines."""
        m = re.search(r"^const " + name + r': &str =\s*"((?:[^"\\]|\\.)*)";', test, re.M | re.S)
        assert m, name
        return rust(m.group(1))
    
    
    NAMES = {n: const_s(n) for n in ("MAIN_NS", "TYPES_NS", "RELS_NS", "ATTR_NS", "RELS_TYPE", "WORKBOOK_TYPE",
                                   "SHEET_TYPE", "STRINGS_TYPE", "STYLES_TYPE", "SAMPLE_FONTS", "SAMPLE_FILLS",
                                   "SAMPLE_XFS", "G1", "A_CELL")}
    sbody = body_of("fn styled_specs(sheet_data: &str, styles: &str) -> Vec<Spec> {")
    lits = [rust(x) for x in LIT.findall(sbody)]
    types_fmt = [x for x in lits if "<Types " in x]
    rels_fmt = [x for x in lits if "<Relationships " in x]
    assert len(types_fmt) == 1 and len(rels_fmt) == 1, "styled_specs' literals"
    ebody = body_of("fn edit_specs(sheet_data: &str) -> Vec<Spec> {")
    sheet_fmt = [rust(x) for x in LIT.findall(ebody) if "<worksheet " in rust(x)]
    assert len(sheet_fmt) == 1, "edit_specs' worksheet"
    pbody = body_of("fn font_sample_part(fonts: &str, fills: &str, cell_xfs: &str, count: u32) -> String {")
    part_fmt = [rust(x) for x in LIT.findall(pbody) if "<styleSheet " in rust(x)]
    assert len(part_fmt) == 1, "font_sample_part's literal"
    styled_types = fill(types_fmt[0], NAMES)
    styled_rels = fill(rels_fmt[0], NAMES)
    
    
    def styles_part(fills_text):
        return fill(part_fmt[0], dict(NAMES, fonts=NAMES["SAMPLE_FONTS"], fills=fills_text,
                                      cell_xfs=NAMES["SAMPLE_XFS"], count="3"))
    
    
    def styled(sheet_data, styles):
        """styled_specs over edit_specs, entry by entry in its order: B0's first
        six entries' parts and methods with the content types, the workbook's
        relationships and the worksheet replaced, then the styles part."""
        assert [p for p, _, _ in B0[:6]] == ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml",
                                             "xl/_rels/workbook.xml.rels", "xl/worksheets/sheet1.xml",
                                             "xl/sharedStrings.xml"]
        items = list(B0[:6])
        items[0] = ("[Content_Types].xml", styled_types.encode(), DEFLATED)
        items[3] = ("xl/_rels/workbook.xml.rels", styled_rels.encode(), STORED)
        items[4] = ("xl/worksheets/sheet1.xml", fill(sheet_fmt[0], dict(NAMES, sheet_data=sheet_data)).encode(), STORED)
        items.append(("xl/styles.xml", styles.encode(), STORED))
        return items
    
    
    g1 = NAMES["G1"]
    gfills = NAMES["SAMPLE_FILLS"].replace('<fills count="2">', '<fills count="3">').replace("</fills>", g1 + "</fills>")
    assert gfills != NAMES["SAMPLE_FILLS"] and gfills.count(g1) == 1
    B11 = styled("<sheetData>" + grows + "</sheetData>", styles_part(gfills))
    write("b11", B11)
    STYLES = "xl/styles.xml"
    
    
    def changed(items, old, new, n=1):
        outl = []
        for part, data, method in items:
            if part == STYLES:
                text = data.decode()
                assert text.count(old) == n, (old, text.count(old))
                data = text.replace(old, new).encode()
            outl.append((part, data, method))
        return outl
    
    
    N16 = changed(B11, 'degree="90"', 'degree="ninety"')
    print("n16 entries changed:%d (the styles part, G1's degree \"ninety\"; stored; every other entry as B11's)"
          % sum(1 for a, b in zip(B11, N16) if a != b))
    write("n16", N16)
    N17 = styled(NAMES["A_CELL"], styles_part(""))
    write("n17", N17)
    SECOND_STOP = '<stop position="1"><color rgb="FFFFFFFF"/></stop>'
    NAMED_FILL = ('<xf numFmtId="2" fontId="0" applyAlignment="1">', '<xf numFmtId="2" fontId="0" fillId="2" applyAlignment="1">')
    B12 = changed(B11, *NAMED_FILL)
    print("b12 entries changed:%d (the styles part, SAMPLE_XFS's second format naming fill 2, G1; stored; every other entry as B11's)"
          % sum(1 for a, b in zip(B11, B12) if a != b))
