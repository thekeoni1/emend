    plant("c-trend-build.rs", "\nfn first_worksheet<", "\nfn planted_trend() -> NewTrendline<'static> {\n    NewTrendline {\n        kind: TrendlineKind::Linear,\n        forward: None,\n        backward: None,\n        intercept: None,\n        show_equation: false,\n        show_r_squared: false,\n        name: None,\n    }\n}\n\nfn first_worksheet<", whole=True)
    plant("c-trend-default.rs", "        forward: None,\n        backward: None,", "        forward: Some(1.0),\n        backward: None,")
