    ROUND = {"Pie", "Pie3D", "Doughnut", "OfPie"}
    charts, shown, rules_ok, applies_ok = [], [], bool(items), bool(items)
    for item in items:
        im = re.fullmatch(r"(?:// [^\n]*\n\s*)*NewChart \{(.*)\}", item.strip(), re.S)
        if not im:
            rules_ok = applies_ok = False
            continue
        fl = fields(im.group(1))
        d = dict(base)
        own = dict(fl)
        if own.get("..") != "base":
            rules_ok = applies_ok = False
        d.update({k: v for k, v in own.items() if k != ".."})
        pm = re.fullmatch(r"NewPlot::([A-Za-z0-9]+)(?: \{.*\})?", d.get("plot", ""))
        kind = pm.group(1) if pm else "?"
        texts = {}
        for f in TEXTS:
            v = d.get(f, "None")
            if v == "None":
                continue
            tm = re.fullmatch(r"Some\((.*)\)", v)
            texts[f] = text_of(tm.group(1)) if tm else None
        sm2 = re.fullmatch(r"&([a-z_]+)", d.get("series", ""))
        st = series_texts(sm2.group(1)) if sm2 else None
        label_texts = [t for k, t in (st or []) if k == "labels"]
        for t in list(texts.values()) + label_texts:
            rules_ok = rules_ok and text_ok(t)
        has = lambda f: d.get(f, "None") != "None"
        applies_ok = applies_ok and st is not None
        applies_ok = applies_ok and ("title_text" not in texts or has("title"))
        applies_ok = applies_ok and ("axis_title_text" not in texts
                                     or has("category_axis_title") or has("value_axis_title"))
        applies_ok = applies_ok and ("axis_label_text" not in texts or kind not in ROUND)
        applies_ok = applies_ok and ("legend_text" not in texts or has("legend"))
        applies_ok = applies_ok and not (label_texts and kind in ("Surface", "Surface3D"))
        charts.append(kind)
        shown.append("%s %s; labels %s" % (kind, " ".join("%s=%s" % (f, show(texts[f])) for f in TEXTS if f in texts)
                                           or "-", " ".join(show(t) for t in label_texts) or "-"))
    print("charts: %s" % " | ".join(shown))
