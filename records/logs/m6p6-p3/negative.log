    printf 'spec0016=yes\ncommitted=no\nworking=no\n' >"$B/c-prefix-spec.txt"
    check "control: the same test refuses a reading where the working spec does not quote it" "$(ynnot prefix_quoted "$B/c-prefix-spec.txt")"
    python3 -I -B "$B/messages.py" "$B/now-package.rs" --name SHEET_ADDED_TO_PREFIXED >>"$B/known.tsv"
    python3 -I -B "$B/messages.py" "$B/base-package.rs" --name SHEET_ADDED_TO_PREFIXED >"$B/pfx-base.tsv"
    echo "command: python3 -I -B <scratch>/w/messages.py <scratch>/w/now-package.rs --name SHEET_ADDED_TO_PREFIXED, and the same over <scratch>/w/base-package.rs (change NC60)"
    LC_ALL=C "$G" -E "^SHEET_ADDED_TO_PREFIXED${TAB}" "$B/known.tsv" | sed 's/^/    /'
    sed 's/^/    at the base: /' "$B/pfx-base.tsv"
    PFX_MSG=$(awk -F"$TAB" '$1 == "SHEET_ADDED_TO_PREFIXED" { print $2 }' "$B/known.tsv")
    pfx_known() { [ "$(count_matches -E "^SHEET_ADDED_TO_PREFIXED${TAB}" "$B/known.tsv")" = 1 ] && [ -n "$PFX_MSG" ] && [ "$(count_lines "$B/pfx-base.tsv")" = 1 ] && [ "$(cut -f2 "$B/pfx-base.tsv")" = "$PFX_MSG" ]; }
    check "N8P's message read apart is package.rs's SHEET_ADDED_TO_PREFIXED, once, the base's message (ruling O; change NC60)" "$(yn pfx_known)"
    pfx_ctl() { local PFX_MSG=planted; pfx_known; }
    check "control: the same test refuses a planted message" "$(ynnot pfx_ctl)"
    pfx_listed() { [ "$(count_matches -xF "$PFX_MSG" "$B/cat-now.txt")$(count_matches -xF "$PFX_MSG" "$B/cat-base.txt")" = 11 ]; }
    check "N8P's message is a list item of the package header's catalogue at the phase commit and at the base, once each (change NC60)" "$(yn pfx_listed)"
    pfx_listed_ctl() { local PFX_MSG="$PFX_MSG planted"; pfx_listed; }
