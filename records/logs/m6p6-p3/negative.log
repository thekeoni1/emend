    cur = None
    for line in lines:
        m = re.match(r"(pub(\(crate\))? )?fn ([a-z0-9_]+)", line)
        if m and cur is None:
            cur = (m.group(3), [])
        if cur is not None:
            cur[1].append(line)
            if line == "}":
                fns[cur[0]] = cur[1]
                order.append(cur[0])
                cur = None
    splits = re.findall(r"OfPieSplit::([A-Za-z]+)(\([^)]*\))?", main)
    print("OfPieSplit forms named in the tool: %s" % " ".join(a + b for a, b in splits))
    builders = [n for n in order if re.search(r"NewPlot::(Surface|Surface3D|OfPie) \{\s*(wireframe|kind)", "\n".join(fns[n]))]
    print("functions building a surface or an of-pie plot: %s" % " ".join(builders))
    body = "\n".join(fns.get("chart_surface_sample", []))
    literals = body.count("NewSeries {")
    spreads = body.count("..over_b")
    ok_series = (literals == 3 and spreads == 2
                 and body.count("let over_b = NewSeries {") == 1
