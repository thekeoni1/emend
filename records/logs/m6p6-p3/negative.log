    plant("c-trend-custom.rs", "minus: &d,", "minus: &e,")
    plant("c-trend-direction.rs", "bars(None, ErrorBarKind::Both, ErrorValue::Fixed(1.5))", "bars(Some(ErrorDirection::Y), ErrorBarKind::Both, ErrorValue::Fixed(1.5))")
    plant("c-trend-same.rs", "Some(ErrorDirection::X),", "Some(ErrorDirection::Y),")
    plant("c-trend-two.rs", "error_bars: &fixed,", "error_bars: &two_sets,")
    plant("c-trend-kind.rs", "NewPlot::Bar {", "NewPlot::Bar3D {")
    plant("c-trend-combined.rs", "            combined: None,\n", "            combined: Some(SECOND),\n")
    PY
    echo "command: the same program over fifteen planted copies, each changing one thing (change ND47):"
    sed 's/^/    /' "$B/trend-plant.out"
    for c in build default order period average intercept forecast name length custom direction same two kind combined; do
