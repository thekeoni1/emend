## every mktemp call, this script's and the counting library's (ruling 12; change MW, carried as NB3 and NB31 to NB53)
  this script: mktemp calls 1; of them not in TMPDIR's form 0
    B=$(mktemp -d) || exit 2
  the counting library, <scratch>/w/counting.sh: mktemp calls 1; of them not in TMPDIR's form 0
