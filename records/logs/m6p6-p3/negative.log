    for name in COVER_DRAWING COVER_TEXT COVER_OPTION COVER_OPTION_BAR COVER_OPTION_LINE COVER_OPTION_AREA COVER_OPTION_PIE COVER_SIZE COVER_ANCHOR COVER_PARTS COVER_OPTION_DOUGHNUT COVER_OPTION_STOCK COVER_SIZES $P2_OPTION COVER_NO_CHART COVER_CHART_PART $P3_OPTION COVER_NO_CHART_IMAGE; do
      echo "  chart_write::${!name} $(count_matches -F "fn ${!name}()" "$B/write-tests.rs")"
    done
    for name in COVER_TOOL COVER_LINE COVER_ADD_TOOL COVER_ADD_LINE COVER_TWO_TOOL COVER_3D_TOOL COVER_3D_LINE COVER_REMOVE_TOOL COVER_REMOVE_LINE COVER_SHEET_TOOL COVER_SHEET_LINE; do
      echo "  ${!name} $(count_matches -F "fn ${!name}()" "$B/null_rewrite.rs")"
    done
    for name in COVER_ROOT COVER_ABSOLUTE COVER_ONE; do
      echo "  chartsheet::${!name} $(count_matches -F "fn ${!name}()" "$B/sheet-tests.rs")"
    done
    # covered_once <name> <file>: the file holds the test's fn line once.
    covered_once() { [ "$(count_matches -F "fn $1()" "$2")" = 1 ]; }
    check "N1's and N2's covering crate test (the drawing refusals through add_chart, a userShapes root and a relationship whose part is missing among them) is at the phase commit, once (change ND36)" "$(yn covered_once "$COVER_DRAWING" "$B/write-tests.rs")"
    # user_shapes_root: the crate test file builds a drawing whose root is
    # userShapes, the case N1 shows through the binary (change ND35).
    user_shapes_root() { [ "$(count_matches -F '<c:userShapes xmlns:c=' "$B/write-tests.rs")" -ge 1 ]; }
    check "package/tests/chart_write.rs at the phase commit builds a drawing whose root is userShapes (change ND35)" "$(yn user_shapes_root)"
    check "the tool test covering N1 is at the phase commit, once" "$(yn covered_once "$COVER_TOOL" "$B/null_rewrite.rs")"
    check "the kinds tool test whose appended case is B0 is at the phase commit, once" "$(yn covered_once "$COVER_LINE" "$B/null_rewrite.rs")"
    check "the tool test covering N2 is at the phase commit, once (change ND36)" "$(yn covered_once "$COVER_ADD_TOOL" "$B/null_rewrite.rs")"
    check "the add-chart tool test whose appended case is B1 is at the phase commit, once (change ND36)" "$(yn covered_once "$COVER_ADD_LINE" "$B/null_rewrite.rs")"
    check "CHART_TEXT_INVALID's covering crate test is at the phase commit, once" "$(yn covered_once "$COVER_TEXT" "$B/write-tests.rs")"
    check "CHART_OPTION_KIND's part 4 covering crate tests (no series; a bar's Standard; a line's Clustered; an area's Clustered; a pie's second series or axis title) are at the phase commit, once each (change ND35)" "$(yn [ "$(yn covered_once "$COVER_OPTION" "$B/write-tests.rs")$(yn covered_once "$COVER_OPTION_BAR" "$B/write-tests.rs")$(yn covered_once "$COVER_OPTION_LINE" "$B/write-tests.rs")$(yn covered_once "$COVER_OPTION_AREA" "$B/write-tests.rs")$(yn covered_once "$COVER_OPTION_PIE" "$B/write-tests.rs")" = yesyesyesyesyes ])"
    check "CHART_SIZE_ANCHOR's covering crate test is at the phase commit, once" "$(yn covered_once "$COVER_SIZE" "$B/write-tests.rs")"
    check "CHART_ANCHOR_OUT_OF_RANGE's covering crate test is at the phase commit, once" "$(yn covered_once "$COVER_ANCHOR" "$B/write-tests.rs")"
    check "control: the same count finds no test of a planted name" "$(ynnot covered_once a_planted_test_name "$B/write-tests.rs")"
    check "the tool test covering N3 is at the phase commit, once (change ND37)" "$(yn covered_once "$COVER_TWO_TOOL" "$B/null_rewrite.rs")"
    check "part 1's messages' covering crate test is at the phase commit, once (change ND37)" "$(yn covered_once "$COVER_PARTS" "$B/write-tests.rs")"
    check "this phase's CHART_OPTION_KIND tests (a doughnut's hole or axis title; a stock's series count; sizes missing or misplaced) are at the phase commit, once each (change ND37)" "$(yn [ "$(yn covered_once "$COVER_OPTION_DOUGHNUT" "$B/write-tests.rs")$(yn covered_once "$COVER_OPTION_STOCK" "$B/write-tests.rs")$(yn covered_once "$COVER_SIZES" "$B/write-tests.rs")" = yesyesyes ])"
    # body_of <name> <file>: the test fn's lines, from its fn line to the
    # first line that is a lone closing brace (change ND37).
    body_of() { awk -v f="fn $1()" 'index($0, f) { on = 1 } on { print } on && $0 == "}" { exit }' "$2"; }
    # body_holds <name> <file> <text>: the test's body holds the text.
    body_holds() { [ "$(body_of "$1" "$2" | count_matches -F "$3" /dev/stdin)" -ge 1 ]; }
    # known_msg <NAME>: the message read apart for the constant.
    known_msg() { awk -F"$TAB" -v n="$1" '$1 == n { print $2 }' "$B/known.tsv"; }
    for name in NO_SUCH_PART CELL_EDIT_REPLACED REMOVED_PART_EDITED; do
      check "$name's message is a string literal of $COVER_PARTS's body (change ND37)" "$(yn body_holds "$COVER_PARTS" "$B/write-tests.rs" "\"$(known_msg "$name")\"")"
    done
    check "TWO_DRAWINGS's message is a string literal of $COVER_DRAWING's body, N3's covering crate test (change ND37)" "$(yn body_holds "$COVER_DRAWING" "$B/write-tests.rs" "\"$(known_msg TWO_DRAWINGS)\"")"
    check "TWO_DRAWINGS's message is in $COVER_TWO_TOOL's body, as the tool prints it (change ND37)" "$(yn body_holds "$COVER_TWO_TOOL" "$B/null_rewrite.rs" "\"error: $(known_msg TWO_DRAWINGS)\\n\"")"
    for name in COVER_OPTION_DOUGHNUT COVER_OPTION_STOCK COVER_SIZES; do
      check "${!name} asserts the option message, OPTION (change ND37)" "$(yn body_holds "${!name}" "$B/write-tests.rs" ", OPTION);")"
    done
    check "$COVER_SIZES asserts the text message, TEXT, for its empty sizes reference (change ND37)" "$(yn body_holds "$COVER_SIZES" "$B/write-tests.rs" ", TEXT);")"
    check "control: body_holds says no for a text the body lacks" "$(ynnot body_holds "$COVER_SIZES" "$B/write-tests.rs" "a planted text")"
    check "control: body_holds says no for a planted test name" "$(ynnot body_holds a_planted_test_name "$B/write-tests.rs" "fn")"
    body_end_ctl() { [ "$(body_of "$COVER_OPTION_STOCK" "$B/write-tests.rs" | count_matches -F "fn " /dev/stdin)" = 1 ]; }
    check "control: body_of stops at the test's closing brace, holding one fn line" "$(yn body_end_ctl)"
    check "the tool test covering N4 is at the phase commit, once (change ND38)" "$(yn covered_once "$COVER_3D_TOOL" "$B/null_rewrite.rs")"
    check "the 3D tool test whose appended case is B2 is at the phase commit, once (change ND38)" "$(yn covered_once "$COVER_3D_LINE" "$B/null_rewrite.rs")"
    check "DRAWING_UNREADABLE's message is in $COVER_3D_TOOL's body, as the tool prints it (change ND38)" "$(yn body_holds "$COVER_3D_TOOL" "$B/null_rewrite.rs" "\"error: $(known_msg DRAWING_UNREADABLE)\\n\"")"
    check "$COVER_3D_TOOL's body runs the 3D sample (change ND38)" "$(yn body_holds "$COVER_3D_TOOL" "$B/null_rewrite.rs" "\"--chart-3d-sample\"")"
    # body_asserts <name> <MESSAGE>: the test's body passes the message's
    # constant to its assertion, on the call's line (", NAME);") or on a line
    # of its own ("NAME,"), as rustfmt lays it out (change ND38).
    body_asserts() { [ "$(body_of "$1" "$B/write-tests.rs" | count_matches -E "(, $2[)];\$|^[[:space:]]+$2,\$)" /dev/stdin)" -ge 1 ]; }
    for name in $P2_OPTION; do
      check "${!name} is at the phase commit, once, and asserts the option message, OPTION (change ND38)" "$(yn [ "$(yn covered_once "${!name}" "$B/write-tests.rs")$(yn body_asserts "${!name}" OPTION)" = yesyes ])"
    done
    check "$COVER_COMBINED_ORDER asserts the text message, TEXT, for the combined texts (change ND38)" "$(yn body_asserts "$COVER_COMBINED_ORDER" TEXT)"
    check "control: body_asserts says no for a constant the body does not pass" "$(ynnot body_asserts "$COVER_OPTION_LINE3D" TEXT)"
    check "the tool test covering N5 is at the phase commit, once (change ND39)" "$(yn covered_once "$COVER_REMOVE_TOOL" "$B/null_rewrite.rs")"
    check "the remove-chart tool test whose line is B3's is at the phase commit, once (change ND39)" "$(yn covered_once "$COVER_REMOVE_LINE" "$B/null_rewrite.rs")"
    check "CHART_UNREADABLE's message is a string literal of $COVER_REMOVE_TOOL's body, the message styled_run_refused prints after error: (change ND39; ruling N)" "$(yn body_holds "$COVER_REMOVE_TOOL" "$B/null_rewrite.rs" "\"$(known_msg CHART_UNREADABLE)\",")"
    check "$COVER_REMOVE_TOOL's body runs the remove-chart sample (change ND39)" "$(yn body_holds "$COVER_REMOVE_TOOL" "$B/null_rewrite.rs" "\"--remove-chart-sample\"")"
    check "$COVER_REMOVE_LINE's body runs the remove-chart sample (change ND39)" "$(yn body_holds "$COVER_REMOVE_LINE" "$B/null_rewrite.rs" "&[\"--remove-chart-sample\"]")"
    # The two new messages' crate tests: each once, each body asserting its
    # message's constant, and the test file holding each message (change ND39).
    check "NO_CHART_AT's covering crate test is at the phase commit, once, and asserts NO_CHART (change ND39)" "$(yn [ "$(yn covered_once "$COVER_NO_CHART" "$B/write-tests.rs")$(yn body_asserts "$COVER_NO_CHART" NO_CHART)" = yesyes ])"
    check "CHART_PART_UNREADABLE's covering crate test is at the phase commit, once, and asserts CHART_PART (change ND39)" "$(yn [ "$(yn covered_once "$COVER_CHART_PART" "$B/write-tests.rs")$(yn body_asserts "$COVER_CHART_PART" CHART_PART)" = yesyes ])"
    # test_const <CONST> <NAME>: the test file binds the constant to the
    # message the source holds for NAME (change ND39).
    test_const() { local m; m=$(awk -F"$TAB" -v n="$2" '$1 == n { print $2 }' "$B/part.tsv"); [ -n "$m" ] && [ "$(count_matches -xF "const $1: &str = \"$m\";" "$B/write-tests.rs")" = 1 ]; }
    check "package/tests/chart_write.rs binds NO_CHART to NO_CHART_AT's message (change ND39)" "$(yn test_const NO_CHART NO_CHART_AT)"
    check "package/tests/chart_write.rs binds CHART_PART to CHART_PART_UNREADABLE's message (change ND39)" "$(yn test_const CHART_PART CHART_PART_UNREADABLE)"
    check "control: test_const says no for a constant bound to another message" "$(ynnot test_const NO_CHART CHART_PART_UNREADABLE)"
    check "control: body_asserts says no for NO_CHART against the frame test" "$(ynnot body_asserts "$COVER_CHART_PART" NO_CHART)"
    # Change ND40: ruling O's test once, its body asserting NO_CHART, gated by
    # the feature images on one of the two lines before its fn line.
    check "NO_CHART_AT's covering crate test for a part the same write adds an image to is at the phase commit, once, and asserts NO_CHART (change ND40; P3 verification ruling O)" "$(yn [ "$(yn covered_once "$COVER_NO_CHART_IMAGE" "$B/write-tests.rs")$(yn body_asserts "$COVER_NO_CHART_IMAGE" NO_CHART)" = yesyes ])"
    images_gated() { [ "$(LC_ALL=C "$G" -B2 -xF "fn $1() {" "$B/write-tests.rs" | count_matches -xF '#[cfg(feature = "images")]' /dev/stdin)" = 1 ]; }
    check "$COVER_NO_CHART_IMAGE is compiled under the feature images (change ND40)" "$(yn images_gated "$COVER_NO_CHART_IMAGE")"
    check "control: images_gated says no for $COVER_NO_CHART, compiled under charts alone" "$(ynnot images_gated "$COVER_NO_CHART")"
    for name in $P3_OPTION; do
      check "${!name} is at the phase commit, once, and asserts the option message, OPTION (change ND39)" "$(yn [ "$(yn covered_once "${!name}" "$B/write-tests.rs")$(yn body_asserts "${!name}" OPTION)" = yesyes ])"
    done
    check "$COVER_NEW_ORDER asserts the text message, TEXT, for the new texts (change ND39)" "$(yn body_asserts "$COVER_NEW_ORDER" TEXT)"
    check "control: body_asserts says no for a planted test name" "$(ynnot body_asserts a_planted_test_name OPTION)"
    printf 'fn a_planted() {\n    assert_package(\n        call(x).expect_err("refused"),\n        OPTION,\n    );\n    let OPTIONS = 1;\n}\n' >"$B/c-assert.rs"
    c_assert_ctl() { [ "$(count_matches -E "(, OPTION[)];\$|^[[:space:]]+OPTION,\$)" "$B/c-assert.rs")" = 1 ]; }
    check "control: the same form finds a planted test's one assertion laid out on its own line, and not a name that starts with the constant's" "$(yn c_assert_ctl)"
    # held_by_tests <NAME>: the test file holds the constant's message as a
    # string literal, so its tests assert that message.
    held_by_tests() { local m; m=$(awk -F"$TAB" -v n="$1" '$1 == n { print $2 }' "$B/part.tsv"); [ -n "$m" ] && [ "$(count_matches -F "\"$m\"" "$B/write-tests.rs")" -ge 1 ]; }
    for name in $PART_NAMES $NEW_NAMES; do
      check "$name's message is a string literal of package/tests/chart_write.rs (change ND39 for P3's two)" "$(yn held_by_tests "$name")"
    done
    check "control: held_by_tests says no for a constant the module does not hold" "$(ynnot held_by_tests PLANTED_NAME)"
    # Change ND41: this phase's three messages' crate tests, each once in
    # package/tests/chartsheet.rs, each body asserting its constant (on the
    # call's line or on a line of its own, as body_asserts reads it), and that
    # file binding each constant to the source's message; N6's and B4's tool
    # tests, each once, each running the chartsheet sample, N6's holding the
    # message as the tool prints it.
    asserts_in() { [ "$(body_of "$1" "$2" | count_matches -E "(, $3[)];\$|^[[:space:]]+$3,\$)" /dev/stdin)" -ge 1 ]; }
    check "NOT_SHEET_ROOT's covering crate test $COVER_ROOT is in package/tests/chartsheet.rs at the phase commit, once, and asserts ROOT (change ND41)" "$(yn [ "$(yn covered_once "$COVER_ROOT" "$B/sheet-tests.rs")$(yn asserts_in "$COVER_ROOT" "$B/sheet-tests.rs" ROOT)" = yesyes ])"
    check "CHARTSHEET_ANCHOR's covering crate test $COVER_ABSOLUTE is in package/tests/chartsheet.rs at the phase commit, once, and asserts ABSOLUTE (change ND41)" "$(yn [ "$(yn covered_once "$COVER_ABSOLUTE" "$B/sheet-tests.rs")$(yn asserts_in "$COVER_ABSOLUTE" "$B/sheet-tests.rs" ABSOLUTE)" = yesyes ])"
    check "ONE_CHART's covering crate test $COVER_ONE is in package/tests/chartsheet.rs at the phase commit, once, and asserts ONE (change ND41)" "$(yn [ "$(yn covered_once "$COVER_ONE" "$B/sheet-tests.rs")$(yn asserts_in "$COVER_ONE" "$B/sheet-tests.rs" ONE)" = yesyes ])"
    check "control: asserts_in says no for ROOT against $COVER_ONE" "$(ynnot asserts_in "$COVER_ONE" "$B/sheet-tests.rs" ROOT)"
    check "control: covered_once finds none of a planted test name in package/tests/chartsheet.rs" "$(ynnot covered_once a_planted_test_name "$B/sheet-tests.rs")"
    # sheet_const <CONST> <NAME>: package/tests/chartsheet.rs binds the
    # constant to the message the source holds for NAME.
    sheet_const() { local m; m=$(awk -F"$TAB" -v n="$2" '$1 == n { print $2 }' "$B/part.tsv"); [ -n "$m" ] && [ "$(count_matches -xF "const $1: &str = \"$m\";" "$B/sheet-tests.rs")" = 1 ]; }
    check "package/tests/chartsheet.rs binds ROOT to NOT_SHEET_ROOT's message (change ND41)" "$(yn sheet_const ROOT NOT_SHEET_ROOT)"
    check "package/tests/chartsheet.rs binds ABSOLUTE to CHARTSHEET_ANCHOR's message (change ND41)" "$(yn sheet_const ABSOLUTE CHARTSHEET_ANCHOR)"
    check "package/tests/chartsheet.rs binds ONE to ONE_CHART's message (change ND41)" "$(yn sheet_const ONE ONE_CHART)"
    check "control: sheet_const says no for a constant bound to another message" "$(ynnot sheet_const ROOT ONE_CHART)"
    check "the tool test covering N6 is at the phase commit, once (change ND41)" "$(yn covered_once "$COVER_SHEET_TOOL" "$B/null_rewrite.rs")"
    check "the chartsheet tool test whose line is B4's is at the phase commit, once (change ND41)" "$(yn covered_once "$COVER_SHEET_LINE" "$B/null_rewrite.rs")"
    check "NO_SUCH_PART's message is in $COVER_SHEET_TOOL's body, as the tool prints it (change ND41)" "$(yn body_holds "$COVER_SHEET_TOOL" "$B/null_rewrite.rs" "\"error: $(known_msg NO_SUCH_PART)\\n\"")"
    check "$COVER_SHEET_TOOL's body runs the chartsheet sample (change ND41)" "$(yn body_holds "$COVER_SHEET_TOOL" "$B/null_rewrite.rs" "&[\"--chartsheet-sample\"]")"
    check "$COVER_SHEET_LINE's body runs the chartsheet sample (change ND41)" "$(yn body_holds "$COVER_SHEET_LINE" "$B/null_rewrite.rs" "&[\"--chartsheet-sample\"]")"
    # Change ND42, turned by ND60 (specs/0043 ruling O): N8's covering crate
    # test is a_workbook_root_binding_no_relationships_prefix_takes_an_add in
    # package/tests.rs at the phase commit, once, its body calling add_sheet,
    # reading the output back and holding no message literal; the refusing
    # test's old name at the base only.
    COVER_PREFIX=a_workbook_root_binding_no_relationships_prefix_takes_an_add
    COVER_PREFIX_OLD=a_workbook_root_binding_no_relationships_prefix_refuses_an_add
    git show "$C:crates/emend/src/package/tests.rs" >"$B/tests.rs"
    git show "$REC:crates/emend/src/package/tests.rs" >"$B/base-tests.rs"
    echo "command: count_matches -F 'fn <name>()' over crates/emend/src/package/tests.rs at the phase commit and at the base, for $COVER_PREFIX and $COVER_PREFIX_OLD (change ND60)"
    echo "  $COVER_PREFIX: at the phase commit $(count_matches -F "fn $COVER_PREFIX()" "$B/tests.rs"); at the base $(count_matches -F "fn $COVER_PREFIX()" "$B/base-tests.rs")"
    echo "  $COVER_PREFIX_OLD: at the phase commit $(count_matches -F "fn $COVER_PREFIX_OLD()" "$B/tests.rs"); at the base $(count_matches -F "fn $COVER_PREFIX_OLD()" "$B/base-tests.rs")"
    check "N8's covering crate test $COVER_PREFIX is in package/tests.rs at the phase commit, once, and not at the base (ruling O; change ND60)" "$(yn [ "$(count_matches -F "fn $COVER_PREFIX()" "$B/tests.rs")$(count_matches -F "fn $COVER_PREFIX()" "$B/base-tests.rs")" = 10 ])"
    check "the refusing test $COVER_PREFIX_OLD is at the base, once, and not at the phase commit (ruling O; change ND60)" "$(yn [ "$(count_matches -F "fn $COVER_PREFIX_OLD()" "$B/tests.rs")$(count_matches -F "fn $COVER_PREFIX_OLD()" "$B/base-tests.rs")" = 01 ])"
    check "$COVER_PREFIX's body calls add_sheet (change ND60)" "$(yn body_holds "$COVER_PREFIX" "$B/tests.rs" "package.add_sheet(")"
    check "$COVER_PREFIX's body reads the output back, reopening it and reading its sheets (change ND60)" "$(yn [ "$(yn body_holds "$COVER_PREFIX" "$B/tests.rs" "Package::open(Cursor::new(out))")$(yn body_holds "$COVER_PREFIX" "$B/tests.rs" "back.sheets()")" = yesyes ])"
    check "$COVER_PREFIX's body holds no message literal: neither N8's old message nor the error assertion (ruling O; change ND60)" "$(yn [ "$(yn body_holds "$COVER_PREFIX" "$B/tests.rs" "$PREFIX_MSG")$(yn body_holds "$COVER_PREFIX" "$B/tests.rs" "assert_package(")" = nono ])"
    check "$COVER_PREFIX's body declares the relationships namespace on the file's sheet element and expects the new one's declaration (ruling M; change ND60)" "$(yn [ "$(yn body_holds "$COVER_PREFIX" "$B/tests.rs" 'xmlns:q=\"{ATTR_NS}\" q:id=\"rId1\"')$(yn body_holds "$COVER_PREFIX" "$B/tests.rs" 'xmlns:r=\"{ATTR_NS}\" r:id=\"rId3\"')" = yesyes ])"
    check "control: body_holds says yes for N8's old message in the refusing test's body at the base, so the form can find it (change ND60)" "$(yn body_holds "$COVER_PREFIX_OLD" "$B/base-tests.rs" "$PREFIX_MSG")"
    # Change ND43 (ruling M): CHARTSHEET_ANCHOR and ONE_CHART, raised at the
    # write after Package::add_chart on a chartsheet, are not reachable through
    # emend-copy. The phase commit's tools/emend-copy/src/main.rs read by a
    # program that splits it into its top-level functions: first_worksheet
    # takes the first sheet of SheetKind::Worksheet; every function calling
    # add_chart or remove_chart is one of the twelve chart samples (the
    # surface sample the seventh, change ND44, the format sample the eighth,
    # change ND45, the trend sample the ninth, change ND47, the axis sample
    # the tenth, change ND48, the text sample the eleventh, change ND52, the
    # edit sample the twelfth, change ND53), each call on
    # &part, part bound once from first_worksheet and no parameter, the part's
    # cells read by sample before the first chart call (a part whose root is a
    # chartsheet is refused there, N9 below); add_chartsheet is called once, by
    # chartsheet_sample; and Package::add_chartsheet in chart_write.rs takes a
    # name and a chart and no anchor. Each check has a planted copy it refuses.
    git show "$C:tools/emend-copy/src/main.rs" >"$B/main.rs"
    cat >"$B/reach.py" <<'PY'
    import re
    import sys
    
    main = open(sys.argv[1]).read().split("\n")
    writer = open(sys.argv[2]).read()
    fns = {}
    order = []
    cur = None
    for line in main:
        m = re.match(r"(pub(\(crate\))? )?fn ([a-z0-9_]+)", line)
        if m and cur is None:
            cur = (m.group(3), [])
        if cur is not None:
            cur[1].append(line)
            if line == "}":
                fns[cur[0]] = cur[1]
                order.append(cur[0])
                cur = None
    fw = "\n".join(fns.get("first_worksheet", []))
    fw_ok = (fw.count(".find(|sheet| sheet.kind == SheetKind::Worksheet)") == 1
             and fw.count(".find(") == 1 and fw.count(".filter(") == 0
             and ".map(|sheet| sheet.part.clone())" in fw)
    print("first_worksheet filters on SheetKind::Worksheet: %s" % ("yes" if fw_ok else "no"))
    callers = [n for n in order if re.search(r"\.(add_chart|remove_chart)\(", "\n".join(fns[n]))]
    print("chart-call functions: %s" % " ".join(callers))
    every = bool(callers)
    for n in callers:
        body = fns[n]
        text = "\n".join(body)
        head = text[:text.index("{")]
        calls = re.findall(r"\.(add_chart|remove_chart)\(([^,)]*)", text)
        binds = re.findall(r"\blet (?:mut )?part\b[^\n]*", text)
        assigns = len(re.findall(r"(?<![.\w])part\s*=(?!=)", text))
        first_call = min(i for i, l in enumerate(body) if re.search(r"\.(add_chart|remove_chart)\(", l))
        sampled = [i for i, l in enumerate(body) if "sample(&mut package, &part)?" in l]
        ok = (all(arg == "&part" for _, arg in calls)
              and binds == ["let part = first_worksheet(&mut package)?;"]
              and assigns == 1
              and not re.search(r"\bpart\s*:", head)
              and bool(sampled) and sampled[0] < first_call)
        print("  %s: calls %s; part from first_worksheet alone, cells read by sample first: %s"
              % (n, ",".join(c for c, _ in calls), "yes" if ok else "no"))
        every = every and ok
    print("every add_chart and remove_chart call takes the part first_worksheet gives, its cells read first: %s"
          % ("yes" if every else "no"))
    cs = [n for n in order if ".add_chartsheet(" in "\n".join(fns[n])]
    ncs = sum("\n".join(fns[n]).count(".add_chartsheet(") for n in order)
    print("add_chartsheet calls: %d (%s)" % (ncs, " ".join(cs)))
    sig = "    pub fn add_chartsheet(&mut self, name: &str, chart: &NewChart<'_>) -> Result<Vec<u8>, Error> {"
    print("Package::add_chartsheet takes a name and a chart and no anchor: %s"
          % ("yes" if writer.count(sig) == 1 and writer.count("pub fn add_chartsheet(") == 1 else "no"))
    PY
    python3 -I -B "$B/reach.py" "$B/main.rs" "$B/now-chart_write.rs" >"$B/reach.out" 2>&1
