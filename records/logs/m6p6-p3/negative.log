    plant("c-trend-intercept.rs", "                show_r_squared: true,\n                ..trend(TrendlineKind::Linear)", "                show_r_squared: true,\n                intercept: Some(1.0),\n                ..trend(TrendlineKind::Power)")
    plant("c-trend-forecast.rs", "forward: Some(2.0),", "forward: Some(-2.0),")
