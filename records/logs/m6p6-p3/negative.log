    check "control: the same check refuses a copy whose index is the last but one" "$(ynnot reach_has "$TE_SECOND" "$B/c-edit-index.out")"
    check "control: the same check refuses a copy adding a chart in the second write" "$(ynnot reach_has "$TE_SECOND" "$B/c-edit-add.out")"
