    python3 -I -B - "$B/main.rs" "$B" <<'PY' >"$B/edit-plant.out" 2>&1
    import sys
    main = open(sys.argv[1]).read()
    out = sys.argv[2]
    i = main.index("\nfn chart_edit_sample(")
    j = main.index("\n}\n", i)
    
    
    def plant(name, a, b, whole=False):
        text = main if whole else main[i:j]
        assert text.count(a) >= 1, (name, a)
        new = text.replace(a, b, 1)
        open(out + "/" + name, "w").write(new if whole else main[:i] + new + main[j:])
        print("planted %s" % name)
    
    
    plant("c-edit-build.rs", "\nfn first_worksheet<", "\nfn planted_edit() {\n    package.set_chart_title(&part, 0, None);\n}\n\nfn first_worksheet<", whole=True)
