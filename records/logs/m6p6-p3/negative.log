        below U+0020, U+FFFE or U+FFFF."""
        return (0 < len(text.encode()) <= limit
                and not any(ord(c) < 0x20 or c in "\ufffe\uffff" for c in text))
    
    
    # The functions calling set_chart_title or set_chart_series.
    editors = [n for n in order if re.search(r"\.set_chart_(title|series)\(", "\n".join(fns[n]))]
    print("functions calling set_chart_title or set_chart_series: %s" % " ".join(editors))
    body = "\n".join(fns.get("chart_edit_sample", []))
    # The part: first_worksheet's, bound once and no parameter, its cells read
    # by sample before the first chart call; every edit call on it.
    read_at = body.find("let sampled = sample(&mut package, &part)?;")
    add_at = body.find("package.add_chart(")
    part_ok = (body.count("let part = first_worksheet(&mut package)?;") == 1
               and "fn chart_edit_sample(input: &Path, output: &Path)" in body
               and 0 <= read_at < add_at
               and all(m.group(1) == "&part" for m in re.finditer(r"\.(?:set_chart_title|set_chart_series|add_chart)\(([^,]*),", body)))
    print("every edit call takes the part first_worksheet gives, its cells read first: %s" % yes(part_ok))
    # The second write: the first write's output reopened, the index the last of
    # its charts list; no addition and no removal recorded on it.
    second = body[body.index("let mut added = "):] if "let mut added = " in body else ""
    index_ok = re.search(r"let index = added\s*\.charts\(&part\)\?\s*\.len\(\)\s*\.checked_sub\(1\)", second) is not None
    no_add = second != "" and ".add_chart(" not in second and ".remove_chart(" not in second
    print("the second write's index is the last of the charts list read after the addition, and it records no addition or removal: %s"
          % yes(index_ok and no_add))
    # set_chart_series: once, on series 0 of that index.
    series_calls = re.findall(r"\.set_chart_series\(([^;]*)\)\?;", body)
    print("set_chart_series calls: %d (%s)" % (len(series_calls), "; ".join(" ".join(c.split()) for c in series_calls)))
    # The chart added: one series, no combined plot, its style 26 (ruling G).
    charts = literals(body, "NewChart")
    series_lits = literals(body, "NewSeries")
    chart_ok = (len(charts) == 1 and dict(charts[0][1]).get("series") == "&series" and len(series_lits) == 1
                and re.search(r"let series = \[NewSeries \{", body) is not None
                and dict(charts[0][1]).get("combined") == "None" and dict(charts[0][1]).get("style") == "Some(26)")
    print("the chart added: one literal of one series, no combined plot, its style 26: %s" % yes(chart_ok))
    # set_chart_title: its titles, each a constant that passes the text rule;
    # the kept chart's on index 0 only where W held a chart before.
    titles = re.findall(r"\.set_chart_title\(&part, ([a-z0-9_]+), Some\(\"([^\"\\]*)\"\)\)\?;", body)
    print("set_chart_title calls: %s" % "; ".join("%s %s" % t for t in titles))
    kept_ok = (re.search(r"let kept = before\.charts > 0;", body) is not None
               and re.search(r"if kept \{\s*added\.set_chart_title\(&part, 0, Some\(\"[^\"]*\"\)\)\?;\s*\}", body) is not None)
    print("the kept chart's title is set on index 0 alone, where W held a chart before: %s" % yes(kept_ok))
    print("the titles pass the text rule: %s" % yes(len(titles) == 2 and all(valid(t, 32767) for _, t in titles)))
    # The edit's references: the sample's bounded columns and C1 over W's
    # quoted name.
    edits = literals(body, "ChartSeriesEdit")
    refs_ok = (len(edits) == 1 and dict(edits[0][1]) == {
        "name": "Some(NewSeriesName::Reference(&c_name))", "categories": "Some(&b)", "values": "Some(&c)"}
        and 'let column = |letter: char| format!("{sheet}!${letter}$2:${letter}${last}");' in body
        and "let last = bounded_last_row(sampled.max_row);" in body
        and 'let (b_name, c_name) = (format!("{sheet}!$B$1"), format!("{sheet}!$C$1"));' in body
        and "let sheet = format!(\"'{}'\", name.replace('\\'', \"''\"));" in body)
    print("the edit's references: the name C1, the categories over B and the values over C, bounded, over W's quoted name: %s"
          % yes(refs_ok))
    # Every chart literal of the tool: a full one's style None, a spread one
    # setting none, but the edit sample's, whose style is a constant from 1 to
    # 48 (ruling G).
    full = spread = 0
    style_ok = True
    styled = []
    for n in order:
        for _, fl in literals("\n".join(fns[n]), "NewChart"):
            d = dict(fl)
            if ".." in d:
                spread += 1
                style_ok &= "style" not in d
            else:
                full += 1
                m = re.fullmatch(r"Some\(([0-9]+)\)", d.get("style", ""))
                if m:
                    styled.append((n, int(m.group(1))))
                else:
                    style_ok &= d.get("style") == "None"
    style_ok &= len(styled) == 1 and styled[0][0] == "chart_edit_sample" and 1 <= styled[0][1] <= 48
    print("every chart literal of the tool takes no style but the edit sample's, %s, from 1 to 48: %s (%d full, %d spread)"
          % (" ".join("%s=%d" % s for s in styled) or "none", yes(style_ok), full, spread))
