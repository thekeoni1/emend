    done
    check "the core-read test $COVER_CORE_READ is at the phase commit, once, in styles/tests.rs (ruling R; change ND56)" "$(yn covered_once "$COVER_CORE_READ" "$B/styles-tests.rs")"
    for name in $TWO_CORE_TESTS; do
      check "${!name} is at the phase commit, once, in styles/tests.rs, and its body holds $TWO_NAME's new text, read through its string continuation (rulings Q and Z; change ND56)" "$(yn [ "$(yn covered_once "${!name}" "$B/styles-tests.rs")$(yn body_holds_folded "${!name}" "$B/styles-tests.rs" "\"$TWO_MSG\"")" = yesyes ])"
    done
    check "$COVER_TWO_READ is at the phase commit, once, in package/tests/namedstyles.rs, and its body holds $TWO_NAME's new text, read through its string continuation (ruling Q; change ND56)" "$(yn [ "$(yn covered_once "$COVER_TWO_READ" "$B/namedstyles-tests.rs")$(yn body_holds_folded "$COVER_TWO_READ" "$B/namedstyles-tests.rs" "\"$TWO_MSG\"")" = yesyes ])"
    check "control: body_holds says no for the new text in $COVER_TWO_NUM's body unfolded, the string split by its continuation (change ND56)" "$(ynnot body_holds "$COVER_TWO_NUM" "$B/styles-tests.rs" "\"$TWO_MSG\"")"
    check "control: body_holds_folded says no for the old text in $COVER_TWO_NUM's body (change ND56)" "$(ynnot body_holds_folded "$COVER_TWO_NUM" "$B/styles-tests.rs" "\"$TWO_OLD\"")"
    check "control: body_holds says no for the index message in $COVER_NS_NAME's body (change ND56)" "$(ynnot body_holds "$COVER_NS_NAME" "$B/named-style-tests.rs" "\"$INDEX_MSG\"")"
