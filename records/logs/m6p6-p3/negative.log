        "xl/worksheets/sheet1.xml", "rId1", '<c:style val="2"/>', "xl/worksheets/_rels/sheet1.xml.rels",
        "xl/drawings/drawing1.xml", "xl/drawings/_rels/drawing1.xml.rels", "xl/charts/chart1.xml",
        "xl/charts/chart2.xml"]
    ok = ok and [P[k] for k in (4, 5, 6, 7, 8, 9, 10, 11, 12)] == [
        "[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels",
        "xl/worksheets/sheet1.xml", "<sheetData/>", "xl/styles.xml", "<styleSheet/>", "xl/media/image1.bin"]
