    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh, the spec, the ten modules crates/emend/src/package.rs, package/sheet_read.rs, package/survey.rs, package/pivot.rs, package/extlink.rs, package/chart.rs, package/chart_write.rs, cells.rs, styles/read.rs and archive.rs (at the phase commit and at the base; package.rs's catalogue read from both; M6 part 4 P2 added one constant, chart_write.rs's NO_SERIES_AT; changes NC45 and NC53), package/chart_edit.rs (at the phase commit, M6 part 4 P2's module; change NC53), styles/elements.rs (at the phase commit and at the base; change NC55), package/tests/gradient.rs (at the phase commit; change ND55), styles.rs (at the phase commit and at the base; change NC56), package/tests/named_style.rs, styles/tests.rs and package/tests/namedstyles.rs (at the phase commit; change ND56), $SPEC41 (at the phase commit and its working file, for NO_SERIES_AT's quote; change NC55), specs/0035-charts-write-first-set.md, specs/0036-charts-write-second-set.md, specs/0016-new-workbook-and-sheets.md, specs/0038-chartsheets.md and specs/0039-chart-kinds-and-formatting.md (P2SPEC; at the phase commit, for the messages they quote; changes NC44 and NC47), crates/emend/src/package/tests/chart_write.rs, crates/emend/src/package/tests/chartsheet.rs and crates/emend/src/package/tests.rs (at the phase commit), tools/emend-copy/tests/null_rewrite.rs (at the phase commit, for the tool tests' fixtures and lines) and tools/emend-copy/src/main.rs (at the phase commit, for the chart samples' calls and the tool's chart and labels literals; changes ND43 to ND53) are read from it by git show, and the working files of the spec, of specs/0038 and of specs/0039 are hashed or read in it; nothing in it is run, built or written"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m6p6-p3, the phase's directory on the disk; <phase>/logs/gate.log is the gate log this log reads for the binary's hash (change MB); <phase>/logs/size.log is the size log whose release binaries N8's runs take unless the third argument names another (change NE60)"
    echo "root: <scripts> stands for <phase>/scripts, this script's own directory on the disk, which holds the script and, in <scripts>/out, its own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <build> stands for the build root on the disk, <phase>/negative unless NEGATIVE_BUILD names another"
    echo "root: <gatebuild> stands for <phase>/gate (GATE_BUILD_ROOT in a dry run), the gate log's build directory; <gatebuild>/bin/host/emend-copy is the gate's copy of its host debug emend-copy, copied from there and never run in place; read only (change MB)"
    echo "root: <superseded> stands for <phase>/superseded, where a rerun's superseded files are kept; read only"
    echo "root: <scratch>/tmp stands for <build>/tmp, this run's TMPDIR, exported before any mktemp and kept (change MP)"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory, made in <scratch>/tmp, removed by this script at its end (change HC, kept; change MP): <scratch>/w/counting.sh the phase commit's library, sourced; <scratch>/w/bin the copied binary; <scratch>/w/null_rewrite.rs the tool tests' source; <scratch>/w/fx the fictional fixtures (changes NE31 to NE57 and NE60); <scratch>/w/rel the size log's release emend-copy copies, <scratch>/w/out8 N8's outputs and their --survey copies, <scratch>/w/wbcheck.py and <scratch>/w/activetab.py the workbook part's and the tool message's readers (change NE60); <scratch>/w/reach4.py the trend sample's reader, <scratch>/w/c-trend-*.rs its planted copies and <scratch>/w/trend.out, trend-plant.out and c-trend-*.out its outputs (change ND47); <scratch>/w/reach5.py the tool's chart literals' and the axis sample's reader, <scratch>/w/c-axis-*.rs its planted copies and <scratch>/w/axis.out, axis-plant.out and c-axis-*.out its outputs (change ND48); <scratch>/w/reach6.py the tool's chart and labels literals' and the text sample's reader, <scratch>/w/c-text-*.rs its planted copies and <scratch>/w/text.out, text-plant.out and c-text-*.out its outputs (change ND52); <scratch>/w/reach7.py the edit sample's and the tool's chart literals' reader, <scratch>/w/c-edit-*.rs its planted copies and <scratch>/w/edit.out, edit-plant.out and c-edit-*.out its outputs (change ND53); <scratch>/w/now-chart_edit.rs the new module at the phase commit and <scratch>/w/c-edit-msgs.rs its control, <scratch>/w/spec-0041.md M6 part 4's spec at the phase commit and <scratch>/w/series-spec.txt and c-series-new.tsv the message's quote readings (changes NC53 and NC55); <scratch>/w/now-elements.rs, base-elements.rs, their .tsv readings and c-elements-less.tsv the styles composers' constants and their control (change NC55); <scratch>/w/gradient-tests.rs the gradient crate tests' source, <scratch>/w/reach8.py the gradient sample's reader, <scratch>/w/c-grad-*.rs its planted copies and <scratch>/w/grad.out, grad-plant.out and c-grad-*.out its outputs (change ND55); <scratch>/w/all-base-less-name.set the base's set less M6 part 5 P2's constant (change NC57); <scratch>/w/now-styles.rs, base-styles.rs, their .tsv, -less.tsv and .names readings and c-styles.names the styles reader's constants and their control (change NC56); <scratch>/w/p2base-styles.rs and .tsv the styles reader's constants at M6 part 5 P2's base and <scratch>/w/c-styles-old.tsv their control (change NC57); <scratch>/w/p3-code.names and c-p3-code.names the phase's code paths and their control (change ND57); <scratch>/w/named-style-tests.rs, styles-tests.rs and namedstyles-tests.rs the named style crate tests' sources, <scratch>/w/reach9.py the named style sample's reader, <scratch>/w/c-named-*.rs its planted copies and <scratch>/w/named.out, named-plant.out and c-named-*.out its outputs (change ND56); <scratch>/w/sheet-tests.rs the chartsheet crate tests' source (change ND41); <scratch>/w/defined.py the defined-helper check and its planted scripts (change NF41); <scratch>/w/ph-bad, ph-ok and ph-scrub the placeholder check's planted files (change NF42); <scratch>/w/tests.rs the package tests' source (change ND42) and <scratch>/w/spec-0016.md specs/0016 at the phase commit (change NC42); <scratch>/w/main.rs the tool's source, <scratch>/w/reach.py its reader, <scratch>/w/c-reach-*.rs its planted copies and <scratch>/w/reach*.out the reader's outputs (change ND43); <scratch>/w/reach2.py the surface sample's reader, <scratch>/w/c-surf-*.rs its planted copies and <scratch>/w/surf*.out and c-surf-*.out its outputs (change ND44); <scratch>/w/spec-0039.md part 2's spec, P2SPEC, at the phase commit (changes NC44 and NC47); <scratch>/w/reach3.py the format sample's reader, <scratch>/w/c-fmt-*.rs its planted copies and <scratch>/w/fmt.out, fmt-plant.out and c-fmt-*.out its outputs (change ND45); <scratch>/w/out the outputs; the message and catalogue readers, the fixture generator and the captured outputs (*.stdout, *.stderr, *.out)"
    echo "root: <target> stands for <phase>/target, the phase's one target root (specs/0001); this log builds nothing; it reads the size log's release emend-copy, host and i686, from <target>/main (SIZE_BUILD_ROOT in a dry run) and copies each into <scratch>/w/rel (change NE60)"
    echo "root: <close> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change LD, kept)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$BUILD_ROOT" && apart "$SUPERSEDED_DIR" "$MAIN" && apart "$TARGET_DIR" "$BUILD_ROOT" && apart "$TARGET_DIR" "$MAIN" && apart "$TARGET_DIR" "$SELF_DIR" && apart "$GATE_BUILD" "$BUILD_ROOT" && apart "$GATE_BUILD" "$MAIN" && apart "$GATE_BUILD" "$SELF_DIR" && apart "$GATE_BUILD" "$TARGET_DIR"; }
    check "the roots other than <home> and <phase> are distinct, none inside another (<scratch>/w inside <build>)" "$(yn roots_distinct)"
    roots_ctl() { apart "$B" "$BUILD_ROOT"; }
    check "control: apart refuses <scratch>/w against <build>, which holds it" "$(ynnot roots_ctl)"
    # under_tmpdir <dir>: <dir> lies inside TMPDIR (change MP).
    under_tmpdir() { case "$1/" in "$TMPDIR"/?*) return 0 ;; esac; return 1; }
    echo "TMPDIR: <scratch>/tmp; this run's mktemp -d directory: <scratch>/w"
    check "this run's mktemp -d directory lies under TMPDIR (close-out ruling 1)" "$(yn under_tmpdir "$B")"
    check "control: under_tmpdir refuses <build>, which holds TMPDIR" "$(ynnot under_tmpdir "$BUILD_ROOT")"
    check "control: under_tmpdir refuses TMPDIR itself" "$(ynnot under_tmpdir "$TMPDIR")"
    check "control: under_tmpdir refuses a directory outside it, <phase>" "$(ynnot under_tmpdir "$PHASE_DIR")"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs, its records, planning's modified specs/0043 and ROADMAP.md) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT_SHA")"
    short_names_head() { [ "$(git rev-parse "$SHORT_SHA")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_src_ctl() { printf ' M crates/emend/Cargo.toml\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified manifest" "$(ynnot ours_src_ctl)"
    ours_cl_ctl() { printf ' M CHANGELOG.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified CHANGELOG.md" "$(ynnot ours_cl_ctl)"
    ours_readme_ctl() { printf ' M README.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified README.md (change NA42)" "$(ynnot ours_readme_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m6p6-p3/gate.log\n?? records/m6p6-p3-sheet-2026-10-24-%s.md\n?? records/m6p6-p3-sheet-2026-10-24-%s.txt\n?? records/m6p6-p3-chartsheet-2026-10-24-%s.md\n?? records/m6p6-p3-copy-2026-10-24-%s.txt\n?? records/m6p6-open-2026-10-24-%s.md\n?? records/m6p6-open-2026-10-24-%s.txt\n?? records/size-m6p6-2026-10-24-%s.md\n?? records/api-review-m6p6-2026-10-24-%s.md\n M specs/0043-measurement-and-close.md\n M ROADMAP.md\n?? records/logs/m6p6-p2/gate.log\n?? records/logs/m6p6-p3x/gate.log\n?? records/m6p6-p3-sheet-2026-10-24-abcdef0.md\n?? records/m6p6-chartsheet-2026-10-24-%s.md\n?? records/m6p6-p3-2026-10-24-%s.md\n?? records/size-m6p6-2026-10-24-%s.txt\n?? records/api-review-m6p5-2026-10-24-%s.md\n?? specs/0043-measurement-and-close.md\n M specs/0042-gradient-fills-and-named-styles.md\n M README.md\n' "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern admits this phase's log, its untracked sheet, chartsheet, copy and open records, its size record and API listing and planning's modified specs/0043 and ROADMAP.md alone; it refuses P2's log directory, a sibling directory, a record of another commit, P2's chartsheet record stem, a record stem with no sample word, a size record's .txt, part 5's API listing stem, an untracked spec, a modified specs/0042 and a modified README.md (change NA60)" "$(yn [ "$(ours_rec_ctl)" = 11 ])"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_BLOB=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum: $SPEC_BLOB; sha256sum $SPEC (the working file, holding planning's rulings written during M6 part 6 P3 and not yet committed, checked against PLANNING_SPEC; changes NA31 to NA60): $SPEC_HAVE"
    check "the spec's blob at the phase commit is at the hash this log pins" "$(yn [ "$SPEC_BLOB" = "$SPEC_WANT" ])"
    spec_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$SPEC_WANT" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot spec_ctl)"
    # Change NA48: the working file is the one PLANNING_SPEC names.
    working_ok() { [ -n "$PLANNING_SPEC" ] && [ "$SPEC_HAVE" = "$PLANNING_SPEC" ]; }
    check "the working spec is the file PLANNING_SPEC names, planning's rulings during M6 part 6 P3 (changes NA48 and NA60)" "$(yn working_ok)"
    working_ctl() { local PLANNING_SPEC=$SPEC_WANT; working_ok; }
    check "control: the same comparison refuses the committed blob's hash, the working file holding the rulings (change NA48)" "$(ynnot working_ctl)"
    working_unset_ctl() { local PLANNING_SPEC=; working_ok; }
    check "control: the same comparison refuses an unset PLANNING_SPEC (change NA48)" "$(ynnot working_unset_ctl)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    echo
    echo "## the gate's debug emend-copy, copied into <scratch>/w/bin and checked against gate.log (change MB)"
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    gate_log_there() { [ -s "$GATE_LOG" ]; }
    check "the gate log is there and not empty" "$(yn gate_log_there)"
    HASH_FORM='^  <build>/bin/host/emend-copy: sha256 [0-9a-f]{64}, bytes [0-9]+$'
    nhash=$(count_matches -E "$HASH_FORM" "$GATE_LOG")
    GATED=$(sed -n -E 's#^  <build>/bin/host/emend-copy: sha256 ([0-9a-f]{64}), bytes [0-9]+$#\1#p' "$GATE_LOG" | head -n 1)
    echo "command: count_matches -E and sed for the hash line of the gate's host emend-copy copy in the gate log (sha256 $(sha_of "$GATE_LOG")): lines $nhash; hash ${GATED:-none}"
    check "gate.log holds exactly one hash line for its copy <build>/bin/host/emend-copy" "$(yn [ "$nhash" = 1 ])"
    printf '  <build>/bin/host/emend-copy: sha256 %s, bytes 1\n  <build>/bin/i686/emend-copy: sha256 %s, bytes 1\n' \
      "$(printf 'a' | sha256sum | cut -d' ' -f1)" "$(printf 'b' | sha256sum | cut -d' ' -f1)" >"$B/c-gate.log"
    check "control: the same form counts one line in a fixture holding a host and an i686 line" "$(yn [ "$(count_matches -E "$HASH_FORM" "$B/c-gate.log")" = 1 ])"
    echo "command: mkdir <scratch>/w/bin; cp <gatebuild>/bin/host/emend-copy <scratch>/w/bin/emend-copy"
    mkdir "$B/bin" || exit 2
    cp "$GATE_BIN" "$B/bin/emend-copy"
    BIN=$B/bin/emend-copy
    echo "  <scratch>/w/bin/emend-copy: sha256 $(sha_of "$BIN"), bytes $(wc -c <"$BIN")"
    gated_found() { [ -n "$GATED" ]; }
    check "control: the reader found a hash in gate.log" "$(yn gated_found)"
    bin_is_gated() { gated_found && [ "$(sha_of "$BIN")" = "$GATED" ]; }
    check "the copied binary is the one gate.log hashed, not a rebuild" "$(yn bin_is_gated)"
    bin_ctl() { local GATED; GATED=$(printf 'x' | sha256sum | cut -d' ' -f1); bin_is_gated; }
    check "control: the same comparison refuses another hash" "$(ynnot bin_ctl)"
    echo
    echo "## every mktemp call, this script's and the counting library's (ruling 12; change MW, carried as NB3 and NB31 to NB53)"
    MK=mktemp
    # A call is a line that is not a comment holding a command substitution of
    # mktemp; a call in TMPDIR's form takes no argument but -d (no -p, no
    # --tmpdir, no -t and no template), so mktemp puts it in TMPDIR.
    MK_CALL="^[^#]*[$][(]${MK}([[:space:]]|[)])"
    MK_FORM="[$][(]${MK}( -d)?[)]"
    # mk_calls <file>: the calls; mk_bad <file>: the calls not in that form.
    mk_calls() { count_matches -E "$MK_CALL" "$1"; }
    mk_bad() { LC_ALL=C "$G" -E "$MK_CALL" "$1" | LC_ALL=C "$G" -cvE "$MK_FORM"; }
    printf '%s\n' "a=${D}(${MK} -d) || exit 2" "b=${D}(${MK} -p /x)" "# c=${D}(${MK} -p /y)" "d=${D}(${MK})" "echo ${MK} -d" >"$B/c-mktemp"
    for f in "$SELF" "$B/counting.sh"; do
      name=$([ "$f" = "$SELF" ] && echo "this script" || echo "the counting library, <scratch>/w/counting.sh")
      echo "  $name: mktemp calls $(mk_calls "$f"); of them not in TMPDIR's form $(mk_bad "$f")"
      LC_ALL=C "$G" -E "$MK_CALL" "$f" | sed 's/^[[:space:]]*/    /'
    done
    check "this script holds one mktemp call, B's mktemp -d, in TMPDIR's form, and makes no plain file" "$(yn [ "$(mk_calls "$SELF")$(mk_bad "$SELF")" = 10 ])"
    check "the counting library's mktemp calls (one, its controls' directory, removed by it) are each in TMPDIR's form" "$(yn [ "$(mk_bad "$B/counting.sh")" = 0 ])"
    check "control: the same count finds the fixture's three calls, not its comment or its echo" "$(yn [ "$(mk_calls "$B/c-mktemp")" = 3 ])"
    check "control: the same form refuses the fixture's one call with -p" "$(yn [ "$(mk_bad "$B/c-mktemp")" = 1 ])"
    echo "  the library's directory is made after TMPDIR is exported (change MP), so it lies under TMPDIR as <scratch>/w does, whose place is checked above"
    
    echo
    echo "## the messages, read from the phase commit's source (changes NC31 to NC57 and NC60)"
    TAB=$(printf '\t')
    cat >"$B/messages.py" <<'PY'
    """The Error::Package messages of a Rust source file, by constant name, one
    per line as NAME<TAB>message in source order; a constant with or without
    pub(crate). With --name N, only N.
    Usage: messages.py <file.rs> [--name N]."""
    import re
    import sys
    
    text = open(sys.argv[1]).read()
    found = re.findall(r'^(?:pub\(crate\) )?const ([A-Z_0-9]+): Error =\s*Error::Package\(\s*"([^"]*)",?\s*\);',
                       text, re.M)
    args = sys.argv[2:]
    if args[:1] == ["--name"]:
        found = [(n, m) for n, m in found if n == args[1]]
    for n, m in found:
        print("%s\t%s" % (n, m))
    PY
    sed 's/^/    /' "$B/messages.py"
    MODULES="crates/emend/src/package.rs crates/emend/src/package/sheet_read.rs crates/emend/src/package/survey.rs crates/emend/src/package/pivot.rs crates/emend/src/package/extlink.rs crates/emend/src/package/chart.rs crates/emend/src/package/chart_write.rs crates/emend/src/cells.rs crates/emend/src/styles/read.rs crates/emend/src/archive.rs"
    : >"$B/all-now.tsv"
    : >"$B/all-base.tsv"
    # in_base <path>: the base's tree holds the file (git ls-tree prints its
    # name, and nothing for a file it lacks).
    in_base() { [ "$(git ls-tree --name-only "$REC" -- "$1")" = "$1" ]; }
    # in_phase <path>: the phase commit's tree holds the file.
    in_phase() { [ "$(git ls-tree --name-only "$C" -- "$1")" = "$1" ]; }
    echo "command: for each of the ten modules, git show <commit>:<module> at the phase commit and at the base, and python3 -I -B <scratch>/w/messages.py over each copy"
    for f in $MODULES; do
      stem=$(basename "$f" .rs)
      git show "$C:$f" >"$B/now-$stem.rs"
      if in_base "$f"; then git show "$REC:$f" >"$B/base-$stem.rs"; else : >"$B/base-$stem.rs"; fi
      python3 -I -B "$B/messages.py" "$B/now-$stem.rs" >"$B/now-$stem.tsv"
      python3 -I -B "$B/messages.py" "$B/base-$stem.rs" >"$B/base-$stem.tsv"
      cat "$B/now-$stem.tsv" >>"$B/all-now.tsv"
      cat "$B/base-$stem.tsv" >>"$B/all-base.tsv"
      echo "  $f: in the base's tree $(yn in_base "$f"); constants at the phase commit $(count_lines "$B/now-$stem.tsv"), at the base $(count_lines "$B/base-$stem.tsv")"
    done
    all_in_base() { local f; for f in $MODULES; do in_base "$f" || return 1; done; }
    check "the base holds each of the ten modules (changes NC35 to NC53)" "$(yn all_in_base)"
    check "control: in_base says no for a module path no tree holds" "$(ynnot in_base crates/emend/src/planted.rs)"
    # Change NC53: the new module package/chart_edit.rs, at the phase commit
    # and not at the base, holds no Error::Package constant: it raises the
    # chart writer's constants, NO_SERIES_AT among them. Change NC54: M6
    # part 4 P2 added it, so it is at the base and at the phase commit.
    EDIT_RS=crates/emend/src/package/chart_edit.rs
    git show "$C:$EDIT_RS" >"$B/now-chart_edit.rs"
    python3 -I -B "$B/messages.py" "$B/now-chart_edit.rs" >"$B/now-chart_edit.tsv"
    echo "command: git show <phase commit>:$EDIT_RS and python3 -I -B <scratch>/w/messages.py over it (change NC53)"
    echo "  $EDIT_RS: in the base's tree $(yn in_base "$EDIT_RS"); in the phase commit's $(yn in_phase "$EDIT_RS"); constants at the phase commit $(count_lines "$B/now-chart_edit.tsv"); lines naming NO_SERIES_AT $(count_matches -F NO_SERIES_AT "$B/now-chart_edit.rs")"
    edit_module_ok() { in_phase "$EDIT_RS" && in_base "$EDIT_RS" && [ "$(count_lines "$B/now-chart_edit.tsv")" = 0 ] && [ "$(count_matches -F NO_SERIES_AT "$B/now-chart_edit.rs")" -ge 1 ]; }
    check "package/chart_edit.rs, M6 part 4 P2's module, is at the phase commit and at the base, holds no Error::Package constant and raises the writer's NO_SERIES_AT (changes NC53 and NC54)" "$(yn edit_module_ok)"
    printf 'const X: Error = Error::Package("x");\n' >"$B/c-edit-msgs.rs"
    edit_msgs_ctl() { [ "$(python3 -I -B "$B/messages.py" "$B/c-edit-msgs.rs" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same reader finds a planted constant in a copy of the module (change NC53)" "$(yn edit_msgs_ctl)"
    LC_ALL=C sort -u "$B/all-now.tsv" >"$B/all-now.set"
    LC_ALL=C sort -u "$B/all-base.tsv" >"$B/all-base.set"
    echo "  constants with their messages: at the phase commit $(count_lines "$B/all-now.set"); at the base $(count_lines "$B/all-base.set")"
    # Change NC45: the phase adds, removes and rewords no constant (specs/0039
    # "Errors": the range message is part 2 P1's; P1 verification ruling E (d)):
    # the phase commit's set of the ten modules is the base's. Part 2 P1's
    # CHART_VALUE_RANGE, part 1 P1's three constants (NOT_SHEET_ROOT,
    # CHARTSHEET_ANCHOR and ONE_CHART, change NC41) and part 5 P3's two
    # (NO_CHART_AT and CHART_PART_UNREADABLE, change NC39) are each once at
    # both.
    NEW_NAMES="NO_CHART_AT CHART_PART_UNREADABLE"
    NEW3_NAMES="NOT_SHEET_ROOT CHARTSHEET_ANCHOR ONE_CHART"
    NEW3_FORM="^(NOT_SHEET_ROOT|CHARTSHEET_ANCHOR|ONE_CHART)${TAB}"
    RANGE_NAME=CHART_VALUE_RANGE
    RANGE_LINE="${RANGE_NAME}${TAB}a chart value is out of its range"
    LC_ALL=C "$G" -vE "$NEW3_FORM" "$B/all-base.set" >"$B/all-base-less.set"
    LC_ALL=C "$G" -vE "^${RANGE_NAME}${TAB}" "$B/all-base.set" >"$B/all-base-less-range.set"
    n3_now=$(count_matches -E "$NEW3_FORM" "$B/all-now.set")
    n3_base=$(count_matches -E "$NEW3_FORM" "$B/all-base.set")
    nr_now=$(count_matches -xF "$RANGE_LINE" "$B/all-now.set")
    nr_base=$(count_matches -xF "$RANGE_LINE" "$B/all-base.set")
    echo "  part 1 P1's three constants: at the phase commit $n3_now; at the base $n3_base (change NC42)"
    echo "  part 2 P1's constant $RANGE_NAME with its message: at the phase commit $nr_now; at the base $nr_base (change NC45)"
    # Change NC53: M6 part 4 P2 added one constant, chart_write.rs's
    # NO_SERIES_AT (specs/0041 "Errors"). Change NC54: the base, P2's
    # record commit, holds it; this phase adds, removes and rewords none, so
    # the phase commit's set is the base's, that line once at each.
    NO_SERIES_NAME=NO_SERIES_AT
    NO_SERIES_MSG=$(awk -F"$TAB" -v n="$NO_SERIES_NAME" '$1 == n { print $2 }' "$B/now-chart_write.tsv")
    printf '%s\t%s\n' "$NO_SERIES_NAME" "$NO_SERIES_MSG" | LC_ALL=C sort -u - "$B/all-base.set" >"$B/all-base-plus.set"
    ns_now=$(count_matches -E "^${NO_SERIES_NAME}${TAB}" "$B/all-now.set")
    ns_base=$(count_matches -E "^${NO_SERIES_NAME}${TAB}" "$B/all-base.set")
    echo "  M6 part 4 P2's constant $NO_SERIES_NAME, its message \"$NO_SERIES_MSG\": at the phase commit $ns_now; at the base $ns_base (changes NC53 and NC54)"
    LC_ALL=C "$G" -vE "^${NO_SERIES_NAME}${TAB}" "$B/all-base.set" >"$B/all-base-less-series.set"
    # Change NC56: M6 part 5 P2 added one constant to the ten modules,
    # package.rs's STYLE_NAME_REFUSED (specs/0042 "Errors", the name message).
    # Change NC57: part 5 P3's base held it. Change NC60 (specs/0043 ruling
    # M): this phase removes one constant, package.rs's NO_RELATIONSHIPS_PREFIX,
    # and adds and rewords none, so the phase commit's set is the base's less
    # that line; STYLE_NAME_REFUSED once at each.
    NAME_NAME=STYLE_NAME_REFUSED
    NAME_MSG=$(awk -F"$TAB" -v n="$NAME_NAME" '$1 == n { print $2 }' "$B/now-package.tsv")
    LC_ALL=C "$G" -vE "^${NAME_NAME}${TAB}" "$B/all-base.set" >"$B/all-base-less-name.set"
    LC_ALL=C "$G" -vE "^NO_RELATIONSHIPS_PREFIX${TAB}" "$B/all-base.set" >"$B/all-base-less-prefix.set"
    nn_now=$(count_matches -E "^${NAME_NAME}${TAB}" "$B/all-now.set")
    nn_base=$(count_matches -E "^${NAME_NAME}${TAB}" "$B/all-base.set")
    np_now=$(count_matches -E "^NO_RELATIONSHIPS_PREFIX${TAB}" "$B/all-now.set")
    np_base=$(count_matches -E "^NO_RELATIONSHIPS_PREFIX${TAB}" "$B/all-base.set")
    echo "  M6 part 5 P2's constant $NAME_NAME, its message \"$NAME_MSG\": at the phase commit $nn_now; at the base $nn_base (changes NC56 and NC57)"
    echo "  NO_RELATIONSHIPS_PREFIX: at the phase commit $np_now; at the base $np_base (specs/0043 ruling M; change NC60)"
    same_messages() { [ "$(count_lines "$B/all-base.set")" -ge 1 ] && [ "$NO_SERIES_MSG" = "no series at that position" ] && [ "$NAME_MSG" = "a style name is empty, too long or taken" ] && cmp -s "$B/all-now.set" "$B/all-base-less-prefix.set"; }
    check "the phase removes one Error::Package constant of the ten modules and adds and rewords none: the phase commit's set is the base's less package.rs's NO_RELATIONSHIPS_PREFIX, M6 part 5 P2's $NAME_NAME \"a style name is empty, too long or taken\" and M6 part 4 P2's $NO_SERIES_NAME \"no series at that position\" among them (specs/0043 ruling M; change NC60)" "$(yn same_messages)"
    check "NO_RELATIONSHIPS_PREFIX is once at the base and not at the phase commit (ruling M; change NC60)" "$(yn [ "$np_now$np_base" = 01 ])"
    check "$NAME_NAME is once at the phase commit and once at the base (change NC57)" "$(yn [ "$nn_now$nn_base" = 11 ])"
    check "$NO_SERIES_NAME is once at the phase commit and once at the base (change NC54)" "$(yn [ "$ns_now$ns_base" = 11 ])"
    base_less_ctl() { cmp -s "$B/all-now.set" "$B/all-base-less-series.set"; }
    check "control: the same comparison refuses the base's set less $NO_SERIES_NAME's line (change NC54)" "$(ynnot base_less_ctl)"
    base_less_name_ctl() { cmp -s "$B/all-now.set" "$B/all-base-less-name.set"; }
    check "control: the same comparison refuses the base's set less $NAME_NAME's line (change NC57)" "$(ynnot base_less_name_ctl)"
    base_as_is_ctl() { cmp -s "$B/all-now.set" "$B/all-base.set"; }
    check "control: the same comparison refuses the base's set as it is, NO_RELATIONSHIPS_PREFIX's line in it (change NC60)" "$(ynnot base_as_is_ctl)"
    # Change NC55: the styles composers' module, styles/elements.rs, outside
    # the ten (its two constants are raised at the call, not by a part read):
    # this phase changes it (the gradient's composer and checks) and adds,
    # removes and rewords none of its constants. FIELD_OUT_OF_RANGE is the
    # gradient's refusal (specs/0042 "Errors"), N18's and N19's message below.
    ELEM_RS=crates/emend/src/styles/elements.rs
    git show "$C:$ELEM_RS" >"$B/now-elements.rs"
    git show "$REC:$ELEM_RS" >"$B/base-elements.rs"
    python3 -I -B "$B/messages.py" "$B/now-elements.rs" >"$B/now-elements.tsv"
    python3 -I -B "$B/messages.py" "$B/base-elements.rs" >"$B/base-elements.tsv"
    echo "command: git show <commit>:$ELEM_RS at the phase commit and at the base, and python3 -I -B <scratch>/w/messages.py over each copy (change NC55)"
    sed 's/^/    phase commit: /' "$B/now-elements.tsv"
    sed 's/^/    base: /' "$B/base-elements.tsv"
    FIELD_NAME=FIELD_OUT_OF_RANGE
    FIELD_MSG=$(awk -F"$TAB" -v n="$FIELD_NAME" '$1 == n { print $2 }' "$B/now-elements.tsv")
    # emsg <NAME>: the error line of a styles/elements.rs constant, as msg
    # gives one of the ten modules'.
    emsg() { awk -F"$TAB" -v n="$1" '$1 == n { print "error: " $2 }' "$B/now-elements.tsv"; }
    elements_same() { [ "$(count_lines "$B/now-elements.tsv")" = 2 ] && cmp -s "$B/now-elements.tsv" "$B/base-elements.tsv" && [ "$FIELD_MSG" = "a style field is out of range" ]; }
    check "styles/elements.rs holds the same two constants at the phase commit and at the base, FONT_NAME_REFUSED and $FIELD_NAME \"a style field is out of range\": the phase adds, removes and rewords none (change NC55)" "$(yn elements_same)"
    LC_ALL=C "$G" -vE "^${FIELD_NAME}${TAB}" "$B/base-elements.tsv" >"$B/c-elements-less.tsv"
    elements_ctl() { cmp -s "$B/now-elements.tsv" "$B/c-elements-less.tsv"; }
    check "control: the same comparison refuses the base's constants less $FIELD_NAME's line (change NC55)" "$(ynnot elements_ctl)"
    # tmsg <NAME>: a constant's message from the ten modules' set at the
    # phase commit, the name there once: the typed read's STYLE_UNREADABLE
    # (styles/read.rs) and the collection message NEEDS_COLLECTION
    # (package.rs), N16's and N17's below.
    tmsg() { [ "$(count_matches -E "^$1${TAB}" "$B/all-now.set")" = 1 ] && awk -F"$TAB" -v n="$1" '$1 == n { print $2 }' "$B/all-now.set"; }
    STYLE_UNREAD_MSG=$(tmsg STYLE_UNREADABLE)
    COLLECTION_MSG=$(tmsg NEEDS_COLLECTION)
    echo "  STYLE_UNREADABLE: \"$STYLE_UNREAD_MSG\"; NEEDS_COLLECTION: \"$COLLECTION_MSG\" (each once in the ten modules' set at the phase commit; change NC55)"
    check "STYLE_UNREADABLE and NEEDS_COLLECTION are each once in the ten modules at the phase commit, with the messages specs/0027 and specs/0017 name (change NC55)" "$(yn [ "$STYLE_UNREAD_MSG|$COLLECTION_MSG" = "a style cannot be read|a style addition needs a collection the styles part lacks" ])"
    tmsg_ctl() { [ -z "$(tmsg PLANTED_NAME)" ]; }
    check "control: tmsg gives nothing for a constant the modules do not hold (change NC55)" "$(yn tmsg_ctl)"
    emsg_ctl() { [ -z "$(emsg PLANTED_NAME)" ] && [ "$(emsg "$FIELD_NAME")" = "error: a style field is out of range" ]; }
    check "control: emsg gives nothing for a constant the module does not hold, and $FIELD_NAME's error line for its own (change NC55)" "$(yn emsg_ctl)"
    # Change NC56: the styles reader's module, styles.rs, outside the ten (its
    # constants are read with the part, as package.rs's are, but it stood
    # outside the set since specs/0012): the same four constant names at the
    # phase commit and the base, every message the base's but TWO_CONTAINERS's,
    # which ruling Q rewords to name the two named-style containers. N23's
    # message below is its new text, read by smsg. Change NC57: M6 part 5 P2
    # reworded it, so the base holds the new text and the phase commit's four
    # are the base's as they are; the old text is read from M6 part 5 P2's
    # base, P1's record commit.
    STYLES_RS=crates/emend/src/styles.rs
    git show "$C:$STYLES_RS" >"$B/now-styles.rs"
    git show "$REC:$STYLES_RS" >"$B/base-styles.rs"
    python3 -I -B "$B/messages.py" "$B/now-styles.rs" >"$B/now-styles.tsv"
    python3 -I -B "$B/messages.py" "$B/base-styles.rs" >"$B/base-styles.tsv"
    echo "command: git show <commit>:$STYLES_RS at the phase commit and at the base, and python3 -I -B <scratch>/w/messages.py over each copy (change NC56)"
    sed 's/^/    phase commit: /' "$B/now-styles.tsv"
    sed 's/^/    base: /' "$B/base-styles.tsv"
    TWO_NAME=TWO_CONTAINERS
    TWO_MSG=$(awk -F"$TAB" -v n="$TWO_NAME" '$1 == n { print $2 }' "$B/now-styles.tsv")
    TWO_BASE=$(awk -F"$TAB" -v n="$TWO_NAME" '$1 == n { print $2 }' "$B/base-styles.tsv")
    git show "$P2BASE:$STYLES_RS" >"$B/p2base-styles.rs"
    python3 -I -B "$B/messages.py" "$B/p2base-styles.rs" >"$B/p2base-styles.tsv"
    echo "command: git show <M6 part 5 P2's base>:$STYLES_RS and python3 -I -B <scratch>/w/messages.py over it (change NC57)"
    sed 's/^/    the base of M6 part 5 P2: /' "$B/p2base-styles.tsv"
    TWO_OLD=$(awk -F"$TAB" -v n="$TWO_NAME" '$1 == n { print $2 }' "$B/p2base-styles.tsv")
    TWO_WANT="the styles part has more than one numFmts, fonts, fills, borders, cellStyleXfs, cellXfs or cellStyles"
    TWO_OLD_WANT="the styles part has more than one numFmts, fonts, fills, borders or cellXfs"
    # smsg <NAME>: the error line of a styles.rs constant at the phase commit.
    smsg() { awk -F"$TAB" -v n="$1" '$1 == n { print "error: " $2 }' "$B/now-styles.tsv"; }
    LC_ALL=C "$G" -vE "^${TWO_NAME}${TAB}" "$B/now-styles.tsv" >"$B/now-styles-less.tsv"
    LC_ALL=C "$G" -vE "^${TWO_NAME}${TAB}" "$B/base-styles.tsv" >"$B/base-styles-less.tsv"
    cut -f1 "$B/now-styles.tsv" >"$B/now-styles.names"
    cut -f1 "$B/base-styles.tsv" >"$B/base-styles.names"
    styles_names_same() { [ "$(count_lines "$B/now-styles.names")" = 4 ] && cmp -s "$B/now-styles.names" "$B/base-styles.names"; }
    check "styles.rs holds the same four constant names at the phase commit and at the base, in the same order, $TWO_NAME among them (change NC56)" "$(yn styles_names_same)"
    styles_others_same() { [ "$(count_lines "$B/now-styles-less.tsv")" = 3 ] && cmp -s "$B/now-styles-less.tsv" "$B/base-styles-less.tsv"; }
    check "styles.rs's three other constants keep the base's messages (change NC56)" "$(yn styles_others_same)"
    echo "  $TWO_NAME at the phase commit: \"$TWO_MSG\"; at the base: \"$TWO_BASE\"; at M6 part 5 P2's base: \"$TWO_OLD\" (ruling Q; changes NC56 and NC57)"
    check "$TWO_NAME's message at the phase commit and at the base is ruling Q's text, naming cellStyleXfs and cellStyles, and at M6 part 5 P2's base the old text of five containers (changes NC56 and NC57)" "$(yn [ "$TWO_MSG|$TWO_BASE|$TWO_OLD" = "$TWO_WANT|$TWO_WANT|$TWO_OLD_WANT" ])"
    styles_as_base() { cmp -s "$B/now-styles.tsv" "$1"; }
    check "the phase commit's styles.rs constants are the base's as they are: this phase rewords none (change NC57)" "$(yn styles_as_base "$B/base-styles.tsv")"
    check "control: the same comparison refuses M6 part 5 P2's base's, $TWO_NAME's old text (change NC57)" "$(ynnot styles_as_base "$B/p2base-styles.tsv")"
    cp "$B/p2base-styles.tsv" "$B/c-styles-old.tsv"
    check "control: the same comparison refuses a copy of it, read again (change NC57)" "$(ynnot styles_as_base "$B/c-styles-old.tsv")"
    printf 'PLANTED\tplanted\n' | cat - "$B/now-styles.names" >"$B/c-styles.names"
    styles_names_ctl() { cmp -s "$B/c-styles.names" "$B/base-styles.names"; }
    check "control: the names comparison refuses a set with a planted name (change NC56)" "$(ynnot styles_names_ctl)"
    smsg_ctl() { [ -z "$(smsg PLANTED_NAME)" ] && [ "$(smsg "$TWO_NAME")" = "error: $TWO_WANT" ]; }
    check "control: smsg gives nothing for a constant the module does not hold, and $TWO_NAME's new error line for its own (change NC56)" "$(yn smsg_ctl)"
    # The two other messages ruling X's cases meet, from the ten modules' set
    # at the phase commit by tmsg: the index message, STYLE_OUT_OF_RANGE
    # (package.rs), N21's, and the differential style's field message,
    # DXF_FIELD (package.rs, the feature rules), named by the statements.
    INDEX_MSG=$(tmsg STYLE_OUT_OF_RANGE)
    DXF_FIELD_MSG=$(tmsg DXF_FIELD)
    echo "  STYLE_OUT_OF_RANGE: \"$INDEX_MSG\"; DXF_FIELD: \"$DXF_FIELD_MSG\" (each once in the ten modules' set at the phase commit; change NC56)"
    check "STYLE_OUT_OF_RANGE and DXF_FIELD are each once in the ten modules at the phase commit, with the messages specs/0012 and specs/0020 name (change NC56)" "$(yn [ "$INDEX_MSG|$DXF_FIELD_MSG" = "a style index is out of range|a differential style holds a field this part does not write" ])"
    check "$RANGE_NAME is once at the phase commit and once at the base, with the message specs/0039 names (change NC45)" "$(yn [ "$nr_now$nr_base" = 11 ])"
    check "part 1 P1's three constants NOT_SHEET_ROOT, CHARTSHEET_ANCHOR and ONE_CHART are each once at the phase commit and at the base (change NC42)" "$(yn [ "$n3_now$n3_base" = 33 ])"
    each_once() {
      local name
      for name in $NEW_NAMES; do
        [ "$(count_matches -E "^${name}${TAB}" "$B/all-now.set")$(count_matches -E "^${name}${TAB}" "$B/all-base.set")" = 11 ] || return 1
      done
    }
    check "part 5 P3's two constants NO_CHART_AT and CHART_PART_UNREADABLE are each once at the phase commit and at the base, by name (changes NC40 to NC42)" "$(yn each_once)"
    printf 'PLANTED\tplanted\n' | LC_ALL=C sort -u - "$B/all-now.set" >"$B/c-now-plus.set"
    plant_ctl() { cmp -s "$B/c-now-plus.set" "$B/all-base-plus.set"; }
    check "control: the same comparison refuses a set with a planted constant" "$(ynnot plant_ctl)"
    range_ctl() { cmp -s "$B/all-now.set" "$B/all-base-less-range.set"; }
    check "control: the same comparison refuses the base's set less part 2 P1's line (change NC45)" "$(ynnot range_ctl)"
    whole_ctl() { cmp -s "$B/all-now.set" "$B/all-base-less.set"; }
    check "control: the same comparison refuses the base's set less part 1 P1's three constants (changes NC42 and NC45)" "$(ynnot whole_ctl)"
    # Change NC32, kept by NC34 and NC35: chart.rs is in the base since part 3
    # P1 and among the ten above; its one constant keeps the base's message.
    echo "command: <scratch>/w/now-chart.tsv and <scratch>/w/base-chart.tsv, written by the loop above (crates/emend/src/package/chart.rs at the phase commit and at the base)"
    sed 's/^/    /' "$B/now-chart.tsv"
    nchart=$(count_lines "$B/now-chart.tsv")
    CHART_TEXT=$(awk -F"$TAB" '$1 == "CHART_UNREADABLE" { print $2 }' "$B/now-chart.tsv")
    CHART_BASE=$(awk -F"$TAB" '$1 == "CHART_UNREADABLE" { print $2 }' "$B/base-chart.tsv")
    chart_one() { [ "$nchart" = 1 ] && [ -n "$CHART_TEXT" ] && [ "$CHART_TEXT" = "$CHART_BASE" ]; }
    check "the chart module holds exactly one Error::Package constant, CHART_UNREADABLE, with the message the base's chart.rs holds (change NC32)" "$(yn chart_one)"
    chart_ctl() { local CHART_BASE=planted; chart_one; }
    check "control: the same test refuses a planted base message" "$(ynnot chart_ctl)"
    printf 'const A: Error = Error::Package("x");\npub(crate) const B: Error =\n    Error::Package("two");\nconst C: Error = Error::Package(\n    "three",\n);\n' >"$B/c-msgs.rs"
    python3 -I -B "$B/messages.py" "$B/c-msgs.rs" --name B >"$B/c-name.tsv"
    python3 -I -B "$B/messages.py" "$B/c-msgs.rs" --name C >>"$B/c-name.tsv"
    check "control: --name takes the one constant named, pub(crate) and wrapped or multi-line" "$(yn [ "$(cut -f2 "$B/c-name.tsv" | tr '\n' ' ')" = "two three " ])"
    # Change NC35: the part's module, chart_write.rs, in the base since P1 and
    # among the ten above, holds the part's four messages; changes NC39 to
    # NC41: and P3's two and this phase's three, and no other constant.
    WRITE_RS=crates/emend/src/package/chart_write.rs
    cp "$B/now-chart_write.tsv" "$B/part.tsv"
    echo "command: <scratch>/w/now-chart_write.tsv, written by the loop above ($WRITE_RS at the phase commit; change NC35)"
    sed 's/^/    /' "$B/part.tsv"
    check "the base's tree and the phase commit's each hold $WRITE_RS (change NC35)" "$(yn [ "$(yn in_base "$WRITE_RS")$(yn in_phase "$WRITE_RS")" = yesyes ])"
    PART_NAMES="CHART_TEXT_INVALID CHART_OPTION_KIND CHART_SIZE_ANCHOR CHART_ANCHOR_OUT_OF_RANGE"
    part_names() { cut -f1 "$B/part.tsv" | LC_ALL=C sort | tr '\n' ' '; }
    PART_WANT=$(printf '%s\n' $PART_NAMES $NEW_NAMES $NEW3_NAMES $RANGE_NAME $NO_SERIES_NAME | LC_ALL=C sort | tr '\n' ' ')
    part_four() { [ "$(count_lines "$B/part.tsv")" = 11 ] && [ "$(part_names)" = "$PART_WANT" ] && [ "$(awk -F"$TAB" '$2 == "" { n++ } END { print n + 0 }' "$B/part.tsv")" = 0 ]; }
    check "chart_write.rs holds exactly the four constants of the part, CHART_TEXT_INVALID, CHART_OPTION_KIND, CHART_SIZE_ANCHOR and CHART_ANCHOR_OUT_OF_RANGE, P3's two, NO_CHART_AT and CHART_PART_UNREADABLE, part 1 P1's three, NOT_SHEET_ROOT, CHARTSHEET_ANCHOR and ONE_CHART, part 2 P1's CHART_VALUE_RANGE and this phase's NO_SERIES_AT, none empty (changes NC34, NC35, NC39 to NC42, NC44, NC45 and NC53)" "$(yn part_four)"
    part_ctl() { local PART_WANT="CHARTSHEET_ANCHOR CHART_ANCHOR_OUT_OF_RANGE CHART_OPTION_KIND CHART_PART_UNREADABLE CHART_SIZE_ANCHOR CHART_VALUE_RANGE NOT_SHEET_ROOT NO_CHART_AT NO_SERIES_AT ONE_CHART PLANTED "; part_four; }
    check "control: the same test refuses a planted name in place of one of the eleven (changes NC44 and NC53)" "$(ynnot part_ctl)"
    # Change NC37 (from NC35 and NC36; P1 verification ruling G): each of the
    # four is a list item of the package header's catalogue at the phase commit
    # and at the base alike: part 4 P2 wrote the catalogue, and this phase adds
    # no message (the catalogue for this part is P3's). Read as the crate's
    # catalogue test reads a list item.
    cat >"$B/catalogue.py" <<'PY'
    """The messages a Rust source file's catalogue lists: each //! line whose
    text, trimmed, starts '- "', its string read to the closing quote, the
    escaped brackets unescaped, one per line, as the crate's catalogue test
    reads them.
    Usage: catalogue.py <file.rs>."""
    import re
    import sys
    
    for line in open(sys.argv[1]):
        m = re.match(r'^\s*//!\s*- "((?:[^"\\]|\\.)*)"', line)
        if m:
            print(m.group(1).replace("\\[", "[").replace("\\]", "]"))
    PY
    sed 's/^/    /' "$B/catalogue.py"
    python3 -I -B "$B/catalogue.py" "$B/now-package.rs" >"$B/cat-now.txt"
    python3 -I -B "$B/catalogue.py" "$B/base-package.rs" >"$B/cat-base.txt"
    echo "command: python3 -I -B <scratch>/w/catalogue.py over crates/emend/src/package.rs at the phase commit and at the base: list items $(count_lines "$B/cat-now.txt") and $(count_lines "$B/cat-base.txt") (changes NC36 and NC37)"
    # in_catalogue <NAME> <list>: the constant's message is one whole line of
    # the list.
    in_catalogue() { local m; m=$(awk -F"$TAB" -v n="$1" '$1 == n { print $2 }' "$B/part.tsv"); [ -n "$m" ] && [ "$(count_matches -xF "$m" "$2")" = 1 ]; }
    for name in $PART_NAMES; do
      echo "  $name: in the catalogue at the phase commit $(yn in_catalogue "$name" "$B/cat-now.txt"); at the base $(yn in_catalogue "$name" "$B/cat-base.txt")"
      check "$name's message is a list item of the package header's catalogue at the phase commit, once, and at the base, once (changes NC36 and NC37; P1 verification ruling G)" "$(yn [ "$(yn in_catalogue "$name" "$B/cat-now.txt")$(yn in_catalogue "$name" "$B/cat-base.txt")" = yesyes ])"
    done
    # Changes NC39 and NC40: each of P3's two constants is a list item of the
    # catalogue at the phase commit and at the base, once each.
    for name in $NEW_NAMES; do
      echo "  $name: in the catalogue at the phase commit $(yn in_catalogue "$name" "$B/cat-now.txt"); at the base $(yn in_catalogue "$name" "$B/cat-base.txt")"
      check "$name's message is a list item of the package header's catalogue at the phase commit, once, and at the base, once (changes NC39 and NC40)" "$(yn [ "$(yn in_catalogue "$name" "$B/cat-now.txt")$(yn in_catalogue "$name" "$B/cat-base.txt")" = yesyes ])"
    done
    # Change NC42: each of part 1 P1's three constants is a list item of the
    # catalogue at the phase commit and at the base, once each (change NC41
    # added them at P1).
    for name in $NEW3_NAMES; do
      echo "  $name: in the catalogue at the phase commit $(yn in_catalogue "$name" "$B/cat-now.txt"); at the base $(yn in_catalogue "$name" "$B/cat-base.txt")"
      check "$name's message is a list item of the package header's catalogue at the phase commit and at the base, once each (changes NC41 and NC42)" "$(yn [ "$(yn in_catalogue "$name" "$B/cat-now.txt")$(yn in_catalogue "$name" "$B/cat-base.txt")" = yesyes ])"
    done
    # Change NC45: part 2 P1's constant is a list item of the package header's
    # catalogue at the phase commit and at the base, once each (part 2 P2
    # extended its entry's text and added no second entry, P1 verification
    # ruling E (d); change NC46: part 2 P3 left package.rs as the base had
    # it; change NC47: part 3 P1 changed package.rs's charts re-export list
    # alone, not its catalogue; change NC48: part 3 P2 changed that list
    # and the header's charts limits paragraph, not its catalogue; change
    # NC52: M6 part 4 P1 changed that list alone, not its catalogue; change
    # NC53: this phase adds that list's ChartSeriesEdit and the catalogue's
    # entry for its one message, below, and leaves part 2 P1's entry).
    echo "  $RANGE_NAME: in the catalogue at the phase commit $(yn in_catalogue "$RANGE_NAME" "$B/cat-now.txt"); at the base $(yn in_catalogue "$RANGE_NAME" "$B/cat-base.txt")"
    check "$RANGE_NAME's message is a list item of the package header's catalogue at the phase commit and at the base, once each (changes NC44 and NC45; ruling E (d))" "$(yn [ "$(yn in_catalogue "$RANGE_NAME" "$B/cat-now.txt")$(yn in_catalogue "$RANGE_NAME" "$B/cat-base.txt")" = yesyes ])"
    check "control: in_catalogue says no for a constant the module does not hold" "$(ynnot in_catalogue PLANTED_NAME "$B/cat-now.txt")"
    # Change NC53: M6 part 4 P2's constant is a list item of the package
    # header's catalogue; change NC54: at the phase commit and at the base.
    echo "  $NO_SERIES_NAME: in the catalogue at the phase commit $(yn in_catalogue "$NO_SERIES_NAME" "$B/cat-now.txt"); at the base $(yn in_catalogue "$NO_SERIES_NAME" "$B/cat-base.txt")"
    check "$NO_SERIES_NAME's message is a list item of the package header's catalogue at the phase commit and at the base (changes NC53 and NC54)" "$(yn [ "$(yn in_catalogue "$NO_SERIES_NAME" "$B/cat-now.txt")$(yn in_catalogue "$NO_SERIES_NAME" "$B/cat-base.txt")" = yesyes ])"
    awk -v m="$(awk -F"$TAB" '$1 == "CHART_TEXT_INVALID" { print $2 }' "$B/part.tsv")" '$0 != m' "$B/cat-base.txt" >"$B/c-cat-base.txt"
    check "control: in_catalogue says no for CHART_TEXT_INVALID against the base's list with its line removed (change NC36)" "$(ynnot in_catalogue CHART_TEXT_INVALID "$B/c-cat-base.txt")"
    printf '//! - "a planted \\[message\\]" (`some_test`).\n//! "not a list item"\n' >"$B/c-cat.rs"
    cat_ctl() { [ "$(python3 -I -B "$B/catalogue.py" "$B/c-cat.rs")" = "a planted [message]" ]; }
    check "control: catalogue.py reads a list item, its brackets unescaped, and not a plain doc line" "$(yn cat_ctl)"
    # Change NC56: the new message and the containers' new text are list items
    # of the package header's catalogue at the phase commit, once each, and not
    # at the base; the containers' old text is one at the base and not at the
    # phase commit. Change NC57: M6 part 5 P2 added both, so they are list items
    # at the phase commit and at the base, once each, and the old text at
    # neither.
    cat_once() { [ "$(count_matches -xF "$1" "$2")" = 1 ]; }
    echo "  $NAME_NAME: in the catalogue at the phase commit $(yn cat_once "$NAME_MSG" "$B/cat-now.txt"); at the base $(yn cat_once "$NAME_MSG" "$B/cat-base.txt")"
    echo "  $TWO_NAME's new text: in the catalogue at the phase commit $(yn cat_once "$TWO_MSG" "$B/cat-now.txt"); at the base $(yn cat_once "$TWO_MSG" "$B/cat-base.txt"); its old text at the phase commit $(yn cat_once "$TWO_OLD" "$B/cat-now.txt"); at the base $(yn cat_once "$TWO_OLD" "$B/cat-base.txt")"
    check "$NAME_NAME's message is a list item of the package header's catalogue at the phase commit and at the base, once each (changes NC56 and NC57)" "$(yn [ "$(yn cat_once "$NAME_MSG" "$B/cat-now.txt")$(yn cat_once "$NAME_MSG" "$B/cat-base.txt")" = yesyes ])"
    check "$TWO_NAME's new text is a list item of the catalogue at the phase commit and at the base, once each, and its old text at neither (ruling Q; changes NC56 and NC57)" "$(yn [ "$(yn cat_once "$TWO_MSG" "$B/cat-now.txt")$(yn cat_once "$TWO_MSG" "$B/cat-base.txt")$(yn cat_once "$TWO_OLD" "$B/cat-now.txt")$(yn cat_once "$TWO_OLD" "$B/cat-base.txt")" = yesyesnono ])"
    check "control: cat_once says no for a planted message (change NC56)" "$(ynnot cat_once "a planted message" "$B/cat-now.txt")"
    : >"$B/known.tsv"
    # Change NC37: N3's message and part 1's three are read beside N1's and N2's.
    KNOWN="DRAWING_UNREADABLE TWO_DRAWINGS NO_SUCH_PART CELL_EDIT_REPLACED REMOVED_PART_EDITED"
    for name in $KNOWN; do
      python3 -I -B "$B/messages.py" "$B/now-package.rs" --name "$name" >>"$B/known.tsv"
    done
    echo "command: python3 -I -B <scratch>/w/messages.py <scratch>/w/now-package.rs --name <NAME>, for each of $KNOWN (at the phase commit; changes NC34 to NC37)"
    sed 's/^/    /' "$B/known.tsv"
    nknown=$(count_lines "$B/known.tsv")
    nempty=$(awk -F"$TAB" '$2 == "" { n++ } END { print n + 0 }' "$B/known.tsv")
    # Change NC39: N5's message, the reader's CHART_UNREADABLE (ruling N), read
    # from chart.rs at the phase commit after the five.
    python3 -I -B "$B/messages.py" "$B/now-chart.rs" --name CHART_UNREADABLE >>"$B/known.tsv"
    echo "command: python3 -I -B <scratch>/w/messages.py <scratch>/w/now-chart.rs --name CHART_UNREADABLE (change NC39)"
    sed 's/^/    /' "$B/known.tsv"
    nknown=$(count_lines "$B/known.tsv")
    nempty=$(awk -F"$TAB" '$2 == "" { n++ } END { print n + 0 }' "$B/known.tsv")
    KNOWN6="$KNOWN CHART_UNREADABLE"
    known_ok() { [ "$nknown" = 6 ] && [ "$nempty" = 0 ] && [ "$(cut -f1 "$B/known.tsv" | tr '\n' ' ')" = "$KNOWN6 " ]; }
    check "the six messages read apart, N1's and N2's, N3's, part 1's three and N5's, are each read once, in order, not empty (changes NC37 and NC39)" "$(yn known_ok)"
    known_ctl() { local KNOWN6="DRAWING_UNREADABLE TWO_DRAWINGS NO_SUCH_PART CELL_EDIT_REPLACED REMOVED_PART_EDITED PLANTED_NAME"; known_ok; }
    check "control: known_ok refuses a planted name in place of one of the six" "$(ynnot known_ctl)"
    chart_known() { [ "$(awk -F"$TAB" '$1 == "CHART_UNREADABLE" { print $2 }' "$B/known.tsv")" = "$CHART_TEXT" ]; }
    check "N5's message read apart is the chart module's one constant read above, CHART_UNREADABLE (change NC39)" "$(yn chart_known)"
    # msg <NAME>: the message the source holds for the constant, as the tool
    # prints it.
    msg() { awk -F"$TAB" -v n="$1" '$1 == n { print "error: " $2 }' "$B/known.tsv"; }
    msg_ctl() { [ -z "$(msg PLANTED_NAME)" ]; }
    check "control: msg gives nothing for a constant the source does not hold" "$(yn msg_ctl)"
    # Change NC37: specs/0036 quotes three of the four call messages and none
    # of the drawing or part 1 messages ("At the write, the drawing's messages
    # as part 4 says"); specs/0035 at the phase commit quotes N1's to N3's and
    # the four. Part 1's three are printed, not asserted. Change NC41: specs/0036
    # is read at the phase commit; specs/0038, committed and working, quotes
    # this phase's three.
    PART4_SPEC=specs/0035-charts-write-first-set.md
    # Change NC41: part 5's spec, read at the phase commit for the messages it
    # quotes; the committed and the working files read are specs/0038's.
    PART5_SPEC=specs/0036-charts-write-second-set.md
    git show "$C:$P1SPEC" >"$B/spec-committed.md"
    git show "$C:$PART4_SPEC" >"$B/spec-part4.md"
    git show "$C:$PART5_SPEC" >"$B/spec-part5.md"
    cat "$B/known.tsv" "$B/part.tsv" >"$B/quoted.tsv"
    python3 -I -B - "$B/quoted.tsv" "$B/spec-part4.md" "$B/spec-part5.md" "$B/spec-committed.md" "$P1SPEC" >"$B/in-spec.tsv" <<'PY'
    import re
    import sys
    part4 = re.sub(r"\s+", " ", open(sys.argv[2]).read())
    part5 = re.sub(r"\s+", " ", open(sys.argv[3]).read())
    committed = re.sub(r"\s+", " ", open(sys.argv[4]).read())
    working = re.sub(r"\s+", " ", open(sys.argv[5]).read())
    for line in open(sys.argv[1]):
        name, message = line.rstrip("\n").split("\t", 1)
        print("%s\tspec0035=%s\tspec0036=%s\tcommitted=%s\tworking=%s" % (
            name, "yes" if message in part4 else "no", "yes" if message in part5 else "no",
            "yes" if message in committed else "no", "yes" if message in working else "no"))
    PY
    echo "command: each message looked for in $PART4_SPEC and $PART5_SPEC (git show <phase commit>), in the committed $P1SPEC (git show <phase commit>) and in its working file, whitespace folded (changes NC37, NC41 and NC44)"
    sed 's/^/    /' "$B/in-spec.tsv"
    QUOTED4="^(DRAWING_UNREADABLE|TWO_DRAWINGS|CHART_TEXT_INVALID|CHART_OPTION_KIND|CHART_SIZE_ANCHOR|CHART_ANCHOR_OUT_OF_RANGE)${TAB}spec0035=yes${TAB}"
    QUOTED="^(CHART_TEXT_INVALID|CHART_OPTION_KIND|CHART_ANCHOR_OUT_OF_RANGE)${TAB}spec0035=yes${TAB}spec0036=yes${TAB}"
    quoted4_ok() { [ "$(count_matches -E "$QUOTED4" "$B/in-spec.tsv")" = 6 ]; }
    quoted_ok() { [ "$(count_matches -E "$QUOTED" "$B/in-spec.tsv")" = 3 ]; }
    check "N1's and N2's message, N3's and the part's four are each quoted in $PART4_SPEC at the phase commit (change NC37)" "$(yn quoted4_ok)"
    check "the three call messages specs/0036 quotes (CHART_TEXT_INVALID, CHART_OPTION_KIND and CHART_ANCHOR_OUT_OF_RANGE) are each quoted in $PART5_SPEC at the phase commit (changes NC37 and NC41)" "$(yn quoted_ok)"
    printf 'CHART_OPTION_KIND\tspec0035=yes\tspec0036=no\tcommitted=no\tworking=no\nCHART_TEXT_INVALID\tspec0035=yes\tspec0036=yes\tcommitted=no\tworking=no\nTWO_DRAWINGS\tspec0035=no\tspec0036=no\tcommitted=no\tworking=no\n' >"$B/c-in-spec.tsv"
    check "control: the same count finds one line where one of two says spec0036=no" "$(yn [ "$(count_matches -E "$QUOTED" "$B/c-in-spec.tsv")" = 1 ])"
    check "control: the part 4 count finds two lines where a third says spec0035=no" "$(yn [ "$(count_matches -E "$QUOTED4" "$B/c-in-spec.tsv")" = 2 ])"
    # Changes NC39 to NC41: part 5 P3's two messages are each quoted in
    # specs/0036 at the phase commit ("Errors"), whitespace folded.
    QUOTED_NEW="^(NO_CHART_AT|CHART_PART_UNREADABLE)${TAB}spec0035=no${TAB}spec0036=yes${TAB}"
    quoted_new_ok() { [ "$(count_matches -E "$QUOTED_NEW" "$B/in-spec.tsv")" = 2 ]; }
    check "part 5 P3's two messages are each quoted in $PART5_SPEC at the phase commit and not in $PART4_SPEC (changes NC39 to NC41)" "$(yn quoted_new_ok)"
    printf 'NO_CHART_AT\tspec0035=no\tspec0036=no\tcommitted=no\tworking=no\nCHART_PART_UNREADABLE\tspec0035=no\tspec0036=yes\tcommitted=no\tworking=no\n' >"$B/c-in-new.tsv"
    check "control: the same count finds one line where one of two says spec0036=no (change NC41)" "$(yn [ "$(count_matches -E "$QUOTED_NEW" "$B/c-in-new.tsv")" = 1 ])"
    # Change NC41: this phase's three messages are each quoted in the committed
    # and the working specs/0038 ("Errors") and in neither earlier spec.
    QUOTED3="^(NOT_SHEET_ROOT|CHARTSHEET_ANCHOR|ONE_CHART)${TAB}spec0035=no${TAB}spec0036=no${TAB}committed=yes${TAB}working=yes\$"
    quoted3_ok() { [ "$(count_matches -E "$QUOTED3" "$B/in-spec.tsv")" = 3 ]; }
    check "part 1 P1's three messages are each quoted in the committed and the working $P1SPEC and in neither $PART4_SPEC nor $PART5_SPEC (changes NC41, NC42 and NC44)" "$(yn quoted3_ok)"
    printf 'ONE_CHART\tspec0035=no\tspec0036=no\tcommitted=yes\tworking=no\nNOT_SHEET_ROOT\tspec0035=no\tspec0036=no\tcommitted=yes\tworking=yes\nCHARTSHEET_ANCHOR\tspec0035=no\tspec0036=yes\tcommitted=yes\tworking=yes\n' >"$B/c-in-3.tsv"
    check "control: the same count finds one line of three where one says working=no and one says spec0036=yes (change NC41)" "$(yn [ "$(count_matches -E "$QUOTED3" "$B/c-in-3.tsv")" = 1 ])"
    # Change NC44: this phase's message is quoted in specs/0039, committed (git
    # show <phase commit>) and working, whitespace folded, and in none of
    # specs/0035, specs/0036 and specs/0038 (committed and working).
    git show "$C:$P2SPEC" >"$B/spec-0039.md"
    RANGE_MSG=$(awk -F"$TAB" -v n="$RANGE_NAME" '$1 == n { print $2 }' "$B/part.tsv")
    python3 -I -B - "$RANGE_MSG" "$B/spec-0039.md" "$P2SPEC" >"$B/range-spec.txt" <<'PY'
    import re
    import sys
    m = sys.argv[1]
    for name, path in (("committed", sys.argv[2]), ("working", sys.argv[3])):
        print("%s=%s" % (name, "yes" if m and m in re.sub(r"\s+", " ", open(path).read()) else "no"))
    PY
    echo "command: $RANGE_NAME's message looked for in the committed $P2SPEC (git show <phase commit>) and in its working file, whitespace folded (changes NC44 and NC47)"
    sed 's/^/    /' "$B/range-spec.txt"
    range_quoted() { [ "$(count_matches -xF committed=yes "$1")$(count_matches -xF working=yes "$1")" = 11 ]; }
    check "$RANGE_NAME's message is quoted in the committed and the working $P2SPEC (changes NC44 and NC47)" "$(yn range_quoted "$B/range-spec.txt")"
    printf 'committed=yes\nworking=no\n' >"$B/c-range-spec.txt"
    check "control: the same test refuses a reading where the working spec does not quote it" "$(ynnot range_quoted "$B/c-range-spec.txt")"
    RANGE_EARLIER="^${RANGE_NAME}${TAB}spec0035=no${TAB}spec0036=no${TAB}committed=no${TAB}working=no\$"
    range_new() { [ "$(count_matches -E "$RANGE_EARLIER" "$1")" = 1 ]; }
    check "$RANGE_NAME's message is quoted in none of $PART4_SPEC, $PART5_SPEC and $P1SPEC, committed or working: a message new in this part (change NC44)" "$(yn range_new "$B/in-spec.tsv")"
    printf '%s\tspec0035=no\tspec0036=no\tcommitted=yes\tworking=no\n' "$RANGE_NAME" >"$B/c-range-new.tsv"
    check "control: the same count refuses a line saying committed=yes" "$(ynnot range_new "$B/c-range-new.tsv")"
    # Change NC53: this phase's message is quoted in the committed (git show
    # <phase commit>) and the working specs/0041, whitespace folded, and in
    # none of specs/0035, specs/0036 and specs/0038 (committed and working).
    # Change NC55: the message is M6 part 4's, quoted in specs/0041, read by
    # name (this phase's spec is specs/0042).
    git show "$C:$SPEC41" >"$B/spec-0041.md"
    python3 -I -B - "$NO_SERIES_MSG" "$B/spec-0041.md" "$SPEC41" >"$B/series-spec.txt" <<'PY'
    import re
    import sys
    m = sys.argv[1]
    for name, path in (("committed", sys.argv[2]), ("working", sys.argv[3])):
        print("%s=%s" % (name, "yes" if m and m in re.sub(r"\s+", " ", open(path).read()) else "no"))
    PY
    echo "command: $NO_SERIES_NAME's message looked for in the committed $SPEC41 (git show <phase commit>) and in its working file, whitespace folded (changes NC53 and NC55)"
    sed 's/^/    /' "$B/series-spec.txt"
    check "$NO_SERIES_NAME's message is quoted in the committed and the working $SPEC41 (changes NC53 and NC55)" "$(yn range_quoted "$B/series-spec.txt")"
    SERIES_EARLIER="^${NO_SERIES_NAME}${TAB}spec0035=no${TAB}spec0036=no${TAB}committed=no${TAB}working=no\$"
    series_new() { [ "$(count_matches -E "$SERIES_EARLIER" "$1")" = 1 ]; }
    check "$NO_SERIES_NAME's message is quoted in none of $PART4_SPEC, $PART5_SPEC and $P1SPEC, committed or working: a message new in this part (change NC53)" "$(yn series_new "$B/in-spec.tsv")"
    printf '%s\tspec0035=no\tspec0036=yes\tcommitted=no\tworking=no\n' "$NO_SERIES_NAME" >"$B/c-series-new.tsv"
    check "control: the same count refuses a line saying spec0036=yes (change NC53)" "$(ynnot series_new "$B/c-series-new.tsv")"
    # Change NC41: N7's message, NOT_SHEET_ROOT, read apart from chart_write.rs
    # at the phase commit after the quote checks, so msg gives it.
    python3 -I -B "$B/messages.py" "$B/now-chart_write.rs" --name NOT_SHEET_ROOT >>"$B/known.tsv"
    echo "command: python3 -I -B <scratch>/w/messages.py <scratch>/w/now-chart_write.rs --name NOT_SHEET_ROOT (change NC41)"
    LC_ALL=C "$G" -E "^NOT_SHEET_ROOT${TAB}" "$B/known.tsv" | sed 's/^/    /'
    root_known() { [ "$(count_matches -E "^NOT_SHEET_ROOT${TAB}" "$B/known.tsv")" = 1 ] && [ "$(awk -F"$TAB" '$1 == "NOT_SHEET_ROOT" { print $2 }' "$B/known.tsv")" = "$(awk -F"$TAB" '$1 == "NOT_SHEET_ROOT" { print $2 }' "$B/part.tsv")" ]; }
    check "N7's message read apart is chart_write.rs's NOT_SHEET_ROOT, once (change NC41)" "$(yn root_known)"
    # Change NC42, turned by NC60 (specs/0043 ruling O): N8's old message,
    # NO_RELATIONSHIPS_PREFIX, read apart from package.rs at the base, once, and
