    print("chart_surface_sample's charts: no combined plot, no axis format, the axis titles on the surfaces alone: %s"
          % ("yes" if ok_chart else "no"))
    pies = re.findall(r"NewPlot::OfPie \{\s*kind: OfPieKind::(Pie|Bar),\s*split: ([^\n]*),\s*\},\s*&([a-z]+),", body)
