    """The named style sample's constants (change ND56): the phase commit's
    tools/emend-copy/src/main.rs split into its top-level functions, as
    reach.py splits it. The functions calling add_named_style are
    namedstyle_sample alone, once, with SAMPLE_STYLE_NAME and the style
    sample_named_style gives; the constant is a name the name rules take (not
    empty, at most 255 characters, none a character XML cannot carry);
    sample_named_style's style gives no named; the functions giving a style
    named: Some(..) are namedstyle_sample alone, twice, each the index the
    add_named_style call returned; every other named field of the tool is
    named: None. Usage: reach9.py <main.rs>."""
    import re
    import sys
    
    src = open(sys.argv[1]).read()
    FN = re.compile(r"^(?:pub(?:\([a-z]+\))? )?fn ([a-z_0-9]+)[<(]", re.M)
    fns = {}
    for m in FN.finditer(src):
        end = src.find("\n}\n", m.start())
        assert end > 0, m.group(1)
        fns.setdefault(m.group(1), []).append(src[m.start():end + 3])
    
    
    def body(name):
        assert len(fns.get(name, [])) == 1, name
        return fns[name][0]
    
    
    callers = sorted(n for n, bs in fns.items() for b in bs if ".add_named_style(" in b)
    print("functions calling add_named_style: " + " ".join(callers))
    s = body("namedstyle_sample") if "namedstyle_sample" in fns else ""
    calls = re.findall(r"let (\w+) = package\.add_named_style\((\w+), &(\w+)\)\?;", s)
    set_from = re.findall(r"let (\w+) = (\w+)\(\);", s)
    one_call = (len(re.findall(r"\.add_named_style\(", s)) == 1 and len(calls) == 1
                and calls[0][1] == "SAMPLE_STYLE_NAME" and (calls[0][2], "sample_named_style") in set_from)
    print("namedstyle_sample calls add_named_style once, with SAMPLE_STYLE_NAME and sample_named_style's style: %s"
          % ("yes" if one_call else "no"))
    const = re.findall(r'^const SAMPLE_STYLE_NAME: &str = "((?:[^"\\]|\\.)*)";', src, re.M)
    FORBIDDEN = re.compile("[\x00-\x08\x0b\x0c\x0e-\x1f\ufffe\uffff]")
    name_ok = (len(const) == 1 and "\\" not in const[0] and 0 < len(const[0]) <= 255
               and not FORBIDDEN.search(const[0]))
    shown = const[0] if len(const) == 1 and re.fullmatch(r"[ -~]*", const[0]) else "(not printable ASCII, not printed)"
    print("SAMPLE_STYLE_NAME: %s; a name the name rules take: %s"
          % (shown if const else "none", "yes" if name_ok else "no"))
    style = body("sample_named_style") if "sample_named_style" in fns else ""
    print("sample_named_style's style gives no named: %s"
          % ("yes" if style and not re.search(r"\bnamed:", style) and "..Style::default()" in style else "no"))
    k = calls[0][0] if len(calls) == 1 else None
    some = sorted(set(n for n, bs in fns.items() for b in bs if re.search(r"\bnamed: Some\(", b)))
    given = re.findall(r"\bnamed: Some\((\w+)\)", s)
    print("functions giving named: Some: %s; namedstyle_sample gives it %d times, each the returned index: %s"
          % (" ".join(some) or "none", len(given), "yes" if given and k and all(g == k for g in given) else "no"))
    others = re.findall(r"\bnamed: (?!Some\()([^,\n]*),", src)
    print("every other named field of the tool is named: None: %s (%d)"
          % ("yes" if others and all(o == "None" for o in others) else "no", len(others)))
