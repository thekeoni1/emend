    # B11, N16 to N19, B12 and B13 (change NE55): the gradient tool test's
    # fixture, styled_specs(<rows>, font_sample_part(SAMPLE_FONTS, <fills>,
    # SAMPLE_XFS, 3)) with <fills> SAMPLE_FILLS holding G1 after its two
    # pattern fills, rebuilt from the helpers' own literals at the phase
    # commit (edit_specs' worksheet, styled_specs' content types and workbook
    # relationships, font_sample_part's styles part), each entry stored or
    # deflated as the helpers' Spec makes it, in their order; its expected
    # line read from the test into b11.line. N16 is B11 with G1's degree
    # "ninety", a number the typed read cannot read; N17 is the refusal tool
    # test's fixture, the same helpers over A_CELL and no <fills>; N18 is B11
    # with G1's second stop removed and SAMPLE_XFS's second format naming fill
    # 2, G1, so the round-trip sample reads a one-stop gradient and gives it
    # back to add_style; B12 is N18 with the second stop kept; N19 is B11 with
    # a <dxfs> after <cellXfs> holding one dxf of G1 at degree 400, which the
    # named styles sample reads and gives back to add_differential_style; B13
    # is N19 at G1's own degree 90.
    fn = test.index("fn the_gradient_sample_adds_two_gradient_fills_and_two_formats()")
    gbody = test[fn:test.index("\n}\n", fn)]
    m = re.search(r'assert_eq!\(\s*line,\s*"((?:[^"\\]|\\.)*)",\s*"the edit line"\s*\);', gbody, re.S)
    assert m, "the gradient test's line"
    line = rust(m.group(1))
    assert "\\" not in line and line.endswith("\n") and line.count("\n") == 1
    open(os.path.join(out, "b11.line"), "w").write(line.rstrip("\n"))
    print("read from null_rewrite.rs: gradient line fields:%d" % len(line.rstrip("\n").split("\t")))
    for needle in [
            'let fills = SAMPLE_FILLS\n        .replace("<fills count=\\"2\\">", "<fills count=\\"3\\">")\n'
            '        .replace("</fills>", &format!("{G1}</fills>"));',
            "let part = font_sample_part(SAMPLE_FONTS, &fills, SAMPLE_XFS, 3);",
            '&styled_specs(&format!("<sheetData>{rows}</sheetData>"), &part),',
            '"--gradient-sample",']:
        assert needle in gbody, needle
    rm_ = re.search(r'let rows = "((?:[^"\\]|\\.)*)";', gbody, re.S)
    assert rm_, "the gradient test's rows"
    grows = rust(rm_.group(1))
    fn = test.index("fn the_gradient_sample_refuses_a_part_without_fills_and_leaves_nothing()")
    rbody = test[fn:test.index("\n}\n", fn)]
    assert '&styled_specs(A_CELL, &font_sample_part(SAMPLE_FONTS, "", SAMPLE_XFS, 3)),' in rbody
    assert '"a style addition needs a collection the styles part lacks",' in rbody
    for needle in [
            "fn styled_specs(sheet_data: &str, styles: &str) -> Vec<Spec> {",
            'specs.push(Spec::stored(b"xl/styles.xml", styles.as_bytes()));',
            '*spec = Spec::stored(b"xl/_rels/workbook.xml.rels", rels.as_bytes());',
            "fn font_sample_part(fonts: &str, fills: &str, cell_xfs: &str, count: u32) -> String {",
            '*spec = Spec::stored(b"xl/worksheets/sheet1.xml", sheet.as_bytes());']:
        assert needle in test, needle
    print("the gradient tests' source pieces found: yes")
    
    
    def const_s(name):
        """const() over a literal its continuations carry across lines."""
        m = re.search(r"^const " + name + r': &str =\s*"((?:[^"\\]|\\.)*)";', test, re.M | re.S)
        assert m, name
        return rust(m.group(1))
    
    
    NAMES = {n: const_s(n) for n in ("MAIN_NS", "TYPES_NS", "RELS_NS", "ATTR_NS", "RELS_TYPE", "WORKBOOK_TYPE",
                                   "SHEET_TYPE", "STRINGS_TYPE", "STYLES_TYPE", "SAMPLE_FONTS", "SAMPLE_FILLS",
                                   "SAMPLE_XFS", "G1", "A_CELL")}
    sbody = body_of("fn styled_specs(sheet_data: &str, styles: &str) -> Vec<Spec> {")
    lits = [rust(x) for x in LIT.findall(sbody)]
    types_fmt = [x for x in lits if "<Types " in x]
    rels_fmt = [x for x in lits if "<Relationships " in x]
    assert len(types_fmt) == 1 and len(rels_fmt) == 1, "styled_specs' literals"
    ebody = body_of("fn edit_specs(sheet_data: &str) -> Vec<Spec> {")
    sheet_fmt = [rust(x) for x in LIT.findall(ebody) if "<worksheet " in rust(x)]
    assert len(sheet_fmt) == 1, "edit_specs' worksheet"
    pbody = body_of("fn font_sample_part(fonts: &str, fills: &str, cell_xfs: &str, count: u32) -> String {")
    part_fmt = [rust(x) for x in LIT.findall(pbody) if "<styleSheet " in rust(x)]
    assert len(part_fmt) == 1, "font_sample_part's literal"
    styled_types = fill(types_fmt[0], NAMES)
    styled_rels = fill(rels_fmt[0], NAMES)
    
    
    def styles_part(fills_text):
        return fill(part_fmt[0], dict(NAMES, fonts=NAMES["SAMPLE_FONTS"], fills=fills_text,
                                      cell_xfs=NAMES["SAMPLE_XFS"], count="3"))
    
    
    def styled(sheet_data, styles):
        """styled_specs over edit_specs, entry by entry in its order: B0's first
        six entries' parts and methods with the content types, the workbook's
        relationships and the worksheet replaced, then the styles part."""
        assert [p for p, _, _ in B0[:6]] == ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml",
                                             "xl/_rels/workbook.xml.rels", "xl/worksheets/sheet1.xml",
                                             "xl/sharedStrings.xml"]
        items = list(B0[:6])
        items[0] = ("[Content_Types].xml", styled_types.encode(), DEFLATED)
        items[3] = ("xl/_rels/workbook.xml.rels", styled_rels.encode(), STORED)
        items[4] = ("xl/worksheets/sheet1.xml", fill(sheet_fmt[0], dict(NAMES, sheet_data=sheet_data)).encode(), STORED)
        items.append(("xl/styles.xml", styles.encode(), STORED))
        return items
    
    
    g1 = NAMES["G1"]
    gfills = NAMES["SAMPLE_FILLS"].replace('<fills count="2">', '<fills count="3">').replace("</fills>", g1 + "</fills>")
    assert gfills != NAMES["SAMPLE_FILLS"] and gfills.count(g1) == 1
    B11 = styled("<sheetData>" + grows + "</sheetData>", styles_part(gfills))
    write("b11", B11)
    STYLES = "xl/styles.xml"
    
    
    def changed(items, old, new, n=1):
        outl = []
        for part, data, method in items:
            if part == STYLES:
                text = data.decode()
                assert text.count(old) == n, (old, text.count(old))
                data = text.replace(old, new).encode()
            outl.append((part, data, method))
        return outl
    
    
    N16 = changed(B11, 'degree="90"', 'degree="ninety"')
    print("n16 entries changed:%d (the styles part, G1's degree \"ninety\"; stored; every other entry as B11's)"
          % sum(1 for a, b in zip(B11, N16) if a != b))
    write("n16", N16)
    N17 = styled(NAMES["A_CELL"], styles_part(""))
    write("n17", N17)
    SECOND_STOP = '<stop position="1"><color rgb="FFFFFFFF"/></stop>'
    NAMED_FILL = ('<xf numFmtId="2" fontId="0" applyAlignment="1">', '<xf numFmtId="2" fontId="0" fillId="2" applyAlignment="1">')
    B12 = changed(B11, *NAMED_FILL)
    print("b12 entries changed:%d (the styles part, SAMPLE_XFS's second format naming fill 2, G1; stored; every other entry as B11's)"
          % sum(1 for a, b in zip(B11, B12) if a != b))
    write("b12", B12)
    N18 = changed(B12, SECOND_STOP, "")
    print("n18 entries changed:%d (the styles part, G1's second stop removed; stored; every other entry as B12's)"
          % sum(1 for a, b in zip(B12, N18) if a != b))
    write("n18", N18)
    DXFS = '<dxfs count="1"><dxf>' + g1 + "</dxf></dxfs>"
    B13 = changed(B11, "</cellXfs>", "</cellXfs>" + DXFS)
    print("b13 entries changed:%d (the styles part, a dxfs of one dxf holding G1 after cellXfs; stored; every other entry as B11's)"
          % sum(1 for a, b in zip(B11, B13) if a != b))
    write("b13", B13)
    N19 = changed(B13, '<dxf><fill><gradientFill degree="90">', '<dxf><fill><gradientFill degree="400">')
    print("n19 entries changed:%d (the styles part, the dxf's gradient at degree 400; stored; every other entry as B13's)"
          % sum(1 for a, b in zip(B13, N19) if a != b))
    write("n19", N19)
    # B14 and N20 to N23 (change NE56): the named style tool test's fixture,
    # styled_specs(<rows>, named_sample_part(SAMPLE_XFS, 3)), named_sample_part
    # being font_sample_part(SAMPLE_FONTS, SAMPLE_FILLS, <cell_xfs>, <count>)
    # with one cellStyleXfs format before <cellXfs> and the Normal entry after
    # it, rebuilt from the helpers' own literals at the phase commit; its
    # expected line read from the test into b14.line. N20 is B14 with a second
    # cellStyles entry named EMEND SAMPLE STYLE, the tool's constant in another
    # ASCII case; N21 is B14 with A1's style 9, past its three cell formats;
    # N22 is the refusal tool test's fixture, named_sample_part with its
    # cellStyles removed, over A_CELL; N23 is B14 with a second, empty
    # <cellStyles count="0"/> after the first.
    fn = test.index("fn the_namedstyle_sample_adds_a_named_style_and_two_formats_naming_it()")
    nbody = test[fn:test.index("\n}\n", fn)]
    m = re.search(r'assert_eq!\(\s*line,\s*"((?:[^"\\]|\\.)*)",\s*"the namedstyle line"\s*\);', nbody, re.S)
    assert m, "the named style test's line"
    nline = rust(m.group(1))
    assert "\\" not in nline and nline.endswith("\n") and nline.count("\n") == 1
    open(os.path.join(out, "b14.line"), "w").write(nline.rstrip("\n"))
    print("read from null_rewrite.rs: namedstyle line fields:%d" % len(nline.rstrip("\n").split("\t")))
    for needle in [
            "let part = named_sample_part(SAMPLE_XFS, 3);",
            '&styled_specs(&format!("<sheetData>{rows}</sheetData>"), &part),',
            '"--namedstyle-sample",']:
        assert needle in nbody, needle
    rm_ = re.search(r'let rows = "((?:[^"\\]|\\.)*)";', nbody, re.S)
    assert rm_, "the named style test's rows"
    nrows = rust(rm_.group(1))
    assert nrows == grows, "the named style test's rows are the gradient test's"
    fn = test.index("fn the_namedstyle_sample_refuses_a_part_without_cell_styles_and_leaves_nothing()")
    rbody = test[fn:test.index("\n}\n", fn)]
    rlits = [rust(x) for x in LIT.findall(rbody)]
    assert "&styled_specs(A_CELL, &part)," in rbody and "named_sample_part(SAMPLE_XFS, 3).replace(" in rbody
    assert "a style addition needs a collection the styles part lacks" in rlits
    nbody_part = body_of("fn named_sample_part(cell_xfs: &str, count: u32) -> String {")
    assert "font_sample_part(SAMPLE_FONTS, SAMPLE_FILLS, cell_xfs, count)" in nbody_part
    plits = [rust(x) for x in LIT.findall(nbody_part)]
    assert len(plits) == 4, plits
    print("the named style tests' source pieces found: yes")
    
    
    def named_part(count):
        """named_sample_part(SAMPLE_XFS, count): its two replacements in order,
        each format! filled with count."""
        text = fill(part_fmt[0], dict(NAMES, fonts=NAMES["SAMPLE_FONTS"], fills=NAMES["SAMPLE_FILLS"],
                                      cell_xfs=NAMES["SAMPLE_XFS"], count=str(count)))
        old1, new1, old2, new2 = (fill(x, {"count": str(count)}) for x in plits)
        assert text.count(old1) == 1 and text.count(old2) == 1, "named_sample_part's replacements"
        return text.replace(old1, new1).replace(old2, new2)
    
    
    npart = named_part(3)
    assert npart.count("<cellStyleXfs") == 1 and npart.count("<cellStyles ") == 1
    B14 = styled("<sheetData>" + nrows + "</sheetData>", npart)
    write("b14", B14)
    NORMAL = rlits[0]
    assert NORMAL.startswith('<cellStyles count="1">') and NORMAL in npart, "the refusal test's removed text"
    N20 = changed(B14, NORMAL, NORMAL.replace('<cellStyles count="1">', '<cellStyles count="2">').replace(
        "</cellStyles>", '<cellStyle name="EMEND SAMPLE STYLE" xfId="0"/></cellStyles>'))
    print("n20 entries changed:%d (the styles part, a second entry named the constant in upper case; stored; every other entry as B14's)"
          % sum(1 for a, b in zip(B14, N20) if a != b))
    write("n20", N20)
    N21 = []
    for part_, data, method in B14:
        if part_ == "xl/worksheets/sheet1.xml":
            text = data.decode()
            assert text.count('<c r="A1" s="1">') == 1, "A1's style"
            data = text.replace('<c r="A1" s="1">', '<c r="A1" s="9">').encode()
        N21.append((part_, data, method))
    print("n21 entries changed:%d (the worksheet, A1's style 9 past the three cell formats; stored; every other entry as B14's)"
          % sum(1 for a, b in zip(B14, N21) if a != b))
    write("n21", N21)
    N22 = styled(NAMES["A_CELL"], npart.replace(NORMAL, ""))
    assert "cellStyles" not in dict((p, d) for p, d, _ in N22)[STYLES].decode()
    write("n22", N22)
    N23 = changed(B14, "</cellStyles>", '</cellStyles><cellStyles count="0"/>')
    print("n23 entries changed:%d (the styles part, a second, empty cellStyles; stored; every other entry as B14's)"
          % sum(1 for a, b in zip(B14, N23) if a != b))
    write("n23", N23)
