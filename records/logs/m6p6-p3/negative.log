    # run_bin <label> <args...>: the copied binary, the command printed with the
    # paths it names, stdout, stderr and exit kept under the label.
    run_bin() {
      local label=$1
      shift
      "$BIN" "$@" >"$B/$label.stdout" 2>"$B/$label.stderr" </dev/null
      echo $? >"$B/$label.status"
      echo "command: <scratch>/w/bin/emend-copy $*"
      echo "  exit: $(cat "$B/$label.status")"
      echo "  stdout:"; sed 's/^/    /' "$B/$label.stdout"
      echo "  stderr:"; sed 's/^/    /' "$B/$label.stderr"
    }
    status_is() { [ "$(cat "$B/$1.status")" = "$2" ]; }
    refused_with() { status_is "$1" 2 && [ ! -s "$B/$1.stdout" ] && [ -n "$2" ] && [ "$(cat "$B/$1.stderr")" = "$2" ]; }
    no_output() { [ ! -e "$B/out/$1.xlsx" ]; }
    has_output() { [ -s "$B/out/$1.xlsx" ]; }
    # line_is <label> <line>: exit 0, no stderr, the line, and an output.
    line_is() { status_is "$1" 0 && [ ! -s "$B/$1.stderr" ] && [ "$(cat "$B/$1.stdout")" = "$2" ] && has_output "$1"; }
    mkdir "$B/out" || exit 2
    for case in b0 n1; do
      echo
      echo "### ${case^^} (--chart-kinds-sample)"
      run_bin "$case" "$B/fx/$case.xlsx" "$B/out/$case.xlsx" --chart-kinds-sample
    done
    # Change NE36: B1 is B0's fixture through the add-chart sample, under its own
    # label and output; N2 its refused case.
    echo
    echo "### B1 (--add-chart-sample, B0's fixture)"
    run_bin b1 "$B/fx/b0.xlsx" "$B/out/b1.xlsx" --add-chart-sample
    echo
    echo "### N2 (--add-chart-sample)"
    run_bin n2 "$B/fx/n2.xlsx" "$B/out/n2.xlsx" --add-chart-sample
    # Change NE37: N3, P1's case, its control B1 above.
    echo
    echo "### N3 (--add-chart-sample)"
    run_bin n3 "$B/fx/n3.xlsx" "$B/out/n3.xlsx" --add-chart-sample
    # Change NE38: B2 is B0's fixture through the 3D sample, under its own label
    # and output; N4, this phase's case, N1's fixture through it.
    echo
    echo "### B2 (--chart-3d-sample, B0's fixture)"
    run_bin b2 "$B/fx/b0.xlsx" "$B/out/b2.xlsx" --chart-3d-sample
    echo
    echo "### N4 (--chart-3d-sample, N1's fixture)"
    run_bin n4 "$B/fx/n1.xlsx" "$B/out/n4.xlsx" --chart-3d-sample
    # Change NE39: B3 the charts fixture through the remove-chart sample; N5,
    # this phase's case (ruling N), B3 without its first chart's part.
    echo
    echo "### B3 (--remove-chart-sample, the charts fixture)"
    run_bin b3 "$B/fx/b3.xlsx" "$B/out/b3.xlsx" --remove-chart-sample
    echo
    echo "### N5 (--remove-chart-sample, B3 without its first chart's part)"
    run_bin n5 "$B/fx/n5.xlsx" "$B/out/n5.xlsx" --remove-chart-sample
    # Change NE41: B4, the chartsheet tool tests' fixture, through the
    # chartsheet sample; N6 and N7, this phase's cases.
    echo
    echo "### B4 (--chartsheet-sample, the chartsheet tool tests' fixture)"
    run_bin b4 "$B/fx/b4.xlsx" "$B/out/b4.xlsx" --chartsheet-sample
    echo
    echo "### N6 (--chartsheet-sample, B4 naming a chartsheet relationship with no part)"
    run_bin n6 "$B/fx/n6.xlsx" "$B/out/n6.xlsx" --chartsheet-sample
    echo
    echo "### N7 (--chartsheet-sample, N6 with the part there, its root dialogsheet)"
    run_bin n7 "$B/fx/n7.xlsx" "$B/out/n7.xlsx" --chartsheet-sample
    # Change NE42, turned by NE60: N8 runs below with the size log's release
    # binaries (specs/0043 rulings O and P), not here with the gate's.
    # Change NE43: N9, this phase's case (ruling M), the add-chart sample on B4
    # with its worksheet part's root a chartsheet.
    echo
    echo "### N9 (--add-chart-sample, B4 with its worksheet part's root a chartsheet, the relationship and the content type a worksheet's)"
    run_bin n9 "$B/fx/n9.xlsx" "$B/out/n9.xlsx" --add-chart-sample
    # Change NE44: B5 is B0's fixture through the surface sample, under its own
    # label and output; N10, this phase's case, N1's fixture through it.
    echo
    echo "### B5 (--chart-surface-sample, B0's fixture)"
    run_bin b5 "$B/fx/b0.xlsx" "$B/out/b5.xlsx" --chart-surface-sample
    echo
    echo "### N10 (--chart-surface-sample, N1's fixture)"
    run_bin n10 "$B/fx/n1.xlsx" "$B/out/n10.xlsx" --chart-surface-sample
    # Change NE45: B6 is B0's fixture through the format sample, under its own
    # label and output; N11, part 2 P2's case, N1's fixture through it.
    echo
    echo "### B6 (--chart-format-sample, B0's fixture)"
    run_bin b6 "$B/fx/b0.xlsx" "$B/out/b6.xlsx" --chart-format-sample
    echo
    echo "### N11 (--chart-format-sample, N1's fixture)"
    run_bin n11 "$B/fx/n1.xlsx" "$B/out/n11.xlsx" --chart-format-sample
    # Change NE47: B7 is B0's fixture through the trend sample, under its own
    # label and output; N12, part 3 P1's case, N1's fixture through it.
    echo
    echo "### B7 (--chart-trend-sample, B0's fixture)"
    run_bin b7 "$B/fx/b0.xlsx" "$B/out/b7.xlsx" --chart-trend-sample
    echo
    echo "### N12 (--chart-trend-sample, N1's fixture)"
    run_bin n12 "$B/fx/n1.xlsx" "$B/out/n12.xlsx" --chart-trend-sample
    # Change NE48: B8 is B0's fixture through the axis sample, under its own
    # label and output; N13, part 3 P2's case, N1's fixture through it.
    echo
    echo "### B8 (--chart-axis-sample, B0's fixture)"
    run_bin b8 "$B/fx/b0.xlsx" "$B/out/b8.xlsx" --chart-axis-sample
    echo
    echo "### N13 (--chart-axis-sample, N1's fixture)"
    run_bin n13 "$B/fx/n1.xlsx" "$B/out/n13.xlsx" --chart-axis-sample
    # Change NE52: B9 is B0's fixture through the text sample, under its own
    # label and output; N14, M6 part 4 P1's case, N1's fixture through it.
    echo
    echo "### B9 (--chart-text-sample, B0's fixture)"
    run_bin b9 "$B/fx/b0.xlsx" "$B/out/b9.xlsx" --chart-text-sample
    echo
    echo "### N14 (--chart-text-sample, N1's fixture)"
    run_bin n14 "$B/fx/n1.xlsx" "$B/out/n14.xlsx" --chart-text-sample
    # Change NE53: B10 is B0's fixture through the edit sample, under its own
    # label and output; N15, this phase's case, N1's fixture through it.
    echo
    echo "### B10 (--chart-edit-sample, B0's fixture)"
    run_bin b10 "$B/fx/b0.xlsx" "$B/out/b10.xlsx" --chart-edit-sample
    echo
    echo "### N15 (--chart-edit-sample, N1's fixture)"
    run_bin n15 "$B/fx/n1.xlsx" "$B/out/n15.xlsx" --chart-edit-sample
    # Change NE55: B11 is the gradient tool test's fixture through the gradient
    # sample; N16 and N17 the gradient sample's refusals; N18 and B12 through
    # the round-trip sample, N19 and B13 through the named styles sample.
    echo
    echo "### B11 (--gradient-sample, the gradient tool test's fixture)"
    run_bin b11 "$B/fx/b11.xlsx" "$B/out/b11.xlsx" --gradient-sample
    echo
    echo "### N16 (--gradient-sample, B11 with G1's degree unreadable)"
    run_bin n16 "$B/fx/n16.xlsx" "$B/out/n16.xlsx" --gradient-sample
    echo
    echo "### N17 (--gradient-sample, the refusal tool test's fixture, no <fills>)"
    run_bin n17 "$B/fx/n17.xlsx" "$B/out/n17.xlsx" --gradient-sample
    echo
    echo "### B12 (--roundtrip-sample, B11 with W's format naming G1)"
    run_bin b12 "$B/fx/b12.xlsx" "$B/out/b12.xlsx" --roundtrip-sample
    echo
    echo "### N18 (--roundtrip-sample, B12 with G1 of one stop)"
    run_bin n18 "$B/fx/n18.xlsx" "$B/out/n18.xlsx" --roundtrip-sample
    echo
    echo "### B13 (--namedstyles-sample, B11 with a dxf holding G1)"
    run_bin b13 "$B/fx/b13.xlsx" "$B/out/b13.xlsx" --namedstyles-sample
    echo
    echo "### N19 (--namedstyles-sample, B13 with the dxf's gradient at degree 400)"
    run_bin n19 "$B/fx/n19.xlsx" "$B/out/n19.xlsx" --namedstyles-sample
    # Change NE56: B14 is the named style tool test's fixture through the named
    # style sample; N20 to N23 its refusals (ruling X).
    echo
    echo "### B14 (--namedstyle-sample, the named style tool test's fixture)"
    run_bin b14 "$B/fx/b14.xlsx" "$B/out/b14.xlsx" --namedstyle-sample
    echo
    echo "### N20 (--namedstyle-sample, B14 with an entry named the constant in upper case)"
    run_bin n20 "$B/fx/n20.xlsx" "$B/out/n20.xlsx" --namedstyle-sample
    echo
    echo "### N21 (--namedstyle-sample, B14 with A1's style past the cell formats)"
    run_bin n21 "$B/fx/n21.xlsx" "$B/out/n21.xlsx" --namedstyle-sample
    echo
    echo "### N22 (--namedstyle-sample, the refusal tool test's fixture, no <cellStyles>)"
    run_bin n22 "$B/fx/n22.xlsx" "$B/out/n22.xlsx" --namedstyle-sample
    echo
    echo "### N23 (--namedstyle-sample, B14 with a second, empty <cellStyles>)"
    run_bin n23 "$B/fx/n23.xlsx" "$B/out/n23.xlsx" --namedstyle-sample
    echo
    echo "### the checks"
    # B0's line is the one the kinds tool test asserts for the same fixture, read
    # from null_rewrite.rs above: counts and flags only.
    L_B0=$(cat "$B/fx/b0.line")
    echo "  B0's expected line, from the kinds tool test, asserted for its appended case:"
    printf '%s\n' "$L_B0" | sed 's/^/    /'
    check "B0: exit 0, the kinds tool test's line, an output (the control for N1; ruling K)" "$(yn line_is b0 "$L_B0")"
    L_B1=$(cat "$B/fx/b1.line")
    echo "  B1's expected line, from the add-chart tool test's appended case (change NE36):"
    printf '%s\n' "$L_B1" | sed 's/^/    /'
    check "B1: exit 0, the add-chart tool test's line, an output (the control for N2 and N3; changes NE36 and NE37)" "$(yn line_is b1 "$L_B1")"
    L_B2=$(cat "$B/fx/b2.line")
    echo "  B2's expected line, from the 3D tool test, asserted for its appended case (change NE38):"
    printf '%s\n' "$L_B2" | sed 's/^/    /'
    check "B2: exit 0, the 3D tool test's line, an output (the control for N4; change NE38)" "$(yn line_is b2 "$L_B2")"
    L_B3=$(cat "$B/fx/b3.line")
    echo "  B3's expected line, from the kept remove-chart tool test (change NE39):"
    printf '%s\n' "$L_B3" | sed 's/^/    /'
    check "B3: exit 0, the kept remove-chart tool test's line, an output (the control for N5; change NE39; ruling N)" "$(yn line_is b3 "$L_B3")"
    L_B4=$(cat "$B/fx/b4.line")
    echo "  B4's expected line, from the kept chartsheet tool test (change NE41):"
    printf '%s\n' "$L_B4" | sed 's/^/    /'
    check "B4: exit 0, the kept chartsheet tool test's line, an output (the control for N6 and N7; change NE41)" "$(yn line_is b4 "$L_B4")"
    L_B5=$(cat "$B/fx/b5.line")
    echo "  B5's expected line, from the surface tool test, asserted for its appended case (change NE44):"
    printf '%s\n' "$L_B5" | sed 's/^/    /'
    check "B5: exit 0, the surface tool test's line, an output (the control for N10; change NE44)" "$(yn line_is b5 "$L_B5")"
    L_B6=$(cat "$B/fx/b6.line")
    echo "  B6's expected line, from the format tool test, asserted for its appended case (change NE45):"
    printf '%s\n' "$L_B6" | sed 's/^/    /'
    check "B6: exit 0, the format tool test's line, an output (the control for N11; change NE45)" "$(yn line_is b6 "$L_B6")"
    L_B7=$(cat "$B/fx/b7.line")
    echo "  B7's expected line, from the trend tool test, asserted for its appended case (change NE47):"
    printf '%s\n' "$L_B7" | sed 's/^/    /'
    check "B7: exit 0, the trend tool test's line, an output (the control for N12; change NE47)" "$(yn line_is b7 "$L_B7")"
    L_B8=$(cat "$B/fx/b8.line")
    echo "  B8's expected line, from the axis tool test, asserted for its appended case (change NE48):"
    printf '%s\n' "$L_B8" | sed 's/^/    /'
    check "B8: exit 0, the axis tool test's line, an output (the control for N13; change NE48)" "$(yn line_is b8 "$L_B8")"
    L_B9=$(cat "$B/fx/b9.line")
    echo "  B9's expected line, from the text tool test, asserted for its appended case (change NE52):"
    printf '%s\n' "$L_B9" | sed 's/^/    /'
    check "B9: exit 0, the text tool test's line, an output (the control for N14; change NE52)" "$(yn line_is b9 "$L_B9")"
    L_B10=$(cat "$B/fx/b10.line")
    echo "  B10's expected line, from the edit tool test, asserted for its appended case (change NE53):"
    printf '%s\n' "$L_B10" | sed 's/^/    /'
    check "B10: exit 0, the edit tool test's line, an output (the control for N15; change NE53)" "$(yn line_is b10 "$L_B10")"
    L_B11=$(cat "$B/fx/b11.line")
    echo "  B11's expected line, from the gradient tool test (change NE55):"
    printf '%s\n' "$L_B11" | sed 's/^/    /'
    check "B11: exit 0, the gradient tool test's line, an output (the control for N16 and N17; change NE55)" "$(yn line_is b11 "$L_B11")"
    # B12's and B13's lines (change NE55): no tool test runs these fixtures, so
    # the lines are this log's own, the counts the fixtures imply: B12 one
    # format read and added again (W's A1), its font, fill (G1, read typed and
    # appended, ruling C) and border appended, equal on read-back; B13 no named
    # style, the one dxf read with its gradient (ruling C) and written back,
    # equal on read-back.
    L_B12="roundtrip${TAB}styles_in=1${TAB}styles_added=1${TAB}xfs_before=3${TAB}xfs_after=4${TAB}fonts_before=1${TAB}fonts_after=2${TAB}fills_before=3${TAB}fills_after=4${TAB}borders_before=1${TAB}borders_after=2${TAB}equal=1"
    L_B13="namedstyles${TAB}named=0${TAB}named_xfs=0${TAB}builtin=0${TAB}custom=0${TAB}resolved=0${TAB}default_font_size=0${TAB}dxfs=1${TAB}dxf_fonts=0${TAB}dxf_fills=1${TAB}dxf_borders=0${TAB}dxf_numfmts=0${TAB}dxf_alignments=0${TAB}dxf_protections=0${TAB}dxf_gradients=1${TAB}dxf_implied_solid=0${TAB}dxf_inside_sides=0${TAB}dxf_written=1${TAB}dxf_equal=1"
    echo "  B12's expected line, the fixture's counts (change NE55):"
    printf '%s\n' "$L_B12" | sed 's/^/    /'
    check "B12: exit 0, the round-trip line with the gradient fill appended and read back equal, an output (the control for N18; ruling C; change NE55)" "$(yn line_is b12 "$L_B12")"
    echo "  B13's expected line, the fixture's counts (change NE55):"
    printf '%s\n' "$L_B13" | sed 's/^/    /'
    check "B13: exit 0, the named styles line with the dxf's gradient read typed, written back and read back equal, an output (the control for N19; ruling C; change NE55)" "$(yn line_is b13 "$L_B13")"
    L_B14=$(cat "$B/fx/b14.line")
    echo "  B14's expected line, from the named style tool test (change NE56):"
    printf '%s\n' "$L_B14" | sed 's/^/    /'
    check "B14: exit 0, the named style tool test's line, an output (the control for N20 to N23; change NE56)" "$(yn line_is b14 "$L_B14")"
    B4_HEAD="chartsheet${TAB}part_length=25${TAB}charts=1${TAB}series=2${TAB}"
    # head_of <label> <head>: the run's stdout begins with the head.
    head_of() { case "$(cat "$B/$1.stdout")" in "$2"*) return 0 ;; esac; return 1; }
    check "B4's line begins chartsheet, part_length=25, charts=1, series=2, tab-separated (specs/0038 P1; change NE41)" "$(yn head_of b4 "$B4_HEAD")"
    check "control: head_of says no on B4's run against a head with two charts" "$(ynnot head_of b4 "chartsheet${TAB}part_length=25${TAB}charts=2${TAB}")"
    : >"$B/reached"
    # refusal <case> <NAME> <what>: the case refused with the message of NAME,
    # no output.
    refusal() {
      local case=$1 name=$2 what=$3 expect
      expect=$(msg "$name")
      check "${case^^} ($what): exit 2, no stdout, the error line exactly the $name message" "$(yn refused_with "$case" "$expect")"
      check "${case^^}: no output file" "$(yn no_output "$case")"
      if refused_with "$case" "$expect"; then
        printf '%s\n' "$case" >>"$B/reached"
      fi
    }
    refusal n1 DRAWING_UNREADABLE "part 4 P2's: the kinds sample on a drawing whose root is not wsDr; ruling K"
    refusal n2 DRAWING_UNREADABLE "part 4 P1's: the add-chart sample on a drawing relationship with no part"
    refusal n3 TWO_DRAWINGS "P1's: the add-chart sample on a worksheet holding two drawing elements; part 4 ruling Q"
    refusal n4 DRAWING_UNREADABLE "P2's: the 3D sample on a drawing whose root is not wsDr; part 4 ruling K's case"
    refusal n5 CHART_UNREADABLE "P3's: the remove-chart sample on a chart frame naming a relationship with no part, the reader's message; ruling N"
    refusal n6 NO_SUCH_PART "part 1 P1's: the chartsheet sample on a workbook whose rels part names a chartsheet relationship with no part"
    refusal n7 NOT_SHEET_ROOT "part 1 P1's: the chartsheet sample on a workbook whose chartsheet relationship names a part whose root is dialogsheet"
    refusal n9 NOT_WORKSHEET "P3's (ruling M): the add-chart sample on a worksheet relationship whose part's root is a chartsheet, refused by the cell read before Package::add_chart, so CHARTSHEET_ANCHOR is not met"
    refusal n10 DRAWING_UNREADABLE "part 2 P1's: the surface sample on a drawing whose root is not wsDr, N1's fixture; part 4 ruling K's case, as N4"
    refusal n11 DRAWING_UNREADABLE "part 2 P2's: the format sample on a drawing whose root is not wsDr, N1's fixture; part 4 ruling K's case, as N4 and N10"
    refusal n12 DRAWING_UNREADABLE "part 3 P1's: the trend sample on a drawing whose root is not wsDr, N1's fixture; part 4 ruling K's case, as N4, N10 and N11"
    refusal n13 DRAWING_UNREADABLE "part 3 P2's: the axis sample on a drawing whose root is not wsDr, N1's fixture; part 4 ruling K's case, as N4, N10, N11 and N12"
    refusal n14 DRAWING_UNREADABLE "M6 part 4 P1's: the text sample on a drawing whose root is not wsDr, N1's fixture; part 4 ruling K's case, as N4 and N10 to N13"
    refusal n15 DRAWING_UNREADABLE "M6 part 4 P2's: the edit sample on a drawing whose root is not wsDr, N1's fixture; part 4 ruling K's case, as N4 and N10 to N14"
    # Change NE55: N16's to N19's messages are read apart from known.tsv:
    # STYLE_UNREADABLE and NEEDS_COLLECTION by tmsg, $FIELD_NAME, a
    # styles/elements.rs constant, by emsg. N18 and N19 give the writer a
    # gradient read from the input (ruling D), which it refuses.
    refusal_x() {
      local case=$1 name=$2 expect=$3 what=$4
      check "${case^^} ($what): exit 2, no stdout, the error line exactly the $name message" "$(yn refused_with "$case" "$expect")"
      check "${case^^}: no output file" "$(yn no_output "$case")"
      if refused_with "$case" "$expect"; then
        printf '%s\n' "$case" >>"$B/reached"
      fi
    }
    refusal_x n16 STYLE_UNREADABLE "error: $STYLE_UNREAD_MSG" "this phase's: the gradient sample on a styles part whose gradient fill's degree is not a number, refused by the typed read before any addition"
    refusal_x n17 NEEDS_COLLECTION "error: $COLLECTION_MSG" "this phase's: the gradient sample on a styles part without <fills>, refused at add_style"
    refusal_x n18 "$FIELD_NAME" "$(emsg "$FIELD_NAME")" "this phase's: the round-trip sample reading a gradient fill of one stop and giving it back to add_style, refused by the writer's stop count (ruling D)"
    refusal_x n19 "$FIELD_NAME" "$(emsg "$FIELD_NAME")" "this phase's: the named styles sample reading a dxf gradient at degree 400 and giving it back to add_differential_style, refused by the writer's degree range (ruling D)"
    # Change NE56: N20's to N23's messages, read apart from known.tsv: the name,
    # index and collection messages by tmsg (package.rs) and the containers'
    # new text by smsg (styles.rs).
    refusal_x n20 "$NAME_NAME" "error: $NAME_MSG" "M6 part 5 P2's: the named style sample on a styles part holding the constant's name in upper case, refused at add_named_style by the duplicate check (decision 4 A)"
    refusal_x n21 STYLE_OUT_OF_RANGE "error: $INDEX_MSG" "M6 part 5 P2's: the named style sample on a styles part whose first sampled cell's style lies past cellXfs, refused by add_style's base check for the second format"
    refusal_x n22 NEEDS_COLLECTION "error: $COLLECTION_MSG" "M6 part 5 P2's: the named style sample on a styles part without <cellStyles>, refused at add_named_style (ruling T)"
    refusal_x n23 "$TWO_NAME" "$(smsg "$TWO_NAME")" "M6 part 5 P2's: the named style sample on a styles part with two <cellStyles>, refused at the styles part's read with the containers' new text (ruling Q)"
    echo "  refused as expected, by case:"
    sed 's/^/    /' "$B/reached"
    check "the 22 cases were refused, N1 to N7 and N9 to N23, N8 turned to the accepting case below (changes NE39, NE41 to NE45, NE47, NE48, NE52, NE53, NE55, NE56 and NE60)" "$(yn [ "$(count_lines "$B/reached")" = 22 ])"
    b0_refused() { refused_with b0 "$(msg DRAWING_UNREADABLE)"; }
    check "control: refused_with says no on B0's run" "$(ynnot b0_refused)"
    b1_refused() { refused_with b1 "$(msg DRAWING_UNREADABLE)"; }
    check "control: refused_with says no on B1's run" "$(ynnot b1_refused)"
    b1_two_refused() { refused_with b1 "$(msg TWO_DRAWINGS)"; }
    check "control: refused_with says no on B1's run against N3's message (change NE37)" "$(ynnot b1_two_refused)"
    n3_other() { refused_with n3 "$(msg DRAWING_UNREADABLE)"; }
    check "control: refused_with says no on N3's run against the drawing message (change NE37)" "$(ynnot n3_other)"
    b2_refused() { refused_with b2 "$(msg DRAWING_UNREADABLE)"; }
    check "control: refused_with says no on B2's run (change NE38)" "$(ynnot b2_refused)"
    n4_other() { refused_with n4 "$(msg TWO_DRAWINGS)"; }
    check "control: refused_with says no on N4's run against the two-drawing message (change NE38)" "$(ynnot n4_other)"
    b3_refused() { refused_with b3 "$(msg CHART_UNREADABLE)"; }
    check "control: refused_with says no on B3's run (change NE39)" "$(ynnot b3_refused)"
    n5_other() { refused_with n5 "$(msg DRAWING_UNREADABLE)"; }
    check "control: refused_with says no on N5's run against the drawing message (change NE39)" "$(ynnot n5_other)"
    empty_message() { refused_with n1 ""; }
    check "control: refused_with says no against an empty message" "$(ynnot empty_message)"
    other_message() { refused_with n1 "error: a worksheet has two drawing elements"; }
    check "control: refused_with says no on N1's run against another message" "$(ynnot other_message)"
    b0_line_ctl() { line_is b0 "$(printf '%s' "$L_B0" | sed "s/${TAB}charts_after=6${TAB}/${TAB}charts_after=7${TAB}/")"; }
    check "control: line_is says no on B0's run against a line with one chart more" "$(ynnot b0_line_ctl)"
    b0_line_changes() { [ "$(printf '%s' "$L_B0" | sed "s/${TAB}charts_after=6${TAB}/${TAB}charts_after=7${TAB}/")" != "$L_B0" ]; }
    check "control: the planted line differs from B0's" "$(yn b0_line_changes)"
