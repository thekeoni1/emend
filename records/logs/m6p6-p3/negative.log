    python3 -I -B "$B/messages.py" "$B/now-package.rs" --name NO_RELATIONSHIPS_PREFIX >"$B/prefix-now.tsv"
    python3 -I -B "$B/messages.py" "$B/base-package.rs" --name NO_RELATIONSHIPS_PREFIX >"$B/prefix-base.tsv"
    echo "command: python3 -I -B <scratch>/w/messages.py <scratch>/w/now-package.rs --name NO_RELATIONSHIPS_PREFIX, and the same over <scratch>/w/base-package.rs (changes NC42 and NC60)"
    sed 's/^/    at the phase commit: /' "$B/prefix-now.tsv"
    sed 's/^/    at the base: /' "$B/prefix-base.tsv"
    echo "  lines at the phase commit: $(count_lines "$B/prefix-now.tsv"); at the base: $(count_lines "$B/prefix-base.tsv")"
    PREFIX_MSG=$(cut -f2 "$B/prefix-base.tsv")
    prefix_gone() { [ "$(count_lines "$B/prefix-base.tsv")" = 1 ] && [ -n "$PREFIX_MSG" ] && [ ! -s "$1" ]; }
    check "N8's old message, package.rs's NO_RELATIONSHIPS_PREFIX, is read apart at the base, once, and not at the phase commit (ruling O; change NC60)" "$(yn prefix_gone "$B/prefix-now.tsv")"
    check "control: the same test refuses the base's reading given as the phase commit's (change NC60)" "$(ynnot prefix_gone "$B/prefix-base.tsv")"
    prefix_listed() { [ "$(count_matches -xF "$PREFIX_MSG" "$1")$(count_matches -xF "$PREFIX_MSG" "$B/cat-base.txt")" = 01 ]; }
    check "N8's old message is a list item of the package header's catalogue at the base, once, and not at the phase commit (ruling O; change NC60)" "$(yn prefix_listed "$B/cat-now.txt")"
    check "control: the same count refuses the base's list given as the phase commit's (change NC60)" "$(ynnot prefix_listed "$B/cat-base.txt")"
    git show "$C:specs/0016-new-workbook-and-sheets.md" >"$B/spec-0016.md"
    python3 -I -B - "$PREFIX_MSG" "$B/spec-0016.md" "$B/spec-committed.md" "$P1SPEC" >"$B/prefix-spec.txt" <<'PY'
    import re
    import sys
    m = sys.argv[1]
    for name, path in (("spec0016", sys.argv[2]), ("committed", sys.argv[3]), ("working", sys.argv[4])):
        print("%s=%s" % (name, "yes" if m and m in re.sub(r"\s+", " ", open(path).read()) else "no"))
    PY
