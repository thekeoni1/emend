    check "control: the same check refuses a copy whose sample_fill takes a gradient" "$(ynnot reach_has "$TG_OTHERS" "$B/c-grad-other.out")"
    check "control: the callers' check refuses the same copy, sample_fill calling sample_gradients" "$(ynnot reach_has "$TG_CALLERS" "$B/c-grad-other.out")"
    # Change ND56: this phase's covering crate tests, each once at the phase
    # commit, the refusing ones' bodies holding their messages as string
