    import re
    import sys
    
    main = open(sys.argv[1]).read()
    lines = main.split("\n")
    fns = {}
    order = []
    cur = None
    for line in lines:
        m = re.match(r"(pub(\(crate\))? )?fn ([a-z0-9_]+)", line)
        if m and cur is None:
            cur = (m.group(3), [])
        if cur is not None:
            cur[1].append(line)
            if line == "}":
                fns[cur[0]] = cur[1]
                order.append(cur[0])
                cur = None
    
    
    def yes(ok):
        return "yes" if ok else "no"
    
    
    def closing(text, start):
        """The index just past the bracket closing the one opened before start."""
        depth, j = 1, start
        while depth:
            c = text[j]
            if c in "{[(":
                depth += 1
            elif c in "}])":
                depth -= 1
            j += 1
        return j
    
    
    def fields(body):
        """A struct literal's top-level fields as (name, value), a spread as
        ("..", base), a shorthand field as (name, name)."""
        parts, depth, cur = [], 0, ""
        for c in body:
            if c in "{[(":
                depth += 1
            elif c in "}])":
                depth -= 1
            if c == "," and depth == 0:
                parts.append(cur.strip())
                cur = ""
            else:
                cur += c
        if cur.strip():
            parts.append(cur.strip())
        out = []
        for p in parts:
            if p.startswith(".."):
                out.append(("..", " ".join(p[2:].split())))
            elif re.match(r"[a-z_]+: ", p):
                name, value = p.split(": ", 1)
                out.append((name, " ".join(value.split())))
            else:
                out.append((p, p))
        return out
    
    
    def literals(text, name):
        out = []
        for m in re.finditer(r"\b%s \{" % name, text):
            j = closing(text, m.end())
            out.append((m.start(), fields(text[m.end():j - 1])))
        return out
    
    
    FIVE = ("drop_lines", "high_low_lines", "up_down_bars", "category_axis", "value_axis")
    builders = [n for n in order if re.search(r"\b(NewAxis|NewDateAxis) \{", "\n".join(fns[n]))]
    print("functions building an axis or a date axis: %s" % " ".join(builders))
    # Every chart literal outside the axis sample: no plot line but a stock
    # plot's high-low lines, no axis option.
    others_ok, n_full, n_spread = True, 0, 0
    for name in order:
        if name == "chart_axis_sample":
            continue
        for _, fl in literals("\n".join(fns[name]), "NewChart"):
            d = dict(fl)
            if ".." in d:
                n_spread += 1
                plot = d.get("plot")
                others_ok = others_ok and not any(f in d for f in FIVE)
                others_ok = others_ok and (plot is None or (plot.startswith("NewPlot::")
                                                            and not plot.startswith("NewPlot::Stock")))
                continue
            n_full += 1
            plot = d.get("plot", "")
            hl = d.get("high_low_lines", "")
            ok = (d.get("drop_lines") == "false" and d.get("up_down_bars") == "false"
                  and d.get("category_axis") == "None" and d.get("value_axis") == "None")
            if hl == "false":
                ok = ok and plot.startswith("NewPlot::") and not plot.startswith("NewPlot::Stock")
            elif hl == "true":
                ok = ok and plot == "NewPlot::Stock"
            else:
                ok = ok and re.fullmatch(r"[a-z_]+", plot) is not None and hl == "%s == NewPlot::Stock" % plot
            others_ok = others_ok and ok
    print("every other chart literal: no plot line but a stock plot's high-low lines, no axis option: %s"
          " (%d full, %d spread)" % (yes(others_ok and n_full > 0), n_full, n_spread))
    body = "\n".join(fns.get("chart_axis_sample", []))
    AXIS_NONE = [("min", "None"), ("max", "None"), ("log_base", "None"), ("reversed", "false"),
                 ("major_unit", "None"), ("minor_unit", "None"), ("tick_label_skip", "None"),
                 ("tick_mark_skip", "None"), ("date", "None")]
    am = re.search(r"let axis = NewAxis \{", body)
    axis_ok = bool(am) and fields(body[am.end():closing(body, am.end()) - 1]) == AXIS_NONE
    print("the axis default gives no option: %s" % yes(axis_ok))
    cm = re.search(r"let chart = \|plot: NewPlot\| NewChart \{", body)
    closure = dict(fields(body[cm.end():closing(body, cm.end()) - 1])) if cm else {}
    closure_ok = bool(closure) and closure.get("plot") == "plot" and all(
        closure.get(f) == v for f, v in (("drop_lines", "false"), ("high_low_lines", "false"),
                                         ("up_down_bars", "false"), ("category_axis", "None"),
                                         ("value_axis", "None"), ("combined", "None")))
    print("the closure chart gives no plot line, no axis option and no combined plot: %s" % yes(closure_ok))
    NUM = r"-?[0-9]+(?:\.[0-9]+)?"
    charts = {}
    for m in re.finditer(r"let ([a-z_]+) = NewChart \{", body):
        fl = fields(body[m.end():closing(body, m.end()) - 1])
        d = dict(fl)
        base = d.get("..", "")
        pm = re.fullmatch(r"chart\(NewPlot::([A-Za-z0-9]+)(?: \{(.*)\})?\)", base)
        if pm:
            charts[m.group(1)] = (pm.group(1), re.sub(r"\s", "", pm.group(2) or ""), d)
    ROUND = {"Pie", "Pie3D", "Doughnut", "OfPie"}
    XY = {"Scatter", "Bubble"}
    DATED = {"Bar", "Line", "Area", "Stock"}
    shown = []
    lines_ok = bool(charts)
    axes_shown = []
    axes_ok = bool(charts)
    
    
    def axis_fields(value):
        am = re.fullmatch(r"Some\(NewAxis \{(.*)\}\)", value, re.S)
        if not am:
            return None
        fl = fields(am.group(1))
        if fl[-1:] != [("..", "axis")]:
            return None
        return dict(fl[:-1])
    
    
    def number(v):
        m = re.fullmatch(r"Some\((%s)\)" % NUM, v)
        return float(m.group(1)) if m else None
    
    
    for name, (kind, opts, d) in charts.items():
        flags = {f: d.get(f, "false") for f in FIVE[:3]}
        shown.append("%s %s%s %s" % (name, kind, "{%s}" % opts if opts else "",
                                     ",".join("%s=%s" % kv for kv in sorted(flags.items()) if kv[1] != "false") or "-"))
        takes = {"drop_lines": kind in ("Line", "Area", "Stock"), "high_low_lines": kind in ("Line", "Stock"),
                 "up_down_bars": kind in ("Line", "Stock")}
        for f, v in flags.items():
            lines_ok = lines_ok and v in ("true", "false") and (v == "false" or takes[f])
        if kind == "Stock":
            lines_ok = lines_ok and flags["high_low_lines"] == "true"
        for which in ("category_axis", "value_axis"):
            value = d.get(which)
            if value is None:
                continue
            af = axis_fields(value)
            if af is None:
                axes_ok = False
                axes_shown.append("%s %s unread" % (name, which))
                continue
            axes_shown.append("%s %s %s" % (name, which.split("_")[0],
                                            ",".join("%s=%s" % kv for kv in sorted(af.items()))))
            if kind in ROUND:
                axes_ok = False
                continue
            category = which == "category_axis"
            date = af.get("date", "None")
            if date != "None":
                dm = re.fullmatch(r"Some\(NewDateAxis \{ base_unit: TimeUnit::(Days|Months|Years), "
                                  r"major: (None|Some\(\(([0-9]+), TimeUnit::(Days|Months|Years)\)\)), "
                                  r"minor: (None|Some\(\(([0-9]+), TimeUnit::(Days|Months|Years)\)\)), \}\)", date)
                if not dm or not category or kind not in DATED or kind in XY:
                    axes_ok = False
                    form = None
                else:
                    form = "date"
                    for count in (dm.group(3), dm.group(6)):
                        axes_ok = axes_ok and (count is None or int(count) >= 1)
            else:
                form = "category" if category and kind not in XY else "value"
            bounds = {}
            for f in ("min", "max"):
                if f in af:
                    n = number(af[f])
                    axes_ok = axes_ok and form in ("value", "date") and n is not None
                    bounds[f] = n
            if None not in bounds.values() and len(bounds) == 2:
                axes_ok = axes_ok and bounds["min"] < bounds["max"]
            if "log_base" in af:
                n = number(af["log_base"])
                axes_ok = axes_ok and form == "value" and n is not None and 2.0 <= n <= 1000.0
            if "reversed" in af:
                axes_ok = axes_ok and af["reversed"] in ("true", "false")
            for f in ("major_unit", "minor_unit"):
                if f in af:
                    n = number(af[f])
                    axes_ok = axes_ok and form == "value" and n is not None and n > 0.0
            for f in ("tick_label_skip", "tick_mark_skip"):
                if f in af:
                    sm = re.fullmatch(r"Some\(([0-9]+)\)", af[f])
                    axes_ok = axes_ok and form == "category" and bool(sm) and int(sm.group(1)) >= 1
            known = {"min", "max", "log_base", "reversed", "major_unit", "minor_unit", "tick_label_skip",
                     "tick_mark_skip", "date"}
            axes_ok = axes_ok and set(af) <= known
    print("charts: %s" % "; ".join(shown))
    print("the plot line rules: drop lines on a line, an area or a stock plot, high-low lines and up-down bars on a "
          "line or a stock plot, a stock plot's high-low lines always: %s" % yes(lines_ok))
    print("axes: %s" % "; ".join(axes_shown))
    print("the axis rules: no axis on a round kind, a date form on a bar's, a line's, an area's or a stock plot's "
          "category axis alone, each field on the form that takes it, every bound finite and the minimum below the "
          "maximum, a base 2 to 1000, every unit finite and positive, every skip and date count 1 or more: %s"
          % yes(axes_ok and axis_ok))
    lm = re.search(r"for \(\(chart, title\), k\) in \[([a-z_, ]+)\]", body)
    added = [x.strip() for x in lm.group(1).split(",")] if lm else []
    print("charts added: %s" % " ".join(added))
    print("every chart added is one read above, once: %s"
          % yes(bool(added) and sorted(added) == sorted(charts) and len(set(added)) == len(added)))
    print("combined plots: none: %s" % yes(body.count("combined: None,") == 1 and "combined: Some" not in body))
