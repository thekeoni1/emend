## the earlier run of each sample: the run directory its latest committed record names, read only (specs/0043 "Harness runs" P3; part 5 P3's change NZY, its form; change OAD)
command: <work>/prevrec.py <earlier run directory> <its committed record's .txt> <its labels>; the program:
    import os
    import sys
    
    sys.dont_write_bytecode = True
    run_dir, txt, want = sys.argv[1:4]
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    summary = []
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        summary += s[1:]
    tables = "\n".join(lines(txt)).split("\n\n")
    ok = labels == want.split() and len(tables) == 3 and tables[0].split("\n") == summary
