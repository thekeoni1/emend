    # Change NTK (M5 part 1 P3's NTC, carried): every cargo command of this log
    # runs offline; the two settings are printed below.
    export CARGO_NET_OFFLINE=true
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR RUSTDOCFLAGS RUSTFLAGS
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    LO_TIMEOUT_S=600
    SPEC=specs/0043-measurement-and-close.md
    # Change OAA: the committed blob the doc commit 7f3b43c holds (planning's
    # P3 brief, by hash).
    SPEC_WANT=cc1b5d902817c7fd9b792aa56c8a5cdfb9b4132cc71e228ed2759415c550addc
    # Change OAA: decision 3's reruns, the three samples, each with its tool
    # argument, each held to the earlier run of it (changes OAC and OAD).
    SAMPLES="sheet chartsheet copy"
    declare -A EDITS=([sheet]=--sheet-sample [chartsheet]=--chartsheet-sample [copy]=--copy-sample)
    PLANNING_SPEC=${PLANNING_SPEC:-}
    PHASE_DIR=$HOME/.cache/emend-build/m6p6-p3
    # Change OAE: Milestone 6 part 1 P2's phase directory, where part 1 P2's
    # run kept its working directory and the openpyxl fixture; read only.
    P12_PHASE=$HOME/.cache/emend-build/m6p1-p2
    # Change NSK: every build of <repo>, dry or logged, goes into the main tree's
    # subdirectory of the phase's one target root, <target>/main; no input moves
    # it and nothing here cleans it. The logged run leaves RUN_KEEP unset; a dry
    # run points it elsewhere so it leaves no keep where the logged run refuses
    # one.
    TARGET_ROOT=$PHASE_DIR/target
    BUILD_ROOT=$TARGET_ROOT/main
    # Change NZX (part 4 P3's NZG, carried): the size log and its build
    # directory, whose release binaries every run below uses.
    SIZE_LOG=${2:-$PHASE_DIR/logs/size.log}
    SIZE_BUILD=${SIZE_BUILD_ROOT:-$TARGET_ROOT/main}
    KEEP=${RUN_KEEP:-$PHASE_DIR/keep-host}
    RUN_OUT_ROOT=${RUN_OUT_ROOT:-$CORPUS/runs}
    RUN_SKIP_KEEP=${RUN_SKIP_KEEP:-no}
    case $RUN_SKIP_KEEP in yes | no) ;; *) echo "RUN_SKIP_KEEP is yes or no" >&2; exit 2 ;; esac
    INSTALLED=()
    I686=i686-unknown-linux-musl
    RECORDS_DEST=${RECORDS_DEST:-records}
    # A keep in place is another attempt's, moved below once the header can list
    # it; without SUPERSEDED_KEEP naming the attempt it is refused.
    SUPERSEDED_KEEP=${SUPERSEDED_KEEP:-}
    case $SUPERSEDED_KEEP in '' | attempt-[1-9]) ;; *) echo "SUPERSEDED_KEEP is attempt-<n> or nothing" >&2; exit 2 ;; esac
    if [ "$RUN_SKIP_KEEP" = no ] && [ -e "$KEEP" ] && [ -z "$SUPERSEDED_KEEP" ]; then echo "$KEEP is already there; name its attempt in SUPERSEDED_KEEP" >&2; exit 2; fi
    mkdir -p "$BUILD_ROOT" || exit 2
    export CARGO_TARGET_DIR=$BUILD_ROOT
    # Change OAB (specs/0043 ruling J): the records are staged in a directory
    # made for this invocation, <work>/records, set below once <work> is made;
    # nothing is staged under the script directory's out/records.
    # Change NTI: TMPDIR is <scratch>/tmp, the phase's directory's, made and
    # exported before any mktemp (close-out ruling 1); the working directory
    # is the one mktemp -d makes under it, on the disk, kept; nothing here is
    # removed.
    TMPDIR=$PHASE_DIR/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    B=$(mktemp -d) || exit 2
    # Change OAB: this invocation's record staging directory.
    RECORDS=$B/records
    # Change NSB: the counting library is the phase commit's, by git show.
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT=$(git rev-parse --short=7 "$C")
    DATE=$(date -u +%Y-%m-%d)
    # What the status pattern admits (changes NSB, NUB, NUI, NXL, NXT, NYD, NYU,
    # NZL, NZQ, NZW and OAA): this phase's log directory, this phase's four record
    # pairs (named by the run's date and the phase commit's short sha,
    # untracked), and the API record the test log writes and the size record
    # the size log writes (any date, the phase commit's short sha, untracked;
    # part 4 P3's change NZF); and, as change NXS gave it, planning's modified
    # specs/0043 when PLANNING_SPEC is given and the working file hashes to it;
    # nothing else.
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m6p6-p3/|\\?\\? records/m6p6-(p3-sheet|p3-chartsheet|p3-copy|open)-$DATE-$SHORT[.](md|txt)\$|\\?\\? records/(api-review|size)-m6p6-[0-9]{4}-[0-9]{2}-[0-9]{2}-$SHORT[.]md\$)"
    PLAN_SPEC_NOW=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    plan_admitted() { [ -n "${PLANNING_SPEC:-}" ] && [ "$PLAN_SPEC_NOW" = "$PLANNING_SPEC" ]; }
    if plan_admitted; then OURS="^((\\?\\?| ?[MARCD]) records/logs/m6p6-p3/|\\?\\? records/m6p6-(p3-sheet|p3-chartsheet|p3-copy|open)-$DATE-$SHORT[.](md|txt)\$|\\?\\? records/(api-review|size)-m6p6-[0-9]{4}-[0-9]{2}-[0-9]{2}-$SHORT[.]md\$| M specs/0043-measurement-and-close[.]md\$)"; fi
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs, its records and the API and size records" >&2
      exit 2
    fi
    # Change OAA: each sample's record stem, the phase's with the sample's
    # word (m6p6-p3-<sample>-<utc-date>-<shortsha>).
    declare -A STEMS=([sheet]=m6p6-p3-sheet-$DATE-$SHORT [chartsheet]=m6p6-p3-chartsheet-$DATE-$SHORT [copy]=m6p6-p3-copy-$DATE-$SHORT)
    STEM_OPEN=m6p6-open-$DATE-$SHORT
    # A rerun takes a suffix, so its run directory is never the superseded one.
    RUN_SUFFIX=${RUN_SUFFIX:-}
    case $RUN_SUFFIX in '' | -[b-z]) ;; *) echo "RUN_SUFFIX is -b to -z or nothing" >&2; exit 2 ;; esac
    RUN=$DATE-$SHORT$RUN_SUFFIX
    mkdir -p "$RECORDS" "$RECORDS_DEST" || exit 2
    # A rerun names the superseded run directory, which is MOVED into
    # <scripts>/out/superseded after the header prints it, never removed; it
    # must be another run of this phase, not this one.
    SUPERSEDED_RUN=${SUPERSEDED_RUN:-}
    case $SUPERSEDED_RUN in
      '' | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f] | 20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[b-z]) ;;
      *) echo "SUPERSEDED_RUN is not a run directory's name" >&2; exit 2 ;;
    esac
    if [ -n "$SUPERSEDED_RUN" ] && [ "$SUPERSEDED_RUN" = "$RUN" ]; then echo "SUPERSEDED_RUN names this run's own directory" >&2; exit 2; fi
    # Change OAA: the open pair's and every sample's.
    for f in "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt"; do
      if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
    done
    for s in $SAMPLES; do
      for f in "$RECORDS/${STEMS[$s]}.md" "$RECORDS/${STEMS[$s]}.txt" "$RECORDS_DEST/${STEMS[$s]}.md" "$RECORDS_DEST/${STEMS[$s]}.txt"; do
        if [ -e "$f" ]; then echo "$f is already there; move it aside first" >&2; exit 2; fi
      done
    done
    # A run directory that exists before the run is another attempt's; refused
    # (the runner itself refuses one holding an earlier run's conversion
    # directories, specs/0030 decision 1 A).
    # Change NVX: each sample's run directory (three, change OAA).
    for s in $SAMPLES; do
      if [ -e "$RUN_OUT_ROOT/$RUN-$s" ]; then echo "$RUN_OUT_ROOT/$RUN-$s is already there; name a fresh run" >&2; exit 2; fi
    done
    
    # The corpus's path begins with <repo>'s, so <runs> and <corpus> are
    # replaced before <repo> (M4 part 1 P3's order); the phase's directories
    # before <phase>, and <home> last.
    scrub() {
      sed -e "s#$B#<work>#g" -e "s#$TMPDIR#<scratch>/tmp#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$KEEP#<keep>#g" \
        -e "s#$TARGET_ROOT#<target>#g" -e "s#$RUN_OUT_ROOT#<runs>#g" -e "s#$CORPUS#<corpus>#g" \
        -e "s#$MAIN#<repo>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$P12_PHASE#<p1p2phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M6 part 6 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # The environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo "input (as exported by this script, change NTK): PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE CARGO_NET_OFFLINE=$CARGO_NET_OFFLINE"
    echo "input: TMPDIR=$TMPDIR"
    echo "  (TMPDIR set, made and exported by this script before any mktemp; <work> is made under it: close-out ruling 1; change NTI)"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change NTJ: the fourth shape, PYB: a Python call without -I -B (the word
    # followed by whitespace and an option or a .py path, outside a comment,
    # and not by " -I -B"). The word is built from two halves, so that this
    # form's own text is no call.
    PYW=pyth
    PYW=${PYW}on3
    pyb_count() {
      awk -v w="$PYW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { r = substr(s, i + length(w)); if (r ~ /^[ \t]+(-|[^ \t]*[.]py([ \t"]|$))/ && r !~ /^ -I -B( |$)/) { n++; break }; s = r }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "$PYW -c x" "$PYW -I -B -c x" "# $PYW -c x" "command -v $PYW" "$PYW tool.py" >"$B/pyb-fixture"
    n_self=$(pyb_count "$SELF")
    n_fix=$(pyb_count "$B/pyb-fixture")
    echo "command: pyb_count <this script>, and the same over a fixture of five lines: a call with -c, one with -I -B -c, a comment, a command -v, a call of a .py path"
    echo "  shape PYB: in this script $n_self; in the fixture $n_fix"
    check "PYB: this script holds none (change NTJ)" "$(yn [ "$n_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's two calls without -I -B and not its other three lines" "$(yn [ "$n_fix" = 2 ])"
    # Rulings Z, AD and AK a (change NWT): the defined-helper check over this
    # script's own source, and its planted controls. The program is written
    # into <work> from this script's text, so nothing is copied beside it; the
    # planted calls are built from pieces, so this text holds no call of an
    # undefined name.
    cat >"$B/defined_check.py" <<'PY'
    """The defined-helper check (specs/0037: ruling Q, carried into each script's
    own shape block by ruling Z, widened by rulings AD and AK a): every helper
    a yn, ynnot, is or isnot call names is defined in the script, and each of
    the four the script calls is itself defined in it.
    
    Usage: python3 -I -B defined_check.py <script>
    
    A call's name is the word after a command substitution's opening, a dollar
    sign and a parenthesis, followed by one of the four names and a space,
    outside a comment line; a name is defined when a line of the script reads
    "<name>() {" (leading blanks allowed). The commands a script calls by name
    through them, "[", "cmp", "true" and "podman", are not helpers
    (gen/defined.py's list). Prints one line, "called <n>; undefined: <names or
    none>; yn defined: <yes|no|not called>; ynnot defined: ...; is defined:
    ...; isnot defined: ..."; exit 0 when no name is undefined and none of the
    four is called undefined, 1 otherwise, 2 on a usage or read error."""
    import re
    import sys
    
    COMMANDS = ("[", "cmp", "true", "podman")
    WRAPPERS = ("yn", "ynnot", "is", "isnot")
    CALL = re.compile(r"\$\((yn|ynnot|is|isnot) ([^ )\"]+)")
    
    
    def main():
        if len(sys.argv) != 2:
            print("usage: defined_check.py <script>", file=sys.stderr)
            sys.exit(2)
        try:
            text = open(sys.argv[1], encoding="utf-8").read()
        except OSError as err:
            print("cannot read the script: %s" % err.strerror, file=sys.stderr)
            sys.exit(2)
        called, wrappers = set(), set()
        for line in text.split("\n"):
            if line.lstrip().startswith("#"):
                continue
            for wrapper, name in CALL.findall(line):
                wrappers.add(wrapper)
                called.add(name)
        defined = set(re.findall(r"^[ \t]*([A-Za-z_][A-Za-z0-9_]*)\(\) \{", text, re.M))
        missing = sorted(n for n in called if n not in COMMANDS and n not in defined)
    
        def state(w):
            if w not in wrappers:
                return "not called"
            return "yes" if w in defined else "no"
        print("called %d; undefined: %s; %s"
              % (len(called), " ".join(missing) if missing else "none",
                 "; ".join("%s defined: %s" % (w, state(w)) for w in WRAPPERS)))
        bad = missing or any(state(w) == "no" for w in WRAPPERS)
        sys.exit(1 if bad else 0)
    
    
    main()
    PY
    echo "command: python3 -I -B <work>/defined_check.py <this script> (the program, written from this script's text, below; sha256 $(sha_of "$B/defined_check.py")), and the same over a copy of this script with one planted yn call and one planted is call of undefined helpers, and over a planted script that calls yn and is and defines neither (rulings Z, AD and AK a)"
    sed 's/^/    /' "$B/defined_check.py"
    python3 -I -B "$B/defined_check.py" "$SELF" >"$B/def-self.out" 2>"$B/def-self.err" </dev/null
    def_rc=$?
    sed 's/^/    /' "$B/def-self.out"
    def_self_ok() { [ "$def_rc" = 0 ] && [ ! -s "$B/def-self.err" ] && [ "$(count_matches -F 'undefined: none; yn defined: yes; ynnot defined: yes; is defined: not called; isnot defined: not called' "$B/def-self.out")" = 1 ]; }
    check "every helper a yn or ynnot call of this script names is defined in it, yn and ynnot are themselves defined, and it calls neither is nor isnot (rulings Z, AD and AK a)" "$(yn def_self_ok)"
    { cat "$SELF"; printf '%s\n' "zz=\$""(yn zz_planted_undefined_helper)" "zi=\$""(is zz_planted_is_helper)"; } >"$B/def-plant.sh"
    python3 -I -B "$B/defined_check.py" "$B/def-plant.sh" >"$B/def-plant.out" 2>"$B/def-plant.err" </dev/null
    def_prc=$?
    echo "  over the planted copy: exit $def_prc; $(cat "$B/def-plant.out")"
    def_plant_ok() { [ "$def_prc" = 1 ] && [ "$(count_matches -F 'undefined: zz_planted_is_helper zz_planted_undefined_helper;' "$B/def-plant.out")" = 1 ] && [ "$(count_matches -F '; is defined: no;' "$B/def-plant.out")" = 1 ]; }
    check "control: the same check names the two planted undefined helpers in a copy of this script, the is call's among them, and is undefined there (rulings Z and AK a)" "$(yn def_plant_ok)"
    printf '%s\n' 'f() { :; }' "x=\$""(yn f)" "y=\$""(is f)" >"$B/def-noyn.sh"
    python3 -I -B "$B/defined_check.py" "$B/def-noyn.sh" >"$B/def-noyn.out" 2>"$B/def-noyn.err" </dev/null
    def_nrc=$?
    echo "  over a planted script defining f and calling yn f and is f: exit $def_nrc; $(cat "$B/def-noyn.out")"
    def_noyn_ok() { [ "$def_nrc" = 1 ] && [ "$(count_matches -F '; yn defined: no;' "$B/def-noyn.out")" = 1 ] && [ "$(count_matches -F '; is defined: no;' "$B/def-noyn.out")" = 1 ]; }
    check "control: the same check refuses a planted script that calls yn and is and defines neither (rulings AD and AK a)" "$(yn def_noyn_ok)"
    # P1 verification ruling D (change NXD): the placeholder check, the scan's
    # rule, over this script's own source, printed in this log with its
    # controls. A placeholder is a lower-case angle-bracketed word printed
    # immediately before a slash, or the target of a scrub; it is declared when
    # a root line says the word stands for something. The planted tokens are
    # built from pieces, so this text holds none.
    ph_used() {
      {
        LC_ALL=C "$G" -a -o -E 's#[^#]*#<[a-z][a-z0-9_-]*>' "$1" | LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>$'
        LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>/' "$1" | sed 's#/$##'
      } | LC_ALL=C sort -u
    }
    ph_declared() {
      LC_ALL=C "$G" -a -E '(^|echo ")root: ' "$1" | LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>(/[a-z0-9]+)? stands for' |
        LC_ALL=C "$G" -a -o -E '^<[a-z][a-z0-9_-]*>' | LC_ALL=C sort -u
    }
    ph_undeclared() { LC_ALL=C comm -23 <(ph_used "$1") <(ph_declared "$1") | count_lines /dev/stdin; }
    PL='<'
    { cat "$SELF"; printf '%s\n' "read ${PL}zzplanted>/x"; } >"$B/ph-plant.sh"
    { cat "$SELF"; printf '%s\n' "read ${PL}zzplanted>/x" "echo \"root: ${PL}zzplanted> stands for x\""; } >"$B/ph-decl.sh"
    { cat "$SELF"; printf '%s\n' "  sed -e \"s#\$X#${PL}zzscrub>#g\""; } >"$B/ph-scrub.sh"
    echo "command: the scan's placeholder rule (the tokens before a slash and the scrub targets, against the tokens the root lines declare) over this script, and over three planted copies of it: one printing a token before a slash, the same with a root line declaring it, one scrubbing to a token (P1 verification ruling D; change NXD)"
    echo "  this script: placeholders printed: $(ph_used "$SELF" | tr '\n' ' '); declared by root lines: $(ph_declared "$SELF" | tr '\n' ' '); undeclared: $(ph_undeclared "$SELF")"
    check "every placeholder this script prints is declared by a root line (the scan's rule; P1 verification ruling D; change NXD)" "$(yn [ "$(ph_undeclared "$SELF")" = 0 ])"
    echo "  the planted copies: undeclared $(ph_undeclared "$B/ph-plant.sh"), $(ph_undeclared "$B/ph-decl.sh") and $(ph_undeclared "$B/ph-scrub.sh")"
    check "control: the same check finds the one token a planted copy prints before a slash with no root line (change NXD)" "$(yn [ "$(ph_undeclared "$B/ph-plant.sh")" = 1 ])"
    check "control: the same check finds none when a root line in the planted copy declares it (change NXD)" "$(yn [ "$(ph_undeclared "$B/ph-decl.sh")" = 0 ])"
    check "control: the same check finds the scrub target a planted copy writes with no root line (change NXD)" "$(yn [ "$(ph_undeclared "$B/ph-scrub.sh")" = 1 ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M6 part 6 P2 record: the logs, the records, the check, the scan')
    DOC=$(by_subject 'M6 part 6 P3: commit planning docs (the P2 verification and rulings)')
    # Change OAA: the code commit, the phase commit (specs/0043 decision 3 A,
    # ruling M): the sheet writer's fix, its two tests and the CHANGELOG
    # bullet.
    CODE=$(by_subject 'M6 part 6 P3: a sheet add on a workbook root binding no relationships prefix')
    # Change OAA: the record the keep is compared with is the last committed
    # open-check record, the one P2's record commit, the base, added, found by
    # its subject (no hash is typed here); checked below to be an ancestor and
    # the last. The chartsheet and copy reruns are compared with what P2's
    # record commit names, the sheet rerun with what M4 part 1 P3's record
    # commit names (change OAD), and openpyxl's form is read from the fixture
    # part 1 P2's record commit's run.log hashed (change OAE).
    PREV_OPEN_REC=$(by_subject 'M6 part 6 P2 record: the logs, the records, the check, the scan')
    SHEETREC=$(by_subject 'M4 part 1 P3 record: logs, the size record, the API listing record, the sample records, the independent check')
    P12REC=$(by_subject "M6 part 1 P2 record: the logs, the run's records, the check, the scan")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  P2's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the code commit, the phase commit (decision 3 A; change OAA): ${CODE:-none}"
    echo "  the record commit the keep is compared with (the last to add an open-check record, the base; change OAA): ${PREV_OPEN_REC:-none}"
    echo "  M4 part 1 P3's record commit, whose sheet record the sheet rerun is compared with (change OAD): ${SHEETREC:-none}"
    echo "  M6 part 1 P2's record commit, whose run.log hashed the openpyxl fixture (change OAE): ${P12REC:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~2"
    for k in 0 1 2; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CODE" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the code commit, the doc commit and the base, each the next one's parent, the code commit the phase commit (change OAA)" "$(yn roles_in_order)"
    roles_ctl() { local CODE=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the phase commit (change OAA)" "$(ynnot roles_ctl)"
    roles_ctl2() { local REC=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the base" "$(ynnot roles_ctl2)"
    roles_ctl3() { local DOC=$CODE; roles_in_order; }
    check "control: roles_in_order refuses the code commit named as the doc commit (change OAA)" "$(ynnot roles_ctl3)"
    # record_is <commit> <subject prefix>: the commit is there, its subject
    # begins with the prefix, and it is an ancestor of the phase commit.
    record_is() { [ -n "$1" ] && git cat-file -e "$1^{commit}" && [ "$(git log -1 --format=%s "$1" | LC_ALL=C "$G" -cE "^$2")" = 1 ] && git merge-base --is-ancestor "$1" "$C"; }
    echo "command: git log -1 --format=%s <P2's record commit>; the same for M4 part 1 P3's and M6 part 1 P2's"
    echo "    $(git log -1 --format=%s "$PREV_OPEN_REC")"
    echo "    $(git log -1 --format=%s "$SHEETREC")"
    echo "    $(git log -1 --format=%s "$P12REC")"
    check "the named record commit is P2's record commit, an ancestor of the phase commit (change OAA)" "$(yn record_is "$PREV_OPEN_REC" 'M6 part 6 P2 record: ')"
    check "control: the same check refuses the doc commit named instead" "$(ynnot record_is "$DOC" 'M6 part 6 P2 record: ')"
    check "control: the same check refuses the code commit named instead" "$(ynnot record_is "$CODE" 'M6 part 6 P2 record: ')"
    check "the base is P2's record commit, the named record commit (change OAA)" "$(yn [ "$REC" = "$PREV_OPEN_REC" ])"
    check "M4 part 1 P3's record commit is an ancestor of the phase commit, with its subject (change OAD)" "$(yn record_is "$SHEETREC" 'M4 part 1 P3 record: ')"
    check "control: the same check refuses P2's record commit named as M4 part 1 P3's" "$(ynnot record_is "$REC" 'M4 part 1 P3 record: ')"
    check "M6 part 1 P2's record commit is an ancestor of the phase commit, with its subject (change OAE)" "$(yn record_is "$P12REC" 'M6 part 1 P2 record: ')"
    check "control: the same check refuses P2's record commit named as part 1 P2's" "$(ynnot record_is "$REC" 'M6 part 1 P2 record: ')"
    # row_field <run.tsv> <column>: the run row's column, by header name.
    row_field() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && NR == 2 { print $k }' "$1"; }
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the code commit, by its subject (decision 3 A; change OAA)" "$(yn [ "$CODE" = "$C" ])"
    check "control: the same comparison refuses the doc commit (change OAA)" "$(ynnot [ "$DOC" = "$C" ])"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT")"
    short_names_head() { [ "$(git rev-parse "$SHORT")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    echo "phase: Milestone 6 part 6 P3 ($SPEC) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # Rulings AA and AK b (change NWV): every attempt refused at entry, or
    # superseded, is named by RERUN_NOTE and each of its files hashed here,
    # the hashing asserted by a check line (M5 part 6 P4's run log's form).
    # Change NXE (P1 verification ruling F): rerun_script <files>: some
    # file named is a .sh under <phase>/superseded, the superseded script that
    # wrote the attempt; its control runs every time.
    rerun_script() { local sf; for sf in $1; do case $sf in "$PHASE_DIR"/superseded/*.sh) return 0 ;; esac; done; return 1; }
    rerun_script_ctl() { ! rerun_script "$PHASE_DIR/superseded/x/run.log" && rerun_script "$PHASE_DIR/superseded/x/run.log $PHASE_DIR/superseded/x/m6p6-p3-run.sh"; }
    check "control: rerun_script refuses a planted RERUN_FILES naming a log alone, and takes one naming a script beside it (change NXE)" "$(yn rerun_script_ctl)"
    n_rerun_files=0
    n_rerun_missing=0
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in (ruling AA)"
      for sf in ${RERUN_FILES:-}; do
        n_rerun_files=$((n_rerun_files + 1))
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          n_rerun_missing=$((n_rerun_missing + 1))
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
      rerun_hashed() { [ "$n_rerun_files" -gt 0 ] && [ "$n_rerun_missing" = 0 ]; }
      check "every file of the attempt RERUN_NOTE names is hashed above, and RERUN_FILES names at least one (rulings AA and AK b)" "$(yn rerun_hashed)"
      # Change NWV: every file RERUN_FILES names lies in <phase>/superseded.
      rerun_kept() { local sf; for sf in ${RERUN_FILES:-}; do case $sf in "$PHASE_DIR"/superseded/*) ;; *) return 1 ;; esac; done; }
      check "every file RERUN_FILES names lies in <phase>/superseded (ruling AA)" "$(yn rerun_kept)"
      rerun_script_given() { rerun_script "${RERUN_FILES:-}"; }
      check "RERUN_FILES names the superseded script that wrote the attempt, a .sh under <phase>/superseded (P1 verification ruling F; change NXE)" "$(yn rerun_script_given)"
    fi
    
    # The two move checks as functions, run over planted inputs every time
    # below, and over a real moved keep or run directory when there is one.
    # keep_pairs_ok <listing>: the .in.xlsx lines times two equal the listing's
    # lines (the pattern in double quotes so the tab is interpolated).
    keep_pairs_ok() {
      local pairs files
      pairs=$(count_matches -E "[.]in[.]xlsx${TAB}" "$1")
      files=$(count_lines "$1")
      [ "$files" -ge 2 ] && [ "$((pairs * 2))" = "$files" ]
    }
    # run_listing <dir> <listing>: the listing of a run directory, one line per
    # file, path and bytes.
    run_listing() { (cd "$1" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$2"; }
    # run_listing_ok <dir> <listing>: the listing names each file once and at
    # least one.
    run_listing_ok() {
      local files lines uniq
      files=$(find "$1" -type f | wc -l)
      lines=$(count_lines "$2")
      uniq=$(cut -f1 "$2" | LC_ALL=C sort -u | count_lines /dev/stdin)
      [ "$files" -ge 1 ] && [ "$lines" = "$files" ] && [ "$uniq" = "$files" ]
    }
    
    if [ -n "$SUPERSEDED_RUN" ]; then
    for SUP_S in $SAMPLES; do
      SUP_OUT=$RUN_OUT_ROOT/$SUPERSEDED_RUN-$SUP_S
      SUP_TO=$SELF_DIR/out/superseded/run-$SUPERSEDED_RUN-$SUP_S
      echo "the superseded run directory, moved before this run: <runs>/$SUPERSEDED_RUN-$SUP_S to <scripts>/out/superseded/run-$SUPERSEDED_RUN-$SUP_S"
      sup_there=no
      if [ -d "$SUP_OUT" ]; then
        sup_there=yes
        echo "command: sha256sum <runs>/$SUPERSEDED_RUN-$SUP_S/summary.host.tsv and summary.i686.tsv; mv <runs>/$SUPERSEDED_RUN-$SUP_S <scripts>/out/superseded/run-$SUPERSEDED_RUN-$SUP_S"
        for sl in host i686; do
          if [ -f "$SUP_OUT/summary.$sl.tsv" ]; then echo "    summary.$sl.tsv sha256 $(sha_of "$SUP_OUT/summary.$sl.tsv")"; else echo "    summary.$sl.tsv: NO HASH EXISTS, the file is not there"; fi
        done
        run_listing "$SUP_OUT" "$B/superseded-run.listing"
        echo "command: (cd <runs>/$SUPERSEDED_RUN-$SUP_S && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum"
        echo "    files $(find "$SUP_OUT" -type f | wc -l); listing lines $(count_lines "$B/superseded-run.listing"); listing sha256 $(sha_of "$B/superseded-run.listing")"
        check "the listing of $SUPERSEDED_RUN-$SUP_S names each of its files once" "$(yn run_listing_ok "$SUP_OUT" "$B/superseded-run.listing")"
        if [ -e "$SUP_TO" ]; then echo "    $SUP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$SUP_OUT" "$SUP_TO"; fi
      fi
      sup_moved() { [ ! -e "$SUP_OUT" ] && [ -d "$SUP_TO" ]; }
      if [ "$sup_there" = yes ]; then
        check "the superseded run directory $SUPERSEDED_RUN-$SUP_S is moved, not removed, before the run" "$(yn sup_moved)"
      else
        echo "    <runs>/$SUPERSEDED_RUN-$SUP_S was not there; nothing to move (P3's NTT, carried; change NUB)"
      fi
    done
    fi
    if [ -n "$SUPERSEDED_KEEP" ]; then
      KEEP_TO=$SELF_DIR/out/superseded/keep-$SUPERSEDED_KEEP
      echo "the superseded keep, moved before this run: <keep> to <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
      if [ -d "$KEEP" ]; then
        (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/superseded-keep.listing"
        echo "command: (cd <keep> && find . -type f -printf '%P<tab>%s<newline>' | LC_ALL=C sort) | sha256sum; the .in.xlsx files counted; mv <keep> <scripts>/out/superseded/keep-$SUPERSEDED_KEEP"
        echo "    pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/superseded-keep.listing"); files $(count_lines "$B/superseded-keep.listing"); listing sha256 $(sha_of "$B/superseded-keep.listing")"
        check "the moved keep's pairs times two equals its files" "$(yn keep_pairs_ok "$B/superseded-keep.listing")"
        if [ -e "$KEEP_TO" ]; then echo "    $KEEP_TO is already there"; fail=1; else mkdir -p "$SELF_DIR/out/superseded" && mv "$KEEP" "$KEEP_TO"; fi
      else
        echo "    NO LISTING EXISTS: there is no keep in place to move"
      fi
      keep_moved() { [ ! -e "$KEEP" ] && [ -d "$KEEP_TO" ]; }
      check "the superseded keep is moved, not removed, before the run" "$(yn keep_moved)"
    fi
    echo "superseded run directory named: ${SUPERSEDED_RUN:-none}; superseded keep named: ${SUPERSEDED_KEEP:-none}"
    echo
    echo "## the two move checks over planted inputs, run every time"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\n' "$TAB" "$TAB" >"$B/c-keep.listing"
    printf 'x.1.in.xlsx%s1\nx.1.out.xlsx%s1\ny.1.out.xlsx%s1\n' "$TAB" "$TAB" "$TAB" >"$B/c-keep-odd.listing"
    echo "  planted keep listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep.listing"), files $(count_lines "$B/c-keep.listing"); with an unpaired output: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/c-keep-odd.listing"), files $(count_lines "$B/c-keep-odd.listing")"
    check "keep_pairs_ok passes a planted listing of one whole pair" "$(yn keep_pairs_ok "$B/c-keep.listing")"
    check "control: keep_pairs_ok refuses a planted listing with an unpaired output" "$(ynnot keep_pairs_ok "$B/c-keep-odd.listing")"
    mkdir -p "$B/c-run/abc123" && printf 'a' >"$B/c-run/summary.host.tsv" && printf 'bb' >"$B/c-run/abc123/out.host.xlsx" && printf 'ccc' >"$B/c-run/abc123/stdout.host.txt"
    run_listing "$B/c-run" "$B/c-run.listing"
    echo "  planted run directory: files $(find "$B/c-run" -type f | wc -l); listing lines $(count_lines "$B/c-run.listing"); listing sha256 $(sha_of "$B/c-run.listing")"
    check "run_listing_ok passes the planted run directory's own listing" "$(yn run_listing_ok "$B/c-run" "$B/c-run.listing")"
    { cat "$B/c-run.listing"; head -n 1 "$B/c-run.listing"; } >"$B/c-run-dup.listing"
    check "control: run_listing_ok refuses a listing that names one file twice" "$(ynnot run_listing_ok "$B/c-run" "$B/c-run-dup.listing")"
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run builds into <target>/main, the main tree's subdirectory of the phase's target root (CARGO_TARGET_DIR; change NSU)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "TIMEOUT CHOSEN BEFORE THE RUN: --timeout 300 for the sample's child and --lo-timeout $LO_TIMEOUT_S per conversion, the figures every corpus run since Milestone 3 used; not tuned during the run."
    echo "root: <repo> stands for the repository's top level (inside <home>, scrubbed after <runs> and <corpus>, whose paths begin with it); scripts/counting.sh is read from it at the phase commit by git show; scripts/passthrough-run.sh, scripts/passthrough-record.py and scripts/edit-open-check.sh are run from it, each checked equal to the phase commit's, and the runner and the open check each source scripts/lo-check.sh, which is never run; scripts/openpyxl-ops.py and tests/fixtures/openpyxl-ops.xlsx are each checked equal to the phase commit's, and the committed fixture is read as sheetform.py's control; no image runs them in this log (change OAE); the keep's tests run in it; the four record pairs are installed into its $RECORDS_DEST/"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m6p6-p3 on the disk, the phase's directory; a superseded attempt's files are kept in <phase>/superseded; the size log is read from <phase>/logs/size.log unless the second argument names another (change NZX)"
    echo "root: <p1p2phase> stands for <home>/.cache/emend-build/m6p1-p2 on the disk, Milestone 6 part 1 P2's phase directory, read only: part 1 P2's run kept its working directory under <p1p2phase>/tmp (change OAE)"
    echo "root: <p1p2work> stands for the one directory under <p1p2phase>/tmp holding the openpyxl fixture part 1 P2's run.log hashed, part 1 P2's run's kept working directory, read only: the fixture <p1p2work>/opxcorpus/corpus/<id>.xlsx is read from it, never written (change OAE)"
    echo "root: <p2phase> stands for <home>/.cache/emend-build/m6p5-p2, Milestone 6 part 5 P2's phase directory, named only in the history this script carries from part 5 P3's; this log reads nothing there (change OAE)"
    echo "root: <sizebuild> stands for the size log's build directory, <target>/main unless SIZE_BUILD_ROOT names another for a dry run; its four release binaries are copied into <work>/bin, never run from it (change NZX)"
    echo "root: <scratch> stands for <phase>, the phase's directory, named <scratch> where TMPDIR is concerned as the close-out's scripts name it: TMPDIR is <scratch>/tmp, made and exported by this script before any mktemp, and <work> is made under it (close-out ruling 1; change NTI)"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory, which holds the script alone (change NVO); a superseded run directory and a superseded keep are moved into <scripts>/out/superseded, and this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7); no record is staged under it (change OAB)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (change NTI; the counting library, the checks' programs and outputs, derived tables, the planted listings, run directory and entry rows, the runs' TMPDIR <work>/tmp-run, the open check's TMPDIR <work>/tmp, the placeholder controls, the size log's four release binaries copied into <work>/bin/host and <work>/bin/i686 (change NZX), this invocation's record staging directory <work>/records (change OAB), the planted summaries and rows of the comparison with the earlier runs <work>/c-ident (changes OAC and OAD), the openpyxl fixture's one-workbook corpus <work>/opxcorpus and its two samples' run directories <work>/opxrun-sheet and <work>/opxrun-chartsheet (change OAE)), kept after the run and never removed"
    echo "root: <target> stands for <phase>/target on the disk, the phase's one target root: this log builds the keep's tests of <repo> into <target>/main, the main tree's subdirectory, and into no other; it builds no release binary, the size log having built them there (changes NSK and NZX)"
    echo "root: <keep> stands for <phase>/keep-host on the disk unless RUN_KEEP names another for a dry run, this phase's host keep; kept after the run for planning"
    echo "root: <corpus> stands for the private corpus directory (the manifest and the inputs under <corpus>/corpus, read)"
    echo "root: <runs> stands for the corpus run directories' parent, <corpus>/runs unless RUN_OUT_ROOT names another for a dry run; this log's run directories <runs>/$RUN-sheet, <runs>/$RUN-chartsheet and <runs>/$RUN-copy are written there (change OAA); the earlier runs of the three samples, the ones their records name, are read from <corpus>/runs and never written (change OAD)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$SELF_DIR" "$BUILD_ROOT" "$MAIN" "$KEEP" "$CORPUS" "$TMPDIR")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots other than <home>, <phase>, <work> and <runs> are distinct, none inside another (TMPDIR, <scratch>/tmp, among them; change NTI)" "$(yn roots_distinct)"
    work_in_tmpdir() { case "$B/" in "$TMPDIR/"*) return 0 ;; esac; return 1; }
    check "<work>, the directory mktemp -d made, is under TMPDIR, <scratch>/tmp (close-out ruling 1; change NTI)" "$(yn work_in_tmpdir)"
    work_ctl() { local B=/tmp/x; work_in_tmpdir; }
    check "control: the same test refuses a working directory under /tmp" "$(ynnot work_ctl)"
    work_ctl2() { local B=$SELF_DIR/out/work.x; work_in_tmpdir; }
    check "control: the same test refuses one under <scripts>/out, where the carried form made it" "$(ynnot work_ctl2)"
    tmpdir_ctl() { local TMPDIR=$SELF_DIR/out; work_in_tmpdir; }
    check "control: the same test refuses <work> against a TMPDIR it is not under" "$(ynnot tmpdir_ctl)"
    # Change NTS (specs/0033 "Planning rulings on P1", ruling 12): every
    # mktemp call of this script is checked under TMPDIR, so the source is
    # read for its calls outside comments; the call's text is built from
    # pieces, so this form's own text is no call.
    MKW='$('
    MKW=${MKW}mkt
    MKW=${MKW}emp
    count_tempcalls() {
      awk -v w="$MKW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { n++; s = substr(s, i + length(w)) }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "A=$MKW -d)" "F=$MKW)" "# $MKW -d)" >"$B/mktemp-fixture"
    n_mk=$(count_tempcalls "$SELF")
    n_mk_fix=$(count_tempcalls "$B/mktemp-fixture")
    echo "command: count_tempcalls <this script>, and the same over a fixture of three lines: a directory call, a file call, a comment"
    echo "  mktemp calls in this script outside comments: $n_mk (the one that makes <work>, checked under TMPDIR above); in the fixture: $n_mk_fix"
    check "this script makes one mktemp call, <work>'s, and no plain temporary file (ruling 12; change NTS)" "$(yn [ "$n_mk" = 1 ])"
    check "control: the same count finds the fixture's two calls and not its comment" "$(yn [ "$n_mk_fix" = 2 ])"
    runs_apart() { apart "$RUN_OUT_ROOT" "$MAIN" && apart "$RUN_OUT_ROOT" "$SELF_DIR"; }
    check "<runs> lies outside <repo> and <scripts>" "$(yn runs_apart)"
    check "control: apart refuses <target>/main/release against <target>/main, which holds it" "$(ynnot apart "$BUILD_ROOT/release" "$BUILD_ROOT")"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "the run directories: $(for s in $SAMPLES; do printf '<runs>/%s-%s ' "$RUN" "$s"; done)(changes NVX and NZQ)"
    echo "the record stems: ${STEMS[sheet]}, ${STEMS[chartsheet]}, ${STEMS[copy]} and $STEM_OPEN; the records' destination: $RECORDS_DEST, staged first in <work>/records (change OAB); RUN_SKIP_KEEP: $RUN_SKIP_KEEP"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs, its four record pairs, the API and size records) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    if plan_admitted; then n_ours_ctl_want=7; else n_ours_ctl_want=6; fi
    ours_rec_ctl() {
      {
        printf '?? records/logs/m6p6-p3/run.log\n?? records/logs/m6p6-p2/run.log\n'
        printf '?? records/m6p6-p3-sheet-%s-%s.md\n?? records/m6p6-p3-chartsheet-%s-%s.txt\n?? records/m6p6-open-%s-%s.txt\n' "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$SHORT"
        printf '?? records/api-review-m6p6-2026-01-01-%s.md\n?? records/size-m6p6-%s-%s.md\n' "$SHORT" "$DATE" "$SHORT"
        printf '?? records/m6p6-p3-copy-%s-abcdef0.md\n?? records/m6p6-copy-%s-%s.md\n?? records/m6p6-p3-%s-%s.md\n' "$DATE" "$DATE" "$SHORT" "$DATE" "$SHORT"
        printf '?? records/m6p6-p3-sheets-%s-%s.md\n?? records/m6p5-open-%s-%s.txt\n?? records/logs/m6p6-p3x/run.log\n' "$DATE" "$SHORT" "$DATE" "$SHORT"
        printf ' M ROADMAP.md\n M specs/0043-measurement-and-close.md\n M records/m6p6-p3-sheet-%s-%s.md\n' "$DATE" "$SHORT"
        printf ' M crates/emend/src/package.rs\n?? records/size-m6p6-%s-abcdef0.md\n?? records/api-review-m6p5-%s-%s.md\n M records/size-m6p6-%s-%s.md\n' "$DATE" "$DATE" "$SHORT" "$DATE" "$SHORT"
      } | count_matches -E "$OURS" /dev/stdin
    }
    check "control: the phase's status pattern admits this phase's log, its untracked record pairs and an untracked API record and size record of the phase commit alone; it refuses another phase's log, a record of another commit, P2's record stem, a stem without a sample word or with another, another part's record stem, a sibling directory, a modified roadmap or spec, a modified record, a source file, a size record of another commit, another part's API record and a modified size record (changes NSB, NUI, NZQ, NZW and OAA; the modified spec admitted only at PLANNING_SPEC, change NXS)" "$(yn [ "$(ours_rec_ctl)" = "$n_ours_ctl_want" ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources (the phase commit's, by git show; change NSB)"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts and the spec, against the phase commit"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh scripts/edit-open-check.sh scripts/openpyxl-ops.py tests/fixtures/openpyxl-ops.xlsx; do
      check "$s in the main tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { [ "$(git show "$C:scripts/excel-check-list.py" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/edit-open-check.sh)" ]; }
    check "control: the same hash comparison tells two different scripts apart" "$(ynnot tree_ctl)"
    spec_now=$(sha_of "$SPEC")
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    spec_doc=$(git show "$DOC:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum; git show <doc commit>:$SPEC | sha256sum; sha256sum $SPEC (the working file, the committed one or the copy planning gives as PLANNING_SPEC, as the status check above holds; checked against PLANNING_SPEC when it is given; changes NXL and NXS)"
    echo "  at the phase commit: $spec_committed; at the doc commit: $spec_doc; the pin: $SPEC_WANT"
    echo "  the working tree's copy: sha256 $spec_now"
    spec_ok() { [ "$spec_committed" = "$SPEC_WANT" ]; }
    check "the spec at the phase commit is at the pinned hash" "$(yn spec_ok)"
    check "the spec at the phase commit is the doc commit's" "$(yn [ "$spec_committed" = "$spec_doc" ])"
    spec_ctl() { local spec_committed=1111111111111111111111111111111111111111111111111111111111111111; spec_ok; }
    check "control: the same check refuses the spec against another hash" "$(ynnot spec_ctl)"
    echo "  PLANNING_SPEC: ${PLANNING_SPEC:-unset}"
    planning_spec_ok() { [ -z "$PLANNING_SPEC" ] || [ "$spec_now" = "$PLANNING_SPEC" ]; }
    check "the working copy of the spec is at PLANNING_SPEC when it is given (change NWS)" "$(yn planning_spec_ok)"
    planning_spec_ctl() { local PLANNING_SPEC=1111111111111111111111111111111111111111111111111111111111111111; planning_spec_ok; }
    check "control: the same check refuses a working copy against another hash" "$(ynnot planning_spec_ctl)"
    echo "command: podman image exists $IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    
    echo
    echo "## the release binaries: the size log's, copied into <work>/bin and checked against size.log's lines, both targets, for every run below (specs/0043 \"Harness runs\" P3: decision 3's reruns; part 5 P3's change NZX, carried)"
    echo "input: the size log: $SIZE_LOG (the second argument, or <phase>/logs/size.log; change NZX)"
    echo "input (environment) SIZE_BUILD_ROOT: ${INPUT_SEEN[SIZE_BUILD_ROOT]} (unset: the size log's build directory is <target>/main; a dry run may name another; change NZX)"
    size_log_there() { [ -s "$SIZE_LOG" ]; }
    check "the size log is there and not empty" "$(yn size_log_there)"
    echo "command: sha256sum <the size log>: $(sha_of "$SIZE_LOG" 2>/dev/null); tail -n 1 <the size log>: $(tail -n 1 "$SIZE_LOG" 2>/dev/null)"
    SIZE_LAST='size log checks all as expected: yes'
    size_log_passed() { [ "$(tail -n 1 "$SIZE_LOG" 2>/dev/null)" = "$SIZE_LAST" ]; }
    check "the size log's last line is \"$SIZE_LAST\" (change NZX)" "$(yn size_log_passed)"
    printf 'x\nsize log checks all as expected: no\n' >"$B/c-size-last.log"
    size_last_ctl() { local SIZE_LOG=$B/c-size-last.log; size_log_passed; }
    check "control: the same check refuses a planted log ending \"size log checks all as expected: no\"" "$(ynnot size_last_ctl)"
    # The size log prints each release binary it builds as two spaces, its path
    # under <target>/main (the host's release directory, or the i686 triple's),
    # ": sha256 ", 64 hex, ", bytes " and a count: M4 part 2 P2's form for its
    # host emend-copy (records/logs/m4p2-p2/size.log).
    HASH_FORM='^  <target>/main/(i686-unknown-linux-musl/)?release/(emend-copy|xlsx-diff): sha256 [0-9a-f]{64}, bytes [0-9]+$'
    n_hash=$(count_matches -E "$HASH_FORM" "$SIZE_LOG")
    echo "command: count_matches -E <the release hash line form> <the size log>: $n_hash"
    check "size.log holds exactly four release hash lines: emend-copy and xlsx-diff, host and $I686" "$(yn [ "$n_hash" = 4 ])"
    # sized_of <log> <triple path or nothing> <binary>: the hash the log prints
    # for that binary, or nothing.
    sized_of() { sed -n -E "s#^  <target>/main/$2release/$3: sha256 ([0-9a-f]{64}), bytes [0-9]+\$#\1#p" "$1" | head -n 1; }
    printf '  <target>/main/release/emend-copy: sha256 %s, bytes 1\n  <target>/main/%s/release/emend-copy: sha256 %s, bytes 1\n' \
      "$(printf 'a' | sha256sum | cut -d' ' -f1)" "$I686" "$(printf 'b' | sha256sum | cut -d' ' -f1)" >"$B/c-size.log"
    sized_ctl() { [ "$(sized_of "$B/c-size.log" "" emend-copy)" = "$(printf 'a' | sha256sum | cut -d' ' -f1)" ] && [ "$(sized_of "$B/c-size.log" "$I686/" emend-copy)" = "$(printf 'b' | sha256sum | cut -d' ' -f1)" ]; }
    check "control: sized_of tells the host line from the $I686 line in a planted log holding both" "$(yn sized_ctl)"
    check "control: the same form counts two lines in that planted log" "$(yn [ "$(count_matches -E "$HASH_FORM" "$B/c-size.log")" = 2 ])"
    mkdir -p "$B/bin/host" "$B/bin/i686" || exit 2
    n_bin_ok=0
    for label in host i686; do
      if [ "$label" = i686 ]; then tp="$I686/"; else tp=""; fi
      for bin in emend-copy xlsx-diff; do
        src=$SIZE_BUILD/${tp}release/$bin
        cp "$src" "$B/bin/$label/$bin"
        want=$(sized_of "$SIZE_LOG" "$tp" "$bin")
        have=$(sha_of "$B/bin/$label/$bin")
        echo "command: cp <sizebuild>/${tp}release/$bin <work>/bin/$label/$bin"
        echo "  <work>/bin/$label/$bin: sha256 $have, bytes $(stat -c %s "$B/bin/$label/$bin"); size.log's line: ${want:-none}"
        bin_is_sized() { [ -n "$want" ] && [ "$have" = "$want" ]; }
        if bin_is_sized; then n_bin_ok=$((n_bin_ok + 1)); fi
        check "$label $bin: the copy is the binary size.log hashed, not a rebuild" "$(yn bin_is_sized)"
      done
    done
    check "the four copies are the four binaries size.log hashed ($n_bin_ok of 4)" "$(yn [ "$n_bin_ok" = 4 ])"
    bin_ctl() { local have; have=$(printf 'x' | sha256sum | cut -d' ' -f1); bin_is_sized; }
    check "control: the same comparison refuses another hash" "$(ynnot bin_ctl)"
    PT_host=$B/bin/host/emend-copy
    XD_host=$B/bin/host/xlsx-diff
    PT_i686=$B/bin/i686/emend-copy
    XD_i686=$B/bin/i686/xlsx-diff
    echo "  this log builds no release binary; every run below uses these four copies (change NZX); $(rustc --version)"
    
    echo
    echo "## the corpus manifest, and its workbooks holding a calculation chain (specs/0025 P3 verification ruling 4; change NSI)"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } { print $k["id"] "\t" $k["ext"] }' "$CORPUS/manifest.tsv" >"$B/order"
    manifest_rows=$(count_lines "$B/order")
    n_regular=$(find "$CORPUS/corpus" -maxdepth 1 -type f | wc -l)
    echo "command: awk over <corpus>/manifest.tsv's id and ext columns by header name; find <corpus>/corpus -maxdepth 1 -type f"
    echo "  manifest rows: $manifest_rows; regular files under <corpus>/corpus: $n_regular"
    check "the manifest names one workbook per regular file of the corpus directory" "$(yn [ "$manifest_rows" = "$n_regular" ])"
    check "the manifest names some workbook" "$(yn [ "$manifest_rows" -ge 1 ])"
    : >"$B/chain-ids"
    while IFS="$TAB" read -r id ext; do
      if [ "$(python3 -I -B -c 'import sys, zipfile; print(1 if "xl/calcChain.xml" in zipfile.ZipFile(sys.argv[1]).namelist() else 0)' "$CORPUS/corpus/$id.$ext")" = 1 ]; then
        printf '%s\n' "$id" >>"$B/chain-ids"
      fi
    done <"$B/order"
    N_CHAIN=$(count_lines "$B/chain-ids")
    echo "command: python3 -I -B -c <zipfile namelist> <corpus>/corpus/<id>.<ext>, for each manifest row"
    echo "  corpus workbooks holding xl/calcChain.xml: $N_CHAIN of $manifest_rows (ids: $(paste -sd' ' "$B/chain-ids"))"
    echo "  the rule covering them (changes NSI and OAC): each rerun's calcChain rows are held, as every entries row, to the earlier run's (change OAC)"
    check "some corpus workbook holds a calculation chain, so the chain rows below are read" "$(yn [ "$N_CHAIN" -ge 1 ])"
    
    echo
    echo "## the reruns' rule: each row as the earlier run of the same sample had it, with its controls (specs/0043 \"Harness runs\" P3: decision 3's reruns byte-identical to their records by sha256; change OAC)"
    # Change OAC: the three samples' own line and entry rules are not carried;
    # each rerun is held to the earlier run of its sample instead (change OAD):
    # every summary and entries row the earlier run's, the label and the
    # timing columns aside; every output and line byte-identical by sha256;
    # the record's changed, added and dropped families the earlier run's.
    kv() { printf '%s\n' "$1" | tr '\t ' '\n\n' | sed -n "s/^$2=//p" | head -1; }
    # P1's summary helpers, carried verbatim (part 4 P2's change NVA, carried).
    count_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k && $k == v { n++ } END { print n + 0 }' "$1"; }
    # count_ok_where <summary> <column> <value>: among the rows whose outcome is ok.
    count_ok_where() { awk -F'\t' -v c="$2" -v v="$3" 'NR == 1 { for (i = 1; i <= NF; i++) { if ($i == c) k = i; if ($i == "outcome") o = i }; next } k && o && $o == "ok" && $k == v { n++ } END { print n + 0 }' "$1"; }
    sum_col() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { n += $k } END { print n + 0 }' "$1"; }
    # status_rows <entries> <status>: the entry rows of that status, every
    # workbook.
    status_rows() { awk -F'\t' -v s="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "status") k = i; next } k && $k == s { n++ } END { print n + 0 }' "$1"; }
    # rows_of <table.tsv>: every row but the header, its label column (when
    # the header names one) read as one word and the columns wall_s and
    # peak_rss_kb (when named) dropped, by header name, sorted: the run's
    # outcome for each workbook, whichever label and however long it took.
    rows_of() {
      awk -F'\t' -v OFS='\t' '
        NR == 1 { for (i = 1; i <= NF; i++) { if ($i == "label") lab = i; if ($i != "wall_s" && $i != "peak_rss_kb") keep[++n] = i }; next }
        { if (lab) $lab = "L"; out = ""; for (j = 1; j <= n; j++) out = out (j > 1 ? OFS : "") $keep[j]; print out }' "$1" | LC_ALL=C sort
    }
    # rows_same <table> <earlier table>: the two read the same by rows_of.
    rows_same() { [ -s "$1" ] && [ -s "$2" ] && cmp -s <(rows_of "$1") <(rows_of "$2"); }
    printf 'id\tlabel\toutcome\twall_s\tpeak_rss_kb\nw\thost\tok\t0.10\t7000\nv\thost\tok\t0.20\t7100\n' >"$B/c-sum-a.tsv"
    printf 'id\tlabel\toutcome\twall_s\tpeak_rss_kb\nv\ti686\tok\t0.40\t6100\nw\ti686\tok\t0.30\t6000\n' >"$B/c-sum-b.tsv"
    printf 'id\tlabel\toutcome\twall_s\tpeak_rss_kb\nw\thost\terror\t0.10\t7000\nv\thost\tok\t0.20\t7100\n' >"$B/c-sum-c.tsv"
    printf 'id\tlabel\toutcome\twall_s\tpeak_rss_kb\nw\thost\tok\t0.10\t7000\n' >"$B/c-sum-d.tsv"
    check "control: rows_same reads two planted summaries the same when only the label, the row order, wall_s and peak_rss_kb differ (change OAC)" "$(yn rows_same "$B/c-sum-a.tsv" "$B/c-sum-b.tsv")"
    check "control: rows_same tells a planted summary whose one outcome differs (change OAC)" "$(ynnot rows_same "$B/c-sum-a.tsv" "$B/c-sum-c.tsv")"
    check "control: rows_same tells a planted summary one row short (change OAC)" "$(ynnot rows_same "$B/c-sum-a.tsv" "$B/c-sum-d.tsv")"
    check "control: rows_same refuses a table that is not there (change OAC)" "$(ynnot rows_same "$B/c-sum-a.tsv" "$B/c-sum-none.tsv")"
    # same_ref <run dir> <earlier run dir> <id> <ext> <label> <earlier label>:
    # the row's output and its tool line in the run directory under the label,
    # and in the earlier one under the earlier label, all there, the same by
    # sha256 (part 5 P3's same_row with the earlier run's label its own; change
    # OAD).
    same_ref() {
      local f g
      for f in "out.$5.$4:out.$6.$4" "stdout.$5.txt:stdout.$6.txt"; do
        g=${f#*:}; f=${f%%:*}
        [ -f "$1/$3/$f" ] && [ -f "$2/$3/$g" ] || return 1
        [ "$(sha_of "$1/$3/$f")" = "$(sha_of "$2/$3/$g")" ] || return 1
      done
    }
    mkdir -p "$B/c-ident/a/w" "$B/c-ident/b/w" "$B/c-ident/c/w" "$B/c-ident/d/w"
    printf 'pk' >"$B/c-ident/a/w/out.i686.xlsx"; printf 'line\n' >"$B/c-ident/a/w/stdout.i686.txt"
    cp "$B/c-ident/a/w/out.i686.xlsx" "$B/c-ident/b/w/out.host.xlsx"; cp "$B/c-ident/a/w/stdout.i686.txt" "$B/c-ident/b/w/stdout.host.txt"
    cp "$B/c-ident/b/w/out.host.xlsx" "$B/c-ident/c/w/"; printf 'line2\n' >"$B/c-ident/c/w/stdout.host.txt"
    cp "$B/c-ident/b/w/stdout.host.txt" "$B/c-ident/d/w/"
    check "control: the planted differing line differs from the original (cmp)" "$(ynnot cmp -s "$B/c-ident/b/w/stdout.host.txt" "$B/c-ident/c/w/stdout.host.txt")"
    check "control: same_ref accepts a planted i686 row the same byte for byte as a planted earlier host row (change OAD)" "$(yn same_ref "$B/c-ident/a" "$B/c-ident/b" w xlsx i686 host)"
    check "control: same_ref refuses a planted row whose line differs (change OAD)" "$(ynnot same_ref "$B/c-ident/a" "$B/c-ident/c" w xlsx i686 host)"
    check "control: same_ref refuses a planted earlier row with no output (change OAD)" "$(ynnot same_ref "$B/c-ident/a" "$B/c-ident/d" w xlsx i686 host)"
    check "control: same_ref refuses an earlier label the earlier run does not hold (change OAD)" "$(ynnot same_ref "$B/c-ident/a" "$B/c-ident/b" w xlsx i686 i686)"
    # refusal_of <run dir> <id> <label>: the layer's one "error: " line when the
    # row is a refusal, else nothing.
    refusal_of() { sed -n '1s/^error: //p' "$1/$2/stderr.$3.txt"; }
    
    
    echo
    echo "## TMPDIR for the corpus runs, on the disk"
    RUNTMP=$B/tmp-run
    mkdir "$RUNTMP" || exit 2
    dev_tmp=$(stat -c %d "$RUNTMP")
    dev_corpus=$(stat -c %d "$CORPUS/corpus")
    dev_proc=$(stat -c %d /proc)
    echo "command: mkdir <work>/tmp-run; stat -c %d <work>/tmp-run <corpus>/corpus /proc; df --output=fstype,target <work>/tmp-run <corpus>/corpus"
    echo "  device of TMPDIR (<work>/tmp-run): $dev_tmp; of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    df --output=fstype,target "$RUNTMP" "$CORPUS/corpus" | sed 's/^/    /'
    check "TMPDIR for the corpus runs and the corpus directory are on one device" "$(yn [ "$dev_tmp" = "$dev_corpus" ])"
    check "control: the same comparison tells /proc's device from the corpus directory's" "$(yn [ "$dev_proc" != "$dev_corpus" ])"
    
    cat >"$B/reccheck.py" <<'PY'
    """This log's check of a passthrough record against its run directory, for
    every label the directory holds. Reads the record's .txt and .md and the run
    directory's summary.<label>.tsv, entries.<label>.tsv and each workbook's
    diff.<label>.tsv; prints one "name: yes|no" line per check and one line of
    counts. It imports only the part-family rules from
    scripts/passthrough-record.py, so the check covers the record's tables and
    its counting, not the family names. Change VJ: the dropped families are an
    input, as the changed and added ones are."""
    import importlib.util
    import os
    import sys
    
    sys.dont_write_bytecode = True
    rec_script, run_dir, txt, md, want_changed, want_added, want_dropped, tool_arg = sys.argv[1:9]
    spec = importlib.util.spec_from_file_location("record", rec_script)
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    def listed(value):
        return value.split(",") if value else []
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    tables = "\n".join(lines(txt)).split("\n\n")
    summary, entries, xml = [], [], ["\t".join(record.XML_HEADER)]
    per_label = {}
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        e = lines("%s/entries.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        entries = entries or [e[0]]
        summary += s[1:]
        entries += e[1:]
        x = []
        for row in s[1:]:
            cells = dict(zip(s[0].split("\t"), row.split("\t")))
            if cells["outcome"] != "ok" or cells["diff_exit"] not in ("0", "1"):
                continue
            for line in lines("%s/%s/diff.%s.tsv" % (run_dir, cells["id"], label)):
                c = line.split("\t")
                if c[0] == "xml":
                    x.append("\t".join([cells["id"], label] + c + [""] * (10 - 2 - len(c))))
        xml += x
        per_label[label] = (e, x)
    checks = [
        ("three tables", len(tables) == 3),
        ("the summary table is every label's summary", len(tables) == 3 and tables[0].split("\n") == summary),
        ("the entries table is every label's entries", len(tables) == 3 and tables[1].split("\n") == entries),
        ("the xml table is every compared workbook's xml rows", len(tables) == 3 and tables[2].split("\n") == xml),
    ]
    text = lines(md)
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line.startswith("| ") and not line.startswith("| ---"):
                out.append(line)
        return out[1:]
    
    
    def row(cells):
        return "| " + " | ".join(str(c) for c in cells) + " |"
    
    
    cols = ("entries",) + record.STATUSES + ("flagged",) + record.FLAGS
    xcols = ("compared", "parse_errors", "names_equal", "values_equal", "in_only", "out_only")
    for label in labels:
        e, x = per_label[label]
        head = e[0].split("\t")
        fam = {}
        for line in e[1:]:
            r = dict(zip(head, line.split("\t")))
            c = fam.setdefault(record.family(r["name"]), dict.fromkeys(cols, 0))
            c["entries"] += 1
            c[r["status"]] = c.get(r["status"], 0) + 1
            flags = [f for f in r["flags"].split(",") if f]
            c["flagged"] += 1 if flags else 0
            for f in flags:
                c[f] = c.get(f, 0) + 1
        want = [row([f] + [fam[f][k] for k in cols]) for f in record.FAMILIES if f in fam]
        want.append(row(["total"] + [sum(fam[f][k] for f in fam) for k in cols]))
        checks.append(("%s: each family row of Entries by part family" % label, section("Entries by part family: " + label) == want))
        xf, cur = {}, None
        for line in x:
            c = line.split("\t")
            name, kind = c[3], c[4]
            if kind == "parse":
                cur = xf.setdefault(record.family(name), dict.fromkeys(xcols, 0))
                cur["compared"] += 1
                parsed = c[5] == "ok" and c[6] == "ok"
                cur["parse_errors"] += 0 if parsed else 1
                differ = False
            elif kind in ("element", "attribute"):
                differ = True
            elif kind == "values":
                cur["names_equal"] += 1 if parsed and not differ else 0
                cur["values_equal"] += 1 if c[7] == "0" and c[8] == "0" else 0
                cur["in_only"] += int(c[7])
                cur["out_only"] += int(c[8])
        want = [row([f] + [xf[f][k] for k in xcols]) for f in record.FAMILIES if f in xf]
        want.append(row(["total"] + [sum(xf[f][k] for f in xf) for k in xcols]))
        checks.append(("%s: each family row of the XML comparison" % label, section("XML comparison of changed entries: " + label) == want))
        changed_f = sorted(f for f in fam if fam[f].get("changed"))
        dropped_f = sorted(f for f in fam if fam[f].get("dropped"))
        added_f = sorted(f for f in fam if fam[f].get("added"))
        checks.append(("%s: the xml families are the changed entries' families" % label, sorted(xf) == changed_f))
        checks.append(("%s: the changed entries' families are %s" % (label, want_changed or "none"), changed_f == listed(want_changed)))
        checks.append(("%s: the dropped entries' families are %s" % (label, want_dropped or "none"), dropped_f == listed(want_dropped)))
        checks.append(("%s: the added entries' families are %s" % (label, want_added or "none"), added_f == listed(want_added)))
    checks.append(("the record's Targets line", "- Targets: " + ", ".join(labels) in text))
    checks.append(("the record's Tool arguments line", "- Tool arguments: " + tool_arg in text))
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("labels %s; summary rows %d; entry rows %d; xml rows %d" % (",".join(labels), len(summary) - 1, len(entries) - 1, len(xml) - 1))
    PY
    fams_of() {
      python3 -I -B -c 'import importlib.util, sys
    spec = importlib.util.spec_from_file_location("record", sys.argv[1])
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    rows = [l.split("\t", 1) for l in open(sys.argv[2]).read().split("\n") if l]
    print(",".join(sorted({record.family(n) for (k, n) in rows if k == sys.argv[3]})))' scripts/passthrough-record.py "$1" "$2"
    }
    inst_same() { cmp -s "$RECORDS/$1" "$RECORDS_DEST/$1" && [ "$(stat -c %a "$RECORDS_DEST/$1")" = 644 ]; }
    # Change JI: no bytecode was written, so there is nothing to remove.
    no_pycache() { [ ! -e scripts/__pycache__ ]; }
    # Change OAD: the earlier run of each sample, the run directory its latest
    # committed record names, resolved before the reruns: M4 part 1 P3's sheet
    # record (that phase ran the sample on the host alone), P2's chartsheet and
    # copy records (both labels).
    echo
    echo "## the earlier run of each sample: the run directory its latest committed record names, read only (specs/0043 \"Harness runs\" P3; part 5 P3's change NZY, its form; change OAD)"
    declare -A REF_WANT=([sheet]=records/m4p1-p3-sheet-2026-10-10-669fa91.txt [chartsheet]=records/m6p6-chartsheet-2026-10-24-d88f735.txt [copy]=records/m6p6-copy-2026-10-24-d88f735.txt)
    declare -A REF_RECOF=([sheet]=$SHEETREC [chartsheet]=$REC [copy]=$REC)
    declare -A REF_PATOF=([sheet]=records/m4p1-p3-sheet- [chartsheet]=records/m6p6-chartsheet- [copy]=records/m6p6-copy-)
    declare -A REF_WHO=([sheet]="M4 part 1 P3's" [chartsheet]="P2's" [copy]="P2's")
    declare -A REF_LABELS=([sheet]="host" [chartsheet]="host i686" [copy]="host i686")
    declare -A REF_RUN=()
    # run_of_md <record .md>: the run directory the committed record names.
    run_of_md() { git show "$C:$1" 2>/dev/null | sed -n 's/^Written by .* from the run directory `\([^`]*\)`.*$/\1/p' | head -n 1; }
    # prevrec.py <run dir> <record .txt> <labels>: the earlier run directory's
    # summaries, every label's in order, against the summary table, the first
    # of three, of that run's committed record, the labels the ones given
    # (part 5 P3's, with the labels an input: change OAD).
    cat >"$B/prevrec.py" <<'PY'
    import os
    import sys
    
    sys.dont_write_bytecode = True
    run_dir, txt, want = sys.argv[1:4]
    
    
    def lines(path):
        out = open(path, encoding="utf-8").read().split("\n")
        return out[:-1] if out and out[-1] == "" else out
    
    
    labels = [l for l in ("host", "i686") if os.path.exists("%s/summary.%s.tsv" % (run_dir, l))]
    summary = []
    for label in labels:
        s = lines("%s/summary.%s.tsv" % (run_dir, label))
        summary = summary or [s[0]]
        summary += s[1:]
    tables = "\n".join(lines(txt)).split("\n\n")
    ok = labels == want.split() and len(tables) == 3 and tables[0].split("\n") == summary
    print("labels %s; summary rows %d; the record's summary table is the run directory's: %s" % (",".join(labels), len(summary) - 1, "yes" if ok else "no"))
    PY
    echo "command: <work>/prevrec.py <earlier run directory> <its committed record's .txt> <its labels>; the program:"
    sed 's/^/    /' "$B/prevrec.py"
    for SAMPLE in $SAMPLES; do
      EDIT=${EDITS[$SAMPLE]}
      PR=${REF_RECOF[$SAMPLE]}
      WHO=${REF_WHO[$SAMPLE]}
      REF_PAT=${REF_PATOF[$SAMPLE]}
      REF_MD=$(git show --name-only --format= "$PR" | LC_ALL=C "$G" -E "^${REF_PAT}[0-9-]+-[0-9a-f]{7}[.]md\$")
      REF_TXT=$(git show --name-only --format= "$PR" | LC_ALL=C "$G" -E "^${REF_PAT}[0-9-]+-[0-9a-f]{7}[.]txt\$")
      echo "command: git show --name-only --format= <$WHO record commit>, the $SAMPLE record's .md and .txt it added: ${REF_MD:-none} ${REF_TXT:-none}"
      check "$SAMPLE: $WHO record commit added exactly one record .md and one .txt of the sample (change OAD)" "$(yn [ "$(printf '%s\n%s\n' "$REF_MD" "$REF_TXT" | count_matches -E '^records/' /dev/stdin)" = 2 ])"
      check "$SAMPLE: the record is the one this phase names, ${REF_WANT[$SAMPLE]} (change OAD)" "$(yn [ "$REF_TXT" = "${REF_WANT[$SAMPLE]}" ])"
      ref_names_arg() { [ "$(git show "$C:$1" 2>/dev/null | count_matches -E "^- Tool arguments: $EDIT\$" /dev/stdin)" = 1 ]; }
      check "$SAMPLE: the record's Tool arguments line is $EDIT (change OAD)" "$(yn ref_names_arg "$REF_MD")"
      # later_by_arg <commit>: no record .md added after the commit, up to the
      # phase commit, names the sample's tool argument, so the named record is
      # the latest committed record of the sample.
      later_by_arg() {
        local f
        for f in $(git log --diff-filter=A --name-only --format= "$1..$C" -- 'records/*.md'); do
          if ref_names_arg "$f"; then return 1; fi
        done
      }
      check "$SAMPLE: no record added after it names $EDIT, so it is the latest committed record of the sample (change OAD)" "$(yn later_by_arg "$PR")"
      check "control: the same check, from the record commit's parent, finds the record itself" "$(ynnot later_by_arg "$PR~1")"
      REF_NAME=$(run_of_md "$REF_MD")
      REF=$CORPUS/runs/$REF_NAME
      echo "  the run directory the record names: <corpus>/runs/${REF_NAME:-none} (read only); its labels: ${REF_LABELS[$SAMPLE]}"
      ref_run_ok() {
        local l
        [ -n "$REF_NAME" ] && [ -d "$REF" ] || return 1
        for l in ${REF_LABELS[$SAMPLE]}; do [ -f "$REF/summary.$l.tsv" ] && [ -f "$REF/entries.$l.tsv" ] && [ -f "$REF/run.$l.tsv" ] || return 1; done
      }
      check "$SAMPLE: the run directory is there with its labels' summaries, entries and run rows (change OAD)" "$(yn ref_run_ok)"
      ref_run_ctl() { local REF=$CORPUS/runs/no-such-run; ref_run_ok; }
      check "control: the same check refuses a run directory that is not there" "$(ynnot ref_run_ctl)"
      check "$SAMPLE: the run's run row names $EDIT (change OAD)" "$(yn [ "$(row_field "$REF/run.host.tsv" tool_args)" = "$EDIT" ])"
      check "$SAMPLE: the run's run row names $WHO record commit's parent, the run's phase commit (change OAD)" "$(yn [ "$(row_field "$REF/run.host.tsv" commit)" = "$(git rev-parse "$PR~1")" ])"
      check "control: the run row check refuses the run's row against this phase's commit" "$(ynnot [ "$(row_field "$REF/run.host.tsv" commit)" = "$C" ])"
      git show "$C:$REF_TXT" >"$B/prev-ref-$SAMPLE.txt"
      echo "command: git show <phase commit>:$REF_TXT; <work>/prevrec.py <corpus>/runs/${REF_NAME:-none} <it> '${REF_LABELS[$SAMPLE]}'"
      python3 -I -B "$B/prevrec.py" "$REF" "$B/prev-ref-$SAMPLE.txt" "${REF_LABELS[$SAMPLE]}" >"$B/prevrec-ref-$SAMPLE.out" 2>&1
      echo "  $(cat "$B/prevrec-ref-$SAMPLE.out")"
      check "$SAMPLE: $WHO run directory's summaries, its labels', are its committed record's summary table (change OAD)" "$(yn [ "$(count_matches -E "is the run directory's: yes\$" "$B/prevrec-ref-$SAMPLE.out")" = 1 ])"
      sed '2d' "$B/prev-ref-$SAMPLE.txt" >"$B/c-prev-ref-$SAMPLE.txt"
      python3 -I -B "$B/prevrec.py" "$REF" "$B/c-prev-ref-$SAMPLE.txt" "${REF_LABELS[$SAMPLE]}" >"$B/c-prevrec-ref-$SAMPLE.out" 2>&1
      check "control: the same program refuses that record with one summary row dropped" "$(yn [ "$(count_matches -E "is the run directory's: no\$" "$B/c-prevrec-ref-$SAMPLE.out")" = 1 ])"
      python3 -I -B "$B/prevrec.py" "$REF" "$B/prev-ref-$SAMPLE.txt" "i686" >"$B/c-prevrec-lab-$SAMPLE.out" 2>&1
      check "control: the same program refuses the record read against another set of labels" "$(yn [ "$(count_matches -E "is the run directory's: no\$" "$B/c-prevrec-lab-$SAMPLE.out")" = 1 ])"
      REF_RUN[$SAMPLE]=$REF
    done
    
    # Change OAC: the per-sample block, part 5 P3's run for each sample in
    # turn with the samples' own rules replaced by the earlier run's rows.
    n_rr_ok=0
    for SAMPLE in $SAMPLES; do
    EDIT=${EDITS[$SAMPLE]}
    STEM=${STEMS[$SAMPLE]}
    WHO=${REF_WHO[$SAMPLE]}
    REF=${REF_RUN[$SAMPLE]}
    O=$RUN_OUT_ROOT/$RUN-$SAMPLE
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      # The earlier run's label held against this one: its own, or the host's
      # where the earlier run ran on the host alone (change OAD).
      case " ${REF_LABELS[$SAMPLE]} " in *" $label "*) RL=$label ;; *) RL=host ;; esac
      echo
      echo "## $SAMPLE: $label run, --tool-arg $EDIT, held to $WHO run's $RL rows"
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <work>/bin/$label/emend-copy --xlsx-diff <work>/bin/$label/xlsx-diff --out <runs>/$RUN-$SAMPLE --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg $EDIT"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --out "$O" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "$EDIT" \
        >"$B/run-$SAMPLE-$label.stdout" 2>"$B/run-$SAMPLE-$label.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$SAMPLE-$label.stderr")"
      sed 's/^/    /' "$B/run-$SAMPLE-$label.stdout"
      check "$SAMPLE $label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$SAMPLE $label: its stderr is empty" "$(yn [ ! -s "$B/run-$SAMPLE-$label.stderr" ])"
      n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
      echo "  entries left in <work>/tmp-run after the run: $n_left"
      check "$SAMPLE $label: the runs' TMPDIR is empty after the run" "$(yn [ "$n_left" = 0 ])"
      SUM=$O/summary.$label.tsv
      ENT=$O/entries.$label.tsv
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      n_ok=$(count_where "$SUM" outcome ok)
      # The refusals, by id and message.
      : >"$B/refused-$SAMPLE-$label"
      while IFS="$TAB" read -r id ext; do
        if [ "$(awk -F'\t' -v id="$id" 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["id"] == id { print $k["outcome"] " " $k["exit"] }' "$SUM")" = "error 2" ] \
           && [ "$(count_lines "$O/$id/stderr.$label.txt")" = 1 ] && [ -n "$(refusal_of "$O" "$id" "$label")" ]; then
          printf '%s\t%s\n' "$id" "$(refusal_of "$O" "$id" "$label")" >>"$B/refused-$SAMPLE-$label"
        fi
      done <"$B/order"
      n_ref=$(count_lines "$B/refused-$SAMPLE-$label")
      echo "  summary rows: $rows; outcome ok: $n_ok; refused by the layer (a finding; fails the summary): $n_ref"
      sed 's/^/    refused: /' "$B/refused-$SAMPLE-$label"
      echo "  among the ok rows: lo ok $(count_ok_where "$SUM" lo ok); lo_in ok $(count_ok_where "$SUM" lo_in ok); leftover no $(count_ok_where "$SUM" leftover no); order_preserved yes $(count_ok_where "$SUM" order_preserved yes); comment_equal yes $(count_ok_where "$SUM" comment_equal yes); files_identical no $(count_ok_where "$SUM" files_identical no), yes $(count_ok_where "$SUM" files_identical yes)"
      echo "  every row: lo_in ok $(count_where "$SUM" lo_in ok); leftover no $(count_where "$SUM" leftover no)"
      echo "  entry totals: identical $(sum_col "$SUM" identical), recompressed $(sum_col "$SUM" recompressed), changed $(sum_col "$SUM" changed), dropped $(sum_col "$SUM" dropped), added $(sum_col "$SUM" added), flagged $(sum_col "$SUM" flagged)"
      echo "  the entries table's rows by status: identical $(status_rows "$ENT" identical), recompressed $(status_rows "$ENT" recompressed), changed $(status_rows "$ENT" changed), dropped $(status_rows "$ENT" dropped), added $(status_rows "$ENT" added)"
      summary_ok() {
        local col st
        [ "$rows" = "$manifest_rows" ] || return 1
        [ "$n_ok" = "$rows" ] && [ "$n_ref" = 0 ] || return 1
        for col in "lo ok" "lo_in ok" "leftover no"; do
          [ "$(count_ok_where "$SUM" ${col% *} ${col#* })" = "$n_ok" ] || return 1
        done
        [ "$(count_where "$SUM" lo_in ok)" = "$rows" ] || return 1
        [ "$(count_where "$SUM" leftover no)" = "$rows" ] || return 1
        for st in identical recompressed changed dropped added; do
          [ "$(sum_col "$SUM" "$st")" = "$(status_rows "$ENT" "$st")" ] || return 1
        done
      }
      check "$SAMPLE $label: every row ok; every row's input opens (lo_in ok) with no leftover; every output opens (lo ok); the summary's status totals the entries table's (change OAC)" "$(yn summary_ok)"
      check "$SAMPLE $label: every summary row is $WHO run's $RL row, the label, wall_s and peak_rss_kb aside (change OAC)" "$(yn rows_same "$SUM" "$REF/summary.$RL.tsv")"
      check "$SAMPLE $label: every entries row is $WHO run's $RL row, the label aside (change OAC)" "$(yn rows_same "$ENT" "$REF/entries.$RL.tsv")"
      echo "  per ok workbook: id and the tool's line (counts and flags only)"
      : >"$B/lines-$SAMPLE-$label"
      nwb=0
      while IFS="$TAB" read -r id ext; do
        if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$SAMPLE-$label")" ]; then continue; fi
        nwb=$((nwb + 1))
        e=$(cat "$O/$id/stdout.$label.txt")
        printf '%s\t%s\n' "$id" "$e" >>"$B/lines-$SAMPLE-$label"
        printf '    %s %s\n' "$id" "$(printf '%s' "$e" | tr '\t' ' ')"
      done <"$B/order"
      echo "  ok workbooks read: $nwb"
      check "$SAMPLE $label: every ok workbook's line was read" "$(yn [ "$nwb" = "$n_ok" ])"
      nrow=0; nsame=0
      : >"$B/ident-$SAMPLE-$label"
      while IFS="$TAB" read -r id ext; do
        nrow=$((nrow + 1))
        printf '    %s %s out %s %s line %s %s\n' "$id" "$label" \
          "$(sha_of "$O/$id/out.$label.$ext" 2>/dev/null)" "$(sha_of "$REF/$id/out.$RL.$ext" 2>/dev/null)" \
          "$(sha_of "$O/$id/stdout.$label.txt" 2>/dev/null)" "$(sha_of "$REF/$id/stdout.$RL.txt" 2>/dev/null)" >>"$B/ident-$SAMPLE-$label"
        if same_ref "$O" "$REF" "$id" "$ext" "$label" "$RL"; then nsame=$((nsame + 1)); else echo "    FINDING (an output byte of the sample moved since $WHO run; change OAD): $id: $label: the output or the line differs from $WHO run's $RL row"; fi
      done <"$B/order"
      echo "  $SAMPLE $label: per row, id, label, the output's sha256 now and in $WHO run ($RL), the line's now and in $WHO run ($RL):"
      cat "$B/ident-$SAMPLE-$label"
      echo "  $SAMPLE $label: rows compared $nrow; identical, output and line, by sha256: $nsame"
      rr_same() { [ "$nrow" = "$manifest_rows" ] && [ "$nsame" = "$nrow" ]; }
      if rr_same; then n_rr_ok=$((n_rr_ok + 1)); fi
      check "$SAMPLE $label: every row's output and line are byte-identical to $WHO run's $RL row, by sha256, $nsame of $manifest_rows (change OAD)" "$(yn rr_same)"
      R=$O/run.$label.tsv
      args=$(row_field "$R" tool_args)
      bins_in_row() { [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } NR == 2 { print $k["passthrough_sha256"] " " $k["xlsx_diff_sha256"] " " $k["commit"] }' "$R")" = "$(sha_of "$PT") $(sha_of "$XD") $C" ]; }
      check "$SAMPLE $label: the run row records the size log's two release binaries, the copies in <work>/bin, by sha256 and the phase commit (change NZX)" "$(yn bins_in_row)"
      check "$SAMPLE $label: the run row's tool_args is $EDIT" "$(yn [ "$args" = "$EDIT" ])"
    done
    check "$SAMPLE: the same workbooks are refused on both targets, with the same messages (none)" "$(yn cmp -s "$B/refused-$SAMPLE-host" "$B/refused-$SAMPLE-i686")"
    cp "$B/refused-$SAMPLE-host" "$B/c-refused"; printf 'x\tsome message\n' >>"$B/c-refused"
    check "control: the same comparison tells a planted refusal list from the host's" "$(ynnot cmp -s "$B/c-refused" "$B/refused-$SAMPLE-i686")"
    mkdir -p "$B/c-refrun/r1"
    printf 'error: a planted message\n' >"$B/c-refrun/r1/stderr.host.txt"
    ref_read() { [ "$(refusal_of "$B/c-refrun" r1 host)" = "a planted message" ]; }
    check "control: refusal_of reads a planted refusal's message" "$(yn ref_read)"
    : >"$B/c-refrun/r1/stderr.host.txt"
    ref_none() { [ -z "$(refusal_of "$B/c-refrun" r1 host)" ]; }
    check "control: refusal_of reads nothing from an empty standard error" "$(yn ref_none)"
    rr_first_id=$(head -n 1 "$B/order" | cut -f1)
    rr_first_ext=$(head -n 1 "$B/order" | cut -f2)
    rr_ctl() { same_ref "$O" "$REF" "${rr_first_id}x" "$rr_first_ext" host host; }
    check "control: $SAMPLE: same_ref refuses the first workbook's id with a letter appended, which neither run holds" "$(ynnot rr_ctl)"
    rows_ctl() { awk -F'\t' -v OFS='\t' 'NR == 2 { $1 = $1 "x" } { print }' "$O/summary.host.tsv" >"$B/c-sum-$SAMPLE.tsv"; rows_same "$B/c-sum-$SAMPLE.tsv" "$REF/summary.host.tsv"; }
    check "control: $SAMPLE: rows_same refuses the host summary with its first row's id changed (change OAC)" "$(ynnot rows_ctl)"
    
    echo
    echo "### $SAMPLE: the two labels' outputs"
    same_out=0
    nboth=0
    while IFS="$TAB" read -r id ext; do
      if [ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$B/refused-$SAMPLE-host")" ]; then continue; fi
      nboth=$((nboth + 1))
      if cmp -s "$O/$id/out.host.$ext" "$O/$id/out.i686.$ext"; then same_out=$((same_out + 1)); else echo "    $id: the outputs differ"; fi
    done <"$B/order"
    echo "  ok workbooks: $nboth; whose host and i686 outputs are byte for byte the same: $same_out"
    check "$SAMPLE: every output is the same on both targets" "$(yn [ "$same_out" = "$nboth" ])"
    check "$SAMPLE: both targets printed the same line for every ok workbook" "$(yn cmp -s "$B/lines-$SAMPLE-host" "$B/lines-$SAMPLE-i686")"
    cp "$B/lines-$SAMPLE-host" "$B/c-lines"; printf 'x\n' >>"$B/c-lines"
    check "control: the same comparison tells a line list with one line added" "$(ynnot cmp -s "$B/c-lines" "$B/lines-$SAMPLE-i686")"
    
    echo
    echo "## the $SAMPLE run's record pair"
    echo "command: python3 -I -B scripts/passthrough-record.py --run <runs>/$RUN-$SAMPLE --out <work>/records --stem $STEM (changes NTJ, NUW, NVX and OAB)"
    python3 -I -B scripts/passthrough-record.py --run "$O" --out "$RECORDS" --stem "$STEM" >"$B/record-$SAMPLE.out" 2>&1
    rrc=$?
    sed 's/^/    /' "$B/record-$SAMPLE.out"
    check "$SAMPLE: the record script exits 0" "$(yn [ "$rrc" = 0 ])"
    RTXT=$RECORDS/$STEM.txt
    RMD=$RECORDS/$STEM.md
    # The families: the names of the host entries table's changed, added and
    # dropped rows (change NSR), against the earlier run's host entries'
    # (change OAC).
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] ~ /^(changed|added|dropped)$/ { print $k["status"] "\t" $k["name"] }' "$O/entries.host.tsv" >"$B/w-$SAMPLE.parts"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $k["status"] ~ /^(changed|added|dropped)$/ { print $k["status"] "\t" $k["name"] }' "$REF/entries.host.tsv" >"$B/ref-$SAMPLE.parts"
    check "$SAMPLE: some changed, added or dropped name in the host entries table ($(count_lines "$B/w-$SAMPLE.parts") names; change NSR)" "$(yn [ "$(count_lines "$B/w-$SAMPLE.parts")" -ge 1 ])"
    FAM_CHANGED=$(fams_of "$B/w-$SAMPLE.parts" changed)
    FAM_ADDED=$(fams_of "$B/w-$SAMPLE.parts" added)
    FAM_DROPPED=$(fams_of "$B/w-$SAMPLE.parts" dropped)
    REF_FAMS="$(fams_of "$B/ref-$SAMPLE.parts" changed | sed 's/^$/-/') $(fams_of "$B/ref-$SAMPLE.parts" added | sed 's/^$/-/') $(fams_of "$B/ref-$SAMPLE.parts" dropped | sed 's/^$/-/')"
    echo "  the families: changed ${FAM_CHANGED:-none}; added ${FAM_ADDED:-none}; dropped ${FAM_DROPPED:-none}; $WHO run's host entries' (changed, added, dropped; - for none): $REF_FAMS"
    fams_ok() { [ "${FAM_CHANGED:--} ${FAM_ADDED:--} ${FAM_DROPPED:--}" = "$REF_FAMS" ]; }
    check "$SAMPLE: the changed, added and dropped families are $WHO run's: $REF_FAMS (- for none; change OAC)" "$(yn fams_ok)"
    fams_ctl() { local FAM_ADDED=planted; fams_ok; }
    check "control: the same check refuses a planted added family" "$(ynnot fams_ctl)"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/reccheck-$SAMPLE.out" 2>&1
    echo "  exit: $?"
    sed 's/^/    /' "$B/reccheck-$SAMPLE.out"
    rec_all() { [ "$(count_matches -E ': yes$' "$B/reccheck-$SAMPLE.out")" = 18 ] && [ "$(count_matches -E ': no$' "$B/reccheck-$SAMPLE.out")" = 0 ]; }
    check "$SAMPLE: the record's three tables are the run directory's, and its family tables are counted from them (eighteen checks: four, six per label, two)" "$(yn rec_all)"
    awk '!done && /^[|] total [|]/ { done = 1; next } { print }' "$RMD" >"$B/c-rec.md"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$B/c-rec.md" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/c-reccheck.out" 2>&1
    sed '2d' "$RTXT" >"$B/c-rec.txt"
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$B/c-rec.txt" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "$FAM_DROPPED" "$EDIT" >"$B/c-reccheck2.out" 2>&1
    python3 -I -B "$B/reccheck.py" scripts/passthrough-record.py "$O" "$RTXT" "$RMD" "$FAM_CHANGED" "$FAM_ADDED" "planted" "$EDIT" >"$B/c-reccheck3.out" 2>&1
    rec_ctl() { [ "$(count_matches -E ': no$' "$B/c-reccheck.out")" -ge 1 ] && [ "$(count_matches -F "the summary table is every label's summary: no" "$B/c-reccheck2.out")" = 1 ]; }
    check "control: the same check finds an .md with a family table's total row dropped and a .txt one summary row short" "$(yn rec_ctl)"
    rec_drop() { [ "$(count_matches -E "the dropped entries' families are planted: no\$" "$B/c-reccheck3.out")" = 2 ]; }
    check "control: the same check finds the dropped families differ from a planted family, on each label" "$(yn rec_drop)"
    check "the record script and the record check left no scripts/__pycache__ (PYTHONDONTWRITEBYTECODE)" "$(yn no_pycache)"
    echo "command: install -m 644 <work>/records/$STEM.md <work>/records/$STEM.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RMD" "$RTXT" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM.md" "$RECORDS_DEST/$STEM.txt")
    echo "  exit: $?"
    for f in "$STEM.md" "$STEM.txt"; do
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, mode 644" "$(yn inst_same "$f")"
    done
    done
    echo
    check "the three samples on both labels byte-identical to their earlier runs ($n_rr_ok of 6; change OAD)" "$(yn [ "$n_rr_ok" = 6 ])"
    rr_cross_ctl() { same_ref "$RUN_OUT_ROOT/$RUN-sheet" "${REF_RUN[copy]}" "$rr_first_id" "$rr_first_ext" host host; }
    check "control: same_ref refuses the sheet sample's first row against P2's copy run" "$(ynnot rr_cross_ctl)"
    
    echo
    echo "## openpyxl's form: part 1 P2's kept fixture, --sheet-sample and --chartsheet-sample on it through the runner by the size log's release binaries, both targets, the input and every output opened by LibreOffice, each new <sheet> declaring the relationships namespace itself (specs/0043 decision 3 A, ruling M reading 1 (a); change OAE)"
    # The fixture is fictional: the workbook the pinned openpyxl image wrote
    # from the committed tests/fixtures/openpyxl-ops.xlsx by openpyxl's
    # chartsheet op in part 1 P2's run, kept in that run's working directory.
    # It is read from there and never written; its copy goes into a
    # one-workbook corpus under <work>, which the runner takes with --corpus,
    # so lo and lo_in are the runner's open checks.
    P12LOG=records/logs/m6p1-p2/run.log
    OPX_SHA=$(git show "$C:$P12LOG" | sed -n -E 's/^  the output: [0-9]+ bytes, sha256 ([0-9a-f]{64})$/\1/p' | head -n 1)
    OPX_BYTES=$(git show "$C:$P12LOG" | sed -n -E 's/^  the output: ([0-9]+) bytes, sha256 [0-9a-f]{64}$/\1/p' | head -n 1)
    OPX_ID=${OPX_SHA:0:12}
    echo "command: git show <phase commit>:$P12LOG, its op output's line; the file added by part 1 P2's record commit"
    echo "  the op output part 1 P2's run.log hashed: ${OPX_BYTES:-none} bytes, sha256 ${OPX_SHA:-none}; id ${OPX_ID:-none}"
    p12_added() { git show --name-only --format= "$P12REC" | LC_ALL=C "$G" -qxF "$P12LOG"; }
    check "part 1 P2's record commit added $P12LOG (change OAE)" "$(yn p12_added)"
    check "part 1 P2's run.log prints one op output line with its sha256 (change OAE)" "$(yn [ "$(git show "$C:$P12LOG" | count_matches -E '^  the output: [0-9]+ bytes, sha256 [0-9a-f]{64}$' /dev/stdin)" = 1 ])"
    # Part 1 P2's run refused the chartsheet sample on this fixture on both
    # targets (specs/0038 ruling J), the refusal decision 3 A removes.
    n_p12_ref=$(git show "$C:$P12LOG" | count_matches -E '^  fixture chartsheet (host|i686): exit 2, nothing on standard output, .* no output file .*: yes$' /dev/stdin)
    echo "  part 1 P2's run.log's refusal lines of the chartsheet sample on this fixture: $n_p12_ref"
    check "part 1 P2's run.log shows the chartsheet sample refused on this fixture on both targets, exit 2 and no output file, the refusal decision 3 A removes (change OAE)" "$(yn [ "$n_p12_ref" = 2 ])"
    # The one directory under <p1p2phase>/tmp holding the fixture by that
    # sha256, part 1 P2's run's kept working directory.
    : >"$B/p12-dirs"
    for d in "$P12_PHASE"/tmp/*/; do
      f=${d}opxcorpus/corpus/$OPX_ID.xlsx
      if [ -f "$f" ] && [ "$(sha_of "$f")" = "$OPX_SHA" ]; then printf '%s\n' "${d%/}" >>"$B/p12-dirs"; fi
    done
    echo "command: for each directory under <p1p2phase>/tmp, sha256sum of its opxcorpus/corpus/$OPX_ID.xlsx, against part 1 P2's run.log's"
    echo "  directories holding the fixture by that sha256: $(count_lines "$B/p12-dirs")"
    sed 's/^/    /' "$B/p12-dirs"
    check "exactly one directory under <p1p2phase>/tmp holds the fixture part 1 P2's run.log hashed (change OAE)" "$(yn [ "$(count_lines "$B/p12-dirs")" = 1 ])"
    P12_WORK=$(head -n 1 "$B/p12-dirs")
    OPX_KEPT=$P12_WORK/opxcorpus/corpus/$OPX_ID.xlsx
    kept_ok() { [ -f "$OPX_KEPT" ] && [ "$(sha_of "$OPX_KEPT")" = "$OPX_SHA" ] && [ "$(stat -c %s "$OPX_KEPT")" = "$OPX_BYTES" ]; }
    check "the kept fixture <p1p2work>/opxcorpus/corpus/$OPX_ID.xlsx is $OPX_BYTES bytes at that sha256 (change OAE)" "$(yn kept_ok)"
    kept_ctl() { local OPX_SHA; OPX_SHA=$(printf 'x' | sha256sum | cut -d' ' -f1); kept_ok; }
    check "control: the same check refuses another sha256" "$(ynnot kept_ctl)"
    # The one-workbook corpus the runner takes with --corpus (part 5 P3's
    # program, the note of its row this fixture's).
    cat >"$B/opxcorpus.py" <<'PY'
    """Copies the workbook given first into corpus/<id>.xlsx in the directory
    given second, and writes manifest.tsv beside corpus there, one row in
    specs/0005's form, <id> the first twelve hex digits of the workbook's
    sha256; the date given third is the row's added column. Prints the id, the
    byte count and the sha256."""
    import hashlib
    import os
    import sys
    
    sys.dont_write_bytecode = True
    MANIFEST_HEADER = ("id\tsha256\tbytes\text\tproducer\tproducer_version\tapp\tsource\ttags\tadded"
                       "\toriginal_name\tnote")
    src, out, date = sys.argv[1:4]
    data = open(src, "rb").read()
    digest = hashlib.sha256(data).hexdigest()
    ident = digest[:12]
    os.makedirs(os.path.join(out, "corpus"))
    with open(os.path.join(out, "corpus", ident + ".xlsx"), "wb") as f:
        f.write(data)
    row = [ident, digest, str(len(data)), "xlsx", "openpyxl", "3.1.5", "openpyxl", "generated", "fixture",
           date, "openpyxl-chartsheet.xlsx", "fictional"]
    with open(os.path.join(out, "manifest.tsv"), "w", encoding="utf-8", newline="\n") as f:
        f.write(MANIFEST_HEADER + "\n" + "\t".join(row) + "\n")
    print("%s\t%d\t%s" % (ident, len(data), digest))
    PY
    echo "command: python3 -I -B <work>/opxcorpus.py <p1p2work>/opxcorpus/corpus/$OPX_ID.xlsx <work>/opxcorpus $DATE; the program:"
    sed 's/^/    /' "$B/opxcorpus.py"
    python3 -I -B "$B/opxcorpus.py" "$OPX_KEPT" "$B/opxcorpus" "$DATE" >"$B/opxcorpus.out" 2>"$B/opxcorpus.err" </dev/null
    oc_rc=$?
    OPX_IN=$B/opxcorpus/corpus/$OPX_ID.xlsx
    echo "  exit: $oc_rc; standard error $(wc -c <"$B/opxcorpus.err") bytes; the fixture: id $(cut -f1 "$B/opxcorpus.out"), $(cut -f2 "$B/opxcorpus.out") bytes, sha256 $(cut -f3 "$B/opxcorpus.out")"
    ocp_ok() { [ "$oc_rc" = 0 ] && [ ! -s "$B/opxcorpus.err" ] && [ "$(cut -f1 "$B/opxcorpus.out")" = "$OPX_ID" ] && cmp -s "$OPX_IN" "$OPX_KEPT"; }
    check "the corpus program exits 0, writes nothing to its standard error, and its copy is the kept fixture byte for byte" "$(yn ocp_ok)"
    check "the kept fixture is unchanged after the copy (read only; change OAE)" "$(yn kept_ok)"
    # sheetform.py: ruling M's form, checked on an input and an output.
    cat >"$B/sheetform.py" <<'PY'
    """Checks a sheet add on openpyxl's form (specs/0043-measurement-and-close.md
    decision 3 A, ruling M): the input's xl/workbook.xml root start tag binds no
    prefix to the relationships namespace, transitional or strict, and every
    <sheet> element of the input declares it itself (openpyxl's form); the
    output's root start tag is the input's byte for byte; the input's <sheet>
    elements are in the output byte for byte, in their order; the output holds
    exactly one <sheet> element more, written as ruling M gives it:
    <sheet name=".." sheetId=".." xmlns:r="<the transitional relationships
    namespace>" r:id=".."/>, its r:id an Id of the workbook's relationships part.
    Usage: sheetform.py <input> <output>, printing one "name: yes|no" line per
    check and the new element; or sheetform.py --plant <output> <copy>, which
    writes a copy of the output whose new <sheet> has lost its declaration (the
    control)."""
    import re
    import sys
    import zipfile
    
    sys.dont_write_bytecode = True
    REL = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
    STRICT = "http://purl.oclc.org/ooxml/officeDocument/relationships"
    WB = "xl/workbook.xml"
    RELS = "xl/_rels/workbook.xml.rels"
    SHEET = re.compile(r"<sheet\s[^>]*/>")
    ROOT = re.compile(r"<workbook(\s[^>]*)?>")
    NEW = re.compile(r'<sheet name="[^"]*" sheetId="[0-9]+" xmlns:r="%s" r:id="([^"]*)"/>' % re.escape(REL))
    
    
    def text(path, name):
        return zipfile.ZipFile(path).read(name).decode("utf-8")
    
    
    def plant(src, dst):
        zin = zipfile.ZipFile(src)
        with zipfile.ZipFile(dst, "x") as zout:
            for info in zin.infolist():
                data = zin.read(info.filename)
                if info.filename == WB:
                    data = data.decode("utf-8").replace(' xmlns:r="%s" r:id=' % REL, ' r:id=', 1).encode("utf-8")
                    # Only the new element reads name, sheetId, xmlns:r, r:id in
                    # that order; openpyxl's put xmlns:r first.
                zout.writestr(info, data)
    
    
    def main():
        if sys.argv[1:2] == ["--plant"] and len(sys.argv) == 4:
            plant(sys.argv[2], sys.argv[3])
            return
        if len(sys.argv) != 3:
            print("usage: sheetform.py <input> <output> | --plant <output> <copy>", file=sys.stderr)
            sys.exit(2)
        win, wout = text(sys.argv[1], WB), text(sys.argv[2], WB)
        rin, rout = ROOT.search(win), ROOT.search(wout)
        sin, sout = SHEET.findall(win), SHEET.findall(wout)
        kept = [s for s in sout if s in sin]
        new = [s for s in sout if s not in sin]
        ids = set(re.findall(r'\sId="([^"]*)"', text(sys.argv[2], RELS)))
        m = NEW.fullmatch(new[0]) if len(new) == 1 else None
        checks = [
            ("the input's root binds no prefix to the relationships namespace",
             rin is not None and REL not in rin.group(0) and STRICT not in rin.group(0)),
            ("every input sheet element declares the relationships namespace itself",
             bool(sin) and all(('xmlns:r="%s"' % REL) in s for s in sin)),
            ("the output's root start tag is the input's", rin is not None and rout is not None and rin.group(0) == rout.group(0)),
            ("the input's sheet elements are in the output byte for byte, in their order", kept == sin),
            ("the output holds one sheet element more", len(sout) == len(sin) + 1 and len(new) == 1),
            ("the new sheet element is name, sheetId, xmlns:r the transitional namespace, r:id, as ruling M gives", m is not None),
            ("the new sheet element's r:id is an Id of the workbook's relationships part", m is not None and m.group(1) in ids),
        ]
        for name, ok in checks:
            print("%s: %s" % (name, "yes" if ok else "no"))
        print("new: %s" % (new[0] if len(new) == 1 else "none"))
    
    
    main()
    PY
    echo "command: python3 -I -B <work>/sheetform.py <input> <output>, for each output below; the program:"
    sed 's/^/    /' "$B/sheetform.py"
    for FS in sheet chartsheet; do
    for label in host i686; do
      var=PT_$label; PT=${!var}; var=XD_$label; XD=${!var}
      FO=$B/opxrun-$FS
      echo
      echo "### openpyxl's form, $FS, $label"
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label $label --passthrough <work>/bin/$label/emend-copy --xlsx-diff <work>/bin/$label/xlsx-diff --corpus <work>/opxcorpus --out <work>/opxrun-$FS --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S --timeout 300 --tool-arg --$FS-sample"
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label "$label" --passthrough "$PT" --xlsx-diff "$XD" --corpus "$B/opxcorpus" --out "$FO" \
        --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" --timeout 300 --tool-arg "--$FS-sample" \
        >"$B/opx-$FS-$label.stdout" 2>"$B/opx-$FS-$label.stderr" </dev/null
      frc=$?
      echo "  exit $frc; stderr bytes: $(wc -c <"$B/opx-$FS-$label.stderr")"
      sed 's/^/    /' "$B/opx-$FS-$label.stdout"
      FSUM=$FO/summary.$label.tsv
      opx_row_ok() { [ "$frc" = 0 ] && [ ! -s "$B/opx-$FS-$label.stderr" ] && [ "$(awk 'NR > 1' "$FSUM" | wc -l)" = 1 ] \
        && [ "$(count_where "$FSUM" outcome ok)" = 1 ] && [ "$(count_where "$FSUM" lo ok)" = 1 ] \
        && [ "$(count_where "$FSUM" lo_in ok)" = 1 ] && [ "$(count_where "$FSUM" leftover no)" = 1 ]; }
      check "openpyxl's form $FS $label: the run exits 0 with an empty stderr, its one row ok, the input and the output opening in LibreOffice (lo_in and lo ok), nothing left over (change OAE)" "$(yn opx_row_ok)"
      e=$(cat "$FO/$OPX_ID/stdout.$label.txt")
      printf '%s\n' "$e" >"$B/opxline-$FS-$label"
      echo "  the line: $(printf '%s' "$e" | tr '\t' ' ')"
      opx_line_ok() { [ "$(printf '%s\n' "$e" | cut -f1)" = "$FS" ] && [ "$(kv "$e" sheets_after)" = 4 ]; }
      check "openpyxl's form $FS $label: the line is the sample's, sheets_after 4, one sheet more than the fixture's three (change OAE)" "$(yn opx_line_ok)"
      python3 -I -B "$B/sheetform.py" "$OPX_IN" "$FO/$OPX_ID/out.$label.xlsx" >"$B/sheetform-$FS-$label.out" 2>&1
      echo "  sheetform.py: exit $?"
      sed 's/^/    /' "$B/sheetform-$FS-$label.out"
      # Change OAG (specs/0043 ruling O): the run's four items on one line:
      # the exit status, the output's sha256, the new <sheet> element's text
      # and LibreOffice's open result (the runner's lo_in and lo).
      opx_lo_in=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "lo_in") k = i; next } k && NR == 2 { print $k }' "$FSUM")
      opx_lo=$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "lo") k = i; next } k && NR == 2 { print $k }' "$FSUM")
      opx_sha=$(sha_of "$FO/$OPX_ID/out.$label.xlsx" 2>/dev/null)
      opx_new=$(sed -n 's/^new: //p' "$B/sheetform-$FS-$label.out")
      echo "  openpyxl's form $FS $label: exit $frc; output sha256 ${opx_sha:-none}; the new sheet element: ${opx_new:-none}; LibreOffice: lo_in ${opx_lo_in:-none}, lo ${opx_lo:-none} (change OAG)"
      opx_items() { [ -n "$opx_sha" ] && [ -n "$opx_new" ] && [ "$opx_new" != none ] && [ -n "$opx_lo_in" ] && [ -n "$opx_lo" ]; }
      check "openpyxl's form $FS $label: the exit status, the output's sha256, the new sheet element and LibreOffice's lo_in and lo are each printed above (ruling O; change OAG)" "$(yn opx_items)"
      sf_all() { [ "$(count_matches -E ': yes$' "$B/sheetform-$FS-$label.out")" = 7 ] && [ "$(count_matches -E ': no$' "$B/sheetform-$FS-$label.out")" = 0 ]; }
      check "openpyxl's form $FS $label: the output's workbook part is the input's with one <sheet> more, declaring the relationships namespace itself in the form ruling M gives (seven checks; change OAE)" "$(yn sf_all)"
    done
    check "openpyxl's form $FS: both targets printed the same line" "$(yn cmp -s "$B/opxline-$FS-host" "$B/opxline-$FS-i686")"
    check "openpyxl's form $FS: the output is the same on both targets, byte for byte" "$(yn cmp -s "$FO/$OPX_ID/out.host.xlsx" "$FO/$OPX_ID/out.i686.xlsx")"
    done
    # The controls of sheetform.py: the committed fixture, whose root binds the
    # prefix (scale-gen's form, not openpyxl's), and a planted output whose new
    # <sheet> lost its declaration.
    python3 -I -B "$B/sheetform.py" tests/fixtures/openpyxl-ops.xlsx tests/fixtures/openpyxl-ops.xlsx >"$B/c-sheetform-root.out" 2>&1
    echo "  sheetform.py over the committed tests/fixtures/openpyxl-ops.xlsx as both input and output:"
    sed 's/^/    /' "$B/c-sheetform-root.out"
    sf_root_ctl() { [ "$(count_matches -F "the input's root binds no prefix to the relationships namespace: no" "$B/c-sheetform-root.out")" = 1 ]; }
    check "control: sheetform.py finds the committed fixture's root binds the relationships prefix (not openpyxl's form)" "$(yn sf_root_ctl)"
    python3 -I -B "$B/sheetform.py" --plant "$B/opxrun-chartsheet/$OPX_ID/out.host.xlsx" "$B/c-sheetform-plant.xlsx" >"$B/c-sheetform-plant.err" 2>&1
    python3 -I -B "$B/sheetform.py" "$OPX_IN" "$B/c-sheetform-plant.xlsx" >"$B/c-sheetform-plant.out" 2>&1
    echo "  sheetform.py over a planted copy of the chartsheet sample's host output whose new <sheet> lost its declaration:"
    sed 's/^/    /' "$B/c-sheetform-plant.out"
    sf_plant_ctl() { [ "$(count_matches -F "the new sheet element is name, sheetId, xmlns:r the transitional namespace, r:id, as ruling M gives: no" "$B/c-sheetform-plant.out")" = 1 ]; }
    check "control: sheetform.py refuses a new <sheet> with no declaration of its own" "$(yn sf_plant_ctl)"
    n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
    check "openpyxl's form: the runs' TMPDIR is empty after the runs" "$(yn [ "$n_left" = 0 ])"
    check "openpyxl's form: the kept fixture is unchanged after the runs (read only; change OAE)" "$(yn kept_ok)"
    
    echo
    if [ "$RUN_SKIP_KEEP" = yes ]; then
    echo "## the keep and the open check: SKIPPED (RUN_SKIP_KEEP=yes, a dry run)"
    else
    echo "## the host keep regenerated (change NSF: M3 part 7 P5's form, one cargo test; carried)"
    mkdir "$KEEP" || exit 2
    echo "command: EMEND_KEEP_DIR=<keep> cargo test --workspace (host; CARGO_TARGET_DIR=<target>/main)"
    EMEND_KEEP_DIR=$KEEP cargo test --workspace >"$B/keep.out" 2>&1 </dev/null
    rc=$?
    echo "  exit: $rc"
    LC_ALL=C "$G" -E '^ *Running |^ *Doc-tests |^test result: ' "$B/keep.out" | sed 's/^ */    /'
    failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
    echo "  passed $passed; failed $failed"
    check "the tests with the keep set exit 0" "$(yn [ "$rc" = 0 ])"
    check "no test failed" "$(yn [ "$failed" = 0 ])"
    echo "  files in the keep: $(find "$KEEP" -type f | wc -l); entries that are not regular files: $(find "$KEEP" -mindepth 1 ! -type f | wc -l)"
    (cd "$KEEP" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort) >"$B/host.files"
    nfiles=$(count_lines "$B/host.files")
    n_in=$(count_matches -E '\.in\.xlsx$' "$B/host.files")
    n_out=$(count_matches -E '\.out\.xlsx$' "$B/host.files")
    n_other=$(count_matches -vE '^[A-Za-z0-9_.-]+\.[0-9]+\.(in|out)\.xlsx$' "$B/host.files")
    LC_ALL=C sed -nE 's/^(.*)\.in\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.names"
    LC_ALL=C sed -nE 's/^(.*)\.out\.xlsx$/\1/p' "$B/host.files" | LC_ALL=C sort >"$B/pair.out.names"
    echo "  .in.xlsx $n_in; .out.xlsx $n_out; names not of the form <test>.<n>.in|out.xlsx: $n_other"
    all_pairs() { [ "$n_in" = "$n_out" ] && [ "$((n_in * 2))" = "$nfiles" ] && [ "$n_other" = 0 ] && cmp -s "$B/pair.names" "$B/pair.out.names"; }
    check "the keep holds only whole pairs named <test>.<n>" "$(yn all_pairs)"
    NPAIRS=$n_in
    (cd "$KEEP" && find . -type f -printf '%P\t%s\n' | LC_ALL=C sort) >"$B/keep.listing"
    echo "  the host keep's listing: pairs $(count_matches -E "[.]in[.]xlsx${TAB}" "$B/keep.listing"); files $(count_lines "$B/keep.listing"); listing sha256 $(sha_of "$B/keep.listing")"
    check "the host keep's pairs times two equals its files (keep_pairs_ok)" "$(yn keep_pairs_ok "$B/keep.listing")"
    
    echo
    echo "## the host keep against P2's committed open-check record, named by its record commit, the base, the last to add one (change OAF)"
    PREV_TXT=$(git show --name-only --format= "$PREV_OPEN_REC" | LC_ALL=C "$G" -E '^records/[a-z0-9]+-open-.*[.]txt$')
    echo "command: git show --name-only --format= <P2's record commit>, the open-check .txt it added; git show <phase commit>:<it>"
    echo "  the record: $PREV_TXT (sha256 $(git show "$C:$PREV_TXT" | sha256sum | cut -d' ' -f1))"
    check "the named record commit added exactly one open-check .txt" "$(yn [ "$(printf '%s\n' "$PREV_TXT" | count_lines /dev/stdin)" = 1 ])"
    no_later_open() { [ -z "$(git log --format=%H "$PREV_OPEN_REC..$C" -- 'records/*-open-*.txt')" ]; }
    check "no commit after it adds an open-check record, so it is the last committed" "$(yn no_later_open)"
    git show "$C:$PREV_TXT" >"$B/prev.txt"
    while IFS= read -r t; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$t" "$(stat -c %s "$KEEP/$t.in.xlsx")" "$(sha_of "$KEEP/$t.in.xlsx")" \
        "$(stat -c %s "$KEEP/$t.out.xlsx")" "$(sha_of "$KEEP/$t.out.xlsx")"
    done <"$B/pair.names" >"$B/keep.rows"
    tail -n +2 "$B/prev.txt" | cut -f1-5 | LC_ALL=C sort >"$B/prev.rows"
    LC_ALL=C sort "$B/keep.rows" >"$B/keep.sorted"
    n_prev=$(count_lines "$B/prev.rows")
    n_kept_prev=$(LC_ALL=C comm -12 "$B/prev.rows" "$B/keep.sorted" | count_lines /dev/stdin)
    cut -f1 "$B/prev.rows" >"$B/prev.names"
    LC_ALL=C comm -13 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.names" <(cut -f1 "$B/keep.sorted") >"$B/gone.pairs"
    echo "  rows: the regenerated keep $(count_lines "$B/keep.rows"), the record $n_prev; its rows found in the keep with the same name, bytes and both sha256s: $n_kept_prev"
    echo "  pairs in the keep and not in the record: $(count_lines "$B/new.pairs"); in the record and not in the keep: $(count_lines "$B/gone.pairs")"
    sed 's/^/    new: /' "$B/new.pairs"
    LC_ALL=C comm -23 "$B/prev.rows" "$B/keep.sorted" | cut -f1 >"$B/changed.pairs"
    echo "  pairs of the record whose bytes differ in the keep: $(count_lines "$B/changed.pairs")"
    sed 's/^/    changed: /' "$B/changed.pairs"
    check "no pair of the record is gone" "$(yn [ "$(count_lines "$B/gone.pairs")" = 0 ])"
    check "every pair of the record is in the keep, unchanged or changed ($n_kept_prev + $(count_lines "$B/changed.pairs") = $n_prev)" "$(yn [ "$((n_kept_prev + $(count_lines "$B/changed.pairs")))" = "$n_prev" ])"
    # Change OAF: the new pairs this phase's tests write, the renamed accepting
    # test's one write and the new chartsheet test's two (ruling M), in byte
    # order (<phase>/dev/expected-new.txt, from the session's dev keep at
    # 7ac8b74).
    : >"$B/want-new.pairs"
    printf '%s\n' package.tests.a_workbook_root_binding_no_relationships_prefix_takes_an_add.1 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.chartsheet.an_openpyxl_form_workbook_takes_a_sheet_and_a_chartsheet.1 >>"$B/want-new.pairs"
    printf '%s\n' package.tests.chartsheet.an_openpyxl_form_workbook_takes_a_sheet_and_a_chartsheet.2 >>"$B/want-new.pairs"
    echo "  the new pairs expected: $(count_lines "$B/want-new.pairs") (change OAF)"
    new_exact() { cmp -s "$B/new.pairs" "$B/want-new.pairs"; }
    check "the new pairs are exactly the $(count_lines "$B/want-new.pairs") this phase's tests write, by name (change OAF)" "$(yn new_exact)"
    new_ctl() { head -n -1 "$B/want-new.pairs" >"$B/c-new.pairs"; cmp -s "$B/new.pairs" "$B/c-new.pairs"; }
    check "control: the same comparison refuses the list one pair short" "$(ynnot new_ctl)"
    # Change OAF: no pair of the record changes its bytes (the session's dev
    # keep at 7ac8b74: 0 changed).
    check "no pair of the record changed its bytes (change OAF)" "$(yn [ "$(count_lines "$B/changed.pairs")" = 0 ])"
    changed_ctl() { printf '%s\n' other.1 >"$B/c-changed.pairs"; [ "$(count_lines "$B/c-changed.pairs")" = 0 ]; }
    check "control: the same count refuses one planted changed pair (change OAF)" "$(ynnot changed_ctl)"
    echo "command: the #[test] functions added or whose body is edited since the named record commit, and those of a .rs file whose text outside its tests differs, from the two commits' sources of every .rs file git diff --name-only <named record commit> <phase commit> names: <work>/edited.py, below (change NSG)"
    cat >"$B/edited.py" <<'PY'
    """The #[test] functions whose body differs between two commits, or that
    the second adds: each file's text at both commits (git show), every
    function after a #[test] attribute (other attributes allowed between), its
    body from the fn line to the first line that is a lone closing brace in
    column one. Prints one test name per line; with a third argument
    --fixtures, instead every test whose body names an item (const,
    static, fn, struct, enum, type or mod at column one) whose lines
    outside the test bodies differ between the two commits (change
    NSG)."""
    import collections
    import re
    import subprocess
    import sys
    
    base, head = sys.argv[1:3]
    TEST = re.compile(r"#\[test\]\s*(?:#\[[^\]]*\]\s*)*fn\s+([A-Za-z0-9_]+)")
    
    
    def show(rev, path):
        run = subprocess.run(["git", "show", "%s:%s" % (rev, path)], capture_output=True)
        return run.stdout.decode() if run.returncode == 0 else ""
    
    
    def tests(text):
        out = {}
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            out[m.group(1)] = text[m.start():end if end >= 0 else len(text)]
        return out
    
    
    names = subprocess.run(["git", "diff", "--name-only", base, head, "--", "*.rs"],
                           capture_output=True, check=True).stdout.decode().split()
    ITEM = re.compile(r"^(?:pub(?:\([^)]*\))?\s+)?(?:const|static|fn|struct|enum|type|mod)\s+([A-Za-z_][A-Za-z0-9_]*)")
    
    
    def outside(text):
        out, at = [], 0
        for m in TEST.finditer(text):
            end = text.find("\n}\n", m.start())
            end = len(text) if end < 0 else end + 3
            if m.start() >= at:
                out.append(text[at:m.start()])
                at = end
        out.append(text[at:])
        return "".join(out)
    
    
    def changed_items(before_text, after_text):
        found = set()
        for text, other in ((after_text, before_text), (before_text, after_text)):
            others = collections.Counter(outside(other).split("\n"))
            current = None
            for line in outside(text).split("\n"):
                m = ITEM.match(line)
                if m:
                    current = m.group(1)
                if others[line] > 0:
                    others[line] -= 1
                elif current is not None:
                    found.add(current)
        return found
    
    
    edited = set()
    fixture = set()
    for path in names:
        before_text, after_text = show(base, path), show(head, path)
        before, after = tests(before_text), tests(after_text)
        for name, body in after.items():
            if before.get(name) != body:
                edited.add(name)
        items = changed_items(before_text, after_text)
        for name, body in after.items():
            if any(re.search(r"\b%s\b" % re.escape(i), body) for i in items):
                fixture.add(name)
    for name in sorted(fixture if sys.argv[3:] == ["--fixtures"] else edited):
        print(name)
    PY
    sed 's/^/    /' "$B/edited.py"
    python3 -I -B "$B/edited.py" "$PREV_OPEN_REC" "$C" | LC_ALL=C sort >"$B/edited.tests"
    python3 -I -B "$B/edited.py" "$PREV_OPEN_REC" "$C" --fixtures | LC_ALL=C sort >"$B/fixture.tests"
    LC_ALL=C sort -u "$B/edited.tests" "$B/fixture.tests" >"$B/touched.tests"
    sed 's/^/    added or edited test: /' "$B/edited.tests"
    sed 's/^/    test of a file whose text outside its tests differs: /' "$B/fixture.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/new.pairs" | LC_ALL=C sort -u >"$B/new.tests"
    sed -E 's/\.[0-9]+$//; s/^.*\.//' "$B/changed.pairs" | LC_ALL=C sort -u >"$B/changed.tests"
    echo "  tests with a new pair: $(count_lines "$B/new.tests"); tests with a changed pair: $(count_lines "$B/changed.tests"); tests added or edited: $(count_lines "$B/edited.tests"); tests of a file whose text outside its tests differs: $(count_lines "$B/fixture.tests")"
    check "some test is added or edited, so the list was read (change NWU)" "$(yn [ "$(count_lines "$B/edited.tests")" -ge 1 ])"
    new_from_edited() { [ "$(LC_ALL=C comm -23 "$B/new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every new pair is kept by a test added or edited since the record" "$(yn new_from_edited)"
    changed_from_touched() { [ "$(LC_ALL=C comm -23 "$B/changed.tests" "$B/touched.tests" | count_lines /dev/stdin)" = 0 ]; }
    check "every changed pair of the record is kept by a test edited since it, or of a file whose fixtures or helpers changed (change NSG)" "$(yn changed_from_touched)"
    printf 'zzz_not_an_edited_test\n' | LC_ALL=C sort -m - "$B/new.tests" >"$B/c-new.tests"
    new_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-new.tests" "$B/edited.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a pair of a test not added or edited" "$(yn new_ctl)"
    printf 'zzz_not_a_touched_test\n' | LC_ALL=C sort -m - "$B/changed.tests" >"$B/c-changed.tests"
    touched_ctl() { [ "$(LC_ALL=C comm -23 "$B/c-changed.tests" "$B/touched.tests" | count_lines /dev/stdin)" = 1 ]; }
    check "control: the same comparison finds a changed pair of a test neither edited nor of a changed file" "$(yn touched_ctl)"
    
    echo
    echo "## scripts/edit-open-check.sh on the host keep (specs/0018 \"Harness runs\": every phase's run log runs it over its keep)"
    mkdir "$B/tmp"
    # The open check's own TMPDIR, its device beside the runs' and the corpus
    # directory's.
    dev_open=$(stat -c %d "$B/tmp")
    echo "command: stat -c %d <work>/tmp <work>/tmp-run <corpus>/corpus /proc"
    echo "  device of the open check's TMPDIR (<work>/tmp): $dev_open; of the runs' TMPDIR (<work>/tmp-run): $(stat -c %d "$RUNTMP"); of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    check "the open check's TMPDIR and the corpus directory are on one device" "$(yn [ "$dev_open" = "$dev_corpus" ])"
    check "control: the same comparison tells /proc's device from the open check's TMPDIR's" "$(yn [ "$dev_proc" != "$dev_open" ])"
    echo "command: TMPDIR=<work>/tmp scripts/edit-open-check.sh --keep <keep> --libreoffice $IMAGE --out <work>/records --stem $STEM_OPEN (change OAB)"
    TMPDIR=$B/tmp scripts/edit-open-check.sh --keep "$KEEP" --libreoffice "$IMAGE" --out "$RECORDS" --stem "$STEM_OPEN" \
      >"$B/oc.stdout" 2>"$B/oc.stderr" </dev/null
    oc_rc=$?
    echo "  exit: $oc_rc"
    echo "  stdout:"; sed 's/^/    /' "$B/oc.stdout"
    echo "  stderr bytes: $(wc -c <"$B/oc.stderr")"
    check "the script exits 0 (no finding, no check errored)" "$(yn [ "$oc_rc" = 0 ])"
    check "its stderr is empty" "$(yn [ ! -s "$B/oc.stderr" ])"
    echo "  the reasons the script kept (its reasons directory under <work>/tmp), one line per refused side:"
    find "$B/tmp" -name '*-reason.txt' | LC_ALL=C sort | while IFS= read -r f; do echo "    ${f#"$B/tmp/"}: $(cat "$f")"; done
    TXT=$RECORDS/$STEM_OPEN.txt
    MD=$RECORDS/$STEM_OPEN.md
    TXT_HEADER=$(git show "$C:scripts/edit-open-check.sh" | sed -n "s/^readonly TXT_HEADER=\\$'\\(.*\\)'\$/\\1/p" | sed 's/\\t/\t/g')
    check "the .txt's header is the script's TXT_HEADER, read from the phase commit (nine columns)" "$(yn [ "$(head -n 1 "$TXT")" = "$TXT_HEADER" ])"
    tail -n +2 "$TXT" | cut -f1-5 >"$B/txt.rows"
    nrow_same=$(paste -d'\n' "$B/keep.rows" "$B/txt.rows" | awk 'NR % 2 == 1 { a = $0; next } a == $0 { n++ } END { print n + 0 }')
    echo "  rows: the keep $(count_lines "$B/keep.rows"), the .txt $(count_lines "$B/txt.rows"); rows whose name, bytes and hashes are the keep's, compared row by row: $nrow_same"
    rows_same() { [ "$(count_lines "$B/keep.rows")" = "$(count_lines "$B/txt.rows")" ] && [ "$nrow_same" = "$(count_lines "$B/keep.rows")" ] && [ "$nrow_same" = "$NPAIRS" ]; }
    check "every .txt row is one kept pair's name, byte counts and sha256s, in name order, one row per pair" "$(yn rows_same)"
    bad_rows=$(tail -n +2 "$TXT" | awk -F'\t' 'NF != 9 || $6 !~ /^(ok|fail|error)$/ || $7 !~ /^(ok|fail|error)$/ || $8 !~ /^(none|refused|count|error)$/ || $9 !~ /^(none|refused|count|error)$/' | wc -l)
    check "every row has nine columns, lo_in and lo each ok, fail or error, and each class none, refused, count or error ($bad_rows rows otherwise)" "$(yn [ "$bad_rows" = 0 ])"
    bad_fit=$(tail -n +2 "$TXT" | awk -F'\t' '{ print $6 ":" $8; print $7 ":" $9 }' | LC_ALL=C "$G" -cvxE 'ok:none|fail:refused|fail:count|error:error')
    check "every side's class fits its verdict ($bad_fit sides otherwise)" "$(yn [ "$bad_fit" = 0 ])"
    stdout_rows() { [ "$(awk -F'\t' 'NF == 3' "$B/oc.stdout")" = "$(tail -n +2 "$TXT" | cut -f1,6,7)" ]; }
    check "the script's per-pair stdout lines are the .txt's test, lo_in and lo columns" "$(yn stdout_rows)"
    echo "command: python3 -I -B <work>/wb.py over each kept input: its xl/workbook.xml entry, its sheet elements by local name (expat, no pattern) and of them those with a prefix"
    cat >"$B/wb.py" <<'PY'
    import sys, zipfile
    from xml.parsers import expat
    for path in sys.argv[1:]:
        name = path.rsplit("/", 1)[1][: -len(".in.xlsx")]
        try:
            z = zipfile.ZipFile(path)
        except zipfile.BadZipFile:
            print("%s\tunreadable\t-\t-" % name)
            continue
        if "xl/workbook.xml" not in z.namelist():
            print("%s\tno\t-\t-" % name)
            continue
        found = {"all": 0, "prefixed": 0}
    
        def start(tag, attrs):
            prefix, _, local = tag.rpartition(":")
            if local == "sheet":
                found["all"] += 1
                found["prefixed"] += 1 if prefix else 0
        p = expat.ParserCreate()
        p.StartElementHandler = start
        try:
            p.Parse(z.read("xl/workbook.xml"), True)
        except expat.ExpatError:
            print("%s\tyes\tunparsed\t-" % name)
            continue
        print("%s\tyes\t%d\t%d" % (name, found["all"], found["prefixed"]))
    PY
    sed 's/^/    /' "$B/wb.py"
    python3 -I -B "$B/wb.py" $(sed "s#^#$KEEP/#; s#\$#.in.xlsx#" "$B/pair.names") | LC_ALL=C sort >"$B/wb.all"
    echo "  kept inputs by workbook entry and sheet elements (entry, all, prefixed: pairs):"
    cut -f2- "$B/wb.all" | sort | uniq -c | sed 's/^/    /'
    echo "  the .md checked against the .txt and the kept inputs, with the heading specs/0015 P2 verification ruling 1 gives: <work>/mdcheck.py, below"
    cat >"$B/mdcheck.py" <<'PY'
    import sys
    txt, md, wb = sys.argv[1:4]
    rows = [l.split("\t") for l in open(txt).read().split("\n")[1:] if l]
    sheets = {l.split("\t")[0]: l.split("\t")[2] for l in open(wb).read().split("\n") if l}
    text = open(md).read().split("\n")
    REFUSED = ("Inputs refused by LibreOffice (allowed: a fixture LibreOffice cannot load: zip-level,"
               " or a package with no relationships part or an empty content-types root)")
    
    
    def section(title):
        out, on = [], False
        for line in text:
            if line == "## " + title:
                on = True
                continue
            if on and line.startswith("## "):
                break
            if on and line:
                out.append(line)
        return out
    
    
    def listed(names):
        return ["- `%s`" % n for n in names] if names else ["None."]
    
    
    def count(col, v):
        return sum(1 for r in rows if r[col] == v)
    
    
    totals = [len(rows)] + [count(5, v) for v in ("ok", "fail", "error")] + [count(6, v) for v in ("ok", "fail", "error")]
    classes = ["| %s | " % side + " | ".join(str(count(col, c)) for c in ("none", "refused", "count", "error")) + " |"
               for side, col in (("reason_in", 7), ("reason_out", 8))]
    tot = section("Totals")
    checks = [
        ("Totals", tot[2:3] == ["| " + " | ".join(str(t) for t in totals) + " |"] and tot[5:] == classes),
        ("the refused-inputs heading reads as ruled, once", text.count("## " + REFUSED) == 1),
        ("Inputs refused by LibreOffice", section(REFUSED) == listed([r[0] for r in rows if r[7] == "refused"])),
        ("the sheet count did not apply", section("Inputs the sheet count did not apply to (allowed: a workbook fixture with no sheet element)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) == "0"])),
        ("counts differ", section("Inputs whose sheet and table counts differ (a finding)") == listed([r[0] for r in rows if r[7] == "count" and sheets.get(r[0]) != "0"])),
        ("Outputs refused on an accepted input", section("Outputs refused on an input LibreOffice accepted (a finding)") == listed([r[0] for r in rows if r[6] == "fail" and r[5] == "ok"])),
        ("Checks that did not run", section("Checks that did not run (error)") == listed([r[0] for r in rows if "error" in (r[5], r[6])])),
        ("Pairs", section("Pairs")[2:] == ["| `%s` | %s | %s | %s | %s | %s | %s | %s | %s |" % tuple(r) for r in rows]),
        ("the Pairs line", ("- Pairs: %d" % len(rows)) in text),
    ]
    for name, ok in checks:
        print("%s: %s" % (name, "yes" if ok else "no"))
    print("totals: pairs %d; lo_in ok %d fail %d error %d; lo ok %d fail %d error %d" % tuple(totals))
    PY
    sed 's/^/    /' "$B/mdcheck.py"
    python3 -I -B "$B/mdcheck.py" "$TXT" "$MD" "$B/wb.all" >"$B/mdcheck.out"
    sed 's/^/    /' "$B/mdcheck.out"
    md_all() { [ "$(count_matches -E ': yes$' "$B/mdcheck.out")" = 9 ] && [ "$(count_matches -E ': no$' "$B/mdcheck.out")" = 0 ]; }
    check "the .md's nine parts are derived from the .txt and the kept inputs' sheet elements, the heading as ruled" "$(yn md_all)"
    head -n 2 "$TXT" >"$B/c-short.txt"
    python3 -I -B "$B/mdcheck.py" "$B/c-short.txt" "$MD" "$B/wb.all" >"$B/c-mdcheck.out"
    md_ctl() { [ "$(count_matches -E ': no$' "$B/c-mdcheck.out")" -ge 1 ]; }
    check "control: the same check on a .txt cut to one row finds the .md does not match it" "$(yn md_ctl)"
    OLD8=records/m1p8-open-2026-09-24-da080f1
    python3 -I -B "$B/mdcheck.py" "$OLD8.txt" "$OLD8.md" "$B/wb.all" >"$B/c-prevmd.out"
    old_heading() { [ "$(count_matches -F 'the refused-inputs heading reads as ruled, once: no' "$B/c-prevmd.out")" = 1 ]; }
    check "control: the same check on part 8 P2's committed .md finds the old heading, not the ruled one" "$(yn old_heading)"
    totals_line() { [ "$(sed -n 's/^wrote .*\.txt: \(pairs [^;]*; lo_in [^;]*; lo [^;]*\); inputs refused .*/\1/p' "$B/oc.stdout")" = "$(sed -n 's/^totals: //p' "$B/mdcheck.out")" ]; }
    check "the script's totals line is the totals derived from the .txt" "$(yn totals_line)"
    echo
    echo "### the verdicts against the named record"
    join -t "$TAB" <(tail -n +2 "$B/prev.txt" | cut -f1,6,7,8,9 | LC_ALL=C sort) <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) >"$B/both"
    check "every pair of the named record has a row in this record" "$(yn [ "$(count_lines "$B/both")" = "$n_prev" ])"
    awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9 { print $1 "\t" $2 "/" $3 "/" $4 "/" $5 " -> " $6 "/" $7 "/" $8 "/" $9 }' "$B/both" >"$B/moved"
    echo "  the named record's pairs whose lo_in, lo or either class changed: $(count_lines "$B/moved")"
    sed 's/^/    /' "$B/moved"
    check "no verdict and no class of the named record's pairs moved" "$(yn [ "$(count_lines "$B/moved")" = 0 ])"
    printf 'x\tok\tok\tnone\tnone\tok\tfail\tnone\trefused\n' >"$B/c-both"
    moved_ctl() { [ "$(awk -F'\t' '$2 != $6 || $3 != $7 || $4 != $8 || $5 != $9' "$B/c-both" | wc -l)" = 1 ]; }
    check "control: the same form finds a planted row whose lo moved" "$(yn moved_ctl)"
    echo "  the changed pairs' verdicts (test, lo_in, lo, reason_in, reason_out; none expected, change OAF):"
    join -t "$TAB" "$B/changed.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) | sed 's/^/    /'
    echo "  the new pairs' verdicts (test, lo_in, lo, reason_in, reason_out):"
    join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7,8,9 | LC_ALL=C sort) | sed 's/^/    /'
    no_new_finding() { [ "$(join -t "$TAB" "$B/new.pairs" <(tail -n +2 "$TXT" | cut -f1,6,7 | LC_ALL=C sort) | awk -F'\t' '$2 == "ok" && $3 != "ok"' | wc -l)" = 0 ]; }
    check "no new pair's output is refused on an accepted input" "$(yn no_new_finding)"
    echo
    echo "### acceptance, and the inputs LibreOffice did not accept"
    tail -n +2 "$TXT" | awk -F'\t' -v OFS='\t' '{ print ($1 ~ /^emend-copy\./ ? "tool" : "crate"), $1, $6, $7, $8, $9 }' >"$B/verdicts"
    for side in crate tool; do
      n=$(awk -F'\t' -v s="$side" '$1 == s' "$B/verdicts" | wc -l)
      nfind=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "ok" && $4 == "fail"' "$B/verdicts" | wc -l)
      nerr=$(awk -F'\t' -v s="$side" '$1 == s && ($3 == "error" || $4 == "error")' "$B/verdicts" | wc -l)
      nin=$(awk -F'\t' -v s="$side" '$1 == s && $3 == "fail"' "$B/verdicts" | wc -l)
      echo "  $side: pairs $n; inputs refused $nin; outputs refused on an accepted input $nfind; checks that did not run $nerr"
      check "$side: no output refused on an accepted input" "$(yn [ "$nfind" = 0 ])"
      check "$side: no check errored" "$(yn [ "$nerr" = 0 ])"
    done
    awk -F'\t' '$5 == "count" { print $2 }' "$B/verdicts" >"$B/count.pairs"
    awk -F'\t' '$2 == "yes" && $3 == "0" { print $1 }' "$B/wb.all" >"$B/zero.pairs"
    echo "  count-class inputs $(count_lines "$B/count.pairs"); kept inputs with a workbook entry and no sheet element $(count_lines "$B/zero.pairs")"
    check "the count-class inputs are exactly the kept inputs with a workbook entry and no sheet element, so no count differs" "$(yn cmp -s "$B/count.pairs" "$B/zero.pairs")"
    echo "  the pairs whose input LibreOffice did not accept, with the class of the input's reason:"
    awk -F'\t' '$3 != "ok" { print $2 "\t" $5 }' "$B/verdicts" | sed 's/^/    /'
    echo
    echo "### the open-check record installed into records/"
    echo "command: install -m 644 <work>/records/$STEM_OPEN.md <work>/records/$STEM_OPEN.txt <repo>/$RECORDS_DEST/"
    install -m 644 "$RECORDS/$STEM_OPEN.md" "$RECORDS/$STEM_OPEN.txt" "$RECORDS_DEST"/ && INSTALLED+=("$RECORDS_DEST/$STEM_OPEN.md" "$RECORDS_DEST/$STEM_OPEN.txt")
    echo "  exit: $?"
    for f in "$STEM_OPEN.md" "$STEM_OPEN.txt"; do
      echo "    written <work>/records/$f: sha256 $(sha_of "$RECORDS/$f"), $(wc -c <"$RECORDS/$f") bytes"
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes, mode $(stat -c %a "$RECORDS_DEST/$f")"
      check "the installed $f is the written one, byte for byte, mode 644" "$(yn inst_same "$f")"
    done
    fi
    
    echo
    echo "## the record files this run installed hold no path"
    echo "  record files installed by this run: ${#INSTALLED[@]}"
    no_path() {
      local f
      [ "${#INSTALLED[@]}" -ge 1 ] || return 1
      for f in "${INSTALLED[@]}"; do
        [ "$(count_matches -F "$HOME" "$f")" = 0 ] || return 1
        [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$f")" = 0 ] || return 1
      done
    }
    check "no record file this run installed names <home>, a home, mount, temporary or corpus path" "$(yn no_path)"
    n_inst_want=8
    if [ "$RUN_SKIP_KEEP" = yes ]; then n_inst_want=6; fi
    check "this run installed the record files it writes ($n_inst_want: the three samples' pairs, and the open pair unless the keep was skipped; changes NUF, NWY, NZQ and OAF)" "$(yn [ "${#INSTALLED[@]}" = "$n_inst_want" ])"
    inst_ctl() { local n_inst_want=6; [ "${#INSTALLED[@]}" = "$n_inst_want" ]; }
    if [ "$RUN_SKIP_KEEP" = no ]; then check "control: the same count refuses the six a run that skipped the keep installs (change OAF)" "$(ynnot inst_ctl)"; fi
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x' >"$B/c-path"
    path_ctl() { [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$B/c-path")" = 1 ]; }
    check "control: the same form finds a planted path" "$(yn path_ctl)"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  the spec: $SPEC, sha256 $(sha_of "$SPEC")"
    echo "status lines: $st_all; of them this phase's logs, its record pairs, the API and size records or the working spec PLANNING_SPEC admits: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's, the API and size records or the working spec PLANNING_SPEC admits (changes NZQ, NZW and OAA)" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources (the phase commit's, by git show; change NSB)
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

