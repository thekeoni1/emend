    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/test.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR RUSTDOCFLAGS RUSTFLAGS CARGO_TARGET_DIR
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    PHASE_DIR=$HOME/.cache/emend-build/m6p6-p3
    BUILD_ROOT=${TEST_BUILD:-$PHASE_DIR/test}
    SUPERSEDED_DIR=$PHASE_DIR/superseded
    TARGET_DIR=$PHASE_DIR/target
    SPEC=specs/0043-measurement-and-close.md
    SPEC_WANT=cc1b5d902817c7fd9b792aa56c8a5cdfb9b4132cc71e228ed2759415c550addc
    # Change YI (M6 part 4 P3's change XM): where T1 writes the listing and
    # where R2 installs the record; a dry run names stand-ins outside the
    # repository.
    API_DIR=${TEST_API_DIR:-$PHASE_DIR/api}
    RECORDS_DEST=${TEST_RECORDS_DEST:-records}
    mkdir -p "$BUILD_ROOT" || exit 2
    # Change QC: made on the disk under <build> and kept after the run.
    B=$(mktemp -d -p "$BUILD_ROOT") || exit 2
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT_SHA=${C:0:7}
    # This phase's logs, untracked, and the API record this log writes, the
    # phase commit's short sha (changes RA, UA, UI, UR, UY, VG, VJ, VN, WB, WE,
    # WH, WP, WS, WZ, XD, XF, XM, XW, YA, YC and YI). Change WW (ruling S): OWN
    # is the phase's own paths, the pattern the status labels count; OURS adds
    # planning's working spec when admitted, the pattern the accounted checks
    # read.
    OURS="^(\\?\\? records/logs/m6p6-p3/|\\?\\? records/api-review-m6p6-[0-9]{4}-[0-9]{2}-[0-9]{2}-${SHORT_SHA}[.]md\$)"
    OWN=$OURS
    PLAN_LINE="^ M specs/0043-measurement-and-close[.]md\$"
    
    # Change VM (kept, with WB's names): planning's working copy of the
    # spec (its rulings during the phase, uncommitted until the record commit)
    # is admitted, modified, when PLANNING_SPEC is given and the working file
    # hashes to it; otherwise the pattern is WB's.
    PLAN_SPEC_NOW=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    plan_admitted() { [ -n "${PLANNING_SPEC:-}" ] && [ "$PLAN_SPEC_NOW" = "$PLANNING_SPEC" ]; }
    if plan_admitted; then OURS="^(\\?\\? records/logs/m6p6-p3/|\\?\\? records/api-review-m6p6-[0-9]{4}-[0-9]{2}-[0-9]{2}-${SHORT_SHA}[.]md\$| M specs/0043-measurement-and-close[.]md\$)"; fi
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_own=$(run_matches -E "$OWN" git status --porcelain)
    entry_plan=$(run_matches -E "$PLAN_LINE" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs and its API record" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$B#<scratch>/w#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$SUPERSEDED_DIR#<superseded>#g" \
        -e "s#$TARGET_DIR#<target>#g" -e "s#$API_DIR#<api>#g" -e "s#$PHASE_DIR#<phase>#g" \
        -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "input: RERUN_NOTE: ${RERUN_NOTE:-unset}"
    echo "input: RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: HOME: set, read for the paths under it, printed as <home>"
    echo "input: TEST_BUILD: ${TEST_BUILD:-unset} (the build root, <build>)"
    echo "input: TEST_API_DIR: ${TEST_API_DIR:-unset} (the listing's directory, <api>; the default <phase>/api: $([ "$API_DIR" = "$PHASE_DIR/api" ] && echo yes || echo no); changes WS, XM and YI)"
    echo "input: TEST_RECORDS_DEST: ${TEST_RECORDS_DEST:-unset} (the records' destination: $RECORDS_DEST; the default records, in <repo>: $([ "$RECORDS_DEST" = records ] && echo yes || echo no); changes WS, XM and YI)"
    echo "input: PLANNING_SPEC: ${PLANNING_SPEC:-unset} (planning's working copy's hash; the working file admitted modified at it: $(yn plan_admitted); change VM)"
    echo "input: RUSTDOCFLAGS, RUSTFLAGS and CARGO_TARGET_DIR: unset by this script at entry; each cargo command below names its target directory"
    echo "about: M6 part 6 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the shape greps, the three and PYB, and the defined-helper check, over this script, before its log (specs/0001; ruling Z; change UF)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    # Change UF: the fourth shape, PYB, M5 part 6's form: a line that is not a comment
    # and calls python3 (followed by whitespace, then a dash or a .py path)
    # without -I -B. The interpreter's name is held in a variable here, so no
    # line of this form spells a call.
    PY=python3
    PYB_CALL="^[^#]*$PY[[:space:]]+(-|[^[:space:]]*[.]py)"
    PYB_OK="$PY -I -B( |\$)"
    # pyb_calls <file> and pyb_without <file>: the calls, and the calls without
    # -I -B. They print, so their values are compared.
    pyb_calls() { count_matches -E "$PYB_CALL" "$1"; }
    pyb_without() { LC_ALL=C "$G" -E "$PYB_CALL" "$1" | LC_ALL=C "$G" -vE "$PYB_OK" | count_lines /dev/stdin; }
    printf '%s\n' "$PY -c x" "$PY -I -B -c x" "# $PY -c x" "command -v $PY" >"$B/shape-pyb-fixture"
    n_pyb_self=$(pyb_without "$SELF")
    n_pyb_fix=$(pyb_without "$B/shape-pyb-fixture")
    n_calls_self=$(pyb_calls "$SELF")
    n_calls_fix=$(pyb_calls "$B/shape-pyb-fixture")
    echo "  shape PYB: in this script $n_pyb_self (of its $n_calls_self Python calls); in the fixture $n_pyb_fix (of its $n_calls_fix)"
    check "PYB: this script holds none (change UF)" "$(yn [ "$n_pyb_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's one call without -I -B, of its two calls, the comment and the command -v line not calls" "$(yn [ "$n_pyb_fix:$n_calls_fix" = 1:2 ])"
    check "control: the call form finds this script's 10 Python call lines, the defined-helper check's two runs, the listing program's two, the formatter's one, and their five command lines (changes UF, VJ, WE, WS, XD, XQ, YA and YM)" "$(yn [ "$n_calls_self" = 10 ])"
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change UF (ruling Z): the defined-helper check over this script's own
    # source, by the phase's gen/defined.py copied into <scratch>/w and checked
    # by its sha256, then over a planted script, the control.
    DEF_WANT=ee9f81359e07025bf08825c9562a853c3403115dc9a4f39c554f90533df9ca6d
    cp "$PHASE_DIR/gen/defined.py" "$B/defined.py" </dev/null
    def_cp_rc=$?
    DEF_HAVE=$(sha256sum <"$B/defined.py" | cut -d' ' -f1)
    echo "command: cp <phase>/gen/defined.py <scratch>/w/defined.py: exit $def_cp_rc; sha256sum: $DEF_HAVE"
    def_copied() { [ "$def_cp_rc" = 0 ] && [ "$DEF_HAVE" = "$DEF_WANT" ]; }
    check "the copy is the defined-helper program this script was generated against, sha256 $DEF_WANT (changes UF and UO)" "$(yn def_copied)"
    echo "command: sed 's/^/    /' <scratch>/w/defined.py"
    sed 's/^/    /' "$B/defined.py"
    DEF_RUN='import importlib.util, sys; s = importlib.util.spec_from_file_location("defined", sys.argv[1]); d = importlib.util.module_from_spec(s); s.loader.exec_module(d); d.check(open(sys.argv[2]).read(), sys.argv[3])'
    echo "command: python3 -I -B -c <the loader: the program loaded from its path, its check run over the file> <scratch>/w/defined.py <this script> $(basename "$SELF")"
    python3 -I -B -c "$DEF_RUN" "$B/defined.py" "$SELF" "$(basename "$SELF")" >"$B/defined-self.out" 2>&1 </dev/null
    def_rc=$?
    sed 's/^/    /' "$B/defined-self.out"
    echo "  exit $def_rc"
    def_self_ok() { [ "$def_rc" = 0 ] && [ "$(count_lines "$B/defined-self.out")" = 5 ] && [ "$(count_matches -E ': yes$' "$B/defined-self.out")" = 5 ]; }
    check "every helper a yn, ynnot, is or isnot call of this script names is defined in it, the four themselves where it calls them are defined in it, and the program's three planted controls find their planted names (5 lines yes; rulings Z, AD and AK a; changes UF and UO)" "$(yn def_self_ok)"
    # The planted calls are built from pieces, so this text holds no call of an
    # undefined name.
    printf '%s\n' 'f() { :; }' "x=\$""(yn f)" "y=\$""(ynnot g)" >"$B/c-defined.sh"
    echo "command: python3 -I -B -c <the loader> <scratch>/w/defined.py <scratch>/w/c-defined.sh c-defined.sh (a planted script defining f and calling f and g)"
    python3 -I -B -c "$DEF_RUN" "$B/defined.py" "$B/c-defined.sh" c-defined.sh >"$B/c-defined.out" 2>&1 </dev/null
    cdef_rc=$?
    sed 's/^/    /' "$B/c-defined.out"
    echo "  exit $cdef_rc"
    def_ctl_ok() { [ "$cdef_rc" != 0 ] && [ "$(count_matches -F 'no, undefined: g' "$B/c-defined.out")" = 1 ]; }
    check "control: the same program names g undefined in the planted script and exits non-zero (ruling Z; change UF)" "$(yn def_ctl_ok)"
    # Change UV (ruling D): this script's own placeholder check, the scan's rule.
    # placeholders_used <file>: every lower-case token printed before a slash,
    # and every scrub target, one per line, sorted and unique.
    TOK='<[a-z][a-z0-9_-]*>'
    placeholders_used() {
      {
        LC_ALL=C "$G" -a -o -E "s#[^#]*#$TOK" "$1" | LC_ALL=C "$G" -a -o -E "$TOK\$"
        LC_ALL=C "$G" -a -o -E "$TOK/" "$1" | sed 's#/$##'
      } | LC_ALL=C sort -u
    }
    # placeholders_declared <file>: the tokens a root line says stand for
    # something.
    placeholders_declared() {
      LC_ALL=C "$G" -a -E '(^|echo ")root: ' "$1" | LC_ALL=C "$G" -a -o -E "$TOK(/[a-z0-9]+)? stands for" |
        LC_ALL=C "$G" -a -o -E "^$TOK" | LC_ALL=C sort -u
    }
    # undeclared <file>: the count of tokens used and not declared. It prints, so
    # its value is compared.
    undeclared() { LC_ALL=C comm -23 <(placeholders_used "$1") <(placeholders_declared "$1") | count_lines /dev/stdin; }
    echo "command: the scan's placeholder rule over this script: the tokens before a slash and the scrub targets, against the tokens its root lines declare"
    ph_used=$(placeholders_used "$SELF" | tr '\n' ' ')
    ph_decl=$(placeholders_declared "$SELF" | tr '\n' ' ')
    n_undecl=$(undeclared "$SELF")
    echo "  placeholders printed: $ph_used; declared by root lines: $ph_decl; undeclared: $n_undecl"
    check "every placeholder this script prints is declared by a root line (ruling D; change UV)" "$(yn [ "$n_undecl" = 0 ])"
    # The planted tokens are built from pieces, so this source spells none.
    L='<'
    printf 'root: %srepo> stands for x\nread %srepo>/a and %sbld>/b\n' "$L" "$L" "$L" >"$B/c-ph-bad"
    printf 'root: %srepo> stands for x; %sbld> stands for y\nread %srepo>/a and %sbld>/b\n' "$L" "$L" "$L" "$L" >"$B/c-ph-ok"
    printf '  sed -e "s#$X#%sgbld>#g"\nroot: %srepo> stands for x\n' "$L" "$L" >"$B/c-ph-scrub"
    check "control: the same rule finds one undeclared token before a slash in a planted file (ruling D; change UV)" "$(yn [ "$(undeclared "$B/c-ph-bad")" = 1 ])"
    check "control: the same rule finds none when a root line declares it" "$(yn [ "$(undeclared "$B/c-ph-ok")" = 0 ])"
    check "control: the same rule finds an undeclared scrub target" "$(yn [ "$(undeclared "$B/c-ph-scrub")" = 1 ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject "M6 part 6 P2 record: the logs, the records, the check, the scan")
    DOC=$(by_subject "M6 part 6 P3: commit planning docs (the P2 verification and rulings)")
    CODEC=$(by_subject "M6 part 6 P3: a sheet add on a workbook root binding no relationships prefix")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's full subject>, for each role"
    echo "  the previous record commit (the base, M6 part 6 P2's record): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the code commit, the phase commit (a sheet add on a workbook root binding no relationships prefix): ${CODEC:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~2"
    for k in 0 1 2; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CODEC" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the code commit, the doc commit and the base, each the next one's parent, the code commit the phase commit (change ZE)" "$(yn roles_in_order)"
    roles_ctl() { local CODEC=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the phase commit (change ZE)" "$(ynnot roles_ctl)"
    roles_ctl2() { local DOC=$REC; roles_in_order; }
    check "control: roles_in_order refuses the base named as the doc commit" "$(ynnot roles_ctl2)"
    # Change ZE: the files each commit changes.
    files_of() { git diff --name-only "$1" "$2" | paste -sd' ' -; }
    echo "command: git diff --name-only <each role's parent> <role>"
    echo "  the doc commit: $(files_of "$REC" "$DOC")"
    echo "  the code commit: $(files_of "$DOC" "$CODEC")"
    roles_files() {
      [ "$(files_of "$REC" "$DOC")" = "ROADMAP.md $SPEC" ] &&
        [ "$(files_of "$DOC" "$CODEC")" = "CHANGELOG.md crates/emend/src/package.rs crates/emend/src/package/tests.rs crates/emend/src/package/tests/chartsheet.rs" ]
    }
    check "each commit changes its own files alone: the doc commit planning's two, the code commit CHANGELOG.md, package.rs and the two test files (change ZE)" "$(yn roles_files)"
    roles_files_ctl() { local CODEC=$DOC DOC=$REC REC=$REC~1; roles_files; }
    check "control: the same check refuses the roles moved one commit down (change ZE)" "$(ynnot roles_files_ctl)"
    roles_files_ctl2() { local DOC=$CODEC; roles_files; }
    check "control: the same check refuses the code commit named as the doc commit (change ZE)" "$(ynnot roles_files_ctl2)"
    echo
    echo "phase: Milestone 6 part 6 P3 ($SPEC) test.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # Ruling AK b (change UP): the hashing asserted, the run log's form, and
    # each named file under <superseded> (ruling AA).
    n_rerun_files=0
    n_rerun_missing=0
    n_rerun_outside=0
    # under_superseded <path>: the path lies inside <superseded>.
    under_superseded() { case "$1" in "$SUPERSEDED_DIR"/*) return 0 ;; esac; return 1; }
    # rerun_hashed: RERUN_FILES named at least one file, each there and each
    # under <superseded>.
    rerun_hashed() { [ "$n_rerun_files" -gt 0 ] && [ "$n_rerun_missing" = 0 ] && [ "$n_rerun_outside" = 0 ]; }
    # names_script <list>: one of the list's paths is a .sh file under
    # <superseded> (ruling F; change UW).
    names_script() {
      local f
      for f in $1; do
        case "$f" in "$SUPERSEDED_DIR"/*.sh) return 0 ;; esac
      done
      return 1
    }
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in (ruling AA; change UG)"
      for sf in ${RERUN_FILES:-}; do
        n_rerun_files=$((n_rerun_files + 1))
        under_superseded "$sf" || n_rerun_outside=$((n_rerun_outside + 1))
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          n_rerun_missing=$((n_rerun_missing + 1))
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
      echo "  files named $n_rerun_files; not there $n_rerun_missing; outside <superseded> $n_rerun_outside"
      check "every file of the attempt RERUN_NOTE names is hashed above, RERUN_FILES names at least one, and each lies in <superseded> (rulings AA and AK b; change UP)" "$(yn rerun_hashed)"
      check "RERUN_FILES names the superseded script that wrote the attempt, a .sh file under <superseded> (ruling F; change UW)" "$(yn names_script "${RERUN_FILES:-}")"
    fi
    rerun_ctl() { local n_rerun_files=1 n_rerun_missing=1 n_rerun_outside=0; rerun_hashed; }
    check "control: names_script refuses a list naming a log and its stderr alone (ruling F; change UW)" "$(ynnot names_script "$SUPERSEDED_DIR/a/test.log $SUPERSEDED_DIR/a/test.outer.stderr")"
    check "control: names_script refuses a script outside <superseded> (change UW)" "$(ynnot names_script "$PHASE_DIR/scripts/m6p6-p3-test.sh")"
    check "control: names_script takes a list naming a script under <superseded> (change UW)" "$(yn names_script "$SUPERSEDED_DIR/a/test.log $SUPERSEDED_DIR/a/m6p6-p3-test.sh")"
    rerun_ctl2() { local n_rerun_files=1 n_rerun_missing=0 n_rerun_outside=1; rerun_hashed; }
    check "control: rerun_hashed refuses a named file that is not there (change UP)" "$(ynnot rerun_ctl)"
    check "control: rerun_hashed refuses a named file outside <superseded> (change UP)" "$(ynnot rerun_ctl2)"
    check "control: under_superseded refuses <superseded> itself" "$(ynnot under_superseded "$SUPERSEDED_DIR")"
    check "control: under_superseded refuses a sibling directory sharing its prefix" "$(ynnot under_superseded "${SUPERSEDED_DIR}x/f")"
    check "control: under_superseded takes a file inside it" "$(yn under_superseded "$SUPERSEDED_DIR/f")"
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this log builds in <repo> into <target>/main, one cargo command at a time (change QB)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh, the spec, the two test files at the base and at the phase commit, the previous test.log (M6 part 5 P3's), M6 part 5 P3's API record, package.rs, styles.rs and styles/elements.rs at M6 part 5 P3's phase commit, and crates/emend/src at the phase commit, are read from it by git show or git archive, the working spec is hashed in it, cargo test, clippy and doc run in it with their output in <target>/main, the listing program reads its history, and the API record is installed in its records unless TEST_RECORDS_DEST names another (changes UX, VJ, VK, WS, WY, XE, XV, YF, YP and ZJ)"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m6p6-p3, the phase's directory on the disk; <phase>/gen/defined.py, the defined-helper program, and <phase>/gen/api-listing.py, the listing program (part 4 P3's), are copied from it (changes UF, UO, UX, VK, VR, WF, WL, WY, XE, XM, XV, XW, YB, YC, YI, YP and ZJ)"
    echo "root: <scripts> stands for <phase>/scripts, this script's own directory on the disk, which holds the script, the formatter <scripts>/make_review.py beside it (generated by gen/test.py; change YO) and, in <scripts>/out, its own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <api> stands for <phase>/api unless TEST_API_DIR names another (a dry run's stand-in), the directory T1 writes the listing into, <api>/listing.tsv and <api>/files.tsv, refused if either is there (changes WS, XM and YI)"
    echo "root: <home>/.cache/emend-build/m6p5-p3 stands for M6 part 5 P3's phase directory, whose api/listing.tsv is the listing this one is compared with; read only (changes XR, YN and ZH)"
    echo "root: <target> stands for <phase>/target, the phase's one target root (specs/0001); <target>/main holds this log's builds (cargo test on both targets, clippy, doc)"
    echo "root: <build> stands for the build root on the disk, <phase>/test unless TEST_BUILD names another"
    echo "root: <superseded> stands for <phase>/superseded, where a rerun's superseded files are kept; read only"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory under <build>, kept on the disk after the run (change QC): <scratch>/w/counting.sh the phase commit's library, sourced; the captured cargo outputs (*.out); <scratch>/w/prev-test.log, the previous test.log read at the phase commit; <scratch>/w/tests-base.rs, tests-now.rs, chartsheet-base.rs and chartsheet-now.rs, the two test files at the base and at the phase commit; <scratch>/w/defined.py, the defined-helper program copied, and its outputs; <scratch>/w/api, T1's work: the archive of crates/emend/src at the phase commit, the listing program copied, the fixture crate, the keys and the sets, the three files at M6 part 5 P3's phase commit, and the staged record; the controls' fixtures (changes RD, UF, UK, UL, UQ, UX, VJ, VK, VW, WE, WF, WS, WY, XE, XV, YF, YP and ZJ)"
    
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$BUILD_ROOT" && apart "$SUPERSEDED_DIR" "$MAIN" && apart "$TARGET_DIR" "$BUILD_ROOT" && apart "$TARGET_DIR" "$MAIN"; }
    check "the roots other than <home> and <phase> are distinct, none inside another (<scratch>/w inside <build>)" "$(yn roots_distinct)"
    roots_ctl() { apart "$B" "$BUILD_ROOT"; }
    check "control: apart refuses <scratch>/w against <build>, which holds it" "$(ynnot roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them this phase's logs or its API record $entry_own; planning's working spec, admitted at PLANNING_SPEC: $entry_plan; the two read by the accounted pattern: $entry_ours; the lines (changes WW, XM, XW, YA, YC and YI):"
    git status --porcelain | sed 's/^/    /'
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT_SHA")"
    short_names_head() { [ "$(git rev-parse "$SHORT_SHA")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_src_ctl() { printf ' M crates/emend/src/cells.rs\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified crate source" "$(ynnot ours_src_ctl)"
    ours_roadmap_ctl() { printf ' M ROADMAP.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified ROADMAP.md (committed and clean in this phase; changes UY, VG, VT, WB, WP, WZ, XF, XM, XW, YC and YI)" "$(ynnot ours_roadmap_ctl)"
    if plan_admitted; then n_ours_ctl_want=3; else n_ours_ctl_want=2; fi
    ours_rec_ctl() { printf '?? records/logs/m6p6-p3/gate.log\n?? records/api-review-m6p6-2026-01-01-%s.md\n?? records/logs/m6p6-p2/gate.log\n?? records/logs/m6p6-p3x/gate.log\n M records/logs/m6p6-p3/gate.log\n M ROADMAP.md\n M specs/0043-measurement-and-close.md\n M specs/0042-gradient-fills-and-named-styles.md\n?? records/m6p6-p3-sheet-2026-01-01-%s.md\n?? records/api-review-m6p6-2026-01-01-%s.md.x\n?? records/api-review-m6p6-2026-01-01-%s.txt\n?? records/api-review-m6p5-2026-01-01-%s.md\n?? records/size-m6p6-2026-01-01-%s.md\n?? records/api-review-m6p6-2026-01-01-0000000.md\n' "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" "$SHORT_SHA" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern takes this phase's untracked log and its API record alone, no other phase's log, no sibling directory, no tracked log, no modified roadmap, the modified spec only when planning's copy is admitted and no other spec, no run record, no longer name, no .txt, no other part's API record, no size record and no other commit's (changes RA, UA, UI, UR, UY, VG, VJ, VM, WB, WE, WH, WP, WS, WZ, XD, XF, XM, XW, YA, YC, YI and ZD)" "$(yn [ "$(ours_rec_ctl)" = "$n_ours_ctl_want" ])"
    # Change WW (ruling S, kept): the own pattern takes the phase's two paths and
    # not the working spec; the plan line takes the working spec alone.
    own_ctl() { printf '?? records/logs/m6p6-p3/gate.log\n?? records/api-review-m6p6-2026-01-01-%s.md\n M specs/0043-measurement-and-close.md\n?? records/logs/m6p6-p2/gate.log\n' "$SHORT_SHA" | count_matches -E "$OWN" /dev/stdin; }
    check "control: the own pattern takes the phase's log and its API record and not the working spec (changes WW, XD, XM, XW and YI)" "$(yn [ "$(own_ctl)" = 2 ])"
    plan_line_ctl() { printf '?? records/logs/m6p6-p3/gate.log\n M specs/0043-measurement-and-close.md\n M specs/0042-gradient-fills-and-named-styles.md\n' | count_matches -E "$PLAN_LINE" /dev/stdin; }
    check "control: the plan line pattern takes the working spec's line alone (changes WW, WZ, XW and YI)" "$(yn [ "$(plan_line_ctl)" = 1 ])"
    ours_readme_ctl() { printf ' M README.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified README.md (committed and clean in this phase; changes UA, UI, UR, UY and VG)" "$(ynnot ours_readme_ctl)"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_BLOB=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum: $SPEC_BLOB; sha256sum $SPEC (the working file; changes RA, UA, UI, UR and UY): $SPEC_HAVE"
    check "the spec's blob at the phase commit is at the hash this log pins" "$(yn [ "$SPEC_BLOB" = "$SPEC_WANT" ])"
    spec_working() { [ "$SPEC_HAVE" = "$SPEC_WANT" ] || { plan_admitted && [ "$SPEC_HAVE" = "$PLANNING_SPEC" ]; }; }
    check "the working spec is that blob, or planning's working copy at PLANNING_SPEC when given (changes UY, VG and VM)" "$(yn spec_working)"
    spec_working_ctl() { local PLANNING_SPEC= SPEC_HAVE=$FAKE_SHA; spec_working; }
    check "control: spec_working refuses another hash with no PLANNING_SPEC (change VM)" "$(ynnot spec_working_ctl)"
    plan_ctl() { local PLANNING_SPEC=$FAKE_SHA; plan_admitted; }
    check "control: plan_admitted refuses a PLANNING_SPEC the working file does not hash to (change VM)" "$(ynnot plan_ctl)"
    spec_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$SPEC_WANT" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot spec_ctl)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    # failed_names <cargo output>: prints the name of every test the run failed,
    # from its FAILED lines, or "none" (M5 part 6's form). It prints, so it is
    # never a check's condition.
    failed_names() {
      local n
      n=$(LC_ALL=C "$G" -a -E '^test .* \.\.\. FAILED$' "$1" | sed -E 's/^test (.*) \.\.\. FAILED$/\1/')
      if [ -n "$n" ]; then printf '%s\n' "$n" | sed 's/^/    failed test: /'; else echo "    failed tests: none"; fi
    }
    printf 'test a::b ... ok\ntest a::c ... FAILED\n' >"$B/c-failed"
    check "control: failed_names prints the name of the one FAILED line of two" "$(yn [ "$(failed_names "$B/c-failed")" = "    failed test: a::c" ])"
    printf 'test a::b ... ok\n' >"$B/c-failed-none"
    check "control: failed_names prints none for a run with no FAILED line" "$(yn [ "$(failed_names "$B/c-failed-none")" = "    failed tests: none" ])"
    # diag_lines <cargo output>: the lines a warning or an error begins with
    # (rustc's and clippy's "warning:" / "warning[...]" / "error:" / "error[...]"),
    # counted by the counting library's form.
    DIAG='^(warning|error)(\[[A-Za-z0-9_:]+\])?: '
    diag_lines() { count_matches -E "$DIAG" "$1"; }
    printf 'warning: unused import\nerror[E0433]: failed to resolve\n    Finished x\nnote: this is not one\n' >"$B/c-diag"
    check "control: diag_lines counts the two diagnostic lines of a four-line fixture" "$(yn [ "$(diag_lines "$B/c-diag")" = 2 ])"
    
    CT=$TARGET_DIR/main
    SETS="off read rules read,rules all"
    # set_args <set>: the cargo arguments of a feature set.
    set_args() { case $1 in off) ;; all) echo "--all-features" ;; *) echo "--features $1" ;; esac; }
    # test_run <name> <cargo args...>: runs cargo with the args into <target>/main,
    # keeps the output as <name>.out, prints the exit, the summary lines and the
    # failed names, and writes <name>.rc, .passed, .failed and .nok. It prints,
    # so it is never a check's condition; run_passed reads its files.
    test_run() {
      local name=$1 rc passed failed nok
      shift
      echo "command: CARGO_TARGET_DIR=<target>/main cargo $*"
      CARGO_TARGET_DIR=$CT cargo "$@" >"$B/$name.out" 2>&1 </dev/null
      rc=$?
      LC_ALL=C "$G" -a -E '^test result: ' "$B/$name.out" | sed 's/^/    /'
      failed_names "$B/$name.out"
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/$name.out")
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/$name.out")
      nok=$(count_matches -E '^test .* \.\.\. ok$' "$B/$name.out")
      echo "$rc" >"$B/$name.rc"; echo "$passed" >"$B/$name.passed"; echo "$failed" >"$B/$name.failed"; echo "$nok" >"$B/$name.nok"
      echo "  $name: exit $rc; passed $passed; failed $failed; executed (passed plus failed) $((passed + failed)); test lines ending ok $nok"
    }
    # run_passed <name>: exit 0, failed 0, passed more than 0 and equal to the ok lines.
    run_passed() {
      local rc passed failed nok
      rc=$(cat "$B/$1.rc"); passed=$(cat "$B/$1.passed"); failed=$(cat "$B/$1.failed"); nok=$(cat "$B/$1.nok")
      [ "$rc" = 0 ] && [ "$failed" = 0 ] && [ "$passed" -gt 0 ] && [ "$passed" = "$nok" ]
    }
    echo 0 >"$B/c-run.rc"; echo 3 >"$B/c-run.passed"; echo 1 >"$B/c-run.failed"; echo 3 >"$B/c-run.nok"
    check "control: run_passed refuses a run with one failed test" "$(ynnot run_passed c-run)"
    echo 0 >"$B/c-run2.rc"; echo 3 >"$B/c-run2.passed"; echo 0 >"$B/c-run2.failed"; echo 2 >"$B/c-run2.nok"
    check "control: run_passed refuses a run whose passed count is not its ok lines" "$(ynnot run_passed c-run2)"
    echo 0 >"$B/c-run3.rc"; echo 3 >"$B/c-run3.passed"; echo 0 >"$B/c-run3.failed"; echo 3 >"$B/c-run3.nok"
    check "control: run_passed takes a clean run of three" "$(yn run_passed c-run3)"
    
    echo
    echo "## W: cargo test --workspace on both targets (the gate's own test steps)"
    test_run ws-host test --workspace
    check "W host: exit 0, none failed, some ran, passed equals the ok lines" "$(yn run_passed ws-host)"
    test_run ws-i686 test --workspace --target i686-unknown-linux-musl
    check "W i686: exit 0, none failed, some ran, passed equals the ok lines" "$(yn run_passed ws-i686)"
    
    echo
    echo "## F: cargo test -p emend with each of the spec's five feature sets, on both targets (changes UJ and XY)"
    for target in host i686; do
      for set in $SETS; do
        args=(test -p emend)
        [ "$target" = host ] || args+=(--target i686-unknown-linux-musl)
        # shellcheck disable=SC2207
        args+=($(set_args "$set"))
        test_run "f-$target-$set" "${args[@]}"
        check "F $target, features $set: exit 0, none failed, some ran, passed equals the ok lines" "$(yn run_passed "f-$target-$set")"
      done
    done
    more_with_all() { [ "$(cat "$B/f-$1-all.passed")" -gt "$(cat "$B/f-$1-off.passed")" ]; }
    check "F host: the all-features run passes more tests than the run with none (the sets differ)" "$(yn more_with_all host)"
    check "F i686: the all-features run passes more tests than the run with none" "$(yn more_with_all i686)"
    more_ctl() { [ "$(cat "$B/f-host-off.passed")" -gt "$(cat "$B/f-host-all.passed")" ]; }
    check "control: the same comparison refuses the reverse order" "$(ynnot more_ctl)"
    
    echo
    echo "## E: each W and F run's passed count beside the previous phase's committed test.log, no run fewer, host equal to i686 (change UK)"
    PREV_TEST=records/logs/m6p5-p3/test.log
    PREV_FORM='^  (ws|f)-(host|i686)[^:]*: exit 0; passed [0-9]+; failed 0; '
    echo "command: git show <phase commit>:$PREV_TEST > <scratch>/w/prev-test.log; grep -cE '$PREV_FORM' <scratch>/w/prev-test.log"
    git show "$C:$PREV_TEST" >"$B/prev-test.log"
    rc_prev=$?
    n_prev=$(count_matches -E "$PREV_FORM" "$B/prev-test.log")
    echo "  exit $rc_prev; run lines $n_prev"
    prev_read() { [ "$rc_prev" = 0 ] && [ "$n_prev" = 12 ]; }
    check "M6 part 5 P3's test.log (the last that ran cargo; P1's and P2's ran none) was read at the phase commit, its run lines 12 (two workspace runs and the five sets on each target; changes YE and ZF)" "$(yn prev_read)"
    # prev_count <log> <run name>: the passed figure of the log's one line
    # "  <run name>: exit 0; passed <n>; failed 0; ...", the test log's form for
    # a run this log repeats under the same name; "none" when not exactly one
    # line reads so. It prints, so its value is compared.
    prev_count() {
      local hits
      hits=$(LC_ALL=C "$G" -E "^  $2: exit 0; passed [0-9]+; failed 0; " "$1" | sed -E 's/^  [^:]*: exit 0; passed ([0-9]+); .*$/\1/')
      if [ -n "$hits" ] && [ "$(printf '%s\n' "$hits" | wc -l)" = 1 ]; then echo "$hits"; else echo none; fi
    }
    # same_count <a> <b>: both are the same decimal number.
    same_count() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9]+$' && [ "$1" = "$2" ]; }
    # not_fewer <a> <b>: both decimal numbers, a not below b.
    not_fewer() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9]+$' && printf '%s' "$2" | LC_ALL=C "$G" -qE '^[0-9]+$' && [ "$1" -ge "$2" ]; }
    printf '%s\n' '  f-host-off: exit 0; passed 10; failed 0; executed (passed plus failed) 10; test lines ending ok 10' \
      '  f-host-offx: exit 0; passed 11; failed 0; executed (passed plus failed) 11; test lines ending ok 11' \
      '  f-host-all: exit 0; passed 12; failed 0; executed (passed plus failed) 12; test lines ending ok 12' \
      '  f-host-all: exit 0; passed 13; failed 0; executed (passed plus failed) 13; test lines ending ok 13' \
      '  f-host-charts: exit 101; passed 14; failed 1; executed (passed plus failed) 15; test lines ending ok 14' >"$B/c-prevtest"
    check "control: prev_count reads 10 for f-host-off, not the figure of the longer name f-host-offx" "$(yn [ "$(prev_count "$B/c-prevtest" f-host-off)" = 10 ])"
    check "control: prev_count reads none for a run the log gives twice (f-host-all)" "$(yn [ "$(prev_count "$B/c-prevtest" f-host-all)" = none ])"
    check "control: prev_count reads none for a run that did not exit 0 with none failed (f-host-charts)" "$(yn [ "$(prev_count "$B/c-prevtest" f-host-charts)" = none ])"
    check "control: prev_count reads none for a run the log does not give (f-host-images)" "$(yn [ "$(prev_count "$B/c-prevtest" f-host-images)" = none ])"
    check "control: same_count refuses 515 against 516" "$(ynnot same_count 515 516)"
    check "control: same_count refuses none against none" "$(ynnot same_count none none)"
    check "control: same_count takes 515 against 515" "$(yn same_count 515 515)"
    check "control: not_fewer refuses 514 against 515" "$(ynnot not_fewer 514 515)"
    check "control: not_fewer refuses none against 515" "$(ynnot not_fewer none 515)"
    check "control: not_fewer takes 515 against 515" "$(yn not_fewer 515 515)"
    # e_line <run name>: prints the run's figure, its previous one and the
    # difference, and checks it is not fewer; a run the previous log did not
    # give is printed as new.
    e_line() {
      local want have
      want=$(prev_count "$B/prev-test.log" "$1")
      have=$(cat "$B/$1.passed")
      if [ "$want" = none ]; then
        echo "  E $1: the previous test.log gives no run of this name; this run passed $have"
        echo none >"$B/$1.prev"
      else
        echo "  E $1: the previous test.log $want; this run passed $have; difference $((have - want))"
        echo "$want" >"$B/$1.prev"
      fi
    }
    for name in ws-host ws-i686; do
      e_line "$name"
      check "E $name: a previous figure exists and this run's is not fewer (change UK)" "$(yn not_fewer "$(cat "$B/$name.passed")" "$(cat "$B/$name.prev")")"
    done
    # Change YE: P1's test.log gives every set this log runs, so every run is
    # compared (XY's new-set branch goes).
    for target in host i686; do
      for set in $SETS; do
        e_line "f-$target-$set"
        check "E $target, features $set: a previous figure exists and this run's is not fewer (changes UK, US and YE)" "$(yn not_fewer "$(cat "$B/f-$target-$set.passed")" "$(cat "$B/f-$target-$set.prev")")"
      done
    done
    # Change US: each run's figure is the one this phase expects.
    # expected <run name>: the figure the generator typed in for the run.
    expected() {
      case $1 in
        ws-*) echo 1449 ;;
        f-*-off) echo 538 ;;
        f-*-read) echo 645 ;;
        f-*-rules) echo 575 ;;
        f-*-read,rules) echo 685 ;;
        f-*-all) echo 1200 ;;
        *) echo none ;;
      esac
    }
    for name in ws-host ws-i686 $(for target in host i686; do for set in $SETS; do echo "f-$target-$set"; done; done); do
      echo "  E $name: this run passed $(cat "$B/$name.passed"); the figure this phase expects $(expected "$name")"
      check "E $name: the figure this phase expects, M6 part 5 P3's and the chartsheet test where charts is on (changes US, VH, VO, VU, WC, WI, WQ, XB, XH, XO, XY, YE, YK and ZF)" "$(yn same_count "$(cat "$B/$name.passed")" "$(expected "$name")")"
    done
    check "control: expected gives none for a run this log does not make (f-host-charts; change XY)" "$(yn [ "$(expected f-host-charts)" = none ])"
    check "control: same_count refuses the expected read figure less one against it (changes US and XY)" "$(ynnot same_count "$(( $(expected f-host-read) - 1 ))" "$(expected f-host-read)")"
    check "E: the workspace's host figure equals its i686 figure" "$(yn same_count "$(cat "$B/ws-host.passed")" "$(cat "$B/ws-i686.passed")")"
    for set in $SETS; do
      check "E features $set: the host figure equals the i686 figure" "$(yn same_count "$(cat "$B/f-host-$set.passed")" "$(cat "$B/f-i686-$set.passed")")"
    done
    plus_one=$(( $(cat "$B/f-host-off.passed") + 1 ))
    check "control: the same comparison refuses the host off run's count plus one" "$(ynnot same_count "$plus_one" "$(cat "$B/f-i686-off.passed")")"
    minus_one=$(( $(cat "$B/f-host-off.prev") - 1 ))
    check "control: not_fewer refuses the previous host off figure less one against it" "$(ynnot not_fewer "$minus_one" "$(cat "$B/f-host-off.prev")")"
    
    echo
    echo "## N: this phase's two tests by name: the accepting test that replaced the refusing one in every run, the old name in none; the chartsheet test on openpyxl's form where charts is on (specs/0043 decision 3 A, ruling M; change ZG)"
    echo "command: git show <base>:<file> and <phase commit>:<file> > <scratch>/w/<name>-base.rs and -now.rs, for crates/emend/src/package/tests.rs and crates/emend/src/package/tests/chartsheet.rs"
    git show "$REC:crates/emend/src/package/tests.rs" >"$B/tests-base.rs"
    rc_tb=$?
    git show "$C:crates/emend/src/package/tests.rs" >"$B/tests-now.rs"
    rc_tn=$?
    git show "$REC:crates/emend/src/package/tests/chartsheet.rs" >"$B/chartsheet-base.rs"
    rc_cb=$?
    git show "$C:crates/emend/src/package/tests/chartsheet.rs" >"$B/chartsheet-now.rs"
    rc_cn=$?
    echo "  exit $rc_tb, $rc_tn, $rc_cb and $rc_cn"
    OLD_T=a_workbook_root_binding_no_relationships_prefix_refuses_an_add
    NEW_T=a_workbook_root_binding_no_relationships_prefix_takes_an_add
    OPX_T=an_openpyxl_form_workbook_takes_a_sheet_and_a_chartsheet
    # fn_count <file> <name>: the lines "fn <name>() {" in the file. It prints,
    # so its value is compared.
    fn_count() { count_matches -xF "fn $2() {" "$1"; }
    echo "  fn $OLD_T: at the base $(fn_count "$B/tests-base.rs" "$OLD_T"); now $(fn_count "$B/tests-now.rs" "$OLD_T")"
    echo "  fn $NEW_T: at the base $(fn_count "$B/tests-base.rs" "$NEW_T"); now $(fn_count "$B/tests-now.rs" "$NEW_T")"
    echo "  fn $OPX_T: at the base $(fn_count "$B/chartsheet-base.rs" "$OPX_T"); now $(fn_count "$B/chartsheet-now.rs" "$OPX_T")"
    names_moved() { [ "$rc_tb:$rc_tn:$rc_cb:$rc_cn" = 0:0:0:0 ] && [ "$(fn_count "$B/tests-base.rs" "$OLD_T"):$(fn_count "$B/tests-now.rs" "$OLD_T")" = 1:0 ] && [ "$(fn_count "$B/tests-base.rs" "$NEW_T"):$(fn_count "$B/tests-now.rs" "$NEW_T")" = 0:1 ] && [ "$(fn_count "$B/chartsheet-base.rs" "$OPX_T"):$(fn_count "$B/chartsheet-now.rs" "$OPX_T")" = 0:1 ]; }
    check "the refusing test is at the base and not at the phase commit; its accepting successor and the chartsheet test are at the phase commit and not at the base, once each (ruling M; change ZG)" "$(yn names_moved)"
    printf '%s\n' "fn $OLD_T() {" "fn ${OLD_T}_too() {" "    fn $OLD_T() {" >"$B/c-fn.rs"
    check "control: fn_count reads one line in a fixture holding the name once at line start, a longer name and an indented one (change ZG)" "$(yn [ "$(fn_count "$B/c-fn.rs" "$OLD_T")" = 1 ])"
    # gate_of_module: the line before the chartsheet module's declaration.
    gate_of_module() { awk '$0 == "mod chartsheet;" { print p; exit } { p = $0 }' "$B/tests-now.rs"; }
    echo "  the line before mod chartsheet; in package/tests.rs: $(gate_of_module)"
    check "the chartsheet module is gated on charts alone (change ZG)" "$(yn [ "$(gate_of_module)" = '#[cfg(feature = "charts")]' ])"
    # ok_lines <run> <full test name>: the run's lines "test <name> ... ok"; any_lines the
    # result lines of the name, ok, FAILED or ignored alike. Each prints, so its
    # value is compared.
    ok_lines() { count_matches -xF "test $2 ... ok" "$B/$1.out"; }
    any_lines() { count_matches -F "test $2 ... " "$B/$1.out"; }
    OLD_FULL=package::tests::$OLD_T
    NEW_FULL=package::tests::$NEW_T
    OPX_FULL=package::tests::chartsheet::$OPX_T
    # charts_on <set>: the set enables charts (every feature alone of the five).
    charts_on() { [ "$1" = all ]; }
    check "control: charts_on refuses the read,rules set (change ZG)" "$(ynnot charts_on read,rules)"
    check "control: charts_on takes the all set (change ZG)" "$(yn charts_on all)"
    for target in host i686; do
      for set in $SETS; do
        run=f-$target-$set
        echo "  N $target, features $set: $NEW_T $(ok_lines "$run" "$NEW_FULL"); its old name's result lines $(any_lines "$run" "$OLD_FULL"); $OPX_T $(ok_lines "$run" "$OPX_FULL") (result lines $(any_lines "$run" "$OPX_FULL"))"
        check "N $target, features $set: the accepting test passed once by name and no test ran under the old name (change ZG)" "$(yn [ "$(ok_lines "$run" "$NEW_FULL"):$(any_lines "$run" "$OLD_FULL")" = 1:0 ])"
        if charts_on "$set"; then
          check "N $target, features $set: the chartsheet test passed once by name (charts is on; change ZG)" "$(yn [ "$(ok_lines "$run" "$OPX_FULL")" = 1 ])"
        else
          check "N $target, features $set: the chartsheet test did not run (charts is off; change ZG)" "$(yn [ "$(any_lines "$run" "$OPX_FULL")" = 0 ])"
        fi
      done
    done
    for target in host i686; do
      run=ws-$target
      echo "  N $run: $NEW_T $(ok_lines "$run" "$NEW_FULL"); its old name's result lines $(any_lines "$run" "$OLD_FULL"); $OPX_T $(ok_lines "$run" "$OPX_FULL")"
      check "N $run: the accepting test and the chartsheet test passed once each by name and no test ran under the old name (the workspace's features unified as the tools', charts among them; change ZG)" "$(yn [ "$(ok_lines "$run" "$NEW_FULL"):$(ok_lines "$run" "$OPX_FULL"):$(any_lines "$run" "$OLD_FULL")" = 1:1:0 ])"
    done
    printf 'test %s ... ok\ntest %s ... FAILED\ntest %s ... ok\n' "$NEW_FULL" "$OPX_FULL" "${NEW_FULL}_too" >"$B/c-n.out"
    check "control: ok_lines reads one ok line for the accepting test, not the longer name's (change ZG)" "$(yn [ "$(ok_lines c-n "$NEW_FULL")" = 1 ])"
    check "control: ok_lines reads 0 for the chartsheet test whose line is FAILED (change ZG)" "$(yn [ "$(ok_lines c-n "$OPX_FULL")" = 0 ])"
    check "control: any_lines counts the FAILED line of the chartsheet test (change ZG)" "$(yn [ "$(any_lines c-n "$OPX_FULL")" = 1 ])"
    printf 'test %s ... FAILED\n' "$OLD_FULL" >"$B/c-old.out"
    check "control: any_lines counts a FAILED line under the old name (change ZG)" "$(yn [ "$(any_lines c-old "$OLD_FULL")" = 1 ])"
    
    echo
    echo "## R: each F run's doc-tests result, 0 passed and 0 failed (change RC, kept; change UM)"
    # doc_result <cargo output>: "<passed> <failed>" of the first "test result:"
    # line after cargo's "Doc-tests emend" line, or "none". It prints, so its
    # value is compared.
    doc_result() {
      local r
      r=$(awk '/^[[:space:]]*Doc-tests emend[[:space:]]*$/ { d = 1; next }
        d && /^test result: / { p = 0; f = 0; for (i = 1; i < NF; i++) { if ($(i + 1) ~ /^passed;$/) p = $i; if ($(i + 1) ~ /^failed;$/) f = $i }; print p, f; exit }' "$1")
      if [ -n "$r" ]; then echo "$r"; else echo none; fi
    }
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n   Doc-tests emend\n\nrunning 1 test\ntest result: ok. 1 passed; 0 failed; 0 ignored\n' >"$B/c-doc1"
    check "control: doc_result reads 1 0 for a fixture with one doctest, not the lib line before it" "$(yn [ "$(doc_result "$B/c-doc1")" = "1 0" ])"
    printf 'test result: ok. 5 passed; 0 failed; 0 ignored\n' >"$B/c-doc2"
    check "control: doc_result reads none for an output with no Doc-tests line" "$(yn [ "$(doc_result "$B/c-doc2")" = none ])"
    for target in host i686; do
      for set in $SETS; do
        dl=$(count_matches -E '^[[:space:]]*Doc-tests emend[[:space:]]*$' "$B/f-$target-$set.out")
        dr=$(doc_result "$B/f-$target-$set.out")
        echo "  R $target, features $set: Doc-tests emend lines $dl; its result (passed failed) $dr"
        check "R $target, features $set: one Doc-tests emend line, its result 0 passed 0 failed" "$(yn [ "$dl:$dr" = "1:0 0" ])"
      done
    done
    
    clean_run() { [ "$(cat "$B/$1.rc")" = 0 ] && [ "$(diag_lines "$B/$1.out")" = 0 ]; }
    # lint_run <name> <env...> -- <cargo args...>: runs cargo into <target>/main,
    # prints the exit and the diagnostic line count, writes <name>.rc.
    lint_run() {
      local name=$1 rc
      shift
      echo "command: CARGO_TARGET_DIR=<target>/main $*"
      env CARGO_TARGET_DIR="$CT" "$@" >"$B/$name.out" 2>&1 </dev/null
      rc=$?
      echo "$rc" >"$B/$name.rc"
      echo "  $name: exit $rc; diagnostic lines $(diag_lines "$B/$name.out")"
      LC_ALL=C "$G" -a -E "$DIAG" "$B/$name.out" | sed 's/^/    /'
    }
    echo 0 >"$B/c-lint.rc"; printf 'warning: unused variable\n    Finished x\n' >"$B/c-lint.out"
    check "control: clean_run refuses an exit-0 run with one warning line" "$(ynnot clean_run c-lint)"
    echo 0 >"$B/c-lint2.rc"; printf '    Checking x\n    Finished x\n' >"$B/c-lint2.out"
    check "control: clean_run takes an exit-0 run with none" "$(yn clean_run c-lint2)"
    
    echo
    echo "## C: clippy with -D warnings, the crate's five sets, the workspace and the size probe crate's three (changes UE, UJ, UN and XY)"
    for set in $SETS; do
      # shellcheck disable=SC2207
      sa=($(set_args "$set"))
      lint_run "c-$set" cargo clippy -p emend --all-targets "${sa[@]}" -- -D warnings
      check "C features $set: exit 0, 0 diagnostic lines" "$(yn clean_run "c-$set")"
    done
    lint_run c-workspace cargo clippy --workspace --all-targets -- -D warnings
    check "C workspace: exit 0, 0 diagnostic lines" "$(yn clean_run c-workspace)"
    PROBE_SETS="emend,xml charts images"
    for set in $PROBE_SETS; do
      lint_run "c-probe-$set" cargo clippy -p size-probe --all-targets --features "$set" -- -D warnings
      check "C size-probe, features $set: exit 0, 0 diagnostic lines (change UE)" "$(yn clean_run "c-probe-$set")"
    done
    
    echo
    echo "## D: rustdoc with -D warnings, the crate's five sets (changes UJ and XY)"
    for set in $SETS; do
      # shellcheck disable=SC2207
      sa=($(set_args "$set"))
      lint_run "d-$set" RUSTDOCFLAGS='-D warnings' cargo doc -p emend --no-deps "${sa[@]}"
      check "D features $set: exit 0, 0 diagnostic lines" "$(yn clean_run "d-$set")"
    done
    
    
    TAB=$(printf '\t')
    # Change YM: one listing program, part 4 P3's, <phase>/gen/api-listing.py
    # (part 7's with change AV1, specs/0040 ruling V). Change ZH: its hash read
    # from part 5 P3's API record, which names it; the listing compared with is
    # part 5 P3's.
    NEW_PROG_SRC=$PHASE_DIR/gen/api-listing.py
    OLD_LISTING=$HOME/.cache/emend-build/m6p5-p3/api/listing.tsv
    OLD_RECORD=records/api-review-m6p5-2026-10-23-fe280ff.md
    FORMATTER=$SELF_DIR/make_review.py
    T=$B/api
    mkdir -p "$T" || fail=1
    
    echo
    echo "## T1: the pub listing, every pub item of crates/emend reachable from the crate root, by module (specs/0043 \"The engineering close\" item 4; M6 part 5 P3's form; changes YM, YN and ZH)"
    api_absent() { [ ! -e "$API_DIR/listing.tsv" ] && [ ! -e "$API_DIR/files.tsv" ]; }
    check "no listing is in <api> before this run" "$(yn api_absent)"
    mkdir -p "$API_DIR" "$T/src" "$T/py" "$T/fx/src" || fail=1
    echo "### the listing program, part 4 P3's (part 7 P3's with change AV1), by the hash part 5 P3's API record names (changes YM and ZH)"
    cp "$NEW_PROG_SRC" "$T/py/api-listing.py" || fail=1
    NEW_PROG_SHA=$(sha256sum <"$T/py/api-listing.py" | cut -d' ' -f1)
    NEW_PROG_WANT=$(git show "$C:$OLD_RECORD" | LC_ALL=C "$G" -o -E 'listing program, sha256 [0-9a-f]{64} ' | awk '{ print $4 }')
    echo "command: cp <phase>/gen/api-listing.py <scratch>/w/api/py/api-listing.py; sha256sum: $NEW_PROG_SHA"
    echo "command: git show <phase commit>:$OLD_RECORD | grep -o -E 'listing program, sha256 <64 hex> ': ${NEW_PROG_WANT:-none}"
    new_prog_ok() { [ -n "$NEW_PROG_WANT" ] && [ "$NEW_PROG_SHA" = "$NEW_PROG_WANT" ]; }
    check "the listing program is the one M6 part 5 P3's API record names, by hash (changes YM and ZH)" "$(yn new_prog_ok)"
    new_prog_ctl() { local NEW_PROG_SHA; NEW_PROG_SHA=$(printf 'x' | sha256sum | cut -d' ' -f1); new_prog_ok; }
    check "control: the same comparison refuses the hash of another file (change YM)" "$(ynnot new_prog_ctl)"
    echo "command: git archive <phase commit> crates/emend/src | tar -x -C <scratch>/w/api/src"
    git archive "$C" crates/emend/src | tar -x -C "$T/src"
    arch_rc=$?
    n_arch=$(find "$T/src/crates/emend/src" -type f -name '*.rs' | count_lines /dev/stdin)
    n_tree=$(git ls-tree -r --name-only "$C" crates/emend/src | count_matches -E '[.]rs$' /dev/stdin)
    echo "  archive exit: $arch_rc; .rs files extracted: $n_arch; .rs files under crates/emend/src in the phase commit's tree: $n_tree"
    arch_ok() { [ "$arch_rc" = 0 ] && [ "$n_arch" -ge 1 ] && [ "$n_arch" = "$n_tree" ]; }
    check "the archive holds every .rs file of the phase commit's crates/emend/src" "$(yn arch_ok)"
    arch_ctl() { local n_tree=$((n_tree + 1)); arch_ok; }
    check "control: the same comparison refuses a tree count one more than the archive's" "$(ynnot arch_ctl)"
    
    echo "### the program's control: part 7's fixture crate, written by this log"
    printf '%s\n' 'pub mod a;' 'mod b;' '#[cfg(test)]' 'mod tests;' 'pub use b::{X, Y as Z};' '/// pub fn not_this()' 'pub(crate) fn hidden() {}' >"$T/fx/src/lib.rs"
    printf '%s\n' 'pub struct P {' '    pub f: u8,' '    g: u8,' '}' 'impl P { pub fn m(&self) { let _s = "{ pub fn fake"; } }' '#[cfg(feature = "q")]' 'pub const C: u8 = 1;' >"$T/fx/src/a.rs"
    printf '%s\n' 'pub struct X;' 'pub struct W;' 'pub enum Y {' '    V,' '}' 'impl W {' '    pub fn n() {}' '}' >"$T/fx/src/b.rs"
    printf '%s\n' 'pub fn t() {}' >"$T/fx/src/tests.rs"
    for f in lib.rs a.rs b.rs tests.rs; do
      echo "  <scratch>/w/api/fx/src/$f:"
      sed 's/^/      /' "$T/fx/src/$f"
    done
    echo "command: python3 -I -B <scratch>/w/api/py/api-listing.py <scratch>/w/api/fx/src fx <repo> <phase commit> <scratch>/w/api/fx/rows.tsv <scratch>/w/api/fx/files.tsv --no-added"
    python3 -I -B "$T/py/api-listing.py" "$T/fx/src" fx "$MAIN" "$C" "$T/fx/rows.tsv" "$T/fx/files.tsv" --no-added >"$T/fx/out" 2>"$T/fx/err"
    fx_rc=$?
    echo "  exit: $fx_rc; standard output $(wc -c <"$T/fx/out") bytes; standard error $(wc -c <"$T/fx/err") bytes; its rows, columns 2 to 8, tabs shown as |:"
    cut -f2-8 "$T/fx/rows.tsv" | tr '\t' '|' | sed 's/^/    /'
    echo "  its files table, tabs shown as |:"
    tr '\t' '|' <"$T/fx/files.tsv" | sed 's/^/    /'
    exp_line() { local IFS=$TAB; printf '%s\n' "$*"; }
    {
      exp_line file line kind name container cfg reachable
      exp_line fx/lib.rs 1 mod a - - yes
      exp_line fx/lib.rs 5 use 'b::{X, Y as Z}' - - yes
      exp_line fx/a.rs 1 struct P - - yes
      exp_line fx/a.rs 2 field f P - yes
      exp_line fx/a.rs 5 method m P - yes
      exp_line fx/a.rs 7 const C - q yes
      exp_line fx/b.rs 1 struct X - - 'yes (re-exported as crate::X)'
      exp_line fx/b.rs 2 struct W - - 'no (private module, not re-exported)'
      exp_line fx/b.rs 3 enum Y - - 'yes (re-exported as crate::Z)'
      exp_line fx/b.rs 7 method n W - 'no (its type is not reachable)'
    } >"$T/fx/expected-rows"
    {
      exp_line file module rows rows_at_line_start rows_reachable
      exp_line fx/lib.rs crate 2 2 2
      exp_line fx/a.rs crate::a 4 3 4
      exp_line fx/b.rs crate::b 4 4 2
      exp_line fx/tests 'cfg(test), not walked' - - -
    } >"$T/fx/expected-files"
    cut -f2-8 "$T/fx/rows.tsv" >"$T/fx/got-rows"
    fx_ran() { [ "$fx_rc" = 0 ] && [ ! -s "$T/fx/out" ] && [ ! -s "$T/fx/err" ]; }
    check "control: the program exits 0 on the fixture crate and prints nothing" "$(yn fx_ran)"
    check "control: the fixture's rows are the expected ones (part 7's fixture and expectation)" "$(yn cmp -s "$T/fx/got-rows" "$T/fx/expected-rows")"
    check "control: the fixture's files table is the expected one" "$(yn cmp -s "$T/fx/files.tsv" "$T/fx/expected-files")"
    cp "$T/fx/expected-rows" "$T/fx/c-rows"; printf 'x\n' >>"$T/fx/c-rows"
    check "control: the same comparison refuses the expected rows with one line more" "$(ynnot cmp -s "$T/fx/got-rows" "$T/fx/c-rows")"
    PUB_RE='^[[:space:]]*pub '
    n_fx_a=$(count_matches -E "$PUB_RE" "$T/fx/src/a.rs")
    n_fx_lib=$(count_matches -E "$PUB_RE" "$T/fx/src/lib.rs")
    echo "  command: count_matches -E '$PUB_RE' over the fixture's a.rs and lib.rs: $n_fx_a and $n_fx_lib"
    check "control: the grep form counts a.rs's three line-start pub lines" "$(yn [ "$n_fx_a" = 3 ])"
    check "control: the grep form counts lib.rs's two pub lines" "$(yn [ "$n_fx_lib" = 2 ])"
    
    echo "### the listing of the phase commit's crate"
    echo "command: python3 -I -B <scratch>/w/api/py/api-listing.py <scratch>/w/api/src/crates/emend/src crates/emend/src <repo> <phase commit> <api>/listing.tsv <api>/files.tsv"
    python3 -I -B "$T/py/api-listing.py" "$T/src/crates/emend/src" crates/emend/src "$MAIN" "$C" "$API_DIR/listing.tsv" "$API_DIR/files.tsv" >"$T/listing.out" 2>"$T/listing.err"
    lst_rc=$?
    echo "  exit: $lst_rc; standard output $(wc -c <"$T/listing.out") bytes; standard error $(wc -c <"$T/listing.err") bytes"
    listing_ran() { [ "$lst_rc" = 0 ] && [ ! -s "$T/listing.out" ] && [ ! -s "$T/listing.err" ]; }
    check "the listing program exits 0 and prints nothing" "$(yn listing_ran)"
    LISTING_SHA=$(sha256sum <"$API_DIR/listing.tsv" | cut -d' ' -f1)
    FILES_SHA=$(sha256sum <"$API_DIR/files.tsv" | cut -d' ' -f1)
    echo "  command: sha256sum <api>/listing.tsv <api>/files.tsv"
    echo "    $LISTING_SHA  listing.tsv"
    echo "    $FILES_SHA  files.tsv"
    echo "  the files table, tabs shown as |:"
    tr '\t' '|' <"$API_DIR/files.tsv" | sed 's/^/    /'
    echo "  the listing, tabs shown as |:"
    tr '\t' '|' <"$API_DIR/listing.tsv" | sed 's/^/    /'
    
    echo "### each walked file's pub lines by grep beside the listing's rows"
    echo "command: count_matches -E '$PUB_RE' <scratch>/w/api/src/<file>, for every walked file"
    pub_bad=0 nfiles=0 rows_sum=0
    while IFS=$TAB read -r f mod rows atstart reach; do
      [ "$f" = file ] && continue
      case "$rows" in -) continue ;; esac
      nfiles=$((nfiles + 1))
      rows_sum=$((rows_sum + rows))
      ng=$(count_matches -E "$PUB_RE" "$T/src/$f")
      echo "    $f ($mod): grep $ng; rows $rows; rows at line start $atstart; reachable $reach"
      if [ "$ng" != "$atstart" ]; then pub_bad=$((pub_bad + 1)); fi
      if [ "$rows" != "$atstart" ]; then
        echo "      rows whose pub follows other text on its line, which the grep form does not count: $((rows - atstart))"
      fi
    done <"$API_DIR/files.tsv"
    n_rows=$(($(count_lines "$API_DIR/listing.tsv") - 1))
    echo "  walked files: $nfiles; rows by the files table: $rows_sum; rows in the listing: $n_rows; files whose grep count differs from their rows at line start: $pub_bad"
    pub_agree() { [ "$nfiles" -ge 1 ] && [ "$pub_bad" = 0 ]; }
    check "every walked file's pub lines by grep equal the listing's rows at line start" "$(yn pub_agree)"
    rows_agree() { [ "$n_rows" -ge 1 ] && [ "$n_rows" = "$rows_sum" ]; }
    check "the listing's rows are the files table's rows, summed" "$(yn rows_agree)"
    pub_ctl() { local pub_bad=1; pub_agree; }
    check "control: the same check refuses one file differing" "$(ynnot pub_ctl)"
    find "$T/src/crates/emend/src" -type f -name '*.rs' | sed "s#^$T/src/##" | sort >"$T/all-rs"
    awk -F"$TAB" 'NR > 1 && $3 != "-" { print $1 }' "$API_DIR/files.tsv" | sort >"$T/walked"
    awk -F"$TAB" 'NR > 1 && $2 ~ /^cfg\(test\)/ { print $1 }' "$API_DIR/files.tsv" | sort >"$T/skipped"
    # unaccounted <file list>: the .rs files neither walked nor under a skipped
    # cfg(test) module (its file, or a path under its directory).
    unaccounted() {
      awk -v W="$T/walked" -v S="$T/skipped" 'BEGIN { while ((getline l < W) > 0) w[l] = 1; ns = 0; while ((getline l < S) > 0) s[++ns] = l }
        { if ($0 in w) next; ok = 0; for (i = 1; i <= ns; i++) if ($0 == s[i] ".rs" || index($0, s[i] "/") == 1) ok = 1; if (!ok) print }' "$1"
    }
    unaccounted "$T/all-rs" >"$T/unaccounted"
    n_all=$(count_lines "$T/all-rs")
    n_walked=$(count_lines "$T/walked")
    n_skipped=$(count_lines "$T/skipped")
    n_un=$(count_lines "$T/unaccounted")
    echo "  .rs files in the archive: $n_all; walked: $n_walked; cfg(test) modules not walked: $n_skipped; files neither walked nor under one: $n_un"
    sed 's/^/    unaccounted: /' "$T/unaccounted"
    check "every .rs file is walked or lies under a cfg(test) module" "$(yn [ "$n_un" = 0 ])"
    cp "$T/all-rs" "$T/c-all-rs"; printf 'crates/emend/src/extra.rs\n' >>"$T/c-all-rs"
    check "control: the same form finds one planted file neither walked nor under a test module" "$(yn [ "$(unaccounted "$T/c-all-rs" | count_lines /dev/stdin)" = 1 ])"
    echo "  rows by kind:"
    awk -F"$TAB" 'NR > 1 { print $4 }' "$API_DIR/listing.tsv" | sort | uniq -c | sed 's/^/    /'
    echo "  rows by reachable:"
    awk -F"$TAB" 'NR > 1 { r = $8; sub(/ \(.*/, "", r); print r }' "$API_DIR/listing.tsv" | sort | uniq -c | sed 's/^/    /'
    awk -F"$TAB" 'NR > 1 { print $10 }' "$API_DIR/listing.tsv" | sort -u >"$T/added"
    n_added=$(count_lines "$T/added")
    n_dash=$(awk -F"$TAB" 'NR > 1 && $10 == "-"' "$API_DIR/listing.tsv" | count_lines /dev/stdin)
    not_anc=0
    while read -r h; do
      [ "$h" = - ] && continue
      git merge-base --is-ancestor "$h" "$C" 2>/dev/null || not_anc=$((not_anc + 1))
    done <"$T/added"
    echo "  distinct added commits: $n_added; rows with no added commit (-): $n_dash; added commits not ancestors of the phase commit: $not_anc"
    check "every added commit is an ancestor of the phase commit" "$(yn [ "$not_anc" = 0 ])"
    anc_ctl() { git merge-base --is-ancestor 0000000000000000000000000000000000000000 "$C" 2>/dev/null; }
    check "control: the same test refuses the null commit" "$(ynnot anc_ctl)"
    
    by_subj() { git log --format='%H' -n 1 -F --grep="$1" "$C"; }
    P5=$(by_subj "M6 part 5 P3: the CHANGELOG names gradient fills and named styles")
    echo "  M6 part 5 P3's phase commit, its listing's, by its subject: ${P5:-none}"
    echo "### the rows, and the rows that differ from M6 part 5 P3's listing by key without added (specs/0041 ruling L; change ZH)"
    OLD_SHA=$(sha256sum <"$OLD_LISTING" | cut -d' ' -f1)
    REC_OLD_SHA=$(git show "$C:$OLD_RECORD" | LC_ALL=C "$G" -o -E 'listing[.]tsv` sha256 [0-9a-f]{64}' | awk '{ print $3 }')
    n_old=$(($(count_lines "$OLD_LISTING") - 1))
    REC_OLD_ITEMS=$(git show "$C:$OLD_RECORD" | LC_ALL=C "$G" -o -E '^- Items: [0-9]+,' | LC_ALL=C "$G" -o -E '[0-9]+')
    echo "command: sha256sum <home>/.cache/emend-build/m6p5-p3/api/listing.tsv: $OLD_SHA; its rows (lines less the header): $n_old"
    echo "command: git show <phase commit>:$OLD_RECORD | grep -o -E 'listing[.]tsv\` sha256 <64 hex>': ${REC_OLD_SHA:-none}; its \"- Items: <n>,\" line's figure: ${REC_OLD_ITEMS:-none}"
    old_is_m5() { [ -n "$REC_OLD_SHA" ] && [ "$OLD_SHA" = "$REC_OLD_SHA" ]; }
    check "M6 part 5 P3's listing file is the one its record names, by hash (change ZH)" "$(yn old_is_m5)"
    old_ctl() { local OLD_SHA; OLD_SHA=$(printf 'x' | sha256sum | cut -d' ' -f1); old_is_m5; }
    check "control: the same comparison refuses the hash of another file (change ZH)" "$(ynnot old_ctl)"
    old_rows_ok() { [ "$n_old" = 844 ] && [ "${REC_OLD_ITEMS:-none}" = 844 ]; }
    check "M6 part 5 P3's listing holds 844 rows, the figure its record states (change ZH)" "$(yn old_rows_ok)"
    old_rows_ctl() { local n_old=845; old_rows_ok; }
    check "control: the same check refuses 845" "$(ynnot old_rows_ctl)"
    # keys_of <listing.tsv>: one line per row, its key (module, kind, name,
    # container, cfg; columns 1, 4, 5, 6, 7; specs/0041 ruling L: the added
    # column is no part of the key) joined by |, sorted.
    keys_of() { awk -F"$TAB" 'NR > 1 { print $1 "|" $4 "|" $5 "|" $6 "|" $7 }' "$1" | LC_ALL=C sort; }
    keys_of "$OLD_LISTING" >"$T/keys-old"
    keys_of "$API_DIR/listing.tsv" >"$T/keys-new"
    LC_ALL=C comm -23 "$T/keys-old" "$T/keys-new" >"$T/gone.got"
    LC_ALL=C comm -13 "$T/keys-old" "$T/keys-new" >"$T/new.got"
    n_gone=$(count_lines "$T/gone.got")
    n_new=$(count_lines "$T/new.got")
    echo "command: keys (module|kind|name|container|cfg; specs/0041 ruling L) of M6 part 5 P3's listing and of this one, sorted, compared with comm"
    echo "  M6 part 5 P3's rows: $(count_lines "$T/keys-old"); this listing's rows: $(count_lines "$T/keys-new"); M6 part 5 P3's not here: $n_gone; this listing's not in M6 part 5 P3's: $n_new; equal by key: $(LC_ALL=C comm -12 "$T/keys-old" "$T/keys-new" | count_lines /dev/stdin)"
    echo "  M6 part 5 P3's rows not here:"
    sed 's/^/    - /' "$T/gone.got"
    echo "  this listing's rows not in M6 part 5 P3's:"
    sed 's/^/    + /' "$T/new.got"
    check "no row of M6 part 5 P3's listing is gone from this one (specs/0043 item 4: none changed; change ZH)" "$(yn [ "$n_gone" = 0 ])"
    check "no row of this listing is new against M6 part 5 P3's (change ZH)" "$(yn [ "$n_new" = 0 ])"
    { cat "$T/keys-old"; printf '%s\n' 'crate::cells|struct|Planted|-|-'; } | LC_ALL=C sort >"$T/c-keys-old"
    check "control: the same comparison finds one gone row with a key planted in M6 part 5 P3's keys (change ZH)" "$(yn [ "$(LC_ALL=C comm -23 "$T/c-keys-old" "$T/keys-new" | count_lines /dev/stdin)" = 1 ])"
    { cat "$T/keys-new"; printf '%s\n' 'crate::cells|struct|Planted|-|-'; } | LC_ALL=C sort >"$T/c-keys-new"
    check "control: the same comparison finds one new row with a key planted in this listing's keys (change ZH)" "$(yn [ "$(LC_ALL=C comm -13 "$T/keys-old" "$T/c-keys-new" | count_lines /dev/stdin)" = 1 ])"
    echo "  rows in the listing: $n_rows; M6 part 5 P3's $n_old, less $n_gone gone, plus $n_new new: $((n_old - n_gone + n_new))"
    rows_sum_ok() { [ "$n_rows" = "$((n_old - n_gone + n_new))" ] && [ "$n_rows" = 844 ]; }
    check "the listing holds 844 rows, M6 part 5 P3's 844 with none gone and none new (change ZH)" "$(yn rows_sum_ok)"
    rows_sum_ctl() { local n_rows=845; rows_sum_ok; }
    check "control: the same check refuses 845" "$(ynnot rows_sum_ctl)"
    echo "### the crate-private messages: package.rs's part 5 P3's less NO_RELATIONSHIPS_PREFIX (ruling M), none new; styles.rs's unchanged; the gone one in no row; the styles elements unchanged (change ZH)"
    PKG=crates/emend/src/package.rs
    STY=crates/emend/src/styles.rs
    ELE=crates/emend/src/styles/elements.rs
    echo "command: git show <M6 part 5 P3's phase commit>:<file> > <scratch>/w/api/<file's name>-before.rs, for $PKG, $STY and $ELE (the commit by its subject: ${P5:-none})"
    git show "$P5:$PKG" >"$T/package-before.rs"
    pk_rc=$?
    git show "$P5:$STY" >"$T/styles-before.rs"
    st_rc=$?
    git show "$P5:$ELE" >"$T/elements-before.rs"
    el_rc=$?
    echo "  exit $pk_rc, $st_rc and $el_rc; $(count_lines "$T/package-before.rs"), $(count_lines "$T/styles-before.rs") and $(count_lines "$T/elements-before.rs") lines"
    # msgs_of <file>: the crate-private Error constants the file declares at line
    # start, one name per line, sorted. It prints, so its value is compared.
    msgs_of() { awk '(index($0, "const ") == 1 && $3 == "Error") { n = $2; sub(/:$/, "", n); print n } (index($0, "pub(crate) const ") == 1 && $4 == "Error") { n = $3; sub(/:$/, "", n); print n }' "$1" | LC_ALL=C sort; }
    for pair in "package:$T/package-before.rs:$T/src/$PKG" "styles:$T/styles-before.rs:$T/src/$STY"; do
      nm=${pair%%:*}; rest=${pair#*:}; bf=${rest%%:*}; nw=${rest#*:}
      msgs_of "$bf" >"$T/msgs-$nm-before"
      msgs_of "$nw" >"$T/msgs-$nm-now"
      LC_ALL=C comm -13 "$T/msgs-$nm-before" "$T/msgs-$nm-now" >"$T/msgs-$nm-new"
      LC_ALL=C comm -23 "$T/msgs-$nm-before" "$T/msgs-$nm-now" >"$T/msgs-$nm-gone"
      echo "command: msgs_of over $nm.rs at M6 part 5 P3's phase commit and now"
      echo "  then: $(count_lines "$T/msgs-$nm-before"); now: $(count_lines "$T/msgs-$nm-now"); new: $(count_lines "$T/msgs-$nm-new"); gone: $(paste -sd' ' "$T/msgs-$nm-gone")"
    done
    msgs_one_gone() { [ "$pk_rc" = 0 ] && [ "$st_rc" = 0 ] && [ -s "$T/msgs-package-before" ] && [ "$(cat "$T/msgs-package-gone")" = NO_RELATIONSHIPS_PREFIX ] && [ ! -s "$T/msgs-package-new" ] && [ -s "$T/msgs-styles-before" ] && [ ! -s "$T/msgs-styles-new" ] && [ ! -s "$T/msgs-styles-gone" ]; }
    check "the crate-private messages of package.rs are M6 part 5 P3's less NO_RELATIONSHIPS_PREFIX, the one gone, none new; styles.rs's are M6 part 5 P3's, none new and none gone (ruling M; change ZH)" "$(yn msgs_one_gone)"
    { cat "$T/msgs-package-now"; printf '%s\n' PLANTED_NEW; } | LC_ALL=C sort >"$T/c-msgs"
    check "control: the same reading finds one new name with one planted (change ZH)" "$(yn [ "$(LC_ALL=C comm -13 "$T/msgs-package-before" "$T/c-msgs" | count_lines /dev/stdin)" = 1 ])"
    printf '%s\n' 'const PLANTED_A: Error =' 'pub(crate) const PLANTED_B: Error =' 'const PLANTED_C: u8 = 1;' '    const PLANTED_D: Error =' >"$T/c-msgs.rs"
    check "control: msgs_of reads a line-start private and a line-start crate-private Error constant, and neither a u8 one nor an indented one" "$(yn [ "$(msgs_of "$T/c-msgs.rs" | paste -sd' ' -)" = 'PLANTED_A PLANTED_B' ])"
    check "control: msgs_of reads NO_RELATIONSHIPS_PREFIX in package.rs at M6 part 5 P3's phase commit (change ZH)" "$(yn [ "$(count_matches -xF NO_RELATIONSHIPS_PREFIX "$T/msgs-package-before")" = 1 ])"
    # msg_rows <listing.tsv>: the rows named NO_RELATIONSHIPS_PREFIX. It prints,
    # so its value is compared.
    msg_rows() { awk -F"$TAB" 'NR > 1 && $5 == "NO_RELATIONSHIPS_PREFIX"' "$1" | count_lines /dev/stdin; }
    echo "  rows of the listing named NO_RELATIONSHIPS_PREFIX: $(msg_rows "$API_DIR/listing.tsv"); of M6 part 5 P3's: $(msg_rows "$OLD_LISTING")"
    check "NO_RELATIONSHIPS_PREFIX was in no row of M6 part 5 P3's listing and is in none of this one, private (change ZH)" "$(yn [ "$(msg_rows "$API_DIR/listing.tsv"):$(msg_rows "$OLD_LISTING")" = 0:0 ])"
    { cat "$API_DIR/listing.tsv"; printf 'crate::package\tf\t1\tconst\tNO_RELATIONSHIPS_PREFIX\t-\t-\tyes\tyes\t0000000\tx\n'; } >"$T/c-msg-rows.tsv"
    check "control: msg_rows finds a planted row of that name" "$(yn [ "$(msg_rows "$T/c-msg-rows.tsv")" = 1 ])"
    el_same() { [ "$el_rc" = 0 ] && cmp -s "$T/elements-before.rs" "$T/src/$ELE"; }
    echo "command: cmp <scratch>/w/api/elements-before.rs <scratch>/w/api/src/$ELE"
    check "the styles elements file is M6 part 5 P3's byte for byte, so no row lost Eq (change ZH)" "$(yn el_same)"
    printf 'x\n' >"$T/c-elements.rs"
    el_ctl() { cmp -s "$T/c-elements.rs" "$T/src/$ELE"; }
    check "control: the same comparison refuses a planted file (change ZH)" "$(ynnot el_ctl)"
    : >"$T/eq.got"
    : >"$T/widened-for-fmt"
    : >"$T/dated.got"
    echo "  the rows marked, for the formatter: lost Eq $(count_lines "$T/eq.got"); cfg-widened $(count_lines "$T/widened-for-fmt"); dated otherwise by the diff $(count_lines "$T/dated.got")"
    check "no row that lost Eq, none cfg-widened and none dated otherwise go to the formatter (change ZH)" "$(yn [ "$(count_lines "$T/eq.got"):$(count_lines "$T/widened-for-fmt"):$(count_lines "$T/dated.got")" = 0:0:0 ])"
    
    echo
    echo "## T2: the doc build with every feature and no warning, and the documented items it indexes (M6 part 4 P3's form; change YM)"
    echo "command: RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR=<target>/main cargo doc --offline -p emend --no-deps --all-features"
    RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR=$CT cargo doc --offline -p emend --no-deps --all-features >"$T/doc.out" 2>&1 </dev/null
    doc_rc=$?
    echo "  exit: $doc_rc; its output:"
    sed 's/^/    /' "$T/doc.out"
    check "the doc build exits 0" "$(yn [ "$doc_rc" = 0 ])"
    WARN_RE='^(warning|error)'
    nwarn=$(count_matches -E "$WARN_RE" "$T/doc.out")
    check "no warning or error line in its output: $nwarn" "$(yn [ "$nwarn" = 0 ])"
    printf 'warning: x\n   Finished\nerror: y\n' >"$T/c-doc"
    check "control: the same form counts two such lines in a fixture" "$(yn [ "$(count_matches -E "$WARN_RE" "$T/c-doc")" = 2 ])"
    ALL_HTML=$CT/doc/emend/all.html
    ITEM_RE='<li><a href="[^"]+"'
    # item_links <html>: one line per item link of a rustdoc all-items page.
    item_links() { LC_ALL=C "$G" -o -E "$ITEM_RE" "$1"; }
    item_links "$ALL_HTML" >"$T/all-items" 2>/dev/null
    n_links=$(count_lines "$T/all-items")
    n_anchors=$(count_matches -E '^<li><a href="#' "$T/all-items")
    n_documented=$((n_links - n_anchors))
    echo "command: grep -o -E '$ITEM_RE' <target>/main/doc/emend/all.html | count_lines; of them, the links to a section anchor (href starting #)"
    echo "  link lines in the index: $n_links; section anchors among them: $n_anchors; documented module-level items: $n_documented; by kind (the link's last path segment up to its first dot):"
    sed -E 's#^<li><a href="([^"]*/)?([A-Za-z_]+)[.].*#\2#' "$T/all-items" | sort | uniq -c | sed 's/^/    /'
    check "the index lists at least one documented item" "$(yn [ "$n_documented" -ge 1 ])"
    printf '<h3>Structs</h3><ul class="all-items"><li><a href="#structs">S</a></li><li><a href="a/struct.A.html">a::A</a></li><li><a href="struct.B.html">B</a></li></ul><h3>Functions</h3><ul class="all-items"><li><a href="fn.f.html">f</a></li></ul>\n' >"$T/c-all.html"
    item_links "$T/c-all.html" >"$T/c-all-items"
    check "control: the same form finds four links, one of them an anchor, on one line of a fixture page" "$(yn [ "$(count_lines "$T/c-all-items"):$(count_matches -E '^<li><a href="#' "$T/c-all-items")" = 4:1 ])"
    n_top=$(awk -F"$TAB" 'NR > 1 && $8 ~ /^yes/ && ($4 == "struct" || $4 == "enum" || $4 == "fn" || $4 == "const" || $4 == "type" || $4 == "trait" || $4 == "static")' "$API_DIR/listing.tsv" | count_lines /dev/stdin)
    echo "  the listing's reachable module-level types, functions, constants, statics and aliases: $n_top"
    check "the documented module-level items equal the listing's reachable module-level items" "$(yn [ "$n_documented" = "$n_top" ])"
    top_ctl() { local n_top=$((n_top + 1)); [ "$n_documented" = "$n_top" ]; }
    check "control: the same comparison refuses one item more" "$(ynnot top_ctl)"
    
    echo
    echo "## R2: the API record, written by the formatter and installed (specs/0043 \"The engineering close\" item 4; changes YM, YO and ZI)"
    FMT_SHA=$(sha256sum <"$FORMATTER" | cut -d' ' -f1)
    echo "command: sed 's/^/    /' <scripts>/make_review.py; sha256sum: $FMT_SHA; $(wc -c <"$FORMATTER") bytes"
    sed 's/^/    /' "$FORMATTER"
    fmt_there() { [ -s "$FORMATTER" ]; }
    check "the formatter is there and not empty" "$(yn fmt_there)"
    check "control: the same check refuses a file that is not there" "$(ynnot [ -s "$SELF_DIR/no-such-formatter.py" ])"
    REC_DATE=$(date -u +%F)
    REC_NAME=api-review-m6p6-$REC_DATE-$SHORT_SHA.md
    STAGED=$T/$REC_NAME
    echo "command: python3 -I -B <scripts>/make_review.py <api>/listing.tsv <home>/.cache/emend-build/m6p5-p3/api/listing.tsv <scratch>/w/api/$REC_NAME $REC_DATE $SHORT_SHA <listing sha256> <files sha256> <formatter sha256> $n_links $n_anchors $n_documented $n_top <scratch>/w/api/widened-for-fmt <scratch>/w/api/eq.got <scratch>/w/api/dated.got <the program's sha256>"
    python3 -I -B "$FORMATTER" "$API_DIR/listing.tsv" "$OLD_LISTING" "$STAGED" "$REC_DATE" "$SHORT_SHA" "$LISTING_SHA" "$FILES_SHA" "$FMT_SHA" "$n_links" "$n_anchors" "$n_documented" "$n_top" "$T/widened-for-fmt" "$T/eq.got" "$T/dated.got" "$NEW_PROG_SHA" >"$T/fmt.out" 2>"$T/fmt.err"
    fmt_rc=$?
    echo "  exit: $fmt_rc; standard error $(wc -c <"$T/fmt.err") bytes; its standard output:"
    sed 's/^/    /' "$T/fmt.out"
    FMT_WANT="rows 844; {'keep': 844}; differing from M6 part 5 P3: 0 gone, 0 new; cfg-widened 0; dated otherwise by the diff 0; Eq dropped 0"
    fmt_ok() { [ "$fmt_rc" = 0 ] && [ ! -s "$T/fmt.err" ] && [ "$(cat "$T/fmt.out")" = "$FMT_WANT" ] && [ -s "$STAGED" ]; }
    check "the formatter exits 0, prints \"$FMT_WANT\" alone and writes its file" "$(yn fmt_ok)"
    fmt_ctl() { local FMT_WANT="rows 844; {'keep': 844}; differing from M6 part 4 P3: 3 gone, 13 new; cfg-widened 1; dated otherwise by the diff 3; Eq dropped 0"; fmt_ok; }
    check "control: the same check refuses M6 part 5 P3's line (change ZI)" "$(ynnot fmt_ctl)"
    n_nonascii=$(LC_ALL=C tr -cd '\200-\377' <"$STAGED" | wc -c)
    echo "  the staged record: $(wc -c <"$STAGED") bytes, sha256 $(sha256sum <"$STAGED" | cut -d' ' -f1); non-ASCII bytes in it: $n_nonascii"
    check "the staged record is ASCII" "$(yn [ "$n_nonascii" = 0 ])"
    REC_DEST=$RECORDS_DEST/$REC_NAME
    rec_absent() { [ ! -e "$REC_DEST" ]; }
    echo "command: cp <scratch>/w/api/$REC_NAME <the records' destination>/$REC_NAME, refused if that name is there (the destination: $RECORDS_DEST)"
    if rec_absent; then
      cp "$STAGED" "$REC_DEST"
      inst_rc=$?
      echo "  installed: exit $inst_rc"
      check "the record's name was not there before this run" yes
    else
      inst_rc=refused
      echo "  refused: $REC_NAME is already there"
      check "the record's name was not there before this run" no
    fi
    installed_ok() { [ "$inst_rc" = 0 ] && cmp -s "$STAGED" "$REC_DEST"; }
    check "the installed record is the staged one, byte for byte" "$(yn installed_ok)"
    echo "  the installed record: $RECORDS_DEST/$REC_NAME, sha256 $(sha256sum <"$REC_DEST" 2>/dev/null | cut -d' ' -f1), $(wc -c <"$REC_DEST" 2>/dev/null) bytes"
    check "control: the absence check refuses the staged file, which is there" "$(ynnot [ ! -e "$STAGED" ])"
    
    
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.out; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    st_own=$(run_matches -E "$OWN" git status --porcelain)
    st_plan=$(run_matches -E "$PLAN_LINE" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or its API record: $st_own; planning's working spec, admitted at PLANNING_SPEC: $st_plan; the two read by the accounted pattern: $st_ours (changes WW, XM, XW, YA and YI)"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's logs, the API record this log installed or, when admitted, planning's working spec (changes UR, UY, VJ, WE, WS, WW, XD, XM, YA and YI)" "$(yn status_accounted)"
    own_sum() { [ "$st_own" != error ] && [ "$st_plan" != error ] && [ "$st_ours" = "$((st_own + st_plan))" ]; }
    check "the accounted lines are the own lines and the plan line, summed (change WW)" "$(yn own_sum)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/test.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "test log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

