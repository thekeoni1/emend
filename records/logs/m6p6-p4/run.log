    WANT_M6_SAMPLES=6
    FEATURES_ORDER="dates rowcol metadata rules tables comments images richtext sheetprops read copy charts"
    mkdir -p "$BUILD_ROOT" || exit 2
    B=$(mktemp -d -p "$BUILD_ROOT") || exit 2
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT_SHA=${C:0:7}
    # This phase's logs and planning's uncommitted spec (changes RRA and RRP).
    OURS='^((\?\?| ?[MARCD]) records/logs/m6p6-p4/| M specs/0043-measurement-and-close[.]md$)'
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs and planning's spec" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$B#<scratch>/w#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$SUPERSEDED_DIR#<superseded>#g" \
        -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    # The environment and path inputs, each on its labelled line.
    echo "input: RERUN_NOTE: ${RERUN_NOTE:-unset}"
    echo "input: RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: HOME: set, read for the paths under it, printed as <home>"
    echo "input: RUN_BUILD: ${RUN_BUILD:-unset} (the build root, <build>)"
    echo "input: PLANNING_SPEC: ${PLANNING_SPEC:-unset} (planning's uncommitted spec's sha256, checked when given; when unset, the working file must be the phase commit's; specs/0037 ruling AF's form, change RRP)"
    echo "about: M6 part 6 P4 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Rulings Z and AD (change RRB): the defined-helper check over this script's
    # own source, and its two planted controls. The planted calls are built from
    # pieces, so this text holds no call of an undefined name.
    echo "command: python3 -I -B <scripts>/defined_check.py <this script> (sha256 of the program $(sha256sum <"$DEFCHECK" | cut -d' ' -f1)), and the same over a copy of this script with one planted call of an undefined helper, and over a planted script that calls yn and defines neither yn nor ynnot (rulings Z and AD)"
    python3 -I -B "$DEFCHECK" "$SELF" >"$B/def-self.out" 2>"$B/def-self.err" </dev/null
    def_rc=$?
    sed 's/^/    /' "$B/def-self.out"
    def_self_ok() { [ "$def_rc" = 0 ] && [ ! -s "$B/def-self.err" ] && [ "$(count_matches -F 'undefined: none; yn defined: yes; ynnot defined: yes' "$B/def-self.out")" = 1 ]; }
    check "every helper a yn or ynnot call of this script names is defined in it, and yn and ynnot are themselves defined (rulings Z and AD)" "$(yn def_self_ok)"
    { cat "$SELF"; printf '%s\n' "zz=\$""(yn zz_planted_undefined_helper)"; } >"$B/def-plant.sh"
    python3 -I -B "$DEFCHECK" "$B/def-plant.sh" >"$B/def-plant.out" 2>"$B/def-plant.err" </dev/null
    def_prc=$?
    echo "  over the planted copy: exit $def_prc; $(cat "$B/def-plant.out")"
    def_plant_ok() { [ "$def_prc" = 1 ] && [ "$(count_matches -F 'undefined: zz_planted_undefined_helper;' "$B/def-plant.out")" = 1 ]; }
    check "control: the same check names the one planted undefined helper in a copy of this script (ruling Z)" "$(yn def_plant_ok)"
    printf '%s\n' 'f() { :; }' "x=\$""(yn f)" >"$B/def-noyn.sh"
    python3 -I -B "$DEFCHECK" "$B/def-noyn.sh" >"$B/def-noyn.out" 2>"$B/def-noyn.err" </dev/null
    def_nrc=$?
    echo "  over a planted script defining f and calling yn f: exit $def_nrc; $(cat "$B/def-noyn.out")"
    def_noyn_ok() { [ "$def_nrc" = 1 ] && [ "$(count_matches -F '; yn defined: no;' "$B/def-noyn.out")" = 1 ]; }
    check "control: the same check refuses a planted script that calls yn and defines neither yn nor ynnot (ruling AD)" "$(yn def_noyn_ok)"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    # Change RRP: the roles are M6 part 6 P4's: the base (P3's record commit),
    # the doc commit, the test commit (specs/0043 ruling R, F7) and the README
    # commit, the phase commit, each by its full subject and each the next
    # one's parent.
    REC=$(by_subject 'M6 part 6 P3 record: the logs, the records, the check, the scan')
    DOC1=$(by_subject 'M6 part 6 P4: commit planning docs (the P3 verification and rulings)')
    CODE1=$(by_subject 'M6 part 6 P4: a strict workbook root binding no relationships prefix takes an add')
    CODE2=$(by_subject 'M6 part 6 P4: the README brought to Milestone 6')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  M6 part 6 P3's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC1:-none}"
    echo "  the test commit (specs/0043 ruling R, finding F7): ${CODE1:-none}"
    echo "  the README commit (the phase commit): ${CODE2:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~3"
    for k in 0 1 2 3; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$CODE2" "$CODE1" "$DOC1" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the README commit, the test commit, the doc commit and the base, each the next one's parent, the README commit the phase commit (change RRP)" "$(yn roles_in_order)"
    pinned_ok() { [ "$REC" = 42cf079ed3c3fd2380f48cfe8c152f10130a2945 ] && [ "$DOC1" = 92c6b38756adfed78c5d1b03a60427e4761f40bd ] && [ "$CODE1" = bb0a29ef2ee3539ec9d457739222b577a759ce21 ] && [ "$CODE2" = 37062b7bd644e176ecc451ce3b63f73834ac9eb7 ]; }
    check "each role is the full sha <phase>/FACTS.md names for it (change RRP)" "$(yn pinned_ok)"
    pinned_ctl() { local CODE2=$CODE1; pinned_ok; }
    check "control: the same comparison refuses the test commit named as the phase commit" "$(ynnot pinned_ctl)"
    echo "command: git diff --name-only <doc commit> <test commit>; git diff --name-only <test commit> <phase commit>"
    git diff --name-only "$DOC1" "$CODE1" | sed 's/^/    /'
    git diff --name-only "$CODE1" "$C" | sed 's/^/    /'
    each_alone() { [ "$(git diff --name-only "$DOC1" "$CODE1")" = crates/emend/src/package/tests.rs ] && [ "$(git diff --name-only "$CODE1" "$C")" = README.md ]; }
    check "the test commit changes crates/emend/src/package/tests.rs alone and the README commit README.md alone (change RRP)" "$(yn each_alone)"
    echo "command: git diff --name-only <doc commit> <phase commit>"
    git diff --name-only "$DOC1" "$C" | sed 's/^/    /'
    phase_files() { [ "$(git diff --name-only "$DOC1" "$C" | tr '\n' ' ')" = "README.md crates/emend/src/package/tests.rs " ]; }
    check "after the doc commit the phase changes README.md and crates/emend/src/package/tests.rs alone (change RRP)" "$(yn phase_files)"
    phase_files_ctl() { [ "$(git diff --name-only "$REC" "$C" | tr '\n' ' ')" = "README.md crates/emend/src/package/tests.rs " ]; }
    check "control: the same comparison refuses the base to the phase commit, which holds the doc commit's two files too" "$(ynnot phase_files_ctl)"
    roles_ctl() { local CODE2=$CODE1; roles_in_order; }
    check "control: roles_in_order refuses the test commit named as the phase commit" "$(ynnot roles_ctl)"
    echo
    echo "phase: Milestone 6 part 6 P4 ($SPEC) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # Ruling AA (change RRC): every attempt refused at entry, or superseded, is
    # named by RERUN_NOTE and each of its files hashed here.
    n_rerun_files=0
    n_rerun_missing=0
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in (ruling AA)"
      for sf in ${RERUN_FILES:-}; do
        n_rerun_files=$((n_rerun_files + 1))
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          n_rerun_missing=$((n_rerun_missing + 1))
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
      rerun_hashed() { [ "$n_rerun_files" -gt 0 ] && [ "$n_rerun_missing" = 0 ]; }
      check "every file of the attempt RERUN_NOTE names is hashed above, and RERUN_FILES names at least one (ruling AA)" "$(yn rerun_hashed)"
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this log builds nothing, runs no binary and reads no corpus: it reads the phase commit's README.md and the records it cites (change FB)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed first); scripts/counting.sh, README.md, crates/emend/Cargo.toml, the cited records and $SPEC are read from it by git show at the phase commit, and the working spec is hashed in it; nothing in it is run or built"
    echo "root: <home> stands for the home directory of the account that ran this script; <home>/.config/emend/private-denylist.txt, the private denylist, is read for counts and never printed (change FE)"
    echo "root: <scripts> stands for <home>/.cache/emend-build/m6p6-p4/scripts, this script's own directory on the disk, which holds the script, the README check program readme_check.py, the defined-helper check program defined_check.py and, in <scripts>/out, its own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <build> stands for the build root on the disk, <home>/.cache/emend-build/m6p6-p4/run unless RUN_BUILD names another; nothing is built there"
    echo "root: <superseded> stands for <home>/.cache/emend-build/m6p6-p4/superseded, where a rerun's superseded files are kept; read only"
    echo "root: <phase> stands for <home>/.cache/emend-build/m6p6-p4, this phase's directory, as a rerun note names it; read only (change RRO)"
    echo "root: <scratch>/w stands for this run's mktemp -d working directory under <build>, kept on the disk after the run: <scratch>/w/counting.sh the phase commit's library, sourced; the README, the records, the manifest and the controls' copies beside it"
    echo "root: <corpus> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change FF)"
    echo "root: <runs> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change FF)"
    echo "root: <target> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change FF)"
    echo "root: <work> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change FF)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() { apart "$BUILD_ROOT" "$MAIN" && apart "$BUILD_ROOT" "$SELF_DIR" && apart "$MAIN" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$SELF_DIR" && apart "$SUPERSEDED_DIR" "$BUILD_ROOT" && apart "$SUPERSEDED_DIR" "$MAIN"; }
    check "the roots other than <home> are distinct, none inside another (<scratch>/w inside <build>)" "$(yn roots_distinct)"
    roots_ctl() { apart "$B" "$BUILD_ROOT"; }
    check "control: apart refuses <scratch>/w against <build>, which holds it" "$(ynnot roots_ctl)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them this phase's logs or planning's spec $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT_SHA"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT_SHA")"
    short_names_head() { [ "$(git rev-parse "$SHORT_SHA")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_readme_ctl() { printf ' M README.md\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified README.md" "$(ynnot ours_readme_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m6p6-p4/run.log\n?? records/logs/m6p6-p3/run.log\n?? records/m6p6-p4-x-2026-01-01-abcdef0.md\n?? records/logs/m6p6-p4x/run.log\n M ROADMAP.md\n M specs/0043-measurement-and-close.md\n M specs/0042-gradient-fills-and-named-styles.md\n?? specs/0043-measurement-and-close.md\n' | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern takes this phase's log and planning's modified spec alone, no other phase's log, no record, no sibling directory, no ROADMAP.md, no other spec and no untracked spec (changes RRA and RRP)" "$(yn [ "$(ours_rec_ctl)" = 2 ])"
    SPEC_HAVE=$(sha256sum <"$SPEC" | cut -d' ' -f1)
    SPEC_BLOB=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum: $SPEC_BLOB; sha256sum $SPEC (the working file, printed; checked against PLANNING_SPEC when it is given, and against the phase commit's blob when it is not; changes RRA and RRP): $SPEC_HAVE"
    check "the spec's blob at the phase commit is at the hash this log pins" "$(yn [ "$SPEC_BLOB" = "$SPEC_WANT" ])"
    spec_ctl() { [ "$(printf 'x' | sha256sum | cut -d' ' -f1)" = "$SPEC_WANT" ]; }
    check "control: the same comparison refuses the hash of another file" "$(ynnot spec_ctl)"
    planning_spec_ok() { [ "$SPEC_HAVE" = "$PLANNING_SPEC" ]; }
    planning_spec_ctl() { [ "$SPEC_BLOB" = "$PLANNING_SPEC" ]; }
    if [ -n "${PLANNING_SPEC:-}" ]; then
      check "the working spec is at PLANNING_SPEC, planning's uncommitted copy (specs/0037 ruling AF's form)" "$(yn planning_spec_ok)"
      check "control: the same comparison refuses the phase commit's blob against PLANNING_SPEC" "$(ynnot planning_spec_ctl)"
    else
      # Change RRP: with no rulings uncommitted, the working file is the
      # phase commit's.
      working_is_blob() { [ "$SPEC_HAVE" = "$SPEC_BLOB" ]; }
      check "PLANNING_SPEC is not set, and the working spec is the phase commit's blob (change RRP)" "$(yn working_is_blob)"
      working_is_blob_ctl() { local SPEC_HAVE=$SPEC_WANT$SPEC_WANT; working_is_blob; }
      check "control: the same comparison refuses another hash as the working file's" "$(ynnot working_is_blob_ctl)"
    fi
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## the README check program (changes FC and RRM)"
    echo "command: sha256sum <scripts>/readme_check.py: $(sha256sum <"$CHECKER" | cut -d' ' -f1)"
    sed 's/^/    /' "$CHECKER"
    echo
    echo "## the defined-helper check program (rulings Z and AD; change RRB)"
    echo "command: sha256sum <scripts>/defined_check.py: $(sha256sum <"$DEFCHECK" | cut -d' ' -f1)"
    sed 's/^/    /' "$DEFCHECK"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the files read at the phase commit (change FB)"
    echo "command: git show <phase commit>:<path> > <scratch>/w/<name>, for README.md, crates/emend/Cargo.toml and each cited record; git ls-tree -r --name-only <phase commit> > <scratch>/w/tree.txt"
    git show "$C:README.md" >"$B/README.md"
    git show "$C:crates/emend/Cargo.toml" >"$B/Cargo.toml"
    git ls-tree -r --name-only "$C" >"$B/tree.txt"
    n_read=0
    for r in $SAMPLE_RECS $OPEN_REC $SCALE_REC $SIZE_REC $M5_RECS $M6_RECS $CMP_REC; do
      git show "$C:$r" >"$B/$(basename "$r")" && n_read=$((n_read + 1))
      echo "  $r: $(wc -c <"$B/$(basename "$r")") bytes, sha256 $(sha256sum <"$B/$(basename "$r")" | cut -d' ' -f1)"
    done
    echo "  README.md: $(wc -l <"$B/README.md") lines, sha256 $(sha256sum <"$B/README.md" | cut -d' ' -f1); crates/emend/Cargo.toml: sha256 $(sha256sum <"$B/Cargo.toml" | cut -d' ' -f1); the tree listing: $(count_lines "$B/tree.txt") paths"
    check "the nineteen records the figures are read from were read at the phase commit: four M3 part 6 samples, the open and scale records, the closing size record, five Milestone 5 and six Milestone 6 samples, the comparison record (changes RRD, RRN, RRQ and RRS)" "$(yn [ "$n_read" = 19 ])"
    readme_read() { test -s "$B/README.md" && test -s "$B/Cargo.toml"; }
    check "README.md and the manifest were read and are not empty" "$(yn readme_read)"
    R=$B/README.md
    
    echo
    echo "## 1. the README check: every sentence holding a digit cites a records/ path the tree holds, every figure row and number, the features, the dash, absolute paths and the two comparatives (changes FC and RRM)"
    echo "command: grep -o -E 'records/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]' <scratch>/w/README.md | sort -u; each path the tree holds copied by git show <phase commit>:<path> into <scratch>/w/root/<path>, and the manifest into <scratch>/w/root/crates/emend/Cargo.toml"
    mkdir -p "$B/root/crates/emend" || exit 2
    cp "$B/Cargo.toml" "$B/root/crates/emend/Cargo.toml"
    LC_ALL=C "$G" -o -E 'records/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]' "$R" | LC_ALL=C sort -u >"$B/cited.txt"
    n_cited=$(count_lines "$B/cited.txt")
    n_root=0
    while IFS= read -r p; do
      if [ "$(count_matches -xF "$p" "$B/tree.txt")" = 1 ]; then
        mkdir -p "$B/root/$(dirname "$p")"
        git show "$C:$p" >"$B/root/$p" && n_root=$((n_root + 1))
      fi
    done <"$B/cited.txt"
    echo "  paths the README cites: $n_cited; copied into the root: $n_root"
    sed 's/^/    /' "$B/cited.txt"
    check "every records/ path the README cites is in the phase commit's tree and was copied into the root" "$(yn [ "$n_root" = "$n_cited" ])"
    echo "command: python3 -I -B <scripts>/readme_check.py <scratch>/w/README.md <scratch>/w/tree.txt <scratch>/w/root"
    python3 -I -B "$CHECKER" "$R" "$B/tree.txt" "$B/root" >"$B/rc.out" 2>"$B/rc.err" </dev/null
    rc=$?
    echo "  exit: $rc; standard error $(wc -c <"$B/rc.err") bytes; standard output:"
    sed 's/^/    /' "$B/rc.out"
    summary_is() { tail -n 1 "$1" | LC_ALL=C "$G" -qE "^sentences [0-9]+ with-digit [0-9]+ cited [0-9]+ $2 figures-checked [0-9]+\$"; }
    CLEAN='uncited 0 missing 0 figure 0 number 0 feature 0 dash 0 abspath 0 word 0'
    rc_ok() { [ "$rc" = 0 ] && summary_is "$B/rc.out" "$CLEAN" && [ ! -s "$B/rc.err" ]; }
    check "the README check passes: every sentence holding a digit cites a records/ path the tree holds, every figure row is in the README, every number is a figure a row reads, the features are the manifest's, and no dash, absolute path or comparative: exit 0, $CLEAN" "$(yn rc_ok)"
    with_digit=$(tail -n 1 "$B/rc.out" | awk '{print $4}')
    cited=$(tail -n 1 "$B/rc.out" | awk '{print $6}')
    echo "  sentences holding a digit: $with_digit; cited: $cited"
    all_cited() { [ -n "$with_digit" ] && [ "$with_digit" -gt 0 ] && [ "$with_digit" = "$cited" ]; }
    check "the sentences holding a digit are more than none and all cited" "$(yn all_cited)"
    cp "$R" "$B/planted.md"
    printf '\nPlanted: the sample ran 99 times over the corpus.\n' >>"$B/planted.md"
    echo "command (control): the same over a copy with the paragraph \"Planted: the sample ran 99 times over the corpus.\" appended after a blank line"
    python3 -I -B "$CHECKER" "$B/planted.md" "$B/tree.txt" "$B/root" >"$B/rcp.out" 2>"$B/rcp.err" </dev/null
    rcp=$?
    echo "  exit: $rcp; the summary: $(tail -n 1 "$B/rcp.out")"
    rcp_ok() { [ "$rcp" = 1 ] && summary_is "$B/rcp.out" 'uncited 1 missing 0 figure 0 number 0 feature 0 dash 0 abspath 0 word 0'; }
    check "control: the same check refuses the planted uncited sentence" "$(yn rcp_ok)"
    
    echo
    echo "## 2. every figure, read from the record it cites by a printed command (change FD)"
    # md_cell <file> <heading prefix> <exact|prefix|first|all> <row label> <column name>:
    # in the section opened by the first line starting with the heading (up to
    # the next "## " heading), the table whose header row holds a cell named
    # <column name>; prints that column's cell of each data row whose first cell
    # equals the label (exact), starts with it (prefix), of the first data row
    # (first) or of every data row (all). A line outside a table ends it.
    md_cell() {
      awk -F'|' -v h="$2" -v mode="$3" -v lab="$4" -v col="$5" '
        index($0, h) == 1 { s = 1; ci = 0; next }
        s && /^## / { s = 0 }
        s && !/^[|]/ { ci = 0; next }
        s && /^[|]/ {
          if (!ci) { for (i = 2; i < NF; i++) { c = $i; gsub(/^ +| +$/, "", c); if (c == col) ci = i }; next }
          c1 = $2; gsub(/^ +| +$/, "", c1)
          if (c1 ~ /^-+$/) next
          v = $ci; gsub(/^ +| +$/, "", v)
          if (mode == "exact" && c1 == lab) print v
          else if (mode == "prefix" && index(c1, lab) == 1) print v
          else if (mode == "first" && !done) { print v; done = 1 }
          else if (mode == "all") print v
        }' "$1"
    }
    printf '## T\n\n| name | a | b |\n| --- | --- | --- |\n| x | 1 | 2 |\n| xy | 3 | 4 |\n\n| side | c |\n| --- | --- |\n| x | 9 |\n' >"$B/md-fixture"
    echo "command (control): md_cell over a fixture of two tables: exact x b, prefix x a, first - b, all - a"
    md_ctl() { [ "$(md_cell "$B/md-fixture" '## T' exact x b)" = 2 ] && [ "$(md_cell "$B/md-fixture" '## T' prefix x a | tr '\n' ' ')" = "1 3 " ] && [ "$(md_cell "$B/md-fixture" '## T' first '' b)" = 2 ] && [ "$(md_cell "$B/md-fixture" '## T' all '' a | tr '\n' ' ')" = "1 3 " ]; }
    check "control: md_cell reads the fixture's cells by row and column, and the second table, whose header names neither column, is not read" "$(yn md_ctl)"
    num() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9]+([.][0-9]+)?$'; }
    num_pair() { num "$1" && num "$2"; }
    # joined <file>: the file's text with its line ends as spaces, for a
    # sentence the record wraps.
    joined() { tr '\n' ' ' <"$1"; }
    # in_readme_once <text>: the README holds the text exactly once.
    in_readme_once() { [ "$(LC_ALL=C "$G" -o -F -e "$1" "$R" | wc -l)" = 1 ]; }
    # readme_holds <label> <fragment> <fragment with a value changed>.
    readme_holds() {
      echo "    README fragment: $2"
      check "$1: the README holds the fragment once" "$(yn in_readme_once "$2")"
      check "control: $1: the same check refuses the fragment with a value changed" "$(ynnot in_readme_once "$3")"
    }
    FIGS=()
    echo "### the size record, $SIZE_REC, for every feature's cost and the size sentence (changes RRE, RRN and RRR)"
    SZ=$B/$(basename "$SIZE_REC")
    for f in $FEATURES_ORDER; do
      FREC=$SIZE_REC
      v=$(md_cell "$B/$(basename "$FREC")" '## The figures' prefix "the \`$f\` feature's cost," Sections)
      echo "  command: md_cell $FREC '## The figures' prefix 'the \`$f\` feature's cost,' Sections -> $v"
      check "the \`$f\` feature's cost is one number" "$(yn num "$v")"
      FIGS+=("$v")
      LC_ALL=C "$G" -E "^- \`$f\`, " "$R" >"$B/feat-$f"
      n_line=$(count_lines "$B/feat-$f")
      n_val=$(count_matches -F ": $v " "$B/feat-$f")
      n_rec=$(count_matches -F "(\`$FREC\`)" "$B/feat-$f")
      n_bad=$(count_matches -F ": $((v + 1)) " "$B/feat-$f")
      echo "    README lines starting \"- \`$f\`, \": $n_line; of them holding \": $v \": $n_val, citing $FREC: $n_rec; holding the value plus one: $n_bad"
      feat_ok() { [ "$n_line" = 1 ] && [ "$n_val" = 1 ] && [ "$n_rec" = 1 ]; }
      check "the README's \`$f\` line gives the record's cost, $v, and cites $FREC" "$(yn feat_ok)"
      check "control: the same count finds no \`$f\` line with the value plus one" "$(yn [ "$n_bad" = 0 ])"
    done
    BUDGET=$(md_cell "$SZ" '## The figures' prefix 'the budget,' Sections)
    echo "  command: md_cell <record> '## The figures' prefix 'the budget,' Sections -> $BUDGET"
    SENT=$(joined "$SZ" | LC_ALL=C "$G" -o -E 'The budget figure is [0-9]+ section bytes, [0-9]+ under the ceiling[.]')
    echo "  command: tr '\\n' ' ' <record> | grep -o -E 'The budget figure is [0-9]+ section bytes, [0-9]+ under the ceiling[.]' -> $SENT"
    BUDGET2=$(printf '%s' "$SENT" | awk '{print $5}')
    HEADROOM=$(printf '%s' "$SENT" | awk '{print $8}')
    CSENT=$(joined "$SZ" | LC_ALL=C "$G" -o -E 'The ceiling is [0-9]+ section bytes')
    CEIL=$(printf '%s' "$CSENT" | awk '{print $4}')
    echo "  command: tr '\\n' ' ' <record> | grep -o -E 'The ceiling is [0-9]+ section bytes' -> $CSENT"
    echo "  the budget $BUDGET (table) and $BUDGET2 (sentence); the headroom $HEADROOM; the ceiling $CEIL"
    size_nums() { num "$BUDGET" && num "$HEADROOM" && num "$CEIL" && [ "$BUDGET" = "$BUDGET2" ]; }
    check "the budget, the headroom and the ceiling are numbers, the budget the same in the table and the sentence" "$(yn size_nums)"
    check "the headroom is the ceiling less the budget" "$(yn [ "$HEADROOM" = "$((CEIL - BUDGET))" ])"
    FIGS+=("$BUDGET" "$HEADROOM" "$CEIL")
    readme_holds "the size sentence" "is $BUDGET section bytes, $HEADROOM under the ceiling of $CEIL (\`$SIZE_REC\`)" "is $((BUDGET + 1)) section bytes, $HEADROOM under the ceiling of $CEIL (\`$SIZE_REC\`)"
    
    echo "### part 6 P4's four sample records, \"Files by outcome\", the host row (ruling 1)"
    for r in $SAMPLE_RECS; do
      RF=$B/$(basename "$r")
      vf=$(md_cell "$RF" '## Files by outcome' exact host files)
      vo=$(md_cell "$RF" '## Files by outcome' exact host ok)
      vl=$(md_cell "$RF" '## Files by outcome' exact host 'lo ok')
      vi=$(md_cell "$RF" '## Files by outcome' exact host 'lo_in ok')
      echo "  command: md_cell <record> '## Files by outcome' exact host <files|ok|lo ok|lo_in ok>, over $r -> files $vf, ok $vo, lo ok $vl, lo_in ok $vi"
      host_row_ok() { [ "$vf" = "$WANT_FILES" ] && [ "$vo" = "$WANT_OK" ] && [ "$vl" = "$WANT_LO_OK" ] && [ "$vi" = "$WANT_LO_IN_OK" ]; }
      check "$(basename "$r"): the host row reads files $WANT_FILES, ok $WANT_OK, lo ok $WANT_LO_OK, lo_in ok $WANT_LO_IN_OK (ruling 1)" "$(yn host_row_ok)"
      host_row_ctl() { local WANT_OK=$((WANT_OK - 1)); host_row_ok; }
      check "control: the same check refuses an expected ok one less" "$(ynnot host_row_ctl)"
      case "$r" in "$COPY_REC") CF=$vf; CO=$vo; CL=$vl; CI=$vi ;; esac
    done
    FIGS+=("$CF")
    FID="ran over the $CF workbooks of the private test corpus, and on the host all $CO outputs were written and opened in LibreOffice, as were all $CI inputs ("
    check "the copy record's ok and lo ok are one figure, as the README's one word for both says" "$(yn [ "$CO" = "$CL" ])"
    readme_holds "the fidelity sentence" "$FID" "ran over the $CF workbooks of the private test corpus, and on the host all $((CO + 1)) outputs were written and opened in LibreOffice, as were all $CI inputs ("
    n_cite4=0
    for r in $SAMPLE_RECS; do n_cite4=$((n_cite4 + $(LC_ALL=C "$G" -F -e "$FID" "$R" | LC_ALL=C "$G" -c -F -e "\`$r\`"))); done
    echo "  the four sample records cited on the fidelity sentence's line: $n_cite4"
    check "the fidelity sentence cites the four sample records" "$(yn [ "$n_cite4" = 4 ])"
    
    echo "### part 5 P4's five chart sample records, \"Files by outcome\", the host and the i686 rows (ruling AF; change RRF)"
    n_m5=0
    for r in $M5_RECS; do
      RF=$B/$(basename "$r")
      n_m5=$((n_m5 + 1))
      for lab in host i686; do
        vf=$(md_cell "$RF" '## Files by outcome' exact "$lab" files)
        vo=$(md_cell "$RF" '## Files by outcome' exact "$lab" ok)
        vl=$(md_cell "$RF" '## Files by outcome' exact "$lab" 'lo ok')
        vi=$(md_cell "$RF" '## Files by outcome' exact "$lab" 'lo_in ok')
        echo "  command: md_cell <record> '## Files by outcome' exact $lab <files|ok|lo ok|lo_in ok>, over $r -> files $vf, ok $vo, lo ok $vl, lo_in ok $vi"
        check "$(basename "$r"): the $lab row reads files $WANT_FILES, ok $WANT_OK, lo ok $WANT_LO_OK, lo_in ok $WANT_LO_IN_OK (ruling AF)" "$(yn host_row_ok)"
        check "control: the same check refuses an expected ok one less" "$(ynnot host_row_ctl)"
      done
    done
    check "the five chart sample records were read, as the README's \"five chart samples\" says" "$(yn [ "$n_m5" = "$WANT_M5_SAMPLES" ])"
    FIGS+=("$vf")
    readme_holds "the Milestone 5 fidelity sentence's count of samples (change RRN)" "Each of Milestone 5 part 5's five chart samples (" "Each of Milestone 5 part 5's six chart samples ("
    # Change RRS: the fragment ends in the sentence's first record, as the
    # Milestone 6 sentence shares its words.
    M5_FIRST=${M5_RECS%% *}
    FID5="ran over the same $vf workbooks, and on the host and on the static target all $vo outputs were written and opened in LibreOffice, as were all $vi inputs (\`$M5_FIRST\`"
    check "the five records' lo ok is their ok, as the README's one word for both says" "$(yn [ "$vo" = "$vl" ])"
    readme_holds "the Milestone 5 fidelity sentence" "$FID5" "ran over the same $vf workbooks, and on the host and on the static target all $((vo + 1)) outputs were written and opened in LibreOffice, as were all $vi inputs (\`$M5_FIRST\`"
    n_cite5=0
    for r in $M5_RECS; do n_cite5=$((n_cite5 + $(LC_ALL=C "$G" -F -e "$FID5" "$R" | LC_ALL=C "$G" -c -F -e "\`$r\`"))); done
    echo "  the five chart sample records cited on the Milestone 5 fidelity sentence's line: $n_cite5"
    check "the Milestone 5 fidelity sentence cites the five chart sample records" "$(yn [ "$n_cite5" = 5 ])"
    
    echo "### Milestone 6's six sample records, the parts' P3 reruns, \"Files by outcome\", the host and the i686 rows (change RRS)"
    n_m6=0
    for r in $M6_RECS; do
      RF=$B/$(basename "$r")
      n_m6=$((n_m6 + 1))
      for lab in host i686; do
        vf=$(md_cell "$RF" '## Files by outcome' exact "$lab" files)
        vo=$(md_cell "$RF" '## Files by outcome' exact "$lab" ok)
        vl=$(md_cell "$RF" '## Files by outcome' exact "$lab" 'lo ok')
        vi=$(md_cell "$RF" '## Files by outcome' exact "$lab" 'lo_in ok')
        echo "  command: md_cell <record> '## Files by outcome' exact $lab <files|ok|lo ok|lo_in ok>, over $r -> files $vf, ok $vo, lo ok $vl, lo_in ok $vi"
        check "$(basename "$r"): the $lab row reads files $WANT_FILES, ok $WANT_OK, lo ok $WANT_LO_OK, lo_in ok $WANT_LO_IN_OK (change RRS)" "$(yn host_row_ok)"
        check "control: the same check refuses an expected ok one less" "$(ynnot host_row_ctl)"
      done
    done
    check "the six sample records were read, as the README's \"six samples\" says (change RRS)" "$(yn [ "$n_m6" = "$WANT_M6_SAMPLES" ])"
    FIGS+=("$vf")
    readme_holds "the Milestone 6 fidelity sentence's count of samples (change RRS)" "Each of Milestone 6's six samples (" "Each of Milestone 6's seven samples ("
    M6_FIRST=${M6_RECS%% *}
    FID6="ran over the same $vf workbooks, and on the host and on the static target all $vo outputs were written and opened in LibreOffice, as were all $vi inputs (\`$M6_FIRST\`"
    check "the six records' lo ok is their ok, as the README's one word for both says" "$(yn [ "$vo" = "$vl" ])"
    readme_holds "the Milestone 6 fidelity sentence" "$FID6" "ran over the same $vf workbooks, and on the host and on the static target all $((vo + 1)) outputs were written and opened in LibreOffice, as were all $vi inputs (\`$M6_FIRST\`"
    n_cite6=0
    for r in $M6_RECS; do n_cite6=$((n_cite6 + $(LC_ALL=C "$G" -F -e "$FID6" "$R" | LC_ALL=C "$G" -c -F -e "\`$r\`"))); done
    echo "  the six sample records cited on the Milestone 6 fidelity sentence's line: $n_cite6"
    check "the Milestone 6 fidelity sentence cites the six sample records (change RRS)" "$(yn [ "$n_cite6" = 6 ])"
    
    echo "### the core's styles sentence and the charts line's specs (changes RRT and RRU)"
    STYLES_SPEC=specs/0042-gradient-fills-and-named-styles.md
    STY="The core itself writes and reads gradient fills and named styles, \`$STYLES_SPEC\`, with no feature;"
    readme_holds "the core's styles sentence" "$STY" "The core itself writes and reads gradient fills and named styles, \`specs/0041-chart-text-and-edits.md\`, with no feature;"
    LC_ALL=C "$G" -F -e "$STY" "$R" >"$B/styles-line"
    sty_paths() { LC_ALL=C "$G" -o -E 'records/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]' "$1" | sort -u | tr '\n' ' '; }
    echo "  command: grep -o -E 'records/...' <the styles sentence's line> | sort -u -> $(sty_paths "$B/styles-line")"
    check "the styles sentence's line cites the size record alone and names its probe-emend-fullstyles-write-xml (change RRT)" "$(yn [ "$(sty_paths "$B/styles-line")$(count_matches -F '`probe-emend-fullstyles-write-xml`' "$B/styles-line")" = "$SIZE_REC 1" ])"
    check "the tree holds $STYLES_SPEC (change RRT)" "$(yn [ "$(count_matches -xF "$STYLES_SPEC" "$B/tree.txt")" = 1 ])"
    FSD=$(md_cell "$SZ" '## The probes' exact '`probe-emend-fullstyles-write-xml`' 'What it does')
    echo "  command: md_cell <size record> '## The probes' exact '\`probe-emend-fullstyles-write-xml\`' 'What it does' -> $(printf '%s' "$FSD" | wc -c) bytes; holding \"gradient\": $(printf '%s\n' "$FSD" | count_matches -F gradient /dev/stdin); holding \"add_named_style\": $(printf '%s\n' "$FSD" | count_matches -F add_named_style /dev/stdin)"
    fsd_ok() { [ "$(printf '%s\n' "$1" | count_matches -F gradient /dev/stdin)$(printf '%s\n' "$1" | count_matches -F add_named_style /dev/stdin)" = 11 ]; }
    check "the size record's fullstyles probe adds a gradient fill and a named style, as the sentence says (change RRT)" "$(yn fsd_ok "$FSD")"
    check "control: the same check refuses the description with add_named_style taken out" "$(ynnot fsd_ok "${FSD//add_named_style/add_style}")"
    CHARTS_WANT="specs/0034-charts-read.md specs/0035-charts-write-first-set.md specs/0036-charts-write-second-set.md specs/0038-chartsheets.md specs/0039-chart-kinds-and-formatting.md specs/0040-analytic-chart-elements.md specs/0041-chart-text-and-edits.md "
    charts_specs() { LC_ALL=C "$G" -E '^- `charts`, ' "$1" | LC_ALL=C "$G" -o -E 'specs/[0-9]{4}-[a-z0-9-]+[.]md' | tr '\n' ' '; }
    echo "  command: grep -E '^- \`charts\`, ' <README> | grep -o -E 'specs/[0-9]{4}-[a-z0-9-]+[.]md' -> $(charts_specs "$R")"
    check "the charts line names specs/0034 to specs/0036 and specs/0038 to specs/0041, in that order (specs/0043 \"The README\"; change RRU)" "$(yn [ "$(charts_specs "$R")" = "$CHARTS_WANT" ])"
    sed 's# and `specs/0041-chart-text-and-edits.md`##' "$R" >"$B/c-charts.md"
    check "control: the same comparison refuses a copy whose charts line names one spec fewer" "$(ynnot [ "$(charts_specs "$B/c-charts.md")" = "$CHARTS_WANT" ])"
    
    echo "### the copy record's host family table, the total row (ruling 1)"
    CR=$B/$(basename "$COPY_REC")
    ENT=$(md_cell "$CR" '## Entries by part family: host' exact total entries)
    IDN=$(md_cell "$CR" '## Entries by part family: host' exact total identical)
    echo "  command: md_cell <record> '## Entries by part family: host' exact total <entries|identical> -> entries $ENT, identical $IDN"
    copy_tot_ok() { [ "$ENT" = "$WANT_ENTRIES" ] && [ "$IDN" = "$WANT_IDENTICAL" ]; }
    check "the copy record's host total row reads entries $WANT_ENTRIES, identical $WANT_IDENTICAL (ruling 1)" "$(yn copy_tot_ok)"
    copy_tot_ctl() { local WANT_IDENTICAL=$((WANT_IDENTICAL + 1)); copy_tot_ok; }
    check "control: the same check refuses an expected identical one more" "$(ynnot copy_tot_ctl)"
    FIGS+=("$ENT" "$IDN")
    readme_holds "the copy sentence" "In the copy sample, $IDN of the $ENT zip entries on the host came back byte for byte: the entries the copy did not touch (\`$COPY_REC\`)" "In the copy sample, $((IDN + 1)) of the $ENT zip entries on the host came back byte for byte: the entries the copy did not touch (\`$COPY_REC\`)"
    
    echo "### the open record's totals (ruling 1)"
    OR=$B/$(basename "$OPEN_REC")
    PAIRS=$(md_cell "$OR" '## Totals' first '' pairs)
    OLO=$(md_cell "$OR" '## Totals' first '' 'lo ok')
    echo "  command: md_cell <record> '## Totals' first - <pairs|lo ok> -> pairs $PAIRS, lo ok $OLO"
    open_ok() { [ "$PAIRS" = "$WANT_PAIRS" ] && [ "$OLO" = "$WANT_OPEN_LO_OK" ]; }
    check "the open record's totals read pairs $WANT_PAIRS, lo ok $WANT_OPEN_LO_OK (ruling 1)" "$(yn open_ok)"
    open_ctl() { local WANT_PAIRS=$((WANT_PAIRS + 1)); open_ok; }
    check "control: the same check refuses expected pairs one more" "$(ynnot open_ctl)"
    FIGS+=("$PAIRS" "$OLO")
    readme_holds "the open sentence (M3 part 7 P5's words; change RRG)" "Of the $PAIRS output files the crate's and the copy tool's tests keep, LibreOffice opened $OLO; the record's own sections explain the eleven it did not (\`$OPEN_REC\`)" "Of the $PAIRS output files the crate's and the copy tool's tests keep, LibreOffice opened $((OLO + 1)); the record's own sections explain the eleven it did not (\`$OPEN_REC\`)"
    open_rest_ok() { [ "$((PAIRS - OLO))" = "$WANT_OPEN_REST" ]; }
    check "the pairs less the opened are $WANT_OPEN_REST, the README's \"the eleven it did not\" (change RRG)" "$(yn open_rest_ok)"
    open_rest_ctl() { local WANT_OPEN_REST=$((WANT_OPEN_REST + 1)); open_rest_ok; }
    check "control: the same check refuses an expected count one more" "$(ynnot open_rest_ctl)"
    
    echo "### the scale record, $SCALE_REC"
    SC=$B/$(basename "$SCALE_REC")
    SSENT=$(joined "$SC" | LC_ALL=C "$G" -o -E "Every streaming sample peaks between [0-9]+ and [0-9]+ kB on every tier it completes, tier c's [0-9]+-byte sheet entry included[.]")
    echo "  command: tr '\\n' ' ' <record> | grep -o -E \"Every streaming sample peaks between [0-9]+ and [0-9]+ kB on every tier it completes, tier c's [0-9]+-byte sheet entry included[.]\" -> $SSENT"
    PLO=$(printf '%s' "$SSENT" | awk '{print $6}')
    PHI=$(printf '%s' "$SSENT" | awk '{print $8}')
    BIG=$(printf '%s' "$SSENT" | LC_ALL=C "$G" -o -E '[0-9]+-byte' | cut -d- -f1)
    md_cell "$SC" '## Throughput' all '' 'host MB/s' >"$B/tp-host"
    md_cell "$SC" '## Throughput' all '' 'i686 MB/s' >"$B/tp-i686"
    echo "  command: md_cell <record> '## Throughput' all - 'host MB/s' -> $(tr '\n' ' ' <"$B/tp-host")"
    echo "  command: md_cell <record> '## Throughput' all - 'i686 MB/s' -> $(tr '\n' ' ' <"$B/tp-i686")"
    HMIN=$(sort -g "$B/tp-host" | head -n 1); HMAX=$(sort -g "$B/tp-host" | tail -n 1)
    IMIN=$(sort -g "$B/tp-i686" | head -n 1); IMAX=$(sort -g "$B/tp-i686" | tail -n 1)
    RSENT=$(joined "$SC" | LC_ALL=C "$G" -o -E "Tier c's figure includes the raw-copy samples; its rewriting samples run at [0-9]+[.][0-9]+ to [0-9]+[.][0-9]+ MB/s[.]")
    echo "  command: tr '\\n' ' ' <record> | grep -o -E \"Tier c's figure includes the raw-copy samples; its rewriting samples run at [0-9]+[.][0-9]+ to [0-9]+[.][0-9]+ MB/s[.]\" -> $RSENT (change RRG)"
    RLO=$(printf '%s' "$RSENT" | awk '{print $13}')
    RHI=$(printf '%s' "$RSENT" | awk '{print $15}')
    HC=$(md_cell "$SC" '## Throughput' exact c 'host MB/s')
    IC=$(md_cell "$SC" '## Throughput' exact c 'i686 MB/s')
    echo "  command: md_cell <record> '## Throughput' exact c <host MB/s|i686 MB/s> -> host $HC, i686 $IC"
    echo "  the peaks $PLO to $PHI kB; the largest sheet entry $BIG bytes; host $HMIN to $HMAX MB/s; i686 $IMIN to $IMAX MB/s (sort -g, the first and the last); tier c's rewriting samples $RLO to $RHI MB/s"
    scale_nums() { num "$PLO" && num "$PHI" && num "$BIG" && num "$HMIN" && num "$HMAX" && num "$IMIN" && num "$IMAX" && num "$RLO" && num "$RHI" && [ "$(count_lines "$B/tp-host")" = 4 ] && [ "$(count_lines "$B/tp-i686")" = 4 ]; }
    check "every scale figure is a number, the throughput table's four tiers read for each target, and the rewriting samples' range read" "$(yn scale_nums)"
    largest_c() { [ "$HC" = "$HMAX" ] && [ "$IC" = "$IMAX" ]; }
    check "tier c's row holds the largest throughput on each target, the README's \"the largest tier's figures\" (change RRG)" "$(yn largest_c)"
    largest_c_ctl() { local HC=$HMIN; largest_c; }
    check "control: the same check refuses the host's smallest figure as tier c's" "$(ynnot largest_c_ctl)"
    FIGS+=("$BIG" "$PLO" "$PHI" "$HMIN" "$HMAX" "$IMIN" "$IMAX" "$RLO" "$RHI")
    readme_holds "the speed sentence (M3 part 7 P5's words; change RRG)" "up to a $BIG-byte sheet entry, the streaming samples peaked between $PLO and $PHI kB on every tier they completed, and throughput ran from $HMIN to $HMAX MB/s on the host and from $IMIN to $IMAX MB/s on the static target, the largest tier's figures including the raw-copy samples, whose rewriting samples ran at $RLO to $RHI MB/s (\`$SCALE_REC\`)" "up to a $BIG-byte sheet entry, the streaming samples peaked between $PLO and $((PHI + 1)) kB on every tier they completed, and throughput ran from $HMIN to $HMAX MB/s on the host and from $IMIN to $IMAX MB/s on the static target, the largest tier's figures including the raw-copy samples, whose rewriting samples ran at $RLO to $RHI MB/s (\`$SCALE_REC\`)"
    
    echo "### the comparison record, $CMP_REC (changes RRH and RRI)"
    CM=$B/$(basename "$CMP_REC")
    # md_where <file> <heading prefix> <column name> <conditions>: in the section
    # opened by the first line starting with the heading (up to the next "## "
    # heading), each table whose header row names the column and every
    # condition's column; prints that column's cell of each data row meeting
    # every condition, "name=value" separated by ";" (none: every row). A line
    # outside a table ends it.
    md_where() {
      awk -F'|' -v h="$2" -v col="$3" -v conds="$4" '
        BEGIN { nc = split(conds, cs, ";"); for (k = 1; k <= nc; k++) { split(cs[k], kv, "="); cn[k] = kv[1]; cv[k] = kv[2] } }
        index($0, h) == 1 { s = 1; hdr = 0; next }
        s && /^## / { s = 0 }
        s && !/^[|]/ { hdr = 0; next }
        s && /^[|]/ {
          if (!hdr) {
            delete ix
            for (i = 2; i < NF; i++) { c = $i; gsub(/^ +| +$/, "", c); ix[c] = i }
            hdr = 1; ok = (col in ix)
            for (k = 1; k <= nc; k++) if (!(cn[k] in ix)) ok = 0
            next
          }
          c1 = $2; gsub(/^ +| +$/, "", c1)
          if (c1 ~ /^-+$/ || !ok) next
          m = 1
          for (k = 1; k <= nc; k++) { v = $(ix[cn[k]]); gsub(/^ +| +$/, "", v); if (v != cv[k]) m = 0 }
          if (m) { v = $(ix[col]); gsub(/^ +| +$/, "", v); print v }
        }' "$1"
    }
    printf '## T\n\n| op | tool | v |\n| --- | --- | --- |\n| a | x | 1 |\n| a | y | 2 |\n| b | x | 3 |\n\n| op | w |\n| --- | --- |\n| a | 9 |\n' >"$B/mw-fixture"
    echo "command (control): md_where over a fixture of two tables: v where op=a;tool=y, v where tool=x, v over every row, v where op=c"
    md_where_ctl() { [ "$(md_where "$B/mw-fixture" '## T' v 'op=a;tool=y')" = 2 ] && [ "$(md_where "$B/mw-fixture" '## T' v 'tool=x' | tr '\n' ' ')" = "1 3 " ] && [ "$(md_where "$B/mw-fixture" '## T' v '' | tr '\n' ' ')" = "1 2 3 " ] && [ -z "$(md_where "$B/mw-fixture" '## T' v 'op=c')" ]; }
    check "control: md_where reads the fixture's cells by their conditions, and the second table, whose header names no column v, is not read" "$(yn md_where_ctl)"
    # all_are <file> <heading> <column> <conditions> <value>: at least one row
    # meets the conditions, and every such row's cell is the value.
    all_are() { [ "$(md_where "$1" "$2" "$3" "$4" | sort -u | tr '\n' ' ')" = "$5 " ]; }
    rows_of() { md_where "$1" "$2" "$3" "$4" | wc -l; }
    CS='## The corpus, per op'
    SS='## The scale tiers'
    md_where "$CM" "$CS" op '' | sort -u >"$B/cmp-ops"
    n_ops=$(count_lines "$B/cmp-ops")
    n_rows=$(rows_of "$CM" "$CS" op '')
    n_eh=$(rows_of "$CM" "$CS" op 'tool=emend;label=host')
    n_ei=$(rows_of "$CM" "$CS" op 'tool=emend;label=i686')
    n_op=$(rows_of "$CM" "$CS" op 'tool=openpyxl;label=openpyxl')
    echo "  command: md_where <record> '$CS' op <every row | tool=emend;label=host | tool=emend;label=i686 | tool=openpyxl;label=openpyxl> -> rows $n_rows; ops $n_ops ($(tr '\n' ' ' <"$B/cmp-ops")); emend host $n_eh, emend i686 $n_ei, openpyxl $n_op"
    corpus_rows_ok() { [ "$n_ops" = "$WANT_OPS" ] && [ "$n_rows" = "$((3 * WANT_OPS))" ] && [ "$n_eh" = "$WANT_OPS" ] && [ "$n_ei" = "$WANT_OPS" ] && [ "$n_op" = "$WANT_OPS" ]; }
    check "the corpus table holds $WANT_OPS ops, the README's \"the sixteen ops\", each with an emend host, an emend i686 and an openpyxl row" "$(yn corpus_rows_ok)"
    corpus_rows_ctl() { local WANT_OPS=$((WANT_OPS + 1)); corpus_rows_ok; }
    check "control: the same check refuses an expected op count one more" "$(ynnot corpus_rows_ctl)"
    NF=$(md_where "$CM" "$CS" files 'op=roundtrip;tool=emend;label=host')
    NOK=$(md_where "$CM" "$CS" ok 'op=roundtrip;tool=emend;label=host')
    echo "  command: md_where <record> '$CS' <files|ok|lo ok> '' (every row), sort -u -> files $(md_where "$CM" "$CS" files '' | sort -u | tr '\n' ' '); ok $(md_where "$CM" "$CS" ok '' | sort -u | tr '\n' ' '); lo ok $(md_where "$CM" "$CS" 'lo ok' '' | sort -u | tr '\n' ' ')"
    corpus_all_ok() { [ "$NF" = "$WANT_FILES" ] && [ "$NOK" = "$WANT_OK" ] && all_are "$CM" "$CS" files '' "$NF" && all_are "$CM" "$CS" ok '' "$NOK" && all_are "$CM" "$CS" 'lo ok' '' "$NOK"; }
    check "every corpus row of every op and tool reads files $WANT_FILES, ok $WANT_OK and lo ok $WANT_OK, the README's \"27 of 27 outputs for every op, and LibreOffice opened every one\"" "$(yn corpus_all_ok)"
    corpus_all_ctl() { all_are "$CM" "$CS" ok '' "$((NOK - 1))"; }
    check "control: all_are refuses a value one less as every row's ok" "$(ynnot corpus_all_ctl)"
    RT_EH_I=$(md_where "$CM" "$CS" identical 'op=roundtrip;tool=emend;label=host')
    RT_EH_D=$(md_where "$CM" "$CS" dropped 'op=roundtrip;tool=emend;label=host')
    RT_EI_I=$(md_where "$CM" "$CS" identical 'op=roundtrip;tool=emend;label=i686')
    RT_EI_D=$(md_where "$CM" "$CS" dropped 'op=roundtrip;tool=emend;label=i686')
    RT_O_I=$(md_where "$CM" "$CS" identical 'op=roundtrip;tool=openpyxl;label=openpyxl')
    RT_O_D=$(md_where "$CM" "$CS" dropped 'op=roundtrip;tool=openpyxl;label=openpyxl')
    echo "  command: md_where <record> '$CS' <identical|dropped> 'op=roundtrip;tool=<emend;label=host|emend;label=i686|openpyxl;label=openpyxl>' -> emend host $RT_EH_I and $RT_EH_D; emend i686 $RT_EI_I and $RT_EI_D; openpyxl $RT_O_I and $RT_O_D"
    rt_ok() { num "$RT_EH_I" && num "$RT_O_I" && num "$RT_O_D" && [ "$RT_EH_I" = "$RT_EI_I" ] && [ "$RT_EH_D" = 0 ] && [ "$RT_EI_D" = 0 ]; }
    check "the roundtrip's identical entries are one figure on both emend labels and emend dropped 0 on both, the README's \"dropped none\"" "$(yn rt_ok)"
    rt_ctl() { local RT_EI_D=1; rt_ok; }
    check "control: the same check refuses a dropped entry on i686" "$(ynnot rt_ctl)"
    MED_E=$(md_where "$CM" "$CS" 'wall median s' 'op=roundtrip;tool=emend;label=host')
    MED_O=$(md_where "$CM" "$CS" 'wall median s' 'op=roundtrip;tool=openpyxl;label=openpyxl')
    echo "  command: md_where <record> '$CS' 'wall median s' <tool=emend;label=host|tool=openpyxl;label=openpyxl>, sort -u -> emend host $(md_where "$CM" "$CS" 'wall median s' 'tool=emend;label=host' | sort -u | tr '\n' ' '); openpyxl $(md_where "$CM" "$CS" 'wall median s' 'tool=openpyxl;label=openpyxl' | sort -u | tr '\n' ' ')"
    med_ok() { num "$MED_E" && num "$MED_O" && all_are "$CM" "$CS" 'wall median s' 'tool=emend;label=host' "$MED_E" && all_are "$CM" "$CS" 'wall median s' 'tool=openpyxl;label=openpyxl' "$MED_O"; }
    check "the median wall time is $MED_E s on every emend host row and $MED_O s on every openpyxl row, the README's \"on every op\"" "$(yn med_ok)"
    med_ctl() { all_are "$CM" "$CS" 'wall median s' 'tool=emend;label=host' "$MED_O"; }
    check "control: all_are refuses openpyxl's median as every emend host row's" "$(ynnot med_ctl)"
    RSS_E=$(md_where "$CM" "$CS" 'peak RSS max kB' 'op=roundtrip;tool=emend;label=host')
    RSS_O=$(md_where "$CM" "$CS" 'peak RSS max kB' 'op=roundtrip;tool=openpyxl;label=openpyxl')
    echo "  command: md_where <record> '$CS' 'peak RSS max kB' 'op=roundtrip;tool=<emend;label=host|openpyxl;label=openpyxl>' -> emend host $RSS_E; openpyxl $RSS_O"
    check "the roundtrip's peak RSS maxima are numbers" "$(yn num_pair "$RSS_E" "$RSS_O")"
    n_es=$(rows_of "$CM" "$SS" outcome 'tool=emend')
    echo "  command: md_where <record> '$SS' outcome 'tool=emend', sort -u -> $(md_where "$CM" "$SS" outcome 'tool=emend' | sort -u | tr '\n' ' ')(rows $n_es)"
    check "every emend scale row's outcome is ok, the README's \"emend completed every run\"" "$(yn all_are "$CM" "$SS" outcome 'tool=emend' ok)"
    check "control: the same form refuses every openpyxl scale row as ok, its tier c roundtrip a cap" "$(ynnot all_are "$CM" "$SS" outcome 'tool=openpyxl' ok)"
    CAP_OUT=$(md_where "$CM" "$SS" outcome 'tier=c;op=roundtrip;tool=openpyxl')
    CAP_EXIT=$(md_where "$CM" "$SS" exit 'tier=c;op=roundtrip;tool=openpyxl')
    CAP_W=$(md_where "$CM" "$SS" wall_s 'tier=c;op=roundtrip;tool=openpyxl')
    CAP_P=$(md_where "$CM" "$SS" peak_rss_kb 'tier=c;op=roundtrip;tool=openpyxl')
    echo "  command: md_where <record> '$SS' <outcome|exit|wall_s|peak_rss_kb> 'tier=c;op=roundtrip;tool=openpyxl' -> $CAP_OUT, $CAP_EXIT, $CAP_W, $CAP_P"
    cap_ok() { [ "$CAP_OUT" = cap ] && num "$CAP_EXIT" && num "$CAP_W" && num "$CAP_P"; }
    check "openpyxl's tier c roundtrip is a cap, its exit, wall time and peak RSS numbers, the README's \"ended at its memory cap\"" "$(yn cap_ok)"
    cap_ctl() { local CAP_OUT=ok; cap_ok; }
    check "control: the same check refuses the outcome ok" "$(ynnot cap_ctl)"
    # Change RRV: Milestone 6's rerun of the tiers, emend's roundtrip of
    # tier c on both targets and of tier d, its wall time the same on both.
    T_OUT=$(md_where "$CM" "$SS" outcome 'tier=c;op=roundtrip;tool=emend;label=host')
    T_IN=$(md_where "$CM" "$SS" in_bytes 'tier=c;op=roundtrip;tool=emend;label=host')
    T_W=$(md_where "$CM" "$SS" wall_s 'tier=c;op=roundtrip;tool=emend;label=host')
    T_P=$(md_where "$CM" "$SS" peak_rss_kb 'tier=c;op=roundtrip;tool=emend;label=host')
    TI_OUT=$(md_where "$CM" "$SS" outcome 'tier=c;op=roundtrip;tool=emend;label=i686')
    TI_IN=$(md_where "$CM" "$SS" in_bytes 'tier=c;op=roundtrip;tool=emend;label=i686')
    TI_W=$(md_where "$CM" "$SS" wall_s 'tier=c;op=roundtrip;tool=emend;label=i686')
    TI_P=$(md_where "$CM" "$SS" peak_rss_kb 'tier=c;op=roundtrip;tool=emend;label=i686')
    D_OUT=$(md_where "$CM" "$SS" outcome 'tier=d;op=roundtrip;tool=emend;label=host')
    D_IN=$(md_where "$CM" "$SS" in_bytes 'tier=d;op=roundtrip;tool=emend;label=host')
    D_W=$(md_where "$CM" "$SS" wall_s 'tier=d;op=roundtrip;tool=emend;label=host')
    DI_OUT=$(md_where "$CM" "$SS" outcome 'tier=d;op=roundtrip;tool=emend;label=i686')
    DI_IN=$(md_where "$CM" "$SS" in_bytes 'tier=d;op=roundtrip;tool=emend;label=i686')
    DI_W=$(md_where "$CM" "$SS" wall_s 'tier=d;op=roundtrip;tool=emend;label=i686')
    echo "  command: md_where <record> '$SS' <outcome|in_bytes|wall_s|peak_rss_kb> 'tier=c;op=roundtrip;tool=emend;label=<host|i686>' -> host $T_OUT, $T_IN, $T_W, $T_P; i686 $TI_OUT, $TI_IN, $TI_W, $TI_P"
    echo "  command: md_where <record> '$SS' <outcome|in_bytes|wall_s> 'tier=d;op=roundtrip;tool=emend;label=<host|i686>' -> host $D_OUT, $D_IN, $D_W; i686 $DI_OUT, $DI_IN, $DI_W"
    tier_ok() { [ "$T_OUT" = ok ] && [ "$TI_OUT" = ok ] && num "$T_IN" && num "$T_W" && num "$T_P" && num "$TI_W" && num "$TI_P" && [ "$TI_IN" = "$T_IN" ]; }
    check "emend's tier c roundtrip is ok on the host and on the static target, one input, its wall times and peak RSS numbers (changes RRI and RRV)" "$(yn tier_ok)"
    tier_ctl() { local TI_OUT=cap; tier_ok; }
    check "control: the same check refuses the static target's outcome cap" "$(ynnot tier_ctl)"
    tier_d_ok() { [ "$D_OUT" = ok ] && [ "$DI_OUT" = ok ] && num "$D_IN" && num "$D_W" && [ "$DI_IN" = "$D_IN" ] && [ "$DI_W" = "$D_W" ]; }
    check "emend's tier d roundtrip is ok on both targets, one input and one wall time, the README's \"on each\" (change RRV)" "$(yn tier_d_ok)"
    tier_d_ctl() { local DI_W=9$D_W; tier_d_ok; }
    check "control: the same check refuses a static target's wall time that differs" "$(ynnot tier_d_ctl)"
    FIGS+=("$NF" "$NOK" "$RT_EH_I" "$RT_O_I" "$RT_O_D" "$MED_E" "$MED_O" "$RSS_E" "$RSS_O" "$CAP_EXIT" "$CAP_W" "$CAP_P" "$T_IN" "$T_W" "$T_P" "$TI_W" "$TI_P" "$D_IN" "$D_W")
    readme_holds "the tier rerun's sentence (change RRV)" "In Milestone 6's rerun of the tiers, emend's roundtrip of the tier c workbook, $T_IN bytes, took $T_W s at a peak of $T_P kB on the host and $TI_W s at a peak of $TI_P kB on the static target, and of the tier d workbook, $D_IN bytes, $D_W s on each (\`$CMP_REC\`)" "In Milestone 6's rerun of the tiers, emend's roundtrip of the tier c workbook, $T_IN bytes, took $T_W s at a peak of $T_P kB on the host and 9$TI_W s at a peak of $TI_P kB on the static target, and of the tier d workbook, $D_IN bytes, $D_W s on each (\`$CMP_REC\`)"
    LC_ALL=C "$G" -E '^Comparison with openpyxl: ' "$R" >"$B/cmp-line"
    echo "  the comparison paragraph's lines (starting \"Comparison with openpyxl: \"): $(count_lines "$B/cmp-line")"
    check "the README holds one comparison paragraph" "$(yn [ "$(count_lines "$B/cmp-line")" = 1 ])"
    on_cmp_line() { [ "$(count_matches -F "$1" "$B/cmp-line")" = 1 ]; }
    cmp_holds() {
      readme_holds "$1" "$2" "$3"
      check "$1: the fragment is on the comparison paragraph's line" "$(yn on_cmp_line "$2")"
    }
    cmp_holds "the comparison's workbooks and ops" "over the $NF workbooks and the sixteen ops of the comparison" "over the $((NF + 1)) workbooks and the sixteen ops of the comparison"
    cmp_holds "the comparison's outputs" "emend on the host and on the static target and openpyxl each wrote $NOK of $NF outputs for every op, and LibreOffice opened every one" "emend on the host and on the static target and openpyxl each wrote $((NOK - 1)) of $NF outputs for every op, and LibreOffice opened every one"
    cmp_holds "the roundtrip's entries" "On the roundtrip emend left $RT_EH_I zip entries byte-identical and dropped none, where openpyxl left $RT_O_I identical and dropped $RT_O_D" "On the roundtrip emend left $RT_EH_I zip entries byte-identical and dropped none, where openpyxl left $RT_O_I identical and dropped $((RT_O_D + 1))"
    cmp_holds "the median wall times" "The median wall time per workbook was $MED_E s for emend on the host and $MED_O s for openpyxl on every op" "The median wall time per workbook was $MED_E s for emend on the host and 9$MED_O s for openpyxl on every op"
    cmp_holds "the roundtrip's peak RSS" "the roundtrip's largest peak RSS was $RSS_E kB for emend on the host and $RSS_O kB for openpyxl" "the roundtrip's largest peak RSS was $((RSS_E + 1)) kB for emend on the host and $RSS_O kB for openpyxl"
    cmp_holds "the scale tiers" "On the scale tiers emend completed every run, and openpyxl ended at its memory cap on the tier c roundtrip, exit $CAP_EXIT after $CAP_W s at a peak of $CAP_P kB" "On the scale tiers emend completed every run, and openpyxl ended at its memory cap on the tier c roundtrip, exit $CAP_EXIT after 9$CAP_W s at a peak of $CAP_P kB"
    cmp_paths() { LC_ALL=C "$G" -o -E 'records/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]' "$1" | sort -u | tr '\n' ' '; }
    echo "command: grep -o -E 'records/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]' <the comparison paragraph's line> | sort -u -> $(cmp_paths "$B/cmp-line")"
    check "the comparison paragraph cites the comparison record and no other record (specs/0043 \"The README\")" "$(yn [ "$(cmp_paths "$B/cmp-line")" = "$CMP_REC " ])"
    { tr -d '\n' <"$B/cmp-line"; printf ' (`%s`)\n' "$SIZE_REC"; } >"$B/cmp-line-ctl"
    check "control: the same comparison refuses the line with the size record cited too" "$(ynnot [ "$(cmp_paths "$B/cmp-line-ctl")" = "$CMP_REC " ])"
    
    echo
    echo "## 3. the README's number tokens, as a set, equal the figures checked (change FE)"
    # tokens <file>: the number tokens outside records/ and specs/ paths, the
    # licence files' names, the target's name, the milestone names and "3D"
    # (change RRJ), one per line, unique.
    tokens() {
      sed -E -e 's#(records|specs)/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]##g' -e 's#LICENSE-[A-Z]+##g' -e 's#i686-unknown-linux-musl##g' -e 's#Milestone [0-9]+( part [0-9]+)?##g' -e 's#(^|[^A-Za-z0-9])3D([^A-Za-z0-9]|$)#\1\2#g' "$1" |
        LC_ALL=C "$G" -o -E '[0-9]+([.][0-9]+)?' | sort -u
    }
    echo "command: sed -E -e 's#(records|specs)/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]##g' -e 's#LICENSE-[A-Z]+##g' -e 's#i686-unknown-linux-musl##g' -e 's#Milestone [0-9]+( part [0-9]+)?##g' -e 's#(^|[^A-Za-z0-9])3D([^A-Za-z0-9]|$)#\\1\\2#g' <README> | grep -o -E '[0-9]+([.][0-9]+)?' | sort -u"
    tokens "$R" >"$B/tokens"
    printf '%s\n' "${FIGS[@]}" | sort -u >"$B/figs"
    echo "  the README's tokens ($(count_lines "$B/tokens")): $(tr '\n' ' ' <"$B/tokens")"
    echo "  the figures checked ($(count_lines "$B/figs")): $(tr '\n' ' ' <"$B/figs")"
    check "the README holds no number outside its paths and the target name but the figures checked, and every figure checked" "$(yn cmp -s "$B/tokens" "$B/figs")"
    cp "$R" "$B/planted-num.md"
    printf '\nPlanted: 12345 (`%s`).\n' "$SIZE_REC" >>"$B/planted-num.md"
    tokens "$B/planted-num.md" >"$B/tokens-planted"
    check "control: the same comparison refuses a copy with one more number planted" "$(ynnot cmp -s "$B/tokens-planted" "$B/figs")"
    printf 'Each of Milestone 7 part 8 and Milestone 9 ran.\nPart 6 of 8 ran.\n' >"$B/c-part"
    tokens "$B/c-part" >"$B/tokens-part"
    echo "  over a control holding \"Milestone 7 part 8\", \"Milestone 9\" and \"Part 6 of 8\": $(tr '\n' ' ' <"$B/tokens-part")"
    part_ctl() { [ "$(tr '\n' ' ' <"$B/tokens-part")" = "6 8 " ]; }
    check "control: the tokens leave out a milestone's name with its part and keep a number elsewhere (change RRN)" "$(yn part_ctl)"
    
    echo
    echo "## 4. the README's features equal the manifest's, each named with a specs/ path the tree holds (change FE)"
    echo "command: awk over <phase commit>:crates/emend/Cargo.toml, the names of the [features] table; grep -o -E '^- \`[a-z][a-z0-9_-]*\`, ' over the README"
    awk '/^\[features\]$/ { f = 1; next } /^\[/ { f = 0 } f && /^[a-z][a-z0-9_-]* = / { print $1 }' "$B/Cargo.toml" | sort >"$B/feat-cargo"
    LC_ALL=C "$G" -o -E '^- `[a-z][a-z0-9_-]*`, ' "$R" | sed -E 's/^- `([^`]*)`, $/\1/' | sort >"$B/feat-readme"
    echo "  the manifest's features ($(count_lines "$B/feat-cargo")): $(tr '\n' ' ' <"$B/feat-cargo")"
    echo "  the README's features ($(count_lines "$B/feat-readme")): $(tr '\n' ' ' <"$B/feat-readme")"
    check "the README names every feature of the manifest and no other" "$(yn cmp -s "$B/feat-cargo" "$B/feat-readme")"
    { cat "$B/feat-cargo"; echo planted; } | sort >"$B/feat-ctl"
    check "control: the same comparison refuses the manifest's list with one feature more" "$(ynnot cmp -s "$B/feat-ctl" "$B/feat-readme")"
    order_ok() { [ "$(printf '%s\n' $FEATURES_ORDER | sort | tr '\n' ' ')" = "$(tr '\n' ' ' <"$B/feat-cargo")" ]; }
    check "this script's feature list is the manifest's, so every feature's cost was checked above" "$(yn order_ok)"
    n_spec_bad=0
    for f in $(cat "$B/feat-readme"); do
      sp=$(LC_ALL=C "$G" -E "^- \`$f\`, " "$R" | LC_ALL=C "$G" -o -E 'specs/[0-9]{4}-[a-z0-9-]+[.]md')
      n_sp=$(printf '%s\n' "$sp" | LC_ALL=C "$G" -c -E '^specs/')
      in_tree=0
      for p in $sp; do in_tree=$((in_tree + $(count_matches -xF "$p" "$B/tree.txt"))); done
      echo "  $f: $(printf '%s ' $sp)(paths on the line: $n_sp; of them in the phase commit's tree: $in_tree)"
      [ "$n_sp" -ge 1 ] && [ "$in_tree" = "$n_sp" ] || n_spec_bad=$((n_spec_bad + 1))
    done
    check "every feature line names at least one specs/ path, and the tree holds every one (change RRJ)" "$(yn [ "$n_spec_bad" = 0 ])"
    spec_absent_ctl() { [ "$(count_matches -xF 'specs/0000-no-such-spec.md' "$B/tree.txt")" = 1 ]; }
    check "control: the same count does not find a spec the tree lacks" "$(ynnot spec_absent_ctl)"
    
    echo
    echo "## 5. no U+2014, no non-ASCII byte, no absolute path, no corpus directory name and no private-denylist word in the README (change FE)"
    DASH=$(printf '\342\200\224')
    n_dash=$(count_matches -F "$DASH" "$R")
    printf 'a %s b\n' "$DASH" >"$B/c-dash"
    n_dash_c=$(count_matches -F "$DASH" "$B/c-dash")
    echo "  command: count_matches -F <the bytes E2 80 94> <README> -> $n_dash; over a control line holding them -> $n_dash_c"
    check "the README holds no U+2014" "$(yn [ "$n_dash" = 0 ])"
    check "control: the same count finds the control's one line" "$(yn [ "$n_dash_c" = 1 ])"
    n_na=$(count_matches -P '[^\x00-\x7F]' "$R")
    printf 'caf\303\251\n' >"$B/c-na"
    n_na_c=$(count_matches -P '[^\x00-\x7F]' "$B/c-na")
    echo "  command: count_matches -P '[^\\x00-\\x7F]' <README> -> $n_na; over a control line with one two-byte character -> $n_na_c"
    check "the README is ASCII" "$(yn [ "$n_na" = 0 ])"
    check "control: the same count finds the control's one line" "$(yn [ "$n_na_c" = 1 ])"
    n_ctl=$(LC_ALL=C tr -cd '\000-\010\013-\037\177' <"$R" | wc -c)
    echo "  command: tr -cd <control bytes other than tab and line feed> <README> | wc -c -> $n_ctl"
    check "the README holds no control byte other than tab and line feed" "$(yn [ "$n_ctl" = 0 ])"
    n_fb=$(count_matches_i -wE 'faster|better' "$R")
    printf 'emend is Faster here\nand better there\nbetterment is not a word match\n' >"$B/c-fb"
    n_fb_c=$(count_matches_i -wE 'faster|better' "$B/c-fb")
    echo "  command: count_matches_i -wE 'faster|better' <README> -> $n_fb; over three control lines, one holding each word and one a longer word -> $n_fb_c (change RRK)"
    check "the README says neither \"faster\" nor \"better\" (specs/0043 \"The README\")" "$(yn [ "$n_fb" = 0 ])"
    check "control: the same count finds the two control lines with the words, not the longer word" "$(yn [ "$n_fb_c" = 2 ])"
    # Built by concatenation so this script holds no such shape (change FE).
    ABS_RE="(/ho""me/|/t""mp/|/m""nt/|/ro""ot/|/Us""ers/|[A-Za-z]:[\\\\/])"
    CORP="emend-""testing"
    n_abs=$(count_matches -E "$ABS_RE" "$R")
    printf 'x %s%s%s y\nz %s%s w\n' "/ho" "me/" "someone" "C:" "/x" >"$B/c-abs"
    n_abs_c=$(count_matches -E "$ABS_RE" "$B/c-abs")
    echo "  command: count_matches -E <the absolute-path pattern> <README> -> $n_abs; over two control lines, a home path and a drive path -> $n_abs_c"
    check "the README names no absolute path" "$(yn [ "$n_abs" = 0 ])"
    check "control: the same count finds both control lines" "$(yn [ "$n_abs_c" = 2 ])"
    n_corp=$(count_matches_i -F "$CORP" "$R")
    printf 'x %s y\n' "$CORP" >"$B/c-corp"
    n_corp_c=$(count_matches_i -F "$CORP" "$B/c-corp")
    echo "  command: count_matches_i -F <the corpus directory's name> <README> -> $n_corp; over a control line holding it -> $n_corp_c"
    check "the README names no corpus directory" "$(yn [ "$n_corp" = 0 ])"
    check "control: the same count finds the control's one line" "$(yn [ "$n_corp_c" = 1 ])"
    echo "command: the private denylist at <home>/.config/emend/private-denylist.txt, comment and blank lines dropped; LC_ALL=C grep -c -i -w -F -f <entries> <README>; entries counted and never printed"
    deny_ok=no
    if [ -r "$DENY_FILE" ]; then
      LC_ALL=C "$G" -v -E '^[[:space:]]*(#|$)' "$DENY_FILE" >"$B/deny" 2>/dev/null
      n_deny=$(count_lines "$B/deny")
      LC_ALL=C "$G" -c -i -w -F -f "$B/deny" "$R" >"$B/deny-hits"
      rcd=$?
      head -n 1 "$B/deny" >"$B/c-deny"
      LC_ALL=C "$G" -c -i -w -F -f "$B/deny" "$B/c-deny" >"$B/deny-ctl"
      rcd_c=$?
      echo "  entries: $n_deny; lines of the README holding an entry: $(cat "$B/deny-hits") (grep exit $rcd); lines of a control file holding the first entry: $(cat "$B/deny-ctl") (grep exit $rcd_c)"
      deny_ok=yes
    fi
    check "the denylist is present and readable" "$(yn [ "$deny_ok" = yes ])"
    deny_none() { [ "$deny_ok" = yes ] && [ "$rcd" = 1 ] && [ "$(cat "$B/deny-hits")" = 0 ] && [ "$n_deny" -gt 0 ]; }
    check "the README holds no denylist word (grep exit 1, 0 lines), over a denylist with entries" "$(yn deny_none)"
    deny_ctl() { [ "$deny_ok" = yes ] && [ "$rcd_c" = 0 ] && [ "$(cat "$B/deny-ctl")" = 1 ]; }
    check "control: the same form finds the control's one line" "$(yn deny_ctl)"
    rm -f "$B/deny" "$B/c-deny"
    deny_gone() { [ ! -e "$B/deny" ] && [ ! -e "$B/c-deny" ]; }
    check "the denylist's copies are removed from <scratch>/w (rm -f by name)" "$(yn deny_gone)"
    
    echo
    echo "## the log itself"
    ALL=()
    for f in "$B"/*.out "$B"/*.err; do ALL+=("$f"); done
    nbytes=$(cat "${ALL[@]}" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' | wc -c)
    printf 'x \033[31mred\033[m y caf\303\251\n' >"$B/ctl-bytes"
    nctl=$(LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177\200-\377' <"$B/ctl-bytes" | wc -c)
    echo "  captured outputs: ${#ALL[@]}; control and non-ASCII bytes in them: $nbytes; in a control file with two ESC and one two-byte character: $nctl"
    check "no control or non-ASCII byte in any captured output" "$(yn [ "$nbytes" = 0 ])"
    check "control: the same count finds four bytes in the control file" "$(yn [ "$nctl" = 4 ])"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "status lines: $st_all; of them this phase's logs or planning's spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's logs or planning's uncommitted spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## the README check program (changes FC and RRM)
command: sha256sum <scripts>/readme_check.py: 870e84ba562a90fc691b67ac673eb17b71e5a63c8310f1b4f3f60d5257a5611e
    #!/usr/bin/env python3
    """README check of M6 part 6 P4 (specs/0043-measurement-and-close.md, "The
    README" and "P4: the README"), the successor of M5 part 6 P4's program (whose
    checks it keeps, unit for unit, but for the README forms Milestone 6 brought:
    the closing size record, Milestone 6's six samples, the core's styles
    sentence, the charts line's seven specs, the sixteen ops and the tier
    rerun on both targets and tier d; changes RRR to RRX of the run log, which
    prints this program): over the README, the phase commit's
    file list and a root holding the phase commit's crates/emend/Cargo.toml and
    every records/ file the README cites at its repository path.
    
    Usage: python3 -I -B readme_check.py <README> <tree.txt> <root>
    
    Units: a fenced code block is one unit; outside fences, a heading line, a list
    item (a line starting "- " with its continuation lines) and a paragraph (lines
    up to a blank line) are units, and a prose unit is split into sentences after
    ".", "!" or "?" followed by white space. The checks, each refusal one line
    starting with its kind word and never holding README text:
      UNCITED unit <i>    a sentence holding a digit cites no records/ path;
      MISSING <path>      a cited records/ path the tree does not hold;
      FIGURE <label>      a figure row's fragment, built from the figures read
                          from its record, is not in the README once, or the
                          row's figures do not agree; FIGURE unit <i>: a number
                          of a cited sentence that no record it cites holds;
      NUMBER unit <i>     a number of a cited sentence that a record it cites
                          holds but no figure row reads;
      FEATURE <name>      a feature of the manifest with no README line, a line
                          naming no specs/ path or one the tree lacks, or a
                          README feature the manifest does not have;
      DASH unit <i>       U+2014;
      ABSPATH unit <i>    an absolute path;
      WORD unit <i>       one of the two comparatives specs/0043 forbids.
    A sentence's numbers are its digit runs outside records/ and specs/ paths, the
    licence files' names, the target's name, the milestone names (with "part
    <n>" after one) and "3D". Each
    figure row passed prints "checked <label>", each cited sentence "cited <n>
    unit <i>"; the last line is the summary "sentences <s> with-digit <d> cited
    <c> uncited <u> missing <m> figure <f> number <n> feature <x> dash <k> abspath
    <a> word <w> figures-checked <t>". Exit 0 when no line refuses, 1 when one
    does, 2 on a usage or read error of the README, the tree or the manifest."""
    import os
    import re
    import sys
    
    SIZE = "records/size-m6p6-2026-10-24-7ac8b74.md"
    M3_SAMPLES = ["records/m3p6-p4-copy-2026-10-08-9cfd92e.md", "records/m3p6-p4-anchor-2026-10-08-9cfd92e.md",
                  "records/m3p6-p4-removeimage-2026-10-08-9cfd92e.md", "records/m3p6-p4-commentbox-2026-10-08-9cfd92e.md"]
    COPY = M3_SAMPLES[0]
    M5_SAMPLES = ["records/m5p5-p4-charts-2026-10-15-a8bfe71.md", "records/m5p5-p4-chartmore-2026-10-15-a8bfe71.md",
                  "records/m5p5-p4-chart3d-2026-10-15-a8bfe71.md", "records/m5p5-p4-chartlabels-2026-10-15-a8bfe71.md",
                  "records/m5p5-p4-removechart-2026-10-15-a8bfe71.md"]
    # Change RRS: Milestone 6's six samples, the parts' P3 records.
    M6_SAMPLES = ["records/m6p1-p3-chartsheet-2026-10-19-4cc4f2e.md",
                  "records/m6p2-p3-chartformat-2026-10-20-50a3989.md",
                  "records/m6p3-p3-chartaxis-2026-10-21-0707236.md",
                  "records/m6p4-p3-charttext-2026-10-22-1cc0de4.md",
                  "records/m6p5-p3-gradient-2026-10-23-fe280ff.md",
                  "records/m6p5-p3-namedstyle-2026-10-23-fe280ff.md"]
    OPEN = "records/m3p6-open-2026-10-08-9cfd92e.md"
    SCALE = "records/scale-m3p1-2026-10-02-6578925.md"
    CMP = "records/compare-m6p6-2026-10-24-d88f735.md"
    WORDS = {"4": "four", "5": "five", "6": "six", "11": "eleven", "16": "sixteen"}
    # Change RRU: the charts line's specs, M5's three and Milestone 6's four;
    # change RRT: the core's styles sentence and its spec.
    CHARTS_SPECS = ["specs/0034-charts-read.md", "specs/0035-charts-write-first-set.md", "specs/0036-charts-write-second-set.md", "specs/0038-chartsheets.md", "specs/0039-chart-kinds-and-formatting.md", "specs/0040-analytic-chart-elements.md", "specs/0041-chart-text-and-edits.md"]
    STYLES_SPEC = "specs/0042-gradient-fills-and-named-styles.md"
    STYLES_SENTENCE = ("The core itself writes and reads gradient fills and named styles, `" + STYLES_SPEC
                       + "`, with no feature;")
    PATH = re.compile(r"records/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]")
    NUM = re.compile(r"[0-9]+(?:[.][0-9]+)?")
    # Built from pieces, so this program holds neither word.
    COMPARATIVES = re.compile(r"\b(?:" + "fast" + "er|" + "bett" + r"er)\b", re.I)
    ABS = re.compile(r"(?:^|[\s(`'\"])(?:/[A-Za-z0-9._-]+/|[A-Za-z]:[\\/])")
    DASH = chr(0x2014)
    
    
    def units(lines):
        out, cur, fence = [], [], False
    
        def flush():
            if cur:
                out.append((" ".join(x.strip() for x in cur), False))
                cur.clear()
        for ln in lines:
            if ln.startswith("```"):
                if fence:
                    cur.append(ln)
                    out.append(("\n".join(cur), True))
                    cur.clear()
                    fence = False
                else:
                    flush()
                    cur.append(ln)
                    fence = True
                continue
            if fence:
                cur.append(ln)
                continue
            if not ln.strip():
                flush()
                continue
            if ln.startswith("#") or ln.startswith("- "):
                flush()
                cur.append(ln)
                if ln.startswith("#"):
                    flush()
                continue
            cur.append(ln)
        if fence:
            print("error: an unclosed code fence", file=sys.stderr)
            sys.exit(2)
        flush()
        return out
    
    
    def stripped(text):
        """The text without the paths and names whose digits are not numbers."""
        text = re.sub(r"(records|specs)/[A-Za-z0-9._/-]*[A-Za-z0-9_/-]", "", text)
        text = re.sub(r"LICENSE-[A-Z]+", "", text)
        text = text.replace("i686-unknown-linux-musl", "")
        text = re.sub(r"Milestone [0-9]+(?: part [0-9]+)?", "", text)
        return re.sub(r"(^|[^A-Za-z0-9])3D([^A-Za-z0-9]|$)", r"\1\2", text)
    
    
    def section(text, heading):
        """The lines of the section opened by the first line starting with the
        heading, up to the next "## " heading."""
        lines = text.split("\n")
        for i, l in enumerate(lines):
            if l.startswith(heading):
                out = []
                for m in lines[i + 1:]:
                    if m.startswith("## "):
                        break
                    out.append(m)
                return out
        return []
    
    
    def cells(line):
        return [c.strip() for c in line.split("|")[1:-1]]
    
    
    def tables(text, heading):
        """Each table of the section as (header, data rows)."""
        out, cur = [], None
        for l in section(text, heading):
            if l.startswith("|"):
                if cur is None:
                    cur = (cells(l), [])
                    out.append(cur)
                else:
                    row = cells(l)
                    if row and re.fullmatch(r"-+", row[0]):
                        continue
                    cur[1].append(row)
            else:
                cur = None
        return out
    
    
    def where(text, heading, col, **conds):
        """The column's cell of each data row meeting every condition, over the
        section's tables whose header names the column and the conditions'."""
        vals = []
        for head, rows in tables(text, heading):
            names = [col] + list(conds)
            if any(n not in head for n in names):
                continue
            for r in rows:
                if len(r) != len(head):
                    continue
                if all(r[head.index(k)] == v for k, v in conds.items()):
                    vals.append(r[head.index(col)])
        return vals
    
    
    def first_col(text, heading, col, label, prefix=False):
        vals = []
        for head, rows in tables(text, heading):
            if col not in head:
                continue
            for r in rows:
                if len(r) == len(head) and (r[0].startswith(label) if prefix else r[0] == label):
                    vals.append(r[head.index(col)])
        return vals
    
    
    def joined(text):
        return text.replace("\n", " ")
    
    
    def one(vals):
        return vals[0] if len(vals) == 1 else None
    
    
    def is_num(v):
        return v is not None and NUM.fullmatch(v) is not None
    
    
    class Checker:
        def __init__(self, readme, root):
            self.readme = readme
            self.root = root
            self.figs = set()
            self.figure = 0
            self.checked = 0
    
        def rec(self, path):
            try:
                return open(os.path.join(self.root, path), encoding="utf-8").read()
            except (OSError, UnicodeDecodeError):
                return None
    
        def row(self, label, ok, values, fragments):
            """A figure row: its figures agree (ok), each is a number, and each
            fragment is in the README once."""
            good = ok and all(is_num(v) for v in values) and all(self.readme.count(f) == 1 for f in fragments)
            if good:
                self.checked += 1
                self.figs.update(values)
                print("checked %s" % label)
            else:
                self.figure += 1
                print("FIGURE %s" % label)
    
        def line_of(self, fragment):
            for l in self.readme.split("\n"):
                if fragment in l:
                    return l
            return ""
    
    
    def main():
        if len(sys.argv) != 4:
            print("usage: readme_check.py <README> <tree.txt> <root>", file=sys.stderr)
            sys.exit(2)
        try:
            readme = open(sys.argv[1], encoding="utf-8").read()
            tree = set(open(sys.argv[2], encoding="utf-8").read().split("\n"))
            manifest = open(os.path.join(sys.argv[3], "crates/emend/Cargo.toml"), encoding="utf-8").read()
        except (OSError, UnicodeDecodeError) as e:
            print("error: %s" % type(e).__name__, file=sys.stderr)
            sys.exit(2)
        ck = Checker(readme, sys.argv[3])
        lines = readme.split("\n")
        feature = 0
    
        # The features: the manifest's against the README's lines, and each
        # line's cost from M6 part 6 P3's size record, which every line cites
        # (ruling AI's form; change RRR).
        feats, inside = [], False
        for l in manifest.split("\n"):
            if l.strip() == "[features]":
                inside = True
                continue
            if l.startswith("["):
                inside = False
            m = re.match(r"([a-z][a-z0-9_-]*) = ", l)
            if inside and m:
                feats.append(m.group(1))
        readme_feats = [m.group(1) for m in (re.match(r"- `([a-z][a-z0-9_-]*)`, ", l) for l in lines) if m]
        for name in sorted(set(readme_feats) - set(feats)):
            feature += 1
            print("FEATURE %s" % name)
        for f in feats:
            fl = [l for l in lines if l.startswith("- `%s`, " % f)]
            if len(fl) != 1:
                feature += 1
                print("FEATURE %s" % f)
                continue
            specs = re.findall(r"specs/[0-9]{4}-[a-z0-9-]+[.]md", fl[0])
            if not specs or any(s not in tree for s in specs):
                feature += 1
                print("FEATURE %s" % f)
                continue
            recs = PATH.findall(fl[0])
            text = ck.rec(recs[0]) if len(recs) == 1 else None
            v = one(first_col(text, "## The figures", "Sections", "the `%s` feature's cost," % f, True)) if text else None
            ck.row("feature-%s" % f, text is not None and recs[0] == SIZE, [v],
                   [": %s " % v])
    
        # The size sentence, from M6 part 6 P3's size record (change RRR).
        t = ck.rec(SIZE) or ""
        b = one(first_col(t, "## The figures", "Sections", "the budget,", True))
        m = re.search(r"The budget figure is ([0-9]+) section bytes, ([0-9]+) under the ceiling[.]", joined(t))
        c = re.search(r"The ceiling is ([0-9]+) section bytes", joined(t))
        b2, h = (m.group(1), m.group(2)) if m else (None, None)
        cl = c.group(1) if c else None
        ok = all(is_num(x) for x in (b, b2, h, cl)) and b == b2 and int(h) == int(cl) - int(b)
        ck.row("size", ok, [b, h, cl], ["is %s section bytes, %s under the ceiling of %s (`%s`)" % (b, h, cl, SIZE)])
    
        # Fidelity, M3 part 6 P4's four samples: the host row of each.
        def files_row(path, lab):
            t = ck.rec(path) or ""
            return [one(first_col(t, "## Files by outcome", c, lab)) for c in ("files", "ok", "lo ok", "lo_in ok")]
        rows = [files_row(p, "host") for p in M3_SAMPLES]
        f, o, lo, li = rows[0]
        ok = all(r == rows[0] for r in rows) and o == lo
        frag = "ran over the %s workbooks of the private test corpus, and on the host all %s outputs were written and opened in LibreOffice, as were all %s inputs (" % (f, o, li)
        line = ck.line_of(frag)
        ok = ok and all("`%s`" % p in line for p in M3_SAMPLES) and WORDS.get(str(len(M3_SAMPLES))) is not None
        ck.row("fidelity-m3", ok, [f, o, li], [frag, "each of the %s editing samples (" % WORDS.get(str(len(M3_SAMPLES)), "")])
    
        # Fidelity, part 5 P4's five chart samples: both labels' rows (ruling AF).
        rows = [files_row(p, lab) for p in M5_SAMPLES for lab in ("host", "i686")]
        f, o, lo, li = rows[0]
        ok = all(r == rows[0] for r in rows) and o == lo
        frag = "ran over the same %s workbooks, and on the host and on the static target all %s outputs were written and opened in LibreOffice, as were all %s inputs (`%s`" % (f, o, li, M5_SAMPLES[0])
        line = ck.line_of(frag)
        ok = ok and all("`%s`" % p in line for p in M5_SAMPLES)
        ck.row("fidelity-m5", ok, [f, o, li], [frag, "Each of Milestone 5 part 5's %s chart samples (" % WORDS.get(str(len(M5_SAMPLES)), "")])
    
        # Fidelity, Milestone 6's six samples, the parts' P3 records: both
        # labels' rows (change RRS).
        rows = [files_row(p, lab) for p in M6_SAMPLES for lab in ("host", "i686")]
        f, o, lo, li = rows[0]
        ok = all(r == rows[0] for r in rows) and o == lo
        frag = "ran over the same %s workbooks, and on the host and on the static target all %s outputs were written and opened in LibreOffice, as were all %s inputs (`%s`" % (f, o, li, M6_SAMPLES[0])
        line = ck.line_of(frag)
        ok = ok and all("`%s`" % p in line for p in M6_SAMPLES) and WORDS.get(str(len(M6_SAMPLES))) is not None
        ck.row("fidelity-m6", ok, [f, o, li], [frag, "Each of Milestone 6's %s samples (" % WORDS.get(str(len(M6_SAMPLES)), "")])
    
        # The core's styles sentence (change RRT): once in the README, its spec
        # in the tree, citing the size record alone, whose probe table names
        # the fullstyles probe with a gradient fill and add_named_style.
        line = ck.line_of(STYLES_SENTENCE)
        t = ck.rec(SIZE) or ""
        desc = one(first_col(t, "## The probes", "What it does", "`probe-emend-fullstyles-write-xml`"))
        ok = (STYLES_SPEC in tree and PATH.findall(line) == [SIZE] and "`probe-emend-fullstyles-write-xml`" in line
              and desc is not None and "gradient" in desc and "add_named_style" in desc)
        ck.row("core-styles", ok, [], [STYLES_SENTENCE])
    
        # The charts line's specs (change RRU): the seven, in order.
        cl = [l for l in lines if l.startswith("- `charts`, ")]
        ck.row("charts-specs", len(cl) == 1 and re.findall(r"specs/[0-9]{4}-[a-z0-9-]+[.]md", cl[0]) == CHARTS_SPECS, [], [])
    
        # The copy sample's host total row.
        t = ck.rec(COPY) or ""
        e = one(first_col(t, "## Entries by part family: host", "entries", "total"))
        i = one(first_col(t, "## Entries by part family: host", "identical", "total"))
        ck.row("copy", True, [e, i], ["In the copy sample, %s of the %s zip entries on the host came back byte for byte: the entries the copy did not touch (`%s`)" % (i, e, COPY)])
    
        # The open record's totals, its "eleven" the pairs less the opened.
        t = ck.rec(OPEN) or ""
        tot = tables(t, "## Totals")
        pairs = olo = None
        if tot and tot[0][1] and "pairs" in tot[0][0] and "lo ok" in tot[0][0]:
            pairs = tot[0][1][0][tot[0][0].index("pairs")]
            olo = tot[0][1][0][tot[0][0].index("lo ok")]
        rest = WORDS.get(str(int(pairs) - int(olo))) if is_num(pairs) and is_num(olo) else None
        ck.row("open", rest is not None, [pairs, olo],
               ["Of the %s output files the crate's and the copy tool's tests keep, LibreOffice opened %s; the record's own sections explain the %s it did not (`%s`)" % (pairs, olo, rest, OPEN)])
    
        # The scale record: the peaks, the largest sheet entry, the throughput
        # table and tier c's rewriting samples.
        t = ck.rec(SCALE) or ""
        j = joined(t)
        m = re.search(r"Every streaming sample peaks between ([0-9]+) and ([0-9]+) kB on every tier it completes, tier c's ([0-9]+)-byte sheet entry included[.]", j)
        r = re.search(r"Tier c's figure includes the raw-copy samples; its rewriting samples run at ([0-9]+[.][0-9]+) to ([0-9]+[.][0-9]+) MB/s[.]", j)
        hosts = where(t, "## Throughput", "host MB/s")
        i686s = where(t, "## Throughput", "i686 MB/s")
        ok = m is not None and r is not None and len(hosts) == 4 and len(i686s) == 4 and all(is_num(x) for x in hosts + i686s)
        if ok:
            plo, phi, big = m.groups()
            rlo, rhi = r.groups()
            hs = sorted(hosts, key=float)
            js = sorted(i686s, key=float)
            hc = one(where(t, "## Throughput", "host MB/s", tier="c"))
            jc = one(where(t, "## Throughput", "i686 MB/s", tier="c"))
            ok = hc == hs[-1] and jc == js[-1]
            vals = [big, plo, phi, hs[0], hs[-1], js[0], js[-1], rlo, rhi]
            frag = ("up to a %s-byte sheet entry, the streaming samples peaked between %s and %s kB on every tier they completed, and throughput ran from %s to %s MB/s on the host and from %s to %s MB/s on the static target, the largest tier's figures including the raw-copy samples, whose rewriting samples ran at %s to %s MB/s (`%s`)"
                    % (big, plo, phi, hs[0], hs[-1], js[0], js[-1], rlo, rhi, SCALE))
            ck.row("speed", ok, vals, [frag])
        else:
            ck.row("speed", False, [], [])
    
        # The comparison record: the tier rerun's figure and the paragraph.
        t = ck.rec(CMP) or ""
        cs, ss = "## The corpus, per op", "## The scale tiers"
        ops = sorted(set(where(t, cs, "op")))
        n_rows = len(where(t, cs, "op"))
        per = [len(where(t, cs, "op", tool=tl, label=lb)) for tl, lb in (("emend", "host"), ("emend", "i686"), ("openpyxl", "openpyxl"))]
        nf = one(where(t, cs, "files", op="roundtrip", tool="emend", label="host"))
        nok = one(where(t, cs, "ok", op="roundtrip", tool="emend", label="host"))
        every = (set(where(t, cs, "files")) == {nf} and set(where(t, cs, "ok")) == {nok}
                 and set(where(t, cs, "lo ok")) == {nok})
        w_ops = WORDS.get(str(len(ops)))
        ok = w_ops is not None and n_rows == 3 * len(ops) and per == [len(ops)] * 3 and every
        ck.row("comparison-outputs", ok, [nf, nok],
               ["over the %s workbooks and the %s ops of the comparison" % (nf, w_ops),
                "emend on the host and on the static target and openpyxl each wrote %s of %s outputs for every op, and LibreOffice opened every one" % (nok, nf)])
    
        def rt(col, tool, lab):
            return one(where(t, cs, col, op="roundtrip", tool=tool, label=lab))
        ehi, ehd = rt("identical", "emend", "host"), rt("dropped", "emend", "host")
        eii, eid = rt("identical", "emend", "i686"), rt("dropped", "emend", "i686")
        oi, od = rt("identical", "openpyxl", "openpyxl"), rt("dropped", "openpyxl", "openpyxl")
        ck.row("comparison-roundtrip", ehi == eii and ehd == "0" and eid == "0", [ehi, oi, od],
               ["On the roundtrip emend left %s zip entries byte-identical and dropped none, where openpyxl left %s identical and dropped %s" % (ehi, oi, od)])
        me, mo = rt("wall median s", "emend", "host"), rt("wall median s", "openpyxl", "openpyxl")
        ok = (set(where(t, cs, "wall median s", tool="emend", label="host")) == {me}
              and set(where(t, cs, "wall median s", tool="openpyxl", label="openpyxl")) == {mo})
        ck.row("comparison-medians", ok, [me, mo],
               ["The median wall time per workbook was %s s for emend on the host and %s s for openpyxl on every op" % (me, mo)])
        re_, ro = rt("peak RSS max kB", "emend", "host"), rt("peak RSS max kB", "openpyxl", "openpyxl")
        ck.row("comparison-rss", True, [re_, ro],
               ["the roundtrip's largest peak RSS was %s kB for emend on the host and %s kB for openpyxl" % (re_, ro)])
        eo = set(where(t, ss, "outcome", tool="emend"))
    
        def sc(col, **k):
            return one(where(t, ss, col, **k))
        cap = sc("outcome", tier="c", op="roundtrip", tool="openpyxl")
        cx, cw, cp = (sc(c, tier="c", op="roundtrip", tool="openpyxl") for c in ("exit", "wall_s", "peak_rss_kb"))
        ck.row("comparison-scale", eo == {"ok"} and cap == "cap", [cx, cw, cp],
               ["On the scale tiers emend completed every run, and openpyxl ended at its memory cap on the tier c roundtrip, exit %s after %s s at a peak of %s kB" % (cx, cw, cp)])
        # Change RRV: tier c on both targets and tier d, emend's roundtrip.
        tout = sc("outcome", tier="c", op="roundtrip", tool="emend", label="host")
        ti, tw, tp = (sc(c, tier="c", op="roundtrip", tool="emend", label="host") for c in ("in_bytes", "wall_s", "peak_rss_kb"))
        jout = sc("outcome", tier="c", op="roundtrip", tool="emend", label="i686")
        ji, jw, jp = (sc(c, tier="c", op="roundtrip", tool="emend", label="i686") for c in ("in_bytes", "wall_s", "peak_rss_kb"))
        dh = [sc(c, tier="d", op="roundtrip", tool="emend", label="host") for c in ("outcome", "in_bytes", "wall_s")]
        dj = [sc(c, tier="d", op="roundtrip", tool="emend", label="i686") for c in ("outcome", "in_bytes", "wall_s")]
        ok = tout == "ok" and jout == "ok" and ti == ji and dh[0] == "ok" and dj[0] == "ok" and dh[1:] == dj[1:]
        ck.row("tier-rerun", ok, [ti, tw, tp, jw, jp, dh[1], dh[2]],
               ["In Milestone 6's rerun of the tiers, emend's roundtrip of the tier c workbook, %s bytes, took %s s at a peak of %s kB on the host and %s s at a peak of %s kB on the static target, and of the tier d workbook, %s bytes, %s s on each (`%s`)" % (ti, tw, tp, jw, jp, dh[1], dh[2], CMP)])
        para = [l for l in lines if l.startswith("Comparison with openpyxl: ")]
        ck.row("comparison-cites", len(para) == 1 and sorted(set(PATH.findall(para[0]))) == [CMP], [], [])
    
        # The sentences: citations, numbers, the dash, paths and words.
        s = d = cited = u = miss = number = dash = absn = word = 0
        for idx, (text, code) in enumerate(units(lines), 1):
            if DASH in text:
                dash += 1
                print("DASH unit %d" % idx)
            if ABS.search(text):
                absn += 1
                print("ABSPATH unit %d" % idx)
            if COMPARATIVES.search(text):
                word += 1
                print("WORD unit %d" % idx)
            sents = [text] if code else [x for x in re.split(r"(?<=[.!?])\s+", text) if x]
            for sent in sents:
                s += 1
                if not re.search(r"[0-9]", sent):
                    continue
                d += 1
                paths = PATH.findall(sent)
                if not paths:
                    u += 1
                    print("UNCITED unit %d" % idx)
                    continue
                bad = [p for p in paths if p not in tree]
                for p in bad:
                    miss += 1
                    print("MISSING %s" % p)
                if bad:
                    continue
                cited += 1
                print("cited %d unit %d" % (len(paths), idx))
                texts = [ck.rec(p) or "" for p in paths]
                for n in NUM.findall(stripped(sent)):
                    pat = re.compile(r"(?<![0-9.])" + re.escape(n) + r"(?![0-9]|[.][0-9])")
                    if not any(pat.search(x) for x in texts):
                        ck.figure += 1
                        print("FIGURE unit %d" % idx)
                    elif n not in ck.figs:
                        number += 1
                        print("NUMBER unit %d" % idx)
        print("sentences %d with-digit %d cited %d uncited %d missing %d figure %d number %d feature %d dash %d abspath %d word %d figures-checked %d"
              % (s, d, cited, u, miss, ck.figure, number, feature, dash, absn, word, ck.checked))
        sys.exit(0 if u + miss + ck.figure + number + feature + dash + absn + word == 0 else 1)
    
    
    main()

## the defined-helper check program (rulings Z and AD; change RRB)
command: sha256sum <scripts>/defined_check.py: 82c55b4ab2afb71713292132927bf964c35c0b261c74e7151a04cb76ef4e5d2c
    #!/usr/bin/env python3
    """The defined-helper check (specs/0037: ruling Q, carried into each script's
    own shape block by ruling Z, widened by ruling AD): every helper a yn or
    ynnot call names is defined in the script, and yn and ynnot are themselves
    defined in a script that calls them.
    
    Usage: python3 -I -B defined_check.py <script>
    
    A call's name is the word after "$(yn " or "$(ynnot " outside a comment line;
    a name is defined when a line of the script reads "<name>() {" (leading
    blanks allowed). The commands a script calls by name through yn, "[", "cmp",
    "true" and "podman", are not helpers (gen/defined.py's list). Prints one
    line, "called <n>; undefined: <names or none>; yn defined: <yes|no|not
    called>; ynnot defined: <yes|no|not called>"; exit 0 when no name is
    undefined and neither yn nor ynnot is called undefined, 1 otherwise, 2 on a
    usage or read error."""
    import re
    import sys
    
    COMMANDS = ("[", "cmp", "true", "podman")
    CALL = re.compile(r"\$\((yn|ynnot) ([^ )\"]+)")
    
    
    def main():
        if len(sys.argv) != 2:
            print("usage: defined_check.py <script>", file=sys.stderr)
            sys.exit(2)
        try:
            text = open(sys.argv[1], encoding="utf-8").read()
        except OSError as err:
            print("cannot read the script: %s" % err.strerror, file=sys.stderr)
            sys.exit(2)
        called, wrappers = set(), set()
        for line in text.split("\n"):
            if line.lstrip().startswith("#"):
                continue
            for wrapper, name in CALL.findall(line):
                wrappers.add(wrapper)
                called.add(name)
        defined = set(re.findall(r"^[ \t]*([A-Za-z_][A-Za-z0-9_]*)\(\) \{", text, re.M))
        missing = sorted(n for n in called if n not in COMMANDS and n not in defined)
    
        def state(w):
            if w not in wrappers:
                return "not called"
            return "yes" if w in defined else "no"
        print("called %d; undefined: %s; yn defined: %s; ynnot defined: %s"
              % (len(called), " ".join(missing) if missing else "none", state("yn"), state("ynnot")))
        bad = missing or state("yn") == "no" or state("ynnot") == "no"
        sys.exit(1 if bad else 0)
    
    
    main()

## counting controls
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
  control count_matches with a regular expression: 2 (expect 2)
  control count_matches on an unreadable file: error (expect error)
  control count_matches on readable plus unreadable: error (expect error)
  control count_from_file on the same file: 2 (expect 2)
  control count_from_file on a file with none: 0 (expect 0)
  control count_from_file on an unreadable file: error (expect error)
  control count_bytes, control bytes in a file with ESC, ESC and SI: 3 (expect 3)
  control count_bytes, non-ASCII bytes in a file with one two-byte character: 2 (expect 2)
  control count_bytes on a clean file: 0 (expect 0)
  control count_bytes on an unreadable file: error (expect error)
  control count_lines on a three-line file: 3 (expect 3)
  control count_lines on an unreadable file: error (expect error)
  control count_matches_i on mixed case: 2 (expect 2)
  control count_matches on the same file, case sensitive: 1 (expect 1)
  control count_matches_i on an unreadable file: error (expect error)
  control run_lines on a command printing three lines: 3 (expect 3)
  control run_lines on a command printing nothing: 0 (expect 0)
  control run_lines on a FAILING command: error (expect error)
  control run_lines on a command that cannot run: error (expect error)
  control run_matches on a command printing one match: 1 (expect 1)
  control run_matches on a FAILING command: error (expect error)
