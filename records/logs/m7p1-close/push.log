        echo "  40. CARGO_TARGET_DIR checked to be <home>/.cache/emend-build/m5p4-close/target; the other-path control offers M5 part 3's; change 20's block heading cites specs/0035's opening paragraph"
        echo "changes against M5 part 4's script (M5 part 5's close-out; the header above lists them in full):"
