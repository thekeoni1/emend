    done
    tests_ok() { [ "$t_rc" = 0 ] && [ "$n_ok" = 7 ] && [ "$(count_matches -E '^test result: ok[.] 7 passed; 0 failed' "$B/tests.out")" = 1 ]; }
    check "the seven tests passed, each once, and no other ran (change ND64)" "$(yn tests_ok)"
    echo "command: CARGO_TARGET_DIR=<build>/target cargo test -p emend --all-features --lib -- --exact package::tests::zz_planted_absent (no keep)"
    CARGO_TARGET_DIR=$TARGET cargo test -p emend --all-features --lib -- --exact package::tests::zz_planted_absent >"$B/tests-ctl.out" 2>"$B/tests-ctl.err" </dev/null
    c_rc=$?
    LC_ALL=C "$G" -E '^(running |test result: )' "$B/tests-ctl.out" | sed 's/^/    /'
    tests_ctl_ok() { [ "$c_rc" = 0 ] && [ "$(count_matches -E '^test result: ok[.] 0 passed; 0 failed' "$B/tests-ctl.out")" = 1 ]; }
    check "control: the same command with a name no test has runs none (exit $c_rc)" "$(yn tests_ctl_ok)"
    
    echo
    echo "## the kept outputs, read for each fix (K1 to K5; change NE64)"
    cat >"$B/zx.py" <<'PY'
    """Reads a kept package. Usage:
      zx.py names <xlsx>                      the entry names, one a line
      zx.py count <xlsx> <entry> <needle>     the needle's count in the entry, or absent
      zx.py offsets <xlsx> <entry> <n>...     each needle's first offset in the entry, -1 if none
      zx.py foffsets <file> <n>...            the same over a plain file."""
    import sys
    import zipfile
    
    mode = sys.argv[1]
    if mode == "foffsets":
        text = open(sys.argv[2], encoding="utf-8").read()
        print(" ".join(str(text.find(n)) for n in sys.argv[3:]))
        sys.exit(0)
    with zipfile.ZipFile(sys.argv[2]) as z:
        names = z.namelist()
        if mode == "names":
            for n in names:
                print(n)
            sys.exit(0)
        entry = sys.argv[3]
        if entry not in names:
            print("absent")
            sys.exit(0)
        text = z.read(entry).decode("utf-8")
    if mode == "count":
        print(text.count(sys.argv[4]))
    elif mode == "offsets":
        print(" ".join(str(text.find(n)) for n in sys.argv[4:]))
    else:
        sys.exit("unknown mode")
    PY
    sed 's/^/    /' "$B/zx.py"
    zx() { python3 -I -B "$B/zx.py" "$@" 2>>"$B/zx.err" </dev/null; }
    OFPIE=$B/keep/package.tests.chart_write.an_of_pie_of_each_type_and_each_split_writes_its_form
    PLANT=$B/keep/package.tests.protection.the_workbook_element_is_created_before_the_next_main_child_after_a_planted_one
    SCAT=$B/keep/package.tests.chart_write.a_new_scatter_plot_of_the_style_none_is_refused
    ALONE=$B/keep/package.tests.chartsheet.a_removal_alone_on_a_chartsheet_is_refused
    ONEW=$B/keep/package.tests.chartsheet.a_chart_is_replaced_by_a_removal_and_an_addition_in_one_write
    FIELD=$B/keep/package.tests.chart_write.the_trendline_and_error_bar_field_rules_are_refused
    TRW=$B/keep/package.tests.chart_write.each_trendline_kind_writes_its_type_its_order_or_period_and_its_fields
    echo "the keep's pairs by test (inputs, outputs), read by ls <scratch>/w/keep:"
    n_pairs_ok=0
    for v in OFPIE PLANT SCAT ALONE ONEW FIELD TRW; do
      p=${!v}
      ni=$(find "$B/keep" -maxdepth 1 -type f -name "$(basename "$p").*.in.xlsx" | count_lines /dev/stdin)
      no=$(find "$B/keep" -maxdepth 1 -type f -name "$(basename "$p").*.out.xlsx" | count_lines /dev/stdin)
      echo "  $v $(basename "$p"): inputs $ni, outputs $no"
      if [ "$ni" = "$no" ]; then n_pairs_ok=$((n_pairs_ok + 1)); fi
      echo "$no" >"$B/pairs-$v.n"
    done
    check "every test's kept inputs and outputs are equal in number (change NE64)" "$(yn [ "$n_pairs_ok" = 7 ])"
    echo
    echo "### K1, fix 1: the of-pie split (pairs 1 and 10 no split, pair 2 split at position 2)"
    k1a=$(zx count "$OFPIE.1.out.xlsx" xl/charts/chart1.xml 'splitType')
    k1b=$(zx count "$OFPIE.10.out.xlsx" xl/charts/chart1.xml 'splitType')
    k1c=$(zx count "$OFPIE.2.out.xlsx" xl/charts/chart1.xml '<c:splitType val="pos"/><c:splitPos val="2"/>')
    k1d=$(zx count "$OFPIE.1.out.xlsx" xl/charts/chart1.xml '<c:ofPieChart><c:ofPieType val="pie"/>')
    k1e=$(zx count "$OFPIE.10.out.xlsx" xl/charts/chart1.xml '<c:ofPieChart><c:ofPieType val="bar"/>')
    echo "command: python3 -I -B <scratch>/w/zx.py count <pair>.out.xlsx xl/charts/chart1.xml <needle>"
    echo "  pair 1 (pie of pie, no split): splitType $k1a; the pie-of-pie start $k1d"
    echo "  pair 10 (bar of pie, no split): splitType $k1b; the bar-of-pie start $k1e"
    echo "  pair 2 (pie of pie, position 2): <c:splitType val=\"pos\"/><c:splitPos val=\"2\"/> $k1c"
    k1_ok() { [ "$k1a$k1b" = 00 ] && [ "$k1d$k1e" = 11 ]; }
    check "K1: an of-pie with no split, of either type, writes no splitType (fix 1)" "$(yn k1_ok)"
    check "K1 control: the same reading finds the pos form in pair 2, once (fix 1's Some kept)" "$(yn [ "$k1c" = 1 ])"
    echo
    echo "### K2, fix 2: the created workbookProtection after a planted element, before bookViews"
    in_order() { [ "$1" -ge 0 ] && [ "$1" -lt "$2" ] && [ "$2" -lt "$3" ]; }
    read -r k2a1 k2a2 k2a3 <<<"$(zx offsets "$PLANT.1.out.xlsx" xl/workbook.xml '<xr:revisionPtr' '<workbookProtection' '<bookViews')"
    read -r k2b1 k2b2 k2b3 <<<"$(zx offsets "$PLANT.2.out.xlsx" xl/workbook.xml '<mc:AlternateContent' '<workbookProtection' '<bookViews')"
    k2in=$(zx count "$PLANT.1.in.xlsx" xl/workbook.xml '<workbookProtection')
    echo "command: python3 -I -B <scratch>/w/zx.py offsets <pair>.out.xlsx xl/workbook.xml <planted> '<workbookProtection' '<bookViews'"
    echo "  pair 1 (xr:revisionPtr planted): offsets $k2a1 $k2a2 $k2a3; workbookProtection in its input: $k2in"
    echo "  pair 2 (mc:AlternateContent planted): offsets $k2b1 $k2b2 $k2b3"
    check "K2: in pair 1 xr:revisionPtr, then the created workbookProtection, then bookViews (fix 2)" "$(yn in_order "$k2a1" "$k2a2" "$k2a3")"
    check "K2: in pair 2 mc:AlternateContent, then the created workbookProtection, then bookViews (fix 2)" "$(yn in_order "$k2b1" "$k2b2" "$k2b3")"
    check "K2: the input held no workbookProtection: the output's was created" "$(yn [ "$k2in" = 0 ])"
    printf '<workbook><workbookPr/><workbookProtection/><xr:revisionPtr/><bookViews/></workbook>\n' >"$B/k2-planted.xml"
    read -r k2c1 k2c2 k2c3 <<<"$(zx foffsets "$B/k2-planted.xml" '<xr:revisionPtr' '<workbookProtection' '<bookViews')"
    echo "  control: a planted file with workbookProtection before xr:revisionPtr (the old rule's order): offsets $k2c1 $k2c2 $k2c3"
    check "K2 control: the same order check refuses the planted file" "$(ynnot in_order "$k2c1" "$k2c2" "$k2c3")"
    echo
    echo "### K3, fix 3: the scatter test's refused calls"
    echo "  the scatter test kept $(cat "$B/pairs-SCAT.n") pair(s): each refused call writes its input back (the test asserts no chart in each), and the Marker cases, taken, write nothing"
    k3_n() { [ "$(cat "$B/pairs-SCAT.n")" -ge 1 ]; }
    check "K3: the scatter test's refusals each wrote and kept a pair (fix 3)" "$(yn k3_n)"
    n3_chart=0
    for f3 in "$SCAT".*.out.xlsx; do
      n3=$(zx names "$f3" | count_matches -E '^xl/charts/chart[0-9]+[.]xml$' /dev/stdin)
      echo "  $(basename "$f3"): chart parts $n3"
      if [ "$n3" != 0 ]; then n3_chart=$((n3_chart + 1)); fi
    done
    check "K3: no output the scatter test kept holds a chart part: each refused call recorded nothing (fix 3)" "$(yn [ "$n3_chart" = 0 ])"
    echo "  K3 control (change NJ64): an accepted scatter pair, from the scatter style test run alone by exact name with its own keep"
    mkdir "$B/keep3" || exit 2
    P3S=package::tests::chart_write::a_scatter_chart_takes_each_style_with_x_and_y_values
    echo "command: EMEND_KEEP_DIR=<scratch>/w/keep3 CARGO_TARGET_DIR=<build>/target cargo test -p emend --all-features --lib -- --exact $P3S (both variables on this command alone; change NJ64)"
    EMEND_KEEP_DIR=$B/keep3 CARGO_TARGET_DIR=$TARGET cargo test -p emend --all-features --lib -- --exact "$P3S" >"$B/tests3.out" 2>"$B/tests3.err" </dev/null
    t3_rc=$?
    echo "  exit $t3_rc"
    LC_ALL=C "$G" -E '^(running |test result: )' "$B/tests3.out" | sed 's/^/    /'
    n3_marker=0
    for f3 in "$B/keep3"/*.out.xlsx; do
      m3=$(zx count "$f3" xl/charts/chart1.xml 'scatterStyle val="marker"')
      echo "  $(basename "$f3"): scatterStyle marker in xl/charts/chart1.xml: $m3"
      if [ "$m3" = 1 ]; then n3_marker=$((n3_marker + 1)); fi
    done
    k3_ctl() { [ "$t3_rc" = 0 ] && [ "$(count_matches -E '^test result: ok[.] 1 passed; 0 failed' "$B/tests3.out")" = 1 ] && [ "$n3_marker" = 1 ]; }
    check "K3 control: the scatter style test passed alone, and one of its kept outputs, the marker style taken, holds its chart part xl/charts/chart1.xml (change NJ64)" "$(yn k3_ctl)"
    echo
    echo "### K4, fix 4: a chartsheet's chart replaced in one write (pair 2), first written (pair 1)"
    zx names "$ONEW.2.out.xlsx" >"$B/k4-names.out"
    zx names "$ONEW.1.out.xlsx" >"$B/k4-names1.out"
    k4a=$(count_matches -xF 'xl/charts/chart2.xml' "$B/k4-names.out")
    k4b=$(count_matches -xF 'xl/charts/chart1.xml' "$B/k4-names.out")
    k4c=$(zx count "$ONEW.2.out.xlsx" xl/drawings/drawing1.xml '<xdr:graphicFrame')
    k4d=$(zx count "$ONEW.2.out.xlsx" xl/drawings/_rels/drawing1.xml.rels 'charts/chart2.xml')
    k4e=$(zx count "$ONEW.2.out.xlsx" xl/drawings/_rels/drawing1.xml.rels 'Id="rId1"')
    k4f=$(count_matches -xF 'xl/charts/chart1.xml' "$B/k4-names1.out")
    echo "command: python3 -I -B <scratch>/w/zx.py names and count over <pair>.out.xlsx"
    echo "  pair 2: xl/charts/chart2.xml entries $k4a; xl/charts/chart1.xml entries $k4b; graphic frames in the drawing $k4c; drawing rels naming charts/chart2.xml $k4d; naming rId1 $k4e"
    echo "  pair 1: xl/charts/chart1.xml entries $k4f"
    k4_ok() { [ "$k4a$k4b$k4c$k4d$k4e" = 10110 ]; }
    check "K4: the replacement holds one frame on a new chart part, the removed chart part and its relationship gone (fix 4, ruling A)" "$(yn k4_ok)"
    check "K4 control: the same reading finds xl/charts/chart1.xml in the chartsheet as first written" "$(yn [ "$k4f" = 1 ])"
    echo "  the removal-alone test kept $(cat "$B/pairs-ALONE.n") pair(s): the chartsheet as first written and the remove_sheet write; its refused removal writes nothing (refused() keeps no output)"
    echo
    echo "### K5, fix 5: the moving-average period written (pair 9: 255; pair 8: 2)"
    k5a=$(zx count "$TRW.9.out.xlsx" xl/charts/chart1.xml '<c:period val="255"/>')
    k5b=$(zx count "$TRW.9.out.xlsx" xl/charts/chart1.xml '65535')
    k5c=$(zx count "$TRW.8.out.xlsx" xl/charts/chart1.xml '<c:period val="2"/>')
    k5d=$(zx count "$TRW.8.out.xlsx" xl/charts/chart1.xml '<c:period val="255"/>')
    echo "command: python3 -I -B <scratch>/w/zx.py count <pair>.out.xlsx xl/charts/chart1.xml <needle>"
    echo "  pair 9: period 255 $k5a; 65535 $k5b"
    echo "  pair 8: period 2 $k5c; period 255 $k5d"
    check "K5: pair 9 writes the period 255 and no 65535 (fix 5)" "$(yn [ "$k5a$k5b" = 10 ])"
    check "K5 control: pair 8 writes the period 2 and not 255" "$(yn [ "$k5c$k5d" = 10 ])"
    echo "  the field-rules test kept $(cat "$B/pairs-FIELD.n") pair(s): each refused call writes its input back"
    check "the reading program wrote nothing to its standard error" "$(yn [ ! -s "$B/zx.err" ])"
    
    echo
    echo "## the refusals of fixes 3, 4 and 5, read from the tests at the phase commit (specs/0045 ruling L (1); change NJ64)"
    cat >"$B/fnbody.py" <<'PY'
    """The body of a Rust test function, by name: from its fn line to the first
    line after it that is exactly "}", each printed as <line number><TAB><text>.
    Usage: fnbody.py <file.rs> <fn name>. Prints nothing when no fn has the name."""
    import sys
    
    lines = open(sys.argv[1], encoding="utf-8").read().split("\n")
    head = "fn %s() {" % sys.argv[2]
    starts = [k for k, l in enumerate(lines) if l == head]
    if len(starts) == 1:
        for k in range(starts[0], len(lines)):
            print("%d\t%s" % (k + 1, lines[k]))
            if k > starts[0] and lines[k] == "}":
                break
    PY
    sed 's/^/    /' "$B/fnbody.py"
    fnbody() { python3 -I -B "$B/fnbody.py" "$1" "$2" 2>>"$B/fnbody.err" </dev/null; }
    # line_of <body> <text>: the number of the one line whose text is exactly the
    # given text, or -1 when no line or more than one is.
    line_of() { awk -v t="$2" 'BEGIN { n = 0 } { s = $0; sub(/^[0-9]+\t/, "", s) } s == t { n++; k = $0; sub(/\t.*/, "", k) } END { if (n == 1) print k; else print -1 }' "$1"; }
    # text_at <body> <n>: the text of line n.
    text_at() { awk -v n="$2" '{ k = $0; sub(/\t.*/, "", k); s = $0; sub(/^[0-9]+\t/, "", s) } k == n { print s }' "$1"; }
    # lines_of <body> <array name>: line_of for each text of the array, in order.
    lines_of() { local -n texts=$2; local out=() t; for t in "${texts[@]}"; do out+=("$(line_of "$1" "$t")"); done; echo "${out[*]}"; }
    # ascending <n>...: the first is 0 or more and each is below the next.
    ascending() { local prev=-1 n; for n in "$@"; do [ "$n" -gt "$prev" ] || return 1; prev=$n; done; }
    # show_lines <array name> <numbers>: each text with its line number.
    show_lines() { local -n texts=$1; local -a nums; read -ra nums <<<"$2"; local i; for i in "${!texts[@]}"; do echo "    ${nums[$i]}: ${texts[$i]}"; done; }
    # pass_line <path>: the exact test's ok line in the seven tests' run, counted.
    pass_line() { count_matches -xF "test $1 ... ok" "$B/tests.out"; }
    printf '1\ta\n2\t  b\n3\t  b\n4\tc\n' >"$B/c-body"
    check "control: line_of finds a line once, and text_at reads it back (change NJ64)" "$(yn [ "$(line_of "$B/c-body" a)|$(text_at "$B/c-body" 2)" = "1|  b" ])"
    check "control: line_of refuses a line standing twice and one absent (change NJ64)" "$(yn [ "$(line_of "$B/c-body" '  b')$(line_of "$B/c-body" z)" = "-1-1" ])"
    check "control: ascending takes 1 4 9 (change NJ64)" "$(yn ascending 1 4 9)"
    asc_ctl() { ascending 4 1 || ascending -1 4; }
    check "control: the same test refuses a pair out of order and a missing line (change NJ64)" "$(ynnot asc_ctl)"
    RT_CW=crates/emend/src/package/tests/chart_write.rs
    RT_CS=crates/emend/src/package/tests/chartsheet.rs
    git show "$C:$RT_CW" >"$B/rt-cw.rs" || exit 2
    git show "$C:$RT_CS" >"$B/rt-cs.rs" || exit 2
    echo "command: git show <phase commit>:<test file>; python3 -I -B <scratch>/w/fnbody.py <copy> <test name>; each line read by its exact text (line_of), in source order"
    
    echo
    echo "### R3, fix 3: None refused and Marker taken"
    M3_TEXT=$(cut -f2 "$B/msg-SCATTER_STYLE_NONE.out")
    P3=package::tests::chart_write::a_new_scatter_plot_of_the_style_none_is_refused
    fnbody "$B/rt-cw.rs" a_new_scatter_plot_of_the_style_none_is_refused >"$B/r3.body"
    echo "  the message (M1, SCATTER_STYLE_NONE): $M3_TEXT"
    echo "  ${P3##*::} in $RT_CW: $(count_lines "$B/r3.body") lines; the lines read:"
    R3_TEXTS=(
      "    const NONE_STYLE: &str = \"$M3_TEXT\";"
      '    for chart in [first(ScatterStyle::None), second_of(ScatterStyle::None)] {'
      '        assert_package(call(box_anchor(), &chart).expect_err("refused"), NONE_STYLE);'
      '                .expect_err("refused"),'
      '    for chart in [first(ScatterStyle::Marker), second_of(ScatterStyle::Marker)] {'
      '        call(box_anchor(), &chart).expect("taken");'
      '            .expect("taken");'
    )
    R3_N=$(lines_of "$B/r3.body" R3_TEXTS)
    show_lines R3_TEXTS "$R3_N"
    read -ra r3n <<<"$R3_N"
    check "R3: the test holds the message, then None, in a first plot and a combined second, refused by add_chart and by add_chartsheet, then Marker taken by both, each line once and in that order (fix 3)" "$(yn ascending "${r3n[@]}")"
    echo "  test $P3 ... ok: $(pass_line "$P3")"
