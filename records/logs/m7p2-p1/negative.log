    """The body of a Rust test function, by name: from its fn line to the first
    line after it that is exactly "}", each printed as <line number><TAB><text>.
    Usage: fnbody.py <file.rs> <fn name>. Prints nothing when no fn has the name."""
    import sys
    
    lines = open(sys.argv[1], encoding="utf-8").read().split("\n")
    head = "fn %s() {" % sys.argv[2]
    starts = [k for k, l in enumerate(lines) if l == head]
    if len(starts) == 1:
        for k in range(starts[0], len(lines)):
            print("%d\t%s" % (k + 1, lines[k]))
            if k > starts[0] and lines[k] == "}":
                break
