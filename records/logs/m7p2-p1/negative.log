    echo "status lines: $st_all; of them admitted by the phase's pattern (this phase's logs, its records and planning's modified specs/0045 and ROADMAP.md): $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is admitted by the phase's pattern: this phase's logs, its records or planning's modified specs/0045 and ROADMAP.md (change NA64)" "$(yn status_accounted)"
    echo
    echo "## this run's directory removed (change HC)"
