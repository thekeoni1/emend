    check "each of the three messages is at the phase commit once, absent at the base, and in the committed spec's words (M1 to M3; change NC64)" "$(yn [ "$n_msg" = 3 ])"
    python3 -I -B "$B/messages.py" "$B/cw-now.rs" --name ZZ_PLANTED_ABSENT >"$B/msg-ctl.out" 2>&1 </dev/null
    python3 -I -B "$B/messages.py" "$B/cw-now.rs" --name ONE_CHART >"$B/msg-one.out" 2>&1 </dev/null
    echo "  control: --name ZZ_PLANTED_ABSENT finds $(count_lines "$B/msg-ctl.out") line(s); --name ONE_CHART, a constant at both commits, finds: $(sed 's/\t/ = /' "$B/msg-one.out")"
    check "control: the program finds nothing for a name no constant has" "$(yn [ "$(count_lines "$B/msg-ctl.out")" = 0 ])"
    check "control: the program finds the carried constant ONE_CHART once" "$(yn [ "$(count_lines "$B/msg-one.out")" = 1 ])"
    msg_ctl_spec() { [ "$(occurrences 'a planted message no spec holds' "$B/spec-flat.txt")" = 0 ]; }
    check "control: the spec reading finds no occurrence of a message the spec does not hold (change NI64)" "$(yn msg_ctl_spec)"
    printf 'x "a planted\n   wrapped message" y\n' | tr -s '[:space:]' ' ' >"$B/spec-plant.txt"
    n_plant=$(occurrences 'a planted wrapped message' "$B/spec-plant.txt")
    n_plant_abs=$(occurrences 'an absent planted message' "$B/spec-plant.txt")
    echo "  control: a planted text quoting a message wrapped across a line break: occurrences $n_plant; of a message it does not hold: $n_plant_abs"
    check "control: the same reading finds the planted wrapped message once and refuses an absent one (change NI64)" "$(yn [ "$n_plant$n_plant_abs" = 10 ])"
    
    echo
    echo "## the tests that cover the cases, at the phase commit (change ND64)"
    # Each line: the keep's key, the test file, the test's path in the crate.
    cat >"$B/tests.list" <<'TL'
    OFPIE crates/emend/src/package/tests/chart_write.rs package::tests::chart_write::an_of_pie_of_each_type_and_each_split_writes_its_form
    PLANT crates/emend/src/package/tests/protection.rs package::tests::protection::the_workbook_element_is_created_before_the_next_main_child_after_a_planted_one
    SCAT crates/emend/src/package/tests/chart_write.rs package::tests::chart_write::a_new_scatter_plot_of_the_style_none_is_refused
    ALONE crates/emend/src/package/tests/chartsheet.rs package::tests::chartsheet::a_removal_alone_on_a_chartsheet_is_refused
    ONEW crates/emend/src/package/tests/chartsheet.rs package::tests::chartsheet::a_chart_is_replaced_by_a_removal_and_an_addition_in_one_write
    FIELD crates/emend/src/package/tests/chart_write.rs package::tests::chart_write::the_trendline_and_error_bar_field_rules_are_refused
    TRW crates/emend/src/package/tests/chart_write.rs package::tests::chart_write::each_trendline_kind_writes_its_type_its_order_or_period_and_its_fields
    TL
    echo "command: count_matches -F 'fn <name>()' over git show <phase commit>:<file>, for each test"
    n_cov=0
    : >"$B/test-paths"
    while read -r key file path; do
      git show "$C:$file" >"$B/cov.rs" || exit 2
      name=${path##*::}
      n=$(count_matches -F "fn $name()" "$B/cov.rs")
      echo "  $key: $path in $file: $n"
      if [ "$n" = 1 ]; then n_cov=$((n_cov + 1)); fi
      echo "$path" >>"$B/test-paths"
    done <"$B/tests.list"
    check "each of the seven covering tests is at the phase commit, once (change ND64)" "$(yn [ "$n_cov" = 7 ])"
    git show "$C:crates/emend/src/package/tests/chartsheet.rs" >"$B/cov-sheet.rs" || exit 2
    git show "$REC:crates/emend/src/package/tests/chartsheet.rs" >"$B/cov-base.rs" || exit 2
    n_cov_ctl=$(count_matches -F "fn a_removal_leaves_the_chartsheet_s_drawing_empty()" "$B/cov-sheet.rs")
    n_cov_base=$(count_matches -F "fn a_removal_leaves_the_chartsheet_s_drawing_empty()" "$B/cov-base.rs")
    echo "  control: part 1's a_removal_leaves_the_chartsheet_s_drawing_empty in chartsheet.rs at the phase commit: $n_cov_ctl; at the base: $n_cov_base (ruling A's renaming)"
    check "control: the same count finds part 1's renamed test at the base once and not at the phase commit" "$(yn [ "$n_cov_ctl$n_cov_base" = 01 ])"
    
    echo
    echo "## the seven tests run on the host by exact name, with a keep (change NB64 and NE64)"
    mkdir "$B/keep" || exit 2
    mapfile -t PATHS <"$B/test-paths"
    echo "command: EMEND_KEEP_DIR=<scratch>/w/keep CARGO_TARGET_DIR=<build>/target cargo test -p emend --all-features --lib -- --exact <the seven paths> (both variables on this command alone; change NB64)"
    EMEND_KEEP_DIR=$B/keep CARGO_TARGET_DIR=$TARGET cargo test -p emend --all-features --lib -- --exact "${PATHS[@]}" >"$B/tests.out" 2>"$B/tests.err" </dev/null
    t_rc=$?
    echo "  exit $t_rc; standard output lines $(count_lines "$B/tests.out"); standard error lines $(count_lines "$B/tests.err")"
    LC_ALL=C "$G" -E '^(running |test result: )' "$B/tests.out" | sed 's/^/    /'
    n_ok=0
    for p in "${PATHS[@]}"; do
      k=$(count_matches -xF "test $p ... ok" "$B/tests.out")
