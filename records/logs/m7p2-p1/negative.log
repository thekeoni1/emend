    # (P) --pagesetup-sample:
    #       P0 the bare template: <sheetPr>, <printOptions>, <pageMargins>,
    #          <pageSetup> and <headerFooter> all created, exit 0, its line;
    #       P1 two <pageSetup/> after the sheetData: the part's message, "a
    #          worksheet has two sheetPr, autoFilter, printOptions, ...", from the
    #          settings pass;
    #       P1C one <pageSetup/>, the control for P1;
    #       P2 a <pageSetup/> and then a <pageMargins/>, the pageMargins out of
    #          schema order: the same message;
    #       P2C the <pageMargins/> before the <pageSetup/>, the control for P2;
    #       P3 two <headerFooter/>: the same message;
    #       P3C one <headerFooter/>, the control for P3.
    # Each refusal: exit 2, the error line exactly the message the committed
    # source holds, no stdout, no output file. Then the part's messages, read from
    # the source by constant name, compared as SETS with those reached here and
    # those the log states unreachable, each unreachable one with its reason and
    # the tests that cover it; and usage shapes.
    #
    # CARRIED TO M3 part 3 P2 from M3 part 3 P1's negative script (printed in
    # records/logs/m3p3-p1/negative.log, byte-identical to its copy kept on the
    # disk as <home>/.cache/emend-build/m3p3-p2/gen/negative-template-m3p3-p1.sh;
    # its change lists, P1's HA to HD and the earlier ones, follow below). Every
    # check, control and helper of the frame is that text's. What differs, and
    # why:
    #  IA. The phase, the log directory, the subjects and the build directories
    #      are M3 part 3 P2's. The base is M3 part 3 P1's record commit ("M3 part
    #      3 P1 record:"); the doc commit and the three code commits (the carry,
    #      the crate, the tool) by their full P2 subjects. The spec pin is
    #      specs/0025's blob at P2's doc commit, 6c6e87e3. The working file is
    #      printed, and the status pattern allows it modified: planning holds
    #      "Planning rulings during P2" uncommitted. The pattern allows this
    #      phase's logs and its records/m3p3-p2- and records/m3p3-open- stems.
    #  IB. One family, P0 to P3C, the generator gen-p2.py written for this phase:
    #      the template's sheetData given a tail of root children after it. The
    #      part's write message reached three ways (two pageSetup, one out of
    #      order, two headerFooter), each with its control. P1's apart record of
    #      part 3's two-elements message is dropped: no case here reaches it.
    #  IC. The part's messages are the constants package.rs defines under the
    #      Cargo feature sheetprops, compared as a SET with the constants the six
    #      bodies return: Parts::set_tab_color, set_sheet_view,
    #      set_page_margins, set_page_setup and set_header_footer (the private
    #      fns) and SettingsPass::observe; set_print_options records with no
    #      check and has no private body. "a sheet setting is out of range" and
    #      "a header or footer text is not valid" are stated unreachable through
    #      the tool (the sample's settings and texts are its constants), each
    #      with the crate tests that cover it and each test's body asserted to
    #      hold the message.
    #  ID. Nothing of P1's carried rules is dropped. This script removes no
    #      directory: the worktree goes by git worktree remove, the scratch
    #      directory is kept on the disk under <build>, and no rm of any form is
    #      run (specs/0024 P2 ruling 1 needs none here).
    #
    # P1's text:
    # Milestone 3 part 3 P1 negative.log (specs/0025-sheet-and-print-settings.md,
    # "P1": "The negative log through the binary: the sample on a fixture with two
    # <sheetPr> (refused, with a control)"). One family, --sheetview-sample, the
    # gate's host debug binary copied into a detached worktree of the phase commit
    # and checked against gate.log's hash, on fictional packages this log builds
    # from the phase commit's template files. The template's worksheet holds an
    # empty sheetData alone (no sheetPr, no dimension, no sheetViews), its root
    # binds no relationships prefix:
    #
    # (S) --sheetview-sample:
    #       S0 the bare template: <sheetPr> and <sheetViews> both created, exit 0,
    #          its line;
    #       S1 two <sheetPr/> before the sheetData: the part's new message, "a
    #          worksheet has two sheetPr, ...", from the settings pass;
    #       S1C one <sheetPr/>, the control for S1;
    #       S2 a <dimension> and then a <sheetPr/>, the sheetPr out of schema
    #          order: the same message;
    #       S2C the <sheetPr/> before the <dimension>, the control for S2;
    #       S3 two <sheetViews>, each holding one <sheetView>: part 3's message
    #          for two cols, sheetViews or mergeCells elements;
    #       S3C one <sheetViews>, the control for S3.
    # Each refusal: exit 2, the error line exactly the message the committed
    # source holds, no stdout, no output file. Then the part's messages, read from
    # the source by constant name, compared as SETS with those reached here and
    # those the log states unreachable, the unreachable one with its reason and
    # the test that covers it; and usage shapes.
    #
    # CARRIED TO M3 part 3 P1 from M3 part 2 P3's negative script (printed in
    # records/logs/m3p2-p3/negative.log, byte-identical to its copy kept on the
    # disk under <home>/.cache/emend-build/m3p2-p3/scripts, which this phase keeps
    # as <home>/.cache/emend-build/m3p3-p1/gen/negative-template-m3p2-p3.sh; its
    # change lists GA to GD stand in that log). Every check, control and helper
    # of the frame is that text's (the entry and exit checks, the shape greps,
    # the role checks, the roots, the gate binary's copy and hash, the message
    # reader messages.py and the body reader returns.py with their controls, the
    # spec lookup, run_bin and its predicates, the set comparison, the usage
    # shapes, the byte count, the status and stderr checks). What differs, and
    # why:
    #  HA. The phase, the log directory, the subjects and the build directories
    #      are M3 part 3 P1's. The base is M3 part 2's close-out record commit
    #      ("M3 part 2 close-out record:"); the doc commit and the three code
    #      commits (the carry, the crate, the tool) by their full P1 subjects.
    #      The spec pin is specs/0025's blob at P1's doc commit, c15d68d2. The
    #      working file is printed, and the status pattern allows it modified:
    #      planning holds "Planning rulings during P1" uncommitted. The pattern
    #      allows this phase's logs and its records/m3p3-p1- and records/m3p3-open-
    #      stems.
    #  HB. One family, S0 to S3C, the generator gen-p1.py written for this phase:
    #      the template's sheetData given a head of root children before it. The
    #      new write message reached two ways (two sheetPr, one out of order),
    #      part 3's message once (two sheetViews), each with its control.
    #  HC. The part's messages are the constants package.rs defines under the
    #      Cargo feature sheetprops (a reader printed below takes each const
    #      whose line follows #[cfg(feature = "sheetprops")]), compared as a SET
    #      with the constants the three bodies return: Parts::set_tab_color,
    #      Parts::set_sheet_view (the private fns) and SettingsPass::observe.
    #      Part 3's two-elements message is recorded apart (as P3 recorded the
    #      index message), since it is not the part's. "a sheet setting is out of
    #      range" is stated unreachable through the tool (the sample's colour and
    #      zoom are its constants), with the crate test that covers it and the
    #      test's body asserted to hold the message. "Errors"' other shared
    #      messages are every edit's, not the sample's constants, and earlier
    #      parts' negative logs reach them; they are printed, not accounted.
    #  HD. Nothing of P3's carried rules is dropped. This script removes no
    #      directory: the worktree goes by git worktree remove, the scratch
    #      directory is kept on the disk under <build>, and no rm of any form is
    #      run (specs/0024 P2 ruling 1 needs none here).
    #
    # Usage: m7p2-p1-negative.sh <phase commit> > <file outside the tree>,
    # PLANNING_SPEC and PLANNING_ROADMAP set to the working files' sha256 when
    # planning holds them uncommitted, NEGATIVE_BUILD for a dry run's directory
    # (specs/0043 ruling Q); the caller moves the output to
    # records/logs/m7p2-p1/negative.log (change NA64).
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/negative.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    unset EMEND_CORPUS_DIR EMEND_KEEP_DIR RUSTDOCFLAGS RUSTFLAGS CARGO_TARGET_DIR
    # Change MJ: P2 verification ruling 6, and every script's offline cargo
    # setting (this log runs cargo offline, change NB64), each printed as an
    # input line.
    export PYTHONDONTWRITEBYTECODE=1
    export CARGO_NET_OFFLINE=true
    PHASE_DIR=$HOME/.cache/emend-build/m7p2-p1
    BUILD_ROOT=${NEGATIVE_BUILD:-$PHASE_DIR/negative}
    # Change NG62 (specs/0043 ruling Q): the build root is this run's to make.
    if [ -e "$BUILD_ROOT" ]; then echo "the build root $BUILD_ROOT is already there; move it aside first" >&2; exit 2; fi
    # Change NB64: the cargo target of this log's one build, under <build>.
    TARGET=$BUILD_ROOT/target
    SUPERSEDED_DIR=$PHASE_DIR/superseded
    SPEC=specs/0045-publish.md
    SPEC_WANT=f2adb17a7421940ca97270dcc9cbc65586d74c0b14559e240bfb0137d7f25678
    ROADMAP_WANT=3106f10d4bf6f7ad3fa356cb5b8460ab62b24ced9a8cbb32767eb83f364c25bb
    # Change NA64: the working spec holds planning's rulings written during
    # M7 part 2 P1 (A to F), not yet committed; PLANNING_SPEC names its sha256
    # when it is given, and the working file is checked against it below, or
    # against the phase commit's blob when it is not (the doc commit committed
    # specs/0045 at f2adb17a). PLANNING_ROADMAP does the same for ROADMAP.md
    # (committed at 3106f10d; ruling F's row).
    PLANNING_SPEC=${PLANNING_SPEC:-}
    PLANNING_ROADMAP=${PLANNING_ROADMAP:-}
    mkdir -p "$BUILD_ROOT" || exit 2
    # Change MP (close-out ruling 1): TMPDIR is <build>/tmp, written
    # <scratch>/tmp, made before any mktemp; every mktemp below takes it.
    TMPDIR=$BUILD_ROOT/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    # Change HC: this run's own directory, removed at the end (in TMPDIR,
    # change MP).
    B=$(mktemp -d) || exit 2
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    present() { [ -e "$1" ]; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    SHORT_SHA=${C:0:7}
    # What the status pattern admits (M4 part 2 P1 verification ruling 3; change
    # NA64): this phase's logs, its records (the run and size logs write them,
    # named by the phase commit's short sha) and planning's modified specs/0045
    # and ROADMAP.md.
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m7p2-p1/|\\?\\? records/(m7p2-[a-z0-9]+(-[a-z0-9]+)*|size-m7p2)-[0-9]{4}-[0-9]{2}-[0-9]{2}-$SHORT_SHA[.](md|txt)\$| M specs/0045-publish[.]md\$| M ROADMAP[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs, its records and planning's modified spec and ROADMAP.md" >&2
      exit 2
    fi
    
    scrub() {
      sed -e "s#$MAIN#<repo>#g" -e "s#$SELF_DIR#<scripts>#g" -e "s#$B#<scratch>/w#g" -e "s#$TMPDIR#<scratch>/tmp#g" \
        -e "s#$BUILD_ROOT#<build>#g" -e "s#$SUPERSEDED_DIR#<superseded>#g" -e "s#$PHASE_DIR#<phase>#g" \
        -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "input: RERUN_NOTE: ${RERUN_NOTE:-unset}"
    echo "input: RERUN_FILES: ${RERUN_FILES:-unset}"
    echo "input: PLANNING_SPEC: ${PLANNING_SPEC:-unset} (the working spec's sha256, planning's rulings during M7 part 2 P1 when it is given; when unset, the working file must be the phase commit's; change NA64)"
    echo "input: PLANNING_ROADMAP: ${PLANNING_ROADMAP:-unset} (the working ROADMAP.md's sha256 when planning holds it modified; when unset, the working file must be the phase commit's; change NA64)"
    echo "input: PYTHONDONTWRITEBYTECODE: ${PYTHONDONTWRITEBYTECODE:-unset} (exported 1 by this script; P2 verification ruling 6; change MJ)"
    echo "input: CARGO_NET_OFFLINE: ${CARGO_NET_OFFLINE:-unset} (exported true by this script; this log's cargo runs offline; changes MJ and NB64)"
    echo "input: TMPDIR=<scratch>/tmp (exported by this script before any mktemp: <build>/tmp, made if missing; close-out ruling 1; change MP)"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: HOME: set, read for the paths under it, printed as <home>"
    echo "input: NEGATIVE_BUILD: ${NEGATIVE_BUILD:-unset} (the build root, <build>; refused when there at entry; changes NG62 and NG64)"
    echo "input: CARGO_TARGET_DIR: unset by this script, set to <build>/target on each cargo command alone (change NB64)"
    echo "about: M7 part 2 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "names: in the carried history's text, this phase is the phase that wrote it; this log, M7 part 2 P1's, reads the three new messages (M1 to M3), finds the seven covering tests, runs them by exact name with a keep, and reads the kept outputs for each fix (K1 to K5) (change NA64)"
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    P3=python3
    # Change MQ: a Python call is a line that is not a comment where python3
    # is followed by whitespace and an option, `-` or a path ending .py; PYB
    # counts those without `-I -B` after python3.
    PY_CALL="^[[:space:]]*([^#[:space:]].*[^-[:alnum:]_/.])?${P3}[[:space:]]+(-|[^[:space:]]+[.]py)"
    PY_IB="${P3}[[:space:]]+-I[[:space:]]+-B([[:space:]]|\$)"
    # pyb_count <file>: the calls in <file> without -I -B.
    pyb_count() { LC_ALL=C "$G" -E "$PY_CALL" "$1" | LC_ALL=C "$G" -cvE "$PY_IB"; }
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" "  ${P3} -c 'x'" "  ${P3} -I -B -c 'x'" "# ${P3} -c 'x'" "command -v ${P3}" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape; for PYB, the call form then the lines without -I -B"
    for shape in CHAIN BANG ASSIGN PYB; do
      if [ "$shape" = PYB ]; then
        n_self=$(pyb_count "$SELF")
        n_fix=$(pyb_count "$B/shape-fixture")
      else
        var=SHAPE_$shape
        n_self=$(count_matches -E "${!var}" "$SELF")
        n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      fi
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    n_calls_fix=$(count_matches -E "$PY_CALL" "$B/shape-fixture")
    echo "  Python calls in the fixture by the call form: $n_calls_fix (the one without -I -B and the one with; the comment and command -v are not calls)"
    check "control: the call form counts the fixture's two calls and neither the comment nor command -v" "$(yn [ "$n_calls_fix" = 2 ])"
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change NF41 (rulings Z and AD, specs/0038 "Generator rules"; ruling AK a):
    # the defined-helper check over this script's own source, gen/defined.py's
    # program carried here with is and isnot read as yn and ynnot are, with its
    # planted controls; and yn and ynnot themselves defined. The planted calls
    # are built from pieces, so this text holds no call of an undefined name.
    cat >"$B/defined.py" <<'DEFINED'
    import re
    import sys
    
    CALL = re.compile(r"\$\((?:yn|ynnot|is|isnot) ([^ )\"]+)")
    WRAP = re.compile(r"\$\((yn|ynnot|is|isnot) ")
    DEF = re.compile(r"^[ \t]*([A-Za-z_][A-Za-z0-9_]*)\(\) \{", re.M)
    
    
    def calls(script, form):
        called = set()
        for line in script.split("\n"):
            if line.lstrip().startswith("#"):
                continue
            called.update(form.findall(line))
        return called
    
    
    commands = sys.argv[1].split()
    for path in sys.argv[2:]:
        name = path.rsplit("/", 1)[-1]
        text = open(path, encoding="utf-8").read()
        defined = set(DEF.findall(text))
        called = calls(text, CALL)
        missing = sorted(n for n in called if n not in commands and n not in defined)
        wcalled = sorted(calls(text, WRAP))
        wmissing = [w for w in wcalled if w not in defined]
        print("%s: names called %d; undefined: %s; wrappers called: %s; wrappers undefined: %s"
              % (name, len(called), " ".join(missing) or "none", " ".join(wcalled) or "none",
                 " ".join(wmissing) or "none"))
    DEFINED
    echo "command: python3 -I -B <scratch>/w/defined.py '[ cmp true' <scripts>/$(basename "$SELF"), and the same over a copy of this script with one planted call of an undefined helper, over a planted script calling an undefined helper through is, and over a planted script that calls yn and defines neither yn nor ynnot (the program printed below; rulings Z, AD and AK a; change NF41)"
    sed 's/^/    /' "$B/defined.py"
    python3 -I -B "$B/defined.py" "[ cmp true" "$SELF" >"$B/def-self.out" 2>"$B/def-self.err" </dev/null
    def_rc=$?
    sed 's/^/    /' "$B/def-self.out"
    echo "  exit $def_rc; stderr bytes $(wc -c <"$B/def-self.err")"
    def_self_ok() { [ "$def_rc" = 0 ] && [ ! -s "$B/def-self.err" ] && [ "$(count_matches -F '; undefined: none; wrappers called: yn ynnot; wrappers undefined: none' "$B/def-self.out")" = 1 ]; }
    check "every helper a yn, ynnot, is or isnot call of this script names is defined in it, and yn and ynnot, the two it calls, are themselves defined (rulings Z, AD and AK a; change NF41)" "$(yn def_self_ok)"
    { cat "$SELF"; printf '%s\n' "zz=\$""(yn zz_planted_undefined_helper)"; } >"$B/def-plant.sh"
    python3 -I -B "$B/defined.py" "[ cmp true" "$B/def-plant.sh" >"$B/def-plant.out" 2>&1 </dev/null
    echo "  over the planted copy: $(cat "$B/def-plant.out")"
    def_plant_ok() { [ "$(count_matches -F '; undefined: zz_planted_undefined_helper; ' "$B/def-plant.out")" = 1 ]; }
    check "control: the same check names the one planted undefined helper in a copy of this script (ruling Z)" "$(yn def_plant_ok)"
    printf '%s\n' 'is() { :; }' "x=\$""(is f)" >"$B/def-is.sh"
    python3 -I -B "$B/defined.py" "[ cmp true" "$B/def-is.sh" >"$B/def-is.out" 2>&1 </dev/null
    echo "  over a planted script defining is and calling is f: $(cat "$B/def-is.out")"
    def_is_ok() { [ "$(count_matches -F '; undefined: f; wrappers called: is; wrappers undefined: none' "$B/def-is.out")" = 1 ]; }
    check "control: the same check reads an is call and names its undefined helper (ruling AK a)" "$(yn def_is_ok)"
    printf '%s\n' 'f() { :; }' "x=\$""(yn f)" >"$B/def-noyn.sh"
    python3 -I -B "$B/defined.py" "[ cmp true" "$B/def-noyn.sh" >"$B/def-noyn.out" 2>&1 </dev/null
    echo "  over a planted script defining f and calling yn f: $(cat "$B/def-noyn.out")"
    def_noyn_ok() { [ "$(count_matches -F '; wrappers called: yn; wrappers undefined: yn' "$B/def-noyn.out")" = 1 ]; }
    check "control: the same check refuses a planted script that calls yn and defines neither yn nor ynnot (ruling AD)" "$(yn def_noyn_ok)"
    # Change NF42 (planning's verification of P1, ruling D): this script's own
    # placeholder check, the scan's rule, printed with its planted controls:
    # every lower-case angle-bracketed token printed before a slash, and every
    # scrub target of a sed s# expression, is declared by a root line saying
    # the token stands for something. The planted tokens are built from
    # pieces, so this text holds none.
    ph_used() {
      {
        LC_ALL=C "$G" -a -o -E 's#[^#]*#<[a-z][a-z0-9_-]*>' "$1" | LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>$'
        LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>/' "$1" | sed 's#/$##'
      } | LC_ALL=C sort -u
    }
    ph_declared() {
      LC_ALL=C "$G" -a -E '(^|echo ")root: ' "$1" | LC_ALL=C "$G" -a -o -E '<[a-z][a-z0-9_-]*>(/[a-z0-9]+)? stands for' |
        LC_ALL=C "$G" -a -o -E '^<[a-z][a-z0-9_-]*>' | LC_ALL=C sort -u
    }
    ph_undeclared() { LC_ALL=C comm -23 <(ph_used "$1") <(ph_declared "$1") | count_lines /dev/stdin; }
    PH_L='<'
    printf 'echo "root: %srepo> stands for x"\necho "read %srepo>/a and %szzph>/b"\n' "$PH_L" "$PH_L" "$PH_L" >"$B/ph-bad"
    printf 'echo "root: %srepo> stands for x; %szzph> stands for y"\necho "read %srepo>/a and %szzph>/b"\n' "$PH_L" "$PH_L" "$PH_L" "$PH_L" >"$B/ph-ok"
    printf '  sed -e "s#$X#%szzscrub>#g"\necho "root: %srepo> stands for x"\n' "$PH_L" "$PH_L" >"$B/ph-scrub"
    echo "command: the scan's placeholder rule (the tokens printed before a slash and the sed scrub targets, less those a root line declares) over this script's own source, and over three planted files (planning's verification of P1, ruling D; change NF42)"
    echo "  this script: placeholders $(ph_used "$SELF" | tr '\n' ' '); declared by root lines $(ph_declared "$SELF" | tr '\n' ' '); undeclared $(ph_undeclared "$SELF")"
