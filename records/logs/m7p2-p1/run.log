    #  YF. Change XF's form for four samples: every sample, the copy sample
    #      included, compared on both targets with P3's run directory for it,
    #      its outputs by sha256, its lines and its diff tables byte for byte,
    #      every workbook's outcome and exit equal; the run directories read
    #      from the "the run directories:" line of P3's run log at P3's record
    #      commit and checked against the run directory P3's committed copy
    #      record names.
    #  YJ. Change XJ's record pair for each of the four samples: the copy
    #      sample's as P3's, and the three earlier samples' through the same
    #      record script and record check, their families derived from their
    #      entries tables; ten record files installed, eight when the keep is
    #      skipped.
    #  YK. Ruling 8 of the planning rulings during P2 and ruling 10 of those
    #      during P3: the phase's target root is <target>, <home>/.cache/
    #      emend-build/m3p6-p4/target; the keep's tests build into <target>/main
    #      (CARGO_TARGET_DIR), where size.log built the release binaries this
    #      log runs; nothing here cleans it. VK stands: this script runs no
    #      `rm -rf`.
    #
    #
    #
    # CARRIED TO M3 part 7 P3 from M3 part 6 P4's run script (at the phase
    # commit 9cfd92e, printed in records/logs/m3p6-p4/run.log; its change lists
    # up to YK are above), generated by <home>/.cache/emend-build/m3p7-p3/gen/
    # run.py, every replacement asserted to occur as often as it says, the top
    # summary replaced, the keep and open-check sections removed, and the body
    # grepped afterwards for part 6 P4's names, subjects and tokens.
    # copycmp.py and copysurvey.py are part 6 P4's, copied beside this script
    # byte for byte. What differs, and why:
    #  RNA. The phase, the log directory, the subjects and the script directory
    #       (<scripts>, <home>/.cache/emend-build/m3p7-p3/scripts, on the disk)
    #       are this phase's; the base is part 7 P2's record commit ("M3 part 7
    #       P2 record:"); the phase commit is P3's code commit by its subject
    #       ("M3 part 7 P3: rust-version equal to the pin, and the gate checks
    #       the pins agree"); the four samples each have a run directory
    #       <runs>/<date>-<sha>-<sample> and a record stem
    #       m3p7-p3-<sample>-<date>-<sha> (specs/0029 "Harness runs"); the spec
    #       is specs/0029, pinned through SPEC_SHA at this phase's doc commit. The usage
    #       takes the size.log as its second argument, and no test.log.
    #  RNB. The run directories the four samples are compared with are part 6
    #       P4's, named by its record commit, resolved by its subject ("M3 part 6
    #       P4 record:"; no hash is typed here), an ancestor of the phase commit,
    #       read from the "the run directories:" line of part 6 P4's run log at
    #       that commit and checked against the run directory its committed copy
    #       record names.
    #  RNC. The keep and the open check go, with their inputs (RUN_KEEP,
    #       RUN_SKIP_KEEP, SUPERSEDED_KEEP), the test.log argument, the <keep>
    #       root and the open record's stem: specs/0029 "Harness runs" names the
    #       four samples alone. The record files installed are the four pairs,
    #       eight.
    #  RND. Each sample's record header names its binaries (specs/0029 item 5):
    #       the .md holds one "- Binaries (host)" and one "- Binaries (i686)"
    #       line whose two hashes are the binaries this log ran, with a control.
    #  RNE. The size.log is this phase's (its "about:" line names P3's phase
    #       commit).
    #  RNF. The phase's target root is <target>, <home>/.cache/emend-build/
    #       m3p7-p3/target (specs/0001 "Rules for every phase", one target root
    #       per phase); this log builds nothing and runs the release binaries
    #       size.log built in <target>/main.
    #  RNG. The runner gives each child its own TMPDIR under its own work
    #       directory, under <work>/tmp-run here (specs/0029 P1 ruling 2); the
    #       check that <work>/tmp-run is empty after each run stands.
    #
    # Usage: m7p2-p1-run.sh <phase commit> <gate log> > <file outside the tree>;
    # the caller moves the output to records/logs/m7p2-p1/run.log (change TB).
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    GATE_LOG=${2:?the gate log required}
    # Every environment input, as it was set, before any is unset (change TB:
    # PLANNING_ROADMAP added, STAGE_ROOT gone with the stage).
    INPUT_NAMES="RERUN_NOTE RERUN_FILES PLANNING_SPEC PLANNING_ROADMAP RUN_RELEASE_DIR RUN_OUT_ROOT RUN_IDS RUN_FLAGS RUN_KEEP RUN_SKIP_KEEP RUN_OPEN_RECORD RECORDS_DEST EMEND_CORPUS_DIR EMEND_KEEP_DIR HOME"
    OVERRIDES="RUN_RELEASE_DIR RUN_OUT_ROOT RUN_IDS RUN_FLAGS RUN_KEEP RUN_SKIP_KEEP RUN_OPEN_RECORD RECORDS_DEST"
    declare -A INPUT_SEEN
    for v in $INPUT_NAMES; do
      if [ -n "${!v+x}" ]; then INPUT_SEEN[$v]=${!v}; else INPUT_SEEN[$v]=unset; fi
    done
    LOGGED=yes
    for v in $OVERRIDES; do
      if [ "${INPUT_SEEN[$v]}" != unset ]; then LOGGED=no; fi
    done
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    # Python writes no bytecode, so nothing arises to be removed.
    export PYTHONDONTWRITEBYTECODE=1
    # Every cargo command of this log runs offline; the two settings are printed below.
    export CARGO_NET_OFFLINE=true
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR RUSTDOCFLAGS RUSTFLAGS
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    # The open check's timeout and the runner's of every rerun, as part 1's
    # reruns took them (specs/0044 ruling A; specs/0045 "P1's logs").
    LO_TIMEOUT_S=600
    TIMEOUT_S=300
    SPEC=specs/0045-publish.md
    # Change TB: the committed blob the doc commit holds (the generator asserts
    # it); the phase commit is the docs commit at the range's tip.
    SPEC_WANT=f2adb17a7421940ca97270dcc9cbc65586d74c0b14559e240bfb0137d7f25678
    PLANNING_SPEC=${PLANNING_SPEC:-}
    PLANNING_ROADMAP=${PLANNING_ROADMAP:-}
    # Rulings A and G of specs/0045: the open record the keep is compared with,
    # part 1's, by totals and by pair names (change TE).
    PREV_OPEN=records/m7p1-open-2026-10-25-82c07fb
    # Each sample's part 1 record is records/m7p1-<name>-$PREV_RUN.md (change TD).
    PREV_RUN=2026-10-25-82c07fb
    # Part 1's Excel record, read for the 8 re-kept pairs' output hashes and
    # the 32 names of its finding 5 (ruling C; change TF).
    EXCEL_REC=records/excel-check-m7-2026-10-26.md
    PHASE_DIR=$HOME/.cache/emend-build/m7p2-p1
    # The phase's one target root; the gate built the release binaries into
    # <target>/main, and the keep's tests run there (no other build).
    TARGET_ROOT=$PHASE_DIR/target
    BUILD_ROOT=$TARGET_ROOT/main
    RELEASE_DIR=${RUN_RELEASE_DIR:-$BUILD_ROOT/release}
    KEEP=${RUN_KEEP:-$PHASE_DIR/keep-host}
    RUN_SKIP_KEEP=${RUN_SKIP_KEEP:-no}
    case $RUN_SKIP_KEEP in yes | no) ;; *) echo "RUN_SKIP_KEEP is yes or no" >&2; exit 2 ;; esac
    RUN_OPEN_RECORD=${RUN_OPEN_RECORD:-}
    RUN_OUT_ROOT=${RUN_OUT_ROOT:-$CORPUS/runs}
    RECORDS_DEST=${RECORDS_DEST:-records}
    RUN_IDS=${RUN_IDS:-}
    RUN_FLAGS=${RUN_FLAGS:-}
    if [ -n "$RUN_IDS" ] && [ ! -f "$RUN_IDS" ]; then echo "RUN_IDS names no file" >&2; exit 2; fi
    if [ "$RUN_SKIP_KEEP" = yes ]; then
      if [ ! -d "$KEEP" ]; then echo "RUN_SKIP_KEEP=yes needs RUN_KEEP to name a keep directory" >&2; exit 2; fi
      if [ -z "$RUN_OPEN_RECORD" ]; then echo "RUN_SKIP_KEEP=yes needs RUN_OPEN_RECORD" >&2; exit 2; fi
      if git cat-file -e "$C:$RUN_OPEN_RECORD.txt" 2>/dev/null; then :; else echo "RUN_OPEN_RECORD names no record at the phase commit" >&2; exit 2; fi
    else
      if [ -e "$KEEP" ]; then echo "$KEEP is already there; this run makes it (ruling F)" >&2; exit 2; fi
      if [ -n "$RUN_OPEN_RECORD" ]; then echo "RUN_OPEN_RECORD is for RUN_SKIP_KEEP=yes alone" >&2; exit 2; fi
    fi
    SHORT=$(git rev-parse --short=7 "$C")
    DATE=$(date -u +%Y-%m-%d)
    RUN=$DATE-$SHORT
    STEM_OPEN=m7p2-open-$RUN
    # TMPDIR is <scratch>/tmp, the phase's directory's, made and exported before
    # any mktemp; the working directory is the one mktemp -d makes under it, on
    # the disk, kept; nothing here is removed.
    TMPDIR=$PHASE_DIR/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    B=$(mktemp -d) || exit 2
    mkdir "$B/bin" "$B/records" "$B/tmp-run" "$B/tmp" "$B/prev" || exit 2
    RECORDS=$B/records
    RUNTMP=$B/tmp-run
    # The counting library is the phase commit's, by git show.
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    if [ ! -f "$GATE_LOG" ]; then echo "the gate log is not a file" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    # Change TB: what the status pattern admits: this phase's log directory, its
    # record files (named by the run's date and the phase commit's short sha,
    # untracked: the samples' and the open record's m7p2- pairs, and the size
    # log's size-m7p2- record) and planning's modified specs/0045 and
    # ROADMAP.md; nothing else.
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m7p2-p1/|\\?\\? records/(m7p2-[a-z0-9-]+|size-m7p2)-$DATE-$SHORT[.](md|txt)\$| M specs/0045-publish[.]md\$| M ROADMAP[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs, records and planning's spec" >&2
      exit 2
    fi
    
    # Change RV: the gate's release binaries, copied into <work>/bin; the copies
    # are what this log runs.
    for b in emend-copy xlsx-diff; do
      if [ ! -x "$RELEASE_DIR/$b" ]; then echo "the gate's release $b is not there" >&2; exit 2; fi
      cp "$RELEASE_DIR/$b" "$B/bin/$b" || exit 2
    done
    PT=$B/bin/emend-copy
    XD=$B/bin/xlsx-diff
    # Change TC: the six samples specs/0045 "P1's logs" names, in its order (the
    # formula sample, then the five whose outputs part 1's Excel record names),
    # each checked against the binary's own usage text: its usage error, the
    # run with no argument, read for every word ending in -sample.
    SIX="--formula-sample --chart-surface-sample --protect-sample --edit-sample --remove-sample --chartsheet-sample"
    "$PT" >"$B/usage.out" 2>&1 </dev/null
    USAGE_RC=$?
    LC_ALL=C "$G" -o -E -- '--[a-z0-9-]*-sample' "$B/usage.out" >"$B/usage.flags"
    : >"$B/run.flags"
    for f in $SIX; do
      if [ -n "$RUN_FLAGS" ]; then
        case " $RUN_FLAGS " in *" $f "*) ;; *) continue ;; esac
      fi
      printf '%s\n' "$f" >>"$B/run.flags"
    done
    if [ -n "$RUN_FLAGS" ]; then
      for f in $RUN_FLAGS; do
        if [ "$(count_matches -xF "$f" "$B/run.flags")" != 1 ]; then echo "RUN_FLAGS names $f, which is not one of the six samples of specs/0045" >&2; exit 2; fi
      done
    fi
    if [ "$(count_matches -xF --formula-sample "$B/run.flags")" != 1 ]; then echo "the flags run do not hold --formula-sample (a dry run's subset holds it too)" >&2; exit 2; fi
    name_of() { local n=${1#--}; printf '%s\n' "${n%-sample}"; }
    # The run directories and record files this log writes, each refused if it
    # is there already.
    while IFS= read -r f; do
      n=$(name_of "$f")
      if [ -e "$RUN_OUT_ROOT/$RUN-$n" ]; then echo "$RUN_OUT_ROOT/$RUN-$n is already there; name a fresh run" >&2; exit 2; fi
      for x in md txt; do
        if [ -e "$RECORDS_DEST/m7p2-$n-$RUN.$x" ]; then echo "$RECORDS_DEST/m7p2-$n-$RUN.$x is already there; move it aside first" >&2; exit 2; fi
      done
    done <"$B/run.flags"
    for x in md txt; do
      if [ -e "$RECORDS_DEST/$STEM_OPEN.$x" ]; then echo "$RECORDS_DEST/$STEM_OPEN.$x is already there; move it aside first" >&2; exit 2; fi
    done
    
    # The keep and the runs root before the corpus, the phase's directories
    # before <phase>, and <home> last (change TB: no stage).
    scrub() {
      sed -e "s#$B#<work>#g" -e "s#$TMPDIR#<scratch>/tmp#g" -e "s#$SELF_DIR#<scripts>#g" \
        -e "s#$KEEP#<keep>#g" -e "s#$TARGET_ROOT#<target>#g" -e "s#$RUN_OUT_ROOT#<runs>#g" -e "s#$CORPUS#<corpus>#g" \
        -e "s#$MAIN#<repo>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M7 part 2 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # The environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo "input (as exported by this script): PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE CARGO_NET_OFFLINE=$CARGO_NET_OFFLINE"
    echo "input: TMPDIR=$TMPDIR"
    echo "  (TMPDIR set, made and exported by this script before any mktemp; <work> is made under it)"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: the gate log (the second argument): $GATE_LOG"
    if [ "$LOGGED" = yes ]; then
      echo "mode: the logged run: none of the dry run's overrides is set ($OVERRIDES), so the whole set's counts are judged (change TB)"
    else
      echo "mode: a dry run (specs/0044 ruling I's form): an override is set; the counts of the whole set are not judged, the comparisons are printed and not judged, and nothing is written under <corpus>/runs unless an override left it there"
    fi
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change NTJ: the fourth shape, PYB: a Python call without -I -B (the word
    # followed by whitespace and an option or a .py path, outside a comment,
    # and not by " -I -B"). The word is built from two halves, so that this
    # form's own text is no call.
    PYW=pyth
    PYW=${PYW}on3
    pyb_count() {
      awk -v w="$PYW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { r = substr(s, i + length(w)); if (r ~ /^[ \t]+(-|[^ \t]*[.]py([ \t"]|$))/ && r !~ /^ -I -B( |$)/) { n++; break }; s = r }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "$PYW -c x" "$PYW -I -B -c x" "# $PYW -c x" "command -v $PYW" "$PYW tool.py" >"$B/pyb-fixture"
    n_self=$(pyb_count "$SELF")
    n_fix=$(pyb_count "$B/pyb-fixture")
    echo "command: pyb_count <this script>, and the same over a fixture of five lines: a call with -c, one with -I -B -c, a comment, a command -v, a call of a .py path"
    echo "  shape PYB: in this script $n_self; in the fixture $n_fix"
    check "PYB: this script holds none (change NTJ)" "$(yn [ "$n_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's two calls without -I -B and not its other three lines" "$(yn [ "$n_fix" = 2 ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M7 part 1 close-out record: the push, the CI run and the scan')
    DOC=$(by_subject "M7 part 2 P1: commit planning docs (the part 2 spec, part 1's close-out verification)")
    FIX1=$(by_subject 'M7 part 2 P1: an of-pie with no split writes no splitType')
    FIX2=$(by_subject 'M7 part 2 P1: a created workbook element goes before the next main child')
    FIX3=$(by_subject 'M7 part 2 P1: a new scatter plot of the style none is refused')
    FIX4=$(by_subject 'M7 part 2 P1: a chartsheet keeps its chart')
    FIX5=$(by_subject 'M7 part 2 P1: a moving-average period is 2 to 255')
    DOCS=$(by_subject 'M7 part 2 P1: the README and the CHANGELOG name the three limits')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  M7 part 1's close-out record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  fix 1 (the of-pie split): ${FIX1:-none}"
    echo "  fix 2 (the workbook insertion rule): ${FIX2:-none}"
    echo "  fix 3 (the scatter style none): ${FIX3:-none}"
    echo "  fix 4 (a chartsheet keeps its chart): ${FIX4:-none}"
    echo "  fix 5 (the moving-average period): ${FIX5:-none}"
    echo "  the docs commit, the phase commit (the three limits): ${DOCS:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~7"
    for k in 0 1 2 3 4 5 6 7; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$DOCS" "$FIX5" "$FIX4" "$FIX3" "$FIX2" "$FIX1" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the docs commit, the five code commits, the doc commit and the base, each the next one's child, the docs commit the phase commit (change TB)" "$(yn roles_in_order)"
    roles_ctl() { local DOCS=$REC; roles_in_order; }
    check "control: roles_in_order refuses the base named as the phase commit" "$(ynnot roles_ctl)"
    roles_swap_ctl() { local FIX1=$FIX2 FIX2=$FIX1; roles_in_order; }
    check "control: roles_in_order refuses fixes 1 and 2 named in each other's place" "$(ynnot roles_swap_ctl)"
    roles_ctl2() { local REC=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the base" "$(ynnot roles_ctl2)"
    roles_ctl3() { local REC=; roles_in_order; }
    check "control: roles_in_order refuses a role that resolved to nothing" "$(ynnot roles_ctl3)"
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the docs commit, by its subject (change TB)" "$(yn [ "$DOCS" = "$C" ])"
    check "control: the same comparison refuses the doc commit" "$(ynnot [ "$DOC" = "$C" ])"
    check "control: the same comparison refuses the base" "$(ynnot [ "$REC" = "$C" ])"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT")"
    short_names_head() { [ "$(git rev-parse "$SHORT")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    echo "phase: Milestone 7 part 2 P1 ($SPEC) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run's builds, the host and i686 test runs and the keep's tests, go into <target>/main, the main tree's subdirectory of the phase's target root (CARGO_TARGET_DIR)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "SETTINGS CHOSEN BEFORE THE RUN, never tuned during it: every rerun --label host --timeout $TIMEOUT_S --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S (part 1's, specs/0044 ruling A), the runner's default memory; the i686 label's sample reruns are out of scope (specs/0045 \"Out of scope\")"
    echo "root: <repo> stands for the repository's top level (inside <home>, scrubbed after the corpus's paths); scripts/counting.sh, tools/emend-copy/src/main.rs and the records read are taken from it at the phase commit by git show; scripts/passthrough-run.sh, scripts/passthrough-record.py and scripts/edit-open-check.sh are run from it, each checked equal to the phase commit's (the runner and the open check source scripts/lo-check.sh); the test runs and the keep's tests run in it; the record pairs are installed into its $RECORDS_DEST/"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m7p2-p1 on the disk, the phase's directory; <phase>/gen holds the generator that wrote this script and <phase>/model the templates it was written from"
    echo "root: <scratch> stands for <phase>, the phase's directory, named <scratch> where TMPDIR is concerned: TMPDIR is <scratch>/tmp, made and exported by this script before any mktemp, and <work> is made under it"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory; this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (the counting library, the binaries' copies <work>/bin, the record pairs before they are installed <work>/records, the runs' TMPDIR <work>/tmp-run, the open check's TMPDIR <work>/tmp, the part 1 records read at the phase commit <work>/prev, the test runs' outputs, the checks' programs and outputs), kept after the run and never removed"
    echo "root: <target> stands for <phase>/target on the disk, the phase's one target root: the gate built the release binaries into <target>/main/release, and this log runs the host and i686 tests and the keep's tests in <target>/main"
    echo "root: <keep> stands for <phase>/keep-host on the disk unless RUN_KEEP names another for a dry run, this phase's host keep, made by this run (ruling F); kept after the run"
    echo "root: <corpus> stands for the private corpus directory (its manifest.tsv and the inputs under <corpus>/corpus, read by the runner; nothing is written under <corpus>/work)"
    echo "root: <runs> stands for the corpus run directories' parent, <corpus>/runs unless RUN_OUT_ROOT names another for a dry run; this log's run directories <runs>/$RUN-<name> are written there"
    echo "root: <source> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change TB)"
    echo "root: <stage> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change TB)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$SELF_DIR" "$BUILD_ROOT" "$MAIN" "$KEEP" "$CORPUS" "$TMPDIR")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots other than <home>, <phase>, <work> and <runs> are distinct, none inside another (TMPDIR, <scratch>/tmp, among them)" "$(yn roots_distinct)"
    work_in_tmpdir() { case "$B/" in "$TMPDIR/"*) return 0 ;; esac; return 1; }
    check "<work>, the directory mktemp -d made, is under TMPDIR, <scratch>/tmp" "$(yn work_in_tmpdir)"
    work_ctl() { local B=/tmp/x; work_in_tmpdir; }
    check "control: the same test refuses a working directory under /tmp" "$(ynnot work_ctl)"
    # Every mktemp call of this script is checked under TMPDIR, so the source is
    # read for its calls outside comments; the call's text is built from
    # pieces, so this form's own text is no call.
    MKW='$('
    MKW=${MKW}mkt
    MKW=${MKW}emp
    count_tempcalls() {
      awk -v w="$MKW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { n++; s = substr(s, i + length(w)) }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "A=$MKW -d)" "F=$MKW)" "# $MKW -d)" >"$B/mktemp-fixture"
    n_mk=$(count_tempcalls "$SELF")
    n_mk_fix=$(count_tempcalls "$B/mktemp-fixture")
    echo "command: count_tempcalls <this script>, and the same over a fixture of three lines: a directory call, a file call, a comment"
    echo "  mktemp calls in this script outside comments: $n_mk (the one that makes <work>, checked under TMPDIR above); in the fixture: $n_mk_fix"
    check "this script makes one mktemp call, <work>'s, and no plain temporary file" "$(yn [ "$n_mk" = 1 ])"
    check "control: the same count finds the fixture's two calls and not its comment" "$(yn [ "$n_mk_fix" = 2 ])"
    runs_apart() { apart "$RUN_OUT_ROOT" "$MAIN" && apart "$RUN_OUT_ROOT" "$SELF_DIR"; }
    check "<runs> lies outside <repo> and outside <scripts>" "$(yn runs_apart)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs, its record files, planning's modified specs/0045 and ROADMAP.md) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m7p2-p1/run.log\n?? records/m7p2-edit-%s-%s.md\n?? records/m7p2-open-%s-%s.txt\n?? records/size-m7p2-%s-%s.md\n M ROADMAP.md\n M specs/0045-publish.md\n?? records/logs/m7p1-p1/run.log\n?? records/m7p2-edit-%s-abcdef0.md\n?? records/m7p1-edit-%s-%s.md\n?? records/logs/m7p2-p2/run.log\n M specs/0043-measurement-and-close.md\n M records/m7p2-edit-%s-%s.md\n M scripts/passthrough-run.sh\n' "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$SHORT" "$DATE" "$DATE" "$SHORT" "$DATE" "$SHORT" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern admits this phase's log, its record files at this commit, planning's ROADMAP.md and specs/0045 alone; it refuses another phase's log, a record of another commit or phase, specs/0043, a modified record and a source file (change TB)" "$(yn [ "$(ours_rec_ctl)" = 6 ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources (the phase commit's, by git show)"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts, against the phase commit, and planning's uncommitted spec and ROADMAP.md"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh scripts/edit-open-check.sh; do
      check "$s in the main tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { [ "$(git show "$C:scripts/edit-open-check.sh" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/passthrough-run.sh)" ]; }
    check "control: the same hash comparison tells two different scripts apart" "$(ynnot tree_ctl)"
    spec_now=$(sha_of "$SPEC")
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum; sha256sum $SPEC (the working file, holding planning's rulings written during P1 and not yet committed, checked against PLANNING_SPEC; change TB)"
    echo "  at the phase commit: $spec_committed; the pin: $SPEC_WANT"
    echo "  the working tree's copy (planning's uncommitted rulings): sha256 $spec_now"
    spec_ok() { [ "$spec_committed" = "$SPEC_WANT" ]; }
    check "the spec at the phase commit is at the pinned hash, the doc commit's blob" "$(yn spec_ok)"
    spec_ctl() { local spec_committed=1111111111111111111111111111111111111111111111111111111111111111; spec_ok; }
    check "control: the same check refuses the spec against another hash" "$(ynnot spec_ctl)"
    echo "input: PLANNING_SPEC: ${PLANNING_SPEC:-unset} (the working spec's sha256, planning's rulings during P1; change TB)"
    working_ok() { [ -n "$PLANNING_SPEC" ] && [ "$spec_now" = "$PLANNING_SPEC" ]; }
    check "the working spec is the file PLANNING_SPEC names, planning's rulings during P1 (change TB, M6 part 6 P2's form)" "$(yn working_ok)"
    working_ctl() { local PLANNING_SPEC=$SPEC_WANT; working_ok; }
    check "control: the same comparison refuses the doc commit's blob named as PLANNING_SPEC" "$(ynnot working_ctl)"
    working_unset_ctl() { local PLANNING_SPEC=; working_ok; }
    check "control: the same comparison refuses an unset PLANNING_SPEC" "$(ynnot working_unset_ctl)"
    # Change TB: planning's working ROADMAP.md (part 2's P1 row IN PROGRESS,
    # ruling F), admitted at PLANNING_ROADMAP when it differs from the phase
    # commit's; unchanged, it needs no admission.
    roadmap_now=$(sha_of ROADMAP.md)
    roadmap_committed=$(git show "$C:ROADMAP.md" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:ROADMAP.md | sha256sum; sha256sum ROADMAP.md"
    echo "  at the phase commit: $roadmap_committed; the working tree's copy: $roadmap_now; PLANNING_ROADMAP: ${PLANNING_ROADMAP:-unset}"
    roadmap_ok() { [ "$roadmap_now" = "$roadmap_committed" ] || { [ -n "$PLANNING_ROADMAP" ] && [ "$roadmap_now" = "$PLANNING_ROADMAP" ]; }; }
    check "the working ROADMAP.md is the phase commit's or the file PLANNING_ROADMAP names (change TB)" "$(yn roadmap_ok)"
    roadmap_ctl() { local roadmap_now=1111111111111111111111111111111111111111111111111111111111111111; roadmap_ok; }
    check "control: the same check refuses a ROADMAP.md at another hash" "$(ynnot roadmap_ctl)"
    echo "command: podman image exists $IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    
    echo
    echo "## TMPDIR for the corpus runs, on the disk (part 6 P4's change LG)"
    dev_tmp=$(stat -c %d "$RUNTMP")
    dev_corpus=$(stat -c %d "$CORPUS/corpus")
    dev_proc=$(stat -c %d /proc)
    echo "command: stat -c %d <work>/tmp-run <corpus>/corpus /proc"
    echo "  device of TMPDIR (<work>/tmp-run): $dev_tmp; of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    check "TMPDIR for the corpus runs and the corpus directory are on one device" "$(yn [ "$dev_tmp" = "$dev_corpus" ])"
    dev_ctl() { if [ "$dev_proc" = "$dev_corpus" ]; then return 1; else return 0; fi; }
    check "control: the same comparison tells /proc's device from the corpus directory's" "$(yn dev_ctl)"
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 1. the binaries: the gate's release builds, copied into <work>/bin (change RV)"
    echo "command: cp <target>/main/release/<name> <work>/bin/<name>, for emend-copy and xlsx-diff (done before the log began); sha256sum each; the gate log's line for each, read by sed"
    bins_ok=yes
    for b in emend-copy xlsx-diff; do
      have=$(sha_of "$B/bin/$b")
      orig=$(sha_of "$RELEASE_DIR/$b")
      logged=$(sed -n "s#^  <target>/main/release/$b: sha256 \\([0-9a-f]\\{64\\}\\), bytes [0-9]*\$#\\1#p" "$GATE_LOG")
      n_logged=$(printf '%s\n' "$logged" | awk 'NF' | wc -l)
      echo "  <work>/bin/$b: sha256 $have, bytes $(stat -c %s "$B/bin/$b"); <target>/main/release/$b: sha256 $orig; the gate log's line: ${logged:-none} (lines $n_logged)"
      bin_ok() { [ "$n_logged" = 1 ] && [ "$have" = "$logged" ] && [ "$have" = "$orig" ]; }
      if bin_ok; then :; else bins_ok=no; fi
      check "$b: the copy is the gate's release binary, by the one line the gate log prints for it (change RV)" "$(yn bin_ok)"
    done
    bin_ctl() { local have=1111111111111111111111111111111111111111111111111111111111111111; bin_ok; }
    check "control: the same comparison refuses another hash" "$(ynnot bin_ctl)"
    if [ -x "$MAIN/target/release/emend-copy" ]; then
      stale_n=$("$MAIN/target/release/emend-copy" 2>&1 </dev/null | LC_ALL=C "$G" -o -E -- '--[a-z0-9-]*-sample' | count_lines /dev/stdin)
      echo "  <repo>/target/release/emend-copy: there, built $(date -u -r "$MAIN/target/release/emend-copy" +%Y-%m-%d), its usage text names $stale_n flags ending in -sample; NOT USED by this log (ruling E)"
    else
      echo "  <repo>/target/release/emend-copy: not there; NOT USED by this log (ruling E)"
    fi
    if [ "$bins_ok" != yes ]; then
      echo "STOPPED: a binary is not the gate's; no run is made"
      exec 1>&3
      wait "$SCRUB_PID" 2>/dev/null
      exit 1
    fi
    
    echo
    echo "## 2. the six samples, each in the binary's own usage text (change TC)"
    echo "command: <work>/bin/emend-copy (no argument): exit $USAGE_RC; grep -o -E -- '--[a-z0-9-]*-sample' over its output, in order"
    n_usage=$(count_lines "$B/usage.flags")
    n_usage_u=$(LC_ALL=C sort -u "$B/usage.flags" | count_lines /dev/stdin)
    awk '{ print "    " NR ". " $0 }' "$B/usage.flags"
    echo "  the usage text's flags ending in -sample: $n_usage; distinct: $n_usage_u"
    check "the binary's usage error exits 2 (EXIT_ERROR)" "$(yn [ "$USAGE_RC" = 2 ])"
    check "every flag the usage text names is named once" "$(yn [ "$n_usage" = "$n_usage_u" ])"
    git show "$C:tools/emend-copy/src/main.rs" | awk '/^const USAGE: &str = /, /";$/' | LC_ALL=C "$G" -o -E -- '--[a-z0-9-]*-sample' >"$B/usage-src.flags"
    echo "command: git show <phase commit>:tools/emend-copy/src/main.rs, the USAGE constant's lines (awk from 'const USAGE' to the line ending '\";'), the same grep: $(count_lines "$B/usage-src.flags") flags"
    check "the binary's flags, in order, are the USAGE constant's at the phase commit (ruling E)" "$(yn cmp -s "$B/usage.flags" "$B/usage-src.flags")"
    head -n -1 "$B/usage-src.flags" >"$B/c-usage.flags"
    check "control: the same comparison refuses the list less its last flag" "$(ynnot cmp -s "$B/usage.flags" "$B/c-usage.flags")"
    n_run=$(count_lines "$B/run.flags")
    echo "  the flags run, in specs/0045's order: $n_run"
    awk '{ print "    " NR ". " $0 }' "$B/run.flags"
    six_in_usage() { local f; for f in $SIX; do [ "$(count_matches -xF "$f" "$B/usage.flags")" = 1 ] || return 1; done; }
    check "each of the six samples is named once by the binary's usage text" "$(yn six_in_usage)"
    six_ctl() { local SIX="--formula-sample --no-such-sample"; six_in_usage; }
    check "control: the same check refuses a flag the usage text does not name" "$(ynnot six_ctl)"
    six_one() { local SIX="--formula-sample"; six_in_usage; }
    check "control: the same check admits a flag the usage text names (change TI)" "$(yn six_one)"
    if [ "$LOGGED" = yes ]; then
      check "the six samples are run (specs/0045 \"P1's logs\")" "$(yn [ "$n_run" = 6 ])"
    else
      echo "  RUN_FLAGS (a dry run): $n_run of the six run; the whole set's count is not judged"
    fi
    
    # ---------------------------------------------------------------------------
    # The helpers of the reruns and the comparison. Outcome counts of a summary,
    # by the outcome column found by its header name: "error 1 ok 26 " and so
    # on, one pair per outcome, sorted.
    outcome_counts() { awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "outcome") o = i; next } o { n[$o]++ } END { for (k in n) print k, n[k] }' "$1" | LC_ALL=C sort | tr '\n' ' '; }
    # Rows of a summary whose outcome is neither ok nor error.
    other_rows() { awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "outcome") o = i; next } o && $o != "ok" && $o != "error" { n++ } END { print n + 0 }' "$1"; }
    # run_field <run.host.tsv> <column>: the one run row's value of the column,
    # found by its header name.
    run_field() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { print $k }' "$1"; }
    # host_counts <summary table>: the host rows of a record's .txt summary
    # table (its lines up to the first blank line) or of a summary.host.tsv:
    # files, ok, lo ok, lo_in ok and the identical column's sum (change RX).
    host_counts() { awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $0 == "" { exit } $k["label"] == "host" { f++; if ($k["outcome"] == "ok") o++; if ($k["lo"] == "ok") l++; if ($k["lo_in"] == "ok") li++; s += $k["identical"] } END { printf "files %d ok %d lo_ok %d lo_in_ok %d identical %d\n", f, o, l, li, s }' "$1"; }
    printf 'id\tlabel\toutcome\tidentical\tlo\tlo_in\nw1\thost\tok\t3\tok\tok\nw2\thost\terror\t0\t\tok\nw3\thost\tok\t4\tfail\tok\nw1\ti686\tok\t3\tok\tok\n\nid\tother\nw9\thost\n' >"$B/c-summary.tsv"
    # Change TA (ruling N): the one-table fixture, the summary.host.tsv form.
    head -n 5 "$B/c-summary.tsv" >"$B/c-summary-one.tsv"
    check "control: outcome_counts reads a fixture by its header (error 1, ok 3, both labels)" "$(yn [ "$(outcome_counts "$B/c-summary-one.tsv")" = "error 1 ok 3 " ])"
    check "control: other_rows counts no row of the fixture, whose outcomes are ok and error" "$(yn [ "$(other_rows "$B/c-summary-one.tsv")" = 0 ])"
    check "control: host_counts reads the fixture's host rows up to its blank line (files 3, ok 2, lo ok 1, lo_in ok 3, identical 7)" "$(yn [ "$(host_counts "$B/c-summary.tsv")" = "files 3 ok 2 lo_ok 1 lo_in_ok 3 identical 7" ])"
    # ---------------------------------------------------------------------------
    echo
    echo "## 3. the host and i686 test runs (specs/0045 \"P1's logs\"; change TG)"
    # Part 1's workspace figure, read from its committed run log: the passed
    # count its keep's host run printed. This part adds two tests (fix 2's
    # protection test, fix 3's scatter test) and renames two (fix 4, ruling A).
    git show "$C:records/logs/m7p1-p1/run.log" >"$B/prev/part1-run.log" || exit 2
    prev_passed=$(awk '/^command: EMEND_KEEP_DIR=<keep> cargo test --workspace/ { k = 1 } k && /^  passed [0-9]+; failed [0-9]+$/ { print $2; exit }' "$B/prev/part1-run.log" | tr -d ';')
    ADDED_TESTS=2
    echo "command: git show <phase commit>:records/logs/m7p1-p1/run.log, the passed figure after its keep's command: ${prev_passed:-none}; the tests this part adds: $ADDED_TESTS"
    check "part 1's workspace figure was read" "$(yn [ -n "$prev_passed" ])"
    WANT_PASSED=$((${prev_passed:-0} + ADDED_TESTS))
    # test_counts <cargo test output>: passed, failed and ignored, summed over
    # every "test result:" line.
    test_counts() { awk '/^test result: / { for (i = 1; i < NF; i++) { if ($(i + 1) ~ /^passed;$/) p += $i; if ($(i + 1) ~ /^failed;$/) f += $i; if ($(i + 1) ~ /^ignored;$/) g += $i } } END { printf "passed %d failed %d ignored %d\n", p, f, g }' "$1"; }
    printf 'test result: ok. 3 passed; 0 failed; 1 ignored; 0 measured; 0 filtered out\ntest result: FAILED. 2 passed; 1 failed; 0 ignored; 0 measured; 0 filtered out\n' >"$B/c-tests.out"
    check "control: test_counts sums a fixture's two result lines (passed 5, failed 1, ignored 1)" "$(yn [ "$(test_counts "$B/c-tests.out")" = "passed 5 failed 1 ignored 1" ])"
    echo "command: (cd <repo> && CARGO_TARGET_DIR=<target>/main cargo test --workspace)"
    ( cd "$MAIN" && CARGO_TARGET_DIR=$BUILD_ROOT cargo test --workspace ) >"$B/test-host.out" 2>&1 </dev/null
    t_rc=$?
    host_t=$(test_counts "$B/test-host.out")
    echo "  exit $t_rc; $host_t"
    LC_ALL=C "$G" -E '^test result: ' "$B/test-host.out" | sed 's/^/    /'
    check "the host test run exits 0" "$(yn [ "$t_rc" = 0 ])"
    check "the host test run fails no test" "$(yn [ "$(printf '%s\n' "$host_t" | awk '{ print $4 }')" = 0 ])"
    host_passed=$(printf '%s\n' "$host_t" | awk '{ print $2 }')
    echo "  host passed $host_passed; part 1's $prev_passed with the $ADDED_TESTS tests this part adds: $WANT_PASSED"
    check "the host test run passes part 1's figure with the tests this part adds" "$(yn [ "$host_passed" = "$WANT_PASSED" ])"
    echo "command: (cd <repo> && CARGO_TARGET_DIR=<target>/main cargo test --workspace --target i686-unknown-linux-musl)"
    ( cd "$MAIN" && CARGO_TARGET_DIR=$BUILD_ROOT cargo test --workspace --target i686-unknown-linux-musl ) >"$B/test-i686.out" 2>&1 </dev/null
    t_rc=$?
    i686_t=$(test_counts "$B/test-i686.out")
    echo "  exit $t_rc; $i686_t"
    LC_ALL=C "$G" -E '^test result: ' "$B/test-i686.out" | sed 's/^/    /'
    check "the i686 test run exits 0" "$(yn [ "$t_rc" = 0 ])"
    check "the i686 test run passes, fails and ignores what the host run does" "$(yn [ "$i686_t" = "$host_t" ])"
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 4. the reruns on the host, one run per flag, each recorded and compared with its part 1 record (changes TC and TD; specs/0045 ruling G (a))"
    IDS_ARGS=()
    if [ -n "$RUN_IDS" ]; then IDS_ARGS=(--ids "$RUN_IDS"); fi
    n_want_rows=$(if [ -n "$RUN_IDS" ]; then count_lines "$RUN_IDS"; else awk 'NR > 1' "$CORPUS/manifest.tsv" | wc -l; fi)
    echo "  the workbooks each run takes: $n_want_rows ($([ -n "$RUN_IDS" ] && echo "the ids of RUN_IDS" || echo "every manifest row"))"
    n_done=0
    n_rec_done=0
    n_findings=0
    n_info=0
    i=0
    while IFS= read -r f; do
      i=$((i + 1))
      name=$(name_of "$f")
      O=$RUN_OUT_ROOT/$RUN-$name
      STEM=m7p2-$name-$RUN
      echo
      echo "### $i. $f into <runs>/$RUN-$name"
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label host --passthrough <work>/bin/emend-copy --xlsx-diff <work>/bin/xlsx-diff --corpus <corpus> --out <runs>/$RUN-$name --timeout $TIMEOUT_S --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S${RUN_IDS:+ --ids <the RUN_IDS file>} --tool-arg $f"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label host --passthrough "$PT" --xlsx-diff "$XD" --corpus "$CORPUS" --out "$O" \
        --timeout "$TIMEOUT_S" --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" "${IDS_ARGS[@]}" --tool-arg "$f" \
        >"$B/run-$name.stdout" 2>"$B/run-$name.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$name.stderr")"
      sed 's/^/    /' "$B/run-$name.stdout"
      check "$f: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$f: its stderr is empty" "$(yn [ ! -s "$B/run-$name.stderr" ])"
      n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
      echo "  entries left in <work>/tmp-run after the run: $n_left"
      check "$f: the runs' TMPDIR is empty after the run" "$(yn [ "$n_left" = 0 ])"
      SUM=$O/summary.host.tsv
      RT=$O/run.host.tsv
      if [ ! -f "$SUM" ] || [ ! -f "$RT" ]; then
        check "$f: the run directory holds summary.host.tsv and run.host.tsv" "no"
        continue
      fi
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      other=$(other_rows "$SUM")
      echo "  summary.host.tsv: rows $rows; outcomes: $(outcome_counts "$SUM"); rows neither ok nor error: $other"
      check "$f: the summary holds one row per workbook run ($n_want_rows)" "$(yn [ "$rows" = "$n_want_rows" ])"
      rt_rows=$(awk 'NR > 1' "$RT" | wc -l)
      rt_commit=$(run_field "$RT" commit)
      rt_args=$(run_field "$RT" tool_args)
      echo "  run.host.tsv: run rows $rt_rows; commit $rt_commit; tool_args $rt_args; timeout_s $(run_field "$RT" timeout_s); lo_timeout_s $(run_field "$RT" lo_timeout_s); memory_mib $(run_field "$RT" memory_mib)"
      rt_ok() { [ "$rt_rows" = 1 ] && [ "$rt_commit" = "$C" ] && [ "$rt_args" = "$f" ]; }
      check "$f: run.host.tsv holds one run row naming the phase commit and the flag alone" "$(yn rt_ok)"
      rt_settings() { [ "$(run_field "$RT" timeout_s)" = "$TIMEOUT_S" ] && [ "$(run_field "$RT" lo_timeout_s)" = "$LO_TIMEOUT_S" ]; }
      check "$f: run.host.tsv names the settings given (timeout $TIMEOUT_S, lo timeout $LO_TIMEOUT_S; ruling A)" "$(yn rt_settings)"
      n_done=$((n_done + 1))
      if [ "$other" != 0 ]; then
        echo "  FINDING: $f has $other rows neither ok nor error; nothing is rerun to make them pass"
        n_findings=$((n_findings + 1))
      fi
      echo "command: python3 -I -B scripts/passthrough-record.py --run <runs>/$RUN-$name --out <work>/records --stem $STEM --allow-single"
      python3 -I -B scripts/passthrough-record.py --run "$O" --out "$RECORDS" --stem "$STEM" --allow-single >"$B/record-$name.out" 2>"$B/record-$name.err" </dev/null
      rrc=$?
      echo "  exit: $rrc; stdout:"; sed 's/^/    /' "$B/record-$name.out"
      echo "  stderr bytes: $(wc -c <"$B/record-$name.err")"
      rec_ran() { [ "$rrc" = 0 ] && [ ! -s "$B/record-$name.err" ]; }
      check "$f: the record script exits 0, its stderr empty" "$(yn rec_ran)"
      rec_header() {
        [ -f "$RECORDS/$STEM.txt" ] && [ "$(count_matches -xF "- Commit: $C" "$RECORDS/$STEM.md")" = 1 ] \
          && [ "$(count_matches -xF '- Targets: host' "$RECORDS/$STEM.md")" = 1 ] \
          && [ "$(count_matches -xF "- Tool arguments: $f" "$RECORDS/$STEM.md")" = 1 ]
      }
      check "$f: the record pair is there, its .md naming the phase commit on its Commit: line, the host alone and the flag" "$(yn rec_header)"
      if [ -f "$RECORDS/$STEM.txt" ]; then
        echo "  record: $STEM.md sha256 $(sha_of "$RECORDS/$STEM.md"); $STEM.txt sha256 $(sha_of "$RECORDS/$STEM.txt")"
        n_rec_done=$((n_rec_done + 1))
      fi
      # Change TD: the comparison with the part 1 record of the same name.
      now=$(host_counts "$RECORDS/$STEM.txt")
      now_sum=$(host_counts "$SUM")
      check "$f: the record's host counts are the summary's ($now_sum)" "$(yn [ "$now" = "$now_sum" ])"
      prev=records/m7p1-$name-$PREV_RUN.md
      prev_args=$(git show "$C:$prev" 2>/dev/null | sed -n 's/^- Tool arguments: //p')
      if [ "$prev_args" != "$f" ]; then
        echo "  FINDING: $f: $prev is not at the phase commit or does not name the flag alone (its tool arguments: ${prev_args:-none})"
        n_findings=$((n_findings + 1))
        continue
      fi
      git show "$C:${prev%.md}.txt" >"$B/prev/$name.txt" || { check "$f: the compared record's .txt is at the phase commit" "no"; continue; }
      then_c=$(host_counts "$B/prev/$name.txt")
      echo "  compared with $prev (recorded $(git show "$C:$prev" | sed -n 's/^- Record written: //p'); its tool arguments $prev_args)"
      echo "    now:  $now"
      echo "    then: $then_c"
      if [ "$now" = "$then_c" ]; then
        echo "  the host row and the identical count equal the compared record's"
      elif [ "$LOGGED" = yes ]; then
        echo "  FINDING: $f: the host row or the identical count differs from $prev (now: $now; then: $then_c); recorded, not fixed (specs/0045 ruling G (a): the outputs may change bytes, the counts may not)"
        n_findings=$((n_findings + 1))
      else
        echo "  a dry run: the counts differ from $prev (now: $now; then: $then_c), not judged"
      fi
    done <"$B/run.flags"
    echo
    echo "  reruns done $n_done of $n_run; record pairs written $n_rec_done; FINDING lines so far: $n_findings"
    check "every flag was run, and its run directory holds its tables" "$(yn [ "$n_done" = "$n_run" ])"
    check "every run was recorded" "$(yn [ "$n_rec_done" = "$n_run" ])"
    echo "  the run directories, in specs/0045's order:"
    while IFS= read -r f; do n=$(name_of "$f"); printf '    <runs>/%s-%s %s\n' "$RUN" "$n" "$([ -d "$RUN_OUT_ROOT/$RUN-$n" ] && echo there || echo MISSING)"; done <"$B/run.flags"
    n_dirs_there=0
    while IFS= read -r f; do n=$(name_of "$f"); [ -d "$RUN_OUT_ROOT/$RUN-$n" ] && n_dirs_there=$((n_dirs_there + 1)); done <"$B/run.flags"
    echo "  run directories there: $n_dirs_there"
    check "one run directory per flag run is there" "$(yn [ "$n_dirs_there" = "$n_run" ])"
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 5. the host keep and its open record (specs/0044 ruling F's form; specs/0045 rulings A and G; change TE)"
    if [ "$RUN_SKIP_KEEP" = yes ]; then
      echo "  RUN_SKIP_KEEP=yes (a dry run): the keep is <keep>, read only, with $RUN_OPEN_RECORD read at the phase commit; no test run and no open check"
      git show "$C:$RUN_OPEN_RECORD.txt" >"$B/open-given.txt" || exit 2
      git show "$C:$RUN_OPEN_RECORD.md" >"$B/open-given.md" || exit 2
      RECORD_TXT=$B/open-given.txt
      OPEN_MD=$B/open-given.md
      echo "  the record read: sha256 $(sha_of "$RECORD_TXT"), rows $(awk 'NR > 1' "$RECORD_TXT" | wc -l); files in <keep>: $(find "$KEEP" -type f | wc -l)"
    else
      mkdir "$KEEP" || exit 2
      n_keep_entry=$(find "$KEEP" -mindepth 1 | wc -l)
      check "the keep was made by this run and is empty before the tests (ruling F)" "$(yn [ "$n_keep_entry" = 0 ])"
      echo "command: EMEND_KEEP_DIR=<keep> cargo test --workspace (host; CARGO_TARGET_DIR=<target>/main; EMEND_KEEP_DIR set on this command alone)"
      EMEND_KEEP_DIR=$KEEP CARGO_TARGET_DIR=$BUILD_ROOT cargo test --workspace >"$B/keep.out" 2>&1 </dev/null
      rc=$?
      echo "  exit: $rc"
      LC_ALL=C "$G" -E '^test result: ' "$B/keep.out" | sed 's/^/    /'
      failed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^failed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
      passed=$(awk '/^test result: / { for (i = 1; i < NF; i++) if ($(i + 1) ~ /^passed;$/) n += $i } END { print n + 0 }' "$B/keep.out")
      echo "  passed $passed; failed $failed"
      check "the tests with the keep set exit 0" "$(yn [ "$rc" = 0 ])"
      check "no test failed" "$(yn [ "$failed" = 0 ])"
      keep_unset() { [ -z "${EMEND_KEEP_DIR:-}" ]; }
      check "EMEND_KEEP_DIR is unset in this shell after the keep's command (ruling F)" "$(yn keep_unset)"
      n_in=$(find "$KEEP" -maxdepth 1 -type f -name '*.in.xlsx' | wc -l)
      n_out=$(find "$KEEP" -maxdepth 1 -type f -name '*.out.xlsx' | wc -l)
      n_all=$(find "$KEEP" -mindepth 1 | wc -l)
      echo "  the keep: inputs $n_in; outputs $n_out; entries in all $n_all"
      pairs_only() { [ "$n_in" -gt 0 ] && [ "$n_in" = "$n_out" ] && [ "$n_all" = "$((n_in + n_out))" ]; }
      check "the keep holds pairs and nothing else" "$(yn pairs_only)"
      dev_open=$(stat -c %d "$B/tmp")
      echo "  device of the open check's TMPDIR (<work>/tmp): $dev_open; of the corpus directory: $dev_corpus"
      check "the open check's TMPDIR and the corpus directory are on one device" "$(yn [ "$dev_open" = "$dev_corpus" ])"
      echo "command: TMPDIR=<work>/tmp scripts/edit-open-check.sh --keep <keep> --libreoffice $IMAGE --out <work>/records --stem $STEM_OPEN"
      TMPDIR=$B/tmp scripts/edit-open-check.sh --keep "$KEEP" --libreoffice "$IMAGE" --out "$RECORDS" --stem "$STEM_OPEN" \
        >"$B/oc.stdout" 2>"$B/oc.stderr" </dev/null
      oc_rc=$?
      echo "  exit: $oc_rc; stdout lines $(count_lines "$B/oc.stdout"); stderr bytes: $(wc -c <"$B/oc.stderr")"
      echo "  its totals line:"; LC_ALL=C "$G" -E '^wrote ' "$B/oc.stdout" | sed 's/^/    /'
      check "the open check ran every check (exit 0, or 1 for a finding of its own; 2 is a check that errored)" "$(yn [ "$oc_rc" != 2 ])"
      if [ "$oc_rc" = 1 ]; then
        echo "  FINDING: the open check reports findings of its own (an output refused on an input accepted, or a sheet count that differs; its record lists them); recorded, not fixed"
        n_findings=$((n_findings + 1))
      fi
      check "its stderr is empty" "$(yn [ ! -s "$B/oc.stderr" ])"
      RECORD_TXT=$RECORDS/$STEM_OPEN.txt
      OPEN_MD=$RECORDS/$STEM_OPEN.md
      open_pair() { [ -f "$RECORD_TXT" ] && [ -f "$OPEN_MD" ] && [ "$(awk 'NR > 1' "$RECORD_TXT" | wc -l)" = "$n_in" ]; }
      check "the open record pair is there, its .txt one row per kept pair" "$(yn open_pair)"
      echo "  record: $STEM_OPEN.md sha256 $(sha_of "$OPEN_MD"); $STEM_OPEN.txt sha256 $(sha_of "$RECORD_TXT")"
    fi
    # totals_of <open record .md>: its Totals table's first row, the pairs,
    # lo_in ok and lo ok columns.
    totals_of() { awk -F'|' '/^## Totals/ { t = 1; next } t && /^[|] [0-9]/ { gsub(/ /, ""); print "pairs " $2 " lo_in_ok " $3 " lo_ok " $6; exit }' "$1"; }
    printf '# x\n\n## Totals\n\n| pairs | lo_in ok | lo_in fail | lo_in error | lo ok | lo fail | lo error |\n| --- | --- | --- | --- | --- | --- | --- |\n| 10 | 9 | 1 | 0 | 8 | 2 | 0 |\n' >"$B/c-totals.md"
    check "control: totals_of reads a fixture's pairs, lo_in ok and lo ok (10, 9, 8)" "$(yn [ "$(totals_of "$B/c-totals.md")" = "pairs 10 lo_in_ok 9 lo_ok 8" ])"
    git grep -E '^- Record written: ' "$C" -- 'records/*-open-*.md' | sed "s#^$C:##" | awk -F'.md:- Record written: ' '{ print $2 "\t" $1 }' | LC_ALL=C sort | tail -n 1 | cut -f2 >"$B/newest-open"
    echo "command: git grep '^- Record written: ' <phase commit> -- 'records/*-open-*.md', the latest time's record: $(cat "$B/newest-open")"
    check "the compared open record, $PREV_OPEN, part 1's, is the newest open record at the phase commit (rulings A and G)" "$(yn [ "$(cat "$B/newest-open")" = "$PREV_OPEN" ])"
    git show "$C:$PREV_OPEN.md" >"$B/prev-open.md" || exit 2
    open_now=$(totals_of "$OPEN_MD")
    open_then=$(totals_of "$B/prev-open.md")
    echo "  this run's open totals: $open_now"
    echo "  $PREV_OPEN's:          $open_then"
    totals_read() { [ -n "$open_now" ] && [ -n "$open_then" ]; }
    check "both totals were read" "$(yn totals_read)"
    if [ "$open_now" = "$open_then" ]; then
      echo "  the totals equal $PREV_OPEN's"
    else
      echo "  the totals differ from $PREV_OPEN's (now: $open_now; then: $open_then); judged by the pairs below (rulings A and G)"
    fi
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 6. the pairs by name against part 1's open record (specs/0045 rulings A and G; change TE)"
    # Ruling A: the instances of the two chartsheet tests it renames are gone and
    # the one-write test's are new; ruling G (b): the pairs of the tests this
    # part adds (fix 2's protection test, fix 3's scatter test) are new. Each is
    # expected and no FINDING. A pair gone other than ruling A's two tests', any
    # other new pair, or a pair in both whose open result (lo_in or lo) changes
    # from ok, is a FINDING.
    GONE_OK="package.tests.chartsheet.a_chart_is_replaced_by_a_removal_and_an_addition_in_two_writes package.tests.chartsheet.a_removal_leaves_the_chartsheet_s_drawing_empty"
    NEW_OK="package.tests.chartsheet.a_chart_is_replaced_by_a_removal_and_an_addition_in_one_write package.tests.protection.the_workbook_element_is_created_before_the_next_main_child_after_a_planted_one package.tests.chart_write.a_new_scatter_plot_of_the_style_none_is_refused package.tests.chartsheet.a_removal_alone_on_a_chartsheet_is_refused"
    # Change TH (specs/0045 ruling H, readings for d2): (1) one pair gone by
    # KEY, not by test: fix 3 dropped the scatter-style test's None row, so its
    # instance .6 is gone; the test's other keys stay, or a FINDING. (2) the
    # removal-alone test keeps two pairs (its fixture write and the
    # remove_sheet control), in NEW_OK above. (3) the trendline write test
    # gains three refused periods, so its pairs renumber: its new keys and its
    # same-key changed outputs are expected when every one of its open results
    # is ok, each printed by name; any of its pairs not ok is a FINDING.
    GONE_KEYS_OK="package.tests.chart_write.a_scatter_chart_takes_each_style_with_x_and_y_values.6"
    SHIFT_TEST="package.tests.chart_write.each_trendline_kind_writes_its_type_its_order_or_period_and_its_fields"
    # Change TJ (specs/0045 ruling I (1)): fix 5 put its added periods in the
    # refused test, not the write test, so three new keys of the refused test
    # are expected BY KEY when each one's open result is ok (lo_in and lo); any
    # other new key of that test, or one of the three not ok, is a FINDING.
    NEW_KEYS_OK="package.tests.chart_write.the_trendline_and_error_bar_field_rules_are_refused.46 package.tests.chart_write.the_trendline_and_error_bar_field_rules_are_refused.47 package.tests.chart_write.the_trendline_and_error_bar_field_rules_are_refused.48"
    git show "$C:$PREV_OPEN.txt" >"$B/prev-open.txt" || exit 2
    awk -F'\t' 'NR > 1 { print $1 }' "$B/prev-open.txt" | LC_ALL=C sort >"$B/keys-then"
    awk -F'\t' 'NR > 1 { print $1 }' "$RECORD_TXT" | LC_ALL=C sort >"$B/keys-now"
    LC_ALL=C comm -23 "$B/keys-then" "$B/keys-now" >"$B/keys-gone"
    LC_ALL=C comm -13 "$B/keys-then" "$B/keys-now" >"$B/keys-new"
    LC_ALL=C comm -12 "$B/keys-then" "$B/keys-now" >"$B/keys-both"
    echo "command: the first column of $PREV_OPEN.txt (at the phase commit) and of this run's open record .txt, sorted; comm -23, -13 and -12"
    echo "  pairs then $(count_lines "$B/keys-then"); now $(count_lines "$B/keys-now"); gone $(count_lines "$B/keys-gone"); new $(count_lines "$B/keys-new"); in both $(count_lines "$B/keys-both")"
    # test_of <pair key>: the test's path, the key less its instance number.
    test_of() { printf '%s\n' "$1" | sed -E 's/[.][0-9]+$//'; }
    check "control: test_of drops the instance number alone" "$(yn [ "$(test_of package.tests.a.b_c.12)" = package.tests.a.b_c ])"
    # named_in <test> <list>: the test is one of the list's words.
    named_in() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
    check "control: named_in finds a listed test and refuses a prefix of one" "$(yn named_in package.tests.chartsheet.a_removal_leaves_the_chartsheet_s_drawing_empty "$GONE_OK")"
    check "control: named_in refuses a test that is a prefix of a listed one" "$(ynnot named_in package.tests.chartsheet.a_removal "$GONE_OK")"
    check "control: named_in admits the one gone key of ruling H (1) (change TH)" "$(yn named_in package.tests.chart_write.a_scatter_chart_takes_each_style_with_x_and_y_values.6 "$GONE_KEYS_OK")"
    check "control: named_in refuses another key of the same test (change TH)" "$(ynnot named_in package.tests.chart_write.a_scatter_chart_takes_each_style_with_x_and_y_values.1 "$GONE_KEYS_OK")"
    check "control: named_in admits a new key of ruling I (1) (change TJ)" "$(yn named_in package.tests.chart_write.the_trendline_and_error_bar_field_rules_are_refused.47 "$NEW_KEYS_OK")"
    check "control: named_in refuses another key of the same test (change TJ)" "$(ynnot named_in package.tests.chart_write.the_trendline_and_error_bar_field_rules_are_refused.49 "$NEW_KEYS_OK")"
    # open_ok <record .txt> <key>: the key's row reads lo_in ok and lo ok.
    open_ok() { [ "$(awk -F'\t' -v k="$2" 'NR > 1 && $1 == k { print $6 " " $7; exit }' "$1")" = "ok ok" ]; }
    printf 'key\tb\tc\td\te\tlo_in\tlo\nx.1\t-\t-\t-\t-\tok\tok\nx.2\t-\t-\t-\t-\tok\tfail\n' >"$B/c-open-ok"
    check "control: open_ok takes a fixture's ok ok row (change TJ)" "$(yn open_ok "$B/c-open-ok" x.1)"
    open_ok_ctl() { open_ok "$B/c-open-ok" x.2 || open_ok "$B/c-open-ok" x.3; }
    check "control: open_ok refuses a row with lo not ok and a key not there (change TJ)" "$(ynnot open_ok_ctl)"
    echo "  the pairs gone:"
    n_gone_ok=0
    n_gone_bad=0
    while IFS= read -r k; do
      if named_in "$k" "$GONE_KEYS_OK"; then
        echo "    $k: gone, expected (ruling H (1): fix 3 dropped the test's None row; this key alone)"
        n_gone_ok=$((n_gone_ok + 1))
      elif named_in "$(test_of "$k")" "$GONE_OK"; then
        echo "    $k: gone, expected (ruling A: the test is renamed to what it now shows)"
        n_gone_ok=$((n_gone_ok + 1))
      elif [ "$RUN_SKIP_KEEP" = yes ]; then
        echo "    $k: gone (RUN_SKIP_KEEP=yes, a dry run: not judged)"
      else
        echo "    FINDING: $k: a pair gone that ruling A does not name (specs/0045 ruling G); recorded, not fixed"
        n_gone_bad=$((n_gone_bad + 1))
        n_findings=$((n_findings + 1))
      fi
    done <"$B/keys-gone"
    # Ruling H (1): the other keys of each gone key's test are all still there.
    for gk in $GONE_KEYS_OK; do
      gt=$(test_of "$gk")
      n_then_t=$(awk -v t="$gt" '{ k = $0; sub(/[.][0-9]+$/, "", k) } k == t' "$B/keys-then" | LC_ALL=C "$G" -v -x -F -- "$gk" | wc -l)
      n_kept_t=$(awk -v t="$gt" '{ k = $0; sub(/[.][0-9]+$/, "", k) } k == t' "$B/keys-then" | LC_ALL=C "$G" -v -x -F -- "$gk" | LC_ALL=C "$G" -x -F -f "$B/keys-now" | wc -l)
      echo "  $gt: part 1's keys other than ${gk##*.}: $n_then_t; of them in this keep: $n_kept_t (ruling H (1))"
      if [ "$RUN_SKIP_KEEP" = no ] && [ "$n_then_t" != "$n_kept_t" ]; then
        echo "    FINDING: $gt: a key other than the one ruling H names is gone; recorded, not fixed"
        n_findings=$((n_findings + 1))
      fi
    done
    echo "  the pairs new:"
    n_new_ok=0
    n_new_bad=0
    : >"$B/shift-new"
    while IFS= read -r k; do
      if named_in "$k" "$NEW_KEYS_OK" && open_ok "$RECORD_TXT" "$k"; then
        echo "    $k: new, expected by key, open ok ok (ruling I (1): fix 5's added periods in the refused test)"
        n_new_ok=$((n_new_ok + 1))
      elif named_in "$(test_of "$k")" "$NEW_OK"; then
        echo "    $k: new, expected (rulings A, G and H: a test this part adds or renames)"
        n_new_ok=$((n_new_ok + 1))
      elif [ "$(test_of "$k")" = "$SHIFT_TEST" ]; then
        echo "    $k: new, a renumbered key of the trendline write test (ruling H (3); judged by its open results below)"
        printf '%s\n' "$k" >>"$B/shift-new"
        n_new_ok=$((n_new_ok + 1))
      elif [ "$RUN_SKIP_KEEP" = yes ]; then
        echo "    $k: new (RUN_SKIP_KEEP=yes, a dry run: not judged)"
      else
        echo "    FINDING: $k: a new pair of a test rulings A and G do not name; recorded, not fixed"
        n_new_bad=$((n_new_bad + 1))
        n_findings=$((n_findings + 1))
      fi
    done <"$B/keys-new"
    echo "  gone as expected $n_gone_ok, gone otherwise $n_gone_bad; new as expected $n_new_ok, new otherwise $n_new_bad"
    # The open results of the pairs in both: key, lo_in, lo, then and now.
    awk -F'\t' 'NR > 1 { print $1 "\t" $6 "\t" $7 }' "$B/prev-open.txt" | LC_ALL=C sort >"$B/res-then"
    awk -F'\t' 'NR > 1 { print $1 "\t" $6 "\t" $7 }' "$RECORD_TXT" | LC_ALL=C sort >"$B/res-now"
    LC_ALL=C join -t "$TAB" "$B/res-then" "$B/res-now" >"$B/res-both"
    check "the open results were joined for every pair in both" "$(yn [ "$(count_lines "$B/res-both")" = "$(count_lines "$B/keys-both")" ])"
    # from_ok <joined file>: rows whose lo_in or lo was ok and is not now.
    from_ok() { awk -F'\t' '($2 == "ok" && $4 != "ok") || ($3 == "ok" && $5 != "ok")' "$1"; }
    to_ok() { awk -F'\t' '($2 != "ok" && $4 == "ok") || ($3 != "ok" && $5 == "ok")' "$1"; }
    printf 'a.1\tok\tok\tok\tok\nb.1\tok\tok\tok\tfail\nc.1\tfail\tfail\tfail\tok\nd.1\tok\tfail\tfail\tfail\n' >"$B/c-res"
    check "control: from_ok takes a pair whose lo or lo_in leaves ok and no other (b.1, d.1)" "$(yn [ "$(from_ok "$B/c-res" | cut -f1 | tr '\n' ' ')" = "b.1 d.1 " ])"
    check "control: to_ok takes a pair whose lo or lo_in becomes ok (c.1)" "$(yn [ "$(to_ok "$B/c-res" | cut -f1 | tr '\n' ' ')" = "c.1 " ])"
    from_ok "$B/res-both" >"$B/res-from-ok"
    to_ok "$B/res-both" >"$B/res-to-ok"
    echo "command: join the two records' (key, lo_in, lo) on the key; the pairs whose lo_in or lo leaves ok, and those whose lo_in or lo becomes ok"
    echo "  pairs in both whose open result leaves ok: $(count_lines "$B/res-from-ok"); whose open result becomes ok: $(count_lines "$B/res-to-ok")"
    while IFS="$TAB" read -r k a b c d; do
      echo "    FINDING: $k: the open result leaves ok (then lo_in $a lo $b; now lo_in $c lo $d; specs/0045 ruling G); recorded, not fixed"
      n_findings=$((n_findings + 1))
    done <"$B/res-from-ok"
    while IFS="$TAB" read -r k a b c d; do
      echo "    information: $k: the open result becomes ok (then lo_in $a lo $b; now lo_in $c lo $d)"
    done <"$B/res-to-ok"
    # Ruling H (3): the trendline write test's pairs, by name: its new keys
    # (above), its same-key changed outputs, and every one of its open results.
    echo "  the trendline write test (ruling H (3); change TH): $SHIFT_TEST"
    awk -F'\t' 'NR > 1 { print $1 "\t" $5 }' "$B/prev-open.txt" | LC_ALL=C sort >"$B/out-then"
    awk -F'\t' 'NR > 1 { print $1 "\t" $5 }' "$RECORD_TXT" | LC_ALL=C sort >"$B/out-now"
    LC_ALL=C join -t "$TAB" "$B/out-then" "$B/out-now" | awk -F'\t' -v t="$SHIFT_TEST" '{ k = $1; sub(/[.][0-9]+$/, "", k) } k == t && $2 != $3 { print $1 }' >"$B/shift-changed"
    echo "    its new keys: $(count_lines "$B/shift-new"); its same-key keys whose output changed: $(count_lines "$B/shift-changed")"
    while IFS= read -r k; do echo "      output changed: $k"; done <"$B/shift-changed"
    awk -F'\t' -v t="$SHIFT_TEST" 'NR > 1 { k = $1; sub(/[.][0-9]+$/, "", k) } NR > 1 && k == t { print $1 "\t" $6 "\t" $7 }' "$RECORD_TXT" >"$B/shift-res"
    n_shift_all=$(count_lines "$B/shift-res")
    # not_ok_count <file>: rows (key, lo_in, lo) whose lo_in or lo is not ok.
    not_ok_count() { awk -F'\t' '$2 != "ok" || $3 != "ok"' "$1" | wc -l; }
    n_shift_bad=$(not_ok_count "$B/shift-res")
    echo "    its pairs in this keep: $n_shift_all; of them with an open result not ok: $n_shift_bad"
    printf 'x.1\tok\tok\nx.2\tok\tfail\n' >"$B/c-shift"
    check "control: the same count finds the fixture's one pair not ok" "$(yn [ "$(not_ok_count "$B/c-shift")" = 1 ])"
    if [ "$RUN_SKIP_KEEP" = no ] && [ "$n_shift_bad" != 0 ]; then
      awk -F'\t' '$2 != "ok" || $3 != "ok" { print $1 " (lo_in " $2 ", lo " $3 ")" }' "$B/shift-res" | while IFS= read -r line; do
        echo "    FINDING: $line: a pair of the trendline write test whose open result is not ok (ruling H (3)); recorded, not fixed"
      done
      n_findings=$((n_findings + n_shift_bad))
    fi
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 7. the re-kept pairs and the pairs allowed under the precondition (specs/0045 ruling C; change TF)"
    # Ruling C: the 8 pairs the fixes reach, printed with part 1's output
    # sha256 and Excel result (its Excel record's fixture rows) beside this
    # keep's output sha256 and open results; the other 24 of part 1's finding 5
    # named as allowed under the documented precondition. Excel is not judged
    # here (the second Excel check, P2, judges it).
    REKEPT_SAME="package.tests.chart_write.a_scatter_chart_takes_each_style_with_x_and_y_values.1 package.tests.chart_write.an_of_pie_of_each_type_and_each_split_writes_its_form.1 package.tests.chart_write.an_of_pie_of_each_type_and_each_split_writes_its_form.10 package.tests.chart_write.an_of_pie_takes_a_colour_the_percent_and_a_pie_s_positions.1 package.tests.chart_write.each_trendline_kind_writes_its_type_its_order_or_period_and_its_fields.9 package.tests.chart_write.points_are_written_in_the_order_given_on_each_kind_that_takes_them.22"
    REKEPT_RENAMED="package.tests.chartsheet.a_chart_is_replaced_by_a_removal_and_an_addition_in_two_writes.2 package.tests.chartsheet.a_removal_leaves_the_chartsheet_s_drawing_empty.2"
    git show "$C:$EXCEL_REC" >"$B/excel-rec.md" || exit 2
    echo "command: git show <phase commit>:$EXCEL_REC: sha256 $(sha_of "$B/excel-rec.md"); its fixture rows' key, output sha256 and result by awk; its finding 5's names by grep"
    # excel_row <key>: part 1's fixture row's output sha256 and result.
    excel_row() { awk -F'|' -v k="$1" '$2 ~ /^ fixture $/ { t = $3; gsub(/[ `]/, "", t); if (t == k) { s = $6; r = $7; gsub(/ /, "", s); gsub(/ /, "", r); print s " " r; exit } }' "$B/excel-rec.md"; }
    # keep_row <key>: this keep's output sha256, lo_in and lo.
    keep_row() { awk -F'\t' -v k="$1" 'NR > 1 && $1 == k { print $5 " " $6 " " $7; exit }' "$RECORD_TXT"; }
    LC_ALL=C "$G" -E '^5[.] Fixture pairs pass on the input and refused on the output [(][0-9]+[)]: ' "$B/excel-rec.md" | LC_ALL=C "$G" -o -E '`[^`]+`' | tr -d '`' >"$B/finding5"
    n_f5=$(count_lines "$B/finding5")
    echo "  finding 5's names: $n_f5"
    check "part 1's finding 5 names 32 pairs" "$(yn [ "$n_f5" = 32 ])"
    n_rk_in=0
    for k in $REKEPT_SAME $REKEPT_RENAMED; do
      [ "$(count_matches -xF "$k" "$B/finding5")" = 1 ] && n_rk_in=$((n_rk_in + 1))
    done
    printf '%s\n' package.tests.c.one.1 >"$B/c-finding5"
    check "control: the same count finds a fixture's one key once (change TI)" "$(yn [ "$(count_matches -xF package.tests.c.one.1 "$B/c-finding5")" = 1 ])"
    check "the 8 re-kept pairs of ruling C are each one of finding 5's names" "$(yn [ "$n_rk_in" = 8 ])"
    echo "  the 8 re-kept pairs (part 1: output sha256 and Excel result; now: output sha256, lo_in, lo):"
    n_rk_changed=0
    for k in $REKEPT_SAME; do
      then_r=$(excel_row "$k")
      now_r=$(keep_row "$k")
      echo "    $k"
      echo "      part 1: ${then_r:-none}"
      echo "      now:    ${now_r:-absent}"
      if [ -z "$now_r" ]; then
        if [ "$RUN_SKIP_KEEP" = no ]; then
          echo "      FINDING: a re-kept pair is not in this keep; recorded, not fixed"
          n_findings=$((n_findings + 1))
        fi
      elif [ "${then_r%% *}" = "${now_r%% *}" ]; then
        if [ "$RUN_SKIP_KEEP" = no ]; then
          echo "      FINDING: the output is part 1's, which Excel refused: the fix did not reach it; recorded, not fixed"
          n_findings=$((n_findings + 1))
        else
          echo "      the output is part 1's (RUN_SKIP_KEEP=yes, a dry run: not judged)"
        fi
      else
        echo "      the output differs from part 1's: re-kept"
        n_rk_changed=$((n_rk_changed + 1))
      fi
    done
    for k in $REKEPT_RENAMED; do
      echo "    $k"
      echo "      part 1: $(excel_row "$k")"
      echo "      now:    $([ -n "$(keep_row "$k")" ] && echo "still there" || echo "gone (ruling A: renamed)")"
    done
    echo "    the one-write test's pairs (ruling A), now:"
    LC_ALL=C "$G" -E '^package[.]tests[.]chartsheet[.]a_chart_is_replaced_by_a_removal_and_an_addition_in_one_write[.][0-9]+$' "$B/keys-now" >"$B/onewrite"
    while IFS= read -r k; do echo "      $k: $(keep_row "$k")"; done <"$B/onewrite"
    echo "    the removal-alone test (ruling A: it keeps no output): pairs in this keep $(count_matches -E '^package[.]tests[.]chartsheet[.]a_removal_alone_on_a_chartsheet_is_refused[.]' "$B/keys-now")"
    echo "  re-kept pairs whose output differs from part 1's: $n_rk_changed of 6 (the two renamed counted apart)"
    echo "  the pairs allowed under the documented precondition (finding 5 less the 8; specs/0012, specs/0015 Excel-check ruling 4; now: output sha256, lo_in, lo):"
    n_allowed=0
    while IFS= read -r k; do
      if named_in "$k" "$REKEPT_SAME $REKEPT_RENAMED"; then continue; fi
      n_allowed=$((n_allowed + 1))
      now_r=$(keep_row "$k")
      echo "    allowed: $k: ${now_r:-absent}"
    done <"$B/finding5"
    check "the pairs allowed are 24 (ruling C)" "$(yn [ "$n_allowed" = 24 ])"
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 8. the record pairs installed into $RECORDS_DEST/"
    ls "$RECORDS" | LC_ALL=C sort >"$B/records.names"
    n_rec=$(count_lines "$B/records.names")
    n_rec_open=$(count_matches -E "^$STEM_OPEN[.](md|txt)$" "$B/records.names")
    n_rec_samples=$((n_rec - n_rec_open))
    want_rec=$((2 * n_run + $([ "$RUN_SKIP_KEEP" = yes ] && echo 0 || echo 2)))
    echo "  record files written in <work>/records: $n_rec (of them the samples' $n_rec_samples); expected $want_rec (a pair per rerun$([ "$RUN_SKIP_KEEP" = yes ] || echo ", and the open record's pair"))"
    check "the record files are the pairs expected" "$(yn [ "$n_rec" = "$want_rec" ])"
    check "the samples' record files are two per run directory" "$(yn [ "$n_rec_samples" = "$((2 * n_dirs_there))" ])"
    if [ "$LOGGED" = yes ]; then
      check "the samples' record files are 12 and the run directories 6 (specs/0045 \"P1's logs\")" "$(yn [ "$n_rec_samples $n_dirs_there" = "12 6" ])"
    fi
    no_path() { [ "$(cat "$RECORDS/"* | count_matches -F "$HOME" /dev/stdin)" = 0 ] && [ "$(cat "$RECORDS/"* | count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' /dev/stdin)" = 0 ]; }
    check "no record file names <home>, a home, mount, temporary or corpus path" "$(yn no_path)"
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x' >"$B/c-path"
    path_ctl() { [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$B/c-path")" = 1 ]; }
    check "control: the same form finds a planted path" "$(yn path_ctl)"
    mkdir -p "$RECORDS_DEST" || exit 2
    n_inst=0
    while IFS= read -r f; do
      if [ -e "$RECORDS_DEST/$f" ]; then echo "    $RECORDS_DEST/$f is already there: not installed"; continue; fi
      install -m 644 "$RECORDS/$f" "$RECORDS_DEST/$f" || continue
      cmp -s "$RECORDS/$f" "$RECORDS_DEST/$f" && n_inst=$((n_inst + 1))
      echo "    installed $RECORDS_DEST/$f: sha256 $(sha_of "$RECORDS_DEST/$f"), $(wc -c <"$RECORDS_DEST/$f") bytes"
    done <"$B/records.names"
    check "every record file was installed, byte for byte" "$(yn [ "$n_inst" = "$n_rec" ])"
    
    echo
    echo "## the FINDING lines of this log (specs/0043 ruling R)"
    echo "  FINDING lines printed above: $n_findings (each begins with the word FINDING; the runs, the open check and the comparisons print them, none is fixed)"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  planning's uncommitted spec: $SPEC, sha256 $(sha_of "$SPEC"); ROADMAP.md, sha256 $(sha_of ROADMAP.md)"
    echo "status lines: $st_all; of them this phase's logs, its record files or planning's uncommitted spec and ROADMAP.md: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's uncommitted spec and ROADMAP.md" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources (the phase commit's, by git show)
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls
  control count_matches on a file with two matching lines: 2 (expect 2)
  control count_matches on a file with none: 0 (expect 0)
  control count_matches summed over two files: 2 (expect 2)
  control count_matches with a regular expression: 2 (expect 2)
  control count_matches on an unreadable file: error (expect error)
  control count_matches on readable plus unreadable: error (expect error)
  control count_from_file on the same file: 2 (expect 2)
  control count_from_file on a file with none: 0 (expect 0)
  control count_from_file on an unreadable file: error (expect error)
  control count_bytes, control bytes in a file with ESC, ESC and SI: 3 (expect 3)
  control count_bytes, non-ASCII bytes in a file with one two-byte character: 2 (expect 2)
  control count_bytes on a clean file: 0 (expect 0)
  control count_bytes on an unreadable file: error (expect error)
