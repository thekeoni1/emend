      note "the working tree's spec hashes to PLANNING_SPEC (changes D66 to D68, D71, D74, D85 to D92)" "$(is [ "$SPEC_SHA" = "$PLANNING_SPEC" ])"
      planning_spec_ctl() { [ "$SPEC_HEAD" = "$PLANNING_SPEC" ]; }
      note "control: the same comparison refuses the phase commit's blob against PLANNING_SPEC (changes D66 to D68, D71, D74, D85 to D92)" "$(isnot planning_spec_ctl)"
    else
      echo "  PLANNING_SPEC is not set: the working tree's copy is printed only"
    fi
    # Change J91, kept (J92): PLANNING_ROADMAP, when given, is planning's
    # uncommitted ROADMAP.md's hash, and the working tree's copy must hash to it.
    ROADMAP_SHA=$(sha256sum <ROADMAP.md | cut -d' ' -f1)
    ROADMAP_HEAD=$(git show "$C:ROADMAP.md" | sha256sum | cut -d' ' -f1)
    echo "command: sha256sum ROADMAP.md; git show <phase commit>:ROADMAP.md | sha256sum"
    echo "  the working tree's ROADMAP.md: sha256 $ROADMAP_SHA; the phase commit's: sha256 $ROADMAP_HEAD"
    if [ -n "$PLANNING_ROADMAP" ]; then
      echo "  PLANNING_ROADMAP, planning's working copy's hash as given: $PLANNING_ROADMAP"
      note "the working tree's ROADMAP.md hashes to PLANNING_ROADMAP (changes J91 and J92)" "$(is [ "$ROADMAP_SHA" = "$PLANNING_ROADMAP" ])"
      planning_roadmap_ctl() { [ "$ROADMAP_HEAD" = "$PLANNING_ROADMAP" ]; }
      note "control: the same comparison refuses the phase commit's ROADMAP.md against PLANNING_ROADMAP (changes J91 and J92)" "$(isnot planning_roadmap_ctl)"
    else
      echo "  PLANNING_ROADMAP is not set: the working tree's ROADMAP.md is printed only"
    fi
    note "the spec at the phase commit is the doc commit's blob (change D92)" "$(is [ "$SPEC_HEAD" = "$SPEC_GAVE" ])"
    note "the spec at the doc commit is the blob planning's brief gave (change D92)" "$(is [ "$SPEC_DOC" = "$SPEC_GAVE" ])"
    prefix_ok() { [ "${SPEC_HEAD:0:8}" = b3121df7 ]; }
    note "its first 8 digits are the prefix of the hash planning's brief gave (b3121df7)" "$(is prefix_ok)"
    P5_SPEC_CTL=$(git show "$C:specs/0029-engineering-close.md" | sha256sum | cut -d' ' -f1)
    prefix_ctl() { local SPEC_HEAD=$P5_SPEC_CTL; prefix_ok; }
    note "control: prefix_ok refuses specs/0029's hash at the phase commit" "$(isnot prefix_ctl)"
    S43_HEAD=$(git show "$C:specs/0043-measurement-and-close.md" | sha256sum | cut -d' ' -f1)
    echo "  specs/0043 at the phase commit: sha256 $S43_HEAD"
    prefix_ctl2() { local SPEC_HEAD=$S43_HEAD; prefix_ok; }
    note "control: prefix_ok refuses specs/0043's blob at the phase commit" "$(isnot prefix_ctl2)"
    # Change D92: the base, P1's record commit, holds specs/0045 at P1's doc
    # commit's blob, which this phase's doc commit modifies: a control the pin
    # refuses. specs/0044 is unchanged in the range (part 1's close-out doc
    # commit's blob at both ends), another.
    echo "command: git show <the base>:$SPEC | sha256sum; git show <the base>:specs/0044-excel-check.md | sha256sum; the same at <phase commit> (change D92)"
    S45_BASE=$(git show "$BASE_C:$SPEC" 2>/dev/null | sha256sum | cut -d' ' -f1)
    S44_BASE=$(git show "$BASE_C:specs/0044-excel-check.md" 2>/dev/null | sha256sum | cut -d' ' -f1)
    S44_HEAD=$(git show "$C:specs/0044-excel-check.md" | sha256sum | cut -d' ' -f1)
    echo "  specs/0045 at the base: sha256 $S45_BASE; specs/0044 at the base: sha256 $S44_BASE; at the phase commit: sha256 $S44_HEAD"
    S45_BASE_GAVE=f2adb17a7421940ca97270dcc9cbc65586d74c0b14559e240bfb0137d7f25678
    S44_GAVE=4522b5aaa2c1d446b210d50f82e683880553819b05b6e254aec4c1c8c5b66ffe
    note "specs/0045 at the base is P1's doc commit's blob, read when the generator ran (change D92)" "$(is [ "$S45_BASE" = "$S45_BASE_GAVE" ])"
    note "control: the pin comparison refuses specs/0045's blob at the base (change D92)" "$(isnot [ "$S45_BASE" = "$SPEC_GAVE" ])"
    prefix_ctl3() { local SPEC_HEAD=$S45_BASE; prefix_ok; }
    note "control: prefix_ok refuses specs/0045's blob at the base (change D92)" "$(isnot prefix_ctl3)"
    note "specs/0044 is unchanged in the range, the blob read when the generator ran at both ends (change D92)" "$(is [ "$S44_BASE.$S44_HEAD" = "$S44_GAVE.$S44_GAVE" ])"
    note "control: the pin comparison refuses specs/0044's blob at the phase commit (change D92)" "$(isnot [ "$S44_HEAD" = "$SPEC_GAVE" ])"
    note "control: the same comparison refuses another spec's blob (specs/0027 at the phase commit)" \
      "$(isnot [ "$(git show "$C:specs/0027-read-back.md" | sha256sum | cut -d' ' -f1)" = "$SPEC_GAVE" ])"
    
    echo
    echo "## the phase's commits by role, read from git (header change 2)"
    note_fn() { local label=$1; shift; note "$label" "$(is "$@")"; }
    by_subject() { git log --format='%H' -n 1 -F --grep="$1" "$C"; }
    REC=$(by_subject 'M7 part 2 P1 record: the logs, the records, the checks, the scan')
    DOC=$(by_subject "M7 part 2 P2: commit planning docs (P1's verification and rulings M to P)")
    P72_DOC=$(by_subject "M7 part 2 P1: commit planning docs (the part 2 spec, part 1's close-out verification)")
    echo "command: git log --format=%H -n 1 -F --grep=<the role's full subject> <phase commit>, for each role"
    echo "  M7 part 2 P1's record commit (the base): ${REC:-none}"
    echo "  M7 part 2 P2's doc commit (specs/0045 and ROADMAP.md modified), the phase commit: ${DOC:-none}"
    echo "  M7 part 2 P1's doc commit, by subject (a control, change A92): ${P72_DOC:-none}"
    echo "command: git log -1 --format=%s <each role's commit>"
    for r in "$REC" "$DOC"; do
      [ -n "$r" ] && git log -1 --format='    %s' "$r"
    done
    echo "command: git rev-parse <phase commit>~0 and <phase commit>~1"
    for k in 0 1; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    # Change A89, kept (A90, A92; M6 part 6 P2's A86 form, a phase of one doc
    # commit): the doc commit is the phase commit, P1's record commit its parent.
    roles_in_order() {
      local r k=0
      for r in "$REC" "$DOC"; do
        [ -n "$r" ] || return 1
      done
      for r in "$DOC" "$REC"; do
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    note_fn "the doc commit is the phase commit, M7 part 2 P1's record commit its parent (change A92)" roles_in_order
    roles_ctl1() { local DOC=$REC; if roles_in_order; then return 1; else return 0; fi; }
    roles_ctl4() { local DOC=; if roles_in_order; then return 1; else return 0; fi; }
    roles_ctl5() { local c=$REC t=$DOC; local REC=$t DOC=$c; if roles_in_order; then return 1; else return 0; fi; }
    note_fn "control: roles_in_order refuses the base named as the phase commit (changes A89, A90 and A92)" roles_ctl1
    note_fn "control: roles_in_order refuses a role that resolved to nothing" roles_ctl4
    note_fn "control: roles_in_order refuses the two roles swapped (changes A89, A90 and A92)" roles_ctl5
    roles_ctl8() { local DOC=$P72_DOC; if roles_in_order; then return 1; else return 0; fi; }
    note_fn "control: roles_in_order refuses M7 part 2 P1's doc commit named as the phase commit (change A92)" roles_ctl8
    # Change A89 (A86's form): M6 part 6 P4's README and test commits and
    # Milestone 6 part 6's close-out doc commit, each found by its subject,
    # are refused by the same check; they are history.
    P64_CODE=$(by_subject "M6 part 6 P4: the README brought to Milestone 6")
    P64_TESTC=$(by_subject "M6 part 6 P4: a strict workbook root binding no relationships prefix takes an add")
    P66_CLOSE_DOC=$(by_subject "M6 part 6 close-out: commit planning docs (the P4 verification and rulings)")
    P61_CMPC=$(by_subject "M6 part 6 P1: the comparison scripts gain the five ops and the stem compare-m6p6-")
    echo "  M6 part 6 P4's README and test commits, the part's close-out doc commit and P1's code commit, by subject: ${P64_CODE:-none}, ${P64_TESTC:-none}, ${P66_CLOSE_DOC:-none}, ${P61_CMPC:-none}"
    roles_ctl6() { local DOC=$P64_CODE; if roles_in_order; then return 1; else return 0; fi; }
    note_fn "control: roles_in_order refuses M6 part 6 P4's README commit named as the phase commit (change A89)" roles_ctl6
    roles_ctl7() { local REC=$P66_CLOSE_DOC; if roles_in_order; then return 1; else return 0; fi; }
    note_fn "control: roles_in_order refuses the close-out doc commit named as the base (change A89)" roles_ctl7
    # Change B92 (B89's form): nothing under crates/ is changed since M7 part
    # 2 P1's phase commit, its docs commit, found by its subject; P1's fix 5,
    # which changed 3 files there, the control.
    P72_DOCS=$(by_subject "M7 part 2 P1: the README and the CHANGELOG name the three limits")
    P72_FIX5=$(by_subject "M7 part 2 P1: a moving-average period is 2 to 255")
    echo "  M7 part 2 P1's docs commit, its phase commit, and its fix 5, by subject: ${P72_DOCS:-none}, ${P72_FIX5:-none}"
    crate_same_since() { [ -n "$1" ] && git diff --quiet "$1" "$C" -- crates; }
    echo "command: git diff --name-only <M7 part 2 P1's docs commit, its phase commit> <phase commit> -- crates"
    git diff --name-only "$P72_DOCS" "$C" -- crates | sed 's/^/    /'
    note_fn "crates/ at the phase commit is M7 part 2 P1's phase commit's (change B92)" crate_same_since "$P72_DOCS"
    note "no file under crates/ is changed since M7 part 2 P1's phase commit (change B92)" "$(is [ -z "$(git diff --name-only "$P72_DOCS" "$C" -- crates)" ])"
    crate_ctl() { [ -n "$P72_FIX5" ] && git diff --quiet "$P72_FIX5^" "$P72_FIX5" -- crates; }
    note "control: the same comparison refuses P1's fix 5 against its parent, which changed it (change B92)" "$(isnot crate_ctl)"
    note "control: P1's fix 5 changed 3 files under crates/ (change B92)" "$(is [ "$(git diff --name-only "$P72_FIX5^" "$P72_FIX5" -- crates | count_lines /dev/stdin)" = 3 ])"
    # Change A63, kept (A65 to A71, A74, A79, A82 to A89): part 5 P4's probe and CHANGELOG commits stay
    # named, as the probe's control and the areas' controls read them.
    P54_PROBEC=$(by_subject "M5 part 5 P4: probe-emend-charts-write-xml gains the second set")
    P54_LOGC=$(by_subject "M5 part 5 P4: the CHANGELOG names the second set of charts write")
    echo "  part 5 P4's probe and CHANGELOG commits, by subject: ${P54_PROBEC:-none}, ${P54_LOGC:-none}"
    echo "command: git log --format=%s <M7 part 2 P1's record commit, the base>..<phase commit>"
    git log --format='%s' "$REC..$C" >"$W/subjects"
    sed 's/^/    /' "$W/subjects"
    PREFIX_RE='^M7 part 2 P2: '
    nsub=$(count_lines "$W/subjects")
    nprefix=$(count_matches -E "$PREFIX_RE" "$W/subjects")
    echo "  subjects in the range: $nsub; beginning \"M7 part 2 P2: \": $nprefix"
    prefix_all() { [ "$nsub" -ge 1 ] && [ "$nsub" = "$nprefix" ]; }
    note_fn "every commit in the range carries the phase's subject prefix" prefix_all
    printf 'M7 part 2 P2: x\nM7 part 2: w\nM7 part 2 P1: y\nM7 part 2 P3: z\n' >"$W/c-subjects"
    ctl "one subject of four with the prefix, P2's; the part's, a P1 and a P3 subject refused, same command form (changes A90 and A92)" 1 count_matches -E "$PREFIX_RE" "$W/c-subjects"
    no_such_subject() { [ -z "$(by_subject 'M7 part 2 P2: no such subject anywhere')" ]; }
    note_fn "control: a subject no commit has resolves to nothing" no_such_subject
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $HEAD_SHA"
    note "the phase commit given to this script is a full sha" "$(is full_sha "$C")"
    note "the phase commit given to this script is HEAD" "$(is is_head "$C")"
    note "control: the same comparison refuses the null commit" \
      "$(is not_head "$NULL_SHA")"
    note "control: the same comparison refuses a short sha of the real commit" \
      "$(is not_head "$(printf '%s' "$C" | cut -c1-7)")"
    
    echo "phase: Milestone 7 part 2 P2 (specs/0045-publish.md) gate.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "  the superseded files are kept in <home>/${PHASE_DIR#"$HOME"/}/superseded (changes A33, A35, A40, A42 to A68, A71, A74, A79, A82 to A90, A92)"
      # specs/0014 P2 verification ruling 4: a rerun line names only hashes the
      # command under it prints. Change W68 (ruling AK b, the run log's form):
      # each file RERUN_FILES names is counted, hashed with the directory it is
      # kept in, and checked to lie in <phase>/superseded, by a check line.
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in (rulings AA and AK b)"
      n_rerun_files=0
      n_rerun_missing=0
      n_rerun_outside=0
      for sf in ${RERUN_FILES:-}; do
        n_rerun_files=$((n_rerun_files + 1))
        case "$sf" in "$PHASE_DIR/superseded/"*) ;; *) n_rerun_outside=$((n_rerun_outside + 1)) ;; esac
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" \
            "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          n_rerun_missing=$((n_rerun_missing + 1))
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' \
            "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then
        echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"
      fi
      rerun_hashed() { [ "$n_rerun_files" -gt 0 ] && [ "$n_rerun_missing" = 0 ] && [ "$n_rerun_outside" = 0 ]; }
      note "every file of the attempt RERUN_NOTE names is hashed above and lies in <phase>/superseded, and RERUN_FILES names at least one (rulings AA and AK b; change W68)" "$(is rerun_hashed)"
      # Change W71 (ruling F, part 1 P2's W69): RERUN_FILES names the
      # superseded script that wrote the attempt, a file ending .sh in
      # <phase>/superseded.
      rerun_script() { local sf; for sf in ${RERUN_FILES:-}; do case "$sf" in "$PHASE_DIR/superseded/"*.sh) [ -f "$sf" ] && return 0 ;; esac; done; return 1; }
      note "RERUN_FILES names the superseded script that wrote the attempt, a file ending .sh in <phase>/superseded (ruling F; change W71)" "$(is rerun_script)"
      rerun_script_ctl() { local RERUN_FILES="$PHASE_DIR/superseded/planted.log $SELF"; rerun_script; }
      note "control: the same check refuses a list naming a log in <phase>/superseded and a script outside it (change W71)" "$(isnot rerun_script_ctl)"
    fi
    # SERIALIZED: backed by a measurement at entry, the cargo and rustc processes
    # running before this script starts any.
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run builds <repo> into <target>/main and the consumer crate into <target>/consumer (CARGO_TARGET_DIR; changes J35, K35 and K36)"
    echo "root: <repo> stands for the repository's top level, the directory this script cds to (it lies inside <home>, so it is scrubbed first); scripts/check.sh is run from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/${PHASE_DIR#"$HOME"/}, this phase's directory on the disk (change A33); <phase>/superseded keeps a superseded attempt's files; <phase>/out holds this script's own standard error (specs/0017 P1 verification ruling 7)"
    echo "root: <scripts> stands for <phase>/$(basename "$SELF_DIR"), the directory holding this script"
    echo "root: <build> stands for $([ -n "${GATE_BUILD_ROOT:-}" ] && echo "the directory GATE_BUILD_ROOT names, a dry run's" || echo "<phase>/gate"), this log's build directory (header change 1; change A35): <build>/bin/host and <build>/bin/i686 keep the copies of the DEBUG binaries, the carried form (changes J35, K38, K39 and K40), and <build>/bin/release the copies of the host's RELEASE emend-copy and xlsx-diff the run log runs (change Y89)"
    echo "root: <target> stands for <phase>/target, this phase's cargo target root (specs/0029 item 2 and the specs/0001 rule it writes; changes J35, K35 and K36), one subdirectory per source tree: <target>/main for every build of <repo> (the gate, the crate's feature runs, its clippy and doc runs, the probe crate's clippy runs), as the phase's other logs and dry runs use it, and <target>/consumer for the consumer crate"
    echo "root: <scratch> stands for <phase> where this log names its temporary directories (change T50): <scratch>/tmp is TMPDIR, which this script sets, and <scratch>/w stands for this run's mktemp -d working directory inside it, <scratch>/consumer for the consumer crate's, a mktemp -d directory this run makes under TMPDIR and removes at its end (changes A24 and T51); scripts/counting.sh is read at the phase commit into <scratch>/w/counting.sh and sourced from there (change C3)"
    echo "root: <corpus> stands for the private corpus directory, as the ROADMAP.md text this log prints names it (planning's own text, read from the doc commit; this script reads nothing there; change K90)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    note_fn "<scratch>/w lies inside <scratch>/tmp, TMPDIR, as change T50 makes it" under "$W" "$TMPDIR"
    note_fn "<scratch>/w and <repo> are distinct directories, neither inside the other" apart "$W" "$MAIN"
    note_fn "<phase> and <repo> are distinct directories, neither inside the other" apart "$PHASE_DIR" "$MAIN"
    note_fn "<build> and <scripts> are distinct directories, neither inside the other" apart "$BUILD_ROOT" "$SELF_DIR"
    note_fn "<scratch>/consumer lies inside <scratch>/tmp, TMPDIR, as change T51 makes it" under "$CONSUMER" "$TMPDIR"
    note_fn "<build> and <target> are distinct directories, neither inside the other" apart "$BUILD_ROOT" "$SHARED_TARGET"
    note_fn "<target>/main and <target>/consumer are distinct directories, neither inside the other (change K35)" apart "$MAIN_TARGET" "$CONSUMER_TARGET"
    apart_ctl() { if apart "$BUILD_ROOT" "$PHASE_DIR"; then return 1; else return 0; fi; }
    note_fn "control: apart refuses a directory inside another (<build> inside <phase>)" apart_ctl
    note "no cargo or rustc process was running at entry" "$(is [ "$((n_cargo + n_rustc))" = 0 ])"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    note "ANTHROPIC_API_KEY is not set" "$(is key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    note "control: the same check refuses a shell where the variable is set" "$(isnot key_set_ctl)"
    echo "DEPARTURE: CARGO_BUILD_JOBS=4 (this box stopped two T0 P6d gate runs for low memory)"
    echo
    echo "## script"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$W/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    # Change T52 (specs/0033 "Planning rulings on P2", ruling 7): the shared
    # library's one mktemp call, counting_controls's control directory, lies
    # under TMPDIR. The controls run once more in a subshell, their output
    # dropped, with mktemp wrapped by a function that records the path the
    # real command printed; TMPDIR is the one given. The library removes the
    # directory itself; the recorded path is checked under TMPDIR, and the
    # control runs the same with TMPDIR set to <build> and refuses the path.
    LIB_MK=$W/lib-mktemp
    lib_mktemp_dirs() {
      (
        : >"$LIB_MK"
        mktemp() { local p; p=$(command mktemp "$@") || return 1; printf '%s\n' "$p" >>"$LIB_MK"; printf '%s\n' "$p"; }
        export TMPDIR=$1
        counting_controls >/dev/null 2>&1
      )
      cat "$LIB_MK"
    }
    LIB_DIRS=$(lib_mktemp_dirs "$TMPDIR")
    LIB_CTL_DIRS=$(lib_mktemp_dirs "$BUILD_ROOT")
    lib_one_under() { [ "$(printf '%s\n' "$1" | count_lines /dev/stdin)" = 1 ] && [ -n "$1" ] && under "$1" "$2"; }
    echo "command: counting_controls run again in a subshell with mktemp wrapped to record its path, TMPDIR the one given: the library's mktemp directory with TMPDIR <scratch>/tmp: $LIB_DIRS; with TMPDIR <build> (the control): $LIB_CTL_DIRS"
    note "the counting library's one mktemp directory lies under TMPDIR (change T52; specs/0033 Planning rulings on P2, ruling 7)" "$(is lib_one_under "$LIB_DIRS" "$TMPDIR")"
    lib_ctl() { lib_one_under "$LIB_CTL_DIRS" "$TMPDIR"; }
    note "control: the same check refuses the directory the library made with TMPDIR set to <build>, which it made there (change T52)" "$(isnot lib_ctl)"
    
    echo
    echo "## the phase base, resolved from git and checked for ambiguity"
    # specs/0001 requires the base to be read from git by the first doc commit's
    # subject, never typed; its parent is the base. The count of doc commits is
    # deliberately NOT asserted; structure_sound below asserts the structure.
    DOC_PATTERN='^M7 part 2 P2: commit planning docs [(]P1'"'"'s verification and rulings M to P[)]$'
    echo "command: git log --format='%H' --grep='$DOC_PATTERN'"
    git log --format='%H' --grep="$DOC_PATTERN" >"$W/doc-matches"
    nmatch=$(count_lines "$W/doc-matches")
    echo "  commits matching the first doc commit's pattern: $nmatch"
    note "the first doc commit's pattern matches exactly one commit" "$(is [ "$nmatch" = 1 ])"
    DOC=$(git log --format='%H' --grep="$DOC_PATTERN" -n 1)
    BASE=$(git rev-parse --verify "$DOC^" 2>/dev/null)
    echo "  the first doc commit is $DOC"
    echo "  its parent, the phase base, is $BASE"
    note "the base resolved from git, not typed" "$(is [ -n "$BASE" ])"
    CLOSE_REC=$(git log --format='%H' -n 1 --grep='^M7 part 2 P1 record:')
    echo "  M7 part 2 P1's record commit, by subject: ${CLOSE_REC:-none found}"
    note "the phase base is M7 part 2 P1's record commit (change A92)" "$(is [ "$BASE" = "$CLOSE_REC" ])"
    note "control: the same comparison refuses the first doc commit as the base" \
      "$(isnot [ "$DOC" = "$CLOSE_REC" ])"
    
    echo
    echo "## the phase's commits"
    # Change A86, kept (A89): is_ancestor_of_base <commit>: the commit is the
    # base or one of its ancestors, outside the range.
    is_ancestor_of_base() { git merge-base --is-ancestor "$1" "$BASE"; }
    echo "command: git log --reverse --format='%H %s' <base>..<phase commit>"
    git log --reverse --format='    %H %s' "$BASE..$C"
    ncommits=$(git rev-list --count "$BASE..$C")
    echo "  commits in the range: $ncommits"
    # Each commit is classified by the paths it touches, and the sequence is
    # checked as one property in one function (changes A45 to A68, A71, A74, A84 to A86, A89): a mixed
    # or empty commit fails, the range opens with a doc commit and holds at
    # least one code commit. Change A89 (M6 part 6 P2's A86): this phase is
    # a doc commit alone (specs/0044 "P1": no code commit unless a ruling
    # names one), so the carried structure_sound is shown to refuse the range,
    # as a control, and docs_only_sound (M4 part 1 P3's A44 form: every commit
    # a doc commit, at least one, no code commit) is the check.
    commit_class() {
      git show --name-only --format= "$1" | awk '
        NF { total++; if ($0 ~ /^specs\// || $0 == "ROADMAP.md" || $0 == "CLAUDE.md") docs++ }
        END {
          if (total == 0) { print "empty"; exit }
          if (docs == total) print "doc"; else if (docs == 0) print "code"; else print "mixed"
        }'
    }
    structure_sound() {
      awk 'NR == 1 && $1 != "doc" { bad = 1 }
           $1 == "mixed" || $1 == "empty" { bad = 1 }
           $1 == "code" { code = 1 }
           END { exit (bad || !code || NR == 0) }' "$1"
    }
    : >"$W/classes"
    for h in $(git rev-list --reverse "$BASE..$C"); do
      printf '%s %s\n' "$(commit_class "$h")" "$(git log --format='%h %s' -n 1 "$h")" >>"$W/classes"
    done
    sed 's/^/    /' "$W/classes"
    docs_only_sound() {
      awk '$1 != "doc" { bad = 1 }
           END { exit (bad || NR == 0) }' "$1"
    }
    note "every commit is planning docs alone, the range opens with a doc commit and holds no code commit (changes A86 and A89)" \
      "$(is docs_only_sound "$W/classes")"
    note "control: the carried structure_sound, which requires a code commit, refuses this range (changes A86 and A89)" \
      "$(isnot structure_sound "$W/classes")"
    ndoc=$(count_matches -E '^doc ' "$W/classes")
    ncode=$(count_matches -E '^code ' "$W/classes")
    echo "  of the $ncommits commits in the range: $ndoc planning-doc, $ncode code"
    note "the phase holds at least one doc commit, counted in the range" \
      "$(is [ "$ndoc" -ge 1 ])"
    note "the range holds no code commit (changes A86 and A89)" \
      "$(is [ "$ncode" = 0 ])"
    note "control: the two classes account for every commit in the range" \
      "$(is [ "$((ndoc + ncode))" = "$ncommits" ])"
    note "control: commit_class calls the first doc commit a doc commit" \
      "$(is [ "$(commit_class "$DOC")" = doc ])"
    # The code-commit control names its commit by what that commit DID: the
    # last commit up to the phase commit that modified
    # scripts/compare-record.py, M6 part 6 P1's code commit, outside the range (changes
    # A47 to A68, A71, A74, A84 to A86, A89; no commit of this phase modifies
    # code).
    CODEC=$(git log --format='%H' -n 1 --diff-filter=M "$C" -- scripts/compare-record.py)
    echo "  the last commit that modified scripts/compare-record.py: ${CODEC:-none found}"
    codec_before() { [ -n "$CODEC" ] && is_ancestor_of_base "$CODEC"; }
    note "the last commit that modified scripts/compare-record.py resolved from git, before the range (changes A86 and A89)" "$(is codec_before)"
    note "control: commit_class calls the commit that modified scripts/compare-record.py a code commit (changes A68, A71, A84 to A86, A89)" \
      "$(is [ "$(commit_class "$CODEC")" = code ])"
    note "control: commit_class calls M7 part 2 P1's record commit, its logs and records, a code commit (not a doc commit; changes A86, A89, A90 and A92)" \
      "$(is [ "$(commit_class "$CLOSE_REC")" = code ])"
    note "control: the doc commit carries specs/0045, a path the classifier reads as a doc (changes A86, A89 and A92)" \
      "$(is [ "$(git show --name-only --format= "$DOC" | count_matches -Fx specs/0045-publish.md /dev/stdin)" = 1 ])"
    printf 'doc a docs\ncode b code\ndoc c docs\ncode d code\n' >"$W/c-ord-ok"
    printf 'code a code\ndoc b docs\n'                        >"$W/c-ord-first"
    printf 'doc a docs\nmixed b both\ncode c code\n'          >"$W/c-ord-mixed"
    printf 'doc a docs\nempty b nothing\ncode c code\n'       >"$W/c-ord-empty"
    printf 'doc a docs\ndoc b docs\n'                         >"$W/c-ord-nocode"
    printf 'doc a docs\n' >"$W/c-ord-onedoc"
    printf 'doc a docs\ncode b code\n' >"$W/c-ord-code"
    note "control: docs_only_sound accepts one doc commit (M4 part 1 P3's A44 form; changes A86 and A89)" \
      "$(is docs_only_sound "$W/c-ord-onedoc")"
    note "control: docs_only_sound rejects a range with a code commit (changes A86 and A89)" \
      "$(isnot docs_only_sound "$W/c-ord-code")"
    note "control: docs_only_sound rejects a commit mixing docs and code (changes A86 and A89)" \
      "$(isnot docs_only_sound "$W/c-ord-mixed")"
    note "control: docs_only_sound rejects an empty commit (changes A86 and A89)" \
      "$(isnot docs_only_sound "$W/c-ord-empty")"
    note "control: structure_sound accepts docs and code interleaved" \
      "$(is structure_sound "$W/c-ord-ok")"
    note "control: structure_sound rejects a range that opens with a code commit" \
      "$(isnot structure_sound "$W/c-ord-first")"
    note "control: structure_sound rejects a commit mixing docs and code" \
      "$(isnot structure_sound "$W/c-ord-mixed")"
    note "control: structure_sound rejects an empty commit" \
      "$(isnot structure_sound "$W/c-ord-empty")"
    note "control: isnot reports a passing command as UNEXPECTED, so it can fail" \
      "$(is [ "$(isnot true)" = UNEXPECTED ])"
    note "control: structure_sound rejects a range with no code commit" \
      "$(isnot structure_sound "$W/c-ord-nocode")"
    # Change A37, kept (A38): every doc commit before every code commit.
    docs_first() { awk '$1 == "code" { c = 1 } $1 == "doc" && c { bad = 1 } END { exit bad }' "$1"; }
    note "no doc commit follows a code commit in the range (changes A37 to A40, A42 to A68, A71, A74)" "$(is docs_first "$W/classes")"
    printf 'doc a docs\ndoc b docs\ncode c code\ncode d code\n' >"$W/c-ord-first-docs"
    note "control: docs_first accepts two doc commits before two code commits" "$(is docs_first "$W/c-ord-first-docs")"
    note "control: docs_first refuses docs and code interleaved" "$(isnot docs_first "$W/c-ord-ok")"
    
    echo
    echo "## every commit message in the range: ASCII, ending with the Co-Authored-By line only"
    COAUTHOR='Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>'
    msg_form_ok() {
      local last nco nsess nna ntrail
      last=$(awk 'NF { l = $0 } END { print l }' "$1")
      nco=$(count_matches -E '^Co-Authored-By:' "$1")
      nsess=$(count_matches_i -F 'claude-session' "$1")
      nna=$(count_bytes "$NONASCII_CLASS" "$1")
      ntrail=$(git interpret-trailers --parse <"$1" | count_lines /dev/stdin)
      [ "$last" = "$COAUTHOR" ] || return 1
      [ "$nco" = 1 ] || return 1
      [ "$nsess" = 0 ] || return 1
      [ "$ntrail" = 1 ] || return 1
      [ "$nna" = 0 ]
    }
    for h in $(git rev-list --reverse "$BASE..$C"); do
      git log -1 --format=%B "$h" >"$W/msg"
      echo "  $(git log -1 --format=%h "$h"): message lines $(count_lines "$W/msg"), non-ASCII bytes $(count_bytes "$NONASCII_CLASS" "$W/msg"), trailers git parses:"
      git interpret-trailers --parse <"$W/msg" | sed 's/^/      /'
      note "$(git log -1 --format=%h "$h")'s message is ASCII and ends with the Co-Authored-By line only" \
        "$(is msg_form_ok "$W/msg")"
    done
    printf 'subject\n\nbody\n\n%s\n' "$COAUTHOR" >"$W/c-msg-ok"
    printf 'subject\n\nbody\n\n%s\n%s: x\n' "$COAUTHOR" 'Claude-Session' >"$W/c-msg-session"
    printf 'subj\303\251ct\n\n%s\n' "$COAUTHOR" >"$W/c-msg-nonascii"
    printf 'subject\n\n%s\n%s\n' "$COAUTHOR" "$COAUTHOR" >"$W/c-msg-twice"
    printf 'subject\n\nbody\n' >"$W/c-msg-none"
    note "control: msg_form_ok accepts a message ending with the line" "$(is msg_form_ok "$W/c-msg-ok")"
    note "control: msg_form_ok refuses a session line after it" "$(isnot msg_form_ok "$W/c-msg-session")"
    note "control: msg_form_ok refuses a non-ASCII byte" "$(isnot msg_form_ok "$W/c-msg-nonascii")"
    note "control: msg_form_ok refuses the line twice" "$(isnot msg_form_ok "$W/c-msg-twice")"
    note "control: msg_form_ok refuses a message without it" "$(isnot msg_form_ok "$W/c-msg-none")"
    # Change J3 (specs/0018 P2 verification ruling 5 and P3 verification ruling
    # 2, G9, carried in the scan script's form): the count rule on EVERY commit
    # of the phase. A message passes when it carries the diff-alone sentence,
    # read with its line breaks folded, or when it states no count. counts_in
    # prints the numbers left in the body (the trailer dropped) once identifiers
    # are removed: words holding a slash (paths), tokens such as P1 or M2, and the
    # number after "ruling", "decision", "part", "phase" or "section", with any
    # "to" or "and" range after it; what is left, a whole-word number in digits or
    # a number word to twenty, is a count.
    COUNT_SENTENCE='No log prints a count for this commit; the diff alone carries what it changes.'
    says_diff_alone() { tr '\n' ' ' <"$1" | tr -s ' ' | LC_ALL=C "$G" -qF "$COUNT_SENTENCE"; }
    counts_in() {
      python3 -I -B - "$1" <<'COUNTS'
    import re, sys
    text = open(sys.argv[1]).read()
    body = "\n".join(l for l in text.split("\n") if not re.match(r"^Co-Authored-By:", l))
    body = " ".join(body.split())
    body = " ".join(w for w in body.split(" ") if "/" not in w)
    body = re.sub(r"\b[A-Z][0-9]+\b", " ", body)
    num = r"(?:[0-9]+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)"
    body = re.sub(r"\b(?:rulings?|decisions?|parts?|phases?|sections?)\b[^.;:]*?\b" + num + r"\b(?:,? (?:to|and) " + num + r"\b)*", " ", body, flags=re.I)
    for m in re.finditer(r"\b" + num + r"\b", body, flags=re.I):
        print(m.group(0))
    COUNTS
    }
    states_no_count() { [ -z "$(counts_in "$1")" ]; }
    count_rule_ok() { says_diff_alone "$1" || states_no_count "$1"; }
    for h in $(git rev-list --reverse "$BASE..$C"); do
      git log -1 --format=%B "$h" >"$W/msg-rule"
      found=$(counts_in "$W/msg-rule" | tr '\n' ' ')
      sentence=$(says_diff_alone "$W/msg-rule" && echo yes || echo no)
      echo "  $(git log -1 --format=%h "$h"): counts left after the identifiers: ${found:-none}; the diff-alone sentence: $sentence"
      note "$(git log -1 --format=%h "$h")'s message states no count or says the diff alone carries its counts (change J3)" "$(is count_rule_ok "$W/msg-rule")"
    done
    printf 'subject\n\nNo log prints a count for this\ncommit; the diff alone carries what it changes.\n' >"$W/c-msg-folded"
    note "control: says_diff_alone reads the sentence across a line break" "$(is says_diff_alone "$W/c-msg-folded")"
    note "control: says_diff_alone refuses a message without it" "$(isnot says_diff_alone "$W/c-msg-ok")"
    printf 'M7 part 2 P2: x\n\nThe rulings during P1, 1 to 3, and decisions 4 to 6 A; specs/0027-x.md.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-ids"
    printf 'M7 part 2 P2: x\n\nAdds three tests and 14 lines.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-count"
    printf 'M7 part 2 P2: x\n\nAdds three tests. No log prints a count for this commit; the\ndiff alone carries what it changes.\n\n%s\n' "$COAUTHOR" >"$W/c-rule-both"
    note "control: count_rule_ok accepts a message whose numbers are identifiers and a trailer" "$(is count_rule_ok "$W/c-rule-ids")"
    note "control: count_rule_ok refuses a message stating counts without the sentence" "$(isnot count_rule_ok "$W/c-rule-count")"
    note "control: count_rule_ok accepts the same counts beside the sentence" "$(is count_rule_ok "$W/c-rule-both")"
    ctl "counts_in finds the two counts of the refused message, same command form" 2 run_lines counts_in "$W/c-rule-count"
    
    echo
    echo "## the doc commit's files against the hashes of their blobs and against the hashes its message gives; the lines it removes printed (header change 3; changes B33, B35, D38 to D42, D43 to D49, D50 to D58, D59 to D62, D63, D66 to D68, D71, D74, D79, D82 to D90, D92)"
    # The expected values were read from the doc commit's blobs when the
    # generator ran, each checked there against FACTS.md's full hash, the one
    # planning's brief gave (changes D63, D66 to D68, D71, D74, D79, D82 to
    # D90, D92). Every computed hash is printed by the command that made it.
    # Change D92 (D90's form): the phase holds one doc commit, the phase
    # commit itself, modifying specs/0045 and ROADMAP.md.
    echo "  the doc commit: $DOC"
    blob_sha() { git show "$1:$2" | sha256sum | cut -d' ' -f1; }
    blob_matches() {
      git cat-file -e "$1:$2" 2>/dev/null || return 1
      [ "$(blob_sha "$1" "$2")" = "$3" ]
    }
    while read -r which path given prefix; do
      case "$which" in doc) at=$DOC ;; head) at=$C ;; esac
      if git cat-file -e "$at:$path" 2>/dev/null; then got=$(blob_sha "$at" "$path"); else got=absent; fi
      echo "  $which $(git rev-parse --short "$at") $path"
      echo "    command: git show <commit>:$path | sha256sum"
      echo "    sha256 $got"
      echo "    the doc commit's blob's hash: $given (its prefix: $prefix)"
      note "$which's $path is the doc commit's blob" "$(is blob_matches "$at" "$path" "$given")"
      note "the hash this check expects begins with its prefix" "$(is [ "${given:0:8}" = "$prefix" ])"
    done <<'HASHES'
    doc ROADMAP.md 466fc0daf4840dda5ea635dce584a1fd01356745b1a2877a87bbd4e0cfad68ea 466fc0da
    doc specs/0045-publish.md b3121df72cb1aac9238151078270928eb467c7b06809de5e5f36c16f3ed412ea b3121df7
    head ROADMAP.md 466fc0daf4840dda5ea635dce584a1fd01356745b1a2877a87bbd4e0cfad68ea 466fc0da
    head specs/0045-publish.md b3121df72cb1aac9238151078270928eb467c7b06809de5e5f36c16f3ed412ea b3121df7
    HASHES
    TAB=$(printf '\t')
    git show --name-status --format= "$DOC" | LC_ALL=C sort -k2 >"$W/doc-files"
    printf '%s\n' "M${TAB}ROADMAP.md" "M${TAB}specs/0045-publish.md" | LC_ALL=C sort -k2 >"$W/doc-want"
    sed 's/^/    the doc commit carries: /' "$W/doc-files"
    note "the doc commit modifies specs/0045 and ROADMAP.md, nothing else (change D92)" "$(is cmp -s "$W/doc-files" "$W/doc-want")"
    printf '%s\n' "M${TAB}ROADMAP.md" "A${TAB}specs/0045-publish.md" | LC_ALL=C sort -k2 >"$W/c-doc-status"
    note "control: the comparison refuses specs/0045 added rather than modified, P1's doc commit's form (change D92)" "$(isnot cmp -s "$W/c-doc-status" "$W/doc-want")"
    note "control: blob_matches refuses the doc commit's ROADMAP.md hash at the base, which holds P1's doc commit's copy (3106f10d; change D92)" \
      "$(isnot blob_matches "$BASE" ROADMAP.md 466fc0daf4840dda5ea635dce584a1fd01356745b1a2877a87bbd4e0cfad68ea)"
    note "control: blob_matches refuses the doc commit's specs/0045 hash at the base, which holds P1's doc commit's copy (f2adb17a; change D92)" \
      "$(isnot blob_matches "$BASE" specs/0045-publish.md b3121df72cb1aac9238151078270928eb467c7b06809de5e5f36c16f3ed412ea)"
    note "control: blob_matches accepts P1's doc commit's specs/0045 hash at the base, so the check can pass there (change D92)" \
      "$(is blob_matches "$BASE" specs/0045-publish.md f2adb17a7421940ca97270dcc9cbc65586d74c0b14559e240bfb0137d7f25678)"
    note "control: blob_matches accepts P1's doc commit's ROADMAP.md hash at the base (change D92)" \
      "$(is blob_matches "$BASE" ROADMAP.md 3106f10d4bf6f7ad3fa356cb5b8460ab62b24ced9a8cbb32767eb83f364c25bb)"
    # Change R59, kept (D60 to D68, D71, D74, D79, D82 to D89; planning's ruling C, specs/0036 "Planning
    # rulings during P1"): the doc commit's own message is read with its line
    # breaks folded, as change J3's says_diff_alone reads it, and for each of
    # its files the first "sha256 <hash>" after the file's path is taken,
    # whatever words lie between; the pairs are then compared as a set with
    # the blobs' pairs built the same way (change D92: two pairs; the doc
    # commit carries the two "<path> sha256 <blob>" lines, rule GN, the
    # form of specs/0044 ruling Y).
    # msg_hash_pairs <message file> <path>...: "<path> sha256 <hash>" for each
    # path the folded message names with a hash after it.
    msg_hash_pairs() {
      local f=$1
      shift
      tr '\n' ' ' <"$f" | tr -s ' ' | python3 -I -B -c '
    import re, sys
    text = sys.stdin.read()
    for path in sys.argv[1:]:
        m = re.search(r"(?:^|[\s(])" + re.escape(path) + r"(?=[\s,;:)]|$)", text)
        if not m:
            continue
        h = re.search(r"\bsha256 ([0-9a-f]{64})\b", text[m.end():])
        if h:
            print("%s sha256 %s" % (path, h.group(1)))
    ' "$@" | LC_ALL=C sort -u || :
    }
    DOC_PATHS="specs/0045-publish.md ROADMAP.md"
    git log -1 --format=%B "$DOC" >"$W/doc-msg"
    msg_hash_pairs "$W/doc-msg" $DOC_PATHS >"$W/doc-msg-hashes"
    for path in $DOC_PATHS; do
      printf '%s sha256 %s\n' "$path" "$(blob_sha "$DOC" "$path")"
    done | LC_ALL=C sort -u >"$W/doc-blob-hashes"
    echo "command: git log -1 --format=%B <the doc commit>, line breaks folded, for each of its paths the first 'sha256 <hash>' after it read; and, for its files, the path, sha256 and git show <the doc commit>:<path> | sha256sum (changes R59, D68, D71, D74, D79, D82 to D89; ruling C)"
    sed 's/^/    the doc commit'"'"'s message holds: /' "$W/doc-msg-hashes"
    sed 's/^/    the doc commit'"'"'s blobs hash: /' "$W/doc-blob-hashes"
    note "the doc commit's message gives exactly its blobs' hashes, in full, read folded (changes R59, D68, D71, D74, D79, D82 to D89; ruling C)" "$(is cmp -s "$W/doc-msg-hashes" "$W/doc-blob-hashes")"
    ctl "the pairs the doc commit's message gives, same command form (change D92)" 2 count_lines "$W/doc-msg-hashes"
    # Change R59's controls, kept (D60 to D68, D71, D74, D85 to D89): a planted
    # message in b60d4f5's form (a bullet per file, a parenthesis after the
    # path, the hash on the next line) is accepted; the same message with its
    # last hash's last digit changed is refused.
    while read -r path rest; do
      printf -- '- %s (planted words, more of them),\n  sha256\n  %s\n' "$path" "${rest#sha256 }"
    done <"$W/doc-blob-hashes" >"$W/c-doc-folded"
    msg_hash_pairs "$W/c-doc-folded" $DOC_PATHS >"$W/c-doc-folded-hashes"
    note "control: the folded reading accepts a planted message in the bullet form, a parenthesis and line breaks between each path and its hash (changes R59, D68, D71, D74, D79, D82 to D89; ruling C)" "$(is cmp -s "$W/c-doc-folded-hashes" "$W/doc-blob-hashes")"
    ctl "the pairs in the planted bullet-form message of two, same command form (change D92)" 2 run_lines msg_hash_pairs "$W/c-doc-folded" $DOC_PATHS
    sed '$ s/.$/0/' "$W/c-doc-folded" >"$W/c-doc-wrong"
    if cmp -s "$W/c-doc-wrong" "$W/c-doc-folded"; then sed '$ s/.$/1/' "$W/c-doc-folded" >"$W/c-doc-wrong"; fi
    msg_hash_pairs "$W/c-doc-wrong" $DOC_PATHS >"$W/c-doc-wrong-hashes"
    note "control: the same check refuses the planted message with its last hash differing in its last digit (changes R59, D68, D71, D74, D79, D82 to D89; ruling C)" "$(isnot cmp -s "$W/c-doc-wrong-hashes" "$W/doc-blob-hashes")"
    sed '$d' "$W/doc-want" >"$W/c-doc-short"
    note "control: the file comparison refuses a list one file short" "$(isnot cmp -s "$W/c-doc-short" "$W/doc-want")"
    # Change D83, kept (P1's D47; D84 to D89): the lines the doc commit removes
    # are planning's text and are printed.
    removed_count() { LC_ALL=C "$G" -E '^-' "$1" | LC_ALL=C "$G" -vcE '^--- ' || :; }
    for path in $DOC_PATHS; do
      git show -U0 --format= "$DOC" -- "$path" >"$W/doc-diff"
      echo "command: git show -U0 --format= <the doc commit> -- $path, the lines removed (a leading -, not the --- file line)"
      echo "  doc $path: lines removed $(removed_count "$W/doc-diff")"
      git show -U0 --format= "$DOC" -- "$path" | LC_ALL=C "$G" -E '^-' | LC_ALL=C "$G" -vE '^--- ' | sed 's#^#    '"$path"' removes (planning'"'"'s): #' || :
    done
    printf -- '--- a/x\n+++ b/x\n@@ -1,2 +1,1 @@\n-gone line\n' >"$W/c-removed"
    ctl "removed lines in a planted diff of one removal, same command form" 1 removed_count "$W/c-removed"
    
    echo
    echo "## each commit's diff and the phase's combined diff, hashed with the command that produced each"
    for h in $(git rev-list --reverse "$BASE..$C"); do
      cmd="git show --no-color --no-ext-diff --format= $h"
      echo "  command: $cmd | sha256sum"
      echo "    $($cmd | sha256sum | cut -d' ' -f1)  $(git log -1 --format=%s "$h")"
    done
    cmd="git diff --no-color --no-ext-diff $BASE $C"
    echo "  command: $cmd | sha256sum"
    echo "    $($cmd | sha256sum | cut -d' ' -f1)  the phase's combined diff"
    h1=$(git show --no-color --no-ext-diff --format= "$C" | sha256sum | cut -d' ' -f1)
    h2=$(git show --no-color --no-ext-diff --format= "$C" | sha256sum | cut -d' ' -f1)
    h3=$(git show --no-color --no-ext-diff --format= "$C^" | sha256sum | cut -d' ' -f1)
    note "control: the phase commit's diff hashes the same twice" "$(is [ "$h1" = "$h2" ])"
    note "control: its parent's diff hashes differently" "$(isnot [ "$h1" = "$h3" ])"
    
    echo
    echo "## the changed files at the phase commit"
    for f in $(git diff --name-only --diff-filter=d "$BASE" "$C"); do
      git show "$C:$f" >"$W/f" 2>/dev/null || { echo "$f: READ ERROR"; fail=1; continue; }
      echo "$f: sha256 $(sha256sum <"$W/f" | cut -d' ' -f1), bytes $(wc -c <"$W/f"), mode $(git ls-tree "$C" -- "$f" | awk '{print $1}')"
    done
    git diff --name-only --diff-filter=d "$BASE" "$C" >"$W/difffiles"
    echo "  files in the diff: $(count_lines "$W/difffiles")"
    new_mode() { [ "$(git ls-tree "$C" -- "$1" | awk '{print $1}')" = 100755 ]; }
    # Change G37, kept (G38): a modified file keeps its base mode, and an added
    # file is not executable.
    mode_at() { git ls-tree "$1" -- "$2" | awk '{print $1}'; }
    mode_kept() { [ -n "$(mode_at "$BASE" "$1")" ] && [ "$(mode_at "$BASE" "$1")" = "$(mode_at "$C" "$1")" ]; }
    git diff --name-only --diff-filter=A "$BASE" "$C" >"$W/mode-added"
    git diff --name-only --diff-filter=M "$BASE" "$C" >"$W/mode-modified"
    while IFS= read -r m; do
      echo "  $m (modified): mode at the base $(mode_at "$BASE" "$m"); at the phase commit $(mode_at "$C" "$m")"
      note "$m keeps its base mode (change G37)" "$(is mode_kept "$m")"
    done <"$W/mode-modified"
    # Change G63, kept (G65 to G68, G71, G74, G79, G82 to G90): the names this phase's checks need, built
    # from pieces: the fixture's, so this text holds no office file name (the
    # header's rule), and the ops test's, the comparison record's test's and
    # the container tool's, so that the count in the areas section reads this
    # script's calls and not its own words.
    XL=xl; SX=sx
    FIXTURE_PATH=tests/fixtures/openpyxl-ops.$XL$SX
    OT_WORD=openpyxl-ops-; OT_WORD=${OT_WORD}test
    CT_WORD=compare-record-; CT_WORD=${CT_WORD}test
    PM_WORD=pod; PM_WORD=${PM_WORD}man
    OT_PATH=scripts/$OT_WORD.sh
    CT_PATH=scripts/$CT_WORD.py
    # Change G90 (G86's form, part 5 P3's G84): this phase adds no file; the
    # two files it modifies keep their base modes (above); the ops test, not
    # in this phase's diff, keeps its 100755.
    EXEC_ADDED=""
    exec_expected() { case " $EXEC_ADDED " in *" $1 "*) return 0 ;; esac; return 1; }
    nexec=0
    nadded=0
    while IFS= read -r m; do
      echo "  $m (added): mode at the phase commit $(mode_at "$C" "$m")"
      nadded=$((nadded + 1))
      if exec_expected "$m"; then
        note "$m, a script this phase adds under scripts/, is executable" "$(is new_mode "$m")"
        nexec=$((nexec + 1))
      else
        note "$m, added in this phase, is not executable" "$(isnot new_mode "$m")"
      fi
    done <"$W/mode-added"
    echo "  files added in this phase: $nadded"
    git diff --name-only --diff-filter=A "$BASE" "$C" | LC_ALL=C sort >"$W/mode-added-sorted"
    : >"$W/mode-added-want"
    note "the phase adds no file (changes G90 and G92)" "$(is [ "$nadded.$nexec" = 0.0 ])"
    note "the list of added files is empty (changes G90 and G92)" "$(is cmp -s "$W/mode-added-sorted" "$W/mode-added-want")"
    printf '%s\n' specs/0045-publish.md >"$W/c-mode-added"
    note "control: the comparison refuses a list of one file, specs/0045, which M7 part 2 P1's doc commit added (change G92)" "$(isnot cmp -s "$W/c-mode-added" "$W/mode-added-want")"
    note "control: exec_expected refuses the comparison record, which part 6 P2 added (changes G68, G71 and G74)" "$(isnot exec_expected scripts/compare-record.py)"
    note "control: the same mode check finds the runner executable" "$(is new_mode scripts/passthrough-run.sh)"
    ops_test_mode() { [ "$(mode_at "$C" "$OT_PATH")" = 100755 ] && mode_kept "$OT_PATH"; }
    note "the ops test, not in this phase's diff, keeps its mode 100755 (changes G84 to G90, G92)" "$(is ops_test_mode)"
    note "control: the same mode check refuses the spec (M3 part 1 P2's change C19, carried)" "$(isnot new_mode specs/0030-carries-and-api-changes.md)"
    mode_kept_ctl() { mode_kept no/such/path/in/either/commit; }
    note "control: mode_kept refuses a path neither commit holds (changes G38 to G40, G42 to G53, kept)" "$(isnot mode_kept_ctl)"
    
    echo
    echo "## the gate files this phase changed, and the self-test they require: none, so no self-test (P1's change F50 reverted to P3's form; change F51)"
    # specs/0001-bootstrap.md, "Rules for every phase": a phase that changes no
    # gate file LISTS IN gate.log the gate files it checked against the diff.
    cat >"$W/gate-files" <<'EOF'
    scripts/check.sh
    scripts/privacy.sh
    scripts/privacy-patterns.txt
    scripts/privacy-identity.txt
    scripts/sys-allowlist.txt
    scripts/install-hooks.sh
    scripts/counting.sh
    scripts/gate-self-test.sh
    .gitignore
    .github/workflows/ci.yml
    EOF
    echo "command: awk over specs/0001-bootstrap.md, the bullet opening '- A phase that changes a gate file' up to its first 'runs', backticked names"
    git show "$C:specs/0001-bootstrap.md" | awk '/^- A phase that changes a gate file/ { on = 1 } on { print } on && /runs/ { exit }' >"$W/gate-sentence"
    sed 's/^/    /' "$W/gate-sentence"
    tr -d '\n' <"$W/gate-sentence" | LC_ALL=C "$G" -o -E '`[^`]+`' | tr -d '`' | LC_ALL=C "$G" -v -E ' ' | sort >"$W/gate-from-spec"
    LC_ALL=C "$G" -v -Fx .github/workflows/ci.yml "$W/gate-files" | sort >"$W/gate-typed"
    sed 's/^/    named in specs\/0001: /' "$W/gate-from-spec"
    ci_named() { [ "$(count_matches -F 'the CI workflow' "$W/gate-sentence")" = 1 ]; }
    note "the typed gate-file list is specs/0001's backticked names plus the CI workflow" "$(is cmp -s "$W/gate-from-spec" "$W/gate-typed")"
    note "specs/0001's sentence names the CI workflow" "$(is ci_named)"
    LC_ALL=C "$G" -v -Fx scripts/counting.sh "$W/gate-typed" >"$W/c-gate-typed"
    note "control: the comparison refuses the typed list one name short" "$(isnot cmp -s "$W/gate-from-spec" "$W/c-gate-typed")"
    echo "  the gate files specs/0001 names, each checked against the phase diff:"
    sed 's/^/    checked: /' "$W/gate-files"
    touched=0
    while IFS= read -r g; do
      if LC_ALL=C "$G" -Fxq -- "$g" "$W/difffiles"; then
        echo "  gate file in the diff: $g"
        touched=$((touched + 1))
      fi
    done <"$W/gate-files"
    echo "  gate files checked: $(count_lines "$W/gate-files"); of them in the phase diff: $touched"
    note "no gate file is in the phase diff, so specs/0001 asks for this listing and no self-test (changes F38, F40 and F51)" \
      "$(is [ "$touched" = 0 ])"
    # Change F51: the same search over P1's scripts commit, which changed the
    # gate file scripts/check.sh, finds it: the control that the search can
    # find a gate file.
    P1_SCR=$(git log --format='%H' -n 1 -F --grep='M5 part 2 P1: committed scripts call python3 with -I -B' "$C")
    echo "  P1's scripts commit, by subject: ${P1_SCR:-none found}"
    git show --name-only --format= "$P1_SCR" >"$W/c-p1-scr-files"
    p1_touched=0
    while IFS= read -r g; do
      if LC_ALL=C "$G" -Fxq -- "$g" "$W/c-p1-scr-files"; then
        echo "    gate file in P1's scripts commit: $g"
        p1_touched=$((p1_touched + 1))
      fi
    done <"$W/gate-files"
    note "control: the same search over P1's scripts commit finds its one gate file, scripts/check.sh (change F51)" \
      "$(is [ "$p1_touched" = 1 ])"
    FIRST_DIFF=$(sed -n '1p' "$W/difffiles")
    echo "  a file that IS in the phase diff, taken from the diff: $FIRST_DIFF"
    found_first=$(count_matches -Fx "$FIRST_DIFF" "$W/difffiles")
    note "control: the same search finds a name the diff does hold" \
      "$(is [ "$found_first" -ge 1 ])"
    in_diff_not_gate() {
      [ "$(count_matches -Fx "$1" "$W/difffiles")" = 1 ] &&
        [ "$(count_matches -Fx "$1" "$W/gate-files")" = 0 ]
    }
    # Every file the phase diff holds, read from the diff rather than typed.
    while IFS= read -r s; do
      echo "  $s: in the phase diff $(count_matches -Fx "$s" "$W/difffiles") times; in the gate-file list $(count_matches -Fx "$s" "$W/gate-files") times"
      note "$s is in the diff and is not a gate file" "$(is in_diff_not_gate "$s")"
    done <"$W/difffiles"
    gate_ctl() { in_diff_not_gate scripts/counting.sh; }
    note "control: in_diff_not_gate refuses a gate file the phase diff does not hold (scripts/counting.sh)" "$(isnot gate_ctl)"
    ST=records/logs/m7p2-p2/self-test.log
    echo "  $ST: $([ -e "$ST" ] && echo PRESENT || echo "absent, as a phase with no gate-file change requires")"
    note "this phase committed no self-test log, having changed no gate file (changes F38, F40 to F46, F47 to F49, F51; kept)" \
      "$(is [ ! -e "$ST" ])"
    
    echo
    echo "## no code commit: the phase diff the doc commit's two files alone; the tree at the phase commit the base's outside them; no manifest and no lock; no Rust source; nothing under crates/, tools/ or scripts/; the three comparison scripts, scripts/openpyxl-ops.py, CHANGELOG.md, README.md and scripts/passthrough-run.sh not in the range; the crate's messages the base's by both readers, none added and none gone; this script runs neither the ops test, the comparison record's test nor the container tool (changes E86, E89, E90 and E92; changes E53 to E68, E71, E74, E79, E81 to E85 and D35's form)"
    TAB=$(printf '\t')
    # FIXTURE_PATH, OT_PATH, OT_WORD, CT_PATH, CT_WORD and PM_WORD are set
    # above, with the modes. Change E89 (E86's form; specs/0044 "P1"): the
    # phase has no code commit; M6 part 6 P1's code commit's three scripts,
    # found by its subject in the roles above, are the area's control.
    printf '%s\n' "M${TAB}scripts/$CT_WORD.py" "M${TAB}scripts/compare-record.py" "M${TAB}scripts/compare-run.sh" | LC_ALL=C sort -k2 >"$W/area-want-P61"
    echo "command: git show --name-status --format= <M6 part 6 P1's code commit> | sort -k2 (the control's files)"
    git show --name-status --format= "$P61_CMPC" | LC_ALL=C sort -k2 >"$W/area-P61"
    sed 's/^/    /' "$W/area-P61"
    note "control: M6 part 6 P1's code commit's files are the three scripts, each modified (changes E86 and E89)" "$(is cmp -s "$W/area-P61" "$W/area-want-P61")"
    # same_outside <a> <b> <path>...: git diff --quiet between the two commits
    # over every path but the ones given.
    PHASE_FILES="specs/0045-publish.md ROADMAP.md"
    same_outside() {
      local a=$1 b=$2 p
      shift 2
      local spec=(.)
      for p in "$@"; do spec+=(":!$p"); done
      git diff --quiet "$a" "$b" -- "${spec[@]}"
    }
    echo "command: git diff --stat <base> <phase commit> -- . ':!<each of the phase's files>'"
    echo "  the phase's files: $PHASE_FILES"
    same_spec=(.)
    for p in $PHASE_FILES; do same_spec+=(":!$p"); done
    git diff --stat "$BASE" "$C" -- "${same_spec[@]}" | sed 's/^/    /'
    note "the tree at the phase commit is the base's outside the phase's files (changes E86 and E89)" "$(is same_outside "$BASE" "$C" $PHASE_FILES)"
    same_ctl() { same_outside "$BASE" "$C" ROADMAP.md; }
    note "control: the same check refuses the exclusions with specs/0045 left out (change E92)" "$(isnot same_ctl)"
    echo "command: git diff --name-only <base> <phase commit>"
    git diff --name-only "$BASE" "$C" | LC_ALL=C sort >"$W/phase-names"
    sed 's/^/    /' "$W/phase-names"
    printf '%s\n' $PHASE_FILES | LC_ALL=C sort >"$W/phase-names-want"
    note "the phase diff is the doc commit's two files, nothing else (change E92)" "$(is cmp -s "$W/phase-names" "$W/phase-names-want")"
    note "the phase diff holds two files (change E92)" "$(is [ "$(count_lines "$W/phase-names")" = 2 ])"
    sed '1d' "$W/phase-names-want" >"$W/c-phase-names"
    note "control: the comparison refuses the list one file short (changes E86 and E89)" "$(isnot cmp -s "$W/phase-names" "$W/c-phase-names")"
    # Change E89 (E68's form): no manifest and no lock in the phase diff; the crate manifest
    # at the phase commit still declares charts with no dependency and no
    # default feature (part 3 P1's E53, read again).
    nlock=$(count_matches -Fx Cargo.lock "$W/difffiles")
    LC_ALL=C "$G" -E '(^|/)Cargo[.]toml$' "$W/difffiles" | LC_ALL=C sort >"$W/manifests" || :
    nmanifest=$(count_lines "$W/manifests")
    echo "  Cargo.lock in the phase diff: $nlock; manifests in the phase diff: $nmanifest"
    sed 's/^/    manifest in the phase diff: /' "$W/manifests"
    note "the phase changes no Cargo.lock (changes E86 and E89)" "$(is [ "$nlock" = 0 ])"
    note "the phase changes no manifest (changes E86 and E89)" "$(is [ "$nmanifest" = 0 ])"
    manifests_in() { git show --name-only --format= "$1" | count_matches -E '(^|/)Cargo[.]toml$' /dev/stdin; }
    echo "  manifests touched: by the doc commit $(manifests_in "$DOC")"
    P31_MAN_C=$(git log --format='%H' -n 1 -F --grep='M5 part 3 P1: charts read, the anchors, the plots and series' "$C")
    echo "  part 3 P1's crate commit, by subject: ${P31_MAN_C:-none found}; manifests it touched: $(manifests_in "$P31_MAN_C")"
    note "control: the same count reads 1 over part 3 P1's crate commit, which added the feature" "$(is [ "$(manifests_in "$P31_MAN_C")" = 1 ])"
    printf 'Cargo.lock\ntools/xlsx-diff/Cargo.toml\n' >"$W/c-lock"
    ctl "a lock file in a list, same command form" 1 count_matches -Fx Cargo.lock "$W/c-lock"
    ctl "a manifest in a list, same command form" 1 count_matches -E '(^|/)Cargo[.]toml$' "$W/c-lock"
    git show "$C:crates/emend/Cargo.toml" >"$W/crate-manifest"
    ncharts=$(count_matches -Fx 'charts = []' "$W/crate-manifest")
    ndefault=$(count_matches -E '^[[:space:]]*default[[:space:]]*=' "$W/crate-manifest")
    echo "  in the crate manifest at the phase commit: 'charts = []' lines $ncharts; default-feature lines $ndefault"
    note "the crate manifest declares charts with no dependency (change E53, kept)" "$(is [ "$ncharts" = 1 ])"
    note "the crate manifest declares no default feature, so charts is off by default (change E53, kept)" "$(is [ "$ndefault" = 0 ])"
    printf '[features]\ndefault = ["charts"]\ncharts = []\n' >"$W/c-default"
    ctl "a default-feature line in a manifest, same command form" 1 count_matches -E '^[[:space:]]*default[[:space:]]*=' "$W/c-default"
    # Change E89 (E86's form; specs/0044 "P1"): no Rust source is in the diff;
    # nothing under crates/, tools/ or scripts/.
    rs_in() { git show --name-only --format= "$1" | count_matches -E '[.]rs$' /dev/stdin; }
    LC_ALL=C "$G" -E '[.]rs$' "$W/difffiles" | LC_ALL=C sort >"$W/rs-files" || :
    nrs=$(count_lines "$W/rs-files")
    ncrates=$(git diff --name-only "$BASE" "$C" -- crates | count_lines /dev/stdin)
    ntools=$(git diff --name-only "$BASE" "$C" -- tools | count_lines /dev/stdin)
    echo "  Rust sources in the phase diff: $nrs; files under crates/ in the phase diff: $ncrates; under tools/: $ntools"
    sed 's/^/    Rust source in the phase diff: /' "$W/rs-files"
    note "no Rust source is in the phase diff (changes E86 and E89)" "$(is [ "$nrs" = 0 ])"
    note "no file under crates/ is in the phase diff (changes E86 and E89)" "$(is [ "$ncrates" = 0 ])"
    note "no file under tools/ is in the phase diff (changes E86 and E89)" "$(is [ "$ntools" = 0 ])"
    note "the doc commit holds no Rust source (changes E86 and E89)" "$(is [ "$(rs_in "$DOC")" = 0 ])"
    echo "  part 5 P4's probe commit, by subject: ${P54_PROBEC:-none found}; Rust sources it touched: $(rs_in "$P54_PROBEC")"
    note "control: the same count reads 4 over part 5 P4's probe commit (changes E63, E65 to E68, E71, E74, E84 to E86, E89)" "$(is [ "$(rs_in "$P54_PROBEC")" = 4 ])"
    scripts_in_range() { git diff --name-only "$1" "$2" -- 'scripts/*' | count_lines /dev/stdin; }
    nscr=$(scripts_in_range "$BASE" "$C")
    echo "command: git diff --name-only <base> <phase commit> -- 'scripts/*'"
    git diff --name-only "$BASE" "$C" -- 'scripts/*' | LC_ALL=C sort | sed 's/^/    /'
    echo "  files under scripts/ changed in the range: $nscr"
    note "no file under scripts/ is changed in the range (changes E86 and E89)" "$(is [ "$nscr" = 0 ])"
    scr_ctl3() { [ -n "$P61_CMPC" ] && [ "$(scripts_in_range "$P61_CMPC^" "$P61_CMPC")" = 3 ]; }
    note "control: the same count reads 3 over M6 part 6 P1's code commit (changes E86 and E89)" "$(is scr_ctl3)"
    P1_SCRIPTS_A=$(git log --format='%H' -n 1 -F --grep='M5 part 2 P1: committed scripts call python3 with -I -B' "$C")
    echo "  M5 part 2 P1's scripts commit, by subject: ${P1_SCRIPTS_A:-none found}"
    scr_ctl() { [ -n "$P1_SCRIPTS_A" ] && [ "$(scripts_in_range "$P1_SCRIPTS_A^" "$P1_SCRIPTS_A")" = 3 ]; }
    note "control: the same count reads 3 over M5 part 2 P1's scripts commit" "$(is scr_ctl)"
    P52_OPC=$(by_subject "M6 part 5 P2: openpyxl-ops.py named-style")
    scr_ctl2() { [ -n "$P52_OPC" ] && [ "$(scripts_in_range "$P52_OPC^" "$P52_OPC")" = 2 ]; }
    note "control: the same count reads 2 over part 5 P2's op commit (changes E84 to E86, E89)" "$(is scr_ctl2)"
    # The three comparison scripts (P1's), scripts/openpyxl-ops.py (ruling A),
    # CHANGELOG.md, README.md and scripts/passthrough-run.sh are not in the
    # range (changes E75, E78, E81, E84 to E86, E89).
    not_in_range() { [ "$(git diff --name-only "$1" "$2" -- "$3" | count_lines /dev/stdin)" = 0 ]; }
    for f in scripts/compare-run.sh scripts/compare-record.py "scripts/$CT_WORD.py" scripts/openpyxl-ops.py CHANGELOG.md README.md scripts/passthrough-run.sh; do
      echo "command: git diff --name-only <base> <phase commit> -- $f"
      git diff --name-only "$BASE" "$C" -- "$f" | sed 's/^/    /'
      note "$f is not in the range's diff (changes E86 and E89)" "$(is not_in_range "$BASE" "$C" "$f")"
    done
    changelog_ctl() { [ -n "$P54_LOGC" ] && not_in_range "$P54_LOGC^" "$P54_LOGC" CHANGELOG.md; }
    note "control: not_in_range refuses part 5 P4's CHANGELOG commit, which changed CHANGELOG.md (changes E63, E65 to E68, E71, E74, E84 to E86, E89)" "$(isnot changelog_ctl)"
    ops_ctl() { [ -n "$P52_OPC" ] && not_in_range "$P52_OPC^" "$P52_OPC" scripts/openpyxl-ops.py; }
    note "control: not_in_range refuses part 5 P2's op commit, which changed scripts/openpyxl-ops.py (changes E85, E86 and E89)" "$(isnot ops_ctl)"
    cmp_ctl() { [ -n "$P61_CMPC" ] && not_in_range "$P61_CMPC^" "$P61_CMPC" scripts/compare-run.sh; }
    note "control: not_in_range refuses M6 part 6 P1's code commit, which changed scripts/compare-run.sh (changes E86 and E89)" "$(isnot cmp_ctl)"
    README_C=$(git log --format='%H' -n 1 -F --grep="M3 part 7 P5: the README's two sentences")
    echo "  M3 part 7 P5's README commit, by subject: ${README_C:-none found}"
    readme_ctl() { [ -n "$README_C" ] && not_in_range "$README_C^" "$README_C" README.md; }
    note "control: not_in_range refuses M3 part 7 P5's README commit, which changed it" "$(isnot readme_ctl)"
    # The crate's messages: every Error::Package("...") string under
    # crates/emend/src, as a set. Change E86 (E84's form; specs/0042 ruling
    # AI, read by both of part 5 P2's readers): the phase changes no crate
    # source, so each reader's set at the phase commit is the base's, none added
    # and none gone; the one-line reader reads 154 and the several-line
    # reader 168 (M6 part 6 P3 removed one message; change E89); change E92:
    # at this phase's base, P1's three added, 157 and 171, read at generation.
    messages_set() { git grep -h -o -E 'Error::Package[(]"[^"]*"[)]' "$1" -- crates/emend/src | LC_ALL=C sort -u; }
    messages_set "$BASE" >"$W/msgs-base"
    messages_set "$C" >"$W/msgs-head"
    echo "command: git grep -h -o -E 'Error::Package[(]\"[^\"]*\"[)]' <commit> -- crates/emend/src | sort -u, at the base and at the phase commit"
    echo "  distinct messages at the base: $(count_lines "$W/msgs-base"); at the phase commit: $(count_lines "$W/msgs-head")"
    LC_ALL=C comm -13 "$W/msgs-base" "$W/msgs-head" | sed 's/^/    new at the phase commit: /'
    LC_ALL=C comm -23 "$W/msgs-base" "$W/msgs-head" | sed 's/^/    gone at the phase commit: /'
    cp "$W/msgs-base" "$W/msgs-want"
    note "the one-line reader's messages are the base's, none added and none gone, as a set (changes E40, E63, E65 to E68, E71, E74, E81, E84 to E86, E89)" "$(is cmp -s "$W/msgs-head" "$W/msgs-want")"
    note "the one-line reader reads 157 distinct messages at the phase commit (changes E84 to E86, E89, E92)" "$(is [ "$(count_lines "$W/msgs-head")" = 157 ])"
    { cat "$W/msgs-want"; printf '%s\n' 'Error::Package("a planted message")'; } | LC_ALL=C sort -u >"$W/c-msgs-extra"
    note "control: the comparison refuses the expected set with a message added" "$(isnot cmp -s "$W/msgs-head" "$W/c-msgs-extra")"
    sed '1d' "$W/msgs-base" >"$W/c-msgs-short"
    note "control: the comparison refuses the base's set one message short (changes E74, E84 to E86, E89)" "$(isnot cmp -s "$W/msgs-head" "$W/c-msgs-short")"
    # messages_ml <commit>: part 5 P2's several-line reader (change E83, kept): the
    # string of every Error::Package( "..." ), whatever whitespace (a line
    # break among it) lies between the parenthesis, the string, a comma and
    # the closing parenthesis, over every .rs file under crates/emend/src at
    # the commit, as a sorted set.
    messages_ml() {
      python3 -I -B - "$1" <<'MSGML'
    import re, subprocess, sys
    at = sys.argv[1]
    names = subprocess.run(["git", "ls-tree", "-r", "--name-only", at, "--", "crates/emend/src"], capture_output=True,
                           text=True, check=True).stdout.split()
    found = set()
    for f in names:
        if f.endswith(".rs"):
            text = subprocess.run(["git", "show", at + ":" + f], capture_output=True, text=True, check=True).stdout
            found |= set(re.findall(r'Error::Package[(]\s*"([^"\\]*)"\s*,?\s*[)]', text))
    for m in sorted(found):
        print('Error::Package("%s")' % m)
    MSGML
    }
    messages_ml "$BASE" | LC_ALL=C sort -u >"$W/msgs-ml-base"
    messages_ml "$C" | LC_ALL=C sort -u >"$W/msgs-ml-head"
    echo "command: the several-line reader over every .rs file under crates/emend/src, at the base and at the phase commit (changes E83 to E86, E89)"
    echo "  distinct messages at the base: $(count_lines "$W/msgs-ml-base"); at the phase commit: $(count_lines "$W/msgs-ml-head")"
    LC_ALL=C comm -13 "$W/msgs-ml-base" "$W/msgs-ml-head" | sed 's/^/    new at the phase commit: /'
    LC_ALL=C comm -23 "$W/msgs-ml-base" "$W/msgs-ml-head" | sed 's/^/    gone at the phase commit: /'
    note "the several-line reader's messages are the base's, none added and none gone, as a set (specs/0042 ruling AI; changes E84 to E86, E89)" "$(is cmp -s "$W/msgs-ml-head" "$W/msgs-ml-base")"
    note "the several-line reader reads 171 distinct messages at the phase commit (changes E84 to E86, E89, E92)" "$(is [ "$(count_lines "$W/msgs-ml-head")" = 171 ])"
    ml_covers() { [ "$(LC_ALL=C comm -23 "$W/msgs-head" "$W/msgs-ml-head" | count_lines /dev/stdin)" = 0 ]; }
    note "the several-line reader sees every message the one-line reader sees at the phase commit (changes E83 to E86, E89)" "$(is ml_covers)"
    printf '%s\n' 'const A: Error = Error::Package("one line");' 'const B: Error = Error::Package(' '    "two lines",' ');' 'const C: Error =' '    Error::Package("next line");' >"$W/c-msgs.rs"
    c_ml() { python3 -I -B -c 'import re, sys; print(len(re.findall(r"Error::Package[(]\s*\"([^\"\\]*)\"\s*,?\s*[)]", open(sys.argv[1]).read())))' "$1"; }
    ctl "messages the several-line reader's pattern finds in a planted file of three, one over two lines, same pattern (changes E83 to E86, E89)" 3 c_ml "$W/c-msgs.rs"
    ctl "messages the one-line pattern finds in the same file, same command form (changes E83 to E86, E89)" 2 count_matches -E 'Error::Package[(]"[^"]*"[)]' "$W/c-msgs.rs"
    { cat "$W/msgs-ml-base"; printf '%s\n' 'Error::Package("a planted message")'; } | LC_ALL=C sort -u >"$W/c-msgs-ml-extra"
    note "control: the several-line comparison refuses the base's set with a message added (changes E84 to E86, E89)" "$(isnot cmp -s "$W/msgs-ml-head" "$W/c-msgs-ml-extra")"
    # Change E65, kept (E66 to E68, E71, E74, E84 to E86, E89): no line of this script outside a comment
    # names the ops test, the comparison record's test or the container tool.
    # The three words are built from pieces, so the count reads this script's
    # own calls and not its pattern.
    runs_named() { awk -v a="$OT_WORD" -v b="$PM_WORD" -v c="$CT_WORD" '{ t = $0; sub(/^[[:space:]]+/, "", t) } substr(t, 1, 1) != "#" && (index($0, a) || index($0, b) || index($0, c)) { n++ } END { print n + 0 }' "$1"; }
    echo "command: the non-comment lines of this script naming the ops test, the comparison record's test or the container tool"
    echo "  lines: $(runs_named "$SELF")"
    note "this script runs neither the ops test, $OT_PATH, the comparison record's test, $CT_PATH, nor the container tool (changes E71, E74, E84 to E86, E89)" "$(is [ "$(runs_named "$SELF")" = 0 ])"
    printf '%s\n' "# $PM_WORD run in a comment" "x=\$($PM_WORD run img)" "bash scripts/$OT_WORD.sh img" "./scripts/$CT_WORD.py" "y=1" >"$W/c-runs"
    ctl "lines naming any of the three in a planted file of five, a comment and three calls among them, same command form (changes E71 and E74)" 3 runs_named "$W/c-runs"
    
    echo
    echo "## every script under scripts/ parses or compiles at the phase commit (changes H37 to H40, H42 to H50)"
    parse_ok() { bash -n "$1" 2>/dev/null; }
    echo "command: git ls-tree --name-only <phase commit> scripts/, each .sh through bash -n and each .py through py_compile (doraise)"
    git ls-tree --name-only "$C" scripts/ >"$W/scripts-all"
    nsh=0; npyall=0
    while IFS= read -r s; do
      case "$s" in
        *.sh)
          git show "$C:$s" >"$W/parse.sh"
          note "$s parses at the phase commit" "$(is parse_ok "$W/parse.sh")"
          nsh=$((nsh + 1)) ;;
      esac
    done <"$W/scripts-all"
    printf 'if then\n' >"$W/c-parse.sh"
    note "control: the same parse refuses a broken if" "$(isnot parse_ok "$W/c-parse.sh")"
    echo "command: python3 -I -B --version"
    python3 -I -B --version 2>&1 | sed 's/^/    /'
    py_compiles() { python3 -I -B -c 'import py_compile, sys; py_compile.compile(sys.argv[1], cfile=sys.argv[2], doraise=True)' "$1" "$W/compiled.pyc" 2>/dev/null; }
    while IFS= read -r s; do
      case "$s" in
        *.py)
          git show "$C:$s" >"$W/compiled.py"
          note "$s compiles at the phase commit (py_compile, doraise)" "$(is py_compiles "$W/compiled.py")"
          npyall=$((npyall + 1)) ;;
      esac
    done <"$W/scripts-all"
    echo "  shell scripts parsed: $nsh; Python scripts compiled: $npyall"
    both_read() { [ "$nsh" -ge 1 ] && [ "$npyall" -ge 1 ]; }
    note "some shell scripts and some Python scripts were read" "$(is both_read)"
    printf 'def f(:\n    pass\n' >"$W/c-broken.py"
    note "control: the same compile refuses a broken def" "$(isnot py_compiles "$W/c-broken.py")"
    LC_ALL=C "$G" -E '[.]py$' "$W/difffiles" >"$W/py-in-diff" || :
    # Change H86, kept (H87 to H89; part 5 P3's H84 form): no Python script
    # is in the phase diff.
    : >"$W/py-in-diff-want"
    echo "  Python scripts in the phase diff: $(count_lines "$W/py-in-diff")"
    sed 's/^/    /' "$W/py-in-diff"
    note "no Python script is in the phase diff (changes H86 to H89)" "$(is cmp -s "$W/py-in-diff" "$W/py-in-diff-want")"
    printf 'scripts/compare-record.py\n' >"$W/c-py-one"
    note "control: the comparison refuses a list of one, the comparison record alone (changes H68, H71, H74, H83 to H89)" "$(isnot cmp -s "$W/c-py-one" "$W/py-in-diff-want")"
    printf 'scripts/scale-gen.py\ncrates/emend/src/package.rs\n' >"$W/c-py"
    ctl "one Python script in a list of two, same command form" 1 count_matches -E '[.]py$' "$W/c-py"
    
    echo
    echo "## no committed script under scripts/ calls Python without -B, at the phase commit (changes H50 and H51; specs/0032 \"Planning verification and rulings on P3\", ruling 4)"
    # scripts_py <commit> <prefix>: every file under scripts/ at the commit,
    # its calls listed into <prefix>.calls as "<path>:<line> <I> <B>".
    scripts_py() {
      local at=$1 out=$2 f
      : >"$out.calls"
      nscanned=0
      for f in $(git ls-tree -r --name-only "$at" -- scripts); do
        git show "$at:$f" >"$W/pyb-file"
        py_calls "$W/pyb-file" | sed "s#^#$f:#" >>"$out.calls"
        nscanned=$((nscanned + 1))
      done
    }
    no_b() { awk '$3 == 0' "$1" | count_lines /dev/stdin; }
    echo "command: git ls-tree -r --name-only <phase commit> -- scripts; each file read with git show and its Python calls listed by the rule above"
    scripts_py "$C" "$W/pyb-head"
    ncalls=$(count_lines "$W/pyb-head.calls")
    nnob=$(no_b "$W/pyb-head.calls")
    echo "  files scanned: $nscanned; Python calls: $ncalls; calls without -B: $nnob"
    echo "  the calls, each <path>:<line> <-I given> <-B given>:"
    sed 's/^/    /' "$W/pyb-head.calls"
    note "some files were scanned" "$(is [ "$nscanned" -ge 1 ])"
    note "no committed script under scripts/ calls Python without -B at the phase commit (change H50)" "$(is [ "$nnob" = 0 ])"
    awk '{ split($1, a, ":"); print a[1] }' "$W/pyb-head.calls" | LC_ALL=C sort | uniq -c | awk '{ print $2, $1 }' >"$W/pyb-per-file"
    # Change H86 (H85's form): every file's calls, read from the phase commit
    # and the base by this same reader when the generator ran, P1's: no script
    # changes in this phase; the ops test's name is OT_PATH, built from pieces
    # above.
    printf '%s\n' "scripts/check.sh 1" "scripts/compare-run.sh 2" "scripts/edit-open-check.sh 2" "scripts/lo-check.sh 1" "$OT_PATH 7" "scripts/openpyxl-ops.py 1" "scripts/passthrough-record.py 1" | LC_ALL=C sort >"$W/pyb-per-file-want"
    echo "  calls per file:"; sed 's/^/    /' "$W/pyb-per-file"
    note "the calls per file are the ones the generator read: check.sh's 1, compare-run.sh's 2, edit-open-check.sh's 2, lo-check.sh's 1, the ops test's 7, openpyxl-ops.py's 1, passthrough-record.py's 1 (changes H50, H63, H65 to H68, H71, H74, H79, H82 to H89)" "$(is cmp -s "$W/pyb-per-file" "$W/pyb-per-file-want")"
    # Change H51: the base holds no call without -B now; the control by
    # history reads the parent of P1's scripts commit, found by its subject.
    P1_SCRIPTS=$(git log --format='%H' -n 1 -F --grep='M5 part 2 P1: committed scripts call python3 with -I -B' "$C")
    echo "  P1's scripts commit, by subject: ${P1_SCRIPTS:-none found}"
    echo "command: the same over the scripts/ of P1's scripts commit's parent (the control by history: the four calls before that commit)"
    scripts_py "$P1_SCRIPTS^" "$W/pyb-base"
    nnob_base=$(no_b "$W/pyb-base.calls")
    echo "  at P1's scripts commit's parent: files scanned $nscanned; Python calls $(count_lines "$W/pyb-base.calls"); calls without -B $nnob_base"
    note "control: the same count finds the four calls without -B there (change H51)" "$(is [ "$nnob_base" = 4 ])"
    scripts_py "$BASE" "$W/pyb-base2"
    echo "  at the base: Python calls $(count_lines "$W/pyb-base2.calls"); calls without -B $(no_b "$W/pyb-base2.calls")"
    note "the base holds no call without -B either (change H51)" "$(is [ "$(no_b "$W/pyb-base2.calls")" = 0 ])"
    printf '%s\n' "x=\$($PYW -c 'x')" "y=\$($PYW -I -B -c 'x')" "# $PYW -c 'x'" "command -v $PYW" >"$W/c-pyb-fixture"
    printf '%s\n' "x=1" >"$W/c-pyb-plain"
    note "control: the planted fixture differs from a file with no call (cmp)" "$(isnot cmp -s "$W/c-pyb-fixture" "$W/c-pyb-plain")"
    py_calls "$W/c-pyb-fixture" >"$W/c-pyb.calls"
    ctl "Python calls in a planted fixture of four lines (two calls, a comment, a lookup), same command form" 2 count_lines "$W/c-pyb.calls"
    ctl "calls without -B in the same fixture, same command form" 1 no_b "$W/c-pyb.calls"
    printf '%s\n' "$PYW -IB x.py" "$PYW x.py" "$PYW -Bc 'x'" "for t in $PYW sed; do :; done" >"$W/c-pyb-forms"
    py_calls "$W/c-pyb-forms" >"$W/c-pyb-forms.calls"
    ctl "calls in a planted fixture of a bundled -IB, a bare .py, a bundled -Bc and a word list, same command form" 3 count_lines "$W/c-pyb-forms.calls"
    ctl "calls without -B in the same fixture (the bare .py), same command form" 1 no_b "$W/c-pyb-forms.calls"
    
    echo
    echo "## the new sources scored against the gate they must pass, with controls"
    OFF=$(git show "$C:scripts/check.sh" | sed -n "s/^readonly OFFICE_RE='\(.*\)'\$/\1/p")
    note "OFFICE_RE was read from check.sh and is non-empty" "$(is [ -n "$OFF" ])"
    PRE_COMMIT=$(git log --format='%H' --grep='^T0 P6d: narrow the three path patterns' -n 1)
    note "the P6d narrowing commit resolved from git" "$(is [ -n "$PRE_COMMIT" ])"
    git show "$PRE_COMMIT^:scripts/privacy-patterns.txt" >"$W/pre-all" 2>/dev/null || fail=1
    sed -n '8p;10p;11p' "$W/pre-all" >"$W/pre-patterns"
    note "three pre-P6d forms read from the narrowing commit's parent" \
      "$(is [ "$(count_lines "$W/pre-patterns")" = 3 ])"
    git show "$C:scripts/privacy-patterns.txt" >"$W/live-patterns"
    
    f_nonascii() { count_bytes "$NONASCII_CLASS" "$1"; }
    f_ctrl()     { count_bytes "$CTRL_CLASS" "$1"; }
    f_live()     { count_from_file -E "$W/live-patterns" "$1"; }
    f_pre()      { count_from_file -E "$W/pre-patterns" "$1"; }
    f_office()   { count_matches -E "$OFF" "$1"; }
    # P1 gate header change 7, kept: an office extension whose file name is a literal, the
    # name running back from the extension to a space, a quote, a slash, an
    # equals sign or the line's start with no shell expansion in it.
    f_office_literal() { count_matches -E "(^|[ \"'=/])[^ \"'=/\$]+$OFF" "$1"; }
    
    rep() { printf "$1%.0s" $(seq 1 "$2"); }
    printf 'plain\nhas \303\251 byte\n' >"$W/c-nonascii"
    printf 'x \033[31mred\033[m\017 y\n' >"$W/c-ctrl"
    printf 'x %s%s%s y\n' 'gh' 'p_' "$(rep a 24)" >"$W/c-live"
    printf 'x %s%s%s y\n' '/mnt/' 'c/' 'Users/' >"$W/c-pre"
    printf 'name.%s%s\n' 'xl' 'sx' >"$W/c-office"
    printf 'input=$KEEP/$test.in.%s%s\n' 'xl' 'sx' >"$W/c-office-expanded"
    printf 'plain ascii only\n' >"$W/c-clean"
    ctl "f_nonascii on a two-byte character" 2 f_nonascii "$W/c-nonascii"
    ctl "f_ctrl on ESC, ESC and SI" 3 f_ctrl "$W/c-ctrl"
    ctl "f_live on a token shape" 1 f_live "$W/c-live"
    ctl "f_pre on a bare path shape" 1 f_pre "$W/c-pre"
    ctl "f_office on an office file name" 1 f_office "$W/c-office"
    ctl "f_office_literal on the same literal name" 1 f_office_literal "$W/c-office"
    ctl "f_office on a name built from variables" 1 f_office "$W/c-office-expanded"
    ctl "f_office_literal on the same built name" 0 f_office_literal "$W/c-office-expanded"
    for f in f_nonascii f_ctrl f_live f_pre f_office f_office_literal; do
      ctl "$f on a clean file" 0 "$f" "$W/c-clean"
    done
    # Change O63: a literal office name in an added text file is allowed when
    # it is one of the four the phase needs, each built from pieces: the
    # fixture's own name, the name the ops test mounts it under in the
    # container, the corpus manifest's (the passthrough runner names it at
    # the base) and the comparison runner's run table. f_office_other counts
    # the literal-name lines left once those four are removed.
    TS=ts; TV=v
    OFFICE_ALLOWED="openpyxl-ops.$XL$SX fixture.$XL$SX manifest.$TS$TV run.openpyxl.$TS$TV"
    f_office_other() {
      local n e
      cp "$1" "$W/office-other" || return 1
      for n in $OFFICE_ALLOWED; do
        e=$(printf '%s' "$n" | sed 's/[.]/[.]/g')
        sed -E -i "s#(^|[ \"'=/])$e#\\1#g" "$W/office-other"
      done
      f_office_literal "$W/office-other"
    }
    clean_source() {
      [ "$(f_nonascii "$1")" = 0 ] && [ "$(f_ctrl "$1")" = 0 ] &&
        [ "$(f_live "$1")" = 0 ] && [ "$(f_pre "$1")" = 0 ] && [ "$(f_office_other "$1")" = 0 ]
    }
    printf 'm=$CORPUS/manifest.%s%s\nf=/in/fixture.%s%s:ro\n' "$TS" "$TV" "$XL" "$SX" >"$W/c-office-allowed"
    ctl "f_office_literal on two allowed literal names, same command form (change O63)" 2 f_office_literal "$W/c-office-allowed"
    ctl "f_office_other on the same two, same command form (change O63)" 0 f_office_other "$W/c-office-allowed"
    ctl "f_office_other on a literal name not allowed, same command form (change O63)" 1 f_office_other "$W/c-office"
    printf 'x=/in/myfixture.%s%s\n' "$XL" "$SX" >"$W/c-office-near"
    ctl "f_office_other on a name that only ends like an allowed one, same command form (change O63)" 1 f_office_other "$W/c-office-near"
    
    git diff --name-only --diff-filter=A "$BASE" "$C" >"$W/added"
    echo "  files added in this phase: $(count_lines "$W/added")"
    nscored=0
    # Change O63: the committed fixture, a binary, is not scored as text; its
    # bytes are checked against the sha256 tests/fixtures/README.md gives,
    # read at the phase commit.
    FIXTURE_DOC=$(git show "$C:tests/fixtures/README.md" | sed -n 's/^- sha256: `\([0-9a-f]\{64\}\)`[.]$/\1/p')
    while IFS= read -r s; do
      if [ "$s" = "$FIXTURE_PATH" ]; then
        git show "$C:$s" >"$W/fixture-at-head" 2>/dev/null || { echo "$s: READ ERROR"; fail=1; continue; }
        echo "$s (new in this phase, the committed fixture, a binary; change O63):"
        echo "  bytes $(wc -c <"$W/fixture-at-head"); sha256 $(sha256sum <"$W/fixture-at-head" | cut -d' ' -f1); the sha256 tests/fixtures/README.md gives: ${FIXTURE_DOC:-none}"
        note "$s hashes as tests/fixtures/README.md gives (change O63)" "$(is [ "$(sha256sum <"$W/fixture-at-head" | cut -d' ' -f1)" = "$FIXTURE_DOC" ])"
        note "control: the README's hash is not the Containerfile's (change O63)" "$(isnot [ "$(git show "$C:tools/openpyxl-image/Containerfile" | sha256sum | cut -d' ' -f1)" = "$FIXTURE_DOC" ])"
        nscored=$((nscored + 1))
        continue
      fi
      git show "$C:$s" >"$W/a-at-head" 2>/dev/null || { echo "$s: READ ERROR"; fail=1; continue; }
      echo "$s (new in this phase):"
      echo "  non-ASCII bytes: $(f_nonascii "$W/a-at-head")"
      echo "  control bytes: $(f_ctrl "$W/a-at-head")"
      echo "  hits against all $(count_lines "$W/live-patterns") live privacy patterns: $(f_live "$W/a-at-head")"
      echo "  hits against the three pre-P6d bare forms: $(f_pre "$W/a-at-head")"
      echo "  lines with an office extension: $(f_office "$W/a-at-head"); of them a literal file name: $(f_office_literal "$W/a-at-head"); of those a name other than the four allowed: $(f_office_other "$W/a-at-head")"
      note "$s is clean on the five forms, office names counted as literals, the four the phase needs allowed (change O63)" "$(is clean_source "$W/a-at-head")"
      nscored=$((nscored + 1))
    done <"$W/added"
    
    echo
    echo "## the files this phase MODIFIED, scored by change rather than absolutely"
    git diff --name-only --diff-filter=M "$BASE" "$C" >"$W/modified"
    echo "  files modified in this phase: $(count_lines "$W/modified")"
    unchanged_by_this_phase() {
      [ "$added" = 0 ] && [ "$at_base" != error ] && [ "$at_head" != error ] &&
        [ "$at_base" = "$at_head" ]
    }
    while IFS= read -r M; do
      git show "$BASE:$M" >"$W/m-at-base" 2>/dev/null || { echo "$M: READ ERROR at base"; fail=1; continue; }
      git show "$C:$M" >"$W/m-at-head" 2>/dev/null || { echo "$M: READ ERROR at the phase commit"; fail=1; continue; }
      git diff -U0 "$BASE" "$C" -- "$M" |
        LC_ALL=C "$G" '^+' | LC_ALL=C "$G" -v '^+++' | sed 's/^+//' >"$W/m-added"
      echo "$M (modified in this phase):"
      echo "  added lines: $(count_lines "$W/m-added")"
      for form in f_nonascii f_ctrl f_live f_pre f_office_literal f_office; do
        at_base=$("$form" "$W/m-at-base")
        added=$("$form" "$W/m-added")
        at_head=$("$form" "$W/m-at-head")
        echo "  $form: at the base $at_base, in the added lines $added, at the phase commit $at_head"
        if [ "$form" = f_office ]; then
          # Printed only: a moved or rebuilt line can lower the count, and the
          # literal form above is the one held to "nothing new".
          continue
        fi
        note "$M: $form introduces nothing new in this phase" "$(is unchanged_by_this_phase)"
      done
      nscored=$((nscored + 1))
    done <"$W/modified"
    
    echo
    echo "## every file in the diff was scored"
    ndiff=$(count_lines "$W/difffiles")
    echo "  files in the diff: $ndiff; files scored as new or modified: $nscored"
    note "every file in the phase diff was scored" "$(is [ "$ndiff" = "$nscored" ])"
    
    echo
    echo "## the public fn and const first lines, the base's line for line with their cfg lines, a file's items taking the cfg line of its mod declaration (changes E36, L47 to L56, L57, L61 to L63, L66, L74, L79, L82 to L84; P3's E35, P2's E34, P1's E33, M3 part 5 P2's E31, P1's E30, M3 part 4 P1's E28, M3 part 3 P3's E26 reader, M2 part 4c P2's E12, part 4b P1's E7 and part 4a P4's D5, kept)"
    # The first line of every "pub fn" and "pub const" in crates/emend/src outside
    # the test files, leading space, "mut " before a parameter and a trailing brace
    # dropped, each beside the attribute before it when the line before is one
    # ("#[...", an attribute over several lines joined into one line, change
    # E26), else "-", sorted by the first line. Change E31: an item with neither
    # its own cfg line nor a gated impl's takes the cfg line of its file's mod
    # declaration in the parent file, when that line is one. Change L84
    # (part 4 P3's L81 form), kept (L91, L92): the phase adds no pub fn or
    # const (it changes no crate source), loses none and moves no cfg line.
    # file_gate <commit> <path>: the line before the path's mod declaration in
    # its parent file (crates/emend/src/a/b.rs: `mod b;` in crates/emend/src/a.rs)
    # when that line is a feature cfg line, else nothing (change E31).
    file_gate() {
      local at=$1 f=$2 dir name
      case "$f" in crates/emend/src/*/*.rs) ;; *) return 0 ;; esac
      dir=${f%/*}; name=${f##*/}; name=${name%.rs}
      git show "$at:$dir.rs" 2>/dev/null | awk -v m="mod $name;" '$0 == m { print p; exit } { p = $0 }' |
        LC_ALL=C "$G" -E '^#\[cfg\(feature = "[a-z]+"\)\]$' || :
    }
    pub_with_attrs() {
      local at=$1 f
      for f in $(git ls-tree -r --name-only "$at" -- crates/emend/src | LC_ALL=C "$G" -E '[.]rs$' | LC_ALL=C "$G" -vE '(/tests[.]rs|/testing[.]rs|/tests/)'); do
        git show "$at:$f" | awk -v filecfg="$(file_gate "$at" "$f")" '
          function trimmed(s) { sub(/^[[:space:]]*/, "", s); return s }
          function joined(s) { gsub(/[(] /, "(", s); gsub(/ [)]/, ")", s); return s }
          # Change E26: an attribute over several lines, from its "#[" line to
          # the line ending "]", is one line, a space between its pieces and
          # none just inside a parenthesis.
          inattr { attr = attr " " trimmed($0); if ($0 ~ /\]$/) { inattr = 0; prev = joined(attr) }; next }
          /^[[:space:]]*#\[/ && $0 !~ /\]$/ { inattr = 1; attr = trimmed($0); next }
          # Change D5, kept and widened by E7: an impl whose own attribute line is
          # a feature cfg gates every pub fn inside it with that line, up to the
          # impl'"'"'s closing brace at the margin.
          # Change E31: outside a gated impl, the gate of the file itself.
          BEGIN { gated = filecfg }
          /^impl/ { gated = (prev ~ /^#\[cfg\(feature = "[a-z]+"\)\]$/) ? prev : filecfg }
          /^}/ { gated = filecfg }
          /^[[:space:]]*pub (fn|const) / {
            line = $0; sub(/^[[:space:]]*/, "", line); sub(/ [{]$/, "", line)
            gsub(/[(]mut /, "(", line); gsub(/, mut /, ", ", line)
            a = prev; sub(/^[[:space:]]*/, "", a)
            if (a !~ /^#\[/) a = (gated != "" ? gated : "-")
            print a "\t" line
          }
          { prev = $0 }'
      done | LC_ALL=C sort -t "$(printf '\t')" -k2
    }
    TAB=$(printf '\t')
    READ_CFG='#[cfg(feature = "read")]'
    COMMENTS_CFG='#[cfg(feature = "comments")]'
    IMAGES_CFG='#[cfg(feature = "images")]'
    METADATA_CFG='#[cfg(feature = "metadata")]'
    COPY_CFG='#[cfg(feature = "copy")]'
    CHARTS_CFG='#[cfg(feature = "charts")]'
    DRAWING_OLD='#[cfg(any(feature = "images", feature = "read"))]'
    DRAWING_NEW='#[cfg(any(feature = "images", feature = "read", feature = "charts"))]'
    CHART_NEW='#[cfg(any(feature = "read", feature = "charts"))]'
    COMMENTS_ANY='#[cfg(any(feature = "comments", feature = "copy"))]'
    METADATA_ANY='#[cfg(any(feature = "metadata", feature = "copy"))]'
    PAIR_CFG='#[cfg(all(feature = "sheetprops", feature = "metadata"))]'
    TABLE_NEW='#[cfg(any(feature = "rowcol", feature = "tables", all(feature = "sheetprops", feature = "metadata")))]'
    echo "command: git show <commit>:<each crates/emend/src/*.rs outside the tests> | awk (a pub fn or pub const first line, beside the previous line when it is an attribute, one over several lines joined), sorted, at the base and at the phase commit"
    pub_with_attrs "$BASE" >"$W/pubattr-base"
    pub_with_attrs "$C" >"$W/pubattr-head"
    echo "  at the phase commit, every pub fn and pub const first line with its attribute:"
    sed 's/^/    /' "$W/pubattr-head"
    cut -f2 "$W/pubattr-base" | LC_ALL=C sort >"$W/pub-base"
    cut -f2 "$W/pubattr-head" | LC_ALL=C sort >"$W/pub-on"
    echo "  pub first lines: at the base $(count_lines "$W/pub-base"); at the phase commit $(count_lines "$W/pub-on")"
    LC_ALL=C comm -13 "$W/pub-base" "$W/pub-on" >"$W/pub-new"
    LC_ALL=C comm -23 "$W/pub-base" "$W/pub-on" >"$W/pub-lost"
    echo "  the lines the base's list loses at the phase commit:"; sed 's/^/    /' "$W/pub-lost"
    echo "  the lines the phase commit's list adds to the base's:"; sed 's/^/    /' "$W/pub-new"
    # Change L84 (part 4 P3's L81 form): the list is the base's, line for
    # line: the phase adds no pub fn and no pub const, loses none and moves no
    # cfg line.
    : >"$W/pub-new-want"
    echo "  the lines the phase commit adds: $(count_lines "$W/pub-new"); the lines the base's list loses: $(count_lines "$W/pub-lost")"
    note "the phase commit's list adds nothing to the base's (changes L66, L74, L81 and L84)" "$(is cmp -s "$W/pub-new" "$W/pub-new-want")"
    note "no line of the base's list is lost (changes L57, L61 to L63, L66, L74, L84)" "$(is [ "$(count_lines "$W/pub-lost")" = 0 ])"
    note "some first lines were read" "$(is [ "$(count_lines "$W/pub-on")" -ge 1 ])"
    printf '%s\n' 'pub fn planted(&self)' >"$W/c-pub-extra"
    note "control: the comparison refuses a list of one other call" "$(isnot cmp -s "$W/c-pub-extra" "$W/pub-new-want")"
    printf '%s\n' 'pub fn remove_chart(&mut self, part: &[u8], index: usize) -> Result<(), Error>' >"$W/c-pub-p3"
    note "control: the comparison refuses part 5 P3's one added line, remove_chart, given as this phase's (changes L63, L66 and L84)" "$(isnot cmp -s "$W/c-pub-p3" "$W/pub-new-want")"
    gated_by() {
      awk -F "$TAB" -v cfg="$2" '$1 == cfg { print $2 }' "$1" |
        sed -E 's/^pub (fn|const) ([A-Za-z_0-9]+).*/\1 \2/' | LC_ALL=C sort
    }
    # The phase commit's list with attributes is the base's, line for line:
    # no cfg line moves (changes L66, L74, L81 and L84).
    LC_ALL=C sort "$W/pubattr-base" >"$W/pubattr-want"
    LC_ALL=C sort "$W/pubattr-head" >"$W/pubattr-head-sorted"
    note "the phase commit's list with attributes is the base's, line for line (changes L66, L74, L81 and L84)" "$(is cmp -s "$W/pubattr-head-sorted" "$W/pubattr-want")"
    { cat "$W/pubattr-want"; printf '%s\t%s\n' "$CHARTS_CFG" 'pub fn planted(&self)'; } | LC_ALL=C sort >"$W/c-pubattr-extra"
    note "control: the same comparison refuses the expected list with a line added under the charts cfg line" "$(isnot cmp -s "$W/pubattr-head-sorted" "$W/c-pubattr-extra")"
    awk -F "$TAB" -v OFS="$TAB" -v cnew="$CHARTS_CFG" -v cold="$IMAGES_CFG" '$2 ~ /^pub fn remove_chart[(]/ && $1 == cnew { $1 = cold } { print }' "$W/pubattr-want" | LC_ALL=C sort >"$W/c-pubattr-moved"
    note "control: the same comparison refuses the expected list with remove_chart moved to the images cfg line" "$(isnot cmp -s "$W/pubattr-head-sorted" "$W/c-pubattr-moved")"
    # Change E36, kept: P3's copy_sheet stands under the copy cfg line.
    gated_by "$W/pubattr-head" "$COPY_CFG" >"$W/gated-copy"
    printf 'fn copy_sheet\n' >"$W/gated-copy-want"
    echo "  under $COPY_CFG at the phase commit: $(tr '\n' ' ' <"$W/gated-copy")"
    note "the item under the copy cfg line is copy_sheet alone (change E36)" "$(is cmp -s "$W/gated-copy" "$W/gated-copy-want")"
    echo "  file_gate at the phase commit: package/chart_write.rs '$(file_gate "$C" crates/emend/src/package/chart_write.rs)'; package/chart.rs '$(file_gate "$C" crates/emend/src/package/chart.rs)'; package/extlink.rs '$(file_gate "$C" crates/emend/src/package/extlink.rs)'; package/pivot.rs '$(file_gate "$C" crates/emend/src/package/pivot.rs)'; package/survey.rs '$(file_gate "$C" crates/emend/src/package/survey.rs)'; package/sheet_read.rs '$(file_gate "$C" crates/emend/src/package/sheet_read.rs)'; styles/elements.rs '$(file_gate "$C" crates/emend/src/styles/elements.rs)'; package.rs '$(file_gate "$C" crates/emend/src/package.rs)'"
    note "file_gate gives package/chart_write.rs, P1's, the charts cfg line (change L56, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/chart_write.rs)" = "$CHARTS_CFG" ])"
    note "file_gate gives package/chart.rs, part 3 P1's, the charts cfg line (change L53, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/chart.rs)" = "$CHARTS_CFG" ])"
    note "file_gate gives package/extlink.rs, part 2 P3's, the read cfg line (change L52, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/extlink.rs)" = "$READ_CFG" ])"
    note "file_gate gives package/pivot.rs, P2's, the read cfg line (change L51, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/pivot.rs)" = "$READ_CFG" ])"
    note "file_gate gives package/survey.rs, P1's, the read cfg line (change L50, kept)" "$(is [ "$(file_gate "$C" crates/emend/src/package/survey.rs)" = "$READ_CFG" ])"
    note "file_gate gives package/sheet_read.rs the read cfg line (M3 part 5 P2's E31)" "$(is [ "$(file_gate "$C" crates/emend/src/package/sheet_read.rs)" = "$READ_CFG" ])"
    note "control: file_gate gives an ungated module (styles/elements.rs) nothing" "$(is [ -z "$(file_gate "$C" crates/emend/src/styles/elements.rs)" ])"
    note "control: file_gate gives a top-level file (package.rs) nothing" "$(is [ -z "$(file_gate "$C" crates/emend/src/package.rs)" ])"
    # The cfg lines the list carries: the base's, none new and none gone
    # (changes L54, L56 and L57).
    awk -F "$TAB" '$1 ~ /^#\[cfg\(/ { print $1 }' "$W/pubattr-head" | LC_ALL=C sort -u >"$W/cfgs"
    awk -F "$TAB" '$1 ~ /^#\[cfg\(/ { print $1 }' "$W/pubattr-base" | LC_ALL=C sort -u >"$W/cfgs-base"
    echo "  the cfg lines the list carries at the phase commit:"; sed 's/^/    /' "$W/cfgs"
    note "the cfg lines the list carries are the base's (changes L54, L56, L57, L83 and L84)" "$(is cmp -s "$W/cfgs" "$W/cfgs-base")"
    sed '1d' "$W/cfgs-base" >"$W/c-cfgs"
    note "control: the comparison refuses the base's lines one short" "$(isnot cmp -s "$W/cfgs" "$W/c-cfgs")"
    note "the read cfg line is among them (change E33)" "$(is [ "$(count_matches -Fx "$READ_CFG" "$W/cfgs")" = 1 ])"
    while IFS= read -r cfg; do
      gated_by "$W/pubattr-head" "$cfg" >"$W/gated-head"
      gated_by "$W/pubattr-base" "$cfg" >"$W/gated-base"
      echo "  $cfg: items at the base $(count_lines "$W/gated-base"), at the phase commit $(count_lines "$W/gated-head")"
    done <"$W/cfgs"
    gated_by "$W/pubattr-head" "$READ_CFG" >"$W/gated-read-head"
    gated_by "$W/pubattr-base" "$READ_CFG" >"$W/gated-read-base"
    note "the items under the read cfg line are the base's, item for item (changes L54, L56 and L57)" "$(is cmp -s "$W/gated-read-head" "$W/gated-read-base")"
    gated_by "$W/pubattr-head" "$CHARTS_CFG" >"$W/gated-charts"
    printf 'fn add_chart\nfn add_chartsheet\nfn charts\nfn remove_chart\nfn set_chart_series\nfn set_chart_title\n' | LC_ALL=C sort >"$W/gated-charts-want"
    echo "  under $CHARTS_CFG at the phase commit: $(tr '\n' ' ' <"$W/gated-charts")"
    note "the items under the charts cfg line are charts, add_chart, remove_chart and add_chartsheet, as part 1 left them, and set_chart_title and set_chart_series, which part 4 P2 added (changes L53, L56, L57, L61, L63, L66, L74 and L82)" "$(is cmp -s "$W/gated-charts" "$W/gated-charts-want")"
    gated_by "$W/pubattr-head" "$DRAWING_NEW" >"$W/gated-dnew"
    gated_by "$W/pubattr-head" "$CHART_NEW" >"$W/gated-cnew"
    echo "  under $DRAWING_NEW: $(tr '\n' ' ' <"$W/gated-dnew"); under $CHART_NEW: $(tr '\n' ' ' <"$W/gated-cnew")"
    dc_alone() { [ "$(cat "$W/gated-dnew")" = 'const DRAWING' ] && [ "$(cat "$W/gated-cnew")" = 'const CHART' ]; }
    note "DRAWING alone is still under the first widened cfg line and CHART alone under the second (changes L53, L56 and L57)" "$(is dc_alone)"
    note "control: the charts comparison refuses the list of the read cfg line" "$(isnot cmp -s "$W/gated-read-head" "$W/gated-charts-want")"
    : >"$W/c-gated-short"
    note "control: the copy comparison refuses a list one item short" "$(isnot cmp -s "$W/gated-copy" "$W/c-gated-short")"
    printf '%s\n' "    $PAIR_CFG" '    pub fn x(&self) {' '    /// doc' '    pub const Y: u8 = 1;' >"$W/c-attr.rs"
    c_attr() {
      awk '
        /^[[:space:]]*pub (fn|const) / { a = prev; sub(/^[[:space:]]*/, "", a); if (a !~ /^#\[/) a = "-"; print a }
        { prev = $0 }' "$W/c-attr.rs" | tr '\n' '|'
    }
    c_attr_ok() { [ "$(c_attr)" = "$PAIR_CFG|-|" ]; }
    note "control: the attribute reader pairs a cfg line with the fn after it and a doc line with '-'" "$(is c_attr_ok)"
    # Change E26's control: the joining reader over a fixture holding TABLE's
    # six-line cfg, a one-line one and a doc line.
    printf '%s\n' '#[cfg(any(' '    feature = "rowcol",' '    feature = "tables",' '    all(feature = "sheetprops", feature = "metadata")' '))]' 'pub const T: u8 = 1;' "$PAIR_CFG" 'pub fn f(&self) {}' '/// doc' 'pub fn g(&self) {}' >"$W/c-multi.rs"
    c_multi() {
      awk '
        function trimmed(s) { sub(/^[[:space:]]*/, "", s); return s }
        function joined(s) { gsub(/[(] /, "(", s); gsub(/ [)]/, ")", s); return s }
        inattr { attr = attr " " trimmed($0); if ($0 ~ /\]$/) { inattr = 0; prev = joined(attr) }; next }
        /^[[:space:]]*#\[/ && $0 !~ /\]$/ { inattr = 1; attr = trimmed($0); next }
        /^[[:space:]]*pub (fn|const) / { a = prev; sub(/^[[:space:]]*/, "", a); if (a !~ /^#\[/) a = "-"; print a }
        { prev = $0 }' "$W/c-multi.rs" | tr '\n' '|'
    }
    c_multi_ok() { [ "$(c_multi)" = "$TABLE_NEW|$PAIR_CFG|-|" ]; }
    note "control: the reader joins a six-line attribute into the widened cfg line and keeps one-line attributes and doc lines (change E26)" "$(is c_multi_ok)"
    # Change D5's control, widened by E7: the reader itself, over a fixture with
    # a gated impl and an ungated one, gives the pub fn inside the gated impl the
    # cfg line.
    FEATURE_CFG='#[cfg(feature = "sheetprops")]'
    printf '%s\n' "$FEATURE_CFG" 'impl A {' '    /// doc' '    pub fn inside(&self) {}' '}' 'impl B {' '    /// doc' '    pub fn outside(&self) {}' '}' >"$W/c-impl.rs"
    c_impl() {
      awk '
        /^impl/ { gated = (prev ~ /^#\[cfg\(feature = "[a-z]+"\)\]$/) ? prev : "" }
        /^}/ { gated = "" }
        /^[[:space:]]*pub (fn|const) / { a = prev; sub(/^[[:space:]]*/, "", a); if (a !~ /^#\[/) a = (gated != "" ? gated : "-"); print a }
        { prev = $0 }' "$W/c-impl.rs" | tr '\n' '|'
    }
    c_impl_ok() { [ "$(c_impl)" = "$FEATURE_CFG|-|" ]; }
    note "control: the reader gives a pub fn in a gated impl the cfg line and one in an ungated impl '-' (change D5)" "$(is c_impl_ok)"
    nunsafe=$(git grep -c -w -e unsafe "$C" -- crates/emend/src | awk -F: '{ n += $NF } END { print n + 0 }')
    nforbid=$(git show "$C:crates/emend/src/lib.rs" | count_matches -Fx '#![forbid(unsafe_code)]' /dev/stdin)
    echo "  lines holding the word unsafe under crates/emend/src at the phase commit: $nunsafe; lib.rs's forbid line: $nforbid"
    note "lib.rs still forbids unsafe code" "$(is [ "$nforbid" = 1 ])"
    
    echo
    echo "## the base's tests: no test file in the range, so none read, none gone and none edited, with a control over M5 part 5 P3's range; the test names of the whole tree the base's, nothing added (change F6, kept; changes F35, I38 to I40, I43, I44, I47 to I62, I63, I65 to I68, I71, I72, I74, I79, I82 to I85, I87 to I89, I92)"
    git diff --name-only "$BASE" "$C" | LC_ALL=C "$G" -E '(/tests[.]rs|/tests/|^tools/.*/tests/)' >"$W/test-files" || :
    sed 's/^/    test file changed: /' "$W/test-files"
    # test_bodies <commit> <file>: "<name>\t<body with each line joined by a
    # form feed>" per #[test] fn, the body from the fn line to the first line
    # that is a closing brace at the left margin.
    test_bodies() {
      python3 -I -B - "$1" "$2" <<'BODIES'
    import re, subprocess, sys
    at, path = sys.argv[1:3]
    if subprocess.run(["git", "cat-file", "-e", at + "^{commit}"], capture_output=True).returncode != 0:
        sys.exit("no such commit")
    if subprocess.run(["git", "cat-file", "-e", f"{at}:{path}"], capture_output=True).returncode != 0:
        sys.exit(0)
    text = subprocess.run(["git", "show", f"{at}:{path}"], capture_output=True, text=True,
                          check=True).stdout.split("\n")
    i = 0
    while i < len(text):
        if text[i].strip() == "#[test]":
            j = i + 1
            while j < len(text) and not re.match(r"^\s*fn ", text[j]):
                j += 1
            if j >= len(text):
                break
            name = re.match(r"^\s*fn ([a-z0-9_]+)", text[j]).group(1)
            k = j
            while k < len(text) and text[k] != "}":
                k += 1
            print(name + "\t" + "\f".join(text[j:k + 1]))
            i = k
        i += 1
    BODIES
    }
    # added_in <base bodies> <head bodies> <file>: per base test, "gone", or one
    # line "<file> <test> - <line, stripped>" per line removed from its body and
    # "<file> <test> + <line, stripped>" per line added, by a line diff of the
    # body at the base against the body now (change I4).
    added_in() {
      python3 -I -B - "$1" "$2" "$3" <<'ADDED'
    import difflib, sys
    base = dict(l.rstrip("\n").split("\t", 1) for l in open(sys.argv[1]) if l.strip())
    head = dict(l.rstrip("\n").split("\t", 1) for l in open(sys.argv[2]) if l.strip())
    for name, body in sorted(base.items()):
        if name not in head:
            print("%s %s gone" % (sys.argv[3], name))
            continue
        old, new = body.split("\f"), head[name].split("\f")
        for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
            if tag in ("replace", "delete"):
                for line in old[i1:i2]:
                    print("%s %s - %s" % (sys.argv[3], name, line.strip()))
            if tag in ("replace", "insert"):
                for line in new[j1:j2]:
                    print("%s %s + %s" % (sys.argv[3], name, line.strip()))
    ADDED
    }
    : >"$W/tests-edited"; tb_fail=0
    nbase_tests=0
    while IFS= read -r tf; do
      test_bodies "$BASE" "$tf" >"$W/tb-base" || tb_fail=1
      test_bodies "$C" "$tf" >"$W/tb-head" || tb_fail=1
      nbase_tests=$((nbase_tests + $(count_lines "$W/tb-base")))
      added_in "$W/tb-base" "$W/tb-head" "$tf" >>"$W/tests-edited" || tb_fail=1
    done <"$W/test-files"
    echo "command: every #[test] fn of the base in each changed test file, read at the base and at the phase commit; the lines removed from it and added to it, by a line diff, and any gone"
    echo "  base tests read in the changed files: $nbase_tests"
    sed 's/^/    /' "$W/tests-edited"
    LC_ALL=C sort "$W/tests-edited" >"$W/tests-edited-sorted"
    # Change I89 (M6 part 6 P2's I86 form, M5 part 6 P2's I65): no test file
    # is in the phase diff, so no base test is read, none gone and none
    # edited.
    PKG_TESTS=crates/emend/src/package/tests.rs
    ngone=$(count_matches -E ' gone$' "$W/tests-edited")
    note "every test of the base and the phase commit was read, none failing" "$(is [ "$tb_fail" = 0 ])"
    : >"$W/test-files-want"
    LC_ALL=C sort "$W/test-files" >"$W/test-files-sorted"
    echo "  test files in the phase diff: $(count_lines "$W/test-files")"
    note "no test file is in the phase diff (change I89)" "$(is cmp -s "$W/test-files-sorted" "$W/test-files-want")"
    note "no base test was read, there being no test file in the diff (change I89)" "$(is [ "$nbase_tests" = 0 ])"
    printf '%s\n' crates/emend/src/package/tests/named_style.rs >"$W/c-test-files-long"
    note "control: the comparison refuses a list of one test file, part 5 P3's (changes I71, I74, I79, I82 to I85, I87 to I89)" "$(isnot cmp -s "$W/c-test-files-long" "$W/test-files-want")"
    printf 'crates/emend/src/package/tests.rs\nscripts/counting.sh\n' >"$W/c-test-files"
    ctl "test files in a planted list of two, the same pattern" 1 count_matches -E '(/tests[.]rs|/tests/|^tools/.*/tests/)' "$W/c-test-files"
    printf '%s\n' specs/0043-measurement-and-close.md "scripts/$CT_WORD.py" scripts/compare-run.sh >"$W/c-test-fixtures"
    ctl "test files among three of P1's files, the record script's test among them, the same pattern (changes I71, I74, I79, I82 to I86)" 0 count_matches -E '(/tests[.]rs|/tests/|^tools/.*/tests/)' "$W/c-test-fixtures"
    note "no test of the base is gone ($ngone; change I89)" "$(is [ "$ngone" = 0 ])"
    nedit=$(count_lines "$W/tests-edited")
    echo "  edit lines: $nedit"
    : >"$W/tests-edited-want"
    note "the reader's lines are none: no base test edited (change I89)" "$(is cmp -s "$W/tests-edited-sorted" "$W/tests-edited-want")"
    printf '%s\n' "crates/emend/src/package/tests/named_style.rs a_named_style_s_name_is_escaped_as_an_attribute - assert!(" >"$W/c-tests-edited"
    note "control: the comparison refuses a planted removed line (changes I74, I79, I82 to I85, I87 to I89)" "$(isnot cmp -s "$W/tests-edited-sorted" "$W/c-tests-edited")"
    printf '%s\n' 'crates/emend/src/package/tests.rs a_workbook_root_binding_no_relationships_prefix_refuses_an_add gone' >"$W/c-tests-edited-p3"
    note "control: the comparison refuses M6 part 6 P3's one line, the refusing test gone (change I89)" "$(isnot cmp -s "$W/tests-edited-sorted" "$W/c-tests-edited-p3")"
    # Change I62's control, kept (I63, I65 to I68, I71, I74, I79, I82 to I85): the same reader over part 5 P3's range
    # (P2's record commit to P3's tool commit, each found by its subject) finds
    # P3's one edit, the two added lines "color: None," and "labels: None," in
    # one test, so the reader can see an edit; this phase has none (changes
    # I84 and I85).
    P53_BASE=$(git log --format='%H' -n 1 --grep='^M5 part 5 P2 record:')
    P53_TOOLC=$(by_subject "M5 part 5 P3: emend-copy --chart-labels-sample and --remove-chart-sample")
    echo "  part 5 P3's base and tool commit, by subject: ${P53_BASE:-none found}, ${P53_TOOLC:-none found}"
    CWT=crates/emend/src/package/tests/chart_write.rs
    test_bodies "$P53_BASE" "$CWT" >"$W/c-tb-base" 2>/dev/null || :
    test_bodies "$P53_TOOLC" "$CWT" >"$W/c-tb-head" 2>/dev/null || :
    added_in "$W/c-tb-base" "$W/c-tb-head" "$CWT" | LC_ALL=C sort >"$W/c-p3-edited" 2>/dev/null || :
    sed 's/^/    over part 5 P3'"'"'s range: /' "$W/c-p3-edited"
    printf '%s\n' "$CWT texts_are_escaped_and_references_written_as_given + color: None," \
      "$CWT texts_are_escaped_and_references_written_as_given + labels: None," | LC_ALL=C sort >"$W/c-p3-edited-want"
    note "control: the same reader over part 5 P3's range finds P3's one edit, the two added lines 'color: None,' and 'labels: None,' (changes I62, I63, I65 to I68, I71 and I74)" "$(is cmp -s "$W/c-p3-edited" "$W/c-p3-edited-want")"
    printf '%s\n' 'x.rs t gone' 'x.rs u - let a = 1;' >"$W/c-edited"
    ctl "a gone test in a list, same command form" 1 count_matches -E ' gone$' "$W/c-edited"
    ctl "edit lines in a planted list of two, same command form" 2 count_lines "$W/c-edited"
    # The test names of the whole tree: every #[test] fn in every Rust file under
    # crates/ and tools/, as a sorted list of "<file> <name>", at the base and at
    # the phase commit.
    tree_test_names() {
      local at=$1 f
      for f in $(git ls-tree -r --name-only "$at" -- crates tools | LC_ALL=C "$G" -E '[.]rs$'); do
        test_bodies "$at" "$f" | cut -f1 | sed "s#^#$f #"
      done | LC_ALL=C sort
    }
    tree_test_names "$BASE" >"$W/names-base"
    tree_test_names "$C" >"$W/names-head"
    echo "command: every #[test] fn's name in every .rs file under crates/ and tools/, read by the same reader at the base and at the phase commit, sorted"
    echo "  test names at the base: $(count_lines "$W/names-base"); at the phase commit: $(count_lines "$W/names-head")"
    LC_ALL=C comm -23 "$W/names-base" "$W/names-head" >"$W/names-lost"
    LC_ALL=C comm -13 "$W/names-base" "$W/names-head" >"$W/names-new"
    echo "  names the base has and the phase commit lacks: $(count_lines "$W/names-lost")"
    sed 's/^/    lost: /' "$W/names-lost"
    echo "  names the phase commit adds: $(count_lines "$W/names-new")"
    sed 's/^/    new: /' "$W/names-new"
    # Change I89 (I84's form): no name of the base is lost.
    : >"$W/names-lost-want"
    note "no test name of the base is lost (changes I47 to I68, I71, I74, I84, I85, I88, I89)" "$(is cmp -s "$W/names-lost" "$W/names-lost-want")"
    printf '%s\n' 'crates/emend/src/package/tests/chart.rs a_chartsheet_part_is_refused_as_not_a_worksheet' >"$W/c-names-lost"
    note "control: the comparison refuses a list of one, the name part 1 P1 superseded (changes I71, I74, I82 to I85, I87 to I89)" "$(isnot cmp -s "$W/c-names-lost" "$W/names-lost-want")"
    # diff_new_tests: for each test file in the phase diff, the #[test] fns at
    # the phase commit whose fn line is an added line of the range's diff.
    diff_new_tests() {
      local tf
      while IFS= read -r tf; do
        test_bodies "$C" "$tf" | cut -f1 | LC_ALL=C sort -u >"$W/dn-tests"
        git diff -U0 "$BASE" "$C" -- "$tf" | LC_ALL=C "$G" -E '^[+][[:space:]]*fn [a-z0-9_]+[(]' |
          sed -E 's/^[+][[:space:]]*fn ([a-z0-9_]+)[(].*/\1/' | LC_ALL=C sort -u >"$W/dn-added"
        LC_ALL=C comm -12 "$W/dn-tests" "$W/dn-added" | sed "s#^#$tf #"
      done <"$W/test-files"
    }
    diff_new_tests | LC_ALL=C sort >"$W/names-from-diff"
    echo "command: for each test file in the phase diff, the #[test] fns at the phase commit (the same reader) whose 'fn <name>(' line git diff -U0 <base> <phase commit> adds"
    echo "  new tests derived from the diff: $(count_lines "$W/names-from-diff")"
    note "the names the phase commit adds are exactly the new tests derived from the diff (changes I47 to I68, I71, I74)" "$(is cmp -s "$W/names-new" "$W/names-from-diff")"
    note "no new test was derived, there being no test file in the diff (change I89)" "$(is [ "$(count_lines "$W/names-from-diff")" = 0 ])"
    # Change I89: FACTS.md names no new test.
    : >"$W/names-new-want"
    LC_ALL=C sort -o "$W/names-new-want" "$W/names-new-want"
    echo "  the new tests FACTS.md names: $(count_lines "$W/names-new-want")"
    note "no new test, as FACTS.md gives (change I89)" "$(is cmp -s "$W/names-from-diff" "$W/names-new-want")"
    # Change I63: the planted list is one name, a test the diff does not add.
    printf '%s\n' 'crates/emend/src/package/tests/chart_write.rs a_planted_name' >"$W/c-names-new-want"
    note "control: the planted list differs from the expectation (cmp)" "$(isnot cmp -s "$W/c-names-new-want" "$W/names-new-want")"
    note "control: the same comparison refuses another name" "$(isnot cmp -s "$W/names-from-diff" "$W/c-names-new-want")"
    LC_ALL=C comm -23 "$W/names-base" "$W/names-lost-want" | LC_ALL=C sort -m - "$W/names-from-diff" >"$W/names-want"
    note "the test names of the whole tree are the base's, nothing else (changes I47 to I68, I71, I74, I82 to I85, I87 to I89)" "$(is cmp -s "$W/names-head" "$W/names-want")"
    note "some test names were read" "$(is [ "$(count_lines "$W/names-head")" -ge 1 ])"
    sed '1d' "$W/names-head" >"$W/c-names-short"
    note "control: the comparison refuses the list one name short" "$(isnot cmp -s "$W/names-want" "$W/c-names-short")"
    { cat "$W/names-from-diff"; echo 'crates/emend/src/package/tests/chart_write.rs a_planted_name_the_diff_does_not_add'; } | LC_ALL=C sort >"$W/c-names-new"
    note "control: the comparison refuses a new name the diff does not add" "$(isnot cmp -s "$W/c-names-new" "$W/names-from-diff")"
    # The colors module's tests, read at the phase commit for the crate runs
    # below: all of them, and those gated to rules (#[cfg(feature = "rules")] on
    # the line before #[test]), none expected (changes I48 to I52). The carry test of
    # styles/tests.rs, gated cfg(not(feature = "read")) on the line before its
    # #[test], runs with read off alone (specs/0032 "Planning verification and
    # rulings on P1", ruling 3).
    CO_FILE=crates/emend/src/package/tests/colors.rs
    STYLES_TESTS=crates/emend/src/styles/tests.rs
    # Change I83, kept (I84, I85): the carry test is ruling Q's renamed one, by its new name.
    CARRY_TEST=a_second_dxfs_is_walked_past_and_a_second_cell_style_xfs_or_cell_styles_refused
    rules_gated() { awk 'p == "#[cfg(feature = \"rules\")]" && $0 == "#[test]" { n++ } { p = $0 } END { print n + 0 }' "$1"; }
    git show "$C:$CO_FILE" >"$W/co-file"
    N_CO=$(test_bodies "$C" "$CO_FILE" | count_lines /dev/stdin)
    R_CO=$(rules_gated "$W/co-file")
    echo "command: the #[test] fns of $CO_FILE at the phase commit (the same reader), and those whose line before #[test] is #[cfg(feature = \"rules\")]"
    echo "  colors tests: $N_CO; of them gated to rules: $R_CO"
    co_none_gated() { [ "$N_CO" -ge 1 ] && [ "$R_CO" = 0 ]; }
    note "some colors tests, none gated to rules (changes I48 to I52)" "$(is co_none_gated)"
    printf '%s\n' '#[test]' 'fn a() {}' '#[cfg(feature = "rules")]' '#[test]' 'fn b() {}' '#[cfg(feature = "rules")]' 'const X: u8 = 1;' >"$W/c-co"
    ctl "rules-gated tests in a planted file of two tests, one gated, and a gated constant, same command form" 1 rules_gated "$W/c-co"
    # carry_gate <file>: the two lines before the carry test's fn line, joined
    # by a bar.
    carry_gate() { awk -v f="fn $CARRY_TEST() {" '$0 == f { print a "|" b; exit } { a = b; b = $0 }' "$1"; }
    git show "$C:$STYLES_TESTS" >"$W/styles-tests-file"
    echo "command: the two lines before 'fn $CARRY_TEST() {' in $STYLES_TESTS at the phase commit"
    echo "  $(carry_gate "$W/styles-tests-file")"
    CARRY_WANT='#[cfg(not(feature = "read"))]|#[test]'
    note "the carry test is still a test gated to the feature read off (changes I48 to I52)" "$(is [ "$(carry_gate "$W/styles-tests-file")" = "$CARRY_WANT" ])"
    printf '%s\n' '#[cfg(feature = "read")]' '#[test]' "fn $CARRY_TEST() {" '}' >"$W/c-carry"
    note "control: the planted fixture differs from the file (cmp)" "$(isnot cmp -s "$W/c-carry" "$W/styles-tests-file")"
    note "control: the same check refuses the test gated to the feature read on" "$(isnot [ "$(carry_gate "$W/c-carry")" = "$CARRY_WANT" ])"
    # Change I50: the survey module's tests, read at the phase commit for the
    # crate runs below: all of them, and those gated to rules, none expected.
    SV_FILE=crates/emend/src/package/tests/survey.rs
    git show "$C:$SV_FILE" >"$W/sv-file"
    N_SV=$(test_bodies "$C" "$SV_FILE" | count_lines /dev/stdin)
    R_SV=$(rules_gated "$W/sv-file")
    echo "command: the #[test] fns of $SV_FILE at the phase commit (the same reader), and those whose line before #[test] is #[cfg(feature = \"rules\")]"
    echo "  survey tests: $N_SV; of them gated to rules: $R_SV"
    sv_none_gated() { [ "$N_SV" -ge 1 ] && [ "$R_SV" = 0 ]; }
    note "some survey tests, none gated to rules (change I50)" "$(is sv_none_gated)"
    # Change I51: the pivot module's tests, read at the phase commit for the
    # crate runs below: all of them, and those gated to rules, none expected.
    PV_FILE=crates/emend/src/package/tests/pivot.rs
    git show "$C:$PV_FILE" >"$W/pv-file"
    N_PV=$(test_bodies "$C" "$PV_FILE" | count_lines /dev/stdin)
    R_PV=$(rules_gated "$W/pv-file")
    echo "command: the #[test] fns of $PV_FILE at the phase commit (the same reader), and those whose line before #[test] is #[cfg(feature = \"rules\")]"
    echo "  pivot tests: $N_PV; of them gated to rules: $R_PV"
    pv_fourteen() { [ "$N_PV" = 14 ] && [ "$R_PV" = 0 ]; }
    note "fourteen pivot tests, none gated to rules (change I51, kept)" "$(is pv_fourteen)"
    # Change I52: the extlink module's tests, read at the phase commit for the
    # crate runs below: all of them, and those gated to rules, none expected.
    EL_FILE=crates/emend/src/package/tests/extlink.rs
    git show "$C:$EL_FILE" >"$W/el-file"
    N_EL=$(test_bodies "$C" "$EL_FILE" | count_lines /dev/stdin)
    R_EL=$(rules_gated "$W/el-file")
    echo "command: the #[test] fns of $EL_FILE at the phase commit (the same reader), and those whose line before #[test] is #[cfg(feature = \"rules\")]"
    echo "  extlink tests: $N_EL; of them gated to rules: $R_EL"
    el_ten() { [ "$N_EL" = 10 ] && [ "$R_EL" = 0 ]; }
    note "ten extlink tests, none gated to rules (change I52, kept)" "$(is el_ten)"
    # Change I53: the chart module's tests, read at the phase commit for the
    # crate runs below: all of them, and those whose line before #[test] is a
    # cfg line, none expected (the module is compiled with charts alone).
    CH_FILE=crates/emend/src/package/tests/chart.rs
    git show "$C:$CH_FILE" >"$W/ch-file"
    N_CH=$(test_bodies "$C" "$CH_FILE" | count_lines /dev/stdin)
    cfg_gated() { awk 'p ~ /^#\[cfg\(/ && $0 == "#[test]" { n++ } { p = $0 } END { print n + 0 }' "$1"; }
    G_CH=$(cfg_gated "$W/ch-file")
    echo "command: the #[test] fns of $CH_FILE at the phase commit (the same reader), and those whose line before #[test] is a cfg line"
    echo "  chart tests: $N_CH; of them gated by a cfg line of their own: $G_CH"
    ch_40() { [ "$N_CH" = 40 ] && [ "$G_CH" = 0 ]; }
    note "forty chart tests, none gated by a cfg line of its own (change I55, kept)" "$(is ch_40)"
    printf '%s\n' '#[test]' 'fn a() {}' '#[cfg(feature = "read")]' '#[test]' 'fn b() {}' >"$W/c-ch"
    ctl "cfg-gated tests in a planted file of two tests, one gated, same command form" 1 cfg_gated "$W/c-ch"
    # Change I62 (I66, I71, I74, I79, I82): the chart-write module's tests, read at
    # the phase commit for the crate runs below: all of them, 119 (none added
    # by this phase), and those whose line
    # before #[test] is a cfg line (four expected, each gated to images: the
