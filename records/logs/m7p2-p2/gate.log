    fi
    note "control: section_total reads nothing from a file that is not there" "$(is [ -z "$(section_total "$W/no-such-binary")" ])"
    
    echo
    echo "## the consumer crate naming NewLabels, LabelPosition, the series' colour and labels fields, the chart's two axis format fields and remove_chart, which the feature charts gained in part 5 P3, add_chartsheet, which it gained in part 1 P1, the surface and of-pie plots with OfPieKind and OfPieSplit and the markers, lines and points, which it gained in part 2, the trendlines and error bars with their enumerations and NewAxis, NewDateAxis and TimeUnit with the chart's five plot line and axis fields, which it gained in part 3, and NewText with the chart's four text fields and the labels' text, which it gains in this phase (changes K61 to K64, K67, K72, K74, K75, K78, K79, K82: part 4 P3's consumer, NewChart::style and the in-place edits among what it names), with the features off, images alone, charts alone and the two together, and a planted variant the enum lacks refused (part 4a P1's change G3, kept; changes E35, M47 to M50, K51 to K60, K61 and K62)"
    mkdir -p "$CONSUMER/src" || fail=1
    {
      printf '[package]\nname = "charts-consumer"\nversion = "0.0.0"\nedition = "2024"\npublish = false\n\n'
