    #  YF. Change XF's form for four samples: every sample, the copy sample
    #      included, compared on both targets with P3's run directory for it,
    #      its outputs by sha256, its lines and its diff tables byte for byte,
    #      every workbook's outcome and exit equal; the run directories read
    #      from the "the run directories:" line of P3's run log at P3's record
    #      commit and checked against the run directory P3's committed copy
    #      record names.
    #  YJ. Change XJ's record pair for each of the four samples: the copy
    #      sample's as P3's, and the three earlier samples' through the same
    #      record script and record check, their families derived from their
    #      entries tables; ten record files installed, eight when the keep is
    #      skipped.
    #  YK. Ruling 8 of the planning rulings during P2 and ruling 10 of those
    #      during P3: the phase's target root is <target>, <home>/.cache/
    #      emend-build/m3p6-p4/target; the keep's tests build into <target>/main
    #      (CARGO_TARGET_DIR), where size.log built the release binaries this
    #      log runs; nothing here cleans it. VK stands: this script runs no
    #      `rm -rf`.
    #
    #
    #
    # CARRIED TO M3 part 7 P3 from M3 part 6 P4's run script (at the phase
    # commit 9cfd92e, printed in records/logs/m3p6-p4/run.log; its change lists
    # up to YK are above), generated by <home>/.cache/emend-build/m3p7-p3/gen/
    # run.py, every replacement asserted to occur as often as it says, the top
    # summary replaced, the keep and open-check sections removed, and the body
    # grepped afterwards for part 6 P4's names, subjects and tokens.
    # copycmp.py and copysurvey.py are part 6 P4's, copied beside this script
    # byte for byte. What differs, and why:
    #  RNA. The phase, the log directory, the subjects and the script directory
    #       (<scripts>, <home>/.cache/emend-build/m3p7-p3/scripts, on the disk)
    #       are this phase's; the base is part 7 P2's record commit ("M3 part 7
    #       P2 record:"); the phase commit is P3's code commit by its subject
    #       ("M3 part 7 P3: rust-version equal to the pin, and the gate checks
    #       the pins agree"); the four samples each have a run directory
    #       <runs>/<date>-<sha>-<sample> and a record stem
    #       m3p7-p3-<sample>-<date>-<sha> (specs/0029 "Harness runs"); the spec
    #       is specs/0029, pinned through SPEC_SHA at this phase's doc commit. The usage
    #       takes the size.log as its second argument, and no test.log.
    #  RNB. The run directories the four samples are compared with are part 6
    #       P4's, named by its record commit, resolved by its subject ("M3 part 6
    #       P4 record:"; no hash is typed here), an ancestor of the phase commit,
    #       read from the "the run directories:" line of part 6 P4's run log at
    #       that commit and checked against the run directory its committed copy
    #       record names.
    #  RNC. The keep and the open check go, with their inputs (RUN_KEEP,
    #       RUN_SKIP_KEEP, SUPERSEDED_KEEP), the test.log argument, the <keep>
    #       root and the open record's stem: specs/0029 "Harness runs" names the
    #       four samples alone. The record files installed are the four pairs,
    #       eight.
    #  RND. Each sample's record header names its binaries (specs/0029 item 5):
    #       the .md holds one "- Binaries (host)" and one "- Binaries (i686)"
    #       line whose two hashes are the binaries this log ran, with a control.
    #  RNE. The size.log is this phase's (its "about:" line names P3's phase
    #       commit).
    #  RNF. The phase's target root is <target>, <home>/.cache/emend-build/
    #       m3p7-p3/target (specs/0001 "Rules for every phase", one target root
    #       per phase); this log builds nothing and runs the release binaries
    #       size.log built in <target>/main.
    #  RNG. The runner gives each child its own TMPDIR under its own work
    #       directory, under <work>/tmp-run here (specs/0029 P1 ruling 2); the
    #       check that <work>/tmp-run is empty after each run stands.
    #
    # Usage: [RUN_WORK=<dir>] [PLANNING_SPEC=<sha256>] [PLANNING_ROADMAP=<sha256>] m7p2-p3-run.sh <phase commit> > <file outside the tree>;
    # the caller moves the output to records/logs/m7p2-p3/run.log (change TT).
    set -uo pipefail
    SELF_DIR=$(cd "$(dirname "$0")" && pwd)
    SELF=$SELF_DIR/$(basename "$0")
    # specs/0017 P1 verification ruling 7: this script's own standard error, kept and counted at the end.
    mkdir -p "$SELF_DIR/out" || exit 2
    ERR=$SELF_DIR/out/run.stderr
    exec 2>"$ERR"
    cd "$(git rev-parse --show-toplevel)" || exit 2
    MAIN=$(pwd)
    
    C=${1:?phase commit required}
    # Every environment input, as it was set, before any is unset (changes TK
    # and TT).
    INPUT_NAMES="RERUN_NOTE RERUN_FILES PLANNING_SPEC PLANNING_ROADMAP RUN_WORK HOME"
    OVERRIDES="RUN_WORK"
    declare -A INPUT_SEEN
    for v in $INPUT_NAMES; do
      if [ -n "${!v+x}" ]; then INPUT_SEEN[$v]=${!v}; else INPUT_SEEN[$v]=unset; fi
    done
    LOGGED=yes
    for v in $OVERRIDES; do
      if [ "${INPUT_SEEN[$v]}" != unset ]; then LOGGED=no; fi
    done
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    # Python writes no bytecode, so nothing arises to be removed.
    export PYTHONDONTWRITEBYTECODE=1
    # Change TU: every cargo command of this log runs offline but the one
    # publish dry run, which reaches the registry's index alone (ruling AE).
    export CARGO_NET_OFFLINE=true
    unset EMEND_KEEP_DIR EMEND_CORPUS_DIR RUSTDOCFLAGS RUSTFLAGS
    # Change TU (ruling AE): no registry token is set; a set one stops the
    # script before any cargo command, its value never printed.
    if [ -n "${CARGO_REGISTRY_TOKEN+x}" ] || [ -n "${CARGO_REGISTRIES_CRATES_IO_TOKEN+x}" ]; then echo "a registry token variable is set; this log runs with none" >&2; exit 2; fi
    SPEC=specs/0045-publish.md
    # Change TT: the committed blob the doc commit and the phase commit hold
    # (the generator asserts both).
    SPEC_WANT=8a515384b571822e0b32e7d6a6794b45532689c6be5adc745b48f232d38d9f2c
    PLANNING_SPEC=${PLANNING_SPEC:-}
    PLANNING_ROADMAP=${PLANNING_ROADMAP:-}
    PHASE_DIR=$HOME/.cache/emend-build/m7p2-p3
    # Change TT: the dry run's one override, RUN_WORK, holds the run's TMPDIR
    # and its target root; the logged run's are <phase>/tmp and
    # <phase>/target/run.
    WORK_ROOT=${RUN_WORK:-$PHASE_DIR}
    RTARGET=$WORK_ROOT/target/run
    if [ ! -d "$WORK_ROOT" ]; then echo "the work root is not there" >&2; exit 2; fi
    SHORT=$(git rev-parse --short=7 "$C")
    # TMPDIR is <scratch>/tmp, the work root's, made and exported before any
    # mktemp; the working directory is the one mktemp -d makes under it, on the
    # disk, kept; nothing here is removed.
    TMPDIR=$WORK_ROOT/tmp
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    B=$(mktemp -d) || exit 2
    # The counting library is the phase commit's, by git show.
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    # Change TT: what the status pattern admits: this phase's log directory and
    # planning's modified specs/0045 and ROADMAP.md; nothing else (this log
    # writes no record file).
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m7p2-p3/| M specs/0045-publish[.]md\$| M ROADMAP[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs and planning's spec and ROADMAP.md" >&2
      exit 2
    fi
    # Change TT: <work> first (it lies under TMPDIR), then the target root, the
    # work root (<workroot> in a dry run; <phase> itself in the logged run),
    # the phase's directories, and <home> last.
    if [ "$LOGGED" = yes ]; then WR_TOKEN='<phase>'; else WR_TOKEN='<workroot>'; fi
    scrub() {
      sed -e "s#$B#<work>#g" -e "s#$TMPDIR#<scratch>/tmp#g" -e "s#$RTARGET#<target>#g" -e "s#$SELF_DIR#<scripts>#g" \
        -e "s#$WORK_ROOT#$WR_TOKEN#g" -e "s#$MAIN#<repo>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M7 part 2 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # The environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo "input (as exported by this script): PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE CARGO_NET_OFFLINE=$CARGO_NET_OFFLINE"
    echo "input: TMPDIR=$TMPDIR"
    echo "  (TMPDIR set, made and exported by this script before any mktemp; <work> is made under it)"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    if [ "$LOGGED" = yes ]; then
      echo "mode: the logged run: the dry run's one override, RUN_WORK, is unset, so TMPDIR is <phase>/tmp and the target root <phase>/target/run (change TT)"
    else
      echo "mode: a dry run (specs/0043 ruling Q): RUN_WORK names the work root, <workroot>, which holds TMPDIR and the target root; every check is made as in the logged run"
    fi
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change NTJ: the fourth shape, PYB: a Python call without -I -B (the word
    # followed by whitespace and an option or a .py path, outside a comment,
    # and not by " -I -B"). The word is built from two halves, so that this
    # form's own text is no call.
    PYW=pyth
    PYW=${PYW}on3
    pyb_count() {
      awk -v w="$PYW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { r = substr(s, i + length(w)); if (r ~ /^[ \t]+(-|[^ \t]*[.]py([ \t"]|$))/ && r !~ /^ -I -B( |$)/) { n++; break }; s = r }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "$PYW -c x" "$PYW -I -B -c x" "# $PYW -c x" "command -v $PYW" "$PYW tool.py" >"$B/pyb-fixture"
    n_self=$(pyb_count "$SELF")
    n_fix=$(pyb_count "$B/pyb-fixture")
    echo "command: pyb_count <this script>, and the same over a fixture of five lines: a call with -c, one with -I -B -c, a comment, a command -v, a call of a .py path"
    echo "  shape PYB: in this script $n_self; in the fixture $n_fix"
    check "PYB: this script holds none (change NTJ)" "$(yn [ "$n_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's two calls without -I -B and not its other three lines" "$(yn [ "$n_fix" = 2 ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    REC=$(by_subject 'M7 part 2 P2 record: the logs, the record, the checks, the scan')
    DOC=$(by_subject "M7 part 2 P3: commit planning docs (P2's verification and rulings Q to AD)")
    CODE=$(by_subject 'M7 part 2 P3: the manifest names the packaged files and may be published')
    DOCS=$(by_subject 'M7 part 2 P3: the CHANGELOG and the README carry the fixes and both Excel checks')
    DOCS2=$(by_subject 'M7 part 2 P3: the Excel sentences say asked to open; the doc comment names charts')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  M7 part 2 P2's record commit (the base): ${REC:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the code commit (the manifest): ${CODE:-none}"
    echo "  the docs commit: ${DOCS:-none}"
    echo "  the second docs commit, the phase commit (ruling AG): ${DOCS2:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~4"
    for k in 0 1 2 3 4; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    roles_in_order() {
      local r k=0
      for r in "$DOCS2" "$DOCS" "$CODE" "$DOC" "$REC"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the second docs commit, the docs commit, the code commit, the doc commit and the base, each the next one's child, the second docs commit the phase commit (change TT)" "$(yn roles_in_order)"
    roles_ctl() { local DOCS2=$DOCS; roles_in_order; }
    check "control: roles_in_order refuses the first docs commit named as the phase commit" "$(ynnot roles_ctl)"
    roles_ctl2() { local CODE=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the code commit" "$(ynnot roles_ctl2)"
    roles_ctl3() { local REC=; roles_in_order; }
    check "control: roles_in_order refuses a role that resolved to nothing" "$(ynnot roles_ctl3)"
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the second docs commit, by its subject (change TT)" "$(yn [ "$DOCS2" = "$C" ])"
    check "control: the same comparison refuses the code commit" "$(ynnot [ "$CODE" = "$C" ])"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT")"
    short_names_head() { [ "$(git rev-parse "$SHORT")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    echo "phase: Milestone 7 part 2 P3 ($SPEC) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run's cargo builds go to <target> alone: the package list in <repo> and in the archive, and the publish dry run's verify build in the archive"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "root: <repo> stands for the repository's top level (inside <home>, so scrubbed after <work>, <target> and <scripts>); scripts/counting.sh is taken from it at the phase commit by git show; README.md, CHANGELOG.md, crates/emend/Cargo.toml, crates/emend/src/lib.rs and the two Excel records are read in its working tree, each checked equal to the phase commit's (change TT)"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m7p2-p3 on the disk, the phase's directory; <phase>/gen holds the generator that wrote this script and <phase>/model the templates it was written from"
    echo "root: <workroot> stands for the work root: <phase> in the logged run, the directory RUN_WORK names in a dry run; it holds TMPDIR and the target root (change TT)"
    echo "root: <scratch> stands for <workroot>, named <scratch> where TMPDIR is concerned: TMPDIR is <scratch>/tmp, made and exported by this script before any mktemp, and <work> is made under it"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory; this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (the counting library, the package lists, the archive <work>/arch and the checks' programs and outputs), kept after the run and never removed"
    echo "root: <target> stands for <workroot>/target/run, this log's cargo target root (CARGO_TARGET_DIR): the package lists' and the publish dry run's builds (change TU)"
    echo "root: <corpus> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change TT)"
    echo "root: <runs> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change TT)"
    echo "root: <source> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change TT)"
    echo "root: <stage> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change TT)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$SELF_DIR" "$MAIN" "$TMPDIR" "$RTARGET")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots <scripts>, <repo>, TMPDIR (<scratch>/tmp) and <target> are distinct, none inside another (change TT)" "$(yn roots_distinct)"
    work_in_tmpdir() { case "$B/" in "$TMPDIR/"*) return 0 ;; esac; return 1; }
    check "<work>, the directory mktemp -d made, is under TMPDIR, <scratch>/tmp" "$(yn work_in_tmpdir)"
    work_ctl() { local B=/tmp/x; work_in_tmpdir; }
    check "control: the same test refuses a working directory under /tmp" "$(ynnot work_ctl)"
    # Every mktemp call of this script is checked under TMPDIR, so the source is
    # read for its calls outside comments; the call's text is built from
    # pieces, so this form's own text is no call.
    MKW='$('
    MKW=${MKW}mkt
    MKW=${MKW}emp
    count_tempcalls() {
      awk -v w="$MKW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { n++; s = substr(s, i + length(w)) }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "A=$MKW -d)" "F=$MKW)" "# $MKW -d)" >"$B/mktemp-fixture"
    n_mk=$(count_tempcalls "$SELF")
    n_mk_fix=$(count_tempcalls "$B/mktemp-fixture")
    echo "command: count_tempcalls <this script>, and the same over a fixture of three lines: a directory call, a file call, a comment"
    echo "  mktemp calls in this script outside comments: $n_mk (the one that makes <work>, checked under TMPDIR above); in the fixture: $n_mk_fix"
    check "this script makes one mktemp call, <work>'s, and no plain temporary file" "$(yn [ "$n_mk" = 1 ])"
    check "control: the same count finds the fixture's two calls and not its comment" "$(yn [ "$n_mk_fix" = 2 ])"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs, planning's modified specs/0045 and ROADMAP.md) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m7p2-p3/run.log\n M specs/0045-publish.md\n M ROADMAP.md\n?? records/logs/m7p2-p2/run.log\n M README.md\n M CHANGELOG.md\n M crates/emend/Cargo.toml\n M specs/0044-excel-check.md\n' | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern admits this phase's log, specs/0045 and ROADMAP.md alone; it refuses another phase's log, a modified README, CHANGELOG or manifest and specs/0044 (change TT)" "$(yn [ "$(ours_rec_ctl)" = 3 ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources (the phase commit's, by git show)"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the files this log reads, against the phase commit, and planning's spec and ROADMAP.md"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    # Change TT: the texts, the manifest, the doc comment and the two records
    # this log reads in the working tree are the phase commit's.
    for s in README.md CHANGELOG.md crates/emend/Cargo.toml crates/emend/src/lib.rs records/excel-check-m7-2026-10-26.md records/excel-check-m7p2-2026-10-28.md; do
      check "$s in the working tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { [ "$(git show "$C:README.md" | sha256sum | cut -d' ' -f1)" = "$(sha_of CHANGELOG.md)" ]; }
    check "control: the same hash comparison tells two different files apart" "$(ynnot tree_ctl)"
    readme_parent_ctl() { [ "$(git show "$C~4:README.md" | sha256sum | cut -d' ' -f1)" = "$(sha_of README.md)" ]; }
    check "control: the same comparison tells the base's README.md from the phase commit's (change TT)" "$(ynnot readme_parent_ctl)"
    spec_now=$(sha_of "$SPEC")
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum; sha256sum $SPEC (the working file, the phase commit's unless planning holds rulings uncommitted, then the file PLANNING_SPEC names; change TK)"
    echo "  at the phase commit: $spec_committed; the pin: $SPEC_WANT; the working tree's copy: $spec_now; PLANNING_SPEC: ${PLANNING_SPEC:-unset}"
    spec_ok() { [ "$spec_committed" = "$SPEC_WANT" ]; }
    check "the spec at the phase commit is at the pinned hash, the doc commit's blob" "$(yn spec_ok)"
    spec_ctl() { local spec_committed=1111111111111111111111111111111111111111111111111111111111111111; spec_ok; }
    check "control: the same check refuses the spec against another hash" "$(ynnot spec_ctl)"
    working_ok() { [ "$spec_now" = "$spec_committed" ] || { [ -n "$PLANNING_SPEC" ] && [ "$spec_now" = "$PLANNING_SPEC" ]; }; }
    check "the working spec is the phase commit's or the file PLANNING_SPEC names (changes TK and TT)" "$(yn working_ok)"
    working_ctl() { local spec_now=1111111111111111111111111111111111111111111111111111111111111111; working_ok; }
    check "control: the same check refuses a working spec at another hash" "$(ynnot working_ctl)"
    roadmap_now=$(sha_of ROADMAP.md)
    roadmap_committed=$(git show "$C:ROADMAP.md" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:ROADMAP.md | sha256sum; sha256sum ROADMAP.md"
    echo "  at the phase commit: $roadmap_committed; the working tree's copy: $roadmap_now; PLANNING_ROADMAP: ${PLANNING_ROADMAP:-unset}"
    roadmap_ok() { [ "$roadmap_now" = "$roadmap_committed" ] || { [ -n "$PLANNING_ROADMAP" ] && [ "$roadmap_now" = "$PLANNING_ROADMAP" ]; }; }
    check "the working ROADMAP.md is the phase commit's or the file PLANNING_ROADMAP names (changes TK and TT)" "$(yn roadmap_ok)"
    roadmap_ctl() { local roadmap_now=1111111111111111111111111111111111111111111111111111111111111111; roadmap_ok; }
    check "control: the same check refuses a ROADMAP.md at another hash" "$(ynnot roadmap_ctl)"
    
    # Change TV: the shared check functions, <phase>/fork-notes/shared-checks.sh
    # carried byte for byte (the negative log carries the same text; sha256
    # 05acde9921b8e5835797aa15ded51f8bbce1c81bfdd09dd16a28ef56bbe8d3f0).
    # Shared check functions for M7 part 2 P3's run and negative logs
    # (written by the negative fork first; the run fork carries the same text
    # byte for byte). They need counting.sh sourced (for $G). Each prints a
    # figure or a count; no file content beyond the sentences of the two
    # committed texts is printed.
    # totals_of <record>: the record's totals line, the first table row under
    # its "## Totals" heading.
    totals_of() { awk '$0 == "## Totals" { t = 1; next } t && /^## / { exit } t && /^[|] [0-9]/ { print; exit }' "$1"; }
    # figures_of <record>: the seven figures an Excel sentence cites, from the
    # totals line: rows; corpus pass and repair; fixture pass and refused;
    # input pass and refused.
    figures_of() { totals_of "$1" | awk -F'|' '{ for (i = 2; i <= 11; i++) gsub(/ /, "", $i); print $2, $3, $4, $6, $8, $9, $11 }'; }
    # sentence_of <text file> <record path>: the paragraph or list item of the
    # text (README.md or CHANGELOG.md) that cites <record path> and says
    # "Microsoft Excel was asked to open", joined to one line.
    sentence_of() { awk -v r="$2" 'function out() { if (index(s, r) && index(s, "Microsoft Excel was asked to open")) print s; s = "" } /^$/ || /^- / { out() } { sub(/^ +/, ""); s = (s == "" ? $0 : s " " $0) } END { out() }' "$1"; }
    # figures_missing <sentence> <figures>: how many of the figures the
    # sentence does not hold as a whole word.
    figures_missing() { local f n=0; for f in $2; do printf '%s\n' "$1" | LC_ALL=C "$G" -qwF -- "$f" || n=$((n + 1)); done; echo "$n"; }
    # doc_features <lib.rs>: the names the crate doc comment's feature list
    # gives ("//! - `name`:"), one per line, sorted.
    doc_features() { LC_ALL=C "$G" -o -E '^//! - `[a-z]+`:' "$1" | sed -E 's/^\/\/! - `([a-z]+)`:$/\1/' | LC_ALL=C sort -u; }
    # manifest_features <Cargo.toml>: the names under [features], one per
    # line, sorted.
    manifest_features() { awk '/^\[/ { f = ($0 == "[features]"); next } f && /^[a-z][a-z0-9_-]* = / { print $1 }' "$1" | LC_ALL=C sort -u; }
    # features_unnamed <lib.rs> <Cargo.toml>: how many of the manifest's
    # features the doc comment's list does not name.
    features_unnamed() { LC_ALL=C comm -23 <(manifest_features "$2") <(doc_features "$1") | wc -l; }
    # figures_in_order <sentence> <figures>: yes when the sentence holds the
    # figures in the totals line's order, each as a whole word, any text
    # between (specs/0045 ruling AH, N4), else no.
    figures_in_order() { local f re=""; for f in $2; do re="${re:+$re.*}\\b$f\\b"; done; if printf '%s\n' "$1" | LC_ALL=C "$G" -qE "$re"; then echo yes; else echo no; fi; }
    # swap_two <sentence> <a> <b>: the sentence with the whole words a and b
    # exchanged at their first places (the order check's control).
    swap_two() { printf '%s\n' "$1" | sed -E "s/\\b$2\\b/XQX/; s/\\b$3\\b/$2/; s/XQX/$3/"; }
    n_findings=0
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 1. the registry token variables and the credentials file (ruling AE; change TU)"
    tok_state() { if [ -n "${!1+x}" ]; then echo set; else echo absent; fi; }
    echo "command: \${VAR+x} for each token variable (its value never printed)"
    echo "  CARGO_REGISTRY_TOKEN: $(tok_state CARGO_REGISTRY_TOKEN)"
    echo "  CARGO_REGISTRIES_CRATES_IO_TOKEN: $(tok_state CARGO_REGISTRIES_CRATES_IO_TOKEN)"
    tokens_absent() { [ "$(tok_state CARGO_REGISTRY_TOKEN)" = absent ] && [ "$(tok_state CARGO_REGISTRIES_CRATES_IO_TOKEN)" = absent ]; }
    check "neither registry token variable is set (ruling AE)" "$(yn tokens_absent)"
    tok_ctl() { local CARGO_REGISTRY_TOKEN=planted; tokens_absent; }
    check "control: the same check refuses a shell where CARGO_REGISTRY_TOKEN is set" "$(ynnot tok_ctl)"
    tok_ctl2() { local CARGO_REGISTRIES_CRATES_IO_TOKEN=; tokens_absent; }
    check "control: the same check refuses a shell where CARGO_REGISTRIES_CRATES_IO_TOKEN is set, even empty" "$(ynnot tok_ctl2)"
    echo "  the credentials file: this script names, opens and reads no credentials file and runs no cargo login; the publish dry run below is given no token (ruling AE)"
    # Change TY (ruling AH, R3): whether the credentials file exists, by test -e
    # alone; not a byte of it is read. If it exists, a FINDING for the
    # maintainer (the token belongs on the laptop alone), not a stop.
    if [ -e "$HOME/.cargo/credentials.toml" ]; then cred=yes; else cred=no; fi
    echo "  command: test -e <home>/.cargo/credentials.toml (existence alone, never opened; change TY): $cred"
    if [ "$cred" = yes ]; then
      echo "  FINDING: <home>/.cargo/credentials.toml exists on this machine; the token belongs on the laptop alone (ruling AH); recorded for the maintainer, not a stop"
      n_findings=$((n_findings + 1))
    fi
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 2. the package list in <repo> and in a git archive of the phase commit (specs/0045 \"The release texts and the manifest (P3)\"; specs/0031 P2 ruling 1's form; ruling AE; change TU)"
    export CARGO_TARGET_DIR=$RTARGET
    mkdir -p "$RTARGET" || exit 2
    # dirty_flag <dir>: --allow-dirty when <dir> is a git checkout with changes,
    # nothing otherwise (ruling AE: passed only if the tree is dirty there).
    dirty_flag() { if git -C "$1" rev-parse --show-toplevel >/dev/null 2>&1 && [ -n "$(git -C "$1" status --porcelain)" ]; then echo --allow-dirty; fi; }
    FLAG_REPO=$(dirty_flag "$MAIN")
    echo "  <repo>'s working tree: $(run_lines git status --porcelain) status lines, so --allow-dirty is $([ -n "$FLAG_REPO" ] && echo passed || echo "not passed") for its list (the dry run d2 printed the flag itself here)"
    echo "command: cargo package -p emend --list --offline ${FLAG_REPO} in <repo>"
    cargo package -p emend --list --offline $FLAG_REPO >"$B/list-repo.txt" 2>"$B/list-repo.err" </dev/null
    rc_lr=$?
    echo "  exit $rc_lr; entries $(count_lines "$B/list-repo.txt"); standard error lines $(count_lines "$B/list-repo.err"):"
    sed 's/^/    /' "$B/list-repo.err"
    echo "  the list:"
    sed 's/^/    /' "$B/list-repo.txt"
    ARCH=$B/arch
    mkdir -p "$ARCH" || exit 2
    echo "command: git archive --format=tar <phase commit> | tar -x -C <work>/arch"
    git archive --format=tar "$C" | tar -x -C "$ARCH"
    rc_ar=$?
    echo "  exit $rc_ar; files extracted: $(find "$ARCH" -type f | wc -l)"
    check "the archive is extracted (exit 0)" "$(yn [ "$rc_ar" = 0 ])"
    no_git_above() { ! git -C "$1" rev-parse --show-toplevel >/dev/null 2>&1; }
    echo "command: git -C <work>/arch rev-parse --show-toplevel (no repository above the archive)"
    check "the archive lies outside any git checkout: no repository holds <work>/arch (ruling AE)" "$(yn no_git_above "$ARCH")"
    check "control: the same test finds <repo> inside a checkout" "$(ynnot no_git_above "$MAIN")"
    FLAG_ARCH=$(dirty_flag "$ARCH")
    echo "  the archive is no git checkout, so --allow-dirty is ${FLAG_ARCH:+passed}${FLAG_ARCH:-not passed} there (ruling AE)"
    check "--allow-dirty is not passed in the archive" "$(yn [ -z "$FLAG_ARCH" ])"
    echo "command: cargo package -p emend --list --offline in <work>/arch"
    (cd "$ARCH" && cargo package -p emend --list --offline $FLAG_ARCH) >"$B/list-arch.txt" 2>"$B/list-arch.err" </dev/null
    rc_la=$?
    n_lr=$(count_lines "$B/list-repo.txt")
    n_la=$(count_lines "$B/list-arch.txt")
    echo "  exit $rc_la; entries $n_la; standard error lines $(count_lines "$B/list-arch.err"):"
    sed 's/^/    /' "$B/list-arch.err"
    LC_ALL=C "$G" -vxF .cargo_vcs_info.json "$B/list-repo.txt" | LC_ALL=C sort >"$B/list-repo-less-vcs.txt"
    LC_ALL=C sort "$B/list-arch.txt" >"$B/list-arch-sorted.txt"
    echo "command: the repo's list less .cargo_vcs_info.json (git-only, specs/0031 P2 ruling 1 as amended), sorted, against the archive's, sorted (diff):"
    diff "$B/list-repo-less-vcs.txt" "$B/list-arch-sorted.txt" | sed 's/^/    /'
    rels_r=$(count_matches -xF template/_rels/.rels "$B/list-repo.txt")
    rels_a=$(count_matches -xF template/_rels/.rels "$B/list-arch.txt")
    vcs_r=$(count_matches -xF .cargo_vcs_info.json "$B/list-repo.txt")
    echo "  entries: <repo> $n_lr (.cargo_vcs_info.json $vcs_r); the archive $n_la; template/_rels/.rels: <repo> $rels_r, the archive $rels_a"
    check "both lists are made (exit 0 each)" "$(yn [ "$rc_lr$rc_la" = 00 ])"
    lists_equal() { [ "$n_la" -gt 0 ] && [ "$vcs_r" = 1 ] && [ "$n_lr" = "$((n_la + 1))" ] && cmp -s "$B/list-repo-less-vcs.txt" "$B/list-arch-sorted.txt"; }
    if lists_equal; then lv=yes; else
      lv=no
      echo "  FINDING: the archive's package list is not <repo>'s less .cargo_vcs_info.json"
      n_findings=$((n_findings + 1))
    fi
    check "the archive's list is <repo>'s less .cargo_vcs_info.json, the count one fewer (specs/0045 \"The release texts and the manifest (P3)\")" "$lv"
    LC_ALL=C "$G" -vxF template/_rels/.rels "$B/list-arch-sorted.txt" >"$B/c-list-arch.txt"
    lists_ctl() { cmp -s "$B/list-repo-less-vcs.txt" "$B/c-list-arch.txt"; }
    check "control: the same comparison refuses the archive's list less template/_rels/.rels" "$(ynnot lists_ctl)"
    check "template/_rels/.rels is in both lists, once each" "$(yn [ "$rels_r$rels_a" = 11 ])"
    check "control: the same count reads 0 in the list less the file" "$(yn [ "$(count_matches -xF template/_rels/.rels "$B/c-list-arch.txt")" = 0 ])"
    
    echo
    echo "## 3. cargo publish --dry-run in the archive (specs/0045 \"The release texts and the manifest (P3)\"; specs/0031 P2 rulings 1 and 2; ruling AE; change TU)"
    echo "command: cd <work>/arch && CARGO_NET_OFFLINE=false cargo publish -p emend --dry-run ${FLAG_ARCH} (the one command of this log that reaches the network: the registry's index; no token)"
    (cd "$ARCH" && CARGO_NET_OFFLINE=false cargo publish -p emend --dry-run $FLAG_ARCH) >"$B/publish.out" 2>"$B/publish.err" </dev/null
    rc_pub=$?
    echo "  exit $rc_pub; standard output lines $(count_lines "$B/publish.out"); standard error lines $(count_lines "$B/publish.err"):"
    sed 's/^/    /' "$B/publish.err"
    n_abort=$(count_matches -F 'warning: aborting upload due to dry run' "$B/publish.err")
    n_warn=$(count_matches -E '^warning:' "$B/publish.err")
    n_err=$(count_matches -E '^error' "$B/publish.err")
    packaged() { sed -n 's/^ *Packaged \([0-9][0-9]*\) files.*/\1/p' "$1"; }
    n_pkg=$(packaged "$B/publish.err")
    echo "  the aborting-upload warning: $n_abort; warning lines: $n_warn; error lines: $n_err; \"Packaged N files\": ${n_pkg:-none} (the archive's list: $n_la)"
    if [ "$rc_pub" = 0 ]; then pv=yes; else
      pv=no
      echo "  FINDING: cargo publish --dry-run in the archive exited $rc_pub"
      n_findings=$((n_findings + 1))
    fi
    check "the publish dry run exits 0" "$pv"
    check "cargo's one warning, \"aborting upload due to dry run\", stands once, and no other warning or error (ruling 2 of specs/0031 P2)" "$(yn [ "$n_abort $n_warn $n_err" = "1 1 0" ])"
    printf 'warning: aborting upload due to dry run\nwarning: aborting upload due to dry run\n' >"$B/c-publish.err"
    check "control: the same count reads 2 in a fixture of the warning twice" "$(yn [ "$(count_matches -F 'warning: aborting upload due to dry run' "$B/c-publish.err")" = 2 ])"
    check "the package holds the archive's list's count of files" "$(yn [ "${n_pkg:-x}" = "$n_la" ])"
    printf '   Packaged 7 files, 1.0KiB (0.5KiB compressed)\n' >"$B/c-packaged.err"
    check "control: the same reading takes 7 from a fixture's Packaged line" "$(yn [ "$(packaged "$B/c-packaged.err")" = 7 ])"
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 4. the two Excel sentences of each text and their figures (rulings AC and AG; change TV)"
    for rec in records/excel-check-m7-2026-10-26.md records/excel-check-m7p2-2026-10-28.md; do
      tl=$(totals_of "$rec")
      figs=$(figures_of "$rec")
      echo "command: totals_of $rec (the first table row under its \"## Totals\" heading): $tl"
      echo "  figures_of $rec (rows; corpus pass and repair; fixture pass and refused; input pass and refused): $figs"
      check "the record's totals line gives seven figures" "$(yn [ "$(printf '%s\n' $figs | count_lines /dev/stdin)" = 7 ])"
      for t in README.md CHANGELOG.md; do
        s=$(sentence_of "$t" "$rec")
        n_s=$(printf '%s\n' "$s" | count_matches -F 'Microsoft Excel was asked to open' /dev/stdin)
        miss=$(figures_missing "$s" "$figs")
        ord=$(figures_in_order "$s" "$figs")
        echo "  command: sentence_of $t $rec; figures_missing over it:"
        printf '%s\n' "$s" | sed 's/^/    /'
        echo "  sentences $n_s; figures missing $miss; the seven in the totals line's order: $ord (change TY)"
        if [ "$n_s$miss$ord" = 10yes ]; then fv=yes; else
          fv=no
          echo "  FINDING: $t's Excel sentence citing $rec is not one, or misses a figure of the record's totals line, or holds them out of its order"
          n_findings=$((n_findings + 1))
        fi
        check "$t holds one Excel sentence citing $rec, \"Microsoft Excel was asked to open\", holding each of the record's seven figures in the totals line's order (rulings AC and AH)" "$fv"
      done
      first=${figs%% *}
      planted=$(sentence_of README.md "$rec" | sed "s/the $first files/the $((first + 1)) files/")
      check "control: figures_missing reads 1 in README.md's sentence with its row count planted one higher" "$(yn [ "$(figures_missing "$planted" "$figs")" = 1 ])"
      # Change TY (ruling AH, N4): the corpus pass and repair figures swapped.
      fa=$(printf '%s\n' "$figs" | cut -d' ' -f2); fb=$(printf '%s\n' "$figs" | cut -d' ' -f3)
      swapped=$(swap_two "$(sentence_of README.md "$rec")" "$fa" "$fb")
      echo "  the swapped control: README.md's sentence with $fa and $fb exchanged: figures missing $(figures_missing "$swapped" "$figs"); in order: $(figures_in_order "$swapped" "$figs")"
      check "control: figures_in_order refuses README.md's sentence with two figures swapped, all seven still present (change TY)" "$(yn [ "$(figures_missing "$swapped" "$figs")$(figures_in_order "$swapped" "$figs")" = 0no ])"
    done
    echo "  the CHANGELOG's \"Measured\" section, as it stands:"
    awk '$0 == "### Measured" { f = 1 } f && /^### / && $0 != "### Measured" { exit } f' CHANGELOG.md | sed 's/^/    /'
    
    echo
    echo "## 5. the CHANGELOG heading's form (ruling AB; change TV)"
    head_now=$(LC_ALL=C "$G" -m1 -E '^## [0-9]' CHANGELOG.md)
    echo "command: the first \"## <digit>\" heading of CHANGELOG.md: $head_now"
    heading_ok() { printf '%s\n' "$1" | LC_ALL=C "$G" -qxE '## 0[.]1[.]0 [(]([a-z]+|[0-9]{4}-[0-9]{2}-[0-9]{2})[)]'; }
    check "the heading reads \"## 0.1.0 (\" and one parenthesised word or date (ruling AB)" "$(yn heading_ok "$head_now")"
    check "control: the same form takes a dated heading, \"## 0.1.0 (2026-10-30)\"" "$(yn heading_ok '## 0.1.0 (2026-10-30)')"
    check "control: the same form refuses a heading of another version, \"## 0.2.0 (unreleased)\"" "$(ynnot heading_ok '## 0.2.0 (unreleased)')"
    check "control: the same form refuses two words in the parentheses" "$(ynnot heading_ok '## 0.1.0 (not released)')"
    
    echo
    echo "## 6. the two limits, read where 43471ed wrote them (ruling AC; change TV)"
    # section_of <file> <heading>: the section's lines below the heading up to
    # the next heading, joined, runs of spaces squeezed.
    section_of() { awk -v h="$2" '$0 == h { f = 1; next } f && /^#/ { exit } f' "$1" | tr '\n' ' ' | tr -s ' '; }
    LIM1="A cell edit on a table's header row changes the cell and not the table's column name"
    LIM2="A sheet removed leaves every reference to it, and to its tables, in other sheets' formulas and defined names as they were"
    sec_r=$(section_of README.md '## Out of scope by design')
    sec_c=$(section_of CHANGELOG.md '### Not supported by design')
    has() { printf '%s\n' "$1" | LC_ALL=C "$G" -qF "$2"; }
    for lim in "$LIM1" "$LIM2"; do
      echo "  \"$lim\": README \"Out of scope by design\" $(yn has "$sec_r" "$lim"); CHANGELOG \"Not supported by design\" $(yn has "$sec_c" "$lim")"
      check "the limit stands in both sections" "$(yn [ "$(yn has "$sec_r" "$lim")$(yn has "$sec_c" "$lim")" = yesyes ])"
    done
    check "control: the same reading refuses a limit neither section holds" "$(ynnot has "$sec_r" 'A planted limit no section holds')"
    
    echo
    echo "## 7. the five Fixed entries, in the order of \"The fixes (P1)\" (ruling AC; change TV)"
    # fixed_items: the CHANGELOG's "Fixed" items citing specs/0045-publish.md,
    # one per line, joined.
    fixed_items() { awk '$0 == "### Fixed" { f = 1; next } f && /^#/ { exit } f' "$1" | awk 'function out() { if (index(s, "specs/0045-publish.md")) print s; s = "" } /^- / { out() } { sub(/^ +/, ""); s = (s == "" ? $0 : s " " $0) } END { out() }'; }
    fixed_items CHANGELOG.md >"$B/fixed.txt"
    echo "command: fixed_items CHANGELOG.md (the \"Fixed\" items citing specs/0045-publish.md):"
    sed 's/^/    /' "$B/fixed.txt"
    # fix_order <file>: the fix numbers the items name, in order.
    fix_order() { LC_ALL=C "$G" -o -E 'fix [0-9]' "$1" | tr '\n' ' '; }
    cites_both() { [ "$(count_lines "$1")" = "$(count_matches -F 'records/excel-check-m7-2026-10-26.md' "$1")" ]; }
    echo "  items $(count_lines "$B/fixed.txt"); fix numbers in order: $(fix_order "$B/fixed.txt"); items citing part 1's record: $(count_matches -F 'records/excel-check-m7-2026-10-26.md' "$B/fixed.txt")"
    check "five items, fixes 1 to 5 in order, each citing specs/0045-publish.md and part 1's record" "$(yn [ "$(count_lines "$B/fixed.txt") $(fix_order "$B/fixed.txt")" = "5 fix 1 fix 2 fix 3 fix 4 fix 5 " ])"
    check "every such item cites part 1's record" "$(yn cites_both "$B/fixed.txt")"
    tac "$B/fixed.txt" >"$B/c-fixed.txt"
    check "control: the order reading gives 5 to 1 over the items reversed" "$(yn [ "$(fix_order "$B/c-fixed.txt")" = "fix 5 fix 4 fix 3 fix 2 fix 1 " ])"
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 8. the crate doc comment: its feature list against the manifest's, and its opening against the README's (rulings AC and AG; change TW)"
    echo "command: manifest_features crates/emend/Cargo.toml and doc_features crates/emend/src/lib.rs, side by side:"
    LC_ALL=C join -a1 -a2 -e '-' -o 0,1.1,2.1 <(manifest_features crates/emend/Cargo.toml) <(doc_features crates/emend/src/lib.rs) | awk '{ printf "    %-12s manifest %-12s doc comment %s\n", $1, $2, $3 }'
    n_man=$(manifest_features crates/emend/Cargo.toml | count_lines /dev/stdin)
    n_un=$(features_unnamed crates/emend/src/lib.rs crates/emend/Cargo.toml)
    echo "  the manifest's features $n_man; of them unnamed in the doc comment's list $n_un"
    check "every one of the manifest's 12 features is named in the doc comment's list (ruling AG)" "$(yn [ "$n_man $n_un" = "12 0" ])"
    LC_ALL=C "$G" -vE '^//! - `charts`:' crates/emend/src/lib.rs >"$B/c-lib.rs"
    check "control: features_unnamed reads 1 over a copy of lib.rs lacking its charts line" "$(yn [ "$(features_unnamed "$B/c-lib.rs" crates/emend/Cargo.toml)" = 1 ])"
    doc_intro() { sed -n 's#^//! \{0,1\}##p' "$1" | awk 'BEGIN { RS = "" } NR == 2 || NR == 3' | tr '\n' ' '; }
    readme_intro() { awk 'BEGIN { RS = "" } NR == 2 || NR == 3' "$1" | tr '\n' ' '; }
    echo "command: the doc comment's second and third paragraphs, joined:"
    doc_intro crates/emend/src/lib.rs | fold -s -w 100 | sed 's/^/    /'
    echo
    echo "command: README.md's first two paragraphs below its title, joined:"
    readme_intro README.md | fold -s -w 100 | sed 's/^/    /'
    echo
    intro_same() { [ -n "$(readme_intro "$2")" ] && [ "$(doc_intro "$1")" = "$(readme_intro "$2")" ]; }
    check "the doc comment's opening is the README's first paragraphs, word for word (specs/0031 decision 3; ruling AC: no sentence contradicts a fix, unchanged)" "$(yn intro_same crates/emend/src/lib.rs README.md)"
    sed 's/byte for/word for/' README.md >"$B/c-readme.md"
    check "control: the same comparison refuses a README copy with one word changed" "$(ynnot intro_same crates/emend/src/lib.rs "$B/c-readme.md")"
    
    echo
    echo "## the FINDING lines of this log (specs/0043 ruling R)"
    echo "  FINDING lines printed above: $n_findings (each begins with the word FINDING; none is fixed)"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  the spec $SPEC, sha256 $(sha_of "$SPEC"); ROADMAP.md, sha256 $(sha_of ROADMAP.md)"
    echo "status lines: $st_all; of them this phase's logs or planning's spec and ROADMAP.md: $st_ours (change TT)"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's spec and ROADMAP.md" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources (the phase commit's, by git show)
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

