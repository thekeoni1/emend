    echo "  the doc commit by its subject \"$DOC_SUBJECT\": ${DC:-none}"
    check "the phase commit given is the code commit, by its subject (change PI1)" "$(yn [ "$PC" = "$C" ])"
    check "the doc commit is the phase commit's parent" "$(yn [ "$DC" = "$(git rev-parse "$C^")" ])"
    if [ -z "$PC" ] || [ "$PC" != "$C" ]; then stop_here "the phase commit is not the code commit"; fi
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    roadmap_committed=$(git show "$C:ROADMAP.md" | sha256sum | cut -d' ' -f1)
    spec_now=$(sha_of "$SPEC")
    roadmap_now=$(sha_of ROADMAP.md)
    echo "  $SPEC at the phase commit: $spec_committed (pinned $SPEC_WANT); in the working tree: $spec_now; PLANNING_SPEC: ${PLANNING_SPEC:-unset}"
    echo "  ROADMAP.md at the phase commit: $roadmap_committed (pinned $ROADMAP_WANT); in the working tree: $roadmap_now; PLANNING_ROADMAP: ${PLANNING_ROADMAP:-unset}"
    pinned_ok() { [ "$spec_committed" = "$SPEC_WANT" ] && [ "$roadmap_committed" = "$ROADMAP_WANT" ]; }
    check "the phase commit's spec and ROADMAP.md are the pinned blobs (change PI1)" "$(yn pinned_ok)"
    working_ok() { { [ "$spec_now" = "$spec_committed" ] || { [ -n "$PLANNING_SPEC" ] && [ "$spec_now" = "$PLANNING_SPEC" ]; }; } && { [ "$roadmap_now" = "$roadmap_committed" ] || { [ -n "$PLANNING_ROADMAP" ] && [ "$roadmap_now" = "$PLANNING_ROADMAP" ]; }; }; }
    check "the working spec and ROADMAP.md are the phase commit's or planning's named copies" "$(yn working_ok)"
    working_ctl() { local spec_now=1111111111111111111111111111111111111111111111111111111111111111; working_ok; }
    check "control: the same check refuses a spec of another hash" "$(ynnot working_ctl)"
    TAGS_PY=$MAIN/scripts/corpus-tags.py
    ADD_PY=$MAIN/scripts/corpus-add.py
    COV_PY=$MAIN/scripts/corpus-coverage.py
    for f in scripts/corpus-tags.py scripts/corpus-add.py scripts/corpus-coverage.py; do
      echo "  $f: in the working tree sha256 $(sha_of "$f"); at the phase commit $(git show "$C:$f" | sha256sum | cut -d' ' -f1)"
    done
    scripts_committed() {
      local f
      for f in scripts/corpus-tags.py scripts/corpus-add.py scripts/corpus-coverage.py; do
        [ "$(sha_of "$f")" = "$(git show "$C:$f" | sha256sum | cut -d' ' -f1)" ] || return 1
      done
    }
    check "the three corpus scripts this log runs are the phase commit's" "$(yn scripts_committed)"
    echo "root: <repo> stands for the repository's top level; scripts/counting.sh is taken from it at the phase commit by git show, and the three corpus scripts are run from it"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m7p3-p1 on the disk, the phase's directory; <phase>/gen holds the generator that wrote this script and <phase>/model the script it carries its frame from"
    echo "root: <workroot> stands for the work root: <phase> in the logged run, the directory RUN_WORK names in a dry run; it holds TMPDIR (change PI2)"
    echo "root: <corpus> stands for the corpus directory: <home>/emend-testing in the logged run, the directory DRY_CORPUS names in a dry run (change PI2); <corpus>/work/incoming is the logged run's incoming directory, <corpus>/manifest.tsv the manifest and <corpus>/corpus the workbooks"
    echo "root: <source> stands for the directory INTAKE_SOURCE names in a dry run, standing for the incoming directory (change PI2)"
    echo "root: <scratch> stands for <workroot>, named <scratch> where TMPDIR is concerned: TMPDIR is <scratch>/tmp, made and exported by this script before any mktemp, and <work> is made under it"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory; this script's own standard error goes to <scripts>/out/intake.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (the counting library, the listing's files, each command's standard error, the negative's fixtures and scratch corpus), kept after the run and never removed"
    work_in_tmpdir() { case "$B/" in "$TMPDIR/"*) return 0 ;; esac; return 1; }
    check "<work>, the directory mktemp -d made, is under TMPDIR, <scratch>/tmp" "$(yn work_in_tmpdir)"
    work_ctl() { local B=/tmp/x; work_in_tmpdir; }
    check "control: the same test refuses a working directory under /tmp" "$(ynnot work_ctl)"
    # Every mktemp call of this script is checked under TMPDIR, so the source is
    # read for its calls outside comments; the call's text is built from
    # pieces, so this form's own text is no call.
    MKW='$('
    MKW=${MKW}mkt
    MKW=${MKW}emp
    count_tempcalls() {
      awk -v w="$MKW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { n++; s = substr(s, i + length(w)) }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "A=$MKW -d)" "F=$MKW)" "# $MKW -d)" >"$B/mktemp-fixture"
    n_mk=$(count_tempcalls "$SELF")
    n_mk_fix=$(count_tempcalls "$B/mktemp-fixture")
    echo "command: count_tempcalls <this script>, and the same over a fixture of three lines: a directory call, a file call, a comment"
    echo "  mktemp calls in this script outside comments: $n_mk (the one that makes <work>, checked under TMPDIR above); in the fixture: $n_mk_fix"
    check "this script makes one mktemp call, <work>'s, and no plain temporary file" "$(yn [ "$n_mk" = 1 ])"
    check "control: the same count finds the fixture's two calls and not its comment" "$(yn [ "$n_mk_fix" = 2 ])"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs, a coverage record, planning's modified specs/0046 and ROADMAP.md) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    ours_rec_ctl() { printf '?? records/logs/m7p3-p1/intake.log\n?? records/corpus-coverage-2026-10-30.md\n M specs/0046-corpus-maintainer-items.md\n M ROADMAP.md\n?? records/logs/m7p2-p4/verify.log\n M README.md\n M scripts/corpus-add.py\n?? records/corpus-coverage-x.md\n' | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern admits this phase's log, a dated coverage record, specs/0046 and ROADMAP.md alone; it refuses another phase's log, a modified README and script, and an undated record" "$(yn [ "$(ours_rec_ctl)" = 4 ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources (the phase commit's, by git show)"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    # The corpus directory and, for list and add, the incoming directory:
    # directories, mode 700, the corpus outside any git work tree (change PI2).
    mode_of() { stat -c '%a' "$1"; }
    not_in_git() { [ -d "$1" ] && ! git -C "$1" rev-parse >/dev/null 2>&1; }
    under_root() { case "$1/" in "$WORK_ROOT/"*) return 0 ;; esac; return 1; }
    corpus_ok() { [ -d "$CORPUS" ] && [ "$(mode_of "$CORPUS")" = 700 ] && not_in_git "$CORPUS"; }
    dry_roots_ok() { under_root "$CORPUS" && under_root "$IN" && [ "$CORPUS" != "$REAL_CORPUS" ]; }
    dry_roots_ctl() { local CORPUS=$REAL_CORPUS; dry_roots_ok; }
    in_ok() { [ -d "$IN" ] && [ ! -L "$IN" ] && [ "$(mode_of "$IN")" = 700 ]; }
    if [ "$MODE" != negative ]; then
      echo
      echo "## the corpus directory (change PI2)"
      echo "  <corpus>: a directory: $([ -d "$CORPUS" ] && echo yes || echo no); mode $(mode_of "$CORPUS"); inside a git work tree: $(not_in_git "$CORPUS" && echo no || echo yes)"
      check "<corpus> is a directory, mode 700, outside any git work tree" "$(yn corpus_ok)"
      check "control: the same git test finds the repository a work tree" "$(ynnot not_in_git "$MAIN")"
      if [ "$LOGGED" = no ]; then
        check "a dry run's corpus and incoming stand-in lie under the work root, and the corpus is not <home>/emend-testing" "$(yn dry_roots_ok)"
        check "control: the same check refuses the real corpus" "$(ynnot dry_roots_ctl)"
      fi
      if corpus_ok; then :; else stop_here "the corpus directory"; fi
      MAN=$CORPUS/manifest.tsv
      man_rows() { if [ -f "$MAN" ]; then echo $(($(count_lines "$MAN") - 1)); else echo 0; fi; }
      in_corpus() { [ -f "$MAN" ] && awk -F'\t' -v id="$1" 'NR > 1 && $1 == id { f = 1 } END { exit !f }' "$MAN"; }
      echo "  <corpus>/manifest.tsv rows at entry: $(man_rows)"
    fi
    
    # The incoming directory's entries in their sorted order (C locale), by
    # sequence number; the names are held in an array and never printed.
    declare -a ENT
    list_incoming() {
      ENT=()
      local e
      while IFS= read -r -d '' e; do ENT+=("$e"); done < <(find "$IN" -mindepth 1 -maxdepth 1 -print0 | LC_ALL=C sort -z)
    }
    PROP_RE='^(xlsx|xlsm|xltx|xltm|other) [0-9]+ (excel-win|excel-mac|unknown) plain(,[a-z0-9]+)*( chartex)?( threaded)?$'
    prop_form() { printf '%s\n' "$1" | LC_ALL=C "$G" -qE "$PROP_RE"; }
    # A command's standard error is printed when every line is one refused or
    # error line of the scripts' own fixed forms; otherwise only its bytes.
    err_lines() {
      if [ ! -s "$1" ]; then echo "    (standard error: 0 bytes)"; return; fi
      if [ "$(count_matches -E '^(refused|error): [A-Za-z0-9 ,._-]+$' "$1")" = "$(count_lines "$1")" ]; then sed 's/^/    stderr: /' "$1"; else echo "    (standard error: $(wc -c <"$1") bytes, not printed: not of the scripts' fixed forms)"; fi
    }
    declare -A SEQ_SHA
    show_listing() {
      echo "command: find <incoming> -mindepth 1 -maxdepth 1 -print0 | LC_ALL=C sort -z; each entry named by its sequence number"
      echo "  <incoming>: a directory: $([ -d "$IN" ] && echo yes || echo no); a link: $([ -L "$IN" ] && echo yes || echo no); mode $(mode_of "$IN")"
      check "the incoming directory is a directory, not a link, mode 700" "$(yn in_ok)"
      if in_ok; then :; else stop_here "the incoming directory"; fi
      list_incoming
      echo "  entries: ${#ENT[@]}"
      local i n f t sz sh pr rc
      for ((i = 0; i < ${#ENT[@]}; i++)); do
        n=$((i + 1))
        f=${ENT[$i]}
        if [ -L "$f" ]; then t=link; elif [ -f "$f" ]; then t=file; elif [ -d "$f" ]; then t=directory; else t=other; fi
        if [ "$t" != file ]; then
          echo "  entry $n: a $t"
          finding "entry $n of the incoming directory is a $t, not a regular file"
          continue
        fi
        sz=$(wc -c <"$f")
        sh=$(sha_of "$f")
        SEQ_SHA[$n]=$sh
        python3 -I -B "$TAGS_PY" "$f" >"$B/prop.$n" 2>"$B/prop.$n.err"
        rc=$?
        pr=$(cat "$B/prop.$n")
        echo "  entry $n: a file, $sz bytes, sha256 $sh, id ${sh:0:12}; in the corpus already: $(in_corpus "${sh:0:12}" && echo yes || echo no)"
        echo "    corpus-tags.py exit $rc: ${pr:-(nothing on stdout)}"
        err_lines "$B/prop.$n.err"
        if [ "$rc" = 0 ] && [ "$(count_lines "$B/prop.$n")" = 1 ] && prop_form "$pr" && [ ! -s "$B/prop.$n.err" ]; then
          check "entry $n: the proposer printed one line of its form, exit 0" yes
        else
          check "entry $n: the proposer printed one line of its form, exit 0" no
          finding "entry $n: the proposer refused it or printed another form (exit $rc)"
        fi
        if in_corpus "${sh:0:12}"; then finding "entry $n's id is in the corpus already"; fi
      done
      check "control: the proposer's form refuses a line naming a producer it never proposes" "$(ynnot prop_form "xlsx 10 libreoffice plain")"
      check "control: the proposer's form accepts a line with both words" "$(yn prop_form "xlsm 10 excel-mac plain,charts,comments chartex threaded")"
    }
    
    if [ "$MODE" = list ]; then
      echo
      echo "## the intake listing (change PI3)"
      show_listing
      finish
    fi
    
    if [ "$MODE" = add ]; then
      echo
      echo "## the incoming directory read again before the additions (change PI4)"
      show_listing
      echo
      echo "## the additions, one corpus-add.py per ruled file (change PI4)"
      echo "command: python3 -I -B <repo>/scripts/corpus-add.py <entry> <producer> <producer version> <source> <tags> [note], once per row of INTAKE_RULING; the entry's name, the producer version and the note are never printed"
      rows_before=$(man_rows)
      n_rows=0
      n_added=0
      n_refused=0
      declare -A RULED
      # One addition as expected: the added line, the copy and the manifest row.
      added_ok() { [ "$out" = "$want" ] && [ "$(count_lines "$B/add.$r_seq")" = 1 ] && [ -f "$copy" ] && [ "$(sha_of "$copy")" = "$r_sha" ] && in_corpus "$id"; }
      # The ruling's rows: tab-separated, a sequence number, a sha256, the
      # producer, the producer version, the source, the tags, an optional note.
      while IFS=$'\t' read -r r_seq r_sha r_prod r_pver r_src r_tags r_note; do
        [ -n "$r_seq" ] || continue
        n_rows=$((n_rows + 1))
        echo "  ruled row $n_rows: entry $r_seq, sha256 $r_sha, producer $r_prod, source $r_src, tags $r_tags; a note: $([ -n "${r_note:-}" ] && echo yes || echo no)"
        if ! printf '%s' "$r_seq" | LC_ALL=C "$G" -qxE '[1-9][0-9]*' || [ "$r_seq" -gt "${#ENT[@]}" ] || [ -n "${RULED[$r_seq]:-}" ]; then
          finding "ruled row $n_rows names no entry of the listing, or an entry twice"
          continue
        fi
        RULED[$r_seq]=1
        f=${ENT[$((r_seq - 1))]}
        if [ "${SEQ_SHA[$r_seq]:-}" != "$r_sha" ]; then
          finding "entry $r_seq's sha256 is not the ruling's; it is left"
          continue
        fi
        if [ -n "${r_note:-}" ]; then
          python3 -I -B "$ADD_PY" "$f" "$r_prod" "$r_pver" "$r_src" "$r_tags" "$r_note" >"$B/add.$r_seq" 2>"$B/add.$r_seq.err"
        else
          python3 -I -B "$ADD_PY" "$f" "$r_prod" "$r_pver" "$r_src" "$r_tags" >"$B/add.$r_seq" 2>"$B/add.$r_seq.err"
        fi
        rc=$?
        out=$(cat "$B/add.$r_seq")
        echo "    corpus-add.py exit $rc: ${out:-(nothing on stdout)}"
        err_lines "$B/add.$r_seq.err"
        if [ "$rc" != 0 ]; then
          n_refused=$((n_refused + 1))
          finding "entry $r_seq: corpus-add.py refused it (exit $rc); the file is left"
          continue
        fi
        id=${r_sha:0:12}
        ext=$(printf '%s' "$out" | cut -d' ' -f3)
        want="added $id $ext $(wc -c <"$f") $r_prod $r_tags"
        copy=$CORPUS/corpus/$id.$ext
        echo "    the corpus copy <corpus>/corpus/$id.$ext: sha256 $([ -f "$copy" ] && sha_of "$copy" || echo none)"
        check "entry $r_seq: one added line naming its id, extension, bytes, producer and tags; the copy's sha256 the entry's; the id in the manifest" "$(yn added_ok)"
        if added_ok; then :; else finding "entry $r_seq: the addition is not as expected; the file is left"; continue; fi
        n_added=$((n_added + 1))
        echo "    command: rm <the entry's path> (that one path; never rm -r)"
        rm "$f"
        check "entry $r_seq: removed from the incoming directory" "$(ynnot [ -e "$f" ])"
      done <"$INTAKE_RULING"
      rows_after=$(man_rows)
      echo "  ruled rows: $n_rows; added: $n_added; refused: $n_refused; manifest rows before $rows_before, after $rows_after"
      check "the manifest gained one row per addition" "$(yn [ "$rows_after" = "$((rows_before + n_added))" ])"
      list_incoming
      echo "  entries left in the incoming directory: ${#ENT[@]}"
      added_ctl() { local out=x want=y; added_ok; }
      check "control: the added-line comparison refuses a line that differs" "$(ynnot added_ctl)"
      finish
    fi
    
    if [ "$MODE" = coverage ]; then
      echo
      echo "## the coverage over the corpus (change PI5)"
      echo "command: python3 -I -B <repo>/scripts/corpus-coverage.py --verify; script sha256 $(sha_of "$COV_PY"); at the phase commit $C"
      python3 -I -B "$COV_PY" --verify >"$B/coverage.out" 2>"$B/coverage.err"
      rc=$?
      echo "  exit $rc; standard error $(wc -c <"$B/coverage.err") bytes; stdout $(count_lines "$B/coverage.out") lines, sha256 $(sha_of "$B/coverage.out")"
      echo "  the stdout, whole (ids, extensions, byte counts, producers, sources, tags and counts only):"
      sed 's/^/    /' "$B/coverage.out"
      first=$(head -n 1 "$B/coverage.out")
      n_files=$(man_rows)
      cov_ok() { [ "$rc" = 0 ] && [ ! -s "$B/coverage.err" ] && [ "$first" = "files $n_files" ] && [ "$(count_matches -E '^FAIL ' "$B/coverage.out")" = 0 ]; }
      check "the coverage ran with --verify, exit 0, no stderr, no FAIL line, its file count the manifest's $n_files rows" "$(yn cov_ok)"
      if cov_ok; then :; else finding "the coverage script did not verify the corpus"; fi
      cov_ctl() { local first="files $((n_files + 1))"; cov_ok; }
      check "control: the same check refuses a count one more than the manifest's" "$(ynnot cov_ctl)"
      echo "  the gaps (the record's gaps list):"
      LC_ALL=C "$G" -E '^(uncovered|single-producer) ' "$B/coverage.out" | sed 's/^/    /'
      check "the stdout names the uncovered and the single-producer tags, one line each" "$(yn [ "$(count_matches -E '^(uncovered|single-producer) ' "$B/coverage.out")" = 2 ])"
      finish
    fi
    
    # Mode negative (change PI6): fictional files and a scratch corpus under
    # <work>, never the corpus; EMEND_CORPUS_DIR names the scratch corpus.
    echo
    echo "## the negative: the proposer and corpus-add.py refuse (change PI6)"
    NEG=$B/neg
    NC=$B/negcorpus
    mkdir -p "$NEG" && mkdir -m 700 "$NC" || stop_here "the negative's directories"
    export EMEND_CORPUS_DIR=$NC
    echo "root: <work>/negcorpus is the negative's scratch corpus, mode 700, made here; EMEND_CORPUS_DIR names it for corpus-add.py; <work>/neg holds the fictional files"
    python3 -I -B - "$NEG/fictional.xlsx" <<'PYEOF'
    import sys, zipfile
    NS = 'xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"'
    with zipfile.ZipFile(sys.argv[1], "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("[Content_Types].xml", '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"/>')
        z.writestr("xl/workbook.xml", '<workbook %s><sheets><sheet name="S" sheetId="1"/></sheets></workbook>' % NS)
        z.writestr("xl/worksheets/sheet1.xml", '<worksheet %s><sheetData/></worksheet>' % NS)
    PYEOF
    printf 'a fictional text file, not a zip\n' >"$NEG/notzip.xlsx"
    run_one() { "$@" >"$B/neg.out" 2>"$B/neg.err"; echo $?; }
    refused_once() { [ "$1" = 1 ] && [ ! -s "$B/neg.out" ] && [ "$(count_lines "$B/neg.err")" = 1 ] && [ "$(count_matches -E "^refused: $2\$" "$B/neg.err")" = 1 ]; }
    show_neg() { echo "  exit $1; stdout: $(cat "$B/neg.out"); stderr: $(cat "$B/neg.err")"; }
    nc_empty() { [ ! -e "$NC/manifest.tsv" ] && [ -z "$(ls -A "$NC")" ]; }
    
    echo "command: python3 -I -B <repo>/scripts/corpus-tags.py <work>/neg/notzip.xlsx (a text file)"
    rc=$(run_one python3 -I -B "$TAGS_PY" "$NEG/notzip.xlsx"); show_neg "$rc"
    check "the proposer refuses a file that is not a zip: exit 1, nothing on stdout, one line \"refused: not a zip-based workbook\"" "$(yn refused_once "$rc" 'not a zip-based workbook')"
    echo "command: python3 -I -B <repo>/scripts/corpus-tags.py <work>/neg/fictional.xlsx (a fictional workbook; the control)"
    rc=$(run_one python3 -I -B "$TAGS_PY" "$NEG/fictional.xlsx"); show_neg "$rc"
    prop_ctl() { [ "$rc" = 0 ] && [ ! -s "$B/neg.err" ] && [ "$(cat "$B/neg.out")" = "xlsx $(wc -c <"$NEG/fictional.xlsx") unknown plain" ]; }
    check "control: the proposer accepts the fictional workbook: exit 0, one line, xlsx, its bytes, unknown, plain" "$(yn prop_ctl)"
    check "control: the refusal check refuses the accepted run" "$(ynnot refused_once "$rc" 'not a zip-based workbook')"
    
    echo "command: python3 -I -B <repo>/scripts/corpus-add.py <work>/neg/fictional.xlsx unknown 0 maintainer plain,nosuchtag"
    rc=$(run_one python3 -I -B "$ADD_PY" "$NEG/fictional.xlsx" unknown 0 maintainer plain,nosuchtag); show_neg "$rc"
    check "corpus-add.py refuses an unknown tag: exit 1, one line \"refused: unknown, empty or repeated tag\"" "$(yn refused_once "$rc" 'unknown, empty or repeated tag')"
    check "nothing was added to the scratch corpus" "$(yn nc_empty)"
    echo "command: python3 -I -B <repo>/scripts/corpus-add.py <work>/neg/fictional.xlsx unknown 0 nosuchsource plain"
    rc=$(run_one python3 -I -B "$ADD_PY" "$NEG/fictional.xlsx" unknown 0 nosuchsource plain); show_neg "$rc"
    check "corpus-add.py refuses an unknown source: exit 1, one line \"refused: unknown source\"" "$(yn refused_once "$rc" 'unknown source')"
    check "nothing was added to the scratch corpus" "$(yn nc_empty)"
    echo "command: python3 -I -B <repo>/scripts/corpus-add.py <work>/neg/fictional.xlsx unknown 0 maintainer plain (the control)"
    rc=$(run_one python3 -I -B "$ADD_PY" "$NEG/fictional.xlsx" unknown 0 maintainer plain); show_neg "$rc"
    FSHA=$(sha_of "$NEG/fictional.xlsx")
    add_ctl() { [ "$rc" = 0 ] && [ ! -s "$B/neg.err" ] && [ "$(cat "$B/neg.out")" = "added ${FSHA:0:12} xlsx $(wc -c <"$NEG/fictional.xlsx") unknown plain" ] && [ "$(count_lines "$NC/manifest.tsv")" = 2 ]; }
    check "control: corpus-add.py accepts the same file with a known tag and source: one added line, one manifest row" "$(yn add_ctl)"
    check "control: the empty-corpus check refuses the scratch corpus now" "$(ynnot nc_empty)"
    finish

## the shared counting library this log sources (the phase commit's, by git show)
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

