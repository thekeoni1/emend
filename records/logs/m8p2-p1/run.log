    ROWCOL_COST_WANT=58244
    BAND_LOW=3000
    BAND_HIGH=12000
    BAND_ACCEPT=16000
    RUN_OUT_ROOT=${RUN_OUT_ROOT:-$CORPUS/runs}
    RUN_FLAGS=${RUN_FLAGS:-$P1_FLAGS}
    if [ ! -f "$CORPUS/manifest.tsv" ] || [ ! -d "$CORPUS/corpus" ]; then echo "the corpus directory holds no manifest.tsv and corpus/" >&2; exit 2; fi
    SHORT=$(git rev-parse --short=7 "$C")
    DATE=$(date -u +%Y-%m-%d)
    RUN=$DATE-$SHORT
    # TMPDIR is <scratch>/tmp, the phase's directory's, made and exported before
    # any mktemp; the working directory is the one mktemp -d makes under it, on
    # the disk, kept; nothing here is removed.
    TMPDIR=$PHASE_DIR/tmp
    # Change TQ, carried (specs/0047 ruling A): a dry run names its own with
    # RUN_TMPDIR.
    if [ -n "${RUN_TMPDIR:-}" ]; then TMPDIR=$RUN_TMPDIR; fi
    export TMPDIR
    mkdir -p "$TMPDIR" || exit 2
    B=$(mktemp -d) || exit 2
    mkdir "$B/bin" "$B/records" "$B/tmp-run" "$B/prev" || exit 2
    RECORDS=$B/records
    RUNTMP=$B/tmp-run
    # The counting library is the phase commit's, by git show.
    git show "$C:scripts/counting.sh" >"$B/counting.sh" || exit 2
    . "$B/counting.sh"
    fail=0
    check() { echo "  $1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # For a condition that must NOT hold: a leading bang inside yn runs a
    # command named by the bang (specs/0001), so a negation has its own helper.
    ynnot() { if "$@"; then echo no; else echo yes; fi; }
    TAB=$(printf '\t')
    sha_of() { sha256sum <"$1" | cut -d' ' -f1; }
    
    head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
    full_sha() { printf '%s' "$1" | LC_ALL=C "$G" -qE '^[0-9a-f]{40}$'; }
    # The given commit is the phase commit when it is a full sha and HEAD.
    given_ok() { full_sha "$1" && head_is "$1"; }
    if given_ok "$C"; then :; else echo "the phase commit must be a full 40-hex sha that is HEAD, not $C" >&2; exit 2; fi
    if [ ! -f "$GATE_LOG" ]; then echo "the gate log is not a file" >&2; exit 2; fi
    NULL_SHA=0000000000000000000000000000000000000000
    case "${C: -1}" in 0) LAST=1 ;; *) LAST=0 ;; esac
    FAKE_SHA=${C:0:39}$LAST
    # Change WA: what the status pattern admits: this phase's log directory and
    # planning's modified specs/0048; nothing else (no record file is this
    # phase's, change WE).
    OURS="^((\\?\\?| ?[MARCD]) records/logs/m8p2-p1/| M specs/0048-the-two-refusals[.]md\$)"
    entry_all=$(run_lines git status --porcelain)
    entry_ours=$(run_matches -E "$OURS" git status --porcelain)
    entry_clean() { [ "$entry_all" != error ] && [ "$entry_ours" != error ] && [ "$entry_all" = "$entry_ours" ]; }
    if entry_clean; then :; else
      echo "the working tree holds changes outside this phase's logs and planning's spec" >&2
      exit 2
    fi
    
    # Change RV: the gate's release binaries, copied into <work>/bin; the copies
    # are what this log runs.
    for b in emend-copy xlsx-diff; do
      if [ ! -x "$RELEASE_DIR/$b" ]; then echo "the gate's release $b is not there" >&2; exit 2; fi
      cp "$RELEASE_DIR/$b" "$B/bin/$b" || exit 2
    done
    PT=$B/bin/emend-copy
    XD=$B/bin/xlsx-diff
    # Change RW: the flags, from the binary's own usage text (part 1's ruling E): its
    # usage error, the run with no argument, read for every word ending in
    # -sample, in its order.
    "$PT" >"$B/usage.out" 2>&1 </dev/null
    USAGE_RC=$?
    LC_ALL=C "$G" -o -E -- '--[a-z0-9-]*-sample' "$B/usage.out" >"$B/usage.flags"
    : >"$B/run.flags"
    # Change WB: the flags run are the four row and column samples (a dry run's
    # RUN_FLAGS a subset of them), in the usage text's order.
    while IFS= read -r f; do
      case " $RUN_FLAGS " in *" $f "*) ;; *) continue ;; esac
      printf '%s\n' "$f" >>"$B/run.flags"
    done <"$B/usage.flags"
    for f in $RUN_FLAGS; do
      case " $P1_FLAGS " in *" $f "*) ;; *) echo "RUN_FLAGS names $f, which is not one of the four row and column samples" >&2; exit 2 ;; esac
      if [ "$(count_matches -xF "$f" "$B/run.flags")" != 1 ]; then echo "RUN_FLAGS names $f, which the usage text does not name once" >&2; exit 2; fi
    done
    name_of() { local n=${1#--}; printf '%s\n' "${n%-sample}"; }
    # The run directories this log writes, each refused if it is there already
    # (change TD's form; no passthrough run, change WB).
    while IFS= read -r f; do name_of "$f"; done <"$B/run.flags" >"$B/run.names"
    while IFS= read -r n; do
      if [ -e "$RUN_OUT_ROOT/$RUN-$n" ]; then echo "$RUN_OUT_ROOT/$RUN-$n is already there; name a fresh run" >&2; exit 2; fi
    done <"$B/run.names"
    
    # The runs root before the corpus, the phase's directories before <phase>,
    # and <home> last. Change WF: a dry run's probe root is <probes>; the
    # logged run's is <target>/main and is written so.
    SCRUB_PROBE=()
    if [ "$PROBE_TARGET" != "$BUILD_ROOT" ]; then SCRUB_PROBE=(-e "s#$PROBE_TARGET#<probes>#g"); fi
    scrub() {
      sed -e "s#$B#<work>#g" -e "s#$TMPDIR#<scratch>/tmp#g" -e "s#$SELF_DIR#<scripts>#g" \
        "${SCRUB_PROBE[@]}" -e "s#$TARGET_ROOT#<target>#g" -e "s#$RUN_OUT_ROOT#<runs>#g" -e "s#$CORPUS#<corpus>#g" \
        -e "s#$MAIN#<repo>#g" -e "s#$PHASE_DIR#<phase>#g" -e "s#$HOME#<home>#g"
    }
    exec 3>&1
    exec > >(scrub >&3)
    SCRUB_PID=$!
    
    echo "command: git rev-parse HEAD"
    echo "invocation: bash <scripts>/$(basename "$0") $*"
    echo "about: M8 part 2 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    # The environment inputs, each on its labelled line.
    for v in $INPUT_NAMES; do echo "input: $v=${INPUT_SEEN[$v]}"; done
    echo "input (as exported by this script): PYTHONDONTWRITEBYTECODE=$PYTHONDONTWRITEBYTECODE CARGO_NET_OFFLINE=$CARGO_NET_OFFLINE"
    echo "input: TMPDIR=$TMPDIR"
    echo "  (TMPDIR set, made and exported by this script before any mktemp; <work> is made under it)"
    echo "input: ANTHROPIC_API_KEY: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo set || echo unset) (its value never printed)"
    echo "input: the gate log (the second argument): $GATE_LOG"
    if [ "$LOGGED" = yes ]; then
      echo "mode: the logged run: none of the dry run's overrides is set ($OVERRIDES), so the whole set's counts and the expected-change totals are judged (changes TC and WG)"
    else
      echo "mode: a dry run, a DRY CUT (changes TC and WG; specs/0043 ruling Q): an override is set; the counts of the whole set and the expected-change totals are not judged, an earlier id missing from the fictional corpus is printed and not judged, and nothing is written under the real corpus's runs/ unless an override left it there"
    fi
    echo
    echo "## the three shape greps, over this script, before its log (specs/0001)"
    D='$'
    SHAPE_CHAIN="\\${D}\\((yn|ynnot|is|isnot) .*(&&|\\|\\|)"
    SHAPE_BANG="\\${D}\\((yn|ynnot|is|isnot) !"
    SHAPE_ASSIGN="\\${D}\\((yn|ynnot|is|isnot) [A-Za-z_][A-Za-z0-9_]*="
    printf '%s\n' "x=${D}(is [ 1 ] && true)" "y=${D}(isnot ! true)" "z=${D}(yn N=1 true)" >"$B/shape-fixture"
    echo "command: count_matches -E <shape> <this script>, and the same over a fixture holding one line of each shape"
    for shape in CHAIN BANG ASSIGN; do
      var=SHAPE_$shape
      n_self=$(count_matches -E "${!var}" "$SELF")
      n_fix=$(count_matches -E "${!var}" "$B/shape-fixture")
      echo "  shape $shape: in this script $n_self; in the fixture $n_fix"
      check "$shape: this script holds none" "$(yn [ "$n_self" = 0 ])"
      check "control: $shape: the same form finds the fixture's one line" "$(yn [ "$n_fix" = 1 ])"
    done
    check "control: ynnot reports no on a passing command" "$(yn [ "$(ynnot true)" = no ])"
    # Change NTJ: the fourth shape, PYB: a Python call without -I -B (the word
    # followed by whitespace and an option or a .py path, outside a comment,
    # and not by " -I -B"). The word is built from two halves, so that this
    # form's own text is no call.
    PYW=pyth
    PYW=${PYW}on3
    pyb_count() {
      awk -v w="$PYW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { r = substr(s, i + length(w)); if (r ~ /^[ \t]+(-|[^ \t]*[.]py([ \t"]|$))/ && r !~ /^ -I -B( |$)/) { n++; break }; s = r }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "$PYW -c x" "$PYW -I -B -c x" "# $PYW -c x" "command -v $PYW" "$PYW tool.py" >"$B/pyb-fixture"
    n_self=$(pyb_count "$SELF")
    n_fix=$(pyb_count "$B/pyb-fixture")
    echo "command: pyb_count <this script>, and the same over a fixture of five lines: a call with -c, one with -I -B -c, a comment, a command -v, a call of a .py path"
    echo "  shape PYB: in this script $n_self; in the fixture $n_fix"
    check "PYB: this script holds none (change NTJ)" "$(yn [ "$n_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's two calls without -I -B and not its other three lines" "$(yn [ "$n_fix" = 2 ])"
    
    echo
    echo "## the phase's commits by role, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    BASE=$(by_subject 'M8 part 1 close-out record: the push, the CI run and the scan')
    DOC=$(by_subject "M8 part 2 P1: commit planning docs (the spec, the part 2 block, part 1's close-out verification)")
    CODE=$(by_subject 'M8 part 2 P1: an insertion or deletion unshares a shared formula group it cuts')
    echo "command: git log --format=%H -n 1 -F --grep=<the role's subject>, for each role"
    echo "  part 1's close-out record commit (the base): ${BASE:-none}"
    echo "  the doc commit: ${DOC:-none}"
    echo "  the code commit, the phase commit (the unshare and the translator): ${CODE:-none}"
    echo "command: git rev-parse <phase commit>~0 to <phase commit>~2"
    for k in 0 1 2; do git rev-parse "$C~$k"; done | sed 's/^/    /'
    # Change WA: the code commit, the doc commit and the base, each the next's
    # child.
    roles_in_order() {
      local r k=0
      for r in "$CODE" "$DOC" "$BASE"; do
        [ -n "$r" ] || return 1
        [ "$(git rev-parse "$C~$k")" = "$r" ] || return 1
        k=$((k + 1))
      done
    }
    check "the code commit, the doc commit and the base, each the next's child, the code commit the phase commit (change WA)" "$(yn roles_in_order)"
    roles_ctl() { local CODE=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit named as the phase commit (change WA)" "$(ynnot roles_ctl)"
    roles_ctl2() { local DOC=$BASE BASE=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit and the base swapped (change WA)" "$(ynnot roles_ctl2)"
    roles_ctl3() { local BASE=; roles_in_order; }
    check "control: roles_in_order refuses a role that resolved to nothing" "$(ynnot roles_ctl3)"
    echo "  the phase commit given to this script: $C"
    echo "  git rev-parse HEAD at this run:        $(git rev-parse HEAD)"
    echo "  the controls' commits: the null commit $NULL_SHA; the fabricated commit $FAKE_SHA (the given one, its last hex digit changed); the short sha $SHORT"
    check "the phase commit given to this script is a full sha" "$(yn full_sha "$C")"
    check "the phase commit given to this script is HEAD" "$(yn head_is "$C")"
    check "the phase commit is the code commit, by its subject (change WA)" "$(yn [ "$CODE" = "$C" ])"
    check "control: the same comparison refuses the doc commit" "$(ynnot [ "$DOC" = "$C" ])"
    check "control: the same comparison refuses the base" "$(ynnot [ "$BASE" = "$C" ])"
    check "control: the same comparison refuses the null commit" "$(ynnot given_ok "$NULL_SHA")"
    check "control: the same comparison refuses a fabricated commit" "$(ynnot given_ok "$FAKE_SHA")"
    check "control: the same comparison refuses a short sha of the real commit" "$(ynnot given_ok "$SHORT")"
    short_names_head() { [ "$(git rev-parse "$SHORT")" = "$(git rev-parse HEAD)" ]; }
    check "control: the short sha is the real commit's, so only its form is refused" "$(yn short_names_head)"
    echo "phase: Milestone 8 part 2 P1 ($SPEC) run.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then
      echo "rerun: $RERUN_NOTE"
      echo "command: sha256sum and wc -c over each superseded attempt named above, with the directory it is kept in"
      for sf in ${RERUN_FILES:-}; do
        if [ -f "$sf" ]; then
          printf '    %s  %s bytes  %s  kept in %s\n' "$(sha256sum "$sf" | cut -d' ' -f1)" "$(wc -c <"$sf")" "$(basename "$sf")" "$(dirname "$sf")"
        else
          printf '    NO HASH EXISTS for %s: the file is not there at run time (named in %s)\n' "$(basename "$sf")" "$(dirname "$sf")"
        fi
      done
      if [ -z "${RERUN_FILES:-}" ]; then echo "    RERUN_FILES was not set, so no attempt above is hashed by this run"; fi
    fi
    # Change WG: ruling F's RERUN_NOTE requirement (TZ) is not this phase's;
    # every file RERUN_FILES names is there.
    rerun_files_there() {
      local sf
      for sf in ${RERUN_FILES:-}; do [ -f "$sf" ] || return 1; done
    }
    echo "  logged run: $LOGGED; RERUN_NOTE set: $([ -n "${RERUN_NOTE:-}" ] && echo yes || echo no); files RERUN_FILES names: $(set -- ${RERUN_FILES:-}; echo $#)"
    check "every file RERUN_FILES names is there (changes TZ and WG)" "$(yn rerun_files_there)"
    rerun_files_ctl() { local RERUN_FILES="$MAIN/no-such-file-wg"; rerun_files_there; }
    check "control: the same check refuses a file that is not there" "$(ynnot rerun_files_ctl)"
    n_cargo=$(pgrep -x cargo | wc -l)
    n_rustc=$(pgrep -x rustc | wc -l)
    echo "SERIALIZED: no other log run was in flight; cargo processes at entry: $n_cargo; rustc processes at entry: $n_rustc; this run builds the two size probes alone, after the corpus runs (change WF; the gate built the release binaries)"
    no_build_running() { [ "$((n_cargo + n_rustc))" = 0 ]; }
    check "no cargo or rustc process was running at entry" "$(yn no_build_running)"
    echo "DETACHED: no interactive call waits on this run; stdout and stderr go to a file, polled from later calls."
    echo "SETTINGS CHOSEN BEFORE THE RUN, never tuned during it: every run --label host --timeout $TIMEOUT_S --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S, the runner's default memory; the i686 label, the scale tiers and the openpyxl comparison are not run, and no Excel run (specs/0048 \"Harness runs\" P1); the probes built with --profile size --target i686-unknown-linux-musl (change WF)"
    echo "root: <repo> stands for the repository's top level (inside <home>, scrubbed after the corpus's paths); scripts/counting.sh, tools/emend-copy/src/main.rs, the spec, the size record and the records read are taken from it at the phase commit by git show; scripts/passthrough-run.sh and scripts/passthrough-record.py are run from it, each checked equal to the phase commit's (the runner sources scripts/lo-check.sh, checked too); the probes are built from it; nothing is installed into it (change WE)"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m8p2-p1 on the disk, the phase's directory; <phase>/gen holds the generator that wrote this script and <phase>/model the template it was written from"
    echo "root: <scratch> stands for <phase>, the phase's directory, named <scratch> where TMPDIR is concerned: TMPDIR is <scratch>/tmp (a dry run's RUN_TMPDIR otherwise, change TQ), made and exported by this script before any mktemp, and <work> is made under it"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory; this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (the counting library, the binaries' copies <work>/bin, the record pairs, kept there and installed nowhere, <work>/records, the runs' TMPDIR <work>/tmp-run, the earlier records read at the phase commit <work>/prev, the checks' programs and outputs), kept after the run and never removed"
    echo "root: <target> stands for <phase>/target on the disk, the phase's one target root: the gate built the release binaries into <target>/main/release"
    echo "root: <probes> stands for the probes' build root, <target>/main unless RUN_PROBE_TARGET names a dry run's own (change WF); the probes are built under <probes>/i686-unknown-linux-musl/size"
    echo "root: <corpus> stands for the private corpus directory unless RUN_CORPUS names a fictional one for a dry run (its manifest.tsv and the inputs under <corpus>/corpus, read by the runner)"
    echo "root: <runs> stands for the corpus run directories' parent, <corpus>/runs unless RUN_OUT_ROOT names another for a dry run; this log's run directories <runs>/$RUN-<name> are written there"
    echo "root: <source> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change WA)"
    echo "root: <stage> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change WA)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
      local a b all=("$SELF_DIR" "$BUILD_ROOT" "$MAIN" "$CORPUS" "$TMPDIR")
      [ "$PROBE_TARGET" = "$BUILD_ROOT" ] || all+=("$PROBE_TARGET")
      for a in "${all[@]}"; do for b in "${all[@]}"; do
        [ "$a" = "$b" ] && continue
        apart "$a" "$b" || return 1
      done; done
    }
    check "the roots other than <home>, <phase>, <work> and <runs> are distinct, none inside another (TMPDIR, <scratch>/tmp, among them)" "$(yn roots_distinct)"
    work_in_tmpdir() { case "$B/" in "$TMPDIR/"*) return 0 ;; esac; return 1; }
    check "<work>, the directory mktemp -d made, is under TMPDIR, <scratch>/tmp" "$(yn work_in_tmpdir)"
    work_ctl() { local B=/tmp/x; work_in_tmpdir; }
    check "control: the same test refuses a working directory under /tmp" "$(ynnot work_ctl)"
    # Every mktemp call of this script is checked under TMPDIR, so the source is
    # read for its calls outside comments; the call's text is built from
    # pieces, so this form's own text is no call.
    MKW='$('
    MKW=${MKW}mkt
    MKW=${MKW}emp
    count_tempcalls() {
      awk -v w="$MKW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { n++; s = substr(s, i + length(w)) }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "A=$MKW -d)" "F=$MKW)" "# $MKW -d)" >"$B/mktemp-fixture"
    n_mk=$(count_tempcalls "$SELF")
    n_mk_fix=$(count_tempcalls "$B/mktemp-fixture")
    echo "command: count_tempcalls <this script>, and the same over a fixture of three lines: a directory call, a file call, a comment"
    echo "  mktemp calls in this script outside comments: $n_mk (the one that makes <work>, checked under TMPDIR above); in the fixture: $n_mk_fix"
    check "this script makes one mktemp call, <work>'s, and no plain temporary file" "$(yn [ "$n_mk" = 1 ])"
    check "control: the same count finds the fixture's two calls and not its comment" "$(yn [ "$n_mk_fix" = 2 ])"
    runs_apart() { apart "$RUN_OUT_ROOT" "$MAIN" && apart "$RUN_OUT_ROOT" "$SELF_DIR"; }
    check "<runs> lies outside <repo> and <scripts>" "$(yn runs_apart)"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs, planning's modified specs/0048) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    ours_ctl() { printf ' M scripts/check.sh\n' | LC_ALL=C "$G" -qE "$OURS"; }
    check "control: the phase's status pattern refuses a modified gate file" "$(ynnot ours_ctl)"
    ours_rec_ctl() { printf '?? records/logs/m8p2-p1/run.log\n M specs/0048-the-two-refusals.md\n?? records/m8p2-delete-rows-%s-%s.md\n?? records/m8p1-delete-rows-%s-%s.txt\n?? records/logs/m8p1-p2/run.log\n?? records/logs/m8p2-p2/run.log\n M ROADMAP.md\n M specs/0047-harness-findings.md\n M scripts/passthrough-record.py\n' "$DATE" "$SHORT" "$DATE" "$SHORT" | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern admits this phase's log and planning's specs/0048 alone; it refuses a record file of this commit or another phase, another phase's log, ROADMAP.md, another spec and a source file (changes WA and WE)" "$(yn [ "$(ours_rec_ctl)" = 2 ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources (the phase commit's, by git show)"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## the scripts, against the phase commit, and planning's uncommitted spec"
    tree_is_commit() { [ "$(sha_of "$1")" = "$(git show "$C:$1" | sha256sum | cut -d' ' -f1)" ]; }
    for s in scripts/passthrough-run.sh scripts/passthrough-record.py scripts/lo-check.sh; do
      check "$s in the main tree is the phase commit's (sha256 $(sha_of "$s"))" "$(yn tree_is_commit "$s")"
    done
    tree_ctl() { [ "$(git show "$C:scripts/lo-check.sh" | sha256sum | cut -d' ' -f1)" = "$(sha_of scripts/passthrough-run.sh)" ]; }
    check "control: the same hash comparison tells two different scripts apart" "$(ynnot tree_ctl)"
    spec_now=$(sha_of "$SPEC")
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    echo "command: git show <phase commit>:$SPEC | sha256sum; sha256sum $SPEC (the working file: with PLANNING_SPEC set, planning's copy at that hash; unset, the phase commit's; change WA)"
    echo "  at the phase commit: $spec_committed; the pin: $SPEC_WANT"
    echo "  the working tree's copy: sha256 $spec_now"
    spec_ok() { [ "$spec_committed" = "$SPEC_WANT" ]; }
    check "the spec at the phase commit is at the pinned hash, the doc commit's blob" "$(yn spec_ok)"
    spec_ctl() { local spec_committed=1111111111111111111111111111111111111111111111111111111111111111; spec_ok; }
    check "control: the same check refuses the spec against another hash" "$(ynnot spec_ctl)"
    echo "input: PLANNING_SPEC: ${PLANNING_SPEC:-unset} (the working spec's sha256 when planning gives one; change WA)"
    # Change WA: set, the working spec hashes to it; unset, the working spec is
    # the phase commit's.
    working_ok() {
      if [ -n "$PLANNING_SPEC" ]; then [ "$spec_now" = "$PLANNING_SPEC" ]; else [ "$spec_now" = "$spec_committed" ]; fi
    }
    check "the working spec is the file PLANNING_SPEC names, or the phase commit's when it is unset (change WA)" "$(yn working_ok)"
    working_ctl() { local PLANNING_SPEC=1111111111111111111111111111111111111111111111111111111111111111; working_ok; }
    check "control: the same comparison refuses another hash named as PLANNING_SPEC" "$(ynnot working_ctl)"
    working_unset_ctl() { local PLANNING_SPEC= spec_now=1111111111111111111111111111111111111111111111111111111111111111; working_ok; }
    check "control: with PLANNING_SPEC unset, the same comparison refuses a working copy that is not the phase commit's" "$(ynnot working_unset_ctl)"
    echo "command: podman image exists $IMAGE"
    check "the pinned LibreOffice image is there" "$(yn podman image exists "$IMAGE")"
    
    echo
    echo "## TMPDIR for the corpus runs, on the disk (part 6 P4's change LG)"
    dev_tmp=$(stat -c %d "$RUNTMP")
    dev_corpus=$(stat -c %d "$CORPUS/corpus")
    dev_proc=$(stat -c %d /proc)
    echo "command: stat -c %d <work>/tmp-run <corpus>/corpus /proc"
    echo "  device of TMPDIR (<work>/tmp-run): $dev_tmp; of the corpus directory (<corpus>/corpus): $dev_corpus; of /proc (the control): $dev_proc"
    check "TMPDIR for the corpus runs and the corpus directory are on one device" "$(yn [ "$dev_tmp" = "$dev_corpus" ])"
    dev_ctl() { if [ "$dev_proc" = "$dev_corpus" ]; then return 1; else return 0; fi; }
    check "control: the same comparison tells /proc's device from the corpus directory's" "$(yn dev_ctl)"
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 1. the binaries: the gate's release builds, copied into <work>/bin (change RV)"
    echo "command: cp <target>/main/release/<name> <work>/bin/<name>, for emend-copy and xlsx-diff (done before the log began); sha256sum each; the gate log's line for each, read by sed"
    bins_ok=yes
    for b in emend-copy xlsx-diff; do
      have=$(sha_of "$B/bin/$b")
      orig=$(sha_of "$RELEASE_DIR/$b")
      logged=$(sed -n "s#^  <target>/main/release/$b: sha256 \\([0-9a-f]\\{64\\}\\), bytes [0-9]*\$#\\1#p" "$GATE_LOG")
      n_logged=$(printf '%s\n' "$logged" | awk 'NF' | wc -l)
      echo "  <work>/bin/$b: sha256 $have, bytes $(stat -c %s "$B/bin/$b"); <target>/main/release/$b: sha256 $orig; the gate log's line: ${logged:-none} (lines $n_logged)"
      bin_ok() { [ "$n_logged" = 1 ] && [ "$have" = "$logged" ] && [ "$have" = "$orig" ]; }
      if bin_ok; then :; else bins_ok=no; fi
      check "$b: the copy is the gate's release binary, by the one line the gate log prints for it (change RV)" "$(yn bin_ok)"
    done
    bin_ctl() { local have=1111111111111111111111111111111111111111111111111111111111111111; bin_ok; }
    check "control: the same comparison refuses another hash" "$(ynnot bin_ctl)"
    if [ -x "$MAIN/target/release/emend-copy" ]; then
      stale_n=$("$MAIN/target/release/emend-copy" 2>&1 </dev/null | LC_ALL=C "$G" -o -E -- '--[a-z0-9-]*-sample' | count_lines /dev/stdin)
      echo "  <repo>/target/release/emend-copy: there, built $(date -u -r "$MAIN/target/release/emend-copy" +%Y-%m-%d), its usage text names $stale_n flags ending in -sample; NOT USED by this log"
    else
      echo "  <repo>/target/release/emend-copy: not there; NOT USED by this log"
    fi
    if [ "$bins_ok" != yes ]; then
      echo "STOPPED: a binary is not the gate's; no run is made"
      exec 1>&3
      wait "$SCRUB_PID" 2>/dev/null
      exit 1
    fi
    
    echo
    echo "## 2. the flag list, from the binary's own usage text (change RW, kept)"
    echo "command: <work>/bin/emend-copy (no argument): exit $USAGE_RC; grep -o -E -- '--[a-z0-9-]*-sample' over its output, in order"
    n_usage=$(count_lines "$B/usage.flags")
    n_usage_u=$(LC_ALL=C sort -u "$B/usage.flags" | count_lines /dev/stdin)
    awk '{ print "    " NR ". " $0 }' "$B/usage.flags"
    echo "  the usage text's flags ending in -sample: $n_usage; distinct: $n_usage_u"
    check "the binary's usage error exits 2 (EXIT_ERROR)" "$(yn [ "$USAGE_RC" = 2 ])"
    check "every flag the usage text names is named once" "$(yn [ "$n_usage" = "$n_usage_u" ])"
    git show "$C:tools/emend-copy/src/main.rs" | awk '/^const USAGE: &str = /, /";$/' | LC_ALL=C "$G" -o -E -- '--[a-z0-9-]*-sample' >"$B/usage-src.flags"
    echo "command: git show <phase commit>:tools/emend-copy/src/main.rs, the USAGE constant's lines (awk from 'const USAGE' to the line ending '\";'), the same grep: $(count_lines "$B/usage-src.flags") flags"
    check "the binary's flags, in order, are the USAGE constant's at the phase commit" "$(yn cmp -s "$B/usage.flags" "$B/usage-src.flags")"
    head -n -1 "$B/usage-src.flags" >"$B/c-usage.flags"
    check "control: the same comparison refuses the list less its last flag" "$(ynnot cmp -s "$B/usage.flags" "$B/c-usage.flags")"
    # Change WB: the four row and column samples, each named once in the usage
    # text; a logged run runs the four, a dry run the subset RUN_FLAGS names.
    four_named() { local f; for f in $P1_FLAGS; do [ "$(count_matches -xF "$f" "$B/usage.flags")" = 1 ] || return 1; done; }
    check "each of the four row and column samples is named once in the usage text (change WB)" "$(yn four_named)"
    four_ctl() { local P1_FLAGS="$P1_FLAGS --no-such-flag-sample"; four_named; }
    check "control: the same check refuses a flag the usage text does not name" "$(ynnot four_ctl)"
    n_run=$(count_lines "$B/run.flags")
    echo "  the flags run, in the usage text's order: $n_run"
    awk '{ print "    " NR ". " $0 }' "$B/run.flags"
    if [ "$LOGGED" = yes ]; then
      check "the flags run are the four row and column samples, in the usage text's order (change WB)" "$(yn [ "$(tr '\n' ' ' <"$B/run.flags")" = "$P1_FLAGS " ])"
    else
      echo "  RUN_FLAGS (a dry run): $n_run of the four run; the set is not judged"
    fi
    order_kept() { [ "$(LC_ALL=C "$G" -n -x -F -f "$B/run.flags" "$B/usage.flags" | cut -d: -f2 | tr '\n' ' ')" = "$(tr '\n' ' ' <"$B/run.flags")" ]; }
    check "the flags run keep the usage text's order" "$(yn order_kept)"
    
    
    # ---------------------------------------------------------------------------
    # The helpers of the runs and the comparison. Outcome counts of a summary,
    # by the outcome column found by its header name: "error 1 ok 26 " and so
    # on, one pair per outcome, sorted.
    outcome_counts() { awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "outcome") o = i; next } o { n[$o]++ } END { for (k in n) print k, n[k] }' "$1" | LC_ALL=C sort | tr '\n' ' '; }
    # run_field <run.host.tsv> <column>: the one run row's value of the column,
    # found by its header name.
    run_field() { awk -F'\t' -v c="$2" 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == c) k = i; next } k { print $k }' "$1"; }
    # Change TF: triples <table>: the host rows of a record's .txt first table
    # (its lines up to the first blank line) or of a summary.host.tsv, as
    # "id<TAB>outcome<TAB>lo<TAB>lo_in", sorted by id; an empty lo or lo_in
    # cell reads "-".
    triples() { awk -F'\t' -v OFS='\t' 'NR == 1 { for (i = 1; i <= NF; i++) k[$i] = i; next } $0 == "" { exit } $k["label"] == "host" { l = $k["lo"]; li = $k["lo_in"]; print $k["id"], $k["outcome"], (l == "" ? "-" : l), (li == "" ? "-" : li) }' "$1" | LC_ALL=C sort; }
    # compare_ids <earlier triples> <now triples> <out>: one line per id of
    # either, "same|changed|missing|new<TAB>id<TAB>then<TAB>now", each triple
    # written outcome/lo/lo_in, "-" for the side that lacks the id.
    compare_ids() { awk -F'\t' -v OFS='\t' 'FNR == NR { t[$1] = $2 "/" $3 "/" $4; next } { n[$1] = $2 "/" $3 "/" $4 } END { for (i in t) { if (!(i in n)) print "missing", i, t[i], "-"; else if (t[i] == n[i]) print "same", i, t[i], n[i]; else print "changed", i, t[i], n[i] } for (i in n) if (!(i in t)) print "new", i, "-", n[i] }' "$1" "$2" | LC_ALL=C sort -k2,2 >"$3"; }
    kind_count() { awk -F'\t' -v k="$2" '$1 == k { n++ } END { print n + 0 }' "$1"; }
    # new_bad <comparison>: the new ids whose triple is not ok/ok/ok.
    new_bad() { awk -F'\t' '$1 == "new" && $4 != "ok/ok/ok" { n++ } END { print n + 0 }' "$1"; }
    printf 'id\tlabel\toutcome\tidentical\tlo\tlo_in\nw1\thost\tok\t3\tok\tok\nw2\thost\terror\t0\t\tok\nw3\thost\tok\t4\tfail\tok\nw1\ti686\tok\t3\tok\tok\n\nid\tother\nw9\thost\n' >"$B/c-then.tsv"
    printf 'id\tlabel\toutcome\tidentical\tlo\tlo_in\nw1\thost\tok\t3\tok\tok\nw3\thost\tok\t4\tok\tok\nw4\thost\tok\t1\tok\tok\nw5\thost\terror\t0\t\t\n\n' >"$B/c-now.tsv"
    triples "$B/c-then.tsv" >"$B/c-then.tri"
    triples "$B/c-now.tsv" >"$B/c-now.tri"
    compare_ids "$B/c-then.tri" "$B/c-now.tri" "$B/c-cmp"
    check "control: outcome_counts reads a fixture by its header (error 1, ok 3, both labels)" "$(yn [ "$(head -n 5 "$B/c-then.tsv" | outcome_counts /dev/stdin)" = "error 1 ok 3 " ])"
    check "control: triples reads the host rows up to the first blank line, an empty cell as - (3 rows; w2 error/-/ok)" "$(yn [ "$(count_lines "$B/c-then.tri") $(awk -F'\t' '$1 == "w2" { print $2 "/" $3 "/" $4 }' "$B/c-then.tri")" = "3 error/-/ok" ])"
    cmp_ctl() { [ "$(kind_count "$B/c-cmp" same) $(kind_count "$B/c-cmp" changed) $(kind_count "$B/c-cmp" missing) $(kind_count "$B/c-cmp" new) $(new_bad "$B/c-cmp")" = "1 1 1 2 1" ]; }
    check "control: compare_ids over the two fixtures finds w1 the same, w3 changed, w2 missing, w4 and w5 new, and w5 the one new id not ok/ok/ok (TF)" "$(yn cmp_ctl)"
    # Change TE: the records at the phase commit whose first line is a step0
    # passthrough run's title, indexed by path, tool arguments ("none" when the
    # line is absent or says none) and record time.
    git grep -E '^(# step0 passthrough run |- Tool arguments: |- Record written: )' "$C" -- 'records/*.md' | sed "s#^$C:##" \
      | awk 'match($0, /[.]md:/) { p = substr($0, 1, RSTART + 2); r = substr($0, RSTART + 4); if (r ~ /^# step0 passthrough run /) s[p] = 1; else if (r ~ /^- Tool arguments: /) t[p] = substr(r, 19); else if (r ~ /^- Record written: /) w[p] = substr(r, 19) } END { for (p in s) if (p in w) print p "\t" ((p in t) ? t[p] : "none") "\t" w[p] }' \
      | LC_ALL=C sort >"$B/rec-index.tsv"
    # pick_record <arguments>: the indexed record whose tool arguments are
    # exactly these, its name carrying no -scale-<tier>-, with the greatest
    # record time.
    pick_record() { awk -F'\t' -v f="$1" '$2 == f && $1 !~ /-scale-[a-z]-/ { if ($3 > best) { best = $3; p = $1 } } END { print p }' "$B/rec-index.tsv"; }
    printf 'records/a-x-2026-01-01-aaaaaaa.md\t--x-sample\t2026-01-01T00:00:00Z\nrecords/a-scale-b-x-2026-01-03-bbbbbbb.md\t--x-sample\t2026-01-03T00:00:00Z\nrecords/a-x-2026-01-02-ccccccc.md\t--x-sample --other\t2026-01-05T00:00:00Z\nrecords/z-x-2026-01-02-ddddddd.md\t--x-sample\t2026-01-02T00:00:00Z\nrecords/p-2026-01-04-eeeeeee.md\tnone\t2026-01-04T00:00:00Z\n' >"$B/c-index.tsv"
    pick_ctl() { local B=$B/c; mkdir -p "$B" && cp "${B%/c}/c-index.tsv" "$B/rec-index.tsv" && [ "$(pick_record --x-sample)" = records/z-x-2026-01-02-ddddddd.md ] && [ "$(pick_record none)" = records/p-2026-01-04-eeeeeee.md ]; }
    check "control: pick_record takes the latest record time, not the last name, refuses tool arguments that are not exactly the flag, leaves a -scale-<tier>- name out, and reads none for the passthrough (TE)" "$(yn pick_ctl)"
    echo "  the step0-titled records at the phase commit with a record time, indexed: $(count_lines "$B/rec-index.tsv")"
    check "the index holds records" "$(yn [ "$(count_lines "$B/rec-index.tsv")" -gt 0 ])"
    # prev_of <name>: the earlier record of the run, part 1 P2's (change WC).
    prev_of() { printf 'records/m8p1-%s-%s.md\n' "$1" "$PREV_TAG"; }
    check "control: prev_of names part 1 P2's record for delete-rows and insert-columns (WC)" "$(yn [ "$(prev_of delete-rows) $(prev_of insert-columns)" = "records/m8p1-delete-rows-$PREV_TAG.md records/m8p1-insert-columns-$PREV_TAG.md" ])"
    # Change WD: classify <comparison> <name>: each line of compare_ids's
    # output, prefixed by its class against the expected-change table of
    # specs/0048 "Harness runs" P1: met or not (a pair of the table: the triple
    # EXPECT_THEN then, EXPECT_NOW now), same, changed, missing and new. The
    # pairs are read from EXPECTED_PAIRS, space-separated, at the call.
    classify() {
      awk -F'\t' -v OFS='\t' -v name="$2" -v ex=" $EXPECTED_PAIRS " -v want_then="$EXPECT_THEN" -v want_now="$EXPECT_NOW" '
        { kind = $1; id = $2; th = $3; nw = $4; cls = kind
          if (index(ex, " " name ":" id " ") > 0) {
            cls = (kind == "changed" && th == want_then && nw == want_now) ? "met" : "not"
          }
          print cls, kind, id, th, nw }' "$1"
    }
    cls_count() { awk -F'\t' -v k="$2" '$1 == k { n++ } END { print n + 0 }' "$1"; }
    # The fixture: a pair of the table as expected; an unchanged id, a changed
    # one, a missing one and a new one; then the line each control adds.
    printf '%s\n' "changed${TAB}aaaaaaaaaaa1${TAB}error/-/ok${TAB}ok/ok/ok" "same${TAB}bbbbbbbbbbb2${TAB}ok/ok/ok${TAB}ok/ok/ok" \
      "changed${TAB}ccccccccccc3${TAB}ok/ok/ok${TAB}ok/fail/ok" "missing${TAB}ddddddddddd4${TAB}ok/ok/ok${TAB}-" \
      "new${TAB}eeeeeeeeeee5${TAB}-${TAB}ok/ok/ok" >"$B/c-cls-base"
    cls_fixture() {
      local EXPECTED_PAIRS="x-rows:aaaaaaaaaaa1 x-rows:fffffffffff6" name=${2:-x-rows}
      { cat "$B/c-cls-base"; [ -n "$1" ] && printf '%s\n' "$1"; } >"$B/c-cls-in"
      classify "$B/c-cls-in" "$name" >"$B/c-cls-out"
      printf '%s %s %s %s %s %s\n' "$(cls_count "$B/c-cls-out" met)" "$(cls_count "$B/c-cls-out" not)" \
        "$(cls_count "$B/c-cls-out" same)" "$(cls_count "$B/c-cls-out" changed)" "$(cls_count "$B/c-cls-out" missing)" \
        "$(cls_count "$B/c-cls-out" new)"
    }
    cls_met() { [ "$(cls_fixture "changed${TAB}fffffffffff6${TAB}error/-/ok${TAB}ok/ok/ok")" = "2 0 1 1 1 1" ]; }
    cls_unchanged() { [ "$(cls_fixture "same${TAB}fffffffffff6${TAB}error/-/ok${TAB}error/-/ok")" = "1 1 1 1 1 1" ]; }
    cls_other() { [ "$(cls_fixture "changed${TAB}fffffffffff6${TAB}error/-/ok${TAB}ok/fail/ok")" = "1 1 1 1 1 1" ]; }
    cls_sample() { [ "$(cls_fixture "" y-columns)" = "0 0 1 2 1 1" ]; }
    check "classify: a pair of the table error/-/ok to ok/ok/ok is met; one each of same, changed, missing and new (change WD)" "$(yn cls_met)"
    check "control: classify refuses a pair of the table unchanged (change WD)" "$(yn cls_unchanged)"
    check "control: classify refuses a pair of the table changed to another triple, lo fail (change WD)" "$(yn cls_other)"
    check "control: outside its sample a pair's id is a plain change, not met (change WD)" "$(yn cls_sample)"
    
    # ---------------------------------------------------------------------------
    echo
    echo "## the expected-change table (change WD)"
    echo "  the pairs specs/0048 \"Harness runs\" P1 names, each $EXPECT_THEN to $EXPECT_NOW: $EXPECTED_PAIRS"
    # The spec's sentence at the phase commit, its lines folded to single spaces.
    git show "$C:$SPEC" | tr '\n' ' ' | tr -s ' ' >"$B/spec-folded.txt"
    SPEC_PAIRS_TEXT='delete-rows 90a5b01f9541 and delete-columns 91d2bdffa46a each error 2 - ok to ok 0 ok ok, nothing else changed'
    echo "command: git show <phase commit>:$SPEC, folded to single spaces; the count of the sentence: $SPEC_PAIRS_TEXT"
    n_spec_pairs=$(count_matches -F "$SPEC_PAIRS_TEXT" "$B/spec-folded.txt")
    echo "  found: $n_spec_pairs"
    check "the spec at the phase commit names the two pairs and nothing else changed, once (change WD)" "$(yn [ "$n_spec_pairs" = 1 ])"
    spec_pairs_ctl() { [ "$(count_matches -F "${SPEC_PAIRS_TEXT/90a5b01f9541/000000000000}" "$B/spec-folded.txt")" = 0 ]; }
    check "control: the same count reads none for the sentence with an id replaced" "$(yn spec_pairs_ctl)"
    pair_triple() { git show "$C:records/m8p1-${1%%:*}-$PREV_TAG.txt" | triples /dev/stdin | awk -F'\t' -v i="${1#*:}" '$1 == i { print $2 "/" $3 "/" $4 }'; }
    n_pairs_then=0
    for p in $EXPECTED_PAIRS; do
      got=$(pair_triple "$p")
      echo "    $p in records/m8p1-${p%%:*}-$PREV_TAG.txt: ${got:-none} (the table's: $EXPECT_THEN)"
      if [ "$got" = "$EXPECT_THEN" ]; then n_pairs_then=$((n_pairs_then + 1)); fi
    done
    check "each pair's triple in part 1 P2's record is the table's, $EXPECT_THEN (2 pairs; change WD)" "$(yn [ "$n_pairs_then" = 2 ])"
    check "control: pair_triple reads a pair whose id the record lacks as none" "$(yn [ -z "$(pair_triple delete-rows:000000000000)" ])"
    pair_ok_ctl() { [ "$(pair_triple insert-rows:90a5b01f9541)" = "$EXPECT_THEN" ]; }
    check "control: the same id in another sample's record (insert-rows) is not $EXPECT_THEN" "$(ynnot pair_ok_ctl)"
    n_met=0
    : >"$B/expected-table.tsv"
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 4 and 5. the four samples on the host, one run each, recorded into <work>/records and compared per id (changes TD, TF, WB, WC, WD and WE)"
    n_want_rows=$(awk 'NR > 1' "$CORPUS/manifest.tsv" | wc -l)
    echo "  the workbooks each run takes: $n_want_rows (every manifest row)"
    while IFS= read -r f; do printf '%s\t%s\n' "$(name_of "$f")" "$f"; done <"$B/run.flags" >"$B/runs.tsv"
    n_runs_all=$(count_lines "$B/runs.tsv")
    n_done=0
    n_rec_done=0
    n_findings=0
    i=0
    # One run's checks read these, set before each is called: f (the flag),
    # name, rrc, RT, rt_rows, rt_commit, rt_args.
    rt_ok() { [ "$rt_rows" = 1 ] && [ "$rt_commit" = "$C" ] && [ "$rt_args" = "$want_args" ]; }
    rt_settings() { [ "$(run_field "$RT" timeout_s)" = "$TIMEOUT_S" ] && [ "$(run_field "$RT" lo_timeout_s)" = "$LO_TIMEOUT_S" ]; }
    rec_ran() { [ "$rrc" = 0 ] && [ ! -s "$B/record-$name.err" ]; }
    rec_header() {
      [ -f "$RECORDS/$STEM.txt" ] && [ "$(count_matches -xF "- Commit: $C" "$RECORDS/$STEM.md")" = 1 ] \
        && [ "$(count_matches -xF '- Targets: host' "$RECORDS/$STEM.md")" = 1 ] \
        && [ "$(count_matches -xF "- Tool arguments: $rec_args" "$RECORDS/$STEM.md")" = 1 ]
    }
    finding() { echo "  FINDING: $1"; n_findings=$((n_findings + 1)); }
    while IFS="$TAB" read -r name f; do
      i=$((i + 1))
      O=$RUN_OUT_ROOT/$RUN-$name
      STEM=m8p2-p1-$name-$RUN
      ARGS=(--tool-arg "$f")
      want_args=$f
      rec_args=$f
      label=$f
      echo
      echo "### $i. $label into <runs>/$RUN-$name"
      echo "command: TMPDIR=<work>/tmp-run scripts/passthrough-run.sh --label host --passthrough <work>/bin/emend-copy --xlsx-diff <work>/bin/xlsx-diff --corpus <corpus> --out <runs>/$RUN-$name --timeout $TIMEOUT_S --libreoffice $IMAGE --lo-timeout $LO_TIMEOUT_S ${ARGS[*]}"
      started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      TMPDIR=$RUNTMP scripts/passthrough-run.sh --label host --passthrough "$PT" --xlsx-diff "$XD" --corpus "$CORPUS" --out "$O" \
        --timeout "$TIMEOUT_S" --libreoffice "$IMAGE" --lo-timeout "$LO_TIMEOUT_S" "${ARGS[@]}" \
        >"$B/run-$name.stdout" 2>"$B/run-$name.stderr" </dev/null
      rc=$?
      echo "  started $started; ended $(date -u +%Y-%m-%dT%H:%M:%SZ); exit $rc; stderr bytes: $(wc -c <"$B/run-$name.stderr")"
      sed 's/^/    /' "$B/run-$name.stdout"
      check "$label: the run exits 0" "$(yn [ "$rc" = 0 ])"
      check "$label: its stderr is empty" "$(yn [ ! -s "$B/run-$name.stderr" ])"
      n_left=$(find "$RUNTMP" -mindepth 1 | wc -l)
      echo "  entries left in <work>/tmp-run after the run: $n_left"
      check "$label: the runs' TMPDIR is empty after the run" "$(yn [ "$n_left" = 0 ])"
      SUM=$O/summary.host.tsv
      RT=$O/run.host.tsv
      if [ ! -f "$SUM" ] || [ ! -f "$RT" ]; then
        check "$label: the run directory holds summary.host.tsv and run.host.tsv" "no"
        continue
      fi
      rows=$(awk 'NR > 1' "$SUM" | wc -l)
      echo "  summary.host.tsv: rows $rows; outcomes: $(outcome_counts "$SUM")"
      check "$label: the summary holds one row per workbook ($n_want_rows)" "$(yn [ "$rows" = "$n_want_rows" ])"
      rt_rows=$(awk 'NR > 1' "$RT" | wc -l)
      rt_commit=$(run_field "$RT" commit)
      rt_args=$(run_field "$RT" tool_args)
      echo "  run.host.tsv: run rows $rt_rows; commit $rt_commit; tool_args ${rt_args:-(empty)}; timeout_s $(run_field "$RT" timeout_s); lo_timeout_s $(run_field "$RT" lo_timeout_s); memory_mib $(run_field "$RT" memory_mib)"
      check "$label: run.host.tsv holds one run row naming the phase commit and the flag alone" "$(yn rt_ok)"
      check "$label: run.host.tsv names the settings given (timeout $TIMEOUT_S, lo timeout $LO_TIMEOUT_S)" "$(yn rt_settings)"
      n_done=$((n_done + 1))
      echo "command: python3 -I -B scripts/passthrough-record.py --run <runs>/$RUN-$name --out <work>/records --stem $STEM --allow-single"
      python3 -I -B scripts/passthrough-record.py --run "$O" --out "$RECORDS" --stem "$STEM" --allow-single >"$B/record-$name.out" 2>"$B/record-$name.err" </dev/null
      rrc=$?
      echo "  exit: $rrc; stdout:"; sed 's/^/    /' "$B/record-$name.out"
      echo "  stderr bytes: $(wc -c <"$B/record-$name.err")"
      check "$label: the record script exits 0, its stderr empty" "$(yn rec_ran)"
      check "$label: the record pair is there, its .md naming the phase commit on its Commit: line, the host alone and the tool arguments $rec_args" "$(yn rec_header)"
      if [ ! -f "$RECORDS/$STEM.txt" ]; then continue; fi
      echo "  record (kept in <work>/records, installed nowhere; change WE): $STEM.md sha256 $(sha_of "$RECORDS/$STEM.md"); $STEM.txt sha256 $(sha_of "$RECORDS/$STEM.txt")"
      n_rec_done=$((n_rec_done + 1))
      triples "$RECORDS/$STEM.txt" >"$B/now-$name.tri"
      triples "$SUM" >"$B/sum-$name.tri"
      check "$label: the record's host triples are the summary's" "$(yn cmp -s "$B/now-$name.tri" "$B/sum-$name.tri")"
      # Change WC: the earlier record, part 1 P2's.
      prev=$(prev_of "$name")
      picked=$(pick_record "$rec_args")
      echo "  the earlier record: $prev (change WC); the one the selection rule picks at the phase commit: ${picked:-none}"
      if [ "$picked" != "$prev" ]; then
        finding "$label: the selection rule picks ${picked:-no record}, not part 1 P2's $prev; part 1 P2's is compared (WC)"
      fi
      if git cat-file -e "$C:${prev%.md}.txt" 2>/dev/null; then :; else
        finding "$label: the earlier record ${prev%.md}.txt is not at the phase commit; nothing is compared"
        continue
      fi
      git show "$C:${prev%.md}.txt" >"$B/prev/$name.txt" || exit 2
      triples "$B/prev/$name.txt" >"$B/prev-$name.tri"
      compare_ids "$B/prev-$name.tri" "$B/now-$name.tri" "$B/cmp-$name.tsv"
      classify "$B/cmp-$name.tsv" "$name" >"$B/cls-$name.tsv"
      n_then=$(count_lines "$B/prev-$name.tri")
      n_same=$(kind_count "$B/cmp-$name.tsv" same)
      n_changed=$(kind_count "$B/cmp-$name.tsv" changed)
      n_missing=$(kind_count "$B/cmp-$name.tsv" missing)
      n_new=$(kind_count "$B/cmp-$name.tsv" new)
      echo "  compared with ${prev%.md}.txt per id (outcome/lo/lo_in of the host rows): earlier ids $n_then; the same $n_same; changed $n_changed; missing from this run $n_missing; new ids $n_new"
      n_met_here=0
      while IFS="$TAB" read -r cls kind id then_t now_t; do
        case $cls in
          met)
            n_met_here=$((n_met_here + 1))
            n_met=$((n_met + 1))
            echo "    expected (specs/0048 \"Harness runs\" P1): id $id: $then_t then, $now_t now" ;;
          not) finding "$label: id $id: outcome/lo/lo_in $then_t in ${prev##*/}, $now_t now, not the change specs/0048 names ($EXPECT_THEN to $EXPECT_NOW); recorded, not fixed" ;;
          changed) finding "$label: id $id: outcome/lo/lo_in $then_t in ${prev##*/}, $now_t now; recorded, not fixed" ;;
          missing)
            if [ "$LOGGED" = yes ]; then finding "$label: id $id of ${prev##*/} ($then_t) is not in this run"
            else echo "    a dry run: id $id of ${prev##*/} is not in the fictional corpus; not judged"; fi ;;
          new)
            if [ "$LOGGED" = yes ]; then finding "$label: id $id ($now_t) is not in ${prev##*/}"
            else echo "    a dry run: id $id ($now_t) is not in ${prev##*/}; printed"; fi ;;
        esac
      done <"$B/cls-$name.tsv"
      # A pair of the table whose id is not in this run's comparison at all.
      for p in $EXPECTED_PAIRS; do
        if [ "${p%%:*}" = "$name" ] && [ "$(awk -F'\t' -v i="${p#*:}" '$3 == i' "$B/cls-$name.tsv" | count_lines /dev/stdin)" = 0 ]; then
          if [ "$LOGGED" = yes ]; then finding "$label: the table's id ${p#*:} is in neither record"
          else echo "    a dry run: the table's id ${p#*:} is not in the fictional corpus; not judged"; fi
        fi
      done
      printf '%s\t%s\n' "$label" "$n_met_here" >>"$B/expected-table.tsv"
      if [ "$LOGGED" = yes ]; then
        check "$label: the earlier record holds 39 host rows, this run 39, and no id is new or missing (WG)" "$(yn [ "$n_then $rows $n_new $n_missing" = "39 39 0 0" ])"
      fi
      echo "  summary $label: earlier $n_then (same $n_same, changed $n_changed, missing $n_missing); new $n_new; the table's pairs met here $n_met_here; FINDING lines so far $n_findings"
    done <"$B/runs.tsv"
    echo
    echo "  runs done $n_done of $n_runs_all; record pairs written $n_rec_done; FINDING lines so far: $n_findings"
    check "every run was made, and its run directory holds its tables" "$(yn [ "$n_done" = "$n_runs_all" ])"
    check "every run was recorded" "$(yn [ "$n_rec_done" = "$n_runs_all" ])"
    echo "  the run directories, in the usage text's order:"
    n_dirs_there=0
    while IFS="$TAB" read -r name f; do
      if [ -d "$RUN_OUT_ROOT/$RUN-$name" ]; then n_dirs_there=$((n_dirs_there + 1)); st=there; else st=MISSING; fi
      printf '    <runs>/%s-%s %s\n' "$RUN" "$name" "$st"
    done <"$B/runs.tsv"
    echo "  run directories there: $n_dirs_there"
    check "one run directory per run is there" "$(yn [ "$n_dirs_there" = "$n_runs_all" ])"
    
    # ---------------------------------------------------------------------------
    echo
    echo "## the record pairs, kept in <work>/records and installed nowhere (change WE: P4 writes the part's records)"
    ls "$RECORDS" | LC_ALL=C sort >"$B/records.names"
    n_rec=$(count_lines "$B/records.names")
    want_rec=$((2 * n_runs_all))
    echo "  record files written in <work>/records: $n_rec; expected $want_rec (a pair per run)"
    sed 's/^/    /' "$B/records.names"
    check "the record files are the pairs expected" "$(yn [ "$n_rec" = "$want_rec" ])"
    if [ "$LOGGED" = yes ]; then
      check "the record files are 8 and the run directories 4 (WG)" "$(yn [ "$n_rec $n_dirs_there" = "8 4" ])"
    fi
    no_path() { [ "$(cat "$RECORDS/"* | count_matches -F "$HOME" /dev/stdin)" = 0 ] && [ "$(cat "$RECORDS/"* | count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' /dev/stdin)" = 0 ]; }
    check "no record file names <home>, a home, mount, temporary or corpus path" "$(yn no_path)"
    printf '%s%s%s\n' '/ho' 'me/someone/' 'emend-testing/corpus/x' >"$B/c-path"
    path_ctl() { [ "$(count_matches -E '(/home/|/mnt/|/Users/|/tmp/|emend-testing)' "$B/c-path")" = 1 ]; }
    check "control: the same form finds a planted path" "$(yn path_ctl)"
    no_record_in_tree() { [ "$(git status --porcelain -- records | count_matches -E '^[?][?] records/m8p2-' /dev/stdin)" = 0 ]; }
    check "no record file of this phase is in the repository's records/ (change WE)" "$(yn no_record_in_tree)"
    
    echo
    echo "## the expected-change table (specs/0048 \"Harness runs\" P1; changes WD and WG)"
    echo "  per run: the run, the table's pairs met in it:"
    sed 's/^/    /' "$B/expected-table.tsv"
    echo "  the table's pairs met: $n_met of 2"
    if [ "$LOGGED" = yes ]; then
      check "the two pairs of the table are met: delete-rows 90a5b01f9541 and delete-columns 91d2bdffa46a $EXPECT_THEN to $EXPECT_NOW (WG)" "$(yn [ "$n_met" = 2 ])"
    else
      echo "  a dry run: the totals are printed and not judged (WG)"
    fi
    met_ctl() { local n_met=1; [ "$n_met" = 2 ]; }
    check "control: the same total refuses one pair met" "$(ynnot met_ctl)"
    
    # ---------------------------------------------------------------------------
    echo
    echo "## 6. the rowcol probe's size-profile figure (specs/0048 \"Size\"; change WF)"
    # The record's probes table: the section bytes of a probe's row, the
    # second-to-last cell of a five-cell row under "## The probes".
    record_section() { awk -F ' [|] ' -v p="| \`$2\` | " '/^## The probes/ { on = 1; next } /^## / { on = 0 } on && index($0, p) == 1 && NF == 5 { print $4; exit }' "$1"; }
    git show "$C:$SIZE_RECORD" >"$B/size-record.md" || exit 2
    SR_ROWCOL=$(record_section "$B/size-record.md" probe-emend-rowcol-write-xml)
    SR_FORMAT=$(record_section "$B/size-record.md" probe-emend-format-write-xml)
    echo "command: git show <phase commit>:$SIZE_RECORD, its probes table's section bytes for the rowcol and format probes"
    echo "  the record's rowcol probe ${SR_ROWCOL:-none}; its format probe ${SR_FORMAT:-none}; the rowcol cost, the one less the other: $(( ${SR_ROWCOL:-0} - ${SR_FORMAT:-0} ))"
    sr_cost_ok() { [ -n "$SR_ROWCOL" ] && [ -n "$SR_FORMAT" ] && [ "$((SR_ROWCOL - SR_FORMAT))" = "$ROWCOL_COST_WANT" ]; }
    check "the record's rowcol cost is the spec's $ROWCOL_COST_WANT (change WF)" "$(yn sr_cost_ok)"
    check "control: record_section reads nothing for a probe the record does not name" "$(yn [ -z "$(record_section "$B/size-record.md" probe-emend-no-such-probe)" ])"
    printf '%s\n' '## The probes' '| `probe-x` | a description | 10 | 20 | 30 |' '## Movements' '| `probe-x` | 1 | 2 | 3 | 4 | 5 | code |' >"$B/c-size-record"
    check "control: record_section reads the probes table's row alone (20 in a planted record)" "$(yn [ "$(record_section "$B/c-size-record" probe-x)" = 20 ])"
    section_total() { size -A "$1" 2>/dev/null | awk '$1 == "Total" { print $2 }'; }
    n_findings_before=$n_findings
    while read -r pbin pfeat; do
      echo "command: (cd <repo> && CARGO_TARGET_DIR=<probes> cargo build -p size-probe --bin $pbin --features $pfeat --profile size --target i686-unknown-linux-musl)"
      ( cd "$MAIN" && CARGO_BUILD_JOBS=4 CARGO_TARGET_DIR=$PROBE_TARGET cargo build -p size-probe --bin "$pbin" --features "$pfeat" --profile size --target i686-unknown-linux-musl ) </dev/null >"$B/probe-$pbin.out" 2>&1
      prc=$?
      LC_ALL=C "$G" -a -E '^(warning|error)(\[|:)' "$B/probe-$pbin.out" | sed 's/^/    /'
      echo "  the build: exit $prc"
      check "$pbin: the size-profile build on i686 exits 0 (change WF)" "$(yn [ "$prc" = 0 ])"
    done <<'PROBES'
    probe-emend-rowcol-write-xml rowcol
    probe-emend-format-write-xml emend,xml
    PROBES
    ROWCOL_BIN=$PROBE_TARGET/i686-unknown-linux-musl/size/probe-emend-rowcol-write-xml
    FORMAT_BIN=$PROBE_TARGET/i686-unknown-linux-musl/size/probe-emend-format-write-xml
    rowcol_sections=$(section_total "$ROWCOL_BIN")
    format_sections=$(section_total "$FORMAT_BIN")
    echo "command: size -A <probes>/i686-unknown-linux-musl/size/<probe>, its Total line; sha256sum and wc -c of the same file, for each"
    for bin in "$ROWCOL_BIN" "$FORMAT_BIN"; do
      if [ -f "$bin" ]; then
        echo "  $bin: file $(wc -c <"$bin") bytes; sections $(section_total "$bin"); sha256 $(sha_of "$bin")"
      else
        echo "  $bin: not there"
      fi
    done
    probes_read() { [ -n "$rowcol_sections" ] && [ -n "$format_sections" ] && [ "$rowcol_sections" -gt 0 ] && [ "$format_sections" -gt 0 ]; }
    check "both section totals were read (change WF)" "$(yn probes_read)"
    check "control: section_total reads nothing from a file that is not there" "$(yn [ -z "$(section_total "$B/no-such-binary")" ])"
    # band_verdict <growth>: in, above-expected (accepted), outside or shrink.
    band_verdict() {
      if [ "$1" -lt 0 ]; then echo shrink
      elif [ "$1" -lt "$BAND_LOW" ]; then echo below
      elif [ "$1" -le "$BAND_HIGH" ]; then echo in
      elif [ "$1" -le "$BAND_ACCEPT" ]; then echo accepted
      else echo outside; fi
    }
    check "control: band_verdict reads -1 shrink, 2999 below, 3000 and 12000 in, 12001 and 16000 accepted, 16001 outside" "$(yn [ "$(band_verdict -1) $(band_verdict 2999) $(band_verdict 3000) $(band_verdict 12000) $(band_verdict 12001) $(band_verdict 16000) $(band_verdict 16001)" = "shrink below in in accepted accepted outside" ])"
    if probes_read; then
      rowcol_cost=$((rowcol_sections - format_sections))
      growth=$((rowcol_cost - ROWCOL_COST_WANT))
      verdict=$(band_verdict "$growth")
      echo "  the rowcol probe's sections $rowcol_sections; the format probe's $format_sections; the rowcol cost $rowcol_cost; Milestone 7 part 2's $ROWCOL_COST_WANT; the growth $growth; expected $BAND_LOW to $BAND_HIGH, accepted up to $BAND_ACCEPT: $verdict"
      case $verdict in
        in) echo "  the growth is in the expected band (specs/0048 \"Size\")" ;;
        accepted) echo "  the growth is above the expected band and within the accepted one (specs/0048 \"Size\"), told to planning" ;;
        *) finding "the rowcol cost's growth over Milestone 7 part 2's size record, $growth section bytes, is $verdict the band (expected $BAND_LOW to $BAND_HIGH, accepted up to $BAND_ACCEPT; specs/0048 \"Size\"); recorded, not fixed" ;;
      esac
    else
      finding "the probes' section totals were not read; the rowcol cost is not judged"
    fi
    echo "  FINDING lines of this section: $((n_findings - n_findings_before))"
    
    echo
    echo "## the FINDING lines of this log (specs/0043 ruling R)"
    echo "  FINDING lines printed above: $n_findings (each begins with the word FINDING; the comparisons and the size section print them, none is fixed)"
    
    echo
    echo "## status after the run"
    echo "command: git status --porcelain"
    git status --porcelain | sed 's/^/    /'
    st_all=$(run_lines git status --porcelain)
    st_ours=$(run_matches -E "$OURS" git status --porcelain)
    echo "  the working spec: $SPEC, sha256 $(sha_of "$SPEC")"
    echo "status lines: $st_all; of them this phase's logs or planning's spec: $st_ours"
    status_accounted() { [ "$st_all" != error ] && [ "$st_ours" != error ] && [ "$st_all" = "$st_ours" ]; }
    check "every change in the working tree is this phase's or planning's spec" "$(yn status_accounted)"
    echo
    echo "## this script's own standard error (specs/0017 P1 verification ruling 7)"
    nerr=$(wc -c <"$ERR")
    cp "$ERR" "$B/c-err"; printf 'x' >>"$B/c-err"
    nerr_ctl=$(wc -c <"$B/c-err")
    echo "  command: wc -c <scripts>/out/run.stderr: $nerr bytes; a copy with one byte appended: $nerr_ctl"
    check "this script wrote nothing to its standard error" "$(yn [ "$nerr" = 0 ])"
    check "control: the same count reads one byte more in the copy" "$(yn [ "$nerr_ctl" = "$((nerr + 1))" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "run log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exec 1>&3
    wait "$SCRUB_PID" 2>/dev/null
    exit "$fail"

## the shared counting library this log sources (the phase commit's, by git show)
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

