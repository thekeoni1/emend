    earlier_stat() { local n; for n in $EARLIER; do if [ -e "$STAGE_ROOT/$n" ]; then printf '%s %s\n' "$n" "$(stat -c '%F %s %Y' "$STAGE_ROOT/$n")"; else printf '%s absent\n' "$n"; fi; done; }
