    while IFS= read -r f; do
      case " $SAMPLES " in *" $(name_of "$f") "*) printf '%s\n' "$f" >>"$B/run.flags" ;; esac
    done <"$B/usage.flags"
    # The run directories and record files this log writes, each refused if it
