    echo "root: <repo> stands for the repository's top level (inside <home>, scrubbed after the corpus's paths); scripts/counting.sh, scripts/excel-check-list.py, scripts/excel-check-open.ps1, tools/emend-copy/src/main.rs, the spec and the records read are taken from it at the phase commit by git show; scripts/passthrough-run.sh, scripts/passthrough-record.py and scripts/edit-open-check.sh are run from it, each checked equal to the phase commit's (the runner sources scripts/lo-check.sh, checked too); the record pairs are installed into its records/ unless RUN_RECORDS_DEST names a dry run's directory (change ZC)"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m8p3-p1 on the disk, the phase's directory; <phase>/gen holds the generator that wrote this script and <phase>/model the templates it was written from"
    echo "root: <scratch> stands for <phase>, the phase's directory, named <scratch> where TMPDIR is concerned: TMPDIR is <scratch>/tmp (a dry run's RUN_TMPDIR otherwise, change TQ), made and exported by this script before any mktemp, and <work> is made under it"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory; this script's own standard error goes to <scripts>/out/run.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (the counting library, the binaries' copies <work>/bin, the record pairs before they are installed, <work>/records, the runs' TMPDIR <work>/tmp-run, the open check's TMPDIR <work>/tmp, the earlier records read at the phase commit <work>/prev, the list script's copy, the checks' programs and outputs), kept after the run and never removed"
    echo "root: <target> stands for <phase>/target on the disk, the phase's one target root: the gate built the release binaries into <target>/main/release, and the keep's test run builds into <target>/main (a dry run's RUN_BUILD_ROOT otherwise)"
    echo "root: <corpus> stands for the private corpus directory unless RUN_CORPUS names a fictional one for a dry run (its manifest.tsv and the inputs under <corpus>/corpus, read by the runner); the stage's parent is <corpus>/work unless STAGE_ROOT names another"
    echo "root: <runs> stands for <corpus>/runs, the corpus run directories' parent; this log's run directories <runs>/$RUN-<name> are written there, and the list takes the parent of <runs> as the corpus root"
    echo "root: <keep> stands for <phase>/keep-host on the disk, the host keep this run makes (a dry run's RUN_KEEP otherwise, read only with RUN_SKIP_KEEP=yes)"
    echo "root: <stage> stands for the list's stage, <corpus>/work/excel-check-m8-$DATE unless STAGE_ROOT names another parent for a dry run, made mode 700 by this run; <stage>.zip is the zip beside it; neither is committed"
    echo "root: <source> stands for a list row's source column (corpus, fixture or input) in the stage's layout files/<source>/<file> (specs/0016 P1 ruling 4), <file> the row's file column"
    echo "root: <id> stands for a directory of an earlier phase's log and appears in this log only in the printed script's carried history; this log reads and writes nothing under it (change WM)"
    apart() { case "$1/" in "$2"/*) return 1 ;; esac; case "$2/" in "$1"/*) return 1 ;; esac; return 0; }
    roots_distinct() {
