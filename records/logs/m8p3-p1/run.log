    check "control: roles_in_order refuses the base named as the phase commit (change WY)" "$(ynnot roles_ctl)"
    roles_ctl2() { local DOC=$BASE BASE=$DOC; roles_in_order; }
    check "control: roles_in_order refuses the doc commit and the base swapped (change WY)" "$(ynnot roles_ctl2)"
    roles_ctl3() { local BASE=; roles_in_order; }
