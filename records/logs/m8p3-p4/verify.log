    }
    printf '%s\n' "$PYW -c x" "$PYW -I -B -c x" "# $PYW -c x" "command -v $PYW" "$PYW tool.py" >"$B/pyb-fixture"
    n_self=$(pyb_count "$SELF")
    n_fix=$(pyb_count "$B/pyb-fixture")
    echo "command: pyb_count <this script>, and the same over a fixture of five lines: a call with -c, one with -I -B -c, a comment, a command -v, a call of a .py path"
    echo "  shape PYB: in this script $n_self; in the fixture $n_fix"
    check "PYB: this script holds none (change NTJ)" "$(yn [ "$n_self" = 0 ])"
    check "control: PYB: the same form finds the fixture's two calls without -I -B and not its other three lines" "$(yn [ "$n_fix" = 2 ])"
    
    echo
    echo "## the phase's commits and the tag, read from git"
    by_subject() { git log --format='%H' -n 1 -F --grep="$1"; }
    echo "phase: Milestone 8 part 3 P4 ($SPEC) verify.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    PC=$(by_subject "$PHASE_SUBJECT")
    echo "  the phase commit by its subject \"$PHASE_SUBJECT\": ${PC:-none}"
    check "the phase commit given is the P4 doc commit, by its subject (change PV1)" "$(yn [ "$PC" = "$C" ])"
    TAGSUB=$(by_subject "$TAG_SUBJECT")
    TAGC=$(git rev-parse -q --verify refs/tags/v0.1.1)
    TAGT=$(git cat-file -t refs/tags/v0.1.1 2>/dev/null)
    echo "  git rev-parse refs/tags/v0.1.1 -> ${TAGC:-none}; git cat-file -t -> ${TAGT:-none}; the close-out doc commit by its subject: ${TAGSUB:-none}"
    tag_ok() { [ -n "$TAGC" ] && [ "$TAGC" = "$TAGSUB" ] && [ "$TAGT" = commit ]; }
    check "the tag v0.1.1 is a lightweight tag on the close-out doc commit, of type commit (specs/0049 ruling N)" "$(yn tag_ok)"
    tag_ctl() { [ "$(git cat-file -t "$C^{tree}")" = commit ]; }
    check "control: the same type reading refuses a tree" "$(ynnot tag_ctl)"
    check "the tag's commit is an ancestor of the phase commit" "$(yn git merge-base --is-ancestor "$TAGC" "$C")"
    if [ -z "$TAGC" ] || [ "$TAGC" != "$TAGSUB" ]; then stop_here "the tag is not the close-out doc commit"; fi
    spec_committed=$(git show "$C:$SPEC" | sha256sum | cut -d' ' -f1)
    roadmap_committed=$(git show "$C:ROADMAP.md" | sha256sum | cut -d' ' -f1)
    spec_now=$(sha_of "$SPEC")
    roadmap_now=$(sha_of ROADMAP.md)
    echo "  $SPEC at the phase commit: $spec_committed (pinned $SPEC_WANT); in the working tree: $spec_now; PLANNING_SPEC: ${PLANNING_SPEC:-unset}"
    echo "  ROADMAP.md at the phase commit: $roadmap_committed (pinned $ROADMAP_WANT); in the working tree: $roadmap_now; PLANNING_ROADMAP: ${PLANNING_ROADMAP:-unset}"
    pinned_ok() { [ "$spec_committed" = "$SPEC_WANT" ] && [ "$roadmap_committed" = "$ROADMAP_WANT" ]; }
    check "the phase commit's spec and ROADMAP.md are the pinned blobs (change PV1)" "$(yn pinned_ok)"
    working_ok() { { [ "$spec_now" = "$spec_committed" ] || { [ -n "$PLANNING_SPEC" ] && [ "$spec_now" = "$PLANNING_SPEC" ]; }; } && { [ "$roadmap_now" = "$roadmap_committed" ] || { [ -n "$PLANNING_ROADMAP" ] && [ "$roadmap_now" = "$PLANNING_ROADMAP" ]; }; }; }
    check "the working spec and ROADMAP.md are the phase commit's or planning's named copies" "$(yn working_ok)"
    working_ctl() { local spec_now=1111111111111111111111111111111111111111111111111111111111111111; working_ok; }
    check "control: the same check refuses a spec of another hash" "$(ynnot working_ctl)"
    echo "root: <repo> stands for the repository's top level; scripts/counting.sh and records/logs/m8p3-p3/run.log are taken from it at the phase commit by git show, and the tag's tree by git archive"
    echo "root: <home> stands for the home directory of the account that ran this script"
    echo "root: <phase> stands for <home>/.cache/emend-build/m8p3-p4 on the disk, the phase's directory; <phase>/gen holds the generator that wrote this script and <phase>/model the script it carries its frame from"
    echo "root: <workroot> stands for the work root: <phase> in the logged run, the directory RUN_WORK names in a dry run; it holds TMPDIR (change PV2)"
    echo "root: <source> stands for the directory P4_SOURCE names in a dry run, holding the three inputs copied instead of downloaded (change PV2)"
    echo "root: <scratch> stands for <workroot>, named <scratch> where TMPDIR is concerned: TMPDIR is <scratch>/tmp, made and exported by this script before any mktemp, and <work> is made under it"
    echo "root: <scripts> stands for <phase>/scripts on the disk, this script's own directory; this script's own standard error goes to <scripts>/out/verify.stderr (specs/0017 P1 verification ruling 7)"
    echo "root: <work> stands for this run's working directory, made by mktemp -d under TMPDIR, <scratch>/tmp, on the disk (the counting library, the three inputs <work>/in, the crate's entries <work>/crate, the tag's tree <work>/tag, the checks' programs and outputs), kept after the run and never removed"
    work_in_tmpdir() { case "$B/" in "$TMPDIR/"*) return 0 ;; esac; return 1; }
    check "<work>, the directory mktemp -d made, is under TMPDIR, <scratch>/tmp" "$(yn work_in_tmpdir)"
    work_ctl() { local B=/tmp/x; work_in_tmpdir; }
    check "control: the same test refuses a working directory under /tmp" "$(ynnot work_ctl)"
    # Every mktemp call of this script is checked under TMPDIR, so the source is
    # read for its calls outside comments; the call's text is built from
    # pieces, so this form's own text is no call.
    MKW='$('
    MKW=${MKW}mkt
    MKW=${MKW}emp
    count_tempcalls() {
      awk -v w="$MKW" '{ l = $0; sub(/^[ \t]+/, "", l); if (substr(l, 1, 1) == "#") next; s = l
        while ((i = index(s, w)) > 0) { n++; s = substr(s, i + length(w)) }
      } END { print n + 0 }' "$1"
    }
    printf '%s\n' "A=$MKW -d)" "F=$MKW)" "# $MKW -d)" >"$B/mktemp-fixture"
    n_mk=$(count_tempcalls "$SELF")
    n_mk_fix=$(count_tempcalls "$B/mktemp-fixture")
    echo "command: count_tempcalls <this script>, and the same over a fixture of three lines: a directory call, a file call, a comment"
    echo "  mktemp calls in this script outside comments: $n_mk (the one that makes <work>, checked under TMPDIR above); in the fixture: $n_mk_fix"
    check "this script makes one mktemp call, <work>'s, and no plain temporary file" "$(yn [ "$n_mk" = 1 ])"
    check "control: the same count finds the fixture's two calls and not its comment" "$(yn [ "$n_mk_fix" = 2 ])"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY:-}" ] && echo yes || echo no)"
    key_unset() { [ -z "${ANTHROPIC_API_KEY:-}" ]; }
    check "ANTHROPIC_API_KEY is not set" "$(yn key_unset)"
    key_set_ctl() { local ANTHROPIC_API_KEY=planted; key_unset; }
    check "control: the same check refuses a shell where the variable is set" "$(ynnot key_set_ctl)"
    echo "at entry: status lines $entry_all; of them admitted by the phase's pattern (this phase's logs, planning's modified specs/0049 and ROADMAP.md) $entry_ours; the lines:"
    git status --porcelain | sed 's/^/    /'
    ours_rec_ctl() { printf '?? records/logs/m8p3-p4/verify.log\n M specs/0049-excel-check-and-release.md\n M ROADMAP.md\n?? records/logs/m8p3-p3/run.log\n M README.md\n M crates/emend/Cargo.toml\n' | count_matches -E "$OURS" /dev/stdin; }
    check "control: the phase's status pattern admits this phase's log, specs/0049 and ROADMAP.md alone; it refuses another phase's log, a modified README and manifest" "$(yn [ "$(ours_rec_ctl)" = 3 ])"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$SELF"
    echo
    echo "## the shared counting library this log sources (the phase commit's, by git show)"
    sed 's/^/    /' "$B/counting.sh"
    echo
    echo "## counting controls"
    counting_controls
    if [ "$counting_controls_ok" != yes ]; then fail=1; fi
    
    echo
    echo "## 1. the registry token variables and the credentials file"
    tok_state() { if [ -n "${!1+x}" ]; then echo set; else echo absent; fi; }
    echo "  CARGO_REGISTRY_TOKEN: $(tok_state CARGO_REGISTRY_TOKEN); CARGO_REGISTRIES_CRATES_IO_TOKEN: $(tok_state CARGO_REGISTRIES_CRATES_IO_TOKEN) (values never printed)"
    tokens_absent() { [ "$(tok_state CARGO_REGISTRY_TOKEN)" = absent ] && [ "$(tok_state CARGO_REGISTRIES_CRATES_IO_TOKEN)" = absent ]; }
    check "the two registry token variables are absent" "$(yn tokens_absent)"
    tok_ctl() { local CARGO_REGISTRY_TOKEN=planted; tokens_absent; }
    check "control: the same check refuses a shell where one is set" "$(ynnot tok_ctl)"
    echo "  <home>/.cargo/credentials.toml: named here and nowhere opened, listed or read by this script; no cargo command runs in this log"
    
    echo
    echo "## 2. the three inputs (change PV3)"
    mkdir -p "$B/in" || stop_here "<work>/in could not be made"
    # fetch <name> <url>: the logged run downloads with curl over https alone;
    # a dry run copies <source>/<name> (change PV2).
    fetch() {
      local name=$1 url=$2 rc code
      if [ "$LOGGED" = yes ]; then
        echo "command: curl -sS --fail --proto =https --tlsv1.2 --max-time 120 -A <user agent> -o <work>/in/$name -w %{http_code} $url"
        code=$(curl -sS --fail --proto =https --tlsv1.2 --max-time 120 -A "$UA" -o "$B/in/$name" -w '%{http_code}' "$url" 2>"$B/in/$name.err" </dev/null); rc=$?
        echo "  exit: $rc; HTTP code: ${code:-none}; curl's standard error: $(wc -c <"$B/in/$name.err") bytes"
        sed 's/^/    /' "$B/in/$name.err"
      else
        echo "command (dry run, no network): cp <source>/$name <work>/in/$name"
        cp "$SOURCE/$name" "$B/in/$name" 2>"$B/in/$name.err" </dev/null; rc=$?
        code=dry
        echo "  exit: $rc"
      fi
      if [ "$rc" != 0 ] || [ ! -s "$B/in/$name" ]; then finding "$name could not be fetched (exit $rc)"; stop_here "an input is missing"; fi
      echo "  $name: $(wc -c <"$B/in/$name") bytes, sha256 $(sha_of "$B/in/$name")"
    }
    fetch emend-0.1.1.crate "$CRATE_URL"
    fetch index-emend "$INDEX_URL"
    fetch api-emend.json "$API_URL"
    check "the three inputs are there and not empty" yes
    
    echo
    echo "## 3. the index's lines for 0.1.1 and 0.1.0 and the crate file's sha256 (changes PV3 and QV4)"
    cat >"$B/index.py" <<'PYEOF'
    import json, sys
    rows = []
    old = []
    for line in open(sys.argv[1], encoding="utf-8"):
        line = line.strip()
        if not line:
            continue
        r = json.loads(line)
        print("  index line: name %s, vers %s, yanked %s" % (r.get("name"), r.get("vers"), str(r.get("yanked")).lower()))
        if r.get("vers") == "0.1.1":
            rows.append(r)
        if r.get("vers") == "0.1.0":
            old.append(r)
    print("  lines for 0.1.1: %d" % len(rows))
    if len(rows) == 1:
        r = rows[0]
        print("FIELDS %s %s %s %s" % (r.get("name"), r.get("vers"), r.get("cksum"), str(r.get("yanked")).lower()))
    print("  lines for 0.1.0: %d" % len(old))
    if len(old) == 1:
        r = old[0]
        print("OLD %s %s %s %s" % (r.get("name"), r.get("vers"), r.get("cksum"), str(r.get("yanked")).lower()))
    PYEOF
    python3 -I -B "$B/index.py" "$B/in/index-emend" >"$B/index.out" 2>"$B/index.err"; rc=$?
    LC_ALL=C "$G" -v -E '^(FIELDS|OLD) ' "$B/index.out"
    echo "  the index reader's exit: $rc; its standard error: $(wc -c <"$B/index.err") bytes"
    read -r _ I_NAME I_VERS I_CKSUM I_YANKED <<<"$(LC_ALL=C "$G" '^FIELDS ' "$B/index.out")"
    echo "  the line for 0.1.1: name ${I_NAME:-none}, vers ${I_VERS:-none}, cksum ${I_CKSUM:-none}, yanked ${I_YANKED:-none}"
    index_ok() { [ "$rc" = 0 ] && [ "${I_NAME:-}" = emend ] && [ "${I_VERS:-}" = 0.1.1 ] && [ "${I_YANKED:-}" = false ] && printf '%s' "${I_CKSUM:-}" | LC_ALL=C "$G" -qxE '[0-9a-f]{64}'; }
    check "the index holds one line for emend 0.1.1, not yanked, with a 64-hex cksum" "$(yn index_ok)"
    if ! index_ok; then finding "the index's line for 0.1.1 is not as expected"; stop_here "the index"; fi
    CRATE_SHA=$(sha_of "$B/in/emend-0.1.1.crate")
    echo "  the crate file's sha256: $CRATE_SHA; the index's cksum: $I_CKSUM"
    check "the crate file's sha256 is the index's cksum" "$(yn [ "$CRATE_SHA" = "$I_CKSUM" ])"
    cp "$B/in/emend-0.1.1.crate" "$B/c-crate"; printf 'x' >>"$B/c-crate"
    check "control: a copy of the crate file with one byte appended does not match the cksum" "$(yn [ "$(sha_of "$B/c-crate")" != "$I_CKSUM" ])"
    if [ "$CRATE_SHA" != "$I_CKSUM" ]; then finding "the crate file's sha256 $CRATE_SHA is not the index's cksum $I_CKSUM"; stop_here "the cksum"; fi
    # Change QV4: 0.1.0 still listed in the index, once, not yanked.
    read -r _ O_NAME O_VERS O_CKSUM O_YANKED <<<"$(LC_ALL=C "$G" '^OLD ' "$B/index.out")"
    echo "  the line for 0.1.0: name ${O_NAME:-none}, vers ${O_VERS:-none}, cksum ${O_CKSUM:-none}, yanked ${O_YANKED:-none}"
    old_ok() { [ "$1" = emend ] && [ "$2" = 0.1.0 ] && [ "$3" = false ] && printf '%s' "$4" | LC_ALL=C "$G" -qxE '[0-9a-f]{64}'; }
    check "the index still holds one line for emend 0.1.0, not yanked, with a 64-hex cksum (change QV4)" "$(yn old_ok "${O_NAME:-}" "${O_VERS:-}" "${O_YANKED:-}" "${O_CKSUM:-}")"
    check "control: the same check refuses that line read as yanked" "$(ynnot old_ok "${O_NAME:-}" "${O_VERS:-}" true "${O_CKSUM:-}")"
    if ! old_ok "${O_NAME:-}" "${O_VERS:-}" "${O_YANKED:-}" "${O_CKSUM:-}"; then finding "the index does not hold one line for 0.1.0, not yanked"; stop_here "0.1.0 in the index"; fi
    
    echo
    echo "## 4. the crate file's entries and its count of files (change PV4)"
    echo "command: tar -tvzf <work>/in/emend-0.1.1.crate"
    tar -tvzf "$B/in/emend-0.1.1.crate" >"$B/entries-v" 2>"$B/entries.err"; rc=$?
    tar -tzf "$B/in/emend-0.1.1.crate" >"$B/entries" 2>>"$B/entries.err" || rc=1
    echo "  exit: $rc; entries: $(count_lines "$B/entries"); standard error: $(wc -c <"$B/entries.err") bytes"
    n_out=$(awk '$0 !~ /^emend-0[.]1[.]1\// || $0 ~ /(^|\/)[.][.](\/|$)/' "$B/entries" | wc -l)
    n_type=$(awk 'substr($1, 1, 1) != "-" && substr($1, 1, 1) != "d"' "$B/entries-v" | wc -l)
    echo "  entries outside emend-0.1.1/ or holding \"..\": $n_out; entries neither a file nor a directory: $n_type"
    entries_ok() { [ "$rc" = 0 ] && [ "$n_out" = 0 ] && [ "$n_type" = 0 ]; }
    check "every entry is under emend-0.1.1/, none holding \"..\", each a file or a directory" "$(yn entries_ok)"
    printf '%s\n' 'emend-0.1.1/src/lib.rs' '../x' 'emend-0.1.1/../y' '/etc/z' >"$B/c-entries"
    bad_entries() { awk '$0 !~ /^emend-0[.]1[.]1\// || $0 ~ /(^|\/)[.][.](\/|$)/' "$1" | wc -l; }
    check "control: the same reading finds the fixture's three bad entries" "$(yn [ "$(bad_entries "$B/c-entries")" = 3 ])"
    if [ "$rc" != 0 ] || [ "$n_out" != 0 ] || [ "$n_type" != 0 ]; then finding "the crate file's entries are not all files and directories under emend-0.1.1/"; stop_here "the entries"; fi
    mkdir -p "$B/crate" && tar -xzf "$B/in/emend-0.1.1.crate" -C "$B/crate" --no-same-owner --no-same-permissions 2>>"$B/entries.err" || { finding "the crate file did not extract"; stop_here "the extraction"; }
    PK=$B/crate/emend-0.1.1
    (cd "$PK" && find . -type f | sed 's#^[.]/##' | LC_ALL=C sort) >"$B/files"
    n_files=$(count_lines "$B/files")
    P3_PACKAGED=$(git show "$C:records/logs/m8p3-p3/run.log" | sed -n 's/.*"Packaged N files": \([0-9][0-9]*\) (the archive.s list: [0-9]*)$/\1/p' | head -n 1)
    echo "  files in the package: $n_files; P3's \"Packaged N files\" in the archive (records/logs/m8p3-p3/run.log at the phase commit): ${P3_PACKAGED:-none}; .cargo_vcs_info.json in the package: $(count_matches -xF .cargo_vcs_info.json "$B/files")"
    echo "  the package's files:"
    sed 's/^/    /' "$B/files"
    count_ok() { [ -n "$P3_PACKAGED" ] && [ "$(count_matches -xF .cargo_vcs_info.json "$1")" = 1 ] && [ "$(count_lines "$1")" = "$((P3_PACKAGED + 1))" ]; }
    check "the count is P3's $P3_PACKAGED plus .cargo_vcs_info.json, which cargo adds in a git checkout and not in P3's archive" "$(yn count_ok "$B/files")"
    { cat "$B/files"; echo extra.rs; } >"$B/c-files"
    check "control: the same count refuses a list with one file more" "$(ynnot count_ok "$B/c-files")"
    if ! count_ok "$B/files"; then finding "the package holds $n_files files, not P3's ${P3_PACKAGED:-none} plus one"; stop_here "the count"; fi
    
    echo
    echo "## 5. every packaged file against the tag's tree (change PV4)"
    echo "command: git archive $TAGC | tar -x -C <work>/tag"
    mkdir -p "$B/tag" && git archive "$TAGC" | tar -x -C "$B/tag" 2>"$B/tag.err"; rc=$?
    echo "  exit: $rc; files in the tag's tree: $(find "$B/tag" -type f | wc -l); in its crates/emend: $(find "$B/tag/crates/emend" -type f | wc -l)"
    if [ "$rc" != 0 ]; then finding "git archive of the tag did not extract"; stop_here "the tag's tree"; fi
    # tag_path <packaged file>: the tag's file it is to equal, or "cargo" for a
    # file cargo writes.
    tag_path() {
      case "$1" in
        Cargo.toml | .cargo_vcs_info.json | Cargo.lock) echo cargo ;;
        README.md) echo README.md ;;
        Cargo.toml.orig) echo crates/emend/Cargo.toml ;;
        *) echo "crates/emend/$1" ;;
      esac
    }
    same_file() { [ -f "$1" ] && [ -f "$2" ] && [ "$(sha_of "$1")" = "$(sha_of "$2")" ]; }
    n_eq=0; n_diff=0; n_cargo=0
    echo "  each packaged file: its sha256, its path, the tag's file and the result"
    while IFS= read -r f; do
      t=$(tag_path "$f")
      if [ "$t" = cargo ]; then
        printf '    %s  %s  written by cargo (section 6)\n' "$(sha_of "$PK/$f")" "$f"
        n_cargo=$((n_cargo + 1))
      elif same_file "$PK/$f" "$B/tag/$t"; then
        printf '    %s  %s  = %s\n' "$(sha_of "$PK/$f")" "$f" "$t"
        n_eq=$((n_eq + 1))
      else
        printf '    %s  %s  DIFFERS from %s\n' "$(sha_of "$PK/$f")" "$f" "$t"
        finding "the packaged $f differs from the tag's $t"
        n_diff=$((n_diff + 1))
      fi
    done <"$B/files"
    # Every file of the tag's crates/emend is in the package (Cargo.toml as
    # Cargo.toml.orig), and README.md beside them.
    (cd "$B/tag/crates/emend" && find . -type f | sed 's#^[.]/##' | LC_ALL=C sort) >"$B/tag-files"
    n_missing=0
    while IFS= read -r f; do
      p=$f; [ "$f" = Cargo.toml ] && p=Cargo.toml.orig
      if [ "$(count_matches -xF "$p" "$B/files")" != 1 ]; then finding "the tag's crates/emend/$f is not in the package"; n_missing=$((n_missing + 1)); fi
    done <"$B/tag-files"
    echo "  packaged files equal to the tag's: $n_eq; differing: $n_diff; written by cargo: $n_cargo; the tag's crates/emend files: $(count_lines "$B/tag-files"), of them missing from the package: $n_missing"
    compare_ok() { [ "$n_diff" = 0 ] && [ "$n_missing" = 0 ] && [ "$n_cargo" = 3 ] && [ "$((n_eq + n_cargo))" = "$n_files" ]; }
    check "every packaged file but the three cargo writes equals the tag's, and every file of the tag's crates/emend is packaged" "$(yn compare_ok)"
    cp "$B/tag/crates/emend/src/lib.rs" "$B/c-lib.rs"
    check "control: the same comparison accepts a copy of the tag's src/lib.rs" "$(yn same_file "$B/c-lib.rs" "$B/tag/crates/emend/src/lib.rs")"
    printf 'x' >>"$B/c-lib.rs"
    check "control: the same comparison refuses that copy with one byte appended" "$(ynnot same_file "$B/c-lib.rs" "$B/tag/crates/emend/src/lib.rs")"
    if [ "$n_diff" != 0 ] || [ "$n_missing" != 0 ] || [ "$n_cargo" != 3 ]; then stop_here "the package is not the tag's"; fi
    
    echo
    echo "## 6. the files cargo writes, and Cargo.toml.orig, read in full (change PV5)"
    for f in .cargo_vcs_info.json Cargo.toml Cargo.toml.orig Cargo.lock; do
      if [ -n "$(tail -c 1 "$PK/$f")" ]; then nl="no final newline"; else nl="a final newline"; fi
      echo "file $f ($(wc -c <"$PK/$f") bytes, sha256 $(sha_of "$PK/$f"), $nl):"
      awk '{ print "    " $0 }' "$PK/$f"
    done
    cat >"$B/vcs.py" <<'PYEOF'
    import json, sys
    v = json.load(open(sys.argv[1], encoding="utf-8"))
    g = v.get("git", {})
    print("%s %s %s" % (g.get("sha1"), v.get("path_in_vcs"), str(g.get("dirty", False)).lower()))
    PYEOF
    read -r V_SHA V_PATH V_DIRTY <<<"$(python3 -I -B "$B/vcs.py" "$PK/.cargo_vcs_info.json" 2>>"$B/index.err")"
    echo "  .cargo_vcs_info.json: git.sha1 ${V_SHA:-none}; path_in_vcs ${V_PATH:-none}; dirty ${V_DIRTY:-none}"
    vcs_ok() { [ "${V_SHA:-}" = "$1" ] && [ "${V_PATH:-}" = crates/emend ] && [ "${V_DIRTY:-}" = false ]; }
    check ".cargo_vcs_info.json names the tag's commit $TAGC, the path crates/emend, not dirty" "$(yn vcs_ok "$TAGC")"
    check "control: the same check refuses another commit" "$(ynnot vcs_ok "$FAKE_SHA")"
    if ! vcs_ok "$TAGC"; then finding ".cargo_vcs_info.json does not name the tag's commit and crates/emend, clean"; stop_here "the vcs file"; fi
    cat >"$B/manifest.py" <<'PYEOF'
    import sys, tomllib
    m = tomllib.load(open(sys.argv[1], "rb"))
    p = m.get("package", {})
    print("name %s" % p.get("name"))
    print("version %s" % p.get("version"))
    print("keywords %s" % " ".join(sorted(p.get("keywords", []))))
    print("categories %s" % " ".join(sorted(p.get("categories", []))))
    PYEOF
    python3 -I -B "$B/manifest.py" "$PK/Cargo.toml" >"$B/norm.out" 2>>"$B/index.err"
    python3 -I -B "$B/manifest.py" "$B/tag/crates/emend/Cargo.toml" >"$B/orig.out" 2>>"$B/index.err"
    echo "  the normalised Cargo.toml:"; sed 's/^/    /' "$B/norm.out"
    echo "  the tag's crates/emend/Cargo.toml (keywords and categories are its own, not the workspace's):"; sed 's/^/    /' "$B/orig.out"
    norm_ok() { LC_ALL=C "$G" -qx 'name emend' "$1" && LC_ALL=C "$G" -qx 'version 0.1.1' "$1" && [ "$(LC_ALL=C "$G" -E '^(keywords|categories) ' "$1")" = "$(LC_ALL=C "$G" -E '^(keywords|categories) ' "$B/orig.out")" ]; }
    check "the normalised Cargo.toml names emend 0.1.1, with the tag's manifest's keywords and categories" "$(yn norm_ok "$B/norm.out")"
    sed 's/^keywords .*/keywords xlsx/' "$B/norm.out" >"$B/c-norm.out"
    check "control: the same check refuses a copy with one keyword" "$(ynnot norm_ok "$B/c-norm.out")"
    if ! norm_ok "$B/norm.out"; then finding "the normalised Cargo.toml is not emend 0.1.1 with the manifest's keywords and categories"; stop_here "the normalised manifest"; fi
    if same_file "$PK/Cargo.lock" "$B/tag/Cargo.lock"; then lock_rel="equals"; else lock_rel="differs from"; fi
    echo "  Cargo.lock in the package $lock_rel the tag's workspace Cargo.lock; cargo writes the package's own lock file (information, not a check)"
    
    echo
    echo "## 7. the registry's page (specs/0031 ruling 4; change PV6)"
    cat >"$B/api.py" <<'PYEOF'
    import json, sys
    d = json.load(open(sys.argv[1], encoding="utf-8"))
    c = d.get("crate", {})
    print("name %s" % c.get("name"))
    print("max_version %s" % c.get("max_version"))
    print("keywords %s" % " ".join(sorted(c.get("keywords") or [])))
    print("categories %s" % " ".join(sorted(c.get("categories") or [])))
    kw = d.get("keywords")
    ca = d.get("categories")
    print("page_keywords %s" % ("absent" if kw is None else " ".join(sorted(k.get("id", "") for k in kw))))
    print("page_categories %s" % ("absent" if ca is None else " ".join(sorted(k.get("slug", k.get("id", "")) for k in ca))))
    vs = [v for v in d.get("versions", []) if v.get("num") == "0.1.1"]
    print("versions_0_1_1 %d" % len(vs))
    if vs:
        print("yanked %s" % str(vs[0].get("yanked")).lower())
        print("checksum %s" % vs[0].get("checksum"))
    vo = [v for v in d.get("versions", []) if v.get("num") == "0.1.0"]
    print("versions_0_1_0 %d" % len(vo))
    if vo:
        print("yanked_0_1_0 %s" % str(vo[0].get("yanked")).lower())
    PYEOF
    python3 -I -B "$B/api.py" "$B/in/api-emend.json" >"$B/api.out" 2>"$B/api.err"; rc=$?
    echo "  the page reader's exit: $rc; its standard error: $(wc -c <"$B/api.err") bytes; what it read:"
    sed 's/^/    /' "$B/api.out"
    field() { sed -n "s/^$2 //p" "$1"; }
    api_ok() {
      [ "$(field "$1" name)" = emend ] && [ "$(field "$1" keywords)" = "$(field "$B/orig.out" keywords)" ] &&
        [ "$(field "$1" categories)" = "$(field "$B/orig.out" categories)" ] && [ "$(field "$1" versions_0_1_1)" = 1 ] &&
        [ "$(field "$1" yanked)" = false ] && [ "$(field "$1" checksum)" = "$I_CKSUM" ]
    }
    page_ok() { [ "$rc" = 0 ] && api_ok "$B/api.out"; }
    check "the page names emend, the manifest's keywords and categories, version 0.1.1 once, not yanked, its checksum the index's cksum" "$(yn page_ok)"
    sed 's/^categories .*/categories encoding/' "$B/api.out" >"$B/c-api.out"
    check "control: the same check refuses a page lacking one category" "$(ynnot api_ok "$B/c-api.out")"
    if [ "$rc" != 0 ] || ! api_ok "$B/api.out"; then finding "the registry's page does not read back as the manifest's keywords and categories and version 0.1.1"; stop_here "the registry's page"; fi
    # Change QV4: 0.1.0 still on the page, once, not yanked.
    old_page_ok() { [ "$(field "$1" versions_0_1_0)" = 1 ] && [ "$(field "$1" yanked_0_1_0)" = false ]; }
    check "the page still lists version 0.1.0 once, not yanked (change QV4)" "$(yn old_page_ok "$B/api.out")"
    sed 's/^yanked_0_1_0 .*/yanked_0_1_0 true/' "$B/api.out" >"$B/c-api0.out"
    check "control: the same check refuses a page with 0.1.0 yanked" "$(ynnot old_page_ok "$B/c-api0.out")"
    if ! old_page_ok "$B/api.out"; then finding "the registry's page does not list 0.1.0 once, not yanked"; stop_here "0.1.0 on the page"; fi
    finish

## the shared counting library this log sources (the phase commit's, by git show)
    # emend shared counting forms (specs/0007-gate-self-test.md, "scripts/counting.sh").
    #
    # Sourced by scripts/gate-self-test.sh and by the log scripts of later phases,
    # which use these instead of carrying their own copy.
    #
    # WHY THIS FILE EXISTS. In T3 P4 four counting sites compared a bare `grep -c`
    # with 0 without reading the exit status, so a read error printed 0 and the
    # check passed. Two independent checks found them, and the class was declared
    # closed three further times while instances still stood: a helper whose first
    # repair read grep's status while `cat` was the failing command, and both
    # halves of one function in T2 P7. Planning's remedy is that every counting
    # form, including a throwaway one, is a named function that reads the exit
    # status and has a positive control, from the start.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path. A caller that compares a result
    # with 0 therefore cannot mistake a failed read for an absence.
    #
    # counting_controls runs every form against a match, a miss and an unreadable
    # file, prints one line per control, and sets counting_controls_ok. Callers run
    # it before using any form.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_matches_i <-F|-E> <pattern> <file>...: count_matches with -i, the form
    # the hygiene step uses for OFFICE_RE and ZONE_RE. It lived in a log script as a
    # hand-rolled copy with no control of its own (independent check 2, T6 P1, gap
    # 14); a counting form belongs here, with a control, even a throwaway one.
    count_matches_i() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c -i "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # run_lines <command...>: run the command, and print the number of lines it
    # wrote on stdout, or "error" if the command itself failed. The log scripts
    # asserted a clean working tree with
    #   git status --porcelain >file 2>/dev/null || : >file
    # which turns a FAILED git status into an empty file, so the check read a
    # failed command as a clean tree (independent check 2, T6 P1, gap 1; planning
    # reproduced it). Reading the command's exit status is the whole point: a
    # command that could not run is never the same as a command that found nothing.
    run_lines() {
      local out rc
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | wc -l | tr -d ' '
    }
    
    # run_matches <-F|-E> <pattern> <command...>: the same, counting only the lines
    # that match, so a caller can compare "all lines" with "lines of the expected
    # shape" without either count hiding a failed command.
    run_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$("$@" 2>/dev/null); rc=$?
      if [ "$rc" -ne 0 ]; then printf 'error'; return; fi
      if [ -z "$out" ]; then printf '0'; return; fi
      printf '%s\n' "$out" | LC_ALL=C "$G" -a -c "$mode" -e "$pattern" || true
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      printf 'NEEDLE\nneedle\n' >"$d/mixedcase"
      r=$(count_matches_i -F needle "$d/mixedcase"); echo "  control count_matches_i on mixed case: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/mixedcase");  echo "  control count_matches on the same file, case sensitive: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(count_matches_i -F needle "$d/locked");   echo "  control count_matches_i on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines printf 'a\nb\nc\n');            echo "  control run_lines on a command printing three lines: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(run_lines true);                          echo "  control run_lines on a command printing nothing: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(run_lines false);                         echo "  control run_lines on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_lines "$d/no-such-command");          echo "  control run_lines on a command that cannot run: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(run_matches -F needle printf 'needle\nother\n'); echo "  control run_matches on a command printing one match: $r (expect 1)"; [ "$r" = 1 ] || ok=no
      r=$(run_matches -F needle false);             echo "  control run_matches on a FAILING command: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "${d:?}"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

