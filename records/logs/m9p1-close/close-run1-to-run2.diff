+JSONPY='import json, sys
+sel, path = sys.argv[1], sys.argv[2]
+with open(path, encoding="utf-8") as f:
+    d = json.load(f)
+def bad(j):
+    return j["status"] != "completed" or j["conclusion"] != "success"
+if sel == "len":
