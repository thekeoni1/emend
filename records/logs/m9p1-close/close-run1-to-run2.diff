+    print(d[0]["databaseId"])
+elif sel == "fields":
+    print(" ".join(str(d[k]) for k in ("name", "event", "headSha", "status")))
+elif sel == "conclusion":
+    print(d["conclusion"])
+elif sel == "njobs":
+    print(len(d["jobs"]))
+elif sel == "jobs":
+    print("; ".join("%s: %s %s" % (j["name"], j["status"], j["conclusion"]) for j in d["jobs"]))
+elif sel == "badjobs":
+    print(sum(1 for j in d["jobs"] if bad(j)))
+else:
+    sys.exit("unknown selector " + sel)'
+jread() {
+  local sel=$1 f=$2 rc
+  JV=$(python3 -I -B -c "$JSONPY" "$sel" "$f")
+  rc=$?
+  check "the reader $sel over $(basename "$f") exits 0" same "$rc" 0
+}
