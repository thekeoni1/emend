    #!/usr/bin/env bash
    # T0 P1 scan, run 2. Appended to records/logs/t0-p1/scan.log.
    # Positive controls use grep -c so no non-ASCII byte is written to the log.
    set -uo pipefail
    cd /home/dev/emend
    C=5f15d55641d77b2087ec9686700829d5a7897181
    T=$(mktemp -d)
    FILES="CLAUDE.md ROADMAP.md specs/0000-step-zero-plan.md specs/0001-bootstrap.md"
    
    echo
    echo "================================================================"
    echo "## run 2, $(date -u +%Y-%m-%dT%H:%M:%SZ), commit scanned: $C"
    echo "HEAD when run 2 started: $(git rev-parse HEAD)"
    echo "Fixes in this run, taken from independent-check.md (first check):"
    echo "  1. The exact script is printed below. Run 1 printed only command templates."
    echo "  2. Each grep's exit status is recorded per file (0 match, 1 no match, 2 or more error)."
    echo "  3. The locale and the grep binary in use are recorded."
    echo "  4. Positive controls prove both scans can find a hit."
    echo "  5. The --stat command is recorded with its --format option."
    echo "  6. The evidence the draft report relied on is recorded: root commit,"
    echo "     the record commit and its parent, the remote count, and hashes of the"
    echo "     working tree compared with the commit."
    echo "The run 1 results above are left as they were."
    echo
    echo "### script"
    sed 's/^/    /' "$0"
    echo
    echo "### environment"
    echo "LANG=${LANG:-} LC_ALL=${LC_ALL:-} LC_CTYPE(locale)=$(locale 2>/dev/null | sed -n 's/^LC_CTYPE=//p')"
    echo "type -a grep:"; type -a grep 2>&1 | sed 's/^/    /'
    echo "readlink -f \$(command -v grep): $(readlink -f "$(command -v grep)")"
    echo "grep --version: $(grep --version 2>&1 | head -1)"
    echo "git --version: $(git --version)"
    
    echo
    echo "### positive controls (a temp file holding bytes e2 80 94 = U+2014)"
    printf 'a\xe2\x80\x94b\n' > "$T/ctl"
    grep -cP '\x{2014}' "$T/ctl"; echo "control U+2014, session locale: exit=$? (expect count 1, exit 0)"
    LC_ALL=C grep -cP '\x{2014}' "$T/ctl"; echo "control U+2014, LC_ALL=C: exit=$? (expect count 1, exit 0)"
    LC_ALL=C grep -cP '[^\x00-\x7F]' "$T/ctl"; echo "control non-ASCII, LC_ALL=C: exit=$? (expect count 1, exit 0)"
    printf 'plain ascii\n' > "$T/neg"
    grep -cP '\x{2014}' "$T/neg"; echo "control U+2014 on ASCII-only file: exit=$? (expect count 0, exit 1)"
    
    echo
    echo "### per-file scans of committed content (git show $C:<file> > tmpfile)"
    tot_u=0; tot_n=0
    for f in $FILES; do
      git show "$C:$f" > "$T/f"; echo "git show $C:$f exit=$?"
      u=$(grep -cP '\x{2014}' "$T/f"); ru=$?
      echo "  grep -cP '\\x{2014}' $f: count=$u exit=$ru"
      n=$(LC_ALL=C grep -cP '[^\x00-\x7F]' "$T/f"); rn=$?
      echo "  LC_ALL=C grep -cP '[^\\x00-\\x7F]' $f: count=$n exit=$rn"
      tot_u=$((tot_u+u)); tot_n=$((tot_n+n))
    done
    echo "run 2 U+2014 hits: $tot_u"
    echo "run 2 non-ASCII hits: $tot_n"
    
    echo
    echo "### commit message scans"
    for c in $(git rev-list HEAD); do
      git log -1 --format=%B "$c" > "$T/m"
      n=$(LC_ALL=C grep -cP '[^\x00-\x7F]' "$T/m"); rn=$?
      echo "  $c message non-ASCII: count=$n exit=$rn"
    done
    
    echo
    echo "### record files other than this log"
    for f in records/logs/t0-p1/independent-check.md; do
      u=$(grep -cP '\x{2014}' "$f"); ru=$?
      n=$(LC_ALL=C grep -cP '[^\x00-\x7F]' "$f"); rn=$?
      echo "  $f: U+2014 count=$u exit=$ru; non-ASCII count=$n exit=$rn"
    done
    
    echo
    echo "### commit graph and remotes"
    echo "command: git rev-list --parents $C"; git rev-list --parents "$C"
    echo "command: git rev-list --max-parents=0 HEAD"; git rev-list --max-parents=0 HEAD
    echo "command: git log --format='%H parents=%P %s'"; git log --format='%H parents=%P %s'
    echo "remote count (git remote | wc -l): $(git remote | wc -l)"
    
    echo
    echo "### stat of the phase commit"
    echo "command: git show --stat --format='%H %s' $C"
    git show --stat --format='%H %s' "$C"
    
    echo
    echo "### working tree compared with the committed content"
    echo "The pre-add sha256 values in the draft report came from session output and were not logged in run 1."
    echo "What can be logged now is the working tree after the commit, compared with the commit:"
    for f in $FILES; do
      a=$(sha256sum "$f" | cut -d' ' -f1); b=$(git show "$C:$f" | sha256sum | cut -d' ' -f1)
      echo "  $f worktree=$a commit=$b $([ "$a" = "$b" ] && echo same || echo DIFFERENT)"
    done
    echo "git ls-files --others --ignored --exclude-standard specs/ (untracked or ignored files under specs/):"
    git ls-files --others --exclude-standard specs/ | sed 's/^/    /'; echo "  (end of list)"
    
    echo
    echo "### observation for planning: trailing whitespace in committed files (not edited, per P1)"
    echo "command: grep -n ' \$' on each committed file"
    for f in $FILES; do git show "$C:$f" | grep -n ' $' | sed "s|^|  $f:|"; done
    echo "  (end of list)"
    rm -rf "$T"

