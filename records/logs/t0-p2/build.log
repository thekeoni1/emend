## script
    #!/usr/bin/env bash
    # T0 P2 logs: build.log, binary.log and ignore.log in records/logs/t0-p2/.
    # Usage: p2-logs.sh <phase commit> <target-add output> <auto-install extract> <toolchain transcript>
    # The first two input files hold rustup output captured earlier in the session;
    # the third is the implementing session's transcription of toolchain state.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    C=${1:?phase commit required}
    TARGET_ADD_OUT=${2:?target-add output required}
    AUTO_INSTALL_OUT=${3:?auto-install extract required}
    TOOLCHAINS_TXT=${4:?toolchain transcript required}
    D=records/logs/t0-p2
    I686=i686-unknown-linux-musl
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    # A missing toolchain or target must fail here, not install silently.
    export RUSTUP_AUTO_INSTALL=0
    
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then echo "tracked changes present" >&2; exit 2; fi
    mkdir -p "$D"
    HEADLINE="about: P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    fail=0
    
    step() { # step <label> <command...>: prints the command, its full output and exit status
      local rc
      echo
      echo "## $1"
      echo "command: ${*:2}"
      "${@:2}" > "$T/out" 2>&1; rc=$?
      cat "$T/out"
      echo "exit: $rc"
      cp "$T/out" "$T/out-$1"
      [ "$rc" -eq 0 ] || fail=1
    }
    
    {
      echo "$HEADLINE"
      echo "phase: T0 P2 (specs/0001-bootstrap.md) build.log; run at $NOW"
      echo "temporary files live in <scratch> and are deleted on exit"
      echo
      echo "## script"
      sed 's/^/    /' "$0"
      echo
      echo "## toolchain installs made for P2, before this run (captured rustup output, not re-run)"
      echo "1. Unplanned: the implementing session's probe 'rustup +1.98.1 target list --installed'"
      echo "   auto-installed toolchain 1.98.1-x86_64-unknown-linux-gnu. rustup printed:"
      sed 's/^/    /' "$AUTO_INSTALL_OUT"
      echo "   Finding: the spec pins channel 1.98.1, and rustup treats that as a toolchain separate"
      echo "   from stable even though stable is also rustc 1.98.1. The probe therefore installed it"
      echo "   without the plan the CLAUDE.md Elevation section requires."
      echo "2. Planned, after the maintainer chose it in the implementing session:"
      echo "   command: rustup target add --toolchain 1.98.1-x86_64-unknown-linux-gnu $I686"
      sed 's/^/    /' "$TARGET_ADD_OUT"
      echo "3. Toolchain state before and after, and which P2 commands ran without RUSTUP_AUTO_INSTALL=0:"
      sed 's/^/    /' "$TOOLCHAINS_TXT"
      echo
      echo "## guard in this run"
      echo "RUSTUP_AUTO_INSTALL=${RUSTUP_AUTO_INSTALL} (exported by this script for every rustup and cargo command below)"
      echo
      echo "## toolchain in use"
      echo "rustup show active-toolchain: $(rustup show active-toolchain 2>&1)"
      echo "rustc --version: $(rustc --version 2>&1)"
      echo "cargo --version: $(cargo --version 2>&1)"
      echo "rustup target list --installed: $(rustup target list --installed 2>&1 | tr '\n' ' ')"
      step clean cargo clean
      step host-build cargo build --workspace --all-targets
      step host-test cargo test --workspace
      step i686-build cargo build --workspace --all-targets --target "$I686"
      step i686-test cargo test --workspace --target "$I686"
      echo
      echo "## summary"
      for s in host-test i686-test; do
        ran=$(/usr/bin/grep -c -E '^running [1-9][0-9]* tests?$' "$T/out-$s"); r1=$?
        ok=$(/usr/bin/grep -c -E '^test result: ok\. [1-9][0-9]* passed' "$T/out-$s"); r2=$?
        echo "$s: result lines with at least one passed test = ${ok:-none} (grep exit $r2); 'running N test' lines with N >= 1 = ${ran:-none} (grep exit $r1)"
        { [ "$r1" -eq 0 ] && [ "$r2" -eq 0 ]; } || fail=1
      done
      echo "all steps exit 0 and both targets ran at least one passing test: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    } > "$D/build.log" 2>&1
    
    bin=$(sed -n "s|^ *Running unittests src/main.rs (\(target/$I686/debug/deps/xlsx_diff-[0-9a-f]*\))$|\1|p" "$T/out-i686-test" | head -1)
    {
      echo "$HEADLINE"
      echo "phase: T0 P2 (specs/0001-bootstrap.md) binary.log; run at $NOW"
      echo "The i686 unit-test binary, taken from the i686-test step's 'Running unittests' line in build.log."
      echo "test binary: ${bin:-NOT FOUND}"
      if [ -n "$bin" ]; then
        echo "command: file $bin"
        file "$bin"; echo "exit: $?"
        echo "command: sha256sum $bin"
        sha256sum "$bin"
      else
        fail=1
      fi
    } > "$D/binary.log" 2>&1
    
    {
      echo "$HEADLINE"
      echo "phase: T0 P2 (specs/0001-bootstrap.md) ignore.log; run at $NOW"
      echo "check-ignore exits 0 when the path is ignored and 1 when it is not."
      for spec in "a.xlsx:ignored" "sub/b.xlsm:ignored" "tools/x/tests/fixtures/c.xlsx:not ignored"; do
        p=${spec%%:*}; want=${spec#*:}
        echo
        echo "command: git check-ignore -v $p"
        git check-ignore -v "$p"; rv=$?
        echo "exit: $rv"
        echo "command: git check-ignore --no-index -v --non-matching $p"
        git check-ignore --no-index -v --non-matching "$p"
        git check-ignore -q "$p"; rq=$?
        if [ "$rq" -eq 0 ]; then got=ignored; elif [ "$rq" -eq 1 ]; then got="not ignored"; else got="error $rq"; fi
        echo "$p: $got (expected: $want) -> $([ "$got" = "$want" ] && echo as-expected || echo UNEXPECTED)"
        [ "$got" = "$want" ] || fail=1
      done
    } > "$D/ignore.log" 2>&1
    
    exit "$fail"

