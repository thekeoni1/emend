## script
    #!/usr/bin/env bash
    # T0 P3 negative tests for scripts/check.sh, in a clone outside the repo.
    # Usage: p3-negative.sh <phase commit>. Output goes to records/logs/t0-p3/negative.log.
    # The clone's real path is replaced by <scratch> in everything printed.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    C=${1:?phase commit required}
    REPO=$(pwd)
    G=/usr/bin/grep
    export RUSTUP_AUTO_INSTALL=0
    BASE=$(mktemp -d)
    CLONE=$BASE/emend
    trap 'rm -rf "$BASE"' EXIT
    fail=0
    
    hide() { sed -e "s|$CLONE|<scratch>/emend|g" -e "s|$BASE|<scratch>|g"; }
    
    echo "about: P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: T0 P3 (specs/0001-bootstrap.md) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "Every case runs in a fresh clone at <scratch>/emend, outside the repo, never committed."
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    
    # expect_line <output> <ERE> <label>: record whether a line matching ERE is present
    expect_line() {
      local n rc
      n=$(LC_ALL=C "$G" -c -E -e "$2" "$1"); rc=$?
      if [ "$rc" -ge 2 ]; then echo "  $3: grep error (exit $rc)"; fail=1; return; fi
      echo "  $3: count=${n:-0} grep exit=$rc -> $([ "$rc" -eq 0 ] && echo present || echo ABSENT)"
      [ "$rc" -eq 0 ] || fail=1
    }
    
    # case_run <name> <description> <sed expression>: fresh clone, apply the edit, run the gate
    case_run() {
      local name=$1 desc=$2 expr=$3 rc
      echo
      echo "## case $name: $desc"
      rm -rf "$CLONE"
      git clone -q "$REPO" "$CLONE" && git -C "$CLONE" checkout -q "$C" || { echo "clone failed"; fail=1; return; }
      echo "clone at $C: $(git -C "$CLONE" rev-parse HEAD)"
      echo "command: sed -i -e '$expr' tools/xlsx-diff/src/main.rs"
      sed -i -e "$expr" "$CLONE/tools/xlsx-diff/src/main.rs"
      echo "command: git diff (the edit)"
      git -C "$CLONE" diff | hide | sed 's/^/    /'
      if git -C "$CLONE" diff --quiet; then echo "  EDIT DID NOT APPLY"; fail=1; fi
      echo "command: scripts/check.sh (in the clone)"
      (cd "$CLONE" && scripts/check.sh) > "$BASE/$name.out" 2>&1
      rc=$?
      hide < "$BASE/$name.out" | sed 's/^/    /'
      echo "  exit: $rc (expect non-zero) -> $([ "$rc" -ne 0 ] && echo as-expected || echo UNEXPECTED)"
      [ "$rc" -ne 0 ] || fail=1
    }
    
    case_run a "misformat a line; expect FAIL fmt" 's/^fn main() -> ExitCode {$/fn main()   ->   ExitCode {/'
    expect_line "$BASE/a.out" '^PASS host$' "PASS host before fmt"
    expect_line "$BASE/a.out" '^PASS i686$' "PASS i686 before fmt"
    expect_line "$BASE/a.out" '^FAIL fmt: ' "FAIL fmt"
    
    case_run b "compile the test out on x86 only, so i686 runs zero tests; expect FAIL i686" 's/^    #\[test\]$/    #[cfg(not(target_arch = "x86"))]\n    #[test]/'
    expect_line "$BASE/b.out" '^PASS host$' "PASS host (the test still runs on the host)"
    expect_line "$BASE/b.out" '^FAIL i686: zero tests executed' "FAIL i686: zero tests executed"
    
    case_run c "add a failing assertion; expect FAIL host" 's/assert_eq!(status, 2);/assert_eq!(status, 3);/'
    expect_line "$BASE/c.out" '^FAIL host: ' "FAIL host"
    
    echo
    rm -rf "$CLONE"
    echo "scratch clone removed: $([ -e "$CLONE" ] && echo no || echo yes)"
    echo "main working tree status (expect empty): $(git status --porcelain -- . ':!records/logs/t0-p3' | tr '\n' ' ')"
    echo "all negative cases as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

