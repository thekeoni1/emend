## script that wrote this log
    #!/usr/bin/env bash
    # T0 P5 gate log and toolchain record.
    # Usage: p5-logs.sh <phase commit> <toolchain record scratch file> > <gate log scratch file>
    # The caller moves both files into the repo afterwards, so nothing is written in the
    # working tree while this runs. The toolchain record is written only if the gate passes.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    C=${1:?phase commit required}
    RECORD=${2:?toolchain record scratch file required}
    ROOT=$(pwd)
    I686=i686-unknown-linux-musl
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    if [ -n "$(git status --porcelain)" ]; then echo "working tree not clean" >&2; exit 2; fi
    
    f_ctrl()     { LC_ALL=C /usr/bin/grep -a -c -P '[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]' "$1"; }
    ctrl_bytes() { LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177' < "$1" | wc -c; }
    
    echo "about: P5 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: T0 P5 (specs/0001-bootstrap.md) gate.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "working tree clean before the run: yes (the script exits 2 otherwise); output goes to <scratch> and is moved in afterwards"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$0"
    echo
    echo "## gate files at $C"
    for f in scripts/check.sh scripts/sys-allowlist.txt; do
      echo "$f on disk sha256 $(sha256sum "$f" | cut -d' ' -f1); at $C sha256 $(git show "$C:$f" | sha256sum | cut -d' ' -f1); bytes $(wc -c < "$f")"
    done
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR"
    echo
    echo "## full run on a cold cache, started from / by absolute path"
    echo "command: cargo clean"
    cargo clean 2>&1 | sed 's/^/    /'
    echo "command: (cd / && <repo>/scripts/check.sh)"
    (cd / && "$ROOT/scripts/check.sh") > "$T/out" 2> "$T/err"
    rc=$?
    echo "stdout:"
    sed 's/^/    /' "$T/out"
    echo "stderr bytes: $(wc -c < "$T/err")"
    echo "exit: $rc (expect 0)"
    [ "$rc" -eq 0 ] || fail=1
    want="PASS host|PASS i686|PASS fmt|PASS clippy|PASS native (allowlisted -sys: none)|PASS licences|PASS hygiene|"
    got=$(tr '\n' '|' < "$T/out")
    echo "stdout is exactly the seven PASS lines in order: $([ "$got" = "$want" ] && echo yes || echo no)"
    [ "$got" = "$want" ] || fail=1
    echo
    echo "## control characters in the captured output (tab, LF and CR allowed)"
    printf 'x \033[31mred\033[m\017 y\n' > "$T/ctl"
    printf 'plain\ttab\r\n' > "$T/clean"
    echo "control: ESC and SI file -> lines=$(f_ctrl "$T/ctl") bytes=$(ctrl_bytes "$T/ctl") (expect lines 1, bytes 3)"
    [ "$(ctrl_bytes "$T/ctl")" -eq 3 ] || fail=1
    echo "control: tab and CR file -> lines=$(f_ctrl "$T/clean") bytes=$(ctrl_bytes "$T/clean") (expect 0 and 0)"
    [ "$(ctrl_bytes "$T/clean")" -eq 0 ] || fail=1
    for s in out err; do
      echo "std$s: lines=$(f_ctrl "$T/$s") bytes=$(ctrl_bytes "$T/$s") (expect 0 and 0)"
      [ "$(ctrl_bytes "$T/$s")" -eq 0 ] || fail=1
    done
    echo
    echo "## facts for the toolchain record"
    tc=$(rustup show active-toolchain 2>&1 | sed "s|$ROOT/||")
    targets=$(rustup target list --installed 2>&1 | tr '\n' ' ' | sed 's/ $//')
    echo "command: cargo test --workspace --target $I686 --no-run"
    cargo test --workspace --target "$I686" --no-run > "$T/norun" 2>&1; nrc=$?
    sed "s|$ROOT/||g; s/^/    /" "$T/norun"
    echo "exit: $nrc"
    [ "$nrc" -eq 0 ] || fail=1
    bin=$(sed -n "s|^ *Executable unittests src/main.rs (\(target/$I686/debug/deps/xlsx_diff-[0-9a-f]*\))$|\1|p" "$T/norun" | head -1)
    echo "i686 test binary: ${bin:-NOT FOUND}"
    [ -n "$bin" ] || fail=1
    fileout=$( [ -n "$bin" ] && file "$bin" )
    echo "command: file $bin"
    echo "    $fileout"
    echo "command: rustc -vV"; rustc -vV | sed 's/^/    /'
    echo "command: cargo -V"; cargo -V | sed 's/^/    /'
    echo "active toolchain: $tc"
    echo "installed targets: $targets"
    echo "command: uname -r"; uname -r | sed 's/^/    /'
    echo
    echo "status after the run (expect empty): $(git status --porcelain | tr '\n' ' ')"
    [ -z "$(git status --porcelain)" ] || fail=1
    echo "gate log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    
    if [ "$fail" -eq 0 ]; then
      {
        echo "# Toolchain record, $(date -u +%Y-%m-%d) (UTC)"
        echo
        echo "Written by the T0 P5 log script from the same run as"
        echo "records/logs/t0-p5/gate.log. No toolchain or target was installed in P5."
        echo
        echo "- Full gate (all seven steps) passed at: $C"
        echo "- rustc: $(rustc -V)"
        rustc -vV | sed -n 's/^\(host\|release\|commit-hash\|LLVM version\): /  - \1: /p'
        echo "- cargo: $(cargo -V)"
        echo "- Active toolchain: $tc"
        echo "- Installed targets for that toolchain: $targets"
        echo "- Kernel (\`uname -r\`): $(uname -r)"
        echo "- i686 test binary (\`file\`): $fileout"
        echo "- Guard: every rustup and cargo command ran with RUSTUP_AUTO_INSTALL=0 and CARGO_TERM_COLOR=never."
      } > "$RECORD"
      echo "toolchain record written: yes"
    else
      echo "toolchain record written: no (the gate or a check failed)"
    fi
    exit "$fail"

