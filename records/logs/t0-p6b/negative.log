## script
    #!/usr/bin/env bash
    # T0 P6b negative tests: the hardened scripts/privacy.sh, steps 7 and 8 of
    # scripts/check.sh, and the pre-push hook. A control case 0, cases (a) to (j)
    # from the spec, and cases (k) and (l) beyond it.
    # Every case runs in a scratch clone outside the repo, with a scratch denylist
    # holding a made-up sentinel word (EMEND_PRIVATE_DENYLIST, exported inside this
    # negative test only). Fixture values (sentinels, fake token, email addresses,
    # Windows and Claude Code paths) are built at run time and never printed.
    # Every captured output is counted for them and for the fixture file names.
    # Usage: p6b-negative.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/t0-p6b/negative.log. Paths print as <scratch>.
    # DRYRUN_DIR, if set, copies the gate scripts from that directory into each
    # clone (dry runs only).
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    C=${1:?phase commit required}
    REPO=$(pwd)
    G=/usr/bin/grep
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    unset EMEND_PRIVATE_DENYLIST GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE
    BASE=$(mktemp -d)
    trap 'rm -rf "$BASE"' EXIT
    fail=0
    RC=0
    GATE_FILES="check.sh privacy.sh privacy-patterns.txt privacy-identity.txt install-hooks.sh"
    
    rnd() { LC_ALL=C tr -dc "$1" </dev/urandom | head -c "$2"; }
    SENTINEL="zq$(rnd 'a-z0-9' 12)"
    SENTINEL2="zq$(rnd 'a-z0-9' 12)"
    TOKEN="gh""p_$(rnd 'A-Za-z0-9' 36)"
    EMAIL_COM="zq$(rnd 'a-z0-9' 8)@exam""ple.com"
    EMAIL_INVALID="zq$(rnd 'a-z0-9' 8)@exam""ple.invalid"
    WINPATH="D:""\\Users\\zq$(rnd 'a-z0-9' 6)\\Documents"
    CLAUDEPATH="/home/zq$(rnd 'a-z0-9' 6)/"".claude""/projects/-home-zq/$(rnd 'a-f0-9' 8).jsonl"
    FORBIDDEN=("$SENTINEL" "$SENTINEL2" "$TOKEN" "$EMAIL_COM" "$EMAIL_INVALID" "$WINPATH" "$CLAUDEPATH"
      private.xlsx report.XLSX sample.xlsx budget.xlsx notes.xls)
    DL=$BASE/denylist
    printf '# scratch denylist for the T0 P6b negative tests\n%s\n' "$SENTINEL" >"$DL"
    chmod 600 "$DL"
    export EMEND_PRIVATE_DENYLIST=$DL
    NOTICE_LINE="NOTICE privacy: using the denylist from EMEND_PRIVATE_DENYLIST"
    
    hide() {
      local line f
      while IFS= read -r line || [ -n "$line" ]; do
        line=${line//"$BASE"/<scratch>}
        for f in "${FORBIDDEN[@]}"; do line=${line//"$f"/<fixture>}; done
        printf '%s\n' "$line"
      done
    }
    count_forbidden() { LC_ALL=C "$G" -a -c -F -f <(printf '%s\n' "${FORBIDDEN[@]}") "$1"; }
    count_f() { LC_ALL=C "$G" -a -c -F -e "$1" "$2"; }
    ctrl_bytes() { LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177' <"$1" | wc -c; }
    nonascii_bytes() { LC_ALL=C tr -cd '\200-\377' <"$1" | wc -c; }
    in_dir() { local d=$1; shift; (cd "$d" && "$@"); }
    
    echo "about: P6b phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: T0 P6b (specs/0001-bootstrap.md) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "Every case runs in a scratch clone under <scratch>, outside the repo."
    if [ -n "${DRYRUN_DIR:-}" ]; then
      echo "DRY RUN: DRYRUN_DIR is set, so each clone gets uncommitted gate scripts. Not a phase log."
    else
      echo "DRYRUN_DIR is not set: each clone runs the scripts committed at $C."
    fi
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)"
    echo "scratch denylist: <scratch>/denylist, mode $(stat -c %a "$DL"), $(LC_ALL=C "$G" -c -v -E '^[[:space:]]*(#|$)' "$DL") entry (never printed)"
    echo "EMEND_PRIVATE_DENYLIST: exported to <scratch>/denylist inside this negative test only"
    echo "fixture strings counted in every captured output: ${#FORBIDDEN[@]} (two sentinels, a fake token, two email addresses, a Windows user path, a Claude Code project path, five fixture file names; values never printed)"
    REFS_BEFORE=$(git for-each-ref --format='%(objectname) %(refname)' | sha256sum | cut -d' ' -f1)
    echo "main repository refs sha256 before: $REFS_BEFORE"
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    
    echo
    echo "## counter controls"
    printf '%s\n' "${FORBIDDEN[@]}" >"$BASE/ctl-forbidden"
    printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$BASE/ctl-bytes"
    printf 'plain\ttab\r\n' >"$BASE/ctl-clean"
    hide <"$BASE/ctl-forbidden" >"$BASE/ctl-hidden"
    ctl() { echo "  control $1: $2 (expect $3)"; [ "$2" = "$3" ] || fail=1; }
    ctl "lines with a fixture string in a file holding each once" "$(count_forbidden "$BASE/ctl-forbidden")" "${#FORBIDDEN[@]}"
    ctl "lines with a fixture string in a clean file" "$(count_forbidden "$BASE/ctl-clean")" 0
    ctl "lines with a fixture string after hide()" "$(count_forbidden "$BASE/ctl-hidden")" 0
    ctl "lines reading <fixture> after hide()" "$(count_f '<fixture>' "$BASE/ctl-hidden")" "${#FORBIDDEN[@]}"
    ctl "control bytes in a file with ESC, ESC and SI" "$(ctrl_bytes "$BASE/ctl-bytes")" 3
    ctl "non-ASCII bytes in a file with one two-byte character" "$(nonascii_bytes "$BASE/ctl-bytes")" 2
    ctl "control bytes in a file with only tab, CR and LF" "$(ctrl_bytes "$BASE/ctl-clean")" 0
    
    clone() { # clone <dir>
      local dir=$1
      rm -rf "$dir"
      if ! git clone -q "$REPO" "$dir" || ! git -C "$dir" checkout -q -B work "$C"; then
        echo "clone failed"
        fail=1
        return 1
      fi
      if [ -n "${DRYRUN_DIR:-}" ]; then
        for f in $GATE_FILES; do cp "$DRYRUN_DIR/$f" "$dir/scripts/$f"; done
      fi
      git -C "$dir" config user.name "$(sed -n 1p "$dir/scripts/privacy-identity.txt")"
      git -C "$dir" config user.email "$(sed -n 2p "$dir/scripts/privacy-identity.txt")"
      echo "clone $(printf '%s' "$dir" | hide): branch work at $(git -C "$dir" rev-parse HEAD); local identity set from scripts/privacy-identity.txt"
    }
    commit() { # commit <dir> <git commit args...>
      local dir=$1
      shift
      git -C "$dir" -c commit.gpgsign=false commit -q "$@" || { echo "commit failed"; fail=1; }
    }
    run_out() { # run_out <name> <shown command> <command...>
      local name=$1 shown=$2 fb c n
      shift 2
      echo "command: $shown"
      "$@" >"$BASE/$name.out" 2>&1 </dev/null
      RC=$?
      hide <"$BASE/$name.out" | sed 's/^/    /'
      echo "  exit: $RC"
      fb=$(count_forbidden "$BASE/$name.out")
      c=$(ctrl_bytes "$BASE/$name.out")
      n=$(nonascii_bytes "$BASE/$name.out")
      echo "  captured output: lines with a fixture string=$fb, control bytes=$c, non-ASCII bytes=$n (expect 0, 0 and 0)"
      { [ "$fb" -eq 0 ] && [ "$c" -eq 0 ] && [ "$n" -eq 0 ]; } || fail=1
    }
    want_exit() {
      echo "  exit $1 expected: $([ "$RC" -eq "$1" ] && echo as-expected || echo UNEXPECTED)"
      [ "$RC" -eq "$1" ] || fail=1
    }
    want_nonzero() {
      echo "  exit non-zero expected: $([ "$RC" -ne 0 ] && echo as-expected || echo UNEXPECTED)"
      [ "$RC" -ne 0 ] || fail=1
    }
    expect() { # expect <name> <present|absent> <ERE> <label>
      local n rc want
      n=$(LC_ALL=C "$G" -c -E -e "$3" "$BASE/$1.out")
      rc=$?
      if [ "$rc" -ge 2 ]; then echo "  $4: grep error (exit $rc)"; fail=1; return; fi
      if [ "$2" = present ]; then want=0; else want=1; fi
      echo "  $4: expect $2; count=${n:-0} grep exit=$rc -> $([ "$rc" -eq "$want" ] && echo as-expected || echo UNEXPECTED)"
      [ "$rc" -eq "$want" ] || fail=1
    }
    lines_are() { # lines_are <name> <ERE> <count> <label>
      local n
      n=$(LC_ALL=C "$G" -c -E -e "$2" "$BASE/$1.out")
      echo "  $4: count=$n (expect $3) -> $([ "$n" = "$3" ] && echo as-expected || echo UNEXPECTED)"
      [ "$n" = "$3" ] || fail=1
    }
    first_line() { # first_line <name> <exact line>
      local first
      first=$(head -n 1 "$BASE/$1.out")
      echo "  first output line is the NOTICE line: $([ "$first" = "$2" ] && echo as-expected || echo UNEXPECTED)"
      [ "$first" = "$2" ] || fail=1
    }
    PRIV="scripts/privacy.sh (in the clone; EMEND_PRIVATE_DENYLIST=<scratch>/denylist)"
    
    echo
    echo "## case 0 (control): an unchanged clone; expect the NOTICE line, then PASS privacy"
    D=$BASE/c0
    clone "$D"
    run_out c0 "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 0
    first_line c0 "$NOTICE_LINE"
    expect c0 present '^PASS privacy$' "PASS privacy"
    expect c0 absent '^(FAIL|ERROR) ' "any FAIL or ERROR line"
    
    echo
    echo "## case a: a gzip-compressed emend-testing/corpus/private.xlsx, committed then deleted; expect FAIL naming the first commit, no path printed"
    D=$BASE/a
    clone "$D"
    mkdir -p "$D/emend-testing/corpus"
    printf 'fictional corpus text %s\n' "$(rnd 'a-z' 16)" | gzip -c >"$D/emend-testing/corpus/private.xlsx"
    git -C "$D" add -f emend-testing/corpus/private.xlsx
    commit "$D" -m "case a: add"
    A1=$(git -C "$D" rev-parse HEAD)
    echo "first commit $A1; first two bytes of the committed blob (gzip magic is 1f 8b):$(git -C "$D" cat-file blob "$A1:emend-testing/corpus/private.xlsx" | od -An -tx1 -N2)"
    git -C "$D" rm -q -r emend-testing
    commit "$D" -m "case a: delete"
    A2=$(git -C "$D" rev-parse HEAD)
    echo "second commit $A2; paths containing emend-testing in its tree: $(git -C "$D" ls-tree -r --name-only "$A2" | LC_ALL=C "$G" -c -i -F -e emend-testing)"
    run_out a "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 1
    expect a present "^FAIL paths: commit $A1 1 path[(]s[)] containing emend-testing [(]paths not printed[)]\$" "count-only corpus FAIL naming the first commit"
    expect a present "^FAIL paths: commit $A1 1 office file path[(]s[)] outside tests/fixtures/ [(]paths not printed[)]\$" "count-only office FAIL naming the first commit"
    expect a absent "commit $A2" "the second commit"
    expect a absent 'corpus/' "a corpus path"
    lines_are a '^FAIL ' 2 "FAIL lines"
    
    echo
    echo "## case b: report.XLSX at the root, committed then deleted; expect FAIL"
    D=$BASE/b
    clone "$D"
    printf 'quarterly figures (fictional)\n' >"$D/report.XLSX"
    git -C "$D" add -f report.XLSX
    commit "$D" -m "case b: add"
    B1=$(git -C "$D" rev-parse HEAD)
    git -C "$D" rm -q report.XLSX
    commit "$D" -m "case b: delete"
    B2=$(git -C "$D" rev-parse HEAD)
    echo "first commit $B1; second commit $B2"
    run_out b "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 1
    expect b present "^FAIL paths: commit $B1 1 office file path[(]s[)] outside tests/fixtures/ [(]paths not printed[)]\$" "count-only office FAIL naming the first commit"
    expect b absent "commit $B2" "the second commit"
    lines_are b '^FAIL ' 1 "FAIL lines"
    
    echo
    echo "## case c: an office file under tools/x/tests/fixtures/; expect PASS"
    D=$BASE/c
    clone "$D"
    mkdir -p "$D/tools/x/tests/fixtures"
    printf 'generated fixture stand-in\n' >"$D/tools/x/tests/fixtures/sample.xlsx"
    git -C "$D" add -f tools/x/tests/fixtures/sample.xlsx
    commit "$D" -m "case c"
    echo "commit $(git -C "$D" rev-parse HEAD); office files under tests/fixtures/ in its tree: $(git -C "$D" ls-tree -r --name-only HEAD | LC_ALL=C "$G" -c -E -e '(^|/)tests/fixtures/.*[.]xlsx$')"
    run_out c "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 0
    expect c present '^PASS privacy$' "PASS privacy"
    expect c absent '^(FAIL|ERROR) ' "any FAIL or ERROR line"
    
    echo
    echo "## case d: EMEND_PRIVATE_DENYLIST exported"
    D=$BASE/d
    clone "$D"
    echo "### d1: scripts/privacy.sh prints the NOTICE line first"
    run_out d1 "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 0
    first_line d1 "$NOTICE_LINE"
    echo "### d2: scripts/check.sh step 8 refuses"
    run_out d2 "scripts/check.sh (in the clone; EMEND_PRIVATE_DENYLIST exported)" in_dir "$D" scripts/check.sh
    want_exit 1
    expect d2 present '^FAIL privacy: EMEND_PRIVATE_DENYLIST is set$' "FAIL privacy line"
    expect d2 present '^PASS hygiene$' "steps 1 to 7 ran first (PASS hygiene)"
    expect d2 absent '^PASS privacy$' "PASS privacy"
    echo "### d3: the pre-push hook refuses, and a push to a local bare remote is rejected"
    git init -q --bare "$BASE/remote.git"
    git -C "$D" remote add scratch "$BASE/remote.git"
    run_out d3-install "scripts/install-hooks.sh (in the clone)" in_dir "$D" scripts/install-hooks.sh
    want_exit 0
    ls_remote() { git ls-remote "$BASE/remote.git" >"$BASE/ls-$1.out" 2>&1; echo "git ls-remote <scratch>/remote.git ($1):"; hide <"$BASE/ls-$1.out" | sed 's/^/    /'; echo "  refs: $(wc -l <"$BASE/ls-$1.out")"; }
    ls_remote before-d3
    run_out d3 "git push scratch work:refs/heads/clean (in the clone; EMEND_PRIVATE_DENYLIST exported)" in_dir "$D" git push scratch work:refs/heads/clean
    want_nonzero
    expect d3 present '^FAIL privacy: EMEND_PRIVATE_DENYLIST is set$' "hook FAIL privacy line"
    expect d3 absent '^pre-push: scripts/privacy' "the hook running privacy.sh"
    ls_remote after-d3
    lines_are ls-after-d3 '' 0 "remote refs"
    echo "### d4 (beyond the spec): the same push with the variable removed for that one command; expect success"
    echo "(scripts/privacy.sh then reads the private denylist at its default path; its output is locations only)"
    run_out d4 "env -u EMEND_PRIVATE_DENYLIST git push scratch work:refs/heads/clean (in the clone)" in_dir "$D" env -u EMEND_PRIVATE_DENYLIST git push scratch work:refs/heads/clean
    want_exit 0
    expect d4 present '^PASS privacy$' "PASS privacy"
    expect d4 absent '^NOTICE ' "NOTICE line"
    ls_remote after-d4
    expect ls-after-d4 present "^$C	refs/heads/clean\$" "remote refs/heads/clean at the phase commit"
    
    echo
    echo "## case e: the patterns file with one pattern removed (each in turn), or one extra line; expect exit 2 each"
    D=$BASE/e
    clone "$D"
    cp "$D/scripts/privacy-patterns.txt" "$BASE/patterns-orig"
    NPAT=$(LC_ALL=C "$G" -c -v -E '^[[:space:]]*(#|$)' "$BASE/patterns-orig")
    echo "patterns in the committed file: $NPAT"
    for i in $(seq 1 "$NPAT"); do
      echo "### e-remove-$i: pattern $i removed"
      sed "${i}d" "$BASE/patterns-orig" >"$D/scripts/privacy-patterns.txt"
      run_out "e-remove-$i" "$PRIV" in_dir "$D" scripts/privacy.sh
      want_exit 2
      expect "e-remove-$i" present "^ERROR privacy: scripts/privacy-patterns[.]txt holds $((NPAT - 1)) pattern[(]s[)]; expected $NPAT\$" "ERROR pattern count"
    done
    echo "### e-extra: one extra pattern line"
    { cat "$BASE/patterns-orig"; echo 'zq[-]extra[-]pattern'; } >"$D/scripts/privacy-patterns.txt"
    run_out e-extra "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 2
    expect e-extra present "^ERROR privacy: scripts/privacy-patterns[.]txt holds $((NPAT + 1)) pattern[(]s[)]; expected $NPAT\$" "ERROR pattern count"
    for i in $(seq 1 "$NPAT"); do
      echo "### e-disable-$i (beyond the spec): pattern $i replaced by a pattern that matches nothing planted"
      sed "${i}s/.*/zq[-]disabled[-]pattern/" "$BASE/patterns-orig" >"$D/scripts/privacy-patterns.txt"
      run_out "e-disable-$i" "$PRIV" in_dir "$D" scripts/privacy.sh
      want_exit 2
      expect "e-disable-$i" present "^ERROR privacy: self-test failed: pattern $i did not detect its fake value\$" "ERROR naming pattern $i"
    done
    cp "$BASE/patterns-orig" "$D/scripts/privacy-patterns.txt"
    
    echo
    echo "## case f: a denylist entry containing a space; expect exit 2"
    D=$BASE/f
    clone "$D"
    printf '%s %s\n' "$SENTINEL" "$SENTINEL2" >"$BASE/denylist-space" && chmod 600 "$BASE/denylist-space"
    echo "<scratch>/denylist-space: mode $(stat -c %a "$BASE/denylist-space"), one line holding two words"
    run_out f "env EMEND_PRIVATE_DENYLIST=<scratch>/denylist-space scripts/privacy.sh (in the clone)" \
      in_dir "$D" env EMEND_PRIVATE_DENYLIST="$BASE/denylist-space" scripts/privacy.sh
    want_exit 2
    expect f present '^ERROR privacy: denylist entry 1 contains whitespace$' "ERROR line"
    expect f absent '^PASS privacy$' "PASS privacy"
    
    echo
    echo "## case g: email addresses built at run time"
    echo "### g1: an address at example.com in a committed file; expect FAIL"
    D=$BASE/g1
    clone "$D"
    printf 'contact: %s\n' "$EMAIL_COM" >"$D/g1.txt"
    git -C "$D" add g1.txt
    commit "$D" -m "case g1"
    G1=$(git -C "$D" rev-parse HEAD)
    run_out g1 "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 1
    expect g1 present "^FAIL email: commit $G1 path g1[.]txt line 1\$" "FAIL email naming the file and line"
    lines_are g1 '^FAIL ' 1 "FAIL lines"
    echo "### g2: the same address in a commit message; expect FAIL"
    D=$BASE/g2
    clone "$D"
    printf 'case g2\n' >"$D/g2.txt"
    git -C "$D" add g2.txt
    commit "$D" -m "case g2" -m "contact: $EMAIL_COM"
    G2=$(git -C "$D" rev-parse HEAD)
    run_out g2 "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 1
    expect g2 present "^FAIL message: commit $G2 email line 3\$" "FAIL message email naming the line"
    lines_are g2 '^FAIL ' 1 "FAIL lines"
    echo "### g3: an address at example.invalid in a committed file and in its message; expect PASS"
    D=$BASE/g3
    clone "$D"
    printf 'contact: %s\n' "$EMAIL_INVALID" >"$D/g3.txt"
    git -C "$D" add g3.txt
    commit "$D" -m "case g3" -m "contact: $EMAIL_INVALID"
    run_out g3 "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 0
    expect g3 present '^PASS privacy$' "PASS privacy"
    expect g3 absent '^(FAIL|ERROR) ' "any FAIL or ERROR line"
    
    echo
    echo "## case h: a drive-letter Windows user path and a Claude Code project path, built at run time in a committed file; expect FAIL patterns"
    D=$BASE/h
    clone "$D"
    printf 'backup %s\n' "$WINPATH" >"$D/h.txt"
    printf 'transcript %s\n' "$CLAUDEPATH" >>"$D/h.txt"
    git -C "$D" add h.txt
    commit "$D" -m "case h"
    H=$(git -C "$D" rev-parse HEAD)
    run_out h "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 1
    expect h present "^FAIL patterns: commit $H path h[.]txt pattern 10 line 1\$" "FAIL pattern 10 on line 1"
    expect h present "^FAIL patterns: commit $H path h[.]txt pattern 11 line 2\$" "FAIL pattern 11 on line 2"
    lines_are h '^FAIL ' 2 "FAIL lines"
    
    echo
    echo "## case i: a tracked office file under Emend-Testing/; expect a count-only step 7 FAIL line with no file name"
    D=$BASE/i
    clone "$D"
    mkdir -p "$D/Emend-Testing"
    printf 'fictional\n' >"$D/Emend-Testing/budget.xlsx"
    git -C "$D" add -f Emend-Testing/budget.xlsx
    echo "staged paths: $(git -C "$D" diff --cached --name-only | wc -l)"
    run_out i "scripts/check.sh (in the clone)" in_dir "$D" scripts/check.sh
    want_nonzero
    expect i present '^FAIL hygiene: 1 office file[(]s[)] tracked outside tests/fixtures/ [(]paths not printed[)]$' "count-only office FAIL line"
    expect i absent '^PASS hygiene$' "PASS hygiene"
    expect i absent 'Emend-Testing' "the directory name"
    
    echo
    echo "## case j: P6 negatives (a), (c) and (h) again; expect each still to fail"
    echo "### j-a: a commit authored with a different email"
    D=$BASE/ja
    clone "$D"
    printf 'case j-a\n' >"$D/a.txt"
    git -C "$D" add a.txt
    commit "$D" --author="$(sed -n 1p "$D/scripts/privacy-identity.txt") <someone-else@example.invalid>" -m "case j-a"
    JA=$(git -C "$D" rev-parse HEAD)
    run_out ja "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 1
    expect ja present "^FAIL identity: commit $JA author email differs from scripts/privacy-identity[.]txt\$" "FAIL identity"
    lines_are ja '^FAIL ' 1 "FAIL lines"
    echo "### j-c: the sentinel committed, then deleted"
    D=$BASE/jc
    clone "$D"
    printf 'case j-c %s\n' "$SENTINEL" >"$D/c.txt"
    git -C "$D" add c.txt
    commit "$D" -m "case j-c: add"
    JC1=$(git -C "$D" rev-parse HEAD)
    git -C "$D" rm -q c.txt
    commit "$D" -m "case j-c: delete"
    JC2=$(git -C "$D" rev-parse HEAD)
    run_out jc "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 1
    expect jc present "^FAIL denylist: commit $JC1 path c[.]txt denylist entry 1 line 1\$" "FAIL denylist naming the first commit"
    expect jc absent "commit $JC2" "the second commit"
    echo "### j-h: '* binary' in .git/info/attributes and a committed fake token"
    D=$BASE/jh
    clone "$D"
    printf '* binary\n' >"$D/.git/info/attributes"
    printf 'token %s\n' "$TOKEN" >"$D/h.txt"
    git -C "$D" add h.txt
    commit "$D" -m "case j-h"
    JH=$(git -C "$D" rev-parse HEAD)
    echo "git check-attr binary -- h.txt: $(git -C "$D" check-attr binary -- h.txt)"
    run_out jh "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 1
    expect jh present "^FAIL patterns: commit $JH path h[.]txt pattern 1 line 1\$" "FAIL patterns"
    
    echo
    echo "## case k (beyond the spec): a fake token inside an office file outside tests/fixtures/; expect <office path>"
    D=$BASE/k
    clone "$D"
    printf 'token %s\n' "$TOKEN" >"$D/notes.xls"
    git -C "$D" add -f notes.xls
    commit "$D" -m "case k"
    K=$(git -C "$D" rev-parse HEAD)
    run_out k "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 1
    expect k present "^FAIL patterns: commit $K path <office path> pattern 1 line 1\$" "FAIL patterns with <office path>"
    expect k present "^FAIL paths: commit $K 1 office file path[(]s[)] outside tests/fixtures/ [(]paths not printed[)]\$" "count-only office FAIL"
    lines_are k '^FAIL ' 2 "FAIL lines"
    
    echo
    echo "## case l (beyond the spec): a fake token in a file whose name holds the sentinel; expect <private path>"
    D=$BASE/l
    clone "$D"
    printf 'token %s\n' "$TOKEN" >"$D/n-$SENTINEL.txt"
    git -C "$D" add .
    commit "$D" -m "case l"
    L=$(git -C "$D" rev-parse HEAD)
    run_out l "$PRIV" in_dir "$D" scripts/privacy.sh
    want_exit 1
    expect l present "^FAIL patterns: commit $L path <private path> pattern 1 line 1\$" "FAIL patterns with <private path>"
    expect l present "^FAIL paths: commit $L tree entry [0-9]+ denylist entry 1 [(]path not printed[)]\$" "FAIL paths"
    lines_are l '^FAIL ' 2 "FAIL lines"
    
    echo
    rm -rf "$BASE"/c0 "$BASE"/a "$BASE"/b "$BASE"/c "$BASE"/d "$BASE"/e "$BASE"/f "$BASE"/g1 "$BASE"/g2 "$BASE"/g3 "$BASE"/h "$BASE"/i "$BASE"/ja "$BASE"/jc "$BASE"/jh "$BASE"/k "$BASE"/l "$BASE"/remote.git
    LEFT=$(find "$BASE" -mindepth 1 -maxdepth 1 -type d | wc -l)
    echo "scratch clones removed: $LEFT directories left (expect 0)"
    [ "$LEFT" -eq 0 ] || fail=1
    REFS_AFTER=$(git for-each-ref --format='%(objectname) %(refname)' | sha256sum | cut -d' ' -f1)
    echo "main repository refs sha256 after: $REFS_AFTER; unchanged: $([ "$REFS_BEFORE" = "$REFS_AFTER" ] && echo yes || echo NO)"
    [ "$REFS_BEFORE" = "$REFS_AFTER" ] || fail=1
    echo "main working tree status (expect empty): $(git status --porcelain | tr '\n' ' ')"
    [ -z "$(git status --porcelain)" ] || fail=1
    echo "all negative cases as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

