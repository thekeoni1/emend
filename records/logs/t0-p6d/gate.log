    #!/usr/bin/env bash
    # T0 P6d gate log: the phase's commits, the changed files, the narrowed path
    # patterns, and a full run of all eight check.sh steps on a cold cache.
    # Usage: t0p6d-gate.sh <phase commit> [<stopped-run note>] > <gate log scratch file>
    # The note records an earlier run of this log that the environment stopped
    # (specs/0001 "Rules for every phase": start time, last completed check, reason).
    # The caller moves the file into records/logs/t0-p6d/ afterwards, so nothing is
    # written in the working tree while this runs. Each check is evaluated once and
    # that single result is printed; a check with more than one condition is
    # evaluated inside one function. The corpus directory's path is never printed.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    C=${1:?phase commit required}
    STOPPED=${2:-}
    ROOT=$(pwd)
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    unset EMEND_PRIVATE_DENYLIST
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    DENY_FILE=$HOME/.config/emend/private-denylist.txt
    BEFORE=2638d219f1c480f98594df72c78c0b1298da60c5
    PATTERNS=scripts/privacy-patterns.txt
    CHANGED=("$PATTERNS" scripts/privacy.sh ROADMAP.md specs/0002-gate-corpus-additions.md specs/0006-passthrough.md)
    # The three path patterns this phase narrows, by their line number in the file.
    # They are never written out here: a log must not carry a bare shape.
    NARROWED=(8 10 11)
    
    HEAD_AT_RUN=$(git rev-parse HEAD)
    # The log is about the phase commit. HEAD may sit above it only when every
    # commit in between touches records/logs/ alone, so the code under test is
    # byte-identical at both; anything else is refused.
    if [ "$HEAD_AT_RUN" != "$C" ]; then
      if ! git merge-base --is-ancestor "$C" "$HEAD_AT_RUN" ||
        [ -n "$(git diff --name-only "$C" "$HEAD_AT_RUN" -- . ':(exclude)records/logs/**')" ]; then
        echo "HEAD is $HEAD_AT_RUN, which is not $C and differs from it outside records/logs" >&2
        exit 2
      fi
    fi
    if [ -n "$(git status --porcelain)" ]; then echo "working tree not clean" >&2; exit 2; fi
    
    f_ctrl()     { LC_ALL=C /usr/bin/grep -a -c -P '[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]' "$1"; }
    ctrl_bytes() { LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177' < "$1" | wc -c; }
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    sha() { sha256sum | cut -c1-64; }
    # The class this phase requires after the trailing separator (planning's
    # ruling of 2026-09-16): a path character, or any byte that is not printable
    # ASCII and not whitespace.
    ADDED_CLASS='([A-Za-z0-9._-]|[^[:print:][:space:]])'
    # The self-test plants a home-shaped control fixture of its own; that one line
    # is exempt by its literal source text. FIXTURE_LINE is where it sits, printed
    # so a reader can find it.
    FIXTURE_LINE=422
    FIXTURE_TEXT='"/home/user/""'
    # home_paths <file>: lines holding an absolute home or root path, other than
    # the exempted fixture. grep is given /dev/null as a second argument so it
    # prefixes every line with a file name: with one argument it prints a bare
    # count, which the first form of this check summed with awk -F: and so always
    # read 0 (independent check 2).
    home_paths() {
      LC_ALL=C /usr/bin/grep -H -n -E '/home/|/root/' "$1" /dev/null |
        LC_ALL=C /usr/bin/grep -c -v -F -e "$FIXTURE_TEXT"
    }
    # ends_with_added_class <line number>: that pattern in the file ends with the
    # class above, so a bare shape cannot match it. The test is a suffix match, not
    # a fixed byte count: the first form of this check compared a fixed tail and
    # went stale the moment the class changed.
    ends_with_added_class() {
      case "$(sed -n "${1}p" "$PATTERNS")" in
        *"$ADDED_CLASS") return 0 ;;
        *) return 1 ;;
      esac
    }
    # pattern_count_is <n>: the file holds n non-comment, non-blank patterns.
    pattern_count_is() {
      [ "$(LC_ALL=C /usr/bin/grep -c -v -E '^[[:space:]]*(#|$)' "$PATTERNS")" -eq "$1" ]
    }
    
    echo "about: T0 P6d phase commit $C; HEAD at run: $HEAD_AT_RUN$([ "$HEAD_AT_RUN" = "$C" ] || echo " (record commits only in between, nothing outside records/logs differs)")"
    echo "phase: T0 P6d (specs/0002-gate-corpus-additions.md) gate.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    if [ -n "$STOPPED" ]; then echo "earlier run stopped by the environment: $STOPPED"; fi
    echo "commit before the phase: $BEFORE"
    echo "working tree clean before the run: yes (the script exits 2 otherwise); output goes to <scratch> and is moved in afterwards"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)"
    echo "EMEND_CORPUS_DIR set: $([ -n "${EMEND_CORPUS_DIR+set}" ] && echo yes || echo no); the corpus directory prints as <corpus dir>"
    echo "EMEND_PRIVATE_DENYLIST set: no (unset by this script); step 8 reads the private denylist at \$HOME/.config/emend/private-denylist.txt"
    echo "private denylist: $([ -f "$DENY_FILE" ] && echo present || echo MISSING), mode $(stat -c %a "$DENY_FILE" 2>/dev/null), entries $(LC_ALL=C /usr/bin/grep -c -v -E '^[[:space:]]*(#|$)' "$DENY_FILE") (never printed)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$0"
    
    echo
    echo "## commits of the phase"
    echo "command: git log --format='%H parents=%P %s' $BEFORE..$C"
    git log --format='%H parents=%P %s' "$BEFORE..$C" | sed 's/^/    /'
    for c in $(git rev-list --reverse "$BEFORE..$C"); do
      echo "command: git show --stat --format='%H %s' $c"
      git show --stat --format='%H %s' "$c" | sed 's/^/    /'
    done
    echo "command: git diff --stat $BEFORE $C"
    git diff --stat "$BEFORE" "$C" | sed 's/^/    /'
    
    echo
    echo "## the changed files at $C"
    for f in "${CHANGED[@]}"; do
      echo "$f: sha256 $(git show "$C:$f" | sha), bytes $(git show "$C:$f" | wc -c), git mode $(git ls-tree "$C" -- "$f" | cut -d' ' -f1)"
    done
    bash -n scripts/privacy.sh >"$T/bash-n.out" 2>&1
    rc=$?
    echo "command: bash -n scripts/privacy.sh -> exit $rc"
    check "scripts/privacy.sh parses" "$(yn [ "$rc" -eq 0 ])"
    
    echo
    echo "## the narrowed patterns (named by line number; no shape is written here)"
    echo "patterns in $PATTERNS: $(LC_ALL=C /usr/bin/grep -c -v -E '^[[:space:]]*(#|$)' "$PATTERNS")"
    check "the file still holds 11 patterns" "$(yn pattern_count_is 11)"
    for n in "${NARROWED[@]}"; do
      check "pattern $n ends with the added character class" "$(yn ends_with_added_class "$n")"
    done
    echo "command: git diff --numstat $BEFORE $C -- $PATTERNS -> $(git diff --numstat "$BEFORE" "$C" -- "$PATTERNS" | tr '\t' ' ')"
    check "exactly three pattern lines changed" "$(yn [ "$(git diff --numstat "$BEFORE" "$C" -- "$PATTERNS" | cut -f1)" = 3 ])"
    check "the identity file and the hook installer did not change" "$(yn git diff --quiet "$BEFORE" "$C" -- scripts/privacy-identity.txt scripts/install-hooks.sh)"
    printf 'x = "/home/someone/x"\n' > "$T/home-ctl"
    printf 'nothing to see here\n' > "$T/home-clean"
    sed -n "${FIXTURE_LINE}p" scripts/privacy.sh > "$T/home-fixture"
    echo "the home-path check, with its controls (the first form of this check piped a single-file grep -c into awk -F:, which always summed to 0 and so could not fail; independent check 2 found it):"
    echo "  command: home_paths <file>, which is grep -H -n over the file and /dev/null, then grep -c -v of the self-test's own fixture text"
    echo "  control, a file holding one such line: $(home_paths "$T/home-ctl") (expect 1)"
    check "the control file with one home path counts 1" "$(yn [ "$(home_paths "$T/home-ctl")" -eq 1 ])"
    echo "  control, a clean file: $(home_paths "$T/home-clean") (expect 0)"
    check "the clean control file counts 0" "$(yn [ "$(home_paths "$T/home-clean")" -eq 0 ])"
    echo "  control, a file holding only the self-test's fixture line: $(home_paths "$T/home-fixture") (expect 0, the exemption)"
    check "the exempted fixture line counts 0" "$(yn [ "$(home_paths "$T/home-fixture")" -eq 0 ])"
    n=$(home_paths scripts/privacy.sh)
    echo "  scripts/privacy.sh, raw grep -c for comparison: $(LC_ALL=C /usr/bin/grep -c -E '/home/|/root/' scripts/privacy.sh); through home_paths: $n"
    check "lines with a literal home path in scripts/privacy.sh, other than the self-test fixture at line $FIXTURE_LINE: $n (expect 0)" "$(yn [ "$n" -eq 0 ])"
    
    echo
    echo "## gate files at $C"
    for f in scripts/check.sh scripts/sys-allowlist.txt scripts/privacy.sh scripts/privacy-patterns.txt scripts/privacy-identity.txt scripts/install-hooks.sh .gitignore .github/workflows/ci.yml Cargo.toml Cargo.lock; do
      echo "$f on disk sha256 $(sha256sum "$f" | cut -d' ' -f1); at $C sha256 $(git show "$C:$f" | sha256sum | cut -d' ' -f1); bytes $(wc -c < "$f")"
    done
    check "no crate, Cargo file or workflow changed in $BEFORE..$C" "$(yn git diff --quiet "$BEFORE" "$C" -- scripts/check.sh scripts/sys-allowlist.txt .gitignore .github Cargo.toml Cargo.lock tools)"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR; CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-unset}"
    
    echo
    echo "## full run on a cold cache, started from / by absolute path"
    echo "command: cargo clean"
    cargo clean 2>&1 | sed -e "s#$ROOT#<repo>#g" -e 's/^/    /'
    echo "command: (cd / && <repo>/scripts/check.sh)"
    (cd / && "$ROOT/scripts/check.sh") > "$T/out" 2> "$T/err"
    rc=$?
    echo "stdout:"
    sed 's/^/    /' "$T/out"
    echo "stderr bytes: $(wc -c < "$T/err")"
    echo "exit: $rc"
    check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
    want="PASS host|PASS i686|PASS fmt|PASS clippy|PASS native (allowlisted -sys: none)|PASS licences|PASS hygiene|PASS privacy|"
    got=$(tr '\n' '|' < "$T/out")
    check "stdout is exactly the eight PASS lines in order" "$(yn [ "$got" = "$want" ])"
    
    echo
    echo "## control characters in the captured output (tab, LF and CR allowed)"
    printf 'x \033[31mred\033[m\017 y\n' > "$T/ctl"
    printf 'plain\ttab\r\n' > "$T/clean"
    n=$(ctrl_bytes "$T/ctl"); check "control: ESC and SI file -> lines=$(f_ctrl "$T/ctl") bytes=$n (expect bytes 3)" "$(yn [ "$n" -eq 3 ])"
    n=$(ctrl_bytes "$T/clean"); check "control: tab and CR file -> lines=$(f_ctrl "$T/clean") bytes=$n (expect 0)" "$(yn [ "$n" -eq 0 ])"
    for s in out err; do
      n=$(ctrl_bytes "$T/$s"); check "std$s: lines=$(f_ctrl "$T/$s") bytes=$n (expect 0)" "$(yn [ "$n" -eq 0 ])"
    done
    
    echo
    STATUS=$(git status --porcelain | tr '\n' ' ')
    check "status after the run (expect empty): $STATUS" "$(yn [ -z "$STATUS" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "gate log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

