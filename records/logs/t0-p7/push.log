    #!/usr/bin/env bash
    # T0 P7 push.log, in two parts.
    # Usage: p7-push.sh pre  > <scratch file>   steps 1 to 3 (no push)
    #        p7-push.sh push >> <scratch file>  steps 4 and 5 (only after the
    #                                           maintainer's authorisation)
    # The caller moves the file into records/logs/t0-p7/ afterwards.
    # Authentication uses the existing git credential helper; no
    # authentication output is captured (gh auth status is not run here).
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    MODE=${1:?pre or push}
    REPO=thekeoni1/emend
    URL=https://github.com/thekeoni1/emend.git
    export GIT_TERMINAL_PROMPT=0
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    ctrl_bytes() { LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177' < "$1" | wc -c; }
    show() { # show <label> <file>
      echo "$1:"
      sed 's/^/    /' "$2"
    }
    
    case "$MODE" in
      pre)
        echo "about: T0 P7 push of main at $(git rev-parse main); HEAD at run: $(git rev-parse HEAD)"
        echo "phase: T0 P7 (specs/0001-bootstrap.md) push.log part 1, steps 1 to 3; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)"
        echo
        echo "## script that wrote this log"
        sed 's/^/    /' "$0"
        echo
        if [ -n "$(git status --porcelain)" ]; then echo "working tree not clean"; exit 2; fi
        echo "branch: $(git symbolic-ref --short HEAD); main is $(git rev-parse main); commits on main: $(git rev-list --count main)"
        [ "$(git rev-parse main)" = "$(git rev-parse HEAD)" ] || fail=1
        echo
    
        echo "## step 1: confirm the target"
        echo "command: gh repo view $REPO --json visibility"
        gh repo view "$REPO" --json visibility > "$T/out" 2> "$T/err" </dev/null
        rc=$?
        show stdout "$T/out"; show stderr "$T/err"
        echo "exit: $rc (expect 0)"
        [ "$rc" -eq 0 ] || fail=1
        echo "visibility is PRIVATE: $(LC_ALL=C /usr/bin/grep -q -F '"visibility":"PRIVATE"' "$T/out" && echo yes || echo no)"
        LC_ALL=C /usr/bin/grep -q -F '"visibility":"PRIVATE"' "$T/out" || fail=1
        echo "command: git ls-remote $URL"
        git ls-remote "$URL" > "$T/out" 2> "$T/err" </dev/null
        rc=$?
        show stdout "$T/out"; show stderr "$T/err"
        echo "exit: $rc (expect 0)"
        [ "$rc" -eq 0 ] || fail=1
        echo "refs: $(wc -l < "$T/out") (expect 0)"
        [ "$(wc -l < "$T/out")" -eq 0 ] || fail=1
        echo
    
        echo "## step 2: add the remote"
        echo "remotes before: $(git remote | wc -l) (expect 0)"
        [ "$(git remote | wc -l)" -eq 0 ] || fail=1
        echo "command: git remote add origin $URL"
        git remote add origin "$URL" > "$T/out" 2>&1 </dev/null
        rc=$?
        show output "$T/out"
        echo "exit: $rc (expect 0)"
        [ "$rc" -eq 0 ] || fail=1
        echo "command: git remote -v"
        git remote -v | sed 's/^/    /'
        echo
    
        echo "## step 3: pre-push state and full gate"
        echo "EMEND_PRIVATE_DENYLIST set: $([ -n "${EMEND_PRIVATE_DENYLIST+set}" ] && echo yes || echo no) (expect no)"
        [ -z "${EMEND_PRIVATE_DENYLIST+set}" ] || fail=1
        echo "command: git config --get core.hooksPath"
        git config --get core.hooksPath > "$T/out" 2>&1
        echo "exit: $? (expect 1)"
        show output "$T/out"
        echo "output bytes: $(wc -c < "$T/out") (expect 0)"
        [ "$(wc -c < "$T/out")" -eq 0 ] || fail=1
        echo "command: ls -l .git/hooks/pre-push"
        ls -l .git/hooks/pre-push | sed 's/^/    /'
        echo "hook is executable: $([ -x .git/hooks/pre-push ] && echo yes || echo no)"
        [ -x .git/hooks/pre-push ] || fail=1
        awk '/^cat >"\$hook" <<.HOOK.$/ { p = 1; next } /^HOOK$/ { p = 0 } p' scripts/install-hooks.sh > "$T/heredoc"
        echo "installer heredoc lines: $(wc -l < "$T/heredoc") (expect more than 0)"
        [ "$(wc -l < "$T/heredoc")" -gt 0 ] || fail=1
        echo "hook sha256 $(sha256sum < .git/hooks/pre-push | cut -d' ' -f1); installer heredoc sha256 $(sha256sum < "$T/heredoc" | cut -d' ' -f1)"
        echo "hook equals what scripts/install-hooks.sh writes: $(cmp -s .git/hooks/pre-push "$T/heredoc" && echo yes || echo no)"
        cmp -s .git/hooks/pre-push "$T/heredoc" || fail=1
        echo "command: RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never scripts/check.sh"
        RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never scripts/check.sh > "$T/out" 2> "$T/err" </dev/null
        rc=$?
        show stdout "$T/out"
        echo "stderr bytes: $(wc -c < "$T/err") (expect 0)"
        show stderr "$T/err"
        echo "exit: $rc (expect 0)"
        [ "$rc" -eq 0 ] || fail=1
        printf 'PASS host\nPASS i686\nPASS fmt\nPASS clippy\nPASS native (allowlisted -sys: none)\nPASS licences\nPASS hygiene\nPASS privacy\n' > "$T/want"
        echo "stdout is exactly the eight PASS lines in order: $(cmp -s "$T/out" "$T/want" && echo yes || echo no)"
        cmp -s "$T/out" "$T/want" || fail=1
        for s in out err; do
          echo "check.sh std$s control bytes: $(ctrl_bytes "$T/$s") (expect 0)"
          [ "$(ctrl_bytes "$T/$s")" -eq 0 ] || fail=1
        done
        echo "status after the gate (expect empty): $(git status --porcelain | tr '\n' ' ')"
        [ -z "$(git status --porcelain)" ] || fail=1
        echo "part 1 checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
        ;;
    
      push)
        echo
        echo "# push.log part 2, steps 4 and 5; run at $(date -u +%Y-%m-%dT%H:%M:%SZ); HEAD at run: $(git rev-parse HEAD)"
        echo "EMEND_PRIVATE_DENYLIST set: $([ -n "${EMEND_PRIVATE_DENYLIST+set}" ] && echo yes || echo no) (expect no)"
        [ -z "${EMEND_PRIVATE_DENYLIST+set}" ] || { echo "refusing: EMEND_PRIVATE_DENYLIST is set"; exit 1; }
        echo "core.hooksPath: $(git config --get core.hooksPath || echo unset) (expect unset)"
        [ -z "$(git config --get core.hooksPath)" ] || { echo "refusing: core.hooksPath is set"; exit 1; }
        echo "origin: $(git remote get-url origin)"
        echo
        echo "## step 4: push"
        echo "command: git push -u origin main"
        git push -u origin main > "$T/out" 2> "$T/err" </dev/null
        rc=$?
        show stdout "$T/out"; show stderr "$T/err"
        echo "exit: $rc (expect 0)"
        [ "$rc" -eq 0 ] || fail=1
        echo "hook printed PASS privacy: $(cat "$T/out" "$T/err" | LC_ALL=C /usr/bin/grep -q -x 'PASS privacy' && echo yes || echo no)"
        cat "$T/out" "$T/err" | LC_ALL=C /usr/bin/grep -q -x 'PASS privacy' || fail=1
        for s in out err; do
          echo "push std$s control bytes: $(ctrl_bytes "$T/$s") (expect 0)"
        done
        echo
        echo "## step 5: remote main equals local main"
        echo "command: git ls-remote origin refs/heads/main"
        git ls-remote origin refs/heads/main > "$T/out" 2> "$T/err" </dev/null
        rc=$?
        show stdout "$T/out"; show stderr "$T/err"
        echo "exit: $rc (expect 0)"
        [ "$rc" -eq 0 ] || fail=1
        echo "command: git rev-parse main"
        git rev-parse main | sed 's/^/    /'
        echo "remote main equals local main: $([ "$(cut -f1 "$T/out")" = "$(git rev-parse main)" ] && echo yes || echo no)"
        [ "$(cut -f1 "$T/out")" = "$(git rev-parse main)" ] || fail=1
        echo "command: gh repo view $REPO --json visibility"
        gh repo view "$REPO" --json visibility 2>&1 </dev/null | sed 's/^/    /'
        echo "still PRIVATE: $(gh repo view "$REPO" --json visibility 2>/dev/null </dev/null | LC_ALL=C /usr/bin/grep -q -F '"visibility":"PRIVATE"' && echo yes || echo no)"
        gh repo view "$REPO" --json visibility 2>/dev/null </dev/null | LC_ALL=C /usr/bin/grep -q -F '"visibility":"PRIVATE"' || fail=1
        echo "part 2 checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
        ;;
      *)
        echo "unknown mode" >&2
        exit 2
        ;;
    esac
    exit "$fail"

