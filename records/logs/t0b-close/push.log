## script that wrote part 3
    #!/usr/bin/env bash
    # T0b close-out push.log part 3: re-check of two part 2 checks, with the fix
    # named. No push is run. Each check is evaluated once.
    # Usage: t0bclose-push-part3.sh <push.log> >> <push.log>
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    LOG=${1:?push.log required}
    BASE=401a2f73c3ac03d948e7c297ba117a5268b323af
    fail=0
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    MAIN=$(git rev-parse main)
    echo
    echo "# push.log part 3, re-check of two part 2 checks; run at $(date -u +%Y-%m-%dT%H:%M:%SZ); HEAD at run: $(git rev-parse HEAD)"
    echo "fix named: part 2 read origin/main after the push, when the successful push had already moved that tracking ref to the pushed commit, so its range and count checks compared against $MAIN and printed no. Part 3 uses the base recorded in part 1 before the push ($BASE) and re-checks the hook's lines as printed in part 2. No push is run."
    echo
    echo "## script that wrote part 3"
    sed 's/^/    /' "$0"
    echo
    check "part 1 recorded origin/main before the push as $BASE with 7 commits on main not on it" \
      "$(yn env LC_ALL=C /usr/bin/grep -q -x -F "origin/main (local tracking ref): $BASE; commits on main not on origin/main: 7" "$LOG")"
    N=$(git rev-list --count "$BASE..$MAIN")
    check "git rev-list --count $BASE..main: $N (expect 7)" "$(yn [ "$N" = 7 ])"
    check "part 2 shows the hook's range as $BASE..$MAIN" \
      "$(yn env LC_ALL=C /usr/bin/grep -q -x -F "    pre-push: scripts/privacy.sh --range $BASE..$MAIN (refs/heads/main)" "$LOG")"
    check "part 2 shows the hook scanned 7 commits with 0 findings" \
      "$(yn env LC_ALL=C /usr/bin/grep -q -E '^    privacy: 7 commit[(]s[)], [0-9]+ blob[(]s[)] scanned, 0 finding[(]s[)]$' "$LOG")"
    check "part 2 shows git reporting 401a2f7..199b468 for main" \
      "$(yn env LC_ALL=C /usr/bin/grep -q -x -F "       ${BASE:0:7}..${MAIN:0:7}  main -> main" "$LOG")"
    R=$(git ls-remote origin refs/heads/main 2>/dev/null | cut -f1)
    check "remote main now: $R (expect $MAIN)" "$(yn [ "$R" = "$MAIN" ])"
    echo "part 3 checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

