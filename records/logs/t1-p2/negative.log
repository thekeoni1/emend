## script
    #!/usr/bin/env bash
    # T1 P2 negative.log (specs/0004-xlsx-diff.md, P2 "Negative cases"): the tool
    # run by hand on archives generated in a scratch directory with Python's
    # zipfile module from fictional content.
    #   case 0 (control): input and output generated alike; expect exit 0.
    #   case a: the output's entry differs by exactly one byte at a known offset;
    #           expect `changed`, that offset in columns 14 and 16, `1` in 15.
    #   case b: one 256 MiB entry of generated bytes, deflated at level 6 in the
    #           input and level 1 in the output, so the whole entry is
    #           decompressed on both sides; expect `recompressed`, exit 1, and a
    #           peak resident set under 32 MiB (/usr/bin/time -v, "Maximum
    #           resident set size").
    # Each check is evaluated once, and a check with more than one condition is
    # evaluated inside one function. The content phrase and sentinels are built at
    # run time; every captured output is counted for them, control bytes and
    # non-ASCII bytes.
    # Usage: t1p2-negative.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/t1-p2/negative.log. Paths print as <scratch>.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    G=/usr/bin/grep
    BASE=$(mktemp -d)
    trap 'rm -rf "$BASE"' EXIT
    fail=0
    RC=0
    BIN=target/debug/xlsx-diff
    ONE_BYTE_AT=123457
    LIMIT_KB=32768
    
    rnd() { LC_ALL=C tr -dc "$1" </dev/urandom | head -c "$2"; }
    SENT1="zq$(rnd 'a-z0-9' 14)"
    SENT2="zq$(rnd 'a-z0-9' 14)"
    PHRASE="fictional neg""ative content"
    FORBIDDEN=("$SENT1" "$SENT2" "$PHRASE")
    
    hide() {
      local line f
      while IFS= read -r line || [ -n "$line" ]; do
        line=${line//"$BASE"/<scratch>}
        for f in "${FORBIDDEN[@]}"; do line=${line//"$f"/<fixture>}; done
        printf '%s\n' "$line"
      done
    }
    count_forbidden() { LC_ALL=C "$G" -a -c -F -f <(printf '%s\n' "${FORBIDDEN[@]}") "$1"; }
    ctrl_bytes() { LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177' <"$1" | wc -c; }
    nonascii_bytes() { LC_ALL=C tr -cd '\200-\377' <"$1" | wc -c; }
    note() { echo "  $1: $2"; [ "$2" = as-expected ] || fail=1; }
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    # all_zero <n>...: every count given is 0.
    all_zero() { local v; for v in "$@"; do [ "$v" -eq 0 ] || return 1; done; }
    
    echo "about: T1 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: T1 P2 (specs/0004-xlsx-diff.md) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "Archives are generated under <scratch> with python3 zipfile from fictional content, and deleted on exit."
    echo "fixture strings counted in every captured output: ${#FORBIDDEN[@]} (two random content sentinels and the content phrase, all built at run time; values never printed)"
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    
    echo
    echo "## counter controls"
    printf '%s\n' "${FORBIDDEN[@]}" >"$BASE/ctl-forbidden"
    printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$BASE/ctl-bytes"
    printf 'plain\ttab\r\n' >"$BASE/ctl-clean"
    ctl() { local r; r=$([ "$2" = "$3" ] && echo as-expected || echo UNEXPECTED); echo "  control $1: $2 (expect $3): $r"; [ "$r" = as-expected ] || fail=1; }
    ctl "lines with a fixture string in a file holding each once" "$(count_forbidden "$BASE/ctl-forbidden")" "${#FORBIDDEN[@]}"
    ctl "lines with a fixture string in a clean file" "$(count_forbidden "$BASE/ctl-clean")" 0
    ctl "control bytes in a file with ESC, ESC and SI" "$(ctrl_bytes "$BASE/ctl-bytes")" 3
    ctl "non-ASCII bytes in a file with one two-byte character" "$(nonascii_bytes "$BASE/ctl-bytes")" 2
    
    echo
    echo "## build"
    echo "command: cargo build -p xlsx-diff"
    cargo build -p xlsx-diff >"$BASE/build.out" 2>&1 </dev/null
    RC=$?
    echo "  exit: $RC"
    note "build exit 0" "$(is [ "$RC" -eq 0 ])"
    note "binary $BIN exists" "$(is [ -x "$BIN" ])"
    
    run_tool() { # run_tool <name> <input> <output> [time]
      local name=$1 fb c n r
      echo "command: $([ "${4:-}" = time ] && echo '/usr/bin/time -v ')$BIN $(printf '%s' "$2" | hide) $(printf '%s' "$3" | hide)"
      if [ "${4:-}" = time ]; then
        /usr/bin/time -v -o "$BASE/$name.time" "$BIN" "$2" "$3" >"$BASE/$name.out" 2>"$BASE/$name.err" </dev/null
      else
        "$BIN" "$2" "$3" >"$BASE/$name.out" 2>"$BASE/$name.err" </dev/null
      fi
      RC=$?
      echo "  stdout:"
      hide <"$BASE/$name.out" | sed 's/^/    /'
      echo "  stderr:"
      hide <"$BASE/$name.err" | sed 's/^/    /'
      echo "  exit: $RC"
      cat "$BASE/$name.out" "$BASE/$name.err" >"$BASE/$name.both"
      fb=$(count_forbidden "$BASE/$name.both")
      c=$(ctrl_bytes "$BASE/$name.both")
      n=$(nonascii_bytes "$BASE/$name.both")
      r=$(is all_zero "$fb" "$c" "$n")
      echo "  captured output: lines with a fixture string=$fb, control bytes=$c, non-ASCII bytes=$n (expect 0, 0 and 0): $r"
      [ "$r" = as-expected ] || fail=1
    }
    # row_is <file> <exact row>: the file holds that exact line.
    row_is() { LC_ALL=C "$G" -q -x -F -e "$2" "$1"; }
    # entry_rows_are <file> <count> <status>: exactly <count> entry rows, all with <status>.
    entry_rows_are() {
      [ "$(LC_ALL=C "$G" -c -P '^entry\t' "$1")" = "$2" ] &&
        [ "$(LC_ALL=C "$G" -c -P "^entry\t[^\t]*\t$3\t" "$1")" = "$2" ]
    }
    
    echo
    echo "## generated archives for cases 0 and a"
    cat >"$BASE/gen-small.py" <<'PY'
    import sys, zipfile
    out_dir, s1, s2, phrase, at = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], int(sys.argv[5])
    body = "".join(phrase + " row %d %s %s\n" % (i, s1, s2) for i in range(4000)).encode()
    changed = bytearray(body)
    changed[at] ^= 0x01
    for name, data in (("input.zip", body), ("same.zip", body), ("one-byte.zip", bytes(changed))):
        with zipfile.ZipFile(out_dir + "/" + name, "w") as z:
            info = zipfile.ZipInfo("xl/worksheets/sheet1.xml", date_time=(2026, 9, 15, 0, 0, 0))
            info.compress_type = zipfile.ZIP_DEFLATED
            z.writestr(info, data)
    print(len(body))
    PY
    echo "command: python3 <scratch>/gen-small.py <scratch> <sentinel> <sentinel> <phrase> $ONE_BYTE_AT"
    SIZE=$(python3 "$BASE/gen-small.py" "$BASE" "$SENT1" "$SENT2" "$PHRASE" "$ONE_BYTE_AT")
    echo "  entry xl/worksheets/sheet1.xml: $SIZE uncompressed bytes in each archive; one-byte.zip has the byte at offset $ONE_BYTE_AT xored with 0x01"
    note "the offset is inside the entry" "$(is [ "$ONE_BYTE_AT" -lt "$SIZE" ])"
    
    echo
    echo "## case 0 (control): input and output generated alike; expect identical, exit 0"
    run_tool c0 "$BASE/input.zip" "$BASE/same.zip"
    note "exit 0" "$(is [ "$RC" -eq 0 ])"
    note "one entry row, identical" "$(is entry_rows_are "$BASE/c0.out" 1 identical)"
    note "stderr is empty" "$(is [ ! -s "$BASE/c0.err" ])"
    
    echo
    echo "## case a: one byte different at offset $ONE_BYTE_AT"
    run_tool a "$BASE/input.zip" "$BASE/one-byte.zip"
    note "exit 1" "$(is [ "$RC" -eq 1 ])"
    note "one entry row, changed" "$(is entry_rows_are "$BASE/a.out" 1 changed)"
    COLS=$(LC_ALL=C "$G" -P '^entry\t' "$BASE/a.out" | cut -f 14-17 | tr '\t' '|')
    echo "  columns 14 to 17 of the entry row: $COLS"
    note "column 14 is $ONE_BYTE_AT, column 15 is 1, column 16 is $ONE_BYTE_AT, column 17 empty" "$(is [ "$COLS" = "$ONE_BYTE_AT|1|$ONE_BYTE_AT|" ])"
    note "archive row changed is 1" "$(is row_is "$BASE/a.out" "$(printf 'archive\tchanged\t1')")"
    note "stderr is empty" "$(is [ ! -s "$BASE/a.err" ])"
    
    echo
    echo "## case b: one 256 MiB entry, deflated at level 6 in the input and level 1 in the output"
    cat >"$BASE/gen-big.py" <<'PY'
    import sys, zipfile
    out_dir, phrase = sys.argv[1], sys.argv[2]
    chunk_len = 64 * 1024
    total = 256 * 1024 * 1024
    line = (phrase + " generated bytes ").encode()
    base = (line * (chunk_len // len(line) + 1))[:chunk_len]
    for name, level in (("big-in.zip", 6), ("big-out.zip", 1)):
        with zipfile.ZipFile(out_dir + "/" + name, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=level) as z:
            info = zipfile.ZipInfo("big/generated.bin", date_time=(2026, 9, 15, 0, 0, 0))
            info.compress_type = zipfile.ZIP_DEFLATED
            # The archive's compresslevel does not reach a ZipInfo passed to open(),
            # so the level is set on the entry itself (dry-run finding).
            if hasattr(info, "compress_level"):
                info.compress_level = level
            else:
                info._compresslevel = level
            with z.open(info, "w") as f:
                written = 0
                n = 0
                while written < total:
                    block = bytearray(base)
                    block[:8] = n.to_bytes(8, "little")
                    f.write(bytes(block))
                    written += chunk_len
                    n += 1
    print(total)
    PY
    echo "command: python3 <scratch>/gen-big.py <scratch> <phrase>"
    BIG=$(python3 "$BASE/gen-big.py" "$BASE" "$PHRASE")
    echo "  entry big/generated.bin: $BIG uncompressed bytes; big-in.zip $(wc -c <"$BASE/big-in.zip") bytes, big-out.zip $(wc -c <"$BASE/big-out.zip") bytes"
    note "the entry is 256 MiB" "$(is [ "$BIG" = 268435456 ])"
    # archives_differ: the two archives are not byte-identical, so the levels took effect.
    archives_differ() { ! cmp -s "$BASE/big-in.zip" "$BASE/big-out.zip"; }
    note "big-in.zip and big-out.zip differ in their bytes (the deflate levels took effect)" "$(is archives_differ)"
    run_tool b "$BASE/big-in.zip" "$BASE/big-out.zip" time
    note "exit 1" "$(is [ "$RC" -eq 1 ])"
    note "one entry row, recompressed" "$(is entry_rows_are "$BASE/b.out" 1 recompressed)"
    note "stderr is empty" "$(is [ ! -s "$BASE/b.err" ])"
    echo "  /usr/bin/time -v, selected lines:"
    LC_ALL=C "$G" -E 'Maximum resident set size|Elapsed \(wall clock\) time|Exit status' "$BASE/b.time" | sed 's/^[[:space:]]*/    /'
    RSS=$(LC_ALL=C "$G" -E 'Maximum resident set size' "$BASE/b.time" | awk -F': ' '{print $2}')
    rss_under_limit() { [ -n "$RSS" ] && [ "$RSS" -lt "$LIMIT_KB" ]; }
    note "maximum resident set size ${RSS:-none} kB is under $LIMIT_KB kB (32 MiB)" "$(is rss_under_limit)"
    
    echo
    STATUS=$(git status --porcelain | tr '\n' ' ')
    note "main working tree status (expect empty): $STATUS" "$(is [ -z "$STATUS" ])"
    echo "all negative cases as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

