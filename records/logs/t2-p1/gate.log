    #!/usr/bin/env bash
    # T2 P1 gate log: the import record of scripts/corpus-add.py, checks on the two
    # python3 scripts, and a full run of all eight check.sh steps on a cold cache.
    # Usage: t2p1-gate.sh <import commit> <phase commit> [<stopped-run note>] > <gate log scratch file>
    # The note records an earlier run of this log that the environment stopped
    # (specs/0001 "Rules for every phase": start time, last completed check, reason).
    # The caller moves the file into records/logs/t2-p1/ afterwards, so nothing is
    # written in the working tree while this runs. Each check is evaluated once and
    # that single result is printed; a check with more than one condition is
    # evaluated inside one function. The corpus directory's path is never printed.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    IMPORT=${1:?import commit required}
    C=${2:?phase commit required}
    STOPPED=${3:-}
    ROOT=$(pwd)
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    unset EMEND_PRIVATE_DENYLIST
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    DENY_FILE=$HOME/.config/emend/private-denylist.txt
    BEFORE=24d4a165b0e250f05b6c53db6747f95a28d28796
    RECORDED_IMPORT_SHA=30c66ee96732e329fda3de049cef5e9bfd8c21f58e07fc6385b12bf77602f250
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    PRIVATE=$CORPUS/tools/corpus-add.py
    SCRIPTS=(scripts/corpus-add.py scripts/corpus-coverage.py)
    
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    if [ -n "$(git status --porcelain)" ]; then echo "working tree not clean" >&2; exit 2; fi
    
    f_ctrl()     { LC_ALL=C /usr/bin/grep -a -c -P '[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]' "$1"; }
    ctrl_bytes() { LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177' < "$1" | wc -c; }
    # check <label> <yes|no>: print a result evaluated once.
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    sha() { sha256sum | cut -c1-64; }
    # import_is_one_file: the import commit's parent is the doc commit, and it adds
    # exactly scripts/corpus-add.py.
    import_is_one_file() {
      [ "$(git rev-list --parents -n 1 "$IMPORT" | wc -w)" -eq 2 ] &&
        [ "$(git diff --name-status "$IMPORT^" "$IMPORT")" = "$(printf 'A\tscripts/corpus-add.py')" ]
    }
    # three_equal <a> <b> <c>: the three hashes are equal.
    three_equal() { [ "$1" = "$2" ] && [ "$2" = "$3" ]; }
    # usage_exit_2 <out> <err> <rc> <usage line>: exit 2, no stdout, stderr exactly the usage line.
    usage_exit_2() { [ "$3" -eq 2 ] && [ ! -s "$1" ] && [ "$(cat "$2")" = "$4" ]; }
    # all_stdlib <imports file>: the file lists at least one import and none is
    # outside sys.stdlib_module_names.
    all_stdlib() { [ -s "$1" ] && ! LC_ALL=C /usr/bin/grep -q NOT-STDLIB "$1"; }
    
    echo "about: T2 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: T2 P1 (specs/0005-corpus.md) gate.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    if [ -n "$STOPPED" ]; then echo "earlier run stopped by the environment: $STOPPED"; fi
    echo "import commit: $IMPORT; commit before the phase: $BEFORE"
    echo "working tree clean before the run: yes (the script exits 2 otherwise); output goes to <scratch> and is moved in afterwards"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)"
    echo "EMEND_CORPUS_DIR set: $([ -n "${EMEND_CORPUS_DIR+set}" ] && echo yes || echo no); the corpus directory prints as <corpus dir>"
    echo "EMEND_PRIVATE_DENYLIST set: no (unset by this script); step 8 reads the private denylist at \$HOME/.config/emend/private-denylist.txt"
    echo "private denylist: $([ -f "$DENY_FILE" ] && echo present || echo MISSING), mode $(stat -c %a "$DENY_FILE" 2>/dev/null), entries $(LC_ALL=C /usr/bin/grep -c -v -E '^[[:space:]]*(#|$)' "$DENY_FILE") (never printed)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$0"
    
    echo
    echo "## commits of the phase"
    echo "command: git log --format='%H parents=%P %s' $BEFORE..$C"
    git log --format='%H parents=%P %s' "$BEFORE..$C" | sed 's/^/    /'
    echo "per-commit file lists and stats (check 1 gap 7):"
    for c in $(git rev-list --reverse "$BEFORE..$C"); do
      echo "command: git show --stat --format='%H %s' $c"
      git show --stat --format='%H %s' "$c" | sed 's/^/    /'
      echo "    file modes at $c: $(git ls-tree -r "$c" --format='%(objectmode) %(path)' | LC_ALL=C /usr/bin/grep -E ' scripts/corpus-(add|coverage)\.py$' | tr '\n' ';')"
    done
    echo "command: git diff --stat $BEFORE $C"
    git diff --stat "$BEFORE" "$C" | sed 's/^/    /'
    
    echo
    echo "## import record (specs/0005-corpus.md P1: the private helper's sha256 at import and every change)"
    PRIV_NOW=$(sha < "$PRIVATE")
    AT_IMPORT=$(git show "$IMPORT:scripts/corpus-add.py" | sha)
    echo "recorded sha256 of <corpus dir>/tools/corpus-add.py at import (in the import commit message): $RECORDED_IMPORT_SHA"
    echo "<corpus dir>/tools/corpus-add.py now: sha256 $PRIV_NOW, bytes $(wc -c < "$PRIVATE"), mode $(stat -c %a "$PRIVATE")"
    echo "scripts/corpus-add.py at $IMPORT: sha256 $AT_IMPORT"
    check "the recorded sha256, the private file now and the blob at the import commit are equal" "$(yn three_equal "$RECORDED_IMPORT_SHA" "$PRIV_NOW" "$AT_IMPORT")"
    echo "command: git diff --name-status $IMPORT^ $IMPORT"
    git diff --name-status "$IMPORT^" "$IMPORT" | sed 's/^/    /'
    check "the import commit's parent is one commit and it adds only scripts/corpus-add.py" "$(yn import_is_one_file)"
    check "the import commit's message names the sha256" "$(yn /usr/bin/grep -q -F "$RECORDED_IMPORT_SHA" <(git log -1 --format=%B "$IMPORT"))"
    echo "every change made to it after the import:"
    echo "command: git diff $IMPORT $C -- scripts/corpus-add.py"
    git diff "$IMPORT" "$C" -- scripts/corpus-add.py | sed 's/^/    /'
    echo "the private helper is outside the repository: no other file under the corpus directory enters it (hygiene and privacy steps below count corpus paths)"
    
    echo
    echo "## the two scripts at $C"
    echo "$(python3 --version)"
    for f in "${SCRIPTS[@]}"; do
      echo "$f: sha256 $(git show "$C:$f" | sha), bytes $(git show "$C:$f" | wc -c), git mode $(git ls-tree "$C" -- "$f" | cut -d' ' -f1), first line: $(git show "$C:$f" | head -n 1)"
      check "$f: git mode 100755" "$(yn [ "$(git ls-tree "$C" -- "$f" | cut -d' ' -f1)" = 100755 ])"
      check "$f: first line is #!/usr/bin/env python3" "$(yn [ "$(head -n 1 "$f")" = '#!/usr/bin/env python3' ])"
      python3 -c 'import py_compile, sys; py_compile.compile(sys.argv[1], cfile=sys.argv[2], doraise=True)' "$f" "$T/compiled.pyc" > "$T/compile.out" 2>&1
      rc=$?
      check "$f: py_compile exit $rc (into <scratch>)" "$(yn [ "$rc" -eq 0 ])"
      python3 - "$f" > "$T/imports" <<'PY'
    import ast, sys
    tree = ast.parse(open(sys.argv[1]).read())
    names = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            names.update(a.name.split(".")[0] for a in node.names)
        elif isinstance(node, ast.ImportFrom):
            names.add((node.module or "").split(".")[0])
    for n in sorted(names):
        print(n, "stdlib" if n in sys.stdlib_module_names else "NOT-STDLIB")
    PY
      echo "  imports: $(tr '\n' ';' < "$T/imports")"
      check "$f: every import is in sys.stdlib_module_names" "$(yn all_stdlib "$T/imports")"
      n=$(LC_ALL=C /usr/bin/grep -c -E '/home/|/Users/|/root/' "$f")
      check "$f: lines with a literal home path: $n (expect 0)" "$(yn [ "$n" -eq 0 ])"
    done
    printf 'x = "/home/someone/x"\n' > "$T/home-ctl"
    n=$(LC_ALL=C /usr/bin/grep -c -E '/home/|/Users/|/root/' "$T/home-ctl")
    check "control: the home path form counts 1 line in a file holding one" "$(yn [ "$n" -eq 1 ])"
    echo "usage errors (these exit before the corpus directory is read):"
    env -u EMEND_CORPUS_DIR scripts/corpus-add.py > "$T/u1.out" 2> "$T/u1.err" < /dev/null
    rc=$?
    echo "  command: scripts/corpus-add.py (no arguments) -> exit $rc, stdout bytes $(wc -c < "$T/u1.out"), stderr: $(cat "$T/u1.err")"
    check "corpus-add.py without arguments: exit 2 and the usage line only" "$(yn usage_exit_2 "$T/u1.out" "$T/u1.err" "$rc" "usage: corpus-add.py <file> <producer> <producer_version> <source> <tags> [note]")"
    env -u EMEND_CORPUS_DIR scripts/corpus-coverage.py --bogus > "$T/u2.out" 2> "$T/u2.err" < /dev/null
    rc=$?
    echo "  command: scripts/corpus-coverage.py --bogus -> exit $rc, stdout bytes $(wc -c < "$T/u2.out"), stderr: $(cat "$T/u2.err")"
    check "corpus-coverage.py with an unknown argument: exit 2 and the usage line only" "$(yn usage_exit_2 "$T/u2.out" "$T/u2.err" "$rc" "usage: corpus-coverage.py [--verify]")"
    
    echo
    echo "## gate files at $C"
    for f in scripts/check.sh scripts/sys-allowlist.txt scripts/privacy.sh scripts/privacy-patterns.txt scripts/privacy-identity.txt scripts/install-hooks.sh .gitignore .github/workflows/ci.yml Cargo.toml Cargo.lock; do
      echo "$f on disk sha256 $(sha256sum "$f" | cut -d' ' -f1); at $C sha256 $(git show "$C:$f" | sha256sum | cut -d' ' -f1); bytes $(wc -c < "$f")"
    done
    check "no gate file, Cargo file or workflow changed in $BEFORE..$C" "$(yn git diff --quiet "$BEFORE" "$C" -- scripts/check.sh scripts/sys-allowlist.txt scripts/privacy.sh scripts/privacy-patterns.txt scripts/privacy-identity.txt scripts/install-hooks.sh .gitignore .github Cargo.toml Cargo.lock tools)"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR"
    
    echo
    echo "## full run on a cold cache, started from / by absolute path"
    echo "command: cargo clean"
    cargo clean 2>&1 | sed -e "s#$ROOT#<repo>#g" -e 's/^/    /'
    echo "command: (cd / && <repo>/scripts/check.sh)"
    (cd / && "$ROOT/scripts/check.sh") > "$T/out" 2> "$T/err"
    rc=$?
    echo "stdout:"
    sed 's/^/    /' "$T/out"
    echo "stderr bytes: $(wc -c < "$T/err")"
    echo "exit: $rc"
    check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
    want="PASS host|PASS i686|PASS fmt|PASS clippy|PASS native (allowlisted -sys: none)|PASS licences|PASS hygiene|PASS privacy|"
    got=$(tr '\n' '|' < "$T/out")
    check "stdout is exactly the eight PASS lines in order" "$(yn [ "$got" = "$want" ])"
    echo
    echo "## control characters in the captured output (tab, LF and CR allowed)"
    printf 'x \033[31mred\033[m\017 y\n' > "$T/ctl"
    printf 'plain\ttab\r\n' > "$T/clean"
    n=$(ctrl_bytes "$T/ctl"); check "control: ESC and SI file -> lines=$(f_ctrl "$T/ctl") bytes=$n (expect bytes 3)" "$(yn [ "$n" -eq 3 ])"
    n=$(ctrl_bytes "$T/clean"); check "control: tab and CR file -> lines=$(f_ctrl "$T/clean") bytes=$n (expect 0)" "$(yn [ "$n" -eq 0 ])"
    for s in out err; do
      n=$(ctrl_bytes "$T/$s"); check "std$s: lines=$(f_ctrl "$T/$s") bytes=$n (expect 0)" "$(yn [ "$n" -eq 0 ])"
    done
    echo
    STATUS=$(git status --porcelain | tr '\n' ' ')
    check "status after the run (expect empty): $STATUS" "$(yn [ -z "$STATUS" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "gate log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

