    #!/usr/bin/env bash
    # T2 P7 gate log: the phase's commits, the changed files, the P7 changes present
    # in both scripts, the gate files unchanged, and a full run of all eight
    # check.sh steps on a cold cache.
    # Usage: t2p7-gate.sh <phase commit> [<stopped-run note>] > <gate log scratch file>
    # The caller moves the file into records/logs/t2-p7/ afterwards, so nothing is
    # written in the working tree while this runs. Each check is evaluated once and
    # that single result is printed; a check with more than one condition is
    # evaluated inside one named function. Every counting form comes from
    # t2p7-lib.sh, reads the exit status, and has a positive control: see the
    # counting controls section below.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    C=${1:?phase commit required}
    STOPPED=${2:-}
    ROOT=$(pwd)
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    # This box stopped two T0 P6d gate runs for low memory, so cargo is capped.
    export CARGO_BUILD_JOBS=4
    unset EMEND_PRIVATE_DENYLIST
    LIB=${T2P7_LIB:?the path to t2p7-lib.sh is required}
    . "$LIB"
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    DENY_FILE=$HOME/.config/emend/private-denylist.txt
    # The commit before the phase is resolved from git, not typed: specs/0001's
    # rule (added in this phase's own doc commit) is that every commit id in a log
    # is read from git at run time by a command the log prints. The doc commit is
    # named by the tip of the phase's first commit, found by its subject, so no
    # 40-character id is typed anywhere in this script.
    BEFORE=$(git rev-parse "$(git log --format='%H' --grep='^T2 P7: commit planning doc updates' -n 1)") ||
      { echo "cannot resolve the phase's doc commit" >&2; exit 2; }
    [ -n "$BEFORE" ] || { echo "the phase's doc commit was not found" >&2; exit 2; }
    RECORD=records/corpus-coverage-2026-09-16.md
    CHANGED=(scripts/corpus-add.py scripts/corpus-coverage.py "$RECORD")
    
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    if [ -n "$(git status --porcelain)" ]; then echo "working tree not clean" >&2; exit 2; fi
    
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    sha() { sha256sum | cut -c1-64; }
    # staged_order <script>: the ruled order is present as code, all four steps in
    # one function so no condition is dropped.
    staged_order() {
      local f=$1
      LC_ALL=C "$G" -a -q -F -e 'tmp = os.path.join(dest_dir, f".{fid}.{ext}.corpus-add.tmp")' "$f" &&
        LC_ALL=C "$G" -a -q -F -e 'shutil.copyfile(src, tmp)' "$f" &&
        LC_ALL=C "$G" -a -q -F -e 'os.replace(tmp, dest)' "$f" &&
        LC_ALL=C "$G" -a -q -F -e 'os.unlink(tmp)' "$f"
    }
    # copy_is_staged <script>: the script no longer copies straight to the final
    # name. The old form was shutil.copyfile(src, dest).
    copy_is_staged() {
      local n
      n=$(count_matches -F 'shutil.copyfile(src, dest)' "$1")
      [ "$n" = 0 ]
    }
    # docstring_narrowed <script>: the line-number claim names the per-row failures
    # and lists the ones that carry no line.
    docstring_narrowed() {
      local f=$1
      LC_ALL=C "$G" -a -q -F -e 'A failure found while checking a' "$f" &&
        LC_ALL=C "$G" -a -q -F -e 'do not, because there is no row to name' "$f"
    }
    # record_shape <record>: the committed record carries the header planning ruled
    # and nothing else around the body.
    record_shape() {
      local f=$1
      LC_ALL=C "$G" -a -q -E '^- Commit: [0-9a-f]{40}$' "$f" &&
        LC_ALL=C "$G" -a -q -E '^- Date: [0-9]{4}-[0-9]{2}-[0-9]{2}$' "$f" &&
        LC_ALL=C "$G" -a -q -E '^- Script: `scripts/corpus-coverage\.py`, sha256 [0-9a-f]{64}$' "$f"
    }
    
    echo "about: T2 P7 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "command: git rev-parse HEAD   (every commit id in this log is read from git, never typed)"
    echo "phase: T2 P7 (specs/0005-corpus.md) gate.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    if [ -n "$STOPPED" ]; then echo "earlier run stopped by the environment: $STOPPED"; fi
    echo "command: git rev-parse $BEFORE"
    echo "commit before the phase: $(git rev-parse "$BEFORE")"
    echo "working tree clean before the run: yes (the script exits 2 otherwise); output goes to <scratch> and is moved in afterwards"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)"
    echo "EMEND_CORPUS_DIR set: $([ -n "${EMEND_CORPUS_DIR+set}" ] && echo yes || echo no); the corpus directory prints as <corpus dir>"
    echo "private denylist: $([ -f "$DENY_FILE" ] && echo present || echo MISSING), mode $(stat -c %a "$DENY_FILE" 2>/dev/null) (never printed)"
    echo "DEPARTURE: CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS (this box stopped two T0 P6d gate runs for low memory)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$0"
    echo
    echo "## the shared counting library this log sources"
    sed 's/^/    /' "$LIB"
    
    echo
    echo "## counting controls (every form, before any of them is used)"
    counting_controls
    check "every counting form behaves on a match, a miss and an unreadable file" "$(yn [ "$counting_controls_ok" = yes ])"
    
    echo
    echo "## commits of the phase"
    echo "command: git log --format='%H parents=%P %s' $BEFORE..$C"
    git log --format='%H parents=%P %s' "$BEFORE..$C" | sed 's/^/    /'
    for c in $(git rev-list --reverse "$BEFORE..$C"); do
      echo "command: git show --stat --format='%H %s' $c"
      git show --stat --format='%H %s' "$c" | sed 's/^/    /'
    done
    
    echo
    echo "## the changed files at $C"
    for f in "${CHANGED[@]}"; do
      echo "$f: sha256 $(git show "$C:$f" | sha), bytes $(git show "$C:$f" | wc -c), git mode $(git ls-tree "$C" -- "$f" | cut -d' ' -f1)"
    done
    # By this run the phase diff carries the four logs of the first record commit
    # as well as the two scripts and the record, so the expected set names all
    # seven. The earlier three-path constant would report "no" against a correct
    # tree once the logs were committed.
    EXPECTED_PATHS="records/corpus-coverage-2026-09-16.md records/logs/t2-p7/gate.log records/logs/t2-p7/negative.log records/logs/t2-p7/positive.log records/logs/t2-p7/scan.log scripts/corpus-add.py scripts/corpus-coverage.py "
    echo "phase diff paths: $(git diff --name-only "$BEFORE" "$C" | tr '\n' ' ')"
    check "the phase diff touches exactly the two scripts, the record and the four logs" \
      "$(yn [ "$(git diff --name-only "$BEFORE" "$C" | tr '\n' ' ')" = "$EXPECTED_PATHS" ])"
    for f in scripts/corpus-add.py scripts/corpus-coverage.py; do
      python3 -c 'import py_compile, sys; py_compile.compile(sys.argv[1], cfile=sys.argv[2], doraise=True)' \
        "$f" "$T/compiled.pyc" >"$T/py.out" 2>&1
      rc=$?
      echo "command: py_compile $f -> exit $rc"
      check "$f compiles" "$(yn [ "$rc" -eq 0 ])"
    done
    
    echo
    echo "## the P7 changes are in the scripts at $C"
    check "corpus-add.py stages the copy, appends, renames and cleans up" "$(yn staged_order scripts/corpus-add.py)"
    check "corpus-add.py no longer copies straight to the final name" "$(yn copy_is_staged scripts/corpus-add.py)"
    check "corpus-coverage.py's line-number claim is narrowed to the per-row failures" "$(yn docstring_narrowed scripts/corpus-coverage.py)"
    echo "  (the strings above prove the code is present; positive.log and negative.log run it)"
    
    echo
    echo "## the committed coverage record"
    echo "$RECORD: sha256 $(git show "$C:$RECORD" | sha), bytes $(git show "$C:$RECORD" | wc -c)"
    check "the record carries the ruled header: commit, date and the script's sha256" "$(yn record_shape "$RECORD")"
    n=$(count_matches -E 'emend-testing|/home/|/Users/|/root/' "$RECORD")
    echo "lines naming a corpus or home path in the record: $n (expect 0)"
    check "the record names no corpus or home path" "$(yn [ "$n" = 0 ])"
    n=$(count_bytes "$NONASCII_CLASS" "$RECORD")
    echo "non-ASCII bytes in the record: $n (expect 0)"
    check "the record is ASCII" "$(yn [ "$n" = 0 ])"
    
    echo
    echo "## gate files at $C"
    for f in scripts/check.sh scripts/sys-allowlist.txt scripts/privacy.sh scripts/privacy-patterns.txt scripts/privacy-identity.txt scripts/install-hooks.sh .gitignore .github/workflows/ci.yml Cargo.toml Cargo.lock; do
      echo "$f on disk sha256 $(sha256sum "$f" | cut -d' ' -f1); at $C sha256 $(git show "$C:$f" | sha256sum | cut -d' ' -f1)"
    done
    check "no gate file, Cargo file, crate or workflow changed in $BEFORE..$C" "$(yn git diff --quiet "$BEFORE" "$C" -- scripts/check.sh scripts/sys-allowlist.txt scripts/privacy.sh scripts/privacy-patterns.txt scripts/privacy-identity.txt scripts/install-hooks.sh .gitignore .github Cargo.toml Cargo.lock tools)"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR; CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS"
    
    echo
    echo "## full run on a cold cache, started from / by absolute path"
    echo "command: cargo clean"
    cargo clean 2>&1 | sed -e "s#$ROOT#<repo>#g" -e 's/^/    /'
    echo "command: (cd / && <repo>/scripts/check.sh)"
    (cd / && "$ROOT/scripts/check.sh") > "$T/out" 2> "$T/err"
    rc=$?
    echo "stdout:"
    sed 's/^/    /' "$T/out"
    echo "stderr bytes: $(wc -c < "$T/err")"
    echo "exit: $rc"
    check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
    want="PASS host|PASS i686|PASS fmt|PASS clippy|PASS native (allowlisted -sys: none)|PASS licences|PASS hygiene|PASS privacy|"
    got=$(tr '\n' '|' < "$T/out")
    check "stdout is exactly the eight PASS lines in order" "$(yn [ "$got" = "$want" ])"
    
    echo
    echo "## control characters in the captured output (tab, LF and CR allowed)"
    for s in out err; do
      n=$(count_bytes "$CTRL_CLASS" "$T/$s")
      check "std$s control bytes: $n (expect 0)" "$(yn [ "$n" = 0 ])"
    done
    
    echo
    STATUS=$(git status --porcelain | tr '\n' ' ')
    check "status after the run (expect empty): $STATUS" "$(yn [ -z "$STATUS" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "gate log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

## the shared counting library this log sources
    # T2 P7 shared counting forms, sourced by every log script of this phase.
    #
    # WHY THIS FILE EXISTS. In T3 P4 I wrote four counting sites that compared a
    # bare `grep -c` (or a `cat ... | tr ... | wc -c`) with 0 without reading the
    # exit status, so a read error printed 0 and the check passed. Two independent
    # checks found them, and twice I declared the class closed after repairing one
    # instance. Planning's remedy for T2 P7 is that every counting form, including
    # a throwaway one, is a named function that reads the exit and has a positive
    # control, from the start. These are those functions.
    #
    # WHAT THIS LIBRARY DOES NOT COVER. This comment has been wrong twice. It first
    # claimed no log script counted any other way (check 1 disproved it); it then
    # claimed every ASSERTED site went through the library and listed exceptions
    # that omitted two asserted sites (check 2 disproved that). The list below is
    # the third attempt and is stated as what I believe rather than as a guarantee.
    #
    # Sites NOT using these functions, every one I can find, asserted or not:
    #   - gate.log and positive.log: `git show ... | wc -c` byte counts, printed
    #     beside a sha256, informational.
    #   - scan.log: `git diff --name-only ... | wc -l`, informational, and
    #     fail-closed because files_complete requires a count above zero.
    #   - scan.log's f_email: counts with `grep -o` piped to awk, but reads grep's
    #     exit status itself and returns "error" on 2 or more.
    # Everything that feeds an assertion goes through the functions above. If that
    # is wrong again, the fault is this comment, not the functions.
    #
    # Every function prints either a number or the word "error". None of them ever
    # prints a matched line, a value, or a path.
    
    G=/usr/bin/grep
    
    # count_matches <-F|-E> <pattern> <file>...: total matching lines across the
    # files, or "error" if any file could not be read. The files go to grep
    # directly: with `cat file | grep -c`, an unreadable file makes CAT fail while
    # grep counts 0 over the empty stream and exits 1, so the read error reads as
    # "no hits".
    count_matches() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_from_file <-F|-E> <pattern file> <file>...: the same, with the patterns
    # read from a file (grep -f), so a pattern is never printed.
    count_from_file() {
      local mode=$1 patterns=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -f "$patterns" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    
    # count_bytes <tr class> <file>...: total bytes of that class across the files,
    # or "error" if any file could not be read. Each file is read on its own rather
    # than through `cat "$@" | tr`, for the same reason as above.
    count_bytes() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    # count_lines <file>...: total lines, or "error" if any file could not be read.
    count_lines() {
      local total=0 f n
      for f in "$@"; do
        [ -r "$f" ] || { printf 'error'; return; }
        n=$(wc -l <"$f") || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    
    CTRL_CLASS='\000-\010\013\014\016-\037\177'
    NONASCII_CLASS='\200-\377'
    
    # counting_controls <label prefix>: run every counting form above against a
    # fixture that must match and one that must not, and against an unreadable
    # file, printing one line per result. Sets counting_controls_ok to yes or no.
    # This is the positive control planning requires for every form, and it also
    # proves each form reports "error" rather than 0 when it cannot read.
    counting_controls() {
      local d ok=yes r
      d=$(mktemp -d) || { counting_controls_ok=no; return; }
      printf 'alpha\nbeta needle gamma\nneedle\n' >"$d/hit"
      printf 'nothing of interest\n' >"$d/miss"
      printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$d/bytes"
      printf 'needle\n' >"$d/patterns"
      printf 'unreadable\n' >"$d/locked"
      chmod 000 "$d/locked"
    
      r=$(count_matches -F needle "$d/hit");        echo "  control count_matches on a file with two matching lines: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/miss");       echo "  control count_matches on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/miss"); echo "  control count_matches summed over two files: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -E 'ne+dle' "$d/hit");      echo "  control count_matches with a regular expression: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_matches -F needle "$d/locked");     echo "  control count_matches on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_matches -F needle "$d/hit" "$d/locked"); echo "  control count_matches on readable plus unreadable: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/hit"); echo "  control count_from_file on the same file: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/miss"); echo "  control count_from_file on a file with none: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_from_file -F "$d/patterns" "$d/locked"); echo "  control count_from_file on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/bytes");    echo "  control count_bytes, control bytes in a file with ESC, ESC and SI: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_bytes "$NONASCII_CLASS" "$d/bytes"); echo "  control count_bytes, non-ASCII bytes in a file with one two-byte character: $r (expect 2)"; [ "$r" = 2 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/miss");     echo "  control count_bytes on a clean file: $r (expect 0)"; [ "$r" = 0 ] || ok=no
      r=$(count_bytes "$CTRL_CLASS" "$d/locked");   echo "  control count_bytes on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
      r=$(count_lines "$d/hit");                    echo "  control count_lines on a three-line file: $r (expect 3)"; [ "$r" = 3 ] || ok=no
      r=$(count_lines "$d/locked");                 echo "  control count_lines on an unreadable file: $r (expect error)"; [ "$r" = error ] || ok=no
    
      chmod 644 "$d/locked"
      rm -rf "$d"
      counting_controls_ok=$ok
      echo "  counting controls: $([ "$ok" = yes ] && echo "all as expected" || echo FAILED)"
    }

## counting controls (every form, before any of them is used)
