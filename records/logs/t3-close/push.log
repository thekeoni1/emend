## script that wrote this log
    #!/usr/bin/env bash
    # T3 close-out push.log (specs/0006-passthrough.md "Close-out push (after P2)",
    # following specs/0003-ci.md "Close-out push (after P2)"), in two parts.
    # Every check is evaluated once and that single result is printed; a check
    # with more than one condition is evaluated inside one function.
    # Usage: t3close-push.sh pre > <scratch file>
    #          step 2: env, hook and full gate; records the base (origin/main)
    #          and the count of commits to push. No push.
    #        t3close-push.sh push <base> >> <scratch file>
    #          steps 3 and 4: refuses unless origin/main still equals <base>,
    #          pushes, and checks the hook's range, the count and git's report
    #          against <base> recorded in part 1, never against origin/main read
    #          after the push (T0b close-out departure 1).
    # The caller moves the file into records/logs/t3-close/ afterwards.
    # Authentication uses the existing git credential helper; no authentication
    # output is captured.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    MODE=${1:?pre or push}
    REPO=thekeoni1/emend
    URL=https://github.com/thekeoni1/emend.git
    EXPECT_BASE=83c9852
    EXPECT_COUNT=32
    export GIT_TERMINAL_PROMPT=0 RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    ctrl_bytes() { LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177' < "$1" | wc -c; }
    show() { # show <label> <file>
      echo "$1:"
      sed 's/^/    /' "$2"
    }
    # check <label> <yes|no>: print a result evaluated once.
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    # exit_and_bytes <exit> <bytes> <want exit> <want bytes>: both match.
    exit_and_bytes() { [ "$1" -eq "$3" ] && [ "$2" -eq "$4" ]; }
    # starts_with <full sha> <prefix>: the sha begins with the prefix.
    starts_with() { [ -n "$1" ] && [ "${1#"$2"}" != "$1" ]; }
    # same_nonempty <a> <b>: both set and equal.
    same_nonempty() { [ -n "$1" ] && [ "$1" = "$2" ]; }
    # hook_count_is <file> <n>: the hook's summary line names n commits and 0
    # findings.
    hook_count_is() {
      LC_ALL=C /usr/bin/grep -q -E "^privacy: $2 commit[(]s[)], [0-9]+ blob[(]s[)] scanned, 0 finding[(]s[)]\$" "$1"
    }
    
    case "$MODE" in
      pre)
        echo "about: T3 close-out push of main at $(git rev-parse main); HEAD at run: $(git rev-parse HEAD)"
        echo "phase: T3 close-out (specs/0006-passthrough.md \"Close-out push (after P2)\") push.log part 1, step 2; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)"
        echo
        echo "## script that wrote this log"
        sed 's/^/    /' "$0"
        echo
        STATUS=$(git status --porcelain | tr '\n' ' ')
        check "working tree clean before the run" "$(yn [ -z "$STATUS" ])"
        MAIN=$(git rev-parse main)
        echo "branch: $(git symbolic-ref --short HEAD); main is $MAIN; commits on main: $(git rev-list --count main)"
        check "HEAD is main" "$(yn [ "$(git rev-parse HEAD)" = "$MAIN" ])"
        RURL=$(git remote get-url origin)
        echo "origin: $RURL"
        check "origin is $URL" "$(yn [ "$RURL" = "$URL" ])"
        BASE=$(git rev-parse origin/main)
        COUNT=$(git rev-list --count "$BASE..$MAIN")
        echo "base recorded before the push: origin/main (local tracking ref) is $BASE"
        echo "commits to push: $COUNT"
        check "base starts with $EXPECT_BASE" "$(yn starts_with "$BASE" "$EXPECT_BASE")"
        check "commits to push: $COUNT (expect $EXPECT_COUNT)" "$(yn [ "$COUNT" = "$EXPECT_COUNT" ])"
        echo "commits to push (oldest first):"
        git log --reverse --format='    %H %s' "$BASE..$MAIN"
        echo
    
        echo "## step 2: pre-push state and full gate"
        DSET=$([ -n "${EMEND_PRIVATE_DENYLIST+set}" ] && echo yes || echo no)
        check "EMEND_PRIVATE_DENYLIST is unset (set: $DSET)" "$(yn [ "$DSET" = no ])"
        echo "command: git config --get core.hooksPath"
        git config --get core.hooksPath > "$T/out" 2>&1
        rc=$?
        show output "$T/out"
        n=$(wc -c < "$T/out")
        check "exit $rc and output bytes $n (expect exit 1 and 0 bytes)" "$(yn exit_and_bytes "$rc" "$n" 1 0)"
        echo "command: ls -l .git/hooks/pre-push"
        ls -l .git/hooks/pre-push | sed 's/^/    /'
        check "hook is executable" "$(yn [ -x .git/hooks/pre-push ])"
        awk '/^cat >"\$hook" <<.HOOK.$/ { p = 1; next } /^HOOK$/ { p = 0 } p' scripts/install-hooks.sh > "$T/heredoc"
        n=$(wc -l < "$T/heredoc")
        check "installer heredoc lines: $n (expect more than 0)" "$(yn [ "$n" -gt 0 ])"
        echo "hook sha256 $(sha256sum < .git/hooks/pre-push | cut -d' ' -f1); installer heredoc sha256 $(sha256sum < "$T/heredoc" | cut -d' ' -f1)"
        check "hook equals what scripts/install-hooks.sh writes" "$(yn cmp -s .git/hooks/pre-push "$T/heredoc")"
        echo "command: scripts/check.sh"
        scripts/check.sh > "$T/out" 2> "$T/err" </dev/null
        rc=$?
        show stdout "$T/out"
        show stderr "$T/err"
        echo "exit: $rc; stderr bytes: $(wc -c < "$T/err")"
        check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
        check "stderr is empty" "$(yn [ ! -s "$T/err" ])"
        printf 'PASS host\nPASS i686\nPASS fmt\nPASS clippy\nPASS native (allowlisted -sys: none)\nPASS licences\nPASS hygiene\nPASS privacy\n' > "$T/want"
        check "stdout is exactly the eight PASS lines in order" "$(yn cmp -s "$T/out" "$T/want")"
        n=$(ctrl_bytes "$T/out"); check "check.sh stdout control bytes: $n (expect 0)" "$(yn [ "$n" -eq 0 ])"
        n=$(ctrl_bytes "$T/err"); check "check.sh stderr control bytes: $n (expect 0)" "$(yn [ "$n" -eq 0 ])"
        STATUS=$(git status --porcelain | tr '\n' ' ')
        check "status after the gate (expect empty): $STATUS" "$(yn [ -z "$STATUS" ])"
        echo "part 1 checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
        ;;
    
      push)
        BASE=${2:?base recorded in part 1 required}
        echo
        echo "# push.log part 2, steps 3 and 4; run at $(date -u +%Y-%m-%dT%H:%M:%SZ); HEAD at run: $(git rev-parse HEAD)"
        if [ -n "${EMEND_PRIVATE_DENYLIST+set}" ]; then echo "refusing: EMEND_PRIVATE_DENYLIST is set"; exit 1; fi
        if [ -n "$(git config --get core.hooksPath)" ]; then echo "refusing: core.hooksPath is set"; exit 1; fi
        if [ "$(git rev-parse origin/main)" != "$BASE" ]; then echo "refusing: origin/main is no longer the base recorded in part 1"; exit 1; fi
        echo "EMEND_PRIVATE_DENYLIST unset, core.hooksPath empty, and origin/main still the recorded base (the script refuses otherwise)"
        MAIN=$(git rev-parse main)
        COUNT=$(git rev-list --count "$BASE..$MAIN")
        echo "main is $MAIN; base (recorded in part 1) is $BASE; commits in base..main: $COUNT"
        echo
        echo "## step 3: push"
        echo "command: git push origin main"
        git push origin main > "$T/out" 2> "$T/err" </dev/null
        rc=$?
        show stdout "$T/out"
        show stderr "$T/err"
        echo "exit: $rc"
        check "push exit is 0" "$(yn [ "$rc" -eq 0 ])"
        cat "$T/out" "$T/err" > "$T/both"
        check "the hook printed PASS privacy" "$(yn env LC_ALL=C /usr/bin/grep -q -x 'PASS privacy' "$T/both")"
        check "the hook's range is $BASE..$MAIN (the recorded base)" "$(yn env LC_ALL=C /usr/bin/grep -q -x -F "pre-push: scripts/privacy.sh --range $BASE..$MAIN (refs/heads/main)" "$T/both")"
        check "commits in the recorded base..main: $COUNT (expect $EXPECT_COUNT)" "$(yn [ "$COUNT" = "$EXPECT_COUNT" ])"
        check "the hook scanned $COUNT commits with 0 findings" "$(yn hook_count_is "$T/both" "$COUNT")"
        check "git reported ${BASE:0:7}..${MAIN:0:7} for main" "$(yn env LC_ALL=C /usr/bin/grep -q -x -F "   ${BASE:0:7}..${MAIN:0:7}  main -> main" "$T/both")"
        n=$(ctrl_bytes "$T/both"); check "push output control bytes: $n (expect 0)" "$(yn [ "$n" -eq 0 ])"
        echo
        echo "## step 4: remote main equals local main, repository still private"
        echo "command: git ls-remote origin refs/heads/main"
        git ls-remote origin refs/heads/main > "$T/ls" 2> "$T/lserr" </dev/null
        rc=$?
        show stdout "$T/ls"
        show stderr "$T/lserr"
        echo "exit: $rc"
        check "ls-remote exit is 0" "$(yn [ "$rc" -eq 0 ])"
        REMOTE=$(cut -f1 "$T/ls")
        echo "command: git rev-parse main"
        echo "    $MAIN"
        check "remote main equals local main" "$(yn same_nonempty "$REMOTE" "$MAIN")"
        echo "command: gh repo view $REPO --json visibility"
        gh repo view "$REPO" --json visibility > "$T/vis" 2> "$T/viserr" </dev/null
        rc=$?
        show stdout "$T/vis"
        show stderr "$T/viserr"
        echo "exit: $rc"
        check "gh exit is 0" "$(yn [ "$rc" -eq 0 ])"
        check "still PRIVATE" "$(yn env LC_ALL=C /usr/bin/grep -q -F '"visibility":"PRIVATE"' "$T/vis")"
        STATUS=$(git status --porcelain | tr '\n' ' ')
        check "working tree clean (expect empty): $STATUS" "$(yn [ -z "$STATUS" ])"
        echo "part 2 checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
        ;;
      *)
        echo "unknown mode" >&2
        exit 2
        ;;
    esac
    exit "$fail"

