## script
    #!/usr/bin/env bash
    # T3 P1 negative.log (specs/0006-passthrough.md, P1 deliverables): the runner
    # and the record script exercised on a scratch corpus directory that this
    # script builds under <scratch>, reached through the EMEND_CORPUS_DIR override
    # (no --corpus, no --out), never the real corpus directory. The workbooks are
    # generated by a Python generator from fictional content; the manifest's
    # original_name and note columns carry random sentinels that must never
    # appear in anything the runner or the record script prints or writes.
    #   case 1: a normal file: ok, the diff exit recorded, the entry rows appended;
    #   case 2: PASSTHROUGH_FAULT=sleep with --timeout 2: timeout;
    #   case 3: panic: panic, exit 101;
    #   case 4: abort: crash with the signal;
    #   case 5: exit3: crash with exit 3;
    #   case 6: alloc with --memory 256: error or crash, whichever it gives, recorded;
    #   case 7: the fault variable without PASSTHROUGH_FAULT_ALLOWED: the tool
    #           refuses with exit 2 and the runner records error;
    #   case 8: the record script over that run directory: the .md and .tsv written
    #           under <scratch>, with the family table and the non-ok list;
    #   case 9 (added on check 1): a run directory that cannot be created: one
    #           error line without a path, exit 2;
    #   case 10 (added on check 1): an id that already has a summary row in the
    #           run directory: refused with exit 2, the summary unchanged.
    # Each check is evaluated once, and a check with more than one condition is
    # evaluated inside one function. Every captured output is counted for the
    # sentinels, the scratch path, control bytes and non-ASCII bytes.
    # Usage: t3p1-negative.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/t3-p1/negative.log. Paths print as <scratch>.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    unset PASSTHROUGH_FAULT PASSTHROUGH_FAULT_ALLOWED EMEND_CORPUS_DIR
    G=/usr/bin/grep
    BASE=$(mktemp -d)
    trap 'rm -rf "$BASE"' EXIT
    fail=0
    RC=0
    PT=target/debug/passthrough
    XD=target/debug/xlsx-diff
    RUNNER=scripts/passthrough-run.sh
    RECORD=scripts/passthrough-record.py
    
    # The binaries are built from the working tree, so the run starts only at the
    # phase commit with a clean tree.
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    if [ -n "$(git status --porcelain)" ]; then echo "working tree not clean" >&2; exit 2; fi
    
    rnd() { LC_ALL=C tr -dc "$1" </dev/urandom | head -c "$2"; }
    S_NAME="zq$(rnd 'a-z0-9' 14)"
    S_NOTE="zq$(rnd 'a-z0-9' 14)"
    S_CONTENT="zq$(rnd 'a-z0-9' 14)"
    PHRASE="fictional neg""ative content"
    FORBIDDEN=("$S_NAME" "$S_NOTE" "$S_CONTENT" "$PHRASE")
    CORPUS=$BASE/corpus
    
    hide() {
      local line f
      while IFS= read -r line || [ -n "$line" ]; do
        line=${line//"$BASE"/<scratch>}
        for f in "${FORBIDDEN[@]}"; do line=${line//"$f"/<fixture>}; done
        printf '%s\n' "$line"
      done
    }
    count_forbidden() { LC_ALL=C "$G" -a -c -F -f <(printf '%s\n' "${FORBIDDEN[@]}") "$@" | awk -F: '{ n += $NF } END { print n + 0 }'; }
    count_path() { LC_ALL=C "$G" -a -c -F -e "$BASE" "$@" | awk -F: '{ n += $NF } END { print n + 0 }'; }
    ctrl_bytes() { cat "$@" | LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177' | wc -c; }
    nonascii_bytes() { cat "$@" | LC_ALL=C tr -cd '\200-\377' | wc -c; }
    note() { echo "  $1: $2"; [ "$2" = as-expected ] || fail=1; }
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    # all_zero <n>...: every count given is 0.
    all_zero() { local v; for v in "$@"; do [ "$v" -eq 0 ] || return 1; done; }
    # field <summary file> <id> <column name>: one column of the summary row for id.
    field() {
      awk -F'\t' -v id="$2" -v name="$3" 'NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next } $1 == id { print $col[name] }' "$1"
    }
    # summary_is <id> <outcome> <exit> <signal> <diff_exit>: the one summary row
    # for id has exactly these values.
    summary_is() {
      [ "$(awk -F'\t' -v id="$1" '$1 == id' "$SUMMARY" | wc -l)" -eq 1 ] &&
        [ "$(field "$SUMMARY" "$1" outcome)" = "$2" ] &&
        [ "$(field "$SUMMARY" "$1" exit)" = "$3" ] &&
        [ "$(field "$SUMMARY" "$1" signal)" = "$4" ] &&
        [ "$(field "$SUMMARY" "$1" diff_exit)" = "$5" ]
    }
    # stdout_is <file> <id> <outcome> <diff exit>: the runner printed exactly one
    # file line for id with that outcome and diff exit, a wall time and RSS field
    # of the right shape, and a count line with exactly one file.
    stdout_is() {
      [ "$(wc -l <"$1")" -eq 2 ] &&
        LC_ALL=C "$G" -q -x -E "$2 host $3 $4 ([0-9]+[.][0-9]{2}|-) ([0-9]+|-)" "$1" &&
        [ "$(tail -n 1 "$1" | cut -d' ' -f1-2)" = "files 1" ]
    }
    # count_line_is <file> <outcome>: the count line gives 1 for that outcome and
    # 0 for the others.
    count_line_is() {
      local want="files 1" o
      for o in ok error timeout panic crash; do
        if [ "$o" = "$2" ]; then want="$want $o 1"; else want="$want $o 0"; fi
      done
      [ "$(tail -n 1 "$1")" = "$want" ]
    }
    # md_heading <file> <line>: the file holds that exact line.
    md_heading() { LC_ALL=C "$G" -q -x -F -e "$2" "$1"; }
    # md_total <file> <entries>: the family table's total row counts that many entries.
    md_total() { LC_ALL=C "$G" -q -E "^\\| total \\| $2 \\|" "$1"; }
    # alloc_recorded <id>: the row is error (exit 2) or crash (a signal or an
    # exit), with the diff exit empty.
    alloc_recorded() {
      local o
      o=$(field "$SUMMARY" "$1" outcome)
      { [ "$o" = error ] && [ "$(field "$SUMMARY" "$1" exit)" = 2 ]; } ||
        { [ "$o" = crash ] && [ -n "$(field "$SUMMARY" "$1" signal)$(field "$SUMMARY" "$1" exit)" ]; } || return 1
      [ -z "$(field "$SUMMARY" "$1" diff_exit)" ]
    }
    
    echo "about: T3 P1 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: T3 P1 (specs/0006-passthrough.md) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    echo "The scratch corpus and every run output live under <scratch> and are deleted on exit."
    echo "fixture strings counted in every captured output and written file: ${#FORBIDDEN[@]} (random sentinels for original_name, note and content, and the content phrase; all built at run time; values never printed)"
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    
    echo
    echo "## counter controls"
    printf '%s\n' "${FORBIDDEN[@]}" >"$BASE/ctl-forbidden"
    printf 'x %s y\n' "$BASE" >"$BASE/ctl-path"
    printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$BASE/ctl-bytes"
    printf 'plain\ttab\r\n' >"$BASE/ctl-clean"
    ctl() { local r; r=$([ "$2" = "$3" ] && echo as-expected || echo UNEXPECTED); echo "  control $1: $2 (expect $3): $r"; [ "$r" = as-expected ] || fail=1; }
    ctl "lines with a fixture string in a file holding each once" "$(count_forbidden "$BASE/ctl-forbidden")" "${#FORBIDDEN[@]}"
    ctl "lines with a fixture string in a clean file" "$(count_forbidden "$BASE/ctl-clean")" 0
    ctl "lines with the scratch path in a file holding it once" "$(count_path "$BASE/ctl-path")" 1
    ctl "lines with a fixture string over two files holding them" "$(count_forbidden "$BASE/ctl-forbidden" "$BASE/ctl-forbidden")" "$((2 * ${#FORBIDDEN[@]}))"
    ctl "control bytes in a file with ESC, ESC and SI" "$(ctrl_bytes "$BASE/ctl-bytes")" 3
    ctl "non-ASCII bytes in a file with one two-byte character" "$(nonascii_bytes "$BASE/ctl-bytes")" 2
    ctl "control and non-ASCII bytes in a clean file" "$(($(ctrl_bytes "$BASE/ctl-clean") + $(nonascii_bytes "$BASE/ctl-clean")))" 0
    
    echo
    echo "## build"
    echo "command: cargo build -p passthrough -p xlsx-diff"
    cargo build -p passthrough -p xlsx-diff >"$BASE/build.out" 2>&1 </dev/null
    RC=$?
    echo "  exit: $RC"
    note "build exit 0" "$(is [ "$RC" -eq 0 ])"
    note "binary $PT exists" "$(is [ -x "$PT" ])"
    note "binary $XD exists" "$(is [ -x "$XD" ])"
    
    echo
    echo "## scratch corpus"
    mkdir -m 700 "$CORPUS" "$CORPUS/corpus"
    cat >"$BASE/gen.py" <<'PY'
    import hashlib, os, sys, zipfile
    corpus, s_name, s_note, s_content, phrase = sys.argv[1:6]
    cases = ("normal", "sleep", "panic", "abort", "exit3", "alloc", "unguarded")
    parts = (
        "[Content_Types].xml", "_rels/.rels", "docProps/app.xml", "xl/workbook.xml",
        "xl/_rels/workbook.xml.rels", "xl/worksheets/sheet1.xml", "xl/styles.xml", "xl/sharedStrings.xml",
    )
    header = ["id", "sha256", "bytes", "ext", "producer", "producer_version", "app", "source", "tags", "added", "original_name", "note"]
    rows = ["\t".join(header)]
    for k, case in enumerate(cases):
        path = os.path.join(corpus, "work.zip")
        with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
            for part in parts:
                info = zipfile.ZipInfo(part, date_time=(2026, 1, 2, 3, 4, 6))
                info.compress_type = zipfile.ZIP_DEFLATED
                info.external_attr = 0o100644 << 16
                body = "".join("%s %s %s row %d\n" % (phrase, case, s_content, i) for i in range(30))
                z.writestr(info, body)
        data = open(path, "rb").read()
        os.remove(path)
        sha = hashlib.sha256(data).hexdigest()
        ident = sha[:12]
        target = os.path.join(corpus, "corpus", ident + ".xlsx")
        with open(target, "wb") as handle:
            handle.write(data)
        os.chmod(target, 0o600)
        rows.append("\t".join([ident, sha, str(len(data)), "xlsx", "libreoffice", "unknown", "none", "maintainer",
                               "plain,strings", "2026-09-15", "%s-%s.xlsx" % (s_name, case), "%s %s note" % (s_note, case)]))
        with open(os.path.join(corpus, "ids-" + case), "w") as handle:
            handle.write(ident + "\n")
        print("%s: id %s, %d bytes, zipfile testzip %s" % (case, ident, len(data),
              "ok" if zipfile.ZipFile(target).testzip() is None else "failed"))
    with open(os.path.join(corpus, "manifest.tsv"), "w") as handle:
        handle.write("\n".join(rows) + "\n")
    PY
    echo "command: python3 <scratch>/gen.py <scratch>/corpus <sentinel> <sentinel> <sentinel> <phrase>"
    python3 "$BASE/gen.py" "$CORPUS" "$S_NAME" "$S_NOTE" "$S_CONTENT" "$PHRASE" >"$BASE/gen.out" 2>&1
    RC=$?
    echo "  exit: $RC"
    hide <"$BASE/gen.out" | sed 's/^/    /'
    note "gen.py exit 0" "$(is [ "$RC" -eq 0 ])"
    note "seven workbooks, every entry readable by zipfile" "$(is [ "$(LC_ALL=C "$G" -c -E '^[a-z0-9]+: id [0-9a-f]{12}, [0-9]+ bytes, zipfile testzip ok$' "$BASE/gen.out")" = 7 ])"
    note "manifest: a header and seven rows of twelve columns" "$(is [ "$(awk -F'\t' 'NF == 12' "$CORPUS/manifest.tsv" | wc -l)" = 8 ])"
    note "the name sentinel is in the original_name column of all seven rows and not in the header" "$(is [ "$(LC_ALL=C "$G" -c -F -e "$S_NAME" "$CORPUS/manifest.tsv")" = 7 ])"
    note "the note sentinel is in the note column of all seven rows and not in the header" "$(is [ "$(LC_ALL=C "$G" -c -F -e "$S_NOTE" "$CORPUS/manifest.tsv")" = 7 ])"
    id_of() { tr -d '\n' <"$CORPUS/ids-$1"; }
    for case in normal sleep panic abort exit3 alloc unguarded; do echo "  id for case $case: $(id_of "$case")"; done
    
    RUN_OUTS=()
    # run_case <name> <env assignments...> -- <runner arguments...>
    run_case() {
      local name=$1 start end f fb p c n r
      shift
      local envs=()
      while [ "$1" != -- ]; do envs+=("$1"); shift; done
      shift
      echo "command: env EMEND_CORPUS_DIR=<scratch>/corpus${envs[*]:+ ${envs[*]}} $RUNNER --label host --passthrough $PT --xlsx-diff $XD $*" | hide
      start=$(date +%s)
      env EMEND_CORPUS_DIR="$CORPUS" "${envs[@]}" "$RUNNER" --label host --passthrough "$PT" --xlsx-diff "$XD" "$@" \
        >"$BASE/$name.out" 2>"$BASE/$name.err" </dev/null
      RC=$?
      end=$(date +%s)
      echo "  stdout:"
      hide <"$BASE/$name.out" | sed 's/^/    /'
      echo "  stderr:"
      hide <"$BASE/$name.err" | sed 's/^/    /'
      echo "  exit: $RC; runner seconds: $((end - start))"
      RUN_OUTS+=("$BASE/$name.out" "$BASE/$name.err")
      fb=$(count_forbidden "$BASE/$name.out" "$BASE/$name.err")
      p=$(count_path "$BASE/$name.out" "$BASE/$name.err")
      c=$(ctrl_bytes "$BASE/$name.out" "$BASE/$name.err")
      n=$(nonascii_bytes "$BASE/$name.out" "$BASE/$name.err")
      r=$(is all_zero "$fb" "$p" "$c" "$n")
      echo "  runner output: lines with a fixture string=$fb, lines with the scratch path=$p, control bytes=$c, non-ASCII bytes=$n (expect 0, 0, 0 and 0): $r"
      [ "$r" = as-expected ] || fail=1
      SECONDS_TAKEN=$((end - start))
    }
    
    echo
    echo "## case 1: a normal file"
    run_case normal -- --ids "$CORPUS/ids-normal"
    ID=$(id_of normal)
    RUNS_DIR=$(find "$CORPUS/runs" -mindepth 1 -maxdepth 1 -type d)
    SUMMARY=$RUNS_DIR/summary.host.tsv
    ENTRIES=$RUNS_DIR/entries.host.tsv
    echo "  run directory: <scratch>/corpus/runs/$(basename "$RUNS_DIR")"
    note "runner exit 0" "$(is [ "$RC" -eq 0 ])"
    note "one run directory under <corpus>/runs/, named <utc-date>-<shortsha of HEAD>" "$(is [ "$(basename "$RUNS_DIR")" = "$(date -u +%Y-%m-%d)-$(git rev-parse --short HEAD)" ])"
    "$XD" "$CORPUS/corpus/$ID.xlsx" "$RUNS_DIR/$ID/out.host.xlsx" >"$BASE/by-hand.tsv" 2>"$BASE/by-hand.err" </dev/null
    HAND=$?
    echo "  xlsx-diff run by hand on the same pair: exit $HAND; entry rows $(LC_ALL=C "$G" -c -P '^entry\t' "$BASE/by-hand.tsv"); stderr bytes $(wc -c <"$BASE/by-hand.err")"
    note "summary row: ok, exit 0, no signal, diff exit as by hand" "$(is summary_is "$ID" ok 0 "" "$HAND")"
    note "runner stdout: the file line and the count line" "$(is stdout_is "$BASE/normal.out" "$ID" ok "$HAND")"
    note "count line: one ok" "$(is count_line_is "$BASE/normal.out" ok)"
    note "entries.host.tsv: the eight entry rows, each prefixed by the id and the label" "$(is [ "$(awk -F'\t' -v id="$ID" '$1 == id && $2 == "host" && $3 == "entry"' "$ENTRIES" | wc -l)" = 8 ])"
    note "entries.host.tsv rows equal the by-hand rows after the prefix" "$(is cmp -s <(awk -F'\t' -v OFS='\t' 'NR > 1 { $1 = $1; sub(/^[^\t]*\t[^\t]*\t/, ""); print }' "$ENTRIES") <(LC_ALL=C "$G" -P '^entry\t' "$BASE/by-hand.tsv"))"
    echo "  summary.host.tsv so far:"
    hide <"$SUMMARY" | sed 's/^/    /'
    
    echo
    echo "## case 2: sleep with --timeout 2"
    run_case sleep PASSTHROUGH_FAULT=sleep PASSTHROUGH_FAULT_ALLOWED=1 -- --ids "$CORPUS/ids-sleep" --timeout 2
    ID=$(id_of sleep)
    note "runner exit 0" "$(is [ "$RC" -eq 0 ])"
    note "summary row: timeout, exit 124, signal 9, no diff exit" "$(is summary_is "$ID" timeout 124 9 "")"
    note "runner stdout: the file line and the count line" "$(is stdout_is "$BASE/sleep.out" "$ID" timeout -)"
    note "count line: one timeout" "$(is count_line_is "$BASE/sleep.out" timeout)"
    note "the runner took under 10 s (the fault sleeps 30 s): $SECONDS_TAKEN" "$(is [ "$SECONDS_TAKEN" -lt 10 ])"
    note "no output file left for the case" "$(is [ ! -e "$RUNS_DIR/$ID/out.host.xlsx" ])"
    # A passthrough child that survived the timeout would still hold the scratch
    # path in its command line (added on check 1).
    sleep 1
    SURVIVORS=$(pgrep -f -c -- "$BASE")
    note "processes whose command line holds the scratch path, 1 s after the runner returned: ${SURVIVORS} (expect 0)" "$(is [ "$SURVIVORS" -eq 0 ])"
    
    echo
    echo "## case 3: panic"
    run_case panic PASSTHROUGH_FAULT=panic PASSTHROUGH_FAULT_ALLOWED=1 -- --ids "$CORPUS/ids-panic"
    ID=$(id_of panic)
    note "runner exit 0" "$(is [ "$RC" -eq 0 ])"
    note "summary row: panic, exit 101, no signal, no diff exit" "$(is summary_is "$ID" panic 101 "" "")"
    note "runner stdout: the file line and the count line" "$(is stdout_is "$BASE/panic.out" "$ID" panic -)"
    note "count line: one panic" "$(is count_line_is "$BASE/panic.out" panic)"
    
    echo
    echo "## case 4: abort"
    run_case abort PASSTHROUGH_FAULT=abort PASSTHROUGH_FAULT_ALLOWED=1 -- --ids "$CORPUS/ids-abort"
    ID=$(id_of abort)
    note "runner exit 0" "$(is [ "$RC" -eq 0 ])"
    note "summary row: crash, no exit, signal 6, no diff exit" "$(is summary_is "$ID" crash "" 6 "")"
    note "runner stdout: the file line and the count line" "$(is stdout_is "$BASE/abort.out" "$ID" crash -)"
    note "count line: one crash" "$(is count_line_is "$BASE/abort.out" crash)"
    
    echo
    echo "## case 5: exit3"
    run_case exit3 PASSTHROUGH_FAULT=exit3 PASSTHROUGH_FAULT_ALLOWED=1 -- --ids "$CORPUS/ids-exit3"
    ID=$(id_of exit3)
    note "runner exit 0" "$(is [ "$RC" -eq 0 ])"
    note "summary row: crash, exit 3, no signal, no diff exit" "$(is summary_is "$ID" crash 3 "" "")"
    note "runner stdout: the file line and the count line" "$(is stdout_is "$BASE/exit3.out" "$ID" crash -)"
    note "count line: one crash" "$(is count_line_is "$BASE/exit3.out" crash)"
    
    echo
    echo "## case 6: alloc with --memory 256"
    run_case alloc PASSTHROUGH_FAULT=alloc PASSTHROUGH_FAULT_ALLOWED=1 -- --ids "$CORPUS/ids-alloc" --memory 256
    ID=$(id_of alloc)
    note "runner exit 0" "$(is [ "$RC" -eq 0 ])"
    echo "  recorded: outcome $(field "$SUMMARY" "$ID" outcome); exit '$(field "$SUMMARY" "$ID" exit)'; signal '$(field "$SUMMARY" "$ID" signal)'"
    echo "  the child's stderr, kept in the run directory:"
    hide <"$RUNS_DIR/$ID/stderr.host.txt" | sed 's/^/    /'
    note "summary row: error with exit 2, or crash with a signal or an exit; no diff exit" "$(is alloc_recorded "$ID")"
    
    echo
    echo "## case 7: the fault variable without PASSTHROUGH_FAULT_ALLOWED"
    run_case unguarded PASSTHROUGH_FAULT=exit3 -- --ids "$CORPUS/ids-unguarded"
    ID=$(id_of unguarded)
    note "runner exit 0" "$(is [ "$RC" -eq 0 ])"
    note "summary row: error, exit 2, no signal, no diff exit" "$(is summary_is "$ID" error 2 "" "")"
    note "runner stdout: the file line and the count line" "$(is stdout_is "$BASE/unguarded.out" "$ID" error -)"
    note "count line: one error" "$(is count_line_is "$BASE/unguarded.out" error)"
    echo "  the child's stderr, kept in the run directory:"
    hide <"$RUNS_DIR/$ID/stderr.host.txt" | sed 's/^/    /'
    note "the child's stderr is the refusal line" "$(is [ "$(cat "$RUNS_DIR/$ID/stderr.host.txt")" = "error: PASSTHROUGH_FAULT is set without PASSTHROUGH_FAULT_ALLOWED=1 (test-only)" ])"
    
    echo
    echo "## case 9: a run directory that cannot be created"
    : >"$BASE/blocker"
    run_case no-out-dir -- --ids "$CORPUS/ids-normal" --out "$BASE/blocker/run"
    note "runner exit 2" "$(is [ "$RC" -eq 2 ])"
    note "stdout is empty" "$(is [ ! -s "$BASE/no-out-dir.out" ])"
    note "stderr is exactly the error line" "$(is [ "$(cat "$BASE/no-out-dir.err")" = "error: cannot create the run directory" ])"
    
    echo
    echo "## case 10: an id that already has a summary row in the run directory"
    BEFORE=$(sha256sum <"$SUMMARY" | cut -d' ' -f1)
    run_case again -- --ids "$CORPUS/ids-normal"
    note "runner exit 2" "$(is [ "$RC" -eq 2 ])"
    note "stdout is empty" "$(is [ ! -s "$BASE/again.out" ])"
    note "stderr is exactly the refusal line" "$(is [ "$(cat "$BASE/again.err")" = "error: id $(id_of normal) already has a row in summary.host.tsv; use a new run directory" ])"
    note "summary.host.tsv unchanged" "$(is [ "$(sha256sum <"$SUMMARY" | cut -d' ' -f1)" = "$BEFORE" ])"
    
    echo
    echo "## the run directory after the seven runs"
    echo "  files (names relative to the run directory):"
    (cd "$RUNS_DIR" && find . -type f | sort) | sed 's/^/    /'
    echo "  summary.host.tsv:"
    hide <"$SUMMARY" | sed 's/^/    /'
    echo "  run.host.tsv:"
    hide <"$RUNS_DIR/run.host.tsv" | sed 's/^/    /'
    mapfile -t TEXTS < <(find "$RUNS_DIR" -type f ! -name 'out.*' | sort)
    fb=$(count_forbidden "${TEXTS[@]}")
    note "summary.host.tsv: a header and seven rows" "$(is [ "$(wc -l <"$SUMMARY")" = 8 ])"
    note "run.host.tsv: a header and seven rows" "$(is [ "$(wc -l <"$RUNS_DIR/run.host.tsv")" = 8 ])"
    note "text files in the run directory (${#TEXTS[@]}, copies excluded): lines with a fixture string=$fb (expect 0)" "$(is [ "$fb" -eq 0 ])"
    
    echo
    echo "## case 8: the record script over the run directory"
    mkdir "$BASE/record"
    echo "command: python3 $RECORD --run <scratch>/corpus/runs/$(basename "$RUNS_DIR") --out <scratch>/record"
    python3 "$RECORD" --run "$RUNS_DIR" --out "$BASE/record" >"$BASE/record.out" 2>"$BASE/record.err" </dev/null
    RC=$?
    echo "  stdout:"
    hide <"$BASE/record.out" | sed 's/^/    /'
    echo "  stderr:"
    hide <"$BASE/record.err" | sed 's/^/    /'
    echo "  exit: $RC"
    STEM=step0-$(basename "$RUNS_DIR")
    MD=$BASE/record/$STEM.md
    TSV=$BASE/record/$STEM.tsv
    note "record exit 0" "$(is [ "$RC" -eq 0 ])"
    note "exactly $STEM.md and $STEM.tsv written under <scratch>/record" "$(is [ "$(ls "$BASE/record" | tr '\n' ' ')" = "$STEM.md $STEM.tsv " ])"
    echo "  $STEM.md:"
    hide <"$MD" | sed 's/^/    /'
    echo "  $STEM.tsv: $(wc -l <"$TSV") lines; first line and the line after the blank line:"
    head -n 1 "$TSV" | sed 's/^/    /'
    awk 'prev == "" && NR > 1 { print; exit } { prev = $0 }' "$TSV" | sed 's/^/    /'
    note "md: the family table heading for host" "$(is md_heading "$MD" '## Entries by part family: host')"
    note "md: the total row counts 8 entries" "$(is md_total "$MD" 8)"
    note "md: families content-types, rels, workbook, worksheet, sharedStrings, styles and docProps present" "$(is [ "$(LC_ALL=C "$G" -c -E '^\| (content-types|rels|workbook|worksheet|sharedStrings|styles|docProps) \|' "$MD")" = 7 ])"
    nonok=$(awk '/^## Files not ok/ { on = 1; next } on && /^\| [0-9a-f]{12} \|/ { print $2 }' "$MD" | sort | tr '\n' ' ')
    want=$(for case in sleep panic abort exit3 alloc unguarded; do id_of "$case"; echo; done | sort | tr '\n' ' ')
    if [ "$HAND" -ne 0 ]; then want=$( (printf '%s' "$want" | tr ' ' '\n'; id_of normal; echo) | LC_ALL=C "$G" -v '^$' | sort | tr '\n' ' '); fi
    echo "  ids in the non-ok list: $nonok"
    note "md: the non-ok list holds exactly the six fault cases (and case 1 when its diff exit is not 0)" "$(is [ "$nonok" = "$want" ])"
    note "tsv: a summary header, seven rows, a blank line, an entries header and eight rows" "$(is [ "$(wc -l <"$TSV")" = 18 ])"
    fb=$(count_forbidden "$MD" "$TSV" "$BASE/record.out" "$BASE/record.err")
    p=$(count_path "$MD" "$TSV" "$BASE/record.out" "$BASE/record.err")
    c=$(ctrl_bytes "$MD" "$TSV" "$BASE/record.out" "$BASE/record.err")
    n=$(nonascii_bytes "$MD" "$TSV" "$BASE/record.out" "$BASE/record.err")
    note "record files and output: lines with a fixture string=$fb, with the scratch path=$p, control bytes=$c, non-ASCII bytes=$n (expect 0, 0, 0 and 0)" "$(is all_zero "$fb" "$p" "$c" "$n")"
    
    echo
    STATUS=$(git status --porcelain | tr '\n' ' ')
    note "main working tree status (expect empty): $STATUS" "$(is [ -z "$STATUS" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "all negative cases as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

