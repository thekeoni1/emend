## script that wrote this log
    #!/usr/bin/env bash
    # T3 P2 gate log: a full run of all eight steps.
    # Usage: t3p2-gate.sh <phase commit> [<stopped-run note>] > <gate log scratch file>
    # The note records an earlier run of this log that the environment stopped
    # (specs/0001 "Rules for every phase": start time, last completed check, reason).
    # The caller moves the file into records/logs/t3-p2/ afterwards, so nothing is
    # written in the working tree while this runs. Each check is evaluated once and
    # that single result is printed.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    C=${1:?phase commit required}
    STOPPED=${2:-}
    ROOT=$(pwd)
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    unset EMEND_PRIVATE_DENYLIST
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    DENY_FILE=$HOME/.config/emend/private-denylist.txt
    
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    if [ -n "$(git status --porcelain)" ]; then echo "working tree not clean" >&2; exit 2; fi
    
    f_ctrl()     { LC_ALL=C /usr/bin/grep -a -c -P '[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]' "$1"; }
    ctrl_bytes() { LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177' < "$1" | wc -c; }
    # check <label> <yes|no>: print a result evaluated once.
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    
    echo "about: T3 P2 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: T3 P2 (specs/0006-passthrough.md) gate.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    if [ -n "$STOPPED" ]; then echo "earlier run stopped by the environment: $STOPPED"; fi
    echo "working tree clean before the run: yes (the script exits 2 otherwise); output goes to <scratch> and is moved in afterwards"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)"
    echo "EMEND_PRIVATE_DENYLIST set: no (unset by this script); step 8 reads the private denylist at \$HOME/.config/emend/private-denylist.txt"
    echo "private denylist: $([ -f "$DENY_FILE" ] && echo present || echo MISSING), mode $(stat -c %a "$DENY_FILE" 2>/dev/null), entries $(LC_ALL=C /usr/bin/grep -c -v -E '^[[:space:]]*(#|$)' "$DENY_FILE") (never printed)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$0"
    echo
    echo "## gate files at $C"
    for f in scripts/check.sh scripts/sys-allowlist.txt scripts/privacy.sh scripts/privacy-patterns.txt scripts/privacy-identity.txt scripts/install-hooks.sh .gitignore .github/workflows/ci.yml Cargo.toml Cargo.lock tools/xlsx-diff/Cargo.toml tools/passthrough/Cargo.toml tools/size-probe/Cargo.toml; do
      echo "$f on disk sha256 $(sha256sum "$f" | cut -d' ' -f1); at $C sha256 $(git show "$C:$f" | sha256sum | cut -d' ' -f1); bytes $(wc -c < "$f")"
    done
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR"
    echo
    echo "## dependency tree (the three workspace packages and the ten crates of T1 P1; quick-xml is optional, behind size-probe's xml feature)"
    echo "command: cargo tree -e normal --prefix none"
    cargo tree -e normal --prefix none > "$T/tree" 2>&1
    echo "exit: $?"
    # The repository root prints as <repo>: the log rules require repo-relative
    # paths (T1 P1 gate log fix).
    sed -e "s#$ROOT#<repo>#g" -e 's/^/    /' "$T/tree"
    printf '%s\n' "passthrough v0.1.0" "size-probe v0.1.0" "xlsx-diff v0.1.0" "zip v8.6.0" "crc32fast v1.5.2" "cfg-if v1.0.4" "flate2 v1.1.10" "zlib-rs v0.6.8" "indexmap v2.14.2" "equivalent v1.0.2" "hashbrown v0.17.1" "memchr v2.8.3" "typed-path v0.12.3" | sort > "$T/tree-want"
    # With two workspace packages cargo tree prints a blank line between their
    # trees, which is not a crate (T3 P1's gate-attempt1.log counted it).
    sed -E 's/ \(.*\)$//' "$T/tree" | awk 'NF' | sort -u > "$T/tree-got"
    check "the tree is exactly passthrough, size-probe, xlsx-diff and the ten crates" "$(yn cmp -s "$T/tree-got" "$T/tree-want")"
    echo "command: cargo tree -e normal --prefix none --all-features (as the gate's native step reads it)"
    cargo tree -e normal --prefix none --all-features > "$T/tree-all" 2>&1
    echo "exit: $?"
    sed -e "s#$ROOT#<repo>#g" -e 's/^/    /' "$T/tree-all"
    sed -E 's/ \(.*\)$//' "$T/tree-all" | awk 'NF' | sort -u > "$T/tree-all-got"
    printf '%s\n' "quick-xml v0.42.0" | cat - "$T/tree-want" | sort > "$T/tree-all-want"
    check "with all features the tree adds exactly quick-xml v0.42.0" "$(yn cmp -s "$T/tree-all-got" "$T/tree-all-want")"
    echo
    echo "## licence listing (the same cargo metadata call and allowed list as check.sh step 6)"
    echo "command: cargo metadata --format-version 1 --all-features"
    cargo metadata --format-version 1 --all-features > "$T/metadata.json" 2> "$T/metadata-err"
    echo "exit: $?"
    python3 - "$T/metadata.json" > "$T/licences" <<'PY2'
    import json, sys
    for p in sorted(json.load(open(sys.argv[1]))["packages"], key=lambda p: (p["name"], p["version"])):
        print("%s %s: %s" % (p["name"], p["version"], p.get("license") or "<none>"))
    PY2
    sed 's/^/    /' "$T/licences"
    check "quick-xml 0.42.0 is listed with licence MIT" "$(yn /usr/bin/grep -q -x -F 'quick-xml 0.42.0: MIT' "$T/licences")"
    echo
    echo "## full run on a cold cache, started from / by absolute path"
    echo "command: cargo clean"
    cargo clean 2>&1 | sed 's/^/    /'
    echo "command: (cd / && <repo>/scripts/check.sh)"
    (cd / && "$ROOT/scripts/check.sh") > "$T/out" 2> "$T/err"
    rc=$?
    echo "stdout:"
    sed 's/^/    /' "$T/out"
    echo "stderr bytes: $(wc -c < "$T/err")"
    echo "exit: $rc"
    check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
    want="PASS host|PASS i686|PASS fmt|PASS clippy|PASS native (allowlisted -sys: none)|PASS licences|PASS hygiene|PASS privacy|"
    got=$(tr '\n' '|' < "$T/out")
    check "stdout is exactly the eight PASS lines in order" "$(yn [ "$got" = "$want" ])"
    echo
    echo "## control characters in the captured output (tab, LF and CR allowed)"
    printf 'x \033[31mred\033[m\017 y\n' > "$T/ctl"
    printf 'plain\ttab\r\n' > "$T/clean"
    n=$(ctrl_bytes "$T/ctl"); check "control: ESC and SI file -> lines=$(f_ctrl "$T/ctl") bytes=$n (expect bytes 3)" "$(yn [ "$n" -eq 3 ])"
    n=$(ctrl_bytes "$T/clean"); check "control: tab and CR file -> lines=$(f_ctrl "$T/clean") bytes=$n (expect 0)" "$(yn [ "$n" -eq 0 ])"
    for s in out err; do
      n=$(ctrl_bytes "$T/$s"); check "std$s: lines=$(f_ctrl "$T/$s") bytes=$n (expect 0)" "$(yn [ "$n" -eq 0 ])"
    done
    echo
    STATUS=$(git status --porcelain | tr '\n' ' ')
    check "status after the run (expect empty): $STATUS" "$(yn [ -z "$STATUS" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "gate log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

