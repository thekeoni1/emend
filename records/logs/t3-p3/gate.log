    #!/usr/bin/env bash
    # T3 P3 gate log: the phase's commits, the changed files, the LibreOffice
    # record against the private record and the local image, and a full run of all
    # eight check.sh steps on a cold cache.
    # Usage: t3p3-gate.sh <phase commit> [<stopped-run note>] > <gate log scratch file>
    # The note records an earlier run of this log that the environment stopped
    # (specs/0001 "Rules for every phase": start time, last completed check, reason).
    # The caller moves the file into records/logs/t3-p3/ afterwards, so nothing is
    # written in the working tree while this runs. Each check is evaluated once and
    # that single result is printed; a check with more than one condition is
    # evaluated inside one function. The corpus directory's path is never printed.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    C=${1:?phase commit required}
    STOPPED=${2:-}
    ROOT=$(pwd)
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    unset EMEND_PRIVATE_DENYLIST
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    fail=0
    DENY_FILE=$HOME/.config/emend/private-denylist.txt
    BEFORE=869796bd659d5ba810979e428a311b9c3a2a2124
    CORPUS=${EMEND_CORPUS_DIR:-$HOME/emend-testing}
    PRIVATE=$CORPUS/tools/libreoffice.md
    RECORD=records/libreoffice-2026-09-15.md
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    IMAGE_ID=3f9baefc6e233a6298c12f7cfa091fb28f47c61e7f6edffd961229a5a5ca62f1
    CHANGED=(scripts/passthrough-run.sh scripts/passthrough-record.py "$RECORD" ROADMAP.md specs/0005-corpus.md)
    
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    if [ -n "$(git status --porcelain)" ]; then echo "working tree not clean" >&2; exit 2; fi
    
    f_ctrl()     { LC_ALL=C /usr/bin/grep -a -c -P '[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]' "$1"; }
    ctrl_bytes() { LC_ALL=C tr -cd '\000-\010\013\014\016-\037\177' < "$1" | wc -c; }
    check() { echo "$1: $2"; [ "$2" = yes ] || fail=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    sha() { sha256sum | cut -c1-64; }
    # record_cites_private <record> <sha256 of the private file>: the record names
    # that sha256, so the copy can be traced to what it was copied from.
    record_cites_private() { LC_ALL=C /usr/bin/grep -q -F -e "$2" "$1"; }
    # image_present <image> <id>: podman has that image locally with that id.
    image_present() {
      local got
      got=$(podman image inspect "$1" --format '{{.Id}}' 2>/dev/null) || return 1
      [ "$got" = "$2" ]
    }
    # entrypoint_is <image> <path>: the image's configured entrypoint is exactly
    # that one-element list.
    entrypoint_is() {
      [ "$(podman image inspect "$1" --format '{{json .Config.Entrypoint}}' 2>/dev/null)" = "[\"$2\"]" ]
    }
    # entry_has_flags <file> <flag>...: the entry script read out of the image holds
    # every flag given.
    entry_has_flags() {
      local file=$1 flag
      shift
      for flag in "$@"; do
        LC_ALL=C /usr/bin/grep -q -F -e "$flag" "$file" || return 1
      done
    }
    # record_states <record> <string>...: the record holds every line given.
    record_states() {
      local file=$1 line
      shift
      for line in "$@"; do
        LC_ALL=C /usr/bin/grep -q -F -e "$line" "$file" || return 1
      done
    }
    
    echo "about: T3 P3 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: T3 P3 (specs/0006-passthrough.md) gate.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    if [ -n "$STOPPED" ]; then echo "earlier run stopped by the environment: $STOPPED"; fi
    echo "commit before the phase: $BEFORE"
    echo "working tree clean before the run: yes (the script exits 2 otherwise); output goes to <scratch> and is moved in afterwards"
    echo "ANTHROPIC_API_KEY set in this shell: $([ -n "${ANTHROPIC_API_KEY+set}" ] && echo yes || echo no)"
    echo "EMEND_CORPUS_DIR set: $([ -n "${EMEND_CORPUS_DIR+set}" ] && echo yes || echo no); the corpus directory prints as <corpus dir>"
    echo "EMEND_PRIVATE_DENYLIST set: no (unset by this script); step 8 reads the private denylist at \$HOME/.config/emend/private-denylist.txt"
    echo "private denylist: $([ -f "$DENY_FILE" ] && echo present || echo MISSING), mode $(stat -c %a "$DENY_FILE" 2>/dev/null), entries $(LC_ALL=C /usr/bin/grep -c -v -E '^[[:space:]]*(#|$)' "$DENY_FILE") (never printed)"
    echo
    echo "## script that wrote this log"
    sed 's/^/    /' "$0"
    
    echo
    echo "## commits of the phase"
    echo "command: git log --format='%H parents=%P %s' $BEFORE..$C"
    git log --format='%H parents=%P %s' "$BEFORE..$C" | sed 's/^/    /'
    for c in $(git rev-list --reverse "$BEFORE..$C"); do
      echo "command: git show --stat --format='%H %s' $c"
      git show --stat --format='%H %s' "$c" | sed 's/^/    /'
    done
    echo "command: git diff --stat $BEFORE $C"
    git diff --stat "$BEFORE" "$C" | sed 's/^/    /'
    
    echo
    echo "## the changed files at $C"
    for f in "${CHANGED[@]}"; do
      echo "$f: sha256 $(git show "$C:$f" | sha), bytes $(git show "$C:$f" | wc -c), git mode $(git ls-tree "$C" -- "$f" | cut -d' ' -f1)"
    done
    bash -n scripts/passthrough-run.sh >"$T/bash-n.out" 2>&1
    rc=$?
    echo "command: bash -n scripts/passthrough-run.sh -> exit $rc"
    check "scripts/passthrough-run.sh parses" "$(yn [ "$rc" -eq 0 ])"
    python3 -c 'import py_compile, sys; py_compile.compile(sys.argv[1], cfile=sys.argv[2], doraise=True)' \
      scripts/passthrough-record.py "$T/compiled.pyc" >"$T/py.out" 2>&1
    rc=$?
    echo "command: py_compile scripts/passthrough-record.py -> exit $rc"
    check "scripts/passthrough-record.py compiles" "$(yn [ "$rc" -eq 0 ])"
    n=$(LC_ALL=C /usr/bin/grep -c -E '/home/|/Users/|/root/' scripts/passthrough-run.sh scripts/passthrough-record.py "$RECORD" | awk -F: '{ n += $2 } END { print n + 0 }')
    printf 'x = "/home/someone/x"\n' > "$T/home-ctl"
    check "lines with a literal home path in the two scripts and the record: $n (expect 0; the control file counts $(LC_ALL=C /usr/bin/grep -c -E '/home/|/Users/|/root/' "$T/home-ctl"))" "$(yn [ "$n" -eq 0 ])"
    
    echo
    echo "## the LibreOffice record against the private record and the local image"
    PRIV_SHA=$(sha < "$PRIVATE")
    echo "<corpus dir>/tools/libreoffice.md: sha256 $PRIV_SHA, bytes $(wc -c < "$PRIVATE"), mode $(stat -c %a "$PRIVATE")"
    echo "$RECORD names that sha256: $(LC_ALL=C /usr/bin/grep -c -F -e "$PRIV_SHA" "$RECORD") line(s)"
    check "$RECORD cites the private record's sha256 as it is now" "$(yn record_cites_private "$RECORD" "$PRIV_SHA")"
    echo "command: podman --version -> $(podman --version)"
    echo "command: podman image inspect $IMAGE --format '{{.Id}}' -> $(podman image inspect "$IMAGE" --format '{{.Id}}' 2>&1 | head -c 80)"
    check "the pinned image is in local storage with the recorded id" "$(yn image_present "$IMAGE" "$IMAGE_ID")"
    check "$RECORD states the image tag and id" "$(yn record_states "$RECORD" "$IMAGE" "$IMAGE_ID")"
    check "$RECORD states the allowed stderr line and the entrypoint flags" "$(yn record_states "$RECORD" 'Warning: failed to launch javaldx - java may not function correctly' '--headless --norestore --nolockcheck --nologo')"
    echo "  (the two checks above prove the record holds those strings; the image itself is inspected below, so the record is not its own evidence)"
    check "$RECORD states the two measured findings" "$(yn record_states "$RECORD" 'The exit status is not evidence of a good load' 'substitutes an empty sheet')"
    echo "the record holds no corpus path: $(LC_ALL=C /usr/bin/grep -c -i -F -e emend-testing "$RECORD") line(s) with the corpus directory name (expect 0)"
    check "the record names no corpus path" "$(yn [ "$(LC_ALL=C /usr/bin/grep -c -i -F -e emend-testing "$RECORD")" -eq 0 ])"
    
    echo
    echo "## the image itself, not the record's own words (planning's ruling of 2026-09-15)"
    echo "The commands below are read-only container operations with rootless podman: an"
    echo "image inspect, and one container that runs cat over the entry script and exits."
    echo "No elevation, no network, nothing written outside <scratch>."
    echo "command: podman image inspect $IMAGE --format '{{json .Config.Entrypoint}}' -> $(podman image inspect "$IMAGE" --format '{{json .Config.Entrypoint}}' 2>&1 | head -c 120)"
    check "the image's entrypoint is /usr/local/bin/lo-entry.sh, as $RECORD says" "$(yn entrypoint_is "$IMAGE" /usr/local/bin/lo-entry.sh)"
    echo "command: podman run --rm --network=none --entrypoint cat $IMAGE /usr/local/bin/lo-entry.sh > <scratch>/entry"
    timeout 120 podman run --rm --network=none --entrypoint cat "$IMAGE" /usr/local/bin/lo-entry.sh >"$T/entry" 2>"$T/entry-err" </dev/null
    rc=$?
    echo "  exit: $rc; bytes $(wc -c <"$T/entry"); sha256 $(sha <"$T/entry")"
    echo "  (the file itself is not printed: it is a build input of the corpus session, and only facts about it belong in this repository)"
    check "the entry script was read out of the image" "$(yn [ "$rc" -eq 0 ] )"
    check "the entry script runs soffice with the flags $RECORD names" "$(yn entry_has_flags "$T/entry" soffice -env:UserInstallation= --headless --norestore --nolockcheck --nologo)"
    check "the entry script passes the caller's arguments through" "$(yn entry_has_flags "$T/entry" '"$@"')"
    n=$(LC_ALL=C /usr/bin/grep -c -F -e '--convert-to' "$T/entry")
    check "the entry script does not itself supply --convert-to, so the runner's tail form is what converts: $n line(s) (expect 0)" "$(yn [ "$n" -eq 0 ])"
    
    echo
    echo "## gate files at $C"
    for f in scripts/check.sh scripts/sys-allowlist.txt scripts/privacy.sh scripts/privacy-patterns.txt scripts/privacy-identity.txt scripts/install-hooks.sh .gitignore .github/workflows/ci.yml Cargo.toml Cargo.lock; do
      echo "$f on disk sha256 $(sha256sum "$f" | cut -d' ' -f1); at $C sha256 $(git show "$C:$f" | sha256sum | cut -d' ' -f1); bytes $(wc -c < "$f")"
    done
    check "no gate file, Cargo file, crate or workflow changed in $BEFORE..$C" "$(yn git diff --quiet "$BEFORE" "$C" -- scripts/check.sh scripts/sys-allowlist.txt scripts/privacy.sh scripts/privacy-patterns.txt scripts/privacy-identity.txt scripts/install-hooks.sh .gitignore .github Cargo.toml Cargo.lock tools)"
    echo "RUSTUP_AUTO_INSTALL=$RUSTUP_AUTO_INSTALL; CARGO_TERM_COLOR=$CARGO_TERM_COLOR"
    
    echo
    echo "## full run on a cold cache, started from / by absolute path"
    echo "command: cargo clean"
    cargo clean 2>&1 | sed -e "s#$ROOT#<repo>#g" -e 's/^/    /'
    echo "command: (cd / && <repo>/scripts/check.sh)"
    (cd / && "$ROOT/scripts/check.sh") > "$T/out" 2> "$T/err"
    rc=$?
    echo "stdout:"
    sed 's/^/    /' "$T/out"
    echo "stderr bytes: $(wc -c < "$T/err")"
    echo "exit: $rc"
    check "exit is 0" "$(yn [ "$rc" -eq 0 ])"
    want="PASS host|PASS i686|PASS fmt|PASS clippy|PASS native (allowlisted -sys: none)|PASS licences|PASS hygiene|PASS privacy|"
    got=$(tr '\n' '|' < "$T/out")
    check "stdout is exactly the eight PASS lines in order" "$(yn [ "$got" = "$want" ])"
    
    echo
    echo "## control characters in the captured output (tab, LF and CR allowed)"
    printf 'x \033[31mred\033[m\017 y\n' > "$T/ctl"
    printf 'plain\ttab\r\n' > "$T/clean"
    n=$(ctrl_bytes "$T/ctl"); check "control: ESC and SI file -> lines=$(f_ctrl "$T/ctl") bytes=$n (expect bytes 3)" "$(yn [ "$n" -eq 3 ])"
    n=$(ctrl_bytes "$T/clean"); check "control: tab and CR file -> lines=$(f_ctrl "$T/clean") bytes=$n (expect 0)" "$(yn [ "$n" -eq 0 ])"
    for s in out err; do
      n=$(ctrl_bytes "$T/$s"); check "std$s: lines=$(f_ctrl "$T/$s") bytes=$n (expect 0)" "$(yn [ "$n" -eq 0 ])"
    done
    
    echo
    STATUS=$(git status --porcelain | tr '\n' ' ')
    check "status after the run (expect empty): $STATUS" "$(yn [ -z "$STATUS" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "gate log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

