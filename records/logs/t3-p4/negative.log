    #!/usr/bin/env bash
    # T3 P4 negative.log (specs/0006-passthrough.md "P4: the first recorded run",
    # with planning's rulings of 2026-09-16 on the error/fail boundary, the
    # per-conversion --lo-timeout, the tolerant counts, the record's four counts and
    # headings, and option (c) for how this script runs).
    #
    # OPTION (c), planning's ruling of 2026-09-16: this script clones the repository
    # at HEAD into <scratch> and runs everything inside the clone, so nothing is
    # built or written in the main working tree (independent check 2 of T3 P3 found
    # the P3 script doing exactly that, against specs/0001). It does not build: it
    # copies target/debug/passthrough and target/debug/xlsx-diff out of the main
    # tree read-only and prints both sha256 values, which gate.log prints too from
    # the build it made at the same commit, so a checker ties the two logs by the
    # hash text. Host binaries only; these cases do not need i686.
    #
    #   The scratch corpus holds seven generated workbooks:
    #     healthy    two sheets, sound zip;
    #     truncated  one worksheet entry cut in half (the archive ends mid-entry);
    #     noct       [Content_Types].xml removed, everything else sound;
    #     chartsheet one worksheet part and one chartsheet part (P4's measured
    #                case: the spec asks whether LibreOffice writes a <table:table
    #                for a chart sheet);
    #     wsline     a workbook whose <sheet tags are broken across lines and one
    #                closed straight away, for the tolerant count;
    #     wstrap     a workbook holding <sheets>, <sheetData and <sheetPr text that
    #                a loose count would wrongly include;
    #     slow       a 40000-row workbook used for the real forced timeout. C3
    #                times this fixture and a one-row fixture against the same
    #                image and prints both, and prints the status the conversion
    #                really returns under a one-second budget, so the log holds
    #                the figures rather than this comment asserting them. The
    #                fixture is kept large so the case does not depend on a
    #                start-up that happens to be fast on another machine.
    #   cases:
    #     C1  healthy is lo ok and lo_in ok, and run.host.tsv carries lo_timeout_s;
    #     C2  truncated fails the check (lo_in fail), the reason kept;
    #     C3  a real forced timeout: --lo-timeout 1 against the pinned image gives
    #         status 124, which reads error (NOT fail), with the ruled reason text;
    #     C4  a real signal kill through podman gives a status of 128 or more, which
    #         reads error, with the ruled reason text;
    #     C5  podman failing to start the container (125 to 127) reads error;
    #     C6  the count step failing (python3 wrapper) reads error, not fail;
    #     C7  the chart-sheet workbook: the two counts are printed and compared, so
    #         the spec's conditional is answered by measurement;
    #     C8  the tolerant counts: wsline passes, wstrap is not miscounted;
    #     C9  the record script over a run holding all four lo values: the four
    #         counts per column, the failing heading holding only fail rows, and the
    #         error rows only under the could-not-run heading;
    #     C10 the record refuses an lo value outside the four, with the new text;
    #     C11 the sum guard of lo_tally: it cannot be failed by any input, so a
    #         mutated scratch copy of the record script is used, and the exact
    #         mutation and refusal are printed (planning's obligation 2);
    #     C12 --lo-timeout with a value that is not a positive whole number is
    #         refused, and the refusal is exactly the runner's own text.
    # Every check is evaluated once; a check with more than one condition is
    # evaluated inside one function.
    # Usage: t3p4-negative.sh <phase commit> > <scratch file>; the caller moves the
    # output to records/logs/t3-p4/negative.log. Paths print as <scratch>.
    set -uo pipefail
    MAIN=$(git rev-parse --show-toplevel) || exit 2
    cd "$MAIN" || exit 2
    
    C=${1:?phase commit required}
    export RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never
    unset EMEND_CORPUS_DIR CARGO_TARGET_DIR PASSTHROUGH_FAULT PASSTHROUGH_FAULT_ALLOWED
    G=/usr/bin/grep
    IMAGE=localhost/emend-lo:25.2.3-2-deb13u6
    RUNNER=scripts/passthrough-run.sh
    RECORD=scripts/passthrough-record.py
    BASE=$(mktemp -d)
    trap 'rm -rf "$BASE"' EXIT
    fail=0
    RC=0
    CLONE=$BASE/clone
    CORPUS=$BASE/corpus
    NAMES=(healthy truncated noct chartsheet wsline wstrap slow)
    
    if [ "$(git rev-parse HEAD)" != "$C" ]; then echo "HEAD is not $C" >&2; exit 2; fi
    if [ -n "$(git status --porcelain)" ]; then echo "main working tree not clean" >&2; exit 2; fi
    
    hide() {
      local line
      while IFS= read -r line || [ -n "$line" ]; do
        printf '%s\n' "${line//"$BASE"/<scratch>}"
      done
    }
    note() { echo "  $1: $2"; [ "$2" = as-expected ] || fail=1; }
    # grep_q <grep arguments...>: grep under LC_ALL=C, callable through is().
    # `is LC_ALL=C grep ...` would try to run LC_ALL=C as a command.
    grep_q() { LC_ALL=C "$G" "$@"; }
    is() { if "$@"; then echo as-expected; else echo UNEXPECTED; fi; }
    ctl() { local r; r=$([ "$2" = "$3" ] && echo as-expected || echo UNEXPECTED); echo "  control $1: $2 (expect $3): $r"; [ "$r" = as-expected ] || fail=1; }
    # The three count helpers read grep's exit status and print "error" rather than
    # a count when grep fails, because grep exits 2 or more on an error while
    # printing nothing, and a bare count compared with 0 reads that error as "no
    # hits" (specs/0001: an error is never reported as zero hits). Independent
    # check 1 of this phase found the bare-count form in all three.
    # counted <-F|-E> <pattern> <file>...: the total count across the files, or the
    # word "error" if any file could not be read.
    #
    # The files go to grep directly and are summed with -H, rather than through
    # `cat ... | grep -c`. With cat in front, an unreadable file makes CAT fail
    # while grep counts 0 over the empty stream and exits 1, so the read error
    # reads as "no hits" -- which is the very defect independent check 1 found, and
    # which my first repair did not close: it read grep's status, and grep had not
    # failed. grep given the files itself exits 2 on an unreadable one.
    counted() {
      local mode=$1 pattern=$2 out rc
      shift 2
      out=$(LC_ALL=C "$G" -a -H -c "$mode" -e "$pattern" -- "$@" 2>/dev/null); rc=$?
      if [ "$rc" -ge 2 ]; then printf 'error'; return; fi
      printf '%s\n' "$out" | awk -F: '{ n += $NF } END { print n + 0 }'
    }
    count_path() { counted -F "$BASE" "$@"; }
    count_container_words() { counted -E 'Error|Warning|javaldx' "$@"; }
    # The two byte counters read each file themselves rather than through
    # `cat "$@" | tr | wc -c`. With cat in front, an unreadable file makes cat fail
    # while tr sees an empty stream and wc prints 0, so the file reads as clean.
    # That is the same cat-in-front failure documented for the grep helpers above,
    # which I fixed there and left here; independent check 2 found it.
    byte_class_count() {
      local class=$1 total=0 f n
      shift
      for f in "$@"; do
        if [ ! -r "$f" ]; then printf 'error'; return; fi
        n=$(LC_ALL=C tr -cd "$class" <"$f" | wc -c) || { printf 'error'; return; }
        total=$((total + n))
      done
      printf '%s' "$total"
    }
    ctrl_bytes() { byte_class_count '\000-\010\013\014\016-\037\177' "$@"; }
    nonascii_bytes() { byte_class_count '\200-\377' "$@"; }
    sha() { sha256sum | cut -c1-64; }
    id_of() { cat "$BASE/id-$1"; }
    # field <summary> <id> <column>: one column of the summary row for that id.
    field() {
      awk -F'\t' -v id="$2" -v name="$3" 'NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next } $1 == id { print $col[name] }' "$1"
    }
    # lo_is <run dir> <name> <lo> <lo_in>: the summary row for that workbook has
    # exactly those two values.
    lo_is() {
      local s=$1/summary.host.tsv id
      id=$(id_of "$2")
      [ "$(field "$s" "$id" lo)" = "$3" ] && [ "$(field "$s" "$id" lo_in)" = "$4" ]
    }
    outcome_of() { field "$1/summary.host.tsv" "$(id_of "$2")" outcome; }
    # reason_is <run dir> <name> <which> <text>: the reason file holds exactly that
    # one line, so the branch is identified by its own words and not by the value.
    reason_is() {
      local id
      id=$(id_of "$2")
      [ "$(cat "$1/$id/$3-reason.host.txt" 2>/dev/null)" = "$4" ]
    }
    # clone_is_at <commit>: the clone exists, is at that commit and differs from the
    # main tree nowhere in tracked content.
    clone_is_at() {
      [ -d "$CLONE/.git" ] && [ "$(git -C "$CLONE" rev-parse HEAD)" = "$1" ] &&
        [ -z "$(git -C "$CLONE" status --porcelain)" ]
    }
    # binaries_copied <a> <b>: both exist in the clone and are executable.
    binaries_copied() { [ -x "$1" ] && [ -x "$2" ]; }
    # record_written <exit> <md> <tsv>: exit 0 and both files written.
    record_written() { [ "$1" -eq 0 ] && [ -f "$2" ] && [ -f "$3" ]; }
    # both_listed <md> <id> <id>: the record lists both ids as table rows. -a so a
    # stray byte cannot make grep treat the record as binary and report nothing
    # (independent check 1 of T3 P3 asked for this).
    both_listed() {
      LC_ALL=C "$G" -a -q -F -e "| $2 |" "$1" && LC_ALL=C "$G" -a -q -F -e "| $3 |" "$1"
    }
    # listed_between <md> <id> <start heading> <end heading>: the id appears as a
    # row between those two headings, and nowhere before the first.
    listed_between() {
      awk -v id="$2" -v start="$3" -v stop="$4" '
        $0 == start { inside = 1; next }
        $0 == stop { inside = 0 }
        index($0, "| " id " |") { if (inside) seen = 1; else outside = 1 }
        END { exit !(seen && !outside) }
      ' "$1"
    }
    # refused_bad <exit> <stdout file> <stderr file> <message>: exit 2, nothing on
    # stdout, and exactly that refusal on stderr, so the exit cannot come from
    # another cause.
    refused_bad() {
      [ "$1" -eq 2 ] && [ ! -s "$2" ] && [ "$(cat "$3")" = "$4" ]
    }
    
    echo "about: T3 P4 phase commit $C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: T3 P4 (specs/0006-passthrough.md) negative.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    echo "The scratch clone, the scratch corpus, the run directories and every captured output live under <scratch> and are deleted on exit; --corpus always names the scratch corpus, so the real corpus directory is never read."
    echo "DEPARTURE (planning's option (c) of 2026-09-16): this script runs in a scratch clone and copies the gate's two host binaries instead of building, so no cargo runs here and nothing is written in the main working tree."
    echo "image: $IMAGE (rootless podman, --network=none, no elevation; pins in records/libreoffice-2026-09-15.md)"
    echo "podman: $(podman --version)"
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    
    echo
    echo "## the container commands this log runs"
    echo "    podman run --rm --network=none --userns=keep-id -v <input directory>:/in:ro -v <scratch>/ods:/out $IMAGE --convert-to ods --outdir /out /in/<file>"
    echo "    (the image entrypoint supplies soffice -env:UserInstallation=... --headless --norestore --nolockcheck --nologo)"
    
    echo
    echo "## the scratch clone and the gate's binaries (option (c))"
    echo "command: git clone --quiet --shared <main tree> <scratch>/clone"
    git clone --quiet --shared "$MAIN" "$CLONE" 2>"$BASE/clone.err"
    RC=$?
    echo "  exit: $RC"
    git -C "$CLONE" checkout --quiet "$C" 2>>"$BASE/clone.err"
    echo "  clone HEAD: $(git -C "$CLONE" rev-parse HEAD)"
    note "the clone is at $C and its tree is clean" "$(is clone_is_at "$C")"
    mkdir -p "$CLONE/target/debug"
    PT=$CLONE/target/debug/passthrough
    XD=$CLONE/target/debug/xlsx-diff
    cp -p "$MAIN/target/debug/passthrough" "$PT" 2>>"$BASE/clone.err"
    cp -p "$MAIN/target/debug/xlsx-diff" "$XD" 2>>"$BASE/clone.err"
    echo "  copied from the main tree, read only (gate.log prints these same two hashes):"
    echo "    target/debug/passthrough: sha256 $(sha <"$PT" 2>/dev/null), bytes $(wc -c <"$PT" 2>/dev/null)"
    echo "    target/debug/xlsx-diff:   sha256 $(sha <"$XD" 2>/dev/null), bytes $(wc -c <"$XD" 2>/dev/null)"
    note "both binaries were copied into the clone and are executable" "$(is binaries_copied "$PT" "$XD")"
    MAIN_STATUS=$(git -C "$MAIN" status --porcelain | tr '\n' ' ')
    note "the main working tree is untouched so far (expect empty): $MAIN_STATUS" "$(is [ -z "$MAIN_STATUS" ])"
    cd "$CLONE" || exit 2
    echo "  every command below runs in <scratch>/clone"
    
    echo
    echo "## the scratch corpus"
    mkdir -m 700 "$CORPUS" "$CORPUS/corpus"
    cat >"$BASE/gen.py" <<'OUTER_PY'
    import hashlib, os, sys, zipfile
    base, corpus = sys.argv[1:3]
    CT = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
     '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
     '<Default Extension="xml" ContentType="application/xml"/>'
     '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>'
     '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>'
     '<Override PartName="/xl/worksheets/sheet2.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>'
     '</Types>')
    RELS = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
     '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>')
    WB = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" '
     'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets>'
     '<sheet name="Alpha" sheetId="1" r:id="rId1"/><sheet name="Beta" sheetId="2" r:id="rId2"/></sheets></workbook>')
    WBR = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
     '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/>'
     '<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet2.xml"/></Relationships>')
    def sheet(word, rows=1):
        cells = "".join(
            '<row r="%d"><c r="A%d" t="inlineStr"><is><t>fictional %s %d</t></is></c></row>' % (i, i, word, i)
            for i in range(1, rows + 1))
        return ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
         '<sheetData>%s</sheetData></worksheet>' % cells)
    PARTS = [("[Content_Types].xml", CT), ("_rels/.rels", RELS), ("xl/workbook.xml", WB),
             ("xl/_rels/workbook.xml.rels", WBR), ("xl/worksheets/sheet1.xml", sheet("one")),
             ("xl/worksheets/sheet2.xml", sheet("two"))]
    def build(path, parts):
        with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
            for name, body in parts:
                info = zipfile.ZipInfo(name, date_time=(2026, 1, 2, 3, 4, 6))
                info.compress_type = zipfile.ZIP_DEFLATED
                info.external_attr = 0o100644 << 16
                z.writestr(info, body)
    work = os.path.join(base, "work")
    os.makedirs(work, exist_ok=True)
    healthy = os.path.join(work, "healthy.xlsx")
    build(healthy, PARTS)
    # noct: [Content_Types].xml removed
    build(os.path.join(work, "noct.xlsx"), [p for p in PARTS if p[0] != "[Content_Types].xml"])
    # chartsheet: one worksheet part and one chartsheet part. P4's measured case.
    CS_CT = CT.replace(
        '<Override PartName="/xl/worksheets/sheet2.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>',
        '<Override PartName="/xl/chartsheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.chartsheet+xml"/>')
    CS_WB = WB.replace('<sheet name="Beta" sheetId="2" r:id="rId2"/>', '<sheet name="Chart" sheetId="2" r:id="rId2"/>')
    CS_WBR = WBR.replace(
        '<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet2.xml"/>',
        '<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/chartsheet" Target="chartsheets/sheet1.xml"/>')
    CHARTSHEET = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
     '<chartsheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetPr/>'
     '<sheetViews><sheetView workbookViewId="0"/></sheetViews></chartsheet>')
    build(os.path.join(work, "chartsheet.xlsx"),
          [("[Content_Types].xml", CS_CT), ("_rels/.rels", RELS), ("xl/workbook.xml", CS_WB),
           ("xl/_rels/workbook.xml.rels", CS_WBR), ("xl/worksheets/sheet1.xml", sheet("one")),
           ("xl/chartsheets/sheet1.xml", CHARTSHEET)])
    # wsline: the two <sheet tags broken across lines, one closed straight away.
    WS_WB = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" '
     'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">\n<sheets>\n'
     '<sheet\n  name="Alpha" sheetId="1" r:id="rId1"/>\n'
     '<sheet\tname="Beta" sheetId="2" r:id="rId2"/>\n</sheets>\n</workbook>')
    build(os.path.join(work, "wsline.xlsx"), [(n, WS_WB if n == "xl/workbook.xml" else b) for n, b in PARTS])
    # wstrap: text that a loose count would wrongly include, inside cell strings.
    TRAP = sheet("trap").replace("fictional trap 1",
        "a string mentioning &lt;sheets&gt; and &lt;sheetData and &lt;sheetPr and &lt;table:table-row")
    build(os.path.join(work, "wstrap.xlsx"),
          [(n, TRAP if n == "xl/worksheets/sheet1.xml" else b) for n, b in PARTS])
    # slow: many rows, so a one-second conversion budget cannot finish.
    build(os.path.join(work, "slow.xlsx"),
          [(n, sheet("slow", 40000) if n == "xl/worksheets/sheet1.xml" else b) for n, b in PARTS])
    # truncated: the healthy archive cut inside the second worksheet entry
    data = open(healthy, "rb").read()
    info = zipfile.ZipFile(healthy).getinfo("xl/worksheets/sheet2.xml")
    cut = info.header_offset + 30 + len(info.filename) + max(1, info.compress_size // 2)
    open(os.path.join(work, "truncated.xlsx"), "wb").write(data[:cut])
    header = ["id","sha256","bytes","ext","producer","producer_version","app","source","tags","added","original_name","note"]
    rows = ["\t".join(header)]
    for name in ("healthy", "truncated", "noct", "chartsheet", "wsline", "wstrap", "slow"):
        path = os.path.join(work, name + ".xlsx")
        body = open(path, "rb").read()
        sha = hashlib.sha256(body).hexdigest()
        fid = sha[:12]
        dest = os.path.join(corpus, "corpus", fid + ".xlsx")
        with open(dest, "wb") as handle:
            handle.write(body)
        os.chmod(dest, 0o600)
        rows.append("\t".join([fid, sha, str(len(body)), "xlsx", "libreoffice", "unknown", "none",
                               "libreoffice-export", "plain,strings", "2026-09-16", name + ".xlsx", "generated"]))
        with open(os.path.join(base, "id-" + name), "w") as handle:
            handle.write(fid)
        print("%s: id %s, %d bytes" % (name, fid, len(body)))
    with open(os.path.join(corpus, "manifest.tsv"), "w") as handle:
        handle.write("\n".join(rows) + "\n")
    OUTER_PY
    echo "command: python3 <scratch>/gen.py <scratch> <scratch>/corpus"
    python3 "$BASE/gen.py" "$BASE" "$CORPUS" >"$BASE/gen.out" 2>&1
    RC=$?
    echo "  exit: $RC"
    hide <"$BASE/gen.out" | sed 's/^/    /'
    note "gen.py exit 0" "$(is [ "$RC" -eq 0 ])"
    note "seven workbooks and a manifest of seven rows" "$(is [ "$(awk -F'\t' 'NF == 12' "$CORPUS/manifest.tsv" | wc -l)" = 8 ])"
    echo "  every fixture is generated by this script; no corpus file is copied (planning's ruling of 2026-09-16)"
    
    echo
    echo "## C1, C2, C7, C8: one run with --libreoffice over the sound workbooks"
    RUN=$BASE/run-lo
    printf '%s\n' "$(id_of healthy)" "$(id_of truncated)" "$(id_of noct)" "$(id_of chartsheet)" \
      "$(id_of wsline)" "$(id_of wstrap)" >"$BASE/ids-main"
    # Every --ids file is a real regular file: the runner refuses a process
    # substitution, and a missing file would make C4, C5 and C6 refuse and measure
    # nothing (the T2 P1 failure, repeated here once and caught before the run).
    printf '%s\n' "$(id_of healthy)" >"$BASE/ids-healthy"
    printf '%s\n' "$(id_of slow)" >"$BASE/ids-slow"
    echo "command: $RUNNER --label host --passthrough target/debug/passthrough --xlsx-diff target/debug/xlsx-diff --corpus <scratch>/corpus --out <scratch>/run-lo --timeout 120 --libreoffice $IMAGE --lo-timeout 300 --ids <scratch>/ids-main"
    "$CLONE/$RUNNER" --label host --passthrough "$PT" --xlsx-diff "$XD" \
      --corpus "$CORPUS" --out "$RUN" --timeout 120 --libreoffice "$IMAGE" --lo-timeout 300 \
      --ids "$BASE/ids-main" >"$BASE/run-lo.stdout" 2>"$BASE/run-lo.stderr" </dev/null
    RC=$?
    echo "  exit: $RC"
    echo "  stdout:"
    hide <"$BASE/run-lo.stdout" | sed 's/^/    /'
    echo "  stderr bytes: $(wc -c <"$BASE/run-lo.stderr")"
    note "the run exits 0" "$(is [ "$RC" -eq 0 ])"
    echo "  outcome, lo and lo_in per workbook:"
    for name in healthy truncated noct chartsheet wsline wstrap; do
      printf '    %-11s outcome=%s lo=%s lo_in=%s\n' "$name" "$(outcome_of "$RUN" "$name")" \
        "$(field "$RUN/summary.host.tsv" "$(id_of "$name")" lo)" "$(field "$RUN/summary.host.tsv" "$(id_of "$name")" lo_in)"
    done
    note "C1 healthy: lo ok, lo_in ok" "$(is lo_is "$RUN" healthy ok ok)"
    echo "  run.host.tsv header: $(head -n 1 "$RUN/run.host.tsv")"
    echo "  run.host.tsv row: $(sed -n 2p "$RUN/run.host.tsv" | hide)"
    note "C1 run.host.tsv carries lo_timeout_s and the value given" \
      "$(is [ "$(awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "lo_timeout_s") c = i; next } NR == 2 { print $c }' "$RUN/run.host.tsv")" = 300 ])"
    note "C2 truncated: lo_in fail" "$(is [ "$(field "$RUN/summary.host.tsv" "$(id_of truncated)" lo_in)" = fail ])"
    # MEASURED, and not what an earlier draft of this case asserted. The truncated
    # archive does NOT reach the "1 to 123 is fail" branch: LibreOffice exits 0 and
    # the stderr scan is what refuses it. That is the finding this repository
    # already holds in records/libreoffice-2026-09-15.md ("The exit status is not
    # evidence of a good load") and that T3 P3's M1 measured directly ("every
    # conversion exits 0, including the three that load nothing"). The assertion
    # below names the branch the file really takes.
    note "C2 truncated: the reason is the stderr branch, since the conversion itself exits 0" \
      "$(is reason_is "$RUN" truncated lo-in 'stderr holds a line with Error or Warning other than the allowed javaldx line')"
    echo "  truncated reason: $(hide <"$RUN/$(id_of truncated)/lo-in-reason.host.txt")"
    echo "  noct reason: $(hide <"$RUN/$(id_of noct)/lo-in-reason.host.txt")"
    note "C2 noct: the second refused archive, its reason recorded whichever branch it takes" \
      "$(is [ -s "$RUN/$(id_of noct)/lo-in-reason.host.txt" ])"
    echo "  NOTE for the report: which ladder branches this log reaches, counted from"
    echo "  the reasons above. Both refused archives (truncated, noct) are judged by"
    echo "  the stderr scan, because this image exits 0 even when nothing loads"
    echo "  (records/libreoffice-2026-09-15.md, and T3 P3's M1). The status-fail"
    echo "  branch, a conversion exiting 1 to 123, is therefore present and NOT"
    echo "  exercised by any case here; the report states that rather than implying"
    echo "  every branch was proved."
    
    echo
    echo "## C7: the chart sheet, the measurement the P4 spec asks for"
    echo "  The spec says: if LibreOffice writes no <table:table for a chart sheet,"
    echo "  the sheet count excludes <chartsheet parts. This measures it."
    CS_IN=$CORPUS/corpus/$(id_of chartsheet).xlsx
    mkdir -p "$BASE/cs-out"
    timeout 300 podman run --rm --network=none --userns=keep-id -v "$CORPUS/corpus":/in:ro -v "$BASE/cs-out":/out \
      "$IMAGE" --convert-to ods --outdir /out "/in/$(id_of chartsheet).xlsx" >"$BASE/cs.out" 2>"$BASE/cs.err" </dev/null
    echo "  conversion exit: $?; stderr lines: $(wc -l <"$BASE/cs.err")"
    CS_COUNTS=$(LO_REFERENCE=$CS_IN LO_ODS=$BASE/cs-out/$(id_of chartsheet).ods python3 -c '
    import os, re, zipfile
    wb = zipfile.ZipFile(os.environ["LO_REFERENCE"]).read("xl/workbook.xml").decode("utf-8", "replace")
    ct = zipfile.ZipFile(os.environ["LO_REFERENCE"]).read("[Content_Types].xml").decode("utf-8", "replace")
    od = zipfile.ZipFile(os.environ["LO_ODS"]).read("content.xml").decode("utf-8", "replace")
    names = re.findall(r"<table:table table:name=\"([^\"]*)\"", od)
    print("%d %d %d %s" % (len(re.findall(r"<sheet(?=[\s/>])", wb)),
                           ct.count("chartsheet+xml"),
                           len(re.findall(r"<table:table(?=[\s/>])", od)),
                           ",".join(names)))
    ' 2>"$BASE/cs-count.err")
    echo "  input <sheet count, chartsheet parts, ods <table:table count, table names: $CS_COUNTS"
    # Both counts inside one named function. The form $(is [ ... ] && [ ... ])
    # captures only the first test, which specs/0001 forbids by name: it dropped
    # the ODS <table:table count, which is the half this finding actually turns on.
    # Independent check 1 of this phase found it.
    chart_counts_agree() {
      local sheets tables
      sheets=$(printf '%s\n' "$1" | awk '{ print $1 }')
      tables=$(printf '%s\n' "$1" | awk '{ print $3 }')
      [ "$sheets" = 2 ] && [ "$tables" = 2 ]
    }
    echo "  the two counts this assertion reads: input <sheet=$(printf '%s\n' "$CS_COUNTS" | awk '{ print $1 }'), ods <table:table=$(printf '%s\n' "$CS_COUNTS" | awk '{ print $3 }')"
    note "C7 the chart sheet is counted as a sheet on both sides, so the spec's conditional does not apply" \
      "$(is chart_counts_agree "$CS_COUNTS")"
    note "C7 the runner's own check passes the chart-sheet workbook" "$(is lo_is "$RUN" chartsheet ok ok)"
    
    echo
    echo "## C8: the tolerant counts"
    echo "  wsline's workbook part breaks both <sheet tags across lines; wstrap holds"
    echo "  <sheets>, <sheetData, <sheetPr and <table:table-row inside a cell string."
    note "C8 wsline: counted correctly, so lo_in is ok and not a count mismatch" "$(is [ "$(field "$RUN/summary.host.tsv" "$(id_of wsline)" lo_in)" = ok ])"
    note "C8 wstrap: the trap text does not inflate the count" "$(is [ "$(field "$RUN/summary.host.tsv" "$(id_of wstrap)" lo_in)" = ok ])"
    echo "  the two counting forms against the four shapes, measured directly:"
    python3 - <<'OUTER_PY' | sed 's/^/    /'
    import re
    sheet = r"<sheet(?=[\s/>])"
    table = r"<table:table(?=[\s/>])"
    for text, want in (("<sheet ", 1), ("<sheet\n", 1), ("<sheet\t", 1), ("<sheet/>", 1),
                       ("<sheet>", 1), ("<sheets>", 0), ("<sheetData", 0), ("<sheetPr ", 0)):
        got = len(re.findall(sheet, text))
        print("sheet form %-12r -> %d (expect %d): %s" % (text, got, want, "as-expected" if got == want else "UNEXPECTED"))
    for text, want in (("<table:table ", 1), ("<table:table>", 1), ("<table:table/>", 1),
                       ("<table:table\n", 1), ("<table:table-row ", 0), ("<table:table-cell ", 0)):
        got = len(re.findall(table, text))
        print("table form %-12r -> %d (expect %d): %s" % (text, got, want, "as-expected" if got == want else "UNEXPECTED"))
    OUTER_PY
    
    echo
    echo "## C3: a real forced timeout reads error, not fail (planning's ruling 1)"
    echo "  --lo-timeout 1 against the pinned image, on a workbook with 40000 rows."
    echo "  This is a real conversion under a real budget, not a stub (planning's"
    echo "  ruling of 2026-09-16). The two timings below are measured here, not"
    echo "  asserted: the same image converts the 40000-row fixture and a one-row"
    echo "  fixture, each timed, so the log shows whether the cost is LibreOffice's"
    echo "  cold start or the sheet. Independent check 1 found the earlier form"
    echo "  claiming a conversion time the log did not hold."
    mkdir -p "$BASE/t-out"
    for pair in "slow:$(id_of slow)" "healthy:$(id_of healthy)"; do
      tname=${pair%%:*}; tid=${pair#*:}
      t0=$(date +%s.%N)
      timeout 300 podman run --rm --network=none --userns=keep-id -v "$CORPUS/corpus":/in:ro -v "$BASE/t-out":/out \
        "$IMAGE" --convert-to ods --outdir /out "/in/$tid.xlsx" >/dev/null 2>"$BASE/t-$tname.err" </dev/null
      trc=$?
      t1=$(date +%s.%N)
      printf '    %-8s conversion exit=%s wall=%s s\n' "$tname" "$trc" \
        "$(awk -v a="$t0" -v b="$t1" 'BEGIN { printf "%.1f", b - a }')"
    done
    echo "  (both are compared with the one-second budget C3 uses; if they are close"
    echo "  to each other the sheet size is not what exhausts the budget)"
    RUN3=$BASE/run-timeout
    "$CLONE/$RUNNER" --label host --passthrough "$PT" --xlsx-diff "$XD" \
      --corpus "$CORPUS" --out "$RUN3" --timeout 300 --libreoffice "$IMAGE" --lo-timeout 1 \
      --ids "$BASE/ids-slow" >"$BASE/run-timeout.stdout" 2>"$BASE/run-timeout.stderr" </dev/null
    echo "  run exit: $?"
    # The status the conversion really returned, measured here rather than inferred
    # from the reason text. Independent check 1 noted that the report claimed a
    # status of 124 that no log printed.
    t0=$(date +%s.%N)
    timeout --signal=KILL 1 podman run --rm --network=none --userns=keep-id -v "$CORPUS/corpus":/in:ro -v "$BASE/t-out":/out \
      "$IMAGE" --convert-to ods --outdir /out "/in/$(id_of slow).xlsx" >/dev/null 2>/dev/null </dev/null
    TIMEOUT_RC=$?
    t1=$(date +%s.%N)
    printf '  the same conversion under a one-second budget, timed here: exit=%s wall=%s s\n' \
      "$TIMEOUT_RC" "$(awk -v a="$t0" -v b="$t1" 'BEGIN { printf "%.1f", b - a }')"
    note "C3 the conversion under a one-second budget really returns 124, the status the ladder reads as a timeout" \
      "$(is [ "$TIMEOUT_RC" -eq 124 ])"
    echo "  lo=$(field "$RUN3/summary.host.tsv" "$(id_of slow)" lo) lo_in=$(field "$RUN3/summary.host.tsv" "$(id_of slow)" lo_in)"
    echo "  reason: $(hide <"$RUN3/$(id_of slow)/lo-in-reason.host.txt")"
    note "C3 the timed-out conversion reads error on the input side" "$(is [ "$(field "$RUN3/summary.host.tsv" "$(id_of slow)" lo_in)" = error ])"
    note "C3 the reason is exactly the ruled text" "$(is reason_is "$RUN3" slow lo-in 'the conversion timed out after 1 s')"
    
    echo
    echo "## C4: a conversion killed by a signal reads error"
    echo "  A podman wrapper that kills its own process group, so the status is 128 or more."
    mkdir -p "$BASE/fakebin-kill"
    cat >"$BASE/fakebin-kill/podman" <<'SH'
    #!/usr/bin/env bash
    # Test wrapper: die by SIGKILL, so the caller sees a status of 128 or more.
    kill -KILL $$
    SH
    chmod 755 "$BASE/fakebin-kill/podman"
    RUN4=$BASE/run-killed
    PATH=$BASE/fakebin-kill:$PATH "$CLONE/$RUNNER" --label host --passthrough "$PT" --xlsx-diff "$XD" \
      --corpus "$CORPUS" --out "$RUN4" --timeout 120 --libreoffice "$IMAGE" --lo-timeout 60 \
      --ids "$BASE/ids-healthy" >"$BASE/run-killed.stdout" 2>"$BASE/run-killed.stderr" </dev/null
    echo "  run exit: $?"
    echo "  reason: $(hide <"$RUN4/$(id_of healthy)/lo-in-reason.host.txt" 2>/dev/null)"
    note "C4 a signal-killed conversion reads error" "$(is [ "$(field "$RUN4/summary.host.tsv" "$(id_of healthy)" lo_in)" = error ])"
    note "C4 the reason names the status, not LibreOffice" "$(is grep_q -a -q -E '^the conversion was killed, exit status (13[0-9]|1[4-9][0-9]|2[0-5][0-9])$' "$RUN4/$(id_of healthy)/lo-in-reason.host.txt")"
    
    echo
    echo "## C5: podman failing to start the container reads error"
    mkdir -p "$BASE/fakebin-125"
    cat >"$BASE/fakebin-125/podman" <<'SH'
    #!/usr/bin/env bash
    # Test wrapper: podman's own "cannot start the container" status.
    exit 125
    SH
    chmod 755 "$BASE/fakebin-125/podman"
    RUN5=$BASE/run-125
    PATH=$BASE/fakebin-125:$PATH "$CLONE/$RUNNER" --label host --passthrough "$PT" --xlsx-diff "$XD" \
      --corpus "$CORPUS" --out "$RUN5" --timeout 120 --libreoffice "$IMAGE" --lo-timeout 60 \
      --ids "$BASE/ids-healthy" >"$BASE/run-125.stdout" 2>"$BASE/run-125.stderr" </dev/null
    echo "  run exit: $?"
    echo "  reason: $(hide <"$RUN5/$(id_of healthy)/lo-in-reason.host.txt" 2>/dev/null)"
    note "C5 a podman start failure reads error" "$(is [ "$(field "$RUN5/summary.host.tsv" "$(id_of healthy)" lo_in)" = error ])"
    note "C5 the reason is exactly the ruled text" "$(is reason_is "$RUN5" healthy lo-in 'podman could not run the container, exit 125')"
    
    echo
    echo "## C6: the count step failing reads error, not fail"
    mkdir -p "$BASE/fakebin-py"
    cat >"$BASE/fakebin-py/python3" <<'SH'
    #!/usr/bin/env bash
    # Test wrapper: python3 that always fails, so lo_check cannot count sheets.
    exit 1
    SH
    chmod 755 "$BASE/fakebin-py/python3"
    echo "  (a directory holding only the python3 wrapper, so no other wrapper takes part)"
    RUN6=$BASE/run-count
    PATH=$BASE/fakebin-py:$PATH "$CLONE/$RUNNER" --label host --passthrough "$PT" --xlsx-diff "$XD" \
      --corpus "$CORPUS" --out "$RUN6" --timeout 120 --libreoffice "$IMAGE" --lo-timeout 60 \
      --ids "$BASE/ids-healthy" >"$BASE/run-count.stdout" 2>"$BASE/run-count.stderr" </dev/null
    echo "  run exit: $?"
    echo "  reason: $(hide <"$RUN6/$(id_of healthy)/lo-in-reason.host.txt" 2>/dev/null)"
    note "C6 the healthy workbook reads error on both sides, not fail" "$(is lo_is "$RUN6" healthy error error)"
    note "C6 the reason names the count step" "$(is reason_is "$RUN6" healthy lo-in 'cannot count sheets and tables')"
    rm -rf "$BASE/fakebin-py" "$BASE/fakebin-125" "$BASE/fakebin-kill"
    
    echo
    echo "## C9, C10, C11: the record script"
    echo "  A summary carrying all four lo values is assembled from the runs above,"
    echo "  so the record's counts and headings are measured on real rows."
    RUNR=$BASE/run-record
    mkdir -p "$RUNR"
    head -n 1 "$RUN/summary.host.tsv" >"$RUNR/summary.host.tsv"
    awk -F'\t' -v OFS='\t' 'NR > 1' "$RUN/summary.host.tsv" >>"$RUNR/summary.host.tsv"
    awk -F'\t' -v OFS='\t' 'NR > 1' "$RUN3/summary.host.tsv" >>"$RUNR/summary.host.tsv"
    cp "$RUN/entries.host.tsv" "$RUNR/entries.host.tsv"
    cp "$RUN/run.host.tsv" "$RUNR/run.host.tsv"
    echo "  the assembled summary's lo and lo_in columns:"
    awk -F'\t' 'NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next } { printf "    %s lo=%s lo_in=%s\n", $1, $col["lo"], $col["lo_in"] }' "$RUNR/summary.host.tsv"
    mkdir -p "$BASE/record"
    echo "command: $RECORD --run <scratch>/run-record --out <scratch>/record --allow-single --stem step0-t3p4-scratch"
    python3 "$CLONE/$RECORD" --run "$RUNR" --out "$BASE/record" --allow-single --stem step0-t3p4-scratch \
      >"$BASE/record.stdout" 2>"$BASE/record.stderr" </dev/null
    RC=$?
    echo "  exit: $RC"
    hide <"$BASE/record.stdout" | sed 's/^/    /'
    echo "  stderr: $(hide <"$BASE/record.stderr")"
    MD=$BASE/record/step0-t3p4-scratch.md
    # The record's table is .txt, not .tsv (planning's ruling of 2026-09-16: the
    # hygiene gate refuses a tracked spreadsheet extension). The run directory's
    # own summary.host.tsv, entries.host.tsv and run.host.tsv keep their names and
    # are never committed, so every other .tsv in this script is deliberate.
    TABLE=$BASE/record/step0-t3p4-scratch.txt
    note "C9 the record script exits 0 and wrote a .md and a .txt" "$(is record_written "$RC" "$MD" "$TABLE")"
    echo "  the outcome table of the record:"
    LC_ALL=C "$G" -a -A3 -F '## Files by outcome' "$MD" | sed 's/^/    /'
    note "C9 the outcome table carries the four counts for each column" \
      "$(is grep_q -a -q -F -e '| lo ok | lo fail | lo error | lo not-run | lo_in ok | lo_in fail | lo_in error | lo_in not-run |' "$MD")"
    note "C9 the record has the section for checks that could not run" "$(is grep_q -a -q -x -F -e '## Files whose open check could not run' "$MD")"
    FAILHEAD='## Files not ok, with a diff exit other than 0, with a leftover temporary file, or failing the LibreOffice open check'
    RUNHEAD='## Files whose open check could not run'
    echo "  the rows under each heading:"
    awk -v a="$FAILHEAD" -v b="$RUNHEAD" '$0 == a { s = 1 } $0 == b { s = 2 } s && /^\| [0-9a-f]{12} \|/ { printf "    under heading %d: %s\n", s, substr($0, 1, 60) }' "$MD"
    note "C9 the truncated workbook (lo_in fail) is listed under the failing heading" \
      "$(is listed_between "$MD" "$(id_of truncated)" "$FAILHEAD" "$RUNHEAD")"
    note "C9 the timed-out workbook (lo_in error) is listed only under the could-not-run heading" \
      "$(is listed_between "$MD" "$(id_of slow)" "$RUNHEAD" 'ZZZ-no-such-heading')"
    echo
    echo "  C10: a summary with an lo value outside the four"
    mkdir -p "$BASE/record-bad"
    cp -a "$RUNR" "$BASE/run-bad"
    awk -F'\t' -v OFS='\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "lo") c = i; print; next } { $c = "maybe"; print }' \
      "$RUNR/summary.host.tsv" >"$BASE/run-bad/summary.host.tsv"
    python3 "$CLONE/$RECORD" --run "$BASE/run-bad" --out "$BASE/record-bad" --allow-single --stem step0-t3p4-bad \
      >"$BASE/record-bad.stdout" 2>"$BASE/record-bad.stderr" </dev/null
    RC=$?
    echo "    exit $RC, stderr: $(hide <"$BASE/record-bad.stderr")"
    note "C10 refused with exit 2 and the text naming all four values" \
      "$(is refused_bad "$RC" "$BASE/record-bad.stdout" "$BASE/record-bad.stderr" 'error: summary.host.tsv has a lo value other than ok, fail, error or -')"
    echo
    echo "  C11: the sum guard in lo_tally (planning's obligation 2 of 2026-09-16)"
    echo "    load() refuses an unknown lo value before the counting runs, so NO input"
    echo "    can make the four counts miss a file. The guard is on the script's own"
    echo "    counting, and the only way to fire it is to break the counting. This"
    echo "    case mutates a scratch copy of the record script and shows the refusal."
    cp "$CLONE/$RECORD" "$BASE/record-mutated.py"
    MUTATION='s/            tally\[row\[column\]\] += 1/            if row[column] == "error": continue\n            tally[row[column]] += 1/'
    echo "    mutation applied to the scratch copy (sed):"
    echo "      $MUTATION" | hide
    python3 - "$BASE/record-mutated.py" <<'OUTER_PY'
    import re, sys
    path = sys.argv[1]
    text = open(path).read()
    old = "        for row in summary:\n            tally[row[column]] += 1\n"
    new = "        for row in summary:\n            if row[column] == \"error\":\n                continue\n            tally[row[column]] += 1\n"
    if old not in text:
        sys.stderr.write("the counting loop was not found; the mutation did not apply\n")
        sys.exit(3)
    open(path, "w").write(text.replace(old, new))
    OUTER_PY
    echo "    mutation exit: $?"
    mkdir -p "$BASE/record-mut-out"
    python3 "$BASE/record-mutated.py" --run "$RUNR" --out "$BASE/record-mut-out" --allow-single --stem step0-t3p4-mut \
      >"$BASE/record-mut.stdout" 2>"$BASE/record-mut.stderr" </dev/null
    RC=$?
    echo "    mutated script exit: $RC, stderr: $(hide <"$BASE/record-mut.stderr")"
    note "C11 the mutated copy is refused, so the guard can fire" "$(is [ "$RC" -eq 2 ])"
    note "C11 the refusal names the column and the two totals" \
      "$(is grep_q -a -q -E '^error: summary\.host\.tsv: the lo(_in)? counts total [0-9]+, not the [0-9]+ files$' "$BASE/record-mut.stderr")"
    note "C11 the unmutated script accepts the same run, so the difference is the mutation" "$(is [ -f "$MD" ])"
    
    echo
    echo "## C12: --lo-timeout with a value that is not a positive whole number"
    "$CLONE/$RUNNER" --label host --passthrough "$PT" --xlsx-diff "$XD" \
      --corpus "$CORPUS" --out "$BASE/run-badto" --timeout 120 --lo-timeout 0 \
      >"$BASE/badto.stdout" 2>"$BASE/badto.stderr" </dev/null
    RC=$?
    echo "  exit: $RC; stderr: $(hide <"$BASE/badto.stderr")"
    note "C12 exit 2, no stdout, stderr exactly the refusal" \
      "$(is refused_bad "$RC" "$BASE/badto.stdout" "$BASE/badto.stderr" 'error: --lo-timeout must be a positive whole number of seconds')"
    note "C12 no run directory was created" "$(is [ ! -e "$BASE/run-badto" ])"
    
    echo
    echo "## the log itself"
    OUTS=("$BASE/run-lo.stdout" "$BASE/run-lo.stderr" "$BASE/run-timeout.stdout" "$BASE/run-timeout.stderr"
          "$BASE/run-killed.stdout" "$BASE/run-killed.stderr" "$BASE/run-125.stdout" "$BASE/run-125.stderr"
          "$BASE/run-count.stdout" "$BASE/run-count.stderr" "$BASE/badto.stdout" "$BASE/badto.stderr")
    ALL=("${OUTS[@]}" "$BASE/gen.out" "$BASE/record.stdout" "$BASE/record.stderr" "$BASE/record-bad.stderr"
         "$BASE/record-mut.stderr" "$BASE/cs.out")
    CONTAINER_LINE='Error: source file could not be loaded'
    count_container_line() { counted -F "$CONTAINER_LINE" "$@"; }
    ctl "the container's own line anywhere in the runner's output" "$(count_container_line "${OUTS[@]}")" 0
    note "lines with Error, Warning or javaldx in the runner's output: $(count_container_words "${OUTS[@]}") (expect 0)" \
      "$(is [ "$(count_container_words "${OUTS[@]}")" -eq 0 ])"
    note "lines with the scratch path in every captured output: $(count_path "${ALL[@]}") (expect 0)" \
      "$(is [ "$(count_path "${ALL[@]}")" -eq 0 ])"
    printf 'x \033[31mred\033[m\017 y\ncaf\303\251\n' >"$BASE/ctl-bytes"
    ctl "control bytes in a file with ESC, ESC and SI" "$(ctrl_bytes "$BASE/ctl-bytes")" 3
    ctl "non-ASCII bytes in a file with one two-byte character" "$(nonascii_bytes "$BASE/ctl-bytes")" 2
    note "control and non-ASCII bytes in every captured output: $(ctrl_bytes "${ALL[@]}") and $(nonascii_bytes "${ALL[@]}") (expect 0 and 0)" \
      "$(is [ $(( $(ctrl_bytes "${ALL[@]}") + $(nonascii_bytes "${ALL[@]}") )) -eq 0 ])"
    MAIN_STATUS=$(git -C "$MAIN" status --porcelain | tr '\n' ' ')
    note "the main working tree is still clean and was never built in (expect empty): $MAIN_STATUS" "$(is [ -z "$MAIN_STATUS" ])"
    note "the main tree is still at $C" "$(is [ "$(git -C "$MAIN" rev-parse HEAD)" = "$C" ])"
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "negative log checks all as expected: $([ "$fail" -eq 0 ] && echo yes || echo no)"
    exit "$fail"

