  control f_p6_one pattern=0 file=c-p6-0 count=1 exit=0 expected_exit=0: as-expected
  control f_p6 file=c-p6-0 count=1 exit=0 expected_exit=0: as-expected
  control f_p6_one pattern=1 file=c-p6-1 count=1 exit=0 expected_exit=0: as-expected
