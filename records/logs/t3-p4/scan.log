  control f_nonascii file=c-nonascii count=1 exit=0 expected_exit=0: as-expected
  control f_ctrl file=c-ctrl (ESC and SI) count=1 exit=0 expected_exit=0: as-expected
  control f_ctrl file=c-tabcr (tab and CR only) count=0 exit=1 expected_exit=1: as-expected
  control f_emdash file=c-emdash count=1 exit=0 expected_exit=0: as-expected
  control f_emdash file=c-nonascii count=0 exit=1 expected_exit=1: as-expected
