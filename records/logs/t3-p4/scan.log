  control f_p6_one pattern=2 file=c-p6-2 count=1 exit=0 expected_exit=0: as-expected
  control f_p6 file=c-p6-2 count=1 exit=0 expected_exit=0: as-expected
  control f_p6_one pattern=3 file=c-p6-3 count=1 exit=0 expected_exit=0: as-expected
  control f_p6 file=c-p6-3 count=1 exit=0 expected_exit=0: as-expected
  control f_p6_one pattern=4 file=c-p6-4 count=1 exit=0 expected_exit=0: as-expected
  control f_p6 file=c-p6-4 count=1 exit=0 expected_exit=0: as-expected
  control f_p6_one pattern=5 file=c-p6-5 count=1 exit=0 expected_exit=0: as-expected
  control f_p6 file=c-p6-5 count=1 exit=0 expected_exit=0: as-expected
  control f_p6_one pattern=6 file=c-p6-6 count=1 exit=0 expected_exit=0: as-expected
  control f_p6 file=c-p6-6 count=1 exit=0 expected_exit=0: as-expected
  control f_p6_one pattern=7 file=c-p6-7 count=1 exit=0 expected_exit=0: as-expected
  control f_p6 file=c-p6-7 count=1 exit=0 expected_exit=0: as-expected
  control f_p6_one pattern=8 file=c-p6-8 count=1 exit=0 expected_exit=0: as-expected
  control f_p6 file=c-p6-8 count=1 exit=0 expected_exit=0: as-expected
  control f_p6_one pattern=9 file=c-p6-9 count=1 exit=0 expected_exit=0: as-expected
  control f_p6 file=c-p6-9 count=1 exit=0 expected_exit=0: as-expected
