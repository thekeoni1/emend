## script
    #!/usr/bin/env bash
    # T3 P4 scan over the phase diff: files changed in <base>..<commit> (contents at
    # <commit>), each commit's file list and message, and the other T3 P4 logs.
    # Usage: t3p4-scan.sh <base> <commit> > <scratch file>; the caller moves the
    # output to records/logs/t3-p4/scan.log, so nothing is written in the tree
    # during the run. Never prints matched text, email addresses or denylist entries.
    # Each check is evaluated once and that single result is printed.
    #
    # The pattern array below is the post-P6d form (patterns 8, 10 and 11 require a
    # path character or a byte that is not printable ASCII after the trailing
    # separator). It is compared against scripts/privacy-patterns.txt at the phase
    # commit, so a stale copy fails here rather than scanning with the wrong forms.
    # Because the narrowed patterns are by design blind to a bare shape, this scan's
    # own zero hits do not prove the absence of a bare shape: the pre-P6d forms are
    # run separately at the end, as check 2 of T0 P6d asked and planning ruled.
    set -uo pipefail
    cd "$(git rev-parse --show-toplevel)" || exit 2
    
    BASE=${1:?base commit required}
    C=${2:?phase commit required}
    G=/usr/bin/grep
    unset EMEND_PRIVATE_DENYLIST
    DENY_FILE=$HOME/.config/emend/private-denylist.txt
    COAUTHOR='Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>'
    T=$(mktemp -d)
    trap 'rm -rf "$T"' EXIT
    EMDASH=$(printf '\342\200\224')
    HOST=$(hostname)
    FQDN=$(hostname -f 2>/dev/null || hostname)
    ID_EMAIL=$(git show "$C:scripts/privacy-identity.txt" | sed -n 2p)
    EMAIL_RE='[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+([.][A-Za-z0-9-]+)*[.][A-Za-z]{2,}'
    hits=0; err=0; bad=0; ctl_fail=0
    
    # Shape-based patterns (specs/0001 P6, P6b, P6c and P6d), one character of each
    # literal bracketed. Patterns 8, 10 and 11 carry the P6d class.
    P6=(
      'gh[pousr][_][A-Za-z0-9]{20,}'
      'github[_]pat[_][A-Za-z0-9_]{20,}'
      'sk[-]ant[-][A-Za-z0-9_-]{20,}'
      '-----BEGIN [A-Z ]*PRIVATE[ ]KEY-----'
      'claude[.]ai/code/session[_][A-Za-z0-9]+'
      'session[_][A-Za-z0-9]{20,}'
      '/tmp/claude[-][0-9]+/'
      '/mnt/[a-z]/[Uu]sers/([A-Za-z0-9._-]|[^[:print:][:space:]])'
      'DESKTOP[-][A-Z0-9]{5,}'
      '[A-Za-z]:[\\/]+[Uu][Ss][Ee][Rr][Ss][\\/]+([A-Za-z0-9._-]|[^[:print:][:space:]])'
      '[.]claude[\\/]+projects[\\/]+([A-Za-z0-9._-]|[^[:print:][:space:]])'
    )
    P6ARGS=()
    for p in "${P6[@]}"; do P6ARGS+=(-e "$p"); done
    # The pre-P6d forms of the three narrowed patterns, for the bare-shape scan at
    # the end only. They are never used for the phase scan itself.
    PRE=(
      '/mnt/[a-z]/[Uu]sers/'
      '[A-Za-z]:[\\/]+[Uu][Ss][Ee][Rr][Ss][\\/]'
      '[.]claude[\\/]+projects[\\/]'
    )
    PREARGS=()
    for p in "${PRE[@]}"; do PREARGS+=(-e "$p"); done
    
    f_nonascii() { LC_ALL=C "$G" -c -P '[^\x00-\x7F]' "$1"; }
    f_ctrl()     { LC_ALL=C "$G" -a -c -P '[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]' "$1"; }
    f_emdash()   { LC_ALL=C "$G" -c -F -e "$EMDASH" "$1"; }
    f_session()  { LC_ALL=C "$G" -c -e '^Claude-Session:' "$1"; }
    f_p6()       { LC_ALL=C "$G" -a -c -E "${P6ARGS[@]}" "$1"; }
    f_p6_one()   { LC_ALL=C "$G" -a -c -E -e "${P6[$1]}" "$2"; }
    f_pre()      { LC_ALL=C "$G" -a -c -E "${PREARGS[@]}" "$1"; }
    f_host()     { LC_ALL=C "$G" -a -c -i -w -F -e "$HOST" -e "$FQDN" "$1"; }
    f_deny()     { LC_ALL=C "$G" -a -c -i -w -F -f "$T/deny" "$1"; }
    f_deny_one() { LC_ALL=C "$G" -a -c -i -w -F -f "$T/deny-$1" "$2"; }
    # Addresses outside the allowlist (the identity address, noreply@anthropic.com,
    # example.invalid). Prints the count; exit 0 on a hit, 1 on none, 2 on error.
    f_email() {
      local out rc
      out=$(LC_ALL=C "$G" -a -o -E -e "$EMAIL_RE" "$1"); rc=$?
      if [ "$rc" -ge 2 ]; then echo none; return 2; fi
      if [ "$rc" -eq 1 ]; then echo 0; return 1; fi
      printf '%s\n' "$out" | LC_ALL=C awk -v id="$ID_EMAIL" '
        { a = tolower($0) }
        a == tolower(id) || a == "noreply@anthropic.com" || a ~ /@example[.]invalid$/ { next }
        { n++ }
        END { print n + 0; exit !(n > 0) }'
    }
    FORMS="f_nonascii f_ctrl f_emdash f_session f_p6 f_host f_deny f_email"
    
    run() { # run <form> <file>
      local n rc
      n=$("$1" "$2"); rc=$?
      echo "  form=$1 count=${n:-none} exit=$rc"
      if [ "$rc" -ge 2 ]; then err=1; elif [ "$rc" -eq 0 ]; then hits=$((hits+n)); fi
    }
    check_ctl() { # check_ctl <label> <expected exit> <command...>
      local label=$1 want=$2 n rc r
      shift 2
      n=$("$@"); rc=$?
      r=$([ "$rc" -eq "$want" ] && echo as-expected || echo UNEXPECTED)
      echo "  control $label count=${n:-none} exit=$rc expected_exit=$want: $r"
      [ "$r" = as-expected ] || ctl_fail=1
    }
    # structural <label> <yes|no>: print a result evaluated once.
    structural() { echo "$1: $2"; [ "$2" = yes ] || bad=1; }
    yn() { if "$@"; then echo yes; else echo no; fi; }
    rep() { printf "$1%.0s" $(seq 1 "$2"); }
    
    echo "about: phase diff $BASE..$C; HEAD at run: $(git rev-parse HEAD)"
    echo "phase: T3 P4 (specs/0006-passthrough.md) scan.log; run at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ -n "${RERUN_NOTE:-}" ]; then echo "rerun: $RERUN_NOTE"; fi
    echo "temporary files live in <scratch> and are deleted on exit"
    echo
    echo "## script"
    sed 's/^/    /' "$0"
    echo
    echo "## environment"
    echo "grep: $G, $("$G" --version | head -1)"
    echo "EMEND_PRIVATE_DENYLIST set: no (unset by this script)"
    if [ ! -f "$DENY_FILE" ]; then echo "private denylist: MISSING"; exit 2; fi
    MODE600=$(stat -c %a "$DENY_FILE")
    echo "private denylist: present, mode $MODE600"
    LC_ALL=C "$G" -v -E '^[[:space:]]*(#|$)' "$DENY_FILE" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' > "$T/deny"
    NDENY=$(wc -l < "$T/deny")
    echo "denylist entries: $NDENY (never printed)"
    NWS=$(LC_ALL=C "$G" -c -E '[[:space:]]' "$T/deny")
    structural "denylist entries holding whitespace: $NWS (expect 0)" "$(yn [ "$NWS" -eq 0 ])"
    [ "$NDENY" -gt 0 ] || { echo "denylist has no entries"; exit 2; }
    structural "private denylist mode is 600" "$(yn [ "$MODE600" = 600 ])"
    if git show "$C:scripts/privacy-patterns.txt" > "$T/patterns-at-c" 2>/dev/null; then
      printf '%s\n' "${P6[@]}" > "$T/patterns-here"
      structural "this script's patterns equal scripts/privacy-patterns.txt at $C" "$(yn cmp -s "$T/patterns-here" "$T/patterns-at-c")"
    else
      echo "scripts/privacy-patterns.txt at $C: READ ERROR"; err=1
    fi
    
    echo
    echo "## controls (same command forms as the scans)"
    printf 'plain\nhas \303\251 byte\n' > "$T/c-nonascii"
    printf 'x \033[31mred\033[m\017 y\n' > "$T/c-ctrl"
    printf 'plain\ttab\r\n' > "$T/c-tabcr"
    printf 'has %s here\n' "$EMDASH" > "$T/c-emdash"
    printf 'subject\n\nClaude-Session: control\n' > "$T/c-session"
    printf 'x %s%s%s y\n' 'gh' 'p_' "$(rep a 24)" > "$T/c-p6-0"
    printf 'x %s%s%s y\n' 'github' '_pat_' "$(rep a 24)" > "$T/c-p6-1"
    printf 'x %s%s%s y\n' 'sk' '-ant-' "$(rep a 24)" > "$T/c-p6-2"
    printf '%s%s%s\n' '-----BEGIN RSA ' 'PRIVATE' ' KEY-----' > "$T/c-p6-3"
    printf 'x https://%s%s%s%s y\n' 'claude' '.ai/code/' 'session_' "$(rep A 24)" > "$T/c-p6-4"
    printf 'x %s%s%s y\n' 'session' '_' "$(rep A 24)" > "$T/c-p6-5"
    printf 'x %s%s%s%s y\n' '/tmp/' 'claude-' '1000' '/' > "$T/c-p6-6"
    # Patterns 8, 10 and 11 need a path character after the trailing separator (P6d).
    printf 'x %s%s%s%s y\n' '/mnt/' 'c/' 'Users/' 'bob' > "$T/c-p6-7"
    printf 'x %s%s%s y\n' 'DESKTOP' '-' 'ABC12' > "$T/c-p6-8"
    printf 'x C%s%sUSERS%sbob y\n' ':' '\\' '\\' > "$T/c-p6-9"
    printf 'x %%USERPROFILE%%%s%s%s y\n' '\' '.claude' '\projects\x' > "$T/c-p6-10"
    # The P6b and P6c forms with a segment must still match the narrowed patterns.
    printf 'x C%s%sUsers%sbob y\n' ':' '\' '\' > "$T/c-p6-9-old"
    printf 'x /home/u/%s%s y\n' '.claude' '/projects/x' > "$T/c-p6-10-old"
    # Bare shapes: the three narrowed patterns must NOT match these (the P6d point).
    printf 'x %s%s%s y\n' '/mnt/' 'c/' 'Users/' > "$T/c-bare-7"
    printf 'x C%s%sUsers%s y\n' ':' '\' '\' > "$T/c-bare-9"
    printf 'x %s%s y\n' '.claude' '/projects/' > "$T/c-bare-10"
    printf 'names only: %s %s %s %s\n' 'sk-''ant-' 'github_''pat_' '/tmp/''claude-' 'claude.ai/code/''session' > "$T/c-p6-names"
    printf 'x %s y\n' "$HOST" > "$T/c-host"
    printf 'x %s y\n' "$FQDN" > "$T/c-fqdn"
    printf 'x %s%s%s y\n' 'zq12' '@exam' 'ple.com' > "$T/c-email-bad"
    printf 'x %s noreply@anthropic.com zq@example.invalid y\n' "$ID_EMAIL" > "$T/c-email-ok"
    printf 'plain ascii only\nno session line\n' > "$T/c-clean"
    check_ctl "f_nonascii file=c-nonascii" 0 f_nonascii "$T/c-nonascii"
    check_ctl "f_ctrl file=c-ctrl (ESC and SI)" 0 f_ctrl "$T/c-ctrl"
    check_ctl "f_ctrl file=c-tabcr (tab and CR only)" 1 f_ctrl "$T/c-tabcr"
    check_ctl "f_emdash file=c-emdash" 0 f_emdash "$T/c-emdash"
    check_ctl "f_emdash file=c-nonascii" 1 f_emdash "$T/c-nonascii"
    check_ctl "f_session file=c-session" 0 f_session "$T/c-session"
    for i in "${!P6[@]}"; do
      check_ctl "f_p6_one pattern=$i file=c-p6-$i" 0 f_p6_one "$i" "$T/c-p6-$i"
      check_ctl "f_p6 file=c-p6-$i" 0 f_p6 "$T/c-p6-$i"
    done
    check_ctl "f_p6_one pattern=9 file=c-p6-9-old (P6b form with a segment)" 0 f_p6_one 9 "$T/c-p6-9-old"
    check_ctl "f_p6_one pattern=10 file=c-p6-10-old (P6b form with a segment)" 0 f_p6_one 10 "$T/c-p6-10-old"
    check_ctl "f_p6_one pattern=7 file=c-bare-7 (bare shape, P6d: must not match)" 1 f_p6_one 7 "$T/c-bare-7"
    check_ctl "f_p6_one pattern=9 file=c-bare-9 (bare shape, P6d: must not match)" 1 f_p6_one 9 "$T/c-bare-9"
    check_ctl "f_p6_one pattern=10 file=c-bare-10 (bare shape, P6d: must not match)" 1 f_p6_one 10 "$T/c-bare-10"
    check_ctl "f_pre file=c-bare-7 (the pre-P6d form does match it)" 0 f_pre "$T/c-bare-7"
    check_ctl "f_pre file=c-bare-9 (the pre-P6d form does match it)" 0 f_pre "$T/c-bare-9"
    check_ctl "f_pre file=c-bare-10 (the pre-P6d form does match it)" 0 f_pre "$T/c-bare-10"
    check_ctl "f_p6 file=c-p6-names (bare pattern names must not match)" 1 f_p6 "$T/c-p6-names"
    check_ctl "f_host file=c-host" 0 f_host "$T/c-host"
    check_ctl "f_host file=c-fqdn" 0 f_host "$T/c-fqdn"
    check_ctl "f_email file=c-email-bad (an address at example.com)" 0 f_email "$T/c-email-bad"
    check_ctl "f_email file=c-email-ok (only allowed addresses)" 1 f_email "$T/c-email-ok"
    for i in $(seq 1 "$NDENY"); do
      sed -n "${i}p" "$T/deny" > "$T/deny-$i"
      awk '{print "x " $0 " y"}' "$T/deny-$i" > "$T/c-deny-$i"
      check_ctl "f_deny_one entry=$i (not printed)" 0 f_deny_one "$i" "$T/c-deny-$i"
      check_ctl "f_deny entry=$i (not printed)" 0 f_deny "$T/c-deny-$i"
    done
    for f in $FORMS; do check_ctl "$f file=c-clean" 1 "$f" "$T/c-clean"; done
    check_ctl "f_pre file=c-clean" 1 f_pre "$T/c-clean"
    echo "controls: $([ "$ctl_fail" -eq 0 ] && echo "all as expected" || echo FAILED)"
    
    echo
    echo "## commits in the phase range, with their files"
    echo "command: git rev-list --parents $BASE..$C"
    git rev-list --parents "$BASE..$C"
    for c in $(git rev-list --reverse "$BASE..$C"); do
      echo "command: git show --name-status --format='%H parents=%P %s' $c"
      git show --name-status --format='%H parents=%P %s' "$c" | sed 's/^/    /'
    done
    
    echo
    echo "## files changed in the phase diff (contents at $C)"
    echo "command: git diff --name-status $BASE $C"
    git diff --name-status "$BASE" "$C" | sed 's/^/    /'
    nf=0; nread=0
    while IFS= read -r f; do
      nf=$((nf+1))
      if git show "$C:$f" > "$T/f" 2>/dev/null; then nread=$((nread+1)); else echo "file $f: READ ERROR"; err=1; continue; fi
      echo "file $f (sha256 $(sha256sum < "$T/f" | cut -d' ' -f1))"
      for form in $FORMS; do run "$form" "$T/f"; done
    done < <(git diff --name-only --diff-filter=d "$BASE" "$C")
    want=$(git diff --name-only --diff-filter=d "$BASE" "$C" | wc -l)
    # files_complete: every file in the diff was scanned and read, and there was at least one.
    files_complete() { [ "$nf" -eq "$want" ] && [ "$nread" -eq "$want" ] && [ "$want" -gt 0 ]; }
    structural "files in diff: $want; files scanned: $nf; files read: $nread" "$(yn files_complete)"
    
    echo
    echo "## commit messages in the phase range"
    nm=0
    for c in $(git rev-list "$BASE..$C"); do
      nm=$((nm+1))
      if ! git cat-file commit "$c" > "$T/raw"; then echo "message $c: READ ERROR"; err=1; continue; fi
      sed '1,/^$/d' "$T/raw" > "$T/m"
      last=$(awk 'NF{l=$0} END{print l}' "$T/m")
      echo "message $c"
      structural "  last non-empty line is the Co-Authored-By line" "$(yn [ "$last" = "$COAUTHOR" ])"
      for form in $FORMS; do run "$form" "$T/m"; done
    done
    NR_RANGE=$(git rev-list --count "$BASE..$C")
    # messages_complete: every commit message in the range was scanned, and there was at least one.
    messages_complete() { [ "$nm" -eq "$NR_RANGE" ] && [ "$nm" -gt 0 ]; }
    structural "messages scanned: $nm; commits in range: $NR_RANGE" "$(yn messages_complete)"
    
    echo
    echo "## other T3 P4 logs in the working tree (a log cannot scan itself)"
    echo "Four logs are committed by this phase. The scan.log read here is the one"
    echo "committed at the first record commit, not the file this run is writing:"
    echo "this run's output goes to <scratch> and is moved in afterwards, so no log"
    echo "scans itself. run.log is not rerun; it stays the primary of the run."
    nl=0
    for f in records/logs/t3-p4/gate.log records/logs/t3-p4/negative.log records/logs/t3-p4/run.log records/logs/t3-p4/scan.log; do
      if [ ! -f "$f" ]; then echo "log $f: MISSING"; bad=1; continue; fi
      nl=$((nl+1))
      echo "log $f (sha256 $(sha256sum "$f" | cut -d' ' -f1))"
      for form in $FORMS; do run "$form" "$f"; done
    done
    structural "T3 P4 logs scanned: $nl (expected 4)" "$(yn [ "$nl" -eq 4 ])"
    
    echo
    echo "## the pre-P6d forms over the phase's files and logs (check 2's point)"
    echo "The narrowed patterns are blind to a bare shape by design, so this scan's"
    echo "own zero hits cannot establish that no bare shape was committed. The three"
    echo "pre-P6d forms are run here for that, with a positive control above."
    pre_hits=0; pre_err=0
    for f in records/logs/t3-p4/gate.log records/logs/t3-p4/negative.log records/logs/t3-p4/run.log records/logs/t3-p4/scan.log; do
      [ -f "$f" ] || continue
      n=$(f_pre "$f"); rc=$?
      echo "  pre-P6d forms in $f: count=${n:-none} exit=$rc"
      if [ "$rc" -ge 2 ]; then pre_err=1; elif [ "$rc" -eq 0 ]; then pre_hits=$((pre_hits+n)); fi
    done
    while IFS= read -r f; do
      git show "$C:$f" > "$T/f" 2>/dev/null || continue
      n=$(f_pre "$T/f"); rc=$?
      echo "  pre-P6d forms in $f: count=${n:-none} exit=$rc"
      if [ "$rc" -ge 2 ]; then pre_err=1; elif [ "$rc" -eq 0 ]; then pre_hits=$((pre_hits+n)); fi
    done < <(git diff --name-only --diff-filter=d "$BASE" "$C")
    # Both conditions inside one named function: the form
    # $(yn [ ... ] && [ ... ]) captures only the first test, which specs/0001
    # forbids by name. Independent check 1 of this phase found it here, where it
    # silently dropped the grep-error condition from the printed result.
    pre_clean() { [ "$pre_hits" -eq 0 ] && [ "$pre_err" -eq 0 ]; }
    structural "bare shapes found by the pre-P6d forms: $pre_hits (expect 0); errors: $pre_err" \
      "$(yn pre_clean)"
    
    echo
    echo "total hits: $hits"
    echo "grep or read errors: $err"
    echo "structural checks failed: $bad"
    # scan_passed: controls as expected, no errors, no hits, no failed structural check.
    scan_passed() { [ "$ctl_fail" -eq 0 ] && [ "$err" -eq 0 ] && [ "$hits" -eq 0 ] && [ "$bad" -eq 0 ]; }
    echo "run ended at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if scan_passed; then
      echo "RESULT: PASS"
    else
      echo "RESULT: FAIL"
      exit 1
    fi

## environment
